@* Page-level header: h1 + optional lead on left, actions on right.
   Usage: <PageHeader Title="…" Description="…"><button>…</button></PageHeader> *@

<div class="page-header">
    <div class="page-header-left">
        <h1>@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p class="page-lead">@Description</p>
        }
        @* Project-scoped modules show the shared project selector (the same control as the testing workspaces); global, environment-scoped
           and multi-project modules do not (see docs/audits/birknext-project-selector-consistency-2026-11-18.md). *@
        @if (ShowProjectSelector)
        {
            <div class="page-header-project"><BirkNext.Web.Components.ProjectSelector /></div>
        }
    </div>
    @if (ChildContent is not null)
    {
        <div class="page-header-actions">@ChildContent</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title    { get; set; } = "";
    [Parameter]                 public string? Description { get; set; }
    [Parameter]                 public RenderFragment? ChildContent { get; set; }
    [Parameter]                 public bool ShowProjectSelector { get; set; }
}
