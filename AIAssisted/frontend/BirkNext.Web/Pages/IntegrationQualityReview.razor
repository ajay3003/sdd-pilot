@page "/integration-quality-review"
@using BirkNext.Integrations
@using BirkNext.Web.Components
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@inject IIntegrationCatalogApiService Api
@inject IFrontendAnalysisContextFactory ContextFactory
@inject IWorkspaceSessionService Workspace
@inject IReportExportService ExportService
@inject RuntimeReviewSessionService RuntimeReviews
@inject IntegrationMappingEvidenceSession MappingEvidence
@inject IJSRuntime JS

<PageTitle>Integration Quality Review</PageTitle>

@* Integration Quality Review runs from the ENABLED integrations configured in Target Environment → Integrations (persisted by
   the backend). Endpoint Discovery keeps observed REST/GraphQL traffic; Browser Discovery keeps browser evidence. The review is
   read-only: no event is published or consumed, no checkpoint moved, no consumer group created. Configured expectation,
   runtime evidence, contract evidence and the review result are shown as four different things. *@
<div class="iqr-page">
    <PageHeader Title="Integration Quality Review"
                Description="Review the configured integrations of the active Target Environment: configuration, connectivity, contracts, message flow, reliability, error handling, security, observability, performance and data quality.">
        @if (_result is not null)
        {
            <button type="button" class="btn-secondary" data-testid="iqr-back" @onclick="BackToSetup">Back to setup</button>
            <button type="button" class="btn-secondary" data-testid="iqr-export" @onclick="ExportHtml">Export HTML</button>
        }
    </PageHeader>

    @if (_error is { } error)
    {
        <div class="iqr-banner iqr-banner-error" role="alert" data-testid="iqr-error">@error</div>
    }

    @if (_profile is null && _error is null)
    {
        <p class="iqr-muted" role="status" data-testid="iqr-loading">Loading the active Target Environment…</p>
    }
    else if (_profile is { } profile && _result is null)
    {
        @* ── Pre-run ── Scope + readiness, then what limits the review (with the one place that fixes each), then the details.
           Presentation only: headline, domain readiness and the Run gate are the backend's. Corrective actions deep-link to
           Target Environment → Integrations; nothing is configured here. *@
        <section class="iqr-card iqr-scope @(_readiness is { } r0 ? $"iqr-readiness iqr-readiness-{IntegrationReviewPrerunPresentation.ReadinessTone(r0)}" : "")" aria-labelledby="iqr-scope-heading" data-testid="iqr-scope">
            <h2 id="iqr-scope-heading">Configured scope</h2>
            @if (_readiness is null)
            {
                @if (_error is null) { <p class="iqr-muted" role="status">Loading configured integrations…</p> }
            }
            else
            {
                <dl class="iqr-summary" data-testid="iqr-summary">
                    <div><dt>Target</dt><dd data-testid="iqr-summary-target">@(string.IsNullOrWhiteSpace(profile.Name) ? profile.Id : profile.Name)</dd></div>
                    <div><dt>Integration systems</dt><dd data-testid="iqr-summary-systems">@_readiness.Systems.Count</dd></div>
                    <div><dt>Business topics</dt><dd data-testid="iqr-summary-topics">@_readiness.Systems.Sum(s => s.Topics)</dd></div>
                    <div><dt>Enabled</dt><dd data-testid="iqr-summary-enabled">@_readiness.EnabledIntegrations of @_readiness.ConfiguredIntegrations</dd></div>
                    <div><dt>Review readiness</dt><dd><span class="iqr-pill iqr-pill-@(IntegrationReviewPrerunPresentation.ReadinessTone(_readiness) switch { "ready" => "ready", "limited" => "attention", _ => "fail" })" data-testid="iqr-summary-readiness">@IntegrationReviewPrerunPresentation.ReadinessLabel(_readiness)</span></dd></div>
                </dl>
                @if (_readiness.CanRun && _readiness.Domains.Count > 0)
                {
                    <p class="iqr-muted" data-testid="iqr-readiness-coverage">@IntegrationReviewPrerunPresentation.AssessableDomains(_readiness) of @_readiness.Domains.Count domains are currently assessable or partially assessable.@(_readiness.Headline == "Ready" ? "" : " Some review domains lack runtime or contract evidence.")</p>
                }
            }
        </section>

        @if (_readiness is { } readiness)
        {
            var attention = IntegrationReviewPrerunPresentation.NeedsAttention(readiness, profile.Id);
            var mappingEvidence = IntegrationReviewPrerunPresentation.MappingEvidence(_catalog, MappingEvidence.For(profile.Id));
            <section class="iqr-card iqr-attention" aria-labelledby="iqr-readiness-heading" data-testid="iqr-readiness" data-headline="@readiness.Headline">
                <h2 id="iqr-readiness-heading">@(readiness.CanRun ? attention.Count > 0 ? "Needs attention" : "Ready to run" : "Cannot run")</h2>
                @if (!readiness.CanRun)
                {
                    <ul class="iqr-reasons" data-testid="iqr-readiness-reasons">@foreach (var reason in readiness.Reasons) { <li>@reason</li> }</ul>
                }
                else if (attention.Count > 0)
                {
                    <ul class="iqr-attention-list" data-testid="iqr-attention">
                        @foreach (var item in attention)
                        {
                            <li class="iqr-attention-item" data-testid="iqr-attention-item" data-key="@item.Key">
                                <span class="iqr-attention-label">@item.Label</span>
                                <span class="iqr-attention-value">@item.Value</span>
                                @if (item.ActionHref is { } href) { <a class="iqr-link" href="@href" data-testid="@($"iqr-action-{item.Key}")">@item.ActionLabel</a> }
                                @if (item.Key == "mappings" && mappingEvidence is { } me)
                                {
                                    <span class="iqr-attention-detail iqr-muted" data-testid="iqr-mapping-evidence">Evidence checks this session: @me.Tested tested@(me.Strong > 0 ? $" · {me.Strong} strong evidence, not confirmed" : "")@(me.Partial > 0 ? $" · {me.Partial} partial evidence" : "")@(me.NoSupport > 0 ? $" · {me.NoSupport} no supporting evidence" : "")@(me.NotTestable > 0 ? $" · {me.NotTestable} not testable" : "")@(me.Error > 0 ? $" · {me.Error} error" : "") · @me.NotTested not tested. Evidence never confirms a mapping.</span>
                                }
                            </li>
                        }
                    </ul>
                }
                <div class="iqr-run-bar">
                    <button type="button" class="btn-primary" data-testid="iqr-run" disabled="@(!readiness.CanRun || _running)" aria-describedby="iqr-run-note" @onclick="RunAsync">
                        @(_running ? "Running Integration Quality Review…" : readiness.Headline == "Ready" ? "Run Integration Quality Review" : "Run with limitations")
                    </button>
                    <span class="iqr-muted" id="iqr-run-note">Read-only review. No messages are published, consumed or changed.</span>
                    <a class="iqr-link" href="@IntegrationsHref(profile)" data-testid="iqr-open-integrations">Open Target Environment → Integrations</a>
                </div>
                @if (readiness.CanRun && readiness.Reasons.Count > 0)
                {
                    <ReviewDisclosure Text="All limitation details" CollapseText="Hide limitation details" Hint="@($"{readiness.Reasons.Count} item{(readiness.Reasons.Count == 1 ? "" : "s")}")" TestId="iqr-limitation-details" Class="disclosure-inline">
                        <ul class="iqr-reasons" data-testid="iqr-readiness-reasons">@foreach (var reason in readiness.Reasons) { <li>@reason</li> }</ul>
                    </ReviewDisclosure>
                }
            </section>

            <section class="iqr-card" aria-labelledby="iqr-systems-heading" data-testid="iqr-systems">
                <h2 id="iqr-systems-heading">Configured integration system@(readiness.Systems.Count == 1 ? "" : "s")</h2>
                @if (readiness.Systems.Count == 0)
                {
                    <p class="iqr-muted" data-testid="iqr-no-systems">No enabled integration is configured for this Target Environment.</p>
                }
                @foreach (var system in readiness.Systems)
                {
                    <article class="iqr-system" data-testid="iqr-system">
                        <h3>@system.SystemName @if (system.PlatformName is { } platform) { <span class="iqr-muted">→ @platform</span> }</h3>
                        <dl class="iqr-dl">
                            <div><dt>Topics</dt><dd data-testid="iqr-system-topics">@system.Topics</dd></div>
                            <div><dt>Consumers</dt><dd data-testid="iqr-system-consumers">@IntegrationReviewPrerunPresentation.Consumers(system)</dd></div>
                            @if (system.Kind == IntegrationKind.EventHub) { <div><dt>Consumer groups</dt><dd data-testid="iqr-system-groups">@IntegrationReviewPrerunPresentation.ConsumerGroups(system)</dd></div> }
                            <div><dt>Contracts</dt><dd data-testid="iqr-system-contracts">@IntegrationReviewPrerunPresentation.Contracts(system)</dd></div>
                            @if (!system.DomainReviewSupported) { <div><dt>Domain review</dt><dd>Not implemented for @IntegrationConfigurationRules.KindLabel(system.Kind) — configuration is reviewed</dd></div> }
                        </dl>
                        <div class="iqr-system-actions">
                            @if (system.ConsumersSuggested + system.ConsumersNeedingConfirmation > 0)
                            { <a class="iqr-link" href="@IntegrationReviewPrerunPresentation.Href(profile.Id, IntegrationReviewPrerunPresentation.FocusMappings)" data-testid="iqr-system-review-mappings">Review mappings</a> }
                            @if (_catalog is { } catalog)
                            {
                                <ReviewDisclosure Text="@($"View {system.Topics} topic{(system.Topics == 1 ? "" : "s")}")" CollapseText="Hide topics" TestId="@($"iqr-system-topics-{Slug(system.SystemName)}")" Class="disclosure-inline">
                                    <ul class="iqr-topic-list">
                                        @foreach (var topic in catalog.Integrations.Where(i => i.Enabled && (i.SystemName ?? i.DisplayName) == system.SystemName))
                                        {
                                            <li><span class="iqr-mono">@(topic.EndpointOrTopic ?? topic.DisplayName)</span> — @(topic.Consumer.DisplayName ?? "Consumer not assigned") <span class="iqr-pill iqr-pill-muted">@IntegrationConfigurationRules.MappingLabel(topic.Consumer.MappingState)</span></li>
                                        }
                                    </ul>
                                </ReviewDisclosure>
                            }
                        </div>
                    </article>
                }
            </section>

            var (runtimeAvailable, runtimeTotal) = IntegrationReviewPrerunPresentation.RuntimeAvailability(readiness);
            var commonReason = IntegrationReviewPrerunPresentation.CommonUnavailableReason(readiness);
            <section class="iqr-card" aria-labelledby="iqr-evidence-heading" data-testid="iqr-evidence-sources">
                <h2 id="iqr-evidence-heading">Runtime evidence <span class="iqr-muted" data-testid="iqr-evidence-count">· @runtimeAvailable of @runtimeTotal available</span></h2>
                @if (readiness.EvidenceAdapters.Count == 0)
                {
                    <p class="iqr-muted" data-testid="iqr-no-evidence-sources">No platform is configured, so no runtime evidence source applies.</p>
                }
                else
                {
                    var sources = IntegrationReviewPrerunPresentation.RuntimeSources(readiness);
                    <ul class="iqr-sources" data-testid="iqr-evidence-list">
                        @for (var i = 0; i < sources.Count; i++)
                        {
                            var source = sources[i];
                            var adapter = readiness.EvidenceAdapters[i];
                            <li class="iqr-source" data-testid="iqr-evidence-source" data-source="@adapter.Source" data-state="@adapter.State">
                                <span class="iqr-pill iqr-pill-@IntegrationReviewResultPresentation.AdapterTone(adapter.State)">@IntegrationReviewLabels.EvidenceState(adapter.State)</span>
                                <span class="iqr-adapter-name">@source.Name@if (source.Platform is { } p) { <span class="iqr-muted"> · @p</span> }</span>
                                @if (commonReason is null && adapter.State != IntegrationEvidenceState.Available) { <span class="iqr-muted iqr-adapter-reason">@adapter.Reason</span> }
                            </li>
                        }
                    </ul>
                    @if (commonReason is not null) { <p class="iqr-muted" data-testid="iqr-evidence-common-reason">@commonReason</p> }
                    <div class="iqr-system-actions">
                        @if (runtimeAvailable < runtimeTotal) { <a class="iqr-link" href="@IntegrationReviewPrerunPresentation.Href(profile.Id, IntegrationReviewPrerunPresentation.FocusRuntime)" data-testid="iqr-configure-runtime">Configure runtime evidence</a> }
                        <ReviewDisclosure Text="View details" CollapseText="Hide details" TestId="iqr-evidence-details" Class="disclosure-inline">
                            <p class="iqr-muted">Configuration state only — nothing is contacted before the review runs. Each source is read-only and uses the BirkNext instance's own Azure identity.</p>
                            <div class="iqr-tablewrap" tabindex="0" role="region" aria-label="Runtime evidence source details">
                                <table class="iqr-table iqr-table-compact" data-testid="iqr-evidence-detail-table">
                                    <thead><tr><th scope="col">Source</th><th scope="col">State</th><th scope="col">Reason</th><th scope="col">Freshness</th><th scope="col">Last captured</th></tr></thead>
                                    <tbody>
                                        @foreach (var adapter in readiness.EvidenceAdapters)
                                        {
                                            <tr data-testid="iqr-evidence-detail-row"><td>@adapter.Adapter</td><td>@IntegrationReviewLabels.EvidenceState(adapter.State)</td><td>@adapter.Reason</td><td>Not read pre-run</td><td class="iqr-nowrap">@adapter.CapturedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </ReviewDisclosure>
                    </div>
                }
            </section>

            @if (readiness.ApplicationMessaging.Count > 0)
            {
                @* Application messaging (Wolverine) is source evidence beside the transport runtime sources — never counted among them. *@
                <section class="iqr-card" aria-labelledby="iqr-messaging-heading" data-testid="iqr-messaging">
                    <h2 id="iqr-messaging-heading">Application messaging</h2>
                    <ul class="iqr-sources iqr-messaging-list">
                        @foreach (var app in readiness.ApplicationMessaging)
                        {
                            <li class="iqr-messaging-item" data-testid="iqr-messaging-app" data-application="@app.ApplicationId">
                                <span><strong>@app.ApplicationId</strong> · @app.Technology · <span class="iqr-pill iqr-pill-@(app.Detection == MessagingDetection.Confirmed ? "observed" : "muted")" data-testid="iqr-messaging-detection">@(app.Detection == MessagingDetection.Confirmed ? "Configured" : ApplicationMessagingLabels.Detection(app.Detection))</span></span>
                                <span class="iqr-muted">Handler mapping @ApplicationMessagingLabels.Fact(app.HandlerMapping) · Retry policy @ApplicationMessagingLabels.Fact(app.RetryPolicy) · Outbox @ApplicationMessagingLabels.Fact(app.Outbox) · Error handling @ApplicationMessagingLabels.Fact(app.ErrorHandling)</span>
                                <span class="iqr-muted">@(app.BoundConsumer is { } consumer ? $"Bound to {consumer} ({app.BoundTopics} topic{(app.BoundTopics == 1 ? "" : "s")})." : "Not bound to an Integrations consumer, so it contributes no review checks.")</span>
                                <span class="iqr-muted" data-testid="iqr-messaging-copy">@ApplicationMessagingPresentation.PrerunCopy(app)</span>
                            </li>
                        }
                    </ul>
                    <a class="iqr-link" href="@IntegrationsHref(profile)" data-testid="iqr-messaging-manage">Manage in Target Environment → Integrations</a>
                </section>
            }

            <section class="iqr-card" aria-labelledby="iqr-domains-heading" data-testid="iqr-domain-readiness">
                <h2 id="iqr-domains-heading">What can be reviewed</h2>
                <ul class="iqr-domain-grid">
                    @foreach (var domain in readiness.Domains)
                    {
                        var action = IntegrationReviewPrerunPresentation.DomainAction(domain, readiness, profile.Id);
                        <li class="iqr-domain-card" data-testid="iqr-domain-readiness-card" data-domain="@domain.Domain" data-readiness="@domain.Readiness">
                            <div class="iqr-domain-head"><strong>@IntegrationReviewLabels.Domain(domain.Domain)</strong> <span class="iqr-pill iqr-pill-@IntegrationReviewResultPresentation.ReadinessTone(domain.Readiness)">@IntegrationReviewLabels.Readiness(domain.Readiness)</span></div>
                            <p class="iqr-muted" data-testid="iqr-domain-reason">@domain.Explanation</p>
                            @if (action is { } a) { <a class="iqr-link iqr-domain-action" href="@a.Href" data-testid="iqr-domain-action">@a.Label</a> }
                        </li>
                    }
                </ul>
            </section>

            @if (_history.Count > 0)
            {
                <ReviewDisclosure Text="Previous runs" CollapseText="Hide previous runs" Hint="@($"{_history.Count} run{(_history.Count == 1 ? "" : "s")}")" TestId="iqr-history" Class="iqr-detail-disclosure">
                    <p class="iqr-muted">Historical results. They do not change the current readiness above.</p>
                    <ul class="iqr-history" data-testid="iqr-history-list">
                        @foreach (var run in _history)
                        {
                            <li><button type="button" class="iqr-link" @onclick="() => OpenRunAsync(run.RunId)">@run.CompletedAt.ToString("yyyy-MM-dd HH:mm") UTC</button> — @IntegrationReviewLabels.Outcome(run.Outcome) · @run.Topics topic(s) · @run.Findings finding(s)</li>
                        }
                    </ul>
                </ReviewDisclosure>
            }
        }
    }
    else if (_result is { } result)
    {
        @* ── Post-run ── *@
        var headline = IntegrationReviewResultPresentation.Headline(result);
        <section class="iqr-card iqr-result" aria-labelledby="iqr-result-heading" data-testid="iqr-result">
            <h2 id="iqr-result-heading">Review result <span class="iqr-pill iqr-pill-@(result.Outcome == IntegrationReviewOutcome.Completed ? "ready" : "attention")" data-testid="iqr-outcome">@headline.Outcome</span></h2>
            <dl class="iqr-summary" data-testid="iqr-result-summary">
                <div><dt>Integration systems reviewed</dt><dd data-testid="iqr-result-systems">@headline.Systems</dd></div>
                <div><dt>Topics reviewed</dt><dd data-testid="iqr-result-topics">@headline.Topics</dd></div>
                <div><dt>Domains assessed</dt><dd data-testid="iqr-result-domains">@headline.DomainsAssessed of @headline.DomainsTotal</dd></div>
                <div><dt>Findings</dt><dd data-testid="iqr-result-findings">@headline.Findings</dd></div>
                <div><dt>Checks not assessed</dt><dd data-testid="iqr-result-not-assessed">@headline.NotAssessedChecks</dd></div>
                <div><dt>Evidence freshness</dt><dd data-testid="iqr-result-freshness">@headline.Freshness</dd></div>
                <div><dt>Review window</dt><dd data-testid="iqr-result-window">@headline.Window</dd></div>
            </dl>
            <p class="iqr-muted" data-testid="iqr-result-sources">Evidence sources: @headline.Sources. Configuration snapshot from @result.StartedAt.ToString("yyyy-MM-dd HH:mm") UTC — later edits in Integrations do not change this result.</p>
        </section>

        <div class="iqr-tabs" role="tablist" aria-label="Integration review result">
            @foreach (var tab in IntegrationReviewResultPresentation.Tabs)
            {
                <button type="button" role="tab" id="iqr-tab-btn-@Slug(tab)" class="iqr-tab @(_tab == tab ? "iqr-tab-active" : "")" aria-selected="@(_tab == tab ? "true" : "false")"
                        aria-controls="iqr-tabpanel" tabindex="@(_tab == tab ? "0" : "-1")" data-testid="iqr-tab-@Slug(tab)" @onclick="() => _tab = tab" @onkeydown="e => OnTabKey(e, tab)">@TabLabel(result, tab)</button>
            }
        </div>
        <div id="iqr-tabpanel" role="tabpanel" aria-labelledby="iqr-tab-btn-@Slug(_tab)" class="iqr-tabpanel" data-testid="iqr-tabpanel" data-tab="@_tab">
            @if (_tab == "Overview")
            {
                <ul class="iqr-domain-grid" data-testid="iqr-overview-domains">
                    @foreach (var domain in result.Domains)
                    {
                        <li class="iqr-domain-card" data-testid="iqr-domain-card" data-domain="@domain.Domain">
                            <div class="iqr-domain-head"><strong>@IntegrationReviewLabels.Domain(domain.Domain)</strong> <span class="iqr-pill iqr-pill-@IntegrationReviewResultPresentation.DomainTone(domain)" data-testid="iqr-domain-state">@domain.StateLabel</span></div>
                            <p data-testid="iqr-domain-coverage">@IntegrationReviewResultPresentation.Coverage(domain)@(domain.Findings > 0 ? $" · {domain.Findings} finding{(domain.Findings == 1 ? "" : "s")}" : "")</p>
                            @if (domain.KeyLimitation is { } limitation) { <p class="iqr-muted" data-testid="iqr-domain-limitation">@limitation</p> }
                        </li>
                    }
                </ul>
                <section class="iqr-card" aria-labelledby="iqr-adapters-heading" data-testid="iqr-result-adapters">
                    <h3 id="iqr-adapters-heading">Runtime evidence sources <span class="iqr-muted">· @IntegrationReviewResultPresentation.AdapterSummary(result.EvidenceAdapters)</span></h3>
                    @if (result.EvidenceAdapters.Count == 0)
                    {
                        <p class="iqr-muted">No runtime evidence source was consulted in this run.</p>
                    }
                    else
                    {
                        <ul class="iqr-adapters">
                            @foreach (var adapter in result.EvidenceAdapters)
                            {
                                <li class="iqr-adapter" data-testid="iqr-result-adapter" data-source="@adapter.Source" data-state="@adapter.State">
                                    <span class="iqr-adapter-name">@adapter.Adapter</span>
                                    <span class="iqr-pill iqr-pill-@IntegrationReviewResultPresentation.AdapterTone(adapter.State)">@IntegrationReviewLabels.EvidenceState(adapter.State)</span>
                                    <span class="iqr-muted iqr-adapter-reason">@adapter.Reason</span>
                                </li>
                            }
                        </ul>
                    }
                    @if (result.ContractSnapshot.Count > 0)
                    {
                        <p class="iqr-muted" data-testid="iqr-result-contracts">Contracts used: @string.Join("; ", result.ContractSnapshot.Select(c => $"{c.FileName} ({c.Role.ToString().ToLowerInvariant()}, sha256 {c.ShortHash})"))</p>
                    }
                </section>
                @if (result.ApplicationMessagingSnapshot is { } messaging && messaging.Applications.Any(a => a.BoundConsumer is not null))
                {
                    <section class="iqr-card" aria-labelledby="iqr-result-messaging-heading" data-testid="iqr-result-messaging">
                        <h3 id="iqr-result-messaging-heading">Application messaging</h3>
                        <p class="iqr-muted">Source analyzed @messaging.AnalyzedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC (snapshot used by this run). Configuration evidence is not runtime evidence.</p>
                        <ul>
                            @foreach (var app in messaging.Applications.Where(a => a.BoundConsumer is not null))
                            {
                                var runtime = result.ApplicationMessagingRuntime.FirstOrDefault(r => r.ApplicationId == app.ApplicationId);
                                <li data-testid="iqr-result-messaging-app"><strong>@app.ApplicationId</strong> (@app.BoundConsumer) — Wolverine @ApplicationMessagingLabels.Detection(app.Detection) · handler mapping @ApplicationMessagingLabels.Fact(app.HandlerMapping).ToLowerInvariant() · retry policy @ApplicationMessagingLabels.Fact(app.RetryPolicy).ToLowerInvariant() · runtime processing @(runtime is { State: IntegrationEvidenceState.Available } ? "observed" : $"not assessed ({runtime?.Reason ?? "no runtime read"})")</li>
                            }
                        </ul>
                    </section>
                }
                <section class="iqr-card" aria-labelledby="iqr-manual-heading" data-testid="iqr-manual">
                    <h3 id="iqr-manual-heading">Manual follow-up</h3>
                    <p class="iqr-muted">Tasks and gaps for a person — not defects.</p>
                    <ul>@foreach (var item in result.ManualFollowUp) { <li data-testid="iqr-manual-item"><strong>@item.Title</strong> (@item.AffectedCount) — @item.Detail</li> }</ul>
                </section>
                <section class="iqr-card" aria-labelledby="iqr-limitations-heading" data-testid="iqr-limitations">
                    <h3 id="iqr-limitations-heading">Review limitations</h3>
                    <ul>@foreach (var limitation in result.Limitations) { <li data-testid="iqr-limitation">@limitation</li> }</ul>
                </section>
            }
            else if (_tab == "Findings")
            {
                @if (result.Findings.Count == 0)
                {
                    <p class="iqr-empty" data-testid="iqr-no-findings">No findings on the assessed checks. Checks that could not be assessed are listed in their domain tabs, never as passes.</p>
                }
                else
                {
                    <div class="iqr-tablewrap" tabindex="0" role="region" aria-label="Findings">
                        <table class="iqr-table" data-testid="iqr-findings-table">
                            <thead><tr><th scope="col">Severity</th><th scope="col">Domain</th><th scope="col">Integration / topic</th><th scope="col">Finding</th><th scope="col">Evidence</th><th scope="col">Recommendation</th></tr></thead>
                            <tbody>
                                @foreach (var f in result.Findings)
                                {
                                    <tr data-testid="iqr-finding-row" data-rule="@f.RuleId">
                                        <td><span class="iqr-pill iqr-pill-fail">@f.Severity</span></td>
                                        <td>@IntegrationReviewLabels.Domain(f.Domain)</td>
                                        <td class="iqr-mono">@f.Subject@if (f.AffectedIntegrations.Count > 1) { <span class="iqr-muted"> · affects @f.AffectedIntegrations.Count topics</span> }</td>
                                        <td><strong>@f.Title</strong></td>
                                        <td>@string.Join(" ", f.Evidence)</td>
                                        <td>@f.Recommendation</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            else if (IntegrationReviewResultPresentation.DomainOf(_tab) is { } domain)
            {
                var domainResult = result.Domains.Single(d => d.Domain == domain);
                var rows = IntegrationReviewResultPresentation.Rows(result, domain);
                <p class="iqr-muted" data-testid="iqr-domain-note">@DomainNote(domain) @IntegrationReviewResultPresentation.Coverage(domainResult).</p>
                <h3 class="iqr-checks-heading" data-testid="iqr-checks-heading">@(domain == IntegrationReviewDomain.ErrorHandling ? "Error-handling checks" : $"{IntegrationReviewLabels.Domain(domain)} checks") (@rows.Count)</h3>
                <div class="iqr-tablewrap" tabindex="0" role="region" aria-label="@($"{IntegrationReviewLabels.Domain(domain)} checks")">
                    <table class="iqr-table" data-testid="iqr-checks-table">
                        <thead><tr><th scope="col">Subject</th><th scope="col">Check</th><th scope="col">Status</th><th scope="col">Evidence</th><th scope="col">Explanation</th><th scope="col">Source</th><th scope="col">Freshness</th></tr></thead>
                        <tbody>
                            @foreach (var row in rows)
                            {
                                <tr data-testid="iqr-check-row" data-check-id="@row.Check.CheckId" data-status="@row.Check.Status">
                                    <td class="iqr-mono">@row.Subject</td>
                                    <td>@row.Check.Title</td>
                                    <td><span class="iqr-pill iqr-pill-@IntegrationReviewResultPresentation.StatusTone(row.Check.Status)">@IntegrationReviewLabels.Status(row.Check.Status)</span></td>
                                    <td>@(string.IsNullOrWhiteSpace(row.Check.Evidence) ? "—" : row.Check.Evidence)</td>
                                    <td>@row.Check.Explanation@if (row.Check.Recommendation is { } rec) { <span class="iqr-muted"> Action: @rec</span> }</td>
                                    <td class="iqr-muted">@IntegrationReviewLabels.Source(row.Check.Provenance)</td>
                                    <td class="iqr-muted iqr-nowrap" data-testid="iqr-check-freshness">@IntegrationReviewResultPresentation.Freshness(row.Check)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

@code {
    private FrontendAnalysisProfile? _profile;
    private FrontendAnalysisContext? _context;
    private IntegrationReviewReadiness? _readiness;
    private IntegrationCatalog? _catalog;
    private IntegrationReviewResult? _result;
    private IReadOnlyList<IntegrationReviewRunSummary> _history = [];
    private string? _error;
    private bool _running;
    private string _tab = "Overview";

    protected override async Task OnInitializedAsync()
    {
        var context = await ContextFactory.GetActiveContextAsync();
        if (context.ActiveTargetError is { } targetError) { _error = targetError; return; }
        _context = context;
        _profile = context.ActiveProfile;
        await LoadReadinessAsync();
    }

    private async Task LoadReadinessAsync()
    {
        try
        {
            // Integrations still stored in the browser profile are imported once, so the review sees what the user configured.
            if (_profile!.Integrations.Count > 0) await Api.ImportLegacyAsync(_profile);
            _catalog = await Api.GetCatalogAsync(_profile!);
            _readiness = await Api.ReadinessAsync(_profile!);
            _history = await Api.HistoryAsync(_profile!.Id);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _error = "The BirkNext backend did not answer; configured integrations are stored by the backend.";
        }
    }

    private async Task RunAsync()
    {
        _running = true;
        _error = null;
        if (_context is not null) RuntimeReviews.MarkIntegrationQualityRunning(_context);
        try
        {
            _result = await Api.RunAsync(_profile!);
            _tab = "Overview";
            // The Dashboard card reads the session result; it shows outcome and coverage, never a score.
            if (_context is not null) RuntimeReviews.SaveIntegrationQualityResult(_result, _context);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _error = "The review could not be completed: the BirkNext backend did not answer.";
            if (_context is not null) RuntimeReviews.MarkIntegrationQualityFailed(_context, _error);
        }
        finally { _running = false; }
    }

    private async Task OpenRunAsync(Guid runId)
    {
        _result = await Api.GetRunAsync(runId);
        _tab = "Overview";
    }

    private async Task BackToSetup()
    {
        _result = null;
        await LoadReadinessAsync();
    }

    private async Task ExportHtml()
    {
        if (_result is null) return;
        var html = ExportService.ExportIntegrationReview(_result, Workspace.ProjectName);
        await JS.InvokeVoidAsync("downloadHtmlFile", $"integration-quality-review-{DateTime.UtcNow:yyyy-MM-dd}.html", html);
    }

    private void OnTabKey(KeyboardEventArgs e, string tab)
    {
        var tabs = IntegrationReviewResultPresentation.Tabs;
        var i = Array.IndexOf(tabs, tab);
        _tab = e.Key switch
        {
            "ArrowRight" => tabs[(i + 1) % tabs.Length],
            "ArrowLeft" => tabs[(i - 1 + tabs.Length) % tabs.Length],
            "Home" => tabs[0],
            "End" => tabs[^1],
            _ => _tab,
        };
    }

    private static string TabLabel(IntegrationReviewResult result, string tab) => tab == "Findings" ? $"Findings ({result.Findings.Count})" : tab;

    private static string DomainNote(IntegrationReviewDomain domain) => domain switch
    {
        IntegrationReviewDomain.Configuration => "Configured expectation only — never runtime proof.",
        IntegrationReviewDomain.Connectivity => "Safe runtime checks only: DNS, TCP and TLS to the namespace; no event is sent. Reachable is not message flow verified.",
        IntegrationReviewDomain.Contract => "Contract availability, compatibility and drift are separate; no contract evidence is Not assessed, never compatible.",
        IntegrationReviewDomain.MessageFlow => "Configured flow is not observed flow; no activity is \"no recent evidence\", never a failure.",
        IntegrationReviewDomain.Reliability => "Checkpoint and lag need a known consumer group and checkpoint evidence.",
        IntegrationReviewDomain.ErrorHandling => "Error-handling checks, not a list of errors: findings are listed under Findings.",
        IntegrationReviewDomain.Security => "Configured authentication is not runtime authorization.",
        IntegrationReviewDomain.Observability => "Monitoring configured is not monitoring healthy.",
        IntegrationReviewDomain.Performance => "Measured values only; configuration values are never performance evidence.",
        _ => "Structural event evidence only; payload values are never shown.",
    };

    private static string IntegrationsHref(FrontendAnalysisProfile profile) => IntegrationReviewPresentation.IntegrationsHref(profile.Id);

    private static string Slug(string value) => new string(value.Select(c => char.IsLetterOrDigit(c) ? char.ToLowerInvariant(c) : '-').ToArray());
}
