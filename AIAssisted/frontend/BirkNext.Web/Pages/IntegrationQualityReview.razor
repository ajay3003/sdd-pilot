@page "/integration-quality-review"
@using BirkNext.Web.Components
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@inject IIntegrationQualityReviewService ReviewService
@inject IFrontendAnalysisContextFactory ContextFactory
@inject RuntimeReviewSessionService RuntimeReviews
@inject IWorkspaceSessionService Workspace
@inject IReportExportService ExportService
@inject IJSRuntime JS
@inject IEndpointDiscoveryService Discovery

<PageTitle>Integration Quality Review</PageTitle>

<div class="iqr-page">
    <PageHeader Title="Integration Quality Review"
                Description="Review integrations between services for contract compatibility, message quality, reliability, errors, and runtime evidence." >
        @if (_report is not null)
        {
            <button type="button" class="btn-secondary" @onclick="ExportHtml" data-testid="iqr-export">Export HTML</button>
        }
    </PageHeader>

    @* ── Setup phase: target, evidence, readiness, run action ── *@
    @if (_report is null && !_running && _context is { } setup)
    {
        var scope = IntegrationReviewPresentation.Scope(setup.Integrations);
        var runtime = IntegrationReviewPresentation.RuntimeEvidence(setup.Integrations, CollectObservations(ReviewAuthenticationIdentity.ForContext(setup).ProfileId));
        var readiness = IntegrationReviewPresentation.Readiness(scope, runtime);
        var domains = IntegrationReviewPresentation.Domains(setup.Integrations, scope, runtime);

        @*
            1. Decide: which environment, which integrations, what evidence exists, can it run —
            then run it. Nothing diagnostic here; the inventory is one disclosure away below.
        *@
        <section class="iqr-decide" data-testid="iqr-decide" aria-label="Review setup">
            <div class="iqr-decide-cards">

                <section class="iqr-card iqr-target-card" data-testid="iqr-target" aria-labelledby="iqr-target-heading">
                    <div class="iqr-card-head">
                        <h2 id="iqr-target-heading">Target</h2>
                        <a class="iqr-link" href="@IntegrationReviewPresentation.TargetEnvironmentsHref" data-testid="iqr-configure-target">Open Target Environment</a>
                    </div>
                    @* Review readiness belongs to the Readiness card; repeating it here said the same thing twice. *@
                    <dl class="iqr-dl">
                        <div><dt>Environment</dt><dd><strong data-testid="iqr-env-name">@setup.ActiveProfile.Name</strong> <span class="iqr-pill iqr-pill-muted">@setup.ActiveProfile.EnvironmentType</span></dd></div>
                        <div><dt>Integrations</dt><dd data-testid="iqr-integration-count">@scope.Enabled of @scope.Configured enabled</dd></div>
                    </dl>
                    <ReviewDisclosure Text="View target details" CollapseText="Hide target details" TestId="iqr-target-details" Class="disclosure-inline">
                        <dl class="iqr-dl iqr-dl-technical">
                            <div><dt>Active environment</dt><dd>@setup.ActiveProfile.Name</dd></div>
                            <div><dt>Type</dt><dd>@setup.ActiveProfile.EnvironmentType</dd></div>
                            <div><dt>Authentication</dt><dd>@setup.ActiveProfile.ApiAuth.AuthType</dd></div>
                            <div><dt>Request timeout</dt><dd>@setup.RequestTimeoutSeconds seconds</dd></div>
                        </dl>
                    </ReviewDisclosure>
                </section>

                <section class="iqr-card iqr-scope-card" data-testid="iqr-scope" aria-labelledby="iqr-scope-heading">
                    <div class="iqr-card-head"><h2 id="iqr-scope-heading">Review scope</h2></div>
                    <p class="iqr-scope-headline" data-testid="iqr-scope-headline">@scope.Headline</p>
                    <p class="iqr-muted" data-testid="iqr-scope-enabled">@scope.EnabledLine</p>
                    @if (scope.Transports is { Length: > 0 } transports)
                    {
                        <p class="iqr-muted" data-testid="iqr-scope-transports">@transports</p>
                    }
                    @if (scope.IncompleteNote is { } incomplete)
                    {
                        <p class="iqr-muted" data-testid="iqr-scope-incomplete-note">@incomplete</p>
                    }
                </section>

                <section class="iqr-card iqr-evidence-card" data-testid="iqr-evidence" aria-labelledby="iqr-evidence-heading">
                    <div class="iqr-card-head"><h2 id="iqr-evidence-heading">Runtime evidence</h2></div>
                    @* Counted from observations only. Configuration, reachability and health checks
                       are not evidence that an integration ran. *@
                    <p class="iqr-evidence-headline" data-testid="iqr-runtime-headline">@runtime.Headline</p>
                    @if (runtime.MissingLine is { } missing)
                    {
                        <p class="iqr-muted" data-testid="iqr-runtime-missing">@missing</p>
                    }
                    @if (!runtime.MessagingTelemetryAvailable)
                    {
                        <p class="iqr-muted" data-testid="iqr-runtime-messaging">Messaging telemetry unavailable</p>
                    }
                </section>

                <section class="iqr-card iqr-readiness-card iqr-readiness-@readiness.Level.ToString().ToLowerInvariant()"
                         data-testid="iqr-readiness" data-readiness="@readiness.Level" aria-labelledby="iqr-readiness-heading"
                         role="@(readiness.Level == IntegrationReadinessLevel.Blocked ? "alert" : "status")">
                    <div class="iqr-card-head"><h2 id="iqr-readiness-heading">@readiness.Title</h2></div>
                    <p class="iqr-readiness-message" data-testid="iqr-readiness-message">@readiness.Message</p>
                    @if (readiness.Limitations.Count > 0 && readiness.Level != IntegrationReadinessLevel.Blocked)
                    {
                        @* While the review can still run, the individual limitations are what the reader opens. *@
                        <ReviewDisclosure Text="View limitations" CollapseText="Hide limitations" TestId="iqr-readiness-limitations" Class="disclosure-inline disclosure-small">
                            <ul class="iqr-readiness-items" data-testid="iqr-readiness-items">
                                @foreach (var limitation in readiness.Limitations)
                                {
                                    <li>@limitation</li>
                                }
                            </ul>
                            @if (readiness.ActionText is not null && readiness.ActionHref is not null)
                            {
                                <a class="iqr-link" href="@readiness.ActionHref" data-testid="iqr-readiness-action">@readiness.ActionText</a>
                            }
                        </ReviewDisclosure>
                    }
                    @if (readiness.Level == IntegrationReadinessLevel.Blocked)
                    {
                        @* While it is blocked the reasons stay visible: they are why the reader cannot proceed. *@
                        <ul class="iqr-readiness-items" data-testid="iqr-readiness-items">
                            @foreach (var limitation in readiness.Limitations)
                            {
                                <li>@limitation</li>
                            }
                        </ul>
                        <a class="btn-secondary" href="@readiness.ActionHref" data-testid="iqr-go-configure">@readiness.ActionText</a>
                    }
                </section>
            </div>

            <div class="iqr-run-row" data-testid="iqr-run-row">
                <button class="btn-primary" @onclick="RunReview" disabled="@(!readiness.CanRun || _running)" data-testid="iqr-run-review">
                    @(_running ? "Analysing..." : "Run Integration Quality Review")
                </button>
            </div>
        </section>

        @* 2. Scope: what the review covers, in review words rather than configuration words. *@
        <section class="iqr-section iqr-domains" data-testid="iqr-domains" aria-labelledby="iqr-domains-heading">
            <h2 id="iqr-domains-heading">What will be reviewed</h2>
            <ul class="iqr-domain-grid">
                @foreach (var domain in domains)
                {
                    <li>
                        <article class="iqr-card iqr-domain" data-testid="iqr-domain" data-domain="@domain.Key" data-state="@domain.State">
                            <div class="iqr-domain-head">
                                <h3>@domain.Title</h3>
                                <span class="iqr-pill iqr-pill-@IntegrationDomainStates.Tone(domain.State)" data-testid="iqr-domain-state">@IntegrationDomainStates.Label(domain.State)</span>
                            </div>
                            <p class="iqr-domain-purpose">@domain.Purpose</p>
                            @if (domain.Limitation is { Length: > 0 } limitation)
                            {
                                <p class="iqr-domain-limitation" data-testid="iqr-domain-limitation">@limitation</p>
                            }
                        </article>
                    </li>
                }
            </ul>
        </section>

        @* 3. Review details: the configuration behind the decision, collapsed. *@
        <section class="iqr-section iqr-details" data-testid="iqr-details" aria-labelledby="iqr-details-heading">
            <div class="iqr-card-head"><h2 id="iqr-details-heading">Review details</h2></div>

            <ReviewDisclosure Text="Configured integrations" CollapseText="Hide configured integrations"
                              Hint="@($"{scope.Configured} configured · {scope.Enabled} enabled")"
                              TestId="iqr-scope-disclosure" Class="iqr-detail-disclosure">
                @RenderIntegrationsByType(setup)
                <p class="iqr-muted"><a class="iqr-link" href="@IntegrationReviewPresentation.TargetEnvironmentsHref" data-testid="iqr-manage-scope">Manage integrations</a></p>
            </ReviewDisclosure>

            <ReviewDisclosure Text="Runtime observations" CollapseText="Hide runtime observations"
                              Hint="@runtime.Headline" TestId="iqr-runtime-disclosure" Class="iqr-detail-disclosure">
                @RenderEvidenceSummary(setup)
            </ReviewDisclosure>
        </section>
    }

    @if (_running)
    {
        <div class="iqr-progress" role="status" aria-live="polite" data-testid="iqr-progress">
            <span class="iqr-spinner" aria-hidden="true"></span>
            @_progressMessage
        </div>
    }

    @if (_errorMessage is not null)
    {
        <div class="iqr-error" role="alert" data-testid="iqr-error">@_errorMessage</div>
    }

    @* ── Results phase: summary, integrations, findings, etc ── *@
    @if (_report is not null)
    {
        var report = _report;
        var critical = report.Findings.Count(f => f.Severity == IntegrationFindingSeverity.Critical);
        var high = report.Findings.Count(f => f.Severity == IntegrationFindingSeverity.High);
        var medium = report.Findings.Count(f => f.Severity == IntegrationFindingSeverity.Medium);
        var low = report.Findings.Count(f => f.Severity == IntegrationFindingSeverity.Low);

        <section class="iqr-results" data-testid="iqr-results" aria-labelledby="iqr-results-heading">
            <h2 id="iqr-results-heading" class="iqr-visually-hidden">Review results</h2>

            @* ── Result Actions ── *@
            <div class="iqr-result-actions">
                <a href="/admin/system-settings" class="btn-secondary" data-testid="iqr-configure-btn">Configure Environments</a>
                <button class="btn-secondary" @onclick="RefreshContext" data-testid="iqr-refresh-btn">Refresh</button>
                <button class="btn-secondary" @onclick="ExportHtml" data-testid="iqr-export-btn">Export HTML</button>
                <button class="btn-primary" @onclick="RunReview" disabled="@_running" data-testid="iqr-rerun-btn">
                    @(_running ? "Analysing..." : "Run Review Again")
                </button>
            </div>

            @* ── Review Summary ── *@
            <div class="iqr-summary-card" data-testid="iqr-summary">
                <div class="iqr-summary-meta">
                    <div>
                        <span class="iqr-summary-label">Environment</span>
                        <strong data-testid="iqr-result-env">@report.EnvironmentName</strong>
                    </div>
                    <div>
                        <span class="iqr-summary-label">Generated</span>
                        <span data-testid="iqr-result-generated">@report.GeneratedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</span>
                    </div>
                </div>
                <div class="iqr-summary-counts">
                    <div class="iqr-summary-count">
                        <strong data-testid="iqr-total-integrations">@report.EnabledCount</strong>
                        <span>Integrations assessed</span>
                    </div>
                    <div class="iqr-summary-count">
                        <strong data-testid="iqr-available-contracts">@report.Statuses.Count(s => s.Enabled)</strong>
                        <span>Contracts available</span>
                    </div>
                    <div class="iqr-summary-count">
                        <strong data-testid="iqr-findings-critical">@critical</strong>
                        <span>Critical</span>
                    </div>
                    <div class="iqr-summary-count">
                        <strong data-testid="iqr-findings-high">@high</strong>
                        <span>High</span>
                    </div>
                    <div class="iqr-summary-count">
                        <strong data-testid="iqr-findings-medium">@medium</strong>
                        <span>Medium</span>
                    </div>
                    <div class="iqr-summary-count">
                        <strong data-testid="iqr-findings-low">@low</strong>
                        <span>Low</span>
                    </div>
                </div>
            </div>

            @* ── Findings ── *@
            <section class="iqr-card" data-testid="iqr-findings-section" aria-labelledby="iqr-findings-heading">
                <div class="iqr-card-head">
                    <h3 id="iqr-findings-heading">Findings</h3>
                </div>
                <div class="iqr-findings-toolbar">
                    <input type="search"
                           class="iqr-search"
                           placeholder="Search findings..."
                           value="@_findingSearch"
                           @oninput="e => _findingSearch = e.Value?.ToString() ?? string.Empty"
                           data-testid="iqr-findings-search" />
                    @foreach (var sev in Enum.GetValues<IntegrationFindingSeverity>())
                    {
                        var count = report.Findings.Count(f => f.Severity == sev);
                        if (count == 0) continue;
                        <button class="iqr-filter @(_severityFilter == sev ? "is-active" : "")"
                                @onclick="() => ToggleSeverity(sev)"
                                data-testid="iqr-severity-filter"
                                data-severity="@sev">
                            @sev <span>@count</span>
                        </button>
                    }
                    @if (_severityFilter is not null || !string.IsNullOrWhiteSpace(_findingSearch))
                    {
                        <button class="iqr-filter" @onclick="ClearFilters" data-testid="iqr-clear-filters">Clear</button>
                    }
                </div>

                @{ var findings = FilteredFindings(report.Findings).ToList(); }
                @if (findings.Count == 0)
                {
                    <div class="iqr-empty" data-testid="iqr-no-findings">No findings match the current filters.</div>
                }
                else
                {
                    <div class="iqr-findings-list">
                        @foreach (var finding in findings)
                        {
                            <div class="iqr-finding iqr-finding-@finding.Severity.ToString().ToLowerInvariant()" data-testid="iqr-finding" data-severity="@finding.Severity">
                                <div class="iqr-finding-head">
                                    <span class="iqr-sev iqr-sev-@finding.Severity.ToString().ToLowerInvariant()" data-testid="iqr-finding-severity">@finding.Severity</span>
                                    <strong data-testid="iqr-finding-title">@finding.Title</strong>
                                    <span data-testid="iqr-finding-integration">@finding.IntegrationName</span>
                                </div>
                                <p data-testid="iqr-finding-description">@finding.Description</p>
                                <div class="iqr-rec">
                                    <strong>Recommendation</strong>
                                    <p data-testid="iqr-finding-recommendation">@finding.Recommendation</p>
                                </div>
                                @if (finding.Evidence.Count > 0)
                                {
                                    <div class="iqr-evidence">
                                        @foreach (var evidence in finding.Evidence)
                                        {
                                            <code data-testid="iqr-finding-evidence">@evidence</code>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </section>

            @* ── Manual Review Obligations ── *@
            @if (report.Recommendations.Count > 0)
            {
                <section class="iqr-card iqr-manual-review" data-testid="iqr-manual-review" aria-labelledby="iqr-manual-heading">
                    <h3 id="iqr-manual-heading">Manual review still required</h3>
                    <div class="iqr-recommendations">
                        @{ var idx = 0; }
                        @foreach (var recommendation in report.Recommendations)
                        {
                            idx++;
                            <div class="iqr-recommendation" data-testid="iqr-recommendation" data-index="@idx">
                                <span>@idx</span>
                                <p data-testid="iqr-recommendation-text">@recommendation</p>
                            </div>
                        }
                    </div>
                </section>
            }

            @*
                Review details: how the review was executed and what it could reach. Supporting
                evidence for interpreting the findings above, never a competitor to them.
            *@
            <section class="iqr-section iqr-details" data-testid="iqr-result-details" aria-labelledby="iqr-result-details-heading">
                <div class="iqr-card-head"><h2 id="iqr-result-details-heading">Review details</h2></div>
            @* ── Overview Tab ── *@
            <section class="iqr-card" data-testid="iqr-overview" aria-labelledby="iqr-overview-heading">
                <h3 id="iqr-overview-heading">Overview</h3>
                <div class="iqr-table-wrap">
                    <table class="iqr-table" data-testid="iqr-overview-table">
                        <thead>
                            <tr>
                                <th>Integration</th>
                                <th>Type</th>
                                <th>Evidence</th>
                                <th>Contract</th>
                                <th>Drift</th>
                                <th>Status</th>
                                <th>Findings</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var status in report.Statuses.Where(s => s.Enabled).OrderBy(s => s.Name))
                            {
                                var findingCount = report.Findings.Where(f => f.IntegrationId == status.IntegrationId).Count();
                                var contractState = GetContractState(status);
                                <tr data-testid="iqr-overview-row" data-integration-id="@status.IntegrationId">
                                    <td data-testid="iqr-overview-name"><strong>@status.Name</strong></td>
                                    <td data-testid="iqr-overview-type">@status.Type</td>
                                    <td data-testid="iqr-overview-evidence">@GetEvidenceLabel(status)</td>
                                    <td data-testid="iqr-overview-contract">@contractState</td>
                                    <td data-testid="iqr-overview-drift">@GetDriftState(status)</td>
                                    <td data-testid="iqr-overview-assessment-status">
                                        @if (status.HasRequiredFields)
                                        {
                                            <span class="iqr-pill iqr-pill-ready">✓ Assessed</span>
                                        }
                                        else
                                        {
                                            <span class="iqr-pill iqr-pill-warning">⚠ Incomplete</span>
                                        }
                                    </td>
                                    <td data-testid="iqr-overview-findings">@findingCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @* History summary: concise by default, detail collapsed. *@
                <div class="iqr-history" data-testid="iqr-history">
                    <span class="iqr-history-label">History</span>
                    <span data-testid="iqr-history-summary">@ContractStatePresenter.History(report)</span>
                    @{
                        var persistenceNote = ContractStatePresenter.HistoryPersistenceNote(report);
                    }
                    @if (!string.IsNullOrWhiteSpace(persistenceNote))
                    {
                        <p class="iqr-history-warning" data-testid="iqr-history-persistence">@persistenceNote</p>
                    }
                    @if (report.HistoricalChanges.Count > 0)
                    {
                        <details data-testid="iqr-history-changes">
                            <summary>Changes since previous review (@report.HistoricalChangeCount)</summary>
                            <ul>
                                @foreach (var change in report.HistoricalChanges)
                                {
                                    <li>
                                        <strong>@ContractStatePresenter.HistoricalChangeLabel(change.Type):</strong>
                                        @change.Description
                                    </li>
                                }
                            </ul>
                        </details>
                    }
                </div>

                @* Contract detail: collapsed by default so the overview stays scannable. *@
                <div class="iqr-contract-details" data-testid="iqr-contract-details">
                    @foreach (var status in report.Statuses.Where(s => s.Enabled).OrderBy(s => s.Name))
                    {
                        <details data-testid="iqr-contract-detail" data-integration-id="@status.IntegrationId">
                            <summary>@status.Name — contract evidence</summary>
                            <dl class="iqr-dl">
                                <div><dt>Producer</dt><dd data-testid="iqr-contract-producer">@(status.ProducerService ?? "Not recorded")</dd></div>
                                <div><dt>Consumer</dt><dd data-testid="iqr-contract-consumer">@(status.ConsumerService ?? "Not recorded")</dd></div>
                                <div><dt>Producer contract source</dt><dd>@(status.ProducerContractSource ?? "Not recorded")</dd></div>
                                <div><dt>Consumer contract source</dt><dd>@(status.ConsumerContractSource ?? "Not recorded")</dd></div>
                                <div><dt>Compatibility</dt><dd data-testid="iqr-contract-compatibility">@GetContractState(status)</dd></div>
                                @{
                                    var compatDetail = GetContractStateDetail(status);
                                }
                                @if (!string.IsNullOrWhiteSpace(compatDetail))
                                {
                                    <div><dt>Compatibility detail</dt><dd data-testid="iqr-contract-compatibility-detail">@compatDetail</dd></div>
                                }
                                @if (status.CompatibilityComparedAt is { } comparedAt)
                                {
                                    <div><dt>Compared at</dt><dd data-testid="iqr-contract-compared-at">@comparedAt.ToString("yyyy-MM-dd HH:mm") UTC</dd></div>
                                }
                                <div><dt>Drift</dt><dd data-testid="iqr-contract-drift">@GetDriftState(status)</dd></div>
                                <div>
                                    <dt>Performance</dt>
                                    <dd data-testid="iqr-performance-state">@ContractStatePresenter.Performance(status)</dd>
                                </div>
                                @if (ContractStatePresenter.HasPerformanceEvidence(status))
                                {
                                    <div><dt>Latency p50</dt><dd data-testid="iqr-performance-p50">@ContractStatePresenter.Metric(status.Performance!.P50DurationMs, "ms")</dd></div>
                                    <div><dt>Latency p95</dt><dd data-testid="iqr-performance-p95">@ContractStatePresenter.Metric(status.Performance.P95DurationMs, "ms")</dd></div>
                                    <div><dt>Latency p99</dt><dd data-testid="iqr-performance-p99">@ContractStatePresenter.Metric(status.Performance.P99DurationMs, "ms")</dd></div>
                                    <div><dt>Errors</dt><dd data-testid="iqr-performance-errors">@ContractStatePresenter.ErrorRate(status)</dd></div>
                                    <div><dt>Throughput</dt><dd data-testid="iqr-performance-throughput">@ContractStatePresenter.Metric(status.Performance.RequestsPerSecond, "req/s")</dd></div>
                                    <div><dt>Observation window</dt><dd data-testid="iqr-performance-window">@ContractStatePresenter.ObservationWindow(status)</dd></div>
                                }
                                @if (status.PerformanceChanges.Count > 0)
                                {
                                    <div>
                                        <dt>Since previous review</dt>
                                        <dd data-testid="iqr-performance-changes">
                                            @string.Join("; ", status.PerformanceChanges
                                                .Select(ContractStatePresenter.PerformanceChangeLabel))
                                        </dd>
                                    </div>
                                }
                                @if (status.HistoricalChanges.Count > 0)
                                {
                                    <div>
                                        <dt>Changes since previous review</dt>
                                        <dd data-testid="iqr-contract-historical-changes">
                                            @string.Join("; ", status.HistoricalChanges
                                                .Select(c => ContractStatePresenter.HistoricalChangeLabel(c.Type)))
                                        </dd>
                                    </div>
                                }
                                @if (status.PreviousBaselineTimestamp is { } baselineAt)
                                {
                                    <div><dt>Previous baseline</dt><dd data-testid="iqr-contract-baseline-at">@baselineAt.ToString("yyyy-MM-dd HH:mm") UTC</dd></div>
                                }
                            </dl>

                            @if (status.CompatibilityDifferences.Count > 0)
                            {
                                <details data-testid="iqr-contract-compat-differences">
                                    <summary>Compatibility differences (@status.CompatibilityDifferences.Count)</summary>
                                    <ul>
                                        @foreach (var difference in status.CompatibilityDifferences)
                                        {
                                            <li><strong>@SeverityLabel(difference.Severity):</strong> @difference.Explanation</li>
                                        }
                                    </ul>
                                </details>
                            }

                            @if (status.DriftDifferences.Count > 0)
                            {
                                <details data-testid="iqr-contract-drift-differences">
                                    <summary>Drift differences (@status.DriftDifferences.Count)</summary>
                                    <ul>
                                        @foreach (var difference in status.DriftDifferences)
                                        {
                                            <li><strong>@SeverityLabel(difference.Severity):</strong> @difference.Explanation</li>
                                        }
                                    </ul>
                                </details>
                            }
                        </details>
                    }
                </div>
            </section>

            @* ── Authenticated Review Status ── *@
            @if (report.Authentication is { } auth)
            {
                <section class="iqr-card" data-testid="iqr-auth-section" aria-labelledby="iqr-auth-heading">
                    <h3 id="iqr-auth-heading">Authentication</h3>
                    <div class="iqr-auth-summary">
                        <div class="iqr-auth-item">
                            <span class="iqr-auth-label">Authenticated review available</span>
                            <span class="iqr-pill aqr-pill-@(auth.Capabilities.AuthenticatedRest ? "ready" : "unavailable")">
                                @(auth.Capabilities.AuthenticatedRest ? "✓ Yes" : "○ No")
                            </span>
                        </div>
                    </div>
                    @if (auth.Checks.Count > 0)
                    {
                        <div class="iqr-auth-checks" data-testid="iqr-auth-checks">
                            <p class="iqr-auth-checks-label">Health / Worker endpoints:</p>
                            <dl class="iqr-dl">
                                @foreach (var check in auth.Checks)
                                {
                                    <div><dt>@check.Label</dt><dd>@check.Outcome</dd></div>
                                }
                            </dl>
                        </div>
                    }
                </section>
            }


            @* ── Review Limitations ── *@
            @if (report.Limitations.Count > 0)
            {
                <section class="iqr-card iqr-limitations" data-testid="iqr-limitations" aria-labelledby="iqr-limitations-heading">
                    <div class="iqr-card-head">
                        <h3 id="iqr-limitations-heading">Review limitations</h3>
                    </div>
                    <p class="iqr-limitations-summary" data-testid="iqr-limitations-summary">The review is read-only and observes configured integrations and their readiness. Some aspects require manual verification.</p>
                    <ReviewDisclosure Text="View technical limitations" CollapseText="Hide technical limitations" TestId="iqr-limitations-details" Class="disclosure-inline">
                        <ul class="iqr-limitations-list">
                            @foreach (var limitation in report.Limitations)
                            {
                                <li data-testid="iqr-limitation">@limitation</li>
                            }
                        </ul>
                    </ReviewDisclosure>
                </section>
            }
            </section>
        </section>
    }
</div>

@code {
    private FrontendAnalysisContext? _context;
    private IntegrationQualityReport? _report;
    private bool _running;
    private string _progressMessage = "";
    private string? _errorMessage;
    private string? _findingSearch;
    private IntegrationFindingSeverity? _severityFilter;

    private bool _hasEnabledIntegrations =>
        _context?.Integrations.Any(i => i.Enabled) == true;

    protected override async Task OnInitializedAsync()
    {
        _context = await ContextFactory.GetActiveContextAsync();
        _report = RuntimeReviews.IntegrationQualityReview.Report;
    }

    private async Task RunReview()
    {
        if (_context is null || !_hasEnabledIntegrations) return;

        _running = true;
        _errorMessage = null;
        _report = null;
        _progressMessage = "Analysing configured integrations...";
        RuntimeReviews.MarkIntegrationQualityRunning(_context);
        StateHasChanged();

        try
        {
            var (report, error) = await ReviewService.AnalyzeAsync(BuildRequest(_context));
            if (error is not null)
            {
                _errorMessage = error;
                RuntimeReviews.MarkIntegrationQualityFailed(_context, error);
            }
            else if (report is not null)
            {
                _report = report;
                RuntimeReviews.SaveIntegrationQualityResult(report, _context);
                ClearFilters();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Review failed: " + ex.Message;
            RuntimeReviews.MarkIntegrationQualityFailed(_context, _errorMessage);
        }
        finally
        {
            _running = false;
        }
    }

    private async Task RefreshContext()
    {
        _context = await ContextFactory.GetActiveContextAsync();
    }

    private async Task ExportHtml()
    {
        if (_report is null) return;
        var html = ExportService.ExportIntegrationQualityReview(_report, Workspace.ProjectName);
        await JS.InvokeVoidAsync("downloadHtmlFile", $"integration-quality-review-{DateTime.UtcNow:yyyy-MM-dd}.html", html);
    }

    private IntegrationQualityRequest BuildRequest(FrontendAnalysisContext context)
    {
        var identity = ReviewAuthenticationIdentity.ForContext(context);
        return new()
        {
            EnvironmentName = context.ActiveProfile.Name,
            TimeoutSeconds = context.RequestTimeoutSeconds,
            Integrations = context.Integrations.Select(CloneIntegration).ToList(),
            AuthenticatedTestingMethod = identity.Method,
            ProfileId = identity.ProfileId,
            ContextFingerprint = identity.ContextFingerprint,
            RuntimeObservations = CollectObservations(identity.ProfileId),
        };
    }

    /// <summary>
    /// Traffic observed during the current Endpoint Discovery session, page-correlated plus
    /// shared. The backend derives performance from these; nothing is computed here.
    /// </summary>
    private List<BirkNext.LocalHttpsProxy.ObservedNetworkEndpoint>? CollectObservations(string? profileId)
    {
        // Discovery is optional in hosts that render the review without the discovery stack wired up.
        // No snapshot means no observations, which is exactly what "no runtime evidence" describes.
        if (string.IsNullOrWhiteSpace(profileId) || Discovery is null)
            return null;

        if (Discovery.GetSnapshot(profileId) is not { } snapshot) return null;

        var observed = snapshot.Pages
            .SelectMany(page => page.Endpoints)
            .Concat(snapshot.Shared)
            .ToList();

        return observed.Count > 0 ? observed : null;
    }

    private static IntegrationConfig CloneIntegration(IntegrationConfig source) => new()
    {
        Id = source.Id,
        Name = source.Name,
        Type = source.Type,
        Endpoint = source.Endpoint,
        Resource = source.Resource,
        Consumer = source.Consumer,
        AuthType = source.AuthType,
        HealthUrl = source.HealthUrl,
        WorkerUrl = source.WorkerUrl,
        MonitoringUrl = source.MonitoringUrl,
        Owner = source.Owner,
        Enabled = source.Enabled
    };

    private IEnumerable<IntegrationFinding> FilteredFindings(IReadOnlyList<IntegrationFinding> findings)
    {
        IEnumerable<IntegrationFinding> q = findings
            .OrderBy(f => f.Severity)
            .ThenBy(f => f.IntegrationName)
            .ThenBy(f => f.Title);

        if (_severityFilter.HasValue)
            q = q.Where(f => f.Severity == _severityFilter.Value);

        if (!string.IsNullOrWhiteSpace(_findingSearch))
        {
            var term = _findingSearch.Trim();
            q = q.Where(f =>
                f.Title.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                f.Description.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                f.Recommendation.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                f.IntegrationName.Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        return q;
    }

    private void ToggleSeverity(IntegrationFindingSeverity severity) =>
        _severityFilter = _severityFilter == severity ? null : severity;

    private void ClearFilters()
    {
        _severityFilter = null;
        _findingSearch = null;
    }

    private static string ReadinessTone(bool ready) => ready ? "ready" : "warning";

    private RenderFragment RenderIntegrationsByType(FrontendAnalysisContext context) => __builder =>
    {
        var integrations = context.Integrations.Where(i => i.Enabled).ToList();
        var types = new[] { IntegrationType.REST, IntegrationType.GraphQL, IntegrationType.EventHub, IntegrationType.ServiceBus, IntegrationType.Kafka, IntegrationType.RabbitMQ };

        foreach (var type in types)
        {
            var typeIntegrations = integrations.Where(i => i.Type == type).ToList();
            if (typeIntegrations.Count == 0) continue;

            var groupLabel = type switch
            {
                IntegrationType.GraphQL => "GraphQL integrations",
                IntegrationType.EventHub => "Event Hub integrations",
                IntegrationType.ServiceBus => "Service Bus integrations",
                IntegrationType.Kafka => "Kafka integrations",
                IntegrationType.RabbitMQ => "RabbitMQ integrations",
                _ => "REST integrations"
            };

            <div class="iqr-type-group" data-testid="iqr-type-group" data-type="@type">
                <h4 class="iqr-group-title" id="iqr-group-@type">@groupLabel (@typeIntegrations.Count)</h4>
                <ul class="iqr-integration-list" aria-labelledby="iqr-group-@type">
                    @foreach (var intg in typeIntegrations.OrderBy(i => i.Name))
                    {
                        <li class="iqr-integration-item" data-testid="iqr-integration-item" data-integration-id="@intg.Id">
                            <div class="iqr-integration-name">@intg.Name</div>
                            @if (!string.IsNullOrWhiteSpace(intg.Endpoint))
                            {
                                <div class="iqr-integration-endpoint">@intg.Endpoint</div>
                            }
                            @* Provenance and configuration completeness, read from the shared
                               presenter so the review cannot word them differently from the
                               Target Environment editor. Read-only: configuration is edited there. *@
                            <div class="iqr-integration-source" data-testid="iqr-scope-source">
                                Source: @IntegrationConfigPresenter.SourceLabel(intg.ConfigurationSource)
                            </div>
                            @{
                                var scopeMissing = IntegrationConfigPresenter.MissingRequiredFields(intg);
                            }
                            @if (scopeMissing.Count > 0)
                            {
                                <div class="iqr-integration-incomplete" data-testid="iqr-scope-incomplete">
                                    Configuration incomplete. Missing: @string.Join(", ", scopeMissing).
                                </div>
                            }
                            @if (type is IntegrationType.EventHub or IntegrationType.ServiceBus or IntegrationType.Kafka or IntegrationType.RabbitMQ)
                            {
                                @* The entity is what identifies a messaging integration. Without it
                                   an entry whose namespace is not yet known shows nothing a reviewer
                                   can recognise. *@
                                @if (!string.IsNullOrWhiteSpace(intg.Resource))
                                {
                                    <div class="iqr-integration-meta" data-testid="iqr-scope-resource">@intg.Resource</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(intg.Consumer))
                                {
                                    @* Labelled for what it is: Event Hub and Kafka carry a consumer
                                       group, Service Bus a subscription. Calling either "Consumer"
                                       would collide with the consuming service shown elsewhere. *@
                                    <div class="iqr-integration-meta" data-testid="iqr-scope-consumer-meta">
                                        @(type is IntegrationType.EventHub or IntegrationType.Kafka
                                            ? "Consumer group"
                                            : "Subscription"): @intg.Consumer
                                    </div>
                                }
                            }
                        </li>
                    }
                </ul>
            </div>
        }
    };

    private RenderFragment RenderEvidenceSummary(FrontendAnalysisContext context) => __builder =>
    {
        var enabled = context.Integrations.Where(i => i.Enabled).ToList();
        var contractCount = enabled.Count(i => !string.IsNullOrWhiteSpace(i.ContractName));
        var runtimeCount = enabled.Count; // All enabled integrations can potentially have runtime evidence

        <dl class="iqr-dl">
            <div>
                <dt>Configured integrations</dt>
                <dd data-testid="iqr-evidence-configured">@enabled.Count</dd>
            </div>
            <div>
                <dt>Contract schemas available</dt>
                <dd data-testid="iqr-evidence-contracts">@contractCount</dd>
            </div>
            <div>
                <dt>Runtime evidence available</dt>
                <dd data-testid="iqr-evidence-runtime">Depends on environment activity</dd>
            </div>
        </dl>
    };

    private RenderFragment RenderReadinessSummary(FrontendAnalysisContext context) => __builder =>
    {
        var enabled = context.Integrations.Count(i => i.Enabled);
        var missingRequired = context.Integrations.Count(i =>
            i.Enabled && (string.IsNullOrWhiteSpace(i.Name) ||
            (string.IsNullOrWhiteSpace(i.Endpoint) && string.IsNullOrWhiteSpace(i.Resource))));
        var readyCount = enabled - missingRequired;

        <div class="iqr-readiness-summary" data-testid="iqr-readiness-summary">
            <p><strong data-testid="iqr-ready-count">@readyCount</strong> of <strong>@enabled</strong> integrations are configured and ready.</p>
            @if (missingRequired > 0)
            {
                <p class="iqr-readiness-warning" data-testid="iqr-readiness-warning">@missingRequired integration(s) have missing required fields.</p>
            }
            else
            {
                <p class="iqr-readiness-success" data-testid="iqr-readiness-success">All enabled integrations are ready to review.</p>
            }
        </div>
    };

    private string GetEvidenceLabel(IntegrationStatus status) =>
        status.HealthReachable == true ? "Endpoint reachable" :
        status.WorkerReachable == true ? "Worker reachable" :
        "Not verified";

    // Delegates to the shared presenter so the page and the export cannot diverge.
    private string GetContractState(IntegrationStatus status) =>
        ContractStatePresenter.Compatibility(status);

    private string GetContractStateDetail(IntegrationStatus status) =>
        ContractStatePresenter.CompatibilityDetail(status);

    private string GetDriftState(IntegrationStatus status) =>
        ContractStatePresenter.Drift(status);

    private static string SeverityLabel(ContractDifferenceSeverity severity) =>
        ContractStatePresenter.SeverityLabel(severity);
}
