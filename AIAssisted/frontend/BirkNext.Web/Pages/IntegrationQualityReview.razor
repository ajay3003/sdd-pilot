@page "/integration-quality-review"
@using BirkNext.Web.Components
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@inject IIntegrationQualityReviewService ReviewService
@inject IFrontendAnalysisContextFactory ContextFactory
@inject RuntimeReviewSessionService RuntimeReviews
@inject IWorkspaceSessionService Workspace
@inject IReportExportService ExportService
@inject IJSRuntime JS

<PageTitle>Integration Quality Review</PageTitle>

<div class="iqr-page">
    <PageHeader Title="Integration Quality Review"
                Description="Deterministic readiness analysis for service integrations configured in the active Target Environment." />

    @if (_report is null)
    {
        <ReviewLanding Title="Run an integration readiness audit"
                       Description="Review configured REST, GraphQL, messaging, queue, and event integrations for configuration completeness, operational readiness, health checks, ownership, and deployment risk."
                       PrimaryButtonText="@(_running ? "Analysing..." : "Run Integration Quality Review")"
                       PrimaryRun="RunReview"
                       PrimaryDisabled="@(_running || _context is null || !_hasEnabledIntegrations)"
                       SecondaryActionText="Target Environments"
                       SecondaryActionHref="/admin/system-settings"
                       TargetFields="BuildTargetFields()"
                       Configuration="BuildConfiguration()"
                       AnalysisCards="IntegrationAnalysisCards"
                       Checks="IntegrationChecks"
                       Metadata="BuildMetadata()"
                       EstimatedDuration="1-3 minutes" />
    }

    @if (_report is not null)
    {
        <div class="iqr-target-summary">
            <div class="iqr-target-main">
                <span class="iqr-env-badge">@_report.EnvironmentName</span>
                <span>@_report.EnabledCount of @_report.IntegrationCount integrations enabled</span>
                <span>Generated @_report.GeneratedAt.ToString("yyyy-MM-dd HH:mm") UTC</span>
            </div>
            <div class="iqr-actions">
                <a href="/admin/system-settings" class="iqr-secondary">Configure Environments</a>
                <button class="iqr-secondary" @onclick="RefreshContext">Refresh</button>
                <button class="iqr-secondary" @onclick="ExportHtml">Export HTML</button>
                <button class="iqr-primary" @onclick="RunReview" disabled="@(_running || _context is null || !_hasEnabledIntegrations)">
                    @(_running ? "Analysing..." : "Run Review")
                </button>
            </div>
        </div>
    }

    @if (_running)
    {
        <div class="iqr-progress" role="status" aria-live="polite">
            <span class="iqr-spinner" aria-hidden="true"></span>
            @_progressMessage
        </div>
    }

    @if (_errorMessage is not null)
    {
        <div class="iqr-error" role="alert">@_errorMessage</div>
    }

    @if (_report is not null)
    {
        var report = _report;
        var critical = report.Findings.Count(f => f.Severity == IntegrationFindingSeverity.Critical);
        var high = report.Findings.Count(f => f.Severity == IntegrationFindingSeverity.High);
        var medium = report.Findings.Count(f => f.Severity == IntegrationFindingSeverity.Medium);
        var low = report.Findings.Count(f => f.Severity == IntegrationFindingSeverity.Low);

        <div class="iqr-score-card iqr-@ScoreClass(report.OverallScore)">
            <div>
                <div class="iqr-score">@report.OverallScore</div>
                <div class="iqr-score-label">Readiness score</div>
            </div>
            <div class="iqr-score-meta">
                <strong>@QualityLabel(report.OverallScore)</strong>
                <span>@(report.IsReadyForDeployment ? "Ready for deployment" : "Not ready for deployment")</span>
            </div>
            <div class="iqr-counts">
                @CountPill("Critical", critical, "critical")
                @CountPill("High", high, "high")
                @CountPill("Medium", medium, "medium")
                @CountPill("Low", low, "low")
            </div>
        </div>

        <SectionHeader Title="Configured Integrations" />
        <div class="iqr-table-wrap">
            <table class="iqr-table">
                <thead>
                    <tr>
                        <th>Integration</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Score</th>
                        <th>Health</th>
                        <th>Worker</th>
                        <th>Missing Fields</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var status in report.Statuses.OrderBy(s => s.Name))
                    {
                        <tr>
                            <td>@status.Name</td>
                            <td>@status.Type</td>
                            <td>
                                <span class="iqr-status @(status.Enabled ? "iqr-status-on" : "iqr-status-off")">
                                    @(status.Enabled ? "Enabled" : "Disabled")
                                </span>
                            </td>
                            <td><strong>@status.Score</strong></td>
                            <td>@ReachabilityLabel(status.HealthReachable)</td>
                            <td>@ReachabilityLabel(status.WorkerReachable)</td>
                            <td>
                                @if (status.MissingFields.Count == 0)
                                {
                                    <span class="iqr-muted">None</span>
                                }
                                else
                                {
                                    @string.Join(", ", status.MissingFields)
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        var topRisks = report.Findings
            .Where(f => f.Severity is IntegrationFindingSeverity.Critical or IntegrationFindingSeverity.High)
            .OrderBy(f => f.Severity)
            .ThenBy(f => f.IntegrationName)
            .ToList();
        @if (topRisks.Count > 0)
        {
            <SectionHeader Title="Top Risks" />
            <div class="iqr-risk-grid">
                @foreach (var risk in topRisks)
                {
                    <div class="iqr-risk iqr-risk-@risk.Severity.ToString().ToLowerInvariant()">
                        <div class="iqr-risk-head">
                            <span class="iqr-sev iqr-sev-@risk.Severity.ToString().ToLowerInvariant()">@risk.Severity</span>
                            <span>@risk.IntegrationName</span>
                        </div>
                        <h3>@risk.Title</h3>
                        <p>@risk.Description</p>
                        <strong>Recommendation</strong>
                        <p>@risk.Recommendation</p>
                    </div>
                }
            </div>
        }

        <SectionHeader Title="Findings" />
        <div class="iqr-findings-toolbar">
            <input type="search"
                   class="iqr-search"
                   placeholder="Search findings..."
                   value="@_findingSearch"
                   @oninput="e => _findingSearch = e.Value?.ToString() ?? string.Empty" />
            @foreach (var sev in Enum.GetValues<IntegrationFindingSeverity>())
            {
                var count = report.Findings.Count(f => f.Severity == sev);
                if (count == 0) continue;
                <button class="iqr-filter @(_severityFilter == sev ? "is-active" : "")"
                        @onclick="() => ToggleSeverity(sev)">
                    @sev <span>@count</span>
                </button>
            }
            @if (_severityFilter is not null || !string.IsNullOrWhiteSpace(_findingSearch))
            {
                <button class="iqr-filter" @onclick="ClearFilters">Clear</button>
            }
        </div>

        var findings = FilteredFindings(report.Findings).ToList();
        @if (findings.Count == 0)
        {
            <div class="iqr-empty">No findings match the current filters.</div>
        }
        else
        {
            <div class="iqr-findings-list">
                @foreach (var finding in findings)
                {
                    <div class="iqr-finding iqr-finding-@finding.Severity.ToString().ToLowerInvariant()">
                        <div class="iqr-finding-head">
                            <span class="iqr-sev iqr-sev-@finding.Severity.ToString().ToLowerInvariant()">@finding.Severity</span>
                            <strong>@finding.Title</strong>
                            <span>@finding.IntegrationName</span>
                        </div>
                        <p>@finding.Description</p>
                        <div class="iqr-rec">
                            <strong>Recommendation</strong>
                            <p>@finding.Recommendation</p>
                        </div>
                        @if (finding.Evidence.Count > 0)
                        {
                            <div class="iqr-evidence">
                                @foreach (var evidence in finding.Evidence)
                                {
                                    <code>@evidence</code>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @if (report.Recommendations.Count > 0)
        {
            <SectionHeader Title="Recommendations" />
            <div class="iqr-recommendations">
                @{ var idx = 0; }
                @foreach (var recommendation in report.Recommendations)
                {
                    idx++;
                    <div class="iqr-recommendation">
                        <span>@idx</span>
                        <p>@recommendation</p>
                    </div>
                }
            </div>
        }

        @if (report.Limitations.Count > 0)
        {
            <details class="iqr-details">
                <summary>Technical Details</summary>
                <ul>
                    @foreach (var limitation in report.Limitations)
                    {
                        <li>@limitation</li>
                    }
                </ul>
            </details>
        }
    }
</div>

@code {
    private FrontendAnalysisContext? _context;
    private IntegrationQualityReport? _report;
    private bool _running;
    private string _progressMessage = "";
    private string? _errorMessage;
    private string? _findingSearch;
    private IntegrationFindingSeverity? _severityFilter;

    private bool _hasEnabledIntegrations =>
        _context?.Integrations.Any(i => i.Enabled) == true;

    private static readonly ReviewLanding.AnalysisCard[] IntegrationAnalysisCards =
    [
        new("API", "Synchronous APIs", "Reviews REST, GraphQL, SOAP, and file integration configuration completeness."),
        new("MSG", "Messaging", "Checks Event Hub, Service Bus, Kafka, and RabbitMQ readiness signals."),
        new("HLT", "Health Checks", "Verifies configured health and worker probe endpoints where available."),
        new("SEC", "Authentication", "Flags missing or weak authentication configuration for service integrations."),
        new("OPS", "Ownership", "Highlights missing ownership and monitoring metadata needed for operations."),
        new("RDY", "QA Readiness", "Summarizes integration readiness and deployment risk."),
    ];

    private static readonly string[] IntegrationChecks =
    [
        "Configured integrations",
        "Required fields",
        "Health endpoint reachability",
        "Worker endpoint reachability",
        "Authentication type",
        "Integration ownership",
        "Monitoring URL",
        "Enabled/disabled status",
        "REST endpoints",
        "GraphQL endpoints",
        "Event Hub",
        "Service Bus",
        "Kafka",
        "RabbitMQ",
        "Deployment readiness",
    ];

    protected override async Task OnInitializedAsync()
    {
        _context = await ContextFactory.GetActiveContextAsync();
        _report = RuntimeReviews.IntegrationQualityReview.Report;
    }

    private async Task RunReview()
    {
        if (_context is null || !_hasEnabledIntegrations) return;

        _running = true;
        _errorMessage = null;
        _report = null;
        _progressMessage = "Analysing configured integrations...";
        RuntimeReviews.MarkIntegrationQualityRunning(_context);
        StateHasChanged();

        try
        {
            var (report, error) = await ReviewService.AnalyzeAsync(BuildRequest(_context));
            if (error is not null)
            {
                _errorMessage = error;
                RuntimeReviews.MarkIntegrationQualityFailed(_context, error);
            }
            else if (report is not null)
            {
                _report = report;
                RuntimeReviews.SaveIntegrationQualityResult(report, _context);
                ClearFilters();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Review failed: " + ex.Message;
            RuntimeReviews.MarkIntegrationQualityFailed(_context, _errorMessage);
        }
        finally
        {
            _running = false;
        }
    }

    private async Task RefreshContext()
    {
        _context = await ContextFactory.GetActiveContextAsync();
    }

    private async Task ExportHtml()
    {
        if (_report is null) return;
        var html = ExportService.ExportIntegrationQualityReview(_report, Workspace.ProjectName);
        await JS.InvokeVoidAsync("downloadHtmlFile", $"integration-quality-review-{DateTime.UtcNow:yyyy-MM-dd}.html", html);
    }

    private static IntegrationQualityRequest BuildRequest(FrontendAnalysisContext context) => new()
    {
        EnvironmentName = context.ActiveProfile.Name,
        TimeoutSeconds = context.RequestTimeoutSeconds,
        Integrations = context.Integrations.Select(CloneIntegration).ToList()
    };

    private static IntegrationConfig CloneIntegration(IntegrationConfig source) => new()
    {
        Id = source.Id,
        Name = source.Name,
        Type = source.Type,
        Endpoint = source.Endpoint,
        Resource = source.Resource,
        Consumer = source.Consumer,
        AuthType = source.AuthType,
        HealthUrl = source.HealthUrl,
        WorkerUrl = source.WorkerUrl,
        MonitoringUrl = source.MonitoringUrl,
        Owner = source.Owner,
        Enabled = source.Enabled
    };

    private IReadOnlyList<ReviewLanding.TargetField> BuildTargetFields()
    {
        if (_context is null)
        {
            return [new("Environment", "Loading...", ReviewLanding.FieldStatus.Informational)];
        }

        var total = _context.Integrations.Count;
        var enabled = _context.Integrations.Count(i => i.Enabled);
        var missingRequired = _context.Integrations.Count(i =>
            i.Enabled && (string.IsNullOrWhiteSpace(i.Name) || string.IsNullOrWhiteSpace(i.Endpoint) && string.IsNullOrWhiteSpace(i.Resource)));

        return
        [
            new("Environment", $"{_context.ActiveProfile.EnvironmentType} - {_context.ActiveProfile.Name}", ReviewLanding.FieldStatus.Configured),
            new("Configured integrations", total.ToString(), total > 0 ? ReviewLanding.FieldStatus.Configured : ReviewLanding.FieldStatus.Missing),
            new("Enabled integrations", enabled.ToString(), enabled > 0 ? ReviewLanding.FieldStatus.Configured : ReviewLanding.FieldStatus.Missing),
            new("Incomplete enabled integrations", missingRequired.ToString(), missingRequired == 0 ? ReviewLanding.FieldStatus.Configured : ReviewLanding.FieldStatus.Warning),
        ];
    }

    private IReadOnlyList<ReviewLanding.MetadataItem> BuildMetadata()
    {
        if (_context is null) return [];
        return
        [
            new("Environment", _context.ActiveProfile.EnvironmentType.ToString()),
            new("Authentication", _context.ActiveProfile.ApiAuth.AuthType.ToString()),
            new("Estimated duration", "1-3 minutes"),
        ];
    }

    private ReviewLanding.ConfigurationState BuildConfiguration()
    {
        if (_context is null)
        {
            return new(
                ReviewLanding.ConfigurationStatus.Warning,
                "Loading target environment",
                "The active target environment is still loading.",
                []);
        }

        if (!_hasEnabledIntegrations)
        {
            return new(
                ReviewLanding.ConfigurationStatus.Error,
                "Configuration incomplete",
                "Add at least one enabled integration to the active Target Environment before running the review.",
                ["At least one enabled integration"],
                "Configure Target Environment",
                "/admin/system-settings");
        }

        return new(
            ReviewLanding.ConfigurationStatus.Success,
            "Ready to run",
            "Integration configuration is sufficient for a quality review.",
            []);
    }

    private IEnumerable<IntegrationFinding> FilteredFindings(IReadOnlyList<IntegrationFinding> findings)
    {
        IEnumerable<IntegrationFinding> q = findings
            .OrderBy(f => f.Severity)
            .ThenBy(f => f.IntegrationName)
            .ThenBy(f => f.Title);

        if (_severityFilter.HasValue)
            q = q.Where(f => f.Severity == _severityFilter.Value);

        if (!string.IsNullOrWhiteSpace(_findingSearch))
        {
            var term = _findingSearch.Trim();
            q = q.Where(f =>
                f.Title.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                f.Description.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                f.Recommendation.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                f.IntegrationName.Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        return q;
    }

    private void ToggleSeverity(IntegrationFindingSeverity severity) =>
        _severityFilter = _severityFilter == severity ? null : severity;

    private void ClearFilters()
    {
        _severityFilter = null;
        _findingSearch = null;
    }

    private static string ScoreClass(int score) =>
        score >= 80 ? "score-good" : score >= 50 ? "score-warn" : "score-poor";

    private static string QualityLabel(int score) =>
        score >= 90 ? "Excellent" :
        score >= 80 ? "Good" :
        score >= 65 ? "Needs Attention" :
        score >= 50 ? "At Risk" : "Critical";

    private static string ReachabilityLabel(bool? value) => value switch
    {
        true => "Reachable",
        false => "Unreachable",
        null => "Not checked"
    };

    private RenderFragment CountPill(string label, int count, string variant) => __builder =>
    {
        if (count == 0) return;
        <div class="iqr-count iqr-count-@variant">
            <strong>@count</strong>
            <span>@label</span>
        </div>
    };
}
