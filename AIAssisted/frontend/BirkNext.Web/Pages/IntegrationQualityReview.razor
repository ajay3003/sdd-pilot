@page "/integration-quality-review"
@using BirkNext.Integrations
@using BirkNext.Web.Components
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@inject IIntegrationCatalogApiService Api
@inject IFrontendAnalysisContextFactory ContextFactory
@inject IWorkspaceSessionService Workspace
@inject IReportExportService ExportService
@inject RuntimeReviewSessionService RuntimeReviews
@inject IntegrationMappingEvidenceSession MappingEvidence
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IServiceProvider Services

<PageTitle>Integration Quality Review</PageTitle>

@* Integration Quality Review runs from the ENABLED integrations configured in Target Environment → Integrations (persisted by
   the backend). Endpoint Discovery keeps observed REST/GraphQL traffic; Browser Discovery keeps browser evidence. The review is
   read-only: no event is published or consumed, no checkpoint moved, no consumer group created. Configured expectation,
   runtime evidence, contract evidence and the review result are shown as four different things. *@
<div class="iqr-page">
    <PageHeader Title="Integration Quality Review"
                Description="@HeaderContext">
        @if (_result is not null)
        {
            <button type="button" class="btn-secondary" data-testid="iqr-back" @onclick="BackToSetup">Back to setup</button>
            <button type="button" class="btn-secondary" data-testid="iqr-export" @onclick="ExportHtml">Export HTML</button>
        }
    </PageHeader>

    @if (_error is { } error)
    {
        <div class="iqr-banner iqr-banner-error" role="alert" data-testid="iqr-error">@error</div>
    }

    @if (_profile is null && _error is null)
    {
        <p class="iqr-muted" role="status" data-testid="iqr-loading">Loading the active Target Environment…</p>
    }
    else if (_profile is { } profile && _result is null)
    {
        @* ── Pre-run ── Four views (?view=): Overview (the integration under review, its separate states, what needs attention, Run review),
           Setup & Evidence (integration, mappings, source / contract-reference / runtime evidence; advanced detail collapsed), Review (what can be
           reviewed now — capability-aware domains) and Test & Verify (active execution, test packs and their journeys, active tests, provider
           configuration). Review readiness and active-test readiness are separate; older ?view= links are mapped to these views. Known values are
           read from their owners (integration, binding, Test Pack reference) and never re-entered here. *@
        var subject = _readiness is { } loaded && !EnvironmentWide ? IntegrationReviewPrerunPresentation.Subject(loaded, _subjectId) : null;
        @if (_readiness is { Subjects.Count: > 1 } many)
        {
            @* The selection IS the review scope: the plan, the source evidence and the active-test providers are recomputed for it (?integration=). *@
            <label class="iqr-subject-select" data-testid="iqr-subject-select">Reviewing
                <select class="form-control" value="@(EnvironmentWide ? AllIntegrations : _subjectId)" @onchange="SelectSubjectAsync" data-testid="iqr-subject-selector">
                    @foreach (var item in many.Subjects) { <option value="@item.IntegrationId">@item.DisplayName · @IntegrationReviewPrerunPresentation.CapabilityLabel(item.Capability)</option> }
                    <option value="@AllIntegrations">All enabled integrations (environment-wide review)</option>
                </select>
            </label>
        }
        <nav class="iqr-views" aria-label="Integration Quality Review views" data-testid="iqr-views">
            @foreach (var (key, label) in IntegrationReviewPrerunPresentation.Views)
            {
                <a href="@ViewHref(key)" class="iqr-view @(CurrentView == key ? "iqr-view-active" : "")" aria-current="@(CurrentView == key ? "page" : null)" data-testid="@($"iqr-view-{key}")">@label</a>
            }
        </nav>
        @if (_readiness is null && _error is null)
        {
            <p class="iqr-muted" role="status" data-testid="iqr-integrations-loading">Loading configured integrations…</p>
        }

        @* ── Overview ── *@
        <section class="iqr-group" aria-labelledby="iqr-group-overview-heading" data-testid="iqr-group-overview" hidden="@(CurrentView != IntegrationReviewPrerunPresentation.OverviewView)">
            <h2 class="iqr-group-heading visually-hidden" id="iqr-group-overview-heading">Overview</h2>
            @if (_readiness is { } readiness)
            {
                @if (IntegrationReviewPrerunPresentation.NoEnabledIntegrations(readiness))
                {
                    <div class="iqr-card iqr-empty-state" data-testid="iqr-zero-integrations">
                        <p><strong>No configured integrations.</strong> Integration Quality Review assesses the integrations configured and enabled under Target Environment → Integrations.</p>
                        <a class="btn-primary" href="@IntegrationsHref(profile)" data-testid="iqr-zero-integrations-action">Open Target Environment → Integrations</a>
                    </div>
                }
                else if (subject is not null)
                {
                    @SubjectCard(subject, readiness)
                }
                @if (readiness.Subjects.Count > 0)
                {
                    @* Light mode: what needs a decision first; resolved integrations collapsed. Nothing is bound or chosen automatically. *@
                    var light = IntegrationReviewLightPresentation.Classify(readiness);
                    <section class="iqr-card" aria-labelledby="iqr-light-heading" data-testid="iqr-light">
                        <h3 id="iqr-light-heading" class="iqr-light-summary" data-testid="iqr-light-summary">@IntegrationReviewLightPresentation.Summary(light)</h3>
                        @if (light.Any(item => !item.Resolved))
                        {
                            <ul class="iqr-reasons" data-testid="iqr-light-open">
                                @foreach (var item in light.Where(item => !item.Resolved))
                                {
                                    <li data-testid="iqr-light-item" data-integration="@item.Subject.IntegrationId"><strong>@item.Subject.DisplayName</strong> — @item.Detail
                                        <a class="iqr-link" href="@Navigation.GetUriWithQueryParameter("integration", item.Subject.IntegrationId)" data-testid="iqr-light-resolve">Resolve</a></li>
                                }
                            </ul>
                        }
                        @if (light.Any(item => item.Resolved))
                        {
                            <ReviewDisclosure Text="Show resolved details" CollapseText="Hide resolved details" TestId="iqr-light-resolved" Class="disclosure-inline disclosure-small">
                                <ul class="iqr-reasons">@foreach (var item in light.Where(item => item.Resolved)) { <li data-testid="iqr-light-resolved-item">@item.Subject.DisplayName — @item.Detail</li> }</ul>
                            </ReviewDisclosure>
                        }
                    </section>
                }
                @if (!IntegrationReviewPrerunPresentation.NoEnabledIntegrations(readiness))
                {
                    var attention = IntegrationReviewPrerunPresentation.NeedsAttention(readiness, profile.Id);
                    var mappingEvidence = IntegrationReviewPrerunPresentation.MappingEvidence(_catalog, MappingEvidence.For(profile.Id));
                    <section class="iqr-card iqr-attention" aria-labelledby="iqr-readiness-heading" data-testid="iqr-readiness" data-headline="@readiness.Headline" data-state="@IntegrationReviewPrerunPresentation.ReadinessLabel(readiness)">
                        <h3 id="iqr-readiness-heading" class="visually-hidden">Readiness</h3>
                        @* Two readiness answers, never merged: can a read-only review assess it, and can an active scenario execute. *@
                        <dl class="iqr-readiness-pair" data-testid="iqr-readiness-pair">
                            <div><dt>Review</dt><dd><span class="iqr-pill iqr-pill-@(IntegrationReviewPrerunPresentation.ReadinessTone(readiness) switch { "ready" => "ready", "limited" => "attention", _ => "fail" })" data-testid="iqr-review-readiness">@IntegrationReviewPrerunPresentation.ReadinessLabel(readiness)</span></dd></div>
                            <div><dt>Active tests</dt><dd><span class="iqr-pill iqr-pill-@(_journeySummary is { Ready: > 0 } ? "ready" : "muted")" data-testid="iqr-active-tests-readiness">@ActiveTestsLabel</span>
                                <a class="iqr-link" href="@ViewHref(IntegrationReviewPrerunPresentation.TestView)" data-testid="iqr-open-test-verify">Test &amp; Verify</a></dd></div>
                        </dl>
                        @if (!readiness.CanRun)
                        {
                            <ul class="iqr-reasons" data-testid="iqr-readiness-reasons">@foreach (var reason in readiness.Reasons) { <li>@reason</li> }</ul>
                        }
                        else if (attention.Count > 0)
                        {
                            <h4 class="iqr-attention-heading" data-testid="iqr-attention-count">@attention.Count @(attention.Count == 1 ? "thing needs" : "things need") attention</h4>
                            <ul class="iqr-attention-list" data-testid="iqr-attention">
                                @foreach (var item in attention)
                                {
                                    <li class="iqr-attention-item" data-testid="iqr-attention-item" data-key="@item.Key">
                                        <span class="iqr-attention-label">@item.Label</span>
                                        <span class="iqr-attention-value">@item.Value</span>
                                        @if (item.ActionHref is { } href) { <a class="iqr-link" href="@href" data-testid="@($"iqr-action-{item.Key}")">@item.ActionLabel</a> }
                                        @if (item.Key == "mappings" && mappingEvidence is { } me)
                                        {
                                            <span class="iqr-attention-detail iqr-muted" data-testid="iqr-mapping-evidence">Evidence checks this session: @me.Tested tested@(me.Strong > 0 ? $" · {me.Strong} strong evidence, not confirmed" : "")@(me.Partial > 0 ? $" · {me.Partial} partial evidence" : "")@(me.NoSupport > 0 ? $" · {me.NoSupport} no supporting evidence" : "")@(me.NotTestable > 0 ? $" · {me.NotTestable} not testable" : "")@(me.Error > 0 ? $" · {me.Error} error" : "") · @me.NotTested not tested. Evidence never confirms a mapping.</span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        else { <p class="iqr-muted" data-testid="iqr-attention-none">Nothing limits the review that you can resolve here.</p> }
                        @RunBar(readiness, profile, "iqr-run")
                        @if (readiness.CanRun && readiness.Reasons.Count > 0)
                        {
                            <ReviewDisclosure Text="All limitation details" CollapseText="Hide limitation details" Hint="@($"{readiness.Reasons.Count} item{(readiness.Reasons.Count == 1 ? "" : "s")}")" TestId="iqr-limitation-details" Class="disclosure-inline">
                                <ul class="iqr-reasons" data-testid="iqr-readiness-reasons">@foreach (var reason in readiness.Reasons) { <li>@reason</li> }</ul>
                            </ReviewDisclosure>
                        }
                    </section>
                    <p class="iqr-muted" data-testid="iqr-coverage-link"><a class="iqr-link" href="@ViewHref(IntegrationReviewPrerunPresentation.ReviewView)">Review</a> shows what each review area can assess now; <a class="iqr-link" href="@ViewHref(IntegrationReviewPrerunPresentation.SetupView)">Setup &amp; Evidence</a> shows where each value comes from.</p>
                }
                @if (_history.Count > 0)
                {
                    <ReviewDisclosure Text="Previous runs" CollapseText="Hide previous runs" Hint="@($"{_history.Count} run{(_history.Count == 1 ? "" : "s")}")" TestId="iqr-history" Class="iqr-detail-disclosure">
                        <p class="iqr-muted">Historical results. They do not change the current readiness above.</p>
                        <ul class="iqr-history" data-testid="iqr-history-list">
                            @foreach (var run in _history)
                            {
                                <li><button type="button" class="iqr-link" @onclick="() => OpenRunAsync(run.RunId)">@run.CompletedAt.ToString("yyyy-MM-dd HH:mm") UTC</button> — @IntegrationReviewLabels.Outcome(run.Outcome) · @run.Topics topic(s) · @run.Findings finding(s)</li>
                            }
                        </ul>
                    </ReviewDisclosure>
                }
            }
        </section>

        @* ── Setup & Evidence ── *@
        <section class="iqr-group" aria-labelledby="iqr-group-evidence-heading" data-testid="iqr-group-evidence" hidden="@(CurrentView != IntegrationReviewPrerunPresentation.SetupView)">
            <h2 class="iqr-group-heading" id="iqr-group-evidence-heading">Setup &amp; Evidence</h2>
            <p class="iqr-muted">Values known from their owners are shown with where they come from and are never re-entered here. Edit the integration in Target Environment → Integrations.</p>
            @{ var snapshots = _readiness?.AvailableSourceSnapshots ?? []; var enabled = (_catalog?.Integrations ?? []).Where(i => i.Enabled).ToList(); var bound = _bindings.Where(b => enabled.Any(i => i.Id == b.IntegrationId)).ToList(); }
            <div class="iqr-stages" role="list" aria-label="Setup and evidence" data-testid="iqr-evidence-stages">
                <div role="listitem" class="iqr-stage" data-testid="iqr-stage" data-stage="integration">
                    <h3 class="iqr-stage-title"><span class="iqr-stage-number" aria-hidden="true">1</span> Integration
                        <span class="iqr-pill iqr-pill-@(enabled.Count > 0 ? "ready" : "muted")" data-testid="iqr-stage-status">@(enabled.Count > 0 ? "Configured" : "Not configured")</span></h3>
                    @if (enabled.Count == 0)
                    {
                        <p class="iqr-muted">No integration is enabled. Integrations are configured in Target Environment → Integrations.</p>
                        <a class="iqr-link" href="@IntegrationsHref(profile)" data-testid="iqr-stage-integrations-action">Open Target Environment → Integrations</a>
                    }
                    else if (subject is not null && _catalog?.Integrations.FirstOrDefault(i => i.Id == subject.IntegrationId) is { } definition)
                    {
                        <p><strong data-testid="iqr-setup-integration-name">@definition.DisplayName</strong> <span class="iqr-muted">· @IntegrationReviewPrerunPresentation.SubjectLine(subject)</span></p>
                        <dl class="iqr-known" data-testid="iqr-setup-integration">
                            @Known("Endpoint", definition.EndpointOrTopic, "configured integration")
                            @Known("Producer", definition.Producer, "configured integration")
                            @Known("Consumer", definition.Consumer.DisplayName, "configured integration")
                            <div data-testid="iqr-known" data-field="Consumer mapping"><dt>Consumer mapping</dt><dd>@IntegrationConfigurationRules.MappingLabel(definition.Consumer.MappingState)
                                @if (definition.Consumer.MappingState != ConsumerMappingState.Confirmed) { <a class="iqr-link" href="@IntegrationReviewPrerunPresentation.Href(profile.Id, IntegrationReviewPrerunPresentation.FocusMappings)" data-testid="iqr-setup-confirm-mapping">Confirm consumer mapping</a> }</dd></div>
                        </dl>
                        <p class="iqr-muted"><a class="iqr-link" href="@IntegrationsHref(profile)" data-testid="iqr-setup-edit-integration">Edit in Target Environment → Integrations</a> · @enabled.Count enabled integration@(enabled.Count == 1 ? "" : "s")</p>
                    }
                </div>
                <div role="listitem" class="iqr-stage" data-testid="iqr-stage" data-stage="binding">
                    @{ var facts = subject?.Facts; }
                    <h3 class="iqr-stage-title" id="iqr-source-summary-heading"><span class="iqr-stage-number" aria-hidden="true">2</span> Source evidence
                        @* Stored snapshots that nothing binds yet are available, not missing: Missing only when there is nothing to bind. *@
                        @{ var stageBound = subject is null ? bound.Count : bound.Count(b => b.IntegrationId == subject.IntegrationId); var stageTotal = subject is null ? enabled.Count : 1; }
                        <span class="iqr-pill iqr-pill-@(stageBound == 0 ? "muted" : stageBound < stageTotal ? "attention" : "ready")" data-testid="iqr-stage-status">Source evidence: @(enabled.Count == 0 ? "Not applicable" : stageBound == 0 ? snapshots.Count == 0 ? "Missing" : BirkNext.Web.Services.ProjectImport.SourceSetupPresentation.AvailableNeedsBinding : stageBound < stageTotal ? "Partial" : "Bound")</span></h3>
                    @if (facts?.SourceRole is { } role)
                    {
                        <dl class="iqr-known" data-testid="iqr-source-role">
                            <div><dt>@role matches</dt><dd data-testid="iqr-source-matches">@facts.SourceMatches</dd></div>
                            <div><dt>Canonical binding</dt><dd data-testid="iqr-source-binding">@(facts.BoundArchive ?? "None yet")</dd></div>
                        </dl>
                    }
                    @if (subject is not null)
                    {
                        var own = bound.FirstOrDefault(b => b.IntegrationId == subject.IntegrationId);
                        var scope = _readiness?.SourceScopes.FirstOrDefault(s => s.IntegrationId == subject.IntegrationId);
                        <section class="iqr-own-evidence" aria-labelledby="iqr-own-evidence-heading" data-testid="iqr-own-evidence" data-integration="@subject.IntegrationId">
                            <h4 id="iqr-own-evidence-heading">Canonical source evidence for @subject.DisplayName</h4>
                            <dl class="iqr-known">
                                <div><dt>Source binding</dt><dd data-testid="iqr-own-binding">@if (own is null) { <span>Not bound</span> } else { <span class="iqr-mono">@own.ArchiveName</span> <span class="iqr-muted">· bound</span> }</dd></div>
                                <div><dt>Integration-specific evidence</dt><dd data-testid="iqr-own-correlation" data-resolved="@(scope?.EvidenceResolved == true ? "true" : "false")">@IntegrationReviewPrerunPresentation.CorrelationLabel(scope, own is not null)</dd></div>
                            </dl>
                            @if (scope is { Summary.Length: > 0 }) { <p class="iqr-muted" data-testid="iqr-own-summary">@scope.Summary</p> }
                            @if (scope is { EvidenceResolved: true } && (scope.RepositoryRules > scope.IntegrationRules || scope.RepositoryTests > scope.IntegrationTests))
                            {
                                <p class="iqr-muted" data-testid="iqr-own-repository-context">Repository context (not evidence for this integration): @scope.RepositoryRules rule(s), @scope.RepositoryTests developer test(s) in the snapshot.</p>
                            }
                            @if (own is not null) { <a class="iqr-link" href="@($"source-analysis?snapshot={own.SnapshotId}")">Open source evidence</a> }
                        </section>
                    }
                    @if (bound.Count > 0 && subject is not null && bound.Any(b => b.IntegrationId != subject.IntegrationId))
                    {
                        <ReviewDisclosure Text="@($"Other {profile.Name} integration bindings ({bound.Count(b => b.IntegrationId != subject.IntegrationId)})")" CollapseText="Hide other bindings" TestId="iqr-other-bindings" Class="disclosure-inline">
                            <ul class="iqr-bindings" data-testid="iqr-bindings">
                                @foreach (var binding in bound.Where(b => b.IntegrationId != subject.IntegrationId))
                                {
                                    <li data-testid="iqr-binding" data-integration="@binding.IntegrationId" data-snapshot="@binding.SnapshotId">
                                        <strong>@(enabled.First(i => i.Id == binding.IntegrationId).DisplayName)</strong> → <span class="iqr-mono">@binding.ArchiveName</span>
                                    </li>
                                }
                            </ul>
                        </ReviewDisclosure>
                    }
                    else if (bound.Count > 0 && subject is null)
                    {
                        <ul class="iqr-bindings" data-testid="iqr-bindings">
                            @foreach (var binding in bound)
                            {
                                <li data-testid="iqr-binding" data-integration="@binding.IntegrationId" data-snapshot="@binding.SnapshotId">
                                    <strong>@(enabled.First(i => i.Id == binding.IntegrationId).DisplayName)</strong> → <span class="iqr-mono">@binding.ArchiveName</span>
                                    <a class="iqr-link" href="@($"source-analysis?snapshot={binding.SnapshotId}")">Open evidence</a>
                                    @if (snapshots.All(item => item.Id != binding.SnapshotId)) { <span class="iqr-pill iqr-pill-attention" data-testid="iqr-binding-missing">Snapshot no longer stored — review required</span> }
                                </li>
                            }
                        </ul>
                    }
                    @if (subject is not null && _journeyViews.Where(v => v.MatchedIntegrations.Any(m => m.IntegrationId == subject.IntegrationId)).ToList() is { Count: > 0 } usedBy)
                    {
                        @* Secondary to the evidence above: which guided journeys use this integration, and where their setup continues. *@
                        <div class="iqr-journey-setup" data-testid="iqr-journey-setup">
                            <h4>Journey setup</h4>
                            <ul class="iqr-plain">
                                @foreach (var used in usedBy)
                                {
                                    var packId = _journeyPacks.GetValueOrDefault(used.Journey.JourneyId) ?? "";
                                    var setup = JourneySetupModel.Build(packId, used);
                                    <li data-testid="iqr-journey-setup-item" data-journey="@used.Journey.JourneyId">Used by @used.Journey.DisplayName · setup @setup.RequiredReady of @setup.RequiredSteps ready
                                        @if (TestPackPresentation.PageHref(packId) is { } page) { <a class="iqr-link" href="@($"{page}?tab={used.Journey.JourneyId}&setup=continue")" data-testid="iqr-journey-setup-continue">Continue journey setup</a> }</li>
                                }
                            </ul>
                        </div>
                    }
                    @if (bound.Count == 0) { <p class="iqr-muted" data-testid="iqr-bound-empty">No source evidence is bound yet. Choose one snapshot per integration; the newest is never chosen for you.</p> }
                    <div data-testid="iqr-source-evidence">
                        <ReviewDisclosure Text="@(subject is not null ? bound.Any(b => b.IntegrationId == subject.IntegrationId) ? "Change canonical source evidence" : "Bind canonical source evidence" : bound.Count > 0 ? "Change source evidence" : "Choose source evidence")" CollapseText="Hide source evidence" TestId="iqr-source-details" Class="disclosure-inline" @bind-Expanded="_sourceSetupOpen">
                            <p class="iqr-muted" data-testid="iqr-source-summary">@SourceSummary(snapshots.Count, bound.Count)</p>
                            <p class="iqr-muted">One immutable Source Analysis snapshot per integration. This binding is the canonical source evidence: test packs and providers read it instead of choosing a snapshot of their own, and a newer snapshot never replaces it until you bind it. Choosing contacts nothing.</p>
                            <IqrSourceSetup ShowHeading="false" EnvironmentId="@profile.Id" Integrations="@(_catalog?.Integrations ?? [])" Snapshots="@snapshots" Selections="_sourceSelections" Analyzed="BindingsChangedAsync" BusyChanged="@(busy => _sourceBusy = busy)" SelectedIntegrationId="@subject?.IntegrationId" />
                        </ReviewDisclosure>
                    </div>
                </div>
                <div role="listitem" class="iqr-stage" data-testid="iqr-stage" data-stage="contracts"><div data-testid="iqr-contracts">
                    @{ var breakdown = subject is null ? null : IntegrationReviewPrerunPresentation.Contract(subject); var contractRow = _readiness?.Domains.FirstOrDefault(d => d.Domain == IntegrationReviewDomain.Contract); }
                    <h3 class="iqr-stage-title" id="iqr-contracts-heading"><span class="iqr-stage-number" aria-hidden="true">3</span> Contract/reference evidence
                        @if (contractRow is not null) { <span class="iqr-pill iqr-pill-@IntegrationReviewResultPresentation.ReadinessTone(contractRow.Readiness)" data-testid="iqr-stage-status">@IntegrationReviewLabels.Readiness(contractRow.Readiness)</span> }</h3>
                    @if (breakdown is { } b && (b.Available.Count > 0 || subject?.Facts is not null))
                    {
                        <div class="iqr-breakdown" data-testid="iqr-contract-breakdown">
                            <div><p class="iqr-domain-list-label">Available</p>
                                @if (b.Available.Count == 0) { <p class="iqr-muted">Nothing yet.</p> }
                                else { <ul class="iqr-domain-list" data-testid="iqr-contract-available">@foreach (var item in b.Available) { <li>@item</li> }</ul> }</div>
                            <div><p class="iqr-domain-list-label">Missing / not verified</p>
                                <ul class="iqr-domain-list iqr-domain-list-missing" data-testid="iqr-contract-missing">@foreach (var item in b.NotVerified) { <li>@item</li> }</ul></div>
                        </div>
                    }
                    else { <p class="iqr-muted">Integration contracts (XSD, JSON Schema, OpenAPI, AsyncAPI, WSDL, Protobuf, GraphQL schema) are discovered per side from each integration's bound snapshot in Target Environment → Integrations; uploading is the fallback. Configured is not observed.</p> }
                    @if (subject is not null && _pair is { } pair && pair.IntegrationId == subject.IntegrationId)
                    {
                        @* The producer ↔ consumer pair, each side an exact artifact (snapshot + path) or explicitly unresolved; never confirmed by a name. *@
                        <section class="iqr-contract-pair" aria-labelledby="iqr-contract-pair-heading" data-testid="iqr-contract-pair" data-state="@pair.State">
                            <h4 id="iqr-contract-pair-heading">Contract relationship</h4>
                            <dl class="iqr-known">
                                <div><dt>Producer contract</dt><dd data-testid="iqr-contract-pair-producer">@(pair.Producer is { } producer ? $"{producer.Path} · {producer.ArchiveName}" : $"{pair.ProducerReference ?? "Not configured"} · no exact artifact")</dd></div>
                                <div><dt>Consumer contract</dt><dd data-testid="iqr-contract-pair-consumer">@(pair.Consumer is { } consumer ? $"{consumer.Path} · {consumer.ArchiveName}" : $"{pair.ConsumerReference ?? "Not configured"} · no exact artifact")</dd></div>
                                <div><dt>Relationship review</dt><dd data-testid="iqr-contract-pair-state">@BirkNext.ContractSchemaEvidence.ContractRelationshipComparer.Label(pair.State)</dd></div>
                            </dl>
                            <p class="iqr-muted" data-testid="iqr-contract-pair-summary">@pair.Summary</p>
                            @if (IntegrationReviewPrerunPresentation.SchemaStudioHref(pair, profile.Id) is { } studio)
                            {
                                <a class="iqr-link" href="@studio" data-testid="iqr-contract-pair-studio">Review contract pair in Schema Studio</a>
                            }
                        </section>
                    }
                    <div class="iqr-system-actions">
                        <a class="iqr-link" href="@IntegrationReviewPrerunPresentation.Href(profile.Id, IntegrationReviewPrerunPresentation.FocusContracts)" data-testid="iqr-manage-contracts">Manage contract references in Integrations</a>
                    </div>
                </div></div>
                <div role="listitem" class="iqr-stage" data-testid="iqr-stage" data-stage="runtime">
                    <h3 class="iqr-stage-title" id="iqr-evidence-heading"><span class="iqr-stage-number" aria-hidden="true">4</span> Runtime evidence</h3>
                    @if (_readiness is { } evidence)
                    {
                        var (runtimeAvailable, runtimeTotal) = IntegrationReviewPrerunPresentation.RuntimeAvailability(evidence);
                        var commonReason = IntegrationReviewPrerunPresentation.CommonUnavailableReason(evidence);
                        <div class="iqr-stage-body" data-testid="iqr-evidence-sources">
                            <p data-testid="iqr-evidence-count-line">Runtime evidence · <span data-testid="iqr-evidence-count">@(runtimeTotal == 0 ? "Not verified — no supported or configured runtime evidence provider currently applies to this integration" : $"{runtimeAvailable} of {runtimeTotal} available")</span></p>
                            @if (evidence.RuntimeSourcesTotal > 0)
                            {
                                @* Configured sources and Azure execution are two facts: Azure off is an instance setting, never an integration misconfiguration. *@
                                <p data-testid="iqr-azure-runtime" data-azure="@(evidence.AzureRuntimeEnabled ? "enabled" : "disabled")">@IntegrationReviewPrerunPresentation.AzureRuntimeLine(evidence)@if (!evidence.AzureRuntimeEnabled && evidence.AzureRuntimeReason is { } azureReason) { <span class="iqr-muted"> — @azureReason Not an integration misconfiguration.</span> }</p>
                            }
                            @if (evidence.EvidenceAdapters.Count > 0)
                            {
                                var sources = IntegrationReviewPrerunPresentation.RuntimeSources(evidence);
                                @if (commonReason is not null && commonReason != evidence.AzureRuntimeReason) { <p class="iqr-muted" data-testid="iqr-evidence-common-reason">@commonReason</p> }
                                <div class="iqr-system-actions">
                                    @if (runtimeAvailable < runtimeTotal) { <a class="iqr-link" href="@IntegrationReviewPrerunPresentation.Href(profile.Id, IntegrationReviewPrerunPresentation.FocusRuntime)" data-testid="iqr-configure-runtime">Configure runtime evidence</a> }
                                    <ReviewDisclosure Text="@($"View {sources.Count} runtime evidence source{(sources.Count == 1 ? "" : "s")}")" CollapseText="Hide runtime evidence sources" TestId="iqr-evidence-details" Class="disclosure-inline">
                                        <ul class="iqr-sources" data-testid="iqr-evidence-list">
                                            @for (var i = 0; i < sources.Count; i++)
                                            {
                                                var source = sources[i];
                                                var adapter = evidence.EvidenceAdapters[i];
                                                <li class="iqr-source" data-testid="iqr-evidence-source" data-source="@adapter.Source" data-state="@adapter.State">
                                                    <span class="iqr-pill iqr-pill-@IntegrationReviewResultPresentation.AdapterTone(adapter.State)">@IntegrationReviewLabels.EvidenceState(adapter.State)</span>
                                                    <span class="iqr-adapter-name">@source.Name@if (source.Platform is { } p) { <span class="iqr-muted"> · @p</span> }</span>
                                                    @if (commonReason is null && adapter.State != IntegrationEvidenceState.Available) { <span class="iqr-muted iqr-adapter-reason">@adapter.Reason</span> }
                                                </li>
                                            }
                                        </ul>
                                        <p class="iqr-muted">Configuration state only — nothing is contacted before the review runs. Each source is read-only and uses the BirkNext instance's own Azure identity.</p>
                                        <div class="iqr-tablewrap" tabindex="0" role="region" aria-label="Runtime evidence source details">
                                            <table class="iqr-table iqr-table-compact" data-testid="iqr-evidence-detail-table">
                                                <thead><tr><th scope="col">Source</th><th scope="col">State</th><th scope="col">Reason</th><th scope="col">Freshness</th><th scope="col">Last captured</th></tr></thead>
                                                <tbody>
                                                    @foreach (var adapter in evidence.EvidenceAdapters)
                                                    {
                                                        <tr data-testid="iqr-evidence-detail-row"><td>@adapter.Adapter</td><td>@IntegrationReviewLabels.EvidenceState(adapter.State)</td><td>@adapter.Reason</td><td>Not read pre-run</td><td class="iqr-nowrap">@adapter.CapturedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC</td></tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </ReviewDisclosure>
                                </div>
                            }
                        </div>
                    }
                    else if (_error is null) { <p class="iqr-muted" role="status">Loading runtime evidence…</p> }
                </div>
            </div>

            @if (_readiness is { } areas)
            {
                <ReviewDisclosure Text="Delivery readiness (pipeline source)" CollapseText="Hide delivery readiness" Hint="Integration and contract checks configured in pipelines · not runtime integration verification" TestId="iqr-delivery" Class="iqr-detail-disclosure" @bind-Expanded="_deliveryExpanded">
                    @if (_deliveryExpanded)
                    {
                        <BirkNext.Web.Components.DeliveryEvidencePanel Categories="@([BirkNext.PipelineReview.ValidationCategory.Integration, BirkNext.PipelineReview.ValidationCategory.Contract, BirkNext.PipelineReview.ValidationCategory.Smoke, BirkNext.PipelineReview.ValidationCategory.HealthCheck])"
                            Note="Integration and contract checks the pipelines run before or after deployments. Delivery readiness only — it never verifies a runtime integration." />
                    }
                </ReviewDisclosure>
                <ReviewDisclosure Text="Test data readiness" CollapseText="Hide test data readiness" Hint="Shared Test Data catalog · messages, payloads and expected results; never values" TestId="iqr-test-data" Class="iqr-detail-disclosure" @bind-Expanded="_testDataExpanded">
                    @if (_testDataExpanded) { <BirkNext.Web.Components.TestDataReadinessSummary Kinds="@([BirkNext.TestData.TestDataKind.Message, BirkNext.TestData.TestDataKind.Structured, BirkNext.TestData.TestDataKind.File, BirkNext.TestData.TestDataKind.ExpectedResult])" /> }
                </ReviewDisclosure>
                <ReviewDisclosure Text="Advanced" CollapseText="Hide advanced" Hint="systems, transports, provisioning, application messaging" TestId="iqr-setup-advanced" Class="iqr-detail-disclosure">
                    <section class="iqr-group" aria-labelledby="iqr-group-areas-heading" data-testid="iqr-group-areas">
                        <h3 class="iqr-group-heading" id="iqr-group-areas-heading">Integration areas</h3>
                        <section class="iqr-card" aria-labelledby="iqr-systems-heading" data-testid="iqr-systems">
                            <h4 id="iqr-systems-heading">Configured integration system@(areas.Systems.Count == 1 ? "" : "s")</h4>
                            @if (areas.Systems.Count == 0)
                            {
                                <div class="iqr-empty-state" data-testid="iqr-no-systems">
                                    <p><strong>No integrations are enabled for this Target Environment.</strong></p>
                                    <a class="btn-primary" href="@IntegrationsHref(profile)" data-testid="iqr-no-systems-action">Open Target Environment → Integrations</a>
                                </div>
                            }
                            @foreach (var system in areas.Systems)
                            {
                                <article class="iqr-system" data-testid="iqr-system">
                                    <h5 data-testid="iqr-system-title">@SourceIntegrationsPresentation.Title @if (system.PlatformName is { } platform) { <span class="iqr-muted">→ @platform</span> }</h5>
                                    <p class="iqr-muted" data-testid="iqr-system-group">Configured group: @system.SystemName</p>
                                    <dl class="iqr-dl">
                                        <div><dt>@(system.Kind == IntegrationKind.HttpApi ? "Endpoints" : "Topics")</dt><dd data-testid="iqr-system-topics">@system.Topics</dd></div>
                                        <div><dt>Consumers</dt><dd data-testid="iqr-system-consumers">@IntegrationReviewPrerunPresentation.Consumers(system)</dd></div>
                                        @if (system.Kind == IntegrationKind.EventHub) { <div><dt>Consumer groups</dt><dd data-testid="iqr-system-groups">@IntegrationReviewPrerunPresentation.ConsumerGroups(system)</dd></div> }
                                        <div><dt>Contracts</dt><dd data-testid="iqr-system-contracts">@IntegrationReviewPrerunPresentation.Contracts(system)</dd></div>
                                        @if (!system.DomainReviewSupported) { <div><dt>Domain review</dt><dd>Not implemented for @IntegrationConfigurationRules.KindLabel(system.Kind) — configuration is reviewed</dd></div> }
                                    </dl>
                                    <div class="iqr-system-actions">
                                        @if (system.ConsumersSuggested + system.ConsumersNeedingConfirmation > 0)
                                        { <a class="iqr-link" href="@IntegrationReviewPrerunPresentation.Href(profile.Id, IntegrationReviewPrerunPresentation.FocusMappings)" data-testid="iqr-system-review-mappings">Review mappings</a> }
                                        @if (_catalog is { } catalog)
                                        {
                                            <ReviewDisclosure Text="@($"View {system.Topics} {(system.Kind == IntegrationKind.HttpApi ? "endpoint" : "topic")}{(system.Topics == 1 ? "" : "s")}")" CollapseText="Hide details" TestId="@($"iqr-system-topics-{Slug(system.SystemName)}")" Class="disclosure-inline">
                                                <ul class="iqr-topic-list">
                                                    @foreach (var topic in catalog.Integrations.Where(i => i.Enabled && (i.SystemName ?? i.DisplayName) == system.SystemName))
                                                    {
                                                        <li><span class="iqr-mono">@(topic.EndpointOrTopic ?? topic.DisplayName)</span> — @(topic.Consumer.DisplayName ?? "Consumer not assigned") <span class="iqr-pill iqr-pill-muted">@IntegrationConfigurationRules.MappingLabel(topic.Consumer.MappingState)</span></li>
                                                    }
                                                </ul>
                                            </ReviewDisclosure>
                                        }
                                    </div>
                                </article>
                            }
                        </section>
                        @AdvancedTransports(areas, profile)
                    </section>
                </ReviewDisclosure>
            }
        </section>

        @* ── Review ── *@
        <section class="iqr-group" aria-labelledby="iqr-group-coverage-heading" data-testid="iqr-group-coverage" hidden="@(CurrentView != IntegrationReviewPrerunPresentation.ReviewView)">
            <h2 class="iqr-group-heading" id="iqr-group-coverage-heading">Review</h2>
            @if (_readiness is { } coverage)
            {
                <p class="iqr-review-scope" data-testid="iqr-review-scope" data-scope="@(coverage.ScopeIntegrationId ?? AllIntegrations)">@IntegrationReviewPrerunPresentation.ReviewScope(coverage)</p>
                @DomainTable(coverage, profile)
                @RunBar(coverage, profile, "iqr-run-from-review")
            }
            else if (_error is null) { <p class="iqr-muted" role="status">Loading review coverage…</p> }
        </section>

        @* ── Test & Verify ── *@
        @if (CurrentView == IntegrationReviewPrerunPresentation.TestView)
        {
            @* Active-test readiness is separate from review readiness: a review that can run says nothing about a scenario that can execute.
               Test packs (journeys, verification) are listed here as test packs, never as "extensions". *@
            <section class="iqr-group" aria-labelledby="iqr-group-tests-heading" data-testid="iqr-group-active-tests-view">
                <h2 class="iqr-group-heading" id="iqr-group-tests-heading">Test &amp; Verify</h2>
                <section class="iqr-card iqr-execution" aria-labelledby="iqr-execution-heading" data-testid="iqr-active-execution" data-allowed="@(_executionAllowed switch { true => "true", false => "false", _ => "unknown" })">
                    <h3 id="iqr-execution-heading">Active execution <span class="iqr-pill iqr-pill-@(_executionAllowed == true ? "ready" : "muted")" data-testid="iqr-active-execution-state">@(_executionAllowed switch { true => "Allowed", false => "Not allowed", _ => "Not known" })</span></h3>
                    <p class="iqr-muted">@(_executionAllowed == true ? "This environment is enabled for active execution; each scenario still needs its own prerequisites and confirmation." : "This environment has not been enabled for active execution. Reviews, source evidence and reference metadata never enable it.")
                        <a class="iqr-link" href="@TestPackPresentation.ExecutionSettingsHref" data-testid="iqr-manage-execution">Manage execution</a></p>
                    @if (_executionDetail is { Length: > 0 } detail)
                    {
                        <ReviewDisclosure Text="Technical details" CollapseText="Hide technical details" TestId="iqr-execution-details" Class="disclosure-inline"><p class="iqr-muted">@detail</p></ReviewDisclosure>
                    }
                    <p class="iqr-muted iqr-readiness-distinction" data-testid="iqr-active-test-readiness-note"><strong>Active-test readiness</strong> is separate from <strong>review readiness</strong> (<a class="iqr-link" href="@ViewHref(IntegrationReviewPrerunPresentation.OverviewView)">Overview</a>): their blockers are never merged.</p>
                </section>
                @if (ScopeId is { } selectedId && _readiness?.Subjects.FirstOrDefault(s => s.IntegrationId == selectedId) is { } selectedSubject)
                {
                    <section class="iqr-card" aria-labelledby="iqr-selected-heading" data-testid="iqr-test-selected">
                        <h3 id="iqr-selected-heading">Selected integration</h3>
                        <p><strong>@selectedSubject.DisplayName</strong> <span class="iqr-muted">· @IntegrationReviewPrerunPresentation.CapabilityLabel(selectedSubject.Capability)</span></p>
                        <p class="iqr-muted" data-testid="iqr-test-selected-journeys">@(UsingJourneys(selectedId) is { Count: > 0 } users ? $"Used by: {string.Join(", ", users)}." : "No journey of the registered test packs uses this integration.") Test packs below are shown whole; journeys that use this integration are marked.</p>
                    </section>
                }
                <section class="iqr-card" aria-labelledby="iqr-packs-heading" data-testid="iqr-test-packs">
                    <h3 id="iqr-packs-heading">@(ScopeId is null ? "Test packs" : "Test packs using this integration")</h3>
                    @if (_testPacks is null) { <p class="iqr-muted" role="status">@(_testPacksError ?? "Loading test packs…")</p> }
                    else if (_testPacks.Count == 0) { <p class="iqr-muted">No test pack is registered.</p> }
                    else
                    {
                        @foreach (var pack in _testPacks)
                        {
                            var href = TestPackPresentation.PageHref(pack.PackId);
                            <article class="iqr-pack" data-testid="iqr-test-pack" data-pack="@pack.PackId">
                                <h4>@pack.DisplayName</h4>
                                @if (pack.Journeys.Count > 0)
                                {
                                    <ul class="iqr-pack-journeys" data-testid="iqr-test-pack-journeys" aria-label="@($"{pack.DisplayName} journeys")">
                                        @foreach (var journey in pack.Journeys)
                                        {
                                            <li data-journey="@journey.JourneyId" data-uses-selected="@(UsesSelected(journey.JourneyId) ? "true" : "false")">@if (href is not null) { <a class="iqr-link" href="@($"{href}?tab={journey.JourneyId}")">@journey.DisplayName</a> } else { @journey.DisplayName } <span class="iqr-muted">· @journey.Flow</span>
                                                @if (UsesSelected(journey.JourneyId)) { <span class="iqr-pill iqr-pill-ready" data-testid="iqr-journey-uses-selected">Uses this integration</span> }</li>
                                        }
                                    </ul>
                                }
                                @if (pack.VerificationViews.Count > 0) { <p class="iqr-muted">Verify: @string.Join(", ", pack.VerificationViews.Select(v => v.DisplayName)) · @pack.RuleIds.Count rule@(pack.RuleIds.Count == 1 ? "" : "s")</p> }
                                @if (href is not null) { <a class="btn-secondary" href="@href" data-testid="iqr-test-pack-open">Open @pack.DisplayName</a> }
                            </article>
                        }
                        <p class="iqr-muted">A test pack consumes this review's configured integrations and evidence bindings; it never configures them.</p>
                    }
                </section>
                <section class="iqr-card" aria-labelledby="iqr-journeys-summary-heading" data-testid="iqr-journeys-summary">
                    <h3 id="iqr-journeys-summary-heading">Journeys</h3>
                    @if (_journeySummary is { } journeys)
                    {
                        <dl class="iqr-facts">
                            <div><dt>Journeys</dt><dd data-testid="iqr-journeys-total">@journeys.Total</dd></div>
                            <div><dt>Execution ready</dt><dd data-testid="iqr-journeys-ready">@journeys.Ready</dd></div>
                            <div><dt>Blocked</dt><dd data-testid="iqr-journeys-blocked">@journeys.NotReady</dd></div>
                        </dl>
                    }
                    else { <p class="iqr-muted" role="status">@(_testSummaryError ?? "Loading the integration journey summary…")</p> }
                    <p class="iqr-muted">Configured ≠ source verified ≠ executable ≠ runtime verified. Execution ready means a journey may be started after confirmation, never that it passed.</p>
                    <ReviewDisclosure Text="Open integration journeys" CollapseText="Close integration journeys" TestId="iqr-open-journeys" @bind-Expanded="_journeysOpen">
                        @if (_journeysOpen) { <IntegrationJourneyPanel Profile="profile" /> }
                    </ReviewDisclosure>
                </section>
                <section class="iqr-active-tests" aria-labelledby="iqr-providers-heading" data-testid="iqr-group-active-tests">
                    <h3 class="iqr-section-heading" id="iqr-providers-heading">Active test providers</h3>
                    <ActiveEventTestingPanel SummaryFirst="true" Profile="profile" Integrations="@(_catalog?.Integrations ?? [])" Selections="_sourceSelections"
                                             SelectedIntegrationId="@ScopeId" SelectedIntegrationName="@(_readiness?.Subjects.FirstOrDefault(s => s.IntegrationId == ScopeId)?.DisplayName)" />
                </section>
                <section data-testid="iqr-group-test-configuration">
                    <ReviewDisclosure Text="Provider configuration · message flow" CollapseText="Hide provider configuration" Hint="known · saved for active run · runtime verified" TestId="iqr-provider-configuration" Class="iqr-detail-disclosure" @bind-Expanded="_providerOpen">
                        <MessageFlowReviewPanel EnvironmentId="@profile.Id" />
                    </ReviewDisclosure>
                </section>
                <ReviewDisclosure Text="Advanced" CollapseText="Hide advanced" Hint="topology" TestId="iqr-test-advanced" Class="iqr-detail-disclosure">
                    <section class="iqr-card" aria-labelledby="iqr-topology-heading" data-testid="iqr-topology-section">
                        <h3 id="iqr-topology-heading">Configured integrations and topology</h3>
                        <TopologyIntegrationConnections EnvironmentId="@profile.Id" />
                    </section>
                </ReviewDisclosure>
            </section>
        }
    }
    else if (_result is { } result)
    {
        @foreach (var snapshot in result.SourceSnapshots) { <IqrSourceDetails Snapshot="snapshot" /> }
        @* ── Post-run ── *@
        var headline = IntegrationReviewResultPresentation.Headline(result);
        <section class="iqr-card iqr-result" aria-labelledby="iqr-result-heading" data-testid="iqr-result">
            <h2 id="iqr-result-heading">Review result <span class="iqr-pill iqr-pill-@(result.Outcome == IntegrationReviewOutcome.Completed ? "ready" : "attention")" data-testid="iqr-outcome">@headline.Outcome</span></h2>
            <dl class="iqr-summary" data-testid="iqr-result-summary">
                <div><dt>Integration systems reviewed</dt><dd data-testid="iqr-result-systems">@headline.Systems</dd></div>
                <div><dt>Topics reviewed</dt><dd data-testid="iqr-result-topics">@headline.Topics</dd></div>
                <div><dt>Domains assessed</dt><dd data-testid="iqr-result-domains">@headline.DomainsAssessed of @headline.DomainsTotal</dd></div>
                <div><dt>Findings</dt><dd data-testid="iqr-result-findings">@headline.Findings</dd></div>
                <div><dt>Checks not assessed</dt><dd data-testid="iqr-result-not-assessed">@headline.NotAssessedChecks</dd></div>
                <div><dt>Evidence freshness</dt><dd data-testid="iqr-result-freshness">@headline.Freshness</dd></div>
                <div><dt>Review window</dt><dd data-testid="iqr-result-window">@headline.Window</dd></div>
            </dl>
            <p class="iqr-muted" data-testid="iqr-result-sources">Evidence sources: @headline.Sources. Configuration snapshot from @result.StartedAt.ToString("yyyy-MM-dd HH:mm") UTC — later edits in Integrations do not change this result.</p>
        </section>

        <div class="iqr-tabs" role="tablist" aria-label="Integration review result">
            @foreach (var tab in IntegrationReviewResultPresentation.Tabs)
            {
                <button type="button" role="tab" id="iqr-tab-btn-@Slug(tab)" class="iqr-tab @(_tab == tab ? "iqr-tab-active" : "")" aria-selected="@(_tab == tab ? "true" : "false")"
                        aria-controls="iqr-tabpanel" tabindex="@(_tab == tab ? "0" : "-1")" data-testid="iqr-tab-@Slug(tab)" @onclick="() => _tab = tab" @onkeydown="e => OnTabKey(e, tab)">@TabLabel(result, tab)</button>
            }
        </div>
        <div id="iqr-tabpanel" role="tabpanel" aria-labelledby="iqr-tab-btn-@Slug(_tab)" class="iqr-tabpanel" data-testid="iqr-tabpanel" data-tab="@_tab">
            @if (_tab == "Overview")
            {
                <ul class="iqr-domain-grid" data-testid="iqr-overview-domains">
                    @foreach (var domain in result.Domains)
                    {
                        <li class="iqr-domain-card" data-testid="iqr-domain-card" data-domain="@domain.Domain">
                            <div class="iqr-domain-head"><strong>@IntegrationReviewLabels.Domain(domain.Domain)</strong> <span class="iqr-pill iqr-pill-@IntegrationReviewResultPresentation.DomainTone(domain)" data-testid="iqr-domain-state">@domain.StateLabel</span></div>
                            <p data-testid="iqr-domain-coverage">@IntegrationReviewResultPresentation.Coverage(domain)@(domain.Findings > 0 ? $" · {domain.Findings} finding{(domain.Findings == 1 ? "" : "s")}" : "")</p>
                            @if (domain.KeyLimitation is { } limitation) { <p class="iqr-muted" data-testid="iqr-domain-limitation">@limitation</p> }
                            @if (domain.Observed.Count > 0)
                            {
                                <p class="iqr-domain-list-label">Observed</p>
                                <ul class="iqr-domain-list" data-testid="iqr-domain-observed">@foreach (var item in domain.Observed.Take(4)) { <li>@item</li> }</ul>
                            }
                            @if (domain.Missing.Count > 0)
                            {
                                <p class="iqr-domain-list-label">Missing</p>
                                <ul class="iqr-domain-list iqr-domain-list-missing" data-testid="iqr-domain-missing">@foreach (var item in domain.Missing.Take(4)) { <li>@item</li> }</ul>
                            }
                            @if (domain.Observed.Count > 4 || domain.Missing.Count > 4) { <p class="iqr-muted">More in the @IntegrationReviewLabels.Domain(domain.Domain) tab.</p> }
                        </li>
                    }
                </ul>
                <section class="iqr-card" aria-labelledby="iqr-adapters-heading" data-testid="iqr-result-adapters">
                    <h3 id="iqr-adapters-heading">Runtime evidence sources <span class="iqr-muted">· @IntegrationReviewResultPresentation.AdapterSummary(result.EvidenceAdapters)</span></h3>
                    @if (result.EvidenceAdapters.Count == 0)
                    {
                        <p class="iqr-muted">No runtime evidence source was consulted in this run.</p>
                    }
                    else
                    {
                        <ul class="iqr-adapters">
                            @foreach (var adapter in result.EvidenceAdapters)
                            {
                                <li class="iqr-adapter" data-testid="iqr-result-adapter" data-source="@adapter.Source" data-state="@adapter.State">
                                    <span class="iqr-adapter-name">@adapter.Adapter</span>
                                    <span class="iqr-pill iqr-pill-@IntegrationReviewResultPresentation.AdapterTone(adapter.State)">@IntegrationReviewLabels.EvidenceState(adapter.State)</span>
                                    <span class="iqr-muted iqr-adapter-reason">@adapter.Reason</span>
                                </li>
                            }
                        </ul>
                    }
                    @if (result.ContractSnapshot.Count > 0)
                    {
                        <p class="iqr-muted" data-testid="iqr-result-contracts">Contracts used: @string.Join("; ", result.ContractSnapshot.Select(c => $"{c.FileName} ({c.Role.ToString().ToLowerInvariant()}, sha256 {c.ShortHash})"))</p>
                    }
                </section>
                @if (result.SourceInfrastructureComparisons.Count > 0)
                {
                    @* Configured catalog vs. Source Analysis Infrastructure declarations, as recorded with THIS run (its snapshot; never re-read). *@
                    var first = result.SourceInfrastructureComparisons[0].Comparison;
                    <section class="iqr-card" aria-labelledby="iqr-result-source-infra-heading" data-testid="iqr-result-source-infra">
                        <h3 id="iqr-result-source-infra-heading">Configured vs. declared in source</h3>
                        <p class="iqr-muted">@BirkNext.SourceDomains.SourceInfrastructureComparer.Boundary Source snapshot <code>@SourceAnalysisOverview.ShortFingerprint(first.SourceFingerprint ?? "")</code> · Infrastructure analyzer v@(first.AnalyzerVersion).</p>
                        <dl class="iqr-dl" data-testid="iqr-source-infra-summary">
                            @foreach (var g in result.SourceInfrastructureComparisons.GroupBy(c => c.Comparison.State).OrderBy(g => g.Key))
                            {
                                <div data-state="@g.Key"><dt>@BirkNext.SourceDomains.SourceInfrastructureComparer.Label(g.Key)</dt><dd>@g.Count()</dd></div>
                            }
                        </dl>
                        <ReviewDisclosure Text="@($"View {result.SourceInfrastructureComparisons.Count} comparison(s)")" CollapseText="Hide comparisons" TestId="iqr-source-infra-detail" Class="disclosure-inline">
                            <div class="sd-scroll" tabindex="0" role="region" aria-label="Configured vs declared in source">
                                <table data-testid="iqr-source-infra-table">
                                    <thead><tr><th scope="col">Field</th><th scope="col">Configured</th><th scope="col">Source</th><th scope="col">Declared in source</th><th scope="col">Runtime</th></tr></thead>
                                    <tbody>
                                        @foreach (var row in result.SourceInfrastructureComparisons)
                                        {
                                            var c = row.Comparison;
                                            <tr data-testid="iqr-source-infra-row" data-state="@c.State">
                                                <th scope="row">@c.Field<span class="sd-context">@row.SubjectName@(row.ItemId is { } item ? $" · {item}" : "")</span></th>
                                                <td><code>@(c.ConfiguredValue ?? "Not configured")</code></td>
                                                <td>@BirkNext.SourceDomains.SourceInfrastructureComparer.Label(c.State)<span class="sd-context">@c.EnvironmentBasis</span></td>
                                                <td>@(c.Match is { } m ? $"{m.Name} · {SourceEvidenceDomainsPresentation.Location(m.File, m.Line)}" : c.Candidates.Count == 0 ? "—" : string.Join(", ", c.Candidates.Take(3).Select(x => x.Name)))</td>
                                                <td class="iqr-muted">Assessed separately (Observed)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </ReviewDisclosure>
                    </section>
                }
                @if (result.ObservedAzureComparisons.Count > 0)
                {
                    @* Configured catalog vs. the Azure Environment Analysis snapshot this run read (observed in the control plane; never re-queried). *@
                    var observedAt = result.ObservedAzureComparisons[0].Lookup.CapturedAt;
                    <section class="iqr-card" aria-labelledby="iqr-result-observed-azure-heading" data-testid="iqr-result-observed-azure">
                        <h3 id="iqr-result-observed-azure-heading">Configured vs. observed in Azure</h3>
                        <p class="iqr-muted">@BirkNext.AzureEnvironment.AzureEnvironmentText.ObservedNotVerified. Azure snapshot @(observedAt is { } at ? AzureEnvironmentPresentation.Utc(at) : "—"); <a href="azure-environment">re-analyze in Azure Environment Analysis</a> for current state.</p>
                        <dl class="iqr-dl" data-testid="iqr-observed-azure-summary">
                            @foreach (var g in result.ObservedAzureComparisons.GroupBy(c => c.Lookup.State).OrderBy(g => g.Key))
                            {
                                <div data-state="@g.Key"><dt>@ObservedLabel(g.Key)</dt><dd>@g.Count()</dd></div>
                            }
                        </dl>
                        <ReviewDisclosure Text="@($"View {result.ObservedAzureComparisons.Count} lookup(s)")" CollapseText="Hide lookups" TestId="iqr-observed-azure-detail" Class="disclosure-inline">
                            <div class="sd-scroll" tabindex="0" role="region" aria-label="Configured vs observed in Azure">
                                <table data-testid="iqr-observed-azure-table">
                                    <thead><tr><th scope="col">Field</th><th scope="col">Configured</th><th scope="col">Observed in Azure</th><th scope="col">Detail</th></tr></thead>
                                    <tbody>
                                        @foreach (var row in result.ObservedAzureComparisons)
                                        {
                                            <tr data-testid="iqr-observed-azure-row" data-state="@row.Lookup.State">
                                                <th scope="row">@row.Field<span class="sd-context">@row.SubjectName@(row.ItemId is { } item ? $" · {item}" : "")</span></th>
                                                <td><code>@(row.ConfiguredValue ?? "Not configured")</code></td>
                                                <td>@ObservedLabel(row.Lookup.State)@if (row.Lookup.Resource is { } r) { <span class="sd-context">@r.CategoryDetail · @r.ResourceGroup</span> }</td>
                                                <td class="iqr-muted">@row.Lookup.Detail</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </ReviewDisclosure>
                    </section>
                }
                @foreach (var eventHub in result.EventHubSnapshot)
                {
                    @* Transport — Event Hubs: what is configured vs what Azure showed in THIS run (snapshot; never re-read). Observed is not Pass. *@
                    var ehId = $"iqr-result-eventhub-heading-{Slug(eventHub.PlatformId)}";
                    var hubRows = IntegrationReviewResultPresentation.HubRows(eventHub);
                    <section class="iqr-card" aria-labelledby="@ehId" data-testid="iqr-result-eventhub" data-platform="@eventHub.PlatformId">
                        <h3 id="@ehId">Transport — Event Hubs · configured vs observed</h3>
                        <dl class="iqr-dl iqr-eh-facts">
                            <div><dt>Azure runtime</dt><dd data-testid="iqr-eh-azure">@(eventHub.AzureRuntimeEnabled ? "Enabled" : "Not configured — IntegrationReview:Azure:Enabled is not true (an instance setting, not an integration misconfiguration)")</dd></div>
                            <div><dt>Namespace</dt><dd data-testid="iqr-eh-namespace"><span class="iqr-mono">@eventHub.Namespace</span> — @IntegrationReviewResultPresentation.NamespaceLine(eventHub)</dd></div>
                            <div><dt>Consumer groups</dt><dd data-testid="iqr-eh-groups">@foreach (var line in IntegrationReviewResultPresentation.GroupLines(eventHub)) { <span class="iqr-eh-line">@line</span> }</dd></div>
                            <div><dt>Checkpoints</dt><dd data-testid="iqr-eh-checkpoints">@foreach (var line in IntegrationReviewResultPresentation.CheckpointLines(eventHub)) { <span class="iqr-eh-line">@line</span> }</dd></div>
                            @foreach (var (label, value) in IntegrationReviewResultPresentation.MonitoringRows(eventHub))
                            {
                                <div><dt>@label</dt><dd data-testid="iqr-eh-monitoring">@value</dd></div>
                            }
                            <div><dt>Namespace metrics</dt><dd data-testid="iqr-eh-metrics">@IntegrationReviewResultPresentation.MetricsLine(eventHub)</dd></div>
                        </dl>
                        @if (hubRows.Count > 0)
                        {
                            <ReviewDisclosure Text="@($"Configured vs observed hubs ({hubRows.Count})")" CollapseText="Hide hubs" TestId="@($"iqr-eh-hubs-{Slug(eventHub.PlatformId)}")" Class="disclosure-inline">
                                <div class="iqr-tablewrap" tabindex="0" role="region" aria-label="Configured vs observed Event Hubs">
                                    <table class="iqr-table iqr-table-compact" data-testid="iqr-eh-hub-table">
                                        <thead><tr><th scope="col">Event Hub</th><th scope="col">Type</th><th scope="col">Configured</th><th scope="col">Observed</th><th scope="col">Comparison</th></tr></thead>
                                        <tbody>
                                            @foreach (var row in hubRows)
                                            {
                                                <tr data-testid="iqr-eh-hub-row" data-state="@row.State"><td class="iqr-mono">@row.Hub</td><td>@row.Kind</td><td>@row.Configured</td><td>@row.Observed</td>
                                                    <td><span class="iqr-pill iqr-pill-@IntegrationReviewResultPresentation.ComparisonTone(row.State)">@EventHubComparisonLabels.State(row.State)</span></td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </ReviewDisclosure>
                        }
                        <p class="iqr-muted">Snapshot of this run; opening an old run never re-reads Azure. An observed match is configuration agreeing with Azure — not message flow — and an observed consumer group never confirms which application reads with it.</p>
                    </section>
                }
                <section class="iqr-card" aria-labelledby="iqr-tested-heading" data-testid="iqr-tested">
                    <h3 id="iqr-tested-heading">@(result.SourceSnapshots.Count > 0 ? "What was inspected or observed" : "What was tested")</h3>
                    @if (!IntegrationReviewResultPresentation.ScopeRecorded(result))
                    {
                        <p class="iqr-muted">Not recorded for this run (recorded before this list existed).</p>
                    }
                    else if (result.WhatWasTested.Count == 0)
                    {
                        <p class="iqr-muted">No check was executed with runtime evidence in this run; configuration was reviewed.</p>
                    }
                    else
                    {
                        <ul>@foreach (var item in result.WhatWasTested) { <li data-testid="iqr-tested-item">@item</li> }</ul>
                    }
                </section>
                <section class="iqr-card" aria-labelledby="iqr-not-assessed-heading" data-testid="iqr-not-assessed">
                    <h3 id="iqr-not-assessed-heading">What was not assessed</h3>
                    @if (!IntegrationReviewResultPresentation.ScopeRecorded(result))
                    {
                        <p class="iqr-muted">Not recorded for this run; see Review limitations.</p>
                    }
                    else
                    {
                        <ul>@foreach (var item in result.WhatWasNotAssessed) { <li data-testid="iqr-not-assessed-item">@item</li> }</ul>
                    }
                </section>
                @if (result.ServiceBusSnapshot.Count > 0)
                {
                    <section class="iqr-card" aria-labelledby="iqr-result-servicebus-heading" data-testid="iqr-result-servicebus">
                        <h3 id="iqr-result-servicebus-heading">Transport — Service Bus</h3>
                        <ul>
                            @foreach (var serviceBus in result.ServiceBusSnapshot)
                            {
                                var (active, dead, scheduled) = ServiceBusPresentation.Counts(serviceBus);
                                var routes = serviceBus.Routes.Where(r => r.Direction != nameof(MessagingRouteDirection.Reference)).ToList();
                                <li data-testid="iqr-result-servicebus-platform"><strong>@serviceBus.Namespace</strong> — @ServiceBusLabels.Overall(serviceBus.OverallState) ·
                                    configuration: topology configured, @routes.Count(r => r.Configuration == ServiceBusCheckState.Matched) of @routes.Count code route(s) matched ·
                                    runtime metadata: @(serviceBus.Runtime?.State == IntegrationEvidenceState.Available ? $"available (captured {serviceBus.Runtime.CapturedAt.ToUniversalTime():yyyy-MM-dd HH:mm} UTC)" : $"{IntegrationReviewLabels.EvidenceState(serviceBus.Runtime?.State ?? IntegrationEvidenceState.NotConfigured)} — {serviceBus.Runtime?.Reason}")@(serviceBus.Runtime?.State == IntegrationEvidenceState.Available ? $" · observed active {ServiceBusPresentation.Count(active)}, dead-letter {ServiceBusPresentation.Count(dead)}, scheduled {ServiceBusPresentation.Count(scheduled)}" : "")</li>
                            }
                        </ul>
                        <p class="iqr-muted">Snapshot of this run; opening an old run never re-reads Azure.</p>
                    </section>
                }
                @if (result.SecurityClassificationSnapshot is { } classification)
                {
                    <section class="iqr-card" aria-labelledby="iqr-result-classification-heading" data-testid="iqr-result-classification">
                        <h3 id="iqr-result-classification-heading">Security classification</h3>
                        <p data-testid="iqr-result-classification-summary">@ClassificationLabels.Overall(classification.Overall) · @string.Join(" · ", classification.Pipeline.Select(p => $"{p.Title}: {ClassificationLabels.State(p.Source)}"))</p>
                        <p class="iqr-muted">Source and configuration evidence only; live authorization checks belong to the <a href="security-classification-review">M01 – Gradert tilgang (Kode 6/7) review</a>.</p>
                    </section>
                }
                @if (result.ScimSnapshot.Count > 0)
                {
                    <section class="iqr-card" aria-labelledby="iqr-result-scim-heading" data-testid="iqr-result-scim">
                        <h3 id="iqr-result-scim-heading">Identity provisioning — SCIM</h3>
                        <ul>
                            @foreach (var scim in result.ScimSnapshot)
                            {
                                <li data-testid="iqr-result-scim-platform"><strong>@scim.PlatformName</strong> — @ScimPresentation.Headline(scim) ·
                                    @string.Join(" · ", scim.Stages.Select(s => $"{s.Title}: {ScimLabels.State(s.Source)} / runtime {ScimLabels.State(s.Runtime)}"))</li>
                            }
                        </ul>
                        <p class="iqr-muted">Snapshot of this run: source facts, configuration and safe GET observations only; a published deactivation is not revoked access.</p>
                    </section>
                }
                @if (result.ApplicationMessagingSnapshot is { } messaging && messaging.Applications.Any(a => a.BoundConsumer is not null))
                {
                    <section class="iqr-card" aria-labelledby="iqr-result-messaging-heading" data-testid="iqr-result-messaging">
                        <h3 id="iqr-result-messaging-heading">Application messaging</h3>
                        <p class="iqr-muted">Source analyzed @messaging.AnalyzedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC (snapshot used by this run). Configuration evidence is not runtime evidence.</p>
                        <ul>
                            @foreach (var app in messaging.Applications.Where(a => a.BoundConsumer is not null))
                            {
                                var runtime = result.ApplicationMessagingRuntime.FirstOrDefault(r => r.ApplicationId == app.ApplicationId);
                                <li data-testid="iqr-result-messaging-app"><strong>@app.ApplicationId</strong> (@app.BoundConsumer) — Wolverine @ApplicationMessagingLabels.Detection(app.Detection) · handler mapping @ApplicationMessagingLabels.Fact(app.HandlerMapping).ToLowerInvariant() · retry policy @ApplicationMessagingLabels.Fact(app.RetryPolicy).ToLowerInvariant() · runtime processing @(runtime is { State: IntegrationEvidenceState.Available } ? "observed" : $"not assessed ({runtime?.Reason ?? "no runtime read"})")</li>
                            }
                        </ul>
                    </section>
                }
                <section class="iqr-card" aria-labelledby="iqr-manual-heading" data-testid="iqr-manual">
                    <h3 id="iqr-manual-heading">Manual follow-up</h3>
                    <p class="iqr-muted">Tasks and gaps for a person — not defects.</p>
                    <ul>@foreach (var item in result.ManualFollowUp) { <li data-testid="iqr-manual-item"><strong>@item.Title</strong> (@item.AffectedCount) — @item.Detail</li> }</ul>
                </section>
                <section class="iqr-card" aria-labelledby="iqr-limitations-heading" data-testid="iqr-limitations">
                    <h3 id="iqr-limitations-heading">Review limitations</h3>
                    <ul>@foreach (var limitation in result.Limitations) { <li data-testid="iqr-limitation">@limitation</li> }</ul>
                </section>
            }
            else if (_tab == "Findings")
            {
                @if (result.Findings.Count == 0)
                {
                    <p class="iqr-empty" data-testid="iqr-no-findings">No findings on the assessed checks. Checks that could not be assessed are listed in their domain tabs, never as passes.</p>
                }
                else
                {
                    <div class="iqr-tablewrap" tabindex="0" role="region" aria-label="Findings">
                        <table class="iqr-table" data-testid="iqr-findings-table">
                            <thead><tr><th scope="col">Severity</th><th scope="col">Domain</th><th scope="col">Integration / topic</th><th scope="col">Finding</th><th scope="col">Evidence</th><th scope="col">Recommendation</th><th scope="col">Standards</th></tr></thead>
                            <tbody>
                                @foreach (var f in result.Findings)
                                {
                                    <tr data-testid="iqr-finding-row" data-rule="@f.RuleId">
                                        <td><span class="iqr-pill iqr-pill-fail">@f.Severity</span></td>
                                        <td>@IntegrationReviewLabels.Domain(f.Domain)</td>
                                        <td class="iqr-mono">@f.Subject@if (f.AffectedIntegrations.Count > 1) { <span class="iqr-muted"> · affects @f.AffectedIntegrations.Count topics</span> }</td>
                                        <td><strong>@f.Title</strong></td>
                                        <td>@string.Join(" ", f.Evidence)</td>
                                        <td>@f.Recommendation</td>
                                        <td><StandardReferences References="f.StandardsReferences" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            else if (IntegrationReviewResultPresentation.DomainOf(_tab) is { } domain)
            {
                var domainResult = result.Domains.Single(d => d.Domain == domain);
                var rows = IntegrationReviewResultPresentation.Rows(result, domain);
                <p class="iqr-muted" data-testid="iqr-domain-note">@DomainNote(domain) @IntegrationReviewResultPresentation.Coverage(domainResult).</p>
                <h3 class="iqr-checks-heading" data-testid="iqr-checks-heading">@(domain == IntegrationReviewDomain.ErrorHandling ? "Error-handling checks" : $"{IntegrationReviewLabels.Domain(domain)} checks") (@rows.Count)</h3>
                <div class="iqr-tablewrap" tabindex="0" role="region" aria-label="@($"{IntegrationReviewLabels.Domain(domain)} checks")">
                    <table class="iqr-table" data-testid="iqr-checks-table">
                        <thead><tr><th scope="col">Subject</th><th scope="col">Check</th><th scope="col">Status</th><th scope="col">Evidence</th><th scope="col">Explanation</th><th scope="col">Source</th><th scope="col">Freshness</th></tr></thead>
                        <tbody>
                            @foreach (var row in rows)
                            {
                                <tr data-testid="iqr-check-row" data-check-id="@row.Check.CheckId" data-status="@row.Check.Status">
                                    <td class="iqr-mono">@row.Subject</td>
                                    <td>@row.Check.Title</td>
                                    <td><span class="iqr-pill iqr-pill-@IntegrationReviewResultPresentation.StatusTone(row.Check.Status)">@IntegrationReviewLabels.Status(row.Check.Status)</span></td>
                                    <td>@(string.IsNullOrWhiteSpace(row.Check.Evidence) ? "—" : row.Check.Evidence)</td>
                                    <td>@row.Check.Explanation@if (row.Check.Recommendation is { } rec) { <span class="iqr-muted"> Action: @rec</span> }</td>
                                    <td class="iqr-muted">@IntegrationReviewLabels.Source(row.Check.Provenance)</td>
                                    <td class="iqr-muted iqr-nowrap" data-testid="iqr-check-freshness">@IntegrationReviewResultPresentation.Freshness(row.Check)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
    @if (_result is not null && _profile is { } messageFlowProfile)
    {
        <MessageFlowReviewPanel EnvironmentId="@messageFlowProfile.Id" />
    }
</div>

@code {
    private bool _deliveryExpanded, _testDataExpanded;
    private static string ObservedLabel(BirkNext.AzureEnvironment.ObservedLookupState state) => state switch
    {
        BirkNext.AzureEnvironment.ObservedLookupState.Observed => "Observed",
        BirkNext.AzureEnvironment.ObservedLookupState.NotObserved => "Not observed in the analyzed scope",
        BirkNext.AzureEnvironment.ObservedLookupState.MultipleObserved => "Observed more than once",
        BirkNext.AzureEnvironment.ObservedLookupState.NoSnapshot => "No Azure snapshot",
        BirkNext.AzureEnvironment.ObservedLookupState.Disabled => "Azure Environment Analysis hidden",
        _ => "Unable to verify",
    };

    private readonly List<IqrSourceSelection> _sourceSelections = [];
    private bool _sourceBusy;
    // Master-detail on "What can be reviewed": at most one domain detail open; none by default.
    private IntegrationReviewDomain? _openDomain;
    private void ToggleDomain(IntegrationReviewDomain domain) => _openDomain = _openDomain == domain ? null : domain;
    private static string SourceSummary(int snapshots, int bound) =>
        (snapshots == 0 ? "No source analysis yet" : $"{snapshots} source analysis snapshot{(snapshots == 1 ? "" : "s")} available")
        + $" · {(bound == 0 ? "none" : bound.ToString())} bound to an integration.";

    /// <summary>What each review area can assess now (one compact row per domain, the backend's order), with one detail open at a time.</summary>
    private RenderFragment DomainTable(IntegrationReviewReadiness readiness, FrontendAnalysisProfile profile) => __builder =>
    {
                <section class="iqr-card" aria-labelledby="iqr-domains-heading" data-testid="iqr-domain-readiness">
                    <h3 id="iqr-domains-heading">What can be reviewed</h3>
                    <div class="iqr-tablewrap iqr-domain-tablewrap" tabindex="0" role="region" aria-labelledby="iqr-domains-heading">
                        <table class="iqr-table iqr-domain-table" data-testid="iqr-domain-table">
                            <thead><tr><th scope="col">Review area</th><th scope="col">Status</th><th scope="col">Main limitation</th><th scope="col">Action</th></tr></thead>
                            <tbody>
                                @foreach (var domain in readiness.Domains)
                                {
                                    var action = IntegrationReviewPrerunPresentation.DomainAction(domain, readiness, profile.Id);
                                    var open = _openDomain == domain.Domain;
                                    <tr class="@(open ? "iqr-domain-row-open" : null)" data-testid="iqr-domain-readiness-card" data-domain="@domain.Domain" data-readiness="@domain.Readiness">
                                        <th scope="row">
                                            <button type="button" class="iqr-domain-toggle" aria-expanded="@(open ? "true" : "false")" aria-controls="iqr-domain-detail" data-testid="iqr-domain-toggle" @onclick="() => ToggleDomain(domain.Domain)">
                                                <span class="iqr-domain-chevron" aria-hidden="true">@(open ? "▾" : "▸")</span>@IntegrationReviewLabels.Domain(domain.Domain)
                                            </button>
                                        </th>
                                        <td><span class="iqr-pill iqr-pill-@IntegrationReviewResultPresentation.ReadinessTone(domain.Readiness)" data-testid="iqr-domain-status">@IntegrationReviewLabels.Readiness(domain.Readiness)</span></td>
                                        <td class="iqr-domain-limitation" data-testid="iqr-domain-limitation">@(domain.Missing is { Count: > 0 } m ? m[0] : "—")</td>
                                        <td>@if (action is { } a) { <a class="iqr-link" href="@a.Href" data-testid="iqr-domain-row-action">@a.Label</a> } else { <span class="iqr-muted">—</span> }</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div id="iqr-domain-detail" class="iqr-domain-detail" role="region" aria-label="Review area details" aria-live="polite" data-testid="iqr-domain-detail" hidden="@(_openDomain is null)">
                        @if (_openDomain is { } openDomain && readiness.Domains.FirstOrDefault(d => d.Domain == openDomain) is { } detail)
                        {
                            var detailAction = IntegrationReviewPrerunPresentation.DomainAction(detail, readiness, profile.Id);
                            <h4 data-testid="iqr-domain-detail-title">@IntegrationReviewLabels.Domain(detail.Domain) <span class="iqr-pill iqr-pill-@IntegrationReviewResultPresentation.ReadinessTone(detail.Readiness)">@IntegrationReviewLabels.Readiness(detail.Readiness)</span></h4>
                            <p class="iqr-muted" data-testid="iqr-domain-reason">@detail.Explanation</p>
                            @if (detail.Available is { Count: > 0 } canRead)
                            {
                                <p class="iqr-domain-list-label">Evidence the run reads</p>
                                <ul class="iqr-domain-list" data-testid="iqr-domain-available">@foreach (var item in canRead) { <li>@item</li> }</ul>
                            }
                            @if (detail.Missing is { Count: > 0 } missing)
                            {
                                <p class="iqr-domain-list-label">Missing</p>
                                <ul class="iqr-domain-list iqr-domain-list-missing" data-testid="iqr-domain-missing">@foreach (var item in missing) { <li>@item</li> }</ul>
                            }
                            @if (detailAction is { } da) { <a class="iqr-link iqr-domain-action" href="@da.Href" data-testid="iqr-domain-action">@da.Label</a> }
                        }
                    </div>
                </section>

    };
    /// <summary>Transport, provisioning and application-messaging summaries (advanced detail of Setup &amp; Evidence; unchanged content).</summary>
    private RenderFragment AdvancedTransports(IntegrationReviewReadiness areas, FrontendAnalysisProfile profile) => __builder =>
    {
                @if (areas.ServiceBus.Count > 0)
                {
                    @* Transport — Service Bus: configured topology and runtime metadata, separate from Event Hub sources and from Wolverine. *@
                    <section class="iqr-card" aria-labelledby="iqr-servicebus-heading" data-testid="iqr-servicebus">
                        <h3 id="iqr-servicebus-heading">Transport — Service Bus</h3>
                        <ul class="iqr-sources iqr-messaging-list">
                            @foreach (var serviceBus in areas.ServiceBus)
                            {
                                <li class="iqr-messaging-item" data-testid="iqr-servicebus-platform" data-platform="@serviceBus.PlatformId">
                                    <span><strong>@serviceBus.PlatformName</strong> · Topology <span class="iqr-pill iqr-pill-observed" data-testid="iqr-servicebus-topology">@(serviceBus.Queues + serviceBus.Topics + serviceBus.Subscriptions > 0 ? "Configured" : "Not configured")</span>
                                        · Runtime metadata <span class="iqr-pill iqr-pill-muted" data-testid="iqr-servicebus-runtime">@(serviceBus.RuntimeState == IntegrationEvidenceState.Available ? "Available" : IntegrationReviewLabels.EvidenceState(serviceBus.RuntimeState))</span></span>
                                    @if (serviceBus.RuntimeState != IntegrationEvidenceState.Available) { <span class="iqr-muted" data-testid="iqr-servicebus-reason">@serviceBus.RuntimeReason</span> }
                                </li>
                            }
                        </ul>
                        <div class="iqr-system-actions">
                            <a class="iqr-link" href="@IntegrationReviewPrerunPresentation.Href(profile.Id, ServiceBusPresentation.Focus)" data-testid="iqr-servicebus-manage">Open Service Bus in Integrations</a>
                            <ReviewDisclosure Text="View topology" CollapseText="Hide topology" TestId="iqr-servicebus-details" Class="disclosure-inline">
                                <ul class="iqr-domain-list">
                                    @foreach (var serviceBus in areas.ServiceBus)
                                    {
                                        <li data-testid="iqr-servicebus-counts">@serviceBus.PlatformName: @serviceBus.Queues queue(s) · @serviceBus.Topics topic(s) · @serviceBus.Subscriptions subscription(s) · code routes @serviceBus.RoutesMatched of @serviceBus.RoutesTotal matched@(serviceBus.RoutesMismatched > 0 ? $", {serviceBus.RoutesMismatched} mismatch" : "")</li>
                                    }
                                </ul>
                                <p class="iqr-muted">Transport evidence only: an entity that exists or a route that matches does not show that messages were processed.</p>
                            </ReviewDisclosure>
                        </div>
                    </section>
                }

                @if (areas.Scim.Count > 0)
                {
                    @* Identity provisioning (SCIM): configured flow and stored source evidence. The run adds safe GET checks only — never a user write. *@
                    <section class="iqr-card" aria-labelledby="iqr-scim-heading" data-testid="iqr-scim">
                        <h3 id="iqr-scim-heading">Identity provisioning — SCIM</h3>
                        <ul class="iqr-sources iqr-messaging-list">
                            @foreach (var scim in areas.Scim)
                            {
                                <li class="iqr-messaging-item" data-testid="iqr-scim-platform" data-platform="@scim.PlatformId">
                                    <span><strong>@scim.PlatformName</strong> · SCIM <span class="iqr-pill iqr-pill-observed" data-testid="iqr-scim-source">@(scim.Detected ? "Source verified" : scim.SourceAnalyzed ? "Not found in source" : "Source not analyzed")</span>
                                        · Safe runtime checks <span class="iqr-pill iqr-pill-muted" data-testid="iqr-scim-runtime">@(scim.RuntimeState == IntegrationEvidenceState.Available ? "Available" : IntegrationReviewLabels.EvidenceState(scim.RuntimeState))</span>
                                        · Synthetic mutation test <span class="iqr-pill iqr-pill-muted" data-testid="iqr-scim-mutation">@ScimLabels.Mutation(scim.SyntheticMutation)</span></span>
                                    @if (scim.RuntimeState != IntegrationEvidenceState.Available) { <span class="iqr-muted" data-testid="iqr-scim-reason">@scim.RuntimeReason</span> }
                                </li>
                            }
                        </ul>
                        <div class="iqr-system-actions">
                            <a class="iqr-link" href="@IntegrationReviewPrerunPresentation.Href(profile.Id, ScimPresentation.Focus)" data-testid="iqr-scim-manage">Open SCIM in Integrations</a>
                            <ReviewDisclosure Text="View SCIM details" CollapseText="Hide SCIM details" TestId="iqr-scim-details" Class="disclosure-inline">
                                <ul class="iqr-domain-list">
                                    @foreach (var scim in areas.Scim)
                                    {
                                        <li data-testid="iqr-scim-counts">@scim.PlatformName: @(scim.SourceAnalyzed ? $"{scim.Operations} operation(s) · {scim.RequirementsImplemented} of {scim.RequirementsTotal} specification requirement(s) implemented · {scim.NeedsReview} source observation(s) need review" : "No source analysis yet.")</li>
                                    }
                                </ul>
                                <p class="iqr-muted">Configuration and source evidence are not runtime success. The review never creates, changes, deletes or lists a user.</p>
                            </ReviewDisclosure>
                        </div>
                    </section>
                }

                @if (areas.ApplicationMessaging.Count > 0)
                {
                    @* Application messaging (Wolverine) is source evidence beside the transport runtime sources — never counted among them. *@
                    var apps = areas.ApplicationMessaging;
                    <section class="iqr-card" aria-labelledby="iqr-messaging-heading" data-testid="iqr-messaging">
                        <h3 id="iqr-messaging-heading">Application messaging</h3>
                        <dl class="iqr-dl" data-testid="iqr-messaging-summary">
                            <div><dt>Applications</dt><dd data-testid="iqr-messaging-summary-apps">@apps.Count</dd></div>
                            <div><dt>Detection</dt><dd data-testid="iqr-messaging-summary-detection">@apps.Count(a => a.Detection == MessagingDetection.Confirmed) configured · @apps.Count(a => a.Detection != MessagingDetection.Confirmed) not confirmed</dd></div>
                            <div><dt>Bound to a consumer</dt><dd data-testid="iqr-messaging-summary-bound">@apps.Count(a => a.BoundConsumer is not null) of @apps.Count</dd></div>
                            <div><dt>Runtime evidence</dt><dd data-testid="iqr-messaging-summary-runtime">@apps.Count(a => a.RuntimeState == IntegrationEvidenceState.Available) of @apps.Count available</dd></div>
                        </dl>
                        <div class="iqr-system-actions">
                            <a class="iqr-link" href="@IntegrationsHref(profile)" data-testid="iqr-messaging-manage">Manage in Target Environment → Integrations</a>
                            <ReviewDisclosure Text="@($"View {apps.Count} application{(apps.Count == 1 ? "" : "s")}")" CollapseText="Hide applications" TestId="iqr-messaging-details" Class="disclosure-inline">
                                <ul class="iqr-sources iqr-messaging-list">
                                    @foreach (var app in apps)
                                    {
                                        <li class="iqr-messaging-item" data-testid="iqr-messaging-app" data-application="@app.ApplicationId">
                                            <span><strong>@app.ApplicationId</strong> · @app.Technology · <span class="iqr-pill iqr-pill-@(app.Detection == MessagingDetection.Confirmed ? "observed" : "muted")" data-testid="iqr-messaging-detection">@(app.Detection == MessagingDetection.Confirmed ? "Configured" : ApplicationMessagingLabels.Detection(app.Detection))</span></span>
                                            <span class="iqr-muted">Handler mapping @ApplicationMessagingLabels.Fact(app.HandlerMapping) · Retry policy @ApplicationMessagingLabels.Fact(app.RetryPolicy) · Outbox @ApplicationMessagingLabels.Fact(app.Outbox) · Error handling @ApplicationMessagingLabels.Fact(app.ErrorHandling)</span>
                                            <span class="iqr-muted">@(app.BoundConsumer is { } consumer ? $"Bound to {consumer} ({app.BoundTopics} topic{(app.BoundTopics == 1 ? "" : "s")})." : "Not bound to an Integrations consumer, so it contributes no review checks.")</span>
                                            <span class="iqr-muted" data-testid="iqr-messaging-copy">@ApplicationMessagingPresentation.PrerunCopy(app)</span>
                                        </li>
                                    }
                                </ul>
                            </ReviewDisclosure>
                        </div>
                    </section>
                }
    };

    private FrontendAnalysisProfile? _profile;
    private FrontendAnalysisContext? _context;
    private IntegrationReviewReadiness? _readiness;
    private IntegrationCatalog? _catalog;
    private IntegrationReviewResult? _result;
    private IReadOnlyList<IntegrationReviewRunSummary> _history = [];
    private string? _error;
    private bool _running;
    private string _tab = "Overview";

    /// <summary>The pre-run view (?view=): Overview, Setup &amp; Evidence, Review or Test &amp; Verify; older view names are mapped to them.</summary>
    [SupplyParameterFromQuery(Name = "view")] public string? View { get; set; }
    private string CurrentView => IntegrationReviewPrerunPresentation.ResolveView(View);
    private string ViewHref(string key) => Navigation.GetUriWithQueryParameter("view", key == IntegrationReviewPrerunPresentation.OverviewView ? null : key);

    /// <summary>The integration the views describe and the review is scoped to (the only one, or the one chosen in the header selector).</summary>
    private string? _subjectId;
    private const string AllIntegrations = "all";
    /// <summary>?integration= : an integration id, "all" for the explicit environment-wide review, or absent (the first integration).</summary>
    [SupplyParameterFromQuery(Name = "integration")] public string? IntegrationParam { get; set; }
    private bool EnvironmentWide => _subjectId == AllIntegrations;
    /// <summary>?evidence=bind opens the binding editor (deep link from Target Environment / journeys: "Change canonical source evidence").</summary>
    [SupplyParameterFromQuery(Name = "evidence")] public string? EvidenceParam { get; set; }
    private bool _sourceSetupOpen;
    /// <summary>The selected integration's contract pair review (read-only; reloaded with the scope).</summary>
    private BirkNext.ContractSchemaEvidence.ContractRelationshipReview? _pair;
    private string? ScopeId => EnvironmentWide ? null : _subjectId;

    /// <summary>Changing the selection recomputes the plan, the evidence and the providers for it; nothing from the previous selection is kept.</summary>
    private async Task SelectSubjectAsync(ChangeEventArgs args)
    {
        _subjectId = args.Value?.ToString();
        _journeysOpen = false;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("integration", _subjectId), replace: true);
        await LoadReadinessAsync();
    }
    /// <summary>The backend's active-execution gate for this environment (trusted and execution allowed); null until read.</summary>
    private bool? _executionAllowed;
    private string? _executionDetail;
    private bool _providerOpen;
    /// <summary>"Development · Portal – report intake": where and what is reviewed, in one line (read-only review).</summary>
    private string HeaderContext => string.Join(" · ", new[]
    {
        _profile is { } p ? (string.IsNullOrWhiteSpace(p.Name) ? p.Id : p.Name) : null,
        _readiness is { } r ? IntegrationReviewPrerunPresentation.Subject(r, _subjectId)?.DisplayName : null,
    }.OfType<string>().DefaultIfEmpty("Read-only review of the configured integrations"));
    private string ActiveTestsLabel => _journeySummary is null ? "Not known" : _journeySummary.Ready > 0 ? "Executable after confirmation" : "Blocked";

    /// <summary>The run bar: "Run review" is read-only and offered only when the review can run.</summary>
    private RenderFragment RunBar(IntegrationReviewReadiness readiness, FrontendAnalysisProfile profile, string testId) => __builder =>
    {
        <div class="iqr-run-bar">
            @if (readiness.CanRun)
            {
                <button type="button" class="btn-primary" data-testid="@testId" disabled="@(_running || _sourceBusy)" aria-describedby="@($"{testId}-note")" @onclick="RunAsync">
                    @(_running ? "Running review…" : IntegrationReviewPrerunPresentation.RunLabel(readiness))
                </button>
                <span class="iqr-muted" id="@($"{testId}-note")">Read-only review. No messages are published, consumed or changed.</span>
            }
            @if (!IntegrationReviewPrerunPresentation.NoEnabledIntegrations(readiness)) { <a class="iqr-link" href="@IntegrationsHref(profile)" data-testid="@($"{testId}-integrations")">Open Target Environment → Integrations</a> }
        </div>
    };

    /// <summary>The integration under review: who it is and its separate states (configured, mapping, source, contract/reference, runtime)
    /// with active execution beside them — never one combined "ready".</summary>
    private RenderFragment SubjectCard(IntegrationReviewSubject subject, IntegrationReviewReadiness readiness) => __builder =>
    {
        <section class="iqr-card iqr-subject" aria-labelledby="iqr-subject-name" data-testid="iqr-subject" data-capability="@subject.Capability">
            <h2 id="iqr-subject-name" data-testid="iqr-subject-name">@subject.DisplayName</h2>
            <p class="iqr-muted" data-testid="iqr-subject-line">@IntegrationReviewPrerunPresentation.SubjectLine(subject)</p>
            <dl class="iqr-states" data-testid="iqr-subject-states">
                @foreach (var state in IntegrationReviewPrerunPresentation.SubjectStates(subject, readiness, _bindings.Any(b => b.IntegrationId == subject.IntegrationId)))
                {
                    <div data-key="@state.Key"><dt>@state.Label</dt><dd><span class="iqr-pill iqr-pill-@state.Tone" data-testid="iqr-subject-state">@state.Value</span></dd></div>
                }
                <div data-key="execution"><dt>Active execution</dt><dd><span class="iqr-pill iqr-pill-@(_executionAllowed == true ? "ready" : "muted")" data-testid="iqr-subject-state">@(_executionAllowed switch { true => "Allowed", false => "Not allowed", _ => "Not known" })</span></dd></div>
            </dl>
        </section>
    };

    /// <summary>A value known from its owner, with that owner as its source; never an input.</summary>
    private static RenderFragment Known(string field, string? value, string source) => __builder =>
    {
        <div data-testid="iqr-known" data-field="@field"><dt>@field</dt><dd>@if (string.IsNullOrWhiteSpace(value)) { <span class="iqr-muted">Not configured</span> } else { <span class="iqr-mono iqr-wrap">@value</span> <span class="iqr-muted iqr-provenance">Source: @source</span> }</dd></div>
    };

    private sealed record JourneySummary(int Total, int Ready, int NotReady);
    /// <summary>Journey views (with the configured integrations each one matched), to say which journeys use the selected integration.</summary>
    private IReadOnlyList<IntegrationJourneyView> _journeyViews = [];
    private Dictionary<string, string> _journeyPacks = [];
    private bool UsesSelected(string journeyId) => ScopeId is { } id && _journeyViews.Any(view => view.Journey.JourneyId == journeyId && view.MatchedIntegrations.Any(m => m.IntegrationId == id));
    private List<string> UsingJourneys(string integrationId) =>
        [.. _journeyViews.Where(view => view.MatchedIntegrations.Any(m => m.IntegrationId == integrationId)).Select(view => view.Journey.DisplayName).Distinct()];
    private JourneySummary? _journeySummary;
    private string? _testSummaryError;
    private string? _testSummaryFor;
    private bool _journeysOpen;

    protected override async Task OnParametersSetAsync()
    {
        // An old Extensions link opens Test & Verify with the provider configuration it pointed at.
        if (string.Equals(View, IntegrationReviewPrerunPresentation.LegacyExtensionsView, StringComparison.Ordinal)) _providerOpen = true;
        if (CurrentView is IntegrationReviewPrerunPresentation.OverviewView or IntegrationReviewPrerunPresentation.TestView or IntegrationReviewPrerunPresentation.SetupView) await LoadTestSummariesAsync();
        if (CurrentView == IntegrationReviewPrerunPresentation.TestView) await LoadTestPacksAsync();
    }

    private IReadOnlyList<TestPackDescriptor>? _testPacks;
    private string? _testPacksError;
    private async Task LoadTestPacksAsync()
    {
        if (_testPacks is not null) return;
        if (Services.GetService<IIntegrationJourneysApiService>() is not { } journeysApi) { _testPacksError = "Test packs are not available in this build."; return; }
        try
        {
            var result = await journeysApi.TestPacksAsync();
            _testPacks = result.Value;
            _testPacksError = result.Error;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { _testPacksError = "Test packs could not be loaded."; }
    }

    /// <summary>The canonical source-evidence bindings (one snapshot per integration); the run uses exactly these.</summary>
    private IReadOnlyList<IntegrationEvidenceBinding> _bindings = [];
    private async Task LoadBindingsAsync()
    {
        try { _bindings = await Api.ListEvidenceBindingsAsync(_profile!.Id) ?? []; }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { _bindings = []; }
        _sourceSelections.Clear();
        _sourceSelections.AddRange(_bindings.Select(binding => binding.Selection));
    }

    private async Task BindingsChangedAsync()
    {
        await LoadBindingsAsync();
        await LoadReadinessAsync();
    }

    /// <summary>Journey counts from the journeys' own read-only readiness endpoint; loaded once, only for this view.</summary>
    private async Task LoadTestSummariesAsync()
    {
        if (_profile is not { } profile || _testSummaryFor == profile.Id) return;
        _testSummaryFor = profile.Id;
        try
        {
            if (Services.GetService<IIntegrationJourneysApiService>() is { } journeysApi)
            {
                var packs = (await journeysApi.PacksAsync(profile.Id)).Value ?? [];
                var all = packs.SelectMany(pack => pack.Journeys).ToList();
                // The backend gate is the same for every pack of an environment: trusted and active execution allowed.
                if (packs.FirstOrDefault() is { } first) { _executionAllowed = first.EnvironmentTrusted; _executionDetail = first.EnvironmentDetail; }
                _journeySummary = new(all.Count, all.Count(view => view.Readiness == JourneyReadinessState.Ready), all.Count(view => view.Readiness != JourneyReadinessState.Ready));
                _journeyViews = all;
                _journeyPacks = packs.SelectMany(pack => pack.Journeys.Select(view => (view.Journey.JourneyId, pack.PackId))).DistinctBy(item => item.JourneyId).ToDictionary(item => item.JourneyId, item => item.PackId);
            }
            else _testSummaryError = "Integration journeys are not available in this build.";
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _testSummaryError = "The journey summary could not be loaded; open the integration journeys for detail.";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var context = await ContextFactory.GetActiveContextAsync();
        if (context.ActiveTargetError is { } targetError) { _error = targetError; return; }
        _context = context;
        _profile = context.ActiveProfile;
        _sourceSetupOpen = string.Equals(EvidenceParam, "bind", StringComparison.OrdinalIgnoreCase);
        await LoadReadinessAsync();
    }

    private async Task LoadReadinessAsync()
    {
        try
        {
            // Integrations still stored in the browser profile are imported once, so the review sees what the user configured.
            if (_profile!.Integrations.Count > 0) await Api.ImportLegacyAsync(_profile);
            _catalog = await Api.GetCatalogAsync(_profile!);
            await LoadBindingsAsync();
            _subjectId ??= IntegrationParam;
            _readiness = await Api.ScopedReadinessAsync(_profile!, ScopeId);
            // No selection yet: the review is scoped to the first integration (the environment-wide review is an explicit choice).
            if (_subjectId is null && _readiness.ScopeIntegrationId is null && _readiness.Subjects.FirstOrDefault() is { } first)
            {
                _subjectId = first.IntegrationId;
                _readiness = await Api.ScopedReadinessAsync(_profile!, ScopeId);
            }
            // The contract pair is supplementary: a failure hides it, never the page.
            try { _pair = ScopeId is { } pairFor ? await Api.ContractRelationshipAsync(_profile!.Id, pairFor) : null; }
            catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { _pair = null; }
            _history = await Api.HistoryAsync(_profile!.Id);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _error = $"{BackendRequestClassifier.FromException("Configured integrations", ex).UserMessage} Configured integrations are stored by the backend.";
        }
    }

    private async Task RunAsync()
    {
        _running = true;
        _error = null;
        if (_context is not null) RuntimeReviews.MarkIntegrationQualityRunning(_context);
        try
        {
            _result = await Api.RunScopedAsync(_profile!, ScopeId, _sourceSelections);
            _tab = "Overview";
            // The Dashboard card reads the session result; it shows outcome and coverage, never a score.
            if (_context is not null) RuntimeReviews.SaveIntegrationQualityResult(_result, _context);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _error = BackendRequestClassifier.FromException("Integration Quality Review run", ex).UserMessage;
            if (_context is not null) RuntimeReviews.MarkIntegrationQualityFailed(_context, _error);
        }
        finally { _running = false; }
    }

    private async Task OpenRunAsync(Guid runId)
    {
        _result = await Api.GetRunAsync(runId);
        _tab = "Overview";
    }

    private async Task BackToSetup()
    {
        _result = null;
        await LoadReadinessAsync();
    }

    private async Task ExportHtml()
    {
        if (_result is null) return;
        var html = ExportService.ExportIntegrationReview(_result, Workspace.ProjectName);
        await JS.InvokeVoidAsync("downloadHtmlFile", $"integration-quality-review-{DateTime.UtcNow:yyyy-MM-dd}.html", html);
    }

    private void OnTabKey(KeyboardEventArgs e, string tab)
    {
        var tabs = IntegrationReviewResultPresentation.Tabs;
        var i = Array.IndexOf(tabs, tab);
        _tab = e.Key switch
        {
            "ArrowRight" => tabs[(i + 1) % tabs.Length],
            "ArrowLeft" => tabs[(i - 1 + tabs.Length) % tabs.Length],
            "Home" => tabs[0],
            "End" => tabs[^1],
            _ => _tab,
        };
    }

    private static string TabLabel(IntegrationReviewResult result, string tab) => tab == "Findings" ? $"Findings ({result.Findings.Count})" : tab;

    private static string DomainNote(IntegrationReviewDomain domain) => domain switch
    {
        IntegrationReviewDomain.Configuration => "Configured expectation only — never runtime proof.",
        IntegrationReviewDomain.Connectivity => "Safe runtime checks only: DNS, TCP and TLS to the namespace; no event is sent. Reachable is not message flow verified.",
        IntegrationReviewDomain.Contract => "Contract availability, compatibility and drift are separate; no contract evidence is Not assessed, never compatible.",
        IntegrationReviewDomain.MessageFlow => "Configured flow is not observed flow; no activity is \"no recent evidence\", never a failure.",
        IntegrationReviewDomain.Reliability => "Checkpoint and lag need a known consumer group and checkpoint evidence.",
        IntegrationReviewDomain.ErrorHandling => "Error-handling checks, not a list of errors: findings are listed under Findings.",
        IntegrationReviewDomain.Security => "Configured authentication is not runtime authorization.",
        IntegrationReviewDomain.Observability => "Monitoring configured is not monitoring healthy.",
        IntegrationReviewDomain.Performance => "Measured values only; configuration values are never performance evidence.",
        _ => "Structural event evidence only; payload values are never shown.",
    };

    private static string IntegrationsHref(FrontendAnalysisProfile profile) => IntegrationReviewPresentation.IntegrationsHref(profile.Id);

    private static string Slug(string value) => new string(value.Select(c => char.IsLetterOrDigit(c) ? char.ToLowerInvariant(c) : '-').ToArray());
}
