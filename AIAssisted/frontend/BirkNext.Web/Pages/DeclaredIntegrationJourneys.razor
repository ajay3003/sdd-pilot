@page "/integration-journeys/declare"
@using BirkNext.Integrations
@implements IDisposable
@inject ICurrentWorkspaceProjection CurrentWorkspace
@inject IServiceProvider Services
@inject IJSRuntime JS

<PageTitle>Declared Integration Journeys</PageTitle>

@* Integration Journeys owner: a person declares, per project, a journey's name and the ordered component chain it runs through (names as Source
   Analysis shows them), or edits one (?journey={id}: a new revision; earlier revisions never change). Design metadata only — nothing runs, binds or
   is associated here. Test Coverage proposes association candidates from the declared chain (structure only, a reviewer confirms); the Scope
   Registry can name a declared journey as a Journey member. The overview with revision history is /integration-journeys. *@
<div class="ijd-page" data-testid="ijd-page" aria-busy="@(_loaded ? "false" : "true")">
    @* Unsaved journey edits are never lost silently: leaving asks first. *@
    <NavigationLock ConfirmExternalNavigation="@Dirty" OnBeforeInternalNavigation="ConfirmLeaveAsync" />
    <PageHeader Title="Declared Integration Journeys" Description="Declare the component chain an integration journey runs through, for this project. Test Coverage proposes it to matching source journeys; a reviewer confirms." />
    <p class="ijd-muted"><a href="integration-journeys" data-testid="ijd-overview">← All Integration Journeys of this project</a></p>

    @if (!_loaded)
    {
        <p class="ijd-muted" data-testid="ijd-loading">Loading…</p>
    }
    else if (_projectKey is null)
    {
        <p class="ijd-notice" role="status" data-testid="ijd-no-project">Load a project first: declared journeys belong to one project.</p>
    }
    else if (_api is null)
    {
        <p class="ijd-notice" role="status" data-testid="ijd-unavailable">Declared Integration Journeys are not available in this session.</p>
    }
    else
    {
        <p class="ijd-muted" data-testid="ijd-project">Project: <strong>@(_projectName ?? _projectKey)</strong> <code>@_projectKey</code></p>
        <section class="ijd-card" aria-labelledby="ijd-form-heading" data-testid="ijd-form" data-mode="@(_editing is null ? "declare" : "edit")">
            @if (_editing is { } editing)
            {
                <h2 id="ijd-form-heading">Edit @editing.Journey.DisplayName</h2>
                <p class="ijd-muted" data-testid="ijd-editing">Editing <code>@editing.Journey.Id</code> (revision @editing.Journey.Revision). Saving adds revision @(editing.Journey.Revision + 1); the id stays and earlier revisions never change.
                    <button type="button" class="btn-link" data-testid="ijd-cancel-edit" @onclick="CancelEdit">Declare a new journey instead</button></p>
            }
            else
            {
                <h2 id="ijd-form-heading">Declare a journey</h2>
            }
            <label class="ijd-field">Journey name <input data-testid="ijd-name" @bind="_name" @bind:event="oninput" maxlength="@DeclaredIntegrationJourneyRules.MaxName" /></label>
            <label class="ijd-field">Components in order <span class="ijd-muted">(one per line, as Source Analysis names them — e.g. a project, channel or database name)</span>
                <textarea data-testid="ijd-components" rows="5" @bind="_components" @bind:event="oninput"></textarea>
            </label>
            @* Systems and steps: build the chain from what was discovered (Integration Topology of the active Target Environment) instead of typing
               exact names; reorder or remove steps. Adding a discovered component or connection confirms nothing — the journey stays a person's
               declaration, and the components box above remains the authoritative text. *@
            <section class="ijd-steps-panel" aria-labelledby="ijd-steps-heading" data-testid="ijd-steps-panel">
                <h3 id="ijd-steps-heading" class="ijd-subheading">Systems and steps</h3>
                @if (Chain.Count == 0) { <p class="ijd-muted" data-testid="ijd-steps-none">No step yet: add systems below, or type them in the box above.</p> }
                else
                {
                    <ol class="ijd-steps" data-testid="ijd-steps">
                        @foreach (var (step, index) in Chain.Select((s, i) => (s, i)))
                        {
                            var at = index;
                            <li data-testid="ijd-step" data-index="@at"><span>@(at + 1). @step</span>
                                <button type="button" class="btn-secondary btn-small" data-testid="ijd-step-up" disabled="@(at == 0)" @onclick="() => Move(at, -1)">Move up<span class="visually-hidden"> @step</span></button>
                                <button type="button" class="btn-secondary btn-small" data-testid="ijd-step-down" disabled="@(at == Chain.Count - 1)" @onclick="() => Move(at, 1)">Move down<span class="visually-hidden"> @step</span></button>
                                <button type="button" class="btn-secondary btn-small" data-testid="ijd-step-remove" @onclick="() => RemoveStep(at)">Remove<span class="visually-hidden"> @step</span></button></li>
                        }
                    </ol>
                }
                @if (_topology is { } topology)
                {
                    <label class="ijd-field">Add a discovered system <input data-testid="ijd-system-search" placeholder="Search systems in Integration Topology" @bind="_systemSearch" @bind:event="oninput" /></label>
                    <div class="ijd-picks" data-testid="ijd-system-picks">
                        @foreach (var c in topology.Components.Where(c => _systemSearch.Trim().Length == 0 || c.Name.Contains(_systemSearch.Trim(), StringComparison.OrdinalIgnoreCase)).OrderBy(c => c.Name).Take(12))
                        {
                            var component = c;
                            <button type="button" class="btn-secondary btn-small" data-testid="ijd-add-system" data-name="@c.Name" @onclick="() => AddStep(component.Name)">+ @c.Name <span class="ijd-muted">(@c.Kind)</span></button>
                        }
                    </div>
                    @if (topology.Connections.Count > 0)
                    {
                        <details data-testid="ijd-connections"><summary>Start from a discovered connection</summary>
                            <ul class="ijd-steps">
                                @foreach (var c in topology.Connections.OrderBy(c => c.Relationship is BirkNext.IntegrationTopology.TopologyRelationshipState.Candidate or BirkNext.IntegrationTopology.TopologyRelationshipState.ExpectedUnresolved).Take(15))
                                {
                                    var (from, to) = (IntegrationTestingPresentation.ComponentName(topology, c.ProducerComponentId), IntegrationTestingPresentation.ComponentName(topology, c.ConsumerComponentId));
                                    <li data-testid="ijd-connection" data-state="@c.Relationship">@from → @to <span class="ijd-muted">@IntegrationTestingPresentation.RelationshipLabel(c.Relationship)</span>
                                        <button type="button" class="btn-secondary btn-small" data-testid="ijd-add-connection" @onclick="() => { AddStep(from); AddStep(to); }">Add both</button></li>
                                }
                            </ul>
                        </details>
                    }
                    <p class="ijd-muted">Added steps are your declaration; a discovered connection marked as candidate or expected is not confirmed by adding it.</p>
                }
                else
                {
                    <p class="ijd-muted" data-testid="ijd-no-topology">No discovered systems to choose from (Integration Topology is read for the active Target Environment). Type the components above.</p>
                }
            </section>
            <label class="ijd-field">Description <span class="ijd-muted">(optional)</span> <input data-testid="ijd-description" @bind="_description" @bind:event="oninput" maxlength="@DeclaredIntegrationJourneyRules.MaxDescription" /></label>
            <label class="ijd-field">@(_editing is null ? "Declared by" : "Changed by") <input data-testid="ijd-declared-by" @bind="_declaredBy" @bind:event="oninput" maxlength="@DeclaredIntegrationJourneyRules.MaxDeclaredBy" /></label>
            @if (Chain.Count > 0) { <p class="ijd-muted" data-testid="ijd-preview">Chain: @string.Join(" → ", Chain)</p> }
            <div class="ijd-actions">
                <button type="button" class="btn-primary" data-testid="ijd-save" disabled="@(_busy || Invalid is not null)" @onclick="SaveAsync">@(_editing is null ? "Declare journey" : "Save new revision")</button>
                @if (Invalid is { } why && (_name.Length > 0 || _components.Length > 0)) { <span class="ijd-muted" data-testid="ijd-invalid">@why</span> }
            </div>
            @if (_error is not null) { <p class="ijd-error" role="alert" data-testid="ijd-error">@_error</p> }
            @if (_status is not null) { <p class="ijd-muted" role="status" data-testid="ijd-status">@_status</p> }
            @if (_editing is { } shown)
            {
                <div data-testid="ijd-revisions">
                    <h3 class="ijd-subheading">Revisions (newest first)</h3>
                    <ol class="ijd-revisions">
                        @foreach (var r in shown.Revisions)
                        {
                            <li data-testid="ijd-revision" data-revision="@r.Revision"><strong>Revision @r.Revision</strong>@(r.Revision == shown.Journey.Revision ? " (current)" : "") · @IntegrationJourneys.OriginLabel(r.Origin) by @r.DeclaredBy, @r.DeclaredAt.ToLocalTime().ToString("g")
                                <span class="ijd-chain">@r.DisplayName: @string.Join(" → ", r.Components)</span></li>
                        }
                    </ol>
                </div>
            }
        </section>

        <section class="ijd-card" aria-labelledby="ijd-list-heading" data-testid="ijd-list">
            <h2 id="ijd-list-heading">Declared for this project (@_journeys.Count)</h2>
            @if (_loadError is not null) { <p class="ijd-error" role="alert" data-testid="ijd-load-error">@_loadError</p> }
            else if (_journeys.Count == 0) { <p class="ijd-muted" data-testid="ijd-empty">No journey is declared for this project yet.</p> }
            <ul class="ijd-journeys">
                @foreach (var j in _journeys)
                {
                    var journey = j;
                    <li data-testid="ijd-journey" data-id="@j.Id">
                        <strong>@j.DisplayName</strong> <span class="ijd-muted" data-testid="ijd-journey-revision">revision @j.Revision</span> <code data-testid="ijd-journey-id">@j.Id</code>
                        <span class="ijd-chain" data-testid="ijd-journey-chain">@string.Join(" → ", j.Components)</span>
                        <span class="ijd-muted">@(j.Revision > 1 ? "Last changed" : "Declared") by @j.DeclaredBy, @j.DeclaredAt.ToLocalTime().ToString("g")@(j.Description is { Length: > 0 } d ? $" · {d}" : "")</span>
                        <button type="button" class="btn-secondary btn-small" data-testid="ijd-edit" disabled="@_busy" @onclick="() => EditAsync(journey.JourneyId)">Edit<span class="visually-hidden"> @j.DisplayName</span></button>
                        <button type="button" class="btn-secondary btn-small" data-testid="ijd-remove" disabled="@_busy" @onclick="() => RemoveAsync(journey)">Remove<span class="visually-hidden"> @j.DisplayName</span></button>
                    </li>
                }
            </ul>
            <p class="ijd-muted"><a href="test-coverage-review" data-testid="ijd-test-coverage">Open Test Coverage &amp; Overlap Review</a> and run it again to see association candidates.</p>
        </section>
    }
</div>

@code {
    /// <summary>?journey={journeyId}: open that journey of the current project for editing (a new revision).</summary>
    [SupplyParameterFromQuery(Name = "journey")] public string? JourneyParam { get; set; }

    private readonly CancellationTokenSource _cts = new();
    private IDeclaredIntegrationJourneyApiService? _api;
    private string? _projectKey, _projectName, _error, _status, _loadError, _openedParam;
    private string _name = "", _components = "", _description = "", _declaredBy = "";
    private IReadOnlyList<DeclaredIntegrationJourney> _journeys = [];
    private DeclaredIntegrationJourneyHistory? _editing;
    private bool _loaded, _busy;

    private List<string> Chain => DeclaredIntegrationJourneyRules.Chain(_components.Split('\n'));

    private BirkNext.IntegrationTopology.IntegrationTopologyView? _topology;
    private string _systemSearch = "";

    private void SetChain(IEnumerable<string> steps) => _components = string.Join("\n", steps);
    private void AddStep(string name) { if (Chain.LastOrDefault() != name) SetChain([.. Chain, name]); }
    private void RemoveStep(int at) { var c = Chain; if (at >= 0 && at < c.Count) { c.RemoveAt(at); SetChain(c); } }
    private void Move(int at, int by)
    {
        var c = Chain; var to = at + by;
        if (at < 0 || at >= c.Count || to < 0 || to >= c.Count) return;
        (c[at], c[to]) = (c[to], c[at]); SetChain(c);
    }

    /// <summary>The form holds something that is not saved (a new declaration in progress, or a change to the journey being edited).</summary>
    private bool Dirty => _editing is { } e
        ? _name != e.Journey.DisplayName || !Chain.SequenceEqual(e.Journey.Components) || _description != (e.Journey.Description ?? "")
        : _name.Trim().Length > 0 || Chain.Count > 0;

    private async Task ConfirmLeaveAsync(Microsoft.AspNetCore.Components.Routing.LocationChangingContext context)
    {
        if (!Dirty) return;
        var target = new Uri(new Uri("http://x/"), context.TargetLocation);
        if (target.AbsolutePath.EndsWith("/integration-journeys/declare", StringComparison.OrdinalIgnoreCase) && target.Query.Length == 0) return;
        bool leave;
        try { leave = await JS.InvokeAsync<bool>("confirm", "This journey has unsaved changes. Leave without saving them?"); }
        catch (JSException) { leave = false; }
        if (!leave) context.PreventNavigation();
    }

    private async Task LoadTopologyAsync()
    {
        // The topology client is obtained like every topology page does (it is not a DI registration).
        var topologyApi = IntegrationTopologyApiService.Resolve(Services);
        if (Services.GetService<IFrontendAnalysisContextFactory>() is not { } contexts) return;
        try
        {
            var context = await contexts.GetActiveContextAsync();
            if (context.ActiveTargetError is null && context.ActiveProfile is { Id.Length: > 0 } profile)
                (_topology, _) = await topologyApi.GetAsync(profile.Id, [], _cts.Token);
        }
        catch (Exception e) when (e is not OperationCanceledException) { _topology = null; }
    }

    private DeclaredIntegrationJourneyRequest Request => new()
    {
        ProjectKey = _projectKey ?? "", DisplayName = _name, Description = string.IsNullOrWhiteSpace(_description) ? null : _description, Components = Chain, DeclaredBy = _declaredBy,
        ExpectedRevision = _editing?.Journey.Revision,
    };

    private string? Invalid => DeclaredIntegrationJourneyRules.Validate(Request);

    private IDisposable? _unsaved;

    protected override async Task OnInitializedAsync()
    {
        // A project switch asks before discarding an unsaved journey declaration (the same protection as leaving the page).
        _unsaved = Services.GetService<BirkNext.Web.Services.ProjectImport.UnsavedWorkGuard>()?.Register(() => Dirty ? "This journey declaration has unsaved changes." : null);
        _api = Services.GetService<IDeclaredIntegrationJourneyApiService>();
        var workspace = await CurrentWorkspace.GetAsync();
        _projectKey = string.IsNullOrWhiteSpace(workspace.ProjectSlug) ? null : workspace.ProjectSlug;
        _projectName = workspace.ProjectName;
        if (_projectKey is not null && _api is not null) { await LoadAsync(); await LoadTopologyAsync(); }
        _loaded = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        // Also when the query changes on this page (e.g. from the overview's Edit link while already here).
        if (_projectKey is null || _api is null || string.IsNullOrWhiteSpace(JourneyParam) || JourneyParam == _openedParam) return;
        _openedParam = JourneyParam;
        await EditAsync(JourneyParam);
    }

    private async Task LoadAsync()
    {
        var (journeys, error) = await _api!.ListAsync(_projectKey!, _cts.Token);
        (_journeys, _loadError) = (journeys ?? _journeys, error);
    }

    private async Task EditAsync(string journeyId)
    {
        if (_api is null || _projectKey is null) return;
        _error = null; _status = null;
        var (history, error) = await _api.HistoryAsync(_projectKey, journeyId, _cts.Token);
        if (history is null) { _error = error ?? "The journey could not be opened for editing."; return; }
        if (history.Journey.RetiredAt is not null) { _error = $"{history.Journey.DisplayName} was removed. Declare it again with the same name to reactivate it (its history is kept)."; return; }
        _editing = history;
        (_name, _components, _description) = (history.Journey.DisplayName, string.Join("\n", history.Journey.Components), history.Journey.Description ?? "");
    }

    private void CancelEdit()
    {
        _editing = null; _error = null; _status = null;
        (_name, _components, _description) = ("", "", "");
    }

    private async Task SaveAsync()
    {
        if (_api is null || Invalid is not null) return;
        _busy = true; _error = null; _status = null;
        try
        {
            if (_editing is { } editing)
            {
                var (revised, reviseError) = await _api.ReviseAsync(editing.Journey.ProjectKey, editing.Journey.JourneyId, Request, _cts.Token);
                if (revised is null) { _error = reviseError ?? "The new revision was not saved."; return; }
                _status = $"Saved revision {revised.Revision} of {revised.DisplayName} ({revised.Id}).";
                var (history, _) = await _api.HistoryAsync(revised.ProjectKey, revised.JourneyId, _cts.Token);
                _editing = history ?? editing;
                await LoadAsync();
                return;
            }
            var (journey, error) = await _api.DeclareAsync(Request, _cts.Token);
            if (journey is null) { _error = error ?? "The journey was not saved."; return; }
            _status = journey.Revision > 1 ? $"Declared {journey.DisplayName} again ({journey.Id}, revision {journey.Revision}; its earlier history is kept)." : $"Declared {journey.DisplayName} ({journey.Id}).";
            (_name, _components, _description) = ("", "", "");
            await LoadAsync();
        }
        finally { _busy = false; }
    }

    private async Task RemoveAsync(DeclaredIntegrationJourney journey)
    {
        if (_api is null) return;
        _busy = true; _error = null; _status = null;
        try
        {
            if (await _api.RemoveAsync(journey.ProjectKey, journey.JourneyId, string.IsNullOrWhiteSpace(_declaredBy) ? null : _declaredBy, _cts.Token) is { } error) { _error = error; return; }
            if (_editing?.Journey.JourneyId == journey.JourneyId) CancelEdit();
            _status = $"Removed {journey.DisplayName}. Its revision history is kept; recorded association decisions and scope members that name it are kept and read as missing.";
            await LoadAsync();
        }
        finally { _busy = false; }
    }

    public void Dispose() { _unsaved?.Dispose(); _cts.Cancel(); _cts.Dispose(); }
}
