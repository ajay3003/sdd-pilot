    };
    private string TraceabilityHealthTone => WorkflowStage == LibraryWorkflowStage.CoverageEstablished ? QaStatusTone : "empty";
    private int TraceabilityBarPercent => WorkflowStage == LibraryWorkflowStage.CoverageEstablished ? TraceabilityPercent : 0;
    private int WorkflowCurrentStep => WorkflowStage switch
    {
