@page "/scenarios"
@using BirkNext.Web.Components
@using BirkNext.Web.Models.Library
@using BirkNext.Web.Services

@inject ILibraryPageModelService LibraryPageModelService
@inject IWorkspaceSessionService Workspace

<PageTitle>QA Artifact Library</PageTitle>

<div class="artifact-library-shell">
    <PageHeader Title="QA Artifact Library"
                Description="Store, discover, reuse, and curate QA assets across specifications and projects." />

    <!-- ── Readiness Panel ────────────────────────────────────────── -->
    @if (PageModel is not null)
    {
        <LibraryReadinessPanel Model="PageModel" />
    }
    else if (IsLoading)
    {
        <div class="loading-state" role="status">Loading artifact library...</div>
    }
    else if (LoadError is not null)
    {
        <div class="notification notification-error" role="alert">@LoadError</div>
    }

    <!-- ── Artifact Cards Section ─────────────────────────────────── -->
    @if (PageModel?.Items.Count > 0)
    {
        <div class="artifact-cards-section">
            <h2 class="section-title">Loaded Artifacts</h2>
            <div class="artifact-cards-grid">
                @foreach (var item in PageModel.Items)
                {
                    @if (item.Status != LibraryStatus.Empty)
                    {
                        <div class="artifact-card">
                            <div class="artifact-card-header">
                                <span class="artifact-type-badge">@item.ArtifactKind</span>
                                <span class="artifact-source">@item.Source</span>
                            </div>
                            <div class="artifact-card-body">
                                <h3 class="artifact-name">@item.Name</h3>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <p class="artifact-description">@item.Description</p>
                                }
                                @if (item.LastUpdated.HasValue)
                                {
                                    <div class="artifact-meta">
                                        <span class="meta-label">Last Updated:</span>
                                        <span class="meta-value">@item.LastUpdated.Value.ToString("MMM d, yyyy HH:mm")</span>
                                    </div>
                                }
                            </div>
                            <div class="artifact-card-actions">
                                @foreach (var action in item.Actions)
                                {
                                    <button class="artifact-action-btn @(action.Enabled ? "" : "is-disabled")"
                                            disabled="@(!action.Enabled)"
                                            title="@(action.Reason ?? action.ExpectedEffect ?? action.Name)">
                                        @action.Name
                                    </button>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="notification notification-info" role="note">
            <strong>Coverage analysis belongs in Traceability &amp; Coverage.</strong>
            For coverage gaps, missing tests, orphan tests, and requirement coverage metrics, use the
            <a href="/traceability">standalone Traceability page</a>.
            This library is a repository of reusable QA assets.
        </div>
    }
    else if (PageModel?.ReadinessStatus == LibraryStatus.Empty)
    {
        <div class="empty-state-container">
            <div class="empty-state-icon">📚</div>
            <h2 class="empty-state-title">No artifacts loaded yet</h2>
            <p class="empty-state-description">Import or create artifacts to populate your QA library.</p>
        </div>
    }
</div>

@code {
    private LibraryPageModel? PageModel;
    private bool IsLoading = true;
    private string? LoadError;

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to workspace changes
        Workspace.ReviewContextRebuildNeeded += (s, e) => _ = RefreshPageModel();

        // Load initial model
        await RefreshPageModel();
    }

    private async Task RefreshPageModel()
    {
        try
        {
            IsLoading = true;
            LoadError = null;
            PageModel = await LibraryPageModelService.GetQAArtifactLibraryModelAsync();

            if (PageModel is null)
            {
                LoadError = "Failed to load artifact library";
            }
        }
        catch (Exception ex)
        {
            LoadError = $"Error loading library: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }
}

<style>
.artifact-library-shell {
    padding: 0 20px;
}

.loading-state {
    text-align: center;
    color: #6b7280;
    padding: 40px 20px;
}

.artifact-cards-section {
    margin-top: 32px;
}

.section-title {
    font-size: 18px;
    font-weight: 600;
    color: #111827;
    margin-bottom: 16px;
}

.artifact-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 16px;
    margin-bottom: 24px;
}

.artifact-card {
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    background: white;
    overflow: hidden;
    transition: all 0.2s ease;
}

.artifact-card:hover {
    border-color: #d1d5db;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.07);
}

.artifact-card-header {
    background: #f9fafb;
    padding: 12px 16px;
    display: flex;
    gap: 8px;
    align-items: center;
}

.artifact-type-badge {
    display: inline-block;
    background: #dbeafe;
    color: #1e40af;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
}

.artifact-source {
    display: inline-block;
    background: #f3f4f6;
    color: #6b7280;
    padding: 4px 12px;
    border-radius: 4px;
    font-size: 12px;
}

.artifact-card-body {
    padding: 16px;
}

.artifact-name {
    margin: 0 0 8px 0;
    font-size: 16px;
    font-weight: 600;
    color: #111827;
}

.artifact-description {
    margin: 0 0 12px 0;
    font-size: 14px;
    color: #6b7280;
    line-height: 1.5;
}

.artifact-meta {
    display: flex;
    gap: 8px;
    font-size: 12px;
    color: #9ca3af;
}

.meta-label {
    font-weight: 500;
}

.meta-value {
    color: #6b7280;
}

.artifact-card-actions {
    padding: 12px 16px;
    background: #f9fafb;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.artifact-action-btn {
    padding: 6px 12px;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    background: white;
    color: #374151;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
}

.artifact-action-btn:hover:not(.is-disabled) {
    background: #f3f4f6;
    border-color: #9ca3af;
}

.artifact-action-btn.is-disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.empty-state-container {
    text-align: center;
    padding: 60px 20px;
}

.empty-state-icon {
    font-size: 64px;
    margin-bottom: 16px;
}

.empty-state-title {
    font-size: 24px;
    font-weight: 600;
    color: #111827;
    margin-bottom: 8px;
}

.empty-state-description {
    font-size: 16px;
    color: #6b7280;
}
</style>
