    };
    private string WorkflowCurrentHint => WorkflowStage switch
    {
        LibraryWorkflowStage.NoArtifacts             => "Start by analyzing a specification to extract requirements, tests, and clarifications.",
        LibraryWorkflowStage.RequirementsNotImported => "Requirements have not yet been imported. Return to Specification Review to accept and save requirement artifacts.",
