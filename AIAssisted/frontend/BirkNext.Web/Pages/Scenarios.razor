    {
        LibraryWorkflowStage.NoArtifacts             => "No artifacts to analyze",
        LibraryWorkflowStage.RequirementsNotImported => "Requirements not yet imported",
        LibraryWorkflowStage.TestsMissing            => "Tests not yet imported",
        LibraryWorkflowStage.TraceabilityMissing     => "Traceability not yet established",
        LibraryWorkflowStage.CoverageEstablished     => RequiresCoverageAttention ? "Traceability needs attention" : "Coverage is clear",
        _ => "No artifacts to analyze",
    };
    private string CoverageGapDetail => WorkflowStage switch
    {
        LibraryWorkflowStage.NoArtifacts             => "Import requirements and tests to begin traceability analysis.",
        LibraryWorkflowStage.RequirementsNotImported => "No requirements have been imported. Requirements are needed before traceability gaps can be measured.",
        LibraryWorkflowStage.TestsMissing            => "Requirements are imported. Import tests to enable coverage and traceability analysis.",
        LibraryWorkflowStage.TraceabilityMissing     => "Requirements and tests exist but no traceability links have been established. Generate suggestions or create relationships manually.",
        LibraryWorkflowStage.CoverageEstablished     =>
