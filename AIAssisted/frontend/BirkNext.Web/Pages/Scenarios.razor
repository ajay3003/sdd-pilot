                    : UnlinkedClarificationCount > 0
                        ? $"{UnlinkedClarificationCount} clarification{Plural(UnlinkedClarificationCount)} are not connected to source artifacts."
                        : "Requirements, tests, and clarification relationships are connected.",
        _ => "Import requirements and tests to begin traceability analysis.",
    };
    private string TraceabilityHealthTitle => WorkflowStage switch
    {
        LibraryWorkflowStage.CoverageEstablished => $"{TraceabilityPercent}% Covered",
        LibraryWorkflowStage.TraceabilityMissing => "Not Established",
        _ => "Not Available",
