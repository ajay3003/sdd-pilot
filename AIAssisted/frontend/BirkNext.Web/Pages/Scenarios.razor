@page "/scenarios"
@using BirkNext.Web.Components
@using BirkNext.Web.GraphQL
@inject IBirkNextClient Client

<PageTitle>QA Artifact Library</PageTitle>

<div class="artifact-library-shell">
    <section class="artifact-hero" aria-label="QA artifact library summary">
        <div>
            <div class="workflow-step-badge"><a href="getting-started" class="workflow-step-link">Workflow</a> · Step @WorkflowCurrentStep of 7</div>
            <p class="section-kicker">QA Knowledge Base</p>
            <h1>QA Artifact Library</h1>
            <p class="page-lead">Store, review, and trace requirements, tests, clarifications, and their relationships.</p>
        </div>
        <div class="artifact-hero-metrics" aria-label="Knowledge base health">
            <div class="artifact-health-panel qa-status-panel status-@QaStatusTone">
                <span class="qa-status-label">@QaStatus</span>
                <span>QA status</span>
            </div>
            <div class="artifact-health-panel">
                <span class="artifact-health-score">@_scenarios.Count</span>
                <span>Total artifacts</span>
            </div>
            <div class="artifact-health-panel">
                <span class="artifact-health-score">@(RequirementCount > 0 ? $"{CoveragePercent}%" : "—")</span>
                <span>Requirement coverage</span>
            </div>
            <div class="artifact-health-panel @(WorkflowStage == LibraryWorkflowStage.CoverageEstablished && RequiresCoverageAttention ? "artifact-health-attention" : "")">
                <span class="artifact-health-score">@(WorkflowStage == LibraryWorkflowStage.CoverageEstablished ? AttentionCount.ToString() : "—")</span>
                <span>Quality risks</span>
            </div>
        </div>
    </section>

    <section class="workflow-banner" aria-label="Workflow progress">
        <div class="workflow-banner-header">
            <p class="section-kicker">Workflow Progress</p>
            <span>Step @WorkflowCurrentStep of 7</span>
        </div>
        <ol class="workflow-steps" aria-label="Workflow steps">
            @for (var _s = 1; _s <= 7; _s++)
            {
                var _sCss = _s < WorkflowCurrentStep ? "step-done" : _s == WorkflowCurrentStep ? "step-active" : "step-pending";
                <li class="workflow-step @_sCss">
                    <span class="step-indicator">@(_s < WorkflowCurrentStep ? "✓" : _s.ToString())</span>
                    <span class="step-label">@WorkflowStepLabel(_s)</span>
                </li>
            }
        </ol>
        <p class="workflow-hint">@WorkflowCurrentHint</p>
    </section>

    <section class="traceability-health-strip health-@TraceabilityHealthTone" aria-label="Traceability health">
        <div>
            <p class="section-kicker">Traceability Health</p>
            <h2>@TraceabilityHealthTitle</h2>
            <span>@TraceabilityHealthSubtitle</span>
        </div>
        <div class="health-bar" aria-hidden="true">
            <span style="width: @TraceabilityBarPercent%"></span>
        </div>
    </section>

    <section class="artifact-metrics-grid" aria-label="Artifact summary metrics">
        <div class="artifact-metric metric-total">
            <strong>@_scenarios.Count</strong>
            <span>Total Artifacts</span>
        </div>
        <div class="artifact-metric metric-requirements">
            <strong>@RequirementCount</strong>
            <span>Requirements</span>
        </div>
        <div class="artifact-metric metric-tests">
            <strong>@TestCount</strong>
            <span>Tests</span>
        </div>
        <div class="artifact-metric metric-clarifications">
            <strong>@ClarificationCount</strong>
            <span>Clarifications</span>
        </div>
        <div class="artifact-metric metric-traceability">
            <strong>@TraceabilityPercent%</strong>
            <span>Traceability</span>
        </div>
    </section>

    <section class="traceability-panel" aria-label="Traceability overview">
        <div>
            <p class="section-kicker">Relationships</p>
            <h2>Coverage Map</h2>
        </div>
        <div class="traceability-stats">
            <div>
                <strong>@CoveredRequirementCount</strong>
                <span>covered requirements</span>
            </div>
            <div>
                <strong>@RequirementsWithoutTests</strong>
                <span>requirements without tests</span>
            </div>
            <div>
                <strong>@RelationshipCount</strong>
                <span>saved relationships</span>
            </div>
        </div>
    </section>

    <section class="release-readiness-card release-@ReleaseReadinessTone" aria-label="Release readiness summary">
        <div>
            <p class="section-kicker">Release Readiness</p>
            <h2>@ReleaseReadiness</h2>
            <p>@ReleaseReadinessDetail</p>
        </div>
        <ul class="release-reason-list" aria-label="Release readiness reasons">
            @foreach (var reason in ReleaseReasons)
            {
                <li>@reason</li>
            }
        </ul>
    </section>

    <section class="recommended-actions-panel" aria-label="Recommended actions">
        <div class="recommended-actions-header">
            <div>
                <p class="section-kicker">Recommended Actions</p>
                <h2>What should be fixed next?</h2>
            </div>
            <span>@RecommendedActions.Count action@(Plural(RecommendedActions.Count))</span>
        </div>
        @if (RecommendedActions.Count == 0)
        {
            <div class="recommended-action-empty">No immediate action required.</div>
        }
        else
        {
            <ol class="recommended-action-list">
                @foreach (var action in RecommendedActions)
                {
                    <li class="@(action.IsDisabled ? "action-disabled" : "")">
                        <strong>
                            @if (action.Href is not null && !action.IsDisabled)
                            {
                                <a href="@action.Href">@action.Title</a>
                            }
                            else
                            {
                                @action.Title
                            }
                        </strong>
                        <span>@action.Detail</span>
                    </li>
                }
            </ol>
        }
    </section>

    @if (RequirementCount > 0 && TestCount > 0)
    {
        <section class="traceability-breakdown-panel" aria-label="Traceability breakdown">
            <div class="traceability-breakdown-item">
                <strong>@CoveredRequirementCount / @RequirementCount</strong>
                <span>Requirements covered</span>
            </div>
            <div class="traceability-breakdown-item risk">
                <strong>@RequirementsWithoutTests</strong>
                <span>Uncovered requirements</span>
            </div>
            <div class="traceability-breakdown-item">
                <strong>@TestsWithRequirements / @TestCount</strong>
                <span>Tests mapped</span>
            </div>
            <div class="traceability-breakdown-item risk">
                <strong>@UnmappedTestCount</strong>
                <span>Unmapped tests</span>
            </div>
            <div class="traceability-breakdown-item">
                <strong>@LinkedClarificationCount / @ClarificationCount</strong>
                <span>Clarifications linked</span>
            </div>
            <div class="traceability-breakdown-item risk">
                <strong>@UnlinkedClarificationCount</strong>
                <span>Unlinked clarifications</span>
            </div>
        </section>
    }

    <section class="coverage-gap-card @(RequiresCoverageAttention ? "coverage-gap-attention" : "coverage-gap-clear")" aria-label="Traceability gaps summary">
        <div class="coverage-gap-main">
            <p class="section-kicker">Traceability Gaps</p>
            <h2>@TraceabilityGapHeadline</h2>
            <p>@CoverageGapDetail</p>
        </div>
        @if (WorkflowStage >= LibraryWorkflowStage.TraceabilityMissing)
        {
            <div class="coverage-gap-metrics">
                <div>
                    <strong>@RequirementsWithoutTests</strong>
                    <span>uncovered requirements</span>
                </div>
                <div>
                    <strong>@UnmappedTestCount</strong>
                    <span>unmapped tests</span>
                </div>
                <div>
                    <strong>@UnlinkedClarificationCount</strong>
                    <span>unlinked clarifications</span>
                </div>
            </div>
        }
        else
        {
            <div class="coverage-gap-setup-hint">
                @if (WorkflowStage == LibraryWorkflowStage.RequirementsNotImported)
                {
                    <a href="/extract" class="btn-primary btn-sm">Import Requirements</a>
                }
                else if (WorkflowStage == LibraryWorkflowStage.TestsMissing)
                {
                    <a href="/extract" class="btn-primary btn-sm">Import Tests</a>
                }
            </div>
        }
    </section>

    @if (_pendingSuggestionCount > 0)
    {
        <div class="pending-suggestions-banner" role="status">
            <div class="pending-suggestions-info">
                <strong>@_pendingSuggestionCount traceability suggestion@(_pendingSuggestionCount == 1 ? "" : "s") ready for review</strong>
                @if (_highConfidenceSuggestionCount > 0)
                {
                    <span class="pending-suggestions-tag">@_highConfidenceSuggestionCount high confidence</span>
                }
            </div>
            <a href="traceability/suggestions" class="btn-primary btn-sm">Review Suggestions</a>
        </div>
    }

    <section class="requirement-map-panel" aria-label="Requirement to test mapping">
        <div class="requirement-map-header">
            <div>
                <p class="section-kicker">Requirement to Test Map</p>
                <h2>Requirement -> Test Coverage</h2>
            </div>
            <span>@CoveredRequirementCount of @RequirementCount covered</span>
        </div>
        @if (RequirementItems.Count == 0)
        {
            <div class="mapping-empty">
                @if (WorkflowStage == LibraryWorkflowStage.RequirementsNotImported || WorkflowStage == LibraryWorkflowStage.NoArtifacts)
                {
                    <span>No requirements have been imported into the QA Library.</span>
                    <br />
                    <a href="/extract" class="btn-primary btn-sm" style="display: inline-flex; margin-top: 0.65rem;">Import Requirements</a>
                }
                else
                {
                    <span>No requirements saved yet.</span>
                }
            </div>
        }
        else
        {
            <div class="mapping-list">
                @foreach (var requirement in RequirementItems)
                {
                    var linkedTests = GetLinkedArtifacts(requirement.Id, "Test");
                    <div class="mapping-row @(linkedTests.Count > 0 ? "mapping-covered" : "mapping-uncovered")">
                        <div class="mapping-requirement">
                            <strong>@requirement.Title</strong>
                            @if (linkedTests.Count == 0)
                            {
                                <span>No linked tests</span>
                                <p>Create or link at least one test scenario.</p>
                            }
                            else
                            {
                                <span>@linkedTests.Count linked test@Plural(linkedTests.Count)</span>
                            }
                        </div>
                        <div class="mapping-tests">
                            @if (linkedTests.Count == 0)
                            {
                                <span class="mapping-test-empty">No tests mapped</span>
                            }
                            else
                            {
                                @foreach (var test in linkedTests)
                                {
                                    <span class="mapping-test-pill">@test.Title</span>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <section class="scenarios-section">
        <div class="toolbar knowledge-toolbar">
            <span class="toolbar-meta">
                @if (_isLoading)
                {
                    <span>Loading...</span>
                }
                else if (_loadError is not null)
                {
                    <span>Artifacts unavailable</span>
                }
                else
                {
                    <span>@FilteredScenarios.Count shown of @_scenarios.Count</span>
                }
            </span>
            <div class="filter-bar">
                <input
                    type="search"
                    class="filter-search"
                    placeholder="Search artifacts..."
                    value="@_searchQuery"
                    @oninput="e => _searchQuery = e.Value?.ToString() ?? string.Empty"
                    aria-label="Search scenarios" />
                <select
                    class="filter-kind"
                    value="@_filterKind"
                    @onchange="e => _filterKind = e.Value?.ToString() ?? string.Empty"
                    aria-label="Filter by type">
                    <option value="">All types</option>
                    <option value="Requirement">Requirement</option>
                    <option value="Test">Test</option>
                    <option value="NeedsClarification">Needs Clarification</option>
                </select>
            </div>
        </div>

        <div class="filter-chip-grid" aria-label="Artifact filters">
            <button type="button" class="library-filter-chip @(IsTypeFilter("") && IsRelationshipFilter("") ? "is-active" : "")" @onclick='ClearAllFilters'>
                All <span>@_scenarios.Count</span>
            </button>
            <button type="button" class="library-filter-chip chip-requirement @(IsTypeFilter("Requirement") ? "is-active" : "")" @onclick='() => SetTypeFilter("Requirement")'>
                Requirements <span>@RequirementCount</span>
            </button>
            <button type="button" class="library-filter-chip chip-test @(IsTypeFilter("Test") ? "is-active" : "")" @onclick='() => SetTypeFilter("Test")'>
                Tests <span>@TestCount</span>
            </button>
            <button type="button" class="library-filter-chip chip-clarification @(IsTypeFilter("NeedsClarification") ? "is-active" : "")" @onclick='() => SetTypeFilter("NeedsClarification")'>
                Clarifications <span>@ClarificationCount</span>
            </button>
            <button type="button" class="library-filter-chip @(IsRelationshipFilter("linked") ? "is-active" : "")" @onclick='() => SetRelationshipFilter("linked")'>
                Linked <span>@LinkedArtifactCount</span>
            </button>
            <button type="button" class="library-filter-chip @(IsRelationshipFilter("gaps") ? "is-active" : "")" @onclick='() => SetRelationshipFilter("gaps")'>
                Coverage Gaps <span>@AttentionCount</span>
            </button>
        </div>

        @if (_linksUnavailable)
        {
            <p class="relationship-load-note" role="status">Traceability links are unavailable right now; artifact counts are still current.</p>
        }

        @if (_isLoading)
        {
            <p class="loading-state">Loading scenarios...</p>
        }
        else if (_loadError is not null)
        {
            <div class="scenario-load-error" role="alert" data-testid="scenario-load-error">
                @_loadError
            </div>
        }
        else
        {
            var isDragEnabled = _filterKind == "Test" && string.IsNullOrEmpty(_searchQuery) && string.IsNullOrEmpty(_relationshipFilter);
            var testItems = FilteredScenarios.Where(s => s.Kind == "Test").ToList();
            var reqItems = FilteredScenarios.Where(s => s.Kind == "Requirement").ToList();
            var clrItems = FilteredScenarios.Where(s => s.Kind == "NeedsClarification").ToList();
            var anyVisible = testItems.Count > 0 || reqItems.Count > 0 || clrItems.Count > 0;
            @if (!anyVisible)
            {
                <div class="empty-state empty-state-dashed" data-testid="empty-state">
                    @if (_scenarios.Count == 0)
                    {
                        <h3>Why create scenarios?</h3>
                        <p>Scenarios improve:</p>
                        <ol>
                            <li>Requirement coverage</li>
                            <li>Traceability</li>
                            <li>QA Health Score</li>
                            <li>Release readiness</li>
                        </ol>
                        <div class="empty-state-actions">
                            <a href="/extract">Analyze Specification</a>
                            <a href="scenarios/new">Create Test Scenario</a>
                        </div>
                    }
                    else
                    {
                        <p>No QA artifacts match the current filters.</p>
                    }
                </div>
            }
            else
            {
                @if (reqItems.Count > 0)
                {
                    <section class="artifact-group" data-testid="group-requirements">
                        <div class="artifact-group-heading">
                            <h2 class="artifact-group-header">Requirements</h2>
                            <span>@CoveredRequirementCount of @RequirementCount covered</span>
                        </div>
                        <ScenarioList
                            Scenarios="reqItems"
                            OnDeleteRequested="HandleDeleteAsync"
                            DeletingId="_deletingId"
                            DeleteErrors="_deleteErrors"
                            RelationshipSummaries="RelationshipSummaries" />
                    </section>
                }
                @if (testItems.Count > 0)
                {
                    <section class="artifact-group" data-testid="group-tests">
                        <div class="artifact-group-heading">
                            <h2 class="artifact-group-header">Tests</h2>
                            <span>@TestsWithRequirements of @TestCount traced</span>
                        </div>
                        @if (isDragEnabled)
                        {
                            <p class="drag-hint" data-testid="drag-hint">Drag tests to define execution order.</p>
                        }
                        <ScenarioList
                            Scenarios="testItems"
                            OnDeleteRequested="HandleDeleteAsync"
                            DeletingId="_deletingId"
                            DeleteErrors="_deleteErrors"
                            IsDraggable="@isDragEnabled"
                            OnReordered="HandleReorderAsync"
                            RelationshipSummaries="RelationshipSummaries" />
                    </section>
                }
                @if (_reorderError is not null)
                {
                    <div class="reorder-error" role="alert" data-testid="reorder-error">@_reorderError</div>
                }
                @if (clrItems.Count > 0)
                {
                    <section class="artifact-group" data-testid="group-clarifications">
                        <div class="artifact-group-heading">
                            <h2 class="artifact-group-header">Needs Clarification</h2>
                            <span>@clrItems.Count open question@Plural(clrItems.Count)</span>
                        </div>
                        <ScenarioList
                            Scenarios="clrItems"
                            OnDeleteRequested="HandleDeleteAsync"
                            DeletingId="_deletingId"
                            DeleteErrors="_deleteErrors"
                            RelationshipSummaries="RelationshipSummaries" />
                    </section>
                }
            }
        }
    </section>
</div>

@code {
    private const string ProjectId = "00000000-0000-0000-0000-000000000001";
    private IReadOnlyList<ScenarioListItem> _scenarios = [];
    private IReadOnlyList<ArtifactLink> _links = [];
    private bool _isLoading;
    private string _searchQuery = string.Empty;
    private string _filterKind = string.Empty;
    private string _relationshipFilter = string.Empty;
    private string? _loadError;
    private bool _linksUnavailable;
    private string? _deletingId;
    private Dictionary<string, string> _deleteErrors = [];
    private string? _reorderError;
    private int _pendingSuggestionCount;
    private int _highConfidenceSuggestionCount;

    private IReadOnlyList<ScenarioListItem> FilteredScenarios =>
        _scenarios
            .Where(s =>
                (string.IsNullOrEmpty(_filterKind) || s.Kind == _filterKind) &&
                MatchesRelationshipFilter(s) &&
                (string.IsNullOrEmpty(_searchQuery) ||
                 s.Title.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                 (s.Description?.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ?? false)))
            .ToList();

    private enum LibraryWorkflowStage
    {
        NoArtifacts,
        RequirementsNotImported,
        TestsMissing,
        TraceabilityMissing,
        CoverageEstablished,
    }

    private LibraryWorkflowStage WorkflowStage =>
        _scenarios.Count == 0
            ? LibraryWorkflowStage.NoArtifacts
            : RequirementCount == 0
                ? LibraryWorkflowStage.RequirementsNotImported
                : TestCount == 0
                    ? LibraryWorkflowStage.TestsMissing
                    : RelationshipCount == 0
                        ? LibraryWorkflowStage.TraceabilityMissing
                        : LibraryWorkflowStage.CoverageEstablished;

    private int RequirementCount => CountKind("Requirement");
    private int TestCount => CountKind("Test");
    private int ClarificationCount => CountKind("NeedsClarification");
    private int RelationshipCount => _links.Count;
    private IReadOnlyList<ScenarioListItem> RequirementItems => _scenarios.Where(s => s.Kind == "Requirement").ToList();
    private int CoveredRequirementCount => _scenarios.Count(s => s.Kind == "Requirement" && GetRelationshipSummary(s.Id).LinkedTests > 0);
    private int RequirementsWithoutTests => Math.Max(0, RequirementCount - CoveredRequirementCount);
    private int TestsWithRequirements => _scenarios.Count(s => s.Kind == "Test" && GetRelationshipSummary(s.Id).LinkedRequirements > 0);
    private int UnmappedTestCount => Math.Max(0, TestCount - TestsWithRequirements);
    private int LinkedClarificationCount => _scenarios.Count(s => s.Kind == "NeedsClarification" && GetRelationshipSummary(s.Id).HasTraceability);
    private int UnlinkedClarificationCount => _scenarios.Count(s => s.Kind == "NeedsClarification" && !GetRelationshipSummary(s.Id).HasTraceability);
    private int AttentionCount => _scenarios.Count(s => GetRelationshipSummary(s.Id).RequiresAttention);
    private int LinkedArtifactCount => _scenarios.Count(s => GetRelationshipSummary(s.Id).HasTraceability);
    private bool RequiresCoverageAttention =>
        WorkflowStage == LibraryWorkflowStage.CoverageEstablished &&
        (RequirementsWithoutTests > 0 || UnmappedTestCount > 0 || UnlinkedClarificationCount > 0);
    private int CoveragePercent => WorkflowStage == LibraryWorkflowStage.CoverageEstablished
        ? Percent(CoveredRequirementCount, RequirementCount)
        : 0;
    private int TraceabilityPercent => WorkflowStage == LibraryWorkflowStage.CoverageEstablished
        ? Percent(_scenarios.Count(s => GetRelationshipSummary(s.Id).HasTraceability), _scenarios.Count)
        : 0;
    private string QaStatus => WorkflowStage switch
    {
        LibraryWorkflowStage.NoArtifacts             => "No Data",
        LibraryWorkflowStage.RequirementsNotImported => "Requirements Not Imported",
        LibraryWorkflowStage.TestsMissing            => "Tests Missing",
        LibraryWorkflowStage.TraceabilityMissing     => "Traceability Missing",
        LibraryWorkflowStage.CoverageEstablished     =>
            RequirementsWithoutTests > 0 ? "At Risk"
            : AttentionCount > 0        ? "Attention"
            : "Healthy",
        _ => "No Data",
    };
    private string QaStatusTone => QaStatus switch
    {
        "Healthy"                   => "healthy",
        "Attention"                 => "attention",
        "At Risk"                   => "risk",
        "Traceability Missing"      => "attention",
        "Requirements Not Imported" => "empty",
        "Tests Missing"             => "empty",
        _ => "empty",
    };
    private string ReleaseReadiness => WorkflowStage switch
    {
        LibraryWorkflowStage.NoArtifacts             => "Not Started",
        LibraryWorkflowStage.RequirementsNotImported => "Incomplete Setup",
        LibraryWorkflowStage.TestsMissing            => "Incomplete Setup",
        LibraryWorkflowStage.TraceabilityMissing     => "Incomplete Setup",
        LibraryWorkflowStage.CoverageEstablished     =>
            QaStatus == "Healthy"   ? "Ready"
            : QaStatus == "Attention" ? "Needs Review"
            : "Not Ready",
        _ => "Not Started",
    };
    private string ReleaseReadinessTone => ReleaseReadiness switch
    {
        "Ready"        => "ready",
        "Needs Review" => "review",
        _ => "not-ready",
    };
    private string ReleaseReadinessDetail => WorkflowStage switch
    {
        LibraryWorkflowStage.NoArtifacts             => "Import requirements and tests before assessing release readiness.",
        LibraryWorkflowStage.RequirementsNotImported => "Requirements must be imported before release readiness can be assessed.",
        LibraryWorkflowStage.TestsMissing            => "Acceptance tests must be imported before release readiness can be assessed.",
        LibraryWorkflowStage.TraceabilityMissing     => "Traceability links must be created before release readiness can be assessed.",
        LibraryWorkflowStage.CoverageEstablished     => ReleaseReadiness switch
        {
            "Ready"        => "Traceability is connected and no quality risks are currently visible.",
            "Needs Review" => "Some traceability items need review before release confidence is clear.",
            _              => "Traceability gaps must be resolved before this library is release-ready.",
        },
        _ => "Import requirements and tests before assessing release readiness.",
    };
    private IReadOnlyList<string> ReleaseReasons
    {
        get
        {
            var reasons = new List<string>();
            switch (WorkflowStage)
            {
                case LibraryWorkflowStage.NoArtifacts:
                    reasons.Add("No saved artifacts");
                    break;
                case LibraryWorkflowStage.RequirementsNotImported:
                    reasons.Add("Requirements not imported");
                    if (TestCount > 0) reasons.Add($"{TestCount} test{Plural(TestCount)} without requirements");
                    break;
                case LibraryWorkflowStage.TestsMissing:
                    reasons.Add($"{RequirementCount} requirement{Plural(RequirementCount)} imported");
                    reasons.Add("No tests available for coverage");
                    break;
                case LibraryWorkflowStage.TraceabilityMissing:
                    reasons.Add($"{RequirementCount} requirement{Plural(RequirementCount)} imported");
                    reasons.Add($"{TestCount} test{Plural(TestCount)} imported");
                    reasons.Add("No traceability relationships created");
                    break;
                case LibraryWorkflowStage.CoverageEstablished:
                    if (RequirementsWithoutTests > 0) reasons.Add($"{RequirementsWithoutTests} uncovered requirement{Plural(RequirementsWithoutTests)}");
                    if (UnmappedTestCount > 0) reasons.Add($"{UnmappedTestCount} unmapped test{Plural(UnmappedTestCount)}");
                    if (UnlinkedClarificationCount > 0) reasons.Add($"{UnlinkedClarificationCount} unlinked clarification{Plural(UnlinkedClarificationCount)}");
                    if (reasons.Count == 0) reasons.Add("No release blockers visible");
                    break;
            }
            return reasons;
        }
    }
    private IReadOnlyList<RecommendedAction> RecommendedActions
    {
        get
        {
            var actions = new List<RecommendedAction>();

            switch (WorkflowStage)
            {
                case LibraryWorkflowStage.NoArtifacts:
                    actions.Add(new("Analyze a specification", "Use the Spec Analysis tool to extract requirements, tests, and clarifications.", "/extract"));
                    actions.Add(new("Create a manual test scenario", "Add individual test scenarios to the library.", "/scenarios/new"));
                    break;

                case LibraryWorkflowStage.RequirementsNotImported:
                    actions.Add(new("Import Requirements", "Tests exist but no requirements are available. Return to specification review to accept and save requirement artifacts.", "/extract"));
                    actions.Add(new("Return to Specification Review", "Accept requirement artifacts from a previous analysis session.", "/extract"));
                    actions.Add(new("Generate Traceability Suggestions", "Available after requirements have been imported.", IsDisabled: true));
                    break;

                case LibraryWorkflowStage.TestsMissing:
                    actions.Add(new("Import Tests", "Requirements imported. Accept and save test artifacts to enable traceability analysis.", "/extract"));
                    actions.Add(new("Return to Specification Review", "Accept test artifacts from a previous analysis session.", "/extract"));
                    break;

                case LibraryWorkflowStage.TraceabilityMissing:
                    if (_pendingSuggestionCount > 0)
                    {
                        actions.Add(new("Review Suggested Links", $"{_pendingSuggestionCount} suggestion{Plural(_pendingSuggestionCount)} are ready for review.", "traceability/suggestions"));
                        if (_highConfidenceSuggestionCount > 0)
                            actions.Add(new("Accept High Confidence Links", $"{_highConfidenceSuggestionCount} high-confidence suggestion{Plural(_highConfidenceSuggestionCount)} can be accepted.", "traceability/suggestions"));
                    }
                    else
                    {
                        actions.Add(new("Generate Traceability Suggestions", "Requirements and tests exist. Generate AI-suggested links based on semantic similarity and ID references.", "traceability/suggestions"));
                        actions.Add(new("Create Traceability Relationships", "Manually create relationships between requirements and tests.", "traceability"));
                    }
                    break;

                case LibraryWorkflowStage.CoverageEstablished:
                    if (_pendingSuggestionCount > 0)
                    {
                        actions.Add(new("Review Suggested Links", $"{_pendingSuggestionCount} suggestion{Plural(_pendingSuggestionCount)} are ready for review.", "traceability/suggestions"));
                        if (_highConfidenceSuggestionCount > 0)
                            actions.Add(new("Accept High Confidence Links", $"{_highConfidenceSuggestionCount} high-confidence suggestion{Plural(_highConfidenceSuggestionCount)} can be bulk-accepted.", "traceability/suggestions"));
                    }
                    else if (RequiresCoverageAttention)
                    {
                        if (RequirementsWithoutTests > 0)
                            actions.Add(new("Resolve Coverage Gaps", $"{RequirementsWithoutTests} requirement{Plural(RequirementsWithoutTests)} still need test coverage.", "/extract"));
                        if (UnmappedTestCount > 0)
                            actions.Add(new("Map Orphaned Tests", $"{UnmappedTestCount} test{Plural(UnmappedTestCount)} are not linked to any requirement.", "traceability"));
                        foreach (var req in RequirementItems.Where(r => GetRelationshipSummary(r.Id).LinkedTests == 0).Take(2))
                            actions.Add(new($"Cover: {ShortTitle(req.Title)}", "Create or link at least one test."));
                        if (UnlinkedClarificationCount > 0)
                            actions.Add(new("Link Open Clarifications", $"{UnlinkedClarificationCount} clarification{Plural(UnlinkedClarificationCount)} need traceability links.", "traceability"));
                    }
                    break;
            }

            return actions.Take(5).ToList();
        }
    }
