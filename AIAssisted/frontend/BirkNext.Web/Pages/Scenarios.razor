        LibraryWorkflowStage.TestsMissing            => 3,
        LibraryWorkflowStage.TraceabilityMissing     => _pendingSuggestionCount > 0 ? 5 : 4,
        LibraryWorkflowStage.CoverageEstablished     => _pendingSuggestionCount > 0 ? 5 : 7,
