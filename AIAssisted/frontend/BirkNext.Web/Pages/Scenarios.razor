    private string TraceabilityHealthSubtitle => WorkflowStage switch
    {
        LibraryWorkflowStage.CoverageEstablished     => $"Requirements Covered: {CoveredRequirementCount}/{RequirementCount}",
        LibraryWorkflowStage.TraceabilityMissing     => "Create traceability links to see coverage",
        LibraryWorkflowStage.RequirementsNotImported => "Import requirements to enable traceability",
        LibraryWorkflowStage.TestsMissing            => "Import tests to enable traceability",
