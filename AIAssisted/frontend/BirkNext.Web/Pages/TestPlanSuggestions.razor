    private string? RequirementText(string requirementId, string? path, string language) =>
        (_draft?.RequirementTranslations ?? []).Where(t => string.Equals(t.Language, language, StringComparison.OrdinalIgnoreCase)
                && string.Equals(t.RequirementId, requirementId, StringComparison.OrdinalIgnoreCase)
