        _busy = true;
        Info($"Translating every scenario to {name}…");
        var (result, error) = await _api!.TranslateAllAsync(_draft.Id, new TranslatePlanRequest(_draft.Revision, _translateAllOverwrite, target));
        _busy = false;
        if (result is null) { ShowPlanIn(groups, target); _translateAllHelp = target; Fail(error ?? "The plan could not be translated."); return; }
        _translateAllHelp = null;
        if (result.Draft is { } draft) { _draft = draft; await ReloadWorkspaceAsync(); }
        ShowPlanIn(ScenarioPlanning.Groups(_draft!), result.Target ?? target);
        var detail = result.Failed.Count > 0 ? " " + string.Join(" ", result.Failed.Take(3)) : "";
        if (result.Failed.Count > 0 && result.Translated.Count == 0) Fail(result.Message + detail); else Ok(result.Message + detail);
    }

