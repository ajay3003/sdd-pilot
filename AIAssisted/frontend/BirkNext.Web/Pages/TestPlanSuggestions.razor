                            <a class="tps-btn tps-btn-quiet" href="technical-testing/assess" data-testid="tps-manual-empty-open-technical">Open Technical Testing</a>
                            @if (_inventory.Unclassified > 0) { <button type="button" class="tps-btn tps-btn-quiet" @onclick="() => SetView(P.CandidateView.Attention)">Needs attention (@_inventory.Attention)</button> }
                        </p>
                    </div>
                }
                else
                {
                    @if (recommended.Count > 0 && recommended.Count < inView.Count)
                    {
                        <div class="tps-recommend" data-testid="tps-recommend">
                            <span class="tps-density" role="group" aria-label="Which candidates to list">
                                <button type="button" class="tps-density-btn" aria-pressed="@(recommendedOn ? "true" : "false")" @onclick="() => { _recommended = true; _limit = P.PageSize; }" data-testid="tps-recommended-on">Recommended <span class="tps-count">@recommended.Count</span></button>
                                <button type="button" class="tps-density-btn" aria-pressed="@(recommendedOn ? "false" : "true")" @onclick="() => { _recommended = false; _limit = P.PageSize; }" data-testid="tps-recommended-off">All <span class="tps-count">@inView.Count</span></button>
                            </span>
                            <span class="tps-muted tps-small" data-testid="tps-recommend-hint">@(recommendedOn ? P.RecommendedHint(recommended) : $"Showing all {inView.Count} candidates in this view.")</span>
                        </div>
                    }
                    <div class="tps-filters" role="search" aria-label="Filter candidates">
                        <label class="tps-field tps-field-grow"><span class="tps-k">Search</span><input class="tps-input" type="search" placeholder="Title, purpose, area or requirement" value="@_catalog.Query" @oninput="e => _catalog = _catalog with { Query = e.Value?.ToString() ?? string.Empty }" data-testid="tps-search" /></label>
                        <label class="tps-field"><span class="tps-k">Area</span>
                            <select class="tps-input" @onchange="e => _catalog = _catalog with { Area = Empty(e) }" data-testid="tps-filter-area">
                                <option value="">All</option>
                                @foreach (var a in inView.Select(P.AreaOf).Distinct().OrderBy(a => a, StringComparer.CurrentCultureIgnoreCase)) { <option value="@a" selected="@(_catalog.Area == a)">@a</option> }
                            </select></label>
                        <label class="tps-field"><span class="tps-k">Source</span>
                            <select class="tps-input" @onchange="e => _catalog = _catalog with { Source = Empty(e) }" data-testid="tps-filter-source">
                                <option value="">All</option>
                                @foreach (var s in inView.Select(c => c.SourceCategory).Distinct()) { <option value="@s" selected="@(_catalog.Source == s)">@s</option> }
                            </select></label>
                        <label class="tps-field"><span class="tps-k">Group by</span>
                            <select class="tps-input" @onchange="e => _grouping = Enum.TryParse<P.CatalogGrouping>(e.Value?.ToString(), out var g) ? g : null" data-testid="tps-group-by">
                                @foreach (var g in Enum.GetValues<P.CatalogGrouping>().Where(g => g != P.CatalogGrouping.Story || inView.Any(c => c.Story is not null))) { <option value="@g" selected="@(grouping == g)">@P.GroupingLabel(g)</option> }
                            </select></label>
                        <details class="tps-more-filters" data-testid="tps-more-filters" open="@(moreFilters > 0)">
                            <summary>More filters@(moreFilters > 0 ? $" ({moreFilters})" : "")</summary>
                            <div class="tps-more-filters-body">
                                <label class="tps-field"><span class="tps-k">Type</span>
                                    <select class="tps-input" @onchange="e => _catalog = _catalog with { Type = Enum.TryParse<ScenarioCandidateType>(e.Value?.ToString(), out var t) ? t : null }" data-testid="tps-filter-type">
                                        <option value="">All</option>
                                        @foreach (var t in inView.Select(c => c.Type).Distinct().OrderBy(t => t)) { <option value="@t" selected="@(_catalog.Type == t)">@ScenarioCandidateTypes.Label(t)</option> }
                                    </select></label>
                                <label class="tps-field"><span class="tps-k">Existing tests</span>
                                    <select class="tps-input" @onchange="e => _catalog = _catalog with { Tests = Empty(e) }" data-testid="tps-filter-tests">
                                        <option value="">All</option><option value="with" selected="@(_catalog.Tests == "with")">With an existing test</option><option value="without" selected="@(_catalog.Tests == "without")">Without an existing test</option>
                                    </select></label>
                                <label class="tps-field tps-check"><input type="checkbox" checked="@_catalog.AttentionOnly" @onchange="e => _catalog = _catalog with { AttentionOnly = e.Value is true }" data-testid="tps-filter-attention" /> Only needing attention</label>
                            </div>
                        </details>
                    </div>
                    <div class="tps-selectbar" role="group" aria-label="Selection">
                        <span data-testid="tps-selected-count" aria-live="polite"><strong>@_selected.Count</strong> selected</span>
                        @if (hiddenSelected > 0) { <span class="tps-tone tps-tone-info" data-testid="tps-selected-hidden">@hiddenSelected hidden by filters — still selected</span> }
                        <span class="tps-muted tps-small" data-testid="tps-shown-count">@shown.Count of @inView.Count in this view</span>
                        <button type="button" class="tps-btn tps-btn-quiet" disabled="@(shown.Count == 0)" @onclick="() => { foreach (var c in shown) _selected.Add(c.CandidateId); }" data-testid="tps-select-shown">Select visible (@shown.Count)</button>
                        <button type="button" class="tps-btn tps-btn-quiet" disabled="@(_selected.Count == 0)" @onclick="() => { _selected.Clear(); _preview = null; }" data-testid="tps-clear-selection">Clear selection</button>
                        <span class="tps-density" role="group" aria-label="Row density" data-testid="tps-density">
                            <button type="button" class="tps-density-btn" aria-pressed="@(compact ? "true" : "false")" @onclick="() => _compact = true" data-testid="tps-density-compact">Compact</button>
                            <button type="button" class="tps-density-btn" aria-pressed="@(compact ? "false" : "true")" @onclick="() => _compact = false" data-testid="tps-density-detailed">Detailed</button>
                        </span>
                    </div>
                    @if (shown.Count == 0) { <p class="tps-muted" data-testid="tps-no-match">No scenario matches these filters in this view.</p> }
                    <div class="tps-groups @(compact ? "is-compact" : null)" data-testid="tps-candidates" data-density="@(compact ? "compact" : "detailed")">
                        @{ var groups = P.Group(visible, grouping, _inventory).ToList(); var firstGroup = true; }
                        @foreach (var group in groups)
                        {
                            // Many candidates: only the first group starts open (the headings with their counts are the overview); a few: all open.
                            // The tester's own choice per group wins.
                            var open = _groupOpen.TryGetValue(group.Id, out var chosen) ? chosen : firstGroup || shown.Count <= GroupsOpenUpTo;
                            firstGroup = false;
                            var selectedHere = group.Items.Count(c => _selected.Contains(c.CandidateId));
                            <section class="tps-group" aria-labelledby="tps-g-@group.Id" data-testid="tps-group-@group.Id" data-open="@(open ? "true" : "false")">
                                <h3 id="tps-g-@group.Id" class="tps-group-h">
                                    <button type="button" class="tps-group-toggle" aria-expanded="@(open ? "true" : "false")" aria-controls="tps-gl-@group.Id" data-testid="tps-group-toggle-@group.Id"
                                            @onclick="() => _groupOpen[group.Id] = !open">@group.Title <span class="tps-count">@group.Items.Count</span>@if (selectedHere > 0) { <span class="tps-tone tps-tone-info">@selectedHere selected</span> }</button>
                                </h3>
                                <ul class="tps-rows" id="tps-gl-@group.Id" hidden="@(!open)">
                                    @if (open)
                                    {
                                        @* User story grouping folds the variants of one situation (2026-11-23); other groupings list every row. *@
                                        foreach (var entry in grouping == P.CatalogGrouping.Story ? P.Fold(group.Items) : group.Items.Select(c => new P.ListEntry(c, null, [c])).ToList())
                                        {
                                            if (entry.Single is { } c) { @CandidateRow(c, inDraft.Contains(c.CandidateId)) }
                                            else { @VariantRow(entry, inDraft) }
                                        }
                                    }
                                </ul>
                            </section>
                        }
                    </div>
                    @if (shown.Count > visible.Count)
                    {
                        <button type="button" class="tps-btn tps-btn-quiet" @onclick="() => _limit += P.PageSize" data-testid="tps-show-more">Show @Math.Min(P.PageSize, shown.Count - visible.Count) more (@visible.Count of @shown.Count shown)</button>
                    }
                }
            }
            @if (CanWrite)
            {
                @if (_preview is { } preview)
                {
                    @* Preparation preview: shown before a bulk preparation or one that needs a look (technical candidates, overlaps, missing expected
                       results or prerequisites). Nothing is created until the tester confirms. *@
                    <section class="tps-preview" role="region" aria-labelledby="tps-preview-h" tabindex="-1" id="tps-preview" data-testid="tps-preview">
                        <h3 id="tps-preview-h" class="tps-h3">Prepare @preview.Adding test case@(preview.Adding == 1 ? "" : "s")?</h3>
                        <ul class="tps-plain tps-preview-list">
                            <li data-testid="tps-preview-kinds">@string.Join(" · ", preview.Kinds.Select(k => $"{k.Count} {k.Kind.ToLowerInvariant()}"))</li>
                            @if (preview.AlreadyInPlan > 0) { <li data-testid="tps-preview-in-plan">@preview.AlreadyInPlan already in the plan — not added again</li> }
                            @if (preview.Technical > 0) { <li data-testid="tps-preview-technical">@preview.Technical technical candidate@(preview.Technical == 1 ? " is" : "s are") normally verified in Technical Testing; @(preview.Technical == 1 ? "it becomes" : "they become") manual cases only because you chose so</li> }
                            @if (preview.Overlaps > 0) { <li data-testid="tps-preview-overlaps">@preview.Overlaps may overlap a case already in the plan or another selected candidate (same requirement through another source, or the same contract operation in another file)</li> }
                            @if (preview.MissingExpected > 0) { <li data-testid="tps-preview-missing-expected">@preview.MissingExpected without an expected result in the evidence — they start as Needs clarification</li> }
                            @if (preview.IncompleteSteps > 0) { <li data-testid="tps-preview-incomplete-steps">@preview.IncompleteSteps with no steps, or steps without an expected result, in the evidence — write them before approving (the Azure DevOps export needs an expected result on every step)</li> }
                            @if (preview.MissingPrerequisites > 0) { <li data-testid="tps-preview-missing-prerequisites">@preview.MissingPrerequisites with a missing test prerequisite (Test Data, access or environment)</li> }
                        </ul>
                        <p class="tps-muted tps-small">Preparing creates reviewable drafts only: nothing is approved, executed or counted as coverage.</p>
                        <p class="tps-inline-actions">
                            <button type="button" class="tps-btn" disabled="@_busy" @onclick="PrepareAsync" data-testid="tps-preview-confirm">Prepare @preview.Adding test case@(preview.Adding == 1 ? "" : "s")</button>
                            <button type="button" class="tps-btn tps-btn-quiet" @onclick="() => _preview = null" data-testid="tps-preview-cancel">Back to the selection</button>
                        </p>
                    </section>
                }
                <div class="tps-actionbar tps-actionbar-sticky" data-testid="tps-prepare-bar">
                    <span aria-live="polite"><strong>@_selected.Count</strong> scenario@(_selected.Count == 1 ? "" : "s") selected</span>
                    @if (hiddenSelected > 0 && _candidates.Count > 0) { <span class="tps-muted tps-small" data-testid="tps-prepare-hidden">@hiddenSelected not shown here</span> }
                    @if (alreadyPrepared > 0) { <span class="tps-muted tps-small" data-testid="tps-prepare-in-plan">@alreadyPrepared already in the plan</span> }
                    @if (overlaps > 0) { <span class="tps-tone tps-tone-warn" data-testid="tps-prepare-overlaps">@overlaps may overlap existing cases</span> }
                    <button type="button" class="tps-btn" disabled="@(_busy || adding == 0)" @onclick="PrepareClickedAsync" data-testid="tps-prepare">@(_draft is null ? (adding > 1 ? $"Prepare {adding} test cases" : "Prepare test cases") : $"Add {adding} to the plan")</button>
                    @if (_selected.Count > 0 && adding == 0) { <span class="tps-muted tps-small">Every selected scenario is already in the plan.</span> }
                    @if (_selected.Count == 0) { <span class="tps-muted tps-small" data-testid="tps-select-hint">Select at least one scenario to prepare test cases.</span> }
                </div>
                @if (!GuideMode)
                {
                    @ManualCaseAdvanced(ChooseManualForm)
                }
            }
        </section>
    };

    /// <summary>The candidate ids that are cases of the open plan (a saved case is never an executed test).</summary>
    private IReadOnlySet<string> InPlan => _draft?.Cases.Select(c => c.Source.ScenarioId).ToHashSet(StringComparer.Ordinal) ?? (IReadOnlySet<string>)new HashSet<string>();

    /// <summary>One ordinary case is prepared at once; a bulk selection, or one that needs a look, shows the preview first.</summary>
    private async Task PrepareClickedAsync()
    {
        if (_dirty) { Fail("Save or discard your changes first."); return; }
        var preview = P.Preview(_selected, _candidates, _inventory, InPlan, stepsKnown: !GuideMode);
        if (!preview.NeedsConfirmation) { await PrepareAsync(); return; }
        _preview = preview;
        _revealPreview = true;
    }

    private bool _revealPreview;

    /// <summary>The tester's row density choice; null until chosen (then a long list starts compact, a short one detailed).</summary>
    private bool? _compact;

    /// <summary>Up to this many matching candidates every group starts open; above it only the first group does.</summary>
    private const int GroupsOpenUpTo = 40;
    private readonly Dictionary<string, bool> _groupOpen = new(StringComparer.Ordinal);

    /// <summary>Opens a case of the plan (Prepare test cases, the case expanded) — from a candidate that is already prepared.</summary>
    private void OpenCase(string id)
    {
        _openCases.Add(id);
        _scenarioChosen = false; _openScenario = null; // the case's own scenario opens with it
        GoArea("prepare");
        _revealArea = true;
    }

    /// <summary>
    /// Writing a test case by hand is an advanced path: tests BirkNext did not discover are normally added in Azure DevOps Test Plans after the
    /// file is imported. It stays for linking a requirement before export; collapsed unless a title is being written (or a variant was started).
    /// </summary>
    private RenderFragment ManualCaseAdvanced(RenderFragment form) => __builder =>
    {
        <details class="tps-advanced" data-testid="tps-advanced-manual" open="@(!string.IsNullOrWhiteSpace(_manualTitle))">
            <summary>Advanced: write a test case by hand</summary>
            <p class="tps-muted tps-small" data-testid="tps-manual-where">Tests BirkNext did not find are normally added in Azure DevOps Test Plans after you import the exported file. Write one here only when it must be linked to a requirement in BirkNext before the export.</p>
            @form
        </details>
    };

    private RenderFragment ChooseManualForm => __builder =>
    {
        <div class="tps-actionbar tps-actionbar-compact" data-testid="tps-manual-bar">
            <label class="tps-field tps-field-grow"><span class="tps-k">Title</span><input class="tps-input" id="tps-manual-title" @bind="_manualTitle" @bind:event="oninput" placeholder="Title, e.g. Return a borrowed book" data-testid="tps-manual-title" /></label>
            <button type="button" class="tps-btn tps-btn-quiet" disabled="@(_busy || string.IsNullOrWhiteSpace(_manualTitle))" @onclick="AddManualAsync" data-testid="tps-manual-create">Add test case</button>
            @if (string.IsNullOrWhiteSpace(_manualTitle)) { <span class="tps-muted tps-small" data-testid="tps-manual-hint">Type a title to add a test case.</span> }
        </div>
    };

    private RenderFragment PrepareManualForm => __builder =>
    {
        <div class="tps-actionbar tps-actionbar-compact">
            <label class="tps-field tps-field-grow"><span class="tps-k">Title</span><input class="tps-input" @bind="_manualTitle" @bind:event="oninput" placeholder="Title of a new test case" data-testid="tps-manual-title" /></label>
            <button type="button" class="tps-btn tps-btn-quiet" disabled="@(_busy || _dirty || string.IsNullOrWhiteSpace(_manualTitle))" @onclick="AddManualAsync" data-testid="tps-manual-add">Add test case</button>
            @if (_dirty) { <span class="tps-muted tps-small" data-testid="tps-manual-hint">Save or discard your changes first.</span> }
            else if (string.IsNullOrWhiteSpace(_manualTitle)) { <span class="tps-muted tps-small" data-testid="tps-manual-hint">Type a title to add a test case.</span> }
        </div>
    };

    /// <summary>A deliberate separate case for another data condition: written by hand, never a copy of the candidate record.</summary>
    private void StartVariant(DiscoveredScenario c)
    {
        _manualTitle = $"{c.Title} — variant";
        Info($"A separate case for \"{c.Title}\" is written by hand (for example another data condition). It is not linked to the candidate; edit the title and choose Add test case.");
    }

    /// <summary>Expanded variant groups (by entry key); folded by default.</summary>
    private readonly HashSet<string> _openVariants = new(StringComparer.Ordinal);

    /// <summary>One situation with its variants: one checkbox selects or clears every variant; the variants open below it.</summary>
    private RenderFragment VariantRow(P.ListEntry entry, IReadOnlySet<string> inDraft) => __builder =>
    {
        var key = entry.Key;
        var open = _openVariants.Contains(key);
        var ids = entry.Variants.Select(v => v.CandidateId).ToList();
        var selectedCount = ids.Count(_selected.Contains);
        <li class="tps-row tps-variants @(selectedCount == ids.Count ? "is-selected" : null)" data-testid="tps-variants-@key" data-count="@ids.Count">
            <div class="tps-row-main">
                <label class="tps-row-select">
                    <input type="checkbox" checked="@(selectedCount == ids.Count)" aria-label="@($"Select all {ids.Count} variants of {entry.Situation}")"
                           @onchange="e => { foreach (var id in ids) { if (e.Value is true) _selected.Add(id); else _selected.Remove(id); } _preview = null; }" data-testid="tps-variants-select-@key" />
                    <span class="tps-row-title">@entry.Situation</span>
                </label>
                <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" aria-expanded="@(open ? "true" : "false")" aria-controls="tps-vl-@key"
                        @onclick="() => { if (!_openVariants.Remove(key)) _openVariants.Add(key); }" data-testid="tps-variants-toggle-@key">@(open ? "Hide variants" : $"{ids.Count} variants")</button>
            </div>
            <p class="tps-row-sum">@(selectedCount > 0 && selectedCount < ids.Count ? $"{selectedCount} of {ids.Count} variants selected. " : "")One situation, @ids.Count variants: @string.Join(" · ", entry.Variants.Select(P.Trigger))</p>
            @if (open)
            {
                <ul class="tps-rows tps-variant-rows" id="tps-vl-@key">
                    @foreach (var v in entry.Variants) { @CandidateRow(v, inDraft.Contains(v.CandidateId)) }
                </ul>
            }
        </li>
    };

    private RenderFragment CandidateRow(DiscoveredScenario c, bool inPlan) => __builder =>
    {
        var id = c.CandidateId;
        var selected = _selected.Contains(id);
        var open = _openDetails.Contains(id);
        var warning = P.Warning(c);
        var owner = _inventory.Of(c);
        var otherWorkspace = _view == P.CandidateView.Manual ? null : owner.Primary;
        <li class="tps-row @(selected ? "is-selected" : null)" data-testid="tps-candidate-@id" data-workspace="@owner.Primary">
            <div class="tps-row-main">
                <label class="tps-row-select">
                    <input type="checkbox" checked="@selected" @onchange="e => { if (e.Value is true) _selected.Add(id); else _selected.Remove(id); _preview = null; }" aria-describedby="tps-sum-@id" data-testid="tps-select-@id" />
                    <span class="tps-row-title" title="@c.Title">@c.Title</span>
                </label>
                <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" aria-expanded="@(open ? "true" : "false")" aria-controls="tps-cd-@id" @onclick="() => { if (!_openDetails.Remove(id)) _openDetails.Add(id); }" data-testid="tps-details-@id">@(open ? "Hide details" : "Details")</button>
            </div>
            <p class="tps-row-sum" id="tps-sum-@id">@c.Purpose</p>
            <div class="tps-row-meta">
                <span class="tps-chip" data-testid="tps-kind">@owner.SourceKind</span>
                <span class="tps-chip tps-chip-quiet" data-testid="tps-type">@ScenarioCandidateTypes.Label(c.Type)</span>
                @if (c.Area is { Length: > 0 } area) { <span class="tps-row-area" data-testid="tps-area">@area</span> }
                @if (otherWorkspace == TestingWorkspace.TechnicalTesting) { <span class="tps-chip tps-chip-info" data-testid="tps-workspace">Technical Testing</span> }
                @if (inPlan) { <span class="tps-chip tps-chip-ok" data-testid="tps-in-draft">In the plan</span> }
                @if (c.ExistingTests.Count > 0) { <span class="tps-chip tps-chip-quiet" data-testid="tps-existing-tests" title="Associated through an explicit requirement reference; not an executed manual test">@c.ExistingTests.Count source test@(c.ExistingTests.Count == 1 ? "" : "s")</span> }
                @if (warning is not null) { <span class="tps-chip tps-chip-warn" data-testid="tps-attention">@warning</span> }
                @if (!GuideMode && owner.ManualRelevant && P.StepGap(c) is { } stepGap) { <span class="tps-chip tps-chip-quiet" data-testid="tps-step-gap" title="Write these before approving: the Azure DevOps export needs at least one step and an expected result on every step">@stepGap</span> }
            </div>
            @if (open)
            {
                var handoff = P.HandoffOf(c, owner);
                var sameOperation = _inventory.SameOperation(c);
                <dl class="tps-dl tps-candidate-details" id="tps-cd-@id" data-testid="tps-candidate-details-@id">
                    <dt>Where to test</dt>
                    <dd data-testid="tps-ownership"><strong>@ScenarioOwnership.WorkspaceLabel(owner.Primary)</strong>@(owner.Secondary is { } second ? $" · also {ScenarioOwnership.WorkspaceLabel(second)} when chosen" : "") — @ScenarioOwnership.PurposeLabel(owner.Purpose).
                        <span class="tps-muted">@owner.Basis</span>
                        @if (handoff is not null)
                        {
                            <span class="tps-handoff"><a href="@handoff.Href" data-testid="tps-handoff">@handoff.Label</a> <span class="tps-muted tps-small">@handoff.Carries</span></span>
                        }
                    </dd>
                    @if (inPlan)
                    {
                        <dt>Existing case</dt>
                        <dd data-testid="tps-existing-case">Already prepared in this plan. <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" @onclick="() => OpenCase(id)" data-testid="tps-open-case">Open existing case</button>
                            @if (CanWrite && !GuideMode) { <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" @onclick="() => StartVariant(c)" data-testid="tps-add-variant">Write a separate case by hand</button> <span class="tps-muted tps-small">A second case is legitimate for another data condition; it is not linked to this candidate.</span> }
                        </dd>
                    }
                    <dt>Expected behaviour</dt><dd data-testid="tps-expected">@(c.ExpectedBehaviour is { } eb ? $"{eb}{(c.ExpectedBasis is { } basis ? $" ({basis})" : "")}" : "Needs clarification — the evidence states no expected outcome.")</dd>
                    @if (c.Steps.Count > 0) { <dt>Steps in the evidence</dt><dd><ol class="tps-plain">@foreach (var s in c.Steps) { <li>@s.Action — <span class="tps-muted">@(s.Expected ?? "expected result not stated")</span></li> }</ol></dd> }
                    @if (c.RequirementIds.Count > 0) { <dt>Requirements</dt><dd>@string.Join(", ", c.RequirementIds)</dd> }
                    @if (c.TestDataNeeds.Count > 0) { <dt>Test Data</dt><dd>@string.Join("; ", c.TestDataNeeds)</dd> }
                    @if (c.Clarifications.Count > 0) { <dt>Clarifications</dt><dd><ul class="tps-plain" data-testid="tps-candidate-clarifications">@foreach (var k in c.Clarifications) { <li data-testid="tps-clarification" data-state="@k.State"><span class="tps-chip @(k.State == BirkNext.TestCoverage.CoverageClarification.Open ? "tps-chip-warn" : k.State == BirkNext.TestCoverage.CoverageClarification.Resolved ? "tps-chip-ok" : "tps-chip-info")">@ClarificationStates.CaseLabel(k)</span> @k.Question@if ((k.Resolution ?? k.Answer) is { Length: > 0 } answer) { <span> → <strong>@answer</strong></span> }</li> }</ul></dd> }
                    <dt>Existing tests</dt><dd>@(c.ExistingTests.Count == 0 ? "None associated (only explicit references count)" : string.Join("; ", c.ExistingTests.Select(t => $"{t.Name}{(t.Confirmed ? "" : " (candidate — needs review)")}")) + " — source tests, not executed manual tests.")</dd>
                    <dt>Source</dt><dd>@c.SourceCategory · @(c.Area ?? "no area stated") · @c.Engine@(string.IsNullOrEmpty(c.RuleVersion) ? "" : $" · rules {c.RuleVersion}") · @ScenarioCandidateTypes.ConfidenceLabel(c.Confidence)</dd>
                    <dt>Evidence</dt><dd><ul class="tps-plain">@foreach (var e in c.Evidence.Take(8))
                        {
                            @* A run is named by what it showed, not by its internal id. *@
                            if (e.Kind == "journey-run") { <li data-testid="tps-evidence-run">Integration journey run — @e.Detail</li> }
                            else { <li><code>@e.Reference</code>@(e.Detail is { } detail ? $" — {detail}" : "")</li> }
                        }</ul></dd>
                    @if (sameOperation.Count > 0)
                    {
                        <dt>Same operation in</dt>
                        <dd data-testid="tps-same-operation">@sameOperation.Count other contract file@(sameOperation.Count == 1 ? "" : "s"): @string.Join("; ", sameOperation.Take(6).Select(o => _candidates.FirstOrDefault(x => x.CandidateId == o) is { } other ? ScenarioOwnership.ContractFile(other) ?? other.Title : o))
                            <span class="tps-muted">(same operation and signature — related, kept separate; prepare one unless the files differ on purpose)</span></dd>
                    }
                    @if (c.PossibleDuplicates.Count > 0) { <dt>Related candidates</dt><dd data-testid="tps-possible-duplicates">@string.Join("; ", c.PossibleDuplicates.Select(d => _candidates.FirstOrDefault(x => x.CandidateId == d)?.Title ?? d)) <span class="tps-muted">(same requirement, different source — kept separate)</span></dd> }
                    @if (c.Gaps.Count > 0)
                    {
                        @* What is still open, classified: who resolves it and the supported next step. A missing prerequisite or observation is not an
                           unclear expectation; static evidence is never a run. *@
                        <dt>What is still open</dt>
                        <dd><ul class="tps-plain tps-gaps" data-testid="tps-gaps">
                            @foreach (var g in c.Gaps)
                            {
                                <li data-testid="tps-gap" data-kind="@g.Kind"><strong>@EvidenceGaps.Label(g.Kind)</strong> — @g.Question
                                    @if (g.Basis is { } gb) { <span class="tps-muted"> (@gb)</span> }
                                    @if (g.NextAction is { } next) { <span class="tps-gap-next" data-testid="tps-gap-next"> Next: @next</span> }
                                    <span class="tps-muted tps-small"> · @EvidenceGaps.Owner(g.Kind)</span></li>
                            }
                        </ul></dd>
                    }
                    else if (c.OpenQuestions.Count > 0) { <dt>Open questions</dt><dd><ul class="tps-plain">@foreach (var q in c.OpenQuestions) { <li>@q</li> }</ul></dd> }
                    @if (c.ExpectedBehaviour is null && c.OpenQuestions.Count > 0)
                    { <dt>Needs clarification</dt><dd data-testid="tps-needs-clarification-@c.CandidateId"><ul class="tps-plain">@foreach (var question in c.OpenQuestions) { <li>@question</li> }</ul></dd> }
                    @if (c.SourcesChecked.Count > 0)
                    {
                        <dt>Sources checked</dt>
                        <dd><ul class="tps-plain" data-testid="tps-sources-checked">@foreach (var sc in c.SourcesChecked) { <li data-found="@(sc.Found ? "true" : "false")"><strong>@sc.Source</strong> — @sc.Detail</li> }</ul></dd>
                    }
                </dl>
            }
        </li>
    };

    private static string? Empty(ChangeEventArgs e) => string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString();

    private async Task PrepareAsync()
    {
        if (_dirty) { Fail("Save or discard your changes first."); return; }
        _busy = true;
        TestPlanDraft? draft; string? error;
        if (GuideMode)
        {
            (draft, error) = _draft is null
                ? await _api!.CreateAsync(new CreateTestPlanDraftRequest(_guideKey!, $"{_ws?.Guides.FirstOrDefault(g => g.GuideKey == _guideKey)?.Title ?? _guideKey} – test plan", null, [.. _selected]))
                : await _api!.SaveAsync(_draft.Id, P.ToSaveRequest(_draft, _selected));
        }
        else
        {
            (draft, error) = await _api!.CreateProjectAsync(new CreateProjectTestPlanRequest
            {
                ProjectKey = _projectKey!, ProjectName = _projectName, DiscoveryId = _discovery?.DiscoveryId ?? "", CandidateIds = [.. _selected],
                DraftId = _draft?.Id, BaseRevision = _draft?.Revision,
            });
        }
        _busy = false;
        if (draft is null) { Fail(error ?? "The test cases could not be prepared."); return; }
        var count = _selected.Count;
        _draft = draft; _dirty = false; _selected.Clear(); _preview = null;
        _planName = draft.PlanName; _deliveryLabel = draft.DeliveryLabel ?? "";
        await ReloadWorkspaceAsync();
        GoArea("prepare");
        Ok($"{count} scenario{(count == 1 ? "" : "s")} prepared as test cases. Review them before use.");
    }

    private async Task AddManualAsync()
    {
        if (_dirty) { Fail("Save or discard your changes first."); return; }
        _busy = true;
        var (draft, error) = _draft is null
            ? await _api!.CreateProjectAsync(new CreateProjectTestPlanRequest { ProjectKey = _projectKey!, ProjectName = _projectName, ManualCaseTitle = _manualTitle })
            : await _api!.AddManualCaseAsync(_draft.Id, new AddManualTestCaseRequest(_draft.Revision, _manualTitle, null, null));
        _busy = false;
        if (draft is null) { Fail(error ?? "The test case could not be added."); return; }
        _draft = draft; _dirty = false; _manualTitle = "";
        await ReloadWorkspaceAsync();
        var added = draft.Cases[^1].Source.ScenarioId;
        _openCases.Add(added);
        _focusNewStep = added;
        GoArea("prepare");
        Ok("Test case added. Write its first step and expected result, then the case's expected result, and save.");
    }

    // ── Step 2: Prepare test cases ───────────────────────────────────────────────────────────────────────────

    private RenderFragment NoDraft() => __builder =>
    {
        <section class="tps-empty" data-testid="tps-no-draft"><h2>No test cases yet</h2><p>Choose scenarios and prepare them.</p>
            <button type="button" class="tps-btn" @onclick="@(() => GoArea("choose"))">Choose scenarios</button></section>
    };

    private RenderFragment PrepareArea() => __builder =>
    {
        if (_draft is not { } d) { __builder.AddContent(0, NoDraft()); return; }
        <section class="tps-section" data-testid="tps-prepare-step" aria-labelledby="tps-prepare-h">
            <div class="tps-section-head">
                <h2 id="tps-prepare-h" class="visually-hidden">Prepare test cases</h2>
                <p class="tps-prepare-status" data-testid="tps-prepare-count"><strong>@d.Cases.Count(c => c.Review == TestCaseReviewState.Accepted) of @d.Cases.Count accepted</strong>
                    <span class="tps-muted tps-small">Your edits are kept apart from the evidence and never overwritten by a new discovery. A missing expected result stays <strong>Needs clarification</strong> until someone states it.</span></p>
            </div>
            @if (d.ProjectKey is not null && _ws?.PlanStatus is { } statuses && statuses.TryGetValue(d.Id, out var planStatus) && planStatus.State != "Klar")
            {
                <div class="tps-note @(planStatus.State is "Må gjennomgås" or "Kilde mangler" ? "tps-note-warn" : null)" data-testid="tps-plan-source-status" data-state="@planStatus.State" role="status">
                    <strong>@planStatus.State</strong> @planStatus.Message
                    <button type="button" class="tps-btn tps-btn-quiet" disabled="@_busy" @onclick="ImpactAsync" data-testid="tps-impact-open">Se konsekvenser</button>
                </div>
            }
            @if (_impact is { } impact && impact.DraftId == d.Id)
            {
                <section class="tps-impact" data-testid="tps-impact" aria-label="Konsekvensanalyse">
                    <p><strong>Konsekvensanalyse:</strong> @impact.Summary</p>
                    @if (impact.Cases.Count > 0)
                    {
                        <ul class="tps-plain">
                            @foreach (var i in impact.Cases)
                            {
                                <li data-testid="tps-impact-case" data-kinds="@string.Join(",", i.Kinds)"><strong>@i.Title</strong> — @i.Summary
                                    @if (i.ReviewedBefore) { <span class="tps-tone tps-tone-warn">Godkjent tidligere: må gjennomgås</span> }
                                    @if (i.Changes.Count > 0)
                                    {
                                        <details><summary class="tps-small">Hva er endret</summary>
                                            <dl class="tps-impact-changes">@foreach (var ch in i.Changes) { <dt>@ch.Field</dt><dd><span class="tps-muted">Før:</span> @(ch.Before ?? "—") <br /><span class="tps-muted">Nå:</span> @(ch.After ?? "—")</dd> }</dl>
                                        </details>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    @if (impact.NewScenarios.Count > 0) { <p class="tps-small" data-testid="tps-impact-new">Nye scenarier: @string.Join(" · ", impact.NewScenarios.Take(8).Select(n => n.Title))@(impact.NewScenarios.Count > 8 ? $" (+{impact.NewScenarios.Count - 8})" : "")</p> }
                    <p class="tps-muted tps-small">Ingenting er endret i planen. Oppdater planen for å ta inn endringene — dine redigeringer, manuelle testtilfeller og historikk beholdes.</p>
                </section>
            }
            @if (d.Cases.Any(c => c.SourceChanged))
            {
                <p class="tps-note tps-note-warn" data-testid="tps-source-changed" role="status"><strong>@d.Cases.Count(c => c.SourceChanged) scenario(s) changed in the evidence</strong> since these cases were prepared. Nothing was changed here.
                    @if (CanWrite) { <button type="button" class="tps-btn tps-btn-quiet" disabled="@_busy" @onclick="RefreshAsync" data-testid="tps-refresh">@(d.ProjectKey is null ? "Create new revision from the current guide" : "Update from the latest discovery (keeps your edits)")</button> }</p>
            }
            @ScenarioList(d)
            @if (CanWrite)
            {
                <div class="tps-actionbar tps-actionbar-sticky" data-testid="tps-prepare-savebar">@SaveBar()</div>
                <details class="tps-advanced" data-testid="tps-suites">
                    <summary>Suites (@d.Suites.Count) <span class="tps-muted tps-small">— groups cases inside BirkNext; in Azure DevOps the suite is chosen when importing</span></summary>
                    <ul class="tps-plain">@foreach (var suite in d.Suites)
                        {
                            var count = d.Cases.Count(c => c.SuiteId == suite.Id);
                            <li data-testid="tps-suite" data-suite="@suite.Id"><input class="tps-input tps-suite-name" value="@suite.Name" aria-label="Suite name" @onchange="e => RenameSuite(suite.Id, e.Value?.ToString())" /> <span class="tps-count">@count</span></li>
                        }</ul>
                </details>
                @* Suites group cases inside BirkNext; in Azure DevOps the suite is chosen when the file is imported. *@
                <details class="tps-advanced" data-testid="tps-advanced-suite">
                    <summary>Advanced: add a suite</summary>
                    <div class="tps-actionbar tps-actionbar-compact">
                        <label class="tps-field"><span class="tps-k">New suite</span><input class="tps-input" @bind="_newSuite" @bind:event="oninput" placeholder="Suite name" /></label>
                        <button type="button" class="tps-btn tps-btn-quiet" disabled="@string.IsNullOrWhiteSpace(_newSuite)" @onclick="AddSuite">Add suite</button>
                    </div>
                </details>
                @if (d.ProjectKey is not null)
                {
                    @ManualCaseAdvanced(PrepareManualForm)
                }
            }
        </section>
    };

    private RenderFragment CaseEditor(TestPlanDraft d, TestCaseDraft c) => __builder =>
    {
        var sid = c.Source.ScenarioId;
        var open = _openCases.Contains(sid);
        var review = P.Review(c.Review);
        var expected = P.Expected(c);
        var stepResults = c.EffectiveStepExpected;
        var shown = ShownLanguage(c);
        var caseSiblings = d.Cases.Where(x => (x.ParentScenario ?? "") == (c.ParentScenario ?? "")).Select(x => x.Source.ScenarioId).ToList();
        var casePosition = caseSiblings.IndexOf(sid);
        var caseReorder = CanWrite && d.ProjectKey is not null && caseSiblings.Count > 1;
        <li class="tps-case @(open ? "is-open" : null) @(_dropTarget == "case:" + sid ? "is-drop-target" : null)" data-testid="tps-case-@sid" data-case="@sid" data-language="@(shown ?? "original")"
            @ondragover:preventDefault @ondragenter='() => DragEnter("case:" + sid)' @ondrop="() => DropCase(d, sid)">
            @if (caseReorder)
            {
                <span class="tps-case-order">
                    <span class="tps-drag" draggable="true" data-drag="@($"case:{sid}")" title="Drag to reorder the test case" aria-hidden="true"
                          @ondragstart='() => _drag = ("case", sid, -1)' @ondragend="DragEnd" data-testid="@($"tps-case-drag-{sid}")">⋮⋮</span>
                    <button type="button" class="tps-icon-btn tps-icon-btn-sm" disabled="@(_busy || casePosition <= 0)" aria-label="@($"Move test case {c.EffectiveTitle} up")" title="Move up"
                            @onclick="() => Change(PlanOrdering.MoveCase(d, sid, casePosition - 1))" data-testid="@($"tps-case-up-{sid}")">↑</button>
                    <button type="button" class="tps-icon-btn tps-icon-btn-sm" disabled="@(_busy || casePosition >= caseSiblings.Count - 1)" aria-label="@($"Move test case {c.EffectiveTitle} down")" title="Move down"
                            @onclick="() => Change(PlanOrdering.MoveCase(d, sid, casePosition + 1))" data-testid="@($"tps-case-down-{sid}")">↓</button>
                </span>
            }
            <button type="button" class="tps-case-head" aria-expanded="@(open ? "true" : "false")" aria-controls="@($"tps-case-body-{sid}")" @onclick="() => ToggleCase(sid)">
                <span class="tps-card-title" data-testid="tps-case-title">@(shown is not null && !string.IsNullOrWhiteSpace(c.Translation(shown)?.Title) ? c.Translation(shown)!.Title : c.EffectiveTitle)</span>
                @if (C.GeneratedNotReviewed(c) is { } gen) { <span class="tps-chip tps-chip-quiet" data-testid="tps-case-generated">@gen</span> }
                @foreach (var lang in c.TranslatedLanguages) { <span class="tps-tone tps-tone-@C.TranslationTone(c, lang)" data-testid="tps-case-translation" data-language="@lang">@TranslationLanguages.Name(lang)@(ScenarioPlanning.StateOf(c, lang) == TranslationState.SourceChanged ? ": review" : "")</span> }
                <span class="tps-chip">@P.TypeLabel(c.EffectiveType)</span>
                @* The generated chip already says "Generated — not reviewed": the review badge is shown only when it says something else. *@
                @if (C.GeneratedNotReviewed(c) != review.Text) { <span class="tps-tone tps-tone-@review.Tone" data-testid="tps-case-review">@review.Text</span> }
                <span class="tps-tone tps-tone-@expected.Tone">Expected: @expected.Text</span>
                @if (PlanSourcePresentation.CaseState(c) is { } srcState) { <span class="tps-tone tps-tone-@srcState.Tone" data-testid="tps-case-source-state" title="@c.SourceStateReason">@srcState.Text</span> }
                else if (c.SourceChanged) { <span class="tps-tone tps-tone-warn">Changed in the evidence</span> }
                @if (c.HasUnresolvedConflict) { <span class="tps-tone tps-tone-bad" data-testid="tps-case-conflict">Trenger avklaring: kildekonflikt</span> }
            </button>
            @if (open)
            {
                <div class="tps-case-body" id="@($"tps-case-body-{sid}")">
                    @CaseStatus(d, c, sid)
                    @if (c.SourceStateReason is { Length: > 0 } sourceWhy) { <p class="tps-small tps-muted" data-testid="tps-case-source-reason-@sid">@sourceWhy</p> }
                    @if (c.Generated.Conflicts is { Count: > 0 } conflicts)
                    {
                        <div class="tps-conflict @(c.ConflictResolution is null ? "is-open" : "is-resolved")" data-testid="tps-conflict-@sid">
                            <p><strong>@(c.ConflictResolution is null ? "Kildekonflikt" : "Kildekonflikt avklart")</strong> — @conflicts[0].Explanation</p>
                            <ul class="tps-plain">
                                @foreach (var claim in conflicts.SelectMany(k => k.Claims).DistinctBy(x => x.CandidateId)) { <li class="tps-small"><strong>@claim.SourceCategory:</strong> @claim.Expected <span class="tps-muted">(@claim.EvidenceReference)</span></li> }
                            </ul>
                            @if (c.ConflictResolution is { } resolution)
                            {
                                <p class="tps-small">Avklart av @resolution.ResolvedBy @resolution.ResolvedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm"): «@resolution.ExpectedResult» — @resolution.Rationale</p>
                            }
                            else if (CanWrite && _resolveCase != c.Source.ScenarioId)
                            {
                                <button type="button" class="tps-btn tps-btn-quiet" @onclick="() => StartResolve(c)" data-testid="tps-conflict-resolve-@sid">Registrer avklaring</button>
                            }
                            else if (CanWrite)
                            {
                                <div class="tps-conflict-form" data-testid="tps-conflict-form-@sid">
                                    <label class="tps-small">Kilde som gjelder
                                        <select class="tps-input tps-input-sm" @onchange="e => PickClaim(conflicts, e.Value?.ToString())" data-testid="tps-conflict-claim">
                                            <option value="">Eget forventet resultat</option>
                                            @foreach (var claim in conflicts.SelectMany(k => k.Claims).DistinctBy(x => x.CandidateId)) { <option value="@claim.CandidateId" selected="@(_resolveClaim == claim.CandidateId)">@claim.SourceCategory: @claim.Expected</option> }
                                        </select></label>
                                    <label class="tps-small">Forventet resultat <textarea class="tps-input" rows="2" @bind="_resolveExpected" data-testid="tps-conflict-expected"></textarea></label>
                                    <label class="tps-small">Begrunnelse (hvem bekreftet, og hvor) <input class="tps-input" @bind="_resolveRationale" data-testid="tps-conflict-rationale" /></label>
                                    <button type="button" class="tps-btn" disabled="@(_busy || string.IsNullOrWhiteSpace(_resolveExpected) || string.IsNullOrWhiteSpace(_resolveRationale))" @onclick="() => ResolveConflictAsync(c)" data-testid="tps-conflict-save">Lagre avklaring</button>
                                    <button type="button" class="tps-btn tps-btn-quiet" @onclick="() => _resolveCase = null">Avbryt</button>
                                </div>
                            }
                        </div>
                    }
                    <p data-testid="tps-expected-result-@sid"><strong>Expected result:</strong> @(c.EffectiveExpected ?? "Needs clarification — no supported expected result is stated.") <span class="tps-muted">(@c.Generated.ExpectedBasis)</span></p>
                    @if (shown is { } editLanguage) { @TranslationEditor(d, c, sid, editLanguage) }
                    <details class="tps-source-facts" open="@(!CanWrite)" data-testid="@($"tps-source-facts-{sid}")">
                    <summary>From the evidence <span class="tps-muted tps-small">purpose, details, requirements and where it came from</span></summary>
                    <dl class="tps-dl" data-testid="tps-generated-@sid">
                        <dt>Purpose</dt><dd>@c.EffectivePurpose</dd>
                        @* MT-7: a guide's rule ids are its business rules, never called specification requirements; project cases carry specification ids. *@
                        @if (c.Source.Kind == ScenarioSourceKind.SystemGuide && c.Generated.Requirements.Count == 0) { <dt>Business rules (guide)</dt><dd class="tps-muted">No business rule in the guide names this scenario.</dd> }
                        @if (c.Generated.Requirements.Count > 0) { <dt>@(c.Source.Kind == ScenarioSourceKind.SystemGuide ? "Business rules (guide)" : "Requirements")</dt><dd><ul class="tps-plain">@foreach (var r in c.Generated.Requirements) { <li><strong>@r.Title</strong>@(r.ExpectedBehavior is { } eb ? $": {eb}" : "") <span class="tps-muted">(@r.RuleId)</span></li> }</ul></dd> }
                        @SpecificationRequirements(c)
                        @if (c.Generated.Template.Count > 0)
                        {
                            <dt>@(P.TypeLabel(c.EffectiveType)) details</dt>
                            <dd><ul class="tps-plain" data-testid="tps-template-@sid">@foreach (var t in c.Generated.Template)
                                {
                                    var human = c.Edits.TemplateValues?.GetValueOrDefault(t.Key);
                                    var key = t.Key;
                                    <li><strong>@t.Label:</strong> @(t.Value ?? "Not in the evidence")
                                        @if (CanWrite && t.Value is null) { <input class="tps-input tps-input-sm" value="@human" placeholder="Add if known" aria-label="@t.Label" @onchange="e => Change(P.WithCase(d, sid, x => x with { Edits = x.Edits with { TemplateValues = WithTemplate(x.Edits.TemplateValues, key, e.Value?.ToString()) } }))" data-testid="@($"tps-template-{sid}-{key}")" /> }
                                        else if (human is not null) { <span class="tps-chip tps-chip-ok">Added: @human</span> }
                                    </li>
                                }</ul></dd>
                        }
                        @if (c.Generated.Clarifications.Count > 0) { <dt>Clarifications</dt><dd><ul class="tps-plain" data-testid="tps-case-clarifications">@foreach (var k in c.Generated.Clarifications) { <li data-testid="tps-clarification" data-state="@k.State"><span class="tps-chip @(k.State == BirkNext.TestCoverage.CoverageClarification.Open ? "tps-chip-warn" : k.State == BirkNext.TestCoverage.CoverageClarification.Resolved ? "tps-chip-ok" : "tps-chip-info")">@ClarificationStates.CaseLabel(k)</span> @k.Question@if ((k.Resolution ?? k.Answer) is { Length: > 0 } answer) { <span> → <strong>@answer</strong></span> }</li> }</ul></dd> }
                        @if (c.Generated.FailureCases.Count > 0) { <dt>Failure cases</dt><dd>@string.Join(" · ", c.Generated.FailureCases)</dd> }
                        @if (c.Generated.ExpectedBasis == ExpectedResultBasis.NeedsClarification)
                        { <dt>Needs clarification</dt><dd data-testid="tps-needs-clarification-@sid">@(c.Generated.FollowUp ?? "Avklar forventet resultat før testing.")</dd> }
                        @if (c.Generated.ExistingTests.Count > 0) { <dt>Existing tests</dt><dd>@string.Join("; ", c.Generated.ExistingTests.Select(t => t.Name)) <span class="tps-muted">(explicit requirement references)</span></dd> }
                        else if (c.Generated.NamedExistingTests.Count > 0) { <dt>Tests the guide names</dt><dd>@string.Join(" · ", c.Generated.NamedExistingTests) <span class="tps-muted">(names, not verified identities)</span></dd> }
                        <dt>Evidence</dt><dd class="tps-small" data-testid="tps-evidence-@sid">
                            @if (c.Generated.Evidence.Count > 0) { @foreach (var e in c.Generated.Evidence.Take(6)) { <span class="tps-ref" title="@(e.Detail is null ? e.Reference : $"{e.Reference} · {e.Detail}")">@C.ShortReference(e.Reference) @if (e.Detail is { } provenance) { <span class="tps-muted">@provenance</span> }</span> } }
                            else if (c.Source.Kind == ScenarioSourceKind.Manual) { <span>Written by hand — no discovered evidence.</span> }
                            else { <span>@c.Source.Owner · @sid@(c.Source.Revision is { } rev ? $" · guide revision {rev}" : "")</span> }
                            @if (c.Generated.Confidence is { } conf) { <span class="tps-muted"> · @ScenarioCandidateTypes.ConfidenceLabel(conf)</span> }</dd>
                    </dl>
                    </details>
                    @* Audit 2026-11-22: edit first — a tester who can edit sees title, steps and how to verify before requirement links and suggestions. *@
                    @if (!CanWrite) { @LinkedRequirements(d, c, sid) }
                    @if (CanWrite)
                    {
                        @* Locked while a request is in flight, so a late response can never replace an edit made meanwhile. *@
                        <fieldset class="tps-fieldset" disabled="@_busy">
                        <div class="tps-edit-grid">
                            @EditField(c, "Title", c.Generated.Title, c.EffectiveTitle, v => c with { Edits = c.Edits with { Title = P.TextEdit(c.Generated.Title, v) } }, false, "title")
                            @EditField(c, "Preconditions", c.Generated.Preconditions, c.EffectivePreconditions, v => c with { Edits = c.Edits with { Preconditions = P.TextEdit(c.Generated.Preconditions, v) } }, true, "preconditions")
                        </div>
                        <div class="tps-steps" data-testid="tps-steps-@sid">
                            <span class="tps-k">Steps @if (c.Edits.Steps is not null) { <span class="tps-chip tps-chip-ok">Edited</span> } else if (c.Generated.Steps.Count == 0) { <span class="tps-chip tps-chip-bad">Not in source</span> }</span>
                            <ol class="tps-step-list">
                                @for (var i = 0; i < c.EffectiveSteps.Count; i++)
                                {
                                    var index = i;
                                    <li class="tps-step-row @(_dropTarget == $"step:{sid}:{index}" ? "is-drop-target" : null)" data-testid="@($"tps-step-{sid}-{index}")"
                                        @ondragover:preventDefault @ondragenter='() => DragEnter($"step:{sid}:{index}")' @ondrop="() => DropStep(d, sid, index)">
                                        <span class="tps-drag" draggable="true" data-drag="@($"step:{sid}:{index}")" title="Drag to reorder the step" aria-hidden="true"
                                              @ondragstart='() => _drag = ("step", sid, index)' @ondragend="DragEnd" data-testid="@($"tps-step-drag-{sid}-{index}")">⋮⋮</span>
                                        <span class="tps-step-label" aria-hidden="true">Step @(index + 1) · Action</span>
                                        <span class="tps-step-label tps-step-label-expected" aria-hidden="true">Expected result</span>
                                        <textarea class="tps-input tps-step-text" rows="@C.Rows(c.EffectiveSteps[index])" value="@c.EffectiveSteps[index]" aria-label="Step @(index + 1) action" @onchange="e => Change(P.WithCase(d, sid, x => P.SetStep(x, index, e.Value?.ToString() ?? x.EffectiveSteps[index], null)))" data-testid="@($"tps-step-action-{sid}-{index}")"></textarea>
                                        <textarea class="tps-input tps-step-text tps-step-result" rows="@C.Rows(stepResults[index])" value="@stepResults[index]" placeholder="Needs clarification — expected result not stated" aria-label="Step @(index + 1) expected result" @onchange="e => Change(P.WithCase(d, sid, x => P.SetStep(x, index, null, e.Value?.ToString() ?? string.Empty)))" data-testid="@($"tps-step-expected-{sid}-{index}")"></textarea>
                                        <span class="tps-step-tools">
                                            <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" disabled="@(index == 0)" aria-label="Move step @(index + 1) up" @onclick="() => Change(P.WithCase(d, sid, x => P.MoveStep(x, index, -1)))" data-testid="@($"tps-step-up-{sid}-{index}")">↑</button>
                                            <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" disabled="@(index == c.EffectiveSteps.Count - 1)" aria-label="Move step @(index + 1) down" @onclick="() => Change(P.WithCase(d, sid, x => P.MoveStep(x, index, 1)))" data-testid="@($"tps-step-down-{sid}-{index}")">↓</button>
                                            <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" aria-label="Remove step @(index + 1)" @onclick="() => Change(P.WithCase(d, sid, x => P.RemoveStep(x, index)))" data-testid="@($"tps-step-remove-{sid}-{index}")">Remove</button>
                                        </span>
                                        @if (stepResults[index] is null) { <span class="tps-chip tps-chip-warn">Needs clarification</span> }
                                    </li>
                                }
                            </ol>
                            @if (c.EffectiveSteps.Count == 0)
                            {
                                <p class="tps-muted tps-small" data-testid="@($"tps-steps-empty-{sid}")">No steps yet. Write the first step and what should happen, then choose Add step — a test case needs at least one step with its expected result before it can be approved.</p>
                            }
                            <div class="tps-actionbar tps-step-new-row">
                                <input class="tps-input" id="@($"tps-step-new-{sid}")" value="@_newStep.GetValueOrDefault(sid)" placeholder="@(c.EffectiveSteps.Count == 0 ? "First step: what the tester does" : "New step action")" aria-label="New step action" @oninput="e => _newStep[sid] = e.Value?.ToString() ?? string.Empty" data-testid="@($"tps-step-new-{sid}")" />
                                <input class="tps-input" value="@_newStepExpected.GetValueOrDefault(sid)" placeholder="Expected result of this step" aria-label="New step expected result" @oninput="e => _newStepExpected[sid] = e.Value?.ToString() ?? string.Empty" data-testid="@($"tps-step-new-expected-{sid}")" />
                                <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" disabled="@string.IsNullOrWhiteSpace(_newStep.GetValueOrDefault(sid))" @onclick="() => AddStep(d, sid)" data-testid="@($"tps-step-add-{sid}")">Add step</button>
                            </div>
                        </div>
                        <div class="tps-edit-grid">
                            @EditField(c, "How to verify (observation method)", c.Generated.ObservationMethod, c.EffectiveObservation, v => c with { Edits = c.Edits with { ObservationMethod = P.TextEdit(c.Generated.ObservationMethod, v) } }, true, "observation")
                            @PriorityField(c)
                        </div>
                        @if (string.IsNullOrWhiteSpace(c.EffectiveObservation)) { <p class="tps-muted tps-small" data-testid="@($"tps-observation-missing-{sid}")">@ScenarioPlanning.NeedsVerificationMethod. Say how the tester sees the result (a screen, a report, a log, a database query an authorised person runs …).</p> }
                        @Checklist(c, sid)
                        @LinkedRequirements(d, c, sid)
                        @* What reaches the Azure DevOps file is shown above (title, preconditions, steps with their expected results, priority; requirements
                           and Test Data go to the mapping report). The rest is BirkNext's own planning detail: kept, never lost, and collapsed. *@
                        <details class="tps-more" data-testid="tps-more-fields-@sid">
                        <summary>More fields <span class="tps-muted tps-small">— kept in BirkNext, not exported to Azure DevOps</span></summary>
                        <div class="tps-edit-grid">
                            @EditField(c, "Purpose", c.Generated.Purpose, c.EffectivePurpose, v => c with { Edits = c.Edits with { Purpose = P.TextEdit(c.Generated.Purpose, v) } }, true, "purpose")
                            @EditField(c, "Expected result of the whole case", c.Generated.ExpectedResult, c.EffectiveExpected, v => c with { Edits = c.Edits with { ExpectedResult = P.TextEdit(c.Generated.ExpectedResult, v) } }, true, "expected")
                            @EditField(c, "Environment and prerequisites", c.Generated.EnvironmentPrerequisites, c.EffectiveEnvironment, v => c with { Edits = c.Edits with { EnvironmentPrerequisites = P.TextEdit(c.Generated.EnvironmentPrerequisites, v) } }, true, "environment")
                            @EditField(c, "Roles and access", null, c.Edits.Roles, v => c with { Edits = c.Edits with { Roles = P.TextEdit(null, v) } }, false, "roles")
                            @EditField(c, "Dependencies", null, c.Edits.Dependencies, v => c with { Edits = c.Edits with { Dependencies = P.TextEdit(null, v) } }, false, "dependencies")
                            <label class="tps-field"><span class="tps-k">Risk</span>
                                <select class="tps-input" @onchange="e => Change(P.WithCase(d, sid, x => x with { Risk = Enum.TryParse<TestCaseRisk>(e.Value?.ToString(), out var r) ? r : x.Risk }))" data-testid="tps-risk-@sid">
                                    @foreach (var r in Enum.GetValues<TestCaseRisk>()) { <option value="@r" selected="@(r == c.Risk)">@(r == TestCaseRisk.NotAssessed ? "Not assessed" : r.ToString())</option> }
                                </select></label>
                            @* Test type and execution method are separate choices: a performance case is not automated by type, a functional case not manual. *@
                            <label class="tps-field"><span class="tps-k">Test type</span>
                                <select class="tps-input" @onchange="e => Change(P.WithCase(d, sid, x => x with { Edits = x.Edits with { TestType = Enum.TryParse<TestCaseType>(e.Value?.ToString(), out var t) && t != TestCaseType.NotClassified ? t : null } }))" data-testid="tps-type-@sid">
                                    @foreach (var t in Enum.GetValues<TestCaseType>()) { <option value="@t" selected="@(t == c.EffectiveType)">@P.TypeLabel(t)</option> }
                                </select></label>
                            <label class="tps-field"><span class="tps-k">Execution method</span>
                                <select class="tps-input" @onchange="e => Change(P.WithCase(d, sid, x => x with { Edits = x.Edits with { ExecutionMethod = Enum.TryParse<TestExecutionMethod>(e.Value?.ToString(), out var m) && m != TestExecutionMethod.NotDecided ? m : null } }))" data-testid="tps-method-@sid">
                                    @foreach (var m in Enum.GetValues<TestExecutionMethod>()) { <option value="@m" selected="@(m == c.EffectiveExecutionMethod)">@P.MethodLabel(m)</option> }
                                </select></label>
                            <label class="tps-field"><span class="tps-k">Suite</span>
                                <select class="tps-input" aria-label="Move @c.EffectiveTitle to suite" @onchange="e => Change(P.WithCase(d, sid, x => x with { SuiteId = e.Value?.ToString() ?? x.SuiteId }))" data-testid="tps-suite-@sid">
                                    @foreach (var s in d.Suites) { <option value="@s.Id" selected="@(s.Id == c.SuiteId)">@s.Name</option> }
                                </select></label>
                        </div>
                        @if (c.EffectiveType == TestCaseType.Performance) { @PerformanceFields(d, c, sid) }
                        </details>
                        <div class="tps-actionbar">@SaveBar()</div>
                        </fieldset>
                        @if (_dirty) { <p class="tps-muted tps-small" data-testid="tps-review-needs-save">Save or discard your changes before recording a review decision.</p> }
                        <div class="tps-review-bar" role="group" aria-label="Review decision for @c.EffectiveTitle">
                            <label class="tps-field tps-field-grow"><span class="tps-k">Rationale</span><input class="tps-input" value="@_rationale.GetValueOrDefault(sid)" @oninput="e => SetRationale(sid, e)" placeholder="Why (required to exclude or ask for clarification)" data-testid="tps-rationale-@sid" /></label>
                            <button type="button" class="tps-btn tps-btn-quiet" disabled="@(_busy || _dirty)" @onclick="() => ReviewAsync(sid, TestCaseReviewState.NeedsClarification)" data-testid="tps-clarify-@sid">Needs clarification</button>
                            <button type="button" class="tps-btn tps-btn-quiet" disabled="@(_busy || _dirty)" @onclick="() => ReviewAsync(sid, TestCaseReviewState.Excluded)" data-testid="tps-exclude-@sid">Exclude</button>
                            @{ var approveBlocker = P.ApproveBlocker(c); }
                            <button type="button" class="tps-btn" disabled="@(_busy || _dirty || approveBlocker is not null)" @onclick="() => ReviewAsync(sid, TestCaseReviewState.Accepted)" data-testid="tps-accept-@sid" title="@(_dirty ? "Save your changes first" : approveBlocker ?? "Approved cases are exported to Azure DevOps")">Approve</button>
                        </div>
                        @if (!_dirty && approveBlocker is not null && c.Review != TestCaseReviewState.Accepted) { <p class="tps-muted tps-small" data-testid="tps-approve-why-@sid">To approve: @approveBlocker</p> }
                        @if (d.ProjectKey is not null)
                        {
                            <div class="tps-actionbar tps-actionbar-compact" data-testid="@($"tps-case-actions-{sid}")">
                                <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" disabled="@(_busy || _dirty)" title="@(_dirty ? "Save or discard your changes first" : "A new test case with its own identity, starting from this text")" @onclick="() => DuplicateAsync(c)" data-testid="@($"tps-duplicate-{sid}")">Duplicate as new test case</button>
                                @if (Removable(c)) { <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" disabled="@_busy" @onclick="() => RemoveCase(sid)" data-testid="@($"tps-remove-{sid}")">Remove this test case</button> <span class="tps-muted tps-small">Never reviewed: it is removed from the plan when you save (earlier versions keep it).</span> }
                            </div>
                        }
                    }
                    else
                    {
                        <dl class="tps-dl"><dt>Expected</dt><dd>@(c.EffectiveExpected ?? "NEEDS CLARIFICATION")</dd><dt>Steps</dt><dd><ol>@for (var i = 0; i < c.EffectiveSteps.Count; i++) { <li>@c.EffectiveSteps[i] — <span class="tps-muted">@(stepResults[i] ?? "Needs clarification")</span></li> }</ol></dd></dl>
                    }
                    @if (c.Missing.Count > 0) { <ul class="tps-blockers" data-testid="tps-open-@sid">@foreach (var m in c.Missing) { <li>@m</li> }</ul> }
                    @if (c.EditHistory.Count > 0)
                    {
                        <div class="tps-history" data-testid="tps-edit-history-@sid"><span class="tps-k">Change history</span>
                            <ol class="tps-plain">@foreach (var ev in c.EditHistory.TakeLast(10)) { <li>@ev.Editor · @ev.At.ToLocalTime().ToString("yyyy-MM-dd HH:mm") — @string.Join(", ", ev.Fields)</li> }</ol></div>
                    }
                    @if (c.ReviewHistory.Count > 0)
                    {
                        <div class="tps-history" data-testid="tps-history-@sid"><span class="tps-k">Review history</span>
                            <ol class="tps-plain">@foreach (var ev in c.ReviewHistory) { <li><strong>@P.Review(ev.State).Text</strong> · @ev.Reviewer · @ev.At.ToLocalTime().ToString("yyyy-MM-dd HH:mm")@(ev.Rationale is { } why ? $" — {why}" : "")</li> }</ol></div>
                    }
                </div>
            }
        </li>
    };

    private static Dictionary<string, string>? WithTemplate(Dictionary<string, string>? values, string key, string? value)
    {
        var next = new Dictionary<string, string>(values ?? [], StringComparer.Ordinal);
        if (string.IsNullOrWhiteSpace(value)) next.Remove(key); else next[key] = value.Trim();
        return next.Count == 0 ? null : next;
    }

    private void AddStep(TestPlanDraft d, string sid)
    {
        if (_newStep.GetValueOrDefault(sid) is not { Length: > 0 } action) return;
        Change(P.WithCase(d, sid, x => P.AddStep(x, action.Trim(), _newStepExpected.GetValueOrDefault(sid))));
        _newStep.Remove(sid);
        _newStepExpected.Remove(sid);
    }

    /// <summary>"Linked requirements" of a project case: automatic (the case's own evidence) and manual (a tester's link) side by side, each checked
    /// against the project's current specification; search and link only requirements that exist in it. Saved with the draft.</summary>
    private RenderFragment LinkedRequirements(TestPlanDraft d, TestCaseDraft c, string sid) => __builder =>
    {
        if (d.ProjectKey is null) return; // guide plans: MT-7 associations (Specification requirements above) own this
        var rows = L.Rows(c, _requirements);
        var query = _requirementQuery.GetValueOrDefault(sid) ?? string.Empty;
        <section class="tps-links" aria-labelledby="@($"tps-links-title-{sid}")" data-testid="@($"tps-links-{sid}")">
            @{ var parent = L.ParentStory(c, rows, _stories, L.NoSpecificationInProject(_specificationState)); }
            <div class="tps-parent-story" data-testid="@($"tps-parent-story-{sid}")" data-state="@(parent.Stories.Count > 0 ? "identified" : "not-identified")">
                <h4 class="tps-links-title">Parent User Story</h4>
                @if (parent.Stories.Count > 0)
                {
                    <ul class="tps-link-list">
                        @foreach (var story in parent.Stories)
                        {
                            <li class="tps-link-row" data-testid="tps-parent-story-item" data-story="@(story.StoryId ?? story.Key)">
                                <span class="tps-link-text"><strong>@(story.StoryId ?? "User Story")</strong> @story.Title</span>
                                <span class="tps-muted tps-small">@parent.Via@(story.SpecificationPath is { } storyPath ? $" · {storyPath}" : "")</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="tps-muted tps-small" data-testid="tps-parent-story-none">@parent.Reason</p>
                }
            </div>
            <h4 id="@($"tps-links-title-{sid}")" class="tps-links-title">Linked requirements</h4>
            @if (rows.Count == 0)
            {
                <p class="tps-muted tps-small" data-testid="tps-links-none">No requirement is linked yet. The case is still listed in Test Coverage, but it does not count for any requirement until it is linked.</p>
            }
            else
            {
                <ul class="tps-link-list" data-testid="tps-links-list">
                    @foreach (var row in rows)
                    {
                        <li class="tps-link-row" data-testid="tps-link" data-requirement="@row.RequirementId" data-origin="@(row.Automatic && row.Manual ? "both" : row.Manual ? "manual" : "automatic")">
                            <span class="tps-link-text"><strong>@row.RequirementId</strong> @row.Title@if (ShownLanguage(c) is { } linkLanguage && RequirementText(row.RequirementId, row.SpecificationPath, linkLanguage) is { } translatedRequirement) { <span class="tps-orig" data-testid="tps-link-translated" lang="@linkLanguage">@TranslationLanguages.Name(linkLanguage): @translatedRequirement</span> }</span>
                            <span class="tps-chip @(row.Manual ? "tps-chip-ok" : null)" data-testid="tps-link-origin">@row.Origin</span>
                            <span class="tps-tone tps-tone-@row.Tone" data-testid="tps-link-validity">@row.Validity</span>
                            @if (row.Manual && !row.Saved) { <span class="tps-tone tps-tone-warn" data-testid="tps-link-unsaved">Not saved yet</span> }
                            else if (row.Manual && row.LinkedBy is { } who) { <span class="tps-muted tps-small" data-testid="tps-link-by">Linked by @who@(row.LinkedAt is { } at ? $", {at.ToLocalTime():yyyy-MM-dd}" : "")</span> }
                            @if (CanWrite && row.Manual)
                            {
                                <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" disabled="@_busy" aria-label="@($"Remove the manual link to {row.RequirementId}")"
                                    @onclick="() => Change(P.WithCase(d, sid, x => L.Unlink(x, row.RequirementId, row.SpecificationPath)))" data-testid="tps-link-remove">Remove link</button>
                                @if (row.Automatic) { <span class="tps-muted tps-small">Removing the manual link keeps the automatic one.</span> }
                            }
                        </li>
                    }
                </ul>
            }
            @if (CanWrite) { @SuggestedRequirements(d, c, sid) }
            @if (CanWrite)
            {
                @if (_requirements is not { Count: > 0 } options)
                {
                    <p class="tps-muted tps-small" data-testid="tps-links-unavailable">@(_requirementsNote ?? "The project's specification could not be read, so requirements cannot be linked right now.")</p>
                }
                else
                {
                    var matches = L.Search(options, c, query);
                    <details class="tps-more" data-testid="@($"tps-link-search-all-{sid}")" open="@(query.Length > 0)">
                    <summary>Search all requirements (@options.Count)</summary>
                    <label class="tps-field tps-link-search"><span class="tps-k">Find a requirement to link</span>
                        <input type="search" class="tps-input" value="@query" placeholder="Type an id such as FR-001 or words from the requirement" autocomplete="off"
                            @oninput="e => _requirementQuery[sid] = e.Value?.ToString() ?? string.Empty" data-testid="@($"tps-link-search-{sid}")" /></label>
                    @if (matches.Count == 0)
                    {
                        <p class="tps-muted tps-small" data-testid="tps-link-nomatch">@(query.Length == 0 ? "Every requirement of the specification is already linked." : "No requirement of this project matches. Only requirements in the project's specification can be linked.")</p>
                    }
                    else
                    {
                        <ul class="tps-link-options" aria-label="Matching requirements" data-testid="tps-link-options">
                            @foreach (var o in matches)
                            {
                                <li><button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" disabled="@_busy" aria-label="@($"Link {o.RequirementId}: {o.Title}")"
                                        @onclick="() => Change(P.WithCase(d, sid, x => L.Link(x, o)))" data-testid="tps-link-add" data-requirement="@o.RequirementId">Link</button>
                                    <span><strong>@o.RequirementId</strong> @o.Title</span></li>
                            }
                        </ul>
                    }
                    </details>
                    <p class="tps-muted tps-small">A link says this case is designed to test the requirement. It is not an execution and not a pass. Save the draft to keep your links.</p>
                }
            }
        </section>
    };

    private RenderFragment SpecificationRequirements(TestCaseDraft c) => __builder =>
    {
        if (c.Source.Kind != ScenarioSourceKind.SystemGuide) return; // MT-7 associations exist for guide scenarios only
        var (verified, suggested, rejected) = RequirementCoveragePresentation.ForScenario(_coverage, c.Source.Owner, c.Source.ScenarioId);
        <dt>Specification requirements</dt>
        <dd class="tps-spec" data-testid="tps-spec-requirements">
            @if (_coverageNote is not null) { <span class="tps-muted" data-testid="tps-spec-unknown">@_coverageNote</span> }
            else if (verified.Count + suggested.Count + rejected.Count == 0) { <span class="tps-muted" data-testid="tps-spec-none">No association to a specification requirement: the guide names none and no named test verifies one.</span> }
            else
            {
                @if (verified.Count > 0)
                {
                    <ul class="tps-plain" data-testid="tps-spec-verified">@foreach (var a in verified) { <li><strong>@RequirementCoveragePresentation.Requirement(a)</strong> <span class="tps-tone tps-tone-info">@RequirementCoveragePresentation.TrustLabel(a.Trust)</span>@(a.Reviewer is { } who ? $" · {who}, {a.DecidedAt?.ToLocalTime():yyyy-MM-dd}" : "")</li> }</ul>
                }
                @if (suggested.Count > 0)
                {
                    <p class="tps-k tps-small">Suggested — not verified, not counted</p>
                    <ul class="tps-plain" data-testid="tps-spec-suggested">@foreach (var a in suggested) { <li>@RequirementCoveragePresentation.Requirement(a) <span class="tps-tone tps-tone-warn">@RequirementCoveragePresentation.RuleLabel(a.RuleId)</span></li> }</ul>
                    <a href="@RequirementCoveragePresentation.RelationshipReviewHref" data-testid="tps-spec-decide">Decide these associations in Relationship Review</a>
                }
                @if (rejected.Count > 0) { <p class="tps-muted tps-small" data-testid="tps-spec-rejected">Rejected in Relationship Review: @string.Join(", ", rejected.Select(RequirementCoveragePresentation.Requirement))</p> }
                <p class="tps-muted tps-small">Accepting this Test Case for preparation does not approve any requirement association.</p>
            }
        </dd>
    };

    private void RenameSuite(string id, string? name)
    {
        if (_draft is null || string.IsNullOrWhiteSpace(name)) return;
        Change(_draft with { Suites = [.. _draft.Suites.Select(s => s.Id == id ? s with { Name = name.Trim() } : s)] });
    }

    private void AddSuite()
    {
        if (_draft is null || string.IsNullOrWhiteSpace(_newSuite)) return;
        Change(_draft with { Suites = [.. _draft.Suites, new TestSuiteDraft("suite:r-" + Guid.NewGuid().ToString("N")[..8], _newSuite.Trim(), "reviewer", null)] });
        _newSuite = "";
    }

    private RenderFragment SaveBar() => __builder =>
    {
        <button type="button" class="tps-btn" disabled="@(_busy || !_dirty)" title="@(_busy ? "Saving…" : !_dirty ? "Nothing to save: every change is saved" : "Save your changes as a new version of the plan")" @onclick="SaveAsync" data-testid="tps-save">Save draft</button>
        @if (_dirty) { <button type="button" class="tps-btn tps-btn-quiet" @onclick="DiscardAsync" data-testid="tps-discard">Discard changes</button> <span class="tps-tone tps-tone-warn" data-testid="tps-save-state" role="status">Unsaved changes</span> }
        else if (_draft is { } saved) { <span class="tps-muted tps-small" data-testid="tps-save-state" role="status">All changes saved · version @saved.Revision</span> }
    };

    private async Task SaveAsync()
    {
        if (_draft is null) return;
        _busy = true;
        if (_draft.ProjectKey is not null && _draft.Cases.Any(c => c.RequirementLinks.Any(m => m.LinkedAt == default))) await LoadRequirementsAsync();
        var sent = _edits;
        var (draft, error) = await _api!.SaveAsync(_draft.Id, P.ToSaveRequest(_draft, requirements: _requirements));
        _busy = false;
        if (draft is null) { Fail(error ?? "The draft could not be saved."); return; } // the edits stay; Save can be tried again
        if (_edits != sent)
        {
            // Edited while the save was on its way: what was sent is saved, the newer edits are kept on top of the saved revision and stay unsaved.
            _draft = _draft with { Revision = draft.Revision };
            await ReloadWorkspaceAsync();
            Info($"Saved revision {draft.Revision}. Your newer changes are not saved yet: save again.");
            return;
        }
        _draft = draft; _dirty = false;
        await ReloadWorkspaceAsync();
        if (_historyOpen) await LoadRevisionsAsync();
        Ok($"Draft saved (revision {draft.Revision}).");
    }

    private async Task DiscardAsync() { if (_draft is not null) await OpenDraftAsync(_draft.Id); Info("Changes discarded."); }

    private async Task RefreshAsync()
    {
        if (_draft is null) return;
        if (_dirty) { Fail("Save or discard your changes first."); return; }
        _busy = true;
        var (draft, error) = await _api!.RefreshAsync(_draft.Id, _draft.Revision);
        _busy = false;
        if (draft is null) { Fail(error ?? "The plan could not be updated."); return; }
        _draft = draft;
        await ReloadWorkspaceAsync();
        Ok($"Revision {draft.Revision}: generated content updated, your edits kept. Changed cases went back to review.");
    }

    /// <summary>
    /// A performance test case in plain words: the tester describes purpose, workload, environment, measurements and acceptance criteria; any of
    /// them can stay open. Nothing is assumed or executed here — a performance tester refines and runs it in Performance Test Review.
    /// </summary>
    private RenderFragment PerformanceFields(TestPlanDraft d, TestCaseDraft c, string sid) => __builder =>
    {
        var perf = c.Edits.Performance ?? new PerformanceCaseDetails();
        void Set(Func<PerformanceCaseDetails, PerformanceCaseDetails> f) => Change(P.WithCase(d, sid, x => x with { Edits = x.Edits with { Performance = f(x.Edits.Performance ?? new PerformanceCaseDetails()) } }));
        <section class="tps-perf" aria-labelledby="@($"tps-perf-h-{sid}")" data-testid="tps-perf-@sid">
            <h4 id="@($"tps-perf-h-{sid}")" class="tps-h4">Performance test details</h4>
            <p class="tps-muted tps-small">Describe what you know in your own words — no script is needed. Leave anything unknown empty: it is shown as open for a performance tester, never filled in with a guess.</p>
            @if (string.IsNullOrWhiteSpace(perf.AcceptanceCriteria)) { <p class="tps-chip tps-chip-bad" role="status" data-testid="tps-perf-criteria-missing-@sid">Acceptance criteria not defined — review required.</p> }
