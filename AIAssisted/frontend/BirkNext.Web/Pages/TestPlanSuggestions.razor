    private RenderFragment SaveArea() => __builder =>
    {
        if (_draft is not { } d) { __builder.AddContent(0, NoDraft()); return; }
        var latest = _ws?.Snapshots.Where(s => s.DraftId == d.Id).OrderByDescending(s => s.Sequence).FirstOrDefault();
        <section class="tps-section" data-testid="tps-save-step" aria-labelledby="tps-save-h">
            <div class="tps-section-head">
                <h2 id="tps-save-h" class="tps-h2">Save &amp; export</h2>
                <p class="tps-muted">A snapshot freezes the whole plan — cases, edits, Test Data revisions, review decisions, readiness, the source snapshot and the rule version. It never changes; later edits create a new snapshot.</p>
            </div>
            @if (latest is not null) { <p class="tps-muted" data-testid="tps-latest-snapshot">Latest snapshot: #@latest.Sequence · @(latest.DeliveryLabel ?? "no delivery label") · @latest.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")@(latest.DraftRevision < d.Revision ? " — the plan changed since" : "")</p> }
            @if (CanWrite)
            {
                <div class="tps-actionbar" data-testid="tps-plan-name-bar">
                    <label class="tps-field tps-field-grow"><span class="tps-k">Test plan name</span><input class="tps-input" @bind="_planName" @bind:event="oninput" data-testid="tps-plan-name" /></label>
                    <button type="button" class="tps-btn tps-btn-quiet" disabled="@(_busy || _dirty || string.IsNullOrWhiteSpace(_planName) || string.Equals(_planName.Trim(), d.PlanName, StringComparison.Ordinal))" @onclick="RenamePlanAsync" data-testid="tps-rename-plan">Save name</button>
                </div>
            }
            <div class="tps-actionbar">
                <button type="button" class="tps-btn" @onclick="@(() => GoArea("export"))" data-testid="tps-go-export">Export to Azure DevOps</button>
            </div>
            @* Snapshots (a frozen copy per delivery) and delivery comparison are BirkNext's own history; the Azure DevOps export does not need them. *@
            <details class="tps-advanced" data-testid="tps-snapshot-advanced">
                <summary>Advanced: snapshots and delivery comparison</summary>
                @if (CanWrite)
                {
                    <div class="tps-actionbar" data-testid="tps-snapshot-bar">
                        <label class="tps-field"><span class="tps-k">Delivery label</span><input class="tps-input" @bind="_deliveryLabel" @bind:event="oninput" placeholder="e.g. Release 2026.11" data-testid="tps-delivery" /></label>
                        <label class="tps-field tps-field-grow"><span class="tps-k">Note</span><input class="tps-input" @bind="_snapshotNote" @bind:event="oninput" /></label>
                        <button type="button" class="tps-btn tps-btn-quiet" disabled="@(_busy || _dirty || string.IsNullOrWhiteSpace(_planName))" @onclick="SaveSnapshotAsync" data-testid="tps-save-snapshot">Save snapshot</button>
                        @if (_dirty) { <span class="tps-muted tps-small">Save the draft first.</span> }
                    </div>
                }
                <div class="tps-actionbar">
                    <button type="button" class="tps-btn tps-btn-quiet" @onclick="@(() => GoArea("compare"))" data-testid="tps-go-compare">Compare deliveries</button>
                    <button type="button" class="tps-btn tps-btn-quiet" @onclick="@(() => GoArea("snapshots"))" data-testid="tps-go-snapshots">All snapshots</button>
                </div>
            </details>
            @if (d.Cases.Any(c => c.Generated.CandidateType is ScenarioCandidateType.UiFunctional or ScenarioCandidateType.UiSmoke))
            {
                <p class="tps-muted tps-small" data-testid="tps-e2e-handoff">UI cases can become automated flows only through <a href="critical-e2e-regression#sg-panel">Critical E2E Regression › Suggested tests</a>, where a person verifies and approves them. Nothing is promoted from here.</p>
            }
        </section>
    };

    private async Task SaveSnapshotAsync()
    {
        if (_draft is null) return;
        _busy = true;
        // The plan name and delivery label are collected here (at save), then frozen with the snapshot.
        if (!string.Equals(_planName.Trim(), _draft.PlanName, StringComparison.Ordinal) || !string.Equals(_deliveryLabel.Trim(), _draft.DeliveryLabel ?? "", StringComparison.Ordinal))
        {
            var (renamed, renameError) = await _api!.SaveAsync(_draft.Id, P.ToSaveRequest(_draft with { PlanName = _planName.Trim(), DeliveryLabel = string.IsNullOrWhiteSpace(_deliveryLabel) ? null : _deliveryLabel.Trim() }));
            if (renamed is null) { _busy = false; Fail(renameError ?? "The plan name could not be saved."); return; }
            _draft = renamed;
        }
        var (result, error) = await _api!.SaveSnapshotAsync(_draft.Id, new SaveTestPlanSnapshotRequest(_draft.Revision, string.IsNullOrWhiteSpace(_deliveryLabel) ? null : _deliveryLabel.Trim(), string.IsNullOrWhiteSpace(_snapshotNote) ? null : _snapshotNote));
        _busy = false;
        if (result is null) { Fail(error ?? "The snapshot could not be saved."); return; }
        await ReloadWorkspaceAsync();
        _snapshotNote = "";
        if (result.Unchanged) Info(result.Message); else Ok(result.Message);
    }

    // ── Saved snapshots ─────────────────────────────────────────────────────────────────────────────────────

    /// <summary>Renames the plan (its name is the Azure DevOps file's name); no snapshot is needed for that.</summary>
    private async Task RenamePlanAsync()
    {
        if (_draft is null || _dirty || string.IsNullOrWhiteSpace(_planName)) return;
        _busy = true;
        var (renamed, error) = await _api!.SaveAsync(_draft.Id, P.ToSaveRequest(_draft with { PlanName = _planName.Trim() }));
        _busy = false;
        if (renamed is null) { Fail(error ?? "The name could not be saved."); return; }
        _draft = renamed; _planName = renamed.PlanName;
        await ReloadWorkspaceAsync();
        Ok("Test plan name saved.");
    }

    private RenderFragment SnapshotsArea() => __builder =>
    {
        var snapshots = _ws?.Snapshots ?? [];
        <section class="tps-section" data-testid="tps-snapshots" aria-labelledby="tps-snap-h">
            <div class="tps-section-head">
                <h2 id="tps-snap-h" class="tps-h2">Saved snapshots <span class="tps-count">@snapshots.Count</span></h2>
                <p class="tps-muted">Every saved snapshot of @(GuideMode ? "this guide's plans" : "this project's plans"). A snapshot can never be changed.</p>
            </div>
            @if (snapshots.Count == 0) { <p class="tps-muted" data-testid="tps-no-snapshots">No snapshot saved yet.</p> }
            <ul class="tps-rows" data-testid="tps-snapshot-list">
                @foreach (var s in snapshots)
                {
                    var sid = s.Id;
                    <li class="tps-row" data-testid="tps-snapshot-row" data-sequence="@s.Sequence">
                        <span class="tps-row-title">#@s.Sequence · @s.PlanName</span>
                        <span class="tps-muted tps-small">@(s.DeliveryLabel ?? "No delivery label") · @s.Cases cases · rules @s.RuleVersion · @s.CreatedBy · @s.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") · <code>@s.ContentFingerprint[..12]</code></span>
                        <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" @onclick="() => OpenSnapshotAsync(sid)" data-testid="tps-open-snapshot">Open</button>
                    </li>
                }
            </ul>
            @if (_openSnapshot is { } open)
            {
                <section class="tps-snapshot-view" data-testid="tps-snapshot-view" aria-label="Snapshot @open.Summary.Sequence">
                    <h3 class="tps-h3">Snapshot #@open.Summary.Sequence (read-only) · @open.Plan.PlanName</h3>
                    <p class="tps-muted tps-small">Draft revision @open.Summary.DraftRevision · @(open.Plan.ProjectKey is null ? $"guide revision {open.Plan.Basis.GuideRevision} ({open.Plan.Basis.GuideReviewState})" : $"project {open.Plan.ProjectName ?? open.Plan.ProjectKey}") · fingerprint <code>@open.Summary.ContentFingerprint</code></p>
                    @foreach (var suite in open.Plan.Suites)
                    {
                        var cases = open.Plan.Cases.Where(c => c.SuiteId == suite.Id).ToList();
                        if (cases.Count == 0) continue;
                        <h4 class="tps-h4">@suite.Name</h4>
                        <ul class="tps-plain">@foreach (var c in cases) { <li>@c.EffectiveTitle · <span class="tps-tone tps-tone-@P.Review(c.Review).Tone">@P.Review(c.Review).Text</span> · Expected: @(c.EffectiveExpected ?? "NEEDS CLARIFICATION")</li> }</ul>
                    }
                </section>
            }
        </section>
    };

    private async Task OpenSnapshotAsync(Guid id)
    {
        var (snapshot, error) = await _api!.SnapshotAsync(id);
        if (snapshot is null) { Fail(error ?? "The snapshot could not be opened."); return; }
        _openSnapshot = snapshot;
    }

    // ── Compare deliveries ───────────────────────────────────────────────────────────────────────────────────

    private RenderFragment CompareArea() => __builder =>
    {
        var snapshots = _ws?.Snapshots ?? [];
        <section class="tps-section" data-testid="tps-compare" aria-labelledby="tps-cmp-h">
            <div class="tps-section-head">
                <h2 id="tps-cmp-h" class="tps-h2">Compare deliveries</h2>
                <p class="tps-muted">Two saved snapshots, case by case. Source, review, Test Data and suggestion-rule differences are kept apart; a text change is never declared a behaviour change by itself.</p>
            </div>
            @if (snapshots.Count < 2) { <p class="tps-muted" data-testid="tps-compare-need">Save at least two snapshots to compare deliveries.</p> }
            else
            {
                <div class="tps-filters">
                    <label class="tps-field"><span class="tps-k">From (earlier)</span><select class="tps-input" @onchange="e => _compareFrom = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null" data-testid="tps-compare-from">
                        <option value="">Choose…</option>@foreach (var s in snapshots) { <option value="@s.Id" selected="@(_compareFrom == s.Id)">#@s.Sequence · @(s.DeliveryLabel ?? s.PlanName)</option> }</select></label>
                    <label class="tps-field"><span class="tps-k">To (later)</span><select class="tps-input" @onchange="e => _compareTo = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null" data-testid="tps-compare-to">
                        <option value="">Choose…</option>@foreach (var s in snapshots) { <option value="@s.Id" selected="@(_compareTo == s.Id)">#@s.Sequence · @(s.DeliveryLabel ?? s.PlanName)</option> }</select></label>
                    <button type="button" class="tps-btn" disabled="@(_busy || _compareFrom is null || _compareTo is null || _compareFrom == _compareTo)" @onclick="CompareAsync" data-testid="tps-compare-run">Compare</button>
                </div>
            }
            @if (_comparison is { } cmp)
            {
                @if (!cmp.Comparable) { <p class="tps-note tps-note-warn" data-testid="tps-incomparable">@cmp.IncomparableReason</p> }
                else
                {
                    <ul class="tps-stats" data-testid="tps-compare-counts" aria-label="Comparison summary">
                        <li><strong>@cmp.Added</strong> added</li><li><strong>@cmp.Changed</strong> changed</li><li><strong>@cmp.Removed</strong> removed</li><li><strong>@cmp.Unchanged</strong> unchanged</li>
                        <li><strong>@cmp.Cases.Count(c => c.PotentialBehaviourChange)</strong> potential rule changes</li>
                    </ul>
                    @if (cmp.Context.Count > 0)
                    {
                        <div class="tps-block" data-testid="tps-context-diff"><h3 class="tps-h3">Context differences</h3>
                            <ul class="tps-plain">@foreach (var x in cmp.Context) { <li><strong>@x.Category</strong>: @x.Before → @x.After. <span class="tps-muted">@x.Meaning</span></li> }</ul></div>
                    }
                    <div class="tps-block"><h3 class="tps-h3">Cases</h3>
                        <ul class="tps-cases" data-testid="tps-compare-cases">
                            @foreach (var c in cmp.Cases.Where(c => c.Kind != CaseChangeKind.Unchanged))
                            {
                                <li class="tps-case is-open" data-testid="tps-cmp-case" data-kind="@c.Kind" data-scenario="@c.ScenarioId">
                                    <div class="tps-case-head tps-case-head-static"><span class="tps-card-title">@c.Title</span><span class="tps-tone tps-tone-@(c.Kind switch { CaseChangeKind.Added => "info", CaseChangeKind.Removed => "muted", _ => c.PotentialBehaviourChange ? "bad" : "warn" })">@c.Kind</span></div>
                                    <div class="tps-case-body"><p class="tps-small">@c.Assessment</p>
                                        @if (c.Changes.Count > 0) { <dl class="tps-dl tps-diff">@foreach (var ch in c.Changes) { <dt>@ch.Category</dt><dd><span class="tps-before">@(ch.Before ?? "—")</span> → <span class="tps-after">@(ch.After ?? "—")</span></dd> }</dl> }</div>
                                </li>
                            }
                        </ul>
                        @if (cmp.Unchanged > 0) { <p class="tps-muted tps-small">@cmp.Unchanged unchanged cases are not listed.</p> }
                    </div>
                    <div class="tps-block" data-testid="tps-recommendations"><h3 class="tps-h3">Regression recommendations</h3>
                        @if (cmp.Recommendations.Count == 0) { <p class="tps-muted">None.</p> }
                        <ul class="tps-plain">@foreach (var r in cmp.Recommendations) { <li data-testid="tps-recommendation"><strong>@r.Kind</strong>: @r.Title — @r.Reason</li> }</ul>
                        <p class="tps-muted tps-small">Suggestions for a reviewer to select. Unchanged high-risk and previously blocked cases are kept in view on purpose.</p></div>
                }
            }
        </section>
    };

    private async Task CompareAsync()
    {
        if (_compareFrom is not { } from || _compareTo is not { } to) return;
        _busy = true;
        var (comparison, error) = await _api!.CompareAsync(from, to);
        _busy = false;
        if (comparison is null) { Fail(error ?? "The comparison failed."); return; }
        _comparison = comparison;
    }

    // ── Prepare for Azure DevOps ─────────────────────────────────────────────────────────────────────────────

    private RenderFragment ExportArea() => __builder =>
    {
        var snapshots = _ws?.Snapshots ?? [];
        @* The Azure DevOps Test Plans import file (XLSX / CSV) is built from the saved plan; one shared wizard. *@
        @if (_draft is { ProjectKey: { } exportProject } exportDraft)
        {
            <BirkNext.Web.Components.AdoExportWizard Draft="exportDraft" ProjectKey="@exportProject" CanWrite="CanWrite" Dirty="_dirty" />
        }
        else if (!GuideMode)
        {
            <p class="tps-muted" data-testid="tps-export-no-plan">Prepare and save a test plan first: the Azure DevOps export is built from saved test cases.</p>
        }
        @* Secondary: the Azure DevOps export above is the tester's export. This one archives a saved snapshot as BirkNext JSON; collapsed so the
           two are never mistaken for one another (M2LB end-to-end, 2026-11-19). *@
        <details class="tps-section" data-testid="tps-export" open="@(_export is not null)">
            <summary class="tps-section-head">
                <h2 id="tps-exp-h" class="tps-h2" style="display:inline">Other export: BirkNext JSON of a saved snapshot</h2>
                <p class="tps-muted">Azure DevOps Test Plans stays the authority for formal Test Plans, Suites, Cases, Runs and Results. BirkNext prepares a reviewable proposal from a saved snapshot: copyable text and a structured BirkNext JSON file. Nothing is written to Azure DevOps, and import compatibility is not verified.</p>
            </summary>
            @if (snapshots.Count == 0) { <p class="tps-muted" data-testid="tps-export-need">Save a snapshot first: an export is always of one saved snapshot.</p> }
            else
            {
                <div class="tps-filters">
                    <label class="tps-field"><span class="tps-k">Snapshot</span><select class="tps-input" @onchange="e => _exportSnapshot = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null" data-testid="tps-export-snapshot">
                        <option value="">Choose…</option>@foreach (var s in snapshots) { <option value="@s.Id" selected="@(_exportSnapshot == s.Id)">#@s.Sequence · @(s.DeliveryLabel ?? s.PlanName)</option> }</select></label>
                    <button type="button" class="tps-btn" disabled="@(_busy || _exportSnapshot is null)" @onclick="ExportAsync" data-testid="tps-export-run">Prepare export</button>
                </div>
            }
            @if (_export is { } x)
            {
                <p class="tps-note tps-note-info" data-testid="tps-export-boundary">@x.Boundary</p>
                @if (x.Unresolved.Count > 0)
                {
                    <div class="tps-block" data-testid="tps-export-unresolved"><h3 class="tps-h3">Unresolved questions (@x.Unresolved.Count)</h3><ul class="tps-plain">@foreach (var u in x.Unresolved.Take(30)) { <li>@u</li> }</ul>
                        @if (x.Unresolved.Count > 30) { <p class="tps-muted tps-small">…and @(x.Unresolved.Count - 30) more in the file.</p> }</div>
                }
                <div class="tps-actionbar">
                    <a class="tps-btn" download="@x.FileName" href="@("data:application/json;charset=utf-8," + Uri.EscapeDataString(x.Json))" data-testid="tps-export-download">Download JSON</a>
                    <span class="tps-muted tps-small tps-wrap">@x.FileName · format @x.Format</span>
                </div>
                <label class="tps-field tps-field-wide"><span class="tps-k">Copyable Test Case drafts</span><textarea class="tps-input tps-export-text" rows="16" readonly data-testid="tps-export-text">@x.Text</textarea></label>
            }
        </details>
    };

    private async Task ExportAsync()
    {
        if (_exportSnapshot is not { } id) return;
        _busy = true;
        var (export, error) = await _api!.ExportAsync(id);
        _busy = false;
        if (export is null) { Fail(error ?? "The export could not be prepared."); return; }
        _export = export;
    }
}

@code {
    // ── Scenario-centric Plan & prepare (2026-11-20) ──────────────────────────────────────────────────────────────────────
    // Scenario = what is tested and why; its test cases = how. One scenario open at a time; one case editor open at a time inside it.

    private string? _openScenario;
    private bool _scenarioChosen;
    private string? _addUnder;
    private string _addTitle = "";
    // Which language each scenario is shown in (absent = the original).
    private readonly Dictionary<string, string> _shownLanguage = new(StringComparer.Ordinal);
    // A scenario whose translation could not be done: its note links to System Settings → Translation.
    private string? _translationHelp;
    private readonly Dictionary<string, List<TestCaseVariantProposal>> _variants = new(StringComparer.Ordinal);
    private readonly HashSet<string> _dirtyCases = new(StringComparer.Ordinal);
    private TranslationAvailability? _translation;

    /// <summary>Whether translation is available, as the backend says now. An available answer is reused for this visit; a "not available" one
    /// is asked again every time — it was cached for the whole visit, so after a tester switched to the offline translator in System Settings
    /// (or a first check timed out on a cold AVD session) Translate kept saying no service was available until the page was reloaded (2026-11-23).</summary>
    private async Task<TranslationAvailability> CurrentTranslationAsync() =>
        _translation is { Available: true } known ? known : await _api!.TranslationAsync();
    private string? _overwriteOffer;

    private static string ScenarioDomId(string key) => "tps-scn-" + (key.Length == 0 ? "unresolved" : ScenarioPlanning.Sha(key)[..10]);

    private string? OpenScenarioKey(List<ScenarioGroup> groups)
    {
        if (_scenarioChosen) return _openScenario is { } chosen && groups.Any(g => g.Key == chosen) ? chosen : null;
        var withOpenCase = groups.FirstOrDefault(g => g.Cases.Any(c => _openCases.Contains(c.Source.ScenarioId)));
        return withOpenCase?.Key ?? groups.FirstOrDefault()?.Key;
    }

    private void ToggleScenario(string key, bool isOpen)
    {
        _scenarioChosen = true;
        _openScenario = isOpen ? null : key;
        if (isOpen && _addUnder == key) _addUnder = null;
    }

    private void ShowLanguage(string key, string? language) { if (language is null) _shownLanguage.Remove(key); else _shownLanguage[key] = language; }

    private string? ShownLanguage(TestCaseDraft c) => c.ParentScenario is { } k && _shownLanguage.TryGetValue(k, out var l) ? l : null;

    /// <summary>The languages a tester can translate into (the configured ones once known; Norwegian bokmål by default).</summary>
    private IReadOnlyList<string> Targets => _translation?.TargetLanguages ?? [ScenarioPlanning.Norwegian];

    /// <summary>Languages to offer "Show …" for in a scenario: the configured targets plus any language its cases already have text in.</summary>
    private List<string> ScenarioLanguages(ScenarioGroup g) => [.. Targets.Concat(g.Cases.SelectMany(c => c.TranslatedLanguages)).Distinct(StringComparer.OrdinalIgnoreCase)];

    private static TestCaseDraft? ScenarioCase(TestPlanDraft d, TestCaseDraft c) =>
        c.ParentScenario is { } k ? d.Cases.FirstOrDefault(x => x.Source.Kind != ScenarioSourceKind.Manual && x.Source.ScenarioId == k) : null;

    private bool Unsaved(TestCaseDraft c) => _dirty && _dirtyCases.Contains(c.Source.ScenarioId);

    /// <summary>A case written by hand and never reviewed can be removed; anything reviewed is excluded with a reason instead (history kept).</summary>
    private static bool Removable(TestCaseDraft c) =>
        c.Source.Kind == ScenarioSourceKind.Manual && c.ReviewHistory.Count == 0 && c.Review is TestCaseReviewState.Generated or TestCaseReviewState.UnderReview;

    private void RemoveCase(string sid)
    {
        if (_draft is not { } d) return;
        if (d.Cases.Count <= 1) { Fail("A plan keeps at least one test case."); return; }
        var title = d.Cases.FirstOrDefault(c => c.Source.ScenarioId == sid)?.EffectiveTitle;
        Change(d with { Cases = [.. d.Cases.Where(c => c.Source.ScenarioId != sid)] });
        _openCases.Remove(sid);
        Info($"\"{title}\" is removed when you save. Earlier versions of the plan keep it.");
    }

    private void StartAddUnder(ScenarioGroup g)
    {
        _scenarioChosen = true;
        _openScenario = g.Key;
        _addUnder = g.Key;
        _addTitle = "";
    }

    private async Task AddUnderAsync(ScenarioGroup g)
    {
        if (_draft is null || string.IsNullOrWhiteSpace(_addTitle)) return;
        await AddToScenarioAsync(new AddManualTestCaseRequest(_draft.Revision, _addTitle.Trim(), null, null, ScenarioKey: g.Key), "Test case added under the scenario. Write its steps with an expected result for each, then save.");
        _addUnder = null; _addTitle = "";
    }

    private Task DuplicateAsync(TestCaseDraft c) => _draft is null ? Task.CompletedTask
        : AddToScenarioAsync(new AddManualTestCaseRequest(_draft.Revision, $"{c.EffectiveTitle} (copy)", null, null, ScenarioKey: c.ParentScenario, CopyFrom: c.Source.ScenarioId),
            "Duplicated as a new test case with its own identity. Change what makes it a different test (title, data, expected result) and save. Review, history and Azure DevOps id were not copied.");

    private async Task AddVariantAsync(ScenarioGroup g, TestCaseVariantProposal v)
    {
        if (_draft is null) return;
        await AddToScenarioAsync(new AddManualTestCaseRequest(_draft.Revision, v.Title, null, null, ScenarioKey: g.Key, Variant: v.Key),
            v.Expected is null ? "Variant added. The evidence states no outcome for it: write the expected result before approving." : "Variant added from the scenario's evidence. Check it and save.");
        _variants.Remove(g.Key);
    }

    private async Task AddToScenarioAsync(AddManualTestCaseRequest request, string message)
    {
        if (_draft is null) return;
        if (_dirty) { Fail("Save or discard your changes first."); return; }
        _busy = true;
        var before = _draft.Cases.Select(c => c.Source.ScenarioId).ToHashSet(StringComparer.Ordinal);
        var (draft, error) = await _api!.AddManualCaseAsync(_draft.Id, request);
        _busy = false;
        if (draft is null) { Fail(error ?? "The test case could not be added."); return; }
        _draft = draft; _dirty = false;
        await ReloadWorkspaceAsync();
        if (draft.Cases.FirstOrDefault(c => !before.Contains(c.Source.ScenarioId)) is { } added)
        {
            _openCases.Clear();
            _openCases.Add(added.Source.ScenarioId);
            _scenarioChosen = true;
            _openScenario = added.ParentScenario ?? "";
            if (added.EffectiveSteps.Count == 0) _focusNewStep = added.Source.ScenarioId;
        }
        Ok(message);
    }

    private async Task LoadVariantsAsync(string key)
    {
        if (_draft is null) return;
        _busy = true;
        var (variants, error) = await _api!.VariantsAsync(_draft.Id, key);
        _busy = false;
        if (variants is null) { Fail(error ?? "Suggestions could not be read."); return; }
        _variants[key] = variants;
    }

    /// <summary>The scenario being translated right now (its waiting note); null when none.</summary>
    private string? _translatingScenario;

    private async Task TranslateScenarioAsync(ScenarioGroup g, bool overwrite = false)
    {
        if (_draft is null) return;
        if (_dirty) { Fail("Save or discard your changes first, then translate."); return; }
        _translation = await CurrentTranslationAsync();
        var target = _shownLanguage.TryGetValue(g.Key, out var shown) ? shown : Targets[0];
        var name = TranslationLanguages.Name(target);
        _scenarioChosen = true; _openScenario = g.Key;
        if (!_translation.Available)
        {
            // No translation choice is available: say why, where to set it up, and open the fields to write the text by hand.
            _shownLanguage[g.Key] = target;
            _translationHelp = g.Key;
            Fail($"No translation service is available. {_translation.Reason.Split(" You can write", 2)[0]} The {name} fields are open in each test case of this scenario so you can write the text by hand.");
            return;
        }
        _busy = true; _translatingScenario = g.Key;
        var (result, error) = await _api!.TranslateAsync(_draft.Id, new TranslateScenarioRequest(_draft.Revision, g.Key, overwrite, target));
        _busy = false; _translatingScenario = null;
        if (result is null)
        {
            _shownLanguage[g.Key] = target;
            _translationHelp = g.Key;
            Fail(error ?? "The scenario could not be translated.");
            return;
        }
        _translationHelp = null;
        if (result.Draft is { } draft) { _draft = draft; await ReloadWorkspaceAsync(); }
        _shownLanguage[g.Key] = result.Target ?? target;
        _overwriteOffer = result.KeptPersonEdits.Count > 0 && !overwrite ? g.Key : null;
        var detail = result.Failed.Count > 0 ? " " + string.Join(" ", result.Failed.Take(3)) : "";
        if (result.Failed.Count > 0 && result.Translated.Count == 0) Fail(result.Message + detail); else Ok(result.Message + detail);
    }

    private RenderFragment ScenarioList(TestPlanDraft d) => __builder =>
    {
        var groups = ScenarioPlanning.Groups(d);
        var openKey = OpenScenarioKey(groups);
        var project = d.ProjectKey is not null;
        var stories = C.StoryGroups(groups);
        @if (project) { @TranslateAllBar(d, groups) }
        <p class="tps-muted tps-small" data-testid="tps-scenario-summary">@groups.Count(g => !g.Unresolved) scenario@(groups.Count(g => !g.Unresolved) == 1 ? "" : "s") · @d.Cases.Count test case@(d.Cases.Count == 1 ? "" : "s")@(stories is null ? "" : $" · {stories.Count(s => s.Kind == C.StoryGroupKind.Story)} user stor{(stories.Count(s => s.Kind == C.StoryGroupKind.Story) == 1 ? "y" : "ies")}"). A scenario says what is tested and why; its test cases say how and what result is expected.</p>
        @if (stories is null)
        {
            <div class="tps-scenarios" data-testid="tps-scenarios">
                @foreach (var g in groups) { @ScenarioItem(d, g, openKey, project, false, [.. groups.Where(x => !x.Unresolved).Select(x => x.Key)]) }
            </div>
        }
        else
        {
            // Feature → User Story → Scenario → Test cases, as the specification structures them.
            <div class="tps-scenarios" data-testid="tps-scenarios">
                @{ string? lastFeature = null; }
                @foreach (var sg in stories)
                {
                    @if (sg.Feature is { Length: > 0 } feature && feature != lastFeature)
                    {
                        lastFeature = feature;
                        <p class="tps-feature" data-testid="tps-feature"><span class="tps-k">Feature</span> @feature</p>
                    }
                    var storyId = "tps-story-" + ScenarioPlanning.Sha(sg.Key)[..10];
                    <section class="tps-story" data-testid="tps-story" data-story="@sg.Key" data-kind="@sg.Kind" aria-labelledby="@($"{storyId}-h")">
                        <div class="tps-story-head">
                            <h3 class="tps-story-h" id="@($"{storyId}-h")" data-testid="tps-story-title">@(sg.Story is { } hs && StoryLanguage(sg) is { } hl && StoryText(hs.Key, hl)?.Title is { Length: > 0 } ht ? ht : sg.Label)</h3>
                            @if (sg.Story is { } st)
                            {
                                @if (st.StoryId is { } sid) { <span class="tps-badge" data-testid="tps-story-id">@sid</span> }
                                @if (st.Priority is { } priority) { <span class="tps-badge tps-badge-@priority.ToLowerInvariant()" data-testid="tps-story-priority">@priority</span> }
                                @if (st.IndependentTest is not null) { <span class="tps-chip tps-chip-quiet" data-testid="tps-story-independent">Independent Test</span> }
                                <span class="tps-muted tps-small" data-testid="tps-story-counts">@sg.Scenarios.Count of @st.Scenarios scenario@(st.Scenarios == 1 ? "" : "s") in the plan</span>
                            }
                            else if (sg.Kind == C.StoryGroupKind.NoStory)
                            {
                                <span class="tps-muted tps-small" data-testid="tps-story-none">Parent user story: not identified in the specification</span>
                            }
                        </div>
                        @StoryCard(d, sg)
                        <div class="tps-story-scenarios">
                            @foreach (var g in sg.Scenarios) { @ScenarioItem(d, g, openKey, project, true, [.. sg.Scenarios.Select(x => x.Key)]) }
                        </div>
                    </section>
                }
            </div>
        }
    };

    private RenderFragment ScenarioItem(TestPlanDraft d, ScenarioGroup g, string? openKey, bool project, bool storied, List<string> siblings) => __builder =>
    {
        var position = siblings.IndexOf(g.Key);
        var reorder = CanWrite && project && !g.Unresolved && siblings.Count > 1;
        var isOpen = g.Key == openKey;
        var domId = ScenarioDomId(g.Key);
        var lang = _shownLanguage.GetValueOrDefault(g.Key);
        var nb = lang is not null;
        var primaryNb = lang is null ? null : g.Primary?.Translation(lang);
        var target = lang ?? Targets[0];
        var targetName = TranslationLanguages.Name(target);
        var group = g;
        <section class="tps-scn @(isOpen ? "is-open" : null) @(_dropTarget == "scenario:" + g.Key ? "is-drop-target" : null)" data-testid="tps-scenario" data-scenario="@g.Key" data-open="@(isOpen ? "true" : "false")" aria-labelledby="@($"{domId}-h")"
                 @ondragover:preventDefault @ondragenter='() => DragEnter("scenario:" + group.Key)' @ondrop="() => { PinOpen(openKey); DropScenario(d, siblings, group.Key); }">
            <div class="tps-scn-head">
                @if (reorder)
                {
                    <span class="tps-drag" draggable="true" data-drag="@($"scenario:{g.Key}")" title="Drag to reorder the scenario" aria-hidden="true"
                          @ondragstart='() => _drag = ("scenario", group.Key, -1)' @ondragend="DragEnd" data-testid="tps-scenario-drag">⋮⋮</span>
                }
                <div class="tps-scn-h" role="heading" aria-level="@(storied ? 4 : 3)" id="@($"{domId}-h")">
                    <button type="button" class="tps-scn-toggle" aria-expanded="@(isOpen ? "true" : "false")" aria-controls="@($"{domId}-body")" @onclick="() => ToggleScenario(group.Key, isOpen)" data-testid="tps-scenario-toggle">
                        <span class="tps-scn-chevron" aria-hidden="true">@(isOpen ? "▾" : "▸")</span>
                        <span class="tps-scn-title" data-testid="tps-scenario-title">@(string.IsNullOrWhiteSpace(primaryNb?.Title) ? g.Title : primaryNb!.Title)</span>
                        <span class="tps-scn-meta" data-testid="tps-scenario-counts">@C.Counts(g)</span>
                    </button>
                </div>
                @if (!g.Unresolved && project)
                {
                    <div class="tps-scn-tools" role="group" aria-label="@($"Scenario actions: {g.Title}")">
                        <span class="tps-chip tps-chip-quiet" data-testid="tps-scenario-language" data-language="@(lang ?? "original")">@(lang is null ? "Original" : TranslationLanguages.Name(lang))</span>
                        @if (CanWrite)
                        {
                            <button type="button" class="tps-icon-btn" disabled="@_busy" aria-label="@($"Translate scenario and test cases to {targetName}")" title="@($"Translate scenario and test cases to {targetName}")"
                                    @onclick="() => TranslateScenarioAsync(group)" data-testid="tps-scenario-translate">
                                <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 8 6 6"/><path d="m4 14 6-6 2-3"/><path d="M2 5h12"/><path d="M7 2h1"/><path d="m22 22-5-10-5 10"/><path d="M14 18h6"/></svg>
                            </button>
                        }
                        @if (nb)
                        {
                            <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" @onclick="() => ShowLanguage(group.Key, null)" data-testid="tps-scenario-language-toggle">Show original</button>
                        }
                        else if (g.Cases.Any(c => c.TranslatedLanguages.Any()))
                        {
                            @foreach (var available in ScenarioLanguages(g).Where(l => g.Cases.Any(c => c.Translation(l) is not null)))
                            {
                                var show = available;
                                <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" @onclick="() => ShowLanguage(group.Key, show)" data-testid="tps-scenario-language-toggle" data-language="@show">Show @TranslationLanguages.Name(show)</button>
                            }
                        }
                        @if (CanWrite && ScenarioLanguages(g).Count > 1)
                        {
                                <select class="tps-input tps-input-sm" aria-label="Language to show and translate into" @onchange="e => ShowLanguage(group.Key, string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString())" data-testid="tps-scenario-target">
                                    <option value="" selected="@(lang is null)">Original</option>
                                    @foreach (var l in ScenarioLanguages(g)) { <option value="@l" selected="@(l == lang)">@TranslationLanguages.Name(l)</option> }
                                </select>
                        }
                        @if (CanWrite) { <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" disabled="@_busy" @onclick="() => StartAddUnder(group)" data-testid="tps-scenario-add">+ Add test case</button> }
                        @if (reorder)
                        {
                            <span class="tps-order" role="group" aria-label="@($"Order of {g.Title}")">
                                <button type="button" class="tps-icon-btn tps-icon-btn-sm" disabled="@(_busy || position <= 0)" aria-label="@($"Move scenario {g.Title} up")" title="Move up"
                                        @onclick="() => { PinOpen(openKey); Change(PlanOrdering.MoveScenario(d, group.Key, siblings, position - 1)); }" data-testid="tps-scenario-up">↑</button>
                                <button type="button" class="tps-icon-btn tps-icon-btn-sm" disabled="@(_busy || position >= siblings.Count - 1)" aria-label="@($"Move scenario {g.Title} down")" title="Move down"
                                        @onclick="() => { PinOpen(openKey); Change(PlanOrdering.MoveScenario(d, group.Key, siblings, position + 1)); }" data-testid="tps-scenario-down">↓</button>
                            </span>
                        }
                        @if (CanWrite && !g.Unresolved)
                        {
                            @if (PlanOrdering.RemoveScenarioBlocker(d, g.Key) is null)
                            {
                                <button type="button" class="tps-icon-btn tps-icon-btn-sm" disabled="@_busy" aria-label="@($"Remove scenario {g.Title} from the plan")" title="Remove from the plan (never reviewed; earlier versions keep it)"
                                        @onclick="() => RemoveScenario(d, group)" data-testid="tps-scenario-remove">🗑</button>
                            }
                            else if (g.Cases.Any(c => c.Review is not (TestCaseReviewState.Excluded or TestCaseReviewState.Superseded)))
                            {
                                <button type="button" class="tps-icon-btn tps-icon-btn-sm" disabled="@_busy" aria-label="@($"Exclude scenario {g.Title}")" title="@PlanOrdering.RemoveScenarioBlocker(d, g.Key)"
                                        @onclick="() => { _excludeScenario = group.Key; _excludeReason = string.Empty; _scenarioChosen = true; _openScenario = group.Key; }" data-testid="tps-scenario-exclude">⊘</button>
                            }
                        }
                    </div>
                }
            </div>
            @if (isOpen)
            {
                <div class="tps-scn-body" id="@($"{domId}-body")">
                    @if (g.Unresolved)
                    {
                        <p class="tps-note tps-note-info" data-testid="tps-scenario-unresolved">These test cases were written by hand without a scenario. No scenario can be established for them from the evidence, so none is assigned; they work as before.</p>
                    }
                    else if (g.Primary is { } primary)
                    {
                        var scenarioLinks = primary.RequirementLinks.Where(l => l.Scope == RequirementLinkScope.Scenario).ToList();
                        <dl class="tps-dl tps-scn-overview" data-testid="tps-scenario-overview">
                            <dt>Purpose</dt><dd data-testid="tps-scenario-purpose">@(string.IsNullOrWhiteSpace(primaryNb?.Purpose) ? primary.EffectivePurpose : primaryNb!.Purpose)</dd>
                            @foreach (var (label, key, value) in C.OverviewFields(primary))
                            {
                                var translatedValue = primaryNb is null ? null : C.TranslatedOverview(primaryNb, key);
                                <dt>@label</dt><dd data-testid="@($"tps-scenario-{key}")">@(translatedValue ?? value)@if (translatedValue is not null) { <span class="tps-orig" lang="en">Original: @value</span> }</dd>
                            }
                                @if (C.StoryOf(g) is { } story)
                                {
                                    var storyText = lang is null ? null : StoryText(story.Key, lang);
                                    <dt>User story</dt><dd data-testid="tps-scenario-story">@(storyText?.Title is { Length: > 0 } st ? st : C.StoryLabel(story))@(primary.Generated.NumberInStory is { } n ? $" · scenario {n}" : "")</dd>
                                    @if (story.IndependentTest is { } it) { <dt>Independent Test</dt><dd class="tps-small" data-testid="tps-scenario-independent">@(storyText?.IndependentTest ?? it)</dd> }
                                }
                                else if (primary.Generated.Capability == "specification") { <dt>User story</dt><dd class="tps-muted" data-testid="tps-scenario-story">Not identified</dd> }
                            <dt>Source</dt><dd class="tps-small" data-testid="tps-scenario-evidence" title="@($"{C.SourceReference(primary)}{(d.SnapshotKey is { } fullSnap ? $" · snapshot {fullSnap}" : "")}")">@(C.SourceReference(primary) is { } sourceRef ? C.ShortReference(sourceRef) : "Not stated")@(primary.Generated.GroupTitle is { } area ? $" · {area}" : "")@(d.SnapshotKey is { } snap ? $" · snapshot {C.ShortId(snap)}" : "")</dd>
                            <dt>Scenario requirements</dt><dd data-testid="tps-scenario-requirements">@(scenarioLinks.Count == 0 ? "None confirmed for the scenario as a whole." : string.Join(", ", scenarioLinks.Select(l => l.RequirementId)))
                                <span class="tps-muted tps-small"> — apply to the business scenario; never counted as a test case's test design.</span></dd>
                            @if (nb) { <dt>Original</dt><dd class="tps-muted tps-small" data-testid="tps-scenario-original">@g.Title</dd> }
                        </dl>
                    }
                    else
                    {
                        <p class="tps-muted tps-small" data-testid="tps-scenario-no-primary">The scenario's own case is no longer in this plan; the cases written under "@g.Title" stay here.</p>
                    }
                    @if (_translatingScenario == g.Key)
                    {
                        <InlineLoading Class="tps-note tps-note-info" TestId="tps-translate-running" Text="@($"Translating to {targetName}… The first translation after signing in starts the offline translator, which loads its language model and can take a few minutes on a new session. Later translations take seconds.")" />
                    }
                    @if (_translationHelp == g.Key)
                    {
                        <p class="tps-note tps-note-warn" data-testid="tps-translate-help" role="status">No translation was made. Choose the offline translator packaged with BirkNext, set up Azure AI Translator, or start a LibreTranslate server in
                            <a href="admin/system-settings?section=translation" data-testid="tps-translate-settings">System Settings → Translation</a>,
                            or write the @targetName text in the fields below — it is saved like any other change.</p>
                    }
                    @if (_overwriteOffer == g.Key && CanWrite)
                    {
                        <p class="tps-note tps-note-info" data-testid="tps-translate-kept">@targetName text written by a person was kept. <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" disabled="@_busy" @onclick="() => TranslateScenarioAsync(group, true)" data-testid="tps-translate-overwrite">Replace it with a new machine translation</button></p>
                    }
                    @if (_excludeScenario == g.Key && CanWrite)
                    {
                        <div class="tps-inline-card" role="group" aria-label="@($"Exclude {g.Title}")" data-testid="tps-scenario-exclude-form">
                            <p class="tps-popover-title">Exclude the scenario and its @g.Cases.Count(c => c.Review is not (TestCaseReviewState.Excluded or TestCaseReviewState.Superseded)) test case(s)?</p>
                            <p class="tps-muted tps-small">A test case of it has been reviewed, so it is excluded with a reason instead of removed. Nothing is deleted: its cases, their history and the evidence stay, and each case can be reviewed again.</p>
                            <label class="tps-field"><span class="tps-k">Reason</span><input class="tps-input" @bind="_excludeReason" @bind:event="oninput" placeholder="Why it is not tested in this plan" data-testid="tps-scenario-exclude-reason" /></label>
                            <div class="tps-popover-actions">
                                <button type="button" class="tps-btn" disabled="@(_busy || _dirty || string.IsNullOrWhiteSpace(_excludeReason))" @onclick="() => ExcludeScenarioAsync(group)" data-testid="tps-scenario-exclude-confirm">Exclude scenario</button>
                                <button type="button" class="tps-btn tps-btn-quiet" @onclick="() => _excludeScenario = null" data-testid="tps-scenario-exclude-cancel">Cancel</button>
                            </div>
                            @if (_dirty) { <p class="tps-muted tps-small">Save or discard your changes first.</p> }
                        </div>
                    }
                    @if (_addUnder == g.Key && CanWrite)
                    {
                        var duplicates = ScenarioPlanning.LikelyDuplicates(_addTitle, g.Primary?.EffectivePreconditions, [], g.Cases);
                        <div class="tps-actionbar tps-actionbar-compact" data-testid="tps-scenario-add-form">
                            <label class="tps-field tps-field-grow"><span class="tps-k">New test case under this scenario</span>
                                <input class="tps-input" @bind="_addTitle" @bind:event="oninput" placeholder="Title, e.g. No report submitted" data-testid="tps-scenario-add-title" /></label>
                            <button type="button" class="tps-btn" disabled="@(_busy || _dirty || string.IsNullOrWhiteSpace(_addTitle))" @onclick="() => AddUnderAsync(group)" data-testid="tps-scenario-add-confirm">Add test case</button>
                            <button type="button" class="tps-btn tps-btn-quiet" @onclick="() => _addUnder = null" data-testid="tps-scenario-add-cancel">Cancel</button>
                        </div>
                        @if (_dirty) { <p class="tps-muted tps-small">Save or discard your changes first.</p> }
                        else if (string.IsNullOrWhiteSpace(_addTitle)) { <p class="tps-muted tps-small" data-testid="tps-scenario-add-hint">Type a title. The case starts from the scenario's starting situation; steps and expected results are yours to write.</p> }
                        @if (duplicates.Count > 0 && !string.IsNullOrWhiteSpace(_addTitle)) { <p class="tps-note tps-note-warn" data-testid="tps-scenario-add-duplicate">Looks like an existing case: @string.Join("; ", duplicates.Select(x => x.EffectiveTitle)). Keep it only if it tests something different.</p> }
                    }
                    @if (!g.Unresolved && g.Primary is not null && CanWrite && project)
                    {
                        <div class="tps-variants" data-testid="tps-variants-panel">
                            <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" disabled="@(_busy || _dirty)" @onclick="() => LoadVariantsAsync(group.Key)" data-testid="tps-scenario-suggest">Suggest more test cases</button>
                            @if (_variants.TryGetValue(g.Key, out var proposals))
                            {
                                @if (proposals.Count == 0)
                                {
                                    <p class="tps-muted tps-small" data-testid="tps-variants-none">The scenario's evidence supports no further variant (no stated failure case, further condition or error response). Add a case by hand if you know one.</p>
                                }
                                else
                                {
                                    <ul class="tps-plain tps-variant-list" data-testid="tps-variants">
                                        @foreach (var v in proposals)
                                        {
                                            var variant = v;
                                            <li data-testid="tps-variant" data-key="@v.Key"><strong>@v.Title</strong> <span class="tps-chip tps-chip-quiet">@v.Dimension</span>
                                                <div class="tps-muted tps-small">@v.Basis@(v.Expected is null ? " Expected result: needs clarification." : "")</div>
                                                <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" disabled="@(_busy || _dirty)" @onclick="() => AddVariantAsync(group, variant)" data-testid="tps-variant-add">Add as test case</button></li>
                                        }
                                    </ul>
                                    <p class="tps-muted tps-small">Proposals from this scenario's evidence only. Nothing is added until you choose one.</p>
                                }
                            }
                        </div>
                    }
                    <ul class="tps-cases" aria-label="@($"Test cases of {g.Title}")">@foreach (var c in g.Cases) { @CaseEditor(d, c) }</ul>
                </div>
            }
        </section>
    };

    private RenderFragment CaseStatus(TestPlanDraft d, TestCaseDraft c, string sid) => __builder =>
    {
        var review = P.Review(c.Review);
        <dl class="tps-lifecycle" data-testid="@($"tps-case-lifecycle-{sid}")" aria-label="Status of this test case">
            <div><dt>Content</dt><dd data-testid="tps-case-content-state">@C.ContentState(c, Unsaved(c))</dd></div>
            <div><dt>Review</dt><dd data-testid="tps-case-review-state"><span class="tps-tone tps-tone-@review.Tone">@review.Text</span></dd></div>
            <div><dt>Testability</dt><dd data-testid="tps-case-testability-state">@(c.Testability.Ready ? "Ready" : "Needs action")</dd></div>
            <div><dt>Export</dt><dd data-testid="tps-case-export-state">@C.ExportState(c)</dd></div>
            @if (d.ProjectKey is not null) { <div><dt>Translations</dt><dd data-testid="tps-case-language-state">@C.Languages(c)</dd></div> }
            @if (c.DuplicatedFrom is { } from) { <div><dt>Copied from</dt><dd data-testid="tps-case-copied-from">@(d.Cases.FirstOrDefault(x => x.Source.ScenarioId == from)?.EffectiveTitle ?? from)</dd></div> }
        </dl>
        <p class="tps-muted tps-small">Approving records a review of the test design. It does not mean the requirement is right, the code works or the test was run.</p>
    };

    private RenderFragment TranslationEditor(TestPlanDraft d, TestCaseDraft c, string sid, string language) => __builder =>
    {
        var n = C.Editable(c, language);
        var steps = c.EffectiveSteps;
        var results = c.EffectiveStepExpected;
        var write = CanWrite;
        var name = TranslationLanguages.Name(language);
        <fieldset class="tps-fieldset tps-nb" disabled="@(_busy || !write)" data-testid="@($"tps-tr-{sid}")" data-language="@language" lang="@language">
            <legend>@name text <span class="tps-tone tps-tone-@C.TranslationTone(c, language)" data-testid="tps-tr-state">@C.TranslationLabel(c, language)</span></legend>
            <p class="tps-muted tps-small" lang="en">The original below stays as it is. Requirement ids, field names, codes and paths are kept exactly as in the original.</p>
            <label class="tps-field"><span class="tps-k" lang="en">Title (@name)</span>
                <input class="tps-input" value="@n.Title" @onchange="e => Change(P.WithCase(d, sid, x => C.WithTranslation(x, language, t => t with { Title = e.Value?.ToString() })))" data-testid="@($"tps-tr-title-{sid}")" />
                <span class="tps-orig" lang="en">Original: @c.EffectiveTitle</span></label>
            <label class="tps-field"><span class="tps-k" lang="en">Preconditions (@name)</span>
                <textarea class="tps-input" rows="2" value="@n.Preconditions" @onchange="e => Change(P.WithCase(d, sid, x => C.WithTranslation(x, language, t => t with { Preconditions = e.Value?.ToString() })))" data-testid="@($"tps-tr-preconditions-{sid}")"></textarea>
                <span class="tps-orig" lang="en">Original: @(c.EffectivePreconditions ?? "—")</span></label>
            <ol class="tps-step-list">
                @for (var i = 0; i < steps.Count; i++)
                {
                    var index = i;
                    <li class="tps-step-row" data-testid="@($"tps-tr-step-row-{sid}-{index}")">
                        <input class="tps-input" value="@n.Steps[index]" aria-label="@($"Step {index + 1} action ({name})")" @onchange="e => Change(P.WithCase(d, sid, x => C.WithTranslation(x, language, t => C.SetStep(t, index, e.Value?.ToString() ?? string.Empty, null))))" data-testid="@($"tps-tr-step-{sid}-{index}")" />
                        <input class="tps-input" value="@n.StepExpected[index]" aria-label="@($"Step {index + 1} expected result ({name})")" @onchange="e => Change(P.WithCase(d, sid, x => C.WithTranslation(x, language, t => C.SetStep(t, index, null, e.Value?.ToString() ?? string.Empty))))" data-testid="@($"tps-tr-step-expected-{sid}-{index}")" />
                        <span class="tps-orig" lang="en">Original: @steps[index] — @(results[index] ?? "Needs clarification")</span>
                    </li>
                }
            </ol>
            <label class="tps-field"><span class="tps-k" lang="en">Expected result (@name)</span>
                <textarea class="tps-input" rows="2" value="@n.ExpectedResult" @onchange="e => Change(P.WithCase(d, sid, x => C.WithTranslation(x, language, t => t with { ExpectedResult = e.Value?.ToString() })))" data-testid="@($"tps-tr-expected-{sid}")"></textarea>
                <span class="tps-orig" lang="en">Original: @(c.EffectiveExpected ?? "Needs clarification")</span></label>
            @if (c.Source.Kind != ScenarioSourceKind.Manual)
            {
                var (given, when, then) = ScenarioPlanning.ScenarioFields(c);
                @if (given is not null) { @TranslatedField(d, sid, language, $"Starting situation ({name})", n.Given, given, "given", (t, v) => t with { Given = v }) }
                @if (when is not null) { @TranslatedField(d, sid, language, $"Trigger or action ({name})", n.When, when, "when", (t, v) => t with { When = v }) }
                @if (then is not null) { @TranslatedField(d, sid, language, $"Expected business outcome ({name})", n.Then, then, "then", (t, v) => t with { Then = v }) }
            }
            @if (c.EffectiveObservation is { } observation) { @TranslatedField(d, sid, language, $"How to verify ({name})", n.ObservationMethod, observation, "observation", (t, v) => t with { ObservationMethod = v }) }
            @if (c.EffectiveEnvironment is { } environment) { @TranslatedField(d, sid, language, $"Environment and prerequisites ({name})", n.Environment, environment, "environment", (t, v) => t with { Environment = v }) }
            @if (c.Edits.Roles is { } roles) { @TranslatedField(d, sid, language, $"Roles and access ({name})", n.Roles, roles, "roles", (t, v) => t with { Roles = v }) }
            @if (c.Edits.Dependencies is { } dependencies) { @TranslatedField(d, sid, language, $"Dependencies ({name})", n.Dependencies, dependencies, "dependencies", (t, v) => t with { Dependencies = v }) }
            @if (steps.Count > 0 && !ScenarioPlanning.Complete(c.WithTranslation(language, n), language)) { <p class="tps-muted tps-small" data-testid="tps-tr-incomplete" lang="en">Until every step has @name text (and its result), an export in @name uses the original language for this case.</p> }
        </fieldset>
    };

    private RenderFragment Checklist(TestCaseDraft c, string sid) => __builder =>
    {
        var items = C.Checklist(c);
        <details class="tps-more" data-testid="@($"tps-checklist-{sid}")">
            <summary>Testability checklist <span class="tps-muted tps-small">— @items.Count(i => i.State == C.Check.Ready) ready, @items.Count(i => i.State == C.Check.NeedsAction) need action</span></summary>
            <ul class="tps-plain tps-checklist">
                @foreach (var item in items)
                {
                    <li data-testid="tps-check" data-check="@item.Id" data-state="@item.State"><span class="tps-tone tps-tone-@C.CheckTone(item.State)">@C.CheckLabel(item.State)</span> <strong>@item.Label</strong> <span class="tps-muted tps-small">@item.Detail</span>
                        @if (item.Id == "data" && item.State != C.Check.Ready && item.State != C.Check.NotApplicable) { <a class="tps-small" href="test-data?section=assets" data-testid="tps-check-open-test-data">Open Test Data</a> <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" @onclick="@(() => GoArea("testability"))" data-testid="tps-check-link-data">Link Test Data</button> }
                    </li>
                }
            </ul>
            <p class="tps-muted tps-small">Approving a case never makes it Ready: each line is Ready only when the case states it. BirkNext cannot verify the environment or access from here.</p>
        </details>
    };

    private RenderFragment SuggestedRequirements(TestPlanDraft d, TestCaseDraft c, string sid) => __builder =>
    {
        if (_requirements is not { Count: > 0 }) return;
        var scenario = ScenarioCase(d, c);
        var suggestions = C.Suggestions(c, scenario, _requirements);
        <div class="tps-suggest" data-testid="@($"tps-suggestions-{sid}")">
            <h5 class="tps-links-title">Suggested requirements</h5>
            @if (suggestions.Count == 0)
            {
                <p class="tps-muted tps-small" data-testid="tps-suggestions-none">No requirement of the specification is suggested for this case. That can be right. Link one from the search if you know it; an unlinked case is shown as not linked in Test Coverage.</p>
            }
            else
            {
                <ul class="tps-plain tps-suggest-list">
                    @foreach (var s in suggestions)
                    {
                        var suggestion = s;
                        <li class="tps-suggest-row" data-testid="tps-suggestion" data-requirement="@s.RequirementId" data-level="@s.Level">
                            <div><strong>@s.RequirementId</strong> <span class="tps-tone tps-tone-@C.LevelTone(s.Level)" data-testid="tps-suggestion-level">@C.LevelLabel(s.Level)</span></div>
                            <div class="tps-small" data-testid="tps-suggestion-text">@(s.Title.Length > 240 ? s.Title[..239] + "…" : s.Title)@if (ShownLanguage(c) is { } suggestionLanguage && RequirementText(s.RequirementId, s.SpecificationPath, suggestionLanguage) is { } translatedSuggestion) { <span class="tps-orig" lang="@suggestionLanguage">@TranslationLanguages.Name(suggestionLanguage): @translatedSuggestion</span> }</div>
                            <div class="tps-muted tps-small" data-testid="tps-suggestion-why">Why: @s.Reason Source: @s.SpecificationPath</div>
                            <div class="tps-actionbar tps-actionbar-compact">
                                <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" disabled="@_busy" aria-label="@($"Link {s.RequirementId} to this test case")" @onclick="() => Change(P.WithCase(d, sid, x => C.Confirm(x, suggestion, null)))" data-testid="tps-suggestion-link">Link to this case</button>
                                @if (scenario is { } sc)
                                {
                                    var scenarioId = sc.Source.ScenarioId;
                                    <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" disabled="@_busy" aria-label="@($"Link {s.RequirementId} to the scenario as a whole")" @onclick="() => Change(P.WithCase(d, scenarioId, x => C.Confirm(x, suggestion, RequirementLinkScope.Scenario)))" data-testid="tps-suggestion-link-scenario">Link to the scenario</button>
                                }
                                <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" disabled="@_busy" aria-label="@($"{s.RequirementId} is not related to this test case")" @onclick="() => Change(P.WithCase(d, sid, x => C.Reject(x, suggestion)))" data-testid="tps-suggestion-reject">Not related</button>
                            </div>
                        </li>
                    }
                </ul>
            }
            <p class="tps-muted tps-small">A suggestion is not a link. Only a link you confirm and save counts as test design, and never as an executed test.</p>
        </div>
    };
}

