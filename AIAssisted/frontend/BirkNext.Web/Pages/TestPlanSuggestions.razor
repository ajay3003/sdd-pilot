    private async Task ImpactAsync()
    {
        if (_draft is null) return;
        _busy = true;
        var (impact, error) = await _api!.ImpactAsync(_draft.Id);
        _busy = false;
        if (impact is null) { Fail(error ?? "Konsekvensanalysen kunne ikke lages."); return; }
        _impact = impact;
    }

    private void StartResolve(TestCaseDraft c) { _resolveCase = c.Source.ScenarioId; _resolveExpected = c.EffectiveExpected ?? ""; _resolveRationale = ""; _resolveClaim = null; }

    private void PickClaim(List<ScenarioConflict> conflicts, string? candidateId)
    {
        _resolveClaim = string.IsNullOrWhiteSpace(candidateId) ? null : candidateId;
        if (conflicts.SelectMany(k => k.Claims).FirstOrDefault(x => x.CandidateId == _resolveClaim) is { } claim) _resolveExpected = claim.Expected;
    }

    private async Task ResolveConflictAsync(TestCaseDraft c)
    {
        if (_draft is null) return;
        _busy = true;
        var (draft, error) = await _api!.ResolveConflictAsync(_draft.Id, new ResolveConflictRequest(_draft.Revision, c.Source.ScenarioId, _resolveExpected, _resolveClaim, _resolveRationale));
        _busy = false;
        if (draft is null) { Fail(error ?? "Avklaringen kunne ikke lagres."); return; }
        _resolveCase = null;
        await OpenDraftAsync(draft.Id);
        Info("Avklaringen er lagret. Testtilfellet kan nå godkjennes.");
    }

    // ── Step 1: Choose scenarios ─────────────────────────────────────────────────────────────────────────────

    /// <summary>The project's own documents, parsed by the existing specification parser (the same evidence Test Coverage reads); null when unreadable.</summary>
    private async Task<BirkNext.TestCoverage.CoverageWorkspaceEvidence?> WorkspaceEvidenceAsync()
    {
        try
        {
            BirkNext.Web.Services.Explorers.ArtifactExplorerState? specification = null;
            BirkNext.Web.Services.Explorers.ArtifactExplorerState? tasks = null;
            List<(string Path, string Text)>? featureDocuments = null;
            if (ServiceProvider.GetService(typeof(BirkNext.Web.Services.Explorers.IArtifactExplorerContext)) is BirkNext.Web.Services.Explorers.IArtifactExplorerContext artifacts)
            {
                specification = await artifacts.GetStateAsync(WorkspaceArtifactType.Specification);
                _specificationState = specification;
                tasks = await artifacts.GetStateAsync(WorkspaceArtifactType.Tasks); // story → requirement references in the same feature's tasks.md
                try
                {
                    // … and in its plan.md / quickstart.md (lines naming the story and a requirement), from the pack's document inventory.
                    if (await artifacts.GetPackInventoryAsync() is { } inventory)
                        featureDocuments = [.. inventory.Documents.Where(doc => doc.Text is { Length: > 0 } && TestCoveragePresentation.StoryRelationDocuments.Contains(doc.FileName, StringComparer.OrdinalIgnoreCase))
                            .Select(doc => (doc.Path, doc.Text!))];
                }
                catch (Exception e) when (e is not OperationCanceledException) { featureDocuments = null; }
            }
            if (ServiceProvider.GetService(typeof(IReviewContextProvider)) is IReviewContextProvider reviewContext) await reviewContext.WhenCurrentAsync();
            if (ServiceProvider.GetService(typeof(IWorkspaceSessionService)) is IWorkspaceSessionService session)
            {
                var evidence = TestCoveragePresentation.WorkspaceEvidence(session, (ServiceProvider.GetService(typeof(IReviewContextProvider)) as IReviewContextProvider)?.GetCurrent(), _projectName, specification, tasks, featureDocuments);
                _stories = evidence.Stories;
                return evidence;
            }
        }
        catch (Exception e) when (e is not OperationCanceledException) { }
        return null;
    }

    /// <summary>The requirements a tester can link to (the current project's selected specification), and why the list is empty when it is.</summary>
    private async Task LoadRequirementsAsync()
    {
        var evidence = await WorkspaceEvidenceAsync();
        _requirements = L.Options(evidence);
        _requirementsNote = _requirements is { Count: > 0 } ? null : L.SpecificationChoiceNeeded(_specificationState) ?? L.EmptyReason(evidence, _requirements, _specificationState);
    }

    /// <summary>The tester chose another module, feature or specification here: its requirements are read again; the picker offers Discover now.</summary>
    // The specification changed after discovery: the discover bar says so and owns the one Discover button (the picker's own prompt is off here).
    private bool _specChanged;

    private Task OnSpecificationChangedAsync() { _specChanged = _discovery is not null; return LoadRequirementsAsync(); }

    private async Task DiscoverAsync()
    {
        if (_projectKey is null) return;
        _busy = true;
        _specChanged = false;
        Info("Discovering test scenarios… only the analyzers registered for this project's evidence run.");
        var evidence = await WorkspaceEvidenceAsync();
        var (result, error) = await _api!.DiscoverAsync(new ScenarioDiscoveryRequest
        {
            ProjectKey = _projectKey, ProjectName = _projectName, SnapshotId = _snapshotId, EnvironmentId = _environmentId, Workspace = evidence,
            MemberSnapshotIds = [.. ManualTestingWorkspace.MemberSnapshots(ServiceProvider)], Inspect = _inspect,
        });
        _busy = false;
        if (result is null) { Fail(error ?? "Discovery failed."); return; }
        UseDiscovery(result);
        _limit = P.PageSize;
        if (result.Candidates.Count == 0) Info("No test scenario was found in this project's evidence. Add tests in Azure DevOps Test Plans, or write test cases by hand under Advanced.");
        else Ok($"{result.Candidates.Count} scenario candidates found. Choose the ones to prepare; selecting approves nothing.");
    }

    private RenderFragment ChooseArea() => __builder =>
    {
        // One inventory, four views (2026-11-18): the view narrows what is listed, the filters narrow the view; the selection is never touched by either.
        var inView = _candidates.Where(c => P.InView(c, _inventory.Of(c), _view)).ToList();
        // Recommended first (2026-11-23): a long list starts on the highest-priority user-story scenarios with an expected result.
        var recommended = P.Recommended(inView);
        var recommendedOn = recommended.Count > 0 && recommended.Count < inView.Count && (_recommended ?? P.RecommendByDefault(inView, recommended));
        var grouping = _grouping ?? P.DefaultGrouping(inView);
        var shown = P.Apply(recommendedOn ? recommended : inView, _catalog).ToList();
        if (grouping == P.CatalogGrouping.Story) shown = [.. P.StoryOrder(shown)];
        var visible = shown.Take(_limit).ToList();
        var inDraft = InPlan;
        var shownIds = shown.Select(c => c.CandidateId).ToHashSet(StringComparer.Ordinal);
        var hiddenSelected = _selected.Count(id => !shownIds.Contains(id));
        var adding = _selected.Count(id => !inDraft.Contains(id));
        var alreadyPrepared = _selected.Count(inDraft.Contains);
        var overlaps = P.OverlapsWithPlan(_selected, _candidates, _inventory, inDraft);
        var compact = P.Compact(_compact, shown.Count);
        var moreFilters = (_catalog.Type is null ? 0 : 1) + (_catalog.Tests is null ? 0 : 1) + (_catalog.AttentionOnly ? 1 : 0);
        <section class="tps-section" data-testid="tps-choose" aria-label="Choose scenarios" data-view="@P.ViewId(_view)">
            @DiscoverySummary()
            @if (!GuideMode)
            {
                <BirkNext.Web.Components.SpecificationScopePicker Changed="OnSpecificationChangedAsync" ShowDiscoverLink="false" />
                <div class="tps-actionbar tps-actionbar-compact @(_specChanged ? "is-stale" : null)" data-testid="tps-discover-bar" role="@(_specChanged ? "status" : null)">
                    <button type="button" class="tps-btn @(_discovery is null || _specChanged ? null : "tps-btn-quiet")" disabled="@_busy" @onclick="DiscoverAsync" data-testid="tps-discover-run">@(_discovery is null ? "Discover test scenarios" : "Discover again")</button>
                    <span class="tps-muted tps-small" data-testid="tps-discover-note">@(_discovery is null ? "Reads the specification, source snapshot and contracts of this project. Nothing runs until you ask."
                        : _specChanged ? "The specification changed. The scenarios below came from the previous one; test cases already prepared stay in the plan."
                        : "The last result is reused until you discover again; changing a view or filter never re-runs analysis.")</span>
                </div>
            }
            @if (_candidates.Count == 0)
            {
                <div class="tps-empty" data-testid="tps-no-candidates">
                    <h3 class="tps-h3">@(GuideMode ? "The guide has no scenarios yet." : _discovery is null ? "Not discovered yet" : "No scenario found in this project's evidence")</h3>
                    @if (!GuideMode && _discovery is not null)
                    {
                        <p>None of the registered analyzers found a scenario: no specification acceptance scenarios or requirements, no Razor/HTML pages with a route, no OpenAPI/GraphQL operations and no integration journeys. Evidence sources above say what was read. Add tests in Azure DevOps Test Plans, or write test cases by hand under Advanced below.</p>
                    }
                </div>
            }
            else
            {
                <div class="tps-views" role="group" aria-label="Candidate view" data-testid="tps-views">
                    @foreach (var v in P.Views.Where(v => v != P.CandidateView.SystemEvents || _inventory.SystemEvents > 0 || _view == v))
                    {
                        var view = v;
                        var selectedHere = view == P.CandidateView.All ? _selected.Count : _candidates.Count(c => _selected.Contains(c.CandidateId) && P.InView(c, _inventory.Of(c), view));
                        <button type="button" class="tps-view @(_view == view ? "is-current" : null)" aria-pressed="@(_view == view ? "true" : "false")" data-testid="tps-view-@P.ViewId(view)"
                                @onclick="() => SetView(view)">@P.ViewLabel(view) <span class="tps-count" data-testid="tps-view-count">@_inventory.Count(view)</span>@if (selectedHere > 0 && _view != view) { <span class="tps-view-selected" title="Selected candidates in this view">@selectedHere selected</span> }</button>
                    }
                </div>
                <p class="tps-muted tps-small tps-view-hint" data-testid="tps-view-hint">@P.ViewHint(_view)</p>
                @if (_view == P.CandidateView.Manual && P.ManualEmptyReason(_inventory) is { } emptyReason)
                {
                    @* Adaptive default: an API-only project is never shown as an empty manual list without saying why and what can be done. *@
                    <div class="tps-empty tps-empty-compact" data-testid="tps-manual-empty" role="status">
