    // Azure DevOps Priority is 1–4: a picker, never free text. An older free-text value stays visible (and is replaced only when the tester picks).
    private RenderFragment PriorityField(TestCaseDraft c) => __builder =>
    {
        var sid = c.Source.ScenarioId;
