        <label class="tps-field"><span class="tps-k">Priority <span class="tps-muted tps-small">Azure DevOps 1–4</span></span>
            <select class="tps-input" value="@(mapped ?? (current is null ? "" : "custom"))" aria-label="Priority"
                    @onchange="e => Change(P.WithCase(_draft!, sid, x => x with { Edits = x.Edits with { Priority = P.PickedPriority(e.Value?.ToString(), current) } }))"
                    data-testid="@($"tps-edit-priority-{sid}")">
                <option value="">Not set</option>
                @foreach (var (value, label) in P.Priorities) { <option value="@value">@label</option> }
