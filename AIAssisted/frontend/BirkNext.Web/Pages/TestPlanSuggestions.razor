    private async Task TranslateAllAsync(List<ScenarioGroup> groups)
    {
        if (_draft is null) return;
        if (_dirty) { Fail("Save or discard your changes first, then translate."); return; }
        _translation = await CurrentTranslationAsync();
        var target = Targets[0];
        var name = TranslationLanguages.Name(target);
        _translateAllOpen = false;
        if (!_translation.Available)
        {
            ShowPlanIn(groups, target);
            _translateAllHelp = target;
            Fail($"No translation service is available. {_translation.Reason.Split(" You can write", 2)[0]} The {name} fields are open in every test case so you can write the text by hand.");
