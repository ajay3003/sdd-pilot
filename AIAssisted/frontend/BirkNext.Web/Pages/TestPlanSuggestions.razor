@page "/test-plan-suggestions"
@using BirkNext.TestPlanning
@using BirkNext.Web.Services
@using P = BirkNext.Web.Services.TestPlanSuggestionsPresentation
@using L = BirkNext.Web.Services.RequirementLinkPresentation
@using C = BirkNext.Web.Services.ScenarioCentricPresentation
@implements IDisposable
@inject IServiceProvider ServiceProvider
@inject NavigationManager Nav
@inject IJSRuntime JS

@* Test Plan Suggestions: prepares reviewable test cases for the SELECTED PROJECT from the evidence its registered analyzers can read (specification,
   System Understanding guide when one describes the project's source, UI source, API contracts, integration journeys, existing tests). Candidates are
   guidance — not Test Cases, not coverage, never executed — and nothing is written to Azure DevOps. Imported text is shown as text only (never as
   markup); nothing here runs an imported step. Historical System Understanding guide plans keep loading (?guide=…). *@
<PageTitle>Plan & prepare — Manual Testing</PageTitle>

<div class="tps" data-testid="tps" aria-busy="@(_loading ? "true" : "false")">
    @* Unsaved plan edits are never discarded silently (audit 2026-11-15): leaving the page or opening another plan asks first. *@
    <NavigationLock ConfirmExternalNavigation="@_dirty" OnBeforeInternalNavigation="ConfirmLeaveAsync" />
    @* Plan & prepare of the Manual Testing workspace IS Test Plan Suggestions: one planning page, same route and links as before. *@
    <BirkNext.Web.Components.TestingWorkspaceHeader Workspace="Manual Testing" HomeRoute="@ManualTestingPresentation.HomeRoute" Stages="ManualTestingPresentation.Stages"
        Current="plan" Title="Plan & prepare" ShowProject="@(!_loading && _projectKey is null && !GuideMode)"
        Lead="Choose what to test from the project's evidence, prepare readable test cases and save a plan. Candidates are proposals — not test cases, not executed tests.">
        <Help><BirkNext.Web.Components.HelpLink Topic="test-plan-suggestions" Text="What this page is" /></Help>
    </BirkNext.Web.Components.TestingWorkspaceHeader>

    @if (_loading)
    {
        <p class="tps-muted" data-testid="tps-loading">Loading the project's test plans…</p>
    }
    else if (_api is null || _error is not null && _ws is null && _projectKey is not null)
    {
        <section class="tps-empty" data-testid="tps-error"><h2>Test Plan Suggestions is not available</h2><p>@(_error ?? "Test Plan Suggestions is not available in this host.")</p></section>
    }
    else if (_guideKey is null && _projectKey is null)
    {
        <section class="tps-empty" data-testid="tps-no-project">
            <h2>Choose a project first</h2>
            <p>Test scenarios are discovered from one project's evidence. Open or import a project, then come back here.</p>
            <a class="tps-btn" href="project-import">Import a project</a>
            @if (_history.Count > 0)
            {
                <details class="tps-block" data-testid="tps-historical-plans"><summary>Earlier plans prepared from a System Understanding guide (@_history.Count)</summary>
                    <ul class="tps-plain">@foreach (var d in _history) { <li><a href="@($"{P.Route}?guide={Uri.EscapeDataString(d.GuideKey)}&draft={d.Id}")">@d.PlanName</a> <span class="tps-muted tps-small">revision @d.Revision · @d.Cases cases</span></li> }</ul>
                </details>
            }
        </section>
    }
    else
    {
        @ContextCard()
        @if (_message is not null)
        {
            <p class="tps-note tps-note-@_messageTone" role="status" data-testid="tps-message">@_message</p>
        }
        @if (_ws is { CanWrite: false })
        {
            <p class="tps-note tps-note-info" data-testid="tps-read-only">You can read plans. Preparing, reviewing and saving snapshots needs the configuration-write permission.</p>
        }

        @* Compact stepper (2026-11-18): one row of four numbered steps with their stored status, replacing four large descriptive cards. Every step
           opens (a step that cannot be worked on yet explains why in its own area); the purpose of the open step is one line under its heading. *@
        <div class="tps-nav">
            <nav class="tps-stepper-nav" aria-label="Test preparation steps">
                <ol class="tps-stepper" data-testid="tps-steps">
                    @{ var stepNo = 0; }
                    @foreach (var step in Steps)
                    {
                        stepNo++;
                        var id = step.Id;
                        var current = _area == id;
                        <li class="tps-step @(current ? "is-current" : null)" data-testid="tps-step" data-state="@step.State" data-step="@id">
                            <button type="button" class="tps-step-btn" aria-current="@(current ? "step" : null)" aria-describedby="tps-step-status-@id" data-testid="tps-area-@id"
                                    disabled="@_busy" @onclick="() => OnStepAction(id)">
                                <span class="tps-step-no" aria-hidden="true">@(step.State == GuidedStepState.Done ? "✓" : stepNo.ToString())</span>
                                <span class="tps-step-label">@step.Title</span>
                            </button>
                            <span class="tps-step-status" id="tps-step-status-@id" data-testid="tps-step-status">@(step.DisabledReason ?? step.StatusLabel)</span>
                        </li>
                    }
                </ol>
            </nav>
            <nav class="tps-areas" aria-label="Plan history and export">
                @foreach (var a in P.MoreAreas.Where(a => !P.IsAdvancedArea(a.Id)))
                {
                    var id = a.Id;
                    <button type="button" class="tps-area @(_area == id ? "is-current" : null)" aria-current="@(_area == id ? "page" : null)" data-testid="tps-area-@id" @onclick="() => OnStepAction(id)">@a.Label</button>
                }
                @* Snapshots and delivery comparison are BirkNext's own history (Azure DevOps keeps the test plan): collapsed. *@
                <details class="tps-areas-advanced" data-testid="tps-areas-advanced" open="@P.IsAdvancedArea(_area)">
                    <summary>Advanced</summary>
                    @foreach (var a in P.MoreAreas.Where(a => P.IsAdvancedArea(a.Id)))
                    {
                        var id = a.Id;
                        <button type="button" class="tps-area @(_area == id ? "is-current" : null)" aria-current="@(_area == id ? "page" : null)" data-testid="tps-area-@id" @onclick="() => OnStepAction(id)">@a.Label</button>
                    }
                </details>
            </nav>
        </div>

        <div class="tps-body" data-area="@_area" data-testid="tps-body">
            @* The active step's own heading: a step or area action scrolls here and moves focus here, so it never looks like nothing happened. *@
            <div class="tps-area-head">
                <h2 class="tps-area-heading" id="tps-area-heading" tabindex="-1" data-testid="tps-area-heading">@P.AreaLabel(_area)</h2>
                <p class="tps-area-purpose" data-testid="tps-area-purpose">@P.StepLine(_area)</p>
            </div>
            @(_area switch
            {
                "prepare" => PrepareArea(),
                "testability" => TestabilityArea(),
                "save" => SaveArea(),
                "snapshots" => SnapshotsArea(),
                "compare" => CompareArea(),
                "export" => ExportArea(),
                _ => ChooseArea(),
            })
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "guide")] public string? GuideQuery { get; set; }
    [SupplyParameterFromQuery(Name = "scenarios")] public string? ScenariosQuery { get; set; }
    [SupplyParameterFromQuery(Name = "draft")] public string? DraftQuery { get; set; }
    [SupplyParameterFromQuery(Name = "area")] public string? AreaQuery { get; set; }
    [SupplyParameterFromQuery(Name = "case")] public string? CaseQuery { get; set; }
    /// <summary>The candidate view (manual, technical, all, attention); Manual testing when absent.</summary>
    [SupplyParameterFromQuery(Name = "view")] public string? ViewQuery { get; set; }
    /// <summary>"now": run discovery once on arrival (the Discover now link after choosing another specification); removed from the address after.</summary>
    [SupplyParameterFromQuery(Name = "discover")] public string? DiscoverQuery { get; set; }
    /// <summary>"1": open this full page as the advanced tools of a plan (otherwise ordinary links go to Planlegg og klargjør).</summary>
    [SupplyParameterFromQuery(Name = "advanced")] public string? AdvancedQuery { get; set; }

    private ITestPlanSuggestionsApiService? _api;
    private ICurrentWorkspaceProjection? _projection;
    private TestPlanWorkspace? _ws;
    private TestPlanDraft? _draft;
    private bool _dirty;
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string? _message;
    private string _messageTone = "info";
    private string _area = "choose";

    // Project context (never a hardcoded system): the project the shared workspace projection names, its environment and source snapshot.
    private string? _projectKey;
    private string? _projectName;
    private string? _environmentId;
    private Guid? _snapshotId;
    /// <summary>True when the tester deliberately chose another source version than the project's (historical inspection: never the current basis).</summary>
    private bool _inspect;
    private PlanImpactAnalysis? _impact;
    private string? _resolveCase;
    private string _resolveExpected = "";
    private string _resolveRationale = "";
    private string? _resolveClaim;
    private string? _snapshotBasis;
    private List<BirkNext.SourceEvidence.ReviewSourceSnapshot> _snapshotOptions = [];
    // Historical System Understanding guide plans (?guide=…): their own candidates and workflow, unchanged.
    private string? _guideKey;
    private List<TestPlanDraftSummary> _history = [];

    // Discovery: explicit only; the last result for this project + snapshot is reused.
    private ScenarioDiscoveryResult? _discovery;
    private List<DiscoveredScenario> _candidates = [];
    /// <summary>The candidates classified once per discovery result (workspace, kind, same-operation links); views and counts read it.</summary>
    private P.Inventory _inventory = P.Inventory.Empty;
    private P.CandidateView _view = P.CandidateView.Manual;
    /// <summary>The preparation preview of a bulk selection, shown before anything is created; null when closed.</summary>
    private P.PreparePreview? _preview;
    private P.CatalogFilter _catalog = new();
    /// <summary>The tester's grouping choice; null = the default (User story when candidates have stories, else Area / module).</summary>
    private P.CatalogGrouping? _grouping;
    /// <summary>The tester's Recommended / All choice; null = the default (Recommended for a long list that it narrows).</summary>
    private bool? _recommended;
    private int _limit = P.PageSize;
    private readonly HashSet<string> _selected = new(StringComparer.Ordinal);
    // The selection survives a reload of this tab (sessionStorage, never sent anywhere): the project it was restored for and what was last kept.
    private string? _selectionKey;
    private string _keptSelection = "";
    private readonly HashSet<string> _openDetails = new(StringComparer.Ordinal);

    private readonly HashSet<string> _openCases = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _rationale = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _newStep = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _newStepExpected = new(StringComparer.Ordinal);
    // A test case just written by hand: its first-step field takes focus after the render.
    private string? _focusNewStep;
    private string _manualTitle = "";
    private bool _needsActionOnly;
    private string _planName = "";
    private string _deliveryLabel = "";
    private string _snapshotNote = "";
    private TestPlanSnapshot? _openSnapshot;
    private Guid? _compareFrom;
    private Guid? _compareTo;
    private DeliveryComparison? _comparison;
    private Guid? _exportSnapshot;
    private TestPlanExport? _export;
    private string _newSuite = "";
    // MT-7: scenario → specification requirement associations of the active project (Relationship Review decides them; read-only here).
    private RequirementCoverageView? _coverage;
    private string? _coverageNote;
    // Manual requirement links: the project's current specification requirements (the same parser and evidence Test Coverage reads).
    private List<ProjectRequirementOption>? _requirements;
    private string? _requirementsNote;
    /// <summary>The Specification role as the explorers resolve it: tells "none chosen" (choose it above) from "none in the project" (not in source).</summary>
    private BirkNext.Web.Services.Explorers.ArtifactExplorerState? _specificationState;
    private readonly Dictionary<string, string> _requirementQuery = new(StringComparer.Ordinal);

    private bool CanWrite => _ws?.CanWrite == true;
    private bool GuideMode => _guideKey is not null;

    private IDisposable? _unsaved;

    protected override async Task OnInitializedAsync()
    {
        // One primary workflow (2026-11-23): an ordinary link (bookmarks, Test Coverage / Traceability drill-downs) opens Planlegg og klargjør.
        // The navigation happens after the first render: navigating while the router is still initialising this page left the address on the old link.
        if (BirkNext.Web.Services.ManualTestingPresentation.CanonicalRoute(GuideQuery, DraftQuery, AreaQuery, CaseQuery, AdvancedQuery, ScenariosQuery, ViewQuery) is { } canonical)
        {
            _redirectTo = canonical;
            _loading = false;
            return;
        }
        // A project switch asks before discarding unsaved plan changes (the same protection as leaving the page).
        _unsaved = (ServiceProvider.GetService(typeof(BirkNext.Web.Services.ProjectImport.UnsavedWorkGuard)) as BirkNext.Web.Services.ProjectImport.UnsavedWorkGuard)?.Register(() => _dirty && _draft is not null ? "This plan has unsaved changes." : null);
        _api = ServiceProvider.GetService(typeof(ITestPlanSuggestionsApiService)) as ITestPlanSuggestionsApiService;
        if (_api is null) { _loading = false; return; }
        _area = P.AreaOrDefault(AreaQuery);
        _view = P.ViewOrDefault(ViewQuery);
        // Drill-down from Test Coverage / Requirements Traceability: open that saved case (it is only shown when it belongs to the loaded draft).
        if (!string.IsNullOrWhiteSpace(CaseQuery)) _openCases.Add(CaseQuery);
        _projection = ServiceProvider.GetService(typeof(ICurrentWorkspaceProjection)) as ICurrentWorkspaceProjection;
        if (_projection is not null) _projection.Changed += OnProjectChanged;
        await LoadAsync();
        _loading = false;
        if (string.Equals(DiscoverQuery, "now", StringComparison.OrdinalIgnoreCase) && !GuideMode && _projectKey is not null)
        {
            // Asked for explicitly (Discover now); a reload of the page must not run it again.
            Nav.NavigateTo(Nav.GetUriWithQueryParameter("discover", (string?)null), replace: true);
            _area = "choose";
            await DiscoverAsync();
        }
    }

    public void Dispose() { _unsaved?.Dispose(); if (_projection is not null) _projection.Changed -= OnProjectChanged; }

    /// <summary>Another project was selected: everything project-specific is dropped (selection, discovery, plan) and read again for it.</summary>
    private void OnProjectChanged() => _ = InvokeAsync(async () =>
    {
        var before = _projectKey;
        await ResolveProjectAsync();
        if (string.Equals(before, _projectKey, StringComparison.Ordinal) || GuideMode) return;
        _selected.Clear(); _openDetails.Clear(); _draft = null; _dirty = false; _discovery = null; SetCandidates([]); _preview = null; _comparison = null; _export = null; _openSnapshot = null;
        await LoadProjectAsync();
        StateHasChanged();
    });

    private async Task LoadAsync()
    {
        if (!string.IsNullOrWhiteSpace(GuideQuery)) { _guideKey = GuideQuery.Trim(); await LoadGuideAsync(); }
        else
        {
            await ResolveProjectAsync();
            if (_projectKey is null)
            {
                // A link to a historical guide plan without ?guide= still opens it, in guide mode.
                if (Guid.TryParse(DraftQuery, out var id) && (await _api!.DraftAsync(id)).Draft is { ProjectKey: null } legacy) { _guideKey = legacy.GuideKey; await LoadGuideAsync(); }
                else _history = (await _api!.SummaryAsync(null)).Workspace?.Drafts ?? [];
            }
            else await LoadProjectAsync();
        }
        await LoadCoverageAsync();
    }

    /// <summary>The selected project from the shared workspace projection, its active environment and the project's own source snapshot.</summary>
    private async Task ResolveProjectAsync()
    {
        if (_projection is not null)
        {
            try
            {
                var w = await _projection.GetAsync();
                _projectKey = string.IsNullOrWhiteSpace(w.ProjectSlug) ? null : w.ProjectSlug;
                _projectName = w.ProjectName ?? w.ProjectSlug;
            }
            catch (InvalidOperationException) { _projectKey = null; }
        }
        if (ServiceProvider.GetService(typeof(IFrontendAnalysisContextFactory)) is IFrontendAnalysisContextFactory contexts)
            try { _environmentId = (await contexts.GetActiveContextAsync()).ActiveProfileOrNull?.Id; } catch (InvalidOperationException) { _environmentId = null; }
        (_snapshotId, _snapshotBasis) = ResolveSnapshot();
    }

    /// <summary>The project's snapshot: the imported package of the current workspace scope, else the project evidence's main package. Never the
    /// newest snapshot of some other repository.</summary>
    private (Guid? Id, string? Basis) ResolveSnapshot() => ManualTestingWorkspace.ResolveSnapshot(ServiceProvider);

    private async Task LoadProjectAsync()
    {
        var (ws, error) = await _api!.ProjectAsync(_projectKey!, _environmentId);
        _ws = ws; _error = error;
        await LoadRequirementsAsync();
        if (ServiceProvider.GetService(typeof(ITestCoverageApiService)) is ITestCoverageApiService sources)
            _snapshotOptions = (await sources.SourcesAsync()).Options?.Snapshots ?? [];
        var (last, _) = await _api.LastDiscoveryAsync(_projectKey!, _snapshotId);
        UseDiscovery(last);
        await RestoreSelectionAsync();
        if (Guid.TryParse(DraftQuery, out var draftId)) await OpenDraftAsync(draftId);
        else if (_ws?.Drafts.FirstOrDefault() is { } latest) await OpenDraftAsync(latest.Id);
        _planName = _draft?.PlanName ?? "";
        _deliveryLabel = _draft?.DeliveryLabel ?? "";
    }

    private async Task LoadGuideAsync()
    {
        var (ws, error) = await _api!.WorkspaceAsync(_guideKey);
        _ws = ws; _error = error;
        _guideKey = ws?.GuideKey ?? _guideKey;
        SetCandidates([.. (ws?.Candidates ?? []).Select(P.FromGuideCandidate)]);
        foreach (var id in P.ParseScenarios(ScenariosQuery).Where(id => _candidates.Any(c => c.CandidateId == id))) _selected.Add(id);
        if (_selected.Count > 0)
        {
            _area = "choose";
            Info($"{_selected.Count} scenario{(_selected.Count == 1 ? "" : "s")} selected from What to test. Nothing is approved by selecting: review the test cases before use.");
        }
        if (Guid.TryParse(DraftQuery, out var draftId)) await OpenDraftAsync(draftId);
        else if (ws?.Drafts.FirstOrDefault() is { } latest && _selected.Count == 0) await OpenDraftAsync(latest.Id);
        _planName = _draft?.PlanName ?? "";
        _deliveryLabel = _draft?.DeliveryLabel ?? "";
    }

    private async Task ReloadWorkspaceAsync()
    {
        if (GuideMode) { var (ws, _) = await _api!.WorkspaceAsync(_guideKey); if (ws is not null) _ws = ws; }
        else if (_projectKey is not null) { var (ws, _) = await _api!.ProjectAsync(_projectKey, _environmentId); if (ws is not null) _ws = ws; }
    }

    private void UseDiscovery(ScenarioDiscoveryResult? result)
    {
        if (result is not null && result.ProjectKey != _projectKey) result = null; // never another project's result
        _discovery = result;
        SetCandidates(result?.Candidates ?? []);
        // Rediscovery keeps a selection only for candidate ids that still exist (ids are stable per project and source identity).
        var ids = _candidates.Select(c => c.CandidateId).ToHashSet(StringComparer.Ordinal);
        _selected.RemoveWhere(id => !ids.Contains(id));
        _preview = null;
    }

    /// <summary>A reload keeps the scenarios this tab had selected (only those the current discovery still has; nothing is prepared or approved by it).</summary>
    private async Task RestoreSelectionAsync()
    {
        _selectionKey = null;
        if (_projectKey is null) return;
        var kept = await TabDraftStore.ReadAsync<string[]>(JS, TabDraftStore.SelectionKey(_projectKey)) ?? [];
        var ids = _candidates.Select(c => c.CandidateId).ToHashSet(StringComparer.Ordinal);
        var restored = 0;
        foreach (var id in kept.Where(ids.Contains)) if (_selected.Add(id)) restored++;
        _selectionKey = _projectKey;
        _keptSelection = SelectionSignature();
        if (restored > 0)
            Info($"{restored} selected scenario{(restored == 1 ? " was" : "s were")} kept from before the page was reloaded. Nothing is prepared until you choose Prepare.");
    }

    private string SelectionSignature() => string.Join("|", _selected.Order(StringComparer.Ordinal));

    private async Task KeepSelectionAsync()
    {
        if (GuideMode || _selectionKey is null || _selectionKey != _projectKey) return;
        var signature = SelectionSignature();
        if (signature == _keptSelection) return;
        _keptSelection = signature;
        if (_selected.Count == 0) await TabDraftStore.RemoveAsync(JS, TabDraftStore.SelectionKey(_selectionKey));
        else await TabDraftStore.WriteAsync(JS, TabDraftStore.SelectionKey(_selectionKey), _selected.Order(StringComparer.Ordinal).ToArray());
    }

    private void SetCandidates(List<DiscoveredScenario> candidates)
    {
        _candidates = candidates;
        _inventory = P.Classify(candidates);
    }

    /// <summary>Switching views keeps the selection and the filters; the view is part of the address so a link or reload opens it again.</summary>
    private void SetView(P.CandidateView view)
    {
        _view = view;
        _limit = P.PageSize;
        _preview = null;
        Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?> { ["view"] = view == P.CandidateView.Manual ? null : P.ViewId(view) }), replace: true);
    }

    private async Task LoadCoverageAsync()
    {
        if (_environmentId is null && ServiceProvider.GetService(typeof(IFrontendAnalysisContextFactory)) is IFrontendAnalysisContextFactory contexts)
            try { _environmentId = (await contexts.GetActiveContextAsync()).ActiveProfileOrNull?.Id; } catch (InvalidOperationException) { }
        if (string.IsNullOrWhiteSpace(_environmentId)) { _coverageNote = "Unknown: no project (Target Environment) is selected, so no requirement association can be read."; return; }
        var (coverage, error) = await _api!.RequirementCoverageAsync(_environmentId, rows: false);
        _coverage = coverage;
        _coverageNote = coverage is null ? error : coverage.Known ? null : $"Unknown: {coverage.UnknownReason}";
    }

    private async Task OpenDraftAsync(Guid id)
    {
        var (draft, error) = await _api!.DraftAsync(id);
        if (draft is null) { Fail(error ?? "The plan could not be opened."); return; }
        // Project isolation: a plan of another project is never opened here.
        if (!GuideMode && draft.ProjectKey != _projectKey) { Fail("That plan belongs to another project and is not shown here."); return; }
        if (GuideMode && draft.ProjectKey is not null) { Fail("That plan belongs to a project; open the project to see it."); return; }
        _draft = draft;
        _dirty = false;
        _planName = draft.PlanName;
        _deliveryLabel = draft.DeliveryLabel ?? "";
    }

    private void GoArea(string id)
    {
        _area = P.AreaOrDefault(id);
        _message = null;
        Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?> { ["area"] = _area, ["draft"] = _draft?.Id.ToString(), ["scenarios"] = null }), replace: true);
    }

    // A step or area action always shows where it went: the area is activated (also when it already was — "Open now" on the current step), and
    // after rendering the area's heading is scrolled into view and focused. Re-opening a completed step works the same way.
    private bool _revealArea;

    private Task OnStepAction(string id) { GoArea(id); _revealArea = true; return Task.CompletedTask; }

    /// <summary>The canonical page an ordinary link is sent to (null = this page is used as the advanced tools).</summary>
    private string? _redirectTo;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_redirectTo is { } target)
        {
            _redirectTo = null;
            (ServiceProvider.GetService(typeof(NavigationManager)) as NavigationManager)?.NavigateTo(target, replace: true);
            return;
        }
        await KeepSelectionAsync();
        if (_focusNewStep is { } focus)
        {
            _focusNewStep = null;
            _revealArea = false; // the new case's first step is where the tester continues
            try { await JS.InvokeVoidAsync("birknextRevealSection", $"tps-step-new-{focus}"); }
            catch (JSException) { }
            catch (InvalidOperationException) { }
            return;
        }
        if (_revealPreview)
        {
            // The preparation preview takes focus so keyboard and screen-reader users land on it.
            _revealPreview = false;
            try { await JS.InvokeVoidAsync("birknextRevealSection", "tps-preview"); }
            catch (JSException) { }
            catch (InvalidOperationException) { }
        }
        if (!_revealArea) return;
        _revealArea = false;
        try { await JS.InvokeVoidAsync("birknextRevealSection", "tps-area-heading"); }
        catch (JSException) { }
        catch (InvalidOperationException) { } // prerendering / no JS runtime
    }

    private void Info(string text) { _message = text; _messageTone = "info"; }
    private void Ok(string text) { _message = text; _messageTone = "ok"; }
    private void Fail(string text) { _message = text; _messageTone = "warn"; }

    private void Change(TestPlanDraft draft)
    {
        // Which cases this unsaved change touches (a case's content state says "Unsaved changes" only for those).
        if (!_dirty) _dirtyCases.Clear();
        var before = _draft?.Cases.ToDictionary(c => c.Source.ScenarioId, StringComparer.Ordinal) ?? [];
        foreach (var c in draft.Cases) if (!before.TryGetValue(c.Source.ScenarioId, out var old) || !ReferenceEquals(old, c)) _dirtyCases.Add(c.Source.ScenarioId);
        _draft = draft; _dirty = true; _edits++;
    }

    // ── Version history ──────────────────────────────────────────────────────────────────────────────────────────────

    private bool _historyOpen;
    private List<TestPlanRevisionSummary>? _revisions;
    private string? _historyError;
    private TestPlanDraft? _viewed;

    private async Task ToggleHistoryAsync()
    {
        _historyOpen = !_historyOpen;
        _viewed = null;
        if (_historyOpen) await LoadRevisionsAsync();
    }

    private async Task LoadRevisionsAsync()
    {
        if (_draft is null || _api is null) return;
        _revisions = null; _historyError = null;
        var (list, error) = await _api.RevisionsAsync(_draft.Id);
        (_revisions, _historyError) = (list, list is null ? error ?? "The version history could not be read." : null);
    }

    private async Task ViewRevisionAsync(int revision)
    {
        if (_viewed?.Revision == revision) { _viewed = null; return; }
        if (_draft is null || _api is null) return;
        var (draft, error) = await _api.RevisionAsync(_draft.Id, revision);
        if (draft is null) { Fail(error ?? "That version could not be read."); return; }
        _viewed = draft;
    }

    private async Task RestoreRevisionAsync(int revision)
    {
        if (_draft is not { } current || _api is null || _dirty) return;
        var next = current.Revision + 1;
        if (!await JS.InvokeAsync<bool>("confirm", $"Restore version {revision}? It is saved as version {next}; the current version {current.Revision} stays in the history. Test cases added after version {revision} leave the plan.")) return;
        _busy = true;
        try
        {
            var (restored, error) = await _api.RestoreRevisionAsync(current.Id, current.Revision, revision);
            if (restored is null) { Fail(error ?? "The version could not be restored."); return; }
            _draft = restored; _dirty = false; _planName = restored.PlanName; _deliveryLabel = restored.DeliveryLabel ?? ""; _viewed = null;
            Ok($"Version {revision} restored as version {restored.Revision}.");
            await LoadRevisionsAsync();
        }
        finally { _busy = false; }
    }

    /// <summary>Counts local edits, so a save that completes after a newer edit never marks that edit as saved.</summary>
    private int _edits;

    /// <summary>Leaving with unsaved edits asks first. Switching areas of the same plan keeps the edits and does not ask.</summary>
    private async Task ConfirmLeaveAsync(Microsoft.AspNetCore.Components.Routing.LocationChangingContext context)
    {
        if (!_dirty || _draft is null) return;
        var target = Nav.ToAbsoluteUri(context.TargetLocation);
        var current = Nav.ToAbsoluteUri(Nav.Uri);
        var draftParameter = System.Text.RegularExpressions.Regex.Match(target.Query, @"[?&]draft=([^&]+)");
        var samePlan = string.Equals(target.AbsolutePath, current.AbsolutePath, StringComparison.OrdinalIgnoreCase)
            && (!draftParameter.Success || string.Equals(Uri.UnescapeDataString(draftParameter.Groups[1].Value), _draft.Id.ToString(), StringComparison.OrdinalIgnoreCase));
        if (samePlan) return;
        bool leave;
        try { leave = await JS.InvokeAsync<bool>("confirm", "This plan has unsaved changes. Leave without saving them?"); }
        catch (JSException) { leave = false; }
        if (!leave) context.PreventNavigation();
    }

