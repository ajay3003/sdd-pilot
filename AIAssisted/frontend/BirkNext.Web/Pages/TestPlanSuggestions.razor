    private void ChangeStoryText(string storyKey, string language, Func<StoryTranslation, StoryTranslation> change)
    {
        if (_draft is null) return;
        var all = (_draft.StoryTranslations ?? []).ToList();
        var held = all.FirstOrDefault(t => t.StoryKey == storyKey && t.Language == language) ?? new StoryTranslation { StoryKey = storyKey, Language = language };
        all.RemoveAll(t => t.StoryKey == storyKey && t.Language == language);
        all.Add(change(held));
        Change(_draft with { StoryTranslations = all });
    }

    // ── Requirements of a user story: named (A), tasks.md (B), suggested (C/D), confirmed for the story, and the cases' links (read-only) ──

    private sealed record StoryRequirementItem(string RequirementId, string SpecificationPath, string Title, RequirementSuggestionLevel Level, string Reason);

    private List<StoryRequirementItem> StoryCandidates(BirkNext.TestCoverage.CoverageUserStory story, TestPlanDraft d)
    {
        var options = _requirements ?? [];
        var confirmed = (d.StoryRequirementLinks ?? []).Where(l => l.StoryKey == story.Key).Select(l => L.Key(l.Link.RequirementId, l.Link.SpecificationPath)).ToHashSet();
        var rejected = (d.StoryRejectedSuggestions ?? []).Where(r => r.StoryKey == story.Key).Select(r => L.Key(r.Rejection.RequirementId, r.Rejection.SpecificationPath)).ToHashSet();
        var path = story.SpecificationPath ?? "";
        ProjectRequirementOption? Option(string id) => options.FirstOrDefault(o => string.Equals(o.RequirementId, id, StringComparison.OrdinalIgnoreCase) && L.Key(o.RequirementId, o.SpecificationPath) == L.Key(id, path))
            ?? options.FirstOrDefault(o => string.Equals(o.RequirementId, id, StringComparison.OrdinalIgnoreCase));
        var items = new List<StoryRequirementItem>();
        foreach (var id in story.NamedRequirements)
            if (Option(id) is { } o) items.Add(new(o.RequirementId, o.SpecificationPath, o.Title, RequirementSuggestionLevel.Explicit, $"The story's text names {o.RequirementId}."));
        foreach (var t in story.TaskRequirements.GroupBy(t => t.RequirementId, StringComparer.OrdinalIgnoreCase))
            if (Option(t.Key) is { } o && items.All(i => !string.Equals(i.RequirementId, o.RequirementId, StringComparison.OrdinalIgnoreCase)))
                items.Add(new(o.RequirementId, o.SpecificationPath, o.Title, RequirementSuggestionLevel.Structural,
                    string.Join("; ", t.Take(3).Select(x => $"{x.TasksPath[(x.TasksPath.LastIndexOf('/') + 1)..]}: {(x.TaskId is { } task ? task + " " : "")}{(x.Line is { } line ? $"(line {line})" : "")}"))
                    + $" — {t.First().TaskText}"));
        var taken = items.Select(i => L.Key(i.RequirementId, i.SpecificationPath)).ToHashSet();
        var text = string.Join("\n", new[] { story.Title, story.Description, story.WhyThisPriority, story.IndependentTest }.Where(x => x is not null));
        foreach (var s in ScenarioPlanning.SuggestRequirements(text, [], [], options, taken.Concat(confirmed).Concat(rejected)))
            items.Add(new(s.RequirementId, s.SpecificationPath, s.Title, s.Level, s.Reason));
        return [.. items.Where(i => !confirmed.Contains(L.Key(i.RequirementId, i.SpecificationPath)) && !rejected.Contains(L.Key(i.RequirementId, i.SpecificationPath)))];
    }

    private void ConfirmForStory(string storyKey, StoryRequirementItem item)
    {
        if (_draft is null) return;
        Change(_draft with
        {
            StoryRequirementLinks = [.. _draft.StoryRequirementLinks ?? [], new StoryRequirementLink(storyKey, new ManualRequirementLink
            {
                RequirementId = item.RequirementId, SpecificationPath = item.SpecificationPath, Title = item.Title, SuggestionLevel = item.Level, SuggestionReason = item.Reason,
            })],
        });
    }

    private void RejectForStory(string storyKey, StoryRequirementItem item)
    {
        if (_draft is null) return;
        Change(_draft with
        {
            StoryRejectedSuggestions = [.. _draft.StoryRejectedSuggestions ?? [], new StoryRequirementRejection(storyKey, new RejectedRequirementSuggestion { RequirementId = item.RequirementId, SpecificationPath = item.SpecificationPath })],
        });
    }

    private void UnlinkFromStory(string storyKey, ManualRequirementLink link)
    {
        if (_draft is null) return;
        Change(_draft with { StoryRequirementLinks = [.. (_draft.StoryRequirementLinks ?? []).Where(l => !(l.StoryKey == storyKey && L.Key(l.Link.RequirementId, l.Link.SpecificationPath) == L.Key(link.RequirementId, link.SpecificationPath)))] });
    }

    /// <summary>The story card's two tabs: the story (description, why, Independent Test — translated when the story is shown in another language,
