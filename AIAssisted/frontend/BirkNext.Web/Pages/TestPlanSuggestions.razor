    private string? StoryLanguage(C.StoryGroup sg) => sg.Scenarios.Select(g => _shownLanguage.GetValueOrDefault(g.Key)).FirstOrDefault(l => l is not null);

    /// <summary>The whole plan's language (all scenarios shown in one language), or null when mixed / original.</summary>
