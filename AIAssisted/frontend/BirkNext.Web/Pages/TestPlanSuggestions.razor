@page "/test-plan-suggestions"
@using BirkNext.TestPlanning
@using BirkNext.Web.Services
@using P = BirkNext.Web.Services.TestPlanSuggestionsPresentation
@using L = BirkNext.Web.Services.RequirementLinkPresentation
@implements IDisposable
@inject IServiceProvider ServiceProvider
@inject NavigationManager Nav
@inject IJSRuntime JS

@* Test Plan Suggestions: prepares reviewable test cases for the SELECTED PROJECT from the evidence its registered analyzers can read (specification,
   System Understanding guide when one describes the project's source, UI source, API contracts, integration journeys, existing tests). Candidates are
   guidance — not Test Cases, not coverage, never executed — and nothing is written to Azure DevOps. Imported text is shown as text only (never as
   markup); nothing here runs an imported step. Historical System Understanding guide plans keep loading (?guide=…). *@
<PageTitle>Plan & prepare — Manual Testing</PageTitle>

<div class="tps" data-testid="tps" aria-busy="@(_loading ? "true" : "false")">
    @* Unsaved plan edits are never discarded silently (audit 2026-11-15): leaving the page or opening another plan asks first. *@
    <NavigationLock ConfirmExternalNavigation="@_dirty" OnBeforeInternalNavigation="ConfirmLeaveAsync" />
    @* Plan & prepare of the Manual Testing workspace IS Test Plan Suggestions: one planning page, same route and links as before. *@
    <BirkNext.Web.Components.TestingWorkspaceHeader Workspace="Manual Testing" HomeRoute="@ManualTestingPresentation.HomeRoute" Stages="ManualTestingPresentation.Stages"
        Current="plan" Title="Plan & prepare" ShowProject="@(!_loading && _projectKey is null && !GuideMode)"
        Lead="Choose what to test from the project's evidence, prepare readable test cases and save a plan. Candidates are proposals — not test cases, not executed tests.">
        <Help><BirkNext.Web.Components.HelpLink Topic="test-plan-suggestions" Text="What this page is" /></Help>
    </BirkNext.Web.Components.TestingWorkspaceHeader>

    @if (_loading)
    {
        <p class="tps-muted" data-testid="tps-loading">Loading the project's test plans…</p>
    }
    else if (_api is null || _error is not null && _ws is null && _projectKey is not null)
    {
        <section class="tps-empty" data-testid="tps-error"><h2>Test Plan Suggestions is not available</h2><p>@(_error ?? "Test Plan Suggestions is not available in this host.")</p></section>
    }
    else if (_guideKey is null && _projectKey is null)
    {
        <section class="tps-empty" data-testid="tps-no-project">
            <h2>Choose a project first</h2>
            <p>Test scenarios are discovered from one project's evidence. Open or import a project, then come back here.</p>
            <a class="tps-btn" href="project-import">Import a project</a>
            @if (_history.Count > 0)
            {
                <details class="tps-block" data-testid="tps-historical-plans"><summary>Earlier plans prepared from a System Understanding guide (@_history.Count)</summary>
                    <ul class="tps-plain">@foreach (var d in _history) { <li><a href="@($"{P.Route}?guide={Uri.EscapeDataString(d.GuideKey)}&draft={d.Id}")">@d.PlanName</a> <span class="tps-muted tps-small">revision @d.Revision · @d.Cases cases</span></li> }</ul>
                </details>
            }
        </section>
    }
    else
    {
        @ContextCard()
        @if (_message is not null)
        {
            <p class="tps-note tps-note-@_messageTone" role="status" data-testid="tps-message">@_message</p>
        }
        @if (_ws is { CanWrite: false })
        {
            <p class="tps-note tps-note-info" data-testid="tps-read-only">You can read plans. Preparing, reviewing and saving snapshots needs the configuration-write permission.</p>
        }

        @* Compact stepper (2026-11-18): one row of four numbered steps with their stored status, replacing four large descriptive cards. Every step
           opens (a step that cannot be worked on yet explains why in its own area); the purpose of the open step is one line under its heading. *@
        <div class="tps-nav">
            <nav class="tps-stepper-nav" aria-label="Test preparation steps">
                <ol class="tps-stepper" data-testid="tps-steps">
                    @{ var stepNo = 0; }
                    @foreach (var step in Steps)
                    {
                        stepNo++;
                        var id = step.Id;
                        var current = _area == id;
                        <li class="tps-step @(current ? "is-current" : null)" data-testid="tps-step" data-state="@step.State" data-step="@id">
                            <button type="button" class="tps-step-btn" aria-current="@(current ? "step" : null)" aria-describedby="tps-step-status-@id" data-testid="tps-area-@id"
                                    disabled="@_busy" @onclick="() => OnStepAction(id)">
                                <span class="tps-step-no" aria-hidden="true">@(step.State == GuidedStepState.Done ? "✓" : stepNo.ToString())</span>
                                <span class="tps-step-label">@step.Title</span>
                            </button>
                            <span class="tps-step-status" id="tps-step-status-@id" data-testid="tps-step-status">@(step.DisabledReason ?? step.StatusLabel)</span>
                        </li>
                    }
                </ol>
            </nav>
            <nav class="tps-areas" aria-label="Plan history and export">
                @foreach (var a in P.MoreAreas.Where(a => !P.IsAdvancedArea(a.Id)))
                {
                    var id = a.Id;
                    <button type="button" class="tps-area @(_area == id ? "is-current" : null)" aria-current="@(_area == id ? "page" : null)" data-testid="tps-area-@id" @onclick="() => OnStepAction(id)">@a.Label</button>
                }
                @* Snapshots and delivery comparison are BirkNext's own history (Azure DevOps keeps the test plan): collapsed. *@
                <details class="tps-areas-advanced" data-testid="tps-areas-advanced" open="@P.IsAdvancedArea(_area)">
                    <summary>Advanced</summary>
                    @foreach (var a in P.MoreAreas.Where(a => P.IsAdvancedArea(a.Id)))
                    {
                        var id = a.Id;
                        <button type="button" class="tps-area @(_area == id ? "is-current" : null)" aria-current="@(_area == id ? "page" : null)" data-testid="tps-area-@id" @onclick="() => OnStepAction(id)">@a.Label</button>
                    }
                </details>
            </nav>
        </div>

        <div class="tps-body" data-area="@_area" data-testid="tps-body">
            @* The active step's own heading: a step or area action scrolls here and moves focus here, so it never looks like nothing happened. *@
            <div class="tps-area-head">
                <h2 class="tps-area-heading" id="tps-area-heading" tabindex="-1" data-testid="tps-area-heading">@P.AreaLabel(_area)</h2>
                <p class="tps-area-purpose" data-testid="tps-area-purpose">@P.StepLine(_area)</p>
            </div>
            @(_area switch
            {
                "prepare" => PrepareArea(),
                "testability" => TestabilityArea(),
                "save" => SaveArea(),
                "snapshots" => SnapshotsArea(),
                "compare" => CompareArea(),
                "export" => ExportArea(),
                _ => ChooseArea(),
            })
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "guide")] public string? GuideQuery { get; set; }
    [SupplyParameterFromQuery(Name = "scenarios")] public string? ScenariosQuery { get; set; }
    [SupplyParameterFromQuery(Name = "draft")] public string? DraftQuery { get; set; }
    [SupplyParameterFromQuery(Name = "area")] public string? AreaQuery { get; set; }
    [SupplyParameterFromQuery(Name = "case")] public string? CaseQuery { get; set; }
    /// <summary>The candidate view (manual, technical, all, attention); Manual testing when absent.</summary>
    [SupplyParameterFromQuery(Name = "view")] public string? ViewQuery { get; set; }
    /// <summary>"now": run discovery once on arrival (the Discover now link after choosing another specification); removed from the address after.</summary>
    [SupplyParameterFromQuery(Name = "discover")] public string? DiscoverQuery { get; set; }

    private ITestPlanSuggestionsApiService? _api;
    private ICurrentWorkspaceProjection? _projection;
    private TestPlanWorkspace? _ws;
    private TestPlanDraft? _draft;
    private bool _dirty;
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string? _message;
    private string _messageTone = "info";
    private string _area = "choose";

    // Project context (never a hardcoded system): the project the shared workspace projection names, its environment and source snapshot.
    private string? _projectKey;
    private string? _projectName;
    private string? _environmentId;
    private Guid? _snapshotId;
    private string? _snapshotBasis;
    private List<BirkNext.SourceEvidence.ReviewSourceSnapshot> _snapshotOptions = [];
    // Historical System Understanding guide plans (?guide=…): their own candidates and workflow, unchanged.
    private string? _guideKey;
    private List<TestPlanDraftSummary> _history = [];

    // Discovery: explicit only; the last result for this project + snapshot is reused.
    private ScenarioDiscoveryResult? _discovery;
    private List<DiscoveredScenario> _candidates = [];
    /// <summary>The candidates classified once per discovery result (workspace, kind, same-operation links); views and counts read it.</summary>
    private P.Inventory _inventory = P.Inventory.Empty;
    private P.CandidateView _view = P.CandidateView.Manual;
    /// <summary>The preparation preview of a bulk selection, shown before anything is created; null when closed.</summary>
    private P.PreparePreview? _preview;
    private P.CatalogFilter _catalog = new();
    private P.CatalogGrouping _grouping = P.CatalogGrouping.Area;
    private int _limit = P.PageSize;
    private readonly HashSet<string> _selected = new(StringComparer.Ordinal);
    // The selection survives a reload of this tab (sessionStorage, never sent anywhere): the project it was restored for and what was last kept.
    private string? _selectionKey;
    private string _keptSelection = "";
    private readonly HashSet<string> _openDetails = new(StringComparer.Ordinal);

    private readonly HashSet<string> _openCases = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _rationale = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _newStep = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _newStepExpected = new(StringComparer.Ordinal);
    // A test case just written by hand: its first-step field takes focus after the render.
    private string? _focusNewStep;
    private string _manualTitle = "";
    private bool _needsActionOnly;
    private string _planName = "";
    private string _deliveryLabel = "";
    private string _snapshotNote = "";
    private TestPlanSnapshot? _openSnapshot;
    private Guid? _compareFrom;
    private Guid? _compareTo;
    private DeliveryComparison? _comparison;
    private Guid? _exportSnapshot;
    private TestPlanExport? _export;
    private string _newSuite = "";
    // MT-7: scenario → specification requirement associations of the active project (Relationship Review decides them; read-only here).
    private RequirementCoverageView? _coverage;
    private string? _coverageNote;
    // Manual requirement links: the project's current specification requirements (the same parser and evidence Test Coverage reads).
    private List<ProjectRequirementOption>? _requirements;
    private string? _requirementsNote;
    private readonly Dictionary<string, string> _requirementQuery = new(StringComparer.Ordinal);

    private bool CanWrite => _ws?.CanWrite == true;
    private bool GuideMode => _guideKey is not null;

    private IDisposable? _unsaved;

    protected override async Task OnInitializedAsync()
    {
        // A project switch asks before discarding unsaved plan changes (the same protection as leaving the page).
        _unsaved = (ServiceProvider.GetService(typeof(BirkNext.Web.Services.ProjectImport.UnsavedWorkGuard)) as BirkNext.Web.Services.ProjectImport.UnsavedWorkGuard)?.Register(() => _dirty && _draft is not null ? "This plan has unsaved changes." : null);
        _api = ServiceProvider.GetService(typeof(ITestPlanSuggestionsApiService)) as ITestPlanSuggestionsApiService;
        if (_api is null) { _loading = false; return; }
        _area = P.AreaOrDefault(AreaQuery);
        _view = P.ViewOrDefault(ViewQuery);
        // Drill-down from Test Coverage / Requirements Traceability: open that saved case (it is only shown when it belongs to the loaded draft).
        if (!string.IsNullOrWhiteSpace(CaseQuery)) _openCases.Add(CaseQuery);
        _projection = ServiceProvider.GetService(typeof(ICurrentWorkspaceProjection)) as ICurrentWorkspaceProjection;
        if (_projection is not null) _projection.Changed += OnProjectChanged;
        await LoadAsync();
        _loading = false;
        if (string.Equals(DiscoverQuery, "now", StringComparison.OrdinalIgnoreCase) && !GuideMode && _projectKey is not null)
        {
            // Asked for explicitly (Discover now); a reload of the page must not run it again.
            Nav.NavigateTo(Nav.GetUriWithQueryParameter("discover", (string?)null), replace: true);
            _area = "choose";
            await DiscoverAsync();
        }
    }

    public void Dispose() { _unsaved?.Dispose(); if (_projection is not null) _projection.Changed -= OnProjectChanged; }

    /// <summary>Another project was selected: everything project-specific is dropped (selection, discovery, plan) and read again for it.</summary>
    private void OnProjectChanged() => _ = InvokeAsync(async () =>
    {
        var before = _projectKey;
        await ResolveProjectAsync();
        if (string.Equals(before, _projectKey, StringComparison.Ordinal) || GuideMode) return;
        _selected.Clear(); _openDetails.Clear(); _draft = null; _dirty = false; _discovery = null; SetCandidates([]); _preview = null; _comparison = null; _export = null; _openSnapshot = null;
        await LoadProjectAsync();
        StateHasChanged();
    });

    private async Task LoadAsync()
    {
        if (!string.IsNullOrWhiteSpace(GuideQuery)) { _guideKey = GuideQuery.Trim(); await LoadGuideAsync(); }
        else
        {
            await ResolveProjectAsync();
            if (_projectKey is null)
            {
                // A link to a historical guide plan without ?guide= still opens it, in guide mode.
                if (Guid.TryParse(DraftQuery, out var id) && (await _api!.DraftAsync(id)).Draft is { ProjectKey: null } legacy) { _guideKey = legacy.GuideKey; await LoadGuideAsync(); }
                else _history = (await _api!.SummaryAsync(null)).Workspace?.Drafts ?? [];
            }
            else await LoadProjectAsync();
        }
        await LoadCoverageAsync();
    }

    /// <summary>The selected project from the shared workspace projection, its active environment and the project's own source snapshot.</summary>
    private async Task ResolveProjectAsync()
    {
        if (_projection is not null)
        {
            try
            {
                var w = await _projection.GetAsync();
                _projectKey = string.IsNullOrWhiteSpace(w.ProjectSlug) ? null : w.ProjectSlug;
                _projectName = w.ProjectName ?? w.ProjectSlug;
            }
            catch (InvalidOperationException) { _projectKey = null; }
        }
        if (ServiceProvider.GetService(typeof(IFrontendAnalysisContextFactory)) is IFrontendAnalysisContextFactory contexts)
            try { _environmentId = (await contexts.GetActiveContextAsync()).ActiveProfileOrNull?.Id; } catch (InvalidOperationException) { _environmentId = null; }
        (_snapshotId, _snapshotBasis) = ResolveSnapshot();
    }

    /// <summary>The project's snapshot: the imported package of the current workspace scope, else the project evidence's main package. Never the
    /// newest snapshot of some other repository.</summary>
    private (Guid? Id, string? Basis) ResolveSnapshot() => ManualTestingWorkspace.ResolveSnapshot(ServiceProvider);

    private async Task LoadProjectAsync()
    {
        var (ws, error) = await _api!.ProjectAsync(_projectKey!, _environmentId);
        _ws = ws; _error = error;
        await LoadRequirementsAsync();
        if (ServiceProvider.GetService(typeof(ITestCoverageApiService)) is ITestCoverageApiService sources)
            _snapshotOptions = (await sources.SourcesAsync()).Options?.Snapshots ?? [];
        var (last, _) = await _api.LastDiscoveryAsync(_projectKey!, _snapshotId);
        UseDiscovery(last);
        await RestoreSelectionAsync();
        if (Guid.TryParse(DraftQuery, out var draftId)) await OpenDraftAsync(draftId);
        else if (_ws?.Drafts.FirstOrDefault() is { } latest) await OpenDraftAsync(latest.Id);
        _planName = _draft?.PlanName ?? "";
        _deliveryLabel = _draft?.DeliveryLabel ?? "";
    }

    private async Task LoadGuideAsync()
    {
        var (ws, error) = await _api!.WorkspaceAsync(_guideKey);
        _ws = ws; _error = error;
        _guideKey = ws?.GuideKey ?? _guideKey;
        SetCandidates([.. (ws?.Candidates ?? []).Select(P.FromGuideCandidate)]);
        foreach (var id in P.ParseScenarios(ScenariosQuery).Where(id => _candidates.Any(c => c.CandidateId == id))) _selected.Add(id);
        if (_selected.Count > 0)
        {
            _area = "choose";
            Info($"{_selected.Count} scenario{(_selected.Count == 1 ? "" : "s")} selected from What to test. Nothing is approved by selecting: review the test cases before use.");
        }
        if (Guid.TryParse(DraftQuery, out var draftId)) await OpenDraftAsync(draftId);
        else if (ws?.Drafts.FirstOrDefault() is { } latest && _selected.Count == 0) await OpenDraftAsync(latest.Id);
        _planName = _draft?.PlanName ?? "";
        _deliveryLabel = _draft?.DeliveryLabel ?? "";
    }

    private async Task ReloadWorkspaceAsync()
    {
        if (GuideMode) { var (ws, _) = await _api!.WorkspaceAsync(_guideKey); if (ws is not null) _ws = ws; }
        else if (_projectKey is not null) { var (ws, _) = await _api!.ProjectAsync(_projectKey, _environmentId); if (ws is not null) _ws = ws; }
    }

    private void UseDiscovery(ScenarioDiscoveryResult? result)
    {
        if (result is not null && result.ProjectKey != _projectKey) result = null; // never another project's result
        _discovery = result;
        SetCandidates(result?.Candidates ?? []);
        // Rediscovery keeps a selection only for candidate ids that still exist (ids are stable per project and source identity).
        var ids = _candidates.Select(c => c.CandidateId).ToHashSet(StringComparer.Ordinal);
        _selected.RemoveWhere(id => !ids.Contains(id));
        _preview = null;
    }

    /// <summary>A reload keeps the scenarios this tab had selected (only those the current discovery still has; nothing is prepared or approved by it).</summary>
    private async Task RestoreSelectionAsync()
    {
        _selectionKey = null;
        if (_projectKey is null) return;
        var kept = await TabDraftStore.ReadAsync<string[]>(JS, TabDraftStore.SelectionKey(_projectKey)) ?? [];
        var ids = _candidates.Select(c => c.CandidateId).ToHashSet(StringComparer.Ordinal);
        var restored = 0;
        foreach (var id in kept.Where(ids.Contains)) if (_selected.Add(id)) restored++;
        _selectionKey = _projectKey;
        _keptSelection = SelectionSignature();
        if (restored > 0)
            Info($"{restored} selected scenario{(restored == 1 ? " was" : "s were")} kept from before the page was reloaded. Nothing is prepared until you choose Prepare.");
    }

    private string SelectionSignature() => string.Join("|", _selected.Order(StringComparer.Ordinal));

    private async Task KeepSelectionAsync()
    {
        if (GuideMode || _selectionKey is null || _selectionKey != _projectKey) return;
        var signature = SelectionSignature();
        if (signature == _keptSelection) return;
        _keptSelection = signature;
        if (_selected.Count == 0) await TabDraftStore.RemoveAsync(JS, TabDraftStore.SelectionKey(_selectionKey));
        else await TabDraftStore.WriteAsync(JS, TabDraftStore.SelectionKey(_selectionKey), _selected.Order(StringComparer.Ordinal).ToArray());
    }

    private void SetCandidates(List<DiscoveredScenario> candidates)
    {
        _candidates = candidates;
        _inventory = P.Classify(candidates);
    }

    /// <summary>Switching views keeps the selection and the filters; the view is part of the address so a link or reload opens it again.</summary>
    private void SetView(P.CandidateView view)
    {
        _view = view;
        _limit = P.PageSize;
        _preview = null;
        Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?> { ["view"] = view == P.CandidateView.Manual ? null : P.ViewId(view) }), replace: true);
    }

    private async Task LoadCoverageAsync()
    {
        if (_environmentId is null && ServiceProvider.GetService(typeof(IFrontendAnalysisContextFactory)) is IFrontendAnalysisContextFactory contexts)
            try { _environmentId = (await contexts.GetActiveContextAsync()).ActiveProfileOrNull?.Id; } catch (InvalidOperationException) { }
        if (string.IsNullOrWhiteSpace(_environmentId)) { _coverageNote = "Unknown: no project (Target Environment) is selected, so no requirement association can be read."; return; }
        var (coverage, error) = await _api!.RequirementCoverageAsync(_environmentId, rows: false);
        _coverage = coverage;
        _coverageNote = coverage is null ? error : coverage.Known ? null : $"Unknown: {coverage.UnknownReason}";
    }

    private async Task OpenDraftAsync(Guid id)
    {
        var (draft, error) = await _api!.DraftAsync(id);
        if (draft is null) { Fail(error ?? "The plan could not be opened."); return; }
        // Project isolation: a plan of another project is never opened here.
        if (!GuideMode && draft.ProjectKey != _projectKey) { Fail("That plan belongs to another project and is not shown here."); return; }
        if (GuideMode && draft.ProjectKey is not null) { Fail("That plan belongs to a project; open the project to see it."); return; }
        _draft = draft;
        _dirty = false;
        _planName = draft.PlanName;
        _deliveryLabel = draft.DeliveryLabel ?? "";
    }

    private void GoArea(string id)
    {
        _area = P.AreaOrDefault(id);
        _message = null;
        Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?> { ["area"] = _area, ["draft"] = _draft?.Id.ToString(), ["scenarios"] = null }), replace: true);
    }

    // A step or area action always shows where it went: the area is activated (also when it already was — "Open now" on the current step), and
    // after rendering the area's heading is scrolled into view and focused. Re-opening a completed step works the same way.
    private bool _revealArea;

    private Task OnStepAction(string id) { GoArea(id); _revealArea = true; return Task.CompletedTask; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await KeepSelectionAsync();
        if (_focusNewStep is { } focus)
        {
            _focusNewStep = null;
            _revealArea = false; // the new case's first step is where the tester continues
            try { await JS.InvokeVoidAsync("birknextRevealSection", $"tps-step-new-{focus}"); }
            catch (JSException) { }
            catch (InvalidOperationException) { }
            return;
        }
        if (_revealPreview)
        {
            // The preparation preview takes focus so keyboard and screen-reader users land on it.
            _revealPreview = false;
            try { await JS.InvokeVoidAsync("birknextRevealSection", "tps-preview"); }
            catch (JSException) { }
            catch (InvalidOperationException) { }
        }
        if (!_revealArea) return;
        _revealArea = false;
        try { await JS.InvokeVoidAsync("birknextRevealSection", "tps-area-heading"); }
        catch (JSException) { }
        catch (InvalidOperationException) { } // prerendering / no JS runtime
    }

    private void Info(string text) { _message = text; _messageTone = "info"; }
    private void Ok(string text) { _message = text; _messageTone = "ok"; }
    private void Fail(string text) { _message = text; _messageTone = "warn"; }

    private void Change(TestPlanDraft draft) { _draft = draft; _dirty = true; _edits++; }

    // ── Version history ──────────────────────────────────────────────────────────────────────────────────────────────

    private bool _historyOpen;
    private List<TestPlanRevisionSummary>? _revisions;
    private string? _historyError;
    private TestPlanDraft? _viewed;

    private async Task ToggleHistoryAsync()
    {
        _historyOpen = !_historyOpen;
        _viewed = null;
        if (_historyOpen) await LoadRevisionsAsync();
    }

    private async Task LoadRevisionsAsync()
    {
        if (_draft is null || _api is null) return;
        _revisions = null; _historyError = null;
        var (list, error) = await _api.RevisionsAsync(_draft.Id);
        (_revisions, _historyError) = (list, list is null ? error ?? "The version history could not be read." : null);
    }

    private async Task ViewRevisionAsync(int revision)
    {
        if (_viewed?.Revision == revision) { _viewed = null; return; }
        if (_draft is null || _api is null) return;
        var (draft, error) = await _api.RevisionAsync(_draft.Id, revision);
        if (draft is null) { Fail(error ?? "That version could not be read."); return; }
        _viewed = draft;
    }

    private async Task RestoreRevisionAsync(int revision)
    {
        if (_draft is not { } current || _api is null || _dirty) return;
        var next = current.Revision + 1;
        if (!await JS.InvokeAsync<bool>("confirm", $"Restore version {revision}? It is saved as version {next}; the current version {current.Revision} stays in the history. Test cases added after version {revision} leave the plan.")) return;
        _busy = true;
        try
        {
            var (restored, error) = await _api.RestoreRevisionAsync(current.Id, current.Revision, revision);
            if (restored is null) { Fail(error ?? "The version could not be restored."); return; }
            _draft = restored; _dirty = false; _planName = restored.PlanName; _deliveryLabel = restored.DeliveryLabel ?? ""; _viewed = null;
            Ok($"Version {revision} restored as version {restored.Revision}.");
            await LoadRevisionsAsync();
        }
        finally { _busy = false; }
    }

    /// <summary>Counts local edits, so a save that completes after a newer edit never marks that edit as saved.</summary>
    private int _edits;

    /// <summary>Leaving with unsaved edits asks first. Switching areas of the same plan keeps the edits and does not ask.</summary>
    private async Task ConfirmLeaveAsync(Microsoft.AspNetCore.Components.Routing.LocationChangingContext context)
    {
        if (!_dirty || _draft is null) return;
        var target = Nav.ToAbsoluteUri(context.TargetLocation);
        var current = Nav.ToAbsoluteUri(Nav.Uri);
        var draftParameter = System.Text.RegularExpressions.Regex.Match(target.Query, @"[?&]draft=([^&]+)");
        var samePlan = string.Equals(target.AbsolutePath, current.AbsolutePath, StringComparison.OrdinalIgnoreCase)
            && (!draftParameter.Success || string.Equals(Uri.UnescapeDataString(draftParameter.Groups[1].Value), _draft.Id.ToString(), StringComparison.OrdinalIgnoreCase));
        if (samePlan) return;
        bool leave;
        try { leave = await JS.InvokeAsync<bool>("confirm", "This plan has unsaved changes. Leave without saving them?"); }
        catch (JSException) { leave = false; }
        if (!leave) context.PreventNavigation();
    }

    private void ToggleCase(string id) { if (!_openCases.Remove(id)) _openCases.Add(id); }

    private IReadOnlyList<GuidedStep> Steps => P.Steps(_draft, _ws?.Snapshots ?? [], _candidates.Count, _discovery is not null || GuideMode, _selected.Count);

    // ── Context ─────────────────────────────────────────────────────────────────────────────────────────────

    private RenderFragment ContextCard() => __builder =>
    {
        <section class="tps-context" data-testid="tps-context" aria-label="Project context">
            @if (GuideMode)
            {
                <div class="tps-ctx-item"><span class="tps-k">System Understanding guide</span><strong data-testid="tps-guide-title">@(_ws?.Guides.FirstOrDefault(g => g.GuideKey == _guideKey)?.Title ?? _guideKey)</strong>
                    <span class="tps-muted tps-small">A plan prepared from a guide (earlier workflow). Open a project for project-based discovery.</span></div>
                <div class="tps-ctx-item" data-testid="tps-existing-plan"><span class="tps-k">Plan</span>
                    @if (_draft is { } gd) { <span><strong>@gd.PlanName</strong> <span class="tps-muted">@gd.Cases.Count cases · revision @gd.Revision</span></span> }
                    else { <span class="tps-muted">None yet</span> }
                    @if (_dirty) { <span class="tps-tone tps-tone-warn" data-testid="tps-unsaved">Unsaved changes</span> }
                    @if (_draft is not null) { <button type="button" class="tps-btn tps-btn-quiet" aria-expanded="@(_historyOpen ? "true" : "false")" aria-controls="tps-history" data-testid="tps-history-open" @onclick="ToggleHistoryAsync">Version history</button> }
                </div>
                @if (_ws?.Basis is { } basis)
                {
                    <div class="tps-ctx-item" data-testid="tps-guide-basis"><span class="tps-k">Scenario source</span><span>Guide revision @basis.GuideRevision · <span class="tps-tone tps-tone-@(basis.GuideReviewState.StartsWith("Published") ? "ok" : "warn")">@basis.GuideReviewState</span></span></div>
                    <div class="tps-ctx-item" data-testid="tps-sources"><span class="tps-k">Source baseline</span>
                        <span>@foreach (var r in basis.Roles.GroupBy(r => r.Role)) { var role = r.First(); <span class="tps-chip" title="@role.Label">@role.Role: @P.BaselineState(role.State)</span> }</span>
                    </div>
                    @if (P.HasBaselineWarning(basis))
                    {
                        <p class="tps-note tps-note-warn" data-testid="tps-baseline-warning" role="status"><strong>Source baseline not selected.</strong> At least one source is imported in alternative versions and none is chosen. Plans record this; versions are never combined. <a href="source-analysis?area=versions">Select the analysis baseline</a></p>
                    }
                }
            }
            else
            {
                @* The shared project selector (same control as every workspace header); plain text where no selection service exists. *@
                @if (ServiceProvider.GetService(typeof(BirkNext.Web.Services.ProjectImport.ProjectSelection)) is not null)
                {
                    <div class="tps-ctx-item" data-testid="tps-project"><BirkNext.Web.Components.ProjectSelector /></div>
                }
                else
                {
                    <div class="tps-ctx-item"><span class="tps-k">Project</span><strong data-testid="tps-project-name">@(_projectName ?? _projectKey)</strong></div>
                }
                <div class="tps-ctx-item" data-testid="tps-snapshot"><span class="tps-k">Source snapshot</span>
                    @if (_snapshotOptions.Count > 0)
                    {
                        <select class="tps-input tps-input-sm" aria-label="Source snapshot" @onchange="SnapshotChanged" data-testid="tps-snapshot-select">
                            <option value="" selected="@(_snapshotId is null)">None (documents only)</option>
                            @foreach (var s in _snapshotOptions.Take(60)) { <option value="@s.SnapshotId" selected="@(_snapshotId == s.SnapshotId)">@s.ArchiveName · @s.AnalyzedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</option> }
                        </select>
                    }
                    else { <span>@(_snapshotId is null ? "None linked" : _snapshotId.ToString()![..8])</span> }
                    <span class="tps-muted tps-small">@(_snapshotBasis ?? (_snapshotId is null ? "No source snapshot is linked to this project; documents are still read." : "Chosen here"))</span>
                </div>
                <div class="tps-ctx-item" data-testid="tps-existing-plan"><span class="tps-k">Existing plan</span>
                    @if (_draft is { } d) { <span><strong>@d.PlanName</strong> <span class="tps-muted">@d.Cases.Count cases · revision @d.Revision</span></span> }
                    else { <span class="tps-muted">None yet</span> }
                    @if (_dirty) { <span class="tps-tone tps-tone-warn" data-testid="tps-unsaved">Unsaved changes</span> }
                    @if (_draft is not null) { <button type="button" class="tps-btn tps-btn-quiet" aria-expanded="@(_historyOpen ? "true" : "false")" aria-controls="tps-history" data-testid="tps-history-open" @onclick="ToggleHistoryAsync">Version history</button> }
                </div>
            }
        </section>
        @if (_historyOpen && _draft is { } hd)
        {
            @* Version history: every saved revision of this plan (append-only). A restore saves the chosen version as the next revision. *@
            <section class="tps-block" id="tps-history" data-testid="tps-history" aria-labelledby="tps-history-title">
                <h2 id="tps-history-title" class="tps-h">Version history of "@hd.PlanName"</h2>
                <p class="tps-muted tps-small">Every saved version is kept. Restoring one saves it as a new version; nothing is deleted.</p>
                @if (_historyError is not null) { <p class="tps-note tps-note-warn" role="alert">@_historyError</p> }
                else if (_revisions is null) { <p class="tps-muted" role="status">Loading versions…</p> }
                else if (_revisions.Count == 0) { <p class="tps-muted" data-testid="tps-history-none">No saved version is recorded yet. Versions saved from now on appear here.</p> }
                else
                {
                    <ol class="tps-plain" data-testid="tps-history-list">
                        @foreach (var r in _revisions)
                        {
                            <li data-testid="tps-history-item" data-revision="@r.Revision" data-current="@(r.Current ? "true" : "false")">
                                <strong>Version @r.Revision</strong> · @r.Reason · @r.SavedBy · @r.SavedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") · @r.Cases case@(r.Cases == 1 ? "" : "s")@(r.PlanName != hd.PlanName ? $" · named \"{r.PlanName}\"" : "")
                                @if (r.Current) { <span class="tps-tone tps-tone-ok" data-testid="tps-history-current">Current</span> }
                                else
                                {
                                    <button type="button" class="tps-btn tps-btn-quiet" data-testid="tps-history-view" @onclick="() => ViewRevisionAsync(r.Revision)">@(_viewed?.Revision == r.Revision ? "Hide" : "View")</button>
                                    <button type="button" class="tps-btn tps-btn-quiet" disabled="@(_busy || _dirty)" data-testid="tps-history-restore" @onclick="() => RestoreRevisionAsync(r.Revision)">Restore this version</button>
                                }
                                @if (_viewed is { } v && v.Revision == r.Revision)
                                {
                                    <ul class="tps-plain" data-testid="tps-history-cases">@foreach (var c in v.Cases) { <li>@c.EffectiveTitle <span class="tps-muted tps-small">@c.EffectiveSteps.Count step@(c.EffectiveSteps.Count == 1 ? "" : "s")</span></li> }</ul>
                                }
                            </li>
                        }
                    </ol>
                    @if (_dirty) { <p class="tps-muted tps-small" data-testid="tps-history-needs-save">Save or discard your changes before restoring a version.</p> }
                }
            </section>
        }
        @if (!GuideMode && _discovery is { } discovery)
        {
            @* Compact evidence summary (2026-11-18): the five numbers a tester needs, then the per-source detail on demand. Saved cases are cases of
               the open plan; a saved case is never an executed test. *@
            var found = discovery.Capabilities.Where(x => x.State == DiscoveryCapabilityState.Available).ToList();
            var saved = _draft?.Cases.Count(c => c.Review is not (TestCaseReviewState.Excluded or TestCaseReviewState.Superseded)) ?? 0;
            <dl class="tps-summary" data-testid="tps-stats" aria-label="Discovered candidates">
                <div class="tps-summary-item" data-testid="tps-stat-total"><dt>Discovered</dt><dd>@_inventory.Total</dd></div>
                <div class="tps-summary-item" data-testid="tps-stat-manual"><dt>For manual testing</dt><dd>@_inventory.Manual</dd></div>
                <div class="tps-summary-item" data-testid="tps-stat-technical"><dt>Technical</dt><dd>@_inventory.Technical</dd>@if (_inventory.OperationCandidates > _inventory.DistinctOperations) { <dd class="tps-summary-note" data-testid="tps-stat-operations">@_inventory.OperationCandidates operation entries = @_inventory.DistinctOperations distinct operation@(_inventory.DistinctOperations == 1 ? "" : "s")</dd> }</div>
                <div class="tps-summary-item" data-testid="tps-stat-saved"><dt>Cases in the plan</dt><dd>@saved</dd></div>
                <div class="tps-summary-item" data-testid="tps-stat-attention"><dt>Need attention</dt><dd>@_inventory.Attention</dd></div>
            </dl>
            <details class="tps-block tps-evidence" data-testid="tps-capabilities" aria-label="Evidence sources">
                <summary class="tps-evidence-summary"><span class="tps-h3">Evidence sources</span>
                    <span class="tps-muted tps-small" data-testid="tps-capabilities-summary">@found.Sum(x => x.Candidates) candidate@(found.Sum(x => x.Candidates) == 1 ? "" : "s") from @found.Count of @discovery.Capabilities.Count source@(discovery.Capabilities.Count == 1 ? "" : "s") · discovered @discovery.DiscoveredAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span></summary>
                <ul class="tps-capabilities">
                    @foreach (var c in discovery.Capabilities)
                    {
                        var tone = c.State switch { DiscoveryCapabilityState.Available => "ok", DiscoveryCapabilityState.Failed => "bad", _ => "muted" };
                        var label = c.State switch { DiscoveryCapabilityState.Available => $"{c.Candidates} found", DiscoveryCapabilityState.NoEvidence => "No evidence", DiscoveryCapabilityState.NotApplicable => "Not applicable", _ => "Could not read" };
                        <li class="tps-capability" data-testid="tps-capability-@c.Id" data-state="@c.State"><strong>@c.Label</strong> <span class="tps-tone tps-tone-@tone">@(c.Id == "existing-tests" && c.State == DiscoveryCapabilityState.Available ? "Associations only" : label)</span>
                            <span class="tps-muted tps-small">@c.Detail</span></li>
                    }
                </ul>
                <p class="tps-muted tps-small">Discovered @discovery.DiscoveredAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") · rules @discovery.RuleVersion@(discovery.SnapshotLabel is { } sl ? $" · {sl}" : "")</p>
                @foreach (var l in discovery.Limitations) { <p class="tps-muted tps-small" data-testid="tps-limitation">@l</p> }
            </details>
        }
    };

    private async Task SnapshotChanged(ChangeEventArgs e)
    {
        _snapshotId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        _snapshotBasis = "Chosen here";
        var (last, _) = await _api!.LastDiscoveryAsync(_projectKey!, _snapshotId);
        UseDiscovery(last);
        if (last is null) Info("Discover test scenarios again to read the chosen snapshot.");
    }

    // ── Step 1: Choose scenarios ─────────────────────────────────────────────────────────────────────────────

    /// <summary>The project's own documents, parsed by the existing specification parser (the same evidence Test Coverage reads); null when unreadable.</summary>
    private async Task<BirkNext.TestCoverage.CoverageWorkspaceEvidence?> WorkspaceEvidenceAsync()
    {
        try
        {
            BirkNext.Web.Services.Explorers.ArtifactExplorerState? specification = null;
            if (ServiceProvider.GetService(typeof(BirkNext.Web.Services.Explorers.IArtifactExplorerContext)) is BirkNext.Web.Services.Explorers.IArtifactExplorerContext artifacts)
                specification = await artifacts.GetStateAsync(WorkspaceArtifactType.Specification);
            if (ServiceProvider.GetService(typeof(IWorkspaceSessionService)) is IWorkspaceSessionService session)
                return TestCoveragePresentation.WorkspaceEvidence(session, (ServiceProvider.GetService(typeof(IReviewContextProvider)) as IReviewContextProvider)?.GetCurrent(), _projectName, specification);
        }
        catch (Exception e) when (e is not OperationCanceledException) { }
        return null;
    }

    /// <summary>The requirements a tester can link to (the current project's selected specification), and why the list is empty when it is.</summary>
    private async Task LoadRequirementsAsync()
    {
        var evidence = await WorkspaceEvidenceAsync();
        _requirements = L.Options(evidence);
        _requirementsNote = L.EmptyReason(evidence, _requirements);
    }

    /// <summary>The tester chose another module, feature or specification here: its requirements are read again; the picker offers Discover now.</summary>
    private Task OnSpecificationChangedAsync() => LoadRequirementsAsync();

    private async Task DiscoverAsync()
    {
        if (_projectKey is null) return;
        _busy = true;
        Info("Discovering test scenarios… only the analyzers registered for this project's evidence run.");
        var evidence = await WorkspaceEvidenceAsync();
        var (result, error) = await _api!.DiscoverAsync(new ScenarioDiscoveryRequest { ProjectKey = _projectKey, ProjectName = _projectName, SnapshotId = _snapshotId, EnvironmentId = _environmentId, Workspace = evidence });
        _busy = false;
        if (result is null) { Fail(error ?? "Discovery failed."); return; }
        UseDiscovery(result);
        _limit = P.PageSize;
        if (result.Candidates.Count == 0) Info("No test scenario was found in this project's evidence. Add tests in Azure DevOps Test Plans, or write test cases by hand under Advanced.");
        else Ok($"{result.Candidates.Count} scenario candidates found. Choose the ones to prepare; selecting approves nothing.");
    }

    private RenderFragment ChooseArea() => __builder =>
    {
        // One inventory, four views (2026-11-18): the view narrows what is listed, the filters narrow the view; the selection is never touched by either.
        var inView = _candidates.Where(c => P.InView(c, _inventory.Of(c), _view)).ToList();
        var shown = P.Apply(inView, _catalog).ToList();
        var visible = shown.Take(_limit).ToList();
        var inDraft = InPlan;
        var shownIds = shown.Select(c => c.CandidateId).ToHashSet(StringComparer.Ordinal);
        var hiddenSelected = _selected.Count(id => !shownIds.Contains(id));
        var adding = _selected.Count(id => !inDraft.Contains(id));
        var alreadyPrepared = _selected.Count(inDraft.Contains);
        var overlaps = P.OverlapsWithPlan(_selected, _candidates, _inventory, inDraft);
        var moreFilters = (_catalog.Type is null ? 0 : 1) + (_catalog.Tests is null ? 0 : 1) + (_catalog.AttentionOnly ? 1 : 0);
        <section class="tps-section" data-testid="tps-choose" aria-label="Choose scenarios" data-view="@P.ViewId(_view)">
            @if (!GuideMode)
            {
                <BirkNext.Web.Components.SpecificationScopePicker Changed="OnSpecificationChangedAsync" Discover="DiscoverAsync" />
                <div class="tps-actionbar tps-actionbar-compact" data-testid="tps-discover-bar">
                    <button type="button" class="tps-btn @(_discovery is null ? null : "tps-btn-quiet")" disabled="@_busy" @onclick="DiscoverAsync" data-testid="tps-discover-run">@(_discovery is null ? "Discover test scenarios" : "Discover again")</button>
                    <span class="tps-muted tps-small">@(_discovery is null ? "Reads the specification, source snapshot and contracts of this project. Nothing runs until you ask." : "The last result is reused until you discover again; changing a view or filter never re-runs analysis.")</span>
                </div>
            }
            @if (_candidates.Count == 0)
            {
                <div class="tps-empty" data-testid="tps-no-candidates">
                    <h3 class="tps-h3">@(GuideMode ? "The guide has no scenarios yet." : _discovery is null ? "Not discovered yet" : "No scenario found in this project's evidence")</h3>
                    @if (!GuideMode && _discovery is not null)
                    {
                        <p>None of the registered analyzers found a scenario: no specification acceptance scenarios or requirements, no Razor/HTML pages with a route, no OpenAPI/GraphQL operations and no integration journeys. Evidence sources above say what was read. Add tests in Azure DevOps Test Plans, or write test cases by hand under Advanced below.</p>
                    }
                </div>
            }
            else
            {
                <div class="tps-views" role="group" aria-label="Candidate view" data-testid="tps-views">
                    @foreach (var v in P.Views)
                    {
                        var view = v;
                        var selectedHere = view == P.CandidateView.All ? _selected.Count : _candidates.Count(c => _selected.Contains(c.CandidateId) && P.InView(c, _inventory.Of(c), view));
                        <button type="button" class="tps-view @(_view == view ? "is-current" : null)" aria-pressed="@(_view == view ? "true" : "false")" data-testid="tps-view-@P.ViewId(view)"
                                @onclick="() => SetView(view)">@P.ViewLabel(view) <span class="tps-count" data-testid="tps-view-count">@_inventory.Count(view)</span>@if (selectedHere > 0 && _view != view) { <span class="tps-view-selected" title="Selected candidates in this view">@selectedHere selected</span> }</button>
                    }
                </div>
                <p class="tps-muted tps-small tps-view-hint" data-testid="tps-view-hint">@P.ViewHint(_view)</p>
                @if (_view == P.CandidateView.Manual && P.ManualEmptyReason(_inventory) is { } emptyReason)
                {
                    @* Adaptive default: an API-only project is never shown as an empty manual list without saying why and what can be done. *@
                    <div class="tps-empty tps-empty-compact" data-testid="tps-manual-empty" role="status">
                        <p>@emptyReason</p>
                        <p class="tps-inline-actions">
                            @if (_inventory.Technical > 0) { <button type="button" class="tps-btn" data-testid="tps-manual-empty-technical" @onclick="() => SetView(P.CandidateView.Technical)">Show technical candidates (@_inventory.Technical)</button> }
                            <a class="tps-btn tps-btn-quiet" href="technical-testing/assess" data-testid="tps-manual-empty-open-technical">Open Technical Testing</a>
                            @if (_inventory.Unclassified > 0) { <button type="button" class="tps-btn tps-btn-quiet" @onclick="() => SetView(P.CandidateView.Attention)">Needs attention (@_inventory.Attention)</button> }
                        </p>
                    </div>
                }
                else
                {
                    <div class="tps-filters" role="search" aria-label="Filter candidates">
                        <label class="tps-field tps-field-grow"><span class="tps-k">Search</span><input class="tps-input" type="search" placeholder="Title, purpose, area or requirement" value="@_catalog.Query" @oninput="e => _catalog = _catalog with { Query = e.Value?.ToString() ?? string.Empty }" data-testid="tps-search" /></label>
                        <label class="tps-field"><span class="tps-k">Area</span>
                            <select class="tps-input" @onchange="e => _catalog = _catalog with { Area = Empty(e) }" data-testid="tps-filter-area">
                                <option value="">All</option>
                                @foreach (var a in inView.Select(P.AreaOf).Distinct().OrderBy(a => a, StringComparer.CurrentCultureIgnoreCase)) { <option value="@a" selected="@(_catalog.Area == a)">@a</option> }
                            </select></label>
                        <label class="tps-field"><span class="tps-k">Source</span>
                            <select class="tps-input" @onchange="e => _catalog = _catalog with { Source = Empty(e) }" data-testid="tps-filter-source">
                                <option value="">All</option>
                                @foreach (var s in inView.Select(c => c.SourceCategory).Distinct()) { <option value="@s" selected="@(_catalog.Source == s)">@s</option> }
                            </select></label>
                        <label class="tps-field"><span class="tps-k">Group by</span>
                            <select class="tps-input" @onchange="e => _grouping = Enum.TryParse<P.CatalogGrouping>(e.Value?.ToString(), out var g) ? g : P.CatalogGrouping.Area" data-testid="tps-group-by">
                                @foreach (var g in Enum.GetValues<P.CatalogGrouping>()) { <option value="@g" selected="@(_grouping == g)">@P.GroupingLabel(g)</option> }
                            </select></label>
                        <details class="tps-more-filters" data-testid="tps-more-filters" open="@(moreFilters > 0)">
                            <summary>More filters@(moreFilters > 0 ? $" ({moreFilters})" : "")</summary>
                            <div class="tps-more-filters-body">
                                <label class="tps-field"><span class="tps-k">Type</span>
                                    <select class="tps-input" @onchange="e => _catalog = _catalog with { Type = Enum.TryParse<ScenarioCandidateType>(e.Value?.ToString(), out var t) ? t : null }" data-testid="tps-filter-type">
                                        <option value="">All</option>
                                        @foreach (var t in inView.Select(c => c.Type).Distinct().OrderBy(t => t)) { <option value="@t" selected="@(_catalog.Type == t)">@ScenarioCandidateTypes.Label(t)</option> }
                                    </select></label>
                                <label class="tps-field"><span class="tps-k">Existing tests</span>
                                    <select class="tps-input" @onchange="e => _catalog = _catalog with { Tests = Empty(e) }" data-testid="tps-filter-tests">
                                        <option value="">All</option><option value="with" selected="@(_catalog.Tests == "with")">With an existing test</option><option value="without" selected="@(_catalog.Tests == "without")">Without an existing test</option>
                                    </select></label>
                                <label class="tps-field tps-check"><input type="checkbox" checked="@_catalog.AttentionOnly" @onchange="e => _catalog = _catalog with { AttentionOnly = e.Value is true }" data-testid="tps-filter-attention" /> Only needing attention</label>
                            </div>
                        </details>
                    </div>
                    <div class="tps-selectbar" role="group" aria-label="Selection">
                        <span data-testid="tps-selected-count" aria-live="polite"><strong>@_selected.Count</strong> selected</span>
                        @if (hiddenSelected > 0) { <span class="tps-tone tps-tone-info" data-testid="tps-selected-hidden">@hiddenSelected hidden by filters — still selected</span> }
                        <span class="tps-muted tps-small" data-testid="tps-shown-count">@shown.Count of @inView.Count in this view</span>
                        <button type="button" class="tps-btn tps-btn-quiet" disabled="@(shown.Count == 0)" @onclick="() => { foreach (var c in shown) _selected.Add(c.CandidateId); }" data-testid="tps-select-shown">Select visible (@shown.Count)</button>
                        <button type="button" class="tps-btn tps-btn-quiet" disabled="@(_selected.Count == 0)" @onclick="() => { _selected.Clear(); _preview = null; }" data-testid="tps-clear-selection">Clear selection</button>
                    </div>
                    @if (shown.Count == 0) { <p class="tps-muted" data-testid="tps-no-match">No scenario matches these filters in this view.</p> }
                    <div class="tps-groups" data-testid="tps-candidates">
                        @{ var groups = P.Group(visible, _grouping, _inventory).ToList(); var firstGroup = true; }
                        @foreach (var group in groups)
                        {
                            // Many candidates: only the first group starts open (the headings with their counts are the overview); a few: all open.
                            // The tester's own choice per group wins.
                            var open = _groupOpen.TryGetValue(group.Id, out var chosen) ? chosen : firstGroup || shown.Count <= GroupsOpenUpTo;
                            firstGroup = false;
                            var selectedHere = group.Items.Count(c => _selected.Contains(c.CandidateId));
                            <section class="tps-group" aria-labelledby="tps-g-@group.Id" data-testid="tps-group-@group.Id" data-open="@(open ? "true" : "false")">
                                <h3 id="tps-g-@group.Id" class="tps-group-h">
                                    <button type="button" class="tps-group-toggle" aria-expanded="@(open ? "true" : "false")" aria-controls="tps-gl-@group.Id" data-testid="tps-group-toggle-@group.Id"
                                            @onclick="() => _groupOpen[group.Id] = !open">@group.Title <span class="tps-count">@group.Items.Count</span>@if (selectedHere > 0) { <span class="tps-tone tps-tone-info">@selectedHere selected</span> }</button>
                                </h3>
                                <ul class="tps-rows" id="tps-gl-@group.Id" hidden="@(!open)">
                                    @if (open) { foreach (var c in group.Items) { @CandidateRow(c, inDraft.Contains(c.CandidateId)) } }
                                </ul>
                            </section>
                        }
                    </div>
                    @if (shown.Count > visible.Count)
                    {
                        <button type="button" class="tps-btn tps-btn-quiet" @onclick="() => _limit += P.PageSize" data-testid="tps-show-more">Show @Math.Min(P.PageSize, shown.Count - visible.Count) more (@visible.Count of @shown.Count shown)</button>
                    }
                }
            }
            @if (CanWrite)
            {
                @if (_preview is { } preview)
                {
                    @* Preparation preview: shown before a bulk preparation or one that needs a look (technical candidates, overlaps, missing expected
                       results or prerequisites). Nothing is created until the tester confirms. *@
                    <section class="tps-preview" role="region" aria-labelledby="tps-preview-h" tabindex="-1" id="tps-preview" data-testid="tps-preview">
                        <h3 id="tps-preview-h" class="tps-h3">Prepare @preview.Adding test case@(preview.Adding == 1 ? "" : "s")?</h3>
                        <ul class="tps-plain tps-preview-list">
                            <li data-testid="tps-preview-kinds">@string.Join(" · ", preview.Kinds.Select(k => $"{k.Count} {k.Kind.ToLowerInvariant()}"))</li>
                            @if (preview.AlreadyInPlan > 0) { <li data-testid="tps-preview-in-plan">@preview.AlreadyInPlan already in the plan — not added again</li> }
                            @if (preview.Technical > 0) { <li data-testid="tps-preview-technical">@preview.Technical technical candidate@(preview.Technical == 1 ? " is" : "s are") normally verified in Technical Testing; @(preview.Technical == 1 ? "it becomes" : "they become") manual cases only because you chose so</li> }
                            @if (preview.Overlaps > 0) { <li data-testid="tps-preview-overlaps">@preview.Overlaps may overlap a case already in the plan or another selected candidate (same requirement through another source, or the same contract operation in another file)</li> }
                            @if (preview.MissingExpected > 0) { <li data-testid="tps-preview-missing-expected">@preview.MissingExpected without an expected result in the evidence — they start as Needs clarification</li> }
                            @if (preview.IncompleteSteps > 0) { <li data-testid="tps-preview-incomplete-steps">@preview.IncompleteSteps with no steps, or steps without an expected result, in the evidence — write them before approving (the Azure DevOps export needs an expected result on every step)</li> }
                            @if (preview.MissingPrerequisites > 0) { <li data-testid="tps-preview-missing-prerequisites">@preview.MissingPrerequisites with a missing test prerequisite (Test Data, access or environment)</li> }
                        </ul>
                        <p class="tps-muted tps-small">Preparing creates reviewable drafts only: nothing is approved, executed or counted as coverage.</p>
                        <p class="tps-inline-actions">
                            <button type="button" class="tps-btn" disabled="@_busy" @onclick="PrepareAsync" data-testid="tps-preview-confirm">Prepare @preview.Adding test case@(preview.Adding == 1 ? "" : "s")</button>
                            <button type="button" class="tps-btn tps-btn-quiet" @onclick="() => _preview = null" data-testid="tps-preview-cancel">Back to the selection</button>
                        </p>
                    </section>
                }
                <div class="tps-actionbar tps-actionbar-sticky" data-testid="tps-prepare-bar">
                    <span aria-live="polite"><strong>@_selected.Count</strong> scenario@(_selected.Count == 1 ? "" : "s") selected</span>
                    @if (hiddenSelected > 0 && _candidates.Count > 0) { <span class="tps-muted tps-small" data-testid="tps-prepare-hidden">@hiddenSelected not shown here</span> }
                    @if (alreadyPrepared > 0) { <span class="tps-muted tps-small" data-testid="tps-prepare-in-plan">@alreadyPrepared already in the plan</span> }
                    @if (overlaps > 0) { <span class="tps-tone tps-tone-warn" data-testid="tps-prepare-overlaps">@overlaps may overlap existing cases</span> }
                    <button type="button" class="tps-btn" disabled="@(_busy || adding == 0)" @onclick="PrepareClickedAsync" data-testid="tps-prepare">@(_draft is null ? (adding > 1 ? $"Prepare {adding} test cases" : "Prepare test cases") : $"Add {adding} to the plan")</button>
                    @if (_selected.Count > 0 && adding == 0) { <span class="tps-muted tps-small">Every selected scenario is already in the plan.</span> }
                    @if (_selected.Count == 0) { <span class="tps-muted tps-small" data-testid="tps-select-hint">Select at least one scenario to prepare test cases.</span> }
                </div>
                @if (!GuideMode)
                {
                    @ManualCaseAdvanced(ChooseManualForm)
                }
            }
        </section>
    };

    /// <summary>The candidate ids that are cases of the open plan (a saved case is never an executed test).</summary>
    private IReadOnlySet<string> InPlan => _draft?.Cases.Select(c => c.Source.ScenarioId).ToHashSet(StringComparer.Ordinal) ?? (IReadOnlySet<string>)new HashSet<string>();

    /// <summary>One ordinary case is prepared at once; a bulk selection, or one that needs a look, shows the preview first.</summary>
    private async Task PrepareClickedAsync()
    {
        if (_dirty) { Fail("Save or discard your changes first."); return; }
        var preview = P.Preview(_selected, _candidates, _inventory, InPlan, stepsKnown: !GuideMode);
        if (!preview.NeedsConfirmation) { await PrepareAsync(); return; }
        _preview = preview;
        _revealPreview = true;
    }

    private bool _revealPreview;

    /// <summary>Up to this many matching candidates every group starts open; above it only the first group does.</summary>
    private const int GroupsOpenUpTo = 40;
    private readonly Dictionary<string, bool> _groupOpen = new(StringComparer.Ordinal);

    /// <summary>Opens a case of the plan (Prepare test cases, the case expanded) — from a candidate that is already prepared.</summary>
    private void OpenCase(string id)
    {
        _openCases.Add(id);
        GoArea("prepare");
        _revealArea = true;
    }

    /// <summary>
    /// Writing a test case by hand is an advanced path: tests BirkNext did not discover are normally added in Azure DevOps Test Plans after the
    /// file is imported. It stays for linking a requirement before export; collapsed unless a title is being written (or a variant was started).
    /// </summary>
    private RenderFragment ManualCaseAdvanced(RenderFragment form) => __builder =>
    {
        <details class="tps-advanced" data-testid="tps-advanced-manual" open="@(!string.IsNullOrWhiteSpace(_manualTitle))">
            <summary>Advanced: write a test case by hand</summary>
            <p class="tps-muted tps-small" data-testid="tps-manual-where">Tests BirkNext did not find are normally added in Azure DevOps Test Plans after you import the exported file. Write one here only when it must be linked to a requirement in BirkNext before the export.</p>
            @form
        </details>
    };

    private RenderFragment ChooseManualForm => __builder =>
    {
        <div class="tps-actionbar tps-actionbar-compact" data-testid="tps-manual-bar">
            <label class="tps-field tps-field-grow"><span class="tps-k">Title</span><input class="tps-input" id="tps-manual-title" @bind="_manualTitle" @bind:event="oninput" placeholder="Title, e.g. Return a borrowed book" data-testid="tps-manual-title" /></label>
            <button type="button" class="tps-btn tps-btn-quiet" disabled="@(_busy || string.IsNullOrWhiteSpace(_manualTitle))" @onclick="AddManualAsync" data-testid="tps-manual-create">Add test case</button>
            @if (string.IsNullOrWhiteSpace(_manualTitle)) { <span class="tps-muted tps-small" data-testid="tps-manual-hint">Type a title to add a test case.</span> }
        </div>
    };

    private RenderFragment PrepareManualForm => __builder =>
    {
        <div class="tps-actionbar tps-actionbar-compact">
            <label class="tps-field tps-field-grow"><span class="tps-k">Title</span><input class="tps-input" @bind="_manualTitle" @bind:event="oninput" placeholder="Title of a new test case" data-testid="tps-manual-title" /></label>
            <button type="button" class="tps-btn tps-btn-quiet" disabled="@(_busy || _dirty || string.IsNullOrWhiteSpace(_manualTitle))" @onclick="AddManualAsync" data-testid="tps-manual-add">Add test case</button>
            @if (_dirty) { <span class="tps-muted tps-small" data-testid="tps-manual-hint">Save or discard your changes first.</span> }
