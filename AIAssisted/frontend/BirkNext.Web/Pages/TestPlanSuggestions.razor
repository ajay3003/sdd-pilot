    private string? _dropTarget;
    private string? _excludeScenario;
    private string _excludeReason = "";

    private void DragEnter(string target) { if (_drag is not null) _dropTarget = target; }

    /// <summary>A move never changes which scenario is open: the one shown open stays open.</summary>
    private void PinOpen(string? openKey) { if (!_scenarioChosen) { _scenarioChosen = true; _openScenario = openKey; } }
    private void DragEnd() { _drag = null; _dropTarget = null; }

    private void DropScenario(TestPlanDraft d, List<string> siblings, string targetKey)
    {
        if (_drag is ("scenario", var key, _) && key != targetKey && siblings.Contains(key))
            Change(PlanOrdering.MoveScenario(d, key, siblings, siblings.IndexOf(targetKey)));
        DragEnd();
    }

    private void DropCase(TestPlanDraft d, string targetId)
    {
        if (_drag is ("case", var key, _) && key != targetId)
        {
            var moving = d.Cases.FirstOrDefault(c => c.Source.ScenarioId == key);
            var target = d.Cases.FirstOrDefault(c => c.Source.ScenarioId == targetId);
            if (moving is not null && target is not null && (moving.ParentScenario ?? "") == (target.ParentScenario ?? ""))
            {
                var siblings = d.Cases.Where(c => (c.ParentScenario ?? "") == (target.ParentScenario ?? "")).Select(c => c.Source.ScenarioId).ToList();
                Change(PlanOrdering.MoveCase(d, key, siblings.IndexOf(targetId)));
            }
        }
        DragEnd();
    }

    private void DropStep(TestPlanDraft d, string sid, int targetIndex)
    {
        if (_drag is ("step", var key, var from) && key == sid && from != targetIndex)
            Change(P.WithCase(d, sid, x => PlanOrdering.MoveStep(x, from, targetIndex)));
        DragEnd();
    }

    private void RemoveScenario(TestPlanDraft d, ScenarioGroup g)
    {
        Change(PlanOrdering.RemoveScenario(d, g.Key));
        foreach (var c in g.Cases) _openCases.Remove(c.Source.ScenarioId);
        Info($"\"{g.Title}\" and its {g.Cases.Count} test case{(g.Cases.Count == 1 ? "" : "s")} are removed when you save. Earlier versions of the plan keep them.");
    }

    private async Task ExcludeScenarioAsync(ScenarioGroup g)
    {
        if (_draft is null || string.IsNullOrWhiteSpace(_excludeReason)) return;
        if (_dirty) { Fail("Save or discard your changes first."); return; }
        _busy = true;
        var (draft, error) = await _api!.ExcludeScenarioAsync(_draft.Id, new ExcludeScenarioRequest(_draft.Revision, g.Key, _excludeReason.Trim()));
        _busy = false;
        if (draft is null) { Fail(error ?? "The scenario could not be excluded."); return; }
        _draft = draft; _excludeScenario = null; _excludeReason = "";
        await ReloadWorkspaceAsync();
        Ok($"\"{g.Title}\" is excluded: its test cases stay in the plan with the reason, and none is exported.");
    }

