    /// <summary>A deliberate separate case for another data condition: written by hand, never a copy of the candidate record.</summary>
    private void StartVariant(DiscoveredScenario c)
    {
        _manualTitle = $"{c.Title} — variant";
        Info($"A separate case for \"{c.Title}\" is written by hand (for example another data condition). It is not linked to the candidate; edit the title and choose Add test case.");
    }

    private RenderFragment CandidateRow(DiscoveredScenario c, bool inPlan) => __builder =>
    {
        var id = c.CandidateId;
        var selected = _selected.Contains(id);
        var open = _openDetails.Contains(id);
        var warning = P.Warning(c);
        var owner = _inventory.Of(c);
        var otherWorkspace = _view == P.CandidateView.Manual ? null : owner.Primary;
        <li class="tps-row @(selected ? "is-selected" : null)" data-testid="tps-candidate-@id" data-workspace="@owner.Primary">
            <div class="tps-row-main">
                <label class="tps-row-select">
                    <input type="checkbox" checked="@selected" @onchange="e => { if (e.Value is true) _selected.Add(id); else _selected.Remove(id); _preview = null; }" aria-describedby="tps-sum-@id" data-testid="tps-select-@id" />
                    <span class="tps-row-title">@c.Title</span>
                </label>
                <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" aria-expanded="@(open ? "true" : "false")" aria-controls="tps-cd-@id" @onclick="() => { if (!_openDetails.Remove(id)) _openDetails.Add(id); }" data-testid="tps-details-@id">@(open ? "Hide details" : "Details")</button>
            </div>
            <p class="tps-row-sum" id="tps-sum-@id">@c.Purpose</p>
            <div class="tps-row-meta">
                <span class="tps-chip" data-testid="tps-kind">@owner.SourceKind</span>
                <span class="tps-chip tps-chip-quiet" data-testid="tps-type">@ScenarioCandidateTypes.Label(c.Type)</span>
                @if (c.Area is { Length: > 0 } area) { <span class="tps-row-area" data-testid="tps-area">@area</span> }
                @if (otherWorkspace == TestingWorkspace.TechnicalTesting) { <span class="tps-chip tps-chip-info" data-testid="tps-workspace">Technical Testing</span> }
                @if (inPlan) { <span class="tps-chip tps-chip-ok" data-testid="tps-in-draft">In the plan</span> }
                @if (c.ExistingTests.Count > 0) { <span class="tps-chip tps-chip-quiet" data-testid="tps-existing-tests" title="Associated through an explicit requirement reference; not an executed manual test">@c.ExistingTests.Count source test@(c.ExistingTests.Count == 1 ? "" : "s")</span> }
                @if (warning is not null) { <span class="tps-chip tps-chip-warn" data-testid="tps-attention">@warning</span> }
                @if (!GuideMode && owner.ManualRelevant && P.StepGap(c) is { } stepGap) { <span class="tps-chip tps-chip-quiet" data-testid="tps-step-gap" title="Write these before approving: the Azure DevOps export needs at least one step and an expected result on every step">@stepGap</span> }
            </div>
            @if (open)
            {
                var handoff = P.HandoffOf(c, owner);
                var sameOperation = _inventory.SameOperation(c);
                <dl class="tps-dl tps-candidate-details" id="tps-cd-@id" data-testid="tps-candidate-details-@id">
                    <dt>Where to test</dt>
                    <dd data-testid="tps-ownership"><strong>@ScenarioOwnership.WorkspaceLabel(owner.Primary)</strong>@(owner.Secondary is { } second ? $" · also {ScenarioOwnership.WorkspaceLabel(second)} when chosen" : "") — @ScenarioOwnership.PurposeLabel(owner.Purpose).
                        <span class="tps-muted">@owner.Basis</span>
                        @if (handoff is not null)
                        {
                            <span class="tps-handoff"><a href="@handoff.Href" data-testid="tps-handoff">@handoff.Label</a> <span class="tps-muted tps-small">@handoff.Carries</span></span>
                        }
                    </dd>
                    @if (inPlan)
                    {
                        <dt>Existing case</dt>
                        <dd data-testid="tps-existing-case">Already prepared in this plan. <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" @onclick="() => OpenCase(id)" data-testid="tps-open-case">Open existing case</button>
                            @if (CanWrite && !GuideMode) { <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" @onclick="() => StartVariant(c)" data-testid="tps-add-variant">Write a separate case by hand</button> <span class="tps-muted tps-small">A second case is legitimate for another data condition; it is not linked to this candidate.</span> }
                        </dd>
                    }
                    <dt>Expected behaviour</dt><dd data-testid="tps-expected">@(c.ExpectedBehaviour is { } eb ? $"{eb}{(c.ExpectedBasis is { } basis ? $" ({basis})" : "")}" : "Needs clarification — the evidence states no expected outcome.")</dd>
                    @if (c.Steps.Count > 0) { <dt>Steps in the evidence</dt><dd><ol class="tps-plain">@foreach (var s in c.Steps) { <li>@s.Action — <span class="tps-muted">@(s.Expected ?? "expected result not stated")</span></li> }</ol></dd> }
                    @if (c.RequirementIds.Count > 0) { <dt>Requirements</dt><dd>@string.Join(", ", c.RequirementIds)</dd> }
                    @if (c.TestDataNeeds.Count > 0) { <dt>Test Data</dt><dd>@string.Join("; ", c.TestDataNeeds)</dd> }
                    <dt>Existing tests</dt><dd>@(c.ExistingTests.Count == 0 ? "None associated (only explicit references count)" : string.Join("; ", c.ExistingTests.Select(t => $"{t.Name}{(t.Confirmed ? "" : " (candidate — needs review)")}")) + " — source tests, not executed manual tests.")</dd>
                    <dt>Source</dt><dd>@c.SourceCategory · @(c.Area ?? "no area stated") · @c.Engine@(string.IsNullOrEmpty(c.RuleVersion) ? "" : $" · rules {c.RuleVersion}") · @ScenarioCandidateTypes.ConfidenceLabel(c.Confidence)</dd>
                    <dt>Evidence</dt><dd><ul class="tps-plain">@foreach (var e in c.Evidence.Take(8))
                        {
                            @* A run is named by what it showed, not by its internal id. *@
                            if (e.Kind == "journey-run") { <li data-testid="tps-evidence-run">Integration journey run — @e.Detail</li> }
                            else { <li><code>@e.Reference</code>@(e.Detail is { } detail ? $" — {detail}" : "")</li> }
                        }</ul></dd>
                    @if (sameOperation.Count > 0)
                    {
                        <dt>Same operation in</dt>
                        <dd data-testid="tps-same-operation">@sameOperation.Count other contract file@(sameOperation.Count == 1 ? "" : "s"): @string.Join("; ", sameOperation.Take(6).Select(o => _candidates.FirstOrDefault(x => x.CandidateId == o) is { } other ? ScenarioOwnership.ContractFile(other) ?? other.Title : o))
                            <span class="tps-muted">(same operation and signature — related, kept separate; prepare one unless the files differ on purpose)</span></dd>
                    }
                    @if (c.PossibleDuplicates.Count > 0) { <dt>Related candidates</dt><dd data-testid="tps-possible-duplicates">@string.Join("; ", c.PossibleDuplicates.Select(d => _candidates.FirstOrDefault(x => x.CandidateId == d)?.Title ?? d)) <span class="tps-muted">(same requirement, different source — kept separate)</span></dd> }
                    @if (c.Gaps.Count > 0)
                    {
                        @* What is still open, classified: who resolves it and the supported next step. A missing prerequisite or observation is not an
                           unclear expectation; static evidence is never a run. *@
                        <dt>What is still open</dt>
                        <dd><ul class="tps-plain tps-gaps" data-testid="tps-gaps">
                            @foreach (var g in c.Gaps)
                            {
                                <li data-testid="tps-gap" data-kind="@g.Kind"><strong>@EvidenceGaps.Label(g.Kind)</strong> — @g.Question
                                    @if (g.Basis is { } gb) { <span class="tps-muted"> (@gb)</span> }
                                    @if (g.NextAction is { } next) { <span class="tps-gap-next" data-testid="tps-gap-next"> Next: @next</span> }
                                    <span class="tps-muted tps-small"> · @EvidenceGaps.Owner(g.Kind)</span></li>
                            }
                        </ul></dd>
                    }
                    else if (c.OpenQuestions.Count > 0) { <dt>Open questions</dt><dd><ul class="tps-plain">@foreach (var q in c.OpenQuestions) { <li>@q</li> }</ul></dd> }
                    @if (c.SourcesChecked.Count > 0)
                    {
                        <dt>Sources checked</dt>
                        <dd><ul class="tps-plain" data-testid="tps-sources-checked">@foreach (var sc in c.SourcesChecked) { <li data-found="@(sc.Found ? "true" : "false")"><strong>@sc.Source</strong> — @sc.Detail</li> }</ul></dd>
                    }
                </dl>
            }
        </li>
    };

    private static string? Empty(ChangeEventArgs e) => string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString();

    private async Task PrepareAsync()
    {
        if (_dirty) { Fail("Save or discard your changes first."); return; }
        _busy = true;
        TestPlanDraft? draft; string? error;
        if (GuideMode)
        {
            (draft, error) = _draft is null
                ? await _api!.CreateAsync(new CreateTestPlanDraftRequest(_guideKey!, $"{_ws?.Guides.FirstOrDefault(g => g.GuideKey == _guideKey)?.Title ?? _guideKey} – test plan", null, [.. _selected]))
                : await _api!.SaveAsync(_draft.Id, P.ToSaveRequest(_draft, _selected));
        }
        else
        {
            (draft, error) = await _api!.CreateProjectAsync(new CreateProjectTestPlanRequest
            {
                ProjectKey = _projectKey!, ProjectName = _projectName, DiscoveryId = _discovery?.DiscoveryId ?? "", CandidateIds = [.. _selected],
                DraftId = _draft?.Id, BaseRevision = _draft?.Revision,
            });
        }
        _busy = false;
        if (draft is null) { Fail(error ?? "The test cases could not be prepared."); return; }
        var count = _selected.Count;
        _draft = draft; _dirty = false; _selected.Clear(); _preview = null;
        _planName = draft.PlanName; _deliveryLabel = draft.DeliveryLabel ?? "";
        await ReloadWorkspaceAsync();
        GoArea("prepare");
        Ok($"{count} scenario{(count == 1 ? "" : "s")} prepared as test cases. Review them before use.");
    }

    private async Task AddManualAsync()
    {
        if (_dirty) { Fail("Save or discard your changes first."); return; }
        _busy = true;
        var (draft, error) = _draft is null
            ? await _api!.CreateProjectAsync(new CreateProjectTestPlanRequest { ProjectKey = _projectKey!, ProjectName = _projectName, ManualCaseTitle = _manualTitle })
            : await _api!.AddManualCaseAsync(_draft.Id, new AddManualTestCaseRequest(_draft.Revision, _manualTitle, null, null));
        _busy = false;
        if (draft is null) { Fail(error ?? "The test case could not be added."); return; }
        _draft = draft; _dirty = false; _manualTitle = "";
        await ReloadWorkspaceAsync();
        var added = draft.Cases[^1].Source.ScenarioId;
        _openCases.Add(added);
        _focusNewStep = added;
        GoArea("prepare");
        Ok("Test case added. Write its first step and expected result, then the case's expected result, and save.");
    }

    // ── Step 2: Prepare test cases ───────────────────────────────────────────────────────────────────────────

    private RenderFragment NoDraft() => __builder =>
    {
        <section class="tps-empty" data-testid="tps-no-draft"><h2>No test cases yet</h2><p>Choose scenarios and prepare them.</p>
            <button type="button" class="tps-btn" @onclick="@(() => GoArea("choose"))">Choose scenarios</button></section>
    };

    private RenderFragment PrepareArea() => __builder =>
    {
        if (_draft is not { } d) { __builder.AddContent(0, NoDraft()); return; }
        <section class="tps-section" data-testid="tps-prepare-step" aria-labelledby="tps-prepare-h">
            <div class="tps-section-head">
                <h2 id="tps-prepare-h" class="tps-h2">Prepare test cases <span class="tps-count">@d.Cases.Count(c => c.Review == TestCaseReviewState.Accepted) of @d.Cases.Count accepted</span></h2>
                <p class="tps-muted">What came from the evidence stays as it was; your changes are kept separately and never overwritten when scenarios are discovered again. A missing expected result stays <strong>Needs clarification</strong> until someone states it.</p>
            </div>
            @if (d.Cases.Any(c => c.SourceChanged))
            {
                <p class="tps-note tps-note-warn" data-testid="tps-source-changed" role="status"><strong>@d.Cases.Count(c => c.SourceChanged) scenario(s) changed in the evidence</strong> since these cases were prepared. Nothing was changed here.
                    @if (CanWrite) { <button type="button" class="tps-btn tps-btn-quiet" disabled="@_busy" @onclick="RefreshAsync" data-testid="tps-refresh">@(d.ProjectKey is null ? "Create new revision from the current guide" : "Update from the latest discovery (keeps your edits)")</button> }</p>
            }
            @foreach (var suite in d.Suites)
            {
                var cases = d.Cases.Where(c => c.SuiteId == suite.Id).ToList();
                if (cases.Count == 0) continue;
                <section class="tps-suite" data-testid="tps-suite" data-suite="@suite.Id" aria-label="Suite @suite.Name">
                    <div class="tps-suite-head">
                        @if (CanWrite) { <input class="tps-input tps-suite-name" value="@suite.Name" aria-label="Suite name" @onchange="e => RenameSuite(suite.Id, e.Value?.ToString())" /> }
                        else { <h3 class="tps-h3">@suite.Name</h3> }
                        <span class="tps-count">@cases.Count</span>
                    </div>
                    <ul class="tps-cases">@foreach (var c in cases) { @CaseEditor(d, c) }</ul>
                </section>
            }
            @if (CanWrite)
            {
                <div class="tps-actionbar">@SaveBar()</div>
                @* Suites group cases inside BirkNext; in Azure DevOps the suite is chosen when the file is imported. *@
                <details class="tps-advanced" data-testid="tps-advanced-suite">
                    <summary>Advanced: add a suite</summary>
                    <div class="tps-actionbar tps-actionbar-compact">
                        <label class="tps-field"><span class="tps-k">New suite</span><input class="tps-input" @bind="_newSuite" @bind:event="oninput" placeholder="Suite name" /></label>
                        <button type="button" class="tps-btn tps-btn-quiet" disabled="@string.IsNullOrWhiteSpace(_newSuite)" @onclick="AddSuite">Add suite</button>
                    </div>
                </details>
                @if (d.ProjectKey is not null)
                {
                    @ManualCaseAdvanced(PrepareManualForm)
                }
            }
        </section>
    };

    private RenderFragment CaseEditor(TestPlanDraft d, TestCaseDraft c) => __builder =>
    {
        var sid = c.Source.ScenarioId;
        var open = _openCases.Contains(sid);
        var review = P.Review(c.Review);
        var expected = P.Expected(c);
        var stepResults = c.EffectiveStepExpected;
        <li class="tps-case @(open ? "is-open" : null)" data-testid="tps-case-@sid">
            <button type="button" class="tps-case-head" aria-expanded="@(open ? "true" : "false")" @onclick="() => ToggleCase(sid)">
                <span class="tps-card-title">@c.EffectiveTitle</span>
                <span class="tps-chip">@P.TypeLabel(c.EffectiveType)</span>
                <span class="tps-tone tps-tone-@review.Tone" data-testid="tps-case-review">@review.Text</span>
                <span class="tps-tone tps-tone-@expected.Tone">Expected: @expected.Text</span>
                @if (c.SourceChanged) { <span class="tps-tone tps-tone-warn">Changed in the evidence</span> }
            </button>
            @if (open)
            {
                <div class="tps-case-body">
                    <dl class="tps-dl" data-testid="tps-generated-@sid">
                        <dt>Purpose</dt><dd>@c.EffectivePurpose</dd>
                        @* MT-7: a guide's rule ids are its business rules, never called specification requirements; project cases carry specification ids. *@
                        @if (c.Source.Kind == ScenarioSourceKind.SystemGuide && c.Generated.Requirements.Count == 0) { <dt>Business rules (guide)</dt><dd class="tps-muted">No business rule in the guide names this scenario.</dd> }
                        @if (c.Generated.Requirements.Count > 0) { <dt>@(c.Source.Kind == ScenarioSourceKind.SystemGuide ? "Business rules (guide)" : "Requirements")</dt><dd><ul class="tps-plain">@foreach (var r in c.Generated.Requirements) { <li><strong>@r.Title</strong>@(r.ExpectedBehavior is { } eb ? $": {eb}" : "") <span class="tps-muted">(@r.RuleId)</span></li> }</ul></dd> }
                        @SpecificationRequirements(c)
                        @if (c.Generated.Template.Count > 0)
                        {
                            <dt>@(P.TypeLabel(c.EffectiveType)) details</dt>
                            <dd><ul class="tps-plain" data-testid="tps-template-@sid">@foreach (var t in c.Generated.Template)
                                {
                                    var human = c.Edits.TemplateValues?.GetValueOrDefault(t.Key);
                                    var key = t.Key;
                                    <li><strong>@t.Label:</strong> @(t.Value ?? "Not in the evidence")
                                        @if (CanWrite && t.Value is null) { <input class="tps-input tps-input-sm" value="@human" placeholder="Add if known" aria-label="@t.Label" @onchange="e => Change(P.WithCase(d, sid, x => x with { Edits = x.Edits with { TemplateValues = WithTemplate(x.Edits.TemplateValues, key, e.Value?.ToString()) } }))" data-testid="@($"tps-template-{sid}-{key}")" /> }
                                        else if (human is not null) { <span class="tps-chip tps-chip-ok">Added: @human</span> }
                                    </li>
                                }</ul></dd>
                        }
                        @if (c.Generated.FailureCases.Count > 0) { <dt>Failure cases</dt><dd>@string.Join(" · ", c.Generated.FailureCases)</dd> }
                        @if (c.Generated.ExistingTests.Count > 0) { <dt>Existing tests</dt><dd>@string.Join("; ", c.Generated.ExistingTests.Select(t => t.Name)) <span class="tps-muted">(explicit requirement references)</span></dd> }
                        else if (c.Generated.NamedExistingTests.Count > 0) { <dt>Tests the guide names</dt><dd>@string.Join(" · ", c.Generated.NamedExistingTests) <span class="tps-muted">(names, not verified identities)</span></dd> }
                        <dt>Evidence</dt><dd class="tps-small" data-testid="tps-evidence-@sid">
                            @if (c.Generated.Evidence.Count > 0) { @string.Join(" · ", c.Generated.Evidence.Take(6).Select(e => e.Reference)) }
                            else if (c.Source.Kind == ScenarioSourceKind.Manual) { <span>Written by hand — no discovered evidence.</span> }
                            else { <span>@c.Source.Owner · @sid@(c.Source.Revision is { } rev ? $" · guide revision {rev}" : "")</span> }
                            @if (c.Generated.Confidence is { } conf) { <span class="tps-muted"> · @ScenarioCandidateTypes.ConfidenceLabel(conf)</span> }</dd>
                    </dl>
                    @LinkedRequirements(d, c, sid)
                    @if (CanWrite)
                    {
                        @* Locked while a request is in flight, so a late response can never replace an edit made meanwhile. *@
                        <fieldset class="tps-fieldset" disabled="@_busy">
                        <div class="tps-edit-grid">
                            @EditField(c, "Title", c.Generated.Title, c.EffectiveTitle, v => c with { Edits = c.Edits with { Title = P.TextEdit(c.Generated.Title, v) } }, false, "title")
                            @EditField(c, "Preconditions", c.Generated.Preconditions, c.EffectivePreconditions, v => c with { Edits = c.Edits with { Preconditions = P.TextEdit(c.Generated.Preconditions, v) } }, true, "preconditions")
                        </div>
                        <div class="tps-steps" data-testid="tps-steps-@sid">
                            <span class="tps-k">Steps @if (c.Edits.Steps is not null) { <span class="tps-chip tps-chip-ok">Edited</span> } else if (c.Generated.Steps.Count == 0) { <span class="tps-chip tps-chip-bad">Not in source</span> }</span>
                            <ol class="tps-step-list">
                                @for (var i = 0; i < c.EffectiveSteps.Count; i++)
                                {
                                    var index = i;
                                    <li class="tps-step-row" data-testid="@($"tps-step-{sid}-{index}")">
                                        <input class="tps-input" value="@c.EffectiveSteps[index]" aria-label="Step @(index + 1) action" @onchange="e => Change(P.WithCase(d, sid, x => P.SetStep(x, index, e.Value?.ToString() ?? x.EffectiveSteps[index], null)))" data-testid="@($"tps-step-action-{sid}-{index}")" />
                                        <input class="tps-input" value="@stepResults[index]" placeholder="Needs clarification — expected result not stated" aria-label="Step @(index + 1) expected result" @onchange="e => Change(P.WithCase(d, sid, x => P.SetStep(x, index, null, e.Value?.ToString() ?? string.Empty)))" data-testid="@($"tps-step-expected-{sid}-{index}")" />
                                        <span class="tps-step-tools">
                                            <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" disabled="@(index == 0)" aria-label="Move step @(index + 1) up" @onclick="() => Change(P.WithCase(d, sid, x => P.MoveStep(x, index, -1)))" data-testid="@($"tps-step-up-{sid}-{index}")">↑</button>
                                            <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" disabled="@(index == c.EffectiveSteps.Count - 1)" aria-label="Move step @(index + 1) down" @onclick="() => Change(P.WithCase(d, sid, x => P.MoveStep(x, index, 1)))" data-testid="@($"tps-step-down-{sid}-{index}")">↓</button>
                                            <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" aria-label="Remove step @(index + 1)" @onclick="() => Change(P.WithCase(d, sid, x => P.RemoveStep(x, index)))" data-testid="@($"tps-step-remove-{sid}-{index}")">Remove</button>
                                        </span>
                                        @if (stepResults[index] is null) { <span class="tps-chip tps-chip-warn">Needs clarification</span> }
                                    </li>
                                }
                            </ol>
                            @if (c.EffectiveSteps.Count == 0)
                            {
                                <p class="tps-muted tps-small" data-testid="@($"tps-steps-empty-{sid}")">No steps yet. Write the first step and what should happen, then choose Add step — a test case needs at least one step with its expected result before it can be approved.</p>
                            }
                            <div class="tps-actionbar tps-step-new-row">
                                <input class="tps-input" id="@($"tps-step-new-{sid}")" value="@_newStep.GetValueOrDefault(sid)" placeholder="@(c.EffectiveSteps.Count == 0 ? "First step: what the tester does" : "New step action")" aria-label="New step action" @oninput="e => _newStep[sid] = e.Value?.ToString() ?? string.Empty" data-testid="@($"tps-step-new-{sid}")" />
                                <input class="tps-input" value="@_newStepExpected.GetValueOrDefault(sid)" placeholder="Expected result of this step" aria-label="New step expected result" @oninput="e => _newStepExpected[sid] = e.Value?.ToString() ?? string.Empty" data-testid="@($"tps-step-new-expected-{sid}")" />
                                <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" disabled="@string.IsNullOrWhiteSpace(_newStep.GetValueOrDefault(sid))" @onclick="() => AddStep(d, sid)" data-testid="@($"tps-step-add-{sid}")">Add step</button>
                            </div>
                        </div>
                        <div class="tps-edit-grid">
                            @EditField(c, "Priority", null, c.Edits.Priority, v => c with { Edits = c.Edits with { Priority = P.TextEdit(null, v) } }, false, "priority")
                        </div>
                        @* What reaches the Azure DevOps file is shown above (title, preconditions, steps with their expected results, priority; requirements
                           and Test Data go to the mapping report). The rest is BirkNext's own planning detail: kept, never lost, and collapsed. *@
                        <details class="tps-more" data-testid="tps-more-fields-@sid">
                        <summary>More fields <span class="tps-muted tps-small">— kept in BirkNext, not exported to Azure DevOps</span></summary>
                        <div class="tps-edit-grid">
                            @EditField(c, "Purpose", c.Generated.Purpose, c.EffectivePurpose, v => c with { Edits = c.Edits with { Purpose = P.TextEdit(c.Generated.Purpose, v) } }, true, "purpose")
                            @EditField(c, "Expected result of the whole case", c.Generated.ExpectedResult, c.EffectiveExpected, v => c with { Edits = c.Edits with { ExpectedResult = P.TextEdit(c.Generated.ExpectedResult, v) } }, true, "expected")
                            @EditField(c, "Environment and prerequisites", c.Generated.EnvironmentPrerequisites, c.EffectiveEnvironment, v => c with { Edits = c.Edits with { EnvironmentPrerequisites = P.TextEdit(c.Generated.EnvironmentPrerequisites, v) } }, true, "environment")
                            @EditField(c, "Roles and access", null, c.Edits.Roles, v => c with { Edits = c.Edits with { Roles = P.TextEdit(null, v) } }, false, "roles")
                            @EditField(c, "Dependencies", null, c.Edits.Dependencies, v => c with { Edits = c.Edits with { Dependencies = P.TextEdit(null, v) } }, false, "dependencies")
                            <label class="tps-field"><span class="tps-k">Risk</span>
                                <select class="tps-input" @onchange="e => Change(P.WithCase(d, sid, x => x with { Risk = Enum.TryParse<TestCaseRisk>(e.Value?.ToString(), out var r) ? r : x.Risk }))" data-testid="tps-risk-@sid">
                                    @foreach (var r in Enum.GetValues<TestCaseRisk>()) { <option value="@r" selected="@(r == c.Risk)">@(r == TestCaseRisk.NotAssessed ? "Not assessed" : r.ToString())</option> }
                                </select></label>
                            @* Test type and execution method are separate choices: a performance case is not automated by type, a functional case not manual. *@
                            <label class="tps-field"><span class="tps-k">Test type</span>
                                <select class="tps-input" @onchange="e => Change(P.WithCase(d, sid, x => x with { Edits = x.Edits with { TestType = Enum.TryParse<TestCaseType>(e.Value?.ToString(), out var t) && t != TestCaseType.NotClassified ? t : null } }))" data-testid="tps-type-@sid">
                                    @foreach (var t in Enum.GetValues<TestCaseType>()) { <option value="@t" selected="@(t == c.EffectiveType)">@P.TypeLabel(t)</option> }
                                </select></label>
                            <label class="tps-field"><span class="tps-k">Execution method</span>
                                <select class="tps-input" @onchange="e => Change(P.WithCase(d, sid, x => x with { Edits = x.Edits with { ExecutionMethod = Enum.TryParse<TestExecutionMethod>(e.Value?.ToString(), out var m) && m != TestExecutionMethod.NotDecided ? m : null } }))" data-testid="tps-method-@sid">
                                    @foreach (var m in Enum.GetValues<TestExecutionMethod>()) { <option value="@m" selected="@(m == c.EffectiveExecutionMethod)">@P.MethodLabel(m)</option> }
                                </select></label>
                            <label class="tps-field"><span class="tps-k">Suite</span>
                                <select class="tps-input" aria-label="Move @c.EffectiveTitle to suite" @onchange="e => Change(P.WithCase(d, sid, x => x with { SuiteId = e.Value?.ToString() ?? x.SuiteId }))" data-testid="tps-suite-@sid">
                                    @foreach (var s in d.Suites) { <option value="@s.Id" selected="@(s.Id == c.SuiteId)">@s.Name</option> }
                                </select></label>
                        </div>
                        @if (c.EffectiveType == TestCaseType.Performance) { @PerformanceFields(d, c, sid) }
                        </details>
                        <div class="tps-actionbar">@SaveBar()</div>
                        </fieldset>
                        @if (_dirty) { <p class="tps-muted tps-small" data-testid="tps-review-needs-save">Save or discard your changes before recording a review decision.</p> }
                        <div class="tps-review-bar" role="group" aria-label="Review decision for @c.EffectiveTitle">
                            <label class="tps-field tps-field-grow"><span class="tps-k">Rationale</span><input class="tps-input" value="@_rationale.GetValueOrDefault(sid)" @oninput="e => SetRationale(sid, e)" placeholder="Why (required to exclude or ask for clarification)" data-testid="tps-rationale-@sid" /></label>
                            <button type="button" class="tps-btn tps-btn-quiet" disabled="@(_busy || _dirty)" @onclick="() => ReviewAsync(sid, TestCaseReviewState.NeedsClarification)" data-testid="tps-clarify-@sid">Needs clarification</button>
                            <button type="button" class="tps-btn tps-btn-quiet" disabled="@(_busy || _dirty)" @onclick="() => ReviewAsync(sid, TestCaseReviewState.Excluded)" data-testid="tps-exclude-@sid">Exclude</button>
                            @{ var approveBlocker = P.ApproveBlocker(c); }
                            <button type="button" class="tps-btn" disabled="@(_busy || _dirty || approveBlocker is not null)" @onclick="() => ReviewAsync(sid, TestCaseReviewState.Accepted)" data-testid="tps-accept-@sid" title="@(_dirty ? "Save your changes first" : approveBlocker ?? "Approved cases are exported to Azure DevOps")">Approve</button>
                        </div>
                        @if (!_dirty && approveBlocker is not null && c.Review != TestCaseReviewState.Accepted) { <p class="tps-muted tps-small" data-testid="tps-approve-why-@sid">To approve: @approveBlocker</p> }
                    }
                    else
                    {
                        <dl class="tps-dl"><dt>Expected</dt><dd>@(c.EffectiveExpected ?? "NEEDS CLARIFICATION")</dd><dt>Steps</dt><dd><ol>@for (var i = 0; i < c.EffectiveSteps.Count; i++) { <li>@c.EffectiveSteps[i] — <span class="tps-muted">@(stepResults[i] ?? "Needs clarification")</span></li> }</ol></dd></dl>
                    }
                    @if (c.Missing.Count > 0) { <ul class="tps-blockers" data-testid="tps-open-@sid">@foreach (var m in c.Missing) { <li>@m</li> }</ul> }
                    @if (c.EditHistory.Count > 0)
                    {
                        <div class="tps-history" data-testid="tps-edit-history-@sid"><span class="tps-k">Change history</span>
                            <ol class="tps-plain">@foreach (var ev in c.EditHistory.TakeLast(10)) { <li>@ev.Editor · @ev.At.ToLocalTime().ToString("yyyy-MM-dd HH:mm") — @string.Join(", ", ev.Fields)</li> }</ol></div>
                    }
                    @if (c.ReviewHistory.Count > 0)
                    {
                        <div class="tps-history" data-testid="tps-history-@sid"><span class="tps-k">Review history</span>
                            <ol class="tps-plain">@foreach (var ev in c.ReviewHistory) { <li><strong>@P.Review(ev.State).Text</strong> · @ev.Reviewer · @ev.At.ToLocalTime().ToString("yyyy-MM-dd HH:mm")@(ev.Rationale is { } why ? $" — {why}" : "")</li> }</ol></div>
                    }
                </div>
            }
        </li>
    };

    private static Dictionary<string, string>? WithTemplate(Dictionary<string, string>? values, string key, string? value)
    {
        var next = new Dictionary<string, string>(values ?? [], StringComparer.Ordinal);
        if (string.IsNullOrWhiteSpace(value)) next.Remove(key); else next[key] = value.Trim();
        return next.Count == 0 ? null : next;
    }

    private void AddStep(TestPlanDraft d, string sid)
    {
        if (_newStep.GetValueOrDefault(sid) is not { Length: > 0 } action) return;
        Change(P.WithCase(d, sid, x => P.AddStep(x, action.Trim(), _newStepExpected.GetValueOrDefault(sid))));
        _newStep.Remove(sid);
        _newStepExpected.Remove(sid);
    }

    /// <summary>"Linked requirements" of a project case: automatic (the case's own evidence) and manual (a tester's link) side by side, each checked
    /// against the project's current specification; search and link only requirements that exist in it. Saved with the draft.</summary>
    private RenderFragment LinkedRequirements(TestPlanDraft d, TestCaseDraft c, string sid) => __builder =>
    {
        if (d.ProjectKey is null) return; // guide plans: MT-7 associations (Specification requirements above) own this
        var rows = L.Rows(c, _requirements);
        var query = _requirementQuery.GetValueOrDefault(sid) ?? string.Empty;
        <section class="tps-links" aria-labelledby="@($"tps-links-title-{sid}")" data-testid="@($"tps-links-{sid}")">
            <h4 id="@($"tps-links-title-{sid}")" class="tps-links-title">Linked requirements</h4>
            @if (rows.Count == 0)
            {
                <p class="tps-muted tps-small" data-testid="tps-links-none">No requirement is linked yet. The case is still listed in Test Coverage, but it does not count for any requirement until it is linked.</p>
            }
            else
            {
                <ul class="tps-link-list" data-testid="tps-links-list">
                    @foreach (var row in rows)
                    {
                        <li class="tps-link-row" data-testid="tps-link" data-requirement="@row.RequirementId" data-origin="@(row.Automatic && row.Manual ? "both" : row.Manual ? "manual" : "automatic")">
                            <span class="tps-link-text"><strong>@row.RequirementId</strong> @row.Title</span>
                            <span class="tps-chip @(row.Manual ? "tps-chip-ok" : null)" data-testid="tps-link-origin">@row.Origin</span>
                            <span class="tps-tone tps-tone-@row.Tone" data-testid="tps-link-validity">@row.Validity</span>
                            @if (row.Manual && !row.Saved) { <span class="tps-tone tps-tone-warn" data-testid="tps-link-unsaved">Not saved yet</span> }
                            else if (row.Manual && row.LinkedBy is { } who) { <span class="tps-muted tps-small" data-testid="tps-link-by">Linked by @who@(row.LinkedAt is { } at ? $", {at.ToLocalTime():yyyy-MM-dd}" : "")</span> }
                            @if (CanWrite && row.Manual)
                            {
                                <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" disabled="@_busy" aria-label="@($"Remove the manual link to {row.RequirementId}")"
                                    @onclick="() => Change(P.WithCase(d, sid, x => L.Unlink(x, row.RequirementId, row.SpecificationPath)))" data-testid="tps-link-remove">Remove link</button>
                                @if (row.Automatic) { <span class="tps-muted tps-small">Removing the manual link keeps the automatic one.</span> }
                            }
                        </li>
                    }
                </ul>
            }
            @if (CanWrite)
            {
                @if (_requirements is not { Count: > 0 } options)
                {
                    <p class="tps-muted tps-small" data-testid="tps-links-unavailable">@(_requirementsNote ?? "The project's specification could not be read, so requirements cannot be linked right now.")</p>
                }
                else
                {
                    var matches = L.Search(options, c, query);
                    <label class="tps-field tps-link-search"><span class="tps-k">Find a requirement to link</span>
                        <input type="search" class="tps-input" value="@query" placeholder="Type an id such as FR-001 or words from the requirement" autocomplete="off"
                            @oninput="e => _requirementQuery[sid] = e.Value?.ToString() ?? string.Empty" data-testid="@($"tps-link-search-{sid}")" /></label>
                    @if (matches.Count == 0)
                    {
                        <p class="tps-muted tps-small" data-testid="tps-link-nomatch">@(query.Length == 0 ? "Every requirement of the specification is already linked." : "No requirement of this project matches. Only requirements in the project's specification can be linked.")</p>
                    }
                    else
                    {
                        <ul class="tps-link-options" aria-label="Matching requirements" data-testid="tps-link-options">
                            @foreach (var o in matches)
                            {
                                <li><button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" disabled="@_busy" aria-label="@($"Link {o.RequirementId}: {o.Title}")"
                                        @onclick="() => Change(P.WithCase(d, sid, x => L.Link(x, o)))" data-testid="tps-link-add" data-requirement="@o.RequirementId">Link</button>
                                    <span><strong>@o.RequirementId</strong> @o.Title</span></li>
                            }
                        </ul>
                    }
                    <p class="tps-muted tps-small">A link says this case is designed to test the requirement. It is not an execution and not a pass. Save the draft to keep your links.</p>
                }
            }
        </section>
    };

    private RenderFragment SpecificationRequirements(TestCaseDraft c) => __builder =>
    {
        if (c.Source.Kind != ScenarioSourceKind.SystemGuide) return; // MT-7 associations exist for guide scenarios only
        var (verified, suggested, rejected) = RequirementCoveragePresentation.ForScenario(_coverage, c.Source.Owner, c.Source.ScenarioId);
        <dt>Specification requirements</dt>
        <dd class="tps-spec" data-testid="tps-spec-requirements">
            @if (_coverageNote is not null) { <span class="tps-muted" data-testid="tps-spec-unknown">@_coverageNote</span> }
            else if (verified.Count + suggested.Count + rejected.Count == 0) { <span class="tps-muted" data-testid="tps-spec-none">No association to a specification requirement: the guide names none and no named test verifies one.</span> }
            else
            {
                @if (verified.Count > 0)
                {
                    <ul class="tps-plain" data-testid="tps-spec-verified">@foreach (var a in verified) { <li><strong>@RequirementCoveragePresentation.Requirement(a)</strong> <span class="tps-tone tps-tone-info">@RequirementCoveragePresentation.TrustLabel(a.Trust)</span>@(a.Reviewer is { } who ? $" · {who}, {a.DecidedAt?.ToLocalTime():yyyy-MM-dd}" : "")</li> }</ul>
                }
                @if (suggested.Count > 0)
                {
                    <p class="tps-k tps-small">Suggested — not verified, not counted</p>
                    <ul class="tps-plain" data-testid="tps-spec-suggested">@foreach (var a in suggested) { <li>@RequirementCoveragePresentation.Requirement(a) <span class="tps-tone tps-tone-warn">@RequirementCoveragePresentation.RuleLabel(a.RuleId)</span></li> }</ul>
                    <a href="@RequirementCoveragePresentation.RelationshipReviewHref" data-testid="tps-spec-decide">Decide these associations in Relationship Review</a>
                }
                @if (rejected.Count > 0) { <p class="tps-muted tps-small" data-testid="tps-spec-rejected">Rejected in Relationship Review: @string.Join(", ", rejected.Select(RequirementCoveragePresentation.Requirement))</p> }
                <p class="tps-muted tps-small">Accepting this Test Case for preparation does not approve any requirement association.</p>
            }
        </dd>
    };

    private void RenameSuite(string id, string? name)
    {
        if (_draft is null || string.IsNullOrWhiteSpace(name)) return;
        Change(_draft with { Suites = [.. _draft.Suites.Select(s => s.Id == id ? s with { Name = name.Trim() } : s)] });
    }

    private void AddSuite()
    {
        if (_draft is null || string.IsNullOrWhiteSpace(_newSuite)) return;
        Change(_draft with { Suites = [.. _draft.Suites, new TestSuiteDraft("suite:r-" + Guid.NewGuid().ToString("N")[..8], _newSuite.Trim(), "reviewer", null)] });
        _newSuite = "";
    }

    private RenderFragment SaveBar() => __builder =>
    {
        <button type="button" class="tps-btn" disabled="@(_busy || !_dirty)" @onclick="SaveAsync" data-testid="tps-save">Save draft</button>
        @if (_dirty) { <button type="button" class="tps-btn tps-btn-quiet" @onclick="DiscardAsync" data-testid="tps-discard">Discard changes</button> }
    };

    private async Task SaveAsync()
    {
        if (_draft is null) return;
        _busy = true;
        if (_draft.ProjectKey is not null && _draft.Cases.Any(c => c.RequirementLinks.Any(m => m.LinkedAt == default))) await LoadRequirementsAsync();
        var sent = _edits;
        var (draft, error) = await _api!.SaveAsync(_draft.Id, P.ToSaveRequest(_draft, requirements: _requirements));
        _busy = false;
        if (draft is null) { Fail(error ?? "The draft could not be saved."); return; } // the edits stay; Save can be tried again
        if (_edits != sent)
        {
            // Edited while the save was on its way: what was sent is saved, the newer edits are kept on top of the saved revision and stay unsaved.
            _draft = _draft with { Revision = draft.Revision };
            await ReloadWorkspaceAsync();
            Info($"Saved revision {draft.Revision}. Your newer changes are not saved yet: save again.");
            return;
        }
        _draft = draft; _dirty = false;
        await ReloadWorkspaceAsync();
        if (_historyOpen) await LoadRevisionsAsync();
        Ok($"Draft saved (revision {draft.Revision}).");
    }

    private async Task DiscardAsync() { if (_draft is not null) await OpenDraftAsync(_draft.Id); Info("Changes discarded."); }

    private async Task RefreshAsync()
    {
        if (_draft is null) return;
        if (_dirty) { Fail("Save or discard your changes first."); return; }
        _busy = true;
        var (draft, error) = await _api!.RefreshAsync(_draft.Id, _draft.Revision);
        _busy = false;
        if (draft is null) { Fail(error ?? "The plan could not be updated."); return; }
        _draft = draft;
        await ReloadWorkspaceAsync();
        Ok($"Revision {draft.Revision}: generated content updated, your edits kept. Changed cases went back to review.");
    }

    /// <summary>
    /// A performance test case in plain words: the tester describes purpose, workload, environment, measurements and acceptance criteria; any of
    /// them can stay open. Nothing is assumed or executed here — a performance tester refines and runs it in Performance Test Review.
    /// </summary>
    private RenderFragment PerformanceFields(TestPlanDraft d, TestCaseDraft c, string sid) => __builder =>
    {
        var perf = c.Edits.Performance ?? new PerformanceCaseDetails();
        void Set(Func<PerformanceCaseDetails, PerformanceCaseDetails> f) => Change(P.WithCase(d, sid, x => x with { Edits = x.Edits with { Performance = f(x.Edits.Performance ?? new PerformanceCaseDetails()) } }));
        <section class="tps-perf" aria-labelledby="@($"tps-perf-h-{sid}")" data-testid="tps-perf-@sid">
            <h4 id="@($"tps-perf-h-{sid}")" class="tps-h4">Performance test details</h4>
            <p class="tps-muted tps-small">Describe what you know in your own words — no script is needed. Leave anything unknown empty: it is shown as open for a performance tester, never filled in with a guess.</p>
            @if (string.IsNullOrWhiteSpace(perf.AcceptanceCriteria)) { <p class="tps-chip tps-chip-bad" role="status" data-testid="tps-perf-criteria-missing-@sid">Acceptance criteria not defined — review required.</p> }
            <div class="tps-edit-grid">
                <label class="tps-field"><span class="tps-k">Kind of performance test</span>
                    <select class="tps-input" @onchange="e => Set(p => p with { Subtype = Enum.TryParse<PerformanceTestSubtype>(e.Value?.ToString(), out var st) ? st : PerformanceTestSubtype.NotSet })" data-testid="tps-perf-subtype-@sid">
                        @foreach (var st in Enum.GetValues<PerformanceTestSubtype>()) { <option value="@st" selected="@(st == perf.Subtype)">@P.SubtypeLabel(st)</option> }
                    </select></label>
                @PerfField(sid, "operation", "System or operation under test", perf.OperationUnderTest, v => Set(p => p with { OperationUnderTest = v }), false)
                @PerfField(sid, "workload", "Workload (what users do, how many, how often)", perf.Workload, v => Set(p => p with { Workload = v }), true)
                @PerfField(sid, "concurrency", "Users at the same time", perf.Concurrency, v => Set(p => p with { Concurrency = v }), false)
                @PerfField(sid, "rate", "Requests or arrivals per second/minute", perf.ArrivalRate, v => Set(p => p with { ArrivalRate = v }), false)
                @PerfField(sid, "rampup", "Ramp-up", perf.RampUp, v => Set(p => p with { RampUp = v }), false)
                @PerfField(sid, "duration", "Steady-state duration", perf.SteadyStateDuration, v => Set(p => p with { SteadyStateDuration = v }), false)
                @PerfField(sid, "rampdown", "Ramp-down", perf.RampDown, v => Set(p => p with { RampDown = v }), false)
                @PerfField(sid, "environment", "Target environment", perf.TargetEnvironment, v => Set(p => p with { TargetEnvironment = v }), false)
                @PerfField(sid, "volume", "Test data volume", perf.DataVolume, v => Set(p => p with { DataVolume = v }), false)
                @PerfField(sid, "measurements", "What to measure (e.g. response time, p95, throughput, error rate)", perf.Measurements, v => Set(p => p with { Measurements = v }), true)
                @PerfField(sid, "criteria", "Acceptance criteria (thresholds and conditions)", perf.AcceptanceCriteria, v => Set(p => p with { AcceptanceCriteria = v }), true)
                @PerfField(sid, "threshold-source", "Where the thresholds come from", perf.ThresholdSource, v => Set(p => p with { ThresholdSource = v }), false)
                @PerfField(sid, "monitoring", "Monitoring needed", perf.Monitoring, v => Set(p => p with { Monitoring = v }), true)
                @PerfField(sid, "role", "Responsible role", perf.ResponsibleRole, v => Set(p => p with { ResponsibleRole = v }), false)
                @PerfField(sid, "cleanup", "Cleanup / reset", perf.Cleanup, v => Set(p => p with { Cleanup = v }), true)
                @PerfField(sid, "ptr", "Performance Test Review reference", perf.PerformanceReviewReference, v => Set(p => p with { PerformanceReviewReference = v }), false)
            </div>
            <p class="tps-muted tps-small">Execution and results belong to <a href="performance-test-review">Performance Test Review</a>; this draft is a description, not a run.</p>
        </section>
    };

    private RenderFragment PerfField(string sid, string key, string label, string? value, Action<string?> set, bool multi) => __builder =>
    {
        <label class="tps-field @(multi ? "tps-field-wide" : null)"><span class="tps-k">@label</span>
            @if (multi) { <textarea class="tps-input" rows="2" value="@value" @onchange="e => set(string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString())" data-testid="@($"tps-perf-{key}-{sid}")"></textarea> }
            else { <input class="tps-input" value="@value" @onchange="e => set(string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString())" data-testid="@($"tps-perf-{key}-{sid}")" /> }
        </label>
    };

    private RenderFragment EditField(TestCaseDraft c, string label, string? generated, string? effective, Func<string?, TestCaseDraft> apply, bool multi, string key) => __builder =>
    {
        var edited = !string.Equals(generated ?? "", effective ?? "", StringComparison.Ordinal);
        var sid = c.Source.ScenarioId;
        <label class="tps-field @(multi ? "tps-field-wide" : null)"><span class="tps-k">@label @if (edited) { <span class="tps-chip tps-chip-ok">Edited</span> } else if (string.IsNullOrWhiteSpace(generated) && key is "expected" or "preconditions") { <span class="tps-chip tps-chip-bad">Not in source</span> }</span>
            @if (multi) { <textarea class="tps-input" rows="2" value="@effective" @onchange="e => Change(P.WithCase(_draft!, sid, _ => apply(e.Value?.ToString())))" data-testid="@($"tps-edit-{key}-{sid}")"></textarea> }
            else { <input class="tps-input" value="@effective" @onchange="e => Change(P.WithCase(_draft!, sid, _ => apply(e.Value?.ToString())))" data-testid="@($"tps-edit-{key}-{sid}")" /> }
            @if (edited && generated is not null) { <span class="tps-muted tps-small">From the evidence: @generated</span> }
        </label>
    };

    private void SetRationale(string scenarioId, ChangeEventArgs e) => _rationale[scenarioId] = e.Value?.ToString() ?? "";

    private async Task ReviewAsync(string scenarioId, TestCaseReviewState state)
    {
        if (_draft is null) return;
        if (_dirty) { Fail("Save or discard your changes first, then record the review."); return; }
        _busy = true;
        var (draft, error) = await _api!.ReviewAsync(_draft.Id, new ReviewTestCaseRequest(_draft.Revision, scenarioId, state, _rationale.GetValueOrDefault(scenarioId)));
        _busy = false;
        if (draft is null) { Fail(error ?? "The review could not be recorded."); return; }
        _draft = draft;
        _rationale.Remove(scenarioId);
        await ReloadWorkspaceAsync();
        Ok($"Recorded: {P.Review(state).Text}.");
    }

    // ── Step 3: Check testability ────────────────────────────────────────────────────────────────────────────

    private RenderFragment TestabilityArea() => __builder =>
    {
        if (_draft is not { } d) { __builder.AddContent(0, NoDraft()); return; }
        var active = d.Cases.Where(c => c.Review is not (TestCaseReviewState.Excluded or TestCaseReviewState.Superseded)).ToList();
        var shown = _needsActionOnly ? active.Where(P.NeedsAction).ToList() : active;
        <section class="tps-section" data-testid="tps-testability" aria-labelledby="tps-data-h">
            <div class="tps-section-head">
                <h2 id="tps-data-h" class="tps-h2">Check testability</h2>
                <p class="tps-muted">For each case: is Test Data needed, and is suitable data linked from <a href="test-data">Test Data</a> (by its permanent id; values are never copied)? Is anything unclear or blocking? "No test data described" is never read as "not required" — only you decide that.</p>
            </div>
            <ul class="tps-stats" data-testid="tps-readiness-summary" aria-label="Readiness summary">
                @foreach (var g in active.GroupBy(c => c.Testability.Readiness).OrderBy(g => g.Key))
                {
                    var l = P.ReadinessLabel(g.Key);
                    <li data-testid="tps-readiness-@g.Key"><strong>@g.Count()</strong> <span class="tps-tone tps-tone-@l.Tone">@l.Text</span></li>
                }
            </ul>
            <label class="tps-field tps-check"><input type="checkbox" checked="@_needsActionOnly" @onchange="e => _needsActionOnly = e.Value is true" data-testid="tps-needs-action" /> Only cases needing action (@active.Count(P.NeedsAction))</label>
            <ul class="tps-cases">
                @foreach (var c in shown)
                {
                    var sid = c.Source.ScenarioId;
                    var t = c.Testability;
                    var readiness = P.ReadinessLabel(t.Readiness);
                    <li class="tps-case is-open" data-testid="tps-data-@sid">
                        <div class="tps-case-head tps-case-head-static"><span class="tps-card-title">@c.EffectiveTitle</span>
                            <span class="tps-tone tps-tone-@readiness.Tone" data-testid="tps-testability-@sid" title="@t.ReadinessReason">@readiness.Text</span></div>
                        <fieldset class="tps-case-body tps-fieldset" disabled="@_busy">
                            <div class="tps-two">
                                <div>
                                    <span class="tps-k">Test Data described in the evidence</span>
                                    <p>@(c.Generated.RequiredTestData ?? "Not described in the source.")</p>
                                    @if (CanWrite)
                                    {
                                        <label class="tps-field"><span class="tps-k">Does this case need Test Data?</span>
                                            <select class="tps-input" @onchange="e => Change(P.WithCase(d, sid, x => x with { Edits = x.Edits with { TestDataNeed = Enum.TryParse<TestDataNeed>(e.Value?.ToString(), out var n) && n != TestDataNeed.Unknown ? n : null } }))" data-testid="tps-data-need-@sid">
                                                @foreach (var n in Enum.GetValues<TestDataNeed>()) { <option value="@n" selected="@(n == c.EffectiveTestDataNeed)">@P.DataNeedLabel(n)</option> }
                                            </select></label>
                                        <label class="tps-field"><span class="tps-k">Blocked by a prerequisite</span><input class="tps-input" value="@c.Edits.BlockedBy" placeholder="e.g. test account not provisioned" @onchange="e => Change(P.WithCase(d, sid, x => x with { Edits = x.Edits with { BlockedBy = P.TextEdit(null, e.Value?.ToString()) } }))" data-testid="tps-blocked-@sid" /></label>
                                    }
                                    <span class="tps-k">Linked Test Data</span>
                                    @if (c.TestData.Count == 0) { <p class="tps-muted" data-testid="tps-no-data-@sid">None linked.</p> }
                                    <ul class="tps-plain">
                                        @foreach (var link in c.TestData)
                                        {
                                            var assetId = link.AssetId;
                                            <li class="tps-link-row" data-testid="tps-linked-@sid"><strong>@link.Alias</strong> <span class="tps-chip @(link.Approval == "Approved" ? "tps-chip-ok" : "tps-chip-warn")">@link.Approval</span>
                                                @if (link.SchemaCheck is { } sc) { <span class="tps-chip">Schema: @sc</span> }
                                                <span class="tps-muted tps-small">revision <code>@(link.Fingerprint is { Length: >= 12 } f ? f[..12] : link.Fingerprint ?? "—")</code></span>
                                                @if (!link.Resolved) { <span class="tps-chip tps-chip-bad">No longer in Test Data</span> }
                                                @if (CanWrite) { <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" @onclick="() => Change(P.WithCase(d, sid, x => x with { TestData = [.. x.TestData.Where(l => l.AssetId != assetId)] }))">Unlink</button> }
                                            </li>
                                        }
                                    </ul>
                                    @if (CanWrite && _ws!.TestData.Count > 0)
                                    {
                                        <label class="tps-field"><span class="tps-k">Link an asset</span>
                                            <select class="tps-input" @onchange="e => LinkAsset(sid, e.Value?.ToString())" data-testid="tps-link-asset-@sid">
                                                <option value="">Choose…</option>
                                                @foreach (var a in _ws.TestData.Where(a => c.TestData.All(l => l.AssetId != a.AssetId))) { <option value="@a.AssetId">@a.Alias (@a.Approval@(a.Environment is { } env ? $", {env}" : ""))</option> }
                                            </select></label>
                                    }
                                    else if (_ws?.TestData.Count == 0) { <p class="tps-muted tps-small">No Test Data assets exist yet. <a href="test-data">Prepare Test Data</a></p> }
                                </div>
                                <div>
                                    <span class="tps-k">What is still open</span>
                                    <p class="tps-small">@t.ReadinessReason</p>
                                    <table class="tps-facts" aria-label="Manual testability of @c.EffectiveTitle">
                                        <tbody>
                                            @Fact("Steps or input method", t.InputMethod)
                                            @Fact("Suitable Test Data", t.TestData)
                                            @Fact("Expected behaviour known", t.ExpectedBehavior)
                                            @Fact("Outcome observable", t.Observation)
                                            @Fact("Environment available", t.Environment)
                                            @Fact("Tester permissions", t.Permissions)
                                        </tbody>
                                    </table>
                                    @if (c.Correlations.Count > 0)
                                    {
                                        <span class="tps-k">Executable definitions</span>
                                        <ul class="tps-plain">
                                            @foreach (var link in c.Correlations)
                                            {
                                                var key = link.Target.Key;
                                                <li class="tps-link-row" data-testid="tps-correlation-@sid"><strong>@link.Label</strong> <span class="tps-chip @(link.State == CorrelationState.Confirmed ? "tps-chip-ok" : link.Ambiguous ? "tps-chip-warn" : null)">@(link.State == CorrelationState.Candidate ? (link.Ambiguous ? "Ambiguous candidate" : "Candidate") : link.State.ToString())</span>
                                                    <span class="tps-muted tps-small">@link.Basis @link.Capability</span>
                                                    @if (CanWrite && link.State == CorrelationState.Candidate)
                                                    {
                                                        <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" @onclick="() => Decide(sid, key, CorrelationState.Confirmed)" data-testid="tps-confirm-@sid">Confirm link</button>
                                                        <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" @onclick="() => Decide(sid, key, CorrelationState.Rejected)">Reject</button>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    }
                                    @if (CanWrite && _ws!.Executables.Count > 0)
                                    {
                                        <label class="tps-field"><span class="tps-k">Link an existing executable flow</span>
                                            <select class="tps-input" @onchange="e => LinkExecutable(sid, e.Value?.ToString())" data-testid="tps-link-exec-@sid">
                                                <option value="">Choose…</option>
                                                @foreach (var x in _ws.Executables.Where(x => c.Correlations.All(l => l.Target.Key != x.Reference.Key))) { <option value="@x.Reference.Key">@x.Label</option> }
                                            </select></label>
                                    }
                                    @if (t.Blockers.Count > 0) { <ul class="tps-blockers">@foreach (var b in t.Blockers) { <li>@b</li> }</ul> }
                                </div>
                            </div>
                        </fieldset>
                    </li>
                }
            </ul>
            @if (shown.Count == 0) { <p class="tps-muted" data-testid="tps-nothing-needs-action">No case needs action.</p> }
            @if (CanWrite) { <div class="tps-actionbar">@SaveBar()</div> }
        </section>
    };

    private RenderFragment Fact(string label, TestabilityFact fact) => __builder =>
    {
        var l = P.Fact(fact);
        <tr><th scope="row">@label</th><td><span class="tps-tone tps-tone-@l.Tone">@l.Text</span></td></tr>
    };

    private void LinkAsset(string scenarioId, string? assetId)
    {
        if (_draft is null || string.IsNullOrEmpty(assetId) || _ws!.TestData.FirstOrDefault(a => a.AssetId == assetId) is not { } a) return;
        Change(P.WithCase(_draft, scenarioId, c => c with { TestData = [.. c.TestData, new TestCaseDataLink { AssetId = a.AssetId, Alias = a.Alias, Fingerprint = a.Fingerprint, Approval = a.Approval, Validation = a.Validation, SchemaCheck = a.SchemaCheck }] }));
        Info("Linked. Save the draft to keep it; readiness is recalculated on save.");
    }

    private void Decide(string scenarioId, string key, CorrelationState state)
    {
        if (_draft is null) return;
        Change(P.WithCase(_draft, scenarioId, c => c with { Correlations = [.. c.Correlations.Select(x => x.Target.Key == key ? x with { State = state } : x)] }));
        Info("Decision noted. Save the draft to keep it.");
    }

    private void LinkExecutable(string scenarioId, string? key)
    {
        if (_draft is null || string.IsNullOrEmpty(key) || _ws!.Executables.FirstOrDefault(x => x.Reference.Key == key) is not { } x) return;
        Change(P.WithCase(_draft, scenarioId, c => c with { Correlations = [.. c.Correlations, new ScenarioCorrelation { Target = x.Reference, Label = x.Label, State = CorrelationState.Confirmed, Basis = "Linked by a reviewer.", Capability = x.Detail }] }));
        Info("Linked. Save the draft to keep it.");
    }

    // ── Step 4: Save & export ────────────────────────────────────────────────────────────────────────────────

    private RenderFragment SaveArea() => __builder =>
    {
        if (_draft is not { } d) { __builder.AddContent(0, NoDraft()); return; }
        var latest = _ws?.Snapshots.Where(s => s.DraftId == d.Id).OrderByDescending(s => s.Sequence).FirstOrDefault();
        <section class="tps-section" data-testid="tps-save-step" aria-labelledby="tps-save-h">
            <div class="tps-section-head">
                <h2 id="tps-save-h" class="tps-h2">Save &amp; export</h2>
                <p class="tps-muted">A snapshot freezes the whole plan — cases, edits, Test Data revisions, review decisions, readiness, the source snapshot and the rule version. It never changes; later edits create a new snapshot.</p>
            </div>
            @if (latest is not null) { <p class="tps-muted" data-testid="tps-latest-snapshot">Latest snapshot: #@latest.Sequence · @(latest.DeliveryLabel ?? "no delivery label") · @latest.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")@(latest.DraftRevision < d.Revision ? " — the plan changed since" : "")</p> }
            @if (CanWrite)
            {
                <div class="tps-actionbar" data-testid="tps-plan-name-bar">
                    <label class="tps-field tps-field-grow"><span class="tps-k">Test plan name</span><input class="tps-input" @bind="_planName" @bind:event="oninput" data-testid="tps-plan-name" /></label>
                    <button type="button" class="tps-btn tps-btn-quiet" disabled="@(_busy || _dirty || string.IsNullOrWhiteSpace(_planName) || string.Equals(_planName.Trim(), d.PlanName, StringComparison.Ordinal))" @onclick="RenamePlanAsync" data-testid="tps-rename-plan">Save name</button>
                </div>
            }
            <div class="tps-actionbar">
                <button type="button" class="tps-btn" @onclick="@(() => GoArea("export"))" data-testid="tps-go-export">Export to Azure DevOps</button>
            </div>
            @* Snapshots (a frozen copy per delivery) and delivery comparison are BirkNext's own history; the Azure DevOps export does not need them. *@
            <details class="tps-advanced" data-testid="tps-snapshot-advanced">
                <summary>Advanced: snapshots and delivery comparison</summary>
                @if (CanWrite)
                {
                    <div class="tps-actionbar" data-testid="tps-snapshot-bar">
                        <label class="tps-field"><span class="tps-k">Delivery label</span><input class="tps-input" @bind="_deliveryLabel" @bind:event="oninput" placeholder="e.g. Release 2026.11" data-testid="tps-delivery" /></label>
                        <label class="tps-field tps-field-grow"><span class="tps-k">Note</span><input class="tps-input" @bind="_snapshotNote" @bind:event="oninput" /></label>
                        <button type="button" class="tps-btn tps-btn-quiet" disabled="@(_busy || _dirty || string.IsNullOrWhiteSpace(_planName))" @onclick="SaveSnapshotAsync" data-testid="tps-save-snapshot">Save snapshot</button>
                        @if (_dirty) { <span class="tps-muted tps-small">Save the draft first.</span> }
                    </div>
                }
                <div class="tps-actionbar">
                    <button type="button" class="tps-btn tps-btn-quiet" @onclick="@(() => GoArea("compare"))" data-testid="tps-go-compare">Compare deliveries</button>
                    <button type="button" class="tps-btn tps-btn-quiet" @onclick="@(() => GoArea("snapshots"))" data-testid="tps-go-snapshots">All snapshots</button>
                </div>
            </details>
            @if (d.Cases.Any(c => c.Generated.CandidateType is ScenarioCandidateType.UiFunctional or ScenarioCandidateType.UiSmoke))
            {
                <p class="tps-muted tps-small" data-testid="tps-e2e-handoff">UI cases can become automated flows only through <a href="critical-e2e-regression#sg-panel">Critical E2E Regression › Suggested tests</a>, where a person verifies and approves them. Nothing is promoted from here.</p>
            }
        </section>
    };

    private async Task SaveSnapshotAsync()
    {
        if (_draft is null) return;
        _busy = true;
        // The plan name and delivery label are collected here (at save), then frozen with the snapshot.
        if (!string.Equals(_planName.Trim(), _draft.PlanName, StringComparison.Ordinal) || !string.Equals(_deliveryLabel.Trim(), _draft.DeliveryLabel ?? "", StringComparison.Ordinal))
        {
            var (renamed, renameError) = await _api!.SaveAsync(_draft.Id, P.ToSaveRequest(_draft with { PlanName = _planName.Trim(), DeliveryLabel = string.IsNullOrWhiteSpace(_deliveryLabel) ? null : _deliveryLabel.Trim() }));
            if (renamed is null) { _busy = false; Fail(renameError ?? "The plan name could not be saved."); return; }
            _draft = renamed;
        }
        var (result, error) = await _api!.SaveSnapshotAsync(_draft.Id, new SaveTestPlanSnapshotRequest(_draft.Revision, string.IsNullOrWhiteSpace(_deliveryLabel) ? null : _deliveryLabel.Trim(), string.IsNullOrWhiteSpace(_snapshotNote) ? null : _snapshotNote));
        _busy = false;
        if (result is null) { Fail(error ?? "The snapshot could not be saved."); return; }
        await ReloadWorkspaceAsync();
        _snapshotNote = "";
        if (result.Unchanged) Info(result.Message); else Ok(result.Message);
    }

    // ── Saved snapshots ─────────────────────────────────────────────────────────────────────────────────────

    /// <summary>Renames the plan (its name is the Azure DevOps file's name); no snapshot is needed for that.</summary>
    private async Task RenamePlanAsync()
    {
        if (_draft is null || _dirty || string.IsNullOrWhiteSpace(_planName)) return;
        _busy = true;
        var (renamed, error) = await _api!.SaveAsync(_draft.Id, P.ToSaveRequest(_draft with { PlanName = _planName.Trim() }));
        _busy = false;
        if (renamed is null) { Fail(error ?? "The name could not be saved."); return; }
        _draft = renamed; _planName = renamed.PlanName;
        await ReloadWorkspaceAsync();
        Ok("Test plan name saved.");
    }

    private RenderFragment SnapshotsArea() => __builder =>
    {
        var snapshots = _ws?.Snapshots ?? [];
        <section class="tps-section" data-testid="tps-snapshots" aria-labelledby="tps-snap-h">
            <div class="tps-section-head">
                <h2 id="tps-snap-h" class="tps-h2">Saved snapshots <span class="tps-count">@snapshots.Count</span></h2>
                <p class="tps-muted">Every saved snapshot of @(GuideMode ? "this guide's plans" : "this project's plans"). A snapshot can never be changed.</p>
            </div>
            @if (snapshots.Count == 0) { <p class="tps-muted" data-testid="tps-no-snapshots">No snapshot saved yet.</p> }
            <ul class="tps-rows" data-testid="tps-snapshot-list">
                @foreach (var s in snapshots)
                {
                    var sid = s.Id;
                    <li class="tps-row" data-testid="tps-snapshot-row" data-sequence="@s.Sequence">
                        <span class="tps-row-title">#@s.Sequence · @s.PlanName</span>
                        <span class="tps-muted tps-small">@(s.DeliveryLabel ?? "No delivery label") · @s.Cases cases · rules @s.RuleVersion · @s.CreatedBy · @s.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") · <code>@s.ContentFingerprint[..12]</code></span>
                        <button type="button" class="tps-btn tps-btn-quiet tps-btn-xs" @onclick="() => OpenSnapshotAsync(sid)" data-testid="tps-open-snapshot">Open</button>
                    </li>
                }
            </ul>
            @if (_openSnapshot is { } open)
            {
                <section class="tps-snapshot-view" data-testid="tps-snapshot-view" aria-label="Snapshot @open.Summary.Sequence">
                    <h3 class="tps-h3">Snapshot #@open.Summary.Sequence (read-only) · @open.Plan.PlanName</h3>
                    <p class="tps-muted tps-small">Draft revision @open.Summary.DraftRevision · @(open.Plan.ProjectKey is null ? $"guide revision {open.Plan.Basis.GuideRevision} ({open.Plan.Basis.GuideReviewState})" : $"project {open.Plan.ProjectName ?? open.Plan.ProjectKey}") · fingerprint <code>@open.Summary.ContentFingerprint</code></p>
                    @foreach (var suite in open.Plan.Suites)
                    {
                        var cases = open.Plan.Cases.Where(c => c.SuiteId == suite.Id).ToList();
                        if (cases.Count == 0) continue;
                        <h4 class="tps-h4">@suite.Name</h4>
                        <ul class="tps-plain">@foreach (var c in cases) { <li>@c.EffectiveTitle · <span class="tps-tone tps-tone-@P.Review(c.Review).Tone">@P.Review(c.Review).Text</span> · Expected: @(c.EffectiveExpected ?? "NEEDS CLARIFICATION")</li> }</ul>
                    }
                </section>
            }
        </section>
    };

    private async Task OpenSnapshotAsync(Guid id)
    {
        var (snapshot, error) = await _api!.SnapshotAsync(id);
        if (snapshot is null) { Fail(error ?? "The snapshot could not be opened."); return; }
        _openSnapshot = snapshot;
    }

    // ── Compare deliveries ───────────────────────────────────────────────────────────────────────────────────

    private RenderFragment CompareArea() => __builder =>
    {
        var snapshots = _ws?.Snapshots ?? [];
        <section class="tps-section" data-testid="tps-compare" aria-labelledby="tps-cmp-h">
            <div class="tps-section-head">
                <h2 id="tps-cmp-h" class="tps-h2">Compare deliveries</h2>
                <p class="tps-muted">Two saved snapshots, case by case. Source, review, Test Data and suggestion-rule differences are kept apart; a text change is never declared a behaviour change by itself.</p>
            </div>
            @if (snapshots.Count < 2) { <p class="tps-muted" data-testid="tps-compare-need">Save at least two snapshots to compare deliveries.</p> }
            else
            {
                <div class="tps-filters">
                    <label class="tps-field"><span class="tps-k">From (earlier)</span><select class="tps-input" @onchange="e => _compareFrom = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null" data-testid="tps-compare-from">
                        <option value="">Choose…</option>@foreach (var s in snapshots) { <option value="@s.Id" selected="@(_compareFrom == s.Id)">#@s.Sequence · @(s.DeliveryLabel ?? s.PlanName)</option> }</select></label>
                    <label class="tps-field"><span class="tps-k">To (later)</span><select class="tps-input" @onchange="e => _compareTo = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null" data-testid="tps-compare-to">
                        <option value="">Choose…</option>@foreach (var s in snapshots) { <option value="@s.Id" selected="@(_compareTo == s.Id)">#@s.Sequence · @(s.DeliveryLabel ?? s.PlanName)</option> }</select></label>
                    <button type="button" class="tps-btn" disabled="@(_busy || _compareFrom is null || _compareTo is null || _compareFrom == _compareTo)" @onclick="CompareAsync" data-testid="tps-compare-run">Compare</button>
                </div>
            }
            @if (_comparison is { } cmp)
            {
                @if (!cmp.Comparable) { <p class="tps-note tps-note-warn" data-testid="tps-incomparable">@cmp.IncomparableReason</p> }
                else
                {
                    <ul class="tps-stats" data-testid="tps-compare-counts" aria-label="Comparison summary">
                        <li><strong>@cmp.Added</strong> added</li><li><strong>@cmp.Changed</strong> changed</li><li><strong>@cmp.Removed</strong> removed</li><li><strong>@cmp.Unchanged</strong> unchanged</li>
                        <li><strong>@cmp.Cases.Count(c => c.PotentialBehaviourChange)</strong> potential rule changes</li>
                    </ul>
                    @if (cmp.Context.Count > 0)
                    {
                        <div class="tps-block" data-testid="tps-context-diff"><h3 class="tps-h3">Context differences</h3>
                            <ul class="tps-plain">@foreach (var x in cmp.Context) { <li><strong>@x.Category</strong>: @x.Before → @x.After. <span class="tps-muted">@x.Meaning</span></li> }</ul></div>
                    }
                    <div class="tps-block"><h3 class="tps-h3">Cases</h3>
                        <ul class="tps-cases" data-testid="tps-compare-cases">
                            @foreach (var c in cmp.Cases.Where(c => c.Kind != CaseChangeKind.Unchanged))
                            {
                                <li class="tps-case is-open" data-testid="tps-cmp-case" data-kind="@c.Kind" data-scenario="@c.ScenarioId">
                                    <div class="tps-case-head tps-case-head-static"><span class="tps-card-title">@c.Title</span><span class="tps-tone tps-tone-@(c.Kind switch { CaseChangeKind.Added => "info", CaseChangeKind.Removed => "muted", _ => c.PotentialBehaviourChange ? "bad" : "warn" })">@c.Kind</span></div>
                                    <div class="tps-case-body"><p class="tps-small">@c.Assessment</p>
                                        @if (c.Changes.Count > 0) { <dl class="tps-dl tps-diff">@foreach (var ch in c.Changes) { <dt>@ch.Category</dt><dd><span class="tps-before">@(ch.Before ?? "—")</span> → <span class="tps-after">@(ch.After ?? "—")</span></dd> }</dl> }</div>
                                </li>
                            }
                        </ul>
                        @if (cmp.Unchanged > 0) { <p class="tps-muted tps-small">@cmp.Unchanged unchanged cases are not listed.</p> }
                    </div>
                    <div class="tps-block" data-testid="tps-recommendations"><h3 class="tps-h3">Regression recommendations</h3>
                        @if (cmp.Recommendations.Count == 0) { <p class="tps-muted">None.</p> }
                        <ul class="tps-plain">@foreach (var r in cmp.Recommendations) { <li data-testid="tps-recommendation"><strong>@r.Kind</strong>: @r.Title — @r.Reason</li> }</ul>
                        <p class="tps-muted tps-small">Suggestions for a reviewer to select. Unchanged high-risk and previously blocked cases are kept in view on purpose.</p></div>
                }
            }
        </section>
    };

    private async Task CompareAsync()
    {
        if (_compareFrom is not { } from || _compareTo is not { } to) return;
        _busy = true;
        var (comparison, error) = await _api!.CompareAsync(from, to);
        _busy = false;
        if (comparison is null) { Fail(error ?? "The comparison failed."); return; }
        _comparison = comparison;
    }

    // ── Prepare for Azure DevOps ─────────────────────────────────────────────────────────────────────────────

    private RenderFragment ExportArea() => __builder =>
    {
        var snapshots = _ws?.Snapshots ?? [];
        @* The Azure DevOps Test Plans import file (XLSX / CSV) is built from the saved plan; one shared wizard. *@
        @if (_draft is { ProjectKey: { } exportProject } exportDraft)
        {
            <BirkNext.Web.Components.AdoExportWizard Draft="exportDraft" ProjectKey="@exportProject" CanWrite="CanWrite" Dirty="_dirty" />
        }
        else if (!GuideMode)
        {
            <p class="tps-muted" data-testid="tps-export-no-plan">Prepare and save a test plan first: the Azure DevOps export is built from saved test cases.</p>
        }
        @* Secondary: the Azure DevOps export above is the tester's export. This one archives a saved snapshot as BirkNext JSON; collapsed so the
           two are never mistaken for one another (M2LB end-to-end, 2026-11-19). *@
        <details class="tps-section" data-testid="tps-export" open="@(_export is not null)">
            <summary class="tps-section-head">
                <h2 id="tps-exp-h" class="tps-h2" style="display:inline">Other export: BirkNext JSON of a saved snapshot</h2>
                <p class="tps-muted">Azure DevOps Test Plans stays the authority for formal Test Plans, Suites, Cases, Runs and Results. BirkNext prepares a reviewable proposal from a saved snapshot: copyable text and a structured BirkNext JSON file. Nothing is written to Azure DevOps, and import compatibility is not verified.</p>
            </summary>
            @if (snapshots.Count == 0) { <p class="tps-muted" data-testid="tps-export-need">Save a snapshot first: an export is always of one saved snapshot.</p> }
            else
            {
                <div class="tps-filters">
                    <label class="tps-field"><span class="tps-k">Snapshot</span><select class="tps-input" @onchange="e => _exportSnapshot = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null" data-testid="tps-export-snapshot">
                        <option value="">Choose…</option>@foreach (var s in snapshots) { <option value="@s.Id" selected="@(_exportSnapshot == s.Id)">#@s.Sequence · @(s.DeliveryLabel ?? s.PlanName)</option> }</select></label>
                    <button type="button" class="tps-btn" disabled="@(_busy || _exportSnapshot is null)" @onclick="ExportAsync" data-testid="tps-export-run">Prepare export</button>
                </div>
            }
            @if (_export is { } x)
            {
                <p class="tps-note tps-note-info" data-testid="tps-export-boundary">@x.Boundary</p>
                @if (x.Unresolved.Count > 0)
                {
                    <div class="tps-block" data-testid="tps-export-unresolved"><h3 class="tps-h3">Unresolved questions (@x.Unresolved.Count)</h3><ul class="tps-plain">@foreach (var u in x.Unresolved.Take(30)) { <li>@u</li> }</ul>
                        @if (x.Unresolved.Count > 30) { <p class="tps-muted tps-small">…and @(x.Unresolved.Count - 30) more in the file.</p> }</div>
                }
                <div class="tps-actionbar">
                    <a class="tps-btn" download="@x.FileName" href="@("data:application/json;charset=utf-8," + Uri.EscapeDataString(x.Json))" data-testid="tps-export-download">Download JSON</a>
                    <span class="tps-muted tps-small tps-wrap">@x.FileName · format @x.Format</span>
                </div>
                <label class="tps-field tps-field-wide"><span class="tps-k">Copyable Test Case drafts</span><textarea class="tps-input tps-export-text" rows="16" readonly data-testid="tps-export-text">@x.Text</textarea></label>
            }
        </details>
    };

    private async Task ExportAsync()
    {
        if (_exportSnapshot is not { } id) return;
        _busy = true;
        var (export, error) = await _api!.ExportAsync(id);
        _busy = false;
        if (export is null) { Fail(error ?? "The export could not be prepared."); return; }
        _export = export;
    }
}
