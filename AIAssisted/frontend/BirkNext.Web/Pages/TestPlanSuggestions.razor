                        @if (story.WhyThisPriority is { } why) { <label class="tps-field"><span class="tps-k" lang="en">Why this priority (@name)</span><textarea class="tps-input" rows="2" value="@text?.WhyThisPriority" @onchange="e => ChangeStoryText(story.Key, language, t => t with { WhyThisPriority = e.Value?.ToString() })"></textarea><span class="tps-orig" lang="en">Original: @why</span></label> }
                        @if (story.IndependentTest is { } independent) { <label class="tps-field"><span class="tps-k" lang="en">Independent Test (@name)</span><textarea class="tps-input" rows="3" value="@text?.IndependentTest" @onchange="e => ChangeStoryText(story.Key, language, t => t with { IndependentTest = e.Value?.ToString() })" data-testid="tps-story-tr-independent"></textarea><span class="tps-orig" lang="en">Original: @independent</span></label> }
                    </div>
