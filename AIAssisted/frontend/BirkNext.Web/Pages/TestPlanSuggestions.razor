                            var candidate = item;
                            <li class="tps-req" data-testid="tps-story-req" data-requirement="@item.RequirementId" data-level="@item.Level">
                                <span class="tps-level tps-level-@item.Level" title="@C.LevelLabel(item.Level)" data-testid="tps-story-req-level">@C.LevelLabel(item.Level)[..1]</span>
                                <span class="tps-req-id">@item.RequirementId</span>
                                <span class="tps-req-text">@(C.RequirementWording(item.Title, item.RequirementId) switch { var w when w.Length > 200 => w[..199] + "…", var w => w })
                                    <span class="tps-req-why" data-testid="tps-story-req-why">@item.Reason</span></span>
                                @if (CanWrite)
                                {
                                    <span class="tps-req-actions">
                                        <button type="button" class="tps-icon-btn tps-icon-btn-sm tps-icon-ok" aria-label="@($"Confirm {item.RequirementId} for this story")" title="Confirm for this story" @onclick="() => ConfirmForStory(story.Key, candidate)" data-testid="tps-story-req-confirm">✓</button>
                                        <button type="button" class="tps-icon-btn tps-icon-btn-sm" aria-label="@($"{item.RequirementId} is not related to this story")" title="Not related" @onclick="() => RejectForStory(story.Key, candidate)" data-testid="tps-story-req-reject">✕</button>
                                    </span>
                                }
                            </li>
                        }
                    </ul>
                }
                <p class="tps-sub">Linked to the story's test cases <span class="tps-muted tps-small">(read-only)</span></p>
                @if (caseLinks.Count == 0) { <p class="tps-muted tps-small" data-testid="tps-story-case-links-none">No test case of this story is linked to a requirement yet.</p> }
                else
                {
                    <ul class="tps-chip-list" data-testid="tps-story-case-links">
                        @foreach (var g in caseLinks) { <li class="tps-chip" title="@string.Join("; ", g.Select(x => x.Case.EffectiveTitle).Distinct())">@g.Key · @g.Select(x => x.Case.Source.ScenarioId).Distinct().Count() case@(g.Select(x => x.Case.Source.ScenarioId).Distinct().Count() == 1 ? "" : "s")</li> }
                    </ul>
                }
                <p class="tps-muted tps-small">A requirement confirmed for a story is an association with the story: it is never inherited by its scenarios or test cases and never counted as test coverage. Save the draft to keep your choices.</p>
            </div>
        }
    };
}
