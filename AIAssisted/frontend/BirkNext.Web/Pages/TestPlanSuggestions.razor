                                @if (CanWrite) { <button type="button" class="tps-icon-btn tps-icon-btn-sm" aria-label="@($"Remove {link.RequirementId} from this story")" title="Remove" @onclick="() => UnlinkFromStory(story.Key, link)" data-testid="tps-story-req-remove">✕</button> }
