@page "/specification-explorer"
@using BirkNext.Web.Components
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop

@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject BirkNext.Web.Services.IWorkspaceSessionService Workspace
@inject BirkNext.Web.Services.ISampleProjectDocumentResolver DocumentResolver
@inject BirkNext.Web.Services.IScenarioExtractionService ExtractionService

<PageTitle>Specification Explorer — QA Review Studio</PageTitle>

<div class="se-page">

    @if (!string.IsNullOrWhiteSpace(_selectedProjectName))
    {
        <div style="padding: 8px 16px; background: #f5f5f5; border-bottom: 1px solid #e0e0e0; font-size: 0.875rem; color: #666;">
            Sample Project: <strong>@_selectedProjectName</strong>
        </div>
    }

    <PageHeader Title="Specification Explorer"
                Description="Navigate and analyze specification.md files — requirements, gaps, scenarios, and validation." />

    @if (string.IsNullOrWhiteSpace(_selectedProject))
    {
        <div style="padding: 32px; text-align: center; color: #999;">
            <p>No Sample Project selected.</p>
        </div>
    }
    else if (_isMissingDocument)
    {
        <div style="padding: 32px; text-align: center; color: #999;">
            <p>spec.md is not available for <strong>@_selectedProjectName</strong>.</p>
        </div>
    }
    else
    {
        <div class="se-page-body">
            <SpecExplorerPanel
                InitialSpecMarkdown="@_initialText"
                Candidates="@_candidates"
                IsEmbeddedInReview="false" />

            @if (!string.IsNullOrWhiteSpace(_initialText))
            {
                <section class="review-results-panel" aria-label="Selected project specification analysis">
                    <div class="review-results-header">
                        <div class="review-results-title">
                            <p class="section-kicker">Selected Project Analysis</p>
                            <h2>Analysis Results</h2>
                            <p>Extract review candidates from the selected Sample Project spec.md.</p>
                        </div>
                        <div class="review-summary-strip" aria-label="Analysis summary metrics">
                            <div class="summary-slot" data-testid="requirements-metric">
                                <span>@RequirementMetric</span>
                                <small>Requirements</small>
                            </div>
                            <div class="summary-slot" data-testid="tests-metric">
                                <span>@TestMetric</span>
                                <small>Tests</small>
                            </div>
                            <div class="summary-slot" data-testid="clarifications-metric">
                                <span>@ClarificationMetric</span>
                                <small>Clarifications</small>
                            </div>
                            <div class="summary-slot" data-testid="candidates-metric">
                                <span>@CandidateMetric</span>
                                <small>Candidates</small>
                            </div>
                        </div>
                    </div>

                    <button type="button"
                            class="btn-primary"
                            data-testid="spec-explorer-analyze"
                            disabled="@_isAnalyzing"
                            @onclick="AnalyzeSelectedSpecificationAsync">
                        @(_isAnalyzing ? "Analyzing..." : "Analyze Specification")
                    </button>

                    @if (!string.IsNullOrWhiteSpace(_analysisError))
                    {
                        <div class="notification notification-error" role="alert">@_analysisError</div>
                    }
                    else if (_pipelineResult is null)
                    {
                        <div class="extract-pre-state" data-testid="extract-pre-state">
                            <h3>No review candidates yet</h3>
                            <p>Analyze the selected Sample Project specification to generate review candidates.</p>
                        </div>
                    }
                    else
                    {
                        <ExtractionReviewList PipelineResult="_pipelineResult" InitialSession="null" SpecMarkdown="@_pipelineResult.SpecMarkdown" />
                    }
                </section>
            }
        </div>
    }

</div>

@code {
    private string _initialText = string.Empty;
    private SpecTree? _parsedDocument;
    private SpecificationSemanticModel? _semanticModel;
    private List<ExtractionCandidate> _candidates = [];
    private ExtractionPipelineResult? _pipelineResult;
    private string? _selectedProject;
    private string? _selectedProjectName;
    private bool _isMissingDocument;
    private bool _isAnalyzing;
    private string? _analysisError;
    private string? _previousProject;

    private int RequirementMetric => _pipelineResult?.RequirementCount ?? 0;
    private int TestMetric => _pipelineResult?.TestCount ?? 0;
    private int ClarificationMetric => _pipelineResult?.NeedsClarificationCount ?? 0;
    private int CandidateMetric => _pipelineResult?.Candidates.Count ?? 0;

    protected override async Task OnInitializedAsync()
    {
        // POLICY: Automatic Specification loading is Sample Project ONLY
        // Never use Workspace or localStorage as the source for production automatic loading

        // Load from currently selected Sample Project
        var selected = DocumentResolver.GetSelectedProject();
        if (!string.IsNullOrWhiteSpace(selected))
        {
            await LoadFromSampleProject(selected);
            _previousProject = selected;
        }
        else
        {
            // No Sample Project selected - show explicit empty state, not legacy content
            _selectedProject = null;
            _selectedProjectName = null;
            _initialText = string.Empty;
            _parsedDocument = null;
            _semanticModel = null;
            _pipelineResult = null;
            _analysisError = null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            // Detect project changes at runtime
            var currentProject = DocumentResolver.GetSelectedProject();
            if (currentProject != _previousProject)
            {
                _previousProject = currentProject;

                if (!string.IsNullOrWhiteSpace(currentProject))
                {
                    await LoadFromSampleProject(currentProject);
                }
                else
                {
                    // Project was deselected
                    _selectedProject = null;
                    _selectedProjectName = null;
                    _initialText = string.Empty;
                    _parsedDocument = null;
                    _semanticModel = null;
                    _isMissingDocument = false;
                    _pipelineResult = null;
                    _analysisError = null;
                }
                StateHasChanged();
            }
            return;
        }
    }

    private async Task LoadFromSampleProject(string projectSlug)
    {
        var result = await DocumentResolver.ResolveAsync(projectSlug, ExplorerDocumentType.Specification);

        if (result.IsSuccess && !string.IsNullOrEmpty(result.Content))
        {
            _initialText = result.Content;
            _selectedProject = projectSlug;
            _isMissingDocument = false;
            await UpdateSelectedProjectName();
            BuildSemanticModel(result.Content);
            _pipelineResult = null;
            _analysisError = null;
        }
        else if (result.IsMissing)
        {
            _selectedProject = projectSlug;
            _isMissingDocument = true;
            await UpdateSelectedProjectName();
            _parsedDocument = null;
            _semanticModel = null;
            _candidates = [];
            _initialText = string.Empty;
            _pipelineResult = null;
            _analysisError = null;
        }
    }

    private async Task UpdateSelectedProjectName()
    {
        if (string.IsNullOrWhiteSpace(_selectedProject))
        {
            _selectedProjectName = null;
            return;
        }

        var projects = await DocumentResolver.GetAvailableProjectsAsync();
        var project = projects.FirstOrDefault(p => p.Slug == _selectedProject);
        _selectedProjectName = project?.Name ?? _selectedProject;
    }

    private void BuildSemanticModel(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            _semanticModel = null;
            _parsedDocument = null;
            _candidates = [];
            return;
        }
        _parsedDocument = SpecExplorerService.Parse(text);
        _semanticModel = SpecExplorerService.BuildSemanticModel(_parsedDocument, text);
        // Candidates remain empty for automatic loading (only populated from extraction results)
        _candidates = [];
    }

    private async Task AnalyzeSelectedSpecificationAsync()
    {
        if (_isAnalyzing || string.IsNullOrWhiteSpace(_initialText))
            return;

        try
        {
            _isAnalyzing = true;
            _analysisError = null;
            var result = await ExtractionService.ExtractAsync(_initialText, ExtractionProfile.Speckit);
            _pipelineResult = result.WithSpecMarkdown(_initialText);
            _candidates = _pipelineResult.Candidates.ToList();
        }
        catch (Exception ex)
        {
            _analysisError = $"Analysis failed: {ex.Message}";
            _pipelineResult = null;
            _candidates = [];
        }
        finally
        {
            _isAnalyzing = false;
        }
    }
}
