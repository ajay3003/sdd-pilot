@page "/specification-explorer"
@using BirkNext.Web.Components
@using BirkNext.Web.Components.Explorers
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using BirkNext.Web.Services.Explorers

@inject BirkNext.Web.Services.IScenarioExtractionService ExtractionService

<PageTitle>Specification Explorer — QA Review Studio</PageTitle>

<div class="se-page">

    <PageHeader Title="Specification Explorer"
                Description="@ArtifactExplorerRoles.Purpose(WorkspaceArtifactType.Specification)" />

    <ArtifactExplorerHost Role="WorkspaceArtifactType.Specification" OnStateChanged="OnArtifactChanged">
        @if (_parseError is not null)
        {
            <ExplorerAnalysisError Role="WorkspaceArtifactType.Specification" Message="@_parseError" />
        }
        else
        {
            <div class="se-page-body">
                <SpecExplorerPanel
                    InitialSpecMarkdown="@_text"
                    Candidates="@_candidates"
                    IsEmbeddedInReview="false" />

                <section class="review-results-panel" aria-label="Specification analysis">
                    <div class="review-results-header">
                        <div class="review-results-title">
                            <p class="section-kicker">Specification Analysis</p>
                            <h2>Analysis Results</h2>
                            <p>Extract review candidates from the selected Specification artifact.</p>
                        </div>
                        <div class="review-summary-strip" aria-label="Analysis summary metrics">
                            <div class="summary-slot" data-testid="requirements-metric">
                                <span>@RequirementMetric</span>
                                <small>Requirements</small>
                            </div>
                            <div class="summary-slot" data-testid="tests-metric">
                                <span>@TestMetric</span>
                                <small>Tests</small>
                            </div>
                            <div class="summary-slot" data-testid="clarifications-metric">
                                <span>@ClarificationMetric</span>
                                <small>Clarifications</small>
                            </div>
                            <div class="summary-slot" data-testid="candidates-metric">
                                <span>@CandidateMetric</span>
                                <small>Candidates</small>
                            </div>
                        </div>
                    </div>

                    <button type="button"
                            class="btn-primary"
                            data-testid="spec-explorer-analyze"
                            disabled="@_isAnalyzing"
                            @onclick="AnalyzeSelectedSpecificationAsync">
                        @(_isAnalyzing ? "Analyzing..." : "Analyze Specification")
                    </button>

                    @if (!string.IsNullOrWhiteSpace(_analysisError))
                    {
                        <div class="notification notification-error" role="alert">@_analysisError</div>
                    }
                    else if (_pipelineResult is null)
                    {
                        <div class="extract-pre-state" data-testid="extract-pre-state">
                            <h3>No review candidates yet</h3>
                            <p>Analyze the selected Specification artifact to generate review candidates.</p>
                        </div>
                    }
                    else
                    {
                        <ExtractionReviewList PipelineResult="_pipelineResult" InitialSession="null" SpecMarkdown="@_pipelineResult.SpecMarkdown" ProjectSlug="@_projectSlug" />
                    }
                </section>
            </div>
        }
    </ArtifactExplorerHost>

</div>

@code {
    private string _text = string.Empty;
    private string? _projectSlug;
    private List<ExtractionCandidate> _candidates = [];
    private ExtractionPipelineResult? _pipelineResult;
    private bool _isAnalyzing;
    private string? _analysisError;
    private string? _parseError;

    private int RequirementMetric => _pipelineResult?.RequirementCount ?? 0;
    private int TestMetric => _pipelineResult?.TestCount ?? 0;
    private int ClarificationMetric => _pipelineResult?.NeedsClarificationCount ?? 0;
    private int CandidateMetric => _pipelineResult?.Candidates.Count ?? 0;

    private void OnArtifactChanged(ArtifactExplorerState state)
    {
        var text = state.Content ?? string.Empty;
        if (string.Equals(text, _text, StringComparison.Ordinal) && _projectSlug == state.ProjectSlug) return;
        // Another artifact (or project): results of the previous one never carry over.
        _text = text;
        _projectSlug = state.ProjectSlug;
        _candidates = [];
        _pipelineResult = null;
        _analysisError = null;
        _parseError = null;
        if (string.IsNullOrWhiteSpace(text)) return;
        try
        {
            var tree = SpecExplorerService.Parse(text);
            _ = SpecExplorerService.BuildSemanticModel(tree, text);
        }
        catch (Exception ex)
        {
            _parseError = ex.Message;
        }
    }

    private async Task AnalyzeSelectedSpecificationAsync()
    {
        if (_isAnalyzing || string.IsNullOrWhiteSpace(_text))
            return;

        try
        {
            _isAnalyzing = true;
            _analysisError = null;
            var result = await ExtractionService.ExtractAsync(_text, ExtractionProfile.Speckit);
            _pipelineResult = result.WithSpecMarkdown(_text);
            _candidates = _pipelineResult.Candidates.ToList();
        }
        catch (Exception ex)
        {
            _analysisError = $"Analysis failed: {ex.Message}";
            _pipelineResult = null;
            _candidates = [];
        }
        finally
        {
            _isAnalyzing = false;
        }
    }
}
