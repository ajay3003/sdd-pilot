@page "/specification-review"
@using BirkNext.Web.Components
@using BirkNext.Web.Models.Review
@using BirkNext.Web.Services

@inject ReviewPageModelService ReviewPageModelService
@inject IWorkspaceSessionService Workspace
@inject IWorkspaceUpdateCoordinator UpdateCoordinator

<PageTitle>Specification Review</PageTitle>

<div class="sr-page">
    <PageHeader Title="Specification Review"
                Description="Review and analyze specification.md files — requirements, gaps, scenarios, and validation." />

    @if (PageModel is not null)
    {
        <ReviewReadinessPanel Model="PageModel" />
    }

    @if (IsLoading)
    {
        <div class="loading-state">Loading specification analysis...</div>
    }
    else if (LoadError is not null)
    {
        <div class="notification notification-error">@LoadError</div>
    }

    @if (PageModel?.Summary.CanRun == true)
    {
        <div class="content">
            @if (PageModel.Results.Count > 0)
            {
                <div class="results-section">
                    <h2>Analysis Results</h2>
                    @foreach (var result in PageModel.Results)
                    {
                        <div class="result-card">
                            <div class="result-header">
                                <h3>@result.Name</h3>
                                <span class="severity @GetSeverityClass(result.Severity)">@result.Severity</span>
                            </div>
                            @if (!string.IsNullOrEmpty(result.Summary))
                            {
                                <p class="summary">@result.Summary</p>
                            }
                            @if (!string.IsNullOrEmpty(result.Details))
                            {
                                <div class="details">@result.Details</div>
                            }
                            @if (!string.IsNullOrEmpty(result.Recommendation))
                            {
                                <div class="recommendation">
                                    <strong>Recommendation:</strong> @result.Recommendation
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            <div class="editor-section">
                <h2>Specification Content</h2>
                <textarea @bind="_specText"
                          class="editor"
                          placeholder="Paste or edit specification content..."
                          rows="20"></textarea>
                <div class="actions">
                    <button class="btn-primary" @onclick="SaveSpec">Save Specification</button>
                    <button class="btn-secondary" @onclick="ClearSpec">Clear</button>
                    <label class="file-upload">
                        <InputFile OnChange="HandleFileUpload" accept=".md,.txt" hidden />
                        📎 Upload File
                    </label>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private ReviewPageModel? PageModel;
    private bool IsLoading = true;
    private string? LoadError;
    private string _specText = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Workspace.ReviewContextRebuildNeeded += (s, e) => _ = RefreshPageModel();
        await RefreshPageModel();

        var cached = Workspace.Get(WorkspaceArtifactKind.Specification);
        if (cached != null) _specText = cached.Text;
    }

    private async Task RefreshPageModel()
    {
        try
        {
            IsLoading = true;
            LoadError = null;
            PageModel = await ReviewPageModelService.GetSpecificationReviewModelAsync();
        }
        catch (Exception ex)
        {
            LoadError = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SaveSpec()
    {
        if (string.IsNullOrWhiteSpace(_specText))
        {
            LoadError = "Specification content cannot be empty";
            return;
        }

        try
        {
            Workspace.Set(WorkspaceArtifactKind.Specification, _specText);
            UpdateCoordinator.NotifyMutation();
            await RefreshPageModel();
        }
        catch (Exception ex)
        {
            LoadError = $"Failed to save: {ex.Message}";
        }
    }

    private void ClearSpec() => _specText = string.Empty;

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        try
        {
            using var stream = e.File.OpenReadStream();
            using var reader = new StreamReader(stream);
            _specText = await reader.ReadToEndAsync();
            await SaveSpec();
        }
        catch (Exception ex)
        {
            LoadError = $"Failed to upload file: {ex.Message}";
        }
    }

    private string GetSeverityClass(string? severity) => severity?.ToLower() switch
    {
        "critical" => "critical",
        "warning" => "warning",
        "info" => "info",
        _ => "default"
    };
}

<style>
.sr-page { padding: 0 20px; }
.loading-state { text-align: center; padding: 40px; color: #6b7280; }
.content { margin-top: 32px; }
h2 { font-size: 18px; font-weight: 600; margin: 24px 0 16px 0; border-bottom: 2px solid #e5e7eb; padding-bottom: 12px; }
.results-section { margin-bottom: 40px; }
.result-card { border: 1px solid #e5e7eb; border-radius: 8px; padding: 16px; background: white; margin-bottom: 12px; }
.result-header { display: flex; justify-content: space-between; margin-bottom: 12px; }
.result-header h3 { margin: 0; font-size: 16px; font-weight: 600; }
.severity { display: inline-block; padding: 4px 12px; border-radius: 4px; font-size: 12px; font-weight: 600; }
.severity.critical { background: #fee2e2; color: #991b1b; }
.severity.warning { background: #fef3c7; color: #92400e; }
.severity.info { background: #dbeafe; color: #1e40af; }
.summary { margin: 8px 0; font-size: 14px; color: #374151; }
.details { margin: 8px 0; padding: 8px; background: #f9fafb; border-radius: 4px; font-size: 13px; color: #6b7280; }
.recommendation { margin-top: 8px; padding: 8px; background: #fef3c7; border-left: 3px solid #f59e0b; border-radius: 4px; font-size: 13px; }
.editor-section { background: white; border: 1px solid #e5e7eb; border-radius: 8px; padding: 24px; }
.editor { width: 100%; padding: 12px; border: 1px solid #d1d5db; border-radius: 6px; font-family: monospace; font-size: 13px; }
.editor:focus { outline: none; border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1); }
.actions { display: flex; gap: 12px; margin-top: 16px; }
.btn-primary, .btn-secondary, .file-upload { padding: 10px 20px; border-radius: 6px; font-weight: 500; cursor: pointer; border: none; transition: all 0.2s ease; }
.btn-primary { background: #3b82f6; color: white; }
.btn-primary:hover { background: #2563eb; }
.btn-secondary { background: #f3f4f6; color: #374151; border: 1px solid #d1d5db; }
.btn-secondary:hover { background: #e5e7eb; }
.file-upload { background: #f3f4f6; color: #374151; border: 1px solid #d1d5db; }
.file-upload:hover { background: #e5e7eb; }
</style>
