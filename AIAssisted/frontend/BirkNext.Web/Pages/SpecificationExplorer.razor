@page "/specification-explorer"
@using BirkNext.Web.Components
@using BirkNext.Web.Components.Explorers
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using BirkNext.Web.Services.Explorers
@using System.Security.Cryptography
@using System.Text

@inject BirkNext.Web.Services.IScenarioExtractionService ExtractionService

<PageTitle>Specification Explorer — QA Review Studio</PageTitle>

<div class="se-page">

    <PageHeader Title="Specification Explorer"
                Description="@ArtifactExplorerRoles.Purpose(WorkspaceArtifactType.Specification)" />

    <ArtifactExplorerHost Role="WorkspaceArtifactType.Specification" OnStateChanged="OnArtifactChanged">
        @if (_parseError is not null)
        {
            <ExplorerAnalysisError Role="WorkspaceArtifactType.Specification" Message="@_parseError" />
        }
        else
        {
            <div class="se-page-body">
                <SpecExplorerPanel
                    InitialSpecMarkdown="@_text"
                    Candidates="@CandidatesForCurrentArtifact"
                    IsEmbeddedInReview="false" />

                <section class="se-traceability-state" aria-labelledby="se-traceability-title" data-testid="se-traceability-state">
                    <div>
                        <p class="section-kicker">Traceability &amp; Coverage</p>
                        <h2 id="se-traceability-title">Not assessed for this Specification</h2>
                        <p>Document structure does not establish workspace coverage. Open Requirements Traceability to assess artifact links.</p>
                    </div>
                    <a class="btn-secondary" href="artifact-traceability">Open Requirements Traceability</a>
                </section>

                <section class="review-results-panel" aria-label="Specification review analysis" data-testid="spec-review-analysis">
                    <div class="review-results-header">
                        <div class="review-results-title">
                            <p class="section-kicker">Deterministic review</p>
                            <h2>Specification Review Analysis</h2>
                            <p>Run analysis explicitly to generate review candidates from this artifact.</p>
                        </div>
                        <span class="se-analysis-state @(_analysisError is not null ? "is-failed" : IsAnalysisStale ? "is-stale" : HasCurrentAnalysis ? "is-current" : "")" data-testid="spec-review-state">
                            @(_analysisError is not null ? "Failed" : IsAnalysisStale ? "Stale" : HasCurrentAnalysis ? "Analyzed" : "Not run")
                        </span>
                    </div>

                    @if (HasCurrentAnalysis)
                    {
                        <div class="review-summary-strip" aria-label="Review analysis metrics">
                            <div class="summary-slot" data-testid="requirements-metric"><span>@RequirementMetric</span><small>Requirements analyzed</small></div>
                            <div class="summary-slot" data-testid="tests-metric"><span>@TestMetric</span><small>Tests analyzed</small></div>
                            <div class="summary-slot" data-testid="clarifications-metric"><span>@ClarificationMetric</span><small>Clarifications analyzed</small></div>
                            <div class="summary-slot" data-testid="candidates-metric"><span>@CandidateMetric</span><small>Review candidates</small></div>
                        </div>
                    }
                    else if (IsAnalysisStale)
                    {
                        <p class="se-analysis-notice" role="status">The previous review analysis belongs to a different Specification artifact or revision. Run analysis for the selected artifact.</p>
                    }

                    <button type="button"
                            class="btn-primary"
                            data-testid="spec-explorer-analyze"
                            disabled="@_isAnalyzing"
                            @onclick="AnalyzeSelectedSpecificationAsync">
                        @(_isAnalyzing ? "Analyzing..." : HasCurrentAnalysis || IsAnalysisStale ? "Re-analyze Specification" : _analysisError is not null ? "Retry Analysis" : "Analyze Specification")
                    </button>

                    @if (!string.IsNullOrWhiteSpace(_analysisError))
                    {
                        <div class="notification notification-error" role="alert">@_analysisError</div>
                    }
                    else if (_analysisError is null && !HasCurrentAnalysis)
                    {
                        <div class="extract-pre-state" data-testid="extract-pre-state" role="status">
                            <h3>@(IsAnalysisStale ? "Analysis is stale" : "Review analysis not run")</h3>
                            <p>@(IsAnalysisStale ? "Re-analyze the selected Specification to create current review results." : "No review analysis has been run for this Specification artifact.")</p>
                        </div>
                    }
                    else if (CandidateMetric == 0)
                    {
                        <div class="extract-pre-state" data-testid="spec-no-review-candidates" role="status">
                            <h3>No review candidates were found</h3>
                            <p>Analysis completed for the selected Specification and returned no candidates.</p>
                        </div>
                    }
                    else
                    {
                        <ExtractionReviewList PipelineResult="_pipelineResult!" InitialSession="null" SpecMarkdown="@_pipelineResult!.SpecMarkdown" ProjectSlug="@_projectSlug" />
                    }
                </section>
            </div>
        }
    </ArtifactExplorerHost>

</div>

@code {
    private string _text = string.Empty;
    private string? _projectSlug;
    private string? _artifactKey;
    private string? _analysisArtifactKey;
    private List<ExtractionCandidate> _candidates = [];
    private ExtractionPipelineResult? _pipelineResult;
    private bool _isAnalyzing;
    private string? _analysisError;
    private string? _parseError;

    private bool HasCurrentAnalysis => _pipelineResult is not null && _artifactKey is not null && _analysisArtifactKey == _artifactKey;
    private bool IsAnalysisStale => _pipelineResult is not null && !HasCurrentAnalysis;
    private IReadOnlyList<ExtractionCandidate> CandidatesForCurrentArtifact => HasCurrentAnalysis ? _candidates : [];
    private int RequirementMetric => _pipelineResult?.RequirementCount ?? 0;
    private int TestMetric => _pipelineResult?.TestCount ?? 0;
    private int ClarificationMetric => _pipelineResult?.NeedsClarificationCount ?? 0;
    private int CandidateMetric => _pipelineResult?.Candidates.Count ?? 0;

    private void OnArtifactChanged(ArtifactExplorerState state)
    {
        var text = state.Content ?? string.Empty;
        var artifactKey = BuildArtifactKey(state, text);
        if (string.Equals(artifactKey, _artifactKey, StringComparison.Ordinal)) return;
        // Preserve prior analysis only as stale context; it is never rendered as current for another artifact.
        _text = text;
        _projectSlug = state.ProjectSlug;
        _artifactKey = artifactKey;
        _candidates = [];
        _analysisError = null;
        _parseError = null;
        if (string.IsNullOrWhiteSpace(text)) return;
        try
        {
            var tree = SpecExplorerService.Parse(text);
            _ = SpecExplorerService.BuildSemanticModel(tree, text);
        }
        catch (Exception ex)
        {
            _parseError = ex.Message;
        }
    }

    private async Task AnalyzeSelectedSpecificationAsync()
    {
        if (_isAnalyzing || string.IsNullOrWhiteSpace(_text))
            return;

        var analyzedText = _text;
        var analyzedArtifactKey = _artifactKey;
        try
        {
            _isAnalyzing = true;
            _analysisError = null;
            var result = await ExtractionService.ExtractAsync(analyzedText, ExtractionProfile.Speckit);
            if (result.Status != PipelineStatus.Success)
            {
                if (analyzedArtifactKey == _artifactKey)
                {
                    _pipelineResult = null;
                    _analysisArtifactKey = null;
                    _candidates = [];
                    _analysisError = "Specification review analysis did not complete.";
                }
                return;
            }

            _pipelineResult = result.WithSpecMarkdown(analyzedText);
            _candidates = _pipelineResult.Candidates.ToList();
            _analysisArtifactKey = analyzedArtifactKey;
        }
        catch (Exception ex)
        {
            if (analyzedArtifactKey == _artifactKey)
            {
                _analysisError = $"Analysis failed: {ex.Message}";
                _pipelineResult = null;
                _analysisArtifactKey = null;
                _candidates = [];
            }
        }
        finally
        {
            _isAnalyzing = false;
        }
    }

    private static string BuildArtifactKey(ArtifactExplorerState state, string content)
    {
        var hash = Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(content)));
        return $"{state.ProjectSlug}|{state.Selected?.Id}|{state.Selected?.Revision}|{hash}";
    }
}
