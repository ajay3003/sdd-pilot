@page "/specification-explorer"
@using BirkNext.Web.Components
@using BirkNext.Web.Components.Explorers
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using BirkNext.Web.Services.Explorers
@using BirkNext.Web.GraphQL
@using System.Security.Cryptography
@using System.Text
@implements IDisposable

@inject BirkNext.Web.Services.IScenarioExtractionService ExtractionService
@inject IExtractionSessionService ExtractionSession
@inject IWorkspaceStateManager WorkspaceStateManager

<PageTitle>Specification Explorer — QA Review Studio</PageTitle>

<div class="se-page">

    <PageHeader Title="Specification Explorer"
                Description="@ArtifactExplorerRoles.Purpose(WorkspaceArtifactType.Specification)" />

    <ArtifactExplorerHost Role="WorkspaceArtifactType.Specification" OnStateChanged="OnArtifactChanged">
        @if (_parseError is not null)
        {
            <ExplorerAnalysisError Role="WorkspaceArtifactType.Specification" Message="@_parseError" />
        }
        else
        {
            <div class="se-page-body">
                @if (!_header.IsEmpty)
                {
                    <section class="se-feature-header" aria-label="Specification summary" data-testid="se-feature-header">
                        @if (_header.Status is { } status)
                        {
                            <p class="se-feature-status" data-testid="se-spec-status"><span class="se-status-pill">Specification status: @status</span>
                                <span class="se-muted">Ready for review</span></p>
                        }
                        @if (_header.Summary is { } featureSummary)
                        {
                            <div class="se-feature-summary" data-testid="se-feature-summary">
                                <strong>Feature summary</strong>
                                @if (featureSummary.Length > 320)
                                {
                                    <details><summary>@(featureSummary[..300])…</summary><p>@featureSummary</p></details>
                                }
                                else
                                {
                                    <p>@featureSummary</p>
                                }
                            </div>
                        }
                        @if (_header.FeatureBranch is not null || _header.Created is not null)
                        {
                            <details class="se-feature-tech" data-testid="se-feature-technical">
                                <summary>Technical details</summary>
                                <dl>
                                    @if (_header.FeatureBranch is { } branch) { <div><dt>Feature branch</dt><dd>@branch</dd></div> }
                                    @if (_header.Created is { } created) { <div><dt>Created</dt><dd>@created</dd></div> }
                                </dl>
                            </details>
                        }
                    </section>
                }
                <SpecExplorerPanel
                    InitialSpecMarkdown="@_text"
                    Candidates="@CandidatesForCurrentArtifact"
                    IsEmbeddedInReview="false" />

                <SpecificationRelationshipsPanel Projection="_projection" />

                <section class="se-traceability-state" aria-labelledby="se-traceability-title" data-testid="se-traceability-state">
                    <div>
                        <p class="section-kicker">Traceability &amp; Coverage</p>
                        <h2 id="se-traceability-title">Traceability has not been assessed yet.</h2>
                        <p>Tests and requirements are present in this specification, but coverage is assessed separately in Requirements Traceability.</p>
                    </div>
                    <a class="btn-secondary" href="artifact-traceability">Review traceability</a>
                </section>

                <section class="review-results-panel" aria-label="Specification review analysis" data-testid="spec-review-analysis">
                    <div class="review-results-header">
                        <div class="review-results-title">
                            <p class="section-kicker">Automated specification review</p>
                            <h2>Specification review</h2>
                            <p>BirkNext reviews the selected specification automatically and lists suggestions for a person to check.</p>
                        </div>
                        <span class="se-analysis-state @(_analysisError is not null ? "is-failed" : _isAnalyzing ? "is-analyzing" : IsAnalysisStale ? "is-stale" : HasCurrentAnalysis ? "is-current" : "")" data-testid="spec-review-state">
                            @(_analysisError is not null ? "Failed" : _isAnalyzing ? "Analyzing" : IsAnalysisStale ? "Not current" : HasCurrentAnalysis ? "Reviewed" : "Not run")
                        </span>
                    </div>

                    @if (HasCurrentAnalysis)
                    {
                        <div class="review-summary-strip" aria-label="Review analysis metrics">
                            @* Unique logical entities of the analyzed Specification; candidate records are counted separately. *@
                            <div class="summary-slot" data-testid="requirements-metric"><span>@ReviewSummary.Requirements</span><small>Requirements reviewed</small></div>
                            <div class="summary-slot" data-testid="tests-metric"><span>@ReviewSummary.Tests</span><small>Test scenarios reviewed</small></div>
                            <div class="summary-slot" data-testid="clarifications-metric"><span>@ReviewSummary.Clarifications</span><small>Clarifications reviewed</small></div>
                            <div class="summary-slot" data-testid="candidates-metric"><span>@ReviewSummary.Candidates</span><small>Review suggestions</small><small class="summary-slot-detail" data-testid="candidates-by-type">@ReviewSummary.RequirementCandidates requirements · @ReviewSummary.TestCandidates tests · @ReviewSummary.ClarificationCandidates clarifications</small></div>
                        </div>
                    }
                    else if (_isAnalyzing)
                    {
                        <p class="se-analysis-notice" role="status" aria-live="polite">Reviewing this specification. The structure stays available while the review runs.</p>
                    }
                    else if (IsAnalysisStale)
                    {
                        <p class="se-analysis-notice" role="status" data-testid="spec-review-not-current">Review results are from another specification or revision.</p>
                    }

                    <button type="button"
                            class="btn-primary"
                            data-testid="spec-explorer-analyze"
                            disabled="@_isAnalyzing"
                            @onclick="AnalyzeSelectedSpecificationAsync">
                        @(_isAnalyzing ? "Analyzing..." : HasCurrentAnalysis ? "Re-run review" : _analysisError is not null ? "Retry analysis" : "Analyze this specification")
                    </button>

                    @if (!string.IsNullOrWhiteSpace(_analysisError))
                    {
                        <div class="notification notification-error" role="alert">@_analysisError</div>
                    }
                    else if (_analysisError is null && !HasCurrentAnalysis && !_isAnalyzing)
                    {
                        <div class="extract-pre-state" data-testid="extract-pre-state" role="status">
                            <h3>@(IsAnalysisStale ? "Review results are from another specification or revision." : "Specification review not run")</h3>
                            <p>@(IsAnalysisStale ? "Analyze this specification to see review results for it." : "No review has been run for this specification yet.")</p>
                        </div>
                    }
                    else if (CandidateMetric == 0)
                    {
                        <div class="extract-pre-state" data-testid="spec-no-review-candidates" role="status">
                            <h3>No review suggestions</h3>
                            <p>The review of this specification found nothing to suggest for human review.</p>
                        </div>
                    }
                    else
                    {
                        <SpecificationReviewCandidateList Candidates="ReviewCandidates" Summary="ReviewSummary" SourceDocument="@_sourcePath" />
                    }
                </section>
            </div>
        }
    </ArtifactExplorerHost>

</div>

@code {
    private string _text = string.Empty;
    private SpecificationHeader _header = SpecificationHeader.Empty;
    private SpecificationEntityProjection _projection = SpecificationEntityProjection.Empty;
    private ExtractionPipelineResult? _candidatesSource;
    private IReadOnlyList<SpecReviewCandidate> _reviewCandidates = [];
    private string? _artifactKey;
    private string? _analysisArtifactKey;
    private List<ExtractionCandidate> _candidates = [];
    private ExtractionPipelineResult? _pipelineResult;
    private bool _isAnalyzing;
    private string? _analysisError;
    private string? _parseError;
    private readonly HashSet<string> _attemptedAnalysisKeys = new(StringComparer.Ordinal);
    private readonly HashSet<string> _inFlightAnalysisKeys = new(StringComparer.Ordinal);
    private bool _disposed;
    private const string AnalyzerVersion = "speckit-deterministic-v1";

    private bool HasCurrentAnalysis => _pipelineResult is not null && _artifactKey is not null && _analysisArtifactKey == _artifactKey;
    private bool IsAnalysisStale => _pipelineResult is not null && !HasCurrentAnalysis;
    private IReadOnlyList<ExtractionCandidate> CandidatesForCurrentArtifact => HasCurrentAnalysis ? _candidates : [];
    private int CandidateMetric => _pipelineResult?.Candidates.Count ?? 0;
    // The pipeline's per-type counts are candidate distributions; entity counts come from the logical entity projection.
    private IReadOnlyList<SpecReviewCandidate> ReviewCandidates
    {
        get
        {
            if (!HasCurrentAnalysis) return [];
            if (!ReferenceEquals(_candidatesSource, _pipelineResult))
            {
                _candidatesSource = _pipelineResult;
                _reviewCandidates = SpecificationReviewProjection.BuildCandidates(_projection, _candidates);
            }
            return _reviewCandidates;
        }
    }
    private SpecificationReviewSummary ReviewSummary => SpecificationReviewProjection.Summarize(_projection, ReviewCandidates);

    /// <summary>The analyzed specification document's path: review suggestions name it as their source.</summary>
    private string? _sourcePath;

    private async Task OnArtifactChanged(ArtifactExplorerState state)
    {
        var text = state.Content ?? string.Empty;
        _sourcePath = state.Selected?.SourcePath ?? state.Selected?.FileName;
        var artifactKey = BuildArtifactKey(state, text);
        if (string.Equals(artifactKey, _artifactKey, StringComparison.Ordinal)) return;
        // Preserve prior analysis only as stale context; it is never rendered as current for another artifact.
        _text = text;
        _header = SpecificationHeader.Parse(text);
        _artifactKey = artifactKey;
        _projection = SpecificationEntityProjection.Empty;
        _candidates = [];
        _analysisError = null;
        _parseError = null;
        if (string.IsNullOrWhiteSpace(text)) return;
        try
        {
            var tree = SpecExplorerService.Parse(text);
            _ = SpecExplorerService.BuildSemanticModel(tree, text);
            _projection = SpecificationReviewProjection.Build(tree);
        }
        catch (Exception ex)
        {
            _parseError = ex.Message;
            return;
        }

        await EnsureAnalysisCurrentAsync(artifactKey, text);
    }

    private Task AnalyzeSelectedSpecificationAsync()
    {
        if (_artifactKey is null || string.IsNullOrWhiteSpace(_text)) return Task.CompletedTask;
        _attemptedAnalysisKeys.Remove(_artifactKey);
        return EnsureAnalysisCurrentAsync(_artifactKey, _text, force: true);
    }

    private async Task EnsureAnalysisCurrentAsync(string analysisKey, string analyzedText, bool force = false)
    {
        if (_disposed || string.IsNullOrWhiteSpace(analyzedText) || _inFlightAnalysisKeys.Contains(analysisKey))
            return;

        if (!force && HasCurrentAnalysis) return;
        // An artifact already tried in this view (e.g. a pack viewed before) still gets its own cached result back when it is shown
        // again — keyed by exact artifact, revision and content — but extraction is never re-run automatically (a failure is not retried).
        var cacheOnly = !force && _attemptedAnalysisKeys.Contains(analysisKey);
        _attemptedAnalysisKeys.Add(analysisKey);
        _inFlightAnalysisKeys.Add(analysisKey);
        var analyzedArtifactKey = analysisKey;
        try
        {
            _isAnalyzing = true;
            _analysisError = null;
            await InvokeAsync(StateHasChanged);
            await Task.Yield();

            if (!force)
            {
                var cached = await ExtractionSession.GetSpecificationAnalysisAsync(analysisKey, AnalyzerVersion);
                if (cached is not null)
                {
                    var restoredSnapshot = new ExtractionSessionSnapshot
                    {
                        Profile = ExtractionProfile.Speckit,
                        PipelineStatus = cached.Candidates.Count == 0 ? PipelineStatus.NoResults : PipelineStatus.Success,
                        InputLengthChars = cached.InputLengthChars,
                        InputLineCount = cached.InputLineCount,
                        DurationMs = cached.DurationMs,
                        Candidates = cached.Candidates,
                        SpecMarkdown = analyzedText,
                    };
                    var restored = ExtractionPipelineResult.Restore(restoredSnapshot).WithSpecMarkdown(analyzedText);
                    if (_artifactKey == analyzedArtifactKey && !_disposed)
                    {
                        _pipelineResult = restored;
                        _candidates = restored.Candidates.ToList();
                        _analysisArtifactKey = analyzedArtifactKey;
                    }
                    return;
                }
                if (cacheOnly) return;
            }

            var result = await ExtractionService.ExtractAsync(analyzedText, ExtractionProfile.Speckit);
            if (result.Status is not (PipelineStatus.Success or PipelineStatus.NoResults))
            {
                if (analyzedArtifactKey == _artifactKey && !_disposed)
                {
                    _pipelineResult = null;
                    _analysisArtifactKey = null;
                    _candidates = [];
                    _analysisError = result.Status switch
                    {
                        PipelineStatus.EmptyInput => "The selected Specification has no content to analyze.",
                        PipelineStatus.InputTooLarge => "The selected Specification is too large for deterministic review analysis.",
                        _ => "Specification review analysis did not complete.",
                    };
                }
                return;
            }

            var completed = result.WithSpecMarkdown(analyzedText);
            var cacheEntry = new SpecificationAnalysisCacheEntry(
                analyzedArtifactKey,
                AnalyzerVersion,
                DateTimeOffset.UtcNow,
                completed.InputLengthChars,
                completed.InputLineCount,
                completed.DurationMs,
                completed.Candidates.Select(candidate => new CandidateSnapshot(
                    candidate.CandidateId,
                    candidate.Title,
                    candidate.Classification,
                    candidate.ClassificationSignal,
                    candidate.ContextHeading,
                    candidate.SourceBlockType,
                    candidate.Confidence,
                    false,
                    CandidateReviewStatus.New,
                    CandidateSaveState.Pending,
                    null,
                    null)).ToList());
            await ExtractionSession.SaveSpecificationAnalysisAsync(cacheEntry);
            if (_artifactKey == analyzedArtifactKey && !_disposed)
            {
                _pipelineResult = completed;
                _candidates = completed.Candidates.ToList();
                _analysisArtifactKey = analyzedArtifactKey;
            }
        }
        catch (Exception)
        {
            if (analyzedArtifactKey == _artifactKey && !_disposed)
            {
                _analysisError = "Specification review analysis failed. Retry analysis to try again.";
                _pipelineResult = null;
                _analysisArtifactKey = null;
                _candidates = [];
            }
        }
        finally
        {
            _inFlightAnalysisKeys.Remove(analyzedArtifactKey);
            if (analyzedArtifactKey == _artifactKey && !_disposed)
            {
                _isAnalyzing = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private string BuildArtifactKey(ArtifactExplorerState state, string content)
    {
        var hash = Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(content)));
        return $"{WorkspaceStateManager.CurrentWorkspaceId}|{state.ProjectSlug}|{state.Selected?.Id}|{state.Selected?.Revision}|{hash}|{AnalyzerVersion}";
    }

    public void Dispose() => _disposed = true;
}
