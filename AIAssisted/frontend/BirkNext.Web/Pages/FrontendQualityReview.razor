@page "/frontend-quality-review"
@using BirkNext.Web.Components
@using BirkNext.Web.Models.QualityReview
@using BirkNext.Web.Services
@inject IQualityReviewPageModelService PageModelService
@inject IFrontendAnalysisContextFactory ContextFactory
@inject IJSRuntime JS

<PageTitle>Frontend Quality Review</PageTitle>

<div class="fqr-page">
    <PageHeader Title="@(PageModel?.Title ?? "Frontend Quality Review")"
                Description="@(PageModel?.Description ?? "Analyse a deployed frontend for performance, security, accessibility, standards compliance, Blazor WASM-specific checks, and QA readiness in a single unified review.")" />

    <!-- ── Readiness Panel ────────────────────────────────────────── -->
    @if (PageModel is not null)
    {
        <QualityReviewReadinessPanel Model="PageModel" />
    }
    else if (IsLoading)
    {
        <div class="fqr-loading" role="status">Loading page configuration...</div>
    }
    else if (LoadError is not null)
    {
        <div class="fqr-error" role="alert">@LoadError</div>
    }

    <!-- ── Run Button ───────────────────────────────────────────── -->
    @if (PageModel is not null)
    {
        <div class="fqr-actions">
            <button class="btn-primary" disabled="@(!PageModel.Summary.CanRun)" @onclick="RunAudit">
                @if (IsRunning)
                {
                    <span class="spinner" aria-hidden="true">⟳</span>
                }
                @(IsRunning ? "Analysing…" : "Run Frontend Quality Review")
            </button>
        </div>
    }

</div>

@code {
    private QualityReviewPageModel? PageModel;
    private bool IsLoading = true;
    private string? LoadError;
    private bool IsRunning;

    protected override async Task OnInitializedAsync()
    {
        // Load initial page model
        await RefreshPageModel();
    }

    private async Task RefreshPageModel()
    {
        try
        {
            IsLoading = true;
            LoadError = null;
            PageModel = await PageModelService.GetFrontendQualityReviewModelAsync();

            if (PageModel is null)
            {
                LoadError = "Failed to load page configuration";
            }
        }
        catch (Exception ex)
        {
            LoadError = $"Error loading configuration: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task RunAudit()
    {
        if (PageModel?.Summary.CanRun != true)
            return;

        IsRunning = true;
        try
        {
            // Call the actual quality review service
            await Task.Delay(1000); // Placeholder
        }
        finally
        {
            IsRunning = false;
        }
    }

}
