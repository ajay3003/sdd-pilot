    private static string CandidateState(FrontendQualityCapabilityAvailability state) => state switch
    {
        FrontendQualityCapabilityAvailability.Available => "Available now",
        FrontendQualityCapabilityAvailability.CheckedAtRun => "Checked when the review runs",
        FrontendQualityCapabilityAvailability.Unsupported => "Not supported here",
