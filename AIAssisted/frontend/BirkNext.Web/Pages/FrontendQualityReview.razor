@page "/frontend-quality-review"
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using BirkNext.Web.Components
@inject IFrontendQualityReviewOrchestrator Orchestrator
@inject IFrontendAnalysisContextFactory ContextFactory
@inject RuntimeReviewSessionService RuntimeReviews
@inject IWorkspaceSessionService Workspace
@inject IReportExportService ExportService
@inject IJSRuntime JS

<PageTitle>Frontend Quality Review</PageTitle>

<div class="wsr-page fqr-page">

    <PageHeader Title="Frontend Quality Review"
                Description="Analyse a deployed frontend for performance, security, accessibility, standards compliance, Blazor WASM-specific checks, and QA readiness in a single unified review.">
        @if (_report is not null)
        {
            <button type="button" class="btn-secondary" @onclick="ExportHtml">Export HTML</button>
            <button type="button" class="btn-secondary" @onclick="ExportPdf">Export PDF</button>
        }
    </PageHeader>

    @if (_report is null)
    {
        <ReviewLanding Title="Run a production-style frontend audit"
                       Description="Review performance, security, accessibility, standards, Blazor WASM behavior, and QA readiness for the active target environment. Assessment completeness depends on available engines and target configuration."
                       PrimaryButtonText="@(_running ? "Analysing..." : "Run Frontend Quality Review")"
                       PrimaryRun="RunReview"
                       PrimaryDisabled="@(_running || _context is null || !_context.HasTargetUrl)"
                       SecondaryActionText="Target Environments"
                       SecondaryActionHref="/admin/system-settings"
                       TargetFields="BuildFrontendTargetFields()"
                       Configuration="BuildFrontendConfiguration()"
                       AnalysisCards="FrontendAnalysisCards"
                       Checks="FrontendChecks"
                       Metadata="BuildFrontendMetadata()"
                       EstimatedDuration="Scan duration depends on target size and enabled checks." />

        @if (_running)
        {
            <p class="wsr-scan-progress" aria-live="polite">@_progressMessage</p>
        }
    }

    @if (_secError is not null)
    {
        <div class="wsr-banner wsr-banner-warn wsr-banner-standalone" role="status">
            <span aria-hidden="true">!</span> Security scan: @_secError - security findings will be incomplete.
        </div>
    }
    @if (_perfError is not null)
    {
        <div class="wsr-banner wsr-banner-warn wsr-banner-standalone" role="status">
            <span aria-hidden="true">!</span> Performance scan: @_perfError - performance findings will be incomplete.
        </div>
    }

    @if (_report is not null)
    {
        var report = _report;
        var topRisks = report.Findings
            .Where(f => f.Severity is FrontendQualitySeverity.Critical or FrontendQualitySeverity.High)
            .OrderBy(f => f.Severity)
            .ThenBy(f => f.Category)
            .ThenBy(f => f.Title)
            .ToList();
        var filtered = FilteredFindings(report.Findings).ToList();
        var recommendations = BuildRecommendationCards(report).ToList();

        <FrontendQualityDecisionSupport Report="report" />

        @if (ShowLegacyDecisionSupport)
        {
        @if (report.Completeness == AssessmentCompleteness.Partial)
        {
            <div class="wsr-banner wsr-banner-warn wsr-banner-standalone" role="status">
                <span aria-hidden="true">!</span> Partial assessment: Only @string.Join(", ", report.AssessedEngines) ran successfully. Assessment completeness is limited.
            </div>
        }
        else if (report.Completeness == AssessmentCompleteness.Failed)
        {
            <div class="wsr-banner wsr-banner-error wsr-banner-standalone" role="status">
                <span aria-hidden="true">⚠</span> Assessment failed: All engines encountered errors. Review is not available.
            </div>
        }

        @if (report.AccessibilityReport is { } accessibility)
        {
            <section class="fqr-section" aria-label="Automated accessibility checks">
                <SectionHeader Title="Automated accessibility checks" />
                @if (accessibility.ExecutionStatus == AccessibilityExecutionStatusDto.Assessed)
                {
                    <p>Automated assessment completed with axe-core @accessibility.AxeVersion on @accessibility.BrowserName @accessibility.BrowserVersion.</p>
                    <p><strong>Automated violations:</strong> @accessibility.ViolationCount &nbsp; <strong>Needs manual review:</strong> @accessibility.IncompleteCount</p>
                }
                else
                {
                    <p><strong>Accessibility engine:</strong> @accessibility.ExecutionStatus — @accessibility.EngineError</p>
                }
                <p>Automated tooling cannot verify all WCAG requirements. Manual accessibility testing is still required. Zero automated violations does not establish WCAG conformance.</p>
            </section>
        }

        @if (report.LighthouseReport is { } lighthouse)
        {
            <section class="fqr-section" aria-label="Lighthouse lab performance">
                <SectionHeader Title="Lighthouse Lab Performance" />
                @if (lighthouse.ExecutionStatus == LighthouseExecutionStatusDto.Assessed)
                {
                    <p><strong>Lighthouse Performance Score:</strong> @lighthouse.PerformanceScore/100</p>
                    @foreach (var metric in lighthouse.Metrics ?? [])
                    {
                        <span><strong>Lab @metric.Name:</strong> @(metric.ObservedValue?.ToString("0.##") ?? "Not available") @metric.Unit &nbsp; </span>
                    }
                }
                else
                {
                    <p><strong>Lighthouse engine:</strong> @lighthouse.ExecutionStatus — @lighthouse.EngineError</p>
                }
                <p><strong>Measurement:</strong> Synthetic / Lab. Field data is not included; INP requires real-user field data.</p>
            </section>
        }

        @if (report.PassiveSecurityReport is { } passive)
        {
            <section class="fqr-section" aria-label="Passive Security Assessment">
                <SectionHeader Title="Passive Security Assessment" />
                @if (passive.ExecutionStatus == PassiveSecurityExecutionStatusDto.Assessed)
                {
                    <p><strong>Mode:</strong> Passive only &nbsp; <strong>ZAP version:</strong> @(passive.ZapVersion ?? "Unavailable")</p>
                    <p><strong>Scope:</strong> @passive.ScopeSummary &nbsp; <strong>Duration:</strong> @(passive.DurationMs.HasValue ? $"{passive.DurationMs.Value / 1000.0:0.##}s" : "Unavailable")</p>
                    <p><strong>High:</strong> @passive.HighCount &nbsp; <strong>Medium:</strong> @passive.MediumCount &nbsp; <strong>Low:</strong> @passive.LowCount &nbsp; <strong>Informational:</strong> @passive.InformationalCount</p>
                    @foreach (var finding in passive.Findings ?? [])
                    {
                        <article class="fqr-recommendation-card">
                            <h3>@finding.Name</h3>
                            <p><strong>Risk:</strong> @finding.Risk &nbsp; <strong>Confidence:</strong> @finding.Confidence &nbsp; <strong>Instances:</strong> @finding.InstancesCount</p>
                            <p><strong>URL:</strong> @finding.Url</p>
                            @if (!string.IsNullOrWhiteSpace(finding.Evidence)) { <p><strong>Safe evidence:</strong> @finding.Evidence</p> }
                            <p><strong>Solution:</strong> @finding.Solution</p>
                        </article>
                    }
                }
                else
                {
                    <p><strong>Engine Error / Not Assessed:</strong> @passive.ExecutionStatus — @passive.EngineError</p>
                }
                <p>Passive automated scanning cannot prove that an application is secure and does not replace authenticated or active penetration testing.</p>
            </section>
        }

        <section class="fqr-summary-grid" aria-label="Frontend quality score summary">
            @if (report.OverallScore.HasValue)
            {
                <MetricCard Value="@report.OverallScore.Value.ToString()" Label="Overall Score" Sublabel="@QualityLabel(report.OverallScore.Value)" Variant="@ScoreVariant(report.OverallScore.Value)" />
            }
            else
            {
                <MetricCard Value="—" Label="Overall Score" Sublabel="Partial assessment" Variant="warning" />
            }

            @foreach (var cat in report.CategoryScores)
            {
                @if (cat.Assessed && cat.Score.HasValue)
                {
                    <MetricCard Value="@cat.Score.Value.ToString()" Label="@CategoryLabel(cat.Category)" Sublabel="@QualityLabel(cat.Score.Value)" Variant="@ScoreVariant(cat.Score.Value)" />
                }
                else if (cat.Assessed)
                {
                    <MetricCard Value="—" Label="@CategoryLabel(cat.Category)" Sublabel="@(cat.NotAssessedReason ?? "Engine not available")" Variant="warning" />
                }
                else
                {
                    <MetricCard Value="—" Label="@CategoryLabel(cat.Category)" Sublabel="Not assessed" Variant="neutral" />
                }
            }
        </section>

        <section class="fqr-section" aria-label="Top risks">
            <SectionHeader Title="Top Risks" />
            @if (topRisks.Count == 0)
            {
                <div class="fqr-empty-panel">No critical or high findings were detected.</div>
            }
            else
            {
                <div class="fqr-risk-grid">
                    @foreach (var risk in topRisks)
                    {
                        <article class="fqr-risk-card fqr-risk-@risk.Severity.ToString().ToLowerInvariant()">
                            <div class="fqr-risk-meta">
                                <span class="fqr-severity fqr-severity-@risk.Severity.ToString().ToLowerInvariant()">@risk.Severity</span>
                                <span class="fqr-risk-category">@CategoryLabel(risk.Category)</span>
                            </div>
                            <h3>@risk.Title</h3>
                            <div class="fqr-risk-detail">
                                <span>Risk</span>
                                <p>@risk.Description</p>
                            </div>
                            <div class="fqr-risk-detail">
                                <span>Recommendation</span>
                                <p>@risk.Recommendation</p>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        }

        <section class="fqr-section" aria-label="Category summary">
            <SectionHeader Title="Category Summary" />
            <div class="fqr-category-grid">
                @foreach (var category in Enum.GetValues<FrontendQualityCategory>())
                {
                    var summary = GetCategorySummary(report, category);
                    <button type="button"
                            class="fqr-category-card @(_catFilter == category ? "is-active" : "")"
                            @onclick="() => SetCategoryFilter(category)"
                            aria-pressed="@(_catFilter == category)"
                            aria-label="Filter findings by @CategoryLabel(category)">
                        <span class="fqr-category-title">@CategoryLabel(category)</span>
                        <strong>@summary.Total</strong>
                        <span class="fqr-category-sub">total findings</span>
                        <dl class="fqr-category-counts">
                            <div><dt>Critical</dt><dd>@summary.Critical</dd></div>
                            <div><dt>High</dt><dd>@summary.High</dd></div>
                            <div><dt>Medium</dt><dd>@summary.Medium</dd></div>
                            <div><dt>Low</dt><dd>@summary.Low</dd></div>
                        </dl>
                    </button>
                }
            </div>
        </section>

        <section class="fqr-section" aria-label="Detailed findings">
            <SectionHeader Title="Detailed Findings" />
            <div class="fqr-findings-toolbar" role="group" aria-label="Filter findings">
                <input type="search"
                       class="form-control fqr-search"
                       placeholder="Search findings..."
                       aria-label="Search findings"
                       value="@_findingSearch"
                       @oninput="e => _findingSearch = e.Value?.ToString() ?? string.Empty" />

                <select class="form-control fqr-select" @bind="_severityFilterValue" @bind:after="ApplySeverityFilter" aria-label="Filter by severity">
                    <option value="">All severities</option>
                    @foreach (var sev in Enum.GetValues<FrontendQualitySeverity>())
                    {
                        <option value="@sev.ToString()">@sev</option>
                    }
                </select>

                <select class="form-control fqr-select" @bind="_categoryFilterValue" @bind:after="ApplyCategoryFilter" aria-label="Filter by category">
                    <option value="">All categories</option>
                    @foreach (var cat in Enum.GetValues<FrontendQualityCategory>())
                    {
                        <option value="@cat.ToString()">@CategoryLabel(cat)</option>
                    }
                </select>

                @if (_sevFilter is not null || _catFilter is not null || !string.IsNullOrWhiteSpace(_findingSearch))
                {
                    <button type="button" class="btn-secondary" @onclick="ClearFilters">Clear</button>
                }
            </div>

            @if (filtered.Count == 0)
            {
                <div class="fqr-empty-panel">No findings match the current filter.</div>
            }
            else
            {
                <div class="fqr-table-wrap">
                    <table class="fqr-findings-table">
                        <thead>
                            <tr>
                                <th><button type="button" @onclick='() => SortBy("severity")'>Severity @SortGlyph("severity")</button></th>
                                <th><button type="button" @onclick='() => SortBy("category")'>Category @SortGlyph("category")</button></th>
                                <th><button type="button" @onclick='() => SortBy("title")'>Title @SortGlyph("title")</button></th>
                                <th>Description</th>
                                <th>Recommendation</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var finding in filtered)
                            {
                                <tr>
                                    <td><span class="fqr-severity fqr-severity-@finding.Severity.ToString().ToLowerInvariant()">@finding.Severity</span></td>
                                    <td>@CategoryLabel(finding.Category)</td>
                                    <td>
                                        <strong>@finding.Title</strong>
                                        @if (!string.IsNullOrWhiteSpace(finding.SourceSystem))
                                        {
                                            <span class="fqr-source">@finding.SourceSystem</span>
                                        }
                                    </td>
                                    <td>@finding.Description</td>
                                    <td>@finding.Recommendation</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        @if (recommendations.Count > 0)
        {
            <section class="fqr-section" aria-label="Recommendations">
                <SectionHeader Title="Recommendations" />
                <div class="fqr-recommendation-grid">
                    @foreach (var rec in recommendations)
                    {
                        <article class="fqr-recommendation-card fqr-recommendation-@rec.Priority.ToLowerInvariant()">
                            <div class="fqr-recommendation-priority">@rec.Priority Priority</div>
                            <h3>@rec.Title</h3>
                            <p>@rec.Description</p>
                            <div class="fqr-recommendation-benefit">
                                <span>Expected benefit</span>
                                <p>@rec.ExpectedBenefit</p>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }

        <section class="fqr-section" aria-label="Technical details">
            <details class="fqr-technical-details">
                <summary>Technical Details</summary>
                <div class="fqr-technical-grid">
                    <InfoRow Label="Target URL (Requested)">@report.TargetUrl</InfoRow>
                    @if (!string.IsNullOrWhiteSpace(report.FinalUrl) && report.FinalUrl != report.TargetUrl)
                    {
                        <InfoRow Label="Target URL (Final)">@report.FinalUrl</InfoRow>
                        @if (report.RedirectOccurred)
                        {
                            <InfoRow Label="Redirect Occurred">Yes</InfoRow>
                        }
                    }
                    <InfoRow Label="Generated">@report.GeneratedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</InfoRow>
                    @if (report.CompletedAt.HasValue && report.DurationMs.HasValue)
                    {
                        <InfoRow Label="Completed">@report.CompletedAt.Value.ToString("yyyy-MM-dd HH:mm:ss") UTC</InfoRow>
                        <InfoRow Label="Duration">@(report.DurationMs.Value / 1000.0)s</InfoRow>
                    }
                    <InfoRow Label="Assessment Completeness">@(report.Completeness?.ToString() ?? "Unknown")</InfoRow>
                    @if (report.AssessedEngines.Count > 0)
                    {
                        <InfoRow Label="Assessed Engines">@string.Join(", ", report.AssessedEngines)</InfoRow>
                    }
                    @if (report.SkippedEngines.Count > 0)
                    {
                        <InfoRow Label="Skipped Engines">@string.Join(", ", report.SkippedEngines)</InfoRow>
                    }
                    @if (report.FailedEngines.Count > 0)
                    {
                        <InfoRow Label="Failed Engines">@string.Join(", ", report.FailedEngines)</InfoRow>
                    }
                    <InfoRow Label="Application">@(report.IsBlazorWasm ? "Blazor WASM detected" : "Blazor WASM not detected")</InfoRow>
                    @if (!string.IsNullOrWhiteSpace(report.ErrorMessage))
                    {
                        <InfoRow Label="Error">@report.ErrorMessage</InfoRow>
                    }
                    @if (report.Risks.Count > 0)
                    {
                        <div class="fqr-technical-list">
                            <h3>Risks</h3>
                            <ul>
                                @foreach (var risk in report.Risks)
                                {
                                    <li>@risk</li>
                                }
                            </ul>
                        </div>
                    }
                    @if (report.Limitations.Count > 0)
                    {
                        <div class="fqr-technical-list">
                            <h3>Assessment Limitations</h3>
                            <ul>
                                @foreach (var limitation in report.Limitations)
                                {
                                    <li>@limitation</li>
                                }
                            </ul>
                        </div>
                    }
                    <div class="fqr-technical-list">
                        <h3>Scope</h3>
                        <p>This review combines the configured static, passive, and real-browser engines shown in the engine matrix. It does not establish:</p>
                        <ul>
                            <li>Active vulnerability scanning or penetration testing</li>
                            <li>WCAG conformance or completion of manual accessibility testing</li>
                            <li>Production field Core Web Vitals or field INP</li>
                            <li>End-to-end user flow validation</li>
                        </ul>
                    </div>
                    @if (report.Findings.Any(f => f.Evidence.Count > 0))
                    {
                        <div class="fqr-technical-list fqr-technical-evidence">
                            <h3>Evidence</h3>
                            @foreach (var finding in report.Findings.Where(f => f.Evidence.Count > 0))
                            {
                                <div class="fqr-evidence-group">
                                    <strong>@finding.Title</strong>
                                    <ul>
                                        @foreach (var evidence in finding.Evidence)
                                        {
                                            <li><code>@evidence</code></li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    }
                </div>
            </details>
        </section>
    }
</div>

@code {
    private sealed record CategorySummary(int Total, int Critical, int High, int Medium, int Low);
    private sealed record RecommendationView(string Priority, string Title, string Description, string ExpectedBenefit);
    private static readonly ReviewLanding.AnalysisCard[] FrontendAnalysisCards =
    [
        new("PF", "Performance", "Passive asset analysis: measures bundle size, HTTP timing, compression, and caching heuristics."),
        new("SC", "Security", "Passive security scan: reviews headers, exposed configuration, and attack surface indicators."),
        new("AX", "Accessibility", "Optional axe-core checks inspect the rendered DOM. Manual accessibility testing remains required."),
        new("ST", "Standards Compliance", "Security header compliance and standards validation."),
        new("BW", "Blazor WASM", "Static Blazor artifact analysis and bundle optimization indicators."),
        new("QA", "QA Readiness", "Deployment readiness signals derived from performance metrics."),
    ];

    private static readonly string[] FrontendChecks =
    [
        "Security Headers (Assessed)",
        "CSP (Assessed)",
        "CORS (Assessed)",
        "Bundle Size (Assessed)",
        "Compression (Assessed)",
        "Cache Headers (Assessed)",
        "Startup Asset Analysis (Assessed)",
        "Service Worker Detection",
        "Core Web Vitals (Not Assessed — requires browser runtime)",
        "WCAG-related automated checks (axe-core when enabled; manual testing still required)",
        "OWASP-related frontend indicators (passive checks only — no compliance claim)",
        "Testability (Not Assessed — not implemented)",
        "Observability (Not Assessed — not implemented)",
        "Lazy Loading (Static detection only)",
    ];

    private FrontendAnalysisContext? _context;

    private bool    _running;
    private string  _progressMessage = "";
    private string? _secError;
    private string? _perfError;

    private FrontendQualityReviewReport? _report;
    private bool ShowLegacyDecisionSupport => false;

    private string? _findingSearch;
    private FrontendQualitySeverity? _sevFilter;
    private FrontendQualityCategory? _catFilter;
    private string _severityFilterValue = "";
    private string _categoryFilterValue = "";
    private string _sortColumn = "severity";
    private bool _sortDescending;

    protected override async Task OnInitializedAsync()
    {
        _context = await ContextFactory.GetActiveContextAsync();
        _report  = RuntimeReviews.QualityReview.Report;
    }

    private async Task RunReview()
    {
        if (_context is null || !_context.HasTargetUrl) return;

        _running     = true;
        _secError    = null;
        _perfError   = null;
        _report      = null;
        RuntimeReviews.MarkQualityRunning(_context);
        StateHasChanged();

        var startTime = DateTime.UtcNow;
        _progressMessage = "Running enabled review engines...";
        StateHasChanged();
        var orchestration = await Orchestrator.RunAsync(_context.TargetUrl, _context);
        _secError = orchestration.SecurityError;
        _perfError = orchestration.PerformanceError;

        // ── Preflight target validation before scanning ────────────────
        if (orchestration.QualityReport is null)
        {
            _running = false;
            RuntimeReviews.MarkQualityFailed(
                _context,
                orchestration.PreflightBlockReason ?? "Enabled review engines did not produce a quality report.");
            StateHasChanged();
            return;
        }

        // ── Security scan — respects EnableSecurityEngine toggle ──
        // ── Performance scan — respects EnablePerformanceEngine toggle ──
        _progressMessage = "Building quality report...";
        StateHasChanged();

        var qualityReport = orchestration.QualityReport;

        // Enhance report with timing and completion info.
        var completedReport = new FrontendQualityReviewReport
        {
            TargetUrl = qualityReport.TargetUrl,
            FinalUrl = qualityReport.FinalUrl,
            GeneratedAt = qualityReport.GeneratedAt,
            CompletedAt = DateTime.UtcNow,
            DurationMs = (long)(DateTime.UtcNow - startTime).TotalMilliseconds,
            OverallScore = qualityReport.OverallScore,
            PerformanceScore = qualityReport.PerformanceScore,
            SecurityScore = qualityReport.SecurityScore,
            AccessibilityScore = qualityReport.AccessibilityScore,
            StandardsScore = qualityReport.StandardsScore,
            WasmScore = qualityReport.WasmScore,
            ReadinessScore = qualityReport.ReadinessScore,
            Findings = qualityReport.Findings,
            LogicalIssues = qualityReport.LogicalIssues,
            ManualReviewItems = qualityReport.ManualReviewItems,
            CategoryScores = qualityReport.CategoryScores,
            Recommendations = qualityReport.Recommendations,
            Risks = qualityReport.Risks,
            Limitations = qualityReport.Limitations,
            IsBlazorWasm = qualityReport.IsBlazorWasm,
            Coverage = qualityReport.Coverage,
            ReleaseDisposition = qualityReport.ReleaseDisposition,
            EngineOutcomes = qualityReport.EngineOutcomes,
            Completeness = qualityReport.Completeness,
            AssessedEngines = qualityReport.AssessedEngines,
            FailedEngines = qualityReport.FailedEngines,
            SkippedEngines = qualityReport.SkippedEngines,
            PreflightStatus = qualityReport.PreflightStatus,
            PreflightMessage = qualityReport.PreflightMessage,
            AccessibilityReport = qualityReport.AccessibilityReport,
            LighthouseReport = qualityReport.LighthouseReport,
            PassiveSecurityReport = qualityReport.PassiveSecurityReport,
            BrowserRuntimeReport = qualityReport.BrowserRuntimeReport,
        };

        _report  = completedReport;
        _running = false;
        RuntimeReviews.SaveQualityResult(_report, _context);
        ClearFilters();
    }

    private async Task ExportHtml()
    {
        if (_report is null) return;
        var html = ExportService.ExportFrontendQualityReview(_report, Workspace.ProjectName);
        await JS.InvokeVoidAsync("downloadHtmlFile", $"frontend-quality-review-{DateTime.UtcNow:yyyy-MM-dd}.html", html);
    }

    private async Task ExportPdf()
    {
        await JS.InvokeVoidAsync("print");
    }

    private async Task RefreshContext()
    {
        _context = await ContextFactory.GetActiveContextAsync();
    }

    private IReadOnlyList<ReviewLanding.TargetField> BuildFrontendTargetFields()
    {
        if (_context is null)
        {
            return
            [
                new("Environment", "Loading...", ReviewLanding.FieldStatus.Informational),
                new("Target URL", "Loading...", ReviewLanding.FieldStatus.Informational),
                new("Authentication", "Loading...", ReviewLanding.FieldStatus.Informational),
                new("Auth Status", "Loading...", ReviewLanding.FieldStatus.Informational),
            ];
        }

        return
        [
            new("Environment", $"{_context.ActiveProfile.EnvironmentType} - {_context.ActiveProfile.Name}", ReviewLanding.FieldStatus.Configured),
            new("Target URL", _context.HasTargetUrl ? _context.TargetUrl : "Not configured", _context.HasTargetUrl ? ReviewLanding.FieldStatus.Configured : ReviewLanding.FieldStatus.Missing),
            new("Authentication", _context.AuthenticationType.ToString(), ReviewLanding.FieldStatus.Informational),
            new("Auth Status", _context.IsAuthenticatedSessionAvailable ? "Authenticated" : _context.RequiresAuthentication ? "Session unavailable" : "Not required",
                _context.IsAuthenticatedSessionAvailable || !_context.RequiresAuthentication ? ReviewLanding.FieldStatus.Configured : ReviewLanding.FieldStatus.Warning),
        ];
    }

    private IReadOnlyList<ReviewLanding.MetadataItem> BuildFrontendMetadata()
    {
        if (_context is null) return [];
        return
        [
            new("Environment", _context.ActiveProfile.EnvironmentType.ToString()),
            new("Authentication", _context.AuthenticationType.ToString()),
            new("Accessibility", _context.FeatureToggles.EnableAccessibilityEngine ? "Enabled (automated axe-core checks)" : "Disabled"),
            new("Lighthouse", _context.FeatureToggles.EnableLighthouseEngine ? "Enabled (synthetic lab measurement)" : "Disabled"),
            new("Passive Security", _context.FeatureToggles.EnablePassiveSecurityEngine ? "Enabled (ZAP passive only)" : "Disabled"),
        ];
    }

    private ReviewLanding.ConfigurationState BuildFrontendConfiguration()
    {
        if (_context is null)
        {
            return new(
                ReviewLanding.ConfigurationStatus.Warning,
                "Loading target environment",
                "The active frontend analysis profile is still loading.",
                []);
        }

        var missing = new List<string>();
        if (!_context.HasTargetUrl)
            missing.Add("Frontend target URL");

        missing.AddRange(_context.ValidationErrors);

        if (missing.Count > 0)
        {
            return new(
                ReviewLanding.ConfigurationStatus.Error,
                "Configuration incomplete",
                "Resolve the missing requirements before running the review.",
                missing,
                "Configure Target Environment",
                "/admin/system-settings");
        }

        if (_context.HasValidationWarnings)
        {
            return new(
                ReviewLanding.ConfigurationStatus.Warning,
                "Configuration valid with warnings",
                $"Configuration is valid but has concerns: {string.Join(" | ", _context.ValidationWarnings)} Target reachability will be verified during scan.",
                [],
                "Review Settings",
                "/admin/system-settings");
        }

        return new(
            ReviewLanding.ConfigurationStatus.Success,
            "Configuration valid — ready to scan",
            "Frontend target is configured. Target reachability will be verified when you start the review.",
            []);
    }

    private void SetCategoryFilter(FrontendQualityCategory cat)
    {
        _catFilter = _catFilter == cat ? null : cat;
        _categoryFilterValue = _catFilter?.ToString() ?? "";
    }

    private void ApplySeverityFilter()
    {
        _sevFilter = Enum.TryParse<FrontendQualitySeverity>(_severityFilterValue, out var sev) ? sev : null;
    }

    private void ApplyCategoryFilter()
    {
        _catFilter = Enum.TryParse<FrontendQualityCategory>(_categoryFilterValue, out var cat) ? cat : null;
    }

    private void ClearFilters()
    {
        _sevFilter = null;
        _catFilter = null;
        _findingSearch = null;
        _severityFilterValue = "";
        _categoryFilterValue = "";
    }

    private void SortBy(string column)
    {
        if (_sortColumn == column)
        {
            _sortDescending = !_sortDescending;
            return;
        }

        _sortColumn = column;
        _sortDescending = false;
    }

    private string SortGlyph(string column) =>
        _sortColumn != column ? "" : _sortDescending ? "v" : "^";

    private IEnumerable<FrontendQualityFinding> FilteredFindings(IReadOnlyList<FrontendQualityFinding> all)
    {
        IEnumerable<FrontendQualityFinding> q = all;
        if (_sevFilter.HasValue) q = q.Where(f => f.Severity == _sevFilter.Value);
        if (_catFilter.HasValue) q = q.Where(f => f.Category == _catFilter.Value);
        if (!string.IsNullOrWhiteSpace(_findingSearch))
        {
            var term = _findingSearch.Trim();
            q = q.Where(f =>
                f.Title.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                f.Description.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                f.Recommendation.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                CategoryLabel(f.Category).Contains(term, StringComparison.OrdinalIgnoreCase) ||
                f.Severity.ToString().Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        q = _sortColumn switch
        {
            "category" => _sortDescending
                ? q.OrderByDescending(f => CategoryLabel(f.Category)).ThenBy(f => f.Severity).ThenBy(f => f.Title)
                : q.OrderBy(f => CategoryLabel(f.Category)).ThenBy(f => f.Severity).ThenBy(f => f.Title),
            "title" => _sortDescending
                ? q.OrderByDescending(f => f.Title).ThenBy(f => f.Severity)
                : q.OrderBy(f => f.Title).ThenBy(f => f.Severity),
            _ => _sortDescending
                ? q.OrderByDescending(f => f.Severity).ThenBy(f => f.Category).ThenBy(f => f.Title)
                : q.OrderBy(f => f.Severity).ThenBy(f => f.Category).ThenBy(f => f.Title),
        };

        return q;
    }

    private static CategorySummary GetCategorySummary(FrontendQualityReviewReport report, FrontendQualityCategory category)
    {
        var findings = report.Findings.Where(f => f.Category == category).ToList();
        return new CategorySummary(
            findings.Count,
            findings.Count(f => f.Severity == FrontendQualitySeverity.Critical),
            findings.Count(f => f.Severity == FrontendQualitySeverity.High),
            findings.Count(f => f.Severity == FrontendQualitySeverity.Medium),
            findings.Count(f => f.Severity == FrontendQualitySeverity.Low));
    }

    private static IEnumerable<RecommendationView> BuildRecommendationCards(FrontendQualityReviewReport report)
    {
        foreach (var finding in report.Findings
            .Where(f => f.Severity is not FrontendQualitySeverity.Info && !string.IsNullOrWhiteSpace(f.Recommendation))
            .OrderBy(f => f.Severity)
            .ThenBy(f => f.Category)
            .ThenBy(f => f.Title))
        {
            yield return new RecommendationView(
                RecommendationPriority(finding.Severity),
                finding.Title,
                finding.Recommendation,
                ExpectedBenefit(finding));
        }

        foreach (var recommendation in report.Recommendations)
        {
            yield return new RecommendationView(
                "Low",
                ShortTitle(recommendation),
                recommendation,
                "Improves review completeness and keeps follow-up work visible.");
        }
    }

    private static string RecommendationPriority(FrontendQualitySeverity severity) => severity switch
    {
        FrontendQualitySeverity.Critical => "Critical",
        FrontendQualitySeverity.High     => "High",
        FrontendQualitySeverity.Medium   => "Medium",
        _                                => "Low",
    };

    private static string ExpectedBenefit(FrontendQualityFinding finding) => finding.Category switch
    {
        FrontendQualityCategory.Security      => "Reduces exploitable frontend risk and strengthens deployment confidence.",
        FrontendQualityCategory.Performance   => "Improves load behavior, responsiveness, and user-perceived stability.",
        FrontendQualityCategory.Accessibility => "Improves usability for assistive technologies and reduces compliance risk.",
        FrontendQualityCategory.Standards     => "Improves standards compliance and makes future audits easier to pass.",
        FrontendQualityCategory.BlazorWasm    => "Improves Blazor WASM reliability, startup behavior, and operational readiness.",
        FrontendQualityCategory.Readiness     => "Improves release confidence and clarifies go/no-go decision inputs.",
        _                                     => "Improves frontend quality and audit readiness.",
    };

    private static string ShortTitle(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return "Recommendation";
        var trimmed = text.Trim();
        var stop = trimmed.IndexOfAny(['.', ':', '-']);
        if (stop > 12) trimmed = trimmed[..stop];
        return trimmed.Length <= 72 ? trimmed : $"{trimmed[..69]}...";
    }

    private static string CategoryLabel(FrontendQualityCategory c) => c switch
    {
        FrontendQualityCategory.Performance   => "Performance",
        FrontendQualityCategory.Security      => "Security",
        FrontendQualityCategory.Accessibility => "Accessibility",
        FrontendQualityCategory.Standards     => "Standards",
        FrontendQualityCategory.BlazorWasm    => "Blazor WASM",
        FrontendQualityCategory.Readiness     => "Readiness",
        _                                     => c.ToString(),
    };

    private static string ScoreVariant(int score) =>
        score >= 80 ? "success" : score >= 50 ? "warning" : "danger";

    private static string QualityLabel(int score) =>
        score >= 90 ? "Excellent" :
        score >= 80 ? "Good" :
        score >= 65 ? "Needs Attention" :
        score >= 50 ? "At Risk" : "Critical";
}
