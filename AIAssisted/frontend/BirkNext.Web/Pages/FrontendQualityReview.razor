    private async Task RefreshContext()
    {
        if (_running) return;
        _runNotStartedReason = null;
        _context = await ContextFactory.GetActiveContextAsync();
        _context = _context.ForReviewScope(SelectedScope(_context));
        ResolveActiveEngines();
        await ResolveAuthenticatedCapabilities();
        StartEngineStatusFetch();
        if (!_engineStatusPending) await ApplyRecommendedScopeAsync();
    }

    private void SetCategoryFilter(FrontendQualityCategory cat)
    {
        _catFilter = _catFilter == cat ? null : cat;
        _categoryFilterValue = _catFilter?.ToString() ?? "";
    }

    private void ApplySeverityFilter()
    {
        _sevFilter = Enum.TryParse<FrontendQualitySeverity>(_severityFilterValue, out var sev) ? sev : null;
    }

    private void ApplyCategoryFilter()
    {
        _catFilter = Enum.TryParse<FrontendQualityCategory>(_categoryFilterValue, out var cat) ? cat : null;
    }

    private void ClearFilters()
    {
        _sevFilter = null;
        _catFilter = null;
        _findingSearch = null;
        _severityFilterValue = "";
        _categoryFilterValue = "";
    }

    private void SortBy(string column)
    {
        if (_sortColumn == column)
        {
            _sortDescending = !_sortDescending;
            return;
        }

        _sortColumn = column;
        _sortDescending = false;
    }

    private string SortGlyph(string column) =>
        _sortColumn != column ? "" : _sortDescending ? "v" : "^";

    private IEnumerable<FrontendQualityFinding> FilteredFindings(IReadOnlyList<FrontendQualityFinding> all)
    {
        IEnumerable<FrontendQualityFinding> q = all;
        if (_sevFilter.HasValue) q = q.Where(f => f.Severity == _sevFilter.Value);
        if (_catFilter.HasValue) q = q.Where(f => f.Category == _catFilter.Value);
        if (!string.IsNullOrWhiteSpace(_findingSearch))
        {
            var term = _findingSearch.Trim();
            q = q.Where(f =>
                f.Title.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                f.Description.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                f.Recommendation.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                CategoryLabel(f.Category).Contains(term, StringComparison.OrdinalIgnoreCase) ||
                f.Severity.ToString().Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        q = _sortColumn switch
        {
            "category" => _sortDescending
                ? q.OrderByDescending(f => CategoryLabel(f.Category)).ThenBy(f => f.Severity).ThenBy(f => f.Title)
                : q.OrderBy(f => CategoryLabel(f.Category)).ThenBy(f => f.Severity).ThenBy(f => f.Title),
            "title" => _sortDescending
                ? q.OrderByDescending(f => f.Title).ThenBy(f => f.Severity)
                : q.OrderBy(f => f.Title).ThenBy(f => f.Severity),
            _ => _sortDescending
                ? q.OrderByDescending(f => f.Severity).ThenBy(f => f.Category).ThenBy(f => f.Title)
                : q.OrderBy(f => f.Severity).ThenBy(f => f.Category).ThenBy(f => f.Title),
        };

        return q;
    }

    /// <summary>
    /// A category whose contributing engines were all disabled/not selected at review start shows "Not enabled" rather than a
    /// dash that reads like a failed assessment. Uses the review's own activation snapshot, never current settings.
    /// </summary>
    private static bool CategoryEnginesNotEnabled(FrontendQualityReviewReport report, FrontendQualityCategory category)
    {
        if (report.ActiveEngines is not { } active) return false;
        var engines = FrontendQualityCategoryEngines.For(category);
        return engines.Count > 0 && engines.All(id => !active.IsActive(id));
    }

    private static string CategoryLabel(FrontendQualityCategory c) => c switch
    {
        FrontendQualityCategory.Performance   => "Performance",
        FrontendQualityCategory.Security      => "Security",
        FrontendQualityCategory.Accessibility => "Accessibility",
        FrontendQualityCategory.Standards     => "Standards",
        FrontendQualityCategory.BlazorWasm    => "Blazor WASM",
        FrontendQualityCategory.Readiness     => "Readiness",
        _                                     => c.ToString(),
    };

    private static string ScoreVariant(int score) =>
        score >= 80 ? "success" : score >= 50 ? "warning" : "danger";

    private static string QualityLabel(int score) =>
        score >= 90 ? "Excellent" :
        score >= 80 ? "Good" :
        score >= 65 ? "Needs Attention" :
        score >= 50 ? "At Risk" : "Critical";

    private void OnCapabilitySelectionChanged((FrontendQualityEngineIdDto EngineId, bool Selected) change) =>
        HandleEngineSelectionChange(change.EngineId, change.Selected);

    private void HandleEngineSelectionChange(FrontendQualityEngineIdDto engineId, bool selected)
    {
        if (_context is null) return;

        var selection = _context.ReviewEngineSelection.ToSelectionMap();
        selection[engineId] = selected;
        _context.ReviewEngineSelection = ReviewEngineSelection.FromSelectionMap(selection);
        ResolveActiveEngines(); // selection is a per-review opt-out among ENABLED engines; it never enables a disabled one
    }

    private FrontendQualityEngineExecutionSnapshot CaptureExecutionSnapshot()
    {
        var snapshot = new FrontendQualityEngineExecutionSnapshot
        {
            AuthMode = _context?.RequiresAuthentication == true && _context?.IsAuthenticatedSessionAvailable == true
                ? ReviewAuthenticationModeDto.Authenticated
                : ReviewAuthenticationModeDto.Anonymous,
            CapturedAtUtc = DateTime.UtcNow,
        };

        if (_engineStatus != null)
        {
            foreach (var engine in _engineStatus.Engines)
            {
                snapshot.Layer1Allowed[engine.EngineId] = engine.Layer1Allowed;
                snapshot.Layer2Enabled[engine.EngineId] = engine.Layer2Enabled;
                snapshot.AuthModeSupported[engine.EngineId] = engine.AuthModeSupported;
            }
        }

        // Selection in the execution snapshot = the activation rule (saved Enabled toggle && per-review selection).
        // A disabled engine is never selected for execution, whatever the checkbox state says.
        var activation = _activeEngines ?? (_context is null ? null : FrontendQualityActiveEngines.Resolve(_context));
        foreach (var (engineId, dto) in FrontendQualityActiveEngines.BackendEngineIds)
            snapshot.SelectedEngines[dto] = activation?.IsActive(engineId) == true;

        return snapshot;
    }
