    /// <summary>The latest recommendation, for the profile it was computed for. Never saved: it only fills in when nothing was chosen.</summary>
    private FrontendQualityScopeRecommendation? _recommendation;

    private FrontendQualityScopeRecommendation? CurrentRecommendation =>
        _recommendation is { } r && _context is not null && r.ProfileId == _context.ActiveProfile.Id ? r : null;

    /// <summary>
    /// The scope this review uses: the person's explicit choice for this Target Environment, else the capability-aware
    /// recommendation, else (before it is known, or when nothing can run) the legacy derivation from the sign-in rule.
    /// </summary>
    /// <summary>The dialog's selection: the scope in use, or none when nothing was chosen and no scope can run.</summary>
    private FrontendReviewAccessScope? PickerSelection =>
        _context?.ActiveProfile.FrontendReviewScope is null && CurrentRecommendation is { Scope: null } ? null : _context?.ReviewScope;

    /// <summary>
    /// Whether the way to make authenticated access ready (sign in for review / proxy steps) is offered although the review scope
    /// itself is public: nothing was chosen and the Target Environment uses sign-in. Without it a recommended Public only scope would
    /// hide the only route to the authenticated readiness that would recommend Public + authenticated. It never widens the scope.
    /// </summary>
    private bool OfferAuthenticatedSetup =>
        _context is { ReviewScope: FrontendReviewAccessScope.PublicOnly } c && c.ActiveProfile.FrontendReviewScope is null
        && (c.ActiveProfile.Authentication.RequiresAuthentication || c.AuthenticationType != FrontendAuthenticationType.None);

    private FrontendAnalysisContext? AuthenticatedReviewContext =>
        OfferAuthenticatedSetup ? _context!.ForReviewScope(FrontendReviewAccessScope.AuthenticatedOnly) : _context;

    private FrontendQualityTargetAccessContext? AuthenticatedReviewAccess =>
        OfferAuthenticatedSetup && _access is { } access ? FrontendQualityTargetAccess.ForScope(access, FrontendReviewAccessScope.AuthenticatedOnly) : _access;

    private FrontendReviewAccessScope SelectedScope(FrontendAnalysisContext context) =>
        context.ActiveProfile.FrontendReviewScope
        ?? (_recommendation is { Scope: { } recommended } r && r.ProfileId == context.ActiveProfile.Id ? recommended
            : FrontendQualityReviewScopes.ConfiguredScope(context.RequiresAuthentication));

    private IReadOnlyList<FrontendQualityCapabilityRow> CapabilityRows(FrontendAnalysisContext context, FrontendQualityTargetAccessContext? access) =>
        _activeEngines is null ? [] : FrontendQualityLandingPresentation.Capabilities(context, _activeEngines, _engineStatus, _engineStatusPending,
            _readinessPending, access, CompanionState, RecordedEvidence);

    /// <summary>
    /// Re-evaluates the recommendation from the current access and engine status, and applies it when no scope was chosen. An explicit
    /// choice is never replaced. When the applied scope changes, access is re-resolved for it and the engine status is fetched again
    /// for its authentication mode, so the execution snapshot matches the scope that will run: in the background on the landing page
    /// (<paramref name="forRun"/> false), awaited (Layer 1–2 only) when a run is starting. Returns whether the applied scope changed.
    /// </summary>
    private async Task<bool> ApplyRecommendedScopeAsync(bool forRun = false)
    {
        if (_context is null || _context.ActiveTargetError is not null || _activeEngines is null || _engineStatusPending)
            return false;
        // Without a Frontend URL there is no resolved access; configuration alone still answers "nothing can run".
        _recommendation = FrontendQualityReviewScopes.Recommend(_context, _access ?? FrontendQualityTargetAccess.FromContext(_context), CapabilityRows);
        var scope = SelectedScope(_context);
        if (_context.ReviewScope == scope) return false;
        _context = _context.ForReviewScope(scope);
        await ResolveTargetAccess();
        if (!forRun) StartEngineStatusFetch();
        else if (ActiveBackendEngineIds.Count > 0)
        {
            try { await FetchEngineStatus(withReadiness: false); }
            catch { _engineStatus = null; }
        }
        return true;
    }

    private async Task ApplyReviewScope(FrontendReviewAccessScope scope)
    {
        if (_context is null || ServiceProvider.GetService(typeof(IFrontendAnalysisSettingsService)) is not IFrontendAnalysisSettingsService settings)
            throw new InvalidOperationException("Target Environment settings are unavailable.");
        var profile = settings.Settings.Profiles.Single(p => p.Id == _context.ActiveProfile.Id);
        var original = profile.FrontendReviewScope;
        profile.FrontendReviewScope = scope;
        try { await settings.SaveAsync(JS); }
        catch { profile.FrontendReviewScope = original; throw; }
        await RefreshContext();
    }

    private async Task OnWcagProfileChanged(string profileId)
    {
        if (_context is null) return;
        if (ServiceProvider.GetService(typeof(IEndpointDiscoveryService)) is not IEndpointDiscoveryService discovery) return;
        await discovery.SaveWcagSettingsAsync(JS, _context.ActiveProfile.Id, new WcagSettings { ProfileId = profileId });
        StateHasChanged();
    }

    private EndpointDiscoverySnapshot WcagSnapshot =>
        _context is null ? new()
            : (ServiceProvider.GetService(typeof(IEndpointDiscoveryService)) as IEndpointDiscoveryService)?.GetSnapshot(_context.ActiveProfile.Id) ?? new();

    private BrowserCompanionState? CompanionState =>
        _companionRuntime is null || _context is null || _context.ActiveTargetError is not null ? null : _companionRuntime.For(_context.ActiveProfile.Id).State;

    /// <summary>
    /// Browser evidence this review will read, or null when no Browser Companion engine is enabled for this target and
    /// there is therefore nothing to consume. Built from the Browser Companion session and the stored discovery
    /// snapshot — the same two sources Browser Discovery reads, through the same derivations, so the two pages cannot
    /// disagree about what was captured or about whether a browser is open.
    /// </summary>
    private FrontendQualityBrowserEvidenceModel? LandingBrowserEvidence
    {
        get
        {
            if (_context is null || _context.ActiveTargetError is not null) return null;
            if (!_context.FeatureToggles.EnableBrowserQualityEngine && !_context.FeatureToggles.EnablePerformanceQualityEngine) return null;
            if (_companionRuntime is null) return null;
            var snapshot = (ServiceProvider.GetService(typeof(IEndpointDiscoveryService)) as IEndpointDiscoveryService)?.GetSnapshot(_context.ActiveProfile.Id);
            return FrontendQualityBrowserEvidencePresentation.Build(_companionRuntime.For(_context.ActiveProfile.Id), snapshot);
        }
    }

    /// <summary>
    /// Captured-evidence counts for the capability rows, from the same merge the Browser evidence section reads, so an
    /// engine that will run from recorded evidence is not reported as waiting for a live session.
    /// </summary>
    private BrowserEvidenceTotals? RecordedEvidence
    {
        get
        {
            if (_companionRuntime is null || _context is null || _context.ActiveTargetError is not null) return null;
            var snapshot = (ServiceProvider.GetService(typeof(IEndpointDiscoveryService)) as IEndpointDiscoveryService)?.GetSnapshot(_context.ActiveProfile.Id);
            return BrowserDiscoveryLive.Totals(_companionRuntime.For(_context.ActiveProfile.Id), snapshot);
        }
    }

    private LandingView BuildLanding()
    {
        var capabilities = _context is null || _context.ActiveTargetError is not null || _activeEngines is null
            ? (IReadOnlyList<FrontendQualityCapabilityRow>)[]
            : FrontendQualityLandingPresentation.Capabilities(_context, _activeEngines, _engineStatus, _engineStatusPending, _readinessPending, _access, CompanionState, RecordedEvidence);
        // Configuration → available paths → what the runnable engines cover. Resolved once and read by the Target card,
        // the readiness banner, Review access and the engine list, so none of them re-derives scope on its own.
        var scope = _context is null || _context.ActiveTargetError is not null || _access is null || capabilities.Count == 0 ? null
            : FrontendQualityReviewScopes.Resolve(_context, _access, capabilities);
        var readiness = FrontendQualityReviewScopes.ApplyTo(
            FrontendQualityLandingPresentation.Readiness(_context, _activeEngines, capabilities, _engineStatusPending), scope);
        var target = _context is null
            ? new FrontendQualityTargetSummaryModel("Loading…", "—", "—", "—", "—", "Loading", false)
            : FrontendQualityLandingPresentation.TargetSummary(_context, scope) is var summary && PickerSelection is null
                ? summary with { ReviewScope = "No runnable access scope available" } : summary;
        var technical = _context is null ? [] : FrontendQualityLandingPresentation.TechnicalTargetFields(_context, scope);
        var auth = _context is null || _context.ActiveTargetError is not null ? null
            : FrontendQualityLandingPresentation.AuthenticatedReview(AuthenticatedReviewContext, AuthenticatedReviewAccess, _caps, _authSession);
        return new LandingView(target, readiness, capabilities, FrontendQualityLandingPresentation.Dimensions(capabilities, SelectedWcagProfile), technical, auth, scope);
    }

