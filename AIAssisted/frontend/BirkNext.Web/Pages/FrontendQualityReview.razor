    /// <summary>
    /// The shared capabilities the planner resolves, for the landing view: the same resolver over the same live Browser Companion session
    /// Browser Discovery owns (only when an engine consumes a live DOM, exactly as the orchestrator asks). No second browser state.
    /// </summary>
    private IReadOnlyList<FrontendQualityCapability> SemanticCapabilities(FrontendQualityTargetAccessContext access)
    {
        var live = _context is { } c && c.FeatureToggles.EnableAccessibilityEngine && _companionRuntime is not null && c.ActiveTargetError is null
            ? _companionRuntime.For(c.ActiveProfile.Id).EffectiveLive : null;
        return FrontendQualityCapabilityResolver.Resolve(_context!, access, live,
            live is null ? null : BrowserCompanionScope.ApprovedOrigins(_context!.ActiveProfile));
