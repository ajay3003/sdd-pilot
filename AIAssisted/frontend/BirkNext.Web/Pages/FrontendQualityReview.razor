@page "/frontend-quality-review"
@implements IDisposable
@using BirkNext.BrowserCompanion
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using BirkNext.Web.Components
@using BirkNext.LocalHttpsProxy
@inject IFrontendQualityReviewOrchestrator Orchestrator
@inject IFrontendAnalysisContextFactory ContextFactory
@inject IAuthenticatedBrowserSessionService AuthenticatedSessions
@inject RuntimeReviewSessionService RuntimeReviews
@inject IWorkspaceSessionService Workspace
@inject IReportExportService ExportService
@inject IFrontendQualityEngineStatusApiService EngineStatusService
@inject IServiceProvider ServiceProvider
@inject IJSRuntime JS

<PageTitle>Frontend Quality Review</PageTitle>

<div class="fqr-page">

    <PageHeader Title="Frontend Quality Review"
                Description="Review a deployed frontend for performance, security, accessibility, standards compliance, Blazor/WASM quality, and QA readiness.">
        @if (_report is not null)
        {
            <button type="button" class="btn-primary" @onclick="BackToReview">Back to Frontend Quality Review</button>
            <button type="button" class="btn-secondary" @onclick="ExportHtml">Export HTML</button>
            <button type="button" class="btn-secondary" @onclick="ExportPdf">Export PDF</button>
        }
        @* Before a run the primary action sits in the decision area below, directly under target, profile and readiness. *@
    </PageHeader>

    @if (_report is null)
    {
        var landing = BuildLanding();

        @if (_runNotStartedReason is { } notStarted)
        {
            <div class="wsr-banner wsr-banner-error wsr-banner-standalone fqr-run-not-started" role="alert" data-testid="fqr-run-not-started">
                <span aria-hidden="true">⚠</span>
                <strong>Review not started</strong> — @notStarted
                <a href="@TargetEnvironmentsHref" class="wsr-banner-action">Open Target Environments</a>
                <button type="button" class="btn-secondary fqr-banner-dismiss" @onclick="() => _runNotStartedReason = null" aria-label="Dismiss">Dismiss</button>
            </div>
        }

        <div class="fqr-landing" data-testid="fqr-landing">

            @*
                1. Decide. Everything needed to answer "should I run this review, and against what?" — the target, the
                criteria it is judged against, whether it can run, and the run action itself. Nothing diagnostic here.
            *@
            <section class="fqr-decide" aria-label="Review setup" data-testid="fqr-decide">
                <div class="fqr-decide-cards">
                    @* No technical disclosure here: the exact source values live in the ONE Technical details
                       disclosure at the end of Review details, so there is a single place to look for them. *@
                    <FrontendQualityTargetSummary Summary="landing.Target" ChangeHref="@TargetEnvironmentsHref" />
                    @* Review scope, stated before the run: which criteria accessibility is judged against. *@
                    <FrontendQualityProfileCard Selected="SelectedWcagProfile" ProfileChanged="OnWcagProfileChanged" />
                    <FrontendQualityReadinessPanel Readiness="landing.Readiness" />
                </div>
                <div class="fqr-run-bar" data-testid="fqr-run-bar">
                    <PrimaryButton OnClick="RunReview" Disabled="@RunDisabled" data-testid="fqr-run">@RunButtonText</PrimaryButton>
                    @if (_engineStatusPending)
                    {
                        <p class="fqr-run-reason" role="status" aria-live="polite" data-testid="fqr-engine-status-pending">@EngineStatusPendingText</p>
                    }
                    else if (RunDisabled && RunDisabledReason is { } disabledReason)
                    {
                        <p class="fqr-run-reason" role="status" data-testid="fqr-run-disabled-reason">@disabledReason</p>
                    }
                </div>
            </section>

            @* 2. Scope: the six review domains. Always visible — this is the main explanation of what the review covers. *@
            <FrontendQualityDimensionCards Cards="landing.Dimensions" />

            @if (landing.AuthenticatedReview is { } auth)
            {
                <FrontendQualityAuthenticatedReview Model="auth"
                                                    ProgressText="@AuthProgressText"
                                                    Polling="_authPolling"
                                                    ShowCancel="@(_authSession is not null)"
                                                    SignIn="StartAuthentication"
                                                    Cancel="CancelAuthentication"
                                                    ManageHref="@TargetEnvironmentsHref">
                    <TechnicalDetails>
                        @if (_caps is { } caps)
                        {
                            <AuthenticatedReviewStatus Capabilities="caps" ShowBrowserSurfaces="true" />
                        }
                        else
                        {
                            <p class="fqr-muted">Authenticated capability status is not available for this environment.</p>
                        }
                    </TechnicalDetails>
                </FrontendQualityAuthenticatedReview>
            }

            @*
                3. Review details. Everything technical, collapsed by default, ordered from what the reviewer asks about
                to what only an engineer asks about: access → scope → engines → evidence → scope boundary → diagnostics.
                Each row states one fact; expanding it reveals the detail. Nothing here changes the scope stated above.
            *@
            <section class="fqr-section fqr-details" aria-labelledby="fqr-details-heading" data-testid="fqr-details">
                <div class="fqr-section-head">
                    <h2 id="fqr-details-heading">Review details</h2>
                    <p class="fqr-section-note">How this review is set up and what it can reach right now.</p>
                </div>

                @* 1. Review access — which surfaces of the target this review can reach. *@
                @if (_access is { } landingAccess)
                {
                    var coverageRows = FrontendQualityLandingPresentation.Coverage(landingAccess, _caps);
                    <ReviewDisclosure Text="Review access" CollapseText="Hide review access"
                                      Hint="@FrontendQualityLandingPresentation.CoverageSummary(coverageRows).Headline"
                                      TestId="fqr-coverage-disclosure" Class="fqr-detail-disclosure">
                        <FrontendQualityCoverageSummary Rows="coverageRows">
                            <TechnicalDetails>
                                <FrontendQualityTargetAccessPanel Access="landingAccess" ShowActions="true" />
                            </TechnicalDetails>
                        </FrontendQualityCoverageSummary>
                    </ReviewDisclosure>
                }

                @* 2. Review scope — the areas the automated and passive review covers, named rather than counted. *@
                <ReviewDisclosure Text="Review scope" CollapseText="Hide review scope"
                                  Hint="@FrontendQualityLandingPresentation.ReviewScopeSummary"
                                  TestId="fqr-checks-disclosure" Class="fqr-detail-disclosure">
                    <FrontendQualityChecksSection Groups="FrontendQualityLandingPresentation.CheckGroups" />
                </ReviewDisclosure>

                @* 3. Engines — ONE engine list. The "Active review engines" strip that used to sit inside it listed the
                       same engines a second time, in a second vocabulary. *@
                @if (_activeEngines is not null)
                {
                    <ReviewDisclosure Text="Engines" CollapseText="Hide engines"
                                      Hint="@FrontendQualityLandingPresentation.CapabilitySummary(landing.Capabilities).Collapsed"
                                      TestId="fqr-capabilities-disclosure" Class="fqr-detail-disclosure">
                        <FrontendQualityCapabilityList Rows="landing.Capabilities" SelectionChanged="OnCapabilitySelectionChanged" />
                    </ReviewDisclosure>
                }

                @* 4. Browser evidence — consumed, never administered. Browser Discovery owns the session and the setup. *@
                @if (LandingBrowserEvidence is { } evidence)
                {
                    <ReviewDisclosure Text="Browser evidence" CollapseText="Hide browser evidence"
                                      Hint="@FrontendQualityBrowserEvidencePresentation.Collapsed(evidence)"
                                      TestId="fqr-companion" Class="fqr-detail-disclosure">
                        <FrontendQualityBrowserEvidence Model="evidence" />
                    </ReviewDisclosure>
                }

                @* 5. Outside this review — scope boundaries, not gaps. *@
                <ReviewDisclosure Text="Outside this review" CollapseText="Hide what is outside this review"
                                  Hint="@FrontendQualityLandingPresentation.OutsideReviewSummary"
                                  TestId="fqr-not-assessed-disclosure" Class="fqr-detail-disclosure">
                    <FrontendQualityNotAssessedList Items="FrontendQualityLandingPresentation.NotAssessed" />
                </ReviewDisclosure>

                @* 6. Technical details — the one place engine ids, layer state, runtime reasons, the full target URL,
                       approved origins and exact timestamps live. No decision above this line needs them. *@
                <ReviewDisclosure Text="Technical details" CollapseText="Hide technical details"
                                  Hint="Engine internals, target and evidence diagnostics"
                                  TestId="fqr-technical-disclosure" Class="fqr-detail-disclosure">
                    <div class="fqr-technical" data-testid="fqr-technical">
                        @if (landing.TechnicalFields.Count > 0)
                        {
                            <section class="fqr-technical-block" aria-labelledby="fqr-technical-target-heading">
                                <h3 id="fqr-technical-target-heading">Target environment and configured engine state</h3>
                                <p class="fqr-section-note">Enabled and Disabled below are saved configuration, not runtime availability.</p>
                                <dl class="fqr-technical-list-grid" data-testid="fqr-technical-target">
                                    @foreach (var field in landing.TechnicalFields)
                                    {
                                        <div><dt>@field.Label</dt><dd>@field.Value</dd></div>
                                    }
                                </dl>
                            </section>
                        }

                        <section class="fqr-technical-block" aria-labelledby="fqr-technical-engines-heading">
                            <h3 id="fqr-technical-engines-heading">Active runtime-dependent engine capabilities</h3>
                            <p class="fqr-section-note">Only active backend engines are shown. Runtime installation and capability are managed in <a href="@FrontendQualityLandingPresentation.SystemSettingsHref">System Settings — Frontend Engine Capabilities</a>.</p>
                            @if (_readinessPending)
                            {
                                <p class="fqr-muted fqr-engine-progress" aria-live="polite" data-testid="fqr-readiness-pending">Checking runtime readiness of @ActiveBackendEngineIds.Count active engine@(ActiveBackendEngineIds.Count == 1 ? "" : "s")… The review can start meanwhile; readiness is re-validated at execution.</p>
                            }
                            @if (_engineStatus is not null)
                            {
                                var activeBackendIds = ActiveBackendEngineIds;
                                <div class="fqr-engine-grid" data-testid="fqr-engine-grid">
                                    @foreach (var engine in _engineStatus.Engines.Where(e => activeBackendIds.Contains(e.EngineId)).OrderBy(e => e.EngineId))
                                    {
                                        <div class="fqr-engine-card" data-engine-id="@engine.EngineId">
                                            <div class="fqr-engine-header">
                                                <h4>@engine.DisplayName</h4>
                                                <span class="fqr-pill fqr-pill-@(engine.Available ? "ready" : "attention")">@(engine.Available ? "Available" : "Unavailable")</span>
                                            </div>
                                            <dl class="fqr-engine-layers">
                                                <div><dt>Engine ID</dt><dd>@engine.EngineId</dd></div>
                                                <div><dt>Deployment policy</dt><dd>@(engine.Layer1Allowed ? "Allowed" : "Blocked")</dd></div>
                                                <div><dt>System Settings</dt><dd>@(engine.Layer2Enabled ? "Enabled" : "Disabled")</dd></div>
                                                <div><dt>Runtime</dt><dd>@(engine.Layer3Readiness is null ? "Not checked" : engine.Layer3Readiness.IsAvailable ? "Ready" : "Unavailable")</dd></div>
                                                @if (engine.Layer3Readiness is { IsAvailable: false, StatusReason: { Length: > 0 } statusReason })
                                                {
                                                    <div><dt>Runtime reason</dt><dd>@statusReason</dd></div>
                                                }
                                                <div><dt>Authenticated review</dt><dd>@(engine.AuthModeSupported ? "Supported" : "Not supported")</dd></div>
                                            </dl>
                                        </div>
                                    }
                                </div>
                            }
                            else if (!_readinessPending)
                            {
                                <p class="fqr-muted" data-testid="fqr-engine-grid-empty">No backend engine capability status has been read for this target.</p>
                            }
                        </section>

                        @if (LandingBrowserEvidence is { } technicalEvidence)
                        {
                            <section class="fqr-technical-block" aria-labelledby="fqr-technical-evidence-heading">
                                <h3 id="fqr-technical-evidence-heading">Browser evidence</h3>
                                <dl class="fqr-technical-list-grid" data-testid="fqr-technical-evidence">
                                    @* Administered in Browser Discovery; shown here because it explains which pages can
                                       ever produce evidence, not because this page can change it. *@
                                    <div><dt>Current pairing/session approved origins</dt><dd class="fqr-mono">@(technicalEvidence.ApprovedOrigins.Count == 0 ? "None" : string.Join(", ", technicalEvidence.ApprovedOrigins))</dd></div>
                                    @* The live page's full identity (origin + route); the evidence block reads out the route. *@
                                    <div><dt>Current page identity</dt><dd class="fqr-mono">@technicalEvidence.CurrentPageIdentity</dd></div>
                                    <div><dt>Last captured evidence</dt><dd>@technicalEvidence.LastCapturedLabel</dd></div>
                                </dl>
                            </section>
                        }
                    </div>
                </ReviewDisclosure>
            </section>

            @if (_running)
            {
                <p class="fqr-run-progress" role="status" aria-live="polite">@_progressMessage</p>
            }
        </div>
    }

    @if (_secError is not null)
    {
        <div class="wsr-banner wsr-banner-warn wsr-banner-standalone" role="status">
            <span aria-hidden="true">!</span> Security scan: @_secError - security findings will be incomplete.
        </div>
    }
    @if (_perfError is not null)
    {
        <div class="wsr-banner wsr-banner-warn wsr-banner-standalone" role="status">
            <span aria-hidden="true">!</span> Performance scan: @_perfError - performance findings will be incomplete.
        </div>
    }

    @if (_report is not null)
    {
        var report = _report;
        var filtered = FilteredFindings(report.Findings).ToList();
        @* The result is projected from the report alone; the current profile selection is passed only to detect drift. *@
        var result = FrontendQualityResultPresentation.Build(report, WcagSnapshot.Wcag.ProfileId);
        @* Actionable = not informational and not derived: an absent optional capability and a restated conclusion are
           both worth keeping and neither is a problem to fix. *@
        var actionableIssues = report.LogicalIssues.Where(i => i.IsActionable).ToList();
        var keyIssues = actionableIssues.Take(KeyIssueCount).ToList();
        var themes = FrontendQualityRecommendationGrouper.Build(report.LogicalIssues);
        var evidenceRecords = DistinctEvidence(report);

        @* ── 1. The result itself: what ran, against what, and how it ended. ────────────────────────────────── *@
        <FrontendQualityResultSummary Result="result" RunAgain="RunReview" />

        @if (report.PreflightStatus == PreflightStatus.AuthenticationRequired)
        {
            <div class="wsr-banner wsr-banner-error wsr-banner-standalone" role="status">
                <span aria-hidden="true">🔐</span>
                <strong>Authentication required</strong> — @(report.PreflightMessage ?? "The configured target requires authentication, so the protected frontend could not be assessed.")
                <a href="@TargetEnvironmentsHref" class="wsr-banner-action">Configure authentication</a>
            </div>
        }
        else if ((report.PreflightStatus is PreflightStatus.TimedOut or PreflightStatus.Unreachable or PreflightStatus.ScannerUnavailable) && !string.IsNullOrWhiteSpace(report.PreflightMessage))
        {
            <div class="wsr-banner wsr-banner-error wsr-banner-standalone" role="status" data-testid="fqr-preflight-banner">
                <span aria-hidden="true">⚠</span>
                <strong>@(report.PreflightStatus == PreflightStatus.TimedOut ? "Target timed out" : report.PreflightStatus == PreflightStatus.Unreachable ? "Target unreachable" : "Reachability check unavailable")</strong> — @report.PreflightMessage
            </div>
        }

        @* ── 2. Key logical issues: the few things worth acting on first. ─────────────────────────────────────── *@
        <section class="fqr-section" aria-labelledby="fqr-key-issues-heading" data-testid="fqr-key-issues">
            <div class="fqr-section-head">
                <h2 id="fqr-key-issues-heading">Key logical issues</h2>
                <p class="fqr-section-note">The most severe distinct problems this review found. Every issue is listed further down.</p>
            </div>
            <FrontendQualityLogicalIssues Issues="keyIssues" Compact="true" />
            @if (actionableIssues.Count > keyIssues.Count)
            {
                <p class="fqr-section-note" data-testid="fqr-key-issues-more">
                    @(actionableIssues.Count - keyIssues.Count) further logical issue@(actionableIssues.Count - keyIssues.Count == 1 ? "" : "s") in <strong>Logical issues</strong> below.
                </p>
            }
        </section>

        @* ── 3. What each domain found. Accessibility first: it carries the statutory obligation. ───────────── *@
        <div class="fqr-domain-results" data-testid="fqr-domain-results">
            @foreach (var domain in result.Domains)
            {
                @if (domain.Category == FrontendQualityCategory.Accessibility)
                {
                    <FrontendQualityDomainResultSection Result="domain" Scope="@AccessibilityScope(result)"
                                                        DetailsText="View all 48-criterion detail">
                        <Notice>
                            @* The result keeps the profile it ran under; a later selection asks for a new run, it never relabels this one. *@
                            @if (result.ProfileDrift is { } drift)
                            {
                                <div class="wsr-banner wsr-banner-warn fqr-profile-drift" role="status" data-testid="fqr-profile-drift">
                                    <span aria-hidden="true">⚠</span> @drift
                                </div>
                            }
                            @* Five numbers that can be held at once; the overlapping states live in the criteria view. *@
                            @if (result.Accessibility is { } accessibility)
                            {
                                <FrontendQualityAccessibilitySummary Result="accessibility" />
                            }
                        </Notice>
                        <ChildContent>
                            @if (report.Wcag is { } wcag)
                            {
                                @* Collapsed by default here: a finished review leads with its summary, not a 48-row matrix. *@
                                <WcagWorkspace ProfileId="@(_context?.ActiveProfile.Id ?? "")" Snapshot="@WcagSnapshot" Result="wcag"
                                               InitiallyExpanded="false" ProfileChanged="OnResultProfileChanged" />
                            }
                        </ChildContent>
                    </FrontendQualityDomainResultSection>
                }
                else
                {
                    @* Source findings behind a disclosure: the domain card states the result, the list is the evidence. *@
                    <FrontendQualityDomainResultSection Result="domain" DetailsText="@DomainDetailsText(domain)">
                        @if (DomainFindings(report, domain.Category).Count == 0)
                        {
                            <p class="fqr-muted" data-testid="fqr-domain-no-findings">No findings were recorded for this domain in the evidence reviewed.</p>
                        }
                        else
                        {
                            <ul class="fqr-domain-finding-list" data-testid="fqr-domain-finding-list">
                                @foreach (var finding in DomainFindings(report, domain.Category))
                                {
                                    <li class="fqr-domain-finding" data-testid="fqr-domain-finding" data-severity="@finding.Severity" data-origin="@finding.Origin">
                                        <span class="fqr-severity fqr-severity-@finding.Severity.ToString().ToLowerInvariant()">@finding.Severity</span>
                                        <span class="fqr-domain-finding-title">@finding.Title</span>
                                        @if (finding.Origin == FrontendQualityFindingOrigin.Derived && !domain.Derived)
                                        {
                                            <span class="fqr-pill fqr-pill-muted">Derived indicator</span>
                                        }
                                        <span class="fqr-domain-finding-desc">@finding.Description</span>
                                    </li>
                                }
                            </ul>
                        }
                    </FrontendQualityDomainResultSection>
                }
            }
        </div>

        @* ── 4. What to fix, grouped by the work rather than by the observation. ──────────────────────────────── *@
        <section class="fqr-section" aria-labelledby="fqr-recommendations-heading" data-testid="fqr-recommendation-themes">
            <div class="fqr-section-head">
                <h2 id="fqr-recommendations-heading">Recommendations</h2>
                <p class="fqr-section-note">One entry per remediation. An issue observed on several pages is one job, not one per page.</p>
            </div>
            <FrontendQualityRecommendations Themes="themes" />
        </section>

        @* ── 5. Manual follow-up. Two different obligations, kept apart. ──────────────────────────────────────── *@
        @if (result.Accessibility is { RequireManualAssessment: > 0 } manualAccessibility || report.ManualReviewItems.Count > 0)
        {
            <section class="fqr-section" aria-labelledby="fqr-manual-heading" data-testid="fqr-manual-followup">
                <div class="fqr-section-head">
                    <h2 id="fqr-manual-heading">Manual follow-up</h2>
                </div>

                @* Mandatory: criteria no automation can decide. Not a shortfall in the engines. *@
                @if (result.Accessibility is { RequireManualAssessment: > 0 } mandatory)
                {
                    <div class="fqr-manual-block" data-testid="fqr-manual-mandatory">
                        <h3>Mandatory manual assessment</h3>
                        <p>
                            <strong>Accessibility.</strong> @mandatory.RequireManualAssessment of
                            @mandatory.CriteriaInScope criteria in @mandatory.ProfileLabel require a person to assess them.
                            This is what those criteria require; it is not a gap in the automated coverage.
                        </p>
                    </div>
                }

                @* Recommended: a human check that strengthens a conclusion the engines already reached. *@
                @if (report.ManualReviewItems.Count > 0)
                {
                    <div class="fqr-manual-block" data-testid="fqr-manual-recommended">
                        <h3>Recommended human verification</h3>
                        <ReviewDisclosure Text="@($"View {report.ManualReviewItems.Count} verification item{(report.ManualReviewItems.Count == 1 ? "" : "s")}")"
                                          CollapseText="Hide verification items" Class="disclosure-inline" TestId="fqr-manual-items">
                            <ul class="fqr-manual-list" data-testid="fqr-manual-item-list">
                                @foreach (var item in report.ManualReviewItems)
                                {
                                    <li data-testid="fqr-manual-item">
                                        <strong>@item.Title</strong> — @item.Reason
                                        <span class="fqr-muted">(@item.Source)</span>
                                    </li>
                                }
                            </ul>
                        </ReviewDisclosure>
                    </div>
                }
            </section>
        }

        @* ── 6. Everything else, collapsed. Raw evidence and diagnostics are kept, not shown. ─────────────────── *@
        <section class="fqr-section fqr-details" aria-labelledby="fqr-result-details-heading" data-testid="fqr-result-details">
            <div class="fqr-section-head">
                <h2 id="fqr-result-details-heading">Review details</h2>
                <p class="fqr-section-note">Every issue, every source observation, and how this review was executed.</p>
            </div>

            @* Informational observations and derived indicators are listed here too, and are not logical issues: the label
               counts each kind by its own name, so "28 logical issues" means the same thing here as in the metric. *@
            <ReviewDisclosure Text="Review items" CollapseText="Hide review items"
                              Hint="@ReviewItemsHint(report, actionableIssues.Count, result.InformationalIssueCount)"
                              TestId="fqr-all-logical-issues" Class="fqr-detail-disclosure">
                <FrontendQualityLogicalIssues Issues="report.LogicalIssues" />
            </ReviewDisclosure>

            @* 44 source findings plus 4 derived indicators are 48 recorded rows, and the hint says exactly that. It used to
               call all 48 "observations from every engine" beside a metric reading 44. *@
            <ReviewDisclosure Text="Source findings" CollapseText="Hide source findings"
                              Hint="@SourceFindingsHint(result)"
                              TestId="fqr-all-findings" Class="fqr-detail-disclosure">
                <div class="fqr-findings-toolbar" role="group" aria-label="Filter source findings">
                    <input type="search"
                           class="form-control fqr-search"
                           placeholder="Search findings..."
                           aria-label="Search findings"
                           value="@_findingSearch"
                           @oninput="e => _findingSearch = e.Value?.ToString() ?? string.Empty" />

                    <select class="form-control fqr-select" @bind="_severityFilterValue" @bind:after="ApplySeverityFilter" aria-label="Filter by severity">
                        <option value="">All severities</option>
                        @foreach (var sev in Enum.GetValues<FrontendQualitySeverity>())
                        {
                            <option value="@sev.ToString()">@sev</option>
                        }
                    </select>

                    <select class="form-control fqr-select" @bind="_categoryFilterValue" @bind:after="ApplyCategoryFilter" aria-label="Filter by category">
                        <option value="">All categories</option>
                        @foreach (var cat in Enum.GetValues<FrontendQualityCategory>())
                        {
                            <option value="@cat.ToString()">@CategoryLabel(cat)</option>
                        }
                    </select>

                    @if (_sevFilter is not null || _catFilter is not null || !string.IsNullOrWhiteSpace(_findingSearch))
                    {
                        <button type="button" class="btn-secondary" @onclick="ClearFilters">Clear</button>
                    }
                </div>

                @if (filtered.Count == 0)
                {
                    <div class="fqr-empty-panel">No findings match the current filter.</div>
                }
                else
                {
                    <div class="fqr-table-wrap">
                        <table class="fqr-findings-table">
                            <thead>
                                <tr>
                                    <th><button type="button" @onclick='() => SortBy("severity")'>Severity @SortGlyph("severity")</button></th>
                                    <th><button type="button" @onclick='() => SortBy("category")'>Category @SortGlyph("category")</button></th>
                                    <th><button type="button" @onclick='() => SortBy("title")'>Title @SortGlyph("title")</button></th>
                                    <th>Description</th>
                                    <th>Recommendation</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var finding in filtered)
                                {
                                    <tr data-origin="@finding.Origin">
                                        <td><span class="fqr-severity fqr-severity-@finding.Severity.ToString().ToLowerInvariant()">@finding.Severity</span></td>
                                        <td>@CategoryLabel(finding.Category)</td>
                                        <td>
                                            <strong>@finding.Title</strong>
                                            @if (!string.IsNullOrWhiteSpace(finding.SourceSystem))
                                            {
                                                <span class="fqr-source">@finding.SourceSystem</span>
                                            }
                                            @if (finding.Origin == FrontendQualityFindingOrigin.Derived)
                                            {
                                                <span class="fqr-pill fqr-pill-muted" data-testid="fqr-finding-derived">Derived</span>
                                            }
                                        </td>
                                        <td>@finding.Description</td>
                                        <td>@finding.Recommendation</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </ReviewDisclosure>

            <ReviewDisclosure Text="Engine coverage" CollapseText="Hide engine coverage"
                              Hint="@EngineCoverageHint(result)" TestId="fqr-engine-coverage" Class="fqr-detail-disclosure">
                <FrontendQualityDecisionSupport Report="report" />
            </ReviewDisclosure>

            <ReviewDisclosure Text="Target access at review start" CollapseText="Hide target access"
                              Hint="What this review could reach when it ran" TestId="fqr-result-technical" Class="fqr-detail-disclosure">
                @if (report.ActiveEngines is { } engines)
                {
                    <FrontendQualityActiveEnginesPanel Snapshot="engines" />
                }
                @if (report.TargetAccess is { } access)
                {
                    <FrontendQualityTargetAccessPanel Access="access" ShowActions="false" />
                }
            </ReviewDisclosure>

            @* Scores are per-engine numbers on different scales. They were never comparable, and none of them is the
               review's result — so they sit here rather than anywhere a reader might add them up. *@
            <ReviewDisclosure Text="Engine scores" CollapseText="Hide engine scores"
                              Hint="Per-source scores; not comparable and not a review result" TestId="fqr-engine-scores" Class="fqr-detail-disclosure">
                <FrontendQualityEngineScores Report="report" />
            </ReviewDisclosure>

            <ReviewDisclosure Text="Technical details" CollapseText="Hide technical details"
                              Hint="Execution, scope, limitations and raw evidence" TestId="fqr-result-diagnostics" Class="fqr-detail-disclosure">
                <div class="fqr-technical" data-testid="fqr-technical">
                    <section class="fqr-technical-block" aria-labelledby="fqr-tech-execution">
                        <h3 id="fqr-tech-execution">Execution</h3>
                        <dl class="fqr-technical-list-grid" data-testid="fqr-technical-execution">
                            <div><dt>Target URL (requested)</dt><dd>@report.TargetUrl</dd></div>
                            @if (!string.IsNullOrWhiteSpace(report.FinalUrl) && report.FinalUrl != report.TargetUrl)
                            {
                                <div><dt>Target URL (final)</dt><dd>@report.FinalUrl</dd></div>
                                @if (report.RedirectOccurred)
                                {
                                    <div><dt>Redirect occurred</dt><dd>Yes</dd></div>
                                }
                            }
                            <div><dt>Generated</dt><dd>@report.GeneratedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd></div>
                            @if (report.CompletedAt.HasValue && report.DurationMs.HasValue)
                            {
                                <div><dt>Completed</dt><dd>@report.CompletedAt.Value.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd></div>
                                <div><dt>Duration</dt><dd>@(report.DurationMs.Value / 1000.0)s</dd></div>
                            }
                            <div><dt>Application</dt><dd>@(report.IsBlazorWasm ? "Blazor WASM detected" : "Blazor WASM not detected")</dd></div>
                            @if (!string.IsNullOrWhiteSpace(report.ErrorMessage))
                            {
                                <div><dt>Error</dt><dd>@report.ErrorMessage</dd></div>
                            }
                        </dl>
                    </section>

                    @* The four dimensions again, in their exact source values. Never one "completeness" word. *@
                    @if (result.Completeness is { } completeness)
                    {
                        <section class="fqr-technical-block" aria-labelledby="fqr-tech-coverage">
                            <h3 id="fqr-tech-coverage">Coverage</h3>
                            <dl class="fqr-technical-list-grid" data-testid="fqr-technical-coverage">
                                <div><dt>Execution</dt><dd>@completeness.ExecutionLabel</dd></div>
                                <div><dt>Required coverage</dt><dd>@completeness.RequiredCoverageLabel (@completeness.RequiredAssessed of @completeness.RequiredTotal)</dd></div>
                                <div><dt>Optional coverage</dt><dd>@completeness.OptionalCoverageLabel (@completeness.OptionalAssessed of @completeness.OptionalTotal)</dd></div>
                                <div><dt>Manual assessment</dt><dd>@completeness.ManualAssessmentLabel</dd></div>
                                @if (report.AssessedEngines.Count > 0)
                                {
                                    <div><dt>Assessed engines</dt><dd>@string.Join(", ", report.AssessedEngines)</dd></div>
                                }
                                @if (report.SkippedEngines.Count > 0)
                                {
                                    <div><dt>Skipped engines</dt><dd>@string.Join(", ", report.SkippedEngines)</dd></div>
                                }
                                @if (report.FailedEngines.Count > 0)
                                {
                                    <div><dt>Failed engines</dt><dd>@string.Join(", ", report.FailedEngines)</dd></div>
                                }
                            </dl>
                        </section>
                    }

                    <section class="fqr-technical-block" aria-labelledby="fqr-tech-scope">
                        <h3 id="fqr-tech-scope">Scope</h3>
                        <p>This review combines the configured static, passive and real-browser engines shown in Engine coverage. It does not establish:</p>
                        <ul>
                            <li>Active vulnerability scanning or penetration testing</li>
                            <li>WCAG conformance or completion of manual accessibility assessment</li>
                            <li>Production field Core Web Vitals or field INP</li>
                            <li>End-to-end user flow validation</li>
                        </ul>
                    </section>

                    @if (report.Risks.Count > 0 || report.Limitations.Count > 0)
                    {
                        <section class="fqr-technical-block" aria-labelledby="fqr-tech-limits">
                            <h3 id="fqr-tech-limits">Limitations</h3>
                            @if (report.Risks.Count > 0)
                            {
                                <ul data-testid="fqr-technical-risks">@foreach (var risk in report.Risks) { <li>@risk</li> }</ul>
                            }
                            @if (report.Limitations.Count > 0)
                            {
                                <ul data-testid="fqr-technical-limitations">@foreach (var limitation in report.Limitations) { <li>@limitation</li> }</ul>
                            }
                        </section>
                    }

                    @* One block per distinct evidence record. The same three payload records were repeated for every
                       finding that cited them, so the same lines appeared several times in one list. *@
                    @* Raw evidence is one level further in, and is not rendered until asked for: it can run to hundreds of
                       lines, and opening Technical details to read the execution facts should not build them. *@
                    @if (evidenceRecords.Count > 0)
                    {
                        <section class="fqr-technical-block" aria-labelledby="fqr-tech-evidence" data-testid="fqr-technical-raw">
                            <h3 id="fqr-tech-evidence">Raw evidence</h3>
                            <p class="fqr-muted" data-testid="fqr-technical-raw-count">@evidenceRecords.Count distinct evidence record@(evidenceRecords.Count == 1 ? "" : "s")</p>
                            <button type="button" class="btn-secondary fqr-raw-toggle" data-testid="fqr-technical-raw-toggle"
                                    aria-expanded="@(_rawEvidenceOpen ? "true" : "false")" aria-controls="fqr-technical-evidence-list"
                                    @onclick="() => _rawEvidenceOpen = !_rawEvidenceOpen">@(_rawEvidenceOpen ? "Hide raw evidence" : "View raw evidence")</button>
                            @if (_rawEvidenceOpen)
                            {
                                <ul class="fqr-technical-evidence-list" id="fqr-technical-evidence-list" data-testid="fqr-technical-evidence">
                                    @foreach (var record in evidenceRecords)
                                    {
                                        <li>
                                            <code>@record.Value</code>
                                            <span class="fqr-muted">@record.Sources</span>
                                        </li>
                                    }
                                </ul>
                            }
                        </section>
                    }
                </div>
            </ReviewDisclosure>
        </section>
    }

</div>

@code {
    /// <summary>One distinct evidence record and every finding that cited it — the same record, listed once.</summary>
    private sealed record EvidenceRecord(string Value, string Sources);

    /// <summary>Landing-view projection built once per render from the authoritative state held by this page.</summary>
    private sealed record LandingView(
        FrontendQualityTargetSummaryModel Target,
        FrontendQualityReviewReadiness Readiness,
        IReadOnlyList<FrontendQualityCapabilityRow> Capabilities,
        IReadOnlyList<FrontendQualityDimensionCard> Dimensions,
        IReadOnlyList<FrontendQualityTechnicalField> TechnicalFields,
        FrontendQualityAuthenticatedReviewModel? AuthenticatedReview);

    private const string TargetEnvironmentsHref = FrontendQualityTargetAccess.TargetEnvironmentsHref;

    private FrontendQualityEngineStatusReportDto? _engineStatus;
    /// <summary>Browser Companion runtime (optional service): compact status for the Browser Quality engine on the landing view.</summary>
    private BrowserCompanionRuntime? _companionRuntime;
    private bool ProxyRunningForLanding =>
        (ServiceProvider.GetService(typeof(LocalHttpsProxyRuntime)) as LocalHttpsProxyRuntime)?.Status.State
            is LocalHttpsProxyState.Listening or LocalHttpsProxyState.WaitingForAuthenticatedTraffic or LocalHttpsProxyState.AuthenticatedTrafficDetected or LocalHttpsProxyState.Ready;
    /// <summary>Engines active for the next review, resolved from the saved configuration of the active Target Environment.</summary>
    private FrontendQualityActiveEngineSnapshot? _activeEngines;
    /// <summary>Layer 1–3 status is being fetched for the ACTIVE backend engines only; null when no backend engine is active.</summary>
    private Task? _engineStatusTask;
    private bool _engineStatusPending;
    /// <summary>Layer 3 readiness probes for the active backend engines are in flight (informational; Run does not wait).</summary>
    private bool _readinessPending;
    private IReadOnlyList<FrontendQualityEngineIdDto> ActiveBackendEngineIds =>
        _activeEngines is null ? []
        : FrontendQualityActiveEngines.BackendEngineIds.Where(pair => _activeEngines.IsActive(pair.Key)).Select(pair => pair.Value).ToList();
    private string EngineStatusPendingText => $"Checking {ActiveBackendEngineIds.Count} active engine{(ActiveBackendEngineIds.Count == 1 ? "" : "s")}…";
    private string RunButtonText => _running ? "Analysing..."
        : _engineStatusPending ? EngineStatusPendingText
        : "Run Frontend Quality Review";
    private bool RunDisabled => _running || _context is null || _context.ActiveTargetError is not null || !_context.HasTargetUrl
        || _activeEngines is not { HasActiveEngines: true } || _engineStatusPending;
    /// <summary>Human-readable reason shown next to a disabled Run button. Mirrors <see cref="RunDisabled"/>; never a technical code.</summary>
    private string? RunDisabledReason =>
        _running ? null
        : _context is null ? "Loading the active Target Environment…"
        : _context.ActiveTargetError is { } error ? $"{error} Select a Target Environment and choose Set as Active."
        : !_context.HasTargetUrl ? "The active Target Environment has no Frontend URL. Save a valid Frontend URL before running the review."
        : _activeEngines is not { HasActiveEngines: true } ? $"{FrontendQualityActiveEngines.NoActiveEnginesMessage} {FrontendQualityActiveEngines.NoActiveEnginesAction}"
        : null;

    /// <summary>
    /// The discovery snapshot the WCAG profile selection and manual reviews are written to. Read-only here: the
    /// displayed coverage still comes from this review run's own assessment, never from a live re-assessment.
    /// </summary>
    /// <summary>
    /// The accessibility profile this review will be evaluated against. It is review scope, persisted where it already
    /// lived — the Target Environment's WCAG settings — so the selector here and the WCAG result later read one value.
    /// </summary>
    private WcagAssessmentProfile SelectedWcagProfile => WcagSnapshot.Wcag.Profile;

    private async Task OnWcagProfileChanged(string profileId)
    {
        if (_context is null) return;
        if (ServiceProvider.GetService(typeof(IEndpointDiscoveryService)) is not IEndpointDiscoveryService discovery) return;
        await discovery.SaveWcagSettingsAsync(JS, _context.ActiveProfile.Id, new WcagSettings { ProfileId = profileId });
        StateHasChanged();
    }

    private EndpointDiscoverySnapshot WcagSnapshot =>
        _context is null ? new()
            : (ServiceProvider.GetService(typeof(IEndpointDiscoveryService)) as IEndpointDiscoveryService)?.GetSnapshot(_context.ActiveProfile.Id) ?? new();

    private BrowserCompanionState? CompanionState =>
        _companionRuntime is null || _context is null || _context.ActiveTargetError is not null ? null : _companionRuntime.For(_context.ActiveProfile.Id).State;

    /// <summary>
    /// Browser evidence this review will read, or null when no Browser Companion engine is enabled for this target and
    /// there is therefore nothing to consume. Built from the Browser Companion session and the stored discovery
    /// snapshot — the same two sources Browser Discovery reads, through the same derivations, so the two pages cannot
    /// disagree about what was captured or about whether a browser is open.
    /// </summary>
    private FrontendQualityBrowserEvidenceModel? LandingBrowserEvidence
    {
        get
        {
            if (_context is null || _context.ActiveTargetError is not null) return null;
            if (!_context.FeatureToggles.EnableBrowserQualityEngine && !_context.FeatureToggles.EnablePerformanceQualityEngine) return null;
            if (_companionRuntime is null) return null;
            var snapshot = (ServiceProvider.GetService(typeof(IEndpointDiscoveryService)) as IEndpointDiscoveryService)?.GetSnapshot(_context.ActiveProfile.Id);
            return FrontendQualityBrowserEvidencePresentation.Build(_companionRuntime.For(_context.ActiveProfile.Id), snapshot);
        }
    }

    /// <summary>
    /// Captured-evidence counts for the capability rows, from the same merge the Browser evidence section reads, so an
    /// engine that will run from recorded evidence is not reported as waiting for a live session.
    /// </summary>
    private BrowserEvidenceTotals? RecordedEvidence
    {
        get
        {
            if (_companionRuntime is null || _context is null || _context.ActiveTargetError is not null) return null;
            var snapshot = (ServiceProvider.GetService(typeof(IEndpointDiscoveryService)) as IEndpointDiscoveryService)?.GetSnapshot(_context.ActiveProfile.Id);
            return BrowserDiscoveryLive.Totals(_companionRuntime.For(_context.ActiveProfile.Id), snapshot);
        }
    }

    private LandingView BuildLanding()
    {
        var capabilities = _context is null || _context.ActiveTargetError is not null || _activeEngines is null
            ? (IReadOnlyList<FrontendQualityCapabilityRow>)[]
            : FrontendQualityLandingPresentation.Capabilities(_context, _activeEngines, _engineStatus, _engineStatusPending, _readinessPending, _access, CompanionState, RecordedEvidence);
        var readiness = FrontendQualityLandingPresentation.Readiness(_context, _activeEngines, capabilities, _engineStatusPending);
        var target = _context is null
            ? new FrontendQualityTargetSummaryModel("Loading…", "—", "—", "—", "Loading", false)
            : FrontendQualityLandingPresentation.TargetSummary(_context);
        var technical = _context is null ? [] : FrontendQualityLandingPresentation.TechnicalTargetFields(_context);
        var auth = _context is null || _context.ActiveTargetError is not null ? null
            : FrontendQualityLandingPresentation.AuthenticatedReview(_context, _access, _caps, _authSession);
        return new LandingView(target, readiness, capabilities, FrontendQualityLandingPresentation.Dimensions(capabilities, SelectedWcagProfile), technical, auth);
    }

    private FrontendAnalysisContext? _context;
    private BirkNext.LocalHttpsProxy.AuthenticatedReviewCapabilities? _caps;
    private FrontendQualityTargetAccessContext? _access;
    /// <summary>Transient reason the last Run click did not start a review (active target missing at execution time). Cleared on the next Run or refresh.</summary>
    private string? _runNotStartedReason;
    private AuthenticatedBrowserSession? _authSession;
    private bool _authPolling;

    private bool    _running;
    private string  _progressMessage = "";
    private string? _secError;
    private string? _perfError;

    private FrontendQualityReviewReport? _report;
    private bool ShowLegacyDecisionSupport => false;

    /// <summary>The accessibility profile THIS result was produced under, with its scope — read from the report, never from settings.</summary>
    private static string? AccessibilityScope(FrontendQualityResultView result) =>
        result.ProfileLabel is { Length: > 0 } label
            ? result.CriteriaInScope is { } criteria ? $"{label} · {criteria} criteria in scope" : label
            : null;

    /// <summary>
    /// The profile chosen for the next run changed while a result is on screen. The result is never re-labelled; the page
    /// just re-renders so it can say which profile this result belongs to and that a new run is what updates it.
    /// </summary>
    private void OnResultProfileChanged(string profileId) => StateHasChanged();

    /// <summary>How many logical issues the result leads with before asking the reader to open the full list.</summary>
    private const int KeyIssueCount = 5;

    /// <summary>Names what opening the disclosure shows: source observations, and how many of them.</summary>
    /// <summary>
    /// A derived domain lists indicators, never "source findings": QA Readiness showed "Derived · 4 indicators" above a
    /// button reading "View 4 source findings".
    /// </summary>
    private static string DomainDetailsText(FrontendQualityDomainResult domain) => domain.FindingCount switch
    {
        null or 0 => $"View {domain.Title.ToLowerInvariant()} detail",
        var count when domain.Derived => $"View {count} indicator{(count == 1 ? "" : "s")}",
        1 => "View 1 source finding",
        var count => $"View {count} source findings",
    };

    /// <summary>Source findings and derived indicators by their own names; the total only as "recorded".</summary>
    private static string SourceFindingsHint(FrontendQualityResultView result) =>
        $"{result.SourceFindingCount} source finding{(result.SourceFindingCount == 1 ? "" : "s")}"
        + (result.DerivedIndicatorCount > 0
            ? $" · {result.DerivedIndicatorCount} derived indicator{(result.DerivedIndicatorCount == 1 ? "" : "s")} · {result.SourceFindingCount + result.DerivedIndicatorCount} recorded"
            : "");

    /// <summary>Each kind of review item counted by its own name.</summary>
    private static string ReviewItemsHint(FrontendQualityReviewReport report, int actionable, int informational)
    {
        var derived = report.LogicalIssues.Count(i => !i.IsActionable && !i.Informational);
        return $"{actionable} actionable logical issue{(actionable == 1 ? "" : "s")}"
            + (informational > 0 ? $" · {informational} informational observation{(informational == 1 ? "" : "s")}" : "")
            + (derived > 0 ? $" · {derived} derived indicator{(derived == 1 ? "" : "s")}" : "");
    }

    /// <summary>Local UI state: raw evidence is built only after the reader asks for it.</summary>
    private bool _rawEvidenceOpen;

    private static string EngineCoverageHint(FrontendQualityResultView result) =>
        result.Completeness is not { } completeness ? "Engine outcomes for this run"
            : $"Required {completeness.RequiredAssessed}/{completeness.RequiredTotal} · Optional {completeness.OptionalAssessed}/{completeness.OptionalTotal}";

    /// <summary>
    /// Every evidence line once, with the findings that cited it. The raw-evidence block grouped by FINDING, so the
    /// three payload records shared by "Large application JavaScript payload", "Large uncompressed assets" and "Large
    /// CSS payload" were printed three times each and the list read as far more evidence than the review had.
    /// </summary>
    private static IReadOnlyList<EvidenceRecord> DistinctEvidence(FrontendQualityReviewReport report) => report.Findings
        .SelectMany(finding => finding.Evidence.Select(evidence => (Evidence: evidence, finding.Title)))
        .Where(item => !string.IsNullOrWhiteSpace(item.Evidence))
        .GroupBy(item => item.Evidence, StringComparer.Ordinal)
        .OrderBy(group => group.Key, StringComparer.Ordinal)
        .Select(group => new EvidenceRecord(
            group.Key,
            string.Join(", ", group.Select(item => item.Title).Distinct(StringComparer.Ordinal).Order(StringComparer.Ordinal))))
        .ToList();

    /// <summary>The findings this run recorded for one domain, most severe first.</summary>
    private static IReadOnlyList<FrontendQualityFinding> DomainFindings(FrontendQualityReviewReport report, FrontendQualityCategory category) =>
        report.Findings.Where(f => f.Category == category).OrderBy(f => f.Severity).ThenBy(f => f.Title).ToList();

    private string? _findingSearch;
    private FrontendQualitySeverity? _sevFilter;
    private FrontendQualityCategory? _catFilter;
    private string _severityFilterValue = "";
    private string _categoryFilterValue = "";
    private string _sortColumn = "severity";
    private bool _sortDescending;

    protected override async Task OnInitializedAsync()
    {
        _companionRuntime = ServiceProvider.GetService(typeof(BrowserCompanionRuntime)) as BrowserCompanionRuntime;
        _context = await ContextFactory.GetActiveContextAsync();
        _report  = RuntimeReviews.QualityReview.Report;
        ResolveActiveEngines();

        await ResolveAuthenticatedCapabilities();
        // Expensive Layer 3 readiness is fetched for the ACTIVE backend engines only and never blocks the first render.
        // With no active backend engine (e.g. only Static Security + Passive Performance) nothing is fetched at all.
        StartEngineStatusFetch();
        if (_report is null && _companionRuntime is not null && _context.ActiveTargetError is null)
        {
            // Read the existing owner's status and captured history even when FQR is opened directly.
            // Pairing and configuration remain exclusively in Browser Discovery.
            await _companionRuntime.FollowAsync(_context.ActiveProfile);
            _companionRuntime.Changed += OnCompanionChanged;
        }
    }

    private bool _disposed;
    private void OnCompanionChanged()
    {
        if (!_disposed && _report is null) _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _disposed = true;
        if (_companionRuntime is not null) _companionRuntime.Changed -= OnCompanionChanged;
    }

    /// <summary>Saved configuration → active engine set. Never inferred from capability or readiness.</summary>
    private void ResolveActiveEngines() =>
        _activeEngines = _context is null || _context.ActiveTargetError is not null ? null : FrontendQualityActiveEngines.Resolve(_context);

    private void StartEngineStatusFetch()
    {
        _engineStatus = null;
        _readinessPending = false;
        if (_context is null || _context.ActiveTargetError is not null || ActiveBackendEngineIds.Count == 0)
        {
            _engineStatusTask = null;
            _engineStatusPending = false;
            return;
        }
        _engineStatusPending = true;
        _engineStatusTask = FetchEngineStatusAndRenderAsync();
    }

    /// <summary>
    /// Two phases so Run never waits on runtime probes: (1) Layer 1–2 status (deployment policy / System Settings, no readiness
    /// probe) — this is what the execution snapshot needs, so Run is enabled as soon as it arrives; (2) Layer 3 readiness for the
    /// active backend engines only, informational for the engine cards. Readiness is revalidated per engine at execution anyway.
    /// </summary>
    private async Task FetchEngineStatusAndRenderAsync()
    {
        try { await FetchEngineStatus(withReadiness: false); }
        catch { _engineStatus = null; }
        finally
        {
            _engineStatusPending = false;
            await InvokeAsync(StateHasChanged);
        }
        if (_engineStatus is null) return;
        _ = FetchReadinessAndRenderAsync(); // informational; Run does not wait for it
    }

    private async Task FetchReadinessAndRenderAsync()
    {
        _readinessPending = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var layers = _engineStatus;
            await FetchEngineStatus(withReadiness: true);
            _engineStatus ??= layers;
        }
        catch { }
        finally
        {
            _readinessPending = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ResolveAuthenticatedCapabilities()
    {
        if (_context is null || _context.ActiveTargetError is not null)
        {
            _caps = null;
            _access = null;
            return;
        }
        // Optional so page-render tests that do not register it still work; when present it drives the authenticated coverage panel.
        if (ServiceProvider.GetService(typeof(IAuthenticatedReviewCapabilitiesService)) is IAuthenticatedReviewCapabilitiesService service)
            _caps = await service.ResolveAsync(ReviewAuthenticationIdentity.ForContext(_context));
        await ResolveTargetAccess();
    }

    /// <summary>Resolves the Target Environment access context shown on the landing view; the orchestrator resolves it again at run time.</summary>
    private async Task ResolveTargetAccess()
    {
        if (_context is null || !_context.HasTargetUrl) { _access = null; return; }
        if (ServiceProvider.GetService(typeof(IFrontendQualityTargetAccessResolver)) is IFrontendQualityTargetAccessResolver resolver)
        {
            try { _access = await resolver.ResolveAsync(_context); return; }
            catch { }
        }
        _access = FrontendQualityTargetAccess.FromContext(_context);
    }

    private async Task FetchEngineStatus(bool withReadiness = true)
    {
        if (_context is null || _context.ActiveTargetError is not null) return;

        var authMode = _context.RequiresAuthentication && _context.IsAuthenticatedSessionAvailable
            ? ReviewAuthenticationModeDto.Authenticated
            : ReviewAuthenticationModeDto.Anonymous;

        var selection = new ReviewEngineSelectionDto
        {
            Selected = _context.ReviewEngineSelection.ToSelectionMap()
                .ToDictionary(
                    kvp => kvp.Key,
                    kvp => kvp.Value),
            // Only the ACTIVE backend engines get the expensive Layer 3 readiness probe, and only in the informational phase.
            ReadinessEngines = withReadiness ? ActiveBackendEngineIds.ToList() : [],
        };

        _engineStatus = await EngineStatusService.GetStatusAsync(authMode, selection);
    }

    private string AuthenticationStatusText => _authSession?.StatusMessage switch
    {
        "Starting" or "BrowserReady" or "AuthenticationRequired" => "Opening secure sign-in window…",
        "AuthenticationInProgress" or "ConditionalAccessIntermediary" => "Completing Microsoft authentication…",
        "AwaitingUserContinuation" => "Waiting for security access confirmation",
        "AuthenticationExpired" => "The authenticated session expired. Sign in again to continue.",
        "UnexpectedOrigin" => "Authentication stopped because navigation reached an unexpected origin.",
        "AuthenticationFailed" => "Authentication failed safely.",
        "AuthenticationCancelled" or "Disposed" => "Authentication cancelled.",
        _ => "Sign in takes place in a BirkNext-controlled Microsoft Edge window. Credentials and MFA remain under your control."
    };

    private string DeliveryContextText => _authSession?.DeliveryContext switch
    {
        "ConditionalAccessMonitoredSession" or "ProxiedApplicationDelivery" => "Conditional Access / monitored session",
        "DirectApplication" => "Direct application",
        _ => "Validated application session"
    };

    /// <summary>Live sign-in progress for the authenticated review panel; null until a sign-in flow has been started.</summary>
    private string? AuthProgressText => _authSession is null ? null
        : _authSession.StatusMessage == "AwaitingUserContinuation"
            ? $"{AuthenticationStatusText} The organization has presented a monitored-session notice. Review it in the authentication window and choose whether to continue."
        : _authSession.IsAuthenticated ? $"Authenticated — Delivery context: {DeliveryContextText}"
        : AuthenticationStatusText;

    private async Task StartAuthentication()
    {
        if (_context is null || _authPolling) return;
        _authSession = await AuthenticatedSessions.BeginAuthenticationAsync(_context);
        _authPolling = !string.IsNullOrWhiteSpace(_authSession.SessionId);
        StateHasChanged();
        while (_authPolling)
        {
            await Task.Delay(750);
            var status = await AuthenticatedSessions.GetStatusAsync();
            _authSession = await AuthenticatedSessions.GetCurrentSessionAsync();
            StateHasChanged();
            if (status is AuthenticatedBrowserSessionStatus.Authenticated or AuthenticatedBrowserSessionStatus.AuthenticationExpired or AuthenticatedBrowserSessionStatus.AuthenticationCancelled or AuthenticatedBrowserSessionStatus.AuthenticationFailed or AuthenticatedBrowserSessionStatus.UnexpectedOrigin or AuthenticatedBrowserSessionStatus.Disposed)
                _authPolling = false;
        }
        // The access context shown on the landing reflects the new browser session state.
        await ResolveTargetAccess();
    }

    private async Task CancelAuthentication()
    {
        _authPolling = false;
        await AuthenticatedSessions.ClearSessionAsync();
        _authSession = new AuthenticatedBrowserSession { StatusMessage = "AuthenticationCancelled" };
        await ResolveTargetAccess();
    }

    private async Task RunReview()
    {
        if (_running) return;
        _running     = true;
        // Resolve again at execution time; UI selection never participates. Preserve
        // this page's engine choices only when the target identity is unchanged.
        var previousContext = _context;
        _runNotStartedReason = null;
        _context = await ContextFactory.GetActiveContextAsync();
        if (_context.ActiveTargetError is not null || !_context.HasTargetUrl)
        {
            // The run attempt itself is reported, not only the landing configuration state: the
            // active target changed or disappeared between landing and clicking Run.
            _runNotStartedReason = _context.ActiveTargetError is { Length: > 0 } error
                ? $"{error} Select a Target Environment and choose Set as Active."
                : "The active Target Environment has no Frontend URL. Save a valid Frontend URL before running the review.";
            _running = false;
            _access = null;
            _caps = null;
            StateHasChanged();
            return;
        }
        if (previousContext?.ActiveProfile.Id == _context.ActiveProfile.Id)
            _context.ReviewEngineSelection = previousContext.ReviewEngineSelection;
        // Active engines are captured from the SAVED configuration now; the orchestrator snapshots them for this run, so
        // settings edited while the review runs only affect the next review. Zero active engines never starts a review.
        ResolveActiveEngines();
        if (_activeEngines is not { HasActiveEngines: true })
        {
            _runNotStartedReason = $"{FrontendQualityActiveEngines.NoActiveEnginesMessage} {FrontendQualityActiveEngines.NoActiveEnginesAction}";
            _running = false;
            StateHasChanged();
            return;
        }
        if (_engineStatusTask is { } pendingStatus)
            await pendingStatus; // Layer 1–3 status for the active backend engines feeds the execution snapshot.
        await ResolveAuthenticatedCapabilities();
        _secError    = null;
        _perfError   = null;
        _report      = null;
        RuntimeReviews.MarkQualityRunning(_context);
        StateHasChanged();

        var startTime = DateTime.UtcNow;
        var targetIdentity = new FrontendReviewTargetIdentity(
            _context.ActiveProfile.Id, _context.ActiveProfile.Name,
            _context.ActiveProfile.EnvironmentType.ToString(), _context.TargetUrl, startTime);
        _progressMessage = "Running enabled review engines...";
        StateHasChanged();

        var snapshot = CaptureExecutionSnapshot();
        var orchestration = await Orchestrator.RunAsync(_context.TargetUrl, _context, snapshot);
        _secError = orchestration.SecurityError;
        _perfError = orchestration.PerformanceError;

        // ── Preflight target validation before scanning ────────────────
        if (orchestration.QualityReport is null)
        {
            _running = false;
            RuntimeReviews.MarkQualityFailed(
                _context,
                orchestration.PreflightBlockReason ?? "Enabled review engines did not produce a quality report.");
            StateHasChanged();
            return;
        }

        // ── Security scan — respects EnableSecurityEngine toggle ──
        // ── Performance scan — respects EnablePerformanceEngine toggle ──
        _progressMessage = "Building quality report...";
        StateHasChanged();

        var qualityReport = orchestration.QualityReport;

        // Enhance report with timing and completion info.
        var completedReport = new FrontendQualityReviewReport
        {
            TargetEnvironment = targetIdentity,
            TargetUrl = qualityReport.TargetUrl,
            FinalUrl = qualityReport.FinalUrl,
            GeneratedAt = qualityReport.GeneratedAt,
            CompletedAt = DateTime.UtcNow,
            DurationMs = (long)(DateTime.UtcNow - startTime).TotalMilliseconds,
            OverallScore = qualityReport.OverallScore,
            PerformanceScore = qualityReport.PerformanceScore,
            SecurityScore = qualityReport.SecurityScore,
            AccessibilityScore = qualityReport.AccessibilityScore,
            StandardsScore = qualityReport.StandardsScore,
            WasmScore = qualityReport.WasmScore,
            ReadinessScore = qualityReport.ReadinessScore,
            Findings = qualityReport.Findings,
            // Defect: this field-by-field copy silently dropped four results the view below renders, so the WCAG
            // coverage, the BirkNext Performance Quality section, the redirect note and the engine error message
            // could never appear after a run. They are part of the orchestrator's report and belong here.
            Wcag = qualityReport.Wcag,
            PerformanceQualityReport = qualityReport.PerformanceQualityReport,
            RedirectOccurred = qualityReport.RedirectOccurred,
            ErrorMessage = qualityReport.ErrorMessage,
            LogicalIssues = qualityReport.LogicalIssues,
            ManualReviewItems = qualityReport.ManualReviewItems,
            CategoryScores = qualityReport.CategoryScores,
            Recommendations = qualityReport.Recommendations,
            Risks = qualityReport.Risks,
            Limitations = qualityReport.Limitations,
            IsBlazorWasm = qualityReport.IsBlazorWasm,
            Coverage = qualityReport.Coverage,
            ReleaseDisposition = qualityReport.ReleaseDisposition,
            EngineOutcomes = qualityReport.EngineOutcomes,
            Completeness = qualityReport.Completeness,
            AssessedEngines = qualityReport.AssessedEngines,
            FailedEngines = qualityReport.FailedEngines,
            SkippedEngines = qualityReport.SkippedEngines,
            PreflightStatus = qualityReport.PreflightStatus,
            PreflightMessage = qualityReport.PreflightMessage,
            TargetAccess = qualityReport.TargetAccess,
            ActiveEngines = qualityReport.ActiveEngines,
            AuthenticatedApiSurface = qualityReport.AuthenticatedApiSurface,
            AccessibilityReport = qualityReport.AccessibilityReport,
            LighthouseReport = qualityReport.LighthouseReport,
            PassiveSecurityReport = qualityReport.PassiveSecurityReport,
            BrowserRuntimeReport = qualityReport.BrowserRuntimeReport,
        };

        _report  = completedReport;
        _running = false;
        RuntimeReviews.SaveQualityResult(_report, _context);
        ClearFilters();
    }

    private async Task BackToReview()
    {
        _report = null;
        _running = false;
        _progressMessage = "";
        ClearFilters();
        await RefreshContext();
    }

    private async Task ExportHtml()
    {
        if (_report is null) return;
        var html = ExportService.ExportFrontendQualityReview(_report, Workspace.ProjectName);
        await JS.InvokeVoidAsync("downloadHtmlFile", $"frontend-quality-review-{DateTime.UtcNow:yyyy-MM-dd}.html", html);
    }

    private async Task ExportPdf()
    {
        await JS.InvokeVoidAsync("print");
    }

    private async Task RefreshContext()
    {
        if (_running) return;
        _runNotStartedReason = null;
        _context = await ContextFactory.GetActiveContextAsync();
        ResolveActiveEngines();
        await ResolveAuthenticatedCapabilities();
        StartEngineStatusFetch();
    }

    private void SetCategoryFilter(FrontendQualityCategory cat)
    {
        _catFilter = _catFilter == cat ? null : cat;
        _categoryFilterValue = _catFilter?.ToString() ?? "";
    }

    private void ApplySeverityFilter()
    {
        _sevFilter = Enum.TryParse<FrontendQualitySeverity>(_severityFilterValue, out var sev) ? sev : null;
    }

    private void ApplyCategoryFilter()
    {
        _catFilter = Enum.TryParse<FrontendQualityCategory>(_categoryFilterValue, out var cat) ? cat : null;
    }

    private void ClearFilters()
    {
        _sevFilter = null;
        _catFilter = null;
        _findingSearch = null;
        _severityFilterValue = "";
        _categoryFilterValue = "";
    }

    private void SortBy(string column)
    {
        if (_sortColumn == column)
        {
            _sortDescending = !_sortDescending;
            return;
        }

        _sortColumn = column;
        _sortDescending = false;
    }

    private string SortGlyph(string column) =>
        _sortColumn != column ? "" : _sortDescending ? "v" : "^";

    private IEnumerable<FrontendQualityFinding> FilteredFindings(IReadOnlyList<FrontendQualityFinding> all)
    {
        IEnumerable<FrontendQualityFinding> q = all;
        if (_sevFilter.HasValue) q = q.Where(f => f.Severity == _sevFilter.Value);
        if (_catFilter.HasValue) q = q.Where(f => f.Category == _catFilter.Value);
        if (!string.IsNullOrWhiteSpace(_findingSearch))
        {
            var term = _findingSearch.Trim();
            q = q.Where(f =>
                f.Title.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                f.Description.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                f.Recommendation.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                CategoryLabel(f.Category).Contains(term, StringComparison.OrdinalIgnoreCase) ||
                f.Severity.ToString().Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        q = _sortColumn switch
        {
            "category" => _sortDescending
                ? q.OrderByDescending(f => CategoryLabel(f.Category)).ThenBy(f => f.Severity).ThenBy(f => f.Title)
                : q.OrderBy(f => CategoryLabel(f.Category)).ThenBy(f => f.Severity).ThenBy(f => f.Title),
            "title" => _sortDescending
                ? q.OrderByDescending(f => f.Title).ThenBy(f => f.Severity)
                : q.OrderBy(f => f.Title).ThenBy(f => f.Severity),
            _ => _sortDescending
                ? q.OrderByDescending(f => f.Severity).ThenBy(f => f.Category).ThenBy(f => f.Title)
                : q.OrderBy(f => f.Severity).ThenBy(f => f.Category).ThenBy(f => f.Title),
        };

        return q;
    }

    /// <summary>
    /// A category whose contributing engines were all disabled/not selected at review start shows "Not enabled" rather than a
    /// dash that reads like a failed assessment. Uses the review's own activation snapshot, never current settings.
    /// </summary>
    private static bool CategoryEnginesNotEnabled(FrontendQualityReviewReport report, FrontendQualityCategory category)
    {
        if (report.ActiveEngines is not { } active) return false;
        var engines = FrontendQualityCategoryEngines.For(category);
        return engines.Count > 0 && engines.All(id => !active.IsActive(id));
    }

    private static string CategoryLabel(FrontendQualityCategory c) => c switch
    {
        FrontendQualityCategory.Performance   => "Performance",
        FrontendQualityCategory.Security      => "Security",
        FrontendQualityCategory.Accessibility => "Accessibility",
        FrontendQualityCategory.Standards     => "Standards",
        FrontendQualityCategory.BlazorWasm    => "Blazor WASM",
        FrontendQualityCategory.Readiness     => "Readiness",
        _                                     => c.ToString(),
    };

    private static string ScoreVariant(int score) =>
        score >= 80 ? "success" : score >= 50 ? "warning" : "danger";

    private static string QualityLabel(int score) =>
        score >= 90 ? "Excellent" :
        score >= 80 ? "Good" :
        score >= 65 ? "Needs Attention" :
        score >= 50 ? "At Risk" : "Critical";

    private void OnCapabilitySelectionChanged((FrontendQualityEngineIdDto EngineId, bool Selected) change) =>
        HandleEngineSelectionChange(change.EngineId, change.Selected);

    private void HandleEngineSelectionChange(FrontendQualityEngineIdDto engineId, bool selected)
    {
        if (_context is null) return;

        var selection = _context.ReviewEngineSelection.ToSelectionMap();
        selection[engineId] = selected;
        _context.ReviewEngineSelection = ReviewEngineSelection.FromSelectionMap(selection);
        ResolveActiveEngines(); // selection is a per-review opt-out among ENABLED engines; it never enables a disabled one
    }

    private FrontendQualityEngineExecutionSnapshot CaptureExecutionSnapshot()
    {
        var snapshot = new FrontendQualityEngineExecutionSnapshot
        {
            AuthMode = _context?.RequiresAuthentication == true && _context?.IsAuthenticatedSessionAvailable == true
                ? ReviewAuthenticationModeDto.Authenticated
                : ReviewAuthenticationModeDto.Anonymous,
            CapturedAtUtc = DateTime.UtcNow,
        };

        if (_engineStatus != null)
        {
            foreach (var engine in _engineStatus.Engines)
            {
                snapshot.Layer1Allowed[engine.EngineId] = engine.Layer1Allowed;
                snapshot.Layer2Enabled[engine.EngineId] = engine.Layer2Enabled;
                snapshot.AuthModeSupported[engine.EngineId] = engine.AuthModeSupported;
            }
        }

        // Selection in the execution snapshot = the activation rule (saved Enabled toggle && per-review selection).
        // A disabled engine is never selected for execution, whatever the checkbox state says.
        var activation = _activeEngines ?? (_context is null ? null : FrontendQualityActiveEngines.Resolve(_context));
        foreach (var (engineId, dto) in FrontendQualityActiveEngines.BackendEngineIds)
            snapshot.SelectedEngines[dto] = activation?.IsActive(engineId) == true;

        return snapshot;
    }
}
