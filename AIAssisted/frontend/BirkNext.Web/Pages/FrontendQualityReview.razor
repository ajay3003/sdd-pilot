    // ── Issues view filters ───────────────────────────────────────────────────────────────────────────────────────────────────────

    private string? _issueSearch;
    private string _issueSeverity = "";
    private string _issueDomain = "";
    private string _issueImpact = "";

    private bool IssueFiltersActive =>
        !string.IsNullOrWhiteSpace(_issueSearch) || _issueSeverity.Length > 0 || _issueDomain.Length > 0 || _issueImpact.Length > 0;

    /// <summary>A domain card's one details action: the Issues view filtered to that domain (and the issues it also appears in).</summary>
    private void ReviewDomainIssues(FrontendQualityCategory category)
    {
        ClearIssueFilters();
        _issueDomain = category.ToString();
        _tab = FrontendQualityResultTab.Issues;
    }

    private void ClearIssueFilters()
    {
        _issueSearch = null;
        _issueSeverity = _issueDomain = _issueImpact = "";
    }

    /// <summary>A domain filter matches an issue's primary domain and the domains it also shows up in: one issue, several domains.</summary>
    private IEnumerable<FrontendQualityLogicalIssue> FilteredIssues(FrontendQualityReviewReport report, IReadOnlyList<FrontendQualityLogicalIssue> issues)
    {
        IEnumerable<FrontendQualityLogicalIssue> q = issues;
        if (Enum.TryParse<FrontendQualitySeverity>(_issueSeverity, out var severity)) q = q.Where(i => i.PrimarySeverity == severity);
        if (Enum.TryParse<FrontendQualityCategory>(_issueDomain, out var domain)) q = q.Where(i => i.Category == domain || i.RelatedCategories.Contains(domain));
        if (Enum.TryParse<FrontendQualityReleaseImpact>(_issueImpact, out var impact)) q = q.Where(i => FrontendQualityPostRunPresentation.IssueImpact(report, i) == impact);
        if (!string.IsNullOrWhiteSpace(_issueSearch))
        {
            var term = _issueSearch.Trim();
            q = q.Where(i => i.CanonicalTitle.Contains(term, StringComparison.OrdinalIgnoreCase)
                || i.Recommendation.Contains(term, StringComparison.OrdinalIgnoreCase));
        }
        return q;
    }

