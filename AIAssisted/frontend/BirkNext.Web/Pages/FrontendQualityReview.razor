@page "/frontend-quality-review"
@implements IDisposable
@using BirkNext.BrowserCompanion
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using BirkNext.Web.Components
@using BirkNext.LocalHttpsProxy
@inject IFrontendQualityReviewOrchestrator Orchestrator
@inject IFrontendAnalysisContextFactory ContextFactory
@inject IAuthenticatedBrowserSessionService AuthenticatedSessions
@inject RuntimeReviewSessionService RuntimeReviews
@inject IWorkspaceSessionService Workspace
@inject IReportExportService ExportService
@inject IFrontendQualityEngineStatusApiService EngineStatusService
@inject IServiceProvider ServiceProvider
@inject IJSRuntime JS

<PageTitle>Frontend Quality Review</PageTitle>

<div class="fqr-page">

    <PageHeader Title="Frontend Quality Review"
                Description="Review a deployed frontend for performance, security, accessibility, standards compliance, Blazor/WASM quality, and QA readiness.">
        @if (_report is not null)
        {
            @* One primary action after a run: Run again. Back is secondary; every export format sits in one menu. *@
            <button type="button" class="btn-secondary" data-testid="fqr-back" @onclick="BackToReview">Back to Frontend Quality Review</button>
            <ExportMenu Options="ExportOptions" TestId="fqr-export" />
            <button type="button" class="btn-primary fqr-result-rerun" data-testid="fqr-run-again" @onclick="RunReview">Run again</button>
        }
        @* Before a run the primary action sits in the decision area below, directly under target, profile and readiness. *@
    </PageHeader>

    @if (_report is null)
    {
        var landing = BuildLanding();

        @if (_runNotStartedReason is { } notStarted)
        {
            <div class="wsr-banner wsr-banner-error wsr-banner-standalone fqr-run-not-started" role="alert" data-testid="fqr-run-not-started">
                <span aria-hidden="true">⚠</span>
                <strong>Review not started</strong> — @notStarted
                <a href="@TargetEnvironmentsHref" class="wsr-banner-action">Open Target Environments</a>
                <button type="button" class="btn-secondary fqr-banner-dismiss" @onclick="() => _runNotStartedReason = null" aria-label="Dismiss">Dismiss</button>
            </div>
        }

        <div class="fqr-landing" data-testid="fqr-landing">

            @*
                1. Decide. Everything needed to answer "should I run this review, and against what?" — the target, the
                criteria it is judged against, whether it can run, and the run action itself. Nothing diagnostic here.
            *@
            <section class="fqr-decide" aria-label="Review setup" data-testid="fqr-decide">
                <div class="fqr-decide-cards">
                    @* No technical disclosure here: the exact source values live in the ONE Technical details
                       disclosure at the end of Review details, so there is a single place to look for them. *@
                    <FrontendQualityTargetSummary Summary="landing.Target" ChangeHref="@TargetEnvironmentsHref" Verification="@ScopeVerification">
                        <ScopeControl>
                            @if (_context is not null)
                            {
                                <FrontendQualityScopePicker Selected="@PickerSelection" Recommendation="CurrentRecommendation"
                                    Notice="@FrontendQualityReviewScopes.ExplicitScopeNotice(_context.ActiveProfile.FrontendReviewScope, CurrentRecommendation)"
                                    SelectedChanged="ApplyReviewScope" TestingContext="@ScopeTestingContext" Configuration="@(_context.AuthenticationConfiguration ?? "Not assessed")"
                                    Provider="@FrontendQualityReviewScopes.ConfiguredProviderLabel(_context.AuthenticationType)" Verification="@ScopeVerification" />
                            }
                        </ScopeControl>
                    </FrontendQualityTargetSummary>
                    @* Review scope, stated before the run: which criteria accessibility is judged against. *@
                    <FrontendQualityProfileCard Selected="SelectedWcagProfile" ProfileChanged="OnWcagProfileChanged" />
                    <FrontendQualityReadinessPanel Readiness="landing.Readiness" />
                </div>
                <div class="fqr-run-bar" data-testid="fqr-run-bar">
                    <PrimaryButton OnClick="RunReview" Disabled="@RunDisabled" data-testid="fqr-run">@RunButtonText</PrimaryButton>
                    @if (_engineStatusPending)
                    {
                        <p class="fqr-run-reason" role="status" aria-live="polite" data-testid="fqr-engine-status-pending">@EngineStatusPendingText</p>
                    }
                    else if (RunDisabled && RunDisabledReason is { } disabledReason)
                    {
                        <p class="fqr-run-reason" role="status" data-testid="fqr-run-disabled-reason">@disabledReason</p>
                    }
                </div>
            </section>

            @* 2. Scope: the six review domains. Always visible — this is the main explanation of what the review covers. *@
            <FrontendQualityDimensionCards Cards="landing.Dimensions" />

            @if (landing.AuthenticatedReview is { } auth)
            {
                <FrontendQualityAuthenticatedReview Model="auth"
                                                    ProgressText="@AuthProgressText"
                                                    Polling="_authPolling"
                                                    ShowCancel="@(_authSession is not null)"
                                                    SignIn="StartAuthentication"
                                                    Cancel="CancelAuthentication"
                                                    ManageHref="@TargetEnvironmentsHref">
                    <TechnicalDetails>
                        @if (_caps is { } caps)
                        {
                            <AuthenticatedReviewStatus Capabilities="caps" ShowBrowserSurfaces="true" />
                        }
                        else
                        {
                            <p class="fqr-muted">Authenticated capability status is not available for this environment.</p>
                        }
                    </TechnicalDetails>
                </FrontendQualityAuthenticatedReview>
            }

            @*
                3. Review details. Everything technical, collapsed by default, ordered from what the reviewer asks about
                to what only an engineer asks about: access → scope → engines → evidence → scope boundary → diagnostics.
                Each row states one fact; expanding it reveals the detail. Nothing here changes the scope stated above.
            *@
            <section class="fqr-section fqr-details" aria-labelledby="fqr-details-heading" data-testid="fqr-details">
                <div class="fqr-section-head">
                    <h2 id="fqr-details-heading">Review details</h2>
                    <p class="fqr-section-note">How this review is scoped and what it can reach right now.</p>
                </div>

                @* 1. Review access — which surfaces of the target this review can reach. *@
                @if (_access is { } landingAccess)
                {
                    var semanticCapabilities = SemanticCapabilities(landingAccess);
                    var coverageRows = FrontendQualityLandingPresentation.Coverage(landingAccess, _caps, landing.Scope, semanticCapabilities);
                    var renderedDom = FrontendQualityCapabilityResolver.RenderedDom(semanticCapabilities, landingAccess.RequiresAuthentication);
                    @* Open by default (it answers "can this review reach what it needs?"), bound so a rerender never
                       re-opens it after the reader closes it. *@
                    <ReviewDisclosure Text="Review access" CollapseText="Hide review access"
                                      Hint="@FrontendQualityLandingPresentation.CoverageSummary(coverageRows).Headline"
                                      TestId="fqr-coverage-disclosure" Class="fqr-detail-disclosure" @bind-Expanded="_accessExpanded">
                        <FrontendQualityCoverageSummary Rows="coverageRows">
                            <TechnicalDetails>
                                <FrontendQualityTargetAccessPanel Access="landingAccess" ShowActions="true" />
                                @* Every rendered-DOM provider considered, live state only; the chosen one is named in the row above. *@
                                <dl class="fqr-dom-candidates" data-testid="fqr-dom-candidates">
                                    @foreach (var candidate in renderedDom.Candidates)
                                    {
                                        <div data-testid="fqr-dom-candidate" data-kind="@candidate.Kind">
                                            <dt>@(candidate.Provider ?? FrontendQualityExecutionPlanner.CapabilityLabel(candidate.Kind))</dt>
                                            <dd>@(candidate.Provider is null ? "" : $"{FrontendQualityExecutionPlanner.CapabilityLabel(candidate.Kind)} · ")@CandidateState(candidate.State)@(candidate.Provider == renderedDom.Provider && renderedDom.Available ? " · selected" : "") — @candidate.Reason</dd>
                                        </div>
                                    }
                                </dl>
                            </TechnicalDetails>
                        </FrontendQualityCoverageSummary>
                    </ReviewDisclosure>
                }

                @* 2. Review scope — the areas the automated and passive review covers, named rather than counted. *@
                <ReviewDisclosure Text="Review scope" CollapseText="Hide review scope"
                                  Hint="@FrontendQualityLandingPresentation.ReviewScopeSummary"
                                  TestId="fqr-checks-disclosure" Class="fqr-detail-disclosure">
                    <FrontendQualityChecksSection Groups="FrontendQualityLandingPresentation.CheckGroups" />
                </ReviewDisclosure>

                @* 3. Engines — ONE engine list. The "Active review engines" strip that used to sit inside it listed the
                       same engines a second time, in a second vocabulary. *@
                @if (_activeEngines is not null)
                {
                    <ReviewDisclosure Text="Engines" CollapseText="Hide engines"
                                      Hint="@(_enginesExpanded ? null : FrontendQualityLandingPresentation.CapabilitySummary(landing.Capabilities).Collapsed)"
                                      TestId="fqr-capabilities-disclosure" Class="fqr-detail-disclosure" @bind-Expanded="_enginesExpanded">
                        <FrontendQualityCapabilityList Rows="landing.Capabilities" Scope="landing.Scope" SelectionChanged="OnCapabilitySelectionChanged" />
                    </ReviewDisclosure>
                }

                @* 4. Browser evidence — consumed, never administered. Browser Discovery owns the session and the setup. *@
                @if (LandingBrowserEvidence is { } evidence)
                {
                    <ReviewDisclosure Text="Browser evidence" CollapseText="Hide browser evidence"
                                      Hint="@FrontendQualityBrowserEvidencePresentation.Collapsed(evidence)"
                                      TestId="fqr-companion" Class="fqr-detail-disclosure">
                        <FrontendQualityBrowserEvidence Model="evidence" />
                    </ReviewDisclosure>
                }

                @* 5. Outside this review — scope boundaries, not gaps. *@
                <ReviewDisclosure Text="Outside this review" CollapseText="Hide what is outside this review"
                                  Hint="@FrontendQualityLandingPresentation.OutsideReviewSummary"
                                  TestId="fqr-not-assessed-disclosure" Class="fqr-detail-disclosure">
                    <FrontendQualityNotAssessedList Items="FrontendQualityLandingPresentation.NotAssessed" />
                </ReviewDisclosure>

                <ReviewDisclosure Text="Pipeline quality gates" CollapseText="Hide pipeline quality gates" Hint="Configured in pipeline source · not passed"
                                  TestId="fqr-delivery-gates" Class="fqr-detail-disclosure" @bind-Expanded="_deliveryExpanded">
                    @if (_deliveryExpanded)
                    {
                        <BirkNext.Web.Components.DeliveryEvidencePanel EnvironmentId="@(_context?.ActiveProfile.Id ?? "")" Categories="@([BirkNext.PipelineReview.ValidationCategory.E2E, BirkNext.PipelineReview.ValidationCategory.Frontend, BirkNext.PipelineReview.ValidationCategory.Accessibility, BirkNext.PipelineReview.ValidationCategory.Smoke, BirkNext.PipelineReview.ValidationCategory.Performance])" />
                    }
                </ReviewDisclosure>

                @* 6. Technical details — the one place engine ids, layer state, runtime reasons, the full target URL,
                       approved origins and exact timestamps live. No decision above this line needs them. *@
                <ReviewDisclosure Text="Technical details" CollapseText="Hide technical details"
                                  Hint="Engine internals, target and evidence diagnostics"
                                  TestId="fqr-technical-disclosure" Class="fqr-detail-disclosure">
                    <div class="fqr-technical" data-testid="fqr-technical">
                        @if (landing.TechnicalFields.Count > 0)
                        {
                            <section class="fqr-technical-block" aria-labelledby="fqr-technical-target-heading">
                                <h3 id="fqr-technical-target-heading">Target environment and configured engine state</h3>
                                <p class="fqr-section-note">Enabled and Disabled below are saved configuration, not runtime availability.</p>
                                <dl class="fqr-technical-list-grid" data-testid="fqr-technical-target">
                                    @foreach (var field in landing.TechnicalFields)
                                    {
                                        <div><dt>@field.Label</dt><dd>@field.Value</dd></div>
                                    }
                                </dl>
                            </section>
                        }

                        <section class="fqr-technical-block" aria-labelledby="fqr-technical-engines-heading">
                            <h3 id="fqr-technical-engines-heading">Active runtime-dependent engine capabilities</h3>
                            <p class="fqr-section-note">Only active backend engines are shown. Runtime installation and capability are managed in <a href="@FrontendQualityLandingPresentation.SystemSettingsHref">System Settings — Frontend Engine Capabilities</a>.</p>
                            @if (_readinessPending)
                            {
                                <p class="fqr-muted fqr-engine-progress" aria-live="polite" data-testid="fqr-readiness-pending">Checking runtime readiness of @ActiveBackendEngineIds.Count active engine@(ActiveBackendEngineIds.Count == 1 ? "" : "s")… The review can start meanwhile; readiness is re-validated at execution.</p>
                            }
                            @if (_engineStatus is not null)
                            {
                                var activeBackendIds = ActiveBackendEngineIds;
                                <div class="fqr-engine-grid" data-testid="fqr-engine-grid">
                                    @foreach (var engine in _engineStatus.Engines.Where(e => activeBackendIds.Contains(e.EngineId)).OrderBy(e => e.EngineId))
                                    {
                                        <div class="fqr-engine-card" data-engine-id="@engine.EngineId">
                                            <div class="fqr-engine-header">
                                                <h4>@engine.DisplayName</h4>
                                                <span class="fqr-pill fqr-pill-@(engine.Available ? "ready" : "attention")">@(engine.Available ? "Available" : "Unavailable")</span>
                                            </div>
                                            <dl class="fqr-engine-layers">
                                                <div><dt>Engine ID</dt><dd>@engine.EngineId</dd></div>
                                                <div><dt>Deployment policy</dt><dd>@(engine.Layer1Allowed ? "Allowed" : "Blocked")</dd></div>
                                                <div><dt>System Settings</dt><dd>@(engine.Layer2Enabled ? "Enabled" : "Disabled")</dd></div>
                                                <div><dt>Runtime</dt><dd>@(engine.Layer3Readiness is null ? "Not checked" : engine.Layer3Readiness.IsAvailable ? "Ready" : "Unavailable")</dd></div>
                                                @if (engine.Layer3Readiness is { IsAvailable: false, StatusReason: { Length: > 0 } statusReason })
                                                {
                                                    <div><dt>Runtime reason</dt><dd>@statusReason</dd></div>
                                                }
                                                <div><dt>Authenticated review</dt><dd>@(engine.AuthModeSupported ? "Supported" : "Not supported")</dd></div>
                                            </dl>
                                        </div>
                                    }
                                </div>
                            }
                            else if (!_readinessPending)
                            {
                                <p class="fqr-muted" data-testid="fqr-engine-grid-empty">No backend engine capability status has been read for this target.</p>
                            }
                        </section>

                        @if (LandingBrowserEvidence is { } technicalEvidence)
                        {
                            <section class="fqr-technical-block" aria-labelledby="fqr-technical-evidence-heading">
                                <h3 id="fqr-technical-evidence-heading">Browser evidence</h3>
                                <dl class="fqr-technical-list-grid" data-testid="fqr-technical-evidence">
                                    @* Administered in Browser Discovery; shown here because it explains which pages can
                                       ever produce evidence, not because this page can change it. *@
                                    <div><dt>Current pairing/session approved origins</dt><dd class="fqr-mono">@(technicalEvidence.ApprovedOrigins.Count == 0 ? "None" : string.Join(", ", technicalEvidence.ApprovedOrigins))</dd></div>
                                    @* The live page's full identity (origin + route); the evidence block reads out the route. *@
                                    <div><dt>Current page identity</dt><dd class="fqr-mono">@technicalEvidence.CurrentPageIdentity</dd></div>
                                    <div><dt>Last captured evidence</dt><dd>@technicalEvidence.LastCapturedLabel</dd></div>
                                </dl>
                            </section>
                        }
                    </div>
                </ReviewDisclosure>
            </section>

            @if (_running)
            {
                <p class="fqr-run-progress" role="status" aria-live="polite">@_progressMessage</p>
            }
        </div>
    }

    @if (_secError is not null)
    {
        <div class="wsr-banner wsr-banner-warn wsr-banner-standalone" role="status">
            <span aria-hidden="true">!</span> Security scan: @_secError - security findings will be incomplete.
        </div>
    }
    @if (_perfError is not null)
    {
        <div class="wsr-banner wsr-banner-warn wsr-banner-standalone" role="status">
            <span aria-hidden="true">!</span> Performance scan: @_perfError - performance findings will be incomplete.
        </div>
    }

    @if (_report is not null)
    {
        var report = _report;
        var filtered = FilteredFindings(report.Findings).ToList();
        @* The result is projected from the report alone; the current profile selection is passed only to detect drift. *@
        var result = FrontendQualityResultPresentation.Build(report, WcagSnapshot.Wcag.ProfileId);
        @* Actionable = not informational and not derived: an absent optional capability and a restated conclusion are
           both worth keeping and neither is a problem to fix. *@
        var actionableIssues = result.ActionableIssues;
        var keyIssues = actionableIssues.Take(FrontendQualityPostRunPresentation.KeyIssueCount).ToList();
        var themes = FrontendQualityRecommendationGrouper.Build(result.LogicalIssues);
        var evidenceRecords = DistinctEvidence(report);
        var groupedInto = FrontendQualityPostRunPresentation.GroupedInto(result.LogicalIssues);
        var visibleIssues = FilteredIssues(report, actionableIssues).ToList();

        @if (_openedHistoryEntry is { } opened)
        {
            <div class="wsr-banner wsr-banner-info wsr-banner-standalone fqr-history-banner" role="status" data-testid="fqr-history-opened">
                <span aria-hidden="true">🕘</span>
                <strong>Previous run</strong> — completed @opened.CompletedAt.ToString("yyyy-MM-dd HH:mm") UTC. This is the stored result exactly as it completed; it is not recomputed against current settings.
                <button type="button" class="btn-secondary fqr-banner-dismiss" data-testid="fqr-history-return" @onclick="ReturnToLatestRun">Return to latest run</button>
            </div>
        }

        @if (report.PreflightStatus == PreflightStatus.AuthenticationRequired)
        {
            <div class="wsr-banner wsr-banner-error wsr-banner-standalone" role="status">
                <span aria-hidden="true">🔐</span>
                <strong>Authentication required</strong> — @(report.PreflightMessage ?? "The configured target requires authentication, so the protected frontend could not be assessed.")
                <a href="@TargetEnvironmentsHref" class="wsr-banner-action">Configure authentication</a>
            </div>
        }
        else if ((report.PreflightStatus is PreflightStatus.TimedOut or PreflightStatus.Unreachable or PreflightStatus.ScannerUnavailable) && !string.IsNullOrWhiteSpace(report.PreflightMessage))
        {
            <div class="wsr-banner wsr-banner-error wsr-banner-standalone" role="status" data-testid="fqr-preflight-banner">
                <span aria-hidden="true">⚠</span>
                <strong>@(report.PreflightStatus == PreflightStatus.TimedOut ? "Target timed out" : report.PreflightStatus == PreflightStatus.Unreachable ? "Target unreachable" : "Reachability check unavailable")</strong> — @report.PreflightMessage
            </div>
        }

        @* Five views of one result. Every panel stays in the DOM (inactive ones hidden) so a view switch never re-runs a projection and
           each concept has exactly one full rendering: issues in Issues, engines in Coverage, source findings in Evidence. *@
        <div class="fqr-tabs" role="tablist" aria-label="Review result views" data-testid="fqr-result-tabs">
            @foreach (var tab in FrontendQualityPostRunPresentation.Tabs)
            {
                var id = FrontendQualityPostRunPresentation.TabId(tab);
                <button type="button" role="tab" class="fqr-tab @(_tab == tab ? "fqr-tab-active" : "")" id="fqr-tab-@id"
                        aria-selected="@(_tab == tab ? "true" : "false")" aria-controls="fqr-tabpanel-@id" tabindex="@(_tab == tab ? "0" : "-1")"
                        data-testid="fqr-tab-@id" @ref="_tabRefs[tab]" @onclick="() => SelectTab(tab)" @onkeydown="e => OnTabKey(e, tab)">@TabLabel(tab, result)</button>
            }
        </div>

        @* ── Summary: the decision, why, and the few things to act on first ─────────────────────────────────────────────────────── *@
        <div role="tabpanel" id="fqr-tabpanel-summary" aria-labelledby="fqr-tab-summary" class="fqr-tabpanel" tabindex="0"
             hidden="@(_tab != FrontendQualityResultTab.Summary)" data-testid="fqr-tabpanel-summary">
            <FrontendQualityResultSummary Result="result" Report="report" />

            <section class="fqr-section" aria-labelledby="fqr-key-issues-heading" data-testid="fqr-key-issues">
                <div class="fqr-section-head">
                    <h2 id="fqr-key-issues-heading">Key issues</h2>
                    <p class="fqr-section-note">The most severe distinct problems. Each is described in full once, in Issues.</p>
                </div>
                <FrontendQualityLogicalIssues Issues="keyIssues" Compact="true" ImpactOf="issue => FrontendQualityPostRunPresentation.IssueImpact(report, issue)" />
                @if (actionableIssues.Count > keyIssues.Count)
                {
                    <button type="button" class="btn-secondary fa-btn-sm" data-testid="fqr-key-issues-more" @onclick="() => SelectTab(FrontendQualityResultTab.Issues)">
                        View all @actionableIssues.Count issues
                    </button>
                }
            </section>

            <section class="fqr-section" aria-labelledby="fqr-actions-heading" data-testid="fqr-recommended-actions">
                <div class="fqr-section-head">
                    <h2 id="fqr-actions-heading">Recommended actions</h2>
                    @if (themes.Count > 0)
                    {
                        <p class="fqr-section-note" data-testid="fqr-actions-priorities">@FrontendQualityPostRunPresentation.ActionPriorities(themes)</p>
                    }
                </div>
                @if (themes.Count == 0)
                {
                    <p class="fqr-muted">No remediation was recommended by the evidence this review collected.</p>
                }
                else
                {
                    <ol class="fqr-action-list" data-testid="fqr-action-list">
                        @foreach (var theme in themes.Take(FrontendQualityPostRunPresentation.ActionCount))
                        {
                            <li data-testid="fqr-action" data-priority="@theme.Priority"><span class="fqr-action-title">@theme.Title</span> <span class="fqr-muted">— @theme.ScaleLabel</span></li>
                        }
                    </ol>
                    @if (themes.Count > FrontendQualityPostRunPresentation.ActionCount)
                    {
                        <button type="button" class="btn-secondary fa-btn-sm" data-testid="fqr-actions-more" @onclick="() => SelectTab(FrontendQualityResultTab.Issues)">View all @themes.Count recommendations</button>
                    }
                }
            </section>

            <div class="fqr-summary-nav" data-testid="fqr-summary-nav">
                <button type="button" class="btn-secondary" data-testid="fqr-review-issues" @onclick="() => SelectTab(FrontendQualityResultTab.Issues)">Review issues</button>
                <button type="button" class="btn-secondary" data-testid="fqr-review-coverage" @onclick="() => SelectTab(FrontendQualityResultTab.Coverage)">Review coverage</button>
            </div>
        </div>

        @* ── Issues: canonical logical issues, once each, then the remediation they share ─────────────────────────────────────────── *@
        <div role="tabpanel" id="fqr-tabpanel-issues" aria-labelledby="fqr-tab-issues" class="fqr-tabpanel" tabindex="0"
             hidden="@(_tab != FrontendQualityResultTab.Issues)" data-testid="fqr-tabpanel-issues">
            <section class="fqr-section" aria-labelledby="fqr-issues-heading" data-testid="fqr-all-logical-issues">
                <div class="fqr-section-head">
                    <h2 id="fqr-issues-heading">Logical issues (@actionableIssues.Count)</h2>
                    <p class="fqr-section-note">Distinct actionable problems. Source findings behind each are under View evidence and in Evidence.</p>
                </div>
                <div class="fqr-findings-toolbar" role="group" aria-label="Filter logical issues">
                    <input type="search" class="form-control fqr-search" placeholder="Search issues..." aria-label="Search issues"
                           value="@_issueSearch" @oninput="e => _issueSearch = e.Value?.ToString() ?? string.Empty" data-testid="fqr-issue-search" />
                    <select class="form-control fqr-select" @bind="_issueSeverity" aria-label="Filter issues by severity" data-testid="fqr-issue-filter-severity">
                        <option value="">All severities</option>
                        @foreach (var sev in Enum.GetValues<FrontendQualitySeverity>())
                        {
                            <option value="@sev.ToString()">@sev</option>
                        }
                    </select>
                    <select class="form-control fqr-select" @bind="_issueDomain" aria-label="Filter issues by domain" data-testid="fqr-issue-filter-domain">
                        <option value="">All domains</option>
                        @foreach (var cat in Enum.GetValues<FrontendQualityCategory>())
                        {
                            <option value="@cat.ToString()">@CategoryLabel(cat)</option>
                        }
                    </select>
                    <select class="form-control fqr-select" @bind="_issueImpact" aria-label="Filter issues by release impact" data-testid="fqr-issue-filter-impact">
                        <option value="">Any release impact</option>
                        <option value="@FrontendQualityReleaseImpact.Blocking">@FrontendQualityPostRunPresentation.IssueImpactLabel(FrontendQualityReleaseImpact.Blocking)</option>
                        <option value="@FrontendQualityReleaseImpact.NonBlocking">@FrontendQualityPostRunPresentation.IssueImpactLabel(FrontendQualityReleaseImpact.NonBlocking)</option>
                    </select>
                    @if (IssueFiltersActive)
                    {
                        <button type="button" class="btn-secondary" @onclick="ClearIssueFilters">Clear</button>
                    }
                </div>
                @if (actionableIssues.Count > 0 && visibleIssues.Count == 0)
                {
                    <div class="fqr-empty-panel" data-testid="fqr-issues-filtered-empty">No logical issues match the current filter.</div>
                }
                else
                {
                    <FrontendQualityLogicalIssues Issues="visibleIssues" ImpactOf="issue => FrontendQualityPostRunPresentation.IssueImpact(report, issue)" />
                }
            </section>

            <section class="fqr-section" aria-labelledby="fqr-recommendations-heading" data-testid="fqr-recommendation-themes">
                <div class="fqr-section-head">
                    <h2 id="fqr-recommendations-heading">Recommendations</h2>
                    <p class="fqr-section-note">One entry per remediation; it names the issues it resolves rather than repeating them.</p>
                </div>
                <FrontendQualityRecommendations Themes="themes" />
            </section>

            @if (result.Accessibility is { RequireManualAssessment: > 0 } || report.ManualReviewItems.Count > 0)
            {
                <section class="fqr-section" aria-labelledby="fqr-manual-heading" data-testid="fqr-manual-followup">
                    <div class="fqr-section-head">
                        <h2 id="fqr-manual-heading">Manual follow-up</h2>
                    </div>
                    @if (result.Accessibility is { RequireManualAssessment: > 0 } mandatory)
                    {
                        <div class="fqr-manual-block" data-testid="fqr-manual-mandatory">
                            <h3>Mandatory manual assessment</h3>
                            <p>
                                <strong>Accessibility.</strong> @mandatory.RequireManualAssessment of
                                @mandatory.CriteriaInScope criteria in @mandatory.ProfileLabel require a person to assess them.
                                This is what those criteria require; it is not a gap in the automated coverage.
                            </p>
                        </div>
                    }
                    @if (report.ManualReviewItems.Count > 0)
                    {
                        <div class="fqr-manual-block" data-testid="fqr-manual-recommended">
                            <h3>Recommended human verification</h3>
                            <ReviewDisclosure Text="@($"View {report.ManualReviewItems.Count} verification item{(report.ManualReviewItems.Count == 1 ? "" : "s")}")"
                                              CollapseText="Hide verification items" Class="disclosure-inline" TestId="fqr-manual-items">
                                <ul class="fqr-manual-list" data-testid="fqr-manual-item-list">
                                    @foreach (var item in report.ManualReviewItems)
                                    {
                                        <li data-testid="fqr-manual-item">
                                            <strong>@item.Title</strong> — @item.Reason
                                            <span class="fqr-muted">(@item.Source)</span>
                                        </li>
                                    }
                                </ul>
                            </ReviewDisclosure>
                        </div>
                    }
                </section>
            }
        </div>

        @* ── Coverage: review scope, engine coverage, assessment domains and target access — each once ────────────────────────────── *@
        <div role="tabpanel" id="fqr-tabpanel-coverage" aria-labelledby="fqr-tab-coverage" class="fqr-tabpanel" tabindex="0"
             hidden="@(_tab != FrontendQualityResultTab.Coverage)" data-testid="fqr-tabpanel-coverage">
            <section class="fqr-section" aria-labelledby="fqr-scope-heading" data-testid="fqr-access-coverage">
                <h2 id="fqr-scope-heading">Review scope</h2>
                <p data-testid="fqr-review-scope">@ReviewScopeLabel(report)</p>
                @if (FrontendQualityPostRunPresentation.SurfaceStatuses(report) is { Count: > 0 } surfaces)
                {
                    <dl class="fqr-surface-list" data-testid="fqr-surface-list">
                        @foreach (var surface in surfaces)
                        {
                            <div data-testid="fqr-coverage-surface" data-surface="@surface.Surface">
                                <dt>@surface.Label surface</dt>
                                <dd><strong>@surface.Status</strong>@if (surface.Detail is { Length: > 0 } detail) {<span class="fqr-muted"> — @detail</span>}</dd>
                            </div>
                        }
                    </dl>
                }
            </section>

            <section class="fqr-section" aria-labelledby="fqr-engine-coverage-heading" data-testid="fqr-engine-coverage-section">
                <div class="fqr-section-head">
                    <h2 id="fqr-engine-coverage-heading">Engine coverage</h2>
                    @if (result.Completeness is { } completeness)
                    {
                        <p class="fqr-section-note" data-testid="fqr-engine-coverage-counts">
                            Required: @FrontendQualityPostRunPresentation.CoverageCount(completeness.RequiredAssessed, completeness.RequiredTotal) · @FrontendQualityPostRunPresentation.RequiredMeaning(completeness).
                            Optional: @FrontendQualityPostRunPresentation.CoverageCount(completeness.OptionalAssessed, completeness.OptionalTotal) · @FrontendQualityPostRunPresentation.OptionalMeaning(completeness).
                        </p>
                    }
                </div>
                <FrontendQualityEngineCoverageTable Rows="FrontendQualityPostRunPresentation.EngineRows(report)" />
                <ReviewDisclosure Text="View engine diagnostics" CollapseText="Hide engine diagnostics"
                                  Hint="@EngineCoverageHint(report, result)" TestId="fqr-engine-coverage" Class="fqr-detail-disclosure">
                    <FrontendQualityDecisionSupport Report="report" />
                </ReviewDisclosure>
            </section>

            <section class="fqr-section" aria-labelledby="fqr-domains-heading" data-testid="fqr-domain-results">
                <div class="fqr-section-head">
                    <h2 id="fqr-domains-heading">Assessment domains</h2>
                    <p class="fqr-section-note">Each domain's result in one card. Its issues are in Issues, its source findings in Evidence.</p>
                </div>
                <div class="fqr-domain-grid">
                    @foreach (var domain in result.Domains.Where(d => !d.Derived))
                    {
                        @if (domain.Category == FrontendQualityCategory.Accessibility)
                        {
                            <FrontendQualityDomainResultSection Result="domain" Scope="@AccessibilityScope(result)" DetailsText="View all criteria detail">
                                <Notice>
                                    @* The result keeps the profile it ran under; a later selection asks for a new run, it never relabels this one. *@
                                    @if (result.ProfileDrift is { } drift)
                                    {
                                        <div class="wsr-banner wsr-banner-warn fqr-profile-drift" role="status" data-testid="fqr-profile-drift">
                                            <span aria-hidden="true">⚠</span> @drift
                                        </div>
                                    }
                                    @if (result.Accessibility is { } accessibility)
                                    {
                                        <FrontendQualityAccessibilitySummary Result="accessibility" />
                                    }
                                </Notice>
                                <ChildContent>
                                    @if (report.Wcag is { } wcag)
                                    {
                                        <WcagWorkspace ProfileId="@(_context?.ActiveProfile.Id ?? "")" Snapshot="@WcagSnapshot" Result="wcag"
                                                       InitiallyExpanded="false" ProfileChanged="OnResultProfileChanged" />
                                    }
                                </ChildContent>
                            </FrontendQualityDomainResultSection>
                        }
                        else
                        {
                            <FrontendQualityDomainResultSection Result="domain">
                                @if (domain.LogicalIssueCount is > 0)
                                {
                                    <button type="button" class="btn-secondary fa-btn-sm" data-testid="fqr-domain-review-issues" data-category="@domain.Category"
                                            @onclick="() => ReviewDomainIssues(domain.Category)">Review @domain.Title.ToLowerInvariant() issues</button>
                                }
                            </FrontendQualityDomainResultSection>
                        }
                    }
                </div>
                @* QA Readiness draws conclusions from the other domains' evidence; no engine of its own ran, so it is not one of them. *@
                @if (result.Domains.Where(d => d.Derived).ToList() is { Count: > 0 } derivedDomains)
                {
                    <div class="fqr-derived-assessment" data-testid="fqr-derived-assessment">
                        <h3>Derived assessment</h3>
                        <p class="fqr-section-note">Derived from evidence in the domains above. No dedicated engine ran.</p>
                        @foreach (var domain in derivedDomains)
                        {
                            <FrontendQualityDomainResultSection Result="domain" />
                        }
                    </div>
                }
            </section>

            <section class="fqr-section" aria-labelledby="fqr-access-heading" data-testid="fqr-result-technical">
                <h2 id="fqr-access-heading">Target access</h2>
                @if (report.TargetAccess is { } access)
                {
                    <FrontendQualityTargetAccessPanel Access="access" ShowActions="false" Executed="FrontendQualityReviewScopes.Executed(report)" />
                }
                @if (report.ExecutionPlan is { Capabilities.Count: > 0 } plan)
                {
                    <ReviewDisclosure Text="View technical access details" CollapseText="Hide technical access details"
                                      Hint="Capabilities resolved for this run, per surface" TestId="fqr-access-capabilities" Class="disclosure-inline">
                        <dl class="fqr-technical-list-grid" data-testid="fqr-access-capability-list">
                            @foreach (var capability in plan.Capabilities)
                            {
                                <div data-testid="fqr-access-capability" data-kind="@capability.Kind">
                                    <dt>@FrontendQualityExecutionPlanner.CapabilityLabel(capability.Kind)</dt>
                                    <dd>@CapabilityStateLabel(capability.State)@if (capability.Provider is { Length: > 0 } provider) {<span> · @provider</span>}@if (capability.Reason is { Length: > 0 } reason) {<span class="fqr-muted"> — @reason</span>}</dd>
                                </div>
                            }
                        </dl>
                        @if (report.ActiveEngines is { } engines)
                        {
                            <FrontendQualityActiveEnginesPanel Snapshot="engines" />
                        }
                    </ReviewDisclosure>
                }
                else if (report.ActiveEngines is { } engines)
                {
                    <FrontendQualityActiveEnginesPanel Snapshot="engines" />
                }
            </section>
        </div>

        @* ── Evidence: what the engines observed, for audit ───────────────────────────────────────────────────────────────────────── *@
        <div role="tabpanel" id="fqr-tabpanel-evidence" aria-labelledby="fqr-tab-evidence" class="fqr-tabpanel" tabindex="0"
             hidden="@(_tab != FrontendQualityResultTab.Evidence)" data-testid="fqr-tabpanel-evidence">
            <section class="fqr-section fqr-details" aria-labelledby="fqr-result-details-heading" data-testid="fqr-result-details">
                <div class="fqr-section-head">
                    <h2 id="fqr-result-details-heading">Source findings</h2>
                    <p class="fqr-section-note">@SourceFindingsHint(result). Each source finding names the logical issue it was grouped into.</p>
                </div>
                <div data-testid="fqr-all-findings">
                    <div class="fqr-findings-toolbar" role="group" aria-label="Filter source findings">
                        <input type="search"
                               class="form-control fqr-search"
                               placeholder="Search findings..."
                               aria-label="Search findings"
                               value="@_findingSearch"
                               @oninput="e => _findingSearch = e.Value?.ToString() ?? string.Empty" />

                        <select class="form-control fqr-select" @bind="_severityFilterValue" @bind:after="ApplySeverityFilter" aria-label="Filter by severity">
                            <option value="">All severities</option>
                            @foreach (var sev in Enum.GetValues<FrontendQualitySeverity>())
                            {
                                <option value="@sev.ToString()">@sev</option>
                            }
                        </select>

                        <select class="form-control fqr-select" @bind="_categoryFilterValue" @bind:after="ApplyCategoryFilter" aria-label="Filter by category">
                            <option value="">All categories</option>
                            @foreach (var cat in Enum.GetValues<FrontendQualityCategory>())
                            {
                                <option value="@cat.ToString()">@CategoryLabel(cat)</option>
                            }
                        </select>

                        @if (_sevFilter is not null || _catFilter is not null || !string.IsNullOrWhiteSpace(_findingSearch))
                        {
                            <button type="button" class="btn-secondary" @onclick="ClearFilters">Clear</button>
                        }
                    </div>

                    @if (filtered.Count == 0)
                    {
                        <div class="fqr-empty-panel">No findings match the current filter.</div>
                    }
                    else
                    {
                        <div class="fqr-table-wrap">
                            <table class="fqr-findings-table fqr-source-findings-table">
                                <thead>
                                    <tr>
                                        <th scope="col"><button type="button" @onclick='() => SortBy("severity")'>Severity @SortGlyph("severity")</button></th>
                                        <th scope="col"><button type="button" @onclick='() => SortBy("category")'>Domain @SortGlyph("category")</button></th>
                                        <th scope="col"><button type="button" @onclick='() => SortBy("title")'>Finding @SortGlyph("title")</button></th>
                                        <th scope="col">Grouped into</th>
                                        <th scope="col">Recommendation</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var finding in filtered)
                                    {
                                        <tr data-origin="@finding.Origin" data-testid="fqr-source-finding">
                                            <td data-label="Severity"><span class="fqr-severity fqr-severity-@finding.Severity.ToString().ToLowerInvariant()">@finding.Severity</span></td>
                                            <td data-label="Domain">@CategoryLabel(finding.Category)</td>
                                            <td data-label="Finding">
                                                <strong>@finding.Title</strong>
                                                @if (!string.IsNullOrWhiteSpace(finding.SourceSystem))
                                                {
                                                    <span class="fqr-source">@finding.SourceSystem</span>
                                                }
                                                @if (finding.Origin == FrontendQualityFindingOrigin.Derived)
                                                {
                                                    <span class="fqr-pill fqr-pill-muted" data-testid="fqr-finding-derived">Derived</span>
                                                }
                                                <span class="fqr-finding-desc">@finding.Description</span>
                                            </td>
                                            <td data-label="Grouped into" data-testid="fqr-finding-grouped-into">@(FrontendQualityPostRunPresentation.IssueFor(groupedInto, finding)?.CanonicalTitle ?? "—")</td>
                                            <td data-label="Recommendation">@finding.Recommendation</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </section>

            @if (result.DerivedIssues.Count > 0 || result.InformationalIssues.Count > 0)
            {
                <section class="fqr-section" aria-labelledby="fqr-other-items-heading" data-testid="fqr-other-items">
                    <div class="fqr-section-head">
                        <h2 id="fqr-other-items-heading">Derived indicators and observations</h2>
                        <p class="fqr-section-note">Not logical issues: conclusions drawn from evidence reported elsewhere, and observations that ask for nothing.</p>
                    </div>
                    @if (result.DerivedIssues is { Count: > 0 } derivedIssues)
                    {
                        <h3 class="fqr-review-items-heading" data-testid="fqr-review-items-derived">Derived indicators (@result.DerivedIndicatorCount)</h3>
                        <FrontendQualityLogicalIssues Issues="derivedIssues" />
                    }
                    @if (result.InformationalIssues is { Count: > 0 } informational)
                    {
                        <h3 class="fqr-review-items-heading" data-testid="fqr-review-items-informational">Informational observations (@informational.Count)</h3>
                        <FrontendQualityLogicalIssues Issues="informational" />
                    }
                </section>
            }

            <section class="fqr-section" aria-labelledby="fqr-engine-evidence-heading" data-testid="fqr-detailed-evidence">
                <h2 id="fqr-engine-evidence-heading">Detailed engine evidence</h2>
                <ReviewDisclosure Text="Cookie security" CollapseText="Hide cookie security" Hint="@CookieHint(report)" TestId="fqr-cookie-security" Class="fqr-detail-disclosure">
                    <CookieSecuritySection Assessment="report.CookieSecurity" ProfileId="@_context?.ActiveProfile.Id" Expectations="@_context?.SecuritySettings.RuntimeSecurity?.Cookies" />
                </ReviewDisclosure>

                <ReviewDisclosure Text="Shared quality evidence" CollapseText="Hide shared quality evidence" Hint="Evidence by kind · security controls deduplicated with API Quality Review"
                                  TestId="fqr-quality-evidence" Class="fqr-detail-disclosure" @bind-Expanded="_qualityEvidenceExpanded">
                    @if (_qualityEvidenceExpanded) { <QualityEvidenceSummary ProfileId="@(_context?.ActiveProfile.Id ?? "")" FrontendReport="report" /> }
                </ReviewDisclosure>

                <ReviewDisclosure Text="Technical details" CollapseText="Hide technical details"
                                  Hint="Execution, scope, limitations, engine scores and raw evidence" TestId="fqr-result-diagnostics" Class="fqr-detail-disclosure">
                    <div class="fqr-technical" data-testid="fqr-technical">
                        <section class="fqr-technical-block" aria-labelledby="fqr-tech-execution">
                            <h3 id="fqr-tech-execution">Execution</h3>
                            <dl class="fqr-technical-list-grid" data-testid="fqr-technical-execution">
                                <div><dt>Target URL (requested)</dt><dd>@report.TargetUrl</dd></div>
                                @if (!string.IsNullOrWhiteSpace(report.FinalUrl) && report.FinalUrl != report.TargetUrl)
                                {
                                    <div><dt>Target URL (final)</dt><dd>@report.FinalUrl</dd></div>
                                    @if (report.RedirectOccurred)
                                    {
                                        <div><dt>Redirect occurred</dt><dd>Yes</dd></div>
                                    }
                                }
                                <div><dt>Generated</dt><dd>@report.GeneratedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd></div>
                                @if (report.CompletedAt.HasValue && report.DurationMs.HasValue)
                                {
                                    <div><dt>Completed</dt><dd>@report.CompletedAt.Value.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd></div>
                                    <div><dt>Duration</dt><dd>@(report.DurationMs.Value / 1000.0)s</dd></div>
                                }
                                <div><dt>Application</dt><dd>@(report.IsBlazorWasm ? "Blazor WASM detected" : "Blazor WASM not detected")</dd></div>
                                @if (!string.IsNullOrWhiteSpace(report.ErrorMessage))
                                {
                                    <div><dt>Error</dt><dd>@report.ErrorMessage</dd></div>
                                }
                            </dl>
                        </section>

                        @if (result.Completeness is { } completeness)
                        {
                            <section class="fqr-technical-block" aria-labelledby="fqr-tech-coverage">
                                <h3 id="fqr-tech-coverage">Raw counts</h3>
                                <dl class="fqr-technical-list-grid" data-testid="fqr-technical-coverage">
                                    <div><dt>Execution</dt><dd>@completeness.ExecutionLabel</dd></div>
                                    <div><dt>Required coverage</dt><dd>@completeness.RequiredCoverageLabel (@completeness.RequiredAssessed of @completeness.RequiredTotal)</dd></div>
                                    <div><dt>Optional coverage</dt><dd>@completeness.OptionalCoverageLabel (@completeness.OptionalAssessed of @completeness.OptionalTotal)</dd></div>
                                    <div><dt>Manual assessment</dt><dd>@completeness.ManualAssessmentLabel</dd></div>
                                    @if (report.AssessedEngines.Count > 0)
                                    {
                                        <div><dt>Assessed engines</dt><dd>@string.Join(", ", report.AssessedEngines.Select(FrontendQualityActiveEngines.CurrentLabel))</dd></div>
                                    }
                                    @if (report.SkippedEngines.Count > 0)
                                    {
                                        <div><dt>Skipped engines</dt><dd>@string.Join(", ", report.SkippedEngines.Select(FrontendQualityActiveEngines.CurrentLabel))</dd></div>
                                    }
                                    @if (report.FailedEngines.Count > 0)
                                    {
                                        <div><dt>Failed engines</dt><dd>@string.Join(", ", report.FailedEngines)</dd></div>
                                    }
                                </dl>
                            </section>
                        }

                        @if (report.CoveragePasses.Count > 0)
                        {
                            <section class="fqr-technical-block" aria-labelledby="fqr-tech-passes" data-testid="fqr-technical-passes">
                                <h3 id="fqr-tech-passes">Coverage passes</h3>
                                <dl class="fqr-technical-list-grid">
                                    @foreach (var pass in report.CoveragePasses)
                                    {
                                        <div>
                                            <dt>@(pass.Mode == FrontendReviewAccessScope.PublicOnly ? "Public pass" : "Authenticated pass")</dt>
                                            <dd>
                                                @FrontendQualityReviewScopes.PassStatus(pass)
                                                <ul class="fqr-pass-engines">
                                                    @foreach (var outcome in pass.Report.EngineOutcomes.Where(o => o.Enabled && o.ExecutionState != FrontendQualityEngineExecutionState.Disabled))
                                                    {
                                                        <li>@FrontendQualityActiveEngines.DisplayName(outcome.EngineId): @FrontendQualityEngineOutcomePresentation.StateLabel(outcome) — @outcome.AccessLabel</li>
                                                    }
                                                </ul>
                                            </dd>
                                        </div>
                                    }
                                </dl>
                            </section>
                        }

                        <section class="fqr-technical-block" aria-labelledby="fqr-tech-scope">
                            <h3 id="fqr-tech-scope">Scope</h3>
                            <p>This review combines the configured static, passive and real-browser engines shown in Coverage. It does not establish:</p>
                            <ul>
                                <li>Active vulnerability scanning or penetration testing</li>
                                <li>WCAG conformance or completion of manual accessibility assessment</li>
                                <li>Production field Core Web Vitals or field INP</li>
                                <li>End-to-end user flow validation</li>
                            </ul>
                        </section>

                        @if (FrontendQualityResultPresentation.MethodLimitations(report) is { Count: > 0 } limitations)
                        {
                            <section class="fqr-technical-block" aria-labelledby="fqr-tech-limits">
                                <h3 id="fqr-tech-limits">Review limitations</h3>
                                <ul data-testid="fqr-technical-limitations">@foreach (var limitation in limitations) { <li>@limitation</li> }</ul>
                            </section>
                        }

                        @* Scores are per-engine numbers on different scales; none of them is the review's result. *@
                        <section class="fqr-technical-block" aria-labelledby="fqr-tech-scores" data-testid="fqr-engine-scores">
                            <h3 id="fqr-tech-scores">Engine scores</h3>
                            <p class="fqr-muted">Per-source scores; not comparable and not a review result.</p>
                            <FrontendQualityEngineScores Report="report" />
                        </section>

                        @if (evidenceRecords.Count > 0)
                        {
                            <section class="fqr-technical-block" aria-labelledby="fqr-tech-evidence" data-testid="fqr-technical-raw">
                                <h3 id="fqr-tech-evidence">Raw evidence</h3>
                                <p class="fqr-muted" data-testid="fqr-technical-raw-count">@evidenceRecords.Count distinct evidence record@(evidenceRecords.Count == 1 ? "" : "s")</p>
                                <button type="button" class="btn-secondary fqr-raw-toggle" data-testid="fqr-technical-raw-toggle"
                                        aria-expanded="@(_rawEvidenceOpen ? "true" : "false")" aria-controls="fqr-technical-evidence-list"
                                        @onclick="() => _rawEvidenceOpen = !_rawEvidenceOpen">@(_rawEvidenceOpen ? "Hide raw evidence" : "View raw evidence")</button>
                                @if (_rawEvidenceOpen)
                                {
                                    <ul class="fqr-technical-evidence-list" id="fqr-technical-evidence-list" data-testid="fqr-technical-evidence">
                                        @foreach (var record in evidenceRecords)
                                        {
                                            <li>
                                                <code>@record.Value</code>
                                                <span class="fqr-muted">@record.Sources</span>
                                            </li>
                                        }
                                    </ul>
                                }
                            </section>
                        }
                    </div>
                </ReviewDisclosure>
            </section>
        </div>

        @* ── History: previous runs for this Target Environment, each opened exactly as stored ─────────────────────────────────────── *@
        <div role="tabpanel" id="fqr-tabpanel-history" aria-labelledby="fqr-tab-history" class="fqr-tabpanel" tabindex="0"
             hidden="@(_tab != FrontendQualityResultTab.History)" data-testid="fqr-tabpanel-history">
            <section class="fqr-section" aria-labelledby="fqr-history-heading" data-testid="fqr-history">
                <div class="fqr-section-head">
                    <h2 id="fqr-history-heading">Previous runs</h2>
                    <p class="fqr-section-note">The last @FrontendQualityReviewHistory.MaxRuns runs for this Target Environment, stored in this browser. Opening one shows its result as it completed.</p>
                </div>
                @if (HistoryRuns.Count == 0)
                {
                    <p class="fqr-muted" data-testid="fqr-history-empty">No previous run is stored for this Target Environment.</p>
                }
                else
                {
                    <ul class="fqr-history-list" data-testid="fqr-history-list">
                        @foreach (var run in HistoryRuns)
                        {
                            var current = ReferenceEquals(run.Report, report);
                            <li class="fqr-history-run @(current ? "fqr-history-current" : "")" data-testid="fqr-history-run" data-run-id="@run.Id">
                                <span class="fqr-history-time" data-testid="fqr-history-time">@run.CompletedAt.ToString("yyyy-MM-dd HH:mm") UTC</span>
                                <span data-testid="fqr-history-scope">@(run.Scope is { } scope ? FrontendQualityReviewScopes.Label(scope) : "Scope not recorded")</span>
                                <span data-testid="fqr-history-decision"><strong>@FrontendQualityReviewHistory.DispositionLabel(run.Disposition)</strong></span>
                                <span data-testid="fqr-history-issues">@run.IssueCount issue@(run.IssueCount == 1 ? "" : "s")</span>
                                <span data-testid="fqr-history-required">@run.RequiredAssessed/@run.RequiredTotal required</span>
                                @if (current)
                                {
                                    <span class="fqr-pill fqr-pill-muted" data-testid="fqr-history-showing">Showing</span>
                                }
                                else
                                {
                                    <button type="button" class="btn-secondary fa-btn-sm" data-testid="fqr-history-open" @onclick="() => OpenHistoryRun(run)"
                                            aria-label="@($"Open run from {run.CompletedAt:yyyy-MM-dd HH:mm}")">Open run</button>
                                }
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>
    }

</div>

@code {
    /// <summary>One distinct evidence record and every finding that cited it — the same record, listed once.</summary>
    private sealed record EvidenceRecord(string Value, string Sources);

    /// <summary>Landing-view projection built once per render from the authoritative state held by this page.</summary>
    private sealed record LandingView(
        FrontendQualityTargetSummaryModel Target,
        FrontendQualityReviewReadiness Readiness,
        IReadOnlyList<FrontendQualityCapabilityRow> Capabilities,
        IReadOnlyList<FrontendQualityDimensionCard> Dimensions,
        IReadOnlyList<FrontendQualityTechnicalField> TechnicalFields,
        FrontendQualityAuthenticatedReviewModel? AuthenticatedReview,
        FrontendQualityReviewScope? Scope = null);

    private const string TargetEnvironmentsHref = FrontendQualityTargetAccess.TargetEnvironmentsHref;

    private FrontendQualityEngineStatusReportDto? _engineStatus;
    /// <summary>Browser Companion runtime (optional service): compact status for the Browser Quality engine on the landing view.</summary>
    private BrowserCompanionRuntime? _companionRuntime;
    private bool ProxyRunningForLanding =>
        (ServiceProvider.GetService(typeof(LocalHttpsProxyRuntime)) as LocalHttpsProxyRuntime)?.Status.State
            is LocalHttpsProxyState.Listening or LocalHttpsProxyState.WaitingForAuthenticatedTraffic or LocalHttpsProxyState.AuthenticatedTrafficDetected or LocalHttpsProxyState.Ready;
    /// <summary>Engines active for the next review, resolved from the saved configuration of the active Target Environment.</summary>
    private FrontendQualityActiveEngineSnapshot? _activeEngines;
    /// <summary>Layer 1–3 status is being fetched for the ACTIVE backend engines only; null when no backend engine is active.</summary>
    private Task? _engineStatusTask;
    private bool _engineStatusPending;
    /// <summary>Review access and Engines start open; every other Review details section starts collapsed.</summary>
    private bool _accessExpanded = true;
    private bool _enginesExpanded = true;
    /// <summary>Layer 3 readiness probes for the active backend engines are in flight (informational; Run does not wait).</summary>
    private bool _readinessPending;
    private IReadOnlyList<FrontendQualityEngineIdDto> ActiveBackendEngineIds =>
        _activeEngines is null ? []
        : FrontendQualityActiveEngines.BackendEngineIds.Where(pair => _activeEngines.IsActive(pair.Key)).Select(pair => pair.Value).ToList();
    private string EngineStatusPendingText => $"Checking {ActiveBackendEngineIds.Count} active engine{(ActiveBackendEngineIds.Count == 1 ? "" : "s")}…";
    private string RunButtonText => _running ? "Analysing..."
        : _engineStatusPending ? EngineStatusPendingText
        : "Run Frontend Quality Review";
    private bool _deliveryExpanded, _qualityEvidenceExpanded;
    private bool RunDisabled => _running || _context is null || _context.ActiveTargetError is not null || !_context.HasTargetUrl
        || _activeEngines is not { HasActiveEngines: true } || _engineStatusPending;
    /// <summary>Human-readable reason shown next to a disabled Run button. Mirrors <see cref="RunDisabled"/>; never a technical code.</summary>
