    private FrontendQualityResultTab _tab = FrontendQualityResultTab.Summary;
    private readonly Dictionary<FrontendQualityResultTab, ElementReference> _tabRefs = new();

    private void SelectTab(FrontendQualityResultTab tab) => _tab = tab;

    /// <summary>WAI-ARIA tabs: arrow keys, Home and End move between views and move focus with them.</summary>
    private async Task OnTabKey(KeyboardEventArgs e, FrontendQualityResultTab current)
    {
        var tabs = FrontendQualityPostRunPresentation.Tabs;
        var index = tabs.ToList().IndexOf(current);
        var next = e.Key switch
        {
            "ArrowRight" => tabs[(index + 1) % tabs.Count],
            "ArrowLeft" => tabs[(index - 1 + tabs.Count) % tabs.Count],
            "Home" => tabs[0],
            "End" => tabs[^1],
            _ => current,
        };
        if (next == current) return;
        _tab = next;
        StateHasChanged();
        if (_tabRefs.TryGetValue(next, out var element))
            try { await element.FocusAsync(); } catch (Exception ex) when (ex is JSException or InvalidOperationException) { }
    }

