@page "/frontend-quality-review"
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@inject WasmSecurityApiService Scanner
@inject IBlazorWasmPerformanceReviewService PerfService
@inject IFrontendQualityReviewService QualityService
@inject IFrontendAnalysisContextFactory ContextFactory
@inject RuntimeReviewSessionService RuntimeReviews
@inject IWorkspaceSessionService Workspace
@inject IReportExportService ExportService
@inject IJSRuntime JS

<PageTitle>Frontend Quality Review</PageTitle>

<div class="wsr-page">

    <PageHeader Title="Frontend Quality Review"
                Description="Analyse a deployed frontend for performance, security, accessibility, standards compliance, Blazor WASM-specific checks, and QA readiness in a single unified review." />

    @* ── Review Target card ────────────────────────────────────────────────────── *@
    <div class="wsr-target-card">
        <div class="wsr-target-header">
            <h2 class="wsr-target-title">Review Target</h2>
            <div class="wsr-target-actions">
                <a href="/admin/system-settings" class="btn-secondary wsr-settings-btn">
                    Frontend Analysis Settings
                </a>
                @if (_report is not null)
                {
                    <SecondaryButton OnClick="RefreshContext">Refresh</SecondaryButton>
                }
                <PrimaryButton OnClick="RunReview"
                               Disabled="@(_running || _context is null || !_context.HasTargetUrl)"
                               aria-label="Run Frontend Quality Review">
                    @if (_running) { <span class="wsr-spinner" aria-hidden="true">⟳</span> }
                    @(_running ? "Analysing…" : "Run Frontend Quality Review")
                </PrimaryButton>
            </div>
        </div>

        @if (_context is not null)
        {
            <div class="wsr-target-grid">
                <div class="wsr-target-item">
                    <span class="wsr-target-label">Profile</span>
                    <div class="wsr-target-value">
                        <span class="wsr-env-badge wsr-env-@(_context.ActiveProfile.EnvironmentType.ToString().ToLowerInvariant())">
                            @_context.ActiveProfile.EnvironmentType
                        </span>
                        <span class="wsr-target-profile-name">@_context.ActiveProfile.Name</span>
                    </div>
                </div>
                <div class="wsr-target-item">
                    <span class="wsr-target-label">Target URL</span>
                    <div class="wsr-target-value">
                        @if (_context.HasTargetUrl)
                        {
                            <code class="wsr-target-url">@_context.TargetUrl</code>
                        }
                        else
                        {
                            <span class="wsr-target-missing">Not configured — <a href="/admin/system-settings">open settings</a></span>
                        }
                    </div>
                </div>
                <div class="wsr-target-item">
                    <span class="wsr-target-label">Authentication</span>
                    <div class="wsr-target-value">
                        <span>@_context.AuthenticationType</span>
                        @if (_context.RequiresAuthentication)
                        { <span class="wsr-auth-tag">Required</span> }
                    </div>
                </div>
                <div class="wsr-target-item">
                    <span class="wsr-target-label">Auth Status</span>
                    <div class="wsr-target-value">
                        <StatusChip Status="@(_context.IsAuthenticatedSessionAvailable ? "healthy" : _context.RequiresAuthentication ? "warning" : "neutral")"
                                    Label="@(_context.IsAuthenticatedSessionAvailable ? "Authenticated" : _context.RequiresAuthentication ? "Session unavailable" : "Not required")" />
                    </div>
                </div>
                @if (_report is not null)
                {
                    <div class="wsr-target-item">
                        <span class="wsr-target-label">Application</span>
                        <div class="wsr-target-value">
                            @if (_report.IsBlazorWasm)
                            { <span class="wsr-detect-badge wsr-detect-blazor">Blazor WASM</span> }
                            else
                            { <span class="wsr-detect-none">Not Blazor WASM</span> }
                        </div>
                    </div>
                    <div class="wsr-target-item">
                        <span class="wsr-target-label">Last Review</span>
                        <div class="wsr-target-value">
                            <span class="wsr-scan-time">@_report.GeneratedAt.ToString("yyyy-MM-dd HH:mm") UTC</span>
                        </div>
                    </div>
                }
            </div>

            @if (_running)
            {
                <p class="wsr-scan-progress" aria-live="polite">
                    @_progressMessage
                </p>
            }
            @if (_context.HasValidationErrors)
            {
                <div class="wsr-banner wsr-banner-error" role="alert">
                    <span aria-hidden="true">✗</span>
                    Profile has configuration errors: @string.Join(" | ", _context.ValidationErrors)
                </div>
            }
            @if (_context.HasValidationWarnings)
            {
                <div class="wsr-banner wsr-banner-warn" role="status">
                    <span aria-hidden="true">⚠</span>
                    @string.Join(" | ", _context.ValidationWarnings)
                </div>
            }
            @if (!_context.HasTargetUrl && !_running)
            {
                <div class="wsr-banner wsr-banner-warn" role="alert">
                    <span aria-hidden="true">⚠</span>
                    No target URL configured. <a href="/admin/system-settings">Open Frontend Analysis Settings</a> to set one.
                </div>
            }
        }
        else
        {
            <div class="wsr-banner wsr-banner-warn" role="status">
                <span aria-hidden="true">⚠</span>
                Loading frontend analysis profile…
            </div>
        }
    </div>

    @* ── Error banners ────────────────────────────────────────────────────────── *@
    @if (_secError is not null)
    {
        <div class="wsr-banner wsr-banner-warn wsr-banner-standalone" role="status">
            <span aria-hidden="true">⚠</span> Security scan: @_secError — security findings will be incomplete.
        </div>
    }
    @if (_perfError is not null)
    {
        <div class="wsr-banner wsr-banner-warn wsr-banner-standalone" role="status">
            <span aria-hidden="true">⚠</span> Performance scan: @_perfError — performance findings will be incomplete.
        </div>
    }

    @* ── Results ─────────────────────────────────────────────────────────────── *@
    @if (_report is not null)
    {
        var report = _report;

        <div style="display:flex;justify-content:flex-end;margin-bottom:.5rem">
            <button style="background:#1d4ed8;color:#fff;border:none;padding:.35rem .85rem;border-radius:5px;cursor:pointer;font-size:.78rem" @onclick="ExportHtml">Export HTML</button>
        </div>

        @* ── Overall score bar ────────────────────────────────────────────────── *@
        <div class="wsr-readiness-dashboard">
            <div class="wsr-readiness-card @ScoreClass(report.OverallScore)"
                 aria-label="Overall quality score: @report.OverallScore out of 100">
                <div class="wsr-readiness-left">
                    <div class="wsr-readiness-score">@report.OverallScore</div>
                    <div class="wsr-readiness-label">@QualityLabel(report.OverallScore)</div>
                    <div class="wsr-readiness-sub">out of 100</div>
                </div>
                <div class="wsr-readiness-counts" aria-label="Finding counts by severity">
                    @{ var critical = report.Findings.Count(f => f.Severity == FrontendQualitySeverity.Critical); }
                    @{ var high     = report.Findings.Count(f => f.Severity == FrontendQualitySeverity.High); }
                    @{ var medium   = report.Findings.Count(f => f.Severity == FrontendQualitySeverity.Medium); }
                    @{ var low      = report.Findings.Count(f => f.Severity == FrontendQualitySeverity.Low); }
                    @{ var info     = report.Findings.Count(f => f.Severity == FrontendQualitySeverity.Info); }
                    @if (critical > 0) { <div class="wsr-count-pill wsr-count-critical"><span class="wsr-count-value">@critical</span><span class="wsr-count-label">Critical</span></div> }
                    @if (high > 0)     { <div class="wsr-count-pill wsr-count-high"><span class="wsr-count-value">@high</span><span class="wsr-count-label">High</span></div> }
                    @if (medium > 0)   { <div class="wsr-count-pill wsr-count-medium"><span class="wsr-count-value">@medium</span><span class="wsr-count-label">Medium</span></div> }
                    @if (low > 0)      { <div class="wsr-count-pill wsr-count-low"><span class="wsr-count-value">@low</span><span class="wsr-count-label">Low</span></div> }
                    @if (info > 0)     { <div class="wsr-count-pill wsr-count-info"><span class="wsr-count-value">@info</span><span class="wsr-count-label">Info</span></div> }
                    @if (critical == 0 && high == 0 && medium == 0 && low == 0 && info == 0)
                    { <span class="wsr-all-clear">No findings — all checks passed</span> }
                </div>
            </div>
        </div>

        @* ── Domain Score Cards ───────────────────────────────────────────────── *@
        <SectionHeader Title="Domain Scores" />
        <div class="wsr-category-score-grid" role="list" aria-label="Quality domain scores">
            @foreach (var cs in report.CategoryScores)
            {
                var worstSeverity = report.Findings
                    .Where(f => f.Category == cs.Category && f.Severity != FrontendQualitySeverity.Info)
                    .Select(f => (FrontendQualitySeverity?)f.Severity)
                    .OrderBy(s => s)
                    .FirstOrDefault();

                <button class="wsr-cat-card @CatCardClass(worstSeverity, cs.Assessed)"
                        role="listitem"
                        @onclick='() => SetCategoryFilter(cs.Category)'
                        title="View @CategoryLabel(cs.Category) findings"
                        aria-label="@CategoryLabel(cs.Category): @(cs.Assessed ? cs.Score.ToString() : "not assessed")">
                    <div class="wsr-cat-name">@CategoryLabel(cs.Category)</div>
                    <div class="wsr-cat-score @(cs.Assessed ? "" : "wsr-cat-score-na")">
                        @(cs.Assessed ? cs.Score.ToString() : "—")
                    </div>
                    <div class="wsr-cat-status">@(cs.Assessed ? CatStatusLabel(worstSeverity) : "Not assessed")</div>
                    <div class="wsr-cat-findings">
                        @if (!cs.Assessed) { <span>Not assessed</span> }
                        else if (cs.FindingCount == 0) { <span>No issues</span> }
                        else { <span>@cs.FindingCount finding@(cs.FindingCount != 1 ? "s" : "")</span> }
                    </div>
                </button>
            }
        </div>

        @* ── Top Risks ────────────────────────────────────────────────────────── *@
        var topRisks = report.Findings
            .Where(f => f.Severity is FrontendQualitySeverity.Critical or FrontendQualitySeverity.High)
            .OrderBy(f => f.Severity)
            .Take(3)
            .ToList();
        @if (topRisks.Count > 0)
        {
            <SectionHeader Title="Top Risks" />
            <div class="issue-cards">
                @foreach (var risk in topRisks)
                {
                    <IssueCard Severity="@risk.Severity.ToString()"
                               Component="@CategoryLabel(risk.Category)"
                               Description="@(string.IsNullOrEmpty(risk.Description) ? risk.Title : $"{risk.Title} — {risk.Description}")"
                               SuggestedFix="@risk.Recommendation" />
                }
            </div>
        }

        @* ── Findings ─────────────────────────────────────────────────────────── *@
        <SectionHeader Title="Findings" />
        <div class="wsr-findings-toolbar" role="group" aria-label="Filter findings">
            <input type="search"
                   class="form-control wsr-search"
                   placeholder="Search findings…"
                   aria-label="Search findings"
                   value="@_findingSearch"
                   @oninput="e => _findingSearch = e.Value?.ToString() ?? string.Empty" />

            <div class="wsr-filter-chips">
                @foreach (var sev in Enum.GetValues<FrontendQualitySeverity>())
                {
                    var count = report.Findings.Count(f => f.Severity == sev);
                    if (count == 0) continue;
                    <button class="wsr-filter-chip wsr-filter-sev-@sev.ToString().ToLowerInvariant() @(_sevFilter == sev ? "is-active" : "")"
                            @onclick="() => ToggleSev(sev)"
                            aria-pressed="@(_sevFilter == sev)">
                        @sev <span class="wsr-chip-count">@count</span>
                    </button>
                }
                @if (_sevFilter is not null || _catFilter is not null || !string.IsNullOrEmpty(_findingSearch))
                {
                    <button class="wsr-filter-chip" @onclick="ClearFilters">Clear ×</button>
                }
            </div>

            <div class="wsr-filter-chips wsr-filter-chips-cat" aria-label="Filter by category">
                @foreach (var cat in Enum.GetValues<FrontendQualityCategory>())
                {
                    var count = report.Findings.Count(f => f.Category == cat);
                    if (count == 0) continue;
                    <button class="wsr-filter-chip @(_catFilter == cat ? "wsr-filter-cat-active" : "")"
                            @onclick="() => SetCategoryFilter(cat)"
                            aria-pressed="@(_catFilter == cat)">
                        @CategoryLabel(cat) <span class="wsr-chip-count">@count</span>
                    </button>
                }
            </div>
        </div>

        var filtered = FilteredFindings(report.Findings).ToList();
        @if (filtered.Count == 0)
        {
            <div class="wsr-empty-tab">No findings match the current filter.</div>
        }
        else
        {
            <section class="wsr-findings-list" aria-label="Quality findings">
                @foreach (var f in filtered)
                {
                    @FindingCard(f)
                }
            </section>
        }

        @* ── Recommendations ──────────────────────────────────────────────────── *@
        @if (report.Recommendations.Count > 0)
        {
            <SectionHeader Title="Recommendations" />
            <ol class="wsr-rec-list">
                @{ int rIdx = 0; }
                @foreach (var rec in report.Recommendations)
                {
                    rIdx++;
                    <li class="wsr-rec-item">
                        <div class="wsr-rec-num" aria-hidden="true">@rIdx</div>
                        <div class="wsr-rec-body">@rec</div>
                    </li>
                }
            </ol>
        }

        @* ── Limitations ──────────────────────────────────────────────────────── *@
        @if (report.Limitations.Count > 0)
        {
            <SectionHeader Title="Scanner Limitations" />
            <ul class="wsr-limitations-list">
                @foreach (var l in report.Limitations) { <li>@l</li> }
            </ul>
        }
    }
    else if (!_running)
    {
        @* ── Empty state ──────────────────────────────────────────────────────── *@
        <EmptyState Icon="🔍" Title="Ready to review"
                    Description="Run a Frontend Quality Review to analyse performance, security, accessibility, standards compliance, Blazor WASM specifics, and QA readiness for your deployed frontend.">
            <PrimaryButton OnClick="RunReview"
                           Disabled="@(_context is null || !_context?.HasTargetUrl == true)"
                           aria-label="Run Frontend Quality Review">
                Run Frontend Quality Review
            </PrimaryButton>
            @if (_context is not null && !_context.HasTargetUrl)
            {
                <p class="wsr-empty-note">
                    Configure a target URL in <a href="/admin/system-settings">Frontend Analysis Settings</a>.
                </p>
            }
        </EmptyState>
    }

</div>

@code {
    private FrontendAnalysisContext? _context;

    private bool    _running;
    private string  _progressMessage = "";
    private string? _secError;
    private string? _perfError;

    private FrontendQualityReviewReport? _report;

    private string?                _findingSearch;
    private FrontendQualitySeverity? _sevFilter;
    private FrontendQualityCategory? _catFilter;
    private readonly HashSet<string>  _expandedFindings = [];

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        _context = await ContextFactory.GetActiveContextAsync();
        _report  = RuntimeReviews.QualityReview.Report;
    }

    // ── Actions ───────────────────────────────────────────────────────────────

    private async Task RunReview()
    {
        if (_context is null || !_context.HasTargetUrl) return;

        _running     = true;
        _secError    = null;
        _perfError   = null;
        _report      = null;
        RuntimeReviews.MarkQualityRunning(_context);
        StateHasChanged();

        WasmSecurityReviewReport?    secReport  = null;
        WasmPerformanceReviewReport? perfReport = null;

        // Step 1: Security scan
        _progressMessage = "Running security scan…";
        StateHasChanged();
        try
        {
            var scanRequest = BuildScanRequest(_context);
            var (report, error) = await Scanner.ScanAsync(scanRequest);
            secReport = report;
            _secError = error;
        }
        catch (Exception ex)
        {
            _secError = ex.Message;
        }

        // Step 2: Performance scan
        _progressMessage = "Running performance scan…";
        StateHasChanged();
        try
        {
            perfReport = await PerfService.RunReviewAsync(_context.TargetUrl);
        }
        catch (Exception ex)
        {
            _perfError = ex.Message;
        }

        // Step 3: Build unified quality report
        _progressMessage = "Building quality report…";
        StateHasChanged();

        if (secReport is null && perfReport is null)
        {
            _running = false;
            var errorMsg = "Both security and performance scans failed — unable to produce a quality report.";
            RuntimeReviews.MarkQualityFailed(_context, errorMsg);
            StateHasChanged();
            return;
        }

        var qualityReport = QualityService.BuildReport(_context.TargetUrl, secReport, perfReport);
        _report  = qualityReport;
        _running = false;
        RuntimeReviews.SaveQualityResult(_report, _context);
        _expandedFindings.Clear();
        _findingSearch = null;
        _sevFilter     = null;
        _catFilter     = null;
    }

    private async Task ExportHtml()
    {
        if (_report is null) return;
        var html = ExportService.ExportFrontendQualityReview(_report, Workspace.ProjectName);
        await JS.InvokeVoidAsync("downloadHtmlFile", $"frontend-quality-review-{DateTime.UtcNow:yyyy-MM-dd}.html", html);
    }

    private async Task RefreshContext()
    {
        _context = await ContextFactory.GetActiveContextAsync();
    }

    // ── Scan request (same as WASM Security Review) ───────────────────────────

    private static WasmScanRequest BuildScanRequest(FrontendAnalysisContext ctx)
    {
        var allowedHosts = ctx.AllowedBackendDomains
            .Concat(ctx.AllowedRestHosts)
            .Distinct()
            .ToList();

        var clientIds = new List<string>();
        if (!string.IsNullOrWhiteSpace(ctx.SecuritySettings.ExpectedClientId))
            clientIds.Add(ctx.SecuritySettings.ExpectedClientId);

        var knownSafe = ctx.AllowedGraphQlEndpoints
            .Concat(ctx.AllowedCdnHosts)
            .ToList();

        return new WasmScanRequest
        {
            TargetUrl                  = ctx.TargetUrl,
            EnvironmentName            = ctx.ActiveProfile.EnvironmentType.ToString(),
            ExpectedApiGatewayBasePath = ctx.ActiveProfile.ExpectedApiGateway,
            AllowedBackendHostnames    = allowedHosts,
            AllowedAuthority           = ctx.SecuritySettings.ExpectedAuthority,
            AllowedClientIds           = clientIds,
            KnownSafeDomains           = knownSafe
        };
    }

    // ── Filters ───────────────────────────────────────────────────────────────

    private void SetCategoryFilter(FrontendQualityCategory cat)
    {
        _catFilter     = _catFilter == cat ? null : cat;
        _findingSearch = null;
        _sevFilter     = null;
    }

    private void ToggleSev(FrontendQualitySeverity sev) =>
        _sevFilter = _sevFilter == sev ? null : sev;

    private void ClearFilters()
    {
        _sevFilter     = null;
        _catFilter     = null;
        _findingSearch = null;
    }

    private IEnumerable<FrontendQualityFinding> FilteredFindings(IReadOnlyList<FrontendQualityFinding> all)
    {
        IEnumerable<FrontendQualityFinding> q = all.OrderBy(f => f.Severity).ThenBy(f => f.Category);
        if (_sevFilter.HasValue) q = q.Where(f => f.Severity == _sevFilter.Value);
        if (_catFilter.HasValue)  q = q.Where(f => f.Category == _catFilter.Value);
        if (!string.IsNullOrWhiteSpace(_findingSearch))
        {
            var term = _findingSearch.Trim();
            q = q.Where(f =>
                f.Title.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                f.Description.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                CategoryLabel(f.Category).Contains(term, StringComparison.OrdinalIgnoreCase));
        }
        return q;
    }

    // ── Finding card ──────────────────────────────────────────────────────────

    private RenderFragment<FrontendQualityFinding> FindingCard => f => __builder =>
    {
        var expanded = _expandedFindings.Contains(f.Id);
        var sevCls   = f.Severity.ToString().ToLowerInvariant();
        <div class="wsr-finding wsr-finding-@sevCls">
            <button class="wsr-finding-toggle"
                    @onclick="() => ToggleFinding(f.Id)"
                    aria-expanded="@expanded.ToString().ToLowerInvariant()">
                <span class="wsr-sev-badge wsr-sev-@sevCls">@f.Severity</span>
                <span class="wsr-finding-title">@f.Title</span>
                <span class="wsr-cat-chip">@CategoryLabel(f.Category)</span>
                @if (!string.IsNullOrEmpty(f.SourceSystem))
                { <span class="wsr-rule-chip">@f.SourceSystem</span> }
                <span class="wsr-chevron" aria-hidden="true">@(expanded ? "▲" : "▼")</span>
            </button>
            @if (expanded)
            {
                <div class="wsr-finding-body">
                    <div class="wsr-detail-row">
                        <span class="wsr-detail-label">Description</span>
                        <p class="wsr-detail-text">@f.Description</p>
                    </div>
                    <div class="wsr-detail-row">
                        <span class="wsr-detail-label">Recommendation</span>
                        <p class="wsr-detail-text wsr-detail-action">@f.Recommendation</p>
                    </div>
                    @if (f.Evidence.Count > 0)
                    {
                        <div class="wsr-detail-row">
                            <span class="wsr-detail-label">Evidence</span>
                            <ul class="wsr-limitations-list">
                                @foreach (var ev in f.Evidence) { <li class="wsr-mono">@ev</li> }
                            </ul>
                        </div>
                    }
                </div>
            }
        </div>
    };

    private void ToggleFinding(string id)
    {
        if (!_expandedFindings.Remove(id))
            _expandedFindings.Add(id);
    }

    // ── Helpers ───────────────────────────────────────────────────────────────

    private static string CategoryLabel(FrontendQualityCategory c) => c switch
    {
        FrontendQualityCategory.Performance   => "Performance",
        FrontendQualityCategory.Security      => "Security",
        FrontendQualityCategory.Accessibility => "Accessibility",
        FrontendQualityCategory.Standards     => "Standards",
        FrontendQualityCategory.BlazorWasm    => "Blazor WASM",
        FrontendQualityCategory.Readiness     => "Readiness",
        _                                     => c.ToString(),
    };

    private static string ScoreClass(int score) =>
        score >= 80 ? "wsr-rdy-good" : score >= 50 ? "wsr-rdy-warning" : "wsr-rdy-poor";

    private static string QualityLabel(int score) =>
        score >= 90 ? "Excellent" :
        score >= 80 ? "Good" :
        score >= 65 ? "Needs Attention" :
        score >= 50 ? "At Risk" : "Critical";

    private static string CatCardClass(FrontendQualitySeverity? worst, bool assessed)
    {
        if (!assessed) return "wsr-cat-unknown";
        return worst switch
        {
            FrontendQualitySeverity.Critical => "wsr-cat-critical",
            FrontendQualitySeverity.High     => "wsr-cat-high",
            FrontendQualitySeverity.Medium   => "wsr-cat-medium",
            FrontendQualitySeverity.Low      => "wsr-cat-low",
            null                             => "wsr-cat-good",
            _                                => "wsr-cat-low",
        };
    }

    private static string CatStatusLabel(FrontendQualitySeverity? worst) =>
        worst switch
        {
            FrontendQualitySeverity.Critical => "Critical",
            FrontendQualitySeverity.High     => "High Risk",
            FrontendQualitySeverity.Medium   => "Warning",
            FrontendQualitySeverity.Low      => "Low Risk",
            null                             => "Passed",
            _                                => "Info",
        };
}
