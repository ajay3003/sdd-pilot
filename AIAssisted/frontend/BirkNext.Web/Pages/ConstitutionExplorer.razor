@page "/constitution-explorer"
@using BirkNext.Web.Components
@using BirkNext.Web.Models
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject BirkNext.Web.Services.IWorkspaceSessionService Workspace
@inject BirkNext.Web.Services.IConstitutionAnalysisService ConstitutionService
@inject BirkNext.Web.Services.ISampleProjectDocumentResolver DocumentResolver

<PageTitle>Constitution Explorer — QA Review Studio</PageTitle>

<div class="ce-page">

    @if (!string.IsNullOrWhiteSpace(_selectedProjectName))
    {
        <div style="padding: 8px 16px; background: #f5f5f5; border-bottom: 1px solid #e0e0e0; font-size: 0.875rem; color: #666;">
            Sample Project: <strong>@_selectedProjectName</strong>
        </div>
    }

    <PageHeader Title="Constitution Explorer"
                Description="Navigate and analyze constitution.md files — review principles, standards, constraints, and governance in one place." />

    @if (_isMissingDocument && !string.IsNullOrWhiteSpace(_selectedProjectName))
    {
        <div style="padding: 32px; text-align: center; color: #999;">
            <p>constitution.md is not available for <strong>@_selectedProjectName</strong>.</p>
        </div>
    }
    else
    {
        <div class="ce-page-body">
            <ConstitutionExplorerPanel
                ConstitutionText="@_initialText"
                ParsedDocument="@_parsedDocument"
                SemanticModel="@_semanticModel"
                InitialView="@_initialView"
                OnTextChanged="OnPanelTextChanged" />
        </div>
    }

</div>

@code {
    private string _initialText = string.Empty;
    private string? _initialView;
    private ConstitutionDocument? _parsedDocument;
    private ConstitutionSemanticModel? _semanticModel;
    private string? _selectedProject;
    private string? _selectedProjectName;
    private bool _isMissingDocument;
    private string? _previousProject;

    private const string StorageKey = "ce-standalone-constitution";

    protected override async Task OnInitializedAsync()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("view", out var view))
            _initialView = view;

        // POLICY: Automatic Constitution loading is Sample Project ONLY
        // Never use Workspace or localStorage as the source for production automatic loading

        // Load from currently selected Sample Project
        var selected = DocumentResolver.GetSelectedProject();
        if (!string.IsNullOrWhiteSpace(selected))
        {
            await LoadFromSampleProject(selected);
            _previousProject = selected;
        }
        else
        {
            // No Sample Project selected - show explicit empty state, not legacy content
            _selectedProject = null;
            _selectedProjectName = null;
            _initialText = string.Empty;
            _parsedDocument = null;
            _semanticModel = null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            // Detect project changes at runtime
            var currentProject = DocumentResolver.GetSelectedProject();
            if (currentProject != _previousProject)
            {
                _previousProject = currentProject;

                if (!string.IsNullOrWhiteSpace(currentProject))
                {
                    await LoadFromSampleProject(currentProject);
                }
                else
                {
                    // Project was deselected
                    _selectedProject = null;
                    _selectedProjectName = null;
                    _initialText = string.Empty;
                    _parsedDocument = null;
                    _semanticModel = null;
                    _isMissingDocument = false;
                }
                StateHasChanged();
            }
            return;
        }

        // First render complete - legacy localStorage support only for backward compatibility
        // This is NOT the production automatic source; it's an emergency fallback only
        if (!string.IsNullOrWhiteSpace(_initialText) || !string.IsNullOrWhiteSpace(_selectedProject))
        {
            // Already loaded from Sample Project or user provided, skip legacy
            return;
        }

        string? legacy = null;
        try { legacy = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey); } catch { }

        if (!string.IsNullOrWhiteSpace(legacy))
        {
            // Legacy fallback: user previously stored constitution in localStorage
            // Only use if no Sample Project is selected
            Workspace.Set(WorkspaceArtifactKind.Constitution, legacy);
            _initialText = legacy;
            BuildSemanticModel(legacy);
            StateHasChanged();
        }
    }

    private async Task LoadFromSampleProject(string projectSlug)
    {
        var result = await DocumentResolver.ResolveAsync(projectSlug, ExplorerDocumentType.Constitution);

        if (result.IsSuccess && !string.IsNullOrEmpty(result.Content))
        {
            _initialText = result.Content;
            _selectedProject = projectSlug;
            _isMissingDocument = false;
            await UpdateSelectedProjectName();
            BuildSemanticModel(result.Content);
        }
        else if (result.IsMissing)
        {
            _selectedProject = projectSlug;
            _isMissingDocument = true;
            await UpdateSelectedProjectName();
            _parsedDocument = null;
            _semanticModel = null;
        }
    }

    private async Task UpdateSelectedProjectName()
    {
        if (string.IsNullOrWhiteSpace(_selectedProject))
        {
            _selectedProjectName = null;
            return;
        }

        var projects = await DocumentResolver.GetAvailableProjectsAsync();
        var project = projects.FirstOrDefault(p => p.Slug == _selectedProject);
        _selectedProjectName = project?.Name ?? _selectedProject;
    }


    private void BuildSemanticModel(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            _semanticModel = null;
            _parsedDocument = null;
            return;
        }
        _parsedDocument = ConstitutionService.Parse(text);
        _semanticModel = ConstitutionAnalysisService.BuildSemanticModel(_parsedDocument);
    }

    private async Task OnPanelTextChanged(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        BuildSemanticModel(text);
        Workspace.Set(WorkspaceArtifactKind.Constitution, text);
        try
        {
            if (string.IsNullOrWhiteSpace(Workspace.CurrentProject))
                await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, text);
            else
                await JS.InvokeVoidAsync("localStorage.removeItem", StorageKey);
        }
        catch { }
    }
}
