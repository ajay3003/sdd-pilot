@page "/constitution-explorer"
@using BirkNext.Web.Components
@using BirkNext.Web.Models
@using BirkNext.Web.Models.Review
@using BirkNext.Web.Services
@inject ReviewPageModelService ReviewPageModelService
@inject IWorkspaceSessionService Workspace
@inject IWorkspaceUpdateCoordinator UpdateCoordinator
@inject IJSRuntime JS

<PageTitle>Constitution Explorer</PageTitle>

<div class="ce-page">
    <PageHeader Title="Constitution Explorer"
                Description="Navigate and analyze constitution.md files — review principles, standards, constraints, and governance in one place." />

    @if (PageModel is not null)
    {
        <ReviewReadinessPanel Model="PageModel" />
    }

    @if (IsLoading)
    {
        <div class="loading-state">Loading constitution analysis...</div>
    }
    else if (LoadError is not null)
    {
        <div class="notification notification-error">@LoadError</div>
    }

    @if (PageModel?.Summary.CanRun == true)
    {
        <div class="constitution-content">
            <!-- Review Results Section -->
            @if (PageModel.Results.Count > 0)
            {
                <div class="results-section">
                    <h2 class="section-title">Analysis Results</h2>
                    <div class="results-grid">
                        @foreach (var result in PageModel.Results)
                        {
                            <div class="result-card">
                                <div class="result-header">
                                    <h3 class="result-title">@result.Name</h3>
                                    <span class="result-severity @GetSeverityClass(result.Severity)">@result.Severity</span>
                                </div>
                                @if (!string.IsNullOrEmpty(result.Summary))
                                {
                                    <p class="result-summary">@result.Summary</p>
                                }
                                @if (!string.IsNullOrEmpty(result.Details))
                                {
                                    <div class="result-details">@result.Details</div>
                                }
                                @if (!string.IsNullOrEmpty(result.Recommendation))
                                {
                                    <div class="result-recommendation">
                                        <strong>Recommendation:</strong> @result.Recommendation
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Content Editor Section -->
            <div class="constitution-editor">
                <h2 class="section-title">Constitution Content</h2>
                <textarea @bind="_constitutionText"
                          class="editor-textarea"
                          placeholder="Paste or edit constitution content here..."
                          rows="20"></textarea>
                <div class="editor-actions">
                    <button class="btn-primary" @onclick="SaveConstitution">Save Constitution</button>
                    <button class="btn-secondary" @onclick="ClearConstitution">Clear</button>
                    <label class="file-upload-label">
                        <InputFile OnChange="HandleFileUpload" accept=".md,.txt" hidden />
                        📎 Upload File
                    </label>
                </div>
            </div>
        </div>
    }
    else if (PageModel?.ReadinessStatus == ReviewStatus.Blocked)
    {
        <div class="blocked-state">
            <div class="blocked-icon">🔒</div>
            <h2>Load Constitution First</h2>
            <p>Click the upload button above to load a constitution.md file, or paste content directly.</p>
        </div>
    }
</div>

@code {
    private ReviewPageModel? PageModel;
    private bool IsLoading = true;
    private string? LoadError;
    private string _constitutionText = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Workspace.ReviewContextRebuildNeeded += (s, e) => _ = RefreshPageModel();
        await RefreshPageModel();

        var cached = Workspace.Get(WorkspaceArtifactKind.Constitution);
        if (cached != null)
        {
            _constitutionText = cached.Text;
        }
    }

    private async Task RefreshPageModel()
    {
        try
        {
            IsLoading = true;
            LoadError = null;
            PageModel = await ReviewPageModelService.GetConstitutionExplorerModelAsync();
        }
        catch (Exception ex)
        {
            LoadError = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SaveConstitution()
    {
        if (string.IsNullOrWhiteSpace(_constitutionText))
        {
            LoadError = "Constitution content cannot be empty";
            return;
        }

        try
        {
            Workspace.Set(WorkspaceArtifactKind.Constitution, _constitutionText);
            UpdateCoordinator.NotifyMutation();
            await RefreshPageModel();
        }
        catch (Exception ex)
        {
            LoadError = $"Failed to save: {ex.Message}";
        }
    }

    private void ClearConstitution()
    {
        _constitutionText = string.Empty;
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        try
        {
            using var stream = e.File.OpenReadStream();
            using var reader = new StreamReader(stream);
            _constitutionText = await reader.ReadToEndAsync();
            await SaveConstitution();
        }
        catch (Exception ex)
        {
            LoadError = $"Failed to upload file: {ex.Message}";
        }
    }

    private string GetSeverityClass(string? severity) => severity?.ToLower() switch
    {
        "critical" => "severity-critical",
        "warning" => "severity-warning",
        "info" => "severity-info",
        _ => "severity-default"
    };
}

<style>
.ce-page {
    padding: 0 20px;
}

.constitution-content {
    margin-top: 32px;
}

.section-title {
    font-size: 18px;
    font-weight: 600;
    color: #111827;
    margin-bottom: 16px;
    border-bottom: 2px solid #e5e7eb;
    padding-bottom: 12px;
}

.results-section {
    margin-bottom: 40px;
}

.results-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
    margin-bottom: 24px;
}

.result-card {
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 16px;
    background: white;
    transition: all 0.2s ease;
}

.result-card:hover {
    border-color: #d1d5db;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.07);
}

.result-header {
    display: flex;
    justify-content: space-between;
    align-items: start;
    margin-bottom: 12px;
}

.result-title {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    color: #111827;
}

.result-severity {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
}

.result-severity.severity-critical {
    background: #fee2e2;
    color: #991b1b;
}

.result-severity.severity-warning {
    background: #fef3c7;
    color: #92400e;
}

.result-severity.severity-info {
    background: #dbeafe;
    color: #1e40af;
}

.result-summary {
    margin: 0 0 8px 0;
    font-size: 14px;
    color: #374151;
}

.result-details {
    margin: 8px 0;
    padding: 8px;
    background: #f9fafb;
    border-radius: 4px;
    font-size: 13px;
    color: #6b7280;
}

.result-recommendation {
    margin-top: 8px;
    padding: 8px;
    background: #fef3c7;
    border-left: 3px solid #f59e0b;
    border-radius: 4px;
    font-size: 13px;
    color: #92400e;
}

.constitution-editor {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 24px;
}

.editor-textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
    font-size: 13px;
    resize: vertical;
}

.editor-textarea:focus {
    outline: none;
    border-color: #3b82f6;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}

.editor-actions {
    display: flex;
    gap: 12px;
    margin-top: 16px;
}

.btn-primary, .btn-secondary {
    padding: 10px 20px;
    border-radius: 6px;
    font-weight: 500;
    cursor: pointer;
    border: none;
    transition: all 0.2s ease;
}

.btn-primary {
    background: #3b82f6;
    color: white;
}

.btn-primary:hover {
    background: #2563eb;
}

.btn-secondary {
    background: #f3f4f6;
    color: #374151;
    border: 1px solid #d1d5db;
}

.btn-secondary:hover {
    background: #e5e7eb;
}

.file-upload-label {
    display: inline-block;
    padding: 10px 20px;
    background: #f3f4f6;
    color: #374151;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
}

.file-upload-label:hover {
    background: #e5e7eb;
}

.blocked-state {
    text-align: center;
    padding: 80px 20px;
    background: #fef2f2;
    border-radius: 8px;
    margin: 32px 0;
}

.blocked-icon {
    font-size: 64px;
    margin-bottom: 16px;
}

.blocked-state h2 {
    font-size: 24px;
    color: #991b1b;
    margin-bottom: 8px;
}

.blocked-state p {
    font-size: 16px;
    color: #7f1d1d;
}

.loading-state {
    text-align: center;
    padding: 40px;
    color: #6b7280;
}
</style>
