@page "/constitution-explorer"
@using BirkNext.Web.Components
@using BirkNext.Web.Models
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<PageTitle>Constitution Explorer — QA Review Studio</PageTitle>

<div class="ce-page">

    <PageHeader Title="Constitution Explorer"
                Description="Navigate and analyze constitution.md files — review principles, standards, constraints, and governance in one place." />

    <div class="ce-page-body">
        <ConstitutionExplorerPanel
            ConstitutionText="@_initialText"
            InitialView="@_initialView"
            OnBuilt="OnDocumentBuilt" />
    </div>

</div>

@code {
    private string _initialText = string.Empty;
    private string? _initialView;

    private const string StorageKey = "ce-standalone-constitution";

    protected override void OnInitialized()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("view", out var view))
            _initialView = view;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
            if (!string.IsNullOrWhiteSpace(saved) && saved != _initialText)
            {
                _initialText = saved;
                StateHasChanged();
            }
        }
        catch
        {
            // localStorage unavailable — continue without restore
        }
    }

    private async Task OnDocumentBuilt(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, text);
        }
        catch
        {
            // ignore storage errors
        }
    }
}
