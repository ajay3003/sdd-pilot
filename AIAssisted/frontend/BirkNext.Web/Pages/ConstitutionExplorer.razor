@page "/constitution-explorer"
@using BirkNext.Web.Components
@using BirkNext.Web.Components.Explorers
@using BirkNext.Web.Models
@using BirkNext.Web.Services.Explorers
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager NavigationManager
@inject BirkNext.Web.Services.IConstitutionAnalysisService ConstitutionService

<PageTitle>Constitution Explorer — QA Review Studio</PageTitle>

<div class="ce-page">

    <PageHeader Title="Constitution Explorer"
                Description="@ArtifactExplorerRoles.Purpose(WorkspaceArtifactType.Constitution)" />

    <ArtifactExplorerHost @ref="_host" Role="WorkspaceArtifactType.Constitution" OnStateChanged="OnArtifactChanged">
        @if (_analysisError is not null)
        {
            <ExplorerAnalysisError Role="WorkspaceArtifactType.Constitution" Message="@_analysisError" />
        }
        else
        {
            <div class="ce-page-body">
                <ConstitutionExplorerPanel
                    ConstitutionText="@_text"
                    ParsedDocument="@_parsedDocument"
                    SemanticModel="@_semanticModel"
                    InitialView="@_initialView"
                    OnTextChanged="ImportFromPanel" />
            </div>
        }
    </ArtifactExplorerHost>

</div>

@code {
    private ArtifactExplorerHost? _host;
    private string _text = string.Empty;
    private string? _initialView;
    private string? _analysisError;
    private ConstitutionDocument? _parsedDocument;
    private ConstitutionSemanticModel? _semanticModel;

    protected override void OnInitialized()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("view", out var view))
            _initialView = view;
    }

    // The panel's own paste box goes through the repository like every other import.
    private Task ImportFromPanel(string text) => _host?.ImportPastedAsync(text) ?? Task.CompletedTask;

    private void OnArtifactChanged(ArtifactExplorerState state)
    {
        var text = state.Content ?? string.Empty;
        if (string.Equals(text, _text, StringComparison.Ordinal)) return;
        _text = text;
        _parsedDocument = null;
        _semanticModel = null;
        _analysisError = null;
        if (string.IsNullOrWhiteSpace(text)) return;
        try
        {
            _parsedDocument = ConstitutionService.Parse(text);
            _semanticModel = ConstitutionAnalysisService.BuildSemanticModel(_parsedDocument);
        }
        catch (Exception ex)
        {
            _parsedDocument = null;
            _semanticModel = null;
            _analysisError = ex.Message;
        }
    }
}
