@page "/scenarios/new"
@using BirkNext.Web.Components
@inject NavigationManager Navigation

<PageTitle>Create Test Scenario</PageTitle>

<div class="create-scenario-shell">
    <section class="create-scenario-hero" aria-label="Create test scenario overview">
        <div>
            <p class="section-kicker">QA Authoring</p>
            <h1>Create Test Scenario</h1>
            <p class="page-lead">Create reusable QA test scenarios that support requirement coverage, traceability, and release readiness.</p>
        </div>
        <div class="create-scenario-benefits" aria-label="Scenario benefits">
            <span>Improves requirement coverage</span>
            <span>Supports traceability</span>
            <span>Appears in QA Artifact Library</span>
            <span>Contributes to QA Health Score</span>
        </div>
    </section>

    <ScenarioForm OnScenarioCreated="HandleScenarioCreated" />
</div>

@code {
    private void HandleScenarioCreated()
    {
        Navigation.NavigateTo("scenarios");
    }
}
