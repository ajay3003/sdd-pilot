@page "/scenarios/new"
@using BirkNext.Web.Components
@inject NavigationManager Navigation

<PageTitle>New Test Scenario</PageTitle>

<h1>New Test Scenario</h1>
<p class="page-lead">Create a new executable test scenario for this project.</p>

<ScenarioForm OnScenarioCreated="HandleScenarioCreated" />

@code {
    private void HandleScenarioCreated()
    {
        Navigation.NavigateTo("scenarios");
    }
}
