@page "/scenarios/new"
@using BirkNext.Web.Components
@using BirkNext.Web.Models.Library
@using BirkNext.Web.Services

@inject ILibraryPageModelService LibraryPageModelService
@inject IWorkspaceSessionService Workspace

<PageTitle>Create Test Scenario</PageTitle>

<div class="create-scenario-page">
    <PageHeader Title="Create Test Scenario"
                Description="Create structured test scenarios linked to your requirements and design." />

    <!-- ── Readiness Panel ────────────────────────────────────────── -->
    @if (PageModel is not null)
    {
        <LibraryReadinessPanel Model="PageModel" />
    }
    else if (IsLoading)
    {
        <div class="loading-state" role="status">Loading scenario creation interface...</div>
    }
    else if (LoadError is not null)
    {
        <div class="notification notification-error" role="alert">@LoadError</div>
    }

    <!-- ── Scenario Creation Form (only if ready) ─────────────────── -->
    @if (PageModel?.Summary.HasAvailableActions == true)
    {
        <div class="scenario-form-container">
            <div class="form-section">
                <h2 class="form-title">Scenario Details</h2>

                <!-- Title -->
                <div class="form-field">
                    <label for="scenario-title" class="form-label">
                        Title <span class="required-indicator">*</span>
                    </label>
                    <input type="text"
                           id="scenario-title"
                           class="form-input"
                           placeholder="e.g., User registration with valid email"
                           @bind="ScenarioTitle" />
                    <span class="form-hint">Brief descriptive title for the scenario</span>
                </div>

                <!-- Description -->
                <div class="form-field">
                    <label for="scenario-description" class="form-label">
                        Description
                    </label>
                    <textarea id="scenario-description"
                              class="form-textarea"
                              placeholder="Optional: Detailed context and background"
                              rows="3"
                              @bind="ScenarioDescription"></textarea>
                </div>
            </div>

            <div class="form-section">
                <h2 class="form-title">Scenario Steps</h2>

                <!-- Preconditions -->
                <div class="form-field">
                    <label for="preconditions" class="form-label">
                        Preconditions <span class="required-indicator">*</span>
                    </label>
                    <textarea id="preconditions"
                              class="form-textarea"
                              placeholder="What must be true before the scenario starts?&#10;- User is logged in&#10;- Account is verified"
                              rows="4"
                              @bind="Preconditions"></textarea>
                    <span class="form-hint">Conditions that must exist before executing steps</span>
                </div>

                <!-- Steps -->
                <div class="form-field">
                    <label for="steps" class="form-label">
                        Steps <span class="required-indicator">*</span>
                    </label>
                    <textarea id="steps"
                              class="form-textarea"
                              placeholder="What does the user do?&#10;1. Enter email address&#10;2. Click submit&#10;3. Receive confirmation email"
                              rows="4"
                              @bind="Steps"></textarea>
                    <span class="form-hint">Numbered action steps</span>
                </div>

                <!-- Expected Result -->
                <div class="form-field">
                    <label for="expected-result" class="form-label">
                        Expected Result <span class="required-indicator">*</span>
                    </label>
                    <textarea id="expected-result"
                              class="form-textarea"
                              placeholder="What should happen?&#10;- Account created successfully&#10;- User redirected to dashboard&#10;- Welcome email sent"
                              rows="4"
                              @bind="ExpectedResult"></textarea>
                    <span class="form-hint">Observable outcome of the scenario</span>
                </div>
            </div>

            <div class="form-section">
                <h2 class="form-title">Links & Metadata</h2>

                <!-- Linked Requirement -->
                <div class="form-field">
                    <label for="linked-requirement" class="form-label">
                        Linked Requirement
                    </label>
                    <input type="text"
                           id="linked-requirement"
                           class="form-input"
                           placeholder="e.g., REQ-001: User Registration"
                           @bind="LinkedRequirement" />
                    <span class="form-hint">Optional: Link this scenario to a requirement</span>
                </div>

                <!-- Tags -->
                <div class="form-field">
                    <label for="tags" class="form-label">
                        Tags
                    </label>
                    <input type="text"
                           id="tags"
                           class="form-input"
                           placeholder="e.g., happy-path, security, performance"
                           @bind="Tags" />
                    <span class="form-hint">Comma-separated tags for categorization</span>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="form-actions">
                <button class="btn-primary" @onclick="SaveScenario">Create Scenario</button>
                <button class="btn-secondary" @onclick="ResetForm">Clear Form</button>
            </div>
        </div>
    }
    else if (PageModel?.ReadinessStatus == LibraryStatus.Blocked)
    {
        <div class="blocked-state-container">
            <div class="blocked-state-icon">🔒</div>
            <h2 class="blocked-state-title">Cannot create scenarios yet</h2>
            <p class="blocked-state-description">You need to load at least one artifact (Specification, Plan, or Tasks) before creating test scenarios.</p>
            <a href="/scenarios" class="btn-primary">Go to Artifact Library</a>
        </div>
    }
</div>

@code {
    private LibraryPageModel? PageModel;
    private bool IsLoading = true;
    private string? LoadError;

    private string ScenarioTitle = string.Empty;
    private string ScenarioDescription = string.Empty;
    private string Preconditions = string.Empty;
    private string Steps = string.Empty;
    private string ExpectedResult = string.Empty;
    private string LinkedRequirement = string.Empty;
    private string Tags = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to workspace changes
        Workspace.ReviewContextRebuildNeeded += (s, e) => _ = RefreshPageModel();

        // Load initial model
        await RefreshPageModel();
    }

    private async Task RefreshPageModel()
    {
        try
        {
            IsLoading = true;
            LoadError = null;
            PageModel = await LibraryPageModelService.GetCreateTestScenarioModelAsync();

            if (PageModel is null)
            {
                LoadError = "Failed to load scenario creation interface";
            }
        }
        catch (Exception ex)
        {
            LoadError = $"Error loading interface: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SaveScenario()
    {
        if (string.IsNullOrWhiteSpace(ScenarioTitle) ||
            string.IsNullOrWhiteSpace(Preconditions) ||
            string.IsNullOrWhiteSpace(Steps) ||
            string.IsNullOrWhiteSpace(ExpectedResult))
        {
            LoadError = "Please fill in all required fields";
            return;
        }

        // TODO: Implement scenario save logic
        // This would create the scenario in the workspace
        await Task.Delay(100); // Placeholder
    }

    private void ResetForm()
    {
        ScenarioTitle = string.Empty;
        ScenarioDescription = string.Empty;
        Preconditions = string.Empty;
        Steps = string.Empty;
        ExpectedResult = string.Empty;
        LinkedRequirement = string.Empty;
        Tags = string.Empty;
    }
}

<style>
.create-scenario-page {
    padding: 0 20px;
}

.loading-state {
    text-align: center;
    color: #6b7280;
    padding: 40px 20px;
}

.scenario-form-container {
    background: white;
    border-radius: 8px;
    border: 1px solid #e5e7eb;
    max-width: 800px;
    margin: 32px auto;
    padding: 32px;
}

.form-section {
    margin-bottom: 32px;
}

.form-section:last-of-type {
    margin-bottom: 24px;
}

.form-title {
    font-size: 18px;
    font-weight: 600;
    color: #111827;
    margin: 0 0 16px 0;
    padding-bottom: 12px;
    border-bottom: 2px solid #e5e7eb;
}

.form-field {
    margin-bottom: 20px;
}

.form-label {
    display: block;
    font-weight: 500;
    color: #374151;
    margin-bottom: 8px;
    font-size: 14px;
}

.required-indicator {
    color: #ef4444;
}

.form-input,
.form-textarea {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-family: inherit;
    font-size: 14px;
    transition: all 0.2s ease;
}

.form-input:focus,
.form-textarea:focus {
    outline: none;
    border-color: #3b82f6;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}

.form-textarea {
    resize: vertical;
    min-height: 100px;
}

.form-hint {
    display: block;
    font-size: 12px;
    color: #9ca3af;
    margin-top: 4px;
}

.form-actions {
    display: flex;
    gap: 12px;
    justify-content: flex-end;
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid #e5e7eb;
}

.btn-primary,
.btn-secondary {
    padding: 10px 20px;
    border-radius: 6px;
    font-weight: 500;
    cursor: pointer;
    border: none;
    transition: all 0.2s ease;
}

.btn-primary {
    background: #3b82f6;
    color: white;
}

.btn-primary:hover {
    background: #2563eb;
}

.btn-secondary {
    background: #f3f4f6;
    color: #374151;
    border: 1px solid #d1d5db;
}

.btn-secondary:hover {
    background: #e5e7eb;
}

.blocked-state-container {
    text-align: center;
    padding: 60px 20px;
    background: #fef2f2;
    border-radius: 8px;
    margin: 32px 0;
}

.blocked-state-icon {
    font-size: 64px;
    margin-bottom: 16px;
}

.blocked-state-title {
    font-size: 24px;
    font-weight: 600;
    color: #991b1b;
    margin-bottom: 8px;
}

.blocked-state-description {
    font-size: 16px;
    color: #7f1d1d;
    margin-bottom: 24px;
}
</style>
