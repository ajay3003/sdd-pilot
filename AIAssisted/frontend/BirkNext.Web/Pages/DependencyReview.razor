    }

    private MarkupString SectionCount(DependencyReviewResult result, SourceResultSection section, IReadOnlyList<DependencyMapping> mappings)
    {
        var count = section switch
        {
            SourceResultSection.Findings => R.NeedsReview(result).Sum(g => g.Findings.Count),
            SourceResultSection.Mapping => mappings.Count,
            SourceResultSection.VersionDifferences => result.CrossSource.Count,
            _ => -1,
        };
        return count < 0 ? default : (MarkupString)$" <span class=\"dr-section-count\">{count}</span>";
    }

    private RenderFragment RepositoryPicker(DependencyReviewResult result) => __builder =>
    {
        if (result.Repositories.Count < 2) return;
        <nav class="dr-tabs" aria-label="Repositories">
            @foreach (var tab in result.Repositories)
            {
                <button type="button" class="dr-tab @(tab.Repository == Selected?.Repository ? "active" : "")" aria-pressed="@(tab.Repository == Selected?.Repository ? "true" : "false")"
                        data-testid="dr-repo-tab" data-repository="@tab.Repository" @onclick="() => SelectRepository(tab.Repository)">
                    @tab.Repository <span class="dr-badge dr-badge-@DependencyReviewPresentation.Tone(tab.Coverage)">@DependencyReviewPresentation.Coverage(tab.Coverage)</span>
                </button>
            }
        </nav>
    };

    private RenderFragment SourceHistory => __builder =>
    {
        <label class="dr-field dr-history">Source reviews · Evidence: Source snapshot
            <select class="form-control" data-testid="dr-history" value="@(_result?.RunId.ToString() ?? "")" @onchange="OpenRunAsync" disabled="@_busy">
                <option value="">Choose a stored review</option>
                @foreach (var run in _history) { <option value="@run.RunId">Source review · Source snapshot · @run.CompletedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC · @run.Label (@run.Findings findings)</option> }
            </select>
        </label>
    };

    /// <summary>Stored health runs, each labelled with its evidence mode; filtered to one mode inside that mode's result.</summary>
    private RenderFragment HealthHistory(string? mode) => __builder =>
    {
        var runs = _healthHistory.Where(r => mode is null || (r.EvidenceMode ?? DependencyEvidenceModes.Inventory) == mode).ToList();
        <label class="dr-field dr-history">@(mode is null ? "Dependency health reviews" : $"Stored {DependencyEvidenceModes.ReviewType(mode).ToLowerInvariant()}s · Evidence: {DependencyEvidenceModes.Label(mode)}")
            <select class="form-control" data-testid="dh-history" value="@(_health?.RunId.ToString() ?? "")" @onchange="OpenHealthAsync" disabled="@_busy">
                <option value="">Choose a stored review</option>
                @foreach (var run in runs) { <option value="@run.RunId">@DependencyEvidenceModes.ReviewType(run.EvidenceMode) · @DependencyEvidenceModes.Label(run.EvidenceMode) · @run.CompletedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC · @run.Label (@run.Dependencies deps, @run.Findings findings)@(run.RefreshOf is not null ? " · refresh" : "")</option> }
            </select>
        </label>
    };

    protected override async Task OnInitializedAsync()
    {
        try { _history = await Api.HistoryAsync(); }
        catch (Exception ex) when (BackendRequestClassifier.IsRequestFailure(ex)) { _status = BackendRequestClassifier.FromException("Stored reviews", ex).UserMessage; }
        await LoadHealthListsAsync();
        await LoadSourcesAsync();
        try { if (!TargetSettings.IsLoaded) await TargetSettings.LoadAsync(JS); }
        catch (Exception ex) when (ex is JSException or InvalidOperationException) { /* no Target Environments: the manual URL remains */ }
    }

    // ── Pre-run workflow ────────────────────────────────────────────────────────────────────────────────────────────

    private DependencyReviewMode _mode = DependencyReviewMode.None;
    private ElementReference _sourceHeading;
    private ElementReference _inventoryHeading;
    private ElementReference _sbomHeading;
    private ElementReference _deployedHeading;
    private bool _focusMode;
    private string? _targetId;

    /// <summary>Target Environments with a URL (the Target Environment owns URL and environment; nothing is copied).</summary>
    private IReadOnlyList<BirkNext.Web.Models.FrontendAnalysisProfile> Targets =>
        TargetSettings.IsLoaded ? TargetSettings.Settings.Profiles.Where(p => !string.IsNullOrWhiteSpace(p.TargetUrl)).ToList() : [];
    private BirkNext.Web.Models.FrontendAnalysisProfile? SelectedTarget => Targets.FirstOrDefault(t => t.Id == _targetId);
    /// <summary>The selected Target Environment's URL; the manual URL (advanced) only when no target is selected.</summary>
    private string? CaptureUrl => SelectedTarget?.TargetUrl ?? (string.IsNullOrWhiteSpace(_targetUrl) ? null : _targetUrl.Trim());

    private ReadinessView Readiness => DependencyReviewReadiness.Evaluate(ReadinessSelections);

    /// <summary>The inventory the selected mode reviews: the chosen inventory, or in SBOM mode only the inventory derived from this SBOM.</summary>
    private InventorySummary? ModeInventory => _mode == DependencyReviewMode.Sbom ? _inventories.FirstOrDefault(i => i.Id == _sbomInventoryId) : SelectedInventory;
    private Guid? HealthInventoryId => _mode == DependencyReviewMode.Sbom ? _sbomInventoryId : _inventoryId;

    private ReadinessInput ReadinessSelections => new()
    {
        Mode = _mode, Inventory = ModeInventory,
        SourceAnalysisDisabled = !FeatureViz.SourceAnalysis, SourceSnapshotsAvailable = FeatureViz.SourceAnalysis && _scope.Snapshots.Count > 0,
        PrimarySource = Primary is { } p ? $"{p.Repository} · {Short(p.Fingerprint)}" : null, PrimaryRepository = Primary?.Repository, PrimaryHasEvidence = Primary?.HasConsumerEvidence == true, PrimaryEvidenceNote = Primary?.ConsumerEvidenceNote,
        RelatedIncluded = _scope.Related.Count, RelatedSummary = string.Join(", ", _scope.Related.Values.Select(id => _scope.Snapshots.FirstOrDefault(s => s.SnapshotId == id)).OfType<ReviewSourceSnapshot>().Select(s => $"{s.Repository} · {Short(s.Fingerprint)}")),
        RelatedNotIncluded = NotIncludedAvailable.Count, ScopeProblem = ScopeProblem, PendingSbom = _sbom?.Name, SbomInvalid = _validation is { Valid: false },
        PolicyInventory = _inventories.FirstOrDefault(i => i.Id == _policyInventoryId), Deployed = _mode == DependencyReviewMode.Deployed ? _inventories.FirstOrDefault(i => i.Id == _deployedId) : null,
        DeploymentTarget = SelectedTarget?.Name, SbomReviewed = _sbomInventoryId is not null, CanCaptureDeployed = CaptureUrl is not null,
        SbomCandidates = _sbomScan?.Checked.Count > 0 ? _sbomScan.Candidates.Count : null, SbomFormat = _validation is { Valid: true } valid ? DependencyHealthLabels.Format(valid.Format) : null,
    };

    private DependencyReviewNextStep NextStep => DependencyReviewReadiness.NextStep(ReadinessSelections);

    /// <summary>The primary button text: after a result exists for this mode, running again says so.</summary>
    private string PrimaryLabel(DependencyReviewNextStep next) =>
        next.Action == DependencyReviewNextAction.RunSourceReview && CurrentSource is not null ? "Run source dependency analysis again"
        : next.Action == DependencyReviewNextAction.RunHealthReview && CurrentHealth is not null ? $"{next.Label} again"
        : next.Label;

    /// <summary>Workflow hint: 1 when evidence is chosen, 2 when its inputs are ready, 3 when this mode's result is shown.</summary>
    private IReadOnlyList<(int Number, string Label, bool Done)> Steps(DependencyReviewNextStep next) =>
    [
        (1, "Choose evidence", _mode != DependencyReviewMode.None),
        (2, "Check readiness", next.Ready),
        (3, "Run review", next.Ready && (CurrentSource is not null || CurrentHealth is not null)),
    ];

    private readonly Dictionary<DependencyReviewMode, ElementReference> _modeCards = new();
    private InputFile? _sbomInput;
    private ElementReference _inventorySelect;
    private ElementReference _targetSelect;
    private Func<ElementReference?>? _focusControl;

    /// <summary>The next step's action: Choose* opens the right panel and focuses its control; the others call the panel's own command.</summary>
    private async Task NextActionAsync()
    {
        void Choose(DependencyReviewMode mode, Func<ElementReference?> control) { _mode = mode; _focusControl = control; }
        switch (NextStep.Action)
        {
            case DependencyReviewNextAction.ChooseReviewSource: _focusControl = () => _modeCards.TryGetValue(DependencyReviewMode.Source, out var card) ? card : null; break;
            case DependencyReviewNextAction.ChooseSourceSnapshot: Choose(DependencyReviewMode.Source, () => _selector?.SelectElement); break;
            case DependencyReviewNextAction.ResolveSourceScope: Choose(DependencyReviewMode.Source, () => _selector?.SelectElement); break;
            case DependencyReviewNextAction.OpenSourceAnalysis: Navigation.NavigateTo("source-analysis"); break;
            case DependencyReviewNextAction.ChooseInventory: Choose(_mode == DependencyReviewMode.Deployed ? DependencyReviewMode.Deployed : DependencyReviewMode.Inventory, () => _mode == DependencyReviewMode.Deployed ? _deployedHeading : _inventorySelect); break;
            case DependencyReviewNextAction.UploadSbom: Choose(DependencyReviewMode.Sbom, () => _sbomInput?.Element); break;
            case DependencyReviewNextAction.ChooseTarget: Choose(DependencyReviewMode.Deployed, () => _targetSelect); break;
            case DependencyReviewNextAction.CaptureDeployed: await CaptureDeployedAsync(); break;
            case DependencyReviewNextAction.ReviewSbom: await ValidateSbomAsync(); break;
            case DependencyReviewNextAction.RunSourceReview: await RunAsync(); break;
            case DependencyReviewNextAction.RunHealthReview: await RunHealthAsync(); break;
        }
    }

    private async Task SelectModeAsync(DependencyReviewMode mode)
    {
        _mode = mode;
        _focusMode = true;
        if (mode == DependencyReviewMode.Sbom) await ScanForSbomAsync();
    }

    /// <summary>Review SBOM first checks the selected source snapshots (or, with none selected, the latest snapshot per repository) for supported
    /// SBOM files. Read-only: candidates are listed, never imported or selected.</summary>
    private async Task ScanForSbomAsync()
    {
        if (!FeatureViz.SourceAnalysis || _environmentId is null) return;
        var ids = _scope.PrimaryId is { } primary ? [primary, .. _scope.Related.Values] : _scope.Snapshots.Where(s => s.Latest).Select(s => s.SnapshotId).ToList();
        try { _sbomScan = await Api.SbomCandidatesAsync(_environmentId, ids); }
        catch (Exception ex) when (BackendRequestClassifier.IsRequestFailure(ex)) { _sbomScan = null; _healthStatus = BackendRequestClassifier.FromException("Checking source snapshots for SBOM files", ex).UserMessage; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusControl is { } control)
        {
            _focusControl = null;
            _focusMode = false;
            if (control() is { } element) { try { await element.FocusAsync(); } catch (Exception ex) when (ex is JSException or InvalidOperationException) { } }
            return;
        }
        if (!_focusMode) return;
        _focusMode = false;
        var heading = _mode switch { DependencyReviewMode.Source => _sourceHeading, DependencyReviewMode.Inventory => _inventoryHeading, DependencyReviewMode.Sbom => _sbomHeading, _ => _deployedHeading };
        try { await heading.FocusAsync(); } catch (Exception ex) when (ex is JSException or InvalidOperationException) { }
    }

    private ReviewSourceSnapshot? Primary => _scope.Primary;
    /// <summary>Suggested related sources with a snapshot, neither included nor explicitly continued without.</summary>
    private List<RelatedSourceCandidate> NotIncludedAvailable => _scope.NotIncluded.Where(c => c.State == RelatedSourceState.SnapshotAvailable && !_scope.Excluded.Contains(c.Repository)).ToList();
    private string? ScopeProblem => _scope.Related.Values.Select(id => (id, s: _scope.Snapshots.FirstOrDefault(x => x.SnapshotId == id))).Select(x =>
            x.s is null ? "An included related snapshot is no longer available in Source Analysis. Remove it or choose another snapshot."
            : !x.s.HasConsumerEvidence ? $"{x.s.Repository} · {Short(x.s.Fingerprint)} has no dependency evidence. Remove it or choose a newer snapshot." : null)
        .FirstOrDefault(m => m is not null);
    private List<string> ScopeRepositories => Primary is null ? [] : [Primary.Repository, .. _scope.Related.Values.Select(id => _scope.Snapshots.FirstOrDefault(s => s.SnapshotId == id)?.Repository).OfType<string>()];
    private static string Short(string fingerprint) => SourceAnalysisOverview.ShortFingerprint(fingerprint);
    private static string Utc(DateTimeOffset at) => SourceAnalysisOverview.Utc(at);

    private async Task LoadSourcesAsync()
    {
        if (!FeatureViz.SourceAnalysis) return; // feature visibility is respected: hidden Source Analysis offers no snapshots here
        try
        {
            // Source snapshots need no Target Environment; the id (blank without one) is only the caller's runtime context.
            _environmentId = (await ContextFactory.GetActiveContextAsync()).ActiveProfileOrNull?.Id ?? "";
            _scope.Options = await Api.SourceScopeAsync(_environmentId, _scope.Request);
        }
        catch (Exception ex) when (BackendRequestClassifier.IsRequestFailure(ex)) { _status = BackendRequestClassifier.FromException("Source Analysis snapshots", ex).UserMessage; }
    }

    /// <summary>Re-reads the scope's options (candidates, newer snapshots, problems) after an explicit change — never auto-includes.</summary>
    private async Task ReloadScopeAsync()
    {
        if (_environmentId is null) return;
        try { _scope.Options = await Api.SourceScopeAsync(_environmentId, _scope.Request); }
        catch (Exception ex) when (BackendRequestClassifier.IsRequestFailure(ex)) { _error = BackendRequestClassifier.FromException("Checking related sources", ex).UserMessage; }
    }

    /// <summary>Choosing a primary source snapshot is choosing Source snapshot evidence.</summary>
    private async Task PrimaryChangedAsync(Guid? id)
    {
        if (id is not null) _mode = DependencyReviewMode.Source;
        await ReloadScopeAsync();
        if (Primary is { } p && !ScopeRepositories.Contains(_overrideRepository)) _overrideRepository = p.Repository;
    }

    private async Task FocusPrimaryAsync() { if (_selector is not null) await _selector.FocusAsync(); }
    private async Task FocusSetupAsync() { try { await _sourceHeading.FocusAsync(); } catch (InvalidOperationException) { } }
    private string _usageSearch = "", _usageState = "", _usageRenovate = "";

    private async Task PickConfig(InputFileChangeEventArgs args)
    {
        _error = null;
        if (args.File.Size > 1024 * 1024) { _error = "The config file is larger than 1 MB."; return; }
        using var buffer = new MemoryStream();
        await args.File.OpenReadStream(1024 * 1024).CopyToAsync(buffer);
        _config = (args.File.Name, buffer.ToArray());
    }

    /// <summary>Runs the source dependency analysis over exactly the selected snapshots (bound by ID and fingerprint in the result).</summary>
    private async Task RunAsync()
    {
        if (_scope.PrimaryId is not { } primary || _environmentId is null) return;
        _busy = true;
        _error = null;
        _status = "Analyzing dependencies from the selected source scope…";
        try
        {
            var request = new SourceDependencyReviewRequest
            {
                EnvironmentId = _environmentId, PrimarySnapshotId = primary, RelatedSnapshotIds = _scope.Request!.RelatedSnapshotIds, ExcludedSuggestions = _scope.Request.ExcludedSuggestions,
                ConfigOverrides = _config is { } config && _overrideRepository.Length > 0 ? [new SourceConfigOverride(_overrideRepository, config.Name, System.Text.Encoding.UTF8.GetString(config.Bytes))] : [],
            };
            var (result, error) = await Api.RunSourceAsync(request);
            if (error is not null) { _error = error; _status = null; return; }
            Show(result!);
            _status = $"Review completed and stored {result!.CompletedAt.ToUniversalTime():yyyy-MM-dd HH:mm} UTC.";
            _history = await Api.HistoryAsync();
            await LoadHealthListsAsync(); // each reviewed source is also a declared-dependency inventory
        }
        catch (Exception ex) when (BackendRequestClassifier.IsRequestFailure(ex)) { _error = BackendRequestClassifier.FromException("Running the review", ex).UserMessage; _status = null; }
        finally { _busy = false; }
    }

    private async Task OpenRunAsync(ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var id)) return;
        _busy = true;
        try
        {
            if (await Api.GetAsync(id) is { } run) { Show(run); _status = $"Showing stored source review from {run.CompletedAt.ToUniversalTime():yyyy-MM-dd HH:mm} UTC (evidence: Source snapshot), exactly as recorded."; }
            else _error = "That review is no longer stored.";
        }
        catch (Exception ex) when (BackendRequestClassifier.IsRequestFailure(ex)) { _error = BackendRequestClassifier.FromException("The stored review", ex).UserMessage; }
        finally { _busy = false; }
    }

    /// <summary>Shows a source review as the current result — which also selects the evidence mode it belongs to.</summary>
    private void Show(DependencyReviewResult result)
    {
        _result = result;
        _mode = DependencyReviewMode.Source;
        _section = SourceResultSection.Summary;
        _selectedRepository = result.Repositories.FirstOrDefault()?.Repository;
        _filter = null;
        _simType = null;
        _simLimit = 40;
        _singleResult = null;
        _singleError = null;
    }

    private void SelectRepository(string repository)
    {
        _selectedRepository = repository;
        _filter = null;
        _simType = null;
        _simLimit = 40;
        _singleResult = null;
        _singleError = null;
    }

    private void PickPackage(RepositoryDependencyReview repo, string? value)
    {
        if (!int.TryParse(value, out var index) || DependencyReviewPresentation.Packages(repo).ElementAtOrDefault(index) is not { } dep) return;
        _single.PackageName = dep.PackageName;
        _single.Manager = dep.Manager;
        _single.File = dep.OwnerFile;
        _single.Current = dep.CurrentValue ?? "";
        _single.Candidate = RenovateCandidate(dep);
    }

    /// <summary>A default synthetic major scenario version for the chosen package, which the user can change.</summary>
    private static string RenovateCandidate(DeclaredDependency dep)
    {
        var m = System.Text.RegularExpressions.Regex.Match(dep.CurrentValue ?? "", @"^(\d+)(.*)$");
        return m.Success ? $"{int.Parse(m.Groups[1].Value) + 1}.0.0" : "";
    }

    private async Task SimulateAsync(RepositoryDependencyReview repo)
    {
        if (_result is null) return;
        _singleError = null;
        _busy = true;
        try
        {
            var (simulation, error) = await Api.SimulateAsync(new PolicySimulationRequest
            {
                RunId = _result.RunId, Repository = repo.Repository, PackageName = _single.PackageName, Manager = _single.Manager,
                CurrentVersion = _single.Current, CandidateVersion = _single.Candidate, File = string.IsNullOrWhiteSpace(_single.File) ? null : _single.File.Trim(),
            });
            _singleResult = simulation;
            _singleError = error;
        }
        catch (Exception ex) when (BackendRequestClassifier.IsRequestFailure(ex)) { _singleError = BackendRequestClassifier.FromException("Running the simulation", ex).UserMessage; }
        finally { _busy = false; }
    }

    private async Task ExportHtml()
    {
        if (_result is null) return;
        await JS.InvokeVoidAsync("downloadHtmlFile", $"dependency-review-{DateTime.UtcNow:yyyy-MM-dd}.html", ExportService.ExportDependencyReview(_result));
    }

    // ── Dependency health (source-free) ────────────────────────────────────────────────────────────────────────────

    private IReadOnlyList<InventorySummary> _inventories = [];
    private IReadOnlyList<DependencyHealthRunSummary> _healthHistory = [];
    private DependencyHealthRun? _health;
    /// <summary>The evidence mode that produced <see cref="_health"/> (stored with the run).</summary>
    private string? _healthOrigin;
