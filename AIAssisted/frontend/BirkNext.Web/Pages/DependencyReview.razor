@page "/dependency-review"
@using BirkNext.Dependencies
@using BirkNext.Web.Components
@using BirkNext.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IDependencyReviewApiService Api
@inject IReportExportService ExportService
@inject IJSRuntime JS
@inject BirkNext.Web.Services.IFrontendAnalysisSettingsService TargetSettings
@inject BirkNext.Web.Services.IFrontendAnalysisContextFactory ContextFactory
@inject FeatureVisibilityService FeatureViz
@inject NavigationManager Navigation

<PageTitle>Dependency Review</PageTitle>

@* Dependency / supply-chain review, separate from Integration Quality Review, with four evidence sources:
   - Source snapshot: Source Analysis snapshots (one primary + explicitly included related snapshots), never an upload here; no dependency
     file, config, branch, commit, push or PR is produced and Renovate is never triggered. Simulated versions are SYNTHETIC candidates — never "latest", "available" or "published".
   - Existing inventory / SBOM / deployed evidence: a source-free dependency health review (registry, advisories, licenses, comparisons,
     automation runtime) over a stored inventory. Each result is an immutable snapshot; refresh creates a new one.
   Static Renovate configuration and Renovate runtime automation stay separate concepts.
   Pre-run: the test lead chooses one workflow (a card) and only that panel is shown; other panels keep their selections (not exclusive).
   Review readiness shows pre-run states only — never a result. Deployed evidence uses a Target Environment (URL/environment derived). *@
<div class="dr-page">
    <PageHeader Title="Dependency Review"
                Description="Choose dependency evidence. A source snapshot from Source Analysis tests declared dependencies and Renovate policy; the other evidence runs registry, security and license checks without source.">
        @if (_view == ResultView.Source && _result is not null)
        {
            <button type="button" class="btn-secondary" data-testid="dr-export" @onclick="ExportHtml">Export HTML</button>
        }
    </PageHeader>

    @{ var readiness = Readiness; var next = NextStep; }
    @* Workflow: Choose source → Check readiness → Run review. A hint, not a wizard: every panel stays reachable. *@
    <ol class="dr-steps" aria-label="Dependency Review workflow" data-testid="dr-steps">
        @foreach (var (number, label, done) in Steps(next))
        {
            var current = !done && Steps(next).First(s => !s.Done).Number == number;
            <li class="dr-step @(done ? "dr-step-done" : current ? "dr-step-current" : "")" aria-current="@(current ? "step" : null)" data-testid="dr-step" data-step="@number" data-state="@(done ? "done" : current ? "current" : "pending")">
                <span class="dr-step-number" aria-hidden="true">@(done ? "✓" : number.ToString())</span>
                <span class="dr-step-label">@label</span>
                <span class="dr-step-state">@(done ? "Done" : current ? "Current step" : "")</span>
            </li>
        }
    </ol>

    <section class="dr-modes" aria-labelledby="dr-modes-heading" data-testid="dr-modes">
        <h2 id="dr-modes-heading" class="dr-modes-heading">1. Choose dependency evidence</h2>
        <div class="dr-mode-grid" role="group" aria-labelledby="dr-modes-heading">
            @foreach (var mode in DependencyReviewReadiness.Modes)
            {
                var selected = _mode == mode.Mode;
                <button type="button" class="dr-mode @(selected ? "active" : "")" aria-pressed="@(selected ? "true" : "false")" aria-controls="@($"dr-panel-{mode.Mode}")"
                        data-testid="dr-mode" data-mode="@mode.Mode" @ref="_modeCards[mode.Mode]" @onclick="() => SelectModeAsync(mode.Mode)">
                    <span class="dr-mode-head">
                        <span class="dr-mode-title">@mode.Title</span>
                        @if (selected) { <span class="dr-mode-selected" data-testid="dr-mode-selected"><span aria-hidden="true">✓ </span>Selected</span> }
                    </span>
                    <span class="dr-mode-sub">@mode.Summary</span>
                    <span class="dr-mode-best" data-testid="dr-mode-best">Best for: @mode.BestFor</span>
                    <span class="dr-mode-action" aria-hidden="true">@mode.Action →</span>
                </button>
            }
        </div>
    </section>

    <section class="dr-card dr-readiness" aria-labelledby="dr-readiness-heading" data-testid="dr-readiness" data-ready="@(next.Ready ? "true" : "false")">
        <h2 id="dr-readiness-heading">2. Review readiness <span class="dr-badge dr-badge-@(next.Ready ? "info" : next.Tone == "attention" ? "attention" : "muted")" data-testid="dr-readiness-state">@next.Status</span></h2>
        <p class="dr-muted" data-testid="dr-readiness-help">Readiness shows whether the inputs required for the selected review mode are available. It is not a dependency-health result.</p>

        <div class="dr-next" data-testid="dr-next" data-action="@next.Action">
            <p class="dr-next-label">Next step</p>
            <p class="dr-next-text" data-testid="dr-next-text">@next.Label</p>
            <p class="dr-muted" data-testid="dr-next-reason">@next.Reason</p>
            <div class="dr-actions">
                <button type="button" class="btn-primary" data-testid="dr-next-action" disabled="@(_busy || (next.Action == DependencyReviewNextAction.RunHealthReview && _inventoryId is null))" @onclick="NextActionAsync">@next.Label</button>
                @if (_mode != DependencyReviewMode.None) { <span class="dr-muted">Dependency evidence: <strong data-testid="dr-next-mode">@DependencyReviewReadiness.ModeName(_mode)</strong></span> }
            </div>
        </div>

        @foreach (var group in new[] { ReadinessGroup.Inputs, ReadinessGroup.Analysis, ReadinessGroup.Comparison })
        {
            var groupRows = readiness.Rows.Where(r => r.Group == group).ToList();
            var groupId = $"dr-ready-{group.ToString().ToLowerInvariant()}";
            <div class="dr-ready-group" data-testid="dr-ready-group" data-group="@group">
                <h3 id="@groupId">@group</h3>
                <table class="dr-ready-table" aria-labelledby="@groupId">
                    <thead><tr><th scope="col">@(group == ReadinessGroup.Inputs ? "Input" : "Check")</th><th scope="col">Status</th><th scope="col">@(group == ReadinessGroup.Inputs ? "Selected" : "Depends on")</th></tr></thead>
                    <tbody>
                        @foreach (var row in groupRows)
                        {
                            <tr data-testid="dr-ready-row" data-row="@row.Key">
                                <th scope="row">@row.Name</th>
                                <td data-label="Status"><span class="dr-badge dr-badge-@row.Tone" data-testid="dr-ready-state">@row.State</span>@if (group != ReadinessGroup.Inputs && row.Detail.Length > 0) { <span class="dr-muted dr-ready-detail"> @row.Detail</span> }</td>
                                <td data-label="@(group == ReadinessGroup.Inputs ? "Selected" : "Depends on")" class="dr-ready-depends" data-testid="dr-ready-depends">@(group == ReadinessGroup.Inputs ? (row.Detail.Length > 0 ? row.Detail : "—") : row.DependsOn)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="dr-sources" aria-labelledby="dr-run-heading" data-testid="dr-sources">
        <h2 class="dr-run-heading" id="dr-run-heading">3. Run review</h2>
        @if (_mode == DependencyReviewMode.None) { <p class="dr-muted" data-testid="dr-run-none">Choose dependency evidence to see how it runs.</p> }
        <section class="dr-card dr-source" id="dr-panel-Source" aria-labelledby="dr-setup-heading" data-testid="dr-setup" hidden="@(_mode != DependencyReviewMode.Source)">
            <h3 id="dr-setup-heading" tabindex="-1" @ref="_sourceHeading">Source snapshot</h3>
            <p class="dr-muted">Declared dependencies and Renovate policy of source already analyzed by Source Analysis: one primary snapshot plus any related sources you include, each reviewed separately with its own provenance. Source Analysis owns source snapshots — nothing is uploaded here, nothing is written to a repository and Renovate is not run.</p>
            <p class="dr-scope"><strong>Can assess:</strong> Renovate coverage and policy per repository, declared dependencies, version differences across the selected sources.<br /><strong>Cannot assess:</strong> registry, advisories, licenses (run the dependency health review on the resulting inventory), packaged or deployed evidence.</p>
            <SourceEvidencePrerequisite State="_scope" Prefix="dr" SourceAnalysisEnabled="FeatureViz.SourceAnalysis" ConsumerName="Dependency Review" EmptyHeadingLevel="4" ReturnTo="dependency-review"
                                        DisabledDetail="Existing inventory, SBOM and deployed evidence remain available"
                                        OtherSectionsNote="Existing inventory, SBOM and deployed evidence modes do not need a source snapshot.">
                <SourceSnapshotSelector @ref="_selector" State="_scope" Prefix="dr" Busy="_busy" MissingEvidenceLabel="no dependency evidence" OnPrimaryChanged="PrimaryChangedAsync" />
                <ReviewSourceScopePanel State="_scope" Prefix="dr" Busy="_busy" EvidenceLabel="Dependency evidence" MissingEvidenceLabel="no dependency evidence" AllowManualRelated="true"
                                        RelatedExplanation="Detected from the primary snapshot's package and project references (exact package ID or project file)."
                                        OnScopeChanged="ReloadScopeAsync" OnChangeSnapshot="FocusPrimaryAsync" />
            </SourceEvidencePrerequisite>
            <ReviewDisclosure Text="Add Renovate config override" CollapseText="Hide Renovate config override" TestId="dr-override" Class="disclosure-inline" Hint="optional">
                <p class="dr-muted">The supplied file replaces the chosen repository's in-repository configuration for this review only; the source snapshot is not changed.</p>
                <div class="dr-upload">
                    <label class="dr-field">Repository
                        <select class="form-control" data-testid="dr-override-repo" value="@_overrideRepository" @onchange="e => _overrideRepository = e.Value?.ToString() ?? string.Empty" disabled="@(ScopeRepositories.Count == 0 || _busy)">
                            <option value="">@(ScopeRepositories.Count == 0 ? "Choose a source snapshot first" : "Choose repository")</option>
                            @foreach (var repository in ScopeRepositories) { <option value="@repository">@repository</option> }
                        </select>
                    </label>
                    <label class="dr-file-button">
                        <InputFile class="dr-file-input" accept=".json,.json5,.renovaterc" OnChange="PickConfig" disabled="@_busy" aria-label="Choose a Renovate config file" data-testid="dr-override-file" />
                        <span aria-hidden="true">Choose config file</span>
                    </label>
                    <span class="dr-muted" data-testid="dr-override-picked">@(_config is null ? "No config chosen." : _config.Value.Name)</span>
                </div>
            </ReviewDisclosure>
            <div class="dr-actions">
                <button type="button" class="btn-primary" data-testid="dr-run" disabled="@(!ReadinessSelections.SourceReady || _busy)" aria-describedby="dr-run-help" @onclick="RunAsync">Run source dependency analysis</button>
                @if (!ReadinessSelections.SourceReady) { <span class="dr-muted" id="dr-run-help" data-testid="dr-run-help">Choose a primary source snapshot with dependency evidence to run the source dependency analysis.</span> }
                <p class="dr-status" role="status" aria-live="polite" data-testid="dr-status">@_status</p>
            </div>
            @if (_error is { } error) { <p class="dr-error" role="alert" data-testid="dr-error">@error</p> }
        </section>

        <section class="dr-card dr-source" id="dr-panel-Inventory" aria-labelledby="dh-inventory-heading" data-testid="dh-inventory-card" hidden="@(_mode != DependencyReviewMode.Inventory)">
            <h3 id="dh-inventory-heading" tabindex="-1" @ref="_inventoryHeading">Existing inventory</h3>
            <p class="dr-muted">Run registry, security and license checks without uploading source, on a stored inventory: a previous source review, an SBOM, a lock file or deployed evidence.</p>
            <p class="dr-scope"><strong>Can assess:</strong> registry, latest published stable, package age, deprecated/unlisted, advisories, license metadata.<br /><strong>Cannot assess:</strong> runtime loading; Renovate policy unless a source review is chosen.</p>
            <label class="dr-field">Inventory
                <select @ref="_inventorySelect" class="form-control" data-testid="dh-inventory" value="@(_inventoryId?.ToString() ?? "")" @onchange="PickInventory" disabled="@_busy">
                    <option value="">@(_inventories.Count == 0 ? "No stored inventory yet" : "Choose an inventory")</option>
                    @foreach (var inventory in _inventories) { <option value="@inventory.Id">@DependencyHealthPresentation.InventoryOption(inventory)</option> }
                </select>
            </label>
            @if (SelectedInventory is { } chosen)
            {
                <dl class="dr-inventory-summary" data-testid="dh-inventory-summary">
                    <div><dt>Inventory</dt><dd>@chosen.Name</dd></div>
                    <div><dt>Source</dt><dd>@DependencyHealthLabels.Source(chosen.SourceType) · @DependencyHealthLabels.Stage(chosen.Stage)</dd></div>
                    <div><dt>Captured</dt><dd>@DependencyHealthPresentation.Utc(chosen.CapturedAt)</dd></div>
                    <div><dt>Dependencies</dt><dd>@chosen.Dependencies</dd></div>
                    <div><dt>Freshness</dt><dd data-testid="dh-inventory-freshness"><span class="dr-badge dr-badge-@(chosen.Freshness == InventoryFreshness.Stale ? "attention" : chosen.Freshness == InventoryFreshness.Current ? "info" : "muted")">@chosen.Freshness</span> <span class="dr-muted">@chosen.FreshnessDetail</span></dd></div>
                </dl>
                <ReviewDisclosure Text="Comparison options" CollapseText="Hide comparison options" TestId="dh-options" Class="disclosure-inline" Hint="@OptionsHint">
                    <div class="dr-option-grid">
                        <label class="dr-field">Baseline (previous inventory)
                            <select class="form-control" data-testid="dh-baseline" value="@(_baselineId?.ToString() ?? "")" @onchange="e => _baselineId = ParseId(e)" disabled="@_busy">
                                <option value="">None</option>
                                @foreach (var inventory in OtherInventories) { <option value="@inventory.Id">@DependencyHealthPresentation.InventoryOption(inventory)</option> }
                            </select>
                        </label>
                        <label class="dr-field">Cross-source comparison (e.g. SBOM vs source)
                            <select class="form-control" data-testid="dh-comparison" value="@(_comparisonId?.ToString() ?? "")" @onchange="e => _comparisonId = ParseId(e)" disabled="@_busy">
                                <option value="">None</option>
                                @foreach (var inventory in OtherInventories) { <option value="@inventory.Id">@DependencyHealthPresentation.InventoryOption(inventory)</option> }
                            </select>
                        </label>
                    </div>
                    @{ var policy = DependencyReviewReadiness.PolicyStatus(chosen, _inventories.FirstOrDefault(i => i.Id == _policyInventoryId)); }
                    <div class="dr-status-line" data-testid="dh-policy-status">
                        <span class="dr-status-name">Security-fix policy</span>
                        <span class="dr-badge dr-badge-@policy.Tone">@policy.State</span>
                        <span class="dr-muted">@policy.Detail</span>
                    </div>
                    @if (chosen.SourceType != InventorySourceType.SourceReview && _inventories.Any(i => i.SourceType == InventorySourceType.SourceReview && i.SourceRunId is not null))
                    {
                        <label class="dr-field">Use the Renovate policy of a source review
                            <select class="form-control" data-testid="dh-policy" value="@(_policyInventoryId?.ToString() ?? "")" @onchange="e => _policyInventoryId = ParseId(e)" disabled="@_busy">
                                <option value="">None</option>
                                @foreach (var inventory in _inventories.Where(i => i.SourceType == InventorySourceType.SourceReview && i.SourceRunId is not null)) { <option value="@inventory.Id">@inventory.Name</option> }
                            </select>
                        </label>
                    }
                    <div class="dr-status-line" data-testid="dh-deployed-status">
                        <span class="dr-status-name">Deployed evidence</span>
                        <span class="dr-badge dr-badge-@(_deployedId is null ? "muted" : "info")">@(_deployedId is null ? "Not selected" : "Selected")</span>
                        <span class="dr-muted">@(_inventories.FirstOrDefault(i => i.Id == _deployedId)?.Name ?? "Choose it in Deployed evidence.")</span>
                    </div>
                    <p class="dr-muted">Nothing is merged silently: each comparison is shown separately with both sources.</p>
                </ReviewDisclosure>
            }
            <div class="dr-actions">
                <button type="button" class="btn-primary" data-testid="dh-run" disabled="@(_inventoryId is null || _busy)" aria-describedby="dh-run-help" @onclick="RunHealthAsync">Run dependency health review</button>
                @if (_inventoryId is null) { <span class="dr-muted" id="dh-run-help" data-testid="dh-run-help">Choose an inventory to run the dependency health review.</span> }
            </div>
        </section>

        <section class="dr-card dr-source" id="dr-panel-Sbom" aria-labelledby="dh-sbom-heading" data-testid="dh-sbom-card" hidden="@(_mode != DependencyReviewMode.Sbom)">
            <h3 id="dh-sbom-heading" tabindex="-1" @ref="_sbomHeading">Review SBOM</h3>
            <p class="dr-muted">Supported: CycloneDX JSON/XML and SPDX JSON (validated against the official schemas), NuGet packages.lock.json. An invalid document never becomes an inventory.</p>
            <p class="dr-scope"><strong>Can assess:</strong> components, relationships, identifiers, hashes, licenses, then dependency health.<br /><strong>Cannot assess:</strong> SBOM completeness, runtime loading.</p>
            <div class="dr-upload">
                <label class="dr-file-button">
                    <InputFile @ref="_sbomInput" class="dr-file-input" accept=".json,.xml,.cdx,.spdx" OnChange="PickSbom" disabled="@_busy" aria-label="Choose an SBOM or packages.lock.json" data-testid="dh-sbom-file" />
                    <span aria-hidden="true">Upload SBOM</span>
                </label>
                <span class="dr-muted" data-testid="dh-sbom-picked">@(_sbom is null ? "No document chosen." : _sbom.Value.Name)</span>
            </div>
            @if (_sbom is not null)
            {
                <div class="dr-option-grid" data-testid="dh-sbom-metadata">
                    <label class="dr-field">The SBOM describes (provenance)
                        <select class="form-control" data-testid="dh-sbom-role" value="@_sbomRole" @onchange="e => _sbomRole = Enum.TryParse<SbomRole>(e.Value?.ToString(), out var r) ? r : SbomRole.BuildArtifact" disabled="@_busy">
                            <option value="@SbomRole.BuildArtifact">A build artifact (packaged)</option>
                            <option value="@SbomRole.DeployedArtifact">What is deployed to an environment</option>
                        </select>
                    </label>
                    <label class="dr-field">Environment (optional)<input class="form-control" data-testid="dh-sbom-env" @bind="_sbomEnvironment" placeholder="e.g. qa" /></label>
                    <label class="dr-field">Name (optional)<input class="form-control" data-testid="dh-sbom-name" @bind="_sbomName" placeholder="e.g. Build 2026.09.28" /></label>
                </div>
                <div class="dr-actions">
                    <button type="button" class="btn-primary" data-testid="dh-sbom-run" disabled="@_busy" @onclick="ReviewSbomAsync">Review SBOM</button>
                </div>
            }
            @if (_validation is { } v)
            {
                <div class="dr-validation" data-testid="dh-sbom-validation" data-valid="@(v.Valid ? "true" : "false")">
                    <p><span class="dr-badge dr-badge-@(v.Valid ? "info" : "attention")">@(v.Valid ? "Validated" : "Invalid SBOM")</span> @DependencyHealthLabels.Format(v.Format)@(v.SpecVersion is null ? "" : $" {v.SpecVersion}")@(v.Valid ? $" · {v.Components} components" : "")</p>
                    @if (v.Valid)
                    {
                        <p class="dr-muted" data-testid="dh-sbom-coverage">@v.Components components · @v.Direct direct · @v.Transitive transitive · @v.UnknownRelationship unknown relationship · @(string.Join(", ", v.Ecosystems.Select(e => $"{e.Key} {e.Value}"))) · missing: @v.MissingVersions versions, @v.MissingIdentifiers identifiers, @v.MissingLicenses licenses · @v.WithHashes with hashes · dependency graph @(v.HasDependencyGraph ? "present" : "absent"). Completeness is not claimed.</p>
                    }
                    @if (v.Errors.Count + v.Warnings.Count + v.NotAssessed.Count > 0)
                    {
                        <ul class="dr-list" data-testid="dh-sbom-messages">
                            @foreach (var e in v.Errors) { <li>@e</li> }
                            @foreach (var w in v.Warnings) { <li>@w</li> }
                            @foreach (var n in v.NotAssessed) { <li>Not assessed: @n</li> }
                        </ul>
                    }
                </div>
            }
        </section>

        <section class="dr-card dr-source" id="dr-panel-Deployed" aria-labelledby="dh-deployed-heading" data-testid="dh-deployed-card" hidden="@(_mode != DependencyReviewMode.Deployed)">
            <h3 id="dh-deployed-heading" tabindex="-1" @ref="_deployedHeading">Deployed evidence</h3>
            <p class="dr-muted">Compare a known inventory with what a Target Environment serves (its Blazor boot manifest), or use a deployed-artifact SBOM from Review SBOM.</p>
            <p class="dr-scope"><strong>Can assess:</strong> expected vs deployed where versions are proven.<br /><strong>Cannot assess:</strong> versions from a boot manifest, absence unless proven, runtime loading.</p>
            <label class="dr-field">Target Environment
                <select @ref="_targetSelect" class="form-control" data-testid="dh-deployed-target" value="@(_targetId ?? "")" @onchange="e => _targetId = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString()" disabled="@_busy">
                    <option value="">@(Targets.Count == 0 ? "No Target Environment with a URL" : "Select target")</option>
                    @foreach (var target in Targets) { <option value="@target.Id">@target.Name — @target.TargetUrl</option> }
                </select>
            </label>
            @if (SelectedTarget is { } t)
            {
                <dl class="dr-inventory-summary" data-testid="dh-target-summary">
                    <div><dt>Target</dt><dd>@t.Name</dd></div>
                    <div><dt>URL</dt><dd class="dr-mono" data-testid="dh-target-url">@t.TargetUrl</dd></div>
                    <div><dt>Environment</dt><dd data-testid="dh-target-environment">@t.EnvironmentType</dd></div>
                    <div><dt>Evidence method</dt><dd>Blazor boot manifest — assembly files and integrity hashes, not package versions</dd></div>
                </dl>
            }
            <ReviewDisclosure Text="Advanced: use manual target URL" CollapseText="Hide manual target URL" TestId="dh-deployed-manual" Class="disclosure-inline">
                <p class="dr-muted">Only when the target is not a Target Environment. A selected Target Environment takes precedence.</p>
                <div class="dr-option-grid">
                    <label class="dr-field">Target URL<input class="form-control" type="url" data-testid="dh-deployed-url" @bind="_targetUrl" @bind:event="oninput" placeholder="https://…" /></label>
                    <label class="dr-field">Environment (optional)<input class="form-control" data-testid="dh-deployed-env" @bind="_targetEnvironment" placeholder="e.g. qa" /></label>
                </div>
            </ReviewDisclosure>
            <div class="dr-actions">
                <button type="button" class="btn-primary" data-testid="dh-deployed-capture" disabled="@(CaptureUrl is null || _busy)" aria-describedby="dh-deployed-help" @onclick="CaptureDeployedAsync">Capture deployed evidence</button>
                @if (CaptureUrl is null) { <span class="dr-muted" id="dh-deployed-help" data-testid="dh-deployed-help">Select a Target Environment to capture deployed evidence.</span> }
            </div>
            @if (_inventories.Any(i => i.Stage == InventoryStage.Deployed && i.Id != _inventoryId))
            {
                <label class="dr-field">Deployed evidence for the next health review
                    <select class="form-control" data-testid="dh-deployed" value="@(_deployedId?.ToString() ?? "")" @onchange="e => _deployedId = ParseId(e)" disabled="@_busy">
                        <option value="">Not assessed</option>
                        @foreach (var inventory in _inventories.Where(i => i.Stage == InventoryStage.Deployed && i.Id != _inventoryId)) { <option value="@inventory.Id">@DependencyHealthPresentation.InventoryOption(inventory)</option> }
                    </select>
                </label>
            }
        </section>
    </section>

    <div class="dr-live">
        <p class="dr-status" role="status" aria-live="polite" data-testid="dh-status">@_healthStatus</p>
        @if (_healthError is { } healthError) { <p class="dr-error" role="alert" data-testid="dh-error">@healthError</p> }
    </div>

    @if (_history.Count > 0 || _healthHistory.Count > 0)
    {
        <section class="dr-card dr-history-card" aria-labelledby="dr-previous-heading" data-testid="dr-previous">
            <h2 id="dr-previous-heading">Previous reviews</h2>
            <p class="dr-muted" data-testid="dr-previous-summary">@_history.Count source review@(_history.Count == 1 ? "" : "s") · @_healthHistory.Count dependency health review@(_healthHistory.Count == 1 ? "" : "s") — opened exactly as recorded, no registry or advisory source is queried.</p>
            <ReviewDisclosure Text="Open history" CollapseText="Hide history" TestId="dr-history-disclosure" Class="disclosure-inline">
                <div class="dr-option-grid">
                    @if (_history.Count > 0)
                    {
                        <label class="dr-field dr-history">Source reviews (Renovate policy)
                            <select class="form-control" data-testid="dr-history" value="@(_result?.RunId.ToString() ?? "")" @onchange="OpenRunAsync" disabled="@_busy">
                                <option value="">Choose a stored review</option>
                                @foreach (var run in _history) { <option value="@run.RunId">@run.CompletedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC · @run.Label (@run.Findings findings)</option> }
                            </select>
                        </label>
                    }
                    @if (_healthHistory.Count > 0)
                    {
                        <label class="dr-field dr-history">Dependency health reviews
                            <select class="form-control" data-testid="dh-history" value="@(_health?.RunId.ToString() ?? "")" @onchange="OpenHealthAsync" disabled="@_busy">
                                <option value="">Choose a stored review</option>
                                @foreach (var run in _healthHistory) { <option value="@run.RunId">@run.CompletedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC · @run.Label (@run.Dependencies deps, @run.Findings findings)@(run.RefreshOf is not null ? " · refresh" : "")</option> }
                            </select>
                        </label>
                    }
                </div>
            </ReviewDisclosure>
        </section>
    }

    @if (_result is not null && _health is not null)
    {
        <div class="dr-view-switch" role="group" aria-label="Result shown">
            <button type="button" class="dr-chip @(_view == ResultView.Health ? "active" : "")" aria-pressed="@(_view == ResultView.Health ? "true" : "false")" data-testid="dr-view-health" @onclick="() => _view = ResultView.Health">Dependency health result</button>
            <button type="button" class="dr-chip @(_view == ResultView.Source ? "active" : "")" aria-pressed="@(_view == ResultView.Source ? "true" : "false")" data-testid="dr-view-source" @onclick="() => _view = ResultView.Source">Source review result</button>
        </div>
    }

    @if (_view == ResultView.Health && _health is { } health)
    {
        <DependencyHealthResult Run="health" Busy="_busy" OnRefresh="RefreshHealthAsync" OnExport="ExportHealthHtml" />
    }

    @if (_view == ResultView.Source && _result is { } result)
    {
        <section class="dr-card" aria-labelledby="dr-summary-heading" data-testid="dr-summary">
            <h2 id="dr-summary-heading">Summary</h2>
            <p data-testid="dr-headline">@DependencyReviewPresentation.Headline(result)</p>
            <ul class="dr-categories">
                @foreach (var category in result.Categories)
                {
                    <li class="dr-category" data-testid="dr-category" data-category="@category.Name">
                        <span class="dr-category-name">@category.Name</span>
                        <span class="dr-badge dr-badge-@DependencyReviewPresentation.Tone(category.State)">@DependencyLabels.Category(category.State)</span>
                        <span class="dr-muted">@category.Detail</span>
                    </li>
                }
            </ul>
            <ReviewDisclosure Text="How this is evaluated" CollapseText="Hide evaluation details" TestId="dr-mechanism" Class="disclosure-inline">
                <p>@result.EvaluationMechanism</p>
                <ul class="dr-list" data-testid="dr-unsupported">@foreach (var item in result.UnsupportedSemantics) { <li>@item</li> }</ul>
                <p class="dr-muted">Simulated versions are synthetic candidates that test policy — not observed, available or published versions. The source review uses no vulnerability source, so nothing here is a vulnerability status; advisories are checked in the dependency health review.</p>
            </ReviewDisclosure>
        </section>

        <section class="dr-card" aria-labelledby="dr-result-scope-heading" data-testid="dr-result-scope">
            <h2 id="dr-result-scope-heading">Source scope</h2>
            @if (result.SourceScope is { } scope)
            {
                <p class="dr-muted">The exact Source Analysis snapshots this run reviewed. Newer snapshots never change this result.</p>
                <ul class="dr-scope-list">
                    @foreach (var (entry, role) in new[] { (scope.Primary, "Primary") }.Concat(scope.Related.Select(r => (r, "Related"))))
                    {
                        var repoReview = result.Repositories.FirstOrDefault(r => r.Repository == entry.Repository);
                        <li data-testid="dr-result-scope-entry" data-role="@role" data-snapshot="@entry.SnapshotId">
                            <span class="dr-badge dr-badge-@(role == "Primary" ? "info" : "muted")">@role</span> <strong>@entry.Repository</strong> · @entry.ArchiveName · <code title="@entry.Fingerprint">@Short(entry.Fingerprint)</code> · Source Analysis: @entry.SourceStatus
                            @if (repoReview is not null) { <span> · Renovate policy: <span class="dr-badge dr-badge-@DependencyReviewPresentation.Tone(repoReview.Coverage)" data-testid="dr-result-scope-renovate">@DependencyReviewPresentation.Coverage(repoReview.Coverage)</span></span> }
                        </li>
                    }
                </ul>
                @if (scope.Limitations.Count > 0) { <ul class="dr-list" data-testid="dr-result-scope-limitations">@foreach (var l in scope.Limitations) { <li>@l</li> }</ul> }
            }
            else
            {
                <p class="dr-muted" data-testid="dr-result-legacy">Legacy source input: repository archives uploaded directly to Dependency Review before Source Analysis owned source snapshots. No Source Analysis snapshot is linked to this run.</p>
            }
        </section>

        @if (result.Repositories.Count > 1)
        {
            <section class="dr-card" aria-labelledby="dr-cross-heading" data-testid="dr-cross-source">
                <h2 id="dr-cross-heading">Cross-source differences <span class="dr-badge dr-badge-@(result.CrossSource.Count == 0 ? "muted" : "attention")" data-testid="dr-cross-count">@result.CrossSource.Count package@(result.CrossSource.Count == 1 ? "" : "s")</span></h2>
                <p class="dr-muted">The same dependency declared differently in the selected sources, compared as declared. An observation to review — not a failure, vulnerability or incompatibility; registry and advisory checks stay separate.</p>
                @if (result.CrossSource.Count > 0)
                {
                    <ReviewDisclosure Text="View cross-source differences" CollapseText="Hide cross-source differences" TestId="dr-cross-detail" Class="disclosure-inline">
                        <div class="dr-table-wrap" tabindex="0" role="region" aria-label="Cross-source differences">
                            <table class="dr-table" data-testid="dr-cross-table"><thead><tr><th scope="col">Dependency</th><th scope="col">Declared per source</th><th scope="col">State</th></tr></thead><tbody>
                                @foreach (var o in result.CrossSource)
                                {
                                    <tr data-testid="dr-cross-row" data-package="@o.PackageName"><th scope="row">@o.PackageName <span class="dr-muted">· @o.Manager</span></th>
                                        <td><ul class="dr-list">@foreach (var v in o.Values) { <li><strong>@v.Repository</strong> @(v.Value ?? "(no version)") <span class="dr-muted">@string.Join(" · ", v.Files.Take(3))</span></li> }</ul></td>
                                        <td><span class="dr-badge dr-badge-muted">@o.Kind</span></td></tr>
                                }
                            </tbody></table>
                        </div>
                    </ReviewDisclosure>
                }
                @if (result.SourceRelationships.Count > 0)
                {
                    <h3>Source relationships</h3>
                    <ul class="dr-list" data-testid="dr-source-relationships">@foreach (var r in result.SourceRelationships) { <li><strong>@r.FromRepository</strong> references package @r.PackageName @string.Join(", ", r.ReferencedValues) (@r.Projects project(s)) — produced by <strong>@r.ToRepository</strong>@(r.PublishedVersion is { } published ? $", which declares version {published}" : "") (exact package ID).</li> }</ul>
                }
            </section>
        }

        <nav class="dr-tabs" aria-label="Repositories">
            @foreach (var tab in result.Repositories)
            {
                <button type="button" class="dr-tab @(tab.Repository == Selected?.Repository ? "active" : "")" aria-pressed="@(tab.Repository == Selected?.Repository ? "true" : "false")"
                        data-testid="dr-repo-tab" data-repository="@tab.Repository" @onclick="() => SelectRepository(tab.Repository)">
                    @tab.Repository <span class="dr-badge dr-badge-@DependencyReviewPresentation.Tone(tab.Coverage)">@DependencyReviewPresentation.Coverage(tab.Coverage)</span>
                </button>
            }
        </nav>

        @if (Selected is { } repo)
        {
            <section class="dr-card" aria-labelledby="dr-repo-heading" data-testid="dr-repo" data-repository="@repo.Repository">
                <h2 id="dr-repo-heading">@repo.Repository</h2>
                <dl class="dr-facts">
                    <div><dt>Renovate coverage</dt><dd><span class="dr-badge dr-badge-@DependencyReviewPresentation.Tone(repo.Coverage)" data-testid="dr-coverage">@DependencyReviewPresentation.Coverage(repo.Coverage)</span> @repo.CoverageDetail</dd></div>
                    <div><dt>Declared dependencies</dt><dd data-testid="dr-dep-count">@repo.Dependencies.Count (declared only; transitive dependencies are not inventoried)</dd></div>
                    <div><dt>Archive / config hash</dt><dd class="dr-mono">@DependencyReviewPresentation.Short(repo.ArchiveSha256) / @DependencyReviewPresentation.Short(repo.ConfigHash)</dd></div>
                    @if (repo.DriftSincePrevious is { } drift) { <div><dt>Drift</dt><dd data-testid="dr-drift">@drift</dd></div> }
                </dl>

                <h3>Findings</h3>
                @if (repo.Findings.Count == 0) { <p class="dr-muted" data-testid="dr-no-findings">No findings.</p> }
                <ul class="dr-findings" data-testid="dr-findings">
                    @foreach (var finding in DependencyReviewPresentation.OrderedFindings(repo))
                    {
                        <li class="dr-finding" data-testid="dr-finding" data-rule="@finding.RuleId">
                            <div><span class="dr-badge dr-badge-@DependencyReviewPresentation.Tone(finding.Severity)">@DependencyLabels.Severity(finding.Severity)</span> <strong>@finding.Title</strong></div>
                            <p>@finding.Detail</p>
                            @if (finding.Evidence.Count > 0)
                            {
                                <ReviewDisclosure Text="Evidence" CollapseText="Hide evidence" Class="disclosure-inline">
                                    <ul class="dr-list dr-mono">@foreach (var evidence in finding.Evidence) { <li>@evidence</li> }</ul>
                                </ReviewDisclosure>
                            }
                        </li>
                    }
                </ul>

                <h3>Configuration</h3>
                @if (repo.ConfigFiles.Count == 0) { <p class="dr-muted" data-testid="dr-no-config">No Renovate configuration file in this repository.</p> }
                else
                {
                    <div class="dr-table-wrap" tabindex="0" role="region" aria-label="Renovate configuration files">
                        <table class="dr-table" data-testid="dr-config-files">
                            <thead><tr><th scope="col">File</th><th scope="col">Read by Renovate</th><th scope="col">Syntax</th><th scope="col">Note</th></tr></thead>
                            <tbody>
                                @foreach (var file in repo.ConfigFiles)
                                {
                                    <tr><td class="dr-mono">@file.Path</td><td>@(file.Used ? "Yes" : "No")</td><td>@(file.SyntaxValid ? "Valid JSON" : file.SyntaxError ?? "Invalid")</td><td>@file.Note</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                @if (repo.ValidationIssues.Count + repo.UnrecognizedKeys.Count > 0)
                {
                    <ul class="dr-list" data-testid="dr-validation">
                        @foreach (var issue in repo.ValidationIssues) { <li>@issue</li> }
                        @if (repo.UnrecognizedKeys.Count > 0) { <li>Not evaluated by BirkNext (not invalid): <span class="dr-mono">@string.Join(", ", repo.UnrecognizedKeys)</span></li> }
                    </ul>
                }
                @if (repo.RepositorySettings.Count > 0)
                {
                    <ReviewDisclosure Text="Repository-level settings" CollapseText="Hide repository-level settings" TestId="dr-settings" Class="disclosure-inline">
                        <dl class="dr-kv">
                            @foreach (var setting in repo.RepositorySettings) { <div><dt class="dr-mono">@setting.Key</dt><dd class="dr-mono">@setting.Value</dd></div> }
                            @if (repo.Extends.Count > 0) { <div><dt class="dr-mono">extends</dt><dd class="dr-mono">@string.Join(", ", repo.Extends) (not expanded)</dd></div> }
                            @if (repo.IgnorePaths.Count > 0) { <div><dt class="dr-mono">ignorePaths</dt><dd class="dr-mono">@string.Join(", ", repo.IgnorePaths)</dd></div> }
                            @if (repo.IgnoreDeps.Count > 0) { <div><dt class="dr-mono">ignoreDeps</dt><dd class="dr-mono">@string.Join(", ", repo.IgnoreDeps)</dd></div> }
                        </dl>
                    </ReviewDisclosure>
                }

                <h3>Managers</h3>
                <div class="dr-table-wrap" tabindex="0" role="region" aria-label="Managers">
                    <table class="dr-table" data-testid="dr-managers">
                        <thead><tr><th scope="col">Manager</th><th scope="col">Files</th><th scope="col">Declared</th><th scope="col">State</th><th scope="col">Detail</th></tr></thead>
                        <tbody>
                            @foreach (var manager in repo.Managers)
                            {
                                <tr data-manager="@manager.Manager"><td>@manager.Manager</td><td>@manager.Files</td><td>@manager.Dependencies</td>
                                    <td><span class="dr-badge dr-badge-@DependencyReviewPresentation.Tone(manager.State)">@DependencyLabels.Manager(manager.State)</span></td><td>@manager.Detail</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (repo.Rules.Count > 0)
                {
                    <ReviewDisclosure Text="@($"packageRules ({repo.Rules.Count})")" CollapseText="Hide packageRules" TestId="dr-rules" Class="disclosure-inline">
                        <p class="dr-muted">Rules apply in order; each matching rule is merged over the earlier ones, so a later rule overrides the settings it sets.</p>
                        <div class="dr-table-wrap" tabindex="0" role="region" aria-label="Package rules">
                            <table class="dr-table" data-testid="dr-rules-table">
                                <thead><tr><th scope="col">#</th><th scope="col">Description</th><th scope="col">Matchers</th><th scope="col">Settings</th><th scope="col">Matches</th><th scope="col">Location</th></tr></thead>
                                <tbody>
                                    @foreach (var rule in repo.Rules)
                                    {
                                        <tr><td>@rule.Index</td><td>@rule.Description</td>
                                            <td class="dr-mono">@string.Join("; ", rule.Matchers.Select(m => $"{m.Key} [{string.Join(", ", m.Value)}]"))@if (rule.DeprecatedKeys.Count > 0) { <span class="dr-muted"> (deprecated: @string.Join(", ", rule.DeprecatedKeys))</span> }</td>
                                            <td class="dr-mono">@string.Join("; ", rule.Settings.Where(s => s.Key is not ("prBodyNotes" or "commitMessageTopic")).Select(s => $"{s.Key}: {s.Value}"))</td>
                                            <td>@rule.MatchedDependencies</td><td class="dr-mono">@(rule.Location is { } l ? $"{l.File}:{l.Line}" : "")</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </ReviewDisclosure>
                }

                @if (repo.Simulations.Count > 0)
                {
                    <h3>Policy simulation</h3>
                    <p class="dr-muted">Each scenario tests a <strong>@DependencyLabels.SyntheticCandidate.ToLowerInvariant()</strong> against the configuration — a test value, not a version that exists.</p>
                    <div class="dr-filter" role="group" aria-label="Filter by result">
                        <button type="button" class="dr-chip @(_filter is null ? "active" : "")" aria-pressed="@(_filter is null ? "true" : "false")" data-testid="dr-filter-all" @onclick="() => _filter = null">All (@repo.Simulations.Count)</button>
                        @foreach (var (value, count) in DependencyReviewPresentation.ResultCounts(repo))
                        {
                            <button type="button" class="dr-chip @(_filter == value ? "active" : "")" aria-pressed="@(_filter == value ? "true" : "false")" data-testid="dr-filter" data-result="@value" @onclick="() => _filter = value">@DependencyLabels.Result(value) (@count)</button>
                        }
                    </div>
                    <div class="dr-table-wrap" tabindex="0" role="region" aria-label="Policy simulation matrix">
                        <table class="dr-table dr-matrix" data-testid="dr-matrix">
                            <thead><tr><th scope="col">Package</th><th scope="col">Current</th><th scope="col">Scenario</th><th scope="col">@DependencyLabels.SyntheticCandidate</th><th scope="col">Update type</th><th scope="col">Result</th><th scope="col">Why</th></tr></thead>
                            <tbody>
                                @foreach (var sim in DependencyReviewPresentation.Matrix(repo, _filter))
                                {
                                    <tr data-testid="dr-sim" data-result="@sim.Result">
                                        <td class="dr-cell-package"><span class="dr-pkg">@sim.PackageName</span><span class="dr-muted dr-mono">@sim.OwnerFile</span></td>
                                        <td class="dr-mono" data-label="Current">@sim.CurrentValue</td><td data-label="Scenario">@sim.Scenario</td>
                                        <td class="dr-mono" data-label="@DependencyLabels.SyntheticCandidate">@(sim.CandidateVersion ?? "—")</td>
                                        <td data-label="Update type">@DependencyReviewPresentation.UpdateType(sim.UpdateType)</td>
                                        <td data-label="Result"><span class="dr-badge dr-badge-@DependencyReviewPresentation.Tone(sim.Result)">@DependencyReviewPresentation.Outcome(sim)</span></td>
                                        <td class="dr-cell-why"><ReviewDisclosure Text="Why this policy" CollapseText="Hide" Class="disclosure-inline"><SimulationExplanation Simulation="sim" /></ReviewDisclosure></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (repo.NormalizedConfig is not null)
                {
                    <section class="dr-sim" aria-labelledby="dr-single-heading" data-testid="dr-single">
                        <h3 id="dr-single-heading">Simulate one package</h3>
                        <p class="dr-muted">Evaluated against this review's stored configuration snapshot. Enter any synthetic candidate to test the policy.</p>
                        <div class="dr-sim-form">
                            <label class="dr-field">Declared package
                                <select class="form-control" data-testid="dr-single-package" @onchange="e => PickPackage(repo, e.Value?.ToString())">
                                    <option value="">Custom package…</option>
                                    @foreach (var (dep, index) in DependencyReviewPresentation.Packages(repo).Select((d, i) => (d, i))) { <option value="@index">@dep.PackageName · @dep.OwnerFile</option> }
                                </select>
                            </label>
                            <label class="dr-field">Package name<input class="form-control" data-testid="dr-single-name" @bind="_single.PackageName" /></label>
                            <label class="dr-field">Manager
                                <select class="form-control" data-testid="dr-single-manager" @bind="_single.Manager">
                                    @foreach (var manager in new[] { "nuget", "dockerfile", "docker-compose", "azure-pipelines" }) { <option value="@manager">@manager</option> }
                                </select>
                            </label>
                            <label class="dr-field">File<input class="form-control" data-testid="dr-single-file" @bind="_single.File" placeholder="e.g. Aspire/Aspire.csproj" /></label>
                            <label class="dr-field">Current version<input class="form-control" data-testid="dr-single-current" @bind="_single.Current" /></label>
                            <label class="dr-field">@DependencyLabels.SyntheticCandidate<input class="form-control" data-testid="dr-single-candidate" @bind="_single.Candidate" /></label>
                            <button type="button" class="btn-secondary" data-testid="dr-single-run" disabled="@_busy" @onclick="() => SimulateAsync(repo)">Simulate</button>
                        </div>
                        @if (_singleError is { } singleError) { <p class="dr-error" role="alert" data-testid="dr-single-error">@singleError</p> }
                        @if (_singleResult is { } single && single.Repository == repo.Repository)
                        {
                            <div class="dr-single-result" data-testid="dr-single-result" aria-live="polite">
                                <p><strong>@single.PackageName</strong> @single.CurrentValue → <span class="dr-mono">@single.CandidateVersion</span> <span class="dr-muted">(@DependencyLabels.SyntheticCandidate)</span> ·
                                    @DependencyReviewPresentation.UpdateType(single.UpdateType) · <span class="dr-badge dr-badge-@DependencyReviewPresentation.Tone(single.Result)" data-testid="dr-single-outcome">@DependencyReviewPresentation.Outcome(single)</span></p>
                                <SimulationExplanation Simulation="single" />
                            </div>
                        }
                    </section>
                }

                <h3>Security-update policy</h3>
                <p data-testid="dr-security"><span class="dr-badge dr-badge-@DependencyReviewPresentation.Tone(repo.SecurityUpdatePolicy.State)">@DependencyLabels.Category(repo.SecurityUpdatePolicy.State)</span> @repo.SecurityUpdatePolicy.Detail</p>
                <h3>Runtime automation</h3>
                <p data-testid="dr-runtime"><span class="dr-badge dr-badge-muted">@DependencyLabels.Category(repo.RuntimeAutomation.State)</span> @repo.RuntimeAutomation.Detail</p>

                <ReviewDisclosure Text="@($"Declared dependencies ({repo.Dependencies.Count})")" CollapseText="Hide declared dependencies" TestId="dr-deps" Class="disclosure-inline">
                    <div class="dr-table-wrap" tabindex="0" role="region" aria-label="Declared dependencies">
                        <table class="dr-table" data-testid="dr-deps-table">
                            <thead><tr><th scope="col">Package</th><th scope="col">Manager</th><th scope="col">Declared value</th><th scope="col">Owner file</th><th scope="col">Renovate</th></tr></thead>
                            <tbody>
                                @foreach (var dep in repo.Dependencies)
                                {
                                    <tr><td>@dep.PackageName @if (dep.ReferencedBy.Count > 1) { <span class="dr-muted">(@dep.ReferencedBy.Count projects)</span> }</td><td>@dep.Manager</td>
                                        <td class="dr-mono">@(dep.CurrentValue ?? "—")</td><td class="dr-mono">@DependencyReviewPresentation.Location(dep)</td><td>@(dep.IgnoredBy ?? "Processed")</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </ReviewDisclosure>
            </section>
        }
    }
</div>

@code {
    // ── Source snapshot scope: Source Analysis snapshots only (read, never uploaded or changed here) ──
    private string? _environmentId;
    /// <summary>The source scope being edited with the shared source components (explicit choices only).</summary>
    private readonly ReviewSourceScopeState _scope = new();
    private SourceSnapshotSelector? _selector;
    private (string Name, byte[] Bytes)? _config;
    private string _overrideRepository = string.Empty;
    private DependencyReviewResult? _result;
    private IReadOnlyList<DependencyReviewRunSummary> _history = [];
    private string? _selectedRepository;
    private PolicyResult? _filter;
    private bool _busy;
    private string? _status;
    private string? _error;
    private readonly SingleForm _single = new();
    private PolicySimulation? _singleResult;
    private string? _singleError;

    private sealed class SingleForm
    {
        public string PackageName { get; set; } = "";
        public string Manager { get; set; } = "nuget";
        public string? File { get; set; }
        public string Current { get; set; } = "";
        public string Candidate { get; set; } = "";
    }

    private RepositoryDependencyReview? Selected => _result?.Repositories.FirstOrDefault(r => r.Repository == _selectedRepository) ?? _result?.Repositories.FirstOrDefault();

    protected override async Task OnInitializedAsync()
    {
        try { _history = await Api.HistoryAsync(); }
        catch (Exception ex) when (BackendRequestClassifier.IsRequestFailure(ex)) { _status = BackendRequestClassifier.FromException("Stored reviews", ex).UserMessage; }
        await LoadHealthListsAsync();
        await LoadSourcesAsync();
        try { if (!TargetSettings.IsLoaded) await TargetSettings.LoadAsync(JS); }
        catch (Exception ex) when (ex is JSException or InvalidOperationException) { /* no Target Environments: the manual URL remains */ }
    }

    // ── Pre-run workflow ────────────────────────────────────────────────────────────────────────────────────────────

    private DependencyReviewMode _mode = DependencyReviewMode.None;
    private ElementReference _sourceHeading;
    private ElementReference _inventoryHeading;
    private ElementReference _sbomHeading;
    private ElementReference _deployedHeading;
    private bool _focusMode;
    private string? _targetId;

    /// <summary>Target Environments with a URL (the Target Environment owns URL and environment; nothing is copied).</summary>
    private IReadOnlyList<BirkNext.Web.Models.FrontendAnalysisProfile> Targets =>
        TargetSettings.IsLoaded ? TargetSettings.Settings.Profiles.Where(p => !string.IsNullOrWhiteSpace(p.TargetUrl)).ToList() : [];
    private BirkNext.Web.Models.FrontendAnalysisProfile? SelectedTarget => Targets.FirstOrDefault(t => t.Id == _targetId);
    /// <summary>The selected Target Environment's URL; the manual URL (advanced) only when no target is selected.</summary>
    private string? CaptureUrl => SelectedTarget?.TargetUrl ?? (string.IsNullOrWhiteSpace(_targetUrl) ? null : _targetUrl.Trim());

    private ReadinessView Readiness => DependencyReviewReadiness.Evaluate(ReadinessSelections);

    private ReadinessInput ReadinessSelections => new()
    {
        Mode = _mode, Inventory = SelectedInventory,
        SourceAnalysisDisabled = !FeatureViz.SourceAnalysis, SourceSnapshotsAvailable = FeatureViz.SourceAnalysis && _scope.Snapshots.Count > 0,
        PrimarySource = Primary is { } p ? $"{p.Repository} · {Short(p.Fingerprint)}" : null, PrimaryHasEvidence = Primary?.HasConsumerEvidence == true, PrimaryEvidenceNote = Primary?.ConsumerEvidenceNote,
        RelatedIncluded = _scope.Related.Count, RelatedSummary = string.Join(", ", _scope.Related.Values.Select(id => _scope.Snapshots.FirstOrDefault(s => s.SnapshotId == id)).OfType<ReviewSourceSnapshot>().Select(s => $"{s.Repository} · {Short(s.Fingerprint)}")),
        RelatedNotIncluded = NotIncludedAvailable.Count, ScopeProblem = ScopeProblem, PendingSbom = _sbom?.Name, SbomInvalid = _validation is { Valid: false },
        PolicyInventory = _inventories.FirstOrDefault(i => i.Id == _policyInventoryId), Deployed = _inventories.FirstOrDefault(i => i.Id == _deployedId),
        DeploymentTarget = SelectedTarget?.Name, SbomReviewed = _validation is { Valid: true }, CanCaptureDeployed = CaptureUrl is not null,
    };

    private DependencyReviewNextStep NextStep => DependencyReviewReadiness.NextStep(ReadinessSelections);

    /// <summary>Workflow hint: 1 when a source is chosen, 2 when its inputs are ready, 3 when a review result is shown this session.</summary>
    private IReadOnlyList<(int Number, string Label, bool Done)> Steps(DependencyReviewNextStep next) =>
    [
        (1, "Choose evidence", _mode != DependencyReviewMode.None),
        (2, "Check readiness", next.Ready),
        (3, "Run review", next.Ready && (_result is not null || _health is not null)),
    ];

    private readonly Dictionary<DependencyReviewMode, ElementReference> _modeCards = new();
    private InputFile? _sbomInput;
    private ElementReference _inventorySelect;
    private ElementReference _targetSelect;
    private Func<ElementReference?>? _focusControl;

    /// <summary>The next step's action: Choose* opens the right panel and focuses its control; the others call the panel's own command.</summary>
    private async Task NextActionAsync()
    {
        void Choose(DependencyReviewMode mode, Func<ElementReference?> control) { _mode = mode; _focusControl = control; }
        switch (NextStep.Action)
        {
            case DependencyReviewNextAction.ChooseReviewSource: _focusControl = () => _modeCards.TryGetValue(DependencyReviewMode.Source, out var card) ? card : null; break;
            case DependencyReviewNextAction.ChooseSourceSnapshot: Choose(DependencyReviewMode.Source, () => _selector?.SelectElement); break;
            case DependencyReviewNextAction.ResolveSourceScope: Choose(DependencyReviewMode.Source, () => _selector?.SelectElement); break;
            case DependencyReviewNextAction.OpenSourceAnalysis: Navigation.NavigateTo("source-analysis"); break;
            case DependencyReviewNextAction.ChooseInventory: Choose(DependencyReviewMode.Inventory, () => _inventorySelect); break;
            case DependencyReviewNextAction.UploadSbom: Choose(DependencyReviewMode.Sbom, () => _sbomInput?.Element); break;
            case DependencyReviewNextAction.ChooseTarget: Choose(DependencyReviewMode.Deployed, () => _targetSelect); break;
            case DependencyReviewNextAction.CaptureDeployed: await CaptureDeployedAsync(); break;
            case DependencyReviewNextAction.ReviewSbom: await ReviewSbomAsync(); break;
            case DependencyReviewNextAction.RunSourceReview: await RunAsync(); break;
            case DependencyReviewNextAction.RunHealthReview: await RunHealthAsync(); break;
        }
    }

    private void SelectModeAsync(DependencyReviewMode mode)
    {
        _mode = mode;
        _focusMode = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusControl is { } control)
        {
            _focusControl = null;
            _focusMode = false;
            if (control() is { } element) { try { await element.FocusAsync(); } catch (Exception ex) when (ex is JSException or InvalidOperationException) { } }
            return;
        }
        if (!_focusMode) return;
        _focusMode = false;
        var heading = _mode switch { DependencyReviewMode.Source => _sourceHeading, DependencyReviewMode.Inventory => _inventoryHeading, DependencyReviewMode.Sbom => _sbomHeading, _ => _deployedHeading };
        try { await heading.FocusAsync(); } catch (Exception ex) when (ex is JSException or InvalidOperationException) { }
    }

    private ReviewSourceSnapshot? Primary => _scope.Primary;
    /// <summary>Suggested related sources with a snapshot, neither included nor explicitly continued without.</summary>
    private List<RelatedSourceCandidate> NotIncludedAvailable => _scope.NotIncluded.Where(c => c.State == RelatedSourceState.SnapshotAvailable && !_scope.Excluded.Contains(c.Repository)).ToList();
    private string? ScopeProblem => _scope.Related.Values.Select(id => (id, s: _scope.Snapshots.FirstOrDefault(x => x.SnapshotId == id))).Select(x =>
            x.s is null ? "An included related snapshot is no longer available in Source Analysis. Remove it or choose another snapshot."
            : !x.s.HasConsumerEvidence ? $"{x.s.Repository} · {Short(x.s.Fingerprint)} has no dependency evidence. Remove it or choose a newer snapshot." : null)
        .FirstOrDefault(m => m is not null);
    private List<string> ScopeRepositories => Primary is null ? [] : [Primary.Repository, .. _scope.Related.Values.Select(id => _scope.Snapshots.FirstOrDefault(s => s.SnapshotId == id)?.Repository).OfType<string>()];
    private static string Short(string fingerprint) => SourceAnalysisOverview.ShortFingerprint(fingerprint);
    private static string Utc(DateTimeOffset at) => SourceAnalysisOverview.Utc(at);

    private async Task LoadSourcesAsync()
    {
        if (!FeatureViz.SourceAnalysis) return; // feature visibility is respected: hidden Source Analysis offers no snapshots here
        try
        {
            // Source snapshots need no Target Environment; the id (blank without one) is only the caller's runtime context.
            _environmentId = (await ContextFactory.GetActiveContextAsync()).ActiveProfileOrNull?.Id ?? "";
            _scope.Options = await Api.SourceScopeAsync(_environmentId, _scope.Request);
        }
        catch (Exception ex) when (BackendRequestClassifier.IsRequestFailure(ex)) { _status = BackendRequestClassifier.FromException("Source Analysis snapshots", ex).UserMessage; }
    }

    /// <summary>Re-reads the scope's options (candidates, newer snapshots, problems) after an explicit change — never auto-includes.</summary>
    private async Task ReloadScopeAsync()
    {
        if (_environmentId is null) return;
        try { _scope.Options = await Api.SourceScopeAsync(_environmentId, _scope.Request); }
        catch (Exception ex) when (BackendRequestClassifier.IsRequestFailure(ex)) { _error = BackendRequestClassifier.FromException("Checking related sources", ex).UserMessage; }
    }

    private async Task PrimaryChangedAsync(Guid? id)
    {
        await ReloadScopeAsync();
        if (Primary is { } p && !ScopeRepositories.Contains(_overrideRepository)) _overrideRepository = p.Repository;
    }

    private async Task FocusPrimaryAsync() { if (_selector is not null) await _selector.FocusAsync(); }

    private async Task PickConfig(InputFileChangeEventArgs args)
    {
        _error = null;
        if (args.File.Size > 1024 * 1024) { _error = "The config file is larger than 1 MB."; return; }
        using var buffer = new MemoryStream();
        await args.File.OpenReadStream(1024 * 1024).CopyToAsync(buffer);
        _config = (args.File.Name, buffer.ToArray());
    }

    /// <summary>Runs the source dependency analysis over exactly the selected snapshots (bound by ID and fingerprint in the result).</summary>
    private async Task RunAsync()
    {
        if (_scope.PrimaryId is not { } primary || _environmentId is null) return;
        _busy = true;
        _error = null;
        _status = "Analyzing dependencies from the selected source scope…";
        try
        {
            var request = new SourceDependencyReviewRequest
            {
                EnvironmentId = _environmentId, PrimarySnapshotId = primary, RelatedSnapshotIds = _scope.Request!.RelatedSnapshotIds, ExcludedSuggestions = _scope.Request.ExcludedSuggestions,
                ConfigOverrides = _config is { } config && _overrideRepository.Length > 0 ? [new SourceConfigOverride(_overrideRepository, config.Name, System.Text.Encoding.UTF8.GetString(config.Bytes))] : [],
            };
            var (result, error) = await Api.RunSourceAsync(request);
            if (error is not null) { _error = error; _status = null; return; }
            Show(result!);
            _status = $"Review completed and stored {result!.CompletedAt.ToUniversalTime():yyyy-MM-dd HH:mm} UTC.";
            _history = await Api.HistoryAsync();
            await LoadHealthListsAsync(); // each reviewed source is also a declared-dependency inventory
        }
        catch (Exception ex) when (BackendRequestClassifier.IsRequestFailure(ex)) { _error = BackendRequestClassifier.FromException("Running the review", ex).UserMessage; _status = null; }
        finally { _busy = false; }
    }

    private async Task OpenRunAsync(ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var id)) return;
        _busy = true;
        try
        {
            if (await Api.GetAsync(id) is { } run) { Show(run); _status = $"Showing stored review from {run.CompletedAt.ToUniversalTime():yyyy-MM-dd HH:mm} UTC."; }
            else _error = "That review is no longer stored.";
        }
        catch (Exception ex) when (BackendRequestClassifier.IsRequestFailure(ex)) { _error = BackendRequestClassifier.FromException("The stored review", ex).UserMessage; }
        finally { _busy = false; }
    }

    private void Show(DependencyReviewResult result)
    {
        _result = result;
        _view = ResultView.Source;
        _selectedRepository = result.Repositories.FirstOrDefault()?.Repository;
        _filter = null;
        _singleResult = null;
        _singleError = null;
    }

    private void SelectRepository(string repository)
    {
        _selectedRepository = repository;
        _filter = null;
        _singleResult = null;
        _singleError = null;
    }

    private void PickPackage(RepositoryDependencyReview repo, string? value)
    {
        if (!int.TryParse(value, out var index) || DependencyReviewPresentation.Packages(repo).ElementAtOrDefault(index) is not { } dep) return;
        _single.PackageName = dep.PackageName;
        _single.Manager = dep.Manager;
        _single.File = dep.OwnerFile;
        _single.Current = dep.CurrentValue ?? "";
        _single.Candidate = RenovateCandidate(dep);
    }

    /// <summary>A default synthetic major candidate for the chosen package, which the user can change.</summary>
    private static string RenovateCandidate(DeclaredDependency dep)
    {
        var m = System.Text.RegularExpressions.Regex.Match(dep.CurrentValue ?? "", @"^(\d+)(.*)$");
        return m.Success ? $"{int.Parse(m.Groups[1].Value) + 1}.0.0" : "";
    }

    private async Task SimulateAsync(RepositoryDependencyReview repo)
    {
        if (_result is null) return;
        _singleError = null;
        _busy = true;
        try
        {
            var (simulation, error) = await Api.SimulateAsync(new PolicySimulationRequest
            {
                RunId = _result.RunId, Repository = repo.Repository, PackageName = _single.PackageName, Manager = _single.Manager,
                CurrentVersion = _single.Current, CandidateVersion = _single.Candidate, File = string.IsNullOrWhiteSpace(_single.File) ? null : _single.File.Trim(),
            });
            _singleResult = simulation;
            _singleError = error;
        }
        catch (Exception ex) when (BackendRequestClassifier.IsRequestFailure(ex)) { _singleError = BackendRequestClassifier.FromException("Running the simulation", ex).UserMessage; }
        finally { _busy = false; }
    }

    private async Task ExportHtml()
    {
        if (_result is null) return;
        await JS.InvokeVoidAsync("downloadHtmlFile", $"dependency-review-{DateTime.UtcNow:yyyy-MM-dd}.html", ExportService.ExportDependencyReview(_result));
    }

    // ── Dependency health (source-free) ────────────────────────────────────────────────────────────────────────────

    private enum ResultView { Source, Health }
    private ResultView _view = ResultView.Source;
    private IReadOnlyList<InventorySummary> _inventories = [];
    private IReadOnlyList<DependencyHealthRunSummary> _healthHistory = [];
    private DependencyHealthRun? _health;
    private Guid? _inventoryId;
    private Guid? _baselineId;
    private Guid? _comparisonId;
    private Guid? _deployedId;
    private Guid? _policyInventoryId;
    private (string Name, byte[] Bytes)? _sbom;
    private SbomRole _sbomRole = SbomRole.BuildArtifact;
    private string? _sbomEnvironment;
    private string? _sbomName;
    private SbomValidation? _validation;
    private string? _targetUrl;
    private string? _targetEnvironment;
    private string? _healthStatus;
    private string? _healthError;

    private InventorySummary? SelectedInventory => _inventories.FirstOrDefault(i => i.Id == _inventoryId);
    private IEnumerable<InventorySummary> OtherInventories => _inventories.Where(i => i.Id != _inventoryId);
    private string OptionsHint => string.Join(" · ", new[] { _baselineId is null ? null : "baseline", _comparisonId is null ? null : "cross-source", _policyInventoryId is null ? null : "Renovate policy" }.OfType<string>()) is { Length: > 0 } h ? h : "none";

    private static Guid? ParseId(ChangeEventArgs e) => Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;

    private async Task LoadHealthListsAsync()
    {
        try
        {
            _inventories = await Api.InventoriesAsync();
            _healthHistory = await Api.HealthHistoryAsync();
        }
        catch (Exception ex) when (BackendRequestClassifier.IsRequestFailure(ex)) { _healthStatus = BackendRequestClassifier.FromException("Stored inventories", ex).UserMessage; }
    }

    private void PickInventory(ChangeEventArgs e)
    {
        _inventoryId = ParseId(e);
        if (_baselineId == _inventoryId) _baselineId = null;
        if (_comparisonId == _inventoryId) _comparisonId = null;
        if (_deployedId == _inventoryId) _deployedId = null;
        if (_policyInventoryId == _inventoryId) _policyInventoryId = null; // the inventory's own source review applies
    }

    private async Task PickSbom(InputFileChangeEventArgs args)
    {
        _healthError = null;
        _validation = null;
        const long max = 20 * 1024 * 1024;
        if (args.File.Size > max) { _healthError = "The document is larger than the 20 MB limit."; return; }
        using var buffer = new MemoryStream();
        await args.File.OpenReadStream(max).CopyToAsync(buffer);
        _sbom = (args.File.Name, buffer.ToArray());
    }

    private DependencyHealthRequest Request(Guid inventoryId)
    {
        var policy = _inventories.FirstOrDefault(i => i.Id == _policyInventoryId);
        return new DependencyHealthRequest
        {
            InventoryId = inventoryId, BaselineInventoryId = _baselineId, ComparisonInventoryId = _comparisonId, DeployedInventoryId = _deployedId,
            PolicyRunId = policy?.SourceRunId, PolicyRepository = policy?.Repository,
        };
    }

    private async Task RunHealthAsync()
    {
        if (_inventoryId is not { } id) return;
        await HealthAsync(() => Api.RunHealthAsync(Request(id)), "Checking registry, advisory, license and automation evidence…");
    }

    private async Task RefreshHealthAsync()
    {
        if (_health is null) return;
        await HealthAsync(() => Api.RefreshHealthAsync(_health.RunId), "Re-collecting current dependency evidence as a new review…");
    }

    private async Task HealthAsync(Func<Task<(DependencyHealthRun? Run, string? Error)>> call, string working)
    {
        _busy = true;
        _healthError = null;
        _healthStatus = working;
        try
        {
            var (run, error) = await call();
            if (error is not null) { _healthError = error; _healthStatus = null; return; }
            ShowHealth(run!);
            _healthStatus = $"Dependency health review stored {run!.CompletedAt.ToUniversalTime():yyyy-MM-dd HH:mm} UTC{(run.RefreshOf is not null ? " as a new run; the earlier run is unchanged" : "")}.";
            await LoadHealthListsAsync();
        }
        catch (Exception ex) when (BackendRequestClassifier.IsRequestFailure(ex)) { _healthError = BackendRequestClassifier.FromException("Running the dependency health review", ex).UserMessage; _healthStatus = null; }
        finally { _busy = false; }
    }

    private async Task ReviewSbomAsync()
    {
        if (_sbom is not { } sbom) return;
        _busy = true;
        _healthError = null;
        _healthStatus = "Validating the document…";
        try
        {
            var import = await Api.ImportInventoryAsync(sbom.Name, new MemoryStream(sbom.Bytes), _sbomRole, _sbomEnvironment, _sbomName);
            _validation = import.Validation;
            if (import.Inventory is null) { _healthError = import.Error ?? "The document was not accepted."; _healthStatus = null; return; }
            await LoadHealthListsAsync();
            _inventoryId = import.Inventory.Id;
        }
        catch (Exception ex) when (BackendRequestClassifier.IsRequestFailure(ex)) { _healthError = BackendRequestClassifier.FromException("Uploading the document", ex).UserMessage; _healthStatus = null; return; }
        finally { _busy = false; }
        await HealthAsync(() => Api.RunHealthAsync(Request(_inventoryId!.Value)), "SBOM stored as an inventory. Checking registry, advisory and license evidence…");
    }

    private async Task CaptureDeployedAsync()
    {
        if (CaptureUrl is not { } url) return;
        _busy = true;
        _healthError = null;
        _healthStatus = "Reading deployed metadata (read-only GET)…";
        try
        {
            var capture = await Api.CaptureDeployedAsync(new DeployedCaptureRequest { TargetUrl = url, Environment = SelectedTarget?.EnvironmentType.ToString() ?? _targetEnvironment });
            if (capture.Inventory is null) { _healthError = capture.Error ?? "No deployed evidence was captured."; _healthStatus = null; return; }
            await LoadHealthListsAsync();
            _deployedId = capture.Inventory.Id;
            _healthStatus = $"Captured {capture.Inventory.Dependencies} deployed assembl{(capture.Inventory.Dependencies == 1 ? "y" : "ies")} (versions not proven). Selected as deployed evidence for the next dependency health review.";
        }
        catch (Exception ex) when (BackendRequestClassifier.IsRequestFailure(ex)) { _healthError = BackendRequestClassifier.FromException("Capturing deployed evidence", ex).UserMessage; _healthStatus = null; }
        finally { _busy = false; }
    }

    private async Task OpenHealthAsync(ChangeEventArgs e)
    {
        if (ParseId(e) is not { } id) return;
        _busy = true;
        try
        {
            if (await Api.GetHealthAsync(id) is { } run) { ShowHealth(run); _healthStatus = $"Showing stored dependency health review from {run.CompletedAt.ToUniversalTime():yyyy-MM-dd HH:mm} UTC, exactly as recorded."; }
            else _healthError = "That review is no longer stored.";
        }
        catch (Exception ex) when (BackendRequestClassifier.IsRequestFailure(ex)) { _healthError = BackendRequestClassifier.FromException("The stored dependency health review", ex).UserMessage; }
        finally { _busy = false; }
    }

    private void ShowHealth(DependencyHealthRun run)
    {
        _health = run;
        _view = ResultView.Health;
    }

    private async Task ExportHealthHtml()
    {
        if (_health is null) return;
        await JS.InvokeVoidAsync("downloadHtmlFile", $"dependency-health-{DateTime.UtcNow:yyyy-MM-dd}.html", ExportService.ExportDependencyHealth(_health));
    }
