    private string? _healthError;

    private InventorySummary? SelectedInventory => _inventories.FirstOrDefault(i => i.Id == _inventoryId);
    private IEnumerable<InventorySummary> OtherInventories => _inventories.Where(i => i.Id != _inventoryId);
    private string OptionsHint => string.Join(" · ", new[] { _baselineId is null ? null : "baseline", _comparisonId is null ? null : "cross-source", _policyInventoryId is null ? null : "Renovate policy" }.OfType<string>()) is { Length: > 0 } h ? h : "none";

    private static Guid? ParseId(ChangeEventArgs e) => Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;

    private async Task LoadHealthListsAsync()
    {
        try
        {
            _inventories = await Api.InventoriesAsync();
            _healthHistory = await Api.HealthHistoryAsync();
        }
        catch (Exception ex) when (BackendRequestClassifier.IsRequestFailure(ex)) { _healthStatus = BackendRequestClassifier.FromException("Stored inventories", ex).UserMessage; }
    }

    /// <summary>Choosing an inventory in the Existing inventory panel is choosing that evidence (when no mode is chosen yet).</summary>
    private void PickInventory(ChangeEventArgs e)
    {
        if (_mode == DependencyReviewMode.None) _mode = DependencyReviewMode.Inventory;
        PickKnownInventory(e);
    }

    /// <summary>The known (expected) inventory, shared by Existing inventory and Deployed evidence.</summary>
    private void PickKnownInventory(ChangeEventArgs e)
    {
        _inventoryId = ParseId(e);
        if (_baselineId == _inventoryId) _baselineId = null;
        if (_comparisonId == _inventoryId) _comparisonId = null;
        if (_deployedId == _inventoryId) _deployedId = null;
        if (_policyInventoryId == _inventoryId) _policyInventoryId = null; // the inventory's own source review applies
    }

    private async Task PickSbom(InputFileChangeEventArgs args)
    {
        if (_mode == DependencyReviewMode.None) _mode = DependencyReviewMode.Sbom;
        _healthError = null;
        _validation = null;
        _sbomInventoryId = null;
        const long max = 20 * 1024 * 1024;
        if (args.File.Size > max) { _healthError = "The document is larger than the 20 MB limit."; return; }
        using var buffer = new MemoryStream();
        await args.File.OpenReadStream(max).CopyToAsync(buffer);
        _sbom = (args.File.Name, buffer.ToArray());
    }

    private DependencyHealthRequest Request(Guid inventoryId, string mode)
    {
        var policy = _inventories.FirstOrDefault(i => i.Id == _policyInventoryId);
        return new DependencyHealthRequest
        {
            InventoryId = inventoryId, BaselineInventoryId = mode == DependencyEvidenceModes.Inventory ? _baselineId : null,
            ComparisonInventoryId = mode == DependencyEvidenceModes.Inventory ? _comparisonId : null,
            DeployedInventoryId = mode == DependencyEvidenceModes.Deployed ? _deployedId : null,
            PolicyRunId = mode == DependencyEvidenceModes.Inventory ? policy?.SourceRunId : null, PolicyRepository = mode == DependencyEvidenceModes.Inventory ? policy?.Repository : null,
            EvidenceMode = mode,
        };
    }

    private async Task RunHealthAsync()
    {
        if (HealthInventoryId is not { } id || ModeKey(_mode) is not { } mode) return;
        await HealthAsync(() => Api.RunHealthAsync(Request(id, mode)), mode == DependencyEvidenceModes.Deployed ? "Comparing the known inventory with deployed evidence…" : "Checking registry, advisory, license and automation evidence…");
    }

    private async Task RefreshHealthAsync()
    {
        if (_health is null) return;
        await HealthAsync(() => Api.RefreshHealthAsync(_health.RunId), "Re-collecting current dependency evidence as a new review…");
    }

    private async Task HealthAsync(Func<Task<(DependencyHealthRun? Run, string? Error)>> call, string working)
    {
        _busy = true;
        _healthError = null;
        _healthStatus = working;
        try
        {
            var (run, error) = await call();
            if (error is not null) { _healthError = error; _healthStatus = null; return; }
            ShowHealth(run!);
            _healthStatus = $"{DependencyEvidenceModes.ReviewType(_healthOrigin)} stored {run!.CompletedAt.ToUniversalTime():yyyy-MM-dd HH:mm} UTC{(run.RefreshOf is not null ? " as a new run; the earlier run is unchanged" : "")}.";
            await LoadHealthListsAsync();
        }
        catch (Exception ex) when (BackendRequestClassifier.IsRequestFailure(ex)) { _healthError = BackendRequestClassifier.FromException("Running the dependency health review", ex).UserMessage; _healthStatus = null; }
        finally { _busy = false; }
    }

    /// <summary>SBOM lifecycle step 2: validate the uploaded document; only a valid one becomes an inventory. Running the health review is the next, explicit step.</summary>
    private async Task ValidateSbomAsync()
    {
        if (_sbom is not { } sbom) return;
        _busy = true;
        _healthError = null;
        _healthStatus = "Validating the document…";
        try
        {
            var import = await Api.ImportInventoryAsync(sbom.Name, new MemoryStream(sbom.Bytes), _sbomRole, _sbomEnvironment, _sbomName);
            _validation = import.Validation;
            if (import.Inventory is null) { _healthError = import.Error ?? "The document was not accepted."; _healthStatus = null; return; }
            await LoadHealthListsAsync();
            _sbomInventoryId = import.Inventory.Id;
            _healthStatus = $"SBOM validated. Inventory created from SBOM: {import.Inventory.Dependencies} dependencies.";
        }
        catch (Exception ex) when (BackendRequestClassifier.IsRequestFailure(ex)) { _healthError = BackendRequestClassifier.FromException("Uploading the document", ex).UserMessage; _healthStatus = null; }
        finally { _busy = false; }
    }

    private async Task CaptureDeployedAsync()
    {
        if (CaptureUrl is not { } url) return;
        _busy = true;
        _healthError = null;
        _healthStatus = "Reading deployed metadata (read-only GET)…";
        try
        {
            var capture = await Api.CaptureDeployedAsync(new DeployedCaptureRequest { TargetUrl = url, Environment = SelectedTarget?.EnvironmentType.ToString() ?? _targetEnvironment, ProfileId = SelectedTarget?.Id });
            _capture = capture.Capture;
            if (capture.Inventory is null)
            {
                // Not captured is a result with a per-method breakdown, not a red error; only a missing report is an error.
                if (capture.Capture is null) _healthError = capture.Error ?? "No deployment evidence was captured.";
                _healthStatus = capture.Capture?.Summary;
                return;
            }
            await LoadHealthListsAsync();
            _deployedId = capture.Inventory.Id;
            _healthStatus = (capture.Capture?.Summary ?? $"Captured {capture.Inventory.Dependencies} deployed artifacts.") + " Versions are not proven. Selected as the deployment evidence to compare.";
        }
        catch (Exception ex) when (BackendRequestClassifier.IsRequestFailure(ex)) { _healthError = BackendRequestClassifier.FromException("Capturing deployed evidence", ex).UserMessage; _healthStatus = null; }
        finally { _busy = false; }
    }

    private async Task OpenHealthAsync(ChangeEventArgs e)
    {
        if (ParseId(e) is not { } id) return;
        _busy = true;
        try
        {
            if (await Api.GetHealthAsync(id) is { } run)
            {
                ShowHealth(run);
                _healthStatus = $"Showing stored {DependencyEvidenceModes.ReviewType(_healthOrigin).ToLowerInvariant()} from {run.CompletedAt.ToUniversalTime():yyyy-MM-dd HH:mm} UTC (evidence: {DependencyEvidenceModes.Label(_healthOrigin)}), exactly as recorded.";
            }
            else _healthError = "That review is no longer stored.";
        }
        catch (Exception ex) when (BackendRequestClassifier.IsRequestFailure(ex)) { _healthError = BackendRequestClassifier.FromException("The stored dependency health review", ex).UserMessage; }
        finally { _busy = false; }
    }

    /// <summary>Shows a health run as the current result of the evidence mode it was produced under (stored with the run).</summary>
    private void ShowHealth(DependencyHealthRun run)
    {
        _health = run;
        _healthOrigin = DependencyEvidenceModes.Of(run);
        _mode = ModeOf(_healthOrigin);
    }

    private async Task ExportHealthHtml()
    {
        if (_health is null) return;
        await JS.InvokeVoidAsync("downloadHtmlFile", $"dependency-health-{DateTime.UtcNow:yyyy-MM-dd}.html", ExportService.ExportDependencyHealth(_health));
    }
}
