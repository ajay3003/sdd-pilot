    private RepositoryDependencyReview? Selected => _result?.Repositories.FirstOrDefault(r => r.Repository == _selectedRepository) ?? _result?.Repositories.FirstOrDefault();

    /// <summary>The source review shown as current: only under Source snapshot, the mode that produced it.</summary>
    private DependencyReviewResult? CurrentSource => _mode == DependencyReviewMode.Source ? _result : null;
    /// <summary>The health run shown as current: only under the evidence mode that produced it (never a stale run under another mode).</summary>
    private DependencyHealthRun? CurrentHealth => _health is not null && _healthOrigin == ModeKey(_mode) ? _health : null;

    private static string? ModeKey(DependencyReviewMode mode) => mode switch
    {
        DependencyReviewMode.Inventory => DependencyEvidenceModes.Inventory,
        DependencyReviewMode.Sbom => DependencyEvidenceModes.Sbom,
        DependencyReviewMode.Deployed => DependencyEvidenceModes.Deployed,
        _ => null,
    };

    private static DependencyReviewMode ModeOf(string? key) => key switch
    {
        DependencyEvidenceModes.Sbom => DependencyReviewMode.Sbom,
        DependencyEvidenceModes.Deployed => DependencyReviewMode.Deployed,
        _ => DependencyReviewMode.Inventory,
    };

    /// <summary>Results of this session produced under other evidence modes, newest first: offered compactly, never expanded as the current result.</summary>
    private IReadOnlyList<(DependencyReviewMode Mode, string Description, DateTimeOffset At)> OtherModeResults =>
    [
        .. new (DependencyReviewMode Mode, string Description, DateTimeOffset At)?[]
        {
            _result is { } source && CurrentSource is null
                ? (DependencyReviewMode.Source, $"Source review · Source snapshot · {source.Label} · {Utc(source.CompletedAt)}", source.CompletedAt) : null,
            _health is { } health && CurrentHealth is null
                ? (ModeOf(_healthOrigin), $"{DependencyEvidenceModes.ReviewType(_healthOrigin)} · {DependencyEvidenceModes.Label(_healthOrigin)} · {health.Inventory.Name} · {health.Summary.Dependencies} dependencies · {Utc(health.CompletedAt)}", health.CompletedAt) : null,
        }.OfType<(DependencyReviewMode Mode, string Description, DateTimeOffset At)>().OrderByDescending(r => r.At),
    ];

    private Task OpenOtherAsync(DependencyReviewMode mode)
    {
