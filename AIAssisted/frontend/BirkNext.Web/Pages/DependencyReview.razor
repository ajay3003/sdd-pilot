    private SbomCandidateScan? _sbomScan;
    /// <summary>The report of the latest deployment capture (each method's outcome), shown whether or not evidence was captured.</summary>
    private DeploymentCaptureReport? _capture;

    private static string UsedMethods(DeploymentCaptureReport report) =>
        report.Strategies.Where(s => s.Outcome is CaptureStrategyOutcome.Captured or CaptureStrategyOutcome.Partial).Select(s => s.Name).ToList() is { Count: > 0 } used ? string.Join(", ", used) : "None";

    private static string CaptureOverallLabel(CaptureOverall overall) => overall switch
    {
        CaptureOverall.Captured => "Captured",
        CaptureOverall.Partial => "Captured with limitations",
        CaptureOverall.Failed => "Not captured · target not readable",
        _ => "Not captured",
    };

    private static string CapabilityLabel(CaptureCapability capability) => capability switch
    {
        CaptureCapability.Supported => "Supported",
        CaptureCapability.Partial => "Partial — some deployment evidence available",
        CaptureCapability.Unsupported => "Unavailable with currently supported methods",
        _ => "Unknown — the target could not be checked",
    };

    private static string StrategyLabel(CaptureStrategyOutcome outcome) => outcome switch
    {
        CaptureStrategyOutcome.NotDetected => "Not detected",
        CaptureStrategyOutcome.AuthenticationRequired => "Failed · authentication required",
        CaptureStrategyOutcome.NotAttempted => "Not attempted",
        CaptureStrategyOutcome.NotAvailable => "Not available",
        CaptureStrategyOutcome.Partial => "Captured (partial)",
        _ => outcome.ToString(),
    };
    private SbomRole _sbomRole = SbomRole.BuildArtifact;
    private string? _sbomEnvironment;
    private string? _sbomName;
    private SbomValidation? _validation;
