    /// <summary>Fields of the effective schema whose name matches, for package search (opens Felt og regler). Bounded.</summary>
    private static IEnumerable<SearchHit> FieldHits(SchemaPackage package, string term)
    {
        var stack = new Stack<(EffectiveMember Member, int Depth)>(package.EffectiveSchema.Select(root => (root, 0)));
        var count = 0;
        while (stack.Count > 0 && count < 200)
        {
            var (member, depth) = stack.Pop();
            if (member.Name.Contains(term, StringComparison.OrdinalIgnoreCase)) { count++; yield return new(member.Name, member.DeclaredIn, "Felt og regler", "field"); }
            if (depth < 30) foreach (var child in member.Children) stack.Push((child, depth + 1));
        }
    }

