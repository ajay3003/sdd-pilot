@page "/schema-studio"
@using System.Text
@using System.Xml
@using BirkNext.Integrations
@using BirkNext.Web.Components
@using BirkNext.Web.Services
@using BirkNext.Web.Services.SchemaStudio
@using Microsoft.AspNetCore.Components.Forms
@inject SchemaStudioService Studio
@inject IServiceProvider ServiceProvider

<PageTitle>Schema Studio</PageTitle>
<main class="ss-page">
    <PageHeader Title="Schema Studio" Description="A generic workspace for exploring, comparing and testing XML Schema (XSD) contracts. Imports are analyzed locally; remote schemas are never fetched." />
    <p class="ss-note">Schema validity describes structure only. It does not establish business validity or integration behavior.</p>
    <section class="ss-import" aria-labelledby="ss-source-title">
        <h2 id="ss-source-title">Reuse Source Analysis XSDs</h2>
        <p>Choose one immutable Source Analysis snapshot. Schema files are loaded only from that snapshot; newer uploads are never substituted.</p>
        @if (_sourceSnapshots.Count == 0) { <p class="ss-empty">No Source Analysis snapshots are available in this workspace.</p> }
        else
        {
            @if (_sourceSnapshotIndexTruncated) { <p class="ss-warning" role="status">Showing the newest 500 Source Analysis snapshots. Older snapshots are omitted from this selector.</p> }
            <label class="ss-field">Source snapshot
                <select @bind="_sourceSnapshotId" aria-label="Source Analysis snapshot">
                    <option value="">Choose snapshot</option>
                    @foreach (var snapshot in _sourceSnapshots) { <option value="@snapshot.Id">@SnapshotLabel(snapshot)</option> }
                </select>
            </label>
            <button class="ss-action" disabled="@(_sourceSnapshotId.Length == 0 || _sourceBusy)" @onclick="LoadSourceContracts">Load XSDs from snapshot</button>
            @if (_sourcePackage is { } sourcePackage)
            {
                <p class="ss-note">@sourcePackage.Files.Count XSD file(s) bound to @sourcePackage.SourceArchiveName, snapshot @sourcePackage.SnapshotId. Fingerprint <code>@sourcePackage.SnapshotFingerprint</code>.</p>
                @if (!sourcePackage.IsComplete) { <p class="ss-warning" role="status">This snapshot's schema capture is partial: @sourcePackage.OmittedFiles XSD file(s) were omitted by storage limits. The resulting package will remain Partial.</p> }
                <label class="ss-field">Contract XSD
                    <select @bind="_sourceContractPath" aria-label="Discovered XSD contract">
                        @foreach (var file in sourcePackage.Files) { <option value="@file.Path">@file.Path · @file.Text.Length.ToString("N0") characters</option> }
                    </select>
                </label>
                <button class="ss-action" disabled="@(_sourceContractPath.Length == 0)" @onclick="OpenSourceContract">Open contract in Schema Studio</button>
            }
        }
        @if (_sourceBusy) { <p role="status">Loading XSD artifacts from the selected snapshot…</p> }
        @if (!string.IsNullOrWhiteSpace(_sourceError)) { <p class="ss-error" role="alert">@_sourceError</p> }
    </section>
    <section class="ss-import" aria-labelledby="ss-saved-title">
        <h2 id="ss-saved-title">Saved schema analyses</h2>
        <p>Save a package to this BirkNext workspace to reopen it later. Source Analysis packages keep an exact snapshot reference instead of copying the XSD files.</p>
        @{ var savedPackages = SavedPackages?.Packages.Where(p => p.ProjectScope == ProjectScope()).ToArray() ?? []; }
        @if (savedPackages.Length == 0)
        { <p class="ss-empty">No saved schema analyses in this workspace.</p> }
        else
        {
            <div class="ss-package-list">
                @foreach (var saved in savedPackages)
                {
                    <article class="ss-package">
                        <div><strong>@saved.Name</strong><span>@(saved.Files is null ? "Source Analysis snapshot reference" : "Saved local XSD package") · @saved.SavedAt.ToLocalTime().ToString("g")</span><code>@saved.Fingerprint[..Math.Min(12, saved.Fingerprint.Length)]</code></div>
                        @if (saved.Provenance?.SourceSnapshotId is { } snapshotId) { <small>Snapshot @snapshotId · @saved.Provenance.SourceArchiveName</small> }
                        <button class="ss-action" @onclick="() => OpenSavedSchema(saved.Id)">Reopen analysis</button>
                        <button class="ss-text-button" @onclick="() => RemoveSavedSchema(saved.Id)">Remove saved analysis</button>
                    </article>
                }
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(_artifactStatus)) { <p class="ss-result" role="status">@_artifactStatus</p> }
        @if (!string.IsNullOrWhiteSpace(_artifactError)) { <p class="ss-error" role="alert">@_artifactError</p> }
    </section>
    <section class="ss-import" aria-labelledby="ss-import-title">
        <h2 id="ss-import-title">Import XSD files or a package</h2>
        <label class="ss-upload">Choose one or more .xsd files <InputFile accept=".xsd" multiple OnChange="ImportFiles" aria-label="Choose XSD files" /></label>
        <label class="ss-upload">Choose an XSD ZIP package <InputFile accept=".zip" OnChange="ImportZip" aria-label="Choose XSD ZIP package" /></label>
        <button class="ss-action" @onclick="() => _creating = !_creating">Create new XSD</button>
        <p>Maximum 100 schema files, 2 MB each and 20 MB total. Package contents stay in memory for this browser session.</p>
        @if (_creating)
        {
            <div class="ss-create" aria-label="Create new XSD wizard">
                <label>Schema name <input @bind="_newSchemaName" /></label><label>Target namespace <input @bind="_newNamespace" /></label><label>Root element <input @bind="_newRoot" /></label>
                <button class="ss-action" @onclick="CreateSchema">Create schema and open Designer</button>
            </div>
        }
        @if (_error is not null) { <p class="ss-error" role="alert">@_error</p> }
    </section>

    <section aria-labelledby="ss-packages-title">
        <div class="ss-heading"><h2 id="ss-packages-title">Schema packages and versions</h2><span>@Studio.Packages.Count in this session</span></div>
        @if (Studio.Packages.Count == 0)
        {
            <p class="ss-empty">No schemas imported. Choose an XSD or ZIP package to begin.</p>
        }
        else
        {
            <div class="ss-package-list">
                @foreach (var item in Studio.Packages)
                {
                    <article class="ss-package @(item.Id == _selectedId ? "selected" : "")">
                        <button class="ss-package-open" @onclick="() => Select(item.Id)"><strong>@item.Name</strong><span>@item.Files.Count file(s) · @item.Validation · @item.ImportedAt.ToLocalTime().ToString("g")</span><code>@item.Fingerprint[..12]</code></button>
                        <button class="ss-text-button" @onclick="() => Remove(item.Id)" aria-label="Remove @item.Name">Remove</button>
                    </article>
                }
            </div>
        }
    </section>

    @if (Current is { } package)
    {
        <section class="ss-workspace" aria-labelledby="ss-current-title">
        <div class="ss-heading"><div><h2 id="ss-current-title">@package.Name</h2><p>@package.Files.Count XSD file(s) · @package.Validation · Fingerprint <code>@package.Fingerprint</code></p></div>
                @if (CurrentFile is { } active) { <a class="ss-action" download="@active.Name" href="@Download(active.Text, "application/xml")">Export current XSD</a> }
                <a class="ss-action" download="@(package.Name + ".zip")" href="@Download(Convert.ToBase64String(SchemaStudioService.ExportZip(package)), "application/zip", true)">Export package ZIP</a>
                <button class="ss-action" @onclick="SaveCurrentSchema">Save analysis to workspace</button>
            </div>
            @if (package.Provenance is { } provenance)
            {
                <p class="ss-note">Source evidence: @(provenance.SourceProjectName ?? provenance.SourceArchiveName) · archive @provenance.SourceArchiveName@(string.IsNullOrWhiteSpace(provenance.ProjectImportId) ? "" : $" · Project Import {provenance.ProjectImportId}") · snapshot @provenance.SourceSnapshotId · contract @provenance.SelectedContractPath · fingerprint @provenance.ContractFingerprint. This analysis remains bound to the selected snapshot.</p>
            }
            <label class="ss-search">Search this package <input type="search" @bind="_search" @bind:event="oninput" placeholder="Element, type, namespace, filename, facet" /></label>
            @if (!string.IsNullOrWhiteSpace(_search))
            {
                <ul class="ss-search-results">@foreach (var result in Search(package, _search).Take(30)) { <li><button class="ss-link" @onclick="() => Jump(result.File, result.Tab)">@result.Name</button> <small>@result.File · @result.Tab · @result.Match</small></li> }</ul>
            }
            <nav class="ss-tabs" aria-label="Schema package views">
                @foreach (var tab in Tabs) { <button class="@(tab == _tab ? "active" : "")" aria-current="@(tab == _tab ? "page" : null)" @onclick="() => _tab = tab">@tab</button> }
            </nav>
            @if (package.Diagnostics.Count > 0) { <div class="ss-warning" role="status"><strong>Partial dependency resolution</strong><ul>@foreach (var d in package.Diagnostics) { <li>@d</li> }</ul></div> }
            @switch (_tab)
            {
                case "Overview":
                    <dl class="ss-stats"><div><dt>Root XSD</dt><dd>@(package.Files.FirstOrDefault(f => f.Declarations.Any(d => d.Kind == "element"))?.Name ?? "Not identified")</dd></div><div><dt>Namespaces</dt><dd>@(string.Join(", ", package.Files.Select(f => f.TargetNamespace).Where(n => n is not null).Distinct()) is { Length: > 0 } ns ? ns : "None declared")</dd></div><div><dt>Dependencies</dt><dd>@package.Files.Sum(f => f.Links.Count) links · @package.Files.Sum(f => f.Links.Count(l => l.ResolvedFile is null)) unresolved</dd></div><div><dt>Global declarations</dt><dd>@package.Files.Sum(f => f.Declarations.Count)</dd></div></dl>
                    <p>Current imported artifact is the version you selected for this session. Importing again creates a separate version; nothing is deployed or inferred to be runtime truth.</p>
                    break;
                case "Linked XSDs":
                    var dependencyEdges = DependencyEdges(package, _graphMode).Take(1001).ToArray();
                    <p>Relationships resolve only within this imported package. Missing files are shown as unresolved; remote schema locations are never fetched.</p>
                    <label class="ss-field">Dependency view <select @bind="_graphMode"><option>Files only</option><option>Files + namespaces</option><option>Files + types</option><option>All relationships</option></select></label>
                    <div class="ss-table-wrap"><table><thead><tr><th>File</th><th>Namespace</th><th>Relationship</th><th>Schema location</th><th>Resolution</th></tr></thead><tbody>
                    @foreach (var f in package.Files) { <tr><td><button class="ss-link" @onclick="() => _fileName = f.Name">@f.Name</button></td><td>@(f.TargetNamespace ?? "—")</td><td>Root file</td><td>—</td><td>Available</td></tr>@foreach (var link in f.Links) { <tr><td>@f.Name</td><td>@(link.Namespace ?? "—")</td><td>@link.Kind</td><td>@(link.Location ?? "—")</td><td>@(link.ResolvedFile is null ? "Unresolved" : "Resolved: " + link.ResolvedFile)</td></tr> } }
                    </tbody></table></div>
                    <SchemaRelationshipGraph Package="package" OnFileSelected="OpenGraphFile" />
                    <h3>Dependency relationships</h3>
                    @if (dependencyEdges.Length > SchemaStudioService.MaxRelationships || (package.ReferencesTruncated && _graphMode is "Files + types" or "All relationships"))
                    {
                        <p class="ss-warning" role="status">Relationship view limited to 1,000 entries. Showing the first 1,000 relationships; additional relationships are omitted.</p>
                    }
                    <ul class="ss-dependencies">@foreach (var edge in dependencyEdges.Take(1000)) { <li>@edge</li> }</ul>
                    break;
                case "Schema Tree":
                    <p>Declared schema structures, grouped by file. Linked source files remain separate artifacts.</p>
                    @foreach (var f in package.Files) { <h3>@f.Name · @(f.TargetNamespace ?? "no target namespace")</h3><ul class="ss-tree">@foreach (var d in f.Declarations) { <li><strong>@d.Name</strong> <small>@d.Kind · @(d.Type ?? d.BaseType ?? "inline") · declared in @f.Name</small>@if (d.Compositor is not null) { <small>Compositor: @d.Compositor</small> }@if (d.Documentation is not null) { <p>@d.Documentation</p> }@if (d.Children.Count > 0) { <ul>@foreach (var child in d.Children) { <li>@child.Name <small>@(child.Type ?? "inline") · @(child.MinOccurs)..@(child.MaxOccurs) · @child.SourceFile @(child.Compositor is null ? "" : "· " + child.Compositor)</small>@if (child.Documentation is not null) { <p>@child.Documentation</p> }</li> }</ul> }</li> }</ul> }
                    break;
                case "Effective Schema":
                    <p>Effective logical view resolves linked type use and inheritance while preserving provenance. Physical XSD files remain separate.</p>
                    @foreach (var root in package.EffectiveSchema) { <article class="ss-card"><h3>@root.Name <small>root · declared in @root.DeclaredIn</small></h3>@if (root.Attributes is { Count: > 0 }) { <ul class="ss-tree">@foreach (var attribute in root.Attributes) { @RenderAttribute(attribute) }</ul> }<ul class="ss-tree">@foreach (var member in root.Children) { @RenderMember(member) }</ul></article> }
                    @if (package.EffectiveSchema.Count == 0) { <p>No global root elements were found.</p> }
                    break;
                case "Types":
                    <div class="ss-table-wrap"><table><thead><tr><th>Declaration</th><th>Kind</th><th>Type/base</th><th>Source</th><th>Facets / members</th><th>Usage</th></tr></thead><tbody>@foreach (var f in package.Files) { @foreach (var d in f.Declarations.Where(d => _tab == "References" || d.Kind is "simpleType" or "complexType")) { <tr><td>@d.Name @if (d.Documentation is not null) { <details><summary>Documentation</summary><p>@d.Documentation</p></details> }</td><td>@d.Kind</td><td>@(d.Type ?? d.BaseType ?? "—")</td><td>@f.Name</td><td>@string.Join(", ", d.Facets.Select(x => x.Kind + "=" + x.Value)) · @d.Children.Count child elements @if (d.BaseType is not null) { <span>· extends @d.BaseType</span> }</td><td>@UsageCount(package, d.Name) reference(s)</td></tr> } }</tbody></table></div>
                    break;
                case "References":
                    <p>Cross-file type use, inheritance and element references, with both source and declaration files.</p>
                    @if (package.ReferencesTruncated)
                    {
                        <p class="ss-warning" role="status">Reference view limited to 1,000 entries. Showing the first 1,000 references; additional references are omitted.</p>
                    }
                    <div class="ss-table-wrap"><table><thead><tr><th>Relationship</th><th>Declaration</th><th>Referenced from</th><th>Declared in</th><th>Path</th></tr></thead><tbody>@foreach (var reference in package.References) { <tr><td>@reference.Kind</td><td>@reference.Name</td><td>@reference.SourceFile</td><td>@reference.TargetFile</td><td>@(reference.Path ?? "—")</td></tr> }</tbody></table></div>
                    @if (package.References.Count == 0) { <p>No cross-file references were resolved.</p> }
                    break;
                case "Constraints":
                    <div class="ss-table-wrap"><table><thead><tr><th>Type/path</th><th>Constraint</th><th>Value</th><th>Source XSD</th></tr></thead><tbody>@foreach (var f in package.Files) { @foreach (var d in f.Declarations) { @foreach (var facet in d.Facets) { <tr><td>@d.Path</td><td>@facet.Kind</td><td>@facet.Value</td><td>@f.Name</td></tr> } @foreach (var e in d.Children) { <tr><td>@(d.Path + "/" + e.Name)</td><td>Occurrence</td><td>@e.MinOccurs..@e.MaxOccurs @(e.Compositor is null ? "" : "· " + e.Compositor)</td><td>@e.SourceFile</td></tr> @foreach (var facet in e.Facets) { <tr><td>@(d.Path + "/" + e.Name)</td><td>@facet.Kind</td><td>@facet.Value</td><td>@e.SourceFile</td></tr> } } } }</tbody></table></div>
                    break;
                case "Namespaces":
                    @foreach (var group in package.Files.GroupBy(f => f.TargetNamespace ?? "(no target namespace)")) { <article class="ss-card"><h3>@group.Key</h3><p>@string.Join(", ", group.Select(f => f.Name))</p><p>Global elements and types: @group.Sum(f => f.Declarations.Count)</p><p>Imported by: @string.Join(", ", package.Files.Where(f => f.Links.Any(l => l.ResolvedFile is not null && group.Any(g => g.Name == l.ResolvedFile))).Select(f => f.Name).DefaultIfEmpty("None"))</p></article> }
                    break;
                case "Raw XSD":
                    <label class="ss-field">XSD file <select value="@_fileName" @onchange="FileChanged">@foreach (var f in package.Files) { <option value="@f.Name">@f.Name</option> }</select></label>
                    <pre class="ss-raw"><code>@(CurrentFile?.Text)</code></pre>
                    break;
                case "Designer":
                    <p>Schema Designer drafts are separate from imported source evidence. The structured helper adds an element to the root sequence and can set occurrence bounds, enumerations, or inclusive numeric bounds. Other edits use the XSD draft and are accepted only when the full linked package compiles.</p>
                    <label class="ss-field">File <select value="@_fileName" @onchange="FileChanged">@foreach (var f in package.Files) { <option value="@f.Name">@f.Name</option> }</select></label>
                    <div class="ss-create"><label>Child element <input aria-label="Child element name" @bind="_newChildName" /></label><label>Type <select aria-label="Child element type" @bind="_newChildType"><option value="xs:string">String</option><option value="xs:decimal">Decimal</option><option value="xs:integer">Integer</option><option value="xs:boolean">Boolean</option><option value="xs:date">Date</option></select></label><label>Minimum occurrences <select aria-label="Minimum occurrences" @bind="_newChildMin"><option value="1">1 (required)</option><option value="0">0 (optional)</option><option value="2">2</option></select></label><label>Maximum occurrences <select aria-label="Maximum occurrences" @bind="_newChildMax"><option value="1">1</option><option value="2">2</option><option value="unbounded">Unbounded</option></select></label><label>Enumeration values, comma separated <input aria-label="Enumeration values" @bind="_newChildEnumeration" /></label><label>Inclusive minimum number <input aria-label="Minimum numeric value" inputmode="decimal" @bind="_newChildNumericMinimum" /></label><label>Inclusive maximum number <input aria-label="Maximum numeric value" inputmode="decimal" @bind="_newChildNumericMaximum" /></label><button class="ss-action" @onclick="AddDraftElement">Add child element</button></div>
                    <textarea class="ss-editor" @bind="_draft" aria-label="Edit XSD source"></textarea>
                    <div class="ss-actions"><button class="ss-text-button" @onclick="SaveWorkingDraft">Save working draft</button><button class="ss-text-button" @onclick="PreviewDraft">Preview and validate draft</button><button class="ss-text-button" @onclick="RevertDraft">Revert draft</button><button class="ss-action" @onclick="SaveDraft">Validate and save new version</button></div>
                    @if (!string.IsNullOrWhiteSpace(_draftStatus)) { <p role="status">@_draftStatus</p> }
                    @if (_draftPreview is { } draftPreview) { <p role="status">Draft compilation: @draftPreview.Validation · @draftPreview.Files.Count file(s) · @draftPreview.References.Count relationship(s).</p>@if (draftPreview.Validation != "Valid") { <ul class="ss-warning">@foreach (var diagnostic in draftPreview.Diagnostics) { <li>@diagnostic</li> }</ul> } else { <h3>Preview changes</h3><ul>@foreach (var change in Compare(package, draftPreview)) { <li>@change</li> }</ul><p>Linked references affected by the selected file edit are re-resolved before saving.</p> } }
                    break;
                case "Compare":
                    <p>Compare immutable package fingerprints and declaration summaries. Import a second version to compare it with the current package.</p>
                    @if (Studio.Packages.Count > 1) { var prior = Studio.Packages.Where(p => p.Id != package.Id && p.Name == package.Name).OrderByDescending(p => p.ImportedAt).FirstOrDefault() ?? Studio.Packages.First(p => p.Id != package.Id); <p>Comparing with <strong>@prior.Name</strong> (@prior.Fingerprint[..12])</p><ul>@foreach (var change in Compare(prior, package)) { <li>@change</li> }</ul> } else { <p>Import a second package/version to see contract changes.</p> }
                    break;
                case "Generated Tests":
                    <p>Cases derive from XSD declarations and constraints. They test schema behavior only, not business or integration behavior.</p>
                    <p>Cases run locally against the imported package. Expected validity and actual validator output are shown separately.</p>
                    @if (package.GeneratedTestsTruncated) { <p class="ss-warning" role="status">Only the first 5,000 derived test candidates are available here; some candidate tests were omitted. Effective Schema and Constraints still show the analyzed XSD evidence.</p> }
                    <div class="ss-actions"><button class="ss-action" @onclick="RunGeneratedTests">Run generated tests (first 100)</button></div>
                    <div class="ss-table-wrap"><table><thead><tr><th>Path</th><th>Derived case</th><th>Value or mutation</th><th>Expected</th><th>Source XSD</th><th>Action</th></tr></thead><tbody>@foreach (var test in package.GeneratedTests) { <tr><td>@test.Path</td><td>@test.Rule</td><td><code>@test.Value</code></td><td>@(test.ExpectedValid ? "Valid" : "Invalid")</td><td>@test.SourceFile</td><td><button class="ss-text-button" @onclick="() => GenerateXml(test)">Generate XML</button></td></tr> }</tbody></table></div>
                    @if (_testResults.Count > 0) { <h3>Test results</h3><div class="ss-table-wrap"><table><thead><tr><th>Path</th><th>Case</th><th>Expected</th><th>Actual</th><th>Outcome</th><th>Evidence</th></tr></thead><tbody>@foreach (var result in _testResults) { <tr><td>@result.Path</td><td>@result.Rule</td><td>@(result.ExpectedValid ? "Valid" : "Invalid")</td><td>@result.Actual</td><td>@result.Outcome</td><td><details><summary>Diagnostic, valid baseline and mutated XML</summary><p>@result.Diagnostic</p>@if (!string.IsNullOrWhiteSpace(result.BaselineId)) { <p>Baseline: @result.BaselineId</p> }@if (result.BaselineXml.Length > 0) { <h4>Valid baseline XML</h4><pre class="ss-raw"><code>@result.BaselineXml</code></pre> }@if (result.Xml.Length > 0) { <h4>Mutated XML</h4><pre class="ss-raw"><code>@result.Xml</code></pre> }</details></td></tr> }</tbody></table></div> }
                    @if (TestRuns?.Runs.Where(r => r.PackageFingerprint == package.Fingerprint && r.ProjectScope == ProjectScope()).Take(10).ToArray() is { Length: > 0 } savedRuns)
                    {
                        <h3>Saved validation history</h3><p>History stores schema, snapshot and profile identity with sanitized outcomes. Generated XML is not retained in run history.</p>
                        <div class="ss-table-wrap"><table><thead><tr><th>Run</th><th>Profile</th><th>Results</th><th>Pass</th><th>Fail</th><th>Not evaluated</th></tr></thead><tbody>
                        @foreach (var run in savedRuns) { <tr><td>@run.CreatedAt.ToLocalTime().ToString("g")<br /><small>@run.PackageFingerprint[..Math.Min(12, run.PackageFingerprint.Length)] · @run.Provenance?.SourceSnapshotId</small></td><td>@run.ProfileName · seed @(run.Seed?.ToString() ?? "not set")</td><td>@run.Results.Count</td><td>@run.Results.Count(r => r.Outcome == "Pass")</td><td>@run.Results.Count(r => r.Outcome == "Fail")</td><td>@run.Results.Count(r => r.Outcome == "Not evaluated")</td></tr> }
                        </tbody></table></div>
                    }
                    <label class="ss-field">Validate XML against <select @bind="_fileName">@foreach (var f in package.Files) { <option value="@f.Name">@f.Name</option> }</select></label>
                    <textarea class="ss-editor ss-xml" @bind="_xml" aria-label="XML instance to validate"></textarea>
                    <p class="ss-note">Saving XML stores its content in this BirkNext workspace. Review user-entered values before saving.</p>
                    <div class="ss-actions"><button class="ss-action" @onclick="GenerateXml">Generate minimum example</button><button class="ss-action" @onclick="ValidateXml">Validate XML</button><button class="ss-text-button" @onclick="SaveCurrentXml">Save XML artifact</button>@if (!string.IsNullOrWhiteSpace(_xml)) { <a class="ss-action" download="schema-studio.xml" href="@Download(_xml, "application/xml")">Export XML</a> }</div>
                    @if (_validationMessage is not null) { <p role="status" class="ss-result">@_validationMessage</p> }
                    @if (!string.IsNullOrWhiteSpace(_xmlArtifactStatus)) { <p role="status" class="ss-result">@_xmlArtifactStatus</p> }
                    @if (!string.IsNullOrWhiteSpace(_xmlArtifactError)) { <p role="alert" class="ss-error">@_xmlArtifactError</p> }
                    @if (SavedXml?.Documents.Where(item => item.PackageFingerprint == package.Fingerprint && item.ProjectScope == ProjectScope()).Take(10).ToArray() is { Length: > 0 } savedXml)
                    {
                        <h3>Saved XML artifacts</h3>
                        <div class="ss-package-list">@foreach (var saved in savedXml)
                        {
                            <article class="ss-package"><div><strong>@saved.ProfileName</strong><span>@saved.FileName · @saved.SavedAt.ToLocalTime().ToString("g") · schema @saved.PackageFingerprint[..12]@(saved.Provenance?.SourceSnapshotId is { } xmlSnapshot ? $" · snapshot {xmlSnapshot}" : "")</span></div>
                                <button class="ss-action" @onclick="() => ReopenXml(saved.Id)">Reopen XML</button>
                                <button class="ss-text-button" @onclick="() => RemoveXml(saved.Id)">Remove XML artifact</button>
                            </article>
                        }</div>
                    }
                    break;
                case "Test Data Profile":
                    <p>Profiles store deterministic generation rules, not real identifiers, secrets or fixed personal values. Generated values are synthetic and only XSD validity is evaluated.</p>
                    <div class="ss-profile">
                        <label>Profile
                            <select @bind="_activeProfileId" aria-label="Test Data Profile">
                                @foreach (var builtIn in TestDataProfilesService.BuiltIns(package.Fingerprint)) { <option value="@builtIn.Id">@builtIn.Name (built-in)</option> }
                                @foreach (var profile in AvailableProfiles(package)) { <option value="@profile.Id">@profile.Name</option> }
                            </select>
                        </label>
                        <label>New profile name <input @bind="_newProfileName" maxlength="120" /></label>
