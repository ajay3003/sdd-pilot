    protected override async Task OnInitializedAsync()
    {
        try
        {
            var repository = ServiceProvider.GetService<IWorkspaceArtifactRepository>();
            SavedDrafts?.RestoreJson(repository?.Get(WorkspaceArtifactType.SchemaStudioDrafts)?.Text);
            if (Studio.Packages.FirstOrDefault() is { } latest) Select(latest.Id);
            if (repository?.Get(WorkspaceArtifactType.SchemaStudio) is { } savedProfiles)
            {
                ProfileCatalog?.RestoreJson(savedProfiles.Text);
                var rejected = ProfileCatalog?.RejectedUnboundLegacyProfiles ?? 0;
                if (rejected > 0)
                    _profileStatus = $"Skipped {rejected} legacy profile(s) whose wildcard schema identity was not bound to a specific XSD. Other profiles were restored.";
            }
            if (repository?.Get(WorkspaceArtifactType.SchemaStudioTestRuns) is { } savedRuns)
                TestRuns?.RestoreJson(savedRuns.Text);
            if (repository?.Get(WorkspaceArtifactType.SchemaStudioGeneratedXml) is { } savedXml)
                SavedXml?.RestoreJson(savedXml.Text);
            if (repository?.Get(WorkspaceArtifactType.SchemaStudioPackages) is { } savedSchemas && SavedPackages is { } store)
            {
                store.RestoreJson(savedSchemas.Text);
                foreach (var saved in store.Packages.Where(p => p.ProjectScope == ProjectScope() && p.Files is not null))
                {
                    if (Studio.Packages.Any(p => p.Fingerprint == saved.Fingerprint && p.Provenance?.SourceSnapshotId == saved.Provenance?.SourceSnapshotId)) continue;
                    var restored = store.ReopenLocal(saved, Studio);
                    if (Current is null) Select(restored.Id);
                }
            }
        }
        catch (Exception e) when (e is InvalidDataException or System.Text.Json.JsonException or ArgumentException or XmlException or System.Xml.Schema.XmlSchemaException or InvalidOperationException)
        { _artifactError = "Saved Schema Studio workspace artifacts could not be restored safely."; }
        var sourceApi = SourceSchemaApiService.Resolve(ServiceProvider);
        if (sourceApi is null) return;
        try
        {
            var index = await sourceApi.ListSchemaSnapshotIndexAsync();
            _sourceSnapshots = index?.Snapshots ?? [];
            _sourceSnapshotIndexTruncated = index?.IsTruncated ?? false;
        }
        catch (Exception e) when (e is HttpRequestException or TaskCanceledException)
        { _sourceError = "Source Analysis snapshots could not be loaded. Local XSD import remains available."; }
    }

    private async Task LoadSourceContracts()
    {
        if (!Guid.TryParse(_sourceSnapshotId, out var snapshotId)) return;
        var sourceApi = SourceSchemaApiService.Resolve(ServiceProvider);
        if (sourceApi is null) { _sourceError = "Source Analysis is unavailable in this session."; return; }
        _sourceBusy = true; _sourceError = ""; _sourcePackage = null; _sourceContractPath = "";
        try
        {
            var snapshot = _sourceSnapshots.FirstOrDefault(s => s.Id == snapshotId);
            if (snapshot is null)
            { _sourceError = "The selected Source Analysis snapshot is no longer available in the current snapshot index."; return; }
            if (!snapshot.HasSchemaArtifact)
            { _sourceError = "This immutable Source Analysis snapshot did not retain XSD artifacts. Reimport the source archive to create a reusable schema snapshot."; return; }
            var artifact = await sourceApi.SourceSchemasAsync(snapshotId);
            if (artifact is null)
            { _sourceError = "The selected Source Analysis snapshot's XSD artifact is unavailable."; return; }
            if (!artifact.IsAvailable)
            { _sourceError = artifact.UnavailableReason ?? "This Source Analysis snapshot has no reusable XSD artifacts."; return; }
            if (artifact.SnapshotId != snapshot.Id || string.IsNullOrWhiteSpace(snapshot.Fingerprint)
                || !string.Equals(artifact.SnapshotFingerprint, snapshot.Fingerprint, StringComparison.Ordinal))
            { _sourceError = "The returned XSD artifacts do not match the selected immutable Source Analysis snapshot."; return; }
            if (!string.Equals(artifact.ProjectImportId, snapshot.ProjectImportId, StringComparison.Ordinal))
            { _sourceError = "The returned XSD artifacts do not match the selected project import identity."; return; }
            _sourcePackage = artifact;
            _sourceContractPath = artifact.Files.FirstOrDefault(f => f.Path.EndsWith(".xsd", StringComparison.OrdinalIgnoreCase))?.Path ?? "";
            if (_sourceContractPath.Length == 0) _sourceError = "The selected snapshot contains no stored XSD files.";
        }
        catch (Exception e) when (e is HttpRequestException or TaskCanceledException or InvalidOperationException)
        { _sourceError = "The XSD artifacts could not be loaded from this snapshot."; }
        finally { _sourceBusy = false; }
    }

    private void OpenSourceContract()
    {
        if (_sourcePackage is not { } source || source.Files.Count == 0 || _sourceContractPath.Length == 0) return;
        try
        {
            var files = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            foreach (var file in source.Files)
            {
                var path = file.Path.Replace('\\', '/');
                if (!files.TryAdd(path, file.Text)) throw new InvalidDataException("The snapshot contains duplicate XSD paths.");
                var actual = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(Encoding.UTF8.GetBytes(file.Text))).ToLowerInvariant();
                if (!string.Equals(actual, file.Fingerprint, StringComparison.Ordinal)) throw new InvalidDataException("An XSD file fingerprint did not match the selected snapshot artifact.");
            }
            var contractFiles = SchemaStudioService.ContractPackageFiles(files, _sourceContractPath);
            var provenance = new SchemaProvenance("Source Analysis", source.SourceArchiveName, source.SnapshotId,
                source.SnapshotFingerprint, source.AnalyzedAt, _sourceContractPath, "", source.IsComplete, source.OmittedFiles,
                source.ProjectImportId, source.SourceProjectName);
            var package = Studio.Import(contractFiles, source.SourceArchiveName, provenance);
            Select(package.Id); _fileName = _sourceContractPath; _sourceError = "";
        }
        catch (Exception e) when (e is InvalidDataException or ArgumentException or InvalidOperationException or XmlException or System.Xml.Schema.XmlSchemaException)
        { _sourceError = e.Message; }
    }

    private static string SnapshotLabel(SourceSchemaSnapshotSummary snapshot)
    {
        var name = string.IsNullOrWhiteSpace(snapshot.ArchiveName) ? $"Source snapshot {snapshot.Id.ToString("N")[..8]}" : snapshot.ArchiveName;
        var fingerprint = string.IsNullOrWhiteSpace(snapshot.Fingerprint) ? "fingerprint unavailable" : snapshot.Fingerprint[..Math.Min(12, snapshot.Fingerprint.Length)];
        var import = string.IsNullOrWhiteSpace(snapshot.ProjectImportId) ? "Source Analysis upload" : $"Project Import {snapshot.ProjectImportId}";
        return $"{name} · {import} · {snapshot.AnalyzedAt.ToLocalTime():g} · {fingerprint} · {(snapshot.HasSchemaArtifact ? "XSD available" : "XSD not retained")}";
    }

    private async Task OpenSavedSchema(string id)
    {
        if (SavedPackages?.Packages.FirstOrDefault(p => p.Id == id && p.ProjectScope == ProjectScope()) is not { } saved) return;
        try
        {
            SchemaPackage package;
            if (saved.Files is not null)
            {
                var alreadyOpen = Studio.Packages.FirstOrDefault(p => p.Fingerprint == saved.Fingerprint
                    && p.Provenance?.SourceSnapshotId == saved.Provenance?.SourceSnapshotId);
                package = alreadyOpen ?? SavedPackages!.ReopenLocal(saved, Studio);
            }
            else
            {
                var provenance = saved.Provenance;
                if (provenance?.SourceSnapshotId is not { } snapshotId || string.IsNullOrWhiteSpace(provenance.SourceSnapshotFingerprint))
                    throw new InvalidDataException("Saved Source Analysis reference is missing its immutable snapshot identity.");
                var snapshotFingerprint = provenance.SourceSnapshotFingerprint;
                var sourceApi = SourceSchemaApiService.Resolve(ServiceProvider)
                    ?? throw new InvalidOperationException("Source Analysis is unavailable in this session.");
                var source = await sourceApi.SourceSchemasAsync(snapshotId)
                    ?? throw new InvalidDataException("The exact Source Analysis snapshot no longer has an available XSD artifact.");
                if (source.SnapshotId != snapshotId || !string.Equals(source.SnapshotFingerprint, snapshotFingerprint, StringComparison.Ordinal))
                    throw new InvalidDataException("The reopened XSD artifact does not match the saved immutable snapshot.");
                if (!string.Equals(source.ProjectImportId, provenance.ProjectImportId, StringComparison.Ordinal))
                    throw new InvalidDataException("The reopened XSD artifact does not match the saved Project Import identity.");
                var files = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
                foreach (var file in source.Files)
                {
                    if (!files.TryAdd(file.Path.Replace('\\', '/'), file.Text)) throw new InvalidDataException("The snapshot contains duplicate XSD paths.");
                    var actual = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(Encoding.UTF8.GetBytes(file.Text))).ToLowerInvariant();
                    if (!string.Equals(actual, file.Fingerprint, StringComparison.Ordinal)) throw new InvalidDataException("An XSD file fingerprint did not match the saved snapshot.");
                }
                if (provenance.SelectedContractPath is not { Length: > 0 } contract)
                    throw new InvalidDataException("The saved Source Analysis reference does not identify a selected contract.");
                var contractFiles = SchemaStudioService.ContractPackageFiles(files, contract);
                package = Studio.Import(contractFiles, saved.Name, provenance with { SourceCaptureComplete = source.IsComplete, OmittedSourceFiles = source.OmittedFiles });
            }
            if (!string.Equals(package.Fingerprint, saved.Fingerprint, StringComparison.Ordinal))
            {
                Studio.Remove(package.Id);
                throw new InvalidDataException("Reopened XSD content does not match the fingerprint recorded with the saved analysis.");
            }
            Select(package.Id);
            if (saved.Provenance?.SelectedContractPath is { Length: > 0 } selectedPath) _fileName = selectedPath;
            _artifactError = ""; _artifactStatus = $"Reopened {saved.Name} with fingerprint {saved.Fingerprint[..Math.Min(12, saved.Fingerprint.Length)]}.";
        }
        catch (Exception e) when (e is InvalidDataException or ArgumentException or InvalidOperationException or XmlException or System.Xml.Schema.XmlSchemaException or HttpRequestException)
        { _artifactError = e.Message; }
    }

