                    ?? throw new InvalidOperationException("Source Analysis is unavailable in this session.");
                var source = await sourceApi.SourceSchemasAsync(snapshotId)
                    ?? throw new InvalidDataException("The exact Source Analysis snapshot no longer has an available XSD artifact.");
                if (source.SnapshotId != snapshotId || !string.Equals(source.SnapshotFingerprint, snapshotFingerprint, StringComparison.Ordinal))
                    throw new InvalidDataException("The reopened XSD artifact does not match the saved immutable snapshot.");
                if (!string.Equals(source.ProjectImportId, provenance.ProjectImportId, StringComparison.Ordinal))
                    throw new InvalidDataException("The reopened XSD artifact does not match the saved Project Import identity.");
                var files = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
                foreach (var file in source.Files)
                {
                    if (!files.TryAdd(file.Path.Replace('\\', '/'), file.Text)) throw new InvalidDataException("The snapshot contains duplicate XSD paths.");
                    var actual = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(Encoding.UTF8.GetBytes(file.Text))).ToLowerInvariant();
                    if (!string.Equals(actual, file.Fingerprint, StringComparison.Ordinal)) throw new InvalidDataException("An XSD file fingerprint did not match the saved snapshot.");
                }
                if (provenance.SelectedContractPath is not { Length: > 0 } contract)
                    throw new InvalidDataException("The saved Source Analysis reference does not identify a selected contract.");
                var contractFiles = SchemaStudioService.ContractPackageFiles(files, contract);
                package = Studio.Import(contractFiles, saved.Name, provenance with { SourceCaptureComplete = source.IsComplete, OmittedSourceFiles = source.OmittedFiles });
