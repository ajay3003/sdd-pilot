    private IEnumerable<(string Path, EffectiveMember Member)> ProfileMembers(SchemaPackage package)
    {
        foreach (var root in package.EffectiveSchema)
        {
            foreach (var attribute in ProfileAttributes(root, "/" + root.Name)) yield return attribute;
            foreach (var member in FlattenMembers(root)) yield return ("/" + root.Name + member.Path, member.Member);
        }
    }
    private static IEnumerable<(string Path, EffectiveMember Member)> FlattenMembers(EffectiveMember root, string path = "")
    {
        foreach (var child in root.Children)
        {
            var childPath = path + "/" + child.Name;
            yield return (childPath, child);
            foreach (var attribute in ProfileAttributes(child, childPath)) yield return attribute;
            foreach (var nested in FlattenMembers(child, childPath)) yield return nested;
        }
    }
    private static IEnumerable<(string Path, EffectiveMember Member)> ProfileAttributes(EffectiveMember owner, string path)
    {
        foreach (var attribute in owner.Attributes ?? [])
            yield return (path + "/@" + attribute.Name, new EffectiveMember(attribute.Name, attribute.Type, "1", "1", attribute.DeclaredIn,
                attribute.InheritedFrom, attribute.TypeDeclaredIn, null, attribute.Facets, [], attribute.NamespaceUri, null,
                attribute.DefaultValue, attribute.FixedValue, BaseType: attribute.BaseType));
    }
