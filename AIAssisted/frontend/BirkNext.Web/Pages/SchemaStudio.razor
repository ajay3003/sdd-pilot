    private static IEnumerable<string> DependencyEdges(SchemaPackage package, string mode)
    {
        foreach (var file in package.Files)
        {
            if (mode is "Files + namespaces" or "Files + types" or "All relationships") yield return $"{file.Name} → namespace {file.TargetNamespace ?? "(none)"}";
            foreach (var link in file.Links) yield return $"{file.Name} —{link.Kind.ToLowerInvariant()}→ {link.ResolvedFile ?? "unresolved: " + (link.Location ?? link.Namespace ?? "no location")}";
        }
        if (mode is "Files + types" or "All relationships") foreach (var reference in package.References) yield return $"{reference.SourceFile} —{reference.Kind} {reference.Name}→ {reference.TargetFile}";
    }
    private static RenderFragment RenderMember(EffectiveMember member) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "li"); builder.OpenElement(seq++, "strong"); builder.AddContent(seq++, member.Name); builder.CloseElement();
        builder.AddContent(seq++, " "); builder.OpenElement(seq++, "small");
        builder.AddContent(seq++, $"{member.Type ?? "inline"} · {member.MinOccurs}..{member.MaxOccurs} · declared in {member.DeclaredIn}");
        if (member.InheritedFrom is not null) builder.AddContent(seq++, $" · inherited from {member.InheritedFrom}");
        if (member.TypeDeclaredIn is not null) builder.AddContent(seq++, $" · type declared in {member.TypeDeclaredIn}");
        if (member.BaseType is not null && member.BaseType != member.Type) builder.AddContent(seq++, $" · base type {member.BaseType}");
        if (member.Compositor is not null) builder.AddContent(seq++, $" · {member.Compositor}");
        builder.CloseElement();
        if (member.Facets.Count > 0) { builder.OpenElement(seq++, "small"); builder.AddContent(seq++, " · " + string.Join(", ", member.Facets.Select(f => f.Kind + "=" + f.Value))); builder.CloseElement(); }
        if (member.Attributes is { Count: > 0 }) { builder.OpenElement(seq++, "ul"); foreach (var attribute in member.Attributes) builder.AddContent(seq++, RenderAttribute(attribute)); builder.CloseElement(); }
        if (member.Children.Count > 0) { builder.OpenElement(seq++, "ul"); foreach (var child in member.Children) builder.AddContent(seq++, RenderMember(child)); builder.CloseElement(); }
        builder.CloseElement();
    };
    private static RenderFragment RenderAttribute(EffectiveAttribute attribute) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "li"); builder.OpenElement(seq++, "strong"); builder.AddContent(seq++, "@" + attribute.Name); builder.CloseElement();
        builder.AddContent(seq++, " "); builder.OpenElement(seq++, "small");
        builder.AddContent(seq++, $"{attribute.Type ?? "inline"} · {attribute.Use} · declared in {attribute.DeclaredIn}");
        if (attribute.InheritedFrom is not null) builder.AddContent(seq++, $" · inherited from {attribute.InheritedFrom}");
        if (attribute.TypeDeclaredIn is not null) builder.AddContent(seq++, $" · type declared in {attribute.TypeDeclaredIn}");
        if (attribute.BaseType is not null && attribute.BaseType != attribute.Type) builder.AddContent(seq++, $" · base type {attribute.BaseType}");
        if (attribute.Facets.Count > 0) builder.AddContent(seq++, " · " + string.Join(", ", attribute.Facets.Select(f => f.Kind + "=" + f.Value)));
        builder.CloseElement(); builder.CloseElement();
    };
