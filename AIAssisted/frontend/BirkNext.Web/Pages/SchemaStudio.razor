    private async Task LoadSourceContracts()
    {
        if (!Guid.TryParse(_sourceSnapshotId, out var snapshotId)) return;
        var sourceApi = SourceSchemaApiService.Resolve(ServiceProvider);
        if (sourceApi is null) { _sourceError = "Source Analysis is unavailable in this session."; return; }
        _sourceBusy = true; _sourceError = ""; _sourcePackage = null; _sourceContractPath = "";
        try
        {
            var snapshot = _sourceSnapshots.FirstOrDefault(s => s.Id == snapshotId);
            if (snapshot is null)
            { _sourceError = "The selected Source Analysis snapshot is no longer available in the current snapshot index."; return; }
            if (!snapshot.HasSchemaArtifact)
            { _sourceError = "This immutable Source Analysis snapshot did not retain XSD artifacts. Reimport the source archive to create a reusable schema snapshot."; return; }
            var artifact = await sourceApi.SourceSchemasAsync(snapshotId);
            if (artifact is null)
            { _sourceError = "The selected Source Analysis snapshot's XSD artifact is unavailable."; return; }
            if (!artifact.IsAvailable)
            { _sourceError = artifact.UnavailableReason ?? "This Source Analysis snapshot has no reusable XSD artifacts."; return; }
            if (artifact.SnapshotId != snapshot.Id || string.IsNullOrWhiteSpace(snapshot.Fingerprint)
                || !string.Equals(artifact.SnapshotFingerprint, snapshot.Fingerprint, StringComparison.Ordinal))
            { _sourceError = "The returned XSD artifacts do not match the selected immutable Source Analysis snapshot."; return; }
            if (!string.Equals(artifact.ProjectImportId, snapshot.ProjectImportId, StringComparison.Ordinal))
            { _sourceError = "The returned XSD artifacts do not match the selected project import identity."; return; }
            _sourcePackage = artifact;
            _sourceContractPath = artifact.Files.FirstOrDefault(f => f.Path.EndsWith(".xsd", StringComparison.OrdinalIgnoreCase))?.Path ?? "";
            if (_sourceContractPath.Length == 0) _sourceError = "The selected snapshot contains no stored XSD files.";
        }
        catch (Exception e) when (e is HttpRequestException or TaskCanceledException or InvalidOperationException)
        { _sourceError = "The XSD artifacts could not be loaded from this snapshot."; }
        finally { _sourceBusy = false; }
    }

    private void OpenSourceContract()
    {
        if (_sourcePackage is not { } source || source.Files.Count == 0 || _sourceContractPath.Length == 0) return;
        try
        {
            var files = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            foreach (var file in source.Files)
            {
                var path = file.Path.Replace('\\', '/');
                if (!files.TryAdd(path, file.Text)) throw new InvalidDataException("The snapshot contains duplicate XSD paths.");
                var actual = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(Encoding.UTF8.GetBytes(file.Text))).ToLowerInvariant();
                if (!string.Equals(actual, file.Fingerprint, StringComparison.Ordinal)) throw new InvalidDataException("An XSD file fingerprint did not match the selected snapshot artifact.");
            }
            var contractFiles = SchemaStudioService.ContractPackageFiles(files, _sourceContractPath);
            var provenance = new SchemaProvenance("Source Analysis", source.SourceArchiveName, source.SnapshotId,
                source.SnapshotFingerprint, source.AnalyzedAt, _sourceContractPath, "", source.IsComplete, source.OmittedFiles,
                source.ProjectImportId, source.SourceProjectName);
            var package = Studio.Import(contractFiles, source.SourceArchiveName, provenance);
            Select(package.Id); _fileName = _sourceContractPath; _sourceError = "";
        }
        catch (Exception e) when (e is InvalidDataException or ArgumentException or InvalidOperationException or XmlException or System.Xml.Schema.XmlSchemaException)
        { _sourceError = e.Message; }
    }

