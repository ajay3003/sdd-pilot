        catch (Exception e) when (e is InvalidDataException or ArgumentException or System.Xml.XmlException) { _error = e.Message; }
    }
    private void AddDraftElement()
    {
        try
        {
            System.Xml.XmlConvert.VerifyNCName(_newChildName);
            if (_draft is null) throw new InvalidDataException("Select an XSD draft first.");
            using var reader = System.Xml.XmlReader.Create(new StringReader(_draft), new System.Xml.XmlReaderSettings { DtdProcessing = System.Xml.DtdProcessing.Prohibit, XmlResolver = null, MaxCharactersInDocument = SchemaStudioService.MaxFileBytes });
            var document = System.Xml.Linq.XDocument.Load(reader);
            var xs = System.Xml.Linq.XNamespace.Get("http://www.w3.org/2001/XMLSchema");
            var schema = document.Root ?? throw new InvalidDataException("XSD schema root is missing.");
            var typePrefix = schema.GetPrefixOfNamespace(xs);
            if (string.IsNullOrWhiteSpace(typePrefix))
            {
                typePrefix = "xs";
                while (schema.GetNamespaceOfPrefix(typePrefix) is not null) typePrefix += "d";
                schema.Add(new System.Xml.Linq.XAttribute(System.Xml.Linq.XNamespace.Xmlns + typePrefix, xs));
            }
            var root = schema.Elements(xs + "element").FirstOrDefault() ?? throw new InvalidDataException("A global root element is required before adding child elements.");
            var complex = root.Element(xs + "complexType");
            if (complex is null && root.Attribute("type") is { } typeAttribute)
            {
                var localTypeName = typeAttribute.Value.Split(':').Last();
                complex = schema.Elements(xs + "complexType").FirstOrDefault(t => (string?)t.Attribute("name") == localTypeName);
            }
            if (complex is null && root.Attribute("type") is null) { complex = new System.Xml.Linq.XElement(xs + "complexType"); root.Add(complex); }
            if (complex is null) throw new InvalidDataException("The root uses a non-inline type that is not a complex type; no child was added.");
            var content = complex.Elements().FirstOrDefault(e => e.Name == xs + "complexContent" || e.Name == xs + "simpleContent");
            var extension = content?.Elements().FirstOrDefault(e => e.Name == xs + "extension" || e.Name == xs + "restriction");
            var contentType = extension ?? complex;
            var compositor = contentType.Elements().FirstOrDefault(e => e.Name == xs + "sequence" || e.Name == xs + "choice" || e.Name == xs + "all");
            if (compositor is not null && compositor.Name != xs + "sequence") throw new InvalidDataException("Adding a field to this choice/all compositor needs an explicit designer edit; the draft was not changed.");
            compositor ??= new System.Xml.Linq.XElement(xs + "sequence");
            if (compositor.Parent is null) contentType.Add(compositor);
            if (compositor.Elements(xs + "element").Any(e => (string?)e.Attribute("name") == _newChildName)) throw new InvalidDataException("A child with that name already exists in the sequence.");
            if (!int.TryParse(_newChildMin, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var minimumOccurrences)
                || minimumOccurrences is < 0 or > 2 || _newChildMax is not ("1" or "2" or "unbounded")
                || _newChildMax != "unbounded" && int.Parse(_newChildMax, System.Globalization.CultureInfo.InvariantCulture) < minimumOccurrences)
                throw new InvalidDataException("Occurrence bounds must use a supported minimum and a maximum at least as large.");
            var enumerations = _newChildEnumeration.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
            if (enumerations.Length > 100 || enumerations.Any(value => value.Length > 256 || value.Any(char.IsControl)))
                throw new InvalidDataException("Use at most 100 enumeration values, each no longer than 256 printable characters.");
            var hasNumericMinimum = !string.IsNullOrWhiteSpace(_newChildNumericMinimum);
            var hasNumericMaximum = !string.IsNullOrWhiteSpace(_newChildNumericMaximum);
            var numericType = _newChildType is "xs:decimal" or "xs:integer";
            if ((hasNumericMinimum || hasNumericMaximum) && !numericType)
                throw new InvalidDataException("Inclusive numeric bounds require the Decimal or Integer element type.");
            if (hasNumericMinimum && !decimal.TryParse(_newChildNumericMinimum, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out _))
                throw new InvalidDataException("Enter a valid invariant-culture numeric minimum.");
            if (hasNumericMaximum && !decimal.TryParse(_newChildNumericMaximum, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out _))
                throw new InvalidDataException("Enter a valid invariant-culture numeric maximum.");
            if (hasNumericMinimum && hasNumericMaximum
                && decimal.Parse(_newChildNumericMinimum, System.Globalization.CultureInfo.InvariantCulture) > decimal.Parse(_newChildNumericMaximum, System.Globalization.CultureInfo.InvariantCulture))
                throw new InvalidDataException("The inclusive numeric minimum cannot exceed the maximum.");
            var added = new System.Xml.Linq.XElement(xs + "element", new System.Xml.Linq.XAttribute("name", _newChildName),
                new System.Xml.Linq.XAttribute("minOccurs", _newChildMin), new System.Xml.Linq.XAttribute("maxOccurs", _newChildMax));
            var selectedType = _newChildType.Replace("xs:", typePrefix + ":", StringComparison.Ordinal);
            if (enumerations.Length == 0 && !hasNumericMinimum && !hasNumericMaximum)
                added.Add(new System.Xml.Linq.XAttribute("type", selectedType));
            else
            {
                var restriction = new System.Xml.Linq.XElement(xs + "restriction", new System.Xml.Linq.XAttribute("base", selectedType));
                foreach (var value in enumerations) restriction.Add(new System.Xml.Linq.XElement(xs + "enumeration", new System.Xml.Linq.XAttribute("value", value)));
                if (hasNumericMinimum) restriction.Add(new System.Xml.Linq.XElement(xs + "minInclusive", new System.Xml.Linq.XAttribute("value", _newChildNumericMinimum.Trim())));
                if (hasNumericMaximum) restriction.Add(new System.Xml.Linq.XElement(xs + "maxInclusive", new System.Xml.Linq.XAttribute("value", _newChildNumericMaximum.Trim())));
