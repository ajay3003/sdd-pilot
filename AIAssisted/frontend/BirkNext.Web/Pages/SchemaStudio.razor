                var restriction = new System.Xml.Linq.XElement(xs + "restriction", new System.Xml.Linq.XAttribute("base", selectedType));
                foreach (var value in enumerations) restriction.Add(new System.Xml.Linq.XElement(xs + "enumeration", new System.Xml.Linq.XAttribute("value", value)));
                if (hasNumericMinimum) restriction.Add(new System.Xml.Linq.XElement(xs + "minInclusive", new System.Xml.Linq.XAttribute("value", _newChildNumericMinimum.Trim())));
                if (hasNumericMaximum) restriction.Add(new System.Xml.Linq.XElement(xs + "maxInclusive", new System.Xml.Linq.XAttribute("value", _newChildNumericMaximum.Trim())));
                added.Add(new System.Xml.Linq.XElement(xs + "simpleType", restriction));
            }
            compositor.Add(added);
            _draft = document.ToString(); _error = null;
        }
        catch (Exception e) when (e is InvalidDataException or ArgumentException or System.Xml.XmlException or InvalidOperationException) { _error = e.Message; }
    }
