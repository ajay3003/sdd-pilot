        _importRole = _snapshots.Count == 0 ? DeliverySnapshotRole.Baseline : DeliverySnapshotRole.Current;
        _effectiveInput = P.LocalInput(DateTimeOffset.Now);
        _focusImport = true;
    }

    private async Task CloseImport()
    {
        if (_projectId is { } pid) Session.Clear(pid);
        if (_preview is { } preview) await Api.DiscardAsync(preview.StagingId);
        _preview = null;
        _importOpen = false;
    }

    private async Task ChooseSource(bool azureDevOps)
    {
        if (_fromAzureDevOps == azureDevOps) return;
        _fromAzureDevOps = azureDevOps;
        if (_preview is { } old) await Api.DiscardAsync(old.StagingId);
        _preview = null;
        _adoNote = null;
        _importError = null;
        _confirmDuplicate = false;
    }

    /// <summary>The resolved commit's tree was previewed by the same pipeline as a ZIP; its state time becomes the effective date.</summary>
    private async Task OnAzureDevOpsPreview((DeliveryImportPreview Preview, string? Note) result)
    {
        if (_preview is { } old && old.StagingId != result.Preview.StagingId) await Api.DiscardAsync(old.StagingId);
        _preview = result.Preview;
        _adoNote = result.Note;
        _importError = null;
        _confirmDuplicate = false;
        if (result.Preview.SuggestedEffectiveAt is { } at) _effectiveInput = P.LocalInput(at);
        if (string.IsNullOrWhiteSpace(_importLabel) && result.Preview.AzureDevOps is { } ado) _importLabel = $"{ado.Branch} {P.Day(result.Preview.SuggestedEffectiveAt ?? ado.CommitAt)}";
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _importError = null;
        if (_preview is { } old) await Api.DiscardAsync(old.StagingId);
        _preview = null;
        _confirmDuplicate = false;
        _busy = true;
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 50L * 1024 * 1024);
            var (preview, error) = await Api.PreviewAsync(_projectId, e.File.Name, stream);
            _preview = preview;
            _importError = error;
        }
        catch (IOException)
        {
            _importError = "The file could not be read. ZIPs up to 50 MB are supported.";
        }
        finally { _busy = false; }
    }

    private async Task CommitImport()
    {
        if (_preview is not { } preview || _projectId is not { } id || P.ParseLocalInput(_effectiveInput) is not { } effective) return;
        _busy = true;
        try
        {
            var result = await Api.CommitAsync(preview.StagingId, new DeliveryImportCommitRequest
            {
                ProjectId = id, EffectiveAt = effective, Role = _importRole, Label = string.IsNullOrWhiteSpace(_importLabel) ? null : _importLabel,
                ConfirmDuplicate = _confirmDuplicate,
            });
            if (result.Snapshot is { } snapshot)
            {
                Session.Clear(id, preview.StagingId);
                _importOpen = false;
                _preview = null;
                _notice = $"Snapshot “{P.DisplayName(snapshot)}” imported: {snapshot.FeatureCount} features, {snapshot.CompletedTaskCount}/{snapshot.TaskCount} tasks completed.";
                _snapshots = await Api.SnapshotsAsync(id);
                _projects = (await Api.ProjectsAsync()).Projects;
                // A choice the person made stays; only an unchosen selection follows the new current snapshot.
                if (!_userChoseSnapshots) await DefaultSelectionAsync();
                else await KeepSelectionAsync();
            }
            else if (result.DuplicateWarning is { } duplicate) _preview = preview with { DuplicateWarning = duplicate };
            else _importError = result.Error;
        }
        finally { _busy = false; }
    }

    private async Task OnDialogKey(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return;
        if (_confirm is not null) _confirm = null;
        else if (_importOpen) await CloseImport();
    }

    // ── Reports ─────────────────────────────────────────────────────────────────────────────────────────────────────

    /// <summary>
    /// Generates the report as a background operation with its project, baseline and current snapshot captured at start. Leaving the page does
    /// not stop it and its completion never navigates elsewhere: only a page still showing that project opens the new report; otherwise the
    /// Activity Center offers it. The same baseline/current pair is not generated twice at once.
    /// </summary>
    // ── Comparison preview, swap and direction confirmation ─────────────────────────────────────────────────────────────
    private DeliveryComparisonPreview? _comparison;
    private string? _comparisonError;
    private bool _confirmDirection;
    private Guid? _correctId;
    private DateTime? _correctValue;
    private string? _correctReason;

    private async Task OnBaselineChanged(ChangeEventArgs e)
    {
        _baselineId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        (_userChoseSnapshots, _selectionNotice) = (true, null);
        await LoadPreviewAsync();
    }

    /// <summary>Baseline → Current before generation: never generated blind, never reversed silently.</summary>
    private async Task LoadPreviewAsync()
    {
        _comparison = null; _comparisonError = null; _confirmDirection = false;
        if (_projectId is not { } project || _baselineId is not { } baseline || _currentId is not { } current || baseline == current) return;
        (_comparison, _comparisonError) = await Api.ComparisonPreviewAsync(project, baseline, current);
    }

    private async Task Swap()
    {
        (_baselineId, _currentId) = (_currentId, _baselineId);
        _userChoseSnapshots = true;
        await LoadPreviewAsync();
    }

    private static string DirectionLabel(DeliveryDirectionState state) => state switch
    {
        DeliveryDirectionState.InventoryReduced => "Possible rollback / scope reduction / reversed direction",
        DeliveryDirectionState.SameEffectiveDate => "Same effective date — source order not confirmable from dates",
        DeliveryDirectionState.BaselineLater => "Reversed — the baseline is later than the current snapshot",
        _ => "Chronological",
    };

    private static string Signed(int value) => value > 0 ? $"+{value}" : value.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private RenderFragment PreviewPanel() => __builder =>
    {
        if (_comparisonError is { } previewError) { <p class="dlr-warning" role="alert" data-testid="dlr-preview-error">@previewError</p> }
        if (_comparison is not { } pv) return;
        <section class="dlr-preview" aria-labelledby="dlr-preview-h" data-testid="dlr-preview" data-direction="@pv.Direction">
            <h3 class="dlr-h3" id="dlr-preview-h">Baseline → Current</h3>
            <table class="dlr-table dlr-preview-table" data-testid="dlr-preview-table">
                <thead><tr><th scope="col">Metric</th><th scope="col">Baseline</th><th scope="col">Current</th><th scope="col">Change</th></tr></thead>
                <tbody>
                    <tr data-key="features"><th scope="row">Features</th><td>@pv.BaselineInventory.Features</td><td>@pv.CurrentInventory.Features</td><td>@Signed(pv.FeatureDelta)</td></tr>
                    <tr data-key="tasks"><th scope="row">Tasks</th><td>@pv.BaselineInventory.Tasks</td><td>@pv.CurrentInventory.Tasks</td><td>@Signed(pv.TaskDelta)</td></tr>
                    <tr data-key="checked"><th scope="row">Checked tasks</th><td>@pv.BaselineInventory.CheckedTasks</td><td>@pv.CurrentInventory.CheckedTasks</td><td>@Signed(pv.CheckedDelta)</td></tr>
                </tbody>
            </table>
            <p class="dlr-muted" data-testid="dlr-preview-dates">Effective dates: @P.DayTime(pv.Baseline.EffectiveAt) → @P.DayTime(pv.Current.EffectiveAt) (imported @P.DayTime(pv.Baseline.ImportedAt) / @P.DayTime(pv.Current.ImportedAt))</p>
            <p data-testid="dlr-preview-coverage">@pv.CoverageText</p>
            <p data-testid="dlr-preview-direction"><strong>Direction:</strong> @DirectionLabel(pv.Direction)</p>
            @foreach (var w in pv.Warnings) { <p class="dlr-warning" role="note" data-testid="dlr-preview-warning">@w</p> }
            @if (pv.MissingFeatures.Count > 0) { <details data-testid="dlr-preview-missing"><summary>@pv.MissingFeatures.Count feature@(pv.MissingFeatures.Count == 1 ? "" : "s") only in the baseline</summary><ul class="dlr-list dlr-compact">@foreach (var f in pv.MissingFeatures) { <li>@f</li> }</ul></details> }
            @if (pv.NewFeatures.Count > 0) { <details data-testid="dlr-preview-new"><summary>@pv.NewFeatures.Count feature@(pv.NewFeatures.Count == 1 ? "" : "s") only in the current snapshot</summary><ul class="dlr-list dlr-compact">@foreach (var f in pv.NewFeatures) { <li>@f</li> }</ul></details> }
            <p class="dlr-preview-actions">
                <button type="button" class="btn-secondary" data-testid="dlr-swap" @onclick="Swap">Swap Baseline / Current</button>
                <a class="dlr-link" href="@P.SnapshotsHref(_projectId)" data-testid="dlr-preview-snapshots">Review snapshot details</a>
            </p>
            @if (pv.RequiresConfirmation)
            {
                <label class="dlr-confirm" data-testid="dlr-confirm-direction"><input type="checkbox" checked="@_confirmDirection" @onchange="e => _confirmDirection = e.Value is true" data-testid="dlr-confirm-direction-input" />
                    I have verified the direction (e.g. a legitimate scope reduction). Record this confirmation in the report and generate anyway.</label>
            }
        </section>
    };

    /// <summary>"Version 2 of W44 · different snapshot pair" — reports of one week are listed as versions, and a different pair is said explicitly.</summary>
    private string? HistoryVersion(DeliveryReportSummaryRow r)
    {
        var sameWeek = _reports.Where(x => x.WeekLabel == r.WeekLabel).OrderBy(x => x.GeneratedAt).ToList();
        if (sameWeek.Count < 2) return null;
        var version = sameWeek.FindIndex(x => x.Id == r.Id) + 1;
        var differentPair = r.PairKey.Length > 0 && sameWeek.Any(x => x.Id != r.Id && x.PairKey.Length > 0 && x.PairKey != r.PairKey);
        return $"Version {version} of {sameWeek.Count} for {r.WeekLabel}{(differentPair ? " · compares a different snapshot pair — not interchangeable" : " · same snapshot pair")}";
    }

    private async Task CorrectEffectiveDate(DeliverySnapshotSummary s)
    {
        if (_projectId is not { } project || _correctValue is not { } value) return;
        var local = new DateTimeOffset(value, TimeZoneInfo.Local.GetUtcOffset(value));
        var (updated, error) = await Api.UpdateSnapshotAsync(project, s.Id, new UpdateDeliverySnapshotRequest(null, null, local, _correctReason));
        if (updated is null) { _error = error ?? "The effective date could not be corrected."; return; }
        _correctId = null;
        _snapshots = await Api.SnapshotsAsync(project);
        await LoadPreviewAsync();
    }

    private async Task Generate()
    {
        if (_projectId is not { } id || _baselineId is not { } baseline || _currentId is not { } current) return;
        _busy = true;
        _error = null;
        var confirm = _confirmDirection;
        var (source, scope) = (_generateSource, _generateScope);
        var baselineLabel = _snapshots.FirstOrDefault(s => s.Id == baseline) is { } b ? P.DisplayName(b) : null;
        var currentLabel = _snapshots.FirstOrDefault(s => s.Id == current) is { } c ? P.DisplayName(c) : null;
        WeeklyDeliveryReport? generated = null;
        try
        {
            var run = Operations.Start(new(BirkNext.Web.Services.Operations.OperationKind.DeliveryReportGeneration, "Generating weekly report",
                new(ProjectName ?? "Delivery project", id.ToString()) { Baseline = baselineLabel, Revision = currentLabel }, $"{P.Route}?project={id}&tab=history")
            {
                IdempotencyKey = $"delivery-report:{id}:{baseline}:{current}:{source}:{scope}",
                // The backend generates and saves in one request; it is not cancellable once sent.
                Cancellable = false,
            }, async (progress, ct) =>
            {
                progress.Stage("Comparing snapshots and generating the report", $"{baselineLabel} → {currentLabel}");
                var (report, error) = await Api.GenerateAsync(new GenerateWeeklyReportRequest(id, baseline, current) { ConfirmDirection = confirm, SourceId = source, FunctionalScopeId = scope });
                if (report is null) return BirkNext.Web.Services.Operations.OperationOutcome.Failure(error ?? "The report could not be generated.");
                generated = report;
                return BirkNext.Web.Services.Operations.OperationOutcome.Success($"{P.Route}?project={id}&tab=overview&report={report.ReportId}", $"Open report {report.WeekLabel}");
            });
            var done = await run.Completion;
            if (_disposed || _projectId != id) return;
            if (done.Status != BirkNext.Web.Services.Operations.OperationStatus.Completed) { _error = done.Error; return; }
            _reports = await Api.ReportsAsync(id);
            if (generated is { } report)
            {
                _report = report;
                _notice = $"Weekly report {report.WeekLabel} generated and saved to report history.";
                Nav.NavigateTo($"{P.Route}?project={id}&tab=overview&report={report.ReportId}");
            }
            else if (run.Duplicate) _notice = "This report was already being generated; it is now in report history.";
        }
        finally { if (!_disposed) _busy = false; }
    }

    private void OpenReport(Guid reportId) => Nav.NavigateTo($"{P.Route}?project={_projectId}&tab=overview&report={reportId}");

    private IReadOnlyList<ExportMenu.Option> ExportOptions(Guid reportId) =>
    [
        new("markdown", "Markdown (.md)", () => ExportAsync(reportId, DeliveryExportFormat.Markdown)),
        new("html", "HTML (.html)", () => ExportAsync(reportId, DeliveryExportFormat.Html)),
    ];

    /// <summary>
    /// Exports as an operation: the file is kept by the Activity Center (download it again from there). The browser download starts only while
    /// this page is shown; whether the browser saved the file cannot be observed, so the notice says the download was started.
    /// </summary>
    private async Task ExportAsync(Guid reportId, DeliveryExportFormat format)
    {
        if (_projectId is not { } id) return;
        var (appendix, unchanged) = (_exportAppendix, _exportUnchanged);
        DeliveryReportExport? file = null;
        var run = Operations.Start(new(BirkNext.Web.Services.Operations.OperationKind.DeliveryReportExport, $"Exporting report ({format})",
            new(ProjectName ?? "Delivery project", id.ToString()) { Revision = _report?.WeekLabel }, $"{P.Route}?project={id}&tab=overview&report={reportId}")
        {
            IdempotencyKey = $"delivery-export:{id}:{reportId}:{format}:{appendix}:{unchanged}", Cancellable = false,
        }, async (progress, ct) =>
        {
            progress.Stage("Rendering the export from the saved report");
            var (export, error) = await Api.ExportAsync(id, reportId, format, appendix, unchanged);
            if (export is null) return BirkNext.Web.Services.Operations.OperationOutcome.Failure(error ?? "The export could not be created.");
            file = export;
            return BirkNext.Web.Services.Operations.OperationOutcome.Success(file: new(export.FileName, export.ContentType, export.Content));
        });
        var done = await run.Completion;
        if (_disposed) return;
        if (done.Status != BirkNext.Web.Services.Operations.OperationStatus.Completed || (file ?? (done.File is { } f ? new DeliveryReportExport(f.FileName, f.ContentType, f.Content) : null)) is not { } ready)
        { _error = done.Error ?? "The export could not be created."; return; }
        try
        {
            await JS.InvokeVoidAsync("downloadTextFile", ready.FileName, ready.Content, ready.ContentType);
            _notice = $"Download of {ready.FileName} started. It is also kept under Activity.";
        }
        catch (JSException) { _error = $"{ready.FileName} was created, but the browser download could not be started. Download it from Activity."; }
    }

    private void AskDeleteReport(DeliveryReportSummaryRow r)
    {
        _confirm = new("Delete report?", $"Delete “{r.Title} — {r.WeekLabel}” generated {P.DayTime(r.GeneratedAt)}? Snapshots are not affected.", "Delete report", async () =>
        {
            if (_projectId is not { } id) return;
            _error = await Api.DeleteReportAsync(id, r.Id);
            _reports = await Api.ReportsAsync(id);
            if (_report?.ReportId == r.Id) _report = _reports.FirstOrDefault() is { } next ? await Api.ReportAsync(id, next.Id) : null;
            _notice = _error is null ? "Report deleted." : null;
        });
        _focusConfirm = true;
    }

    // ── Snapshots ───────────────────────────────────────────────────────────────────────────────────────────────────

    private async Task View(DeliverySnapshotSummary s)
    {
        if (_viewId == s.Id) { _viewId = null; _view = null; return; }
        _viewId = s.Id;
        _view = _projectId is { } id ? await Api.SnapshotAsync(id, s.Id) : null;
    }

    private async Task CompareFrom(DeliverySnapshotSummary s)
    {
        _currentId = s.Id;
        (_userChoseSnapshots, _selectionNotice) = (true, null);
        await SuggestAsync();
        await LoadPreviewAsync();
        await LoadGenerationScopeAsync();
        Nav.NavigateTo($"{P.Route}?project={_projectId}&tab=overview{(_report is null ? "" : $"&report={_report.ReportId}")}");
    }

    private async Task Rename(DeliverySnapshotSummary s)
    {
        if (_projectId is not { } id) return;
        var (_, error) = await Api.UpdateSnapshotAsync(id, s.Id, new UpdateDeliverySnapshotRequest(_renameValue, null));
        _error = error;
        _renameId = null;
        _snapshots = await Api.SnapshotsAsync(id);
    }

    private async Task ChangeRole(DeliverySnapshotSummary s, string? value)
    {
        if (_projectId is not { } id || !Enum.TryParse<DeliverySnapshotRole>(value, out var role)) return;
        var (_, error) = await Api.UpdateSnapshotAsync(id, s.Id, new UpdateDeliverySnapshotRequest(null, role));
        _error = error;
        _snapshots = await Api.SnapshotsAsync(id);
    }

    private void AskDeleteSnapshot(DeliverySnapshotSummary s)
    {
        var reports = s.ReportCount > 0 ? $" {s.ReportCount} generated report{(s.ReportCount == 1 ? "" : "s")} used it and keep their saved content." : "";
        _confirm = new("Delete snapshot?", $"Delete snapshot “{P.DisplayName(s)}” ({P.Day(s.EffectiveAt)})? Only Delivery Reporting data is removed.{reports}", "Delete snapshot", async () =>
        {
            if (_projectId is not { } id) return;
            _error = await Api.DeleteSnapshotAsync(id, s.Id);
            _snapshots = await Api.SnapshotsAsync(id);
            if (_viewId == s.Id) { _viewId = null; _view = null; }
            if (_baselineId == s.Id || _currentId == s.Id)
            {
                if (_userChoseSnapshots) await KeepSelectionAsync();
                else await DefaultSelectionAsync();
            }
            _notice = _error is null ? "Snapshot deleted." : null;
        });
        _focusConfirm = true;
    }

    private async Task RunConfirm()
    {
        var confirm = _confirm;
        _confirm = null;
        if (confirm is not null) await confirm.Run();
    }
}
