@page "/delivery-reporting"
@page "/delivery-snapshots"
@* Delivery data is read from the Delivery Reporting API only, never from workspace documents: no wait for document bodies. *@
@attribute [BirkNext.Web.Services.WorkspaceDocumentsNotRead]
@using BirkNext.DeliveryReporting
@using BirkNext.Web.Services
@using BirkNext.Web.Shared.Components.Common
@using BirkNext.Web.Components
@using P = BirkNext.Web.Services.DeliveryReportingPresentation
@inject IDeliveryReportingApiService Api
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject BirkNext.Web.Services.Operations.BackgroundOperationService Operations
@inject DeliveryReportingSession Session
@implements IDisposable

@* Delivery Reporting: a standalone weekly delivery report for Scrum Masters and Project Leaders. Everything on this page comes from
   Delivery Reporting's own projects, snapshots and frozen reports — never from the current workspace, Target Environment or Source Analysis. *@

<PageTitle>@(OnSnapshotsRoute ? "Delivery Snapshots" : "Delivery Reports")</PageTitle>

<div class="sd-workspace dlr-page" data-testid="dlr-page" aria-busy="@(_loaded ? "false" : "true")">
    @* One header for every tab (sticky while scrolling): which report, which period, what it holds, and the project/import actions. *@
    <div class="dlr-sticky" data-testid="dlr-sticky-header" data-sticky-offset>
    <header class="dlr-header">
        <div>
            @if (OnSnapshotsRoute)
            {
                <h1 class="dlr-page-title" data-testid="dlr-page-title">Delivery Snapshots</h1>
                <p class="dlr-lead" data-testid="dlr-lead">Import, inspect and choose the immutable snapshots that Delivery Overview and Delivery Reports read.</p>
            }
            else
            {
            <h1 class="dlr-page-title" data-testid="dlr-page-title">Delivery Reports</h1>
            <p class="dlr-lead" data-testid="dlr-lead">Understand what changed between delivery snapshots.
                <span class="dlr-info" tabindex="0" title="@CoverageHelp" aria-label="@CoverageHelp">ⓘ</span></p>
            <p class="dlr-sub">Compare scope, Features, User Stories, tasks and quality findings. Generate reports and inspect historical evidence.</p>
            @if (_report is { } headerReport)
            {
                @* "Weekly" only when the comparison genuinely covers a reporting week; a same-day or ad-hoc comparison is a change report. *@
                <p class="dlr-title" data-testid="dlr-title">@DeliveryReportContext.Title(headerReport)@if (DeliveryReportContext.Week(headerReport) is { } week) { <span class="dlr-muted"> · @week</span> }</p>
                <p class="dlr-header-period" data-testid="dlr-context" role="status">@DeliveryReportContext.Line(headerReport)</p>
                <p class="dlr-header-meta" data-testid="dlr-header-meta">@HeaderMeta(headerReport)</p>
            }
            else
            {
                <p class="dlr-muted dlr-clarify" data-testid="dlr-clarification">Change reporting reflects the selected snapshots. Same-day comparisons are not full weekly reports.</p>
            }
            }
        </div>
        <div class="dlr-header-actions">
            <label class="dlr-field dlr-project-field">
                <span>Reporting project</span>
                <select data-testid="dlr-project" value="@(_projectId?.ToString() ?? "")" @onchange="OnProjectChanged">
                    @if (_projects.Count == 0) { <option value="">No reporting projects yet</option> }
                    @foreach (var project in _projects) { <option value="@project.Id">@project.Name</option> }
                </select>
            </label>
            <DeliveryRolePicker Role="_role" OnChange="SetRoleAsync" TestId="dlr-role" />
            <button type="button" class="btn-secondary" data-testid="dlr-new-project" aria-expanded="@(_newProjectOpen ? "true" : "false")" aria-controls="dlr-new-project-form"
                    @onclick="ToggleNewProject">+ New reporting project</button>
            @* One primary import action, on Delivery Snapshots; Delivery Reports links there instead of managing snapshots itself. *@
            @if (OnSnapshotsRoute)
            {
                <button type="button" class="btn-primary" data-testid="dlr-import-open" disabled="@(_projectId is null)" @onclick="OpenImport">Import snapshot</button>
            }
            else if (_projectId is not null)
            {
                <a class="btn-secondary" href="@P.SnapshotsHref(_projectId)" data-testid="dlr-manage-snapshots">Manage Delivery Snapshots</a>
            }
            @if (PendingPreview is { } pending)
            {
                <button type="button" class="btn-secondary" data-testid="dlr-import-pending" @onclick="ReviewPending">Review prepared import (@(pending.Preview.AzureDevOps?.ShortCommit ?? pending.Preview.FileName))</button>
            }
        </div>
    </header>

    @if (_newProjectOpen)
    {
        <form id="dlr-new-project-form" class="dlr-card dlr-inline-form" data-testid="dlr-new-project-form" @onsubmit="CreateProject" @onsubmit:preventDefault>
            <h2 class="dlr-h2">New reporting project</h2>
            <p class="dlr-muted">A reporting project holds its own snapshots and reports. No environment or existing BirkNext project is needed.</p>
            <label class="dlr-field"><span>Name</span><input @ref="_newProjectName" data-testid="dlr-new-project-name" @bind="_newName" maxlength="200" required /></label>
            <label class="dlr-field"><span>Description (optional)</span><input data-testid="dlr-new-project-description" @bind="_newDescription" maxlength="2000" /></label>
            @if (_newProjectError is not null) { <p class="dlr-error" role="alert">@_newProjectError</p> }
            <div class="dlr-actions">
                <button type="submit" class="btn-primary" data-testid="dlr-new-project-save">Create project</button>
                <button type="button" class="btn-secondary" @onclick="ToggleNewProject">Cancel</button>
            </div>
        </form>
    }

    @if (_loaded && _projectId is not null && !OnSnapshotsRoute)
    {
        <nav class="dlr-tabs" aria-label="Delivery Reporting sections">
            @foreach (var (id, label) in P.Tabs)
            {
                <a href="@TabHref(id)" class="dlr-tab @(_tab == id ? "active" : "")" aria-current="@(_tab == id ? "page" : null)" data-testid="dlr-tab-@id">@label</a>
            }
        </nav>
    }
    </div>

    @if (_error is not null) { <p class="dlr-error" role="alert" data-testid="dlr-error">@_error</p> }
    @if (_notice is not null) { <p class="dlr-notice" role="status" data-testid="dlr-notice">@_notice</p> }

    @if (!_loaded)
    {
        <div class="dlr-skeleton" role="status" aria-label="Loading Delivery Reporting"><span></span><span></span><span></span></div>
    }
    else if (_projectId is null)
    {
        <section class="dlr-card dlr-empty" data-testid="dlr-no-project">
            <h2 class="dlr-h2">Create a reporting project to start</h2>
            <p>Create a project such as <strong>M2LB</strong>, import a baseline and a current snapshot (repository ZIPs), and generate the weekly report.</p>
            <button type="button" class="btn-primary" @onclick="ToggleNewProject">+ New reporting project</button>
        </section>
    }
    else
    {
        @if (_tab == "overview") { @Overview() }
        else if (_tab == "stories") { @Stories() }
        else if (_tab == "changes") { @ChangeBoardTab() }
        else if (_tab == "snapshots") { @Snapshots() }
        else if (_tab == "scope") { <FunctionalQualityScopePanel ProjectId="_projectId.Value" InitialScope="@ScopeKeyQuery" /> }
        else { @History() }
    }

    @if (_importOpen) { @ImportDialog() }
    @if (_confirm is not null) { @ConfirmDialog() }
</div>

@code {
    // ── Shared presentation helpers (header, headline cards, attention split) ──────────────────────────────────────

    /// <summary>Attention items shown per category on the Overview; the rest stay one click away in Stories.</summary>
    private const int AttentionPreview = 10;
    private const string CoverageHelp = "Comparison coverage depends on the selected snapshots and their source/revision context.";

    /// <summary>A frozen metric's value, or "–" when the report does not carry it (never a 0 for an unknown).</summary>
    private static string Fig(WeeklyDeliveryReport r, string key) => r.Metrics.FirstOrDefault(m => m.Key == key)?.Value.ToString() ?? "–";

    private static string CriteriaNow(WeeklyDeliveryReport r) =>
        r.Stories.Any(s => s.Hierarchy is not null) ? r.Stories.Where(s => !s.RemovedFeature).Sum(s => s.Hierarchy?.CriteriaCurrent ?? 0).ToString() : "–";

    /// <summary>"38 features · 138 user stories · 6 scenarios · 123 AC · Partial comparison".</summary>
    private static string HeaderMeta(WeeklyDeliveryReport r) => string.Join(" · ", new[]
    {
        $"{Fig(r, "inventory-features")} features",
        r.Metrics.Any(m => m.Key == "inventory-stories") ? $"{Fig(r, "inventory-stories")} user stories" : null,
        r.Metrics.Any(m => m.Key == "inventory-scenarios") ? $"{Fig(r, "inventory-scenarios")} scenarios" : null,
        CriteriaNow(r) is var ac && ac != "–" ? $"{ac} AC" : null,
        r.PeriodCoverage switch { DeliveryPeriodCoverage.FullPeriod => "Full-period comparison", DeliveryPeriodCoverage.PartialPeriod => "Partial comparison",
            DeliveryPeriodCoverage.SameDay => "Same-day comparison", _ => null },
        r.Scope?.Label is { Length: > 0 } scope ? $"Scope: {scope}" : null,
    }.Where(x => x is not null));

    /// <summary>Repository hygiene, not a feature's delivery: items without a feature, and suspected source encoding damage.</summary>
    /// <summary>What the headline total measures: attention items attached to a feature plus scope changes to confirm (each item once); the reference counts
    /// are categories that may overlap it, and hygiene warnings and comparison limitations are listed apart.</summary>
    private const string AttentionDefinition = "Feature attention items: review items attached to a feature, each counted once (e.g. broken traceability, a removed-story reference, a specification "
        + "without tasks). Scope changes to confirm are counted apart; task reference counts overlap these items; project hygiene warnings and comparison limitations are not included.";

    private static bool IsHygiene(DeliveryAttentionItem a) => a.FeatureKey is null || a.Kind == DeliveryAttentionKind.SourceEncoding;
    private static List<DeliveryAttentionItem> HygieneItems(WeeklyDeliveryReport r) => [.. r.Attention.Where(IsHygiene)];
    private static List<DeliveryAttentionItem> DeliveryAttention(WeeklyDeliveryReport r) => [.. r.Attention.Where(a => !IsHygiene(a))];

    // ── Overview ─────────────────────────────────────────────────────────────────────────────────────────────────────

    private RenderFragment Overview() => __builder =>
    {
        if (_report is null)
        {
            @GeneratePanel()
            <section class="dlr-card dlr-empty" data-testid="dlr-no-report">
                <h2 class="dlr-h2">No weekly report yet</h2>
                <p>@(_snapshots.Count < 2 ? "Import a baseline and a current snapshot, then generate the weekly report." : "Choose a baseline and a current snapshot above and generate the weekly report.")</p>
            </section>
            return;
        }
        var report = _report;
        <section class="dlr-card dlr-report-head" data-testid="dlr-report" aria-label="Saved report comparison">
            <p class="dlr-kicker" data-testid="dlr-saved-label">Saved report comparison <span class="dlr-muted">· frozen when generated; the selection below does not change it</span></p>
            <div class="dlr-report-title">
                <h2 class="dlr-h2" data-testid="dlr-report-title">@DeliveryReportTitles.Display(report)</h2>
                @{ var (previous, next) = DeliveryIntelligenceHistory.Neighbours(_reports, report.ReportId); }
                @if (previous is null && next is null && _reports.Count > 1)
                {
                    <nav class="dlr-report-nav" aria-label="Report history" data-testid="dlr-report-nav">
                        <span class="dlr-muted" data-testid="dlr-report-only">The only report of this @(string.IsNullOrEmpty(report.Scope?.Label) ? "comparison" : "scope")</span>
                        <a href="@TabHref("history")" data-testid="dlr-report-history-link">All @_reports.Count reports</a>
                    </nav>
                }
                else if (previous is not null || next is not null)
                {
                    <nav class="dlr-report-nav" aria-label="Report history" data-testid="dlr-report-nav">
                        @if (previous is { } prev) { <a href="@ReportHref(prev.Id)" data-testid="dlr-report-prev" rel="prev">← Previous report <span class="dlr-muted">(@prev.PeriodEnd.ToString("d MMM"))</span></a> }
                        @if (next is { } nxt) { <a href="@ReportHref(nxt.Id)" data-testid="dlr-report-next" rel="next">Next report <span class="dlr-muted">(@nxt.PeriodEnd.ToString("d MMM"))</span> →</a> }
                        else { <span class="dlr-muted" data-testid="dlr-report-latest">Latest report</span> }
                    </nav>
                }
                @if (report.CoverageText.Length > 0) { <p class="dlr-coverage-text" data-testid="dlr-report-coverage" data-coverage="@report.PeriodCoverage">@report.CoverageText</p> }
                @if (report.Scope is { } reportScope)
                {
                    <p class="dlr-scope" data-testid="dlr-report-scope">
                        @if (reportScope.SourceName is { } sourceName) { <span>Source: <strong>@sourceName</strong></span> }
                        @if (reportScope.FunctionalScopeName is { } scopeName) { <span>Functional scope: <strong>@scopeName</strong></span> }
                        <span class="dlr-muted">Scoped report: counts cover these features only (@reportScope.CurrentFeatureKeys.Count now, @reportScope.BaselineFeatureKeys.Count in the baseline).@(reportScope.SourceInBaseline ? "" : " The source is not present in the baseline.")@(reportScope.ScopeInBaseline ? "" : " The functional scope is not present in the baseline.")</span>
                    </p>
                }
                <p class="dlr-muted" data-testid="dlr-report-kind">@(report.Kind == DeliveryReportKind.Weekly ? "Weekly report: the baseline covers this week." : "Delivery change report: compares two snapshots; not a full weekly period.") Baseline @P.DayTime(report.Baseline.EffectiveAt) (imported @P.DayTime(report.Baseline.ImportedAt)) → current @P.DayTime(report.Current.EffectiveAt) (imported @P.DayTime(report.Current.ImportedAt)).</p>
                <ExportMenu TestId="dlr-export" Options="ExportOptions(report.ReportId)" />
            </div>
            <dl class="dlr-meta">
                <div><dt>Project</dt><dd data-testid="dlr-meta-project">@report.ProjectName</dd></div>
                <div><dt>Period</dt><dd data-testid="dlr-meta-period">@P.Period(report.PeriodStart, report.PeriodEnd)</dd></div>
                <div><dt>Baseline</dt><dd data-testid="dlr-meta-baseline">@P.SnapshotLine(report.Baseline) <span class="dlr-muted">(@report.Baseline.Label)</span></dd></div>
                <div><dt>Current</dt><dd data-testid="dlr-meta-current">@P.SnapshotLine(report.Current) <span class="dlr-muted">(@report.Current.Label)</span></dd></div>
                <div><dt>Coverage</dt><dd><span class="dlr-badge @P.CoverageTone(report.Coverage)" data-testid="dlr-meta-coverage">@report.Coverage</span></dd></div>
                <div><dt>Generated</dt><dd>@P.DayTime(report.GeneratedAt)</dd></div>
                @if (report.Direction is { } direction)
                {
                    <div><dt>Snapshot direction</dt><dd data-testid="dlr-meta-direction" data-direction="@direction.State">@DirectionLabel(direction.State)@(direction.Confirmed ? " · explicitly confirmed" : "")</dd></div>
                }
            </dl>
            <div class="dlr-export-options">
                <label><input type="checkbox" data-testid="dlr-export-appendix" @bind="_exportAppendix" /> Include evidence appendix</label>
                <label><input type="checkbox" data-testid="dlr-export-unchanged" @bind="_exportUnchanged" /> Include unchanged stories</label>
                <span class="dlr-muted">PDF: open the HTML export and use your browser's Print → Save as PDF.</span>
            </div>
            @if (report.CoverageNotes.Count + report.ComparisonWarnings.Count > 0)
            {
                @* Metadata limits of the comparison (unknown revision, different coverage): context to read the figures with, not delivery blockers. *@
                <details class="dlr-limitations" data-testid="dlr-limitations">
                    <summary>Comparison limitations · @(report.CoverageNotes.Count + report.ComparisonWarnings.Count) <span class="dlr-muted">— how to read these figures, not delivery defects</span></summary>
                    <ul class="dlr-list">
                        @foreach (var note in report.CoverageNotes) { <li data-testid="dlr-coverage-note"><strong>Coverage:</strong> @note</li> }
                        @foreach (var warning in report.ComparisonWarnings) { <li data-testid="dlr-comparison-warning"><strong>Comparison:</strong> @warning</li> }
                    </ul>
                </details>
            }
        </section>

        @* Scrum Master summary (NEXT53): the shared Delivery Intelligence figures in comparison mode — scope, change, declared and verified
           completion and the checklist apart — then the change charts. Same calculations as Delivery Overview. *@
        <h3 class="dd-h" id="dlr-comparison-h">Baseline → current</h3>
        <DeliveryKpiGrid Kpis="DeliveryIntelligence.Comparison(report)" Label="Baseline compared with current" TestId="dlr-comparison" />
        @if (DeliveryDashboard.ChangeNotComparable(report) is { } notComparable)
        {
            <p class="dlr-card dlr-muted" data-testid="dlr-not-comparable">@notComparable</p>
        }
        else
        {
            <div class="dd-grid">
                <section class="dd-card" aria-label="Feature changes" data-testid="dlr-chart-features"><h3 class="dd-card-h">Feature changes</h3><DeliveryBarChart Bars="DeliveryDashboard.FeatureChanges(report)" TestId="dlr-change-bar" /></section>
                <section class="dd-card" aria-label="Task changes" data-testid="dlr-chart-tasks"><h3 class="dd-card-h">Task checklist changes</h3><DeliveryBarChart Bars="DeliveryDashboard.TaskChanges(report)" TestId="dlr-change-bar" Signed="true" /></section>
            </div>
        }
        <p class="dlr-muted dd-trend" data-testid="dlr-trend">@(_reports.Count > 1 ? $"{_reports.Count} saved reports — see Report history for earlier periods; each report is one baseline → current comparison, not a trend line." : "A baseline and a current snapshot are two points, not a trend.") <a href="@TabHref("changes")" data-testid="dlr-open-board">Open the change board</a></p>

        @* Period changes, current inventory and quality signals are different questions: grouped, never one undifferentiated row (v3). *@
        <details class="dlr-all-figures">
        <summary>All figures (@report.Metrics.Count)</summary>
        <section aria-label="Summary" class="dlr-cards-groups" data-testid="dlr-cards">
            @foreach (var group in report.Metrics.GroupBy(m => report.Version >= 3 ? m.Group : DeliveryMetricGroups.Period))
            {
                <div class="dlr-metric-group" data-testid="dlr-metric-group" data-group="@group.Key">
                    @if (report.Version >= 3) { <h3 class="dlr-h3">@DeliveryMetricGroups.Label(group.Key)</h3> }
                    <div class="dlr-cards">
                        @foreach (var metric in group)
                        {
                            <div class="dlr-metric" data-testid="dlr-metric-@metric.Key" title="@metric.Hint">
                                <span class="dlr-metric-value">@metric.Value</span>
                                <span class="dlr-metric-label">@metric.Label</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </section>
        </details>

        <div class="dlr-grid">
            <section class="dlr-card" data-testid="dlr-summary">
                <h2 class="dlr-h2">This week</h2>
                <ul class="dlr-list">@foreach (var line in report.ExecutiveSummary) { <li>@line</li> }</ul>
                @{ var changed = report.Stories.Where(s => s.Changed).Take(8).ToList(); }
                @if (changed.Count > 0)
                {
                    <h3 class="dlr-h3">Features that moved</h3>
                    <ul class="dlr-list dlr-moved">
                        @foreach (var s in changed)
                        {
                            <li><span class="dlr-badge @P.MovementTone(s.Movement)">@DeliveryReportingText.Movement(s.Movement)</span> <strong>@s.Title</strong> <span class="dlr-muted">@DeliveryReportStories.ProgressChange(s)</span></li>
                        }
                    </ul>
                    <a href="@TabHref("stories")" class="dlr-link">See all story changes</a>
                }
            </section>
            <section class="dlr-card" data-testid="dlr-attention">
                <h2 class="dlr-h2">Delivery attention</h2>
                @if (report.Attention.Count == 0 && report.ScopeChanges.Count == 0) { <p class="dlr-muted">Nothing needs attention.</p> }
                else
                {
                    @if (DeliveryAttention(report).Count == 0 && report.ScopeChanges.Count == 0) { <p class="dlr-muted" data-testid="dlr-attention-none">No delivery attention items; only project hygiene warnings below.</p> }
                    @* Three different kinds of item, counted separately: a scope change to confirm is not a defect. Repository hygiene is apart. *@
                    @foreach (var category in Enum.GetValues<DeliveryAttentionCategory>())
                    {
                        var items = DeliveryAttention(report).Where(a => DeliveryAttentionCategories.Of(a.Kind) == category).ToList();
                        var scope = category == DeliveryAttentionCategory.ScopeChange ? report.ScopeChanges : [];
                        if (items.Count + scope.Count == 0) continue;
                        <div class="dlr-attention-group" data-testid="dlr-attention-group" data-category="@category">
                            <h3 class="dlr-h3">@DeliveryAttentionCategories.Label(category) <span class="dlr-count" data-testid="dlr-attention-count">@(items.Count + scope.Count)</span></h3>
                            <ul class="dlr-list">
                                @foreach (var sc in scope)
                                {
                                    <li data-testid="dlr-scope-item"><span class="dlr-badge dlr-tone-info">Scope change requiring confirmation</span> <strong>@sc.Kind</strong> — @sc.Title<br /><span class="dlr-muted">@sc.Detail</span></li>
                                }
                                @foreach (var a in items.Take(AttentionPreview))
                                {
                                    <li><span class="dlr-badge @(a.Severity == DeliveryAttentionSeverity.Blocker ? "dlr-tone-bad" : "dlr-tone-warn")">@(a.Severity == DeliveryAttentionSeverity.Blocker ? "Blocker" : "Review")</span>
                                        <strong>@DeliveryReportingText.Attention(a.Kind)</strong> — @a.Title<br /><span class="dlr-muted">@a.Detail</span></li>
                                }
                            </ul>
                            @if (items.Count > AttentionPreview)
                            {
                                <p class="dlr-muted" data-testid="dlr-attention-more">+@(items.Count - AttentionPreview) more — <a href="@TabHref("stories")">review them in Stories</a> (filter Needs review).</p>
                            }
                        </div>
                    }
                    @if (HygieneItems(report) is { Count: > 0 } hygiene)
                    {
                        @* Encoding damage, files outside features, duplicate numbers: repository hygiene, not the delivery of a feature. *@
                        <details class="dlr-hygiene" data-testid="dlr-hygiene">
                            <summary>Project hygiene warnings · @hygiene.Count</summary>
                            <ul class="dlr-list">@foreach (var a in hygiene) { <li><strong>@DeliveryReportingText.Attention(a.Kind)</strong> — @a.Title<br /><span class="dlr-muted">@a.Detail</span></li> }</ul>
                        </details>
                    }
                }
            </section>
            <section class="dlr-card" data-testid="dlr-focus">
                <h2 class="dlr-h2">@DeliveryReportStories.FocusHeading(report)</h2>
                @if (report.Version >= 3) { <p class="dlr-muted" data-testid="dlr-focus-note">@DeliveryReportStories.FocusNote</p> }
                @if (report.NextWeekFocus.Count == 0) { <p class="dlr-muted">No open work found in the current snapshot.</p> }
                else
                {
                    <ul class="dlr-list">
                        @foreach (var f in report.NextWeekFocus)
                        {
                            <li>@f.Text
                                @if (f.Features.Count > 0) { <ul class="dlr-sublist">@foreach (var name in f.Features) { <li>@name</li> }</ul> }
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>
        <details class="dlr-generate-more" data-testid="dlr-generate-more">
            <summary>Generate another report</summary>
            @GeneratePanel()
        </details>
    };

    private RenderFragment GeneratePanel() => __builder =>
    {
        <section class="dlr-card dlr-generate" data-testid="dlr-generate" aria-labelledby="dlr-generate-title">
            @if (RunningGeneration is { } running)
            {
                <PersistentOperationStatus Operation="running" Operations="Operations" TestId="dlr-generate-running"
                                           Note="@($"Generating a report ({running.Context.Baseline} → {running.Context.Revision}) — it continues if you leave this page; see Activity.")" />
            }
            <h2 class="dlr-h2" id="dlr-generate-title">Generate delivery report</h2>
            <p class="dlr-kicker" data-testid="dlr-new-config-label">New report configuration <span class="dlr-muted">· chooses the snapshots for a new report; saved reports keep their own snapshots</span></p>
            @if (_snapshots.Count < 2)
            {
                <p class="dlr-muted">Import at least two snapshots (a baseline and a current one) to compare.</p>
            }
            else
            {
                <div class="dlr-generate-row">
                    <label class="dlr-field"><span>Current snapshot</span>
                        <select data-testid="dlr-current" value="@(_currentId?.ToString() ?? "")" @onchange="OnCurrentChanged">
                            <option value="">Choose…</option>
                            @foreach (var s in P.Sorted(_snapshots)) { <option value="@s.Id" title="@($"Snapshot {s.Id}")">@SnapshotOption(s)</option> }
                        </select>
                    </label>
                    <label class="dlr-field"><span>Baseline snapshot</span>
                        <select data-testid="dlr-baseline" value="@(_baselineId?.ToString() ?? "")" @onchange="OnBaselineChanged">
                            <option value="">Choose…</option>
                            @foreach (var s in P.Sorted(_snapshots.Where(s => s.Id != _currentId))) { <option value="@s.Id" title="@($"Snapshot {s.Id}")">@SnapshotOption(s)</option> }
                        </select>
                    </label>
                    @if (_generationScope is { } genScope && (genScope.Sources.Count > 1 || genScope.Scopes.Count > 0))
                    {
                        <label class="dlr-field"><span>Source (optional)</span>
                            <select data-testid="dlr-generate-source" title="@BirkNext.Interpretation.CanonicalScopeText.SourceHelp" value="@(_generateSource ?? "")" @onchange="e => _generateSource = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString()">
                                <option value="">All sources</option>
                                @foreach (var o in genScope.Sources) { <option value="@o.Id" title="@o.Provenance">@o.Name</option> }
                            </select>
                        </label>
                        <label class="dlr-field"><span>Functional scope (optional)</span>
                            <select data-testid="dlr-generate-scope" title="@BirkNext.Interpretation.CanonicalScopeText.FunctionalScopeHelp" value="@(_generateScope ?? "")" @onchange="e => _generateScope = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString()">
                                <option value="">All functional scopes</option>
                                @foreach (var o in genScope.Scopes) { <option value="@o.Id" title="@o.Detail">@o.Name (@o.CurrentFeatures)</option> }
                            </select>
                        </label>
                    }
                    <button type="button" class="btn-primary" data-testid="dlr-generate-run" disabled="@(_busy || RunningGeneration is not null || _baselineId is null || _currentId is null || _comparison is { CanGenerate: false } || _comparison is { RequiresConfirmation: true } && !_confirmDirection)" @onclick="Generate">@(_comparison is { RequiresConfirmation: true } && _confirmDirection ? "Generate anyway" : "Generate report")</button>
                </div>
                <p class="dlr-muted dlr-sort-note">@BirkNext.Snapshots.SnapshotSelectionLabels.SortExplanation “Current” marks the newest snapshot imported as current.</p>
                @if (_selectionNotice is not null) { <p class="dlr-warning" role="status" data-testid="dlr-selection-notice">@_selectionNotice</p> }
                @PreviewPanel()
                @if (_suggestion is not null)
                {
                    <p class="dlr-muted" data-testid="dlr-suggestion" role="status">@(_suggestion.SnapshotId is null ? "No baseline suggested: " : "Suggested baseline: ")@_suggestion.Reason</p>
                }
                @if (SelectedPeriod() is { } period) { <p class="dlr-muted" data-testid="dlr-generate-period">Period: @period</p> }
            }
            <p class="dlr-hint">Need an earlier baseline? Export the repository at the desired Git commit or date (for example <code>git archive --format=zip -o m2lb-monday.zip &lt;commit&gt;</code>) and import the ZIP with that effective date.</p>
        </section>
    };

    // ── Stories ─────────────────────────────────────────────────────────────────────────────────────────────────────

    private RenderFragment Stories() => __builder =>
    {
        if (_report is null)
        {
            <section class="dlr-card dlr-empty" data-testid="dlr-stories-empty"><p>Generate a weekly report on the Overview to compare stories.</p></section>
            return;
        }
        @* Features first (shared cards, comparison mode); the work-item explorer and the drill-down are advanced views of the same report. *@
        <div class="dlr-stories-mode" role="radiogroup" aria-label="Stories layout" data-testid="dlr-stories-mode">
            <label class="@(StoriesMode == "features" ? "is-active" : "")"><input type="radio" name="dlr-stories-mode" checked="@(StoriesMode == "features")" @onchange="@(() => SetStoriesMode("features"))" data-testid="dlr-mode-features" /> Features</label>
            <label class="@(StoriesMode == "workitems" ? "is-active" : "")"><input type="radio" name="dlr-stories-mode" checked="@(StoriesMode == "workitems")" @onchange="@(() => SetStoriesMode("workitems"))" data-testid="dlr-mode-workspace" /> Work items <span class="dlr-muted">(advanced)</span></label>
            <label class="@(StoriesMode == "drilldown" ? "is-active" : "")"><input type="radio" name="dlr-stories-mode" checked="@(StoriesMode == "drilldown")" @onchange="@(() => SetStoriesMode("drilldown"))" data-testid="dlr-mode-drilldown" /> Feature drill-down <span class="dlr-muted">(advanced)</span></label>
        </div>
        @if (StoriesMode == "drilldown")
        {
            <BirkNext.Web.Components.DeliveryFeatureExplorer @key="_report.ReportId" Report="_report" ProjectName="@(_report.ProjectName)" />
        }
        else if (StoriesMode == "workitems")
        {
            <BirkNext.Web.Components.DeliveryWorkspace @key="_report.ReportId" Report="_report" Options="DeliveryExplorerOptions.Comparison" ProjectId="_projectId"
                SelectedId="@ItemQuery" OnSelect="SelectWorkItem" />
        }
        else
        {
            var cards = StoryCards(_report);
            <div class="dd-list-tools" data-testid="dlr-feature-tools">
                <label>Change
                    <select data-testid="dlr-feature-change" value="@ChangeFilter" @onchange="OnChangeFilter">
                        <option value="all">All features</option>
                        <option value="changed">Changed this period</option>
                        <option value="new">New</option>
                        <option value="removed">Removed</option>
                        <option value="review">Needs review</option>
                    </select></label>
                @if (StoryModules(_report) is { Count: > 1 } modules)
                {
                    <label>Module
                        <select data-testid="dlr-feature-module" value="@(ModuleFilter ?? "")" @onchange="OnModuleFilter">
                            <option value="">All modules</option>
                            @foreach (var m in modules) { <option value="@m">@m</option> }
                        </select></label>
                }
                <label><span class="visually-hidden">Search features</span>
                    <input type="search" placeholder="Search features" value="@_featureSearch" @oninput="OnFeatureSearch" data-testid="dlr-feature-search" /></label>
                <span class="dlr-muted" role="status" data-testid="dlr-feature-count">@cards.Count of @_report.Stories.Count features</span>
            </div>
            <DeliveryFeatureList Cards="cards" Report="_report" Comparison="true" SelectedKey="@OpenFeatureQuery" OnSelect="SelectFeatureCard"
                OnOpenTechnical="OpenInWorkItems" TestId="dlr-features" Empty="No feature matches this filter in the selected report." />
        }
    };

    // ── Change board (NEXT53) ─────────────────────────────────────────────────────────────────────────────────────────

    private RenderFragment ChangeBoardTab() => __builder =>
    {
        if (_report is null)
        {
            <section class="dlr-card dlr-empty" data-testid="dlr-board-empty"><p>Generate a report on the Summary tab to see what changed.</p></section>
            return;
        }
        <p class="dlr-muted" data-testid="dlr-board-intro">What changed between “@_report.Baseline.Label” and “@_report.Current.Label”, grouped by what it means for the plan. Select a feature for its details.</p>
        <DeliveryChangeBoard Lanes="DeliveryIntelligence.ChangeBoard(_report, AllCards(_report))" OnOpen="OpenFromBoard" />
    };

    private RenderFragment Evidence(DeliveryStoryRow s) => __builder =>
    {
        var e = s.Evidence;
        <div class="dlr-evidence">
            <ul class="dlr-list">@foreach (var reason in s.Reasons) { <li>@reason</li> }</ul>
            <dl class="dlr-meta">
                @if (e.SpecPath is not null) { <div><dt>Specification</dt><dd><code>@e.SpecPath</code></dd></div> }
                @if (e.TasksPath is not null) { <div><dt>Task source</dt><dd><code>@e.TasksPath</code></dd></div> }
                @if (e.PlanPath is not null) { <div><dt>Plan (context only)</dt><dd><code>@e.PlanPath</code></dd></div> }
                <div><dt>Task counts</dt><dd>Baseline @DeliveryReportStories.Progress(s.BaselineTaskCompleted, s.BaselineTaskTotal) · current @DeliveryReportStories.Progress(s.CurrentTaskCompleted, s.CurrentTaskTotal) · @s.TasksCompletedThisPeriod completed this period</dd></div>
                @if (e.BaselineStatusReason is not null) { <div><dt>Baseline status</dt><dd>@e.BaselineStatusReason</dd></div> }
                @if (e.CurrentStatusReason is not null) { <div><dt>Current status</dt><dd>@e.CurrentStatusReason</dd></div> }
                @if (e.SourceSummary is not null) { <div><dt>Source comparison</dt><dd>@e.SourceSummary</dd></div> }
            </dl>
            @EvidenceList("Tasks completed this period", e.TasksCompleted)
            @EvidenceList("Tasks reopened", e.TasksReopened)
            @EvidenceList("Tasks added", e.TasksAdded)
            @EvidenceList("Tasks removed", e.TasksRemoved)
            @EvidenceList("Acceptance criteria added", e.AcceptanceAdded)
            @EvidenceList("Acceptance criteria removed", e.AcceptanceRemoved)
        </div>
    };

    private static RenderFragment EvidenceList(string title, List<string> items) => __builder =>
    {
        if (items.Count == 0) return;
        <h4 class="dlr-h4">@title (@items.Count)</h4>
        <ul class="dlr-list dlr-compact">@foreach (var item in items) { <li>@item</li> }</ul>
    };

    // ── Snapshots ───────────────────────────────────────────────────────────────────────────────────────────────────

    private RenderFragment Snapshots() => __builder =>
    {
        <section class="dlr-card" data-testid="dlr-snapshots">
            <h2 class="dlr-h2">Stored snapshots</h2>
            @{ var (readiness, readinessText) = P.Readiness(_snapshots); }
            @* Readiness from the canonical stored list only: a preview or an unconfirmed import never counts. *@
            <div class="dlr-readiness" data-testid="dlr-snapshot-readiness" data-state="@readiness" role="status">
                <p>@readinessText</p>
                <div class="dlr-actions" data-testid="dlr-snapshot-next">
                    @if (readiness == "none")
                    {
                        <button type="button" class="btn-primary" data-testid="dlr-next-import" @onclick="OpenImport">Import first snapshot</button>
                    }
                    else
                    {
                        <a class="btn-secondary" href="@OverviewHref" data-testid="dlr-next-overview">Open Delivery Overview</a>
                        @if (readiness == "one")
                        {
                            <button type="button" class="btn-secondary" data-testid="dlr-next-import" @onclick="OpenImport">Import comparison snapshot</button>
                        }
                        else
                        {
                            <a class="btn-secondary" href="@TabHref("overview")" data-testid="dlr-next-compare">Compare snapshots</a>
                        }
                        @if (LatestReportId is { } latestReport)
                        {
                            <a class="btn-link" href="@ReportHrefOn("overview", latestReport)" data-testid="dlr-next-latest-report">Open latest change report</a>
                        }
                    }
                </div>
            </div>
            <p class="dlr-muted">Only snapshots imported into Delivery Reporting for this project are listed. Imported snapshots never change; you can rename them, change their role or delete them.</p>
            @if (_snapshots.Count == 0) { <p data-testid="dlr-snapshots-empty">No snapshots yet. Import a repository ZIP to create the first one.</p> }
            else
            {
                var shownSnapshots = DeliverySnapshotList.Apply(_snapshots, _snapshotSearch, _snapshotRole, _snapshotSort);
                var latest = DeliverySnapshotList.Latest(_snapshots);
                <div class="dlr-list-toolbar" role="group" aria-label="Find snapshots" data-testid="dlr-snapshot-toolbar">
                    <label class="dlr-field"><span>Search</span><input type="search" data-testid="dlr-snapshot-search" value="@_snapshotSearch" @oninput="e => _snapshotSearch = e.Value?.ToString() ?? string.Empty" placeholder="Name, file, repository or commit" /></label>
                    <label class="dlr-field"><span>Role</span>
                        <select data-testid="dlr-snapshot-role-filter" value="@(_snapshotRole?.ToString() ?? "")" @onchange="e => _snapshotRole = Enum.TryParse<DeliverySnapshotRole>(e.Value?.ToString(), out var role) ? role : null">
                            <option value="">All roles</option>
                            @foreach (var role in Enum.GetValues<DeliverySnapshotRole>()) { <option value="@role">@DeliveryReportingText.Role(role)</option> }
                        </select></label>
                    <label class="dlr-field"><span>Sort</span>
                        <select data-testid="dlr-snapshot-sort" value="@_snapshotSort" @onchange="e => _snapshotSort = e.Value?.ToString() ?? DeliverySnapshotList.ByEffective">
                            <option value="@DeliverySnapshotList.ByEffective">Effective date (newest first)</option>
                            <option value="@DeliverySnapshotList.ByImported">Imported (newest first)</option>
                            <option value="@DeliverySnapshotList.ByName">Name</option>
                        </select></label>
                    <span class="dlr-muted" role="status" data-testid="dlr-snapshot-count">@shownSnapshots.Count of @_snapshots.Count snapshots</span>
                </div>
                <p class="dlr-muted dlr-small">Effective date = the date the source represents; Imported = when it was added to BirkNext. Comparisons use the effective date.</p>
                @if (shownSnapshots.Count == 0) { <p class="dlr-muted" data-testid="dlr-snapshots-none">No snapshot matches the search.</p> }
                <div class="dlr-table-wrap">
                    <table class="dlr-table" data-testid="dlr-snapshot-table">
                        <thead><tr><th scope="col">Snapshot</th><th scope="col">Effective date</th><th scope="col">Imported</th><th scope="col">Source</th><th scope="col">Features</th><th scope="col" title="Checked tasks in tasks.md — checklist progress, not verified delivery">Tasks (checklist)</th><th scope="col">Role</th><th scope="col">Coverage</th><th scope="col">Actions</th></tr></thead>
                        <tbody>
                            @foreach (var s in shownSnapshots)
                            {
                                <tr data-testid="dlr-snapshot-row" data-latest="@(latest?.Id == s.Id ? "true" : "false")">
                                    <th scope="row">
                                        @if (_renameId == s.Id)
                                        {
                                            <form class="dlr-rename" @onsubmit="() => Rename(s)" @onsubmit:preventDefault>
                                                <label class="visually-hidden" for="dlr-rename-@s.Id">New label for @s.Label</label>
                                                <input id="dlr-rename-@s.Id" data-testid="dlr-rename-input" @bind="_renameValue" maxlength="200" />
                                                <button type="submit" class="btn-link">Save</button><button type="button" class="btn-link" @onclick="() => _renameId = null">Cancel</button>
                                            </form>
                                        }
                                        else { @P.DisplayName(s) if (P.GivenName(s) is null) { <span class="dlr-muted" title="@($"Stored name: {s.Label}")"> · @DeliveryReportingText.Role(s.Role)</span> } }
                                        @if (latest?.Id == s.Id) { <span class="dlr-badge dlr-tone-info" data-testid="dlr-snapshot-latest" title="Newest effective date in this project">Latest</span> }
                                        @if (s.FeatureCount == 0) { <br /><span class="dlr-muted" data-testid="dlr-snapshot-not-comparable">Not comparable: no features were read from this snapshot</span> }
                                    </th>
                                    <td data-testid="dlr-snapshot-effective">@P.Day(s.EffectiveAt)<br /><span class="dlr-muted" data-testid="dlr-snapshot-effective-provenance">@s.EffectiveAtProvenance@(s.EffectiveAtCorrections.Count > 0 ? $" · {s.EffectiveAtCorrections.Count} correction{(s.EffectiveAtCorrections.Count == 1 ? "" : "s")}" : "")</span>
                                        @if (_correctId == s.Id)
                                        {
                                            <form class="dlr-correct" data-testid="dlr-correct-form" @onsubmit="() => CorrectEffectiveDate(s)" @onsubmit:preventDefault>
                                                <label>Effective date <input type="datetime-local" data-testid="dlr-correct-date" @bind="_correctValue" /></label>
                                                <label>Reason <input data-testid="dlr-correct-reason" @bind="_correctReason" maxlength="500" placeholder="Why the archive represents another date" /></label>
                                                <button type="submit" class="btn-link" data-testid="dlr-correct-save">Save correction</button><button type="button" class="btn-link" @onclick="() => _correctId = null">Cancel</button>
                                            </form>
                                        }
                                    </td>
                                    <td>@P.DayTime(s.ImportedAt)</td>
                                    <td data-testid="dlr-snapshot-source">@DeliveryReportingText.Source(s.SourceType)<br /><span class="dlr-muted">@(s.AzureDevOps is { } ado ? $"{ado.Project} / {ado.Repository} / {ado.Branch} · {ado.ShortCommit}" : s.SourceFileName)</span></td>
                                    <td>@s.FeatureCount</td>
                                    <td data-testid="dlr-snapshot-tasks">@(s.TaskCount == 0 ? "No tasks" : $"{s.CompletedTaskCount}/{s.TaskCount} checked")</td>
                                    <td>
                                        <label class="visually-hidden" for="dlr-role-@s.Id">Role of @s.Label</label>
                                        <select id="dlr-role-@s.Id" data-testid="dlr-snapshot-role" value="@s.Role" @onchange="e => ChangeRole(s, e.Value?.ToString())">
                                            @foreach (var role in Enum.GetValues<DeliverySnapshotRole>()) { <option value="@role">@DeliveryReportingText.Role(role)</option> }
                                        </select>
                                    </td>
                                    <td><span class="dlr-badge @P.CoverageTone(s.Coverage)">@s.Coverage</span>@if (s.WarningsCount > 0) { <br /><span class="dlr-muted">@s.WarningsCount warning@(s.WarningsCount == 1 ? "" : "s")</span> }</td>
                                    <td class="dlr-row-actions">
                                        <button type="button" class="btn-link" data-testid="dlr-snapshot-view" aria-expanded="@(_viewId == s.Id ? "true" : "false")" @onclick="() => View(s)">View<span class="visually-hidden"> @s.Label</span></button>
                                        <button type="button" class="btn-link" data-testid="dlr-snapshot-compare" @onclick="() => CompareFrom(s)">Compare<span class="visually-hidden"> @s.Label</span></button>
                                        <details class="dlr-more" data-testid="dlr-snapshot-more">
                                            <summary aria-label="@($"More actions for {P.DisplayName(s)}")">⋯</summary>
                                            <div class="dlr-more-menu">
                                                <button type="button" class="btn-link" data-testid="dlr-snapshot-rename" @onclick="() => { _renameId = s.Id; _renameValue = s.Label; }">Rename<span class="visually-hidden"> @s.Label</span></button>
                                                <button type="button" class="btn-link" data-testid="dlr-snapshot-correct" @onclick="() => { _correctId = s.Id; _correctValue = s.EffectiveAt.ToLocalTime().DateTime; _correctReason = null; }">Correct effective date<span class="visually-hidden"> of @s.Label</span></button>
                                                <button type="button" class="btn-link dlr-danger" data-testid="dlr-snapshot-delete" @onclick="() => AskDeleteSnapshot(s)">Delete<span class="visually-hidden"> @s.Label</span></button>
                                            </div>
                                        </details>
                                    </td>
                                </tr>
                                @if (_viewId == s.Id && _view is { } detail)
                                {
                                    <tr class="dlr-evidence-row"><td colspan="9" data-testid="dlr-snapshot-detail">
                                        <p><strong>Modules:</strong> @(detail.Modules.Count == 0 ? "–" : string.Join(", ", detail.Modules))@(s.GitCommit is { } commit ? $" · Git commit {commit[..Math.Min(10, commit.Length)]}" : "")</p>
                                        @if (s.EffectiveAtCorrections.Count > 0)
                                        {
                                            <p data-testid="dlr-snapshot-corrections"><strong>Effective date corrections:</strong> @string.Join("; ", s.EffectiveAtCorrections.Select(c => $"{P.Day(c.Previous)} → {P.Day(c.Corrected)} on {P.DayTime(c.CorrectedAt)}{(c.Reason is { } why ? $" ({why})" : "")}"))</p>
                                        }
                                        <ul class="dlr-list dlr-compact">@foreach (var f in detail.Features) { <li><strong>@f.Title</strong> <span class="dlr-muted">(@f.Module)</span> — @f.Status · @DeliveryReportStories.TaskProgress(f.TaskCompleted, f.TaskTotal, f.TasksPath is not null)</li> }</ul>
                                        @if (detail.Warnings.Count > 0) { <h4 class="dlr-h4">Import warnings</h4><ul class="dlr-list dlr-compact">@foreach (var w in detail.Warnings) { <li>@w.Message</li> }</ul> }
                                    </td></tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    };

    private string _snapshotSearch = "", _snapshotSort = DeliverySnapshotList.ByEffective, _historySearch = "";
    private DeliverySnapshotRole? _snapshotRole;

    // ── Report history ──────────────────────────────────────────────────────────────────────────────────────────────

    /// <summary>The frozen display title (never recomputed with newer rules), else the stored title and week.</summary>
    private static string HistoryName(DeliveryReportSummaryRow r) => r.DisplayTitle.Length > 0 ? r.DisplayTitle : $"{r.Title} — {r.WeekLabel}";

    private RenderFragment History() => __builder =>
    {
        <section class="dlr-card" data-testid="dlr-history">
            <h2 class="dlr-h2">Report history</h2>
            <p class="dlr-muted">Every generated report is kept exactly as it was generated. Opening or exporting an older report shows that version, even after new snapshots are imported.</p>
            @if (_reports.Count == 0) { <p data-testid="dlr-history-empty">No reports generated yet.</p> }
            else
            {
                var shownReports = _reports.Where(r => _historySearch.Trim().Length == 0 || HistoryName(r).Contains(_historySearch.Trim(), StringComparison.OrdinalIgnoreCase)
                    || r.BaselineLabel.Contains(_historySearch.Trim(), StringComparison.OrdinalIgnoreCase) || r.CurrentLabel.Contains(_historySearch.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
                <div class="dlr-list-toolbar" role="group" aria-label="Find reports">
                    <label class="dlr-field"><span>Search</span><input type="search" data-testid="dlr-history-search" value="@_historySearch" @oninput="e => _historySearch = e.Value?.ToString() ?? string.Empty" placeholder="Report or snapshot name" /></label>
                    <span class="dlr-muted" role="status" data-testid="dlr-history-count">@shownReports.Count of @_reports.Count reports</span>
                </div>
                <div class="dlr-table-wrap">
                <table class="dlr-table dlr-history-table" data-testid="dlr-history-table">
                    <thead><tr><th scope="col">Report</th><th scope="col">Baseline → current</th><th scope="col">Coverage</th><th scope="col">Generated</th><th scope="col">Key changes</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
                    <tbody>
                    @foreach (var r in shownReports)
                    {
                        <tr class="@(_report?.ReportId == r.Id ? "is-open" : "")" data-testid="dlr-history-row" aria-current="@(_report?.ReportId == r.Id ? "true" : null)">
                            <th scope="row">
                                <span class="dlr-report-card-title">@HistoryName(r)</span>@if (_report?.ReportId == r.Id) { <span class="dlr-badge dlr-tone-info"> Open</span> }
                                <br /><span class="dlr-muted">@if (HistoryVersion(r) is { } version) { <span data-testid="dlr-history-version">@version · </span> }@P.Period(r.PeriodStart, r.PeriodEnd)</span>
                                @if (r.ScopeLabel.Length > 0) { <br /><span class="dlr-muted" data-testid="dlr-history-scope">Scope: @r.ScopeLabel</span> }
                            </th>
                            <td data-testid="dlr-history-pair">
                                <span><span class="dlr-pair-label">Baseline</span> @r.BaselineLabel@if (r.BaselineSource.Length > 0) { <span class="dlr-muted"> · @r.BaselineSource</span> }</span>
                                <span aria-hidden="true"> → </span>
                                <span><span class="dlr-pair-label">Current</span> @r.CurrentLabel@if (r.CurrentSource.Length > 0) { <span class="dlr-muted"> · @r.CurrentSource</span> }</span>
                            </td>
                            <td>
                                @if (r.CoverageText.Length > 0) { <span class="dlr-muted" data-testid="dlr-history-coverage">@r.CoverageText</span><br /> }
                                <span class="dlr-badge @P.CoverageTone(r.Coverage)">@r.Coverage</span>
                                @if (r.Direction is { } d && d != DeliveryDirectionState.Chronological) { <span class="dlr-badge dlr-tone-warn">@DirectionLabel(d)@(r.DirectionConfirmed ? " · confirmed" : "")</span> }
                            </td>
                            <td>@P.DayTime(r.GeneratedAt)</td>
                            <td><span data-testid="dlr-history-changes">@r.StoriesChanged changed · @r.AttentionCount attention item@(r.AttentionCount == 1 ? "" : "s")</span></td>
                            <td class="dlr-row-actions">
                                <button type="button" class="btn-secondary" data-testid="dlr-history-open" @onclick="() => OpenReport(r.Id)">Open<span class="visually-hidden"> @r.Title @r.WeekLabel</span></button>
                                <ExportMenu TestId="dlr-history-export" Options="ExportOptions(r.Id)" />
                                <details class="dlr-more">
                                    <summary aria-label="@($"More actions for {r.Title} {r.WeekLabel}")">⋯</summary>
                                    <div class="dlr-more-menu">
                                        <button type="button" class="btn-link dlr-danger" data-testid="dlr-history-delete" @onclick="() => AskDeleteReport(r)">Delete<span class="visually-hidden"> @r.Title @r.WeekLabel</span></button>
                                    </div>
                                </details>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
                </div>
            }
        </section>
    };

    // ── Import dialog ───────────────────────────────────────────────────────────────────────────────────────────────

    private RenderFragment ImportDialog() => __builder =>
    {
        <div class="dlr-backdrop">
            <div class="dlr-dialog" role="dialog" aria-modal="true" aria-labelledby="dlr-import-title" data-testid="dlr-import-dialog" @onkeydown="OnDialogKey">
                <h2 class="dlr-h2" id="dlr-import-title" tabindex="-1" @ref="_importTitle">Import snapshot</h2>
                <p class="dlr-muted">Into reporting project <strong>@ProjectName</strong>. The repository is read once; only its stories, tasks and file fingerprints are kept.</p>
                <fieldset class="dlr-source-choice" data-testid="dlr-import-source">
                    <legend>Source</legend>
                    <label><input type="radio" name="dlr-import-source" data-testid="dlr-source-zip" checked="@(!_fromAzureDevOps)" @onchange="() => ChooseSource(false)" /> Upload ZIP</label>
                    <label><input type="radio" name="dlr-import-source" data-testid="dlr-source-ado" checked="@_fromAzureDevOps" @onchange="() => ChooseSource(true)" /> Import from Azure DevOps</label>
                </fieldset>
                @if (_fromAzureDevOps)
                {
                    <BirkNext.Web.Components.DeliveryAzureDevOpsImport ProjectId="_projectId" ProjectName="@ProjectName" Disabled="_busy" OnPreview="OnAzureDevOpsPreview" />
                }
                <div class="dlr-form-grid">
                    @if (!_fromAzureDevOps)
                    {
                        <label class="dlr-field"><span>Source file (ZIP)</span>
                            <InputFile accept=".zip,application/zip" data-testid="dlr-import-file" OnChange="OnFileSelected" disabled="@_busy" />
                        </label>
                    }
                    <label class="dlr-field"><span>Effective snapshot date and time</span>
                        <input type="datetime-local" data-testid="dlr-import-effective" value="@_effectiveInput" @onchange="e => _effectiveInput = e.Value?.ToString() ?? string.Empty" aria-describedby="dlr-effective-help" />
                        <small id="dlr-effective-help" class="dlr-muted">@(_fromAzureDevOps ? "Filled from the selected state time (or the commit time for Current/latest). You can still change it." : "When the repository was in this state, not when you import it. For a historical Git export, use the commit date.")</small>
                    </label>
                    <label class="dlr-field"><span>Snapshot role</span>
                        <select data-testid="dlr-import-role" @bind="_importRole">
                            @foreach (var role in Enum.GetValues<DeliverySnapshotRole>()) { <option value="@role">@DeliveryReportingText.Role(role)</option> }
                        </select>
                    </label>
                    <label class="dlr-field"><span>Label (optional)</span><input data-testid="dlr-import-label" @bind="_importLabel" maxlength="200" placeholder="e.g. Monday baseline" /></label>
                </div>
                @if (!_fromAzureDevOps) { <p class="dlr-hint">Need an earlier baseline? Export the repository at the desired Git commit or date and import the ZIP here with that effective date, or choose Import from Azure DevOps.</p> }

                @if (_busy && _preview is null) { <InlineLoading Text="Reading the archive…" TestId="dlr-import-reading" /> }
                @if (_preview is { } preview)
                {
                    <section class="dlr-preview" aria-label="Import preview" data-testid="dlr-import-preview">
                        <h3 class="dlr-h3">Preview</h3>
                        <dl class="dlr-meta">
                            <div><dt>Project</dt><dd>@ProjectName</dd></div>
                            @if (preview.AzureDevOps is { } ado)
                            {
                                <div><dt>Source</dt><dd data-testid="dlr-preview-ado">Azure DevOps · @ado.Project / @ado.Repository / @ado.Branch</dd></div>
                                <div><dt>Commit time</dt><dd>@P.DayTime(ado.CommitAt)@(ado.RequestedAt is { } requested && requested != ado.CommitAt ? $" (requested {P.DayTime(requested)})" : "")</dd></div>
                            }
                            else { <div><dt>Source file</dt><dd>@preview.FileName (@DeliveryReportingText.Source(preview.SourceType))</dd></div> }
                            @if (preview.GitCommit is { } commit) { <div><dt>Git commit</dt><dd data-testid="dlr-preview-commit">@commit[..Math.Min(12, commit.Length)]</dd></div> }
                            <div><dt>Effective date</dt><dd>@(P.ParseLocalInput(_effectiveInput) is { } eff ? P.DayTime(eff) : "Not set")</dd></div>
                            <div><dt>Modules</dt><dd>@(preview.Modules.Count == 0 ? "–" : string.Join(", ", preview.Modules))</dd></div>
                            <div><dt>Features detected</dt><dd data-testid="dlr-preview-features">@preview.Features.Count</dd></div>
                            <div><dt>Tasks</dt><dd data-testid="dlr-preview-tasks">@preview.TaskTotal (@preview.TaskCompleted completed, @preview.TaskOpen open)</dd></div>
                            <div><dt>Coverage</dt><dd><span class="dlr-badge @P.CoverageTone(preview.Coverage)">@preview.Coverage</span></dd></div>
                        </dl>
                        @if (_adoNote is not null) { <p class="dlr-warning" data-testid="dlr-preview-ado-note">@_adoNote</p> }
                        @if (preview.SuggestedEffectiveAt is { } suggested && preview.AzureDevOps is null)
                        {
                            <p class="dlr-muted" data-testid="dlr-preview-suggested">The archive suggests @P.DayTime(suggested). @preview.SuggestedEffectiveReason
                                <button type="button" class="btn-link" @onclick="() => _effectiveInput = P.LocalInput(suggested)">Use this date</button></p>
                        }
                        @* Long lists stay one click away so the confirm action stays in reach. *@
                        @if (preview.Features.Count > 0)
                        {
                            <details class="dlr-preview-more" data-testid="dlr-preview-features-more">
                                <summary>@preview.Features.Count detected feature@(preview.Features.Count == 1 ? "" : "s")</summary>
                                <ul class="dlr-list dlr-compact dlr-preview-features">
                                    @foreach (var f in preview.Features) { <li><strong>@f.Title</strong> <span class="dlr-muted">(@f.Module)</span> — @f.Status · @DeliveryReportStories.Progress(f.TaskCompleted, f.TaskTotal)@(f.HasSpecification ? "" : " · no spec.md")@(f.HasTasks ? "" : " · no tasks.md")</li> }
                                </ul>
                            </details>
                        }
                        @if (preview.Warnings.Count > 0)
                        {
                            var warningGroups = P.WarningGroups(preview.Warnings);
                            @* Grouped by the warning code the import recorded (no invented categories); every original warning and path stays listed. *@
                            <details class="dlr-preview-more" data-testid="dlr-preview-warnings-more">
                                <summary>Warnings (@preview.Warnings.Count) · @P.WarningGroupSummary(warningGroups)</summary>
                                <div data-testid="dlr-preview-warnings">
                                    @foreach (var group in warningGroups)
                                    {
                                        <h4 class="dlr-h4" data-testid="dlr-preview-warning-group">@group.Code (@group.Items.Count)</h4>
                                        <ul class="dlr-list dlr-compact">@foreach (var w in group.Items) { <li>@w.Message@if (w.Path is { } path) { <span class="dlr-muted"> · @path</span> }</li> }</ul>
                                    }
                                </div>
                            </details>
                        }
                        @if (preview.DuplicateWarning is { } duplicate)
                        {
                            <div class="dlr-warning" role="alert" data-testid="dlr-duplicate-warning">
                                <p>@duplicate</p>
                                <label><input type="checkbox" data-testid="dlr-duplicate-confirm" @bind="_confirmDuplicate" /> Import it anyway as a new snapshot</label>
                            </div>
                        }
                    </section>
                }

                @* Sticky footer: the action, its progress and its failure stay in view. A failed confirmation (e.g. an expired preview) is never
                   reported above a long preview where it goes unseen. *@
                <div class="dlr-dialog-footer" data-testid="dlr-import-footer">
                    @if (_importError is not null) { <p class="dlr-error" role="alert" data-testid="dlr-import-error">@_importError</p> }
                    <div class="dlr-actions">
                        <button type="button" class="btn-primary" data-testid="dlr-import-confirm" aria-busy="@(Importing ? "true" : "false")" disabled="@(_busy || _preview is null || (_preview.DuplicateWarning is not null && !_confirmDuplicate) || P.ParseLocalInput(_effectiveInput) is null)" @onclick="CommitImport">@(Importing ? "Importing…" : "Import snapshot")</button>
                        <button type="button" class="btn-secondary" data-testid="dlr-import-cancel" @onclick="CloseImport">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    };

    private RenderFragment ConfirmDialog() => __builder =>
    {
        var confirm = _confirm!;
        <div class="dlr-backdrop">
            <div class="dlr-dialog dlr-dialog-small" role="alertdialog" aria-modal="true" aria-labelledby="dlr-confirm-title" aria-describedby="dlr-confirm-text" data-testid="dlr-confirm" @onkeydown="OnDialogKey">
                <h2 class="dlr-h2" id="dlr-confirm-title">@confirm.Title</h2>
                <p id="dlr-confirm-text">@confirm.Text</p>
                <div class="dlr-actions">
                    <button type="button" class="btn-danger" data-testid="dlr-confirm-yes" @ref="_confirmButton" @onclick="RunConfirm">@confirm.Action</button>
                    <button type="button" class="btn-secondary" data-testid="dlr-confirm-no" @onclick="() => _confirm = null">Cancel</button>
                </div>
            </div>
        </div>
    };
}

@code {
    private sealed record Confirmation(string Title, string Text, string Action, Func<Task> Run);

    [SupplyParameterFromQuery(Name = "project")] public string? ProjectQuery { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? TabQuery { get; set; }
    [SupplyParameterFromQuery(Name = "report")] public string? ReportQuery { get; set; }
    [SupplyParameterFromQuery(Name = "scope")] public string? ScopeKeyQuery { get; set; }
    /// <summary>Deep link to one work item of the Stories workspace (browser back/forward move between selections).</summary>
    [SupplyParameterFromQuery(Name = "item")] public string? ItemQuery { get; set; }
    [SupplyParameterFromQuery(Name = "mode")] public string? ModeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "f")] public string? OpenFeatureQuery { get; set; }
    [SupplyParameterFromQuery(Name = "chg")] public string? ChangeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "mod")] public string? ModuleQuery { get; set; }
    /// <summary>Stories layout: shared feature cards by default; the work-item explorer and drill-down are advanced (a deep-linked item opens the explorer).</summary>
    private string StoriesMode => ModeQuery is "workitems" or "drilldown" ? ModeQuery : ItemQuery is not null && ModeQuery is null ? "workitems" : "features";
    private string ChangeFilter => ChangeQuery is "changed" or "new" or "removed" or "review" ? ChangeQuery : "all";
    private string? ModuleFilter => string.IsNullOrWhiteSpace(ModuleQuery) ? null : ModuleQuery;
    private string _featureSearch = "";

    private WeeklyDeliveryReport? _cardsFor;
    private IReadOnlyList<DeliveryFeatureCard> _allCards = [];
    /// <summary>The feature cards of a report, current and removed (one calculation per report; the components only render).</summary>
    private IReadOnlyList<DeliveryFeatureCard> AllCards(WeeklyDeliveryReport report)
    {
        if (!ReferenceEquals(_cardsFor, report)) { _allCards = DeliveryIntelligence.Cards(DeliveryBacklog.FromReport(report), report, includeRemoved: true); _cardsFor = report; }
        return _allCards;
    }

    private static IReadOnlyList<string> StoryModules(WeeklyDeliveryReport report) =>
        [.. report.Stories.Select(s => s.Module.Length == 0 ? "Project" : s.Module).Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase)];

    private IReadOnlyList<DeliveryFeatureCard> StoryCards(WeeklyDeliveryReport report)
    {
        var rows = report.Stories.GroupBy(s => s.FeatureKey, StringComparer.Ordinal).ToDictionary(g => g.Key, g => g.First(), StringComparer.Ordinal);
        bool Keep(DeliveryFeatureCard c)
        {
            if (rows.GetValueOrDefault(c.FeatureKey) is not { } s) return false;
            var change = ChangeFilter switch
            {
                "changed" => s.Changed && !s.NewFeature && !s.RemovedFeature,
                "new" => s.NewFeature,
                "removed" => s.RemovedFeature,
                "review" => s.HasActiveAttention || s.RemovalUnconfirmed || s.CurrentStatus == DeliveryStatus.NeedsClarification,
                _ => true,
            };
            var module = ModuleFilter is null || string.Equals(c.Module.Length == 0 ? "Project" : c.Module, ModuleFilter, StringComparison.OrdinalIgnoreCase);
            var search = _featureSearch.Length == 0 || c.Title.Contains(_featureSearch, StringComparison.OrdinalIgnoreCase) || c.Module.Contains(_featureSearch, StringComparison.OrdinalIgnoreCase);
            return change && module && search;
        }
        return [.. AllCards(report).Where(Keep)];
    }

    private void SetQuery(string key, string? value) => Nav.NavigateTo(Nav.GetUriWithQueryParameter(key, value), replace: true);
    private void OnChangeFilter(ChangeEventArgs e) => SetQuery("chg", e.Value?.ToString() is "all" ? null : e.Value?.ToString());
    private void OnModuleFilter(ChangeEventArgs e) => SetQuery("mod", e.Value?.ToString() is { Length: > 0 } m ? m : null);
    private void OnFeatureSearch(ChangeEventArgs e) => _featureSearch = e.Value?.ToString() ?? string.Empty;
    private void SetStoriesMode(string mode) => Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?> { ["mode"] = mode == "features" ? null : mode, ["f"] = null }), replace: true);
    /// <summary>Opening a card is a history entry (Back closes it); filters stay in the URL.</summary>
    private void SelectFeatureCard(string? key) => Nav.NavigateTo(Nav.GetUriWithQueryParameter("f", key));
    private void OpenInWorkItems(string key) => Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?> { ["mode"] = "workitems", ["item"] = DeliveryWorkItems.FeatureId(key), ["f"] = null }));
    private void OpenFromBoard(string key) => Nav.NavigateTo($"{TabHref("stories")}&f={Uri.EscapeDataString(key)}");

    /// <summary>A selection is a history entry (Back returns to the previous item); the explorer's own filters (wi-*) stay in the URL.</summary>
    private void SelectWorkItem(string? id) => Nav.NavigateTo(Nav.GetUriWithQueryParameter("item", id));

    private bool _loaded, _busy;
    private string? _error, _notice;
    private List<DeliveryProject> _projects = [];
    private Guid? _projectId;
    private string _tab = "overview";
    /// <summary>The Delivery Snapshots destination (same component and state as Delivery Reports, another destination).</summary>
    private bool OnSnapshotsRoute => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Equals(P.SnapshotsRoute, StringComparison.OrdinalIgnoreCase);
    private bool Importing => _busy && _preview is not null;
    private string OverviewHref => $"{NavigationCatalog.DeliveryOverviewRoute}?project={_projectId}";
    private Guid? LatestReportId => _reports.Count == 0 ? null : _reports.MaxBy(r => r.GeneratedAt)!.Id;
    private string ReportHrefOn(string tab, Guid reportId) => $"{P.Route}?project={_projectId}&tab={tab}&report={reportId}";
    private List<DeliverySnapshotSummary> _snapshots = [];
    private List<DeliveryReportSummaryRow> _reports = [];
    private DeliveryRole _role = DeliveryRole.ProjectLeader;

    /// <summary>The same tab, another frozen report of this project (history navigation).</summary>
    private string ReportHref(Guid id) => $"{P.Route}?project={_projectId}&tab={_tab}&report={id}";

    /// <summary>The remembered role (this browser) picks the default tab when the URL names none.</summary>
    private async Task ApplyRoleAsync(bool firstRender)
    {
        if (!firstRender || await DeliveryIntelligenceHistory.ReadRoleAsync(JS) is not { } role || role == _role) return;
        _role = role;
        if (TabQuery is null && !OnSnapshotsRoute) { _tab = DeliveryIntelligenceHistory.DefaultReportsTab(role); StateHasChanged(); }
    }

    private async Task SetRoleAsync(DeliveryRole role)
    {
        _role = role;
        await DeliveryIntelligenceHistory.WriteRoleAsync(JS, role);
        Nav.NavigateTo($"{P.Route}?project={_projectId}&tab={DeliveryIntelligenceHistory.DefaultReportsTab(role)}{(_report is null ? "" : $"&report={_report.ReportId}")}", replace: true);
    }
    private WeeklyDeliveryReport? _report;

    private bool _newProjectOpen;
    private string _newName = "", _newDescription = "";
    private string? _newProjectError;
    private ElementReference _newProjectName;

    private bool _importOpen, _confirmDuplicate, _fromAzureDevOps;
    private string? _adoNote;
    private string _effectiveInput = "";
    private DeliverySnapshotRole _importRole = DeliverySnapshotRole.Current;
    private string _importLabel = "";
    private DeliveryImportPreview? _preview;
    private string? _importError;
    private ElementReference _importTitle;
    private bool _focusImport;

    private Guid? _baselineId, _currentId;
    /// <summary>True once the person picked a snapshot (current, baseline, swap or Compare): refreshes keep those exact ids and never pick a default instead.</summary>
    private bool _userChoseSnapshots;
    private string? _selectionNotice;

    /// <summary>Keeps the chosen ids that still exist; a chosen snapshot that no longer exists is reported, never replaced by the latest one.</summary>
    private async Task KeepSelectionAsync()
    {
        var missing = new List<string>();
        if (_currentId is { } c && _snapshots.All(s => s.Id != c)) { _currentId = null; missing.Add("current"); }
        if (_baselineId is { } b && _snapshots.All(s => s.Id != b)) { _baselineId = null; missing.Add("baseline"); }
        _selectionNotice = missing.Count == 0 ? null
            : $"The previously selected {string.Join(" and ", missing)} snapshot is unavailable. Select the intended snapshot.";
        await LoadPreviewAsync();
    }
    private DeliveryBaselineSuggestion? _suggestion;

    private string _storyFilter = "default";
    private string? _storySearch, _storyModule;
    private readonly HashSet<string> _expanded = new(StringComparer.Ordinal);

    private Guid? _renameId, _viewId;
    private string _renameValue = "";
    private DeliverySnapshotDetail? _view;

    private bool _exportAppendix, _exportUnchanged;
    private Confirmation? _confirm;
    private ElementReference _confirmButton;
    private bool _focusConfirm;

    private string? ProjectName => _projects.FirstOrDefault(p => p.Id == _projectId)?.Name;
    private bool _disposed;

    protected override void OnInitialized() => Operations.Changed += OnOperationsChanged;

    // Generation/export/import operations of this project may finish while the page is open or after it was left; the page only observes.
    private void OnOperationsChanged() => _ = InvokeAsync(() => { if (!_disposed) StateHasChanged(); });

    public void Dispose()
    {
        // Unsubscribe only: running report generation, exports and Azure DevOps previews continue (Activity Center).
        _disposed = true;
        Operations.Changed -= OnOperationsChanged;
    }

    /// <summary>A report generation of the shown project that is still running (started here earlier, maybe before leaving the page).</summary>
    private BirkNext.Web.Services.Operations.OperationSnapshot? RunningGeneration =>
        _projectId is { } id ? Operations.Active.FirstOrDefault(o => o.Kind == BirkNext.Web.Services.Operations.OperationKind.DeliveryReportGeneration && o.Context.ProjectKey == id.ToString()) : null;

    protected override async Task OnParametersSetAsync()
    {
        if (!OnSnapshotsRoute && string.Equals(TabQuery, "snapshots", StringComparison.OrdinalIgnoreCase))
        {
            // A saved "Delivery Reports → Snapshots" link lands on the Delivery Snapshots destination (same project).
