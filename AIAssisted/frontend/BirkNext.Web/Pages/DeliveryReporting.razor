    // ── Import ──────────────────────────────────────────────────────────────────────────────────────────────────────

    /// <summary>An Azure DevOps preview that finished while the page was not shown (or the dialog was closed by leaving): offered again.</summary>
    private (DeliveryImportPreview Preview, string? Note)? PendingPreview => _projectId is { } id && !_importOpen ? Session.Pending(id) : null;

    private void ReviewPending()
    {
        if (PendingPreview is not { } pending) return;
        OpenImport();
        _fromAzureDevOps = true;
        _preview = pending.Preview;
        _adoNote = pending.Note;
