@page "/task-explorer"
@using BirkNext.Web.Components
@using BirkNext.Web.Models
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject BirkNext.Web.Services.IWorkspaceSessionService Workspace

<PageTitle>Task Explorer — QA Review Studio</PageTitle>

<div class="tx-page">

    <PageHeader Title="Task Explorer"
                Description="Explore your implementation plan independently of spec alignment. Upload, paste, or drag a tasks.md file to build the hierarchy." />

    <div class="tx-page-body">
        <TaskExplorerPanel
            TasksText="@_initialTasksText"
            ParsedTasks="@_parsedTasks"
            SemanticModel="@_semanticModel"
            InitialView="@_initialView"
            OnTextChanged="OnPanelTextChanged" />
    </div>

</div>

@code {
    private string _initialTasksText = string.Empty;
    private string? _initialView;
    private TaskTree? _parsedTasks;
    private TaskSemanticModel? _semanticModel;

    private const string StorageKey = "te-standalone-tasks";

    protected override void OnInitialized()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("view", out var view))
            _initialView = view;

        var cached = Workspace.Get(WorkspaceArtifactKind.Tasks);
        if (cached != null)
            _initialTasksText = cached.Text;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!string.IsNullOrWhiteSpace(_initialTasksText)) return;

        string? legacy = null;
        try { legacy = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey); } catch { }

        if (!string.IsNullOrWhiteSpace(legacy))
        {
            Workspace.Set(WorkspaceArtifactKind.Tasks, legacy);
            _initialTasksText = legacy;
            BuildSemanticModel(legacy);
            StateHasChanged();
        }
    }

    private void BuildSemanticModel(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            _semanticModel = null;
            _parsedTasks = null;
            return;
        }
        _parsedTasks = TaskExplorerService.Parse(text);
        _semanticModel = TaskExplorerService.BuildSemanticModel(_parsedTasks);
    }

    private async Task OnPanelTextChanged(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        BuildSemanticModel(text);
        Workspace.Set(WorkspaceArtifactKind.Tasks, text);
        try
        {
            if (string.IsNullOrWhiteSpace(Workspace.CurrentProject))
                await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, text);
            else
                await JS.InvokeVoidAsync("localStorage.removeItem", StorageKey);
        }
        catch { }
    }
}
