@page "/task-explorer"
@using BirkNext.Web.Components
@using BirkNext.Web.Models
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>Task Explorer — QA Review Studio</PageTitle>

<div class="tx-page">

    <div class="tx-page-header">
        <div class="tx-page-header-inner">
            <div class="tx-page-title-row">
                <span class="tx-page-icon" aria-hidden="true">🗂</span>
                <div>
                    <h1 class="tx-page-title">Task Explorer</h1>
                    <p class="tx-page-subtitle">Explore your implementation plan independently of spec alignment. Upload, paste, or drag a tasks.md file to build the hierarchy.</p>
                </div>
            </div>
            <div class="tx-page-context-note">
                <span class="tx-context-label">Standalone Explorer</span>
                <span class="tx-context-sep">·</span>
                <span class="tx-context-desc">For spec-aligned analysis use <a href="/task-alignment" class="tx-context-link">Implementation Review</a></span>
            </div>
        </div>
    </div>

    <div class="tx-page-body">
        <TaskExplorerPanel
            TasksText="@_initialTasksText"
            OnBuilt="OnTreeBuilt" />
    </div>

</div>

@code {
    private string _initialTasksText = string.Empty;

    private const string StorageKey = "te-standalone-tasks";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
            if (!string.IsNullOrWhiteSpace(saved) && saved != _initialTasksText)
            {
                _initialTasksText = saved;
                StateHasChanged();
            }
        }
        catch
        {
            // localStorage unavailable — continue without restore
        }
    }

    private async Task OnTreeBuilt(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, text);
        }
        catch
        {
            // ignore storage errors
        }
    }
}
