@page "/delivery-overview"
@* Delivery data is read from the Delivery Reporting API only, never from workspace documents: no wait for document bodies. *@
@attribute [BirkNext.Web.Services.WorkspaceDocumentsNotRead]
@using BirkNext.DeliveryReporting
@using BirkNext.Web.Services
@using BirkNext.Interpretation
@using BirkNext.Web.Components
@using P = BirkNext.Web.Services.DeliveryReportingPresentation
@inject IDeliveryReportingApiService Api
@inject NavigationManager Nav
@inject IJSRuntime JS

@* Delivery Overview: the virtual SDD backlog of a Delivery Reporting project (read-only). It shows what the newest frozen weekly report (or
   newest snapshot) states — never current BirkNext workspace state and never a status the evidence does not state. A feature opens in the
   same feature explorer the report uses (?feature=), so project, report and filters are kept when going back. *@
<PageTitle>Delivery Overview</PageTitle>
<div class="do-page" data-testid="delivery-overview">
    <header class="do-head" data-testid="do-header">
        <div class="do-title-row"><h1>Delivery Overview</h1><DeliveryRolePicker Role="_role" OnChange="SetRoleAsync" TestId="do-role" /></div>
        <p class="do-lead" data-testid="do-lead">Where delivery stands now: features, verified completion, risks and what needs a decision.</p>
        <p class="do-clarify do-muted" data-testid="do-checklist-clarification">Task checklist progress reflects source checkboxes, not verified implementation or QA completion.
            <span class="dd-info" tabindex="0" title="@ChecklistHelp" aria-label="@ChecklistHelp">ⓘ</span></p>
        @if (_view is { } summaryView)
        {
            <p class="do-context" role="status" data-testid="do-context">Current snapshot: <strong>@summaryView.Source.SnapshotLabel</strong> · @summaryView.Items.Count feature@(summaryView.Items.Count == 1 ? "" : "s")@(Scoped ? " in this scope" : "")</p>
        }
    </header>

    @if (!_loaded) { <InlineLoading Text="Loading delivery projects…" /> }
    else if (_error is not null) { <LoadError Title="Delivery projects could not be loaded" Message="@_error" OnRetry="RetryProjectsAsync" TestId="do-load-error" /> }
    else if (_projects.Count == 0)
    {
        <section class="do-card" data-testid="do-no-project">
            <h2>No delivery project yet</h2>
            <p>Create a delivery project and import a snapshot (ZIP or Azure DevOps) in <a href="delivery-reporting">Delivery Reports</a>.</p>
        </section>
    }
    else
    {
        <div class="do-toolbar">
            <label class="do-field"><span>Delivery project</span>
                <select data-testid="do-project" value="@_projectId" @onchange="OnProjectChanged">
                    @foreach (var p in _projects) { <option value="@p.Id">@p.Name</option> }
                </select>
            </label>
        </div>

        @if (_loadingProject) { <InlineLoading Text="Loading the backlog…" /> }
        else if (_view is null)
        {
            <section class="do-card" data-testid="do-no-snapshot">
                <h2>No snapshot imported</h2>
                <p>Import a repository snapshot for this project in <a href="@($"delivery-reporting?project={_projectId}&tab=snapshots")">Delivery Reports</a>.</p>
            </section>
        }
        else if (_report is not null && FeatureQuery is { Length: > 0 } feature && _report.Stories.Any(s => s.FeatureKey == feature))
        {
            <BirkNext.Web.Components.DeliveryFeatureExplorer @key="_report.ReportId" Report="_report" ProjectName="@(_projects.FirstOrDefault(p => p.Id == _projectId)?.Name ?? "")"
                OpenFeatureKey="@feature" OnClose="CloseFeature" />
        }
        else
        {
            var view = _view;
            var header = DeliveryDashboard.Header(view, _report, _projects.FirstOrDefault(p => p.Id == _projectId)?.Name ?? "");
            <section class="dd-header" data-testid="dd-header" aria-label="Comparison context">
                <h2 class="dd-title">@header.Title</h2>
                <dl class="dd-context">
                    <div><dt>Source</dt><dd data-testid="dd-scope-source">@SourceSummary()</dd></div>
                    <div><dt>Functional scope</dt><dd data-testid="dd-scope-scope">@(SelectedScopeName() ?? "All functional scopes")</dd></div>
                    @if (_module.Length > 0) { <div><dt>Module</dt><dd data-testid="dd-scope-module">@ModuleLabel(_module)</dd></div> }
                    <div><dt>Current snapshot</dt><dd data-testid="dd-current-label">@header.CurrentLabel</dd></div>
                    @if (header.BaselineLabel is { } baseline) { <div><dt>Baseline</dt><dd>@baseline</dd></div> }
                    <div><dt>Coverage</dt><dd data-testid="dd-coverage">@header.Coverage</dd></div>
                </dl>
                <p class="dd-badges">
                    @if (header.SameDay) { <span class="dd-badge dd-tone-review" data-testid="dd-same-day"><span aria-hidden="true">◷ </span>Same-day comparison</span> }
                    @if (header.OrderUnconfirmed) { <span class="dd-badge dd-tone-review" data-testid="dd-order" title="Both snapshots have the same effective date; which one is later cannot be confirmed from dates.">Order not confirmable from dates</span> }
                </p>
                <p class="do-muted do-source" data-testid="do-source">
                    @(view.Source.Kind == "report" ? $"From report {view.Source.WeekLabel}" : "From the newest snapshot (no report yet)") ·
                    current snapshot “@view.Source.SnapshotLabel” of @P.Day(view.Source.EffectiveAt) · <span data-testid="do-provenance">@DeliveryBacklog.Provenance(view.Source)</span>
                </p>
            </section>

            @* Sections instead of one long page: the dashboard first; features, risks and the technical work-item explorer on request. *@
            <nav class="dd-section-nav" aria-label="Delivery Overview sections" data-testid="do-sections">
                <a href="@Url(section: "overview")" aria-current="@(Section == "overview" ? "page" : null)" data-testid="do-section-overview">Overview</a>
                <a href="@Url(section: "features")" aria-current="@(Section == "features" ? "page" : null)" data-testid="do-section-features">Features <span class="do-muted">(@view.Items.Count)</span></a>
                <a href="@Url(section: "risks")" aria-current="@(Section == "risks" ? "page" : null)" data-testid="do-section-risks">Risks &amp; quality@(AttentionEntries(view).Count > 0 ? $" ({AttentionEntries(view).Sum(e => e.Key is "evidence" or "limitations" ? 0 : e.Count)})" : "")</a>
                <a class="dd-nav-advanced" href="@Url(section: "technical")" aria-current="@(Section == "technical" ? "page" : null)" data-testid="do-section-technical">Technical details</a>
            </nav>

            <section class="do-filters" aria-label="Scope and filters" data-testid="do-filters">
                <div class="do-toolbar" role="group" aria-label="Scope the overview">
                    @if (Section is "features" or "technical")
                    {
                        <label class="do-field"><span>Search</span><input type="search" data-testid="do-search" @bind="_search" @bind:event="oninput" @bind:after="WriteUrl" placeholder="Feature or module" /></label>
                    }
                    @if (Modules.Count > 1 || _module.Length > 0)
                    {
                        <label class="do-field"><span>Module</span>
                            <select data-testid="do-module" value="@_module" @onchange="OnModuleChanged">
                                <option value="">All modules</option>
                                @foreach (var m in Modules) { <option value="@m">@ModuleLabel(m)</option> }
                            </select></label>
                    }
                    <label class="do-field"><span>Work type <span class="dd-info" tabindex="0" title="@WorkHelp" aria-label="@WorkHelp">ⓘ</span></span>
                        <select data-testid="do-work" value="@_work" @onchange="OnWorkChanged">
                            <option value="@nameof(DeliveryWorkType.NonTechnical)">Non-technical</option>
                            <option value="@nameof(DeliveryWorkType.Technical)">Technical</option>
                            <option value="@nameof(DeliveryWorkType.All)">All work</option>
                        </select></label>
                    @if (Section is "features" or "technical")
                    {
                        <label class="do-field"><span>Delivery status</span>
                            <select data-testid="do-filter" value="@_status" @onchange="OnStateChanged">
                                <option value="@AllFilter">All statuses</option>
                                @foreach (var st in Enum.GetValues<BacklogStatus>().Where(x => !DeliveryBacklog.NotFromSnapshots(x))) { <option value="@st">@DeliveryBacklog.Label(st)</option> }
                            </select></label>
                        <label class="do-field"><span>Attention</span>
                            <select data-testid="do-attention" value="@_attention" @onchange="OnAttentionChanged">
                                <option value="@AllFilter">All features</option>
                                <option value="attention">Needs attention</option>
                                <option value="open">Has open tasks</option>
                            </select></label>
                    }
                </div>
                @* Evidence source, functional scope and quality category are less frequent: one click away, open while any is applied. *@
                <details class="do-more-filters" data-testid="do-more-filters" open="@(_source is not null || _scope is not null || _quality is not null)">
                    <summary>Source, functional scope and quality category</summary>
                    <div class="do-toolbar">
                        <label class="do-field"><span>Source <span class="dd-info" tabindex="0" title="@CanonicalScopeText.SourceHelp" aria-label="@CanonicalScopeText.SourceHelp">ⓘ</span></span>
                            <select data-testid="do-source-filter" value="@(_source ?? "")" @onchange="OnSourceChanged">
                                <option value="">All sources@(SourceOptions.Count > 1 ? $" ({SourceOptions.Count} evidence sources)" : "")</option>
                                @foreach (var s in SourceOptions) { <option value="@s.Id" title="@s.Provenance">@s.Name (@SourceCount(s))</option> }
                                @if (_source is { } src && SourceOptions.All(o => o.Id != src)) { <option value="@src">Unavailable source</option> }
                            </select></label>
                        <label class="do-field"><span>Functional scope <span class="dd-info" tabindex="0" title="@CanonicalScopeText.FunctionalScopeHelp" aria-label="@CanonicalScopeText.FunctionalScopeHelp">ⓘ</span></span>
                            <select data-testid="do-scope-filter" value="@(_scope ?? "")" @onchange="OnScopeChanged">
                                <option value="">All functional scopes</option>
                                @foreach (var g in ScopeOptions.GroupBy(o => o.Kind))
                                {
                                    <optgroup label="@CanonicalScopeText.KindLabel(g.Key)">
                                        @foreach (var o in g) { <option value="@o.Id" title="@o.Detail">@o.Name (@o.CurrentFeatures)</option> }
                                    </optgroup>
                                }
                                @if (_scope is { } sc && ScopeOptions.All(o => o.Id != sc)) { <option value="@sc">Unavailable scope</option> }
                            </select></label>
                        @if (_work != nameof(DeliveryWorkType.Technical))
                        {
                            <label class="do-field"><span>Quality category</span>
                                <select data-testid="do-quality" value="@(_quality ?? "")" @onchange="OnQualityChanged">
                                    <option value="">All categories</option>
                                    @foreach (var q in FunctionalQualityClassifier.NonTechnicalCategories) { <option value="@q">@FunctionalQualityClassifier.Label(q)@QualityCount(q)</option> }
                                </select></label>
                        }
                    </div>
                </details>
                @if (_scopeView?.WorkSummary is { } ws)
                {
                    <p class="do-showing" role="status" data-testid="do-showing">
                        <strong>Showing: @WorkLabel delivery · @ws.Shown of @ws.Total features</strong>
                        @if (_work != nameof(DeliveryWorkType.Technical) && ws.ByCategory.Where(c => c.Key != QualityCategory.Technical).OrderByDescending(c => c.Value).ToList() is { Count: > 0 } cats)
                        {
                            <span class="do-muted" data-testid="do-categories"> · @string.Join(" · ", cats.Select(c => $"{FunctionalQualityClassifier.Label(c.Key)} {c.Value}"))</span>
                        }
                        @if (_work == nameof(DeliveryWorkType.NonTechnical) && ws.Technical > 0) { <span class="do-muted"> · @ws.Technical technical feature@(ws.Technical == 1 ? "" : "s") hidden</span> }
                    </p>
                }
                @if (AnyFilter)
                {
                    <p class="do-chips" data-testid="do-chips">
                        @if (_source is not null) { <button type="button" class="do-chip" data-testid="do-chip-source" aria-label="Clear source" @onclick="ClearSource">Source: @SourceName() <span aria-hidden="true">×</span></button> }
                        @if (_scope is not null) { <button type="button" class="do-chip" data-testid="do-chip-scope" aria-label="Clear functional scope" @onclick="ClearScope">Scope: @(SelectedScopeName() ?? "unavailable") <span aria-hidden="true">×</span></button> }
                        @if (_module.Length > 0) { <button type="button" class="do-chip" aria-label="Clear module" @onclick="ClearModule">Module: @ModuleLabel(_module) <span aria-hidden="true">×</span></button> }
                        <button type="button" class="do-clear" data-testid="do-clear-filters" @onclick="ClearFilters">Clear filters</button>
                    </p>
                }
                @foreach (var invalid in _scopeView?.InvalidFilters ?? []) { <p class="do-notice" role="alert" data-testid="do-invalid-filter">@invalid</p> }
                @foreach (var notice in _scopeView?.Notices ?? []) { <p class="do-notice" role="status" data-testid="do-scope-notice">@notice</p> }
                @if (_scopeError is { } scopeError) { <p class="do-notice" role="alert" data-testid="do-scope-error">@scopeError</p> }
                @if (_scopeView?.InterpretationNote is { } interpretationNote) { <p class="do-muted" data-testid="do-interpretation-note">@interpretationNote</p> }
            </section>

            @if ((Scoped || Work.IsActive) && view.Items.Count == 0)
            {
                <section class="do-card do-empty-scope" data-testid="do-empty-scope" role="status">
                    <h3 class="dd-card-h">No Delivery features match this Source + Functional scope.</h3>
                    <p class="do-chips">
                        @if (_scope is not null) { <button type="button" class="do-clear" data-testid="do-clear-scope" @onclick="ClearScope">Clear functional scope</button> }
                        @if (_source is not null) { <button type="button" class="do-clear" data-testid="do-clear-source" @onclick="ClearSource">Clear source</button> }
                        @if (_module.Length > 0) { <button type="button" class="do-clear" @onclick="ClearModule">Clear module</button> }
                        @if (_work == nameof(DeliveryWorkType.NonTechnical) && _scopeView?.WorkSummary is { Technical: > 0 } hidden)
                        {
                            <button type="button" class="do-clear" data-testid="do-show-all-work" @onclick="ShowAllWork">Show all work (@hidden.Technical technical)</button>
                        }
                    </p>
                </section>
            }

            @switch (Section)
            {
                case "features": @FeaturesSection(view) break;
                case "risks": @RisksSection(view) break;
                case "technical": @TechnicalSection(view) break;
                default: @OverviewSection(view) break;
            }
        }
    }
</div>

@code {
    // ── Sections (NEXT53): Overview dashboard · Features · Risks & quality · Technical details (advanced) ─────────────────────────────

    /// <summary>The page section (?section=); the dashboard by default. Tasks are only in Technical details.</summary>
    [SupplyParameterFromQuery(Name = "section")] public string? SectionQuery { get; set; }
    /// <summary>The feature open in the feature list (?f=, a canonical feature key).</summary>
    [SupplyParameterFromQuery(Name = "f")] public string? OpenFeatureQuery { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? SortQuery { get; set; }

    private static readonly string[] Sections = ["overview", "features", "risks", "technical"];
    /// <summary>The section in the URL; without one, the default of the chosen role (Project Leader: dashboard, Scrum Master: features, Test Lead: risks).</summary>
    private string Section => SectionQuery is { } s && Sections.Contains(s) ? s : DeliveryIntelligenceHistory.DefaultOverviewSection(_role);

    private DeliveryRole _role = DeliveryRole.ProjectLeader;
    private List<DeliveryReportSummaryRow> _reportRows = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || await DeliveryIntelligenceHistory.ReadRoleAsync(JS) is not { } role || role == _role) return;
        _role = role;
        StateHasChanged();
    }

    private async Task SetRoleAsync(DeliveryRole role)
    {
        _role = role;
        await DeliveryIntelligenceHistory.WriteRoleAsync(JS, role);
        Go(Url(section: DeliveryIntelligenceHistory.DefaultOverviewSection(role)));
    }

    private string TimelineHref(DeliveryTimelinePoint p) => $"delivery-reporting?project={_projectId}&report={p.ReportId}";
    private DeliveryFeatureSort Sort => Enum.TryParse<DeliveryFeatureSort>(SortQuery, true, out var s) ? s : DeliveryFeatureSort.Priority;

    // One calculation per data change (the components only render): cards, attention entries and the filtered list are memoised.
    private (DeliveryBacklogView View, WeeklyDeliveryReport? Report)? _cardsFor;
    private IReadOnlyList<DeliveryFeatureCard> _cards = [];
    private IReadOnlyList<DeliveryAttentionEntry> _entries = [];
    private (IReadOnlyList<DeliveryFeatureCard> Cards, string Status, string Attention, string Search, DeliveryFeatureSort Sort)? _shownFor;
    private IReadOnlyList<DeliveryFeatureCard> _shownCards = [];

    private IReadOnlyList<DeliveryFeatureCard> Cards(DeliveryBacklogView view)
    {
        if (_cardsFor is { } f && ReferenceEquals(f.View, view) && ReferenceEquals(f.Report, _report)) return _cards;
        _cards = DeliveryIntelligence.Cards(view, _report);
        _entries = DeliveryIntelligence.AttentionRequired(view, _report, _scope is not null ? _scopeView?.Candidates?.Count ?? 0 : 0);
        _cardsFor = (view, _report);
        return _cards;
    }

    private IReadOnlyList<DeliveryAttentionEntry> AttentionEntries(DeliveryBacklogView view) { Cards(view); return _entries; }

    private IReadOnlyList<DeliveryFeatureCard> ShownCards(DeliveryBacklogView view)
    {
        var cards = Cards(view);
        if (_shownFor is { } s && ReferenceEquals(s.Cards, cards) && s.Status == _status && s.Attention == _attention && s.Search == _search && s.Sort == Sort) return _shownCards;
        var keys = Filtered(view).Select(i => i.FeatureKey).ToHashSet(StringComparer.Ordinal);
        _shownCards = DeliveryIntelligence.Sort(cards.Where(c => keys.Contains(c.FeatureKey)), Sort);
        _shownFor = (cards, _status, _attention, _search, Sort);
        return _shownCards;
    }

    /// <summary>Where an attention entry is handled on this page (its section, with its filter).</summary>
    private string AttentionHref(DeliveryAttentionEntry e)
    {
        var url = Url(section: e.View, state: e.Filter?.StartsWith("state=") == true ? e.Filter["state=".Length..] : null,
            attention: e.Filter?.StartsWith("attention=") == true ? e.Filter["attention=".Length..] : null);
        return url;
    }

    private RenderFragment OverviewSection(DeliveryBacklogView view) => __builder =>
    {
        <h3 class="dd-h" id="dd-current-h">Current delivery state</h3>
        <DeliveryKpiGrid Kpis="DeliveryDashboard.Current(view)" Label="Current delivery state" />

        <div class="dd-grid">
            <DeliveryAttentionRequired Entries="AttentionEntries(view)" Href="AttentionHref" />
            <section class="dd-card" aria-labelledby="dd-status-h" data-testid="dd-status">
                <h3 class="dd-card-h" id="dd-status-h">Feature status</h3>
                <DeliveryBarChart Bars="DeliveryDashboard.FeatureStatus(view)" TestId="dd-status-bar" Label="Features by delivery status" Empty="No features in this scope." />
                <p class="do-muted dd-note">From task checkboxes and explicit status lines only — no workflow state is inferred; none of these is verified completion.</p>
            </section>
        </div>

        <div class="dd-grid">
            @{ var total = view.Items.Sum(i => i.TasksTotal); var done = view.Items.Sum(i => i.TasksCompleted); }
            <section class="dd-card" aria-labelledby="dd-module-h" data-testid="dd-module-progress">
                <h3 class="dd-card-h" id="dd-module-h">Task checklist by module</h3>
                <DeliveryBarChart Bars="DeliveryIntelligence.ModuleProgress(view)" TestId="dd-module-bar" Label="Checked tasks by module" Percent="true" Empty="No tasks.md checkboxes in this scope." />
                <p class="do-muted dd-note" data-testid="dd-checklist-note">@(total == 0 ? "No tasks.md checkboxes in this snapshot." : $"{done} of {total} tasks checked overall ({100 * done / total}%).") @DeliveryDashboard.ChecklistInfo</p>
            </section>
            <section class="dd-card" aria-labelledby="dd-quality-h" data-testid="dd-quality">
                <h3 class="dd-card-h" id="dd-quality-h">Quality &amp; evidence</h3>
                @QualityRows(view)
            </section>
        </div>

        @if (DeliveryIntelligence.BlockersByModule(view) is { Count: > 0 } blockers)
        {
            <section class="dd-card dd-spaced" aria-labelledby="dd-blockers-h" data-testid="dd-blockers">
                <h3 class="dd-card-h" id="dd-blockers-h">Blockers by module</h3>
                <DeliveryBarChart Bars="blockers" TestId="dd-blocker-bar" Label="Blocked features by module" />
            </section>
        }

        @if (_report is not null)
        {
            <h3 class="dd-h" id="dd-change-h">Change this period <span class="do-muted">compared with the baseline@(Scoped ? ", same scope on both sides" : "")</span></h3>
            @if (DeliveryDashboard.ChangeNotComparable(_report) is { } notComparable)
            {
                <p class="do-card do-muted" data-testid="dd-change-not-comparable">@notComparable</p>
            }
            else
            {
                <div class="dd-grid">
                    <section class="dd-card" aria-label="Feature changes" data-testid="dd-change-features"><h3 class="dd-card-h">Features</h3><DeliveryBarChart Bars="DeliveryDashboard.FeatureChanges(_report)" TestId="dd-change-bar" /></section>
                    <section class="dd-card" aria-label="Task changes" data-testid="dd-change-tasks"><h3 class="dd-card-h">Tasks</h3><DeliveryBarChart Bars="DeliveryDashboard.TaskChanges(_report)" TestId="dd-change-bar" Signed="true" /></section>
                </div>
                @if (view.Source.ReportId is { } reportLink)
                {
                    <p class="do-links"><a href="@($"delivery-reporting?project={_projectId}&report={reportLink}")" data-testid="do-open-report">Open the full change report in Delivery Reports</a></p>
                }
            }
        }
        else
        {
            <p class="do-links"><a href="@($"delivery-reporting?project={_projectId}")" data-testid="do-generate-report">Generate a report to see changes since a baseline, user stories and acceptance criteria</a></p>
        }
        <div class="dd-spaced">
            <DeliveryTimeline Points="DeliveryIntelligenceHistory.Timeline(_reportRows, view.Source.ReportId)" Milestones="DeliveryIntelligenceHistory.Milestones(_report)" Href="TimelineHref" TestId="do-timeline" />
        </div>
        <p class="do-muted dd-trend" data-testid="dd-trend">Trend available after more delivery snapshots — a baseline and a current snapshot are two points, not a trend.</p>
    };

    private RenderFragment FeaturesSection(DeliveryBacklogView view) => __builder =>
    {
        var shown = ShownCards(view);
        <div class="dd-list-tools">
            <p class="do-muted" role="status" data-testid="do-count">@shown.Count of @view.Items.Count features@(Scoped ? " in this scope" : "")</p>
            <label>Sort
                <select data-testid="do-sort" value="@Sort" @onchange="OnSortChanged">
                    <option value="@DeliveryFeatureSort.Priority">Needs attention first</option>
                    <option value="@DeliveryFeatureSort.Name">Name</option>
                    <option value="@DeliveryFeatureSort.Module">Module</option>
                    <option value="@DeliveryFeatureSort.Progress">Least checklist progress</option>
                </select></label>
        </div>
        <DeliveryFeatureList Cards="shown" Report="_report" SelectedKey="@OpenFeatureQuery" OnSelect="SelectFeatureCard" OnOpenTechnical="OpenTechnical"
            ShowChange="_report is not null" Why="Why" TestId="do-features" />
        @if (view.RemovedFeatures.Count > 0)
        {
            <p class="do-muted" data-testid="do-removed">Removed this period (scope change to confirm, not counted as delivered): @string.Join(", ", view.RemovedFeatures)</p>
        }
    };

    private RenderFragment RisksSection(DeliveryBacklogView view) => __builder =>
    {
        <div class="dd-grid">
            <DeliveryAttentionRequired Entries="AttentionEntries(view)" Href="AttentionHref" />
            <section class="dd-card" aria-labelledby="dd-quality-h" data-testid="dd-quality">
                <h3 class="dd-card-h" id="dd-quality-h">Quality &amp; evidence</h3>
                @QualityRows(view)
            </section>
        </div>
        <section class="dd-card dd-spaced" aria-labelledby="dd-attention-h" data-testid="dd-attention">
            <h3 class="dd-card-h" id="dd-attention-h">Review items by category</h3>
            @if (_report is null) { <p class="do-muted">Generate a report to see scope changes and traceability issues.</p> }
            else if (DeliveryDashboard.Attention(_report) is { Count: 0 }) { <p class="do-muted" data-testid="dd-attention-none">No attention items. Shared &amp; foundational tasks are normal and never listed here.</p> }
            else
            {
                @foreach (var g in DeliveryDashboard.Attention(_report))
                {
                    <details class="dd-att-group" data-testid="dd-attention-group" data-category="@g.Category">
                        <summary><strong>@g.Label</strong> <span class="dd-badge dd-tone-@(g.Items.Any(i => i.Severity == DeliveryAttentionSeverity.Blocker) ? "blocker" : "review")">@g.Items.Count</span></summary>
                        <ul class="dd-att-list">@foreach (var a in g.Items.Take(20)) { <li><strong>@a.Title</strong> — @a.Detail</li> }</ul>
                        @if (g.Items.Count > 20) { <p class="do-muted">+@(g.Items.Count - 20) more in the report</p> }
                    </details>
                }
            }
        </section>
        @if (_scope is not null && _scopeView?.Candidates is { Count: > 0 } candidates)
        {
            <details class="do-candidates dd-spaced" data-testid="do-scope-candidates">
                <summary>@candidates.Count more feature@(candidates.Count == 1 ? "" : "s") may belong to this scope — awaiting review, not counted</summary>
                <ul>@foreach (var c in candidates) { <li><strong>@c.Title</strong> — @c.Why</li> }</ul>
                <p><a href="correlation-review">Confirm or reject them in Relationship Review</a></p>
            </details>
        }
        @if (view.RemovedFeatures.Count > 0)
        {
            <p class="do-muted" data-testid="do-removed">Removed this period (scope change to confirm, not counted as delivered): @string.Join(", ", view.RemovedFeatures)</p>
        }
    };

    private RenderFragment TechnicalSection(DeliveryBacklogView view) => __builder =>
    {
        <p class="do-muted" data-testid="do-technical-note">Work items for analysis: features, user stories, phases and tasks with their identifiers and source evidence. Task checkboxes are progress, not verification.</p>
        @if (_report is not null)
        {
            var options = ExplorerOptions(view, _report);
            <p class="do-muted" role="status" data-testid="do-count">@options.FeatureKeys!.Count of @view.Items.Count features @(Scoped ? "in this scope " : "")· blocked, needs review, new and changed first</p>
            <BirkNext.Web.Components.DeliveryWorkspace @key="_report.ReportId" Report="_report" Options="options"
                ProjectId="_projectId" SelectedId="@ItemQuery" OnSelect="SelectItem" OnOpenFeature="OpenFeature" />
            @if (options.FeatureKeys.Count == 0 && view.Items.Count > 0) { <p class="do-muted" data-testid="do-empty-filter">No feature matches these filters.</p> }
        }
        else
        {
            <p class="do-card do-muted" data-testid="do-technical-no-report">The work-item explorer needs a generated report (it reads the frozen hierarchy).
                <a href="@($"delivery-reporting?project={_projectId}")">Generate a report in Delivery Reports</a>.</p>
        }
    };

    private static RenderFragment QualityRows(DeliveryBacklogView view) => __builder =>
    {
        <ul class="dd-quality">
            @foreach (var q in DeliveryDashboard.Quality(view))
            {
                <li data-testid="dd-quality-row" data-key="@q.Key" title="@q.Detail">
                    <span class="dd-q-label">@q.Label</span>
                    <span class="dd-q-track" aria-hidden="true">@if (q.Filled is { } f && q.Of is > 0 and var of) { <span class="dd-q-fill dd-tone-@DeliveryDashboard.ToneClass(q.Tone)" style="width:@(100 * f / of)%"></span> }</span>
                    <span class="dd-badge dd-tone-@DeliveryDashboard.ToneClass(q.Tone)" data-testid="dd-quality-state">@q.State</span>
                    <span class="dd-q-detail do-muted">@q.Detail</span>
                </li>
            }
        </ul>
    };

    private void OnSortChanged(ChangeEventArgs e) => Go(Nav.GetUriWithQueryParameter("sort", e.Value?.ToString() is { } s && s != nameof(DeliveryFeatureSort.Priority) ? s : null));

    /// <summary>Opening a card is a history entry (back closes it); the list position and filters stay.</summary>
    private void SelectFeatureCard(string? key) => Nav.NavigateTo(Nav.GetUriWithQueryParameter("f", key));

    /// <summary>The same feature in the work-item explorer (Technical details), selected there.</summary>
    private void OpenTechnical(string key) => Nav.NavigateTo(Url(section: "technical") + $"&item={Uri.EscapeDataString("f:" + key)}");

    private const string AllFilter = "all";
    [SupplyParameterFromQuery(Name = "project")] public string? ProjectQuery { get; set; }
    [SupplyParameterFromQuery(Name = "feature")] public string? FeatureQuery { get; set; }
    [SupplyParameterFromQuery(Name = "source")] public string? SourceQuery { get; set; }
    [SupplyParameterFromQuery(Name = "scope")] public string? ScopeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "module")] public string? ModuleQuery { get; set; }
    [SupplyParameterFromQuery(Name = "state")] public string? StateQuery { get; set; }
    [SupplyParameterFromQuery(Name = "attention")] public string? AttentionQuery { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? SearchQuery { get; set; }
    /// <summary>Work type: absent = Non-technical (the overview's default: functional and quality value), "All", "Technical".</summary>
    [SupplyParameterFromQuery(Name = "work")] public string? WorkQuery { get; set; }
    [SupplyParameterFromQuery(Name = "quality")] public string? QualityQuery { get; set; }
    /// <summary>The selected work item (canonical id, e.g. f:frontend::004-x) — shared with Delivery Reports → Stories.</summary>
    [SupplyParameterFromQuery(Name = "item")] public string? ItemQuery { get; set; }

    private const string ChecklistHelp = "Checked tasks represent source checklist status, not confirmed implementation or QA verification.";

    private (DeliveryBacklogView View, WeeklyDeliveryReport Report, string Status, string Attention, string Search, DeliveryScopeView? Scope)? _optionsFor;
    private BirkNext.Web.Services.DeliveryExplorerOptions? _options;

    /// <summary>The explorer's current-state options with the backlog facts and the page's filters. Built once per data/filter change: the explorer
    /// rebuilds its items when its options change, so they must not be recreated on every render.</summary>
    private BirkNext.Web.Services.DeliveryExplorerOptions ExplorerOptions(DeliveryBacklogView view, WeeklyDeliveryReport report)
    {
        var key = (view, report, _status, _attention, _search, _scopeView);
        if (_options is not null && _optionsFor is { } built && ReferenceEquals(built.View, view) && ReferenceEquals(built.Report, report) && built.Status == _status
            && built.Attention == _attention && built.Search == _search && ReferenceEquals(built.Scope, _scopeView)) return _options;
        var rows = DeliveryDashboard.Rows(view, report).ToDictionary(r => r.Item.FeatureKey, StringComparer.Ordinal);
        _options = BirkNext.Web.Services.DeliveryExplorerOptions.CurrentState with
        {
            Backlog = rows,
            Why = _scopeView?.Members.GroupBy(m => m.FeatureKey).ToDictionary(g => g.Key, g => g.First().Why, StringComparer.Ordinal),
            FeatureKeys = Filtered(view).Select(i => i.FeatureKey).ToHashSet(StringComparer.Ordinal),
        };
        _optionsFor = key;
        return _options;
    }

    /// <summary>The explorer's own state (wi-* keys) of the current URL: kept when the page's filters change.</summary>
    private IEnumerable<string> ExplorerQuery() =>
        BirkNext.Web.Services.DeliveryExplorerState.Parse(Nav.Uri).Where(kv => kv.Key.StartsWith("wi-", StringComparison.Ordinal) && kv.Value is { Length: > 0 })
            .Select(kv => $"{kv.Key}={Uri.EscapeDataString(kv.Value!)}");

    private bool _loaded, _loadingProject;
    private string? _error, _scopeError;
    private List<DeliveryProject> _projects = [];
    private Guid? _projectId, _reportId, _snapshotId;
    private DeliveryBacklogView? _view;
    private WeeklyDeliveryReport? _report;
    // What the server returned for the selected Source + Functional scope; Module narrows it further on the page with the same projection.
    private DeliveryScopeView? _scopeView;
    private WeeklyDeliveryReport? _scopedReport;
    private DeliverySnapshotDetail? _scopedSnapshot;
    private (string? Source, string? Scope, string Work, string? Quality)? _loadedFilter;
    private string? _source, _scope, _quality;
    private string _work = nameof(DeliveryWorkType.NonTechnical);
    private string _status = AllFilter, _module = "", _search = "", _attention = AllFilter;

    /// <summary>A selection other than the default view (all sources and scopes, Non-technical delivery).</summary>
    private bool Scoped => _source is not null || _scope is not null || _module.Length > 0 || _quality is not null || _work != nameof(DeliveryWorkType.NonTechnical);
    private bool AnyFilter => _source is not null || _scope is not null || _module.Length > 0 || _quality is not null || _work != nameof(DeliveryWorkType.NonTechnical)
        || _status != AllFilter || _attention != AllFilter || _search.Length > 0;
    private DeliveryWorkFilter Work => new(Enum.TryParse<DeliveryWorkType>(_work, out var w) ? w : DeliveryWorkType.NonTechnical,
        _work != nameof(DeliveryWorkType.Technical) && Enum.TryParse<QualityCategory>(_quality, out var q) ? q : null);
    private const string WorkHelp = "Non-technical = functional and quality value (functional, security, privacy, performance, reliability, data quality, compliance). " +
        "Technical = migrations, refactoring, infrastructure, translation, pipelines, developer tooling. Same classification as Functional Quality Scope.";
    private string WorkLabel => _work switch { nameof(DeliveryWorkType.Technical) => "Technical", nameof(DeliveryWorkType.All) => "All", _ => "Non-technical" }
        + (Work.Quality is { } q ? $" · {FunctionalQualityClassifier.Label(q)}" : "");
    private string QualityCount(QualityCategory q) => _scopeView?.WorkSummary?.ByCategory.GetValueOrDefault(q) is int n and > 0 ? $" ({n})" : "";
    private IReadOnlyList<DeliveryScopeSourceOption> SourceOptions => _scopeView?.Sources ?? [];
    private IReadOnlyList<DeliveryFunctionalScopeOption> ScopeOptions => _scopeView?.Scopes ?? [];

    /// <summary>Retry after the project list failed: reads it again and continues with the requested project.</summary>
    private async Task RetryProjectsAsync()
    {
        _loaded = false;
        _projectId = null;
        await OnParametersSetAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_loaded)
        {
            var (projects, error) = await Api.ProjectsAsync();
            _projects = projects;
            _error = error;
            _loaded = true;
        }
        _source = Blank(SourceQuery);
        _scope = Blank(ScopeQuery);
        _status = Blank(StateQuery) ?? AllFilter;
        _attention = Blank(AttentionQuery) ?? AllFilter;
        _search = SearchQuery ?? "";
        _work = Enum.TryParse<DeliveryWorkType>(WorkQuery, true, out var w) ? w.ToString() : nameof(DeliveryWorkType.NonTechnical);
        _quality = Blank(QualityQuery);
        var module = ModuleQuery ?? "";
        var requested = Guid.TryParse(ProjectQuery, out var p) && _projects.Any(x => x.Id == p) ? p : _projects.FirstOrDefault()?.Id;
        if (requested != _projectId) { _projectId = requested; _module = module; await LoadAsync(); }
        else if (_loadedFilter != (_source, _scope, _work, _quality)) { _module = module; await LoadScopeAsync(); }
        else if (module != _module) { _module = module; ApplyModule(); }
    }

    /// <summary>The backlog of the chosen delivery project only: its newest report, else its newest snapshot. Never another project's data.</summary>
    private async Task LoadAsync()
    {
        _view = null; _report = null; _reportId = null; _snapshotId = null; _scopeView = null; _loadedFilter = null;
        if (_projectId is not { } id) return;
        _loadingProject = true;
        try
        {
            // A scoped report covers part of the project only: the overview starts from the newest whole-comparison report and scopes it here.
            _reportRows = await Api.ReportsAsync(id) ?? [];
            if (_reportRows.Where(r => r.ScopeLabel.Length == 0).OrderByDescending(r => r.GeneratedAt).FirstOrDefault() is { } newest) _reportId = newest.Id;
            else if ((await Api.SnapshotsAsync(id)).OrderByDescending(s => s.EffectiveAt).FirstOrDefault() is { } snapshot) _snapshotId = snapshot.Id;
            await LoadScopeAsync();
        }
        finally { _loadingProject = false; }
    }

    /// <summary>
    /// Reads the overview for the selected Source + Functional scope from the server (membership by canonical ids; the report projected onto it).
    /// Without the scope endpoint the whole report is shown and a requested scope is reported as not applied — never silently ignored.
    /// </summary>
    private async Task LoadScopeAsync()
    {
        _scopeError = null;
        _loadedFilter = (_source, _scope, _work, _quality);
        if (_projectId is not { } id || _reportId is null && _snapshotId is null) { _scopedReport = null; _scopedSnapshot = null; ApplyModule(); return; }
        var view = await Api.ScopeAsync(id, _reportId, _reportId is null ? _snapshotId : null, new CanonicalScopeFilter(_source, _scope), default, Work);
        _scopeView = view;
        if (view is not null && (view.Report is not null || view.Snapshot is not null))
        {
            _scopedReport = view.Report is { } r && r.ProjectId == id ? r : null;
            _scopedSnapshot = view.Snapshot;
        }
        else
        {
            _scopedReport = _reportId is { } reportId && await Api.ReportAsync(id, reportId) is { } report && report.ProjectId == id ? report : null;
            _scopedSnapshot = _scopedReport is null && _snapshotId is { } snapshotId ? await Api.SnapshotAsync(id, snapshotId) : null;
            if (_source is not null || _scope is not null || Work.IsActive) _scopeError = "Source, Functional scope and Work type could not be applied; the whole project is shown.";
        }
        ApplyModule();
    }

    /// <summary>Module narrows the server-scoped rows with the same projection, so every number on the page stays scoped.</summary>
    private void ApplyModule()
    {
        if (_scopedReport is { } report)
        {
            _report = _module.Length == 0 ? report : DeliveryReportScoping.Project(report,
                report.Stories.Where(s => !s.RemovedFeature && s.Module == _module).Select(s => s.FeatureKey).ToHashSet(StringComparer.Ordinal),
                report.Stories.Where(s => s.RemovedFeature && s.Module == _module).Select(s => s.FeatureKey).ToHashSet(StringComparer.Ordinal),
                report.Scope ?? new DeliveryReportScope());
            _view = DeliveryBacklog.FromReport(_report);
        }
        else if (_scopedSnapshot is { } detail)
        {
            _report = null;
            _view = DeliveryBacklog.FromSnapshot(_module.Length == 0 ? detail : detail with { Features = [.. detail.Features.Where(f => f.Module == _module)] });
        }
        else { _report = null; _view = null; }
    }

    private IReadOnlyList<string> Modules =>
        [.. (_scopedReport?.Stories.Where(s => !s.RemovedFeature).Select(s => s.Module) ?? _scopedSnapshot?.Features.Select(f => f.Module) ?? [])
            .Distinct().Order(StringComparer.OrdinalIgnoreCase)];

    private IReadOnlyList<BacklogItem> Filtered(DeliveryBacklogView view)
    {
        IEnumerable<BacklogItem> items = view.Items;
        if (Enum.TryParse<BacklogStatus>(_status, out var status)) items = items.Where(i => i.Status == status);
        if (_search.Length > 0) items = items.Where(i => i.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) || i.Module.Contains(_search, StringComparison.OrdinalIgnoreCase));
        if (_attention == "attention") items = items.Where(i => i.Attention > 0);
        else if (_attention == "open") items = items.Where(i => i.OpenTasks > 0);
        // Order is the dashboard priority (DeliveryDashboard.Rows): blocked, needs review, new, changed, in progress, then the rest.
        return items.ToList();
    }

    private string? Why(string featureKey) => _scopeView?.Members.FirstOrDefault(m => m.FeatureKey == featureKey)?.Why;

    private string SourceName() => SourceOptions.FirstOrDefault(o => o.Id == _source)?.Name ?? "Unavailable source";

    private string SourceSummary() => _source is not null ? SourceName() : SourceOptions.Count switch
    {
        0 => "All sources",
        1 => $"{SourceOptions[0].Name} (the only source)",
        var n => $"All sources · {n} evidence sources",
    };

    private string? SelectedScopeName() => _scope is null ? null : ScopeOptions.FirstOrDefault(o => o.Id == _scope)?.Name ?? _scopeView?.Scope?.FunctionalScopeName;

    private static string SourceCount(DeliveryScopeSourceOption s) => s.CurrentFeatures == 0 && s.BaselineFeatures > 0 ? "baseline only" : s.CurrentFeatures.ToString();

    private static string ModuleLabel(string module) => module.Length == 0 ? "Project" : module;

    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value;

    // ── URL state: every filter lives in the query, so refresh and back keep the scope (ids only, never display names) ──

    private string Url(string? feature = null, string? source = null, string? scope = null, string? module = null, string? state = null, string? attention = null,
        bool keep = true, string? section = null)
    {
        var parts = new List<string> { $"project={_projectId}" };
        var sec = section ?? Section;
        if (sec != DeliveryIntelligenceHistory.DefaultOverviewSection(_role)) parts.Add($"section={sec}");
        void Add(string key, string? value) { if (!string.IsNullOrEmpty(value)) parts.Add($"{key}={Uri.EscapeDataString(value)}"); }
        Add("source", keep ? source ?? _source : source);
        Add("scope", keep ? scope ?? _scope : scope);
        Add("module", keep ? module ?? _module : module);
        if (keep && _work != nameof(DeliveryWorkType.NonTechnical)) Add("work", _work);
        if (keep && _quality is not null && _work != nameof(DeliveryWorkType.Technical)) Add("quality", _quality);
        var st = keep ? state ?? _status : state;
        if (st != AllFilter) Add("state", st);
        var at = keep ? attention ?? _attention : attention;
        if (at != AllFilter) Add("attention", at);
        if (keep) Add("q", _search);
        if (keep && sec == "technical") Add("item", ItemQuery);
        if (keep && sec == "features") Add("f", OpenFeatureQuery);
        if (keep && sec == "features" && Sort != DeliveryFeatureSort.Priority) Add("sort", Sort.ToString());
        if (keep && sec == "technical") parts.AddRange(ExplorerQuery());
        Add("feature", feature);
        return "delivery-overview?" + string.Join('&', parts);
    }

    private void Go(string url) => Nav.NavigateTo(url, replace: true);

    private void OnSourceChanged(ChangeEventArgs e) => Go(string.IsNullOrEmpty(e.Value?.ToString()) ? UrlWithout("source") : Url(source: e.Value!.ToString()));
    private void OnScopeChanged(ChangeEventArgs e) => Go(string.IsNullOrEmpty(e.Value?.ToString()) ? UrlWithout("scope") : Url(scope: e.Value!.ToString()));
    private void OnModuleChanged(ChangeEventArgs e) => Go(string.IsNullOrEmpty(e.Value?.ToString()) ? UrlWithout("module") : Url(module: e.Value!.ToString()));
    private void OnStateChanged(ChangeEventArgs e) => Go(Url(state: e.Value?.ToString() ?? AllFilter));
    private void OnWorkChanged(ChangeEventArgs e) { (_work, _quality) = (e.Value?.ToString() ?? nameof(DeliveryWorkType.NonTechnical), e.Value?.ToString() == nameof(DeliveryWorkType.Technical) ? null : _quality); Go(Url()); }
    private void ShowAllWork() { (_work, _quality) = (nameof(DeliveryWorkType.All), null); Go(Url()); }
    private void OnQualityChanged(ChangeEventArgs e) { _quality = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString(); Go(Url()); }
    private void OnAttentionChanged(ChangeEventArgs e) => Go(Url(attention: e.Value?.ToString() ?? AllFilter));
    private void WriteUrl() => Go(Url());

    private void ClearSource() => Go(UrlWithout("source"));
    private void ClearScope() => Go(UrlWithout("scope"));
    private void ClearModule() => Go(UrlWithout("module"));
    /// <summary>Back to the default view: all sources and scopes, Non-technical work (the overview's default), no list filters.</summary>
    private void ClearFilters() { _search = ""; Go(Url(keep: false)); }

    /// <summary>The current URL without one scope dimension (the others stay).</summary>
    private string UrlWithout(string key)
    {
        var (source, scope, module) = (_source, _scope, _module);
        (_source, _scope, _module) = (key == "source" ? null : source, key == "scope" ? null : scope, key == "module" ? "" : module);
        try { return Url(); }
        finally { (_source, _scope, _module) = (source, scope, module); }
    }

    private void OpenFeature(string key) => Nav.NavigateTo(Url(feature: key));

    /// <summary>A selection is a history entry (back returns to the previous item); filters and the explorer's state stay in the URL.</summary>
    private void SelectItem(string? id)
    {
        if (id is null || id == ItemQuery) return;
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("item", id));
    }

    private void CloseFeature() => Nav.NavigateTo(Url());

    private void OnProjectChanged(ChangeEventArgs e)
    {
        // Source and scope ids belong to one project: a project change starts unscoped.
        if (Guid.TryParse(e.Value?.ToString(), out var id)) Nav.NavigateTo($"delivery-overview?project={id}");
    }
