@page "/delivery-overview"
@* Delivery data is read from the Delivery Reporting API only, never from workspace documents: no wait for document bodies. *@
@attribute [BirkNext.Web.Services.WorkspaceDocumentsNotRead]
@using BirkNext.DeliveryReporting
@using BirkNext.Web.Services
@using P = BirkNext.Web.Services.DeliveryReportingPresentation
@inject IDeliveryReportingApiService Api
@inject NavigationManager Nav

@* Delivery Overview: the virtual SDD backlog of a Delivery Reporting project (read-only). It shows what the newest frozen weekly report (or
   newest snapshot) states — never current BirkNext workspace state and never a status the evidence does not state. A feature opens in the
   same feature explorer the report uses (?feature=), so project, report and filters are kept when going back. *@
<PageTitle>Delivery Overview</PageTitle>
<div class="do-page" data-testid="delivery-overview">
    <header class="do-head">
        <h1>Delivery Overview</h1>
        <p class="do-lead">Virtual SDD backlog: every feature with its user stories, acceptance criteria, phases and tasks, and its delivery status from the imported snapshots.</p>
    </header>

    @if (!_loaded) { <p role="status">Loading delivery projects…</p> }
    else if (_error is not null) { <p class="do-error" role="alert">@_error</p> }
    else if (_projects.Count == 0)
    {
        <section class="do-card" data-testid="do-no-project">
            <h2>No delivery project yet</h2>
            <p>Create a delivery project and import a snapshot (ZIP or Azure DevOps) in <a href="delivery-reporting">Delivery Reports</a>.</p>
        </section>
    }
    else
    {
        <div class="do-toolbar">
            <label class="do-field"><span>Delivery project</span>
                <select data-testid="do-project" value="@_projectId" @onchange="OnProjectChanged">
                    @foreach (var p in _projects) { <option value="@p.Id">@p.Name</option> }
                </select>
            </label>
        </div>

        @if (_loadingProject) { <p role="status">Loading the backlog…</p> }
        else if (_view is null)
        {
            <section class="do-card" data-testid="do-no-snapshot">
                <h2>No snapshot imported</h2>
                <p>Import a repository snapshot for this project in <a href="@($"delivery-reporting?project={_projectId}&tab=snapshots")">Delivery Reports</a>.</p>
            </section>
        }
        else if (_report is not null && FeatureQuery is { Length: > 0 } feature && _report.Stories.Any(s => s.FeatureKey == feature))
        {
            <BirkNext.Web.Components.DeliveryFeatureExplorer @key="_report.ReportId" Report="_report" ProjectName="@(_projects.FirstOrDefault(p => p.Id == _projectId)?.Name ?? "")"
                OpenFeatureKey="@feature" OnClose="CloseFeature" />
        }
        else
        {
            var view = _view;
            var header = DeliveryDashboard.Header(view, _report, _projects.FirstOrDefault(p => p.Id == _projectId)?.Name ?? "");
            <section class="dd-header" data-testid="dd-header" aria-label="Comparison context">
                <h2 class="dd-title">@header.Title</h2>
                <dl class="dd-context">
                    <div><dt>Current snapshot</dt><dd data-testid="dd-current-label">@header.CurrentLabel</dd></div>
                    @if (header.BaselineLabel is { } baseline) { <div><dt>Baseline</dt><dd>@baseline</dd></div> }
                    <div><dt>Coverage</dt><dd data-testid="dd-coverage">@header.Coverage</dd></div>
                </dl>
                <p class="dd-badges">
                    @if (header.SameDay) { <span class="dd-badge dd-tone-review" data-testid="dd-same-day"><span aria-hidden="true">◷ </span>Same-day comparison</span> }
                    @if (header.OrderUnconfirmed) { <span class="dd-badge dd-tone-review" data-testid="dd-order" title="Both snapshots have the same effective date; which one is later cannot be confirmed from dates.">Order not confirmable from dates</span> }
                </p>
                <p class="do-muted do-source" data-testid="do-source">
                    @(view.Source.Kind == "report" ? $"From report {view.Source.WeekLabel}" : "From the newest snapshot (no report yet)") ·
                    current snapshot “@view.Source.SnapshotLabel” of @P.Day(view.Source.EffectiveAt) · <span data-testid="do-provenance">@DeliveryBacklog.Provenance(view.Source)</span>
                </p>
            </section>

            <h3 class="dd-h" id="dd-current-h">Current delivery state</h3>
            <ul class="dd-kpis" aria-labelledby="dd-current-h" data-testid="dd-current">
                @foreach (var k in DeliveryDashboard.Current(view))
                {
                    <li class="dd-kpi dd-tone-@DeliveryDashboard.ToneClass(k.Tone)" data-testid="dd-kpi" data-key="@k.Key" title="@k.Info">
                        <span class="dd-kpi-value">@k.Value</span>
                        <span class="dd-kpi-label">@k.Label@if (k.Info is { } info) { <span class="dd-info" aria-label="@info" tabindex="0">ⓘ</span> }</span>
                        <span class="dd-kpi-detail">@k.Detail</span>
                    </li>
                }
            </ul>

            <div class="dd-grid">
                @{ var total = view.Items.Sum(i => i.TasksTotal); var done = view.Items.Sum(i => i.TasksCompleted); }
                <section class="dd-card" aria-labelledby="dd-checklist-h" data-testid="dd-checklist">
                    <h3 class="dd-card-h" id="dd-checklist-h">Task checklist</h3>
                    @if (total == 0) { <p class="do-muted">No tasks.md checkboxes in this snapshot.</p> }
                    else
                    {
                        <div class="dd-donut-wrap">
                            <svg class="dd-donut" viewBox="0 0 100 100" role="img" aria-label="@($"{done} of {total} tasks checked, {total - done} open")">
                                <title>@DeliveryDashboard.ChecklistInfo</title>
                                <circle cx="50" cy="50" r="40" class="dd-donut-track" />
                                <circle cx="50" cy="50" r="40" class="dd-donut-value" stroke-dasharray="@($"{251.33 * done / total:0.##} 251.33")" transform="rotate(-90 50 50)" />
                                <text x="50" y="54" text-anchor="middle" class="dd-donut-text">@(100 * done / total)%</text>
                            </svg>
                            <ul class="dd-legend">
                                <li><span class="dd-swatch dd-tone-progress" aria-hidden="true"></span>@done checked</li>
                                <li><span class="dd-swatch dd-tone-neutral" aria-hidden="true"></span>@(total - done) open</li>
                            </ul>
                        </div>
                        <p class="do-muted dd-note" data-testid="dd-checklist-note">@DeliveryDashboard.ChecklistInfo</p>
                    }
                </section>
                <section class="dd-card" aria-labelledby="dd-status-h" data-testid="dd-status">
                    <h3 class="dd-card-h" id="dd-status-h">Features by checklist state</h3>
                    @Bars(DeliveryDashboard.FeatureStatus(view), "dd-status-bar")
                    <p class="do-muted dd-note">Statuses come from task checkboxes and explicit status lines only — no workflow state is inferred.</p>
                </section>
            </div>

            @if (_report is not null)
            {
                <h3 class="dd-h" id="dd-change-h">Change this period <span class="do-muted">compared with the baseline</span></h3>
                <div class="dd-grid">
                    <section class="dd-card" aria-label="Feature changes" data-testid="dd-change-features"><h3 class="dd-card-h">Features</h3>@Bars(DeliveryDashboard.FeatureChanges(_report), "dd-change-bar")</section>
                    <section class="dd-card" aria-label="Task changes" data-testid="dd-change-tasks"><h3 class="dd-card-h">Tasks</h3>@Bars(DeliveryDashboard.TaskChanges(_report), "dd-change-bar")</section>
                </div>
            }

            <div class="dd-grid">
                <section class="dd-card" aria-labelledby="dd-quality-h" data-testid="dd-quality">
                    <h3 class="dd-card-h" id="dd-quality-h">Quality &amp; readiness</h3>
                    <ul class="dd-quality">
                        @foreach (var q in DeliveryDashboard.Quality(view))
                        {
                            <li data-testid="dd-quality-row" data-key="@q.Key" title="@q.Detail">
                                <span class="dd-q-label">@q.Label</span>
                                <span class="dd-q-track" aria-hidden="true">@if (q.Filled is { } f && q.Of is > 0 and var of) { <span class="dd-q-fill dd-tone-@DeliveryDashboard.ToneClass(q.Tone)" style="width:@(100 * f / of)%"></span> }</span>
                                <span class="dd-badge dd-tone-@DeliveryDashboard.ToneClass(q.Tone)" data-testid="dd-quality-state">@q.State</span>
                                <span class="dd-q-detail do-muted">@q.Detail</span>
                            </li>
                        }
                    </ul>
                </section>
                <section class="dd-card" aria-labelledby="dd-attention-h" data-testid="dd-attention">
                    <h3 class="dd-card-h" id="dd-attention-h">Needs attention</h3>
                    @if (_report is null) { <p class="do-muted">Generate a report to see scope changes and traceability issues.</p> }
                    else if (DeliveryDashboard.Attention(_report) is { Count: 0 }) { <p class="do-muted" data-testid="dd-attention-none">No attention items. Shared &amp; foundational tasks are normal and never listed here.</p> }
                    else
                    {
                        @foreach (var g in DeliveryDashboard.Attention(_report))
                        {
                            <details class="dd-att-group" data-testid="dd-attention-group" data-category="@g.Category">
                                <summary><strong>@g.Label</strong> <span class="dd-badge dd-tone-@(g.Items.Any(i => i.Severity == DeliveryAttentionSeverity.Blocker) ? "blocker" : "review")">@g.Items.Count</span></summary>
                                <ul class="dd-att-list">@foreach (var a in g.Items.Take(20)) { <li><strong>@a.Title</strong> — @a.Detail</li> }</ul>
                                @if (g.Items.Count > 20) { <p class="do-muted">+@(g.Items.Count - 20) more in the report</p> }
                            </details>
                        }
                    }
                </section>
            </div>
            <p class="do-muted dd-trend" data-testid="dd-trend">Trend available after more delivery snapshots — a baseline and a current snapshot are two points, not a trend.</p>

            <div class="do-toolbar" role="group" aria-label="Filter features">
                <label class="do-field"><span>Search</span><input type="search" data-testid="do-search" @bind="_search" @bind:event="oninput" placeholder="Feature or module" /></label>
                @if (view.Items.Select(i => i.Module).Distinct().Count() > 1)
                {
                    <label class="do-field"><span>Module</span>
                        <select data-testid="do-module" @bind="_module">
                            <option value="">All modules</option>
                            @foreach (var m in view.Items.Select(i => i.Module).Distinct().Order(StringComparer.OrdinalIgnoreCase)) { <option value="@m">@(m.Length == 0 ? "Project" : m)</option> }
                        </select></label>
                }
                <label class="do-field"><span>State</span>
                    <select data-testid="do-filter" @bind="_status">
                        <option value="@AllFilter">All states</option>
                        @foreach (var st in Enum.GetValues<BacklogStatus>().Where(x => !DeliveryBacklog.NotFromSnapshots(x))) { <option value="@st">@DeliveryBacklog.Label(st)</option> }
                    </select></label>
                <label class="do-field"><span>Attention</span>
                    <select data-testid="do-attention" @bind="_attention">
                        <option value="@AllFilter">All features</option>
                        <option value="attention">Needs attention</option>
                        <option value="open">Has open tasks</option>
                    </select></label>
            </div>

            var keys = Filtered(view).Select(i => i.FeatureKey).ToHashSet(StringComparer.Ordinal);
            var rows = DeliveryDashboard.Rows(view, _report).Where(r => keys.Contains(r.Item.FeatureKey)).ToList();
            <p class="do-muted" role="status" data-testid="do-count">@rows.Count of @view.Items.Count features shown · blocked, needs review, new and changed first</p>
            <ul class="dd-features" data-testid="do-backlog" aria-label="Features">
                @foreach (var r in rows)
                {
                    var item = r.Item;
                    var key = item.FeatureKey;
                    var pct = item.TasksTotal == 0 ? 0 : 100 * item.TasksCompleted / item.TasksTotal;
                    <li data-testid="do-item" data-status="@item.Status">
                        <button type="button" class="dd-feature" data-testid="do-feature-open" disabled="@(_report is null)" @onclick="() => OpenFeature(key)">
                            <span class="dd-f-title"><strong>@item.Title</strong><span class="dd-f-id">@DeliveryWorkItems.FeatureSourceId(key) · @(item.Module.Length == 0 ? "Project" : item.Module)</span></span>
                            <span class="dd-f-progress" title="Task checklist only">
                                @if (item.TasksTotal == 0) { <span class="do-muted">No tasks</span> }
                                else
                                {
                                    <span class="dd-bar" aria-hidden="true"><span class="dd-bar-fill" style="width:@(pct)%"></span></span>
                                    <span data-testid="do-tasks">@item.TasksCompleted / @item.TasksTotal · @(pct)% · @item.OpenTasks open</span>
                                }
                            </span>
                            <span class="dd-f-model" data-testid="do-model">@r.RequirementModel</span>
                            <span class="dd-badge dd-tone-@DeliveryDashboard.ToneClass(r.ChangeTone)" data-testid="do-change">@r.Change</span>
                            <span class="dd-f-attention" data-testid="do-attention-cell">@if (item.Attention > 0) { <span class="dd-badge dd-tone-review" data-testid="do-attention-count">@item.Attention issue@(item.Attention == 1 ? "" : "s")</span> } else { <span class="do-muted">No issues</span> }</span>
                        </button>
                    </li>
                }
            </ul>
            @if (rows.Count == 0) { <p class="do-muted" data-testid="do-empty-filter">No feature matches these filters.</p> }
            @if (view.RemovedFeatures.Count > 0)
            {
                <p class="do-muted" data-testid="do-removed">Removed this period (scope change to confirm, not counted as delivered): @string.Join(", ", view.RemovedFeatures)</p>
            }
            <p class="do-links">
                @if (view.Source.ReportId is { } reportId)
                {
                    <a href="@($"delivery-reporting?project={_projectId}&tab=stories&report={reportId}")" data-testid="do-open-report">Open the report (stories, criteria, tasks and changes)</a>
                }
                else { <a href="@($"delivery-reporting?project={_projectId}")">Generate a report to see user stories, acceptance criteria, phases and baseline changes</a> }
            </p>
        }
    }
</div>

@code {
    private const string AllFilter = "all";
    [SupplyParameterFromQuery(Name = "project")] public string? ProjectQuery { get; set; }
    [SupplyParameterFromQuery(Name = "feature")] public string? FeatureQuery { get; set; }

    private bool _loaded, _loadingProject;
    private string? _error;
    private List<DeliveryProject> _projects = [];
    private Guid? _projectId;
    private DeliveryBacklogView? _view;
    private WeeklyDeliveryReport? _report;
    private string _status = AllFilter, _module = "", _search = "", _attention = AllFilter;

    protected override async Task OnParametersSetAsync()
    {
        if (!_loaded)
        {
            var (projects, error) = await Api.ProjectsAsync();
            _projects = projects;
            _error = error;
            _loaded = true;
        }
        var requested = Guid.TryParse(ProjectQuery, out var p) && _projects.Any(x => x.Id == p) ? p : _projects.FirstOrDefault()?.Id;
        if (requested != _projectId) { _projectId = requested; await LoadAsync(); }
    }

    /// <summary>The backlog of the chosen delivery project only: its newest report, else its newest snapshot. Never another project's data.</summary>
    private async Task LoadAsync()
    {
        _view = null; _report = null;
        if (_projectId is not { } id) return;
        _loadingProject = true;
        try
        {
            var reports = await Api.ReportsAsync(id);
            if (reports.OrderByDescending(r => r.GeneratedAt).FirstOrDefault() is { } newest && await Api.ReportAsync(id, newest.Id) is { } report && report.ProjectId == id)
            {
                _report = report;
                _view = DeliveryBacklog.FromReport(report);
            }
            else if ((await Api.SnapshotsAsync(id)).OrderByDescending(s => s.EffectiveAt).FirstOrDefault() is { } snapshot && await Api.SnapshotAsync(id, snapshot.Id) is { } detail)
                _view = DeliveryBacklog.FromSnapshot(detail);
        }
        finally { _loadingProject = false; }
    }

    private IReadOnlyList<BacklogItem> Filtered(DeliveryBacklogView view)
    {
        IEnumerable<BacklogItem> items = view.Items;
        if (Enum.TryParse<BacklogStatus>(_status, out var status)) items = items.Where(i => i.Status == status);
        if (_module.Length > 0) items = items.Where(i => i.Module == _module);
        if (_search.Length > 0) items = items.Where(i => i.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) || i.Module.Contains(_search, StringComparison.OrdinalIgnoreCase));
        if (_attention == "attention") items = items.Where(i => i.Attention > 0);
        else if (_attention == "open") items = items.Where(i => i.OpenTasks > 0);
        // Order is the dashboard priority (DeliveryDashboard.Rows): blocked, needs review, new, changed, in progress, then the rest.
        var list = items.ToList();
        return list;
    }


    /// <summary>Horizontal bars of one unit (features or tasks), each with a label, count and its meaning as tooltip; scaled within the group.</summary>
    private static RenderFragment Bars(IReadOnlyList<DeliveryBar> bars, string testId) => __builder =>
    {
        var max = Math.Max(1, bars.Select(b => Math.Abs(b.Value)).DefaultIfEmpty(1).Max());
        <ul class="dd-bars">
            @foreach (var b in bars)
            {
                <li data-testid="@testId" data-key="@b.Key" title="@b.Info">
                    <span class="dd-bar-label">@b.Label</span>
                    <span class="dd-bar" aria-hidden="true"><span class="dd-bar-fill dd-tone-@DeliveryDashboard.ToneClass(b.Tone)" style="width:@(100 * Math.Abs(b.Value) / max)%"></span></span>
                    <span class="dd-bar-value">@(b.Value > 0 && b.Key == "net-checked" ? "+" : "")@b.Value</span>
                </li>
            }
        </ul>
    };

    private void ToggleStatus(BacklogStatus status) => _status = _status == status.ToString() ? AllFilter : status.ToString();

    private void OpenFeature(string key) => Nav.NavigateTo($"delivery-overview?project={_projectId}&feature={Uri.EscapeDataString(key)}");

    private void CloseFeature() => Nav.NavigateTo($"delivery-overview?project={_projectId}");

    private void OnProjectChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id)) Nav.NavigateTo($"delivery-overview?project={id}");
    }
}
