@page "/extensions/skolenaervaer"
@using BirkNext.Integrations
@using BirkNext.Web.Components
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@implements IDisposable
@inject IFrontendAnalysisContextFactory ContextFactory
@inject IIntegrationCatalogApiService IntegrationApi
@inject IWorkspaceSessionService Workspace
@inject NavigationManager Navigation
@inject IServiceProvider Services
@inject IJSRuntime JS

<PageTitle>Skolenærvær Testing</PageTitle>

@* The Skolenærvær test pack's page in four areas (Overview, Journeys, Verify, History), rendered from its generic descriptor (journeys, verification views, rules,
   history). One navigation only (?tab=). Readiness, blockers and evidence are the shared engines' own (Integration Journey, Active Event,
   Message Verification, Integration Topology, Test Data); this page summarizes them and hands off to their owners — it embeds no other
   feature's navigation. Source evidence is the canonical Integration Quality Review binding; nothing is selected, run or assessed here. *@
<div class="snt-page">
    <PageHeader Title="Skolenærvær Testing"
                Description="Review readiness, run Skolenærvær test journeys, and verify evidence across the integration flow." />

    @* Four areas from the pack's navigation groups (Overview, Journeys, Verify, History). An area with several views has its own secondary
       navigation; every view keeps its ?tab= id, so older deep links still open the same view. *@
    <nav class="snt-nav" aria-label="Skolenærvær Testing areas" data-testid="snt-nav">
        @foreach (var group in Navigation_)
        {
            var active = CurrentGroup == group;
            var first = group.Views[0].ViewId;
            <a href="@TabHref(first)" class="snt-tab @(active ? "snt-tab-active" : "")" aria-current="@(active ? "page" : null)"
               data-testid="snt-area" data-area="@group.Label" data-tab="@first" @onclick="() => SelectTabAsync(first)" @onclick:preventDefault>@group.Label</a>
        }
    </nav>
    @if (CurrentGroup is { Views.Count: > 1 } area)
    {
        <nav class="snt-subnav" aria-label="@($"{area.Label} views")" data-testid="snt-subnav">
            @foreach (var (caption, views) in SubnavSections(area))
            {
                <span class="snt-subnav-section" role="group" aria-label="@(caption ?? area.Label)" data-testid="snt-subnav-section">
                    @if (caption is not null) { <span class="snt-subnav-caption" aria-hidden="true">@caption</span> }
                    @foreach (var view in views)
                    {
                        <a href="@TabHref(view.ViewId)" class="snt-subtab @(_tab == view.ViewId || CurrentView == view ? "snt-subtab-active" : "")" aria-current="@(CurrentView == view ? "page" : null)"
                           data-testid="snt-subtab" data-tab="@view.ViewId" @onclick="() => SelectTabAsync(view.ViewId)" @onclick:preventDefault>@view.DisplayName</a>
                    }
                </span>
            }
        </nav>
    }

    @if (CurrentView is { Kind: TestPackViewKind.Overview })
    {
        <section id="snt-overview" class="snt-panel" aria-labelledby="snt-overview-heading">
            <h2 id="snt-overview-heading" tabindex="-1">Overview</h2>
            <dl class="snt-context" data-testid="snt-context">
                <div><dt>Target environment</dt><dd data-testid="snt-target">@(_profile is null ? "Not selected · execution not ready" : string.IsNullOrWhiteSpace(_profile.Name) ? _profile.Id : _profile.Name)</dd></div>
                @if (Workspace.ProjectName is { } project) { <div><dt>Project workspace</dt><dd data-testid="snt-workspace">@project</dd></div> }
                <div><dt>Source evidence</dt><dd data-testid="snt-source">Provided by Integration Quality Review bindings · @_sourceSummary @if (_profile is not null) { <a href="integration-quality-review?view=setup-evidence" class="snt-inline-link">Open evidence</a> }</dd></div>
                @if (_profile is not null && _pack is not null)
                {
                    <div><dt>Active execution</dt><dd data-testid="snt-active-execution">@TestPackPresentation.ActiveExecution(_pack)
                        @if (!_pack.EnvironmentTrusted) { <a href="@TestPackPresentation.ExecutionSettingsHref" class="snt-inline-link" data-testid="snt-execution-settings">Manage active execution</a> }</dd></div>
                }
            </dl>

            @if (_guidance is { } guidance && guidance.Sources.Count > 0)
            {
                <section class="snt-summary-card" aria-labelledby="snt-source-requirements-heading" data-testid="snt-source-requirements">
                    <h3 class="snt-subheading" id="snt-source-requirements-heading">Source evidence</h3>
                    <ul class="snt-source-summary" data-testid="snt-source-summary-list">
                        @foreach (var source in guidance.Sources.OrderBy(BirkNext.Web.Services.ProjectImport.SourceSetupPresentation.Order))
                        {
                            var optional = source.Role.Provider == TestPackSourceProvider.ImportedSource && source.Role.Requirement != TestPackSourceRequirement.Required;
                            <li class="snt-source-summary-item @(optional ? "is-optional" : "")" data-testid="snt-source-summary" data-role="@source.Role.Key">
                                <span class="snt-source-name">@source.Role.Label@if (optional) { <span class="snt-muted"> · optional</span> }</span>
                                <span class="snt-pill snt-pill-@SourceGuidancePresentation.SourceStateTone(source.State)" data-testid="snt-source-summary-state">@SourceSummaryLabel(source)</span>
                            </li>
                        }
                    </ul>
                    <ReviewDisclosure Text="View source setup" CollapseText="Hide source setup" TestId="snt-source-setup-details" Class="disclosure-inline">
                        <ul class="snt-source-cards" data-testid="snt-source-setup" aria-label="Logical sources">
                            @foreach (var source in guidance.Sources)
                            {
                                var href = SourceGuidancePresentation.ActionHref(source.NextActionTarget);
                                <li class="snt-source-card" data-testid="snt-source-card" data-role="@source.Role.Key" data-state="@source.State">
                                    <div class="snt-source-card-head"><strong>@source.Role.Label</strong>
                                        <span class="snt-pill snt-pill-@SourceGuidancePresentation.SourceStateTone(source.State)" data-testid="snt-source-state">@SourceGuidancePresentation.SourceStateLabel(source)</span></div>
                                    <p class="snt-source-line" data-testid="snt-source-archive">@(source.Role.Provider == TestPackSourceProvider.TestPackReference
                                        ? source.State == TestPackSourceState.ReferenceAvailable ? $"Built-in {source.Reference?.Kind ?? "reference"} reference · no separate import required" : "Reference could not be loaded"
                                        : source.BoundArchives.Count > 0 ? $"Source: {string.Join(", ", source.BoundArchives)}"
                                        : source.AvailableArchives.Count > 0 ? $"Available: {string.Join(", ", source.AvailableArchives)}" : $"Expected: {source.Role.ExpectedArtifact}")</p>
                                    <p class="snt-source-line snt-muted">Used for: @string.Join(", ", source.Role.Capabilities)</p>
                                    @if (source.State != TestPackSourceState.Bound && href is not null)
                                    {
                                        <a class="snt-inline-link" href="@href" data-testid="snt-source-action">@source.NextAction</a>
                                    }
                                </li>
                            }
                        </ul>
                    </ReviewDisclosure>
                </section>
            }
            @if (_guidance is { Suggestions.Count: > 0 } configuration)
            {
                var known = configuration.Suggestions.Count(item => item.ResolvedValue is not null);
                <section class="snt-summary-card" aria-labelledby="snt-configuration-heading" data-testid="snt-configuration">
                    <h3 class="snt-subheading" id="snt-configuration-heading">Configuration</h3>
                    @* Known values are one fact; integration coverage and execution are separate — "9/9 known" never reads as ready. *@
                    <dl class="snt-config-facts" data-testid="snt-config-facts">
                        <div><dt>Configuration values</dt><dd data-testid="snt-config-known">@known of @configuration.Suggestions.Count known@if (configuration.Suggestions.Count - known > 0) { <span> · @(configuration.Suggestions.Count - known) need attention</span> }</dd></div>
                        <div><dt>Integration coverage</dt><dd data-testid="snt-config-integrations">@IntegrationCoverage</dd></div>
                        <div><dt>Execution configuration</dt><dd data-testid="snt-config-execution">@ExecutionConfiguration</dd></div>
                    </dl>
                    <ReviewDisclosure Text="View provenance" CollapseText="Hide provenance" TestId="snt-config-provenance" Class="disclosure-inline">
                        <p class="snt-muted" data-testid="snt-source-requirements-summary">@GuidanceSummary(configuration) Runtime verification is separate.</p>
                    </ReviewDisclosure>
                    <ReviewDisclosure Text="@($"View {configuration.Suggestions.Count} source requirements")" CollapseText="Hide source requirements" TestId="snt-source-values" Class="disclosure-inline">
                        <SourceGuidanceList Suggestions="configuration.Suggestions" TestId="snt-source-guidance" Label="Source requirements" />
                    </ReviewDisclosure>
                </section>
            }

            @if (_pack is not null && Journeys.Select(j => View(j.JourneyId)).OfType<IntegrationJourneyView>().ToList() is { Count: > 0 } setupViews)
            {
                @* Guided Setup: progress per journey from the authoritative readiness (nothing stored); Continue resumes at the first unresolved step. *@
                var setups = setupViews.Select(v => JourneySetupModel.Build(PackId, v)).ToList();
                var firstOpen = setups.FirstOrDefault(s => !s.SetupComplete);
                <section class="snt-summary-card" aria-labelledby="snt-setup-heading" data-testid="snt-journey-setup">
                    <h3 class="snt-subheading" id="snt-setup-heading">Journey setup</h3>
                    <ul class="snt-plain" data-testid="snt-setup-progress">
                        @foreach (var setup in setups)
                        {
                            <li data-testid="snt-setup-journey" data-journey="@setup.JourneyId" data-complete="@(setup.SetupComplete ? "true" : "false")">@setup.JourneyName · @setup.RequiredReady/@setup.RequiredSteps ready
                                <a class="snt-link" href="@SetupHref(setup.JourneyId)" data-testid="snt-setup-prepare" aria-label="@($"Prepare {setup.JourneyName}")">Prepare @setup.JourneyName</a></li>
                        }
                    </ul>
                    <div class="snt-actions">
                        @if (firstOpen is not null) { <a class="btn-primary" href="@SetupHref(firstOpen.JourneyId)" data-testid="snt-setup-continue">Continue setup</a> }
                        <button type="button" class="btn-secondary" data-testid="snt-setup-import" @onclick="() => _profilePanel = SetupProfileMode.Import">Import setup profile</button>
                        <button type="button" class="btn-secondary" data-testid="snt-setup-export" @onclick="() => _profilePanel = SetupProfileMode.Export">Export safe setup</button>
                    </div>
                    @if (_profilePanel is { } mode && _profile is not null)
                    {
                        <SetupProfilePanel EnvironmentId="@_profile.Id" PackId="@PackId" Mode="mode" Closed="() => _profilePanel = null" Applied="ReloadAfterProfileAsync" />
                    }
                </section>
            }

            <h3 class="snt-subheading" id="snt-journeys-heading">Journeys</h3>
            @if (_pack is not null && JourneyReadinessPresentation.Attention(Journeys.Select(j => View(j.JourneyId)).OfType<IntegrationJourneyView>()) is var attention)
            {
                <div class="snt-attention-categories" data-testid="snt-attention-categories">
                    <p data-testid="snt-attention-summary"><strong>@JourneyReadinessPresentation.AttentionSummary(attention)</strong></p>
                    @if (attention.Count > 0)
                    {
                        <ul class="snt-attention-owner-list">
                            @foreach (var category in attention)
                            {
                                var href = JourneyReadinessPresentation.OwnerHref(category.OwnerKey, _profile?.Id);
                                <li data-testid="snt-attention-category" data-dimension="@category.Dimension">@category.Label (@category.Count: @string.Join(", ", category.Journeys)) — owner: @category.Owner@if (href is not null) { <text> · </text><a href="@href">@JourneyReadinessPresentation.OwnerAction(category.OwnerKey)</a> }</li>
                            }
                        </ul>
                    }
                </div>
            }
            @if (_initialized && _profile is null)
            {
                <p role="status" data-testid="snt-journeys-not-ready">Journey readiness is not available until a Target Environment is selected. Nothing has been run or assessed.</p>
            }
            <div class="snt-scroll" role="region" aria-labelledby="snt-journeys-heading">
                <table class="snt-table snt-stack" role="table" data-testid="snt-journeys">
                    <thead role="rowgroup"><tr role="row"><th role="columnheader" scope="col">Journey</th><th role="columnheader" scope="col">Integration</th><th role="columnheader" scope="col">Contract</th><th role="columnheader" scope="col">Test Data</th><th role="columnheader" scope="col">Execution</th><th role="columnheader" scope="col">Verification</th><th role="columnheader" scope="col">Attention</th><th role="columnheader" scope="col"><span class="visually-hidden">Action</span></th></tr></thead>
                    <tbody role="rowgroup">
                        @foreach (var journey in Journeys)
                        {
                            var view = View(journey.JourneyId);
                            var actions = view is null ? 0 : AttentionGroups(journey.JourneyId).Count;
                            <tr role="row" class="snt-journey-row" data-testid="snt-journey" data-journey="@journey.JourneyId">
                                <th role="rowheader" scope="row"><span class="snt-journey-name">@journey.DisplayName</span><span class="snt-flow">@journey.Flow</span></th>
                                <td role="cell" data-label="Integration" data-testid="snt-matrix-integration">@Dimension("Integration", view is null ? Unknown : MatrixValue(view, JourneyDimension.Integration, JourneyConfiguration(view)))
                                    @if (SourceGuidancePresentation.ForJourney(_guidance, journey.JourneyId) is { Count: > 0 } sources)
                                    {
                                        <span class="snt-journey-sources" data-testid="snt-journey-sources">Source: @string.Join(" · ", sources.Select(SourceGuidancePresentation.SourceShort))</span>
                                    }</td>
                                <td role="cell" data-label="Contract" data-testid="snt-matrix-contract">@Dimension("Contract", view is null ? Unknown : MatrixValue(view, JourneyDimension.Contracts, "Not assessed"))</td>
                                <td role="cell" data-label="Test Data" data-testid="snt-matrix-test-data">@Dimension("Test Data", view is null ? Unknown : MatrixValue(view, JourneyDimension.TestData, "Not assessed"))</td>
                                <td role="cell" data-label="Execution" data-testid="snt-journey-status">@Dimension("Execution readiness", view is null ? Unknown : TestPackPresentation.ExecutionReadiness(view))</td>
                                <td role="cell" data-label="Verification" data-testid="snt-matrix-verification">@Dimension("Verification", view is null ? Unknown : MatrixValue(view, JourneyDimension.Verification, "Not assessed"))
                                    @if (view is not null) { <span class="snt-journey-sources" data-testid="snt-matrix-assessment">Last run: @JourneyReadinessPresentation.AssessmentLabel(view.Assessment)</span> }</td>
                                <td role="cell" data-label="Attention" data-testid="snt-journey-blockers">@(view is null ? "—" : actions == 0 ? "None" : $"{actions} action{(actions == 1 ? "" : "s")}")</td>
                                <td role="cell"><a class="btn-secondary snt-open" href="@TabHref(journey.JourneyId)" @onclick="() => SelectTabAsync(journey.JourneyId)" @onclick:preventDefault
                                       aria-label="@($"Open {journey.DisplayName}")" data-testid="snt-journey-open">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Descriptor?.VerificationViews is { Count: > 0 } verifications)
            {
                <ul class="snt-verify-summary" data-testid="snt-verify-summary">
                    @foreach (var verification in verifications)
                    {
                        <li data-testid="snt-verify-item" data-view="@verification.ViewId"><span class="snt-dimension-label">@verification.DisplayName</span> @Dimension("Availability", VerificationAvailability(verification))
                            <a href="@TabHref(verification.ViewId)" @onclick="() => SelectTabAsync(verification.ViewId)" @onclick:preventDefault data-testid="snt-open-verify">Open Verify</a></li>
                    }
                </ul>
            }

            @if (_profile is not null)
            {
                <ReviewDisclosure Text="Expected topology" CollapseText="Hide expected topology" Hint="connections and what evidence each needs" TestId="snt-topology-details" Class="disclosure-inline">
                    <section class="snt-topology" aria-label="Expected topology" data-testid="snt-topology">
                        <TopologyPathsPanel EnvironmentId="@_profile.Id" ProfileId="skolenaervaer" Title="Expected topology" Compact="true"
                                            SourceHint="(from, to) => SourceGuidancePresentation.ConnectionHint(SourceGuidancePresentation.ForComponents(_guidance, from, to))" />
                    </section>
                </ReviewDisclosure>
            }
        </section>
    }
    else if (CurrentView is { Kind: TestPackViewKind.Journey, JourneyId: { } journeyId })
    {
        var journey = Journeys.FirstOrDefault(item => item.JourneyId == journeyId);
        var view = View(journeyId);
        <section id="@SectionId(journeyId)" class="snt-panel" aria-labelledby="@($"{SectionId(journeyId)}-heading")" data-testid="snt-journey-view" data-journey="@journeyId">
            <h2 id="@($"{SectionId(journeyId)}-heading")" tabindex="-1">@(journey?.DisplayName ?? journeyId)</h2>
            <p class="snt-flow" data-testid="snt-flow"><span class="snt-dimension-label">Flow</span> @(journey?.Flow ?? "")</p>
            @if (_profile is null)
            {
                <p role="status" data-testid="snt-not-ready">Not ready: select a Target Environment to load this journey's readiness. Nothing has been run or assessed.</p>
                <p><a class="btn-secondary" href="/admin/system-settings?section=target-environments">Open Target Environment</a></p>
            }
            else if (view is null)
            {
                <p class="snt-muted" role="status">@(!_initialized ? "Loading readiness…" : "Readiness is not available for this journey.")</p>
            }
            else
            {
                @JourneyStatus(view)
                @if (journeyId == PeriodeavslutningId)
                {
                    <div class="snt-operator" data-testid="snt-period-operator">
                        <p>Period closure is operator-controlled. BirkNext does not lock periods or publish the closure event.</p>
                        <ReviewDisclosure Text="Why?" CollapseText="Hide explanation" TestId="snt-period-why" Class="disclosure-inline">
                            <p>Skolenærværsrapport locks a period on its own schedule; its drift endpoint only postpones the lock, and an immediate trigger exists for local development only. BirkNext never locks a period or publishes the event.</p>
                        </ReviewDisclosure>
                        <p class="snt-muted" data-testid="snt-period-semantics">Service Bus accepted is not the same as Bufdata processed.</p>
                    </div>
                }
                @if (journeyId == RapportmottakId) { @RapportmottakHeader(view) }
                @if (view is not null)
                {
                    <ReviewDisclosure Text="@($"Prepare {journey?.DisplayName ?? journeyId}")" CollapseText="Hide setup" TestId="snt-prepare" Class="disclosure-inline" Expanded="@(SetupParam is not null)">
                        <JourneySetupPanel PackId="@PackId" View="view" ProfileId="@_profile?.Id" FocusNext="@(SetupParam == "continue")" />
                    </ReviewDisclosure>
                }
                @AttentionSummary(journeyId, view)
                @if (view.Journey.ExecutionMode == JourneyExecutionMode.DelegatedToActiveEvent)
                {
                    @* Hand-off: the shared Active Event tests own this journey's scenarios, safety checks, runs and history. *@
                    var blocked = TestPackPresentation.ExecutionReadiness(view) != "Ready";
                    <dl class="snt-handoff" data-testid="snt-handoff">
                        <div><dt>Execution provider</dt><dd data-testid="snt-provider">Shared Active Event Tests <span class="snt-muted">(@view.Journey.DelegatedProviderId)</span></dd></div>
                        <div><dt>Execution</dt><dd data-testid="snt-handoff-readiness">@(blocked ? "Blocked" : "Executable after confirmation")</dd></div>
                    </dl>
                    <p><a class="btn-secondary" href="/integration-quality-review?view=test-verify" data-testid="snt-open-active-tests">@(blocked ? "Review Active Event Tests setup" : "Open Active Event Tests")</a></p>
                    <p class="snt-muted">Scenarios run from Active Event Tests in Integration Quality Review; Event Hub configuration and safety checks are shared. Nothing runs from this page.</p>
                    @PrerequisiteDetails(view)
                }
                else
                {
                    @PrerequisiteDetails(view)
                    <div id="@($"{SectionId(journeyId)}-run")" class="snt-focus-target" tabindex="-1">
                        @if (journeyId == RapportmottakId)
                        {
                            <ReviewDisclosure Text="Rapportmottak run and steps" CollapseText="Hide Rapportmottak run" TestId="snt-rapport-run" @bind-Expanded="_runOpen">
                                <IntegrationJourneyPanel @ref="_journeys" Profile="_profile" PackId="@PackId" Embedded="true" ShowPrerequisites="false" InitialJourneyId="@journeyId" />
                            </ReviewDisclosure>
                        }
                        else
                        {
                            <ReviewDisclosure Text="Steps and expected outcomes" CollapseText="Hide steps" TestId="snt-steps" Class="disclosure-inline">
                                <IntegrationJourneyPanel Profile="_profile" PackId="@PackId" Embedded="true" ShowPrerequisites="false" InitialJourneyId="@journeyId" />
                            </ReviewDisclosure>
                        }
                    </div>
                    @if (journeyId == RapportmottakId) { @RapportmottakDetails(view) }
                }
            }
        </section>
    }
    else if (CurrentView is { Kind: TestPackViewKind.Verification } verificationView)
    {
        <section id="snt-verification" class="snt-panel" aria-labelledby="snt-verification-heading">
            <h2 id="snt-verification-heading" tabindex="-1">@verificationView.DisplayName</h2>
            <p class="snt-muted"><span class="snt-dimension-label">Runtime verification</span> What actually happened to one message, from evidence that already exists: BirkNext's run history and, where approved, MM's and Skoletjenesten's telemetry. Read-only: nothing is sent.</p>
            @if (_profile is null)
            {
                <div class="snt-empty" role="status" data-testid="snt-verification-not-ready">
                    <p><strong>Not ready:</strong> select a Target Environment to verify a message. Nothing has been read.</p>
                    <p><a class="btn-secondary" href="/admin/system-settings?section=target-environments">Open Target Environments</a></p>
                </div>
            }
            else
            {
                <MessageVerificationPanel EnvironmentId="@_profile.Id" />
            }
        </section>
    }
    else if (CurrentView is { Kind: TestPackViewKind.Rules })
    {
        <section id="snt-rules" class="snt-panel" aria-labelledby="snt-rules-heading">
            <h2 id="snt-rules-heading" tabindex="-1">Architecture Rules</h2>
            <p class="snt-muted"><span class="snt-dimension-label">Source-based checks</span> Each rule is assessed only on Source Analysis dependency evidence from the logical source it needs, bound in Integration Quality Review. No evidence is Not assessed, never a pass.</p>
            @if (_profile is null)
            {
                <p role="status" data-testid="snt-rules-not-ready">Not assessed: select a Target Environment and bind source evidence.</p>
            }
            else if (_rules is { } report)
            {
                var root = RulesRootCause(report);
                @if (root is { } cause)
                {
                    <div class="snt-summary-card" data-testid="snt-rules-summary">
                        <p><strong data-testid="snt-rules-summary-count">@cause.Count rule@(cause.Count == 1 ? "" : "s") cannot be assessed</strong></p>
                        <p data-testid="snt-rules-summary-reason">Reason: @cause.Reason</p>
                        @if (cause.Matches.Count > 0) { <p class="snt-muted" data-testid="snt-rules-summary-matches">Matching sources: @string.Join(", ", cause.Matches)</p> }
                        <p><a class="btn-primary" href="@cause.ActionHref" data-testid="snt-rules-summary-action">@cause.ActionLabel</a></p>
                    </div>
                }
                <p class="snt-muted" data-testid="snt-rules-provenance">Evidence source: @(report.SourceArchive is { } archive ? $"Source Analysis snapshot {archive}"
                    : report.RuleSources.Count > 0 ? "per rule — the bound snapshot of the source each rule needs" : "none — no Source Analysis snapshot is bound in Integration Quality Review → Evidence")</p>
                @if (report.Limitations.Count > 0) { <ul class="snt-notes" data-testid="snt-rules-limitations">@foreach (var item in report.Limitations) { <li>@item</li> }</ul> }
                <ReviewDisclosure Text="@($"View {(root is null ? "" : "affected ")}rules ({report.Findings.Count})")" CollapseText="Hide rules" TestId="snt-rules-details" Class="disclosure-inline" Expanded="@(root is null)">
                    <div class="snt-scroll" role="region" tabindex="0" aria-label="Architecture rule results">
                        <table class="snt-table snt-stack" role="table" data-testid="snt-rule-results">
                            <thead role="rowgroup"><tr role="row"><th role="columnheader" scope="col">Rule</th><th role="columnheader" scope="col">Required source</th><th role="columnheader" scope="col">Evidence</th><th role="columnheader" scope="col">Assessment</th><th role="columnheader" scope="col">Reason</th></tr></thead>
                            <tbody role="rowgroup">
                                @foreach (var finding in report.Findings)
                                {
                                    <tr role="row" data-testid="snt-rule" data-rule="@finding.RuleId" data-outcome="@finding.Outcome">
                                        <th role="rowheader" scope="row">@finding.Title</th>
                                        <td role="cell" data-label="Required source" data-testid="snt-rule-source">@RuleSource(report, finding)</td>
                                        <td role="cell" data-label="Evidence" data-testid="snt-rule-evidence">@RuleEvidence(report, finding)</td>
                                        <td role="cell" data-label="Assessment"><span class="snt-pill snt-pill-@IntegrationJourneyPresentation.RuleTone(finding.Outcome)" data-testid="snt-rule-assessment">@IntegrationJourneyPresentation.Rule(finding.Outcome)</span></td>
                                        <td role="cell" data-label="Reason" data-testid="snt-rule-reason">@finding.Detail</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </ReviewDisclosure>
            }
            else
            {
                <p class="snt-muted" role="status">@(_rulesError ?? "Loading rule results…")</p>
            }
        </section>
    }
    else if (CurrentView is { Kind: TestPackViewKind.Security } securityView)
    {
        <section id="snt-security" class="snt-panel" aria-labelledby="snt-security-heading" data-testid="snt-security">
            <h2 id="snt-security-heading" tabindex="-1">@securityView.DisplayName</h2>
            <p class="snt-muted">@securityView.Description Shared requirements come from the one Security Classification review; the Skolenærvær rules below are this extension's own. Nothing runs from this page.</p>
            @if (_profile is null)
            {
                <p role="status" data-testid="snt-security-not-ready">Not available until a Target Environment is selected.</p>
            }
            else
            {
                <SecurityConsumerProjection EnvironmentId="@_profile.Id" ConsumerId="@PackId" />
            }
        </section>
    }
    else if (CurrentView is { Kind: TestPackViewKind.History })
    {
        <section id="snt-history" class="snt-panel" aria-labelledby="snt-history-heading">
            <h2 id="snt-history-heading" tabindex="-1">History</h2>
            @if (_profile is null)
            {
                <p role="status">Not available until a Target Environment is selected. Nothing has been run.</p>
            }
            else
            {
                <p class="snt-muted">Runs of this pack's journeys from the shared journey history. Utdanningsdata runs are kept by the Active Event tests.</p>
                <IntegrationJourneyPanel Profile="_profile" PackId="@PackId" Embedded="true" InitialJourneyId="history" />
            }
        </section>
    }
</div>

@code {
    private const string PackId = "skolenaervaer";
    private const string RapportmottakId = "rapportmottak";
    private const string PeriodeavslutningId = "periodeavslutning";
    private const string NotLoaded = "Loading";
    /// <summary>A dimension without a journey view: still loading, Not ready without a Target Environment, else Not available.</summary>
    private string Unknown => !_initialized ? NotLoaded : _profile is null ? "Not ready" : "Not available";

    /// <summary>The section to show (?tab=); anything the pack does not declare is the Overview.</summary>
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }
    /// <summary>?setup=continue opens a journey's Guided Setup at its first unresolved step.</summary>
    [SupplyParameterFromQuery(Name = "setup")] public string? SetupParam { get; set; }
    private SetupProfileMode? _profilePanel;
    private string SetupHref(string journeyId) => $"{TabHref(journeyId)}&setup=continue";

    /// <summary>After applying a setup profile everything is recomputed from the owners (nothing is cached from the profile).</summary>
    private async Task ReloadAfterProfileAsync()
    {
        if (_profile is null || Services.GetService<IIntegrationJourneysApiService>() is not { } journeys) return;
        try
        {
            _pack = (await journeys.PacksAsync(_profile.Id, _disposed.Token)).Value?.FirstOrDefault(pack => pack.PackId == PackId) ?? _pack;
            _guidance = (await journeys.SourceGuidanceAsync(_profile.Id, PackId, _disposed.Token)).Value is { } fresh ? SourceGuidancePresentation.Resolved(fresh) : _guidance;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { }
    }

    private readonly CancellationTokenSource _disposed = new();
    private FrontendAnalysisProfile? _profile;
    private string _sourceSummary = "Not available";
    private TestPackSourceGuidance? _guidance;
    private BirkNext.SourceDomains.SourceConfigurationApplyResult? _applyResult;
    private string? _applyError;
    private bool _applying;

    /// <summary>Values the bound source declares that are safe to store into empty fields (an explicit action; never over a stored value).</summary>
    private IReadOnlyList<BirkNext.SourceDomains.SourceConfigurationSuggestion> ApplicableSourceValues =>
        _guidance?.Suggestions.Where(SourceGuidancePresentation.Applicable).ToList() ?? [];

    private async Task ApplySourceValuesAsync()
    {
        if (_profile is null || Services.GetService<IIntegrationJourneysApiService>() is not { } journeys) return;
        _applying = true; _applyError = null;
        try
        {
            var result = await journeys.ApplySourceGuidanceAsync(_profile.Id, PackId, _disposed.Token);
            _applyResult = result.Value;
            _applyError = result.Value is null ? result.Error ?? "The values could not be applied." : null;
            if (result.Value is { Applied.Count: > 0 })
            {
                _pack = (await journeys.PacksAsync(_profile.Id, _disposed.Token)).Value?.FirstOrDefault(pack => pack.PackId == PackId) ?? _pack;
                _guidance = (await journeys.SourceGuidanceAsync(_profile.Id, PackId, _disposed.Token)).Value is { } fresh ? SourceGuidancePresentation.Resolved(fresh) : _guidance;
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { _applyError = "The values could not be applied."; }
        finally { _applying = false; }
    }

    /// <summary>"6 values: 4 suggested from bound source · 1 conflict …" — every state in words.</summary>
    private static string GuidanceSummary(TestPackSourceGuidance guidance)
    {
        // One resolution for every page: a value known from its owner, the bound source, the reference or a default is not "missing".
        var known = guidance.Suggestions.Count(item => item.ResolvedValue is not null);
        var configured = guidance.Suggestions.Count(item => item.ConfiguredValue is not null);
        var review = guidance.Suggestions.Count(item => item.ReviewRequired);
        var origins = guidance.Suggestions.Where(item => item.ResolvedValue is not null && item.ResolvedFrom != BirkNext.SourceDomains.ConfigurationValueOrigin.Configured)
            .GroupBy(item => item.ResolvedFrom).Select(group => $"{group.Count()} from {BirkNext.SourceDomains.SourceConfigurationPrecedence.Label(group.Key).ToLowerInvariant()}");
        var parts = string.Join(" · ", new[] { $"{configured} stored" }.Concat(origins).Concat(review > 0 ? [$"{review} need review"] : []));
        return $"{known} of {guidance.Suggestions.Count} configuration values known ({parts}); {guidance.Suggestions.Count - known} unresolved.";
    }

    /// <summary>A rule's required source and what is bound or available for it.</summary>
    private static string RuleSource(ArchitectureRuleReport report, ArchitectureRuleFinding finding) =>
        report.RuleSources.FirstOrDefault(item => item.RuleId == finding.RuleId) is { } source
            ? source.State == TestPackSourceState.Bound ? $"{source.SourceRoleLabel ?? "Bound source"} · {source.BoundArchive}"
              : $"Needs {source.SourceRoleLabel} · {(source.AvailableArchive is { } available ? $"available: {available} (not bound)" : SourceGuidancePresentation.SourceStateLabel(source.State).ToLowerInvariant())}"
            : report.SourceArchive ?? "Not bound";
    private IntegrationJourneyPackView? _pack;
    private TestPackDescriptor? _descriptor;
    private ArchitectureRuleReport? _rules;
    private string? _rulesError;
    private IntegrationJourneyPanel? _journeys;
    private string _tab = TestPackOverview;
    private string? _focusAfterRender;
    private bool _runOpen;
    private readonly HashSet<string> _openGroups = new(StringComparer.Ordinal);
    /// <summary>False until the active Target Environment and readiness have been read: nothing is called Not ready before that is known.</summary>
    private bool _initialized;
    private const string TestPackOverview = "overview";

    /// <summary>The pack's own descriptor; until it loads (or without the endpoint), the same registration as the backend declares.</summary>
    private TestPackDescriptor? Descriptor => _descriptor;

    /// <summary>Navigation from the descriptor; a fixed fallback with the same view ids keeps routes working before it loads.</summary>
    private IReadOnlyList<TestPackNavigationGroup> Navigation_ => _descriptor?.Navigation is { Count: > 0 } navigation ? navigation : Fallback;

    private static readonly IReadOnlyList<TestPackNavigationGroup> Fallback =
    [
        new("Overview", [new(TestPackOverview, "Overview", TestPackViewKind.Overview)]),
        new("Journeys", [new("utdanningsdata", "Utdanningsdata", TestPackViewKind.Journey, "utdanningsdata"), new(RapportmottakId, "Rapportmottak", TestPackViewKind.Journey, RapportmottakId),
            new(PeriodeavslutningId, "Periodeavslutning", TestPackViewKind.Journey, PeriodeavslutningId)]),
        new("Security", [new("security", "Security / Gradert tilgang", TestPackViewKind.Security)]),
        new("Verify", [new("message-verification", "Message Verification", TestPackViewKind.Verification, RapportmottakId, "message-verification", "Read-only verification of what happened to one message."),
            new("architecture-rules", "Architecture Rules", TestPackViewKind.Rules)]),
        new("History", [new("history", "History", TestPackViewKind.History)]),
    ];

    private static readonly IReadOnlyList<TestPackJourney> FallbackJourneys =
    [
        new("utdanningsdata", "Utdanningsdata", "BiRK → Debezium → Event Hub → SkoleAdapter → Utdanning", JourneyExecutionMode.DelegatedToActiveEvent, "skolenaervaer.cdc"),
        new(RapportmottakId, "Rapportmottak", "Altinn → MU → MM → Skolenærværsrapport", JourneyExecutionMode.JourneyRunner, null),
        new(PeriodeavslutningId, "Periodeavslutning", "Skolenærværsrapport → Service Bus → Bufdata", JourneyExecutionMode.JourneyRunner, null),
    ];

    private IReadOnlyList<TestPackJourney> Journeys => _descriptor?.Journeys is { Count: > 0 } journeys ? journeys : FallbackJourneys;

    private TestPackView? CurrentView => Navigation_.SelectMany(group => group.Views).FirstOrDefault(view => view.ViewId == _tab)
        ?? Navigation_.SelectMany(group => group.Views).FirstOrDefault();

    private string TabHref(string key) => key == TestPackOverview ? "extensions/skolenaervaer" : $"extensions/skolenaervaer?tab={key}";
    private static string SectionId(string key) => key switch
    {
        "utdanningsdata" => "snt-education", RapportmottakId => "snt-rapport", PeriodeavslutningId => "snt-period", _ => $"snt-{key}",
    };

    private IntegrationJourneyView? View(string journeyId) => _pack?.Journeys.FirstOrDefault(item => item.Journey.JourneyId == journeyId);

    /// <summary>Unresolved mandatory prerequisites: Rapportmottak counts the unresolved parts of a submission (the backend's own rows).</summary>
    private IReadOnlyList<JourneyPrerequisite> Blockers(string journeyId) => View(journeyId) is not { } view ? []
        : journeyId == RapportmottakId ? SkoleNaervaerReadinessPresentation.NeedsAttention(view.Prerequisites) : TestPackPresentation.Blockers(view);

    private int BlockerCount(string journeyId) => Blockers(journeyId).Count;

    private string VerificationAvailability(TestPackView verification) =>
        !_initialized ? NotLoaded : _profile is null ? "Not ready" : verification.JourneyId is { } journey && View(journey) is { } view && verification.ScenarioId is { } scenario
            ? view.RunnableScenarios.Contains(scenario, StringComparer.Ordinal) ? "Available (read-only)" : "Not available" : "Not available";

    /// <summary>A status always names its dimension, so "Not ready" never stands alone.</summary>
    private static RenderFragment Dimension(string dimension, string value) => __builder =>
    {
        <span class="snt-status" data-dimension="@dimension"><span class="visually-hidden">@dimension: </span><span class="snt-pill snt-pill-@Tone(value)">@value</span></span>
    };

    private static string Tone(string value) => value switch
    {
        "Configured" or "Verified" or "Ready" or "Available (read-only)" => "ready",
        "Partial" or "Review required" or "Partially verified" or "Executed · not verified" => "attention",
        "Not configured" or "Missing" or "Missing integration" or "Blocked" or "Not available" or "Not ready" or "Available · needs binding" => "attention",
        _ => "neutral",
    };

    private RenderFragment JourneyStatus(IntegrationJourneyView view) => __builder =>
    {
        <div class="snt-dimensions" data-testid="snt-status" data-journey="@view.Journey.JourneyId">
            <span><span class="snt-dimension-label">Configuration</span> @Dimension("Configuration", JourneyConfiguration(view))</span>
            <span><span class="snt-dimension-label">Source evidence</span> @Dimension("Source evidence", TestPackPresentation.SourceEvidence(view))</span>
            <span><span class="snt-dimension-label">Execution</span> @Dimension("Execution readiness", TestPackPresentation.ExecutionReadiness(view))</span>
            <span><span class="snt-dimension-label">Assessment</span> @Dimension("Assessment", JourneyReadinessPresentation.AssessmentLabel(view.Assessment))</span>
        </div>
        <JourneyReadinessDimensions View="view" ProfileId="@_profile?.Id" />
    };

    /// <summary>A matrix cell from the journey's shared readiness dimension (fallback when the backend sent none).</summary>
    private static string MatrixValue(IntegrationJourneyView view, JourneyDimension dimension, string fallback) =>
        JourneyReadinessPresentation.Get(view, dimension) is { } d ? JourneyReadinessPresentation.StateLabel(d.State) : fallback;

    /// <summary>Group titles in this pack's own terms; the grouping itself is the shared, generic one.</summary>
    private static readonly IReadOnlyDictionary<string, string> GroupTitles = new Dictionary<string, string>(StringComparer.Ordinal)
    {
        ["authentication"] = "ID-porten test setup", ["run-configuration"] = "Altinn run configuration", ["verification"] = "Bufdata / downstream verification",
    };

    /// <summary>What a journey needs from the tester, as owner-aware action groups (never a wall of raw checks).</summary>
    private IReadOnlyList<TestPackPresentation.BlockerGroup> AttentionGroups(string journeyId) =>
        TestPackPresentation.BlockerGroups(Blockers(journeyId), _guidance, _profile?.Id, GroupTitles, SourceGuidancePresentation.ForJourney(_guidance, journeyId));

    /// <summary>"N things need attention": one card per group with its state, owner and one action; the first is the primary next action
    /// (Rapportmottak's safe configuration, when offered, is its primary action instead).</summary>
    private RenderFragment AttentionSummary(string journeyId, IntegrationJourneyView view) => __builder =>
    {
        var groups = AttentionGroups(journeyId);
        var safeConfigPrimary = journeyId == RapportmottakId && ApplicableSourceValues.Count > 0 && _applyResult is null;
        var primaryGroup = safeConfigPrimary ? null : TestPackPresentation.PrimaryGroup(groups);
        <section class="snt-attention" aria-labelledby="@($"{SectionId(journeyId)}-attention")" data-testid="snt-needs-attention" data-count="@groups.Count">
            <h3 class="snt-subheading" id="@($"{SectionId(journeyId)}-attention")">@(groups.Count == 0 ? "Nothing needs attention" : $"{groups.Count} thing{(groups.Count == 1 ? "" : "s")} need{(groups.Count == 1 ? "s" : "")} attention")</h3>
            @if (groups.Count == 0) { <p class="snt-muted" data-testid="snt-nothing-unresolved">Nothing is blocking execution. Executable is not passed.</p> }
            else
            {
                @if (journeyId == RapportmottakId && SkoleNaervaerReadinessPresentation.InteractiveFallbackOnly(view.Prerequisites))
                {
                    <p class="snt-muted" data-testid="snt-fallback-note">The unattended setup is incomplete. The interactive TestID sign-in fallback can still run it, but the first TT02 run is unattended.</p>
                }
                <ol class="snt-group-cards" data-testid="snt-rapport-blockers">
                    @for (var i = 0; i < groups.Count; i++)
                    {
                        var group = groups[i];
                        var primary = group == primaryGroup;
                        <li class="snt-group-card" data-testid="snt-blocker-group" data-group="@group.Key">
                            <div class="snt-group-card-head"><strong>@group.Title</strong> <span class="snt-pill snt-pill-attention" data-testid="snt-blocker-state">@group.State</span></div>
                            <p class="snt-group-card-text">@group.Explanation</p>
                            @if (group.KnownValues.Count > 0) { <p class="snt-muted" data-testid="snt-blocker-known">Known: @string.Join("; ", group.KnownValues)</p> }
                            <p class="snt-muted snt-group-card-meta"><span data-testid="snt-blocker-owner">Owner: @group.Owner</span> · <span data-testid="snt-blocker-checks">@group.Items.Count check@(group.Items.Count == 1 ? "" : "s")</span></p>
                            @if (group.ActionHref is { } href) { <a class="@(primary ? "btn-primary" : "btn-secondary") snt-group-action" href="@href" data-testid="snt-blocker-action" aria-label="@($"{group.ActionLabel}: {group.Title}")">@group.ActionLabel</a> }
                            else if (group.ActionGroup is { } detail) { <button type="button" class="@(primary ? "btn-primary" : "btn-secondary") snt-group-action" data-testid="snt-blocker-action" aria-label="@($"{group.ActionLabel}: {group.Title}")" @onclick="() => OpenGroupAsync(detail)">@group.ActionLabel</button> }
                        </li>
                    }
                </ol>
            }
        </section>
    };

    /// <summary>Every underlying prerequisite check, for diagnosis: blockers by category with their source guidance, and what resolved
    /// automatically (only when something did). Collapsed by default.</summary>
    private RenderFragment PrerequisiteDetails(IntegrationJourneyView view) => __builder =>
    {
        var blockers = Blockers(view.Journey.JourneyId);
        var resolved = view.Prerequisites.Where(item => item.State == JourneyReadinessState.Ready).ToList();
        <ReviewDisclosure Text="@($"Show {blockers.Count + resolved.Count} prerequisite check{(blockers.Count + resolved.Count == 1 ? "" : "s")}")" CollapseText="Hide prerequisite checks"
                          Hint="@($"{blockers.Count} open")" TestId="snt-blocker-details" Class="disclosure-inline" @bind-Expanded="_detailsOpen">
            <p class="snt-muted">@view.ReadinessSummary</p>
            @CheckList(blockers)
            @if (resolved.Count > 0)
            {
                <section class="snt-resolved-section" aria-label="Resolved automatically" data-testid="snt-resolved" data-count="@resolved.Count">
                    <h4 class="snt-group-heading">Resolved automatically (@resolved.Count)</h4>
                    @foreach (var (group, items) in TestPackPresentation.Grouped(resolved))
                    {
                        <ul class="snt-resolved-list" aria-label="@group">
                            @foreach (var item in items)
                            {
                                <li data-testid="snt-resolved-item" data-key="@item.Key"><span class="snt-mark snt-mark-ok" aria-hidden="true">✓</span>
                                    <span class="snt-row-text"><strong>@item.Label</strong> <span class="snt-source" data-testid="snt-source-badge">@TestPackPresentation.Source(item)</span>
                                        @if (item.Detail.StartsWith("Resolved:", StringComparison.Ordinal)) { <span class="snt-muted snt-row-detail" data-testid="snt-resolved-choice">@item.Detail</span> }</span></li>
                            }
                        </ul>
                    }
                </section>
            }
        </ReviewDisclosure>
    };

    /// <summary>The raw checks by category, each with its source, why it is open and (behind "Why is this blocked?") the source guidance.</summary>
    private RenderFragment CheckList(IReadOnlyList<JourneyPrerequisite> blockers) => __builder =>
    {
        <div class="snt-blocker-groups" data-testid="snt-check-list">
            @foreach (var (group, items) in TestPackPresentation.Grouped(blockers))
            {
                <section class="snt-blocker-group" aria-label="@($"{group} checks")" data-testid="snt-check-group" data-group="@group">
                    <h4 class="snt-group-heading">@group <span class="snt-count">@items.Count</span></h4>
                    <ul class="snt-attention-list">
                        @foreach (var item in items)
                        {
                            var action = SkoleNaervaerReadinessPresentation.ActionFor(item, _profile?.Id);
                            var guidance = SourceGuidancePresentation.For(_guidance, item.Key);
                            <li data-key="@item.Key" data-category="@item.Category" data-testid="snt-attention-item"><span class="snt-mark snt-mark-open" aria-hidden="true">○</span>
                                <span class="snt-row-text"><strong>@item.Label</strong> <span class="snt-source" data-testid="snt-source-badge"><span class="visually-hidden">Source: </span>@TestPackPresentation.Source(item)</span>
                                    <span class="snt-kind" data-testid="snt-kind"><span class="visually-hidden">Needs: </span>@SourceGuidancePresentation.RequirementKind(item, guidance.Count > 0)</span>
                                    <span class="snt-muted snt-row-detail">@item.Detail</span>
                                    @if (item.Diagnostics.Count > 0)
                                    {
                                        @* Diagnostic facts behind the state (identities compared, candidates, exact reason) — a real disclosure, never a dead button. *@
                                        <ReviewDisclosure Text="View details" CollapseText="Hide details" TestId="snt-item-diagnostics" Class="disclosure-inline">
                                            <ul class="snt-diagnostics" data-testid="snt-item-diagnostics-list" aria-label="@($"Details for {item.Label}")">@foreach (var line in item.Diagnostics) { <li>@line</li> }</ul>
                                        </ReviewDisclosure>
                                    }
                                    @if (guidance.Count > 0)
                                    {
                                        <ReviewDisclosure Text="Why is this blocked?" CollapseText="Hide technical details" TestId="snt-blocker-guidance" Class="disclosure-inline">
                                            <SourceGuidanceList Suggestions="guidance" TestId="snt-blocker-guidance-list" Label="@($"Source guidance for {item.Label}")" />
                                        </ReviewDisclosure>
                                    }
                                    @if (action.Href is { } href) { <a class="snt-blocker-action" href="@href">@action.Label</a> }
                                    @* Inside the open check list a generic "View details" would only re-open this list: it is never offered here. *@
                                    else if (action.Group is { } detailGroup && detailGroup != "advanced") { <button type="button" class="snt-link-button" @onclick="() => OpenGroupAsync(detailGroup)">@action.Label</button> }</span></li>
                        }
                    </ul>
                </section>
            }
        </div>
    };

    /// <summary>Source, reference, runtime and active-execution states side by side — separate dimensions, never one "Ready".</summary>
    private RenderFragment ReadinessDimensions(string journeyId) => __builder =>
    {
        <div class="snt-dimensions" data-testid="snt-readiness-dimensions" data-journey="@journeyId">
            @foreach (var dimension in TestPackPresentation.Dimensions(_guidance, journeyId, _pack))
            {
                <span data-testid="snt-readiness-dimension" data-key="@dimension.Key"><span class="snt-dimension-label">@dimension.Label</span>
                    <span class="snt-status"><span class="visually-hidden">@dimension.Label: </span><span class="snt-pill snt-pill-@dimension.Tone">@dimension.Value</span></span></span>
            }
        </div>
        @if (_pack is { EnvironmentTrusted: false })
        {
            <p class="snt-muted" data-testid="snt-execution-note">Active execution is this environment's execution setting, not its health; source evidence and reference metadata never change it.
                <a href="@TestPackPresentation.ExecutionSettingsHref" class="snt-inline-link">Manage active execution</a></p>
        }
    };

    /// <summary>Rapportmottak first: readiness dimensions, the safe configuration (reviewed, then explicitly applied) and a run action whose
    /// wording follows readiness (Prepare while blocked, Start when executable after confirmation).</summary>
    private RenderFragment RapportmottakHeader(IntegrationJourneyView view) => __builder =>
    {
        var decision = SkoleNaervaerReadinessPresentation.Decision(SkoleNaervaerReadinessPresentation.NeedsAttention(view.Prerequisites));
        var executable = decision.Code == "A";
        @* The decision's internal code (A–F, a root-cause order) is not a formal classification, so only its label is shown. *@
        <p class="snt-decision" data-testid="snt-tt02-decision" data-code="@decision.Code"><span class="snt-dimension-label">TT02 submission readiness</span> <strong>@decision.Label</strong>
            @if (executable) { <span class="snt-muted"> — a first real submission still needs your explicit confirmation in the run.</span> }</p>
        @ReadinessDimensions(view.Journey.JourneyId)
        @if (ApplicableSourceValues.Count > 0 && _applyResult is null)
        {
            <section id="safe-configuration" class="snt-summary-card snt-safe-config" aria-labelledby="snt-safe-config-heading" data-testid="snt-safe-config" tabindex="-1">
                <h3 class="snt-subheading" id="snt-safe-config-heading">Safe configuration available</h3>
                <p>@ApplicableSourceValues.Count known value@(ApplicableSourceValues.Count == 1 ? "" : "s") can be saved for the active run.</p>
                @if (!_reviewingApply)
                {
                    <button type="button" class="btn-primary" data-testid="snt-review-apply" @onclick="() => _reviewingApply = true">Review &amp; apply @ApplicableSourceValues.Count value@(ApplicableSourceValues.Count == 1 ? "" : "s")</button>
                }
                else
                {
                    <p><strong>These values will be saved for the active run</strong> (empty fields only — an explicit value is never overwritten):</p>
                    <ul data-testid="snt-apply-preview">@foreach (var item in ApplicableSourceValues) { <li data-testid="snt-apply-preview-item" data-key="@item.Requirement.Key">@item.Requirement.Label: <code>@item.ResolvedValue</code> <span class="snt-muted">· @SourceGuidancePresentation.Origin(item)</span></li> }</ul>
                    <p class="snt-muted">Never secrets, reporters, identities, execution permission or runtime state.</p>
                    <div class="snt-actions">
                        <button type="button" class="btn-primary" data-testid="snt-apply-source" disabled="@_applying" @onclick="ApplySourceValuesAsync">Apply @ApplicableSourceValues.Count value@(ApplicableSourceValues.Count == 1 ? "" : "s")</button>
                        <button type="button" class="btn-secondary" data-testid="snt-apply-cancel" @onclick="() => _reviewingApply = false">Cancel</button>
                    </div>
                }
            </section>
        }
        @if (_applyResult is { } applied)
        {
            <div class="snt-apply-result" role="status" data-testid="snt-apply-result">
                <p><strong>@(applied.Applied.Count == 0 ? "Nothing was applied." : $"Saved {applied.Applied.Count} value{(applied.Applied.Count == 1 ? "" : "s")} for the active run (configuration; not runtime verified):")</strong></p>
                @if (applied.Applied.Count > 0) { <ul>@foreach (var item in applied.Applied) { <li data-testid="snt-applied-item" data-key="@item.Key">@item.Label: <code>@item.Value</code> <span class="snt-muted">· @item.Provenance</span></li> }</ul> }
                @if (applied.NotApplied.Count > 0) { <ul class="snt-muted">@foreach (var item in applied.NotApplied) { <li data-testid="snt-not-applied-item" data-key="@item.Key">@item.Label — @item.Reason</li> }</ul> }
            </div>
        }
        @if (_applyError is not null) { <p role="alert" data-testid="snt-apply-error">@_applyError</p> }
        <div class="snt-actions" data-testid="snt-rapport-actions">
            <button type="button" class="@(executable ? "btn-primary" : "btn-secondary")" data-testid="snt-open-run" @onclick="() => OpenRapportmottakAsync(null)">@(executable ? "Start Rapportmottak run" : "Prepare Rapportmottak run")</button>
            <a class="snt-inline-link" href="/integration-quality-review?view=test-verify" data-testid="snt-configure-altinn">Open Altinn run configuration</a>
        </div>
        <p class="snt-muted">Opening the run sends nothing. A real TT02 submission starts only after you confirm it there, and the backend re-checks every gate.</p>
    };

    /// <summary>Rapportmottak's technical details (provider configuration and every prerequisite), collapsed by default.</summary>
    private RenderFragment RapportmottakDetails(IntegrationJourneyView view) => __builder =>
    {
        <h3 class="snt-subheading">Technical details</h3>
        <div class="snt-groups" data-testid="snt-rapport-details">
            @foreach (var group in DetailGroups(view))
            {
                <div id="@($"snt-group-{group.Key}")" class="snt-focus-target" tabindex="-1">
                    <ReviewDisclosure Text="@group.Title" CollapseText="@group.Title" Hint="@group.Hint" TestId="@($"snt-group-{group.Key}")" Class="snt-group"
                                      Expanded="@_openGroups.Contains(group.Key)" ExpandedChanged="@(open => ToggleGroup(group.Key, open))">
                        @if (group.Key == "local")
                        {
                            <div class="snt-local-setup" data-testid="snt-local-setup">
                                <p>The run page stores nothing: it reads each value from its owner when the readiness is loaded.</p>
                                <ul>
                                    <li><strong>Integration Quality Review → Test &amp; Verify → Altinn provider:</strong> app, environment, ID-porten client id and scopes, approved test reporter reference and synthetic identity set. <a href="/integration-quality-review?view=test-verify">Open Altinn run configuration</a></li>
                                    <li><strong>Local execution config</strong> (this backend's process only, never a committed file): Enabled, the registered redirect URI, the client secret, the approved synthetic TestID reporters and their Altinn profile confirmation, approved synthetic children and the app-policy confirmation. Set them with <code>AIAssisted/scripts/configure-skolenaervaer-tt02-local.ps1</code> and restart the backend from that window.</li>
                                    <li><strong>Target Environment:</strong> the trusted target and its enrolled integrations. <a href="/admin/system-settings?section=target-environments">Open Target Environment</a></li>
                                    <li><strong>Test Data:</strong> approved synthetic reporters and identities. <a href="/test-data">Open Test Data</a></li>
                                    <li><strong>Live Altinn metadata:</strong> task, data type and process contract, read anonymously with "Read public TT02 metadata" under App contract.</li>
                                </ul>
                                <p class="snt-muted">Resolving is not verifying: configured scopes are not a verified client registration, a configured reporter is not authenticated, and a declared child is not verified.</p>
                            </div>
                        }
                        @if (group.Key == "contract") { <AltinnTestSetupPanel EnvironmentId="@_profile!.Id" OnOpenJourney="OpenRapportmottakAsync" /> }
                        @if (group.Items.Count > 0)
                        {
                            <ul class="snt-prerequisites">
                                @foreach (var item in group.Items)
                                {
                                    <li data-testid="snt-prerequisite" data-key="@item.Key" data-state="@item.State">
                                        <span class="snt-pill snt-pill-@IntegrationJourneyPresentation.ReadinessTone(item.State)">@IntegrationJourneyPresentation.Readiness(item.State)</span>
                                        <span><strong>@item.Label</strong>@(item.Mandatory ? "" : " (not a blocker)") — @item.Detail</span>
                                    </li>
                                }
                            </ul>
                        }
                    </ReviewDisclosure>
                </div>
            }
        </div>
    };

    private sealed record DetailGroup(string Key, string Title, string Hint, IReadOnlyList<JourneyPrerequisite> Items);

    /// <summary>Rapportmottak's prerequisites for reading, grouped by category metadata (the Altinn app contract keeps its own group, which
    /// hosts the provider's setup); collapsed by default. Grouping is presentation only.</summary>
    private IEnumerable<DetailGroup> DetailGroups(IntegrationJourneyView view)
    {
        yield return new("local", "Local execution setup", "where each value comes from", []);
        var contract = view.Prerequisites.Where(item => item.Category == JourneyPrerequisiteCategory.Contract).ToList();
        var open = contract.Count(item => item.State != JourneyReadinessState.Ready);
        yield return new("contract", "App contract", contract.Count == 0 ? "Altinn app setup" : open == 0 ? $"{contract.Count} ready" : $"{open} of {contract.Count} not ready", contract);
        foreach (var (group, items) in TestPackPresentation.Grouped(view.Prerequisites.Where(item => item.Category != JourneyPrerequisiteCategory.Contract)))
        {
            var notReady = items.Count(item => item.State != JourneyReadinessState.Ready);
            yield return new(group.ToLowerInvariant().Replace(' ', '-'), group, notReady == 0 ? $"{items.Count} ready" : $"{notReady} of {items.Count} not ready", items);
        }
    }

    /// <summary>What a rule's evidence is, separately from its assessment.</summary>
    private static string RuleEvidence(ArchitectureRuleReport report, ArchitectureRuleFinding finding) =>
        report.SourceSnapshotId is null
            ? report.RuleSources.FirstOrDefault(item => item.RuleId == finding.RuleId)?.State switch
            {
                TestPackSourceState.AvailableNotBound => $"{BirkNext.Web.Services.ProjectImport.SourceSetupPresentation.AvailableNeedsBinding} — no canonical source selected",
                TestPackSourceState.ReviewRequired => "Review required — no canonical source selected",
                TestPackSourceState.Missing or null => "Missing — no source snapshot",
                _ => "No canonical source selected",
            }
        : finding.Evidence.Count > 0 ? $"{finding.Evidence.Count} dependency reference{(finding.Evidence.Count == 1 ? "" : "s")} in source"
        : finding.Outcome == ArchitectureRuleOutcome.NotAssessed ? "Inconclusive — component not found in source" : "No dependency found in source";

    private void ToggleGroup(string key, bool open) { if (open) _openGroups.Add(key); else _openGroups.Remove(key); }

    /// <summary>A blocker's action that is explained on this page opens that detail: Rapportmottak's technical groups (local execution setup,
    /// contract metadata), otherwise the journey's prerequisite checks.</summary>
    private async Task OpenGroupAsync(string key)
    {
        var rapport = CurrentView?.JourneyId == RapportmottakId && View(RapportmottakId) is { } view && DetailGroups(view).Any(group => group.Key == key);
        if (rapport) _openGroups.Add(key); else _detailsOpen = true;
        StateHasChanged();
        try { await JS.InvokeVoidAsync("birknextFocusElement", rapport ? $"snt-group-{key}" : "snt-blocker-details-toggle"); } catch (JSException) { }
    }

    private bool _detailsOpen;
    private bool _reviewingApply;

    /// <summary>The top-level area holding the current view.</summary>
    private TestPackNavigationGroup? CurrentGroup => Navigation_.FirstOrDefault(group => group.Views.Contains(CurrentView!)) ?? Navigation_.FirstOrDefault();

    /// <summary>An area's secondary navigation: verification views split into runtime verification and source-based checks, so a rule check
    /// never reads as runtime verification; other areas are one list.</summary>
    private static IReadOnlyList<(string? Caption, IReadOnlyList<TestPackView> Views)> SubnavSections(TestPackNavigationGroup group)
    {
        var runtime = group.Views.Where(view => view.Kind == TestPackViewKind.Verification).ToList();
        var source = group.Views.Where(view => view.Kind == TestPackViewKind.Rules).ToList();
        if (runtime.Count == 0 || source.Count == 0) return [(null, group.Views)];
        var rest = group.Views.Except(runtime).Except(source).ToList();
        return [("Runtime verification", runtime), ("Source-based checks", source), .. rest.Count > 0 ? new[] { ((string?)null, (IReadOnlyList<TestPackView>)rest) } : []];
    }

    /// <summary>The compact source state on the Overview: the shared wording, "Reference available" for a Test Pack reference.</summary>
    private static string SourceSummaryLabel(TestPackSourceStatus source) => source.State switch
    {
        TestPackSourceState.ReferenceAvailable => "Reference available",
        TestPackSourceState.ReferenceUnavailable => "Reference unavailable",
        TestPackSourceState.Available => "Available",
        _ => SourceGuidancePresentation.SourceStateLabel(source),
    };

    /// <summary>A journey's configuration in tester terms: a missing integration says so; otherwise how many of its values are known (from
    /// their owners, never re-entered); "Not configured" only when nothing is known.</summary>
    private string JourneyConfiguration(IntegrationJourneyView view)
    {
        if (view.Prerequisites.Any(item => item.Category == JourneyPrerequisiteCategory.Integration && item.Key.StartsWith("integration:", StringComparison.Ordinal)
                && item.State == JourneyReadinessState.NotConfigured)) return "Missing integration";
        var mapping = view.Prerequisites.Any(item => item.Key.EndsWith(":mapping", StringComparison.Ordinal) && item.State != JourneyReadinessState.Ready);
        var keys = view.Prerequisites.Select(item => item.Key).ToHashSet(StringComparer.Ordinal);
        var values = _guidance?.Suggestions.Where(item => item.Requirement.PrerequisiteKey is { } key && keys.Contains(key)).ToList() ?? [];
        var known = values.Count == 0 ? TestPackPresentation.Configuration(view) : $"{values.Count(item => item.ResolvedValue is not null)}/{values.Count} values known";
        return mapping ? $"Integration found · mapping incomplete · {known}" : known;
    }

    /// <summary>"Partial: 2 of 3 journey integrations found (1 mapping incomplete)" — configured integrations, never readiness.</summary>
    private string IntegrationCoverage
    {
        get
        {
            var views = Journeys.Select(j => View(j.JourneyId)).OfType<IntegrationJourneyView>().ToList();
            var requirements = views.SelectMany(view => view.Journey.Integrations.Select(requirement => (View: view, Requirement: requirement))).ToList();
            if (requirements.Count == 0) return "Not assessed";
            var found = requirements.Count(item => item.View.MatchedIntegrations.Any(m => m.RequirementKey == item.Requirement.Key && m.IntegrationId is not null));
            var incomplete = requirements.Count(item => item.View.MatchedIntegrations.Any(m => m.RequirementKey == item.Requirement.Key && m.MatchState == BirkNext.Integrations.IntegrationMatchState.MappingIncomplete));
            var state = found == requirements.Count && incomplete == 0 ? "Complete" : found == 0 ? "None found" : "Partial";
            return $"{state}: {found} of {requirements.Count} journey integration{(requirements.Count == 1 ? "" : "s")} found{(incomplete > 0 ? $" ({incomplete} mapping incomplete)" : "")}";
        }
    }

    /// <summary>Whether active execution may start anywhere in this pack: blocked until the environment, integrations and run values allow it.</summary>
    private string ExecutionConfiguration =>
        Journeys.Select(j => View(j.JourneyId)).OfType<IntegrationJourneyView>().ToList() is { Count: > 0 } views
            ? views.Any(view => view.CanRun) ? $"Executable after confirmation for {views.Count(view => view.CanRun)} of {views.Count} journeys" : "Blocked"
            : "Not assessed";

    private sealed record RootCause(int Count, string Reason, IReadOnlyList<string> Matches, string ActionLabel, string ActionHref);

    /// <summary>One summary when every rule that cannot be assessed waits on the same logical source in the same state (for example its
    /// source is available but not bound) — the rules stay listed behind it. Null when the causes differ or nothing is blocked.</summary>
    private RootCause? RulesRootCause(ArchitectureRuleReport report)
    {
        var blocked = report.Findings.Where(finding => finding.Outcome == ArchitectureRuleOutcome.NotAssessed).ToList();
        if (blocked.Count == 0) return null;
        var sources = blocked.Select(finding => report.RuleSources.FirstOrDefault(item => item.RuleId == finding.RuleId)).ToList();
        if (sources.Any(item => item is null)) return null;
        var causes = sources.Select(item => (item!.SourceRole, item.SourceRoleLabel, item.State)).Distinct().ToList();
        if (causes.Count != 1 || causes[0].State == TestPackSourceState.Bound) return null;
        var (role, label, state) = causes[0];
        var status = _guidance?.Sources.FirstOrDefault(item => item.Role.Key == role);
        var name = label ?? role;
        return state switch
        {
            TestPackSourceState.Missing => new(blocked.Count, $"No {name} source has been imported.", [], $"Import {name} source", "/project-import"),
            TestPackSourceState.ReviewRequired => new(blocked.Count, $"Several {name} sources match; one must be chosen as canonical evidence.",
                status?.AvailableArchives ?? [], $"Choose {name} evidence", SourceGuidancePresentation.ActionHref("iqr-evidence")!),
            _ => new(blocked.Count, $"{name} source evidence is available but not bound.", status?.AvailableArchives ?? [.. sources.Select(item => item!.AvailableArchive).OfType<string>().Distinct()],
                $"Bind {name} evidence", SourceGuidancePresentation.ActionHref("iqr-evidence")!),
        };
    }

    private async Task SelectTabAsync(string key)
    {
        _tab = key;
        _focusAfterRender = CurrentView is { Kind: TestPackViewKind.Journey, JourneyId: { } journey } ? $"{SectionId(journey)}-heading"
            : CurrentView?.Kind switch { TestPackViewKind.Verification => "snt-verification-heading", TestPackViewKind.Rules => "snt-rules-heading", TestPackViewKind.History => "snt-history-heading", TestPackViewKind.Security => "snt-security-heading", _ => "snt-overview-heading" };
        Navigation.NavigateTo(TabHref(key));
        await LoadForTabAsync();
    }

    /// <summary>Opens the run inside Rapportmottak (the shared journey panel, embedded); nothing is started.</summary>
    private async Task OpenRapportmottakAsync(string? scenarioId)
    {
        _runOpen = true;
        if (_journeys is not null) await _journeys.ShowJourneyAsync(RapportmottakId, scenarioId);
        StateHasChanged();
        try { await JS.InvokeVoidAsync("birknextFocusElement", "snt-rapport-run"); } catch (JSException) { }
    }

    protected override async Task OnInitializedAsync()
    {
        try { await InitializeAsync(); }
        finally { _initialized = true; }
    }

    private async Task InitializeAsync()
    {
        var journeysApi = Services.GetService<IIntegrationJourneysApiService>();
        if (journeysApi is not null)
        {
            try { if (journeysApi.TestPacksAsync(_disposed.Token) is { } describe) _descriptor = (await describe)?.Value?.FirstOrDefault(pack => pack.PackId == PackId); }
            catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { }
        }
        var context = await ContextFactory.GetActiveContextAsync();
        _profile = context.ActiveProfileOrNull;
        if (_profile is null)
        {
            _sourceSummary = "Not available without an active Target Environment; use Source Analysis to inspect source evidence.";
            return;
        }

        if (journeysApi is not null)
        {
            try { _pack = (await journeysApi.PacksAsync(_profile.Id, _disposed.Token)).Value?.FirstOrDefault(pack => pack.PackId == PackId); }
            catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { }
            try { if (journeysApi.SourceGuidanceAsync(_profile.Id, PackId, _disposed.Token) is { } guidance) _guidance = (await guidance)?.Value is { } loaded ? SourceGuidancePresentation.Resolved(loaded) : null; }
            catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { }
        }
        try
        {
            // The canonical evidence: Integration Quality Review's bindings of the integrations this pack uses. Nothing is chosen here.
            var used = _pack?.Journeys.SelectMany(view => view.MatchedIntegrations).Select(item => item.IntegrationId).OfType<string>().ToHashSet(StringComparer.Ordinal) ?? [];
            var bindings = ((await IntegrationApi.ListEvidenceBindingsAsync(_profile.Id)) ?? []).Where(binding => used.Contains(binding.IntegrationId)).ToList();
            _sourceSummary = bindings.Count == 0 ? "No source evidence bound to this pack's integrations · architecture rules are Not assessed until a snapshot is bound"
                : string.Join(" · ", bindings.Select(binding => binding.ArchiveName).Distinct()) + $" (bound in Integration Quality Review for {bindings.Count} integration{(bindings.Count == 1 ? "" : "s")})";
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _sourceSummary = "Unavailable · open Integration Quality Review → Evidence";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Back from ID-porten TEST: open the Rapportmottak run directly.
        var signIn = new Uri(Navigation.Uri).Query.Contains("altinn-sign-in=", StringComparison.Ordinal);
        _tab = signIn ? RapportmottakId : Tab is { Length: > 0 } requested ? requested : TestPackOverview;
        if (signIn) _runOpen = true;
        await LoadForTabAsync();
    }

    private async Task LoadForTabAsync()
    {
        if (CurrentView?.Kind != TestPackViewKind.Rules || _profile is null || _rules is not null) return;
        if (Services.GetService<IIntegrationJourneysApiService>() is not { } journeys) { _rulesError = "Rule results are not available in this build."; return; }
        try
        {
            var result = await journeys.RulesAsync(_profile.Id, PackId, _disposed.Token);
            _rules = result.Value;
            _rulesError = result.Error ?? (result.Value is null ? "Not assessed: no rule result is available." : null);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { _rulesError = "Rule results could not be loaded."; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusAfterRender is not { } id) return;
        _focusAfterRender = null;
        try { await JS.InvokeVoidAsync("birknextFocusElement", id); } catch (JSException) { }
    }

    public void Dispose()
    {
        _disposed.Cancel();
        _disposed.Dispose();
    }
}
