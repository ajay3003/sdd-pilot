@page "/delivery-readiness"
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@inject IConstitutionAnalysisService ConstitutionService
@inject IPlanAnalysisService PlanService
@inject IDeliveryReadinessAssessmentService ReadinessService
@inject IDashboardSnapshotService DashboardSnapshot

<div class="page-hero">
    <span class="section-kicker">Go / No-Go Assessment</span>
    <h1>Delivery Readiness</h1>
    <p class="hero-description">
        Objective, multi-gate readiness assessment across the SDD artifact chain.
        Answers: Ready for Development? Ready for Testing? Ready for Release?
    </p>
</div>

<div class="dr-page">

    <!-- Input panel -->
    @if (_inputExpanded || _report is null)
    {
        <div class="dr-input-panel">
            <div class="dr-input-panel-header">
                <h3>Artifact Inputs</h3>
                @if (_report is not null)
                {
                    <button class="btn btn-ghost btn-sm" @onclick="() => _inputExpanded = false">
                        Collapse
                    </button>
                }
            </div>
            <div class="dr-artifact-grid">
                <div class="dr-artifact-card @(_constitutionLoaded ? "is-loaded" : "")">
                    <div class="dr-artifact-card-header">
                        Constitution
                        <span class="dr-artifact-card-status">@(_constitutionLoaded ? "Loaded" : "Optional")</span>
                    </div>
                    <InputFile OnChange="e => LoadFile(e, ArtifactSlot.Constitution)" accept=".md,.txt" class="form-control form-control-sm" />
                    <textarea class="form-control" rows="3" placeholder="Paste constitution markdown…"
                              @bind="_constitutionText" @bind:event="oninput"></textarea>
                </div>
                <div class="dr-artifact-card @(_specLoaded ? "is-loaded" : "")">
                    <div class="dr-artifact-card-header">
                        Specification
                        <span class="dr-artifact-card-status">@(_specLoaded ? "Loaded" : "Optional")</span>
                    </div>
                    <InputFile OnChange="e => LoadFile(e, ArtifactSlot.Specification)" accept=".md,.txt" class="form-control form-control-sm" />
                    <textarea class="form-control" rows="3" placeholder="Paste specification markdown…"
                              @bind="_specText" @bind:event="oninput"></textarea>
                </div>
                <div class="dr-artifact-card @(_planLoaded ? "is-loaded" : "")">
                    <div class="dr-artifact-card-header">
                        Implementation Plan
                        <span class="dr-artifact-card-status">@(_planLoaded ? "Loaded" : "Optional")</span>
                    </div>
                    <InputFile OnChange="e => LoadFile(e, ArtifactSlot.Plan)" accept=".md,.txt" class="form-control form-control-sm" />
                    <textarea class="form-control" rows="3" placeholder="Paste plan markdown…"
                              @bind="_planText" @bind:event="oninput"></textarea>
                </div>
                <div class="dr-artifact-card @(_tasksLoaded ? "is-loaded" : "")">
                    <div class="dr-artifact-card-header">
                        Task File
                        <span class="dr-artifact-card-status">@(_tasksLoaded ? "Loaded" : "Optional")</span>
                    </div>
                    <InputFile OnChange="e => LoadFile(e, ArtifactSlot.Tasks)" accept=".md,.txt" class="form-control form-control-sm" />
                    <textarea class="form-control" rows="3" placeholder="Paste task markdown…"
                              @bind="_taskText" @bind:event="oninput"></textarea>
                </div>
            </div>
            <div class="d-flex gap-2 align-items-center">
                <button class="btn btn-primary" @onclick="RunAssessment" disabled="@(!AnyArtifactLoaded)">
                    Assess Delivery Readiness
                </button>
                @if (!AnyArtifactLoaded)
                {
                    <span class="text-muted small">Load at least one artifact to begin.</span>
                }
            </div>
        </div>
    }
    else
    {
        <div class="d-flex align-items-center gap-3">
            <button class="btn btn-ghost btn-sm" @onclick="() => _inputExpanded = true">
                Edit Artifacts
            </button>
            <span class="small text-muted">
                @ArtifactSummary
            </span>
        </div>
    }

    <!-- Results -->
    @if (_report is not null)
    {
        <!-- 3 decision cards -->
        <div class="dr-decision-grid">
            @RenderDecisionCard(_report.DevelopmentDecision)
            @RenderDecisionCard(_report.TestingDecision)
            @RenderDecisionCard(_report.ReleaseDecision)
        </div>

        <!-- Tab bar -->
        <div class="tab-bar">
            <button class="tab-btn @(_tab == "overview"     ? "active" : "")" @onclick='() => _tab = "overview"'>Overview</button>
            <button class="tab-btn @(_tab == "development"  ? "active" : "")" @onclick='() => _tab = "development"'>
                @StateIcon(_report.DevelopmentDecision.State) Development
            </button>
            <button class="tab-btn @(_tab == "testing"      ? "active" : "")" @onclick='() => _tab = "testing"'>
                @StateIcon(_report.TestingDecision.State) Testing
            </button>
            <button class="tab-btn @(_tab == "release"      ? "active" : "")" @onclick='() => _tab = "release"'>
                @StateIcon(_report.ReleaseDecision.State) Release
            </button>
            <button class="tab-btn @(_tab == "blockers"     ? "active" : "")" @onclick='() => _tab = "blockers"'>
                Blockers
                @if (_report.Blockers.Count > 0)
                {
                    <span class="badge @(_report.Blockers.Any(b => b.Severity == GateSeverity.Critical) ? "badge-danger" : "badge-warning") ms-1">
                        @_report.Blockers.Count
                    </span>
                }
            </button>
            <button class="tab-btn @(_tab == "recommendations" ? "active" : "")" @onclick='() => _tab = "recommendations"'>
                Recommendations
                @if (_report.Recommendations.Count > 0)
                {
                    <span class="badge badge-secondary ms-1">@_report.Recommendations.Count</span>
                }
            </button>
        </div>

        <!-- Tab content -->
        @if (_tab == "overview")
        {
            @RenderOverviewTab()
        }
        else if (_tab == "development")
        {
            @RenderGateTab(_report.DevelopmentGate)
        }
        else if (_tab == "testing")
        {
            @RenderGateTab(_report.TestingGate)
        }
        else if (_tab == "release")
        {
            @RenderGateTab(_report.ReleaseGate)
        }
        else if (_tab == "blockers")
        {
            @RenderBlockersTab()
        }
        else if (_tab == "recommendations")
        {
            @RenderRecommendationsTab()
        }
    }
</div>

@code {

    // ── State ──────────────────────────────────────────────────────────────────

    private string _constitutionText = string.Empty;
    private string _specText         = string.Empty;
    private string _planText         = string.Empty;
    private string _taskText         = string.Empty;

    private DeliveryReadinessReport? _report;
    private string _tab = "overview";
    private bool _inputExpanded = true;

    // Filter state
    private GateSeverity? _blockerSeverityFilter;
    private string? _blockerPhaseFilter;
    private string? _recPhaseFilter;
    private string _recSearch = string.Empty;

    private bool _constitutionLoaded => !string.IsNullOrWhiteSpace(_constitutionText);
    private bool _specLoaded         => !string.IsNullOrWhiteSpace(_specText);
    private bool _planLoaded         => !string.IsNullOrWhiteSpace(_planText);
    private bool _tasksLoaded        => !string.IsNullOrWhiteSpace(_taskText);
    private bool AnyArtifactLoaded   => _constitutionLoaded || _specLoaded || _planLoaded || _tasksLoaded;

    private string ArtifactSummary
    {
        get
        {
            var parts = new List<string>();
            if (_constitutionLoaded) parts.Add("Constitution");
            if (_specLoaded)         parts.Add("Specification");
            if (_planLoaded)         parts.Add("Plan");
            if (_tasksLoaded)        parts.Add("Tasks");
            return parts.Count == 0 ? "No artifacts" : string.Join(", ", parts);
        }
    }

    // ── Actions ────────────────────────────────────────────────────────────────

    private enum ArtifactSlot { Constitution, Specification, Plan, Tasks }

    private async Task LoadFile(InputFileChangeEventArgs e, ArtifactSlot slot)
    {
        var file = e.File;
        if (file is null) return;
        using var sr = new System.IO.StreamReader(file.OpenReadStream(maxAllowedSize: 10_485_760));
        var text = await sr.ReadToEndAsync();
        switch (slot)
        {
            case ArtifactSlot.Constitution:  _constitutionText = text; break;
            case ArtifactSlot.Specification: _specText         = text; break;
            case ArtifactSlot.Plan:          _planText         = text; break;
            case ArtifactSlot.Tasks:         _taskText         = text; break;
        }
    }

    private void RunAssessment()
    {
        var constitution = _constitutionLoaded
            ? ConstitutionService.Parse(_constitutionText)
            : null;
        var spec = _specLoaded
            ? SpecExplorerService.Parse(_specText)
            : null;
        var plan = _planLoaded
            ? PlanService.Parse(_planText)
            : null;
        var tasks = _tasksLoaded
            ? TaskExplorerService.Parse(_taskText)
            : null;

        _report = ReadinessService.Assess(constitution, spec, plan, tasks);
        DashboardSnapshot.Publish(_report);
        _inputExpanded = false;
        _tab = "overview";
    }

    // ── Render helpers ─────────────────────────────────────────────────────────

    private string StateClass(ReadinessState state) => state switch
    {
        ReadinessState.Ready       => "is-ready",
        ReadinessState.MostlyReady => "is-mostly-ready",
        ReadinessState.NotReady    => "is-not-ready",
        ReadinessState.Blocked     => "is-blocked",
        _                          => "",
    };

    private string StateLabel(ReadinessState state) => state switch
    {
        ReadinessState.Ready       => "Ready",
        ReadinessState.MostlyReady => "Mostly Ready",
        ReadinessState.NotReady    => "Not Ready",
        ReadinessState.Blocked     => "Blocked",
        _                          => state.ToString(),
    };

    private string StateIcon(ReadinessState state) => state switch
    {
        ReadinessState.Ready       => "✓",
        ReadinessState.MostlyReady => "~",
        ReadinessState.NotReady    => "✗",
        ReadinessState.Blocked     => "⊘",
        _                          => "",
    };

    private string SevClass(GateSeverity sev) => sev switch
    {
        GateSeverity.Critical => "sev-critical",
        GateSeverity.High     => "sev-high",
        GateSeverity.Medium   => "sev-medium",
        GateSeverity.Low      => "sev-low",
        _                     => "",
    };

    private string SevBadgeClass(GateSeverity sev) => sev switch
    {
        GateSeverity.Critical => "dr-badge-sev-critical",
        GateSeverity.High     => "dr-badge-sev-high",
        GateSeverity.Medium   => "dr-badge-sev-medium",
        GateSeverity.Low      => "dr-badge-sev-low",
        _                     => "",
    };

    // ── Score ring ─────────────────────────────────────────────────────────────

    private RenderFragment RenderScoreRing(double score, ReadinessState state, int size = 72) =>
        __builder =>
        {
            int sz        = size;
            int cx        = sz / 2;
            int cy        = sz / 2;
            int r         = (sz - 10) / 2;
            double circumference = 2 * Math.PI * r;
            double pct    = Math.Min(100, Math.Max(0, score)) / 100.0;
            double offset = circumference * (1.0 - pct);
            string variant = StateClass(state);

            var svgHtml = "<svg viewBox=\"0 0 " + sz + " " + sz + "\" width=\"" + sz + "\" height=\"" + sz + "\">" +
                          "<circle class=\"dr-score-ring-bg\" cx=\"" + cx + "\" cy=\"" + cy + "\" r=\"" + r + "\" />" +
                          "<circle class=\"dr-score-ring-fill " + variant + "\" cx=\"" + cx + "\" cy=\"" + cy + "\" r=\"" + r + "\"" +
                          " stroke-dasharray=\"" + circumference.ToString("0.00") + "\" stroke-dashoffset=\"" + offset.ToString("0.00") + "\" />" +
                          "<text x=\"50%\" y=\"50%\" dominant-baseline=\"middle\" text-anchor=\"middle\"" +
                          " font-size=\"" + (sz / 4) + "\" font-weight=\"700\" fill=\"currentColor\">" +
                          ((int)Math.Round(score)).ToString() + "</text>" +
                          "</svg>";
            __builder.AddMarkupContent(0, svgHtml);
        };

    // ── Decision card ──────────────────────────────────────────────────────────

    private RenderFragment RenderDecisionCard(ReadinessDecision decision) =>
        __builder =>
        {
            string cls = StateClass(decision.State);
            string icon = decision.State switch
            {
                ReadinessState.Ready       => "✓",
                ReadinessState.MostlyReady => "~",
                ReadinessState.NotReady    => "✗",
                ReadinessState.Blocked     => "⊘",
                _                          => "",
            };

            <div class="dr-decision-card @cls">
                <div class="dr-decision-card-phase">@decision.Name Readiness</div>
                <div class="dr-decision-state">
                    <div class="dr-decision-state-icon">@icon</div>
                    <span class="dr-decision-state-label">@StateLabel(decision.State)</span>
                </div>
                <div class="dr-decision-score">Score: @decision.Score.ToString("0.#") / 100</div>
                @if (!string.IsNullOrEmpty(decision.Summary))
                {
                    <div class="dr-decision-summary">@decision.Summary</div>
                }
            </div>
        };

    // ── Overview tab ───────────────────────────────────────────────────────────

    private RenderFragment RenderOverviewTab() =>
        __builder =>
        {
            var r = _report!;

            <div class="dr-overview-stats">
                <div class="dr-stat-chip">
                    <span class="dr-stat-chip-value">@r.Health.OverallReadinessScore.ToString("0.#")</span>
                    <span class="dr-stat-chip-label">/ 100 overall</span>
                </div>
                <div class="dr-stat-chip">
                    <span class="dr-stat-chip-value" style="color: var(--color-danger)">
                        @r.Blockers.Count(b => b.Severity == GateSeverity.Critical)
                    </span>
                    <span class="dr-stat-chip-label">critical blockers</span>
                </div>
                <div class="dr-stat-chip">
                    <span class="dr-stat-chip-value">@r.Blockers.Count</span>
                    <span class="dr-stat-chip-label">total blockers</span>
                </div>
                <div class="dr-stat-chip">
                    <span class="dr-stat-chip-value">@r.Recommendations.Count</span>
                    <span class="dr-stat-chip-label">recommendations</span>
                </div>
            </div>

            <div class="dr-check-columns" style="margin-top: var(--space-5)">
                <div class="card p-4">
                    <div class="fw-bold mb-3">Loaded Artifacts</div>
                    <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px;font-size:var(--text-sm)">
                        @ArtifactRow("Constitution", r.HasConstitution)
                        @ArtifactRow("Specification", r.HasSpecification)
                        @ArtifactRow("Plan", r.HasPlan)
                        @ArtifactRow("Tasks", r.HasTasks)
                    </ul>
                </div>
                <div class="card p-4">
                    <div class="fw-bold mb-3">Gate Scores</div>
                    <div style="display:flex;flex-direction:column;gap:12px">
                        @GateScoreRow("Development", r.DevelopmentDecision)
                        @GateScoreRow("Testing", r.TestingDecision)
                        @GateScoreRow("Release", r.ReleaseDecision)
                    </div>
                </div>
            </div>

            @if (r.Blockers.Count > 0)
            {
                <div style="margin-top:var(--space-2)">
                    <div class="fw-bold mb-3">Critical Blockers</div>
                    <div class="dr-blockers-list">
                        @foreach (var b in r.Blockers.Where(b => b.Severity == GateSeverity.Critical).Take(3))
                        {
                            @RenderBlockerCard(b)
                        }
                        @if (r.Blockers.Count(b => b.Severity == GateSeverity.Critical) > 3)
                        {
                            <div class="text-muted small">
                                + @(r.Blockers.Count(b => b.Severity == GateSeverity.Critical) - 3) more critical blockers —
                                <button class="btn btn-link btn-sm p-0" @onclick='() => _tab = "blockers"'>view all</button>
                            </div>
                        }
                    </div>
                </div>
            }
        };

    private RenderFragment ArtifactRow(string name, bool loaded) =>
        __builder =>
        {
            string icon  = loaded ? "✓" : "○";
            string color = loaded ? "var(--color-success)" : "var(--text-muted)";
            <li style="display:flex;align-items:center;gap:8px">
                <span style="color:@color;font-size:13px">@icon</span>
                <span>@name</span>
                @if (!loaded)
                {
                    <span class="text-muted small">not loaded</span>
                }
            </li>
        };

    private RenderFragment GateScoreRow(string phase, ReadinessDecision decision) =>
        __builder =>
        {
            string cls = StateClass(decision.State);
            <div style="display:flex;align-items:center;gap:12px">
                <div style="width:36px;height:36px;flex-shrink:0">
                    @RenderScoreRing(decision.Score, decision.State, 36)
                </div>
                <div>
                    <div style="font-size:var(--text-sm);font-weight:600">@phase</div>
                    <div class="dr-gate-state-badge @cls" style="margin-top:2px">
                        @StateLabel(decision.State)
                    </div>
                </div>
            </div>
        };

    // ── Gate detail tab ────────────────────────────────────────────────────────

    private RenderFragment RenderGateTab(DeliveryGate gate) =>
        __builder =>
        {
            string cls = StateClass(gate.State);

            <div class="dr-gate-header">
                <div class="dr-gate-score-area">
                    @RenderScoreRing(gate.Score, gate.State, 72)
                </div>
                <div class="dr-gate-info">
                    <h3>@gate.Phase Readiness Gate</h3>
                    <div class="dr-gate-state-badge @cls">
                        @StateIcon(gate.State) @StateLabel(gate.State)
                    </div>
                    <div class="text-muted small mt-2">
                        @gate.PassedChecks.Count passed · @gate.FailedChecks.Count failed
                        @if (gate.Blockers.Count > 0)
                        {
                            <span> · @gate.Blockers.Count blocker(s)</span>
                        }
                    </div>
                </div>
            </div>

            <div class="dr-check-columns">
                <div class="dr-check-section is-passed">
                    <div class="dr-check-section-title">Passed Checks (@gate.PassedChecks.Count)</div>
                    @if (gate.PassedChecks.Count == 0)
                    {
                        <div class="text-muted small">No checks passed yet.</div>
                    }
                    else
                    {
                        <ul class="dr-check-list">
                            @foreach (var c in gate.PassedChecks)
                            {
                                <li class="dr-check-item is-passed">
                                    <span class="dr-check-item-icon">✓</span>
                                    <span>@c</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
                <div class="dr-check-section is-failed">
                    <div class="dr-check-section-title">Failed Checks (@gate.FailedChecks.Count)</div>
                    @if (gate.FailedChecks.Count == 0)
                    {
                        <div class="text-muted small">All checks passed.</div>
                    }
                    else
                    {
                        <ul class="dr-check-list">
                            @foreach (var c in gate.FailedChecks)
                            {
                                <li class="dr-check-item is-failed">
                                    <span class="dr-check-item-icon">✗</span>
                                    <span>@c</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>

            @if (gate.Blockers.Count > 0)
            {
                <div>
                    <div class="fw-bold mb-3">Gate Blockers</div>
                    <div class="dr-blockers-list">
                        @foreach (var b in gate.Blockers)
                        {
                            @RenderBlockerCard(b)
                        }
                    </div>
                </div>
            }
        };

    // ── Blockers tab ───────────────────────────────────────────────────────────

    private RenderFragment RenderBlockersTab() =>
        __builder =>
        {
            var r = _report!;
            var filtered = ReadinessService.FilterBlockersBySeverity(
                ReadinessService.FilterBlockersByPhase(r.Blockers, _blockerPhaseFilter),
                _blockerSeverityFilter).ToList();

            <div class="dr-filter-strip">
                <label>Severity:</label>
                <select @bind="_blockerSeverityFilter">
                    <option value="">All</option>
                    @foreach (var s in Enum.GetValues<GateSeverity>())
                    {
                        <option value="@s">@s</option>
                    }
                </select>
                <label>Phase:</label>
                <select @bind="_blockerPhaseFilter">
                    <option value="">All</option>
                    <option value="Development">Development</option>
                    <option value="Testing">Testing</option>
                    <option value="Release">Release</option>
                </select>
                @if (filtered.Count != r.Blockers.Count)
                {
                    <span class="text-muted small">Showing @filtered.Count of @r.Blockers.Count</span>
                }
            </div>

            @if (filtered.Count == 0)
            {
                <div class="dr-empty">
                    <div class="dr-empty-icon">✓</div>
                    <div>No blockers@(r.Blockers.Count > 0 ? " match the current filter" : " found — all gates clear").</div>
                </div>
            }
            else
            {
                <div class="dr-blockers-list">
                    @foreach (var b in filtered)
                    {
                        @RenderBlockerCard(b)
                    }
                </div>
            }
        };

    private RenderFragment RenderBlockerCard(ReadinessBlocker b) =>
        __builder =>
        {
            <div class="dr-blocker-card @SevClass(b.Severity)">
                <div class="dr-blocker-header">
                    <span class="dr-blocker-title">@b.Title</span>
                    <span class="dr-badge @SevBadgeClass(b.Severity)">@b.Severity</span>
                    @if (!string.IsNullOrEmpty(b.Phase))
                    {
                        <span class="dr-badge dr-badge-phase">@b.Phase</span>
                    }
                    @if (!string.IsNullOrEmpty(b.RuleCode))
                    {
                        <span class="dr-badge dr-badge-category">@b.RuleCode</span>
                    }
                </div>
                <div class="dr-blocker-desc">@b.Description</div>
                @if (!string.IsNullOrEmpty(b.Category))
                {
                    <div class="dr-blocker-meta">
                        <span class="text-muted small">Category: @b.Category</span>
                    </div>
                }
            </div>
        };

    // ── Recommendations tab ────────────────────────────────────────────────────

    private RenderFragment RenderRecommendationsTab() =>
        __builder =>
        {
            var r = _report!;
            var filtered = ReadinessService.SearchRecommendations(
                ReadinessService.FilterRecommendationsByPhase(r.Recommendations, _recPhaseFilter),
                _recSearch).ToList();

            <div class="dr-filter-strip">
                <label>Phase:</label>
                <select @bind="_recPhaseFilter">
                    <option value="">All</option>
                    <option value="Development">Development</option>
                    <option value="Testing">Testing</option>
                    <option value="Release">Release</option>
                </select>
                <input type="search" class="form-control form-control-sm" style="max-width:280px"
                       placeholder="Search recommendations…"
                       @bind="_recSearch" @bind:event="oninput" />
                @if (filtered.Count != r.Recommendations.Count)
                {
                    <span class="text-muted small">Showing @filtered.Count of @r.Recommendations.Count</span>
                }
            </div>

            @if (filtered.Count == 0)
            {
                <div class="dr-empty">
                    <div class="dr-empty-icon">✓</div>
                    <div>No recommendations@(r.Recommendations.Count > 0 ? " match the current filter" : " — delivery readiness looks good").</div>
                </div>
            }
            else
            {
                <div class="dr-rec-list">
                    @foreach (var rec in filtered)
                    {
                        <div class="dr-rec-item">
                            <div class="dr-rec-text">@rec.Text</div>
                            <div class="dr-rec-meta">
                                <span class="dr-badge @SevBadgeClass(rec.Priority)">@rec.Priority</span>
                                @if (!string.IsNullOrEmpty(rec.Phase))
                                {
                                    <span class="dr-badge dr-badge-phase">@rec.Phase</span>
                                }
                                @if (!string.IsNullOrEmpty(rec.Category))
                                {
                                    <span class="dr-badge dr-badge-category">@rec.Category</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        };
}
