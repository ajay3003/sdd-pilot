@page "/ai-qa-auditor"
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using BirkNext.Web.GraphQL
@inject IBirkNextClient Client
@inject IConstitutionAnalysisService ConstitutionService
@inject IPlanAnalysisService PlanService
@inject IQAReadinessService ReadinessService
@inject IDashboardSnapshotService DashboardSnapshot

<PageTitle>QA Readiness</PageTitle>

<div class="qa-auditor-page">

    <div class="qa-hero traceability-hero">
        <p class="section-kicker">Executive Command Center</p>
        <h1 class="page-title">QA Readiness</h1>
        <p class="page-subtitle">Assess cross-artifact readiness across Constitution, Specification, Plan, and Tasks. Answers whether the feature is ready for implementation, testing, and release.</p>
    </div>

    <!-- ══ Cross-Artifact Readiness Assessment ══════════════════════════════ -->
    <div class="qr-section">

        <!-- Artifact Input Panel -->
        <div class="qr-input-panel">
            <div class="qr-input-panel-header">
                <span class="qr-input-panel-title">Load Artifacts</span>
                @if (_readinessReport is not null)
                {
                    <button class="qr-input-panel-toggle" @onclick="() => _qrInputExpanded = !_qrInputExpanded">
                        @(_qrInputExpanded ? "▾ Collapse" : "▸ Expand")
                    </button>
                }
            </div>

            @if (_qrInputExpanded)
            {
                <div class="qr-artifact-grid">

                    <!-- Constitution (optional but enables compliance scoring) -->
                    <div class="qr-artifact-card @(!string.IsNullOrEmpty(_qrConstitutionText) ? "is-loaded" : "")">
                        <div class="qr-artifact-card-header">
                            <span class="qr-artifact-icon" aria-hidden="true">📜</span>
                            <span class="qr-artifact-name">Constitution</span>
                            <span class="qr-artifact-status @(!string.IsNullOrEmpty(_qrConstitutionText) ? "is-loaded" : "")">
                                @(!string.IsNullOrEmpty(_qrConstitutionText) ? "Loaded" : "Empty")
                            </span>
                        </div>
                        <textarea class="qr-artifact-textarea" placeholder="Paste constitution.md here…" rows="3"
                                  @bind="_qrConstitutionText"></textarea>
                        @if (!string.IsNullOrEmpty(_qrConstitutionText))
                        {
                            <div class="qr-artifact-footer">
                                <span>@_qrConstitutionText.Split('\n').Length lines</span>
                                <button class="qr-artifact-clear" @onclick='() => _qrConstitutionText = string.Empty'>Clear</button>
                            </div>
                        }
                    </div>

                    <!-- Specification (required for spec score) -->
                    <div class="qr-artifact-card @(!string.IsNullOrEmpty(_qrSpecText) ? "is-loaded" : "is-required")">
                        <div class="qr-artifact-card-header">
                            <span class="qr-artifact-icon" aria-hidden="true">📋</span>
                            <span class="qr-artifact-name">Specification</span>
                            <span class="qr-artifact-required-badge">Required</span>
                            <span class="qr-artifact-status @(!string.IsNullOrEmpty(_qrSpecText) ? "is-loaded" : "")">
                                @(!string.IsNullOrEmpty(_qrSpecText) ? "Loaded" : "Empty")
                            </span>
                        </div>
                        <textarea class="qr-artifact-textarea" placeholder="Paste spec.md here…" rows="3"
                                  @bind="_qrSpecText"></textarea>
                        @if (!string.IsNullOrEmpty(_qrSpecText))
                        {
                            <div class="qr-artifact-footer">
                                <span>@_qrSpecText.Split('\n').Length lines</span>
                                <button class="qr-artifact-clear" @onclick='() => _qrSpecText = string.Empty'>Clear</button>
                            </div>
                        }
                    </div>

                    <!-- Plan -->
                    <div class="qr-artifact-card @(!string.IsNullOrEmpty(_qrPlanText) ? "is-loaded" : "")">
                        <div class="qr-artifact-card-header">
                            <span class="qr-artifact-icon" aria-hidden="true">📐</span>
                            <span class="qr-artifact-name">Plan</span>
                            <span class="qr-artifact-status @(!string.IsNullOrEmpty(_qrPlanText) ? "is-loaded" : "")">
                                @(!string.IsNullOrEmpty(_qrPlanText) ? "Loaded" : "Empty")
                            </span>
                        </div>
                        <textarea class="qr-artifact-textarea" placeholder="Paste plan.md here…" rows="3"
                                  @bind="_qrPlanText"></textarea>
                        @if (!string.IsNullOrEmpty(_qrPlanText))
                        {
                            <div class="qr-artifact-footer">
                                <span>@_qrPlanText.Split('\n').Length lines</span>
                                <button class="qr-artifact-clear" @onclick='() => _qrPlanText = string.Empty'>Clear</button>
                            </div>
                        }
                    </div>

                    <!-- Tasks -->
                    <div class="qr-artifact-card @(!string.IsNullOrEmpty(_qrTaskText) ? "is-loaded" : "")">
                        <div class="qr-artifact-card-header">
                            <span class="qr-artifact-icon" aria-hidden="true">✅</span>
                            <span class="qr-artifact-name">Tasks</span>
                            <span class="qr-artifact-status @(!string.IsNullOrEmpty(_qrTaskText) ? "is-loaded" : "")">
                                @(!string.IsNullOrEmpty(_qrTaskText) ? "Loaded" : "Empty")
                            </span>
                        </div>
                        <textarea class="qr-artifact-textarea" placeholder="Paste tasks.md here…" rows="3"
                                  @bind="_qrTaskText"></textarea>
                        @if (!string.IsNullOrEmpty(_qrTaskText))
                        {
                            <div class="qr-artifact-footer">
                                <span>@_qrTaskText.Split('\n').Length lines</span>
                                <button class="qr-artifact-clear" @onclick='() => _qrTaskText = string.Empty'>Clear</button>
                            </div>
                        }
                    </div>

                </div>

                <div class="qr-analyze-bar">
                    <span class="qr-loaded-summary">
                        @if (string.IsNullOrWhiteSpace(_qrSpecText))
                        { <span>Load at least a Specification to assess readiness</span> }
                        else
                        { <span>Specification loaded · @QrAdditionalCount additional artifact@(QrAdditionalCount != 1 ? "s" : "") loaded</span> }
                    </span>
                    <button class="qr-analyze-btn" disabled="@string.IsNullOrWhiteSpace(_qrSpecText)"
                            @onclick="RunReadinessAssessment">
                        Assess Readiness
                    </button>
                </div>
            }
        </div>

        <!-- ── Report ──────────────────────────────────────────────────────── -->
        @if (_readinessReport is not null)
        {
            <!-- Score ring + status -->
            <div class="qr-score-row">
                @RenderQrScoreRing(_readinessReport.OverallScore)
                <div>
                    <div class="qr-score-meta-title">@QrStatusLabel(_readinessReport.OverallStatus) Readiness</div>
                    <div class="qr-score-meta-sub">
                        @_readinessReport.OverallScore.ToString("0.#")% overall ·
                        @_readinessReport.Scores.Count(s => s.IsAssessed) of 5 categories assessed
                    </div>
                    <span class="qr-status-badge qr-status-@QrStatusClass(_readinessReport.OverallStatus)">
                        @QrStatusLabel(_readinessReport.OverallStatus)
                    </span>
                </div>
            </div>

            <!-- Category score cards -->
            <div class="qr-category-grid">
                @foreach (var score in _readinessReport.Scores)
                {
                    <div class='qr-category-card @(score.IsAssessed ? "is-" + QrStatusClass(score.Status) : "is-not-assessed")'
                         @onclick="() => ToggleCategoryDetail(score.Category)"
                         title="Click to see signals and weaknesses">
                        <div class="qr-category-score">
                            @(score.IsAssessed ? $"{score.Score:0.#}" : "—")
                        </div>
                        <div class="qr-category-name">@QrShortCategory(score.Category)</div>
                        <div class="qr-category-status">
                            @(score.IsAssessed ? QrStatusLabel(score.Status) : "Not loaded")
                        </div>
                    </div>
                }
            </div>

            <!-- Expanded category detail -->
            @if (_expandedCategory is not null)
            {
                var expandedScore = _readinessReport.Scores.FirstOrDefault(s => s.Category == _expandedCategory);
                @if (expandedScore is not null && expandedScore.IsAssessed)
                {
                    <div class="qr-detail-panel">
                        <div class="qr-detail-panel-title">@expandedScore.Category</div>
                        @if (expandedScore.Signals.Count > 0)
                        {
                            <ul class="qr-signal-list">
                                @foreach (var s in expandedScore.Signals)
                                { <li>@s</li> }
                            </ul>
                        }
                        @if (expandedScore.Weaknesses.Count > 0)
                        {
                            <ul class="qr-weak-list" style="margin-top:0.5rem;">
                                @foreach (var w in expandedScore.Weaknesses)
                                { <li>@w</li> }
                            </ul>
                        }
                    </div>
                }
            }

            <!-- Readiness gates -->
            <div class="qr-section-header" style="margin-top:1rem;">
                <span class="qr-section-title">Readiness Gates</span>
            </div>
            <div class="qr-gate-grid">
                @foreach (var gate in _readinessReport.Gates)
                {
                    <div class='qr-gate-card @(gate.IsReady ? "is-ready" : "is-blocked")'>
                        <div class="qr-gate-header">
                            <span class="qr-gate-icon" aria-hidden="true">@(gate.IsReady ? "✅" : "🚫")</span>
                            <span class="qr-gate-name">@gate.Name</span>
                        </div>
                        <div class="qr-gate-question">@gate.Question</div>
                        @if (!gate.IsReady && !string.IsNullOrEmpty(gate.BlockReason))
                        {
                            <div class="qr-gate-reason">@gate.BlockReason</div>
                        }
                    </div>
                }
            </div>

            <!-- Gaps -->
            @if (_readinessReport.Gaps.Count > 0)
            {
                <div class="qr-section-header" style="margin-top:1.25rem;">
                    <span class="qr-section-title">Readiness Gaps</span>
                    <span style="font-size:0.78rem;color:var(--clr-text-muted);">
                        @_readinessReport.Gaps.Count gap@(_readinessReport.Gaps.Count != 1 ? "s" : "") · sorted by severity
                    </span>
                </div>
                @foreach (var gap in _readinessReport.Gaps.Take(_gapShowAll ? 999 : 8))
                {
                    <div class="qr-gap-item sev-@gap.Severity.ToString().ToLowerInvariant()">
                        <span class="qr-gap-cat">@QrShortCategory(gap.Category)</span>
                        <span class="qr-sev-badge qr-sev-@gap.Severity.ToString().ToLowerInvariant()">@gap.Severity</span>
                        <span>@gap.Description</span>
                    </div>
                }
                @if (_readinessReport.Gaps.Count > 8 && !_gapShowAll)
                {
                    <button class="qr-analyze-btn" style="background:var(--clr-bg-subtle);color:var(--clr-primary);border:1px solid var(--clr-border);margin-top:0.25rem;"
                            @onclick="() => _gapShowAll = true">
                        Show all @_readinessReport.Gaps.Count gaps
                    </button>
                }
            }

            <!-- Recommendations -->
            @if (_readinessReport.Recommendations.Count > 0)
            {
                <div class="qr-section-header" style="margin-top:1.25rem;">
                    <span class="qr-section-title">Recommendations</span>
                    <span style="font-size:0.78rem;color:var(--clr-text-muted);">
                        @_readinessReport.Recommendations.Count recommendation@(_readinessReport.Recommendations.Count != 1 ? "s" : "") · highest priority first
                    </span>
                </div>
                @foreach (var rec in _readinessReport.Recommendations.Take(_recShowAll ? 999 : 8))
                {
                    <div class="qr-rec-item">
                        <span class="qr-rec-bullet" aria-hidden="true">→</span>
                        <div>
                            <p class="qr-rec-text">@rec.Text</p>
                            <div class="qr-rec-meta">
                                <span class="qr-rec-target">@rec.TargetArtifact</span>
                                <span class="qr-sev-badge qr-sev-@rec.Priority.ToString().ToLowerInvariant()">@rec.Priority</span>
                            </div>
                        </div>
                    </div>
                }
                @if (_readinessReport.Recommendations.Count > 8 && !_recShowAll)
                {
                    <button class="qr-analyze-btn" style="background:var(--clr-bg-subtle);color:var(--clr-primary);border:1px solid var(--clr-border);margin-top:0.25rem;"
                            @onclick="() => _recShowAll = true">
                        Show all @_readinessReport.Recommendations.Count recommendations
                    </button>
                }
            }
        }

    </div><!-- /qr-section -->

    <!-- ── Divider before legacy API section ──────────────────────────────── -->
    <div class="qr-legacy-divider">
        <span>Legacy API Quality Metrics</span>
    </div>

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Calculating quality score&hellip;</p>
        </div>
    }
    else if (_error != null)
    {
        <div class="error-banner">
            <strong>Error:</strong> @_error
            <button class="btn-secondary" style="margin-left:1rem;" @onclick='() => LoadReportAsync(false)'>Retry</button>
        </div>
    }
    else if (_report != null)
    {
        <!-- Quality Score Banner -->
        <div class="qa-score-banner qa-score-banner--@ReadinessClass">
            <div class="qa-score-gauge qa-score-gauge--@ReadinessClass">
                @if (_report.ReadinessStatus == QaReadinessStatus.InsufficientData)
                {
                    <span class="qa-score-number qa-score-number--empty">--</span>
                }
                else
                {
                    <span class="qa-score-number">@_report.QualityScore</span>
                    <span class="qa-score-unit">/ 100</span>
                }
            </div>
            <div class="qa-score-info">
                <div class="qa-readiness-badge qa-readiness--@ReadinessClass">@ReadinessLabel</div>
                @if (_report.ReadinessStatus == QaReadinessStatus.InsufficientData)
                {
                    <p class="qa-score-subtitle">Add requirements, tests, and traceability links before QA readiness can be calculated.</p>
                }
                else
                {
                    <p class="qa-score-subtitle">
                        Quality score computed from @_report.TotalRequirements requirement(s) across @_report.ScoreDeductions.Count deduction category(ies).
                    </p>
                    @if (_report.ScoreDeductions.Any())
                    {
                        <div class="qa-deduction-pills">
                            @foreach (var d in _report.ScoreDeductions)
                            {
                                <span class="qa-deduction-pill">@d.Category &minus;@d.Points</span>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="qa-score-perfect">No deductions — full score.</p>
                    }
                }
            </div>
        </div>

        <!-- KPI Cards -->
        <div class="qa-kpi-grid">
            <div class="kpi-card kpi-card--@CoverageKpiClass">
                <div class="kpi-label">Requirement Coverage</div>
                <div class="kpi-value">@_report.CoveragePercent.ToString("F0")%</div>
                <div class="kpi-sublabel">@_report.TotalRequirements requirement(s)</div>
            </div>
            <div class="kpi-card kpi-card--@RiskKpiClass">
                <div class="kpi-label">Requirements at Risk</div>
                <div class="kpi-value">@_report.RequirementsAtRisk</div>
                <div class="kpi-sublabel">@_report.HighRiskRequirements with zero tests</div>
            </div>
            <div class="kpi-card kpi-card--@DriftKpiClass">
                <div class="kpi-label">Drift Findings</div>
                <div class="kpi-value">@_report.DriftFindingsCount</div>
                <div class="kpi-sublabel">@_report.HighRiskDriftFindings high-risk</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">Orphan Tests</div>
                <div class="kpi-value kpi-value--@(_report.OrphanTestCount > 0 ? "warn" : "ok")">@_report.OrphanTestCount</div>
                <div class="kpi-sublabel">not linked to any requirement</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">Unlinked Code Files</div>
                <div class="kpi-value kpi-value--@(_report.UnlinkedCodeFiles > 0 ? "warn" : "ok")">@_report.UnlinkedCodeFiles</div>
                <div class="kpi-sublabel">of @_report.TotalCodeFiles registered</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">High-Risk Requirements</div>
                <div class="kpi-value kpi-value--@(_report.HighRiskRequirements > 0 ? "danger" : "ok")">@_report.HighRiskRequirements</div>
                <div class="kpi-sublabel">no tests linked</div>
            </div>
        </div>

        <!-- AI Executive Summary -->
        <div class="qa-section">
            <div class="qa-section-header">
                <h2 class="qa-section-title">
                    <span class="nav-icon nav-icon-ai-auditor qa-section-icon" aria-hidden="true"></span>
                    AI Executive Summary
                </h2>
                @if (_report.AiExecutiveSummary == null && !_aiRequested
                     && _report.ReadinessStatus != QaReadinessStatus.InsufficientData)
                {
                    <button class="btn-primary btn-sm" @onclick="GenerateAiSummaryAsync" disabled="@_generatingAi">
                        @if (_generatingAi)
                        {
                            <span class="spinner-sm"></span>
                        }
                        Generate Summary
                    </button>
                }
                else if (_report.AiExecutiveSummary != null)
                {
                    <button class="btn-secondary btn-sm" @onclick="GenerateAiSummaryAsync" disabled="@_generatingAi">
                        @if (_generatingAi)
                        {
                            <span class="spinner-sm"></span>
                        }
                        Regenerate
                    </button>
                }
            </div>

            @if (_generatingAi)
            {
                <div class="qa-ai-loading">
                    <div class="spinner-sm"></div>
                    <span>Generating AI summary&hellip;</span>
                </div>
            }
            else if (_report.AiExecutiveSummary != null)
            {
                <p class="qa-exec-summary">@_report.AiExecutiveSummary</p>

                @if (_report.AiConcerns.Any())
                {
                    <h3 class="qa-ai-subheading">Key Concerns</h3>
                    <ul class="qa-ai-list">
                        @foreach (var concern in _report.AiConcerns)
                        {
                            <li>@concern</li>
                        }
                    </ul>
                }

                @if (_report.AiRecommendedActions.Any())
                {
                    <h3 class="qa-ai-subheading">AI Recommended Actions</h3>
                    <ul class="qa-ai-list qa-ai-list--actions">
                        @foreach (var action in _report.AiRecommendedActions)
                        {
                            <li>@action</li>
                        }
                    </ul>
                }
            }
            else if (_aiRequested)
            {
                <p class="qa-ai-unavailable">AI summary unavailable — check that <code>Anthropic:ApiKey</code> is configured in <code>appsettings.json</code>.</p>
            }
            else
            {
                <p class="qa-ai-placeholder">Click <strong>Generate Summary</strong> to get an AI-written executive overview, specific concerns, and additional recommended actions based on the quality data above.</p>
            }
        </div>

        <!-- Drift Findings -->
        @if (_report.DriftFindings.Any())
        {
            <div class="qa-section">
                <h2 class="qa-section-title">Spec Drift Findings</h2>
                <div class="qa-findings-list">
                    @foreach (var finding in _report.DriftFindings)
                    {
                        <div class="qa-finding-item qa-finding--@finding.Severity.ToString().ToLowerInvariant()">
                            <span class="impact-risk-badge impact-risk-badge--@finding.Severity.ToString().ToLowerInvariant()">@finding.Severity</span>
                            <span class="qa-finding-cat">@finding.Category</span>
                            <span class="qa-finding-desc">@finding.Description</span>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Top Requirements at Risk -->
        @if (_report.TopRisks.Any())
        {
            <div class="qa-section">
                <h2 class="qa-section-title">Top Requirements at Risk</h2>
                <div class="qa-risks-list">
                    @foreach (var risk in _report.TopRisks)
                    {
                        <div class="qa-risk-row">
                            <span class="impact-risk-badge impact-risk-badge--@risk.DriftRisk.ToString().ToLowerInvariant()">@risk.DriftRisk</span>
                            <span class="qa-risk-title">@risk.Requirement.Title</span>
                            <span class="qa-risk-meta">@risk.LinkedTestCount test(s) — @risk.DriftReason</span>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Recommended Actions -->
        @if (_report.RecommendedActions.Any())
        {
            <div class="qa-section">
                <h2 class="qa-section-title">Recommended Actions</h2>
                <ol class="qa-actions-list">
                    @foreach (var action in _report.RecommendedActions)
                    {
                        <li>@action</li>
                    }
                </ol>
            </div>
        }

        <!-- Score Deductions Detail -->
        @if (_report.ScoreDeductions.Any())
        {
            <div class="qa-section">
                <h2 class="qa-section-title">Score Deductions</h2>
                <div class="qa-deductions-table">
                    <div class="qa-deductions-header">
                        <span>Category</span>
                        <span>Reason</span>
                        <span>Points</span>
                    </div>
                    @foreach (var d in _report.ScoreDeductions)
                    {
                        <div class="qa-deductions-row">
                            <span class="qa-ded-cat">@d.Category</span>
                            <span class="qa-ded-reason">@d.Reason</span>
                            <span class="qa-ded-pts">&minus;@d.Points</span>
                        </div>
                    }
                    <div class="qa-deductions-footer">
                        <span></span>
                        <span>Final score</span>
                        <span class="qa-ded-total">@_report.QualityScore / 100</span>
                    </div>
                </div>
            </div>
        }

        <!-- Feature Chain Diagram -->
        <div class="qa-feature-chain">
            <h2 class="qa-section-title">Data Sources</h2>
            <div class="feature-chain-diagram">
                <div class="chain-item chain-item--active">
                    <span class="nav-icon nav-icon-traceability" aria-hidden="true"></span>
                    Traceability
                </div>
                <div class="chain-arrow">&rarr;</div>
                <div class="chain-item chain-item--active">
                    <span class="nav-icon nav-icon-impact-analysis" aria-hidden="true"></span>
                    Impact Analysis
                </div>
                <div class="chain-arrow">&rarr;</div>
                <div class="chain-item chain-item--active">
                    <span class="nav-icon nav-icon-spec-drift" aria-hidden="true"></span>
                    Spec Drift
                </div>
                <div class="chain-arrow">&rarr;</div>
                <div class="chain-item chain-item--active">
                    <span class="nav-icon nav-icon-code-trace" aria-hidden="true"></span>
                    Code Traceability
                </div>
                <div class="chain-arrow">&rarr;</div>
                <div class="chain-item chain-item--current">
                    <span class="nav-icon nav-icon-qa-auditor" aria-hidden="true"></span>
                    QA Auditor
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="empty-state-actions">
            <p>No data found. Make sure there are requirements and tests in the QA Artifact Library.</p>
        </div>
    }

</div>

@code {
    private const string ProjectId = "birknext-demo";

    private bool _loading = true;
    private string? _error;
    private IGetQaAuditReport_QaAuditReport? _report;
    private bool _generatingAi;
    private bool _aiRequested;

    protected override async Task OnInitializedAsync()
    {
        await LoadReportAsync(false);
    }

    private async Task LoadReportAsync(bool includeAiSummary)
    {
        if (!includeAiSummary) _loading = true;
        _error = null;
        try
        {
            var result = await Client.GetQaAuditReport.ExecuteAsync(ProjectId, includeAiSummary);
            if (result.Errors?.Any() == true)
                _error = result.Errors[0].Message;
            else
                _report = result.Data?.QaAuditReport;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task GenerateAiSummaryAsync()
    {
        _generatingAi = true;
        _aiRequested = true;
        StateHasChanged();
        try
        {
            await LoadReportAsync(true);
        }
        finally
        {
            _generatingAi = false;
        }
    }

    private string ReadinessClass => _report?.ReadinessStatus switch
    {
        QaReadinessStatus.Ready => "ready",
        QaReadinessStatus.ReviewNeeded => "review",
        QaReadinessStatus.InsufficientData => "insufficient",
        _ => "high-risk",
    };

    private string ReadinessLabel => _report?.ReadinessStatus switch
    {
        QaReadinessStatus.Ready => "Ready",
        QaReadinessStatus.ReviewNeeded => "Review Needed",
        QaReadinessStatus.InsufficientData => "Insufficient Data",
        _ => "High Risk",
    };

    private string CoverageKpiClass => (_report?.CoveragePercent ?? 0) >= 80 ? "good"
        : (_report?.CoveragePercent ?? 0) >= 50 ? "warn" : "danger";

    private string RiskKpiClass => (_report?.RequirementsAtRisk ?? 0) == 0 ? "good"
        : (_report?.HighRiskRequirements ?? 0) > 0 ? "danger" : "warn";

    private string DriftKpiClass => (_report?.DriftFindingsCount ?? 0) == 0 ? "good"
        : (_report?.HighRiskDriftFindings ?? 0) > 0 ? "danger" : "warn";

    // ── Cross-Artifact Readiness state ────────────────────────────────────────

    private string _qrConstitutionText = string.Empty;
    private string _qrSpecText         = string.Empty;
    private string _qrPlanText         = string.Empty;
    private string _qrTaskText         = string.Empty;
    private QAReadinessReport? _readinessReport;
    private bool _qrInputExpanded = true;
    private string? _expandedCategory;
    private bool _gapShowAll;
    private bool _recShowAll;

    private int QrAdditionalCount =>
        (string.IsNullOrWhiteSpace(_qrConstitutionText) ? 0 : 1) +
        (string.IsNullOrWhiteSpace(_qrPlanText) ? 0 : 1) +
        (string.IsNullOrWhiteSpace(_qrTaskText) ? 0 : 1);

    private void RunReadinessAssessment()
    {
        ConstitutionDocument? constitution = null;
        SpecTree?             spec         = null;
        PlanDocument?         plan         = null;
        TaskTree?             tasks        = null;

        if (!string.IsNullOrWhiteSpace(_qrConstitutionText))
            constitution = ConstitutionService.Parse(_qrConstitutionText);
        if (!string.IsNullOrWhiteSpace(_qrSpecText))
            spec = SpecExplorerService.Parse(_qrSpecText);
        if (!string.IsNullOrWhiteSpace(_qrPlanText))
            plan = PlanService.Parse(_qrPlanText);
        if (!string.IsNullOrWhiteSpace(_qrTaskText))
            tasks = TaskExplorerService.Parse(_qrTaskText);

        _readinessReport   = ReadinessService.Assess(constitution, spec, plan, tasks);
        DashboardSnapshot.Publish(_readinessReport);
        _qrInputExpanded   = false;
        _expandedCategory  = null;
        _gapShowAll        = false;
        _recShowAll        = false;
    }

    private void ToggleCategoryDetail(string category)
    {
        _expandedCategory = _expandedCategory == category ? null : category;
    }

    // ── Readiness rendering helpers ───────────────────────────────────────────

    private static string QrStatusClass(ReadinessStatus s) => s switch
    {
        ReadinessStatus.Ready       => "ready",
        ReadinessStatus.MostlyReady => "mostly",
        ReadinessStatus.NeedsWork   => "needs-work",
        _                           => "not-ready",
    };

    private static string QrStatusLabel(ReadinessStatus s) => s switch
    {
        ReadinessStatus.Ready       => "Ready",
        ReadinessStatus.MostlyReady => "Mostly Ready",
        ReadinessStatus.NeedsWork   => "Needs Work",
        _                           => "Not Ready",
    };

    private static string QrShortCategory(string category) => category switch
    {
        "Specification Quality" => "Spec",
        "Plan Quality"          => "Plan",
        "Task Readiness"        => "Tasks",
        "Traceability"          => "Traceability",
        "Compliance"            => "Compliance",
        _                       => category,
    };

    private RenderFragment RenderQrScoreRing(double pct) => __builder =>
    {
        const int r  = 44;
        const int cx = 60;
        const int cy = 60;
        var circumference = 2 * Math.PI * r;
        var offset   = circumference - pct / 100.0 * circumference;
        var variant  = pct >= 85 ? "is-ready" :
                       pct >= 65 ? "is-mostly" :
                       pct >= 40 ? "is-needs-work" : "is-not-ready";

        var svgHtml = $"<svg viewBox=\"0 0 120 120\">" +
                      $"<circle class=\"qr-score-ring-bg\" cx=\"{cx}\" cy=\"{cy}\" r=\"{r}\" />" +
                      $"<circle class=\"qr-score-ring-fill {variant}\" cx=\"{cx}\" cy=\"{cy}\" r=\"{r}\"" +
                      $" stroke-dasharray=\"{circumference:0.00}\" stroke-dashoffset=\"{offset:0.00}\" />" +
                      $"</svg>";

        __builder.OpenElement(0, "div");
        __builder.AddAttribute(1, "class", "qr-score-ring");
        __builder.AddMarkupContent(2, svgHtml);
        __builder.OpenElement(3, "div");
        __builder.AddAttribute(4, "class", "qr-score-label");
        __builder.AddMarkupContent(5, $"{pct:0.#}<small>/ 100</small>");
        __builder.CloseElement();
        __builder.CloseElement();
    };
}
