@page "/extract"
@using BirkNext.Web.Components
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@inject IExtractionSessionService SessionService
@inject BirkNext.Web.Services.IWorkspaceSessionService Workspace

<PageTitle>Analyze Specification</PageTitle>

<div class="review-page-shell">
    <PageHeader Title="Analyze Specification"
                Description="Upload or paste a specification document and generate review candidates for QA analysis." />

    <ExtractionInput OnExtractionCompleted="HandleExtractionCompleted" InitialSpec="@_initialSpec" />

    <section class="review-results-panel" aria-label="Specification review results">
        <div class="review-results-header">
            <div class="review-results-title">
                <p class="section-kicker">Review Candidates</p>
                <h2>Analysis Results</h2>
                <p>This is where extracted candidates appear for review, acceptance, and saving.</p>
            </div>
            <div class="review-summary-strip" aria-label="Analysis summary metrics">
                <div class="summary-slot" data-testid="requirements-metric">
                    <span>@RequirementMetric</span>
                    <small>Requirements</small>
                </div>
                <div class="summary-slot" data-testid="tests-metric">
                    <span>@TestMetric</span>
                    <small>Tests</small>
                </div>
                <div class="summary-slot" data-testid="clarifications-metric">
                    <span>@ClarificationMetric</span>
                    <small>Clarifications</small>
                </div>
                <div class="summary-slot" data-testid="candidates-metric">
                    <span>@CandidateMetric</span>
                    <small>Candidates</small>
                </div>
            </div>
        </div>

        @if (_pipelineResult is null)
        {
            <div class="extract-pre-state" data-testid="extract-pre-state">
                <div class="empty-state-icon" aria-hidden="true"></div>
                <h3>No review candidates yet</h3>
                <p>Analyze a specification to generate:</p>
                <ul>
                    <li>Requirements</li>
                    <li>Test Cases</li>
                    <li>Clarifications</li>
                    <li>Review Suggestions</li>
                </ul>
                <p class="empty-state-flow">Review &rarr; Accept &rarr; Save &rarr; Track on Dashboard</p>
            </div>
        }
        else
        {
            <ExtractionReviewList PipelineResult="_pipelineResult" InitialSession="_sessionSnapshot" SpecMarkdown="@(_pipelineResult?.SpecMarkdown ?? string.Empty)" />
        }
    </section>
</div>

@code {
    private ExtractionPipelineResult? _pipelineResult;
    private ExtractionSessionSnapshot? _sessionSnapshot;
    private string? _initialSpec;

    private int RequirementMetric => _pipelineResult?.RequirementCount ?? 0;
    private int TestMetric => _pipelineResult?.TestCount ?? 0;
    private int ClarificationMetric => _pipelineResult?.NeedsClarificationCount ?? 0;
    private int CandidateMetric => _pipelineResult?.Candidates.Count ?? 0;

    protected override async Task OnInitializedAsync()
    {
        // Pre-load spec from workspace so the user can run analysis without re-uploading.
        var cached = Workspace.Get(WorkspaceArtifactKind.Specification);
        if (cached is not null)
            _initialSpec = cached.Text;

        var session = await SessionService.LoadAsync();
        if (session is not null
            && !SessionService.IsExpired(session)
            && session.PipelineStatus == PipelineStatus.Success
            && session.Candidates.Count > 0
            && IsSessionForCurrentSpec(session))
        {
            _sessionSnapshot = session;
            _pipelineResult = ExtractionPipelineResult.Restore(session);
        }
    }

    private bool IsSessionForCurrentSpec(ExtractionSessionSnapshot session)
    {
        if (string.IsNullOrWhiteSpace(_initialSpec))
            return true;

        return string.Equals(session.SpecMarkdown, _initialSpec, StringComparison.Ordinal);
    }

    private void HandleExtractionCompleted(ExtractionPipelineResult result)
    {
        _sessionSnapshot = null;   // new extraction — ExtractionReviewList saves its own initial session
        _pipelineResult = result;
    }
}
