@page "/plan-explorer"
@using BirkNext.Web.Components
@using BirkNext.Web.Components.Explorers
@using BirkNext.Web.Models
@using BirkNext.Web.Services.Explorers
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager NavigationManager
@inject BirkNext.Web.Services.IPlanAnalysisService PlanService

<PageTitle>Plan Explorer — QA Review Studio</PageTitle>

<div class="pe-page">

    <PageHeader Title="Plan Explorer"
                Description="@ArtifactExplorerRoles.Purpose(WorkspaceArtifactType.Plan)" />

    <ArtifactExplorerHost @ref="_host" Role="WorkspaceArtifactType.Plan" OnStateChanged="OnArtifactChanged">
        @if (_analysisError is not null)
        {
            <ExplorerAnalysisError Role="WorkspaceArtifactType.Plan" Message="@_analysisError" />
        }
        else
        {
            <div class="pe-page-body">
                <PlanExplorerPanel
                    PlanText="@_text"
                    ParsedPlan="@_parsed"
                    SemanticModel="@_semanticModel"
                    InitialView="@_initialView"
                    OnTextChanged="ImportFromPanel" />
            </div>
        }
    </ArtifactExplorerHost>

</div>

@code {
    private ArtifactExplorerHost? _host;
    private string _text = string.Empty;
    private string? _initialView;
    private string? _analysisError;
    private PlanDocument? _parsed;
    private PlanSemanticModel? _semanticModel;

    protected override void OnInitialized()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("view", out var view))
            _initialView = view;
    }

    // The panel's own paste box goes through the repository like every other import.
    private Task ImportFromPanel(string text) => _host?.ImportPastedAsync(text) ?? Task.CompletedTask;

    private void OnArtifactChanged(ArtifactExplorerState state)
    {
        var text = state.Content ?? string.Empty;
        if (string.Equals(text, _text, StringComparison.Ordinal)) return;
        _text = text;
        _parsed = null;
        _semanticModel = null;
        _analysisError = null;
        if (string.IsNullOrWhiteSpace(text)) return;
        try
        {
            _parsed = PlanService.Parse(text);
            _semanticModel = PlanAnalysisService.BuildSemanticModel(_parsed);
        }
        catch (Exception ex)
        {
            _parsed = null;
            _semanticModel = null;
            _analysisError = ex.Message;
        }
    }
}
