@page "/plan-explorer"
@using BirkNext.Web.Components
@using BirkNext.Web.Models
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject BirkNext.Web.Services.IWorkspaceSessionService Workspace
@inject BirkNext.Web.Services.IPlanAnalysisService PlanService

<PageTitle>Plan Explorer — QA Review Studio</PageTitle>

<div class="pe-page">

    <PageHeader Title="Plan Explorer"
                Description="Navigate and analyze plan.md artifacts — review architecture decisions, risks and constraints, complexity, and constitution compliance in one place." />

    <div class="pe-page-body">
        <PlanExplorerPanel
            PlanText="@_initialText"
            ParsedPlan="@_parsedPlan"
            SemanticModel="@_semanticModel"
            InitialView="@_initialView"
            OnTextChanged="OnPanelTextChanged" />
    </div>

</div>

@code {
    private string _initialText = string.Empty;
    private string? _initialView;
    private PlanDocument? _parsedPlan;
    private PlanSemanticModel? _semanticModel;

    private const string StorageKey = "pe-standalone-plan";

    protected override void OnInitialized()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("view", out var view))
            _initialView = view;

        var cached = Workspace.Get(WorkspaceArtifactKind.Plan);
        if (cached != null)
            _initialText = cached.Text;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!string.IsNullOrWhiteSpace(_initialText)) return;

        string? legacy = null;
        try { legacy = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey); } catch { }

        if (!string.IsNullOrWhiteSpace(legacy))
        {
            Workspace.Set(WorkspaceArtifactKind.Plan, legacy);
            _initialText = legacy;
            BuildSemanticModel(legacy);
            StateHasChanged();
        }
    }

    private void BuildSemanticModel(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            _semanticModel = null;
            _parsedPlan = null;
            return;
        }
        _parsedPlan = PlanService.Parse(text);
        _semanticModel = PlanAnalysisService.BuildSemanticModel(_parsedPlan);
    }

    private async Task OnPanelTextChanged(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        BuildSemanticModel(text);
        Workspace.Set(WorkspaceArtifactKind.Plan, text);
        try
        {
            if (string.IsNullOrWhiteSpace(Workspace.CurrentProject))
                await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, text);
            else
                await JS.InvokeVoidAsync("localStorage.removeItem", StorageKey);
        }
        catch { }
    }
}
