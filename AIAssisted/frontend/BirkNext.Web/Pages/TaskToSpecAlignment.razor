@page "/task-alignment"
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using BirkNext.Web.Components
@using BirkNext.Web.Services.Explorers
@inject IArtifactExplorerContext ArtifactContext
@inject TaskAlignmentSessionService AlignmentSession
@inject IArtifactParserService MarkdownEngine
@inject TaskSpecAlignmentService ImplementationReview
@inject IReportExportService ExportService
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Implementation Review</PageTitle>

<div class="ir-page">

    <PageHeader Title="Implementation Review"
                Description="Checks every task in the Task artifact for a reference that resolves to the Specification, and suggests where to focus testing. It does not read source code or verify that a task is implemented.">
        @if (_report is not null)
        {
            <button type="button" class="ir-action" data-testid="ir-reanalyze" @onclick="RunAnalysis">Re-analyze</button>
            <button type="button" class="ir-action" data-testid="ir-export" @onclick="ExportHtml">Export HTML</button>
        }
    </PageHeader>

    @if (!_loaded)
    {
        <p class="ir-muted" role="status">Loading current workspace artifacts…</p>
    }
    else if (NoWorkspace)
    {
        @* No imported project, no Sample Project and no document in the manual workspace. *@
        <section class="ir-empty" data-testid="ir-no-project">
            <p class="ir-empty-title">No project is currently loaded.</p>
            <p>Import a project ZIP to discover its Specification and Task artifacts automatically.</p>
            <p class="ir-empty-actions">
                <a class="btn-primary" href="project-import" data-testid="ir-import-project">Import Project</a>
                <a class="btn-secondary" href="sample-projects">Load Sample Project</a>
            </p>
        </section>
    }
    else if (_analysisError is not null)
    {
        <div class="notification notification-error" role="alert" data-testid="implementation-review-error">
            <strong>Implementation review could not be completed.</strong>
            <span>@_analysisError.Message</span>
            @if (ShowDiagnosticDetails)
            {
                <details>
                    <summary>Diagnostic details</summary>
                    <pre>@_analysisError</pre>
                </details>
            }
        </div>
    }

    @if (_loaded && !NoWorkspace && _report is null)
    {
        <section class="ir-prerun" aria-labelledby="ir-prerun-title" data-testid="ir-prerun">
            <h2 id="ir-prerun-title" class="ir-section-title">Not run</h2>
            <p class="ir-muted">The review needs the Specification and the Task artifact of <strong>@ProjectDisplay</strong> (@OriginLabel).</p>
            <ul class="ir-artifacts">
                @foreach (var (role, testId, label) in new[] { (WorkspaceArtifactType.Specification, "ir-artifact-spec", "Specification"), (WorkspaceArtifactType.Tasks, "ir-artifact-tasks", "Task artifact") })
                {
                    var state = RoleState(role);
                    <li class="ir-artifact" data-state="@RoleDataState(state)" data-testid="@testId">
                        <span class="ir-artifact-name">@label</span>
                        <span class="ir-artifact-state">@RoleStateLabel(state)</span>
                        @if (state == WorkspaceArtifactState.RoleAmbiguous)
                        {
                            <a class="ir-artifact-action" href="@ProjectInputPresentation.ExplorerRoute(role)" data-testid="@($"{testId}-choose")">Open @(role == WorkspaceArtifactType.Tasks ? "Task" : "Specification") Explorer</a>
                        }
                    </li>
                }
            </ul>
            <div class="ir-prerun-actions">
                <PrimaryButton OnClick="RunAnalysis" Disabled="@(!_specLoaded || !_tasksLoaded)">Run analysis</PrimaryButton>
                @if (!_specLoaded || !_tasksLoaded)
                {
                    <span class="ir-muted" aria-live="polite" data-testid="ir-needs">@NeedsMessage</span>
                }
            </div>
        </section>
    }
    else if (_report is not null)
    {
        var report = _report;
        var snapshot = AlignmentSession.Snapshot;

        <section class="ir-status" aria-label="Analysis status" data-testid="ir-status" data-state="@_currentness">
            <span class="ir-currentness" data-testid="ir-currentness">@CurrentnessLabel(_currentness)</span>
            <dl class="ir-provenance">
                <div><dt>Project</dt><dd>@ProjectDisplay <span class="ir-muted">(@OriginLabel)</span></dd></div>
                @if (snapshot is not null)
                {
                    <div><dt>Specification</dt><dd><code title="SHA-256 of the Specification the result was produced from">@TaskAlignmentSessionService.ShortHash(snapshot.SpecificationHash)</code></dd></div>
                    <div><dt>Task artifact</dt><dd><code title="SHA-256 of the Task artifact the result was produced from">@TaskAlignmentSessionService.ShortHash(snapshot.TasksHash)</code></dd></div>
                    <div><dt>Analyzed</dt><dd>@snapshot.AnalyzedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd></div>
                }
                <div><dt>Method</dt><dd>Deterministic rules</dd></div>
            </dl>
        </section>

        @if (_currentness == TaskAlignmentCurrentness.Stale)
        {
            <div class="ir-stale" role="status" data-testid="ir-stale">
                <p><strong>Results are stale.</strong> The Specification or the Task artifact changed after this analysis ran. The results below describe the earlier artifacts.</p>
                <button type="button" class="ir-action ir-action--primary" @onclick="RunAnalysis">Re-analyze</button>
            </div>
        }

        @if (report.TotalTasks == 0)
        {
            <section class="ir-empty" data-testid="ir-no-tasks">
                <p class="ir-empty-title">No tasks found in the Task artifact.</p>
                <p>Supported task lines: <code>T001 - Task title</code>, <code>T001: Task title</code> or <code>- [ ] T001 Task title</code>.</p>
            </section>
        }
        else
        {
            <div class="ir-tabs" role="tablist" aria-label="Implementation Review views">
                @Tab("alignment", "Spec alignment", report.FindingCount > 0 ? $"{report.FindingCount} finding{(report.FindingCount == 1 ? "" : "s")}" : null)
                @Tab("impact", "Risk & testing", null)
                @Tab("explorer", "Task Explorer", null)
            </div>

            @if (_activePageTab == "alignment")
            {
                var filtered = Filtered(report.Findings, AlignmentMatches(_activeFilter));

                <div class="ir-panel" role="tabpanel" id="ir-panel-alignment" aria-labelledby="ir-tab-alignment">
                    <div class="ir-cards" role="group" aria-label="Spec alignment summary" data-testid="ir-summary">
                        <div class="ir-card" data-testid="ir-card-analyzed">
                            <span class="ir-card-value">@report.TotalTasks</span>
                            <span class="ir-card-label">Tasks analyzed</span>
                            <span class="ir-card-hint">One result per task in the Task artifact</span>
                        </div>
                        <button type="button" class="ir-card ir-card--findings" data-has="@(report.FindingCount > 0 ? "true" : "false")" data-testid="ir-card-findings"
                                aria-pressed="@(_activeFilter == "findings" ? "true" : "false")" @onclick='() => SetFilter("findings")'>
                            <span class="ir-card-value">@report.FindingCount</span>
                            <span class="ir-card-label">Findings</span>
                            <span class="ir-card-hint">@(report.FindingCount == 0 ? "No task needs action" : $"{report.PossibleDeviations} possible deviation{(report.PossibleDeviations == 1 ? "" : "s")} · {report.NeedsReviewTasks} needs review")</span>
                        </button>
                        <button type="button" class="ir-card ir-card--linked" data-testid="ir-card-linked"
                                aria-pressed="@(_activeFilter == "Linked" ? "true" : "false")" @onclick='() => SetFilter("Linked")'>
                            <span class="ir-card-value">@report.LinkedTasks</span>
                            <span class="ir-card-label">Direct spec link</span>
                            <span class="ir-card-hint">Reference resolves in the Specification — a link, not coverage</span>
                        </button>
                        <button type="button" class="ir-card ir-card--technical" data-testid="ir-card-technical"
                                aria-pressed="@(_activeFilter == "TechnicalOnly" ? "true" : "false")" @onclick='() => SetFilter("TechnicalOnly")'>
                            <span class="ir-card-value">@report.TechnicalOnlyTasks</span>
                            <span class="ir-card-label">Technical only</span>
                            <span class="ir-card-hint">Setup, infrastructure or test work — direct spec link not expected</span>
                        </button>
                    </div>

                    @if (report.FindingCount == 0)
                    {
                        <p class="ir-clear" data-testid="ir-zero-findings">
                            <strong>No findings.</strong> Every task either references a requirement, success criterion or user story that exists in the Specification, or is technical work where a direct spec link is not expected.
                        </p>
                    }

                    <div class="ir-toolbar">
                        <div class="ir-chips" role="group" aria-label="Filter tasks by result" data-testid="ir-filters">
                            @Chip("all", "All", report.TotalTasks, false)
                            @Chip("findings", "Findings", report.FindingCount, false)
                            @Chip("PossibleDeviation", "Possible deviation", report.PossibleDeviations, false)
                            @Chip("NeedsReview", "Needs review", report.NeedsReviewTasks, false)
                            @Chip("Linked", "Direct spec link", report.LinkedTasks, false)
                            @Chip("TechnicalOnly", "Technical only", report.TechnicalOnlyTasks, false)
                        </div>
                        @SearchBox()
                    </div>

                    <p class="ir-showing" aria-live="polite" data-testid="ir-showing">Showing @filtered.Count of @report.TotalTasks task results</p>

                    @if (filtered.Count == 0)
                    {
                        <div class="ir-empty ir-empty--inline" data-testid="ir-filter-empty">
                            <p>@(_activeFilter == "findings" && string.IsNullOrWhiteSpace(_search) ? "No findings — no task needs review or may deviate from the Specification." : "No task results match the filter.")</p>
                            <button type="button" class="ir-link-button" @onclick="ClearFilters">Show all tasks</button>
                        </div>
                    }
                    else
                    {
                        <ul class="ir-list" aria-label="Task results" data-testid="ir-results">
                            @foreach (var result in filtered)
                            {
                                var key = "a-" + result.TaskId;
                                var expanded = _expandedFindings.Contains(key);
                                <li class="ir-row" data-status="@result.Status" data-testid="ir-row">
                                    <button type="button" class="ir-row-toggle" aria-expanded="@(expanded ? "true" : "false")" aria-controls="ir-detail-@key" @onclick="() => ToggleFinding(key)">
                                        <span class="ir-task-id">@result.TaskId</span>
                                        <span class="ir-row-title">@result.Title</span>
                                        <span class="ir-row-meta">
                                            <span class="ir-status-badge" data-status="@result.Status">@StatusLabel(result.Status)</span>
                                            @foreach (var match in result.Matches.Take(3))
                                            {
                                                <span class="ir-ref">@match.ItemId</span>
                                            }
                                            @if (result.Matches.Count > 3)
                                            {
                                                <span class="ir-more">+@(result.Matches.Count - 3)</span>
                                            }
                                            @TopicChips(result.AffectedAreas, 3)
                                        </span>
                                        <span class="ir-chevron" aria-hidden="true"></span>
                                    </button>
                                    @if (expanded)
                                    {
                                        <div class="ir-detail" id="ir-detail-@key" data-testid="ir-detail">
                                            @TaskTextSection(result)
                                            <section class="ir-detail-section" aria-label="Spec links">
                                                <h3>Spec links</h3>
                                                @if (result.Matches.Count > 0)
                                                {
                                                    <ul class="ir-links">
                                                        @foreach (var match in result.Matches)
                                                        {
                                                            <li><span class="ir-ref">@match.ItemId</span> <span class="ir-link-type">@SpecMatchTypeLabel(match.MatchType)</span> <span class="ir-link-title">@match.Title</span></li>
                                                        }
                                                    </ul>
                                                }
                                                else
                                                {
                                                    <p class="ir-muted">@(result.Status == AlignmentStatus.TechnicalOnly ? "None — a direct spec link is not expected for this task." : "None.")</p>
                                                }
                                                @if (result.UnresolvedReferences.Count > 0)
                                                {
                                                    <p class="ir-unresolved" data-testid="ir-unresolved">Not found in the Specification: @string.Join(", ", result.UnresolvedReferences)</p>
                                                }
                                            </section>
                                            <section class="ir-detail-section" aria-label="Classification">
                                                <h3>Why “@StatusLabel(result.Status)”</h3>
                                                <p>@result.Reason</p>
                                                <p class="ir-muted" data-testid="ir-basis">Rule: @result.ClassificationBasis@(result.ClassificationSignal is { Length: > 0 } signal ? $" (matched “{signal}”)" : "").</p>
                                            </section>
                                            <section class="ir-detail-section" aria-label="Next step">
                                                <h3>Next step</h3>
                                                <p>@result.RecommendedAction</p>
                                            </section>
                                            @if (result.AffectedAreas.Count > 0)
                                            {
                                                <section class="ir-detail-section" aria-label="Topics">
                                                    <h3>Topics</h3>
                                                    <p class="ir-topics">@TopicChips(result.AffectedAreas, int.MaxValue)</p>
                                                </section>
                                            }
                                        </div>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>
            }
            else if (_activePageTab == "impact")
            {
                var impactFiltered = Filtered(report.Findings, ImpactMatches(_activeImpactFilter));

                <div class="ir-panel" role="tabpanel" id="ir-panel-impact" aria-labelledby="ir-tab-impact">
                    <p class="ir-scope" data-testid="ir-risk-scope">Test priority comes from the topics a task touches, matched by keyword. It points testing effort; it is not a measured risk or a defect. For change-driven impact, use <a href="/impact-analysis">Impact Analysis</a>.</p>

                    <div class="ir-cards ir-cards--five" role="group" aria-label="Test priority summary" data-testid="ir-risk-summary">
                        @PriorityCard("High", report.HighImpactTasks, "High test priority", "Security, authorization, events or audit")
                        @PriorityCard("Medium", report.MediumImpactTasks, "Medium test priority", "Ingestion, health, validation or errors")
                        @PriorityCard("Low", report.LowImpactTasks, "Low test priority", "Setup or other topics")
                        @PriorityCard("Unknown", report.UnknownImpactTasks, "Not determined", "No topic detected")
                        @PriorityCard("Regression", report.RegressionCandidates, "Regression focus", "High-priority topics, or a finding with test-relevant topics")
                    </div>

                    <div class="ir-toolbar">
                        <div class="ir-chips" role="group" aria-label="Filter tasks by test priority" data-testid="ir-risk-filters">
                            @Chip("all", "All", report.TotalTasks, true)
                            @Chip("High", "High", report.HighImpactTasks, true)
                            @Chip("Medium", "Medium", report.MediumImpactTasks, true)
                            @Chip("Low", "Low", report.LowImpactTasks, true)
                            @Chip("Unknown", "Not determined", report.UnknownImpactTasks, true)
                            @Chip("Regression", "Regression focus", report.RegressionCandidates, true)
                        </div>
                        @SearchBox()
                    </div>

                    <p class="ir-showing" aria-live="polite">Showing @impactFiltered.Count of @report.TotalTasks tasks</p>

                    @if (impactFiltered.Count == 0)
                    {
                        <div class="ir-empty ir-empty--inline">
                            <p>No task matches the filter.</p>
                            <button type="button" class="ir-link-button" @onclick="ClearFilters">Show all tasks</button>
                        </div>
                    }
                    else
                    {
                        <ul class="ir-list" aria-label="Tasks by test priority" data-testid="ir-risk-results">
                            @foreach (var result in impactFiltered)
                            {
                                var key = "r-" + result.TaskId;
                                var expanded = _expandedFindings.Contains(key);
                                <li class="ir-row" data-priority="@result.ImpactLevel" data-testid="ir-risk-row">
                                    <button type="button" class="ir-row-toggle" aria-expanded="@(expanded ? "true" : "false")" aria-controls="ir-detail-@key" @onclick="() => ToggleFinding(key)">
                                        <span class="ir-task-id">@result.TaskId</span>
                                        <span class="ir-row-title">@result.Title</span>
                                        <span class="ir-row-meta">
                                            <span class="ir-priority-badge" data-priority="@result.ImpactLevel">@PriorityLabel(result.ImpactLevel)</span>
                                            @if (result.IsRegressionCandidate)
                                            {
                                                <span class="ir-regression">Regression focus</span>
                                            }
                                            @TopicChips(result.AffectedAreas, 3)
                                        </span>
                                        <span class="ir-chevron" aria-hidden="true"></span>
                                    </button>
                                    @if (expanded)
                                    {
                                        <div class="ir-detail" id="ir-detail-@key">
                                            @TaskTextSection(result)
                                            <section class="ir-detail-section" aria-label="Why this priority">
                                                <h3>Why “@PriorityLabel(result.ImpactLevel)”</h3>
                                                <p>@(string.IsNullOrEmpty(result.RiskReason) ? PriorityFallback(result) : result.RiskReason)</p>
                                            </section>
                                            <section class="ir-detail-section" aria-label="Suggested test focus">
                                                <h3>Suggested test focus</h3>
                                                @if (result.RecommendedTests.Count > 0)
                                                {
                                                    <ul class="ir-tests">
                                                        @foreach (var test in result.RecommendedTests)
                                                        {
                                                            <li>@test</li>
                                                        }
                                                    </ul>
                                                    <p class="ir-muted">Generic suggestions per topic, not tests found in the project.</p>
                                                }
                                                else
                                                {
                                                    <p class="ir-muted">No suggestion — no topic was detected for this task.</p>
                                                }
                                            </section>
                                            <section class="ir-detail-section" aria-label="Spec alignment">
                                                <h3>Spec alignment</h3>
                                                <p><span class="ir-status-badge" data-status="@result.Status">@StatusLabel(result.Status)</span>
                                                    @foreach (var match in result.Matches)
                                                    {
                                                        <span class="ir-ref">@match.ItemId</span>
                                                    }
                                                </p>
                                            </section>
                                            @if (result.AffectedAreas.Count > 0)
                                            {
                                                <section class="ir-detail-section" aria-label="Topics">
                                                    <h3>Topics</h3>
                                                    <p class="ir-topics">@TopicChips(result.AffectedAreas, int.MaxValue)</p>
                                                </section>
                                            }
                                        </div>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>
            }
            else if (_activePageTab == "explorer")
            {
                <div class="ir-panel" role="tabpanel" id="ir-panel-explorer" aria-labelledby="ir-tab-explorer">
                    <TaskExplorerPanel TasksText="@_tasksText" Report="@_report" />
                </div>
            }
        }

        <nav class="ir-chain" aria-label="Related reviews" data-testid="ir-chain">
            <span>Related:</span>
            <a href="/implementation-review">Implementation Evidence Review</a> <span class="ir-muted">(source and test evidence)</span>
            <span aria-hidden="true">·</span>
            <a href="/spec-drift">Spec Drift</a>
            <span aria-hidden="true">·</span>
            <a href="/impact-analysis">Impact Analysis</a>
        </nav>
    }

</div>

@code {
    private string _specText = string.Empty;
    private string _tasksText = string.Empty;
    private bool _specLoaded;
    private bool _tasksLoaded;

    private bool _loaded;
    private string? _scope;
    private string? _projectName;
    private bool _workspaceHasArtifacts;
    private ArtifactExplorerState? _specState;
    private ArtifactExplorerState? _tasksState;

    private AlignmentReport? _report;
    private TaskAlignmentCurrentness _currentness = TaskAlignmentCurrentness.NotRun;
    private string _activeFilter = "all";
    private string _activeImpactFilter = "all";
    private string _search = string.Empty;
    private string _activePageTab = "alignment";
    private Exception? _analysisError;
    private readonly HashSet<string> _expandedFindings = [];

    protected override async Task OnInitializedAsync()
    {
        ArtifactContext.Changed += OnArtifactContextChanged;
        await LoadCurrentWorkspaceAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A project switch can happen without an artifact event (for example a restored selection); re-read on render when the scope differs.
        if (!firstRender && _loaded && !string.Equals(ArtifactContext.CurrentScope, _scope, StringComparison.Ordinal))
        {
            await LoadCurrentWorkspaceAsync();
            StateHasChanged();
        }
    }

    private void OnArtifactContextChanged(object? sender, EventArgs e) => _ = InvokeAsync(async () =>
    {
        await LoadCurrentWorkspaceAsync();
        StateHasChanged();
    });

    public void Dispose() => ArtifactContext.Changed -= OnArtifactContextChanged;

    /// <summary>
    /// Reads the Specification and Task artifacts of the current workspace through the explorers' role authority: an imported project,
    /// a Sample Project or the manual workspace. A role with several candidates is never picked here; the user chooses in its explorer.
    /// </summary>
    private async Task LoadCurrentWorkspaceAsync()
    {
        try
        {
            _analysisError = null;
            var scope = ArtifactContext.CurrentScope;
            var spec = await ArtifactContext.GetStateAsync(WorkspaceArtifactType.Specification);
            var tasks = await ArtifactContext.GetStateAsync(WorkspaceArtifactType.Tasks);
            var hasArtifacts = await WorkspaceArtifactStates.ManualWorkspaceHasArtifactsAsync(ArtifactContext);
            var projectChanged = _loaded && !string.Equals(scope, _scope, StringComparison.Ordinal);

            _scope = scope;
            _specState = spec;
            _tasksState = tasks;
            _workspaceHasArtifacts = hasArtifacts;
            _projectName = spec.ProjectName ?? tasks.ProjectName;
            _specText = spec.Status == ExplorerArtifactStatus.Loaded ? spec.Content ?? string.Empty : string.Empty;
            _tasksText = tasks.Status == ExplorerArtifactStatus.Loaded ? tasks.Content ?? string.Empty : string.Empty;
            _specLoaded = !string.IsNullOrEmpty(_specText);
            _tasksLoaded = !string.IsNullOrEmpty(_tasksText);
            _loaded = true;
            if (projectChanged) AlignmentSession.Clear();

            if (_specLoaded && _tasksLoaded)
            {
                RestoreOrRunAnalysis();
            }
            else
            {
                _report = null;
                _currentness = TaskAlignmentCurrentness.NotRun;
            }
        }
        catch (Exception ex)
        {
            _analysisError = ex;
            _report = null;
            _loaded = true;
            ClearAllArtifacts();
        }
    }

    /// <summary>The identity a result is bound to (with the two fingerprints): the workspace scope, never a display name.</summary>
    private string SessionKey => _scope ?? "manual-workspace";

    private bool NoWorkspace => _specState is { } spec && _tasksState is { } tasks
        && RoleState(WorkspaceArtifactType.Specification) == WorkspaceArtifactState.NoWorkspace
        && RoleState(WorkspaceArtifactType.Tasks) == WorkspaceArtifactState.NoWorkspace;

    private WorkspaceArtifactState RoleState(WorkspaceArtifactType role) =>
        (role == WorkspaceArtifactType.Tasks ? _tasksState : _specState) is { } state
            ? WorkspaceArtifactStates.Of(state, _workspaceHasArtifacts)
            : WorkspaceArtifactState.NoWorkspace;

    private WorkspaceArtifactOrigin Origin => WorkspaceArtifactStates.OriginOf(_scope, _workspaceHasArtifacts);

    private string ProjectDisplay => _projectName ?? (_scope is null || ProjectImportScope.IsImport(_scope) ? "the current workspace" : _scope);

    private string OriginLabel => Origin switch
    {
        WorkspaceArtifactOrigin.ProjectImport => "imported project",
        WorkspaceArtifactOrigin.SampleProject => "Sample Project",
        _ => "manual workspace",
    };

    private static string RoleStateLabel(WorkspaceArtifactState state) => state switch
    {
        WorkspaceArtifactState.RoleSelected => "Selected",
        WorkspaceArtifactState.RoleAmbiguous => "Needs selection",
        WorkspaceArtifactState.Unsupported => "Unable to read",
        _ => "Not available",
    };

    private static string RoleDataState(WorkspaceArtifactState state) => state switch
    {
        WorkspaceArtifactState.RoleSelected => "loaded",
        WorkspaceArtifactState.RoleAmbiguous => "selection-required",
        _ => "missing",
    };

    private string NeedsMessage
    {
        get
        {
            var needs = new[] { (WorkspaceArtifactType.Specification, "Specification"), (WorkspaceArtifactType.Tasks, "Tasks") }
                .Where(r => RoleState(r.Item1) == WorkspaceArtifactState.RoleAmbiguous).Select(r => r.Item2).ToList();
            return needs.Count > 0
                ? $"{string.Join(" and ", needs)} {(needs.Count > 1 ? "need" : "needs")} selection: choose one artifact in its explorer. Nothing is picked automatically."
                : "Both the Specification and the Task artifact must be available.";
        }
    }

    private void ClearAllArtifacts()
    {
        _specText = string.Empty;
        _tasksText = string.Empty;
        _specLoaded = false;
        _tasksLoaded = false;
        _report = null;
        _currentness = TaskAlignmentCurrentness.NotRun;
        AlignmentSession.Clear();
    }

    /// <summary>
    /// A result bound to the loaded artifacts is restored as Current. A result for this project whose Specification or
    /// Task fingerprint no longer matches is shown as Stale until Re-analyze. With no result the deterministic analysis runs.
    /// </summary>
    private void RestoreOrRunAnalysis()
    {
        _analysisError = null;

        if (string.IsNullOrWhiteSpace(_specText) || string.IsNullOrWhiteSpace(_tasksText))
        {
            _report = null;
            _currentness = TaskAlignmentCurrentness.NotRun;
            return;
        }

        var currentness = AlignmentSession.GetCurrentness(SessionKey, _specText, _tasksText);
        if (currentness != TaskAlignmentCurrentness.NotRun)
        {
            if (TryNormalizeReport(AlignmentSession.Report, out var cachedReport))
            {
                _report = cachedReport;
                _currentness = currentness;
                return;
            }

            AlignmentSession.Clear();
        }

        RunAnalysis();
    }

    private void RunAnalysis()
    {
        try
        {
            _analysisError = null;
            if (string.IsNullOrWhiteSpace(_specText) || string.IsNullOrWhiteSpace(_tasksText))
                return;

            var reviewContext = BuildReviewContext();
            _report = NormalizeReport(ImplementationReview.Analyse(reviewContext));
            AlignmentSession.SaveResult(_report, SessionKey, _specText, _tasksText);
            _currentness = TaskAlignmentCurrentness.Current;
            _expandedFindings.Clear();
        }
        catch (Exception ex)
        {
            _analysisError = ex;
            _report = null;
            _currentness = TaskAlignmentCurrentness.NotRun;
            AlignmentSession.Clear();
        }
    }

    private async Task ExportHtml()
    {
        if (_report is null) return;
        var html = ExportService.ExportImplementationReview(_report, ProjectDisplay, AlignmentSession.Snapshot, _currentness);
        await JS.InvokeVoidAsync("downloadHtmlFile", $"implementation-review-{DateTime.UtcNow:yyyy-MM-dd}.html", html);
    }

    private ReviewContext BuildReviewContext()
    {
        var parsed = MarkdownEngine.Parse(
            null,
            _specText,
            null,
            _tasksText);

        var constitutionSemanticModel = parsed.Constitution is not null
            ? ConstitutionAnalysisService.BuildSemanticModel(parsed.Constitution)
            : new ConstitutionSemanticModel();

        var specSemanticModel = parsed.Spec is not null
            ? SpecExplorerService.BuildSemanticModel(parsed.Spec, _specText)
            : new SpecificationSemanticModel();

        var planSemanticModel = parsed.Plan is not null
            ? PlanAnalysisService.BuildSemanticModel(parsed.Plan)
            : new PlanSemanticModel();

        var taskSemanticModel = parsed.Tasks is not null
            ? TaskExplorerService.BuildSemanticModel(parsed.Tasks)
            : new TaskSemanticModel();

        return ReviewContextFactory.Create(
            constitutionSemanticModel,
            specSemanticModel,
            planSemanticModel,
            taskSemanticModel,
            new DataModelSemanticModel());
    }

    private void SelectTab(string tab) => _activePageTab = tab;

    private void SetFilter(string filter) => _activeFilter = _activeFilter == filter ? "all" : filter;

    private void SetImpactFilter(string filter) => _activeImpactFilter = _activeImpactFilter == filter ? "all" : filter;

    private void ClearFilters()
    {
        _activeFilter = "all";
        _activeImpactFilter = "all";
        _search = string.Empty;
    }

    private void ToggleFinding(string key)
    {
        if (!_expandedFindings.Remove(key))
            _expandedFindings.Add(key);
    }

    /// <summary>Spec-alignment filter predicates; "findings" is exactly <see cref="TaskFinding.IsFinding"/>, the same rule as the Findings count.</summary>
    internal static Func<TaskFinding, bool> AlignmentMatches(string filter) => filter switch
    {
        "findings" => f => f.IsFinding,
        "PossibleDeviation" => f => f.Status == AlignmentStatus.PossibleDeviation,
        "NeedsReview" => f => f.Status == AlignmentStatus.NeedsReview,
        "Linked" => f => f.Status == AlignmentStatus.Linked,
        "TechnicalOnly" => f => f.Status == AlignmentStatus.TechnicalOnly,
        _ => _ => true,
    };

    internal static Func<TaskFinding, bool> ImpactMatches(string filter) => filter switch
    {
        "Regression" => f => f.IsRegressionCandidate,
        "High" => f => f.ImpactLevel == ImpactLevel.High,
        "Medium" => f => f.ImpactLevel == ImpactLevel.Medium,
        "Low" => f => f.ImpactLevel == ImpactLevel.Low,
        "Unknown" => f => f.ImpactLevel == ImpactLevel.Unknown,
        _ => _ => true,
    };

    private List<TaskFinding> Filtered(List<TaskFinding>? all, Func<TaskFinding, bool> predicate) =>
        (all ?? []).Where(predicate).Where(MatchesSearch).ToList();

    private bool MatchesSearch(TaskFinding f)
    {
        if (string.IsNullOrWhiteSpace(_search))
            return true;
        var q = _search.Trim();
        return f.TaskId.Contains(q, StringComparison.OrdinalIgnoreCase)
            || f.Title.Contains(q, StringComparison.OrdinalIgnoreCase)
            || (f.TaskText?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
            || f.Matches.Any(m => m.ItemId.Contains(q, StringComparison.OrdinalIgnoreCase))
            || f.AffectedAreas.Any(a => TaskTopicTaxonomy.Label(a).Contains(q, StringComparison.OrdinalIgnoreCase));
    }

    private RenderFragment Tab(string key, string label, string? badge) => __builder =>
    {
        var active = _activePageTab == key;
        <button type="button" role="tab" id="ir-tab-@key" class="ir-tab" aria-selected="@(active ? "true" : "false")"
                aria-controls="ir-panel-@key" data-testid="ir-tab-@key" @onclick="() => SelectTab(key)">
            @label
            @if (badge is not null)
            {
                <span class="ir-tab-badge">@badge</span>
            }
        </button>
    };

    private RenderFragment Chip(string key, string label, int count, bool impact) => __builder =>
    {
        var active = (impact ? _activeImpactFilter : _activeFilter) == key;
        <button type="button" class="ir-chip" aria-pressed="@(active ? "true" : "false")" data-filter="@key"
                @onclick="() => { if (impact) _activeImpactFilter = key; else _activeFilter = key; }">
            @label <span class="ir-chip-count">@count</span>
        </button>
    };

    private RenderFragment SearchBox() => __builder =>
    {
        <div class="ir-search">
            <label for="ir-search-@_activePageTab" class="visually-hidden">Search tasks</label>
            <input id="ir-search-@_activePageTab" type="search" placeholder="Search ID, title, spec item or topic" data-testid="ir-search"
                   value="@_search" @oninput="e => _search = e.Value?.ToString() ?? string.Empty" />
        </div>
    };

    private RenderFragment PriorityCard(string key, int count, string label, string hint) => __builder =>
    {
        <button type="button" class="ir-card ir-card--priority" data-priority="@key" data-testid="ir-priority-@key.ToLowerInvariant()"
                aria-pressed="@(_activeImpactFilter == key ? "true" : "false")" @onclick="() => SetImpactFilter(key)">
            <span class="ir-card-value">@count</span>
            <span class="ir-card-label">@label</span>
            <span class="ir-card-hint">@hint</span>
        </button>
    };

    private static RenderFragment TopicChips(List<AffectedArea> topics, int max) => __builder =>
    {
        foreach (var topic in topics.Take(max))
        {
            <span class="ir-topic" title="@TaskTopicTaxonomy.Label(topic)">@(max == int.MaxValue ? TaskTopicTaxonomy.Label(topic) : TaskTopicTaxonomy.ShortLabel(topic))</span>
        }
        if (topics.Count > max)
        {
            <span class="ir-more" title="@string.Join(", ", topics.Skip(max).Select(TaskTopicTaxonomy.Label))">+@(topics.Count - max) topics</span>
        }
    };

    private static RenderFragment TaskTextSection(TaskFinding result) => __builder =>
    {
        var text = CleanTaskText(result);
        if (text is not null)
        {
            <section class="ir-detail-section ir-detail-section--wide" aria-label="Task text">
                <h3>Task</h3>
                <p class="ir-task-text">@text</p>
            </section>
        }
    };

    /// <summary>The task's full line without the checkbox and ID, shown only when it says more than the (possibly shortened) title.</summary>
    internal static string? CleanTaskText(TaskFinding result)
    {
        if (string.IsNullOrWhiteSpace(result.TaskText))
            return null;
        var text = System.Text.RegularExpressions.Regex.Replace(result.TaskText.Trim(), @"^[-*]\s*\[[ xX]\]\s*", "");
        if (text.StartsWith(result.TaskId, StringComparison.OrdinalIgnoreCase))
            text = text[result.TaskId.Length..].TrimStart(' ', ':', '-', '–');
        var title = result.Title.TrimEnd('…', '.', ' ');
        return text.Trim() == result.Title.Trim() || (text.Length <= title.Length + 2 && text.StartsWith(title, StringComparison.Ordinal)) ? null : text;
    }

    private static string PriorityFallback(TaskFinding f) => f.ImpactLevel switch
    {
        ImpactLevel.Unknown => "No topic was detected in the task text.",
        _ when f.Status == AlignmentStatus.TechnicalOnly => "Technical-only work: setup, infrastructure or tests.",
        _ => "Only low-priority topics were detected.",
    };

    private static bool TryNormalizeReport(AlignmentReport? report, out AlignmentReport normalized)
    {
        if (report is null || report.Findings is null)
        {
            normalized = new AlignmentReport();
            return false;
        }

        normalized = NormalizeReport(report);
        return true;
    }

    private static AlignmentReport NormalizeReport(AlignmentReport report) => new()
    {
        TotalTasks = report.TotalTasks,
        LinkedTasks = report.LinkedTasks,
        TechnicalOnlyTasks = report.TechnicalOnlyTasks,
        NeedsReviewTasks = report.NeedsReviewTasks,
        PossibleDeviations = report.PossibleDeviations,
        HighImpactTasks = report.HighImpactTasks,
        MediumImpactTasks = report.MediumImpactTasks,
        LowImpactTasks = report.LowImpactTasks,
        UnknownImpactTasks = report.UnknownImpactTasks,
        RegressionCandidates = report.RegressionCandidates,
        Findings = (report.Findings ?? []).Where(f => f is not null).Select(NormalizeFinding).ToList(),
    };

    private static TaskFinding NormalizeFinding(TaskFinding finding) => new()
    {
        TaskId = finding.TaskId ?? string.Empty,
        Title = finding.Title ?? string.Empty,
        TaskText = finding.TaskText,
        Status = finding.Status,
        Risk = finding.Risk,
        Reason = finding.Reason ?? string.Empty,
        RecommendedAction = finding.RecommendedAction ?? string.Empty,
        ClassificationBasis = finding.ClassificationBasis ?? string.Empty,
        ClassificationSignal = finding.ClassificationSignal,
        Matches = (finding.Matches ?? []).Where(m => m is not null).Select(NormalizeMatch).ToList(),
        UnresolvedReferences = finding.UnresolvedReferences ?? [],
        AffectedAreas = finding.AffectedAreas ?? [],
        RecommendedTests = finding.RecommendedTests ?? [],
        ImpactLevel = finding.ImpactLevel,
        MatchReason = finding.MatchReason ?? string.Empty,
        RiskReason = finding.RiskReason ?? string.Empty,
        IsRegressionCandidate = finding.IsRegressionCandidate,
    };

    private static SpecMatch NormalizeMatch(SpecMatch match) => new()
    {
        ItemId = match.ItemId ?? string.Empty,
        Title = match.Title ?? string.Empty,
        MatchType = match.MatchType,
    };

