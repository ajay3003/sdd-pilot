@page "/manual-testing/plan"
@using BirkNext.TestPlanning
@using BirkNext.TestCoverage
@using BirkNext.Web.Services
@using M = BirkNext.Web.Services.ManualTestingPresentation
@using P = BirkNext.Web.Services.PlanPreparePresentation
@implements IDisposable
@inject IServiceProvider ServiceProvider
@inject NavigationManager Nav
@inject IJSRuntime JS

@* Planlegg og klargjør (2026-11-23): the one place a manual tester prepares test cases. One plan at a time as a master-detail editor — the
   plan's scenarios with their cases (several per scenario) on the left, the selected case on the right: title, purpose, preconditions, Test
   Data (need + linked assets), steps with an action and an expected result each, the expected result, and its Norwegian translation for review.
   User story, requirements and evidence are context. Tools of the plan are tabs of the same page: Eksporter (the existing Azure DevOps export),
   Versjoner (revision history), Kildeendringer (impact + safe refresh). Saving sends only human-owned edits against the plan's revision (a
   stale save is refused, never merged); unsaved edits are never lost. An archived plan opens read-only until restored. *@
<PageTitle>Planlegg og klargjør</PageTitle>
<NavigationLock ConfirmExternalNavigation="@Dirty" OnBeforeInternalNavigation="OnBeforeNavigation" />

<div class="mt msb-page mtp" data-testid="mtp" aria-busy="@(_loading ? "true" : "false")">
    <BirkNext.Web.Components.TestingWorkspaceHeader Workspace="Manuell testing" HomeRoute="@M.HomeRoute" Stages="M.Stages" Current="plan" Title="Planlegg og klargjør"
        ProjectName="@_ws?.ProjectName" Context="@_ws?.SnapshotBasis"
        Lead="Skriv og gjennomgå testtilfellene for scenarioene du valgte, oversett dem og eksporter dem til Azure DevOps Test Plans.">
        <Help><BirkNext.Web.Components.HelpLink Topic="manual-testing" Text="Slik fungerer det" /></Help>
    </BirkNext.Web.Components.TestingWorkspaceHeader>

    @if (_loading)
    {
        <div class="msb-skeleton" role="status" data-testid="mtp-loading"><span>Laster …</span></div>
    }
    else if (_ws?.ProjectKey is null)
    {
        <p class="msb-empty" data-testid="mtp-no-project">Velg en applikasjon i prosjektlisten først.</p>
    }
    else
    {
        @if (_error is { } error)
        {
            <p class="mt-alert" role="alert" data-testid="mtp-error">@error</p>
        }
        @if (_notice is { } notice)
        {
            <p class="mtp-notice" role="status" data-testid="mtp-notice">@notice</p>
        }

        @if (_selection.Count > 0 && _ws.Discovery is not null)
        {
            var notInPlan = _plan is null ? _selection : _selection.Where(id => _plan.Cases.All(c => c.Source.ScenarioId != id)).ToList();
            @if (notInPlan.Count > 0)
            {
                <section class="mtp-selection" aria-label="Valgte scenarioer" data-testid="mtp-selection">
                    <span><strong>@notInPlan.Count</strong> scenario@(notInPlan.Count == 1 ? "" : "er") valgt i Finn og forstå.</span>
                    @if (_plan is not null && CanWrite && !ReadOnlyPlan)
                    {
                        <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick="() => FromSelectionAsync(notInPlan, true)" data-testid="mtp-selection-add">Legg til i «@_plan.PlanName»</button>
                    }
                    @if (CanWrite)
                    {
                        <button type="button" class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="() => FromSelectionAsync(notInPlan, false)" data-testid="mtp-selection-new">Lag ny plan</button>
                    }
                    <a class="msb-link" href="@M.DiscoverRoute">Endre utvalget</a>
                </section>
            }
        }

        @if (_plans.Count == 0 && _plan is null)
        {
            <section class="msb-empty mtp-empty" data-testid="mtp-no-plan">
                <p>Ingen plan ennå. Velg scenarioer i <a href="@M.DiscoverRoute">Finn og forstå</a>, så lager du testtilfeller for dem her.</p>
                @if (_archived.Count > 0) { <p class="mt-muted msb-small"><a href="@($"{M.HomeRoute}?plans=archived")">@_archived.Count arkivert@(_archived.Count == 1 ? "" : "e") plan@(_archived.Count == 1 ? "" : "er")</a></p> }
            </section>
        }
        else if (_plan is { } plan)
        {
            var status = _ws.Plans?.PlanStatus is { } st && st.TryGetValue(plan.Id, out var s) ? s : null;
            <div class="mtp-planbar" data-testid="mtp-planbar">
                @if (_plans.Count > 1 || ReadOnlyPlan)
                {
                    <label class="mtp-field mtp-inline">
                        <span>Plan</span>
                        <select value="@plan.Id" @onchange="ChoosePlanAsync" data-testid="mtp-plan-select">
                            @foreach (var p in _plans)
                            {
                                <option value="@p.Id">@p.PlanName</option>
                            }
                            @if (ReadOnlyPlan) { <option value="@plan.Id">@plan.PlanName (arkivert)</option> }
                        </select>
                    </label>
                }
                else
                {
                    <h2 class="msb-h mtp-plan-name" data-testid="mtp-plan-name">@plan.PlanName</h2>
                }
                <span class="mt-muted msb-small" data-testid="mtp-plan-counts">@P.ScenarioCount(plan) scenario@(P.ScenarioCount(plan) == 1 ? "" : "er") · @ActiveCases(plan) testtilfelle@(ActiveCases(plan) == 1 ? "" : "r") · @plan.Cases.Count(c => c.Review == TestCaseReviewState.Accepted) godkjent · revisjon @plan.Revision</span>
                <span class="mtp-spacer"></span>
                @if (CanWrite && !ReadOnlyPlan)
                {
                    <button type="button" class="btn btn-secondary btn-sm" disabled="@(_busy || Dirty || !_translationAvailable)" title="@(Dirty ? "Lagre først." : _translationAvailable ? "Oversetter alle testtilfellene til norsk med den valgte tjenesten. Personskrevne og redigerte oversettelser beholdes." : "Oversettelse er ikke satt opp.")"
                            @onclick="TranslateAllAsync" data-testid="mtp-translate-all">Oversett alle</button>
                    <button type="button" class="msb-link" disabled="@(_busy || Dirty)" @onclick="() => _archiveAsk = true" data-testid="mtp-archive">Arkiver plan</button>
                }
            </div>

            @if (_archiveAsk)
            {
                <div class="mtp-confirm" role="group" aria-label="Arkiver plan" data-testid="mtp-archive-confirm">
                    <span>Arkiver «@plan.PlanName»? Planen blir skrivebeskyttet og vises under arkiverte planer. Ingenting slettes, og du kan gjenopprette den.</span>
                    <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick="ArchiveAsync" data-testid="mtp-archive-yes">Arkiver</button>
                    <button type="button" class="msb-link" @onclick="() => _archiveAsk = false" data-testid="mtp-archive-no">Avbryt</button>
                </div>
            }
            @if (ReadOnlyPlan)
            {
                <p class="mtp-source-banner" role="status" data-testid="mtp-archived">
                    <strong>Planen er arkivert</strong> og kan bare leses.
                    @if (CanWrite) { <button type="button" class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="UnarchiveAsync" data-testid="mtp-unarchive">Gjenopprett</button> }
                </p>
            }
            else if (status is not null && status.State is not ("Klar" or "Ikke sammenlignet"))
            {
                <p class="mtp-source-banner" role="status" data-testid="mtp-source-changed">
                    <strong>Kildegrunnlaget er endret.</strong> @status.Message
                    <button type="button" class="msb-link" @onclick='() => SetTool("changes")'>Se hva som er endret</button>
                </p>
            }

            <nav class="mtp-tools" aria-label="Plan" data-testid="mtp-tools">
                @foreach (var (key, label) in Tools)
                {
                    <button type="button" class="mtp-tool" aria-pressed="@(_tool == key ? "true" : "false")" @onclick="() => SetTool(key)" data-testid="mtp-tool" data-tool="@key">@label</button>
                }
                <a class="msb-link mtp-tools-advanced" href="@($"{M.LegacyPlanRoute}?draft={plan.Id}&advanced=1")" data-testid="mtp-advanced">Avanserte verktøy</a>
            </nav>

            @if (_tool == "export")
            {
                <BirkNext.Web.Components.AdoExportWizard Draft="plan" ProjectKey="@(plan.ProjectKey ?? _ws.ProjectKey)" CanWrite="CanWrite" Dirty="Dirty" />
            }
            else if (_tool == "versions" && Api is { } versionsApi)
            {
                <BirkNext.Web.Components.ManualTesting.PlanVersionsPanel Draft="plan" Api="versionsApi" CanWrite="CanWrite" ReadOnly="ReadOnlyPlan" Dirty="Dirty" Restored="ReplacedAsync" />
            }
            else if (_tool == "changes" && Api is { } changesApi)
            {
                <BirkNext.Web.Components.ManualTesting.PlanSourceChangesPanel Draft="plan" Api="changesApi" CanWrite="CanWrite" ReadOnly="ReadOnlyPlan" Dirty="Dirty" Refreshed="ReplacedAsync" />
            }
            else
            {
                var (rows, hidden) = P.Rows(plan, _showTechnical, _query);
                <div class="mtp-layout">
                    <nav class="mtp-master" aria-label="Scenarioer og testtilfeller" data-testid="mtp-master">
                        <div class="mtp-master-tools">
                            <input type="search" class="mtp-search" placeholder="Søk i scenarioer, krav …" aria-label="Søk" value="@_query" @oninput="e => _query = e.Value?.ToString() ?? string.Empty" data-testid="mtp-search" />
                            <label class="mtp-toggle"><input type="checkbox" checked="@_showTechnical" @onchange="e => _showTechnical = e.Value is true" data-testid="mtp-technical" /> Vis teknisk innhold</label>
                            @if (!_showTechnical && hidden > 0)
                            {
                                <span class="mt-muted msb-small" data-testid="mtp-hidden">@hidden teknisk@(hidden == 1 ? "" : "e") testtilfelle@(hidden == 1 ? "" : "r") skjult</span>
                            }
                        </div>
                        @if (rows.Count == 0)
                        {
                            <p class="msb-empty" data-testid="mtp-rows-none">@(hidden > 0 && !_showTechnical ? "Alle testtilfellene i planen er tekniske. Slå på «Vis teknisk innhold» for å se dem." : "Ingen treff.")</p>
                        }
                        <ul class="mtp-scenarios">
                            @foreach (var row in rows)
                            {
                                <li class="mtp-scenario" data-testid="mtp-scenario" data-key="@row.Key">
                                    <div class="mtp-scenario-head">
                                        @if (row.StoryId is { } sid) { <span class="mtp-story" title="@row.StoryTitle">@sid</span> }
                                        <span class="mtp-scenario-title">@row.Title</span>
                                    </div>
                                    <ul class="mtp-cases">
                                        @foreach (var c in row.Cases)
                                        {
                                            var id = P.IdOf(c);
                                            var source = P.SourceLabel(c);
                                            <li>
                                                <button type="button" class="mtp-case @(id == _selectedId ? "is-selected" : null)" aria-current="@(id == _selectedId ? "true" : null)"
                                                        @onclick="() => SelectAsync(id)" data-testid="mtp-case" data-case="@id">
                                                    <span class="mtp-case-title">@(Dirty && id == _selectedId ? "● " : "")@c.EffectiveTitle</span>
                                                    <span class="msb-status msb-tone-@P.ReviewTone(c.Review)" data-testid="mtp-case-state">@P.ReviewLabel(c.Review)</span>
                                                    @if (c.HasUnresolvedConflict) { <span class="msb-status msb-tone-bad" data-testid="mtp-case-conflict">Kildekonflikt</span> }
                                                    else if (source is not null) { <span class="msb-status msb-tone-warn" data-testid="mtp-case-source">@source</span> }
                                                </button>
                                            </li>
                                        }
                                    </ul>
                                    @if (CanWrite && !ReadOnlyPlan && row.Key.Length > 0)
                                    {
                                        <button type="button" class="msb-link mtp-add-case" disabled="@_busy" @onclick="() => AddCaseAsync(row.Key, row.Title)" data-testid="mtp-add-case">+ Testtilfelle</button>
                                    }
                                </li>
                            }
                        </ul>
                    </nav>

                    <section class="mtp-detail" aria-label="Testtilfelle" data-testid="mtp-detail">
                        @if (_pending is not null)
                        {
                            <div class="mtp-unsaved" role="alertdialog" aria-label="Ulagrede endringer" data-testid="mtp-unsaved">
                                <span>Du har ulagrede endringer i «@_form?.Title».</span>
                                <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick="SaveAndContinueAsync" data-testid="mtp-unsaved-save">Lagre og fortsett</button>
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="DiscardAndContinue" data-testid="mtp-unsaved-discard">Forkast endringene</button>
                                <button type="button" class="msb-link" @onclick="() => _pending = null" data-testid="mtp-unsaved-cancel">Avbryt</button>
                            </div>
                        }
                        @if (Selected is not { } current || _form is null)
                        {
                            <p class="msb-empty" data-testid="mtp-detail-none">Velg et testtilfelle i listen.</p>
                        }
                        else
                        {
                            var readonlyCase = !CanWrite || ReadOnlyPlan || current.Review is TestCaseReviewState.Excluded or TestCaseReviewState.Superseded;
                            var crumbScenario = current.ParentScenario is { } crumbKey ? _plan!.Cases.FirstOrDefault(x => x.Source.Kind != ScenarioSourceKind.Manual && x.Source.ScenarioId == crumbKey) : null;
                            <nav class="mtw-crumbs" aria-label="Plassering" data-testid="mtp-breadcrumb">
                                @if (current.Generated.Story is { } crumbStory) { <span data-testid="mtp-breadcrumb-story">@ScenarioWorkspacePresentation.StoryLabel(crumbStory)</span><span aria-hidden="true"> › </span> }
                                else { <span class="mt-muted">Uten brukerhistorie</span><span aria-hidden="true"> › </span> }
                                @if (crumbScenario is not null && !ReferenceEquals(crumbScenario, current)) { <span data-testid="mtp-breadcrumb-scenario">Scenario «@crumbScenario.EffectiveTitle»</span><span aria-hidden="true"> › </span> }
                                <span>Testtilfelle</span>
                                @if (DiscoverScenarioId(current) is { } discoverId)
                                {
                                    <button type="button" class="msb-link" @onclick="() => ShowInDiscoverAsync(current, discoverId)" data-testid="mtp-show-in-discover">Vis scenarioet i Finn og forstå</button>
                                }
                            </nav>
                            <div class="mtp-detail-head">
                                <span class="msb-status msb-tone-@P.ReviewTone(current.Review)" data-testid="mtp-detail-state">@P.ReviewLabel(current.Review)</span>
                                @if (P.SourceLabel(current) is { } src)
                                {
                                    <span class="msb-status msb-tone-warn" title="@current.SourceStateReason" data-testid="mtp-detail-source">@src</span>
                                }
                                @if (P.TechnicalReason(current) is { } why) { <span class="msb-status msb-tone-muted" data-testid="mtp-detail-technical">@why</span> }
                                @if (current.Source.Kind == ScenarioSourceKind.Manual) { <span class="msb-status msb-tone-muted">Skrevet av en person</span> }
                            </div>
                            @if (current.SourceStateReason is { Length: > 0 } reason && current.SourceState is not null and not CaseSourceState.Current)
                            {
                                <p class="mtp-source-banner" data-testid="mtp-case-source-reason">@reason</p>
                            }
                            @if (current.HasUnresolvedConflict && current.Generated.Conflicts is { Count: > 0 } conflicts)
                            {
                                <div class="mtp-conflict" data-testid="mtp-conflict">
                                    <p><strong>Kildene er uenige om forventet resultat.</strong> Velg hvilket som gjelder, eller skriv det selv, og begrunn valget. Testtilfellet kan ikke godkjennes før dette er avklart.</p>
                                    <ul class="mtp-claims">
                                        @foreach (var claim in conflicts.SelectMany(x => x.Claims).DistinctBy(x => x.CandidateId + x.Expected))
                                        {
                                            <li>
                                                <label><input type="radio" name="mtp-claim" checked="@(_conflictChoice == claim.CandidateId)" disabled="@readonlyCase"
                                                              @onchange="() => { _conflictChoice = claim.CandidateId; _conflictText = claim.Expected; }" data-testid="mtp-claim" />
                                                    <span>@claim.Expected</span> <span class="mt-muted msb-small">(@claim.SourceCategory)</span></label>
                                            </li>
                                        }
                                    </ul>
                                    @if (!readonlyCase)
                                    {
                                        <label class="mtp-field"><span>Forventet resultat som gjelder</span><textarea rows="2" value="@_conflictText" @oninput="e => _conflictText = e.Value?.ToString() ?? string.Empty" data-testid="mtp-conflict-expected"></textarea></label>
                                        <label class="mtp-field"><span>Begrunnelse</span><input type="text" value="@_conflictWhy" @oninput="e => _conflictWhy = e.Value?.ToString() ?? string.Empty" data-testid="mtp-conflict-why" /></label>
                                        <button type="button" class="btn btn-secondary btn-sm" disabled="@(_busy || Dirty || string.IsNullOrWhiteSpace(_conflictText) || string.IsNullOrWhiteSpace(_conflictWhy))"
                                                title="@(Dirty ? "Lagre først." : null)" @onclick="ResolveConflictAsync" data-testid="mtp-conflict-resolve">Avklar konflikten</button>
                                    }
                                </div>
                            }

                            @if (current.Generated.Story is { } us)
                            {
                                @* The user story (2026-11-25): a prominent, quiet card in the editor's language — Norsk shows the plan's stored translation
                                   («Oversett alle» translates stories with their cases), Original the source, Sammenlign both. Details one click away. *@
                                var objectives = P.StoryObjectiveCoverage(_plan!, us);
                                var refs = StoryInterpretation.ReferencedStories(us.Description);
                                var nbStory = P.StoryIn(_plan, us, norwegian: true);
                                var ogStory = P.StoryIn(_plan, us, norwegian: false);
                                var storyCompare = _lang == EditorLanguage.Compare && nbStory.Translated;
                                var shown = _lang == EditorLanguage.Norwegian || storyCompare ? nbStory : ogStory;
                                <section class="mtp-us is-story" aria-label="Brukerhistorie" data-testid="mtp-story" data-language="@(shown.Translated ? "nb" : "original")">
                                    <div class="mtp-us-head">
                                        @if (us.StoryId is { Length: > 0 } usid) { <span class="mtw-us">@usid</span> }
                                        @if (us.Priority is { Length: > 0 } prio) { <span class="mtw-prio" data-testid="mtp-story-priority">@prio</span> }
                                        <h3 class="mtp-us-title" data-testid="mtp-story-title">@shown.Title</h3>
                                        @if (storyCompare && ogStory.Title != nbStory.Title) { <span class="mtp-us-original-title" data-testid="mtp-story-title-original"><span class="mtp-lang-tag">Original</span>@ogStory.Title</span> }
                                        @if (objectives.Count > 0)
                                        {
                                            <span class="mtw-chip msb-tone-@(objectives.All(o => o.Covered) ? "ok" : "warn")" title="Testmål fra «Uavhengig test» som ser ut til å finnes i planens testtilfeller (et hint)." data-testid="mtp-story-coverage">@objectives.Count(o => o.Covered)/@objectives.Count testmål</span>
                                        }
                                    </div>
                                    @if (storyCompare)
                                    {
                                        <div class="mtp-us-compare" data-testid="mtp-story-compare">
                                            <p class="mtw-story-lead"><span class="mtp-lang-tag">Norsk</span> @nbStory.Description</p>
                                            <p class="mtw-story-lead"><span class="mtp-lang-tag">Original</span> @ogStory.Description</p>
                                        </div>
                                    }
                                    else if (shown.Description is { Length: > 0 } desc) { <p class="mtw-story-lead" data-testid="mtp-story-description">@desc</p> }
                                    @if (_lang != EditorLanguage.Original && !nbStory.Translated)
                                    {
                                        <p class="mtp-us-note" data-testid="mtp-story-untranslated" title="«Oversett alle» oversetter brukerhistorien sammen med testtilfellene.">Ikke oversatt ennå — vises på originalspråket.</p>
                                    }
                                    else if (nbStory.Stale && _lang != EditorLanguage.Original)
                                    {
                                        <p class="mtp-us-note is-warn" data-testid="mtp-story-stale" title="Oversett på nytt med «Oversett alle».">Kilden er endret etter oversettelsen.</p>
                                    }
                                    <div class="mtw-story-foot">
                                        @if (refs.Count > 0) { @foreach (var rf in refs) { <span class="mtp-chip" data-testid="mtp-story-ref">@rf</span> } }
                                        <button type="button" class="mtw-toggle" aria-expanded="@(_storyOpen ? "true" : "false")" @onclick="() => _storyOpen = !_storyOpen" data-testid="mtp-story-toggle">@(_storyOpen ? "Skjul detaljer" : "Detaljer")</button>
                                    </div>
                                    @if (_storyOpen)
                                    {
                                        <div class="mtp-us-body">
                                            @if (storyCompare && (nbStory.Why is { Length: > 0 } || ogStory.Why is { Length: > 0 }))
                                            {
                                                <div class="mtp-us-block" data-testid="mtp-story-why"><span class="mtp-ctx-label">Hvorfor denne prioriteten</span>
                                                    <div class="mtp-us-compare" data-testid="mtp-story-why-compare">
                                                        <p><span class="mtp-lang-tag">Norsk</span> @nbStory.Why</p>
                                                        <p><span class="mtp-lang-tag">Original</span> @ogStory.Why</p>
                                                    </div></div>
                                            }
                                            else if (shown.Why is { Length: > 0 } why2)
                                            {
                                                <div class="mtp-us-block" data-testid="mtp-story-why"><span class="mtp-ctx-label">Hvorfor denne prioriteten</span><p>@why2</p></div>
                                            }
                                            @if (shown.IndependentTest is { Length: > 0 } independent)
                                            {
                                                <div class="mtp-us-block" data-testid="mtp-story-independent">
                                                    <span class="mtp-ctx-label">Uavhengig test</span>
                                                    @if (storyCompare)
                                                    {
                                                        <div class="mtp-us-compare" data-testid="mtp-story-independent-compare">
                                                            <p class="mtp-quote"><span class="mtp-lang-tag">Norsk</span> @nbStory.IndependentTest</p>
                                                            <p class="mtp-quote"><span class="mtp-lang-tag">Original</span> @ogStory.IndependentTest</p>
                                                        </div>
                                                    }
                                                    else { <p class="mtp-quote">@independent</p> }
                                                    <ul class="mtp-objectives">
                                                        @foreach (var oc in objectives)
                                                        {
                                                            <li class="mtp-objective" data-covered="@(oc.Covered ? "true" : "false")" data-testid="mtp-objective"
                                                                title="@(oc.Covered ? "Ser ut til å dekkes av: " + string.Join(", ", oc.CaseTitles.Take(3)) : "Ikke funnet i planens testtilfeller")">
                                                                <span class="tdp-mark" aria-hidden="true">@(oc.Covered ? "✓" : "○")</span>
                                                                <span class="mtp-obj-text">@oc.Objective.Text</span>
                                                                @if (oc.Objective.NeedsReview) { <span class="msb-tag" title="Delt opp av BirkNext — sjekk mot originalteksten.">tolket</span> }
                                                                @if (oc.Covered) { <span class="mtp-obj-cov is-ok" data-testid="mtp-objective-covered">dekket</span> }
                                                                else { <span class="mtp-obj-cov is-gap" data-testid="mtp-objective-gap">mangler</span> }
                                                            </li>
                                                        }
                                                    </ul>
                                                </div>
                                            }
                                        </div>
                                    }
                                </section>
                            }
                            @* The scenario the selected case comes from: its acceptance criterion number, never "US1 — …" (the card above names the story). *@
                            <h3 class="mtp-scenario-heading" data-testid="mtp-scenario-heading">@P.ScenarioHeading(current)</h3>

                            var hasNb = _form.HasTranslation;
                            var showO = _lang != EditorLanguage.Norwegian;
                            var showN = hasNb && _lang != EditorLanguage.Original;
                            var emptyNb = !hasNb && _lang != EditorLanguage.Original;
                            var compare = showO && showN;
                            var tstatus = P.TranslationStatus(current);
                            var stale = hasNb && ScenarioPlanning.StateOf(current) == TranslationState.SourceChanged;
                            var gaps = P.UntranslatedFields(_form);
                            var canTranslate = CanWrite && !ReadOnlyPlan && current.ParentScenario is not null;
                            <div class="mtp-editor @(compare ? "is-compare" : "")" data-language="@_lang" data-testid="mtp-editor">
                                <div class="mtp-langbar" data-testid="mtp-translation-review">
                                    <div class="mtp-seg" role="radiogroup" aria-label="Språk i testtilfellet" data-testid="mtp-lang">
                                        @foreach (var lang in new[] { EditorLanguage.Norwegian, EditorLanguage.Original, EditorLanguage.Compare })
                                        {
                                            var l = lang;
                                            <button type="button" role="radio" aria-checked="@(_lang == l ? "true" : "false")" class="mtp-seg-btn @(_lang == l ? "is-on" : "")"
                                                    @onclick="() => _lang = l" data-lang="@l" data-testid="mtp-lang-option">@P.LanguageLabel(l)</button>
                                        }
                                    </div>
                                    @if (tstatus is { } ts) { <span class="msb-status msb-tone-@ts.Tone" data-testid="mtp-translation-state">@ts.Text</span> }
                                    @if (hasNb && P.IsProtectedTranslation(current))
                                    {
                                        <span class="mt-muted msb-small" data-testid="mtp-translation-protected">Beholdes ved ny maskinoversettelse.</span>
                                    }
                                    @if (gaps.Count > 0)
                                    {
                                        <span class="msb-status msb-tone-warn" title="@string.Join(", ", gaps)" data-testid="mtp-translation-gaps">Delvis oversatt: @gaps.Count @(gaps.Count == 1 ? "felt" : "felter") mangler</span>
                                    }
                                </div>

                                @if (stale && _lang != EditorLanguage.Original)
                                {
                                    <p class="mtp-source-banner" data-testid="mtp-translation-stale">Originalteksten er endret etter at den ble oversatt. Sammenlign og oppdater den norske teksten før du godkjenner.
                                        @if (!compare) { <button type="button" class="msb-link" @onclick="() => _lang = EditorLanguage.Compare" data-testid="mtp-translation-compare">Sammenlign</button> }</p>
                                }

                                @if (emptyNb)
                                {
                                    <div class="mtp-lang-empty" data-testid="mtp-lang-empty">
                                        <p><strong>Ingen norsk oversettelse finnes ennå.</strong></p>
                                        <p class="mt-muted msb-small">Oversettelse skjer bare når du ber om det. Originalteksten er gjeldende til en oversettelse er laget og gjennomgått.</p>
                                        <div class="mtp-lang-empty-actions">
                                            @if (canTranslate)
                                            {
                                                <button type="button" class="btn btn-primary btn-sm" disabled="@(Dirty || _busy || !_translationAvailable)" title="@(Dirty ? "Lagre først." : _translationAvailable ? null : "Oversettelse er ikke satt opp.")"
                                                        @onclick="() => TranslateAsync(current.ParentScenario!)" data-testid="mtp-translate-inline">Oversett til norsk</button>
                                            }
                                            @if (_lang == EditorLanguage.Norwegian)
                                            {
                                                <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _lang = EditorLanguage.Original" data-testid="mtp-lang-show-original">Vis originalen</button>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (showO || showN)
                                {
                                    @if (compare)
                                    {
                                        <div class="mtp-lhead" aria-hidden="true"><span></span><span>Original</span><span>Norsk</span></div>
                                    }
                                    <div class="mtp-lrow" data-field="title">
                                        <span class="mtp-lrow-label">Tittel</span>
                                        @if (showO) { <input type="text" class="mtp-lcell" value="@_form.Title" @oninput="e => _form.Title = e.Value?.ToString() ?? string.Empty" disabled="@readonlyCase" aria-label="Tittel (original)" data-testid="mtp-title" /> }
                                        @if (showN)
                                        {
                                            <span class="mtp-lcell-wrap">
                                                <input type="text" class="mtp-lcell" value="@_form.TranslatedTitle" @oninput="e => _form.TranslatedTitle = e.Value?.ToString() ?? string.Empty" disabled="@readonlyCase" aria-label="Tittel (norsk)" placeholder="@_form.Title" data-testid="mtp-tr-title" />
                                                @if (P.IsUntranslated(_form, _form.Title, _form.TranslatedTitle)) { <span class="mtp-untr" data-testid="mtp-untranslated">Ikke oversatt</span> }
                                            </span>
                                        }
                                    </div>
                                    <div class="mtp-lrow" data-field="purpose">
                                        <span class="mtp-lrow-label">Formål</span>
                                        @if (showO) { <textarea class="mtp-lcell mtp-auto" rows="2" value="@_form.Purpose" @oninput="e => _form.Purpose = e.Value?.ToString() ?? string.Empty" disabled="@readonlyCase" aria-label="Formål (original)" data-testid="mtp-purpose"></textarea> }
                                        @if (showN)
                                        {
                                            <span class="mtp-lcell-wrap">
                                                <textarea class="mtp-lcell mtp-auto" rows="2" value="@_form.TranslatedPurpose" @oninput="e => _form.TranslatedPurpose = e.Value?.ToString() ?? string.Empty" disabled="@readonlyCase" aria-label="Formål (norsk)" placeholder="@_form.Purpose" data-testid="mtp-tr-purpose"></textarea>
                                                @if (P.IsUntranslated(_form, _form.Purpose, _form.TranslatedPurpose)) { <span class="mtp-untr" data-testid="mtp-untranslated">Ikke oversatt</span> }
                                            </span>
                                        }
                                    </div>
                                    <div class="mtp-lrow" data-field="preconditions">
                                        <span class="mtp-lrow-label">Forutsetninger</span>
                                        @if (showO) { <textarea class="mtp-lcell mtp-auto" rows="2" value="@_form.Preconditions" @oninput="e => _form.Preconditions = e.Value?.ToString() ?? string.Empty" disabled="@readonlyCase" aria-label="Forutsetninger (original)" data-testid="mtp-preconditions"></textarea> }
                                        @if (showN)
                                        {
                                            <span class="mtp-lcell-wrap">
                                                <textarea class="mtp-lcell mtp-auto" rows="2" value="@_form.TranslatedPreconditions" @oninput="e => _form.TranslatedPreconditions = e.Value?.ToString() ?? string.Empty" disabled="@readonlyCase" aria-label="Forutsetninger (norsk)" placeholder="@_form.Preconditions" data-testid="mtp-tr-preconditions"></textarea>
                                                @if (P.IsUntranslated(_form, _form.Preconditions, _form.TranslatedPreconditions)) { <span class="mtp-untr" data-testid="mtp-untranslated">Ikke oversatt</span> }
                                            </span>
                                        }
                                    </div>
                                }

                                <div class="mtp-field">
                                    <span>Testdata</span>
                                    <div class="mtp-testdata">
                                        <select value="@_form.TestDataNeed" @onchange="e => _form.TestDataNeed = Enum.TryParse<TestDataNeed>(e.Value?.ToString(), out var n) ? n : TestDataNeed.Unknown" disabled="@readonlyCase" aria-label="Testdatabehov" data-testid="mtp-testdata-need">
                                            @foreach (var need in Enum.GetValues<TestDataNeed>())
                                            {
                                                <option value="@need">@P.TestDataNeedLabel(need)</option>
                                            }
                                        </select>
                                        @foreach (var assetId in _form.TestDataAssetIds)
                                        {
                                            var link = current.TestData.FirstOrDefault(d => d.AssetId == assetId);
                                            var option = TestDataOptions.FirstOrDefault(o => o.AssetId == assetId);
                                            <span class="mtp-chip" data-testid="mtp-testdata-link">@(option?.Alias ?? link?.Alias ?? assetId)@(link is { Resolved: false } ? " (finnes ikke)" : "")
                                                @if (!readonlyCase) { <button type="button" class="mtp-chip-x" aria-label="@($"Fjern testdata {option?.Alias ?? assetId}")" @onclick="() => _form.TestDataAssetIds.Remove(assetId)" data-testid="mtp-testdata-remove">✕</button> }
                                            </span>
                                        }
                                        @if (!readonlyCase && TestDataOptions.Any(o => !_form.TestDataAssetIds.Contains(o.AssetId)))
                                        {
                                            <select aria-label="Koble testdata" value="" @onchange="e => { if (e.Value?.ToString() is { Length: > 0 } v && !_form.TestDataAssetIds.Contains(v)) _form.TestDataAssetIds.Add(v); }" data-testid="mtp-testdata-add">
                                                <option value="">+ Koble testdata …</option>
                                                @foreach (var o in TestDataOptions.Where(o => !_form.TestDataAssetIds.Contains(o.AssetId)))
                                                {
                                                    <option value="@o.AssetId">@o.Alias@(o.Label is { Length: > 0 } l ? $" — {l}" : "")</option>
                                                }
                                            </select>
                                        }
                                    </div>
                                    @if (current.Generated.RequiredTestData is { Length: > 0 } required) { <span class="mt-muted msb-small" data-testid="mtp-testdata-source">Kilden sier: @required</span> }
                                </div>

                                @if (showO || showN)
                                {
                                    <fieldset class="mtp-steps" data-testid="mtp-steps">
                                        <legend>Teststeg</legend>
                                        @if (_form.Steps.Count == 0) { <p class="mt-muted msb-small" data-testid="mtp-steps-none">Ingen teststeg ennå.</p> }
                                        <ol>
                                            @foreach (var (step, i) in _form.Steps.Select((st, i) => (st, i)))
                                            {
                                                var index = i;
                                                <li class="mtp-step" @key="step.Key" data-testid="mtp-step">
                                                    <span class="mtp-step-no" aria-hidden="true">@(index + 1)</span>
                                                    <div class="mtp-step-body">
                                                        <div class="mtp-lrow" data-field="step-action">
                                                            <span class="mtp-lrow-label">Handling</span>
                                                            @if (showO) { <textarea class="mtp-lcell mtp-auto" rows="2" value="@step.Action" @oninput="e => step.Action = e.Value?.ToString() ?? string.Empty" disabled="@readonlyCase" aria-label="@($"Handling, steg {index + 1}")" data-testid="mtp-step-action"></textarea> }
                                                            @if (showN)
                                                            {
                                                                <span class="mtp-lcell-wrap" data-testid="mtp-tr-step">
                                                                    <textarea class="mtp-lcell mtp-auto" rows="2" value="@step.TranslatedAction" @oninput="e => step.TranslatedAction = e.Value?.ToString() ?? string.Empty" disabled="@readonlyCase" aria-label="@($"Handling på norsk, steg {index + 1}")" placeholder="@step.Action" data-testid="mtp-tr-step-action"></textarea>
                                                                    @if (P.IsUntranslated(_form, step.Action, step.TranslatedAction)) { <span class="mtp-untr" data-testid="mtp-untranslated">Ikke oversatt</span> }
                                                                </span>
                                                            }
                                                        </div>
                                                        <div class="mtp-lrow" data-field="step-expected">
                                                            <span class="mtp-lrow-label">Forventet resultat</span>
                                                            @if (showO) { <textarea class="mtp-lcell mtp-auto" rows="2" value="@step.Expected" @oninput="e => step.Expected = e.Value?.ToString() ?? string.Empty" disabled="@readonlyCase" aria-label="@($"Forventet resultat, steg {index + 1}")" data-testid="mtp-step-expected"></textarea> }
                                                            @if (showN)
                                                            {
                                                                <span class="mtp-lcell-wrap">
                                                                    <textarea class="mtp-lcell mtp-auto" rows="2" value="@step.TranslatedExpected" @oninput="e => step.TranslatedExpected = e.Value?.ToString() ?? string.Empty" disabled="@readonlyCase" aria-label="@($"Forventet resultat på norsk, steg {index + 1}")" placeholder="@step.Expected" data-testid="mtp-tr-step-expected"></textarea>
                                                                    @if (P.IsUntranslated(_form, step.Expected, step.TranslatedExpected)) { <span class="mtp-untr" data-testid="mtp-untranslated">Ikke oversatt</span> }
                                                                </span>
                                                            }
                                                        </div>
                                                    </div>
                                                    @if (!readonlyCase)
                                                    {
                                                        <span class="mtp-step-tools">
                                                            <button type="button" class="mtp-icon" disabled="@(index == 0)" @onclick="() => _form.MoveStep(index, -1)" aria-label="@($"Flytt steg {index + 1} opp")" data-testid="mtp-step-up">↑</button>
                                                            <button type="button" class="mtp-icon" disabled="@(index == _form.Steps.Count - 1)" @onclick="() => _form.MoveStep(index, 1)" aria-label="@($"Flytt steg {index + 1} ned")" data-testid="mtp-step-down">↓</button>
                                                            <button type="button" class="mtp-icon" @onclick="() => _form.RemoveStep(index)" aria-label="@($"Fjern steg {index + 1}")" data-testid="mtp-step-remove">✕</button>
                                                        </span>
                                                    }
                                                </li>
                                            }
                                        </ol>
                                        @if (!readonlyCase)
                                        {
                                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _form.AddStep()" data-testid="mtp-step-add">+ Teststeg</button>
                                        }
                                    </fieldset>

                                    <div class="mtp-lrow" data-field="expected">
                                        <span class="mtp-lrow-label">Samlet forventet resultat</span>
                                        @if (showO) { <textarea class="mtp-lcell mtp-auto" rows="3" value="@_form.ExpectedResult" @oninput="e => _form.ExpectedResult = e.Value?.ToString() ?? string.Empty" disabled="@readonlyCase" aria-label="Samlet forventet resultat (original)" data-testid="mtp-expected"></textarea> }
                                        @if (showN)
                                        {
                                            <span class="mtp-lcell-wrap">
                                                <textarea class="mtp-lcell mtp-auto" rows="3" value="@_form.TranslatedExpected" @oninput="e => _form.TranslatedExpected = e.Value?.ToString() ?? string.Empty" disabled="@readonlyCase" aria-label="Samlet forventet resultat (norsk)" placeholder="@_form.ExpectedResult" data-testid="mtp-tr-expected"></textarea>
                                                @if (P.IsUntranslated(_form, _form.ExpectedResult, _form.TranslatedExpected)) { <span class="mtp-untr" data-testid="mtp-untranslated">Ikke oversatt</span> }
                                            </span>
                                        }
                                    </div>
                                }

                                @if (!readonlyCase && P.QualityHints(_form) is { Count: > 0 } hints)
                                {
                                    <div class="mtp-quality" data-testid="mtp-quality">
                                        <span class="mtp-ctx-label">Kvalitetsråd</span>
                                        <ul>@foreach (var h in hints) { <li data-testid="mtp-quality-hint">@h</li> }</ul>
                                    </div>
                                }
                                @if (showN && !readonlyCase)
                                {
                                    <p class="mt-muted msb-small">Den norske teksten lagres sammen med testtilfellet og overskrives ikke av en ny maskinoversettelse når du har redigert den. Originalteksten er fortsatt gjeldende kilde.</p>
                                }
                            </div>

                            @if (!readonlyCase)
                            {
                                var problems = P.ReadyProblems(current);
                                <div class="mtp-actions" data-testid="mtp-actions">
                                    <button type="button" class="btn btn-primary" disabled="@(!Dirty || _busy)" @onclick="SaveAsync" data-testid="mtp-save">Lagre</button>
                                    <button type="button" class="btn btn-secondary" disabled="@(!Dirty || _busy)" @onclick="Discard" data-testid="mtp-discard">Forkast endringer</button>
                                    <span class="mtp-spacer"></span>
                                    @if (current.Review is TestCaseReviewState.Generated or TestCaseReviewState.NeedsClarification)
                                    {
                                        <button type="button" class="btn btn-secondary" disabled="@(Dirty || _busy || problems.Count > 0)" title="@(Dirty ? "Lagre først." : string.Join(" ", problems))"
                                                @onclick="() => ReviewAsync(TestCaseReviewState.UnderReview)" data-testid="mtp-ready">Klar for gjennomgang</button>
                                    }
                                    @if (current.Review != TestCaseReviewState.NeedsClarification)
                                    {
                                        <button type="button" class="btn btn-secondary" disabled="@(Dirty || _busy)" @onclick="() => ReviewAsync(TestCaseReviewState.NeedsClarification)" data-testid="mtp-clarify">Trenger avklaring</button>
                                    }
                                    @if (current.Review != TestCaseReviewState.Accepted)
                                    {
                                        <button type="button" class="btn btn-primary" disabled="@(Dirty || _busy || problems.Count > 0)" title="@(Dirty ? "Lagre først." : string.Join(" ", problems))"
                                                @onclick="() => ReviewAsync(TestCaseReviewState.Accepted)" data-testid="mtp-approve">Godkjenn</button>
                                    }
                                    <button type="button" class="msb-link" disabled="@(Dirty || _busy)" @onclick="() => _excludeAsk = true" data-testid="mtp-exclude">Utelat</button>
                                </div>
                                @if (_excludeAsk)
                                {
                                    <div class="mtp-confirm" role="group" aria-label="Utelat testtilfellet" data-testid="mtp-exclude-confirm">
                                        <label class="mtp-field"><span>Hvorfor utelates testtilfellet?</span><input type="text" value="@_excludeWhy" @oninput="e => _excludeWhy = e.Value?.ToString() ?? string.Empty" data-testid="mtp-exclude-why" /></label>
                                        <button type="button" class="btn btn-secondary btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_excludeWhy))" @onclick="ExcludeAsync" data-testid="mtp-exclude-yes">Utelat</button>
                                        <button type="button" class="msb-link" @onclick="() => _excludeAsk = false">Avbryt</button>
                                    </div>
                                }
                                @if (problems.Count > 0 && !Dirty)
                                {
                                    <ul class="mtp-problems" data-testid="mtp-problems">@foreach (var pr in problems) { <li>@pr</li> }</ul>
                                }
                            }
                            else if (current.Review == TestCaseReviewState.Excluded && CanWrite && !ReadOnlyPlan)
                            {
                                <div class="mtp-actions"><button type="button" class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="() => ReviewAsync(TestCaseReviewState.UnderReview)" data-testid="mtp-include">Ta med igjen</button></div>
                            }

                            var parentKey = current.ParentScenario;
                            var scenarioCase = parentKey is null ? null : _plan!.Cases.FirstOrDefault(x => x.Source.Kind != ScenarioSourceKind.Manual && x.Source.ScenarioId == parentKey);
                            var linkedAll = Linked(current);
                            var linkedIds = linkedAll.Select(l => l.RequirementId).ToHashSet(StringComparer.OrdinalIgnoreCase);
                            var designReqs = _ws?.Requirements is { } allReqs && RequirementLinkPresentation.SpecificationPathOf(current) is { } ownSpec
                                    ? allReqs.Where(r => linkedIds.Contains(r.RequirementId) && BirkNext.Specifications.SpecificationCatalogRules.SamePath(r.SpecificationPath, ownSpec)).ToList() : [];
                            <details class="mtp-design" open="@_designOpen" data-testid="mtp-design">
                                <summary @onclick="() => _designOpen = !_designOpen" @onclick:preventDefault="true"><span class="msb-h">Testdesign og klargjøring</span></summary>
                                @if (_designOpen)
                                {
                                    <BirkNext.Web.Components.ManualTesting.TestDesignPanel Facts="TestDesignAdvisor.FactsOf(current)" Scenario="scenarioCase ?? current" Case="current"
                                        Readiness="TestDesignAdvisor.Readiness(current)" TestData="TestDesignAdvisor.TestData(current)"
                                        Siblings="@(parentKey is null ? [] : _plan!.Cases.Where(x => x.ParentScenario == parentKey))"
                                        Decisions="@(_plan!.DesignDecisions?.Where(d => d.ScenarioKey == parentKey).ToList())"
                                        Table="@(designReqs.Count() > 1 ? TestDesignAdvisor.Decisions(designReqs) : null)"
                                        CanAct="@(CanWrite && !ReadOnlyPlan && parentKey is not null && scenarioCase is not null && !Dirty)" Busy="_busy"
                                        OnAccept="AcceptDesignAsync" OnDecide="DecideDesignAsync" />
                                }
                            </details>

                            <aside class="mtp-context" aria-label="Kildegrunnlag" data-testid="mtp-context">
                                <h3 class="msb-h">Kildegrunnlag</h3>
                                @if (current.Generated.Story is { } story)
                                {
                                    <div class="mtp-ctx" data-testid="mtp-ctx-story">
                                        <span class="mtp-ctx-label">Brukerhistorie</span>
                                        <span>@if (story.StoryId is { Length: > 0 } sid) { <span class="mtw-us">@sid</span> } @BirkNext.Web.Services.ScenarioWorkspacePresentation.StoryTitle(story)
                                            @if (P.IsTechnicalStory(story)) { <span class="msb-tag" data-testid="mtp-ctx-story-technical">teknisk</span> }</span>
                                    </div>
                                }
                                @if (linkedAll is { Count: > 0 } linkedReqs)
                                {
                                    var shownReqs = _showAllSuggestions ? linkedReqs : linkedReqs.Where(x => x.Relation != RequirementRelation.Suggested || x.Suggestion?.Level != RequirementSuggestionLevel.Weak).ToList();
                                    var hiddenWeak = linkedReqs.Count - shownReqs.Count;
                                    <div class="mtp-ctx mtp-ctx-wide" data-testid="mtp-ctx-requirements">
                                        <span class="mtp-ctx-label">Tilknyttede krav</span>
                                        <ul class="mtp-reqs mtp-linked">
                                            @foreach (var lr in shownReqs)
                                            {
                                                var req = lr;
                                                <li class="mtp-linked-req" data-relation="@req.Relation" data-testid="mtp-ctx-requirement">
                                                    <div class="mtp-linked-head">
                                                        <a class="mtp-req-id" href="@($"artifact-traceability?q={Uri.EscapeDataString(req.RequirementId)}")" translate="no" data-testid="mtp-req-id">@req.RequirementId</a>
                                                        <span class="msb-status msb-tone-@req.Tone" data-testid="mtp-req-relation">@req.RelationText</span>
                                                        @if (req.Technical) { <span class="msb-tag" title="Gjelder kodebasen, ikke atferd en tester ser. Vises her fordi det er knyttet til testtilfellet." data-testid="mtp-ctx-requirement-technical">teknisk</span> }
                                                        @if (req.Missing) { <span class="msb-status msb-tone-warn" data-testid="mtp-req-missing">Finnes ikke i valgt spesifikasjon — teller ikke</span> }
                                                        @if (req.Change is { } ch)
                                                        {
                                                            <span class="msb-status msb-tone-@(ch.Kind == RequirementChangeKind.Behavioural ? "warn" : "muted")" title="@string.Join("; ", ch.Differences)" data-testid="mtp-req-change">@(ch.Kind == RequirementChangeKind.Behavioural ? "Kravets atferd er endret — gjennomgå testtilfellet" : "Kravteksten er omformulert")</span>
                                                        }
                                                    </div>
                                                    <span class="mtp-req-title" data-testid="mtp-req-title">@req.Title</span>
                                                    @if (req.Behaviour is { Length: > 0 } beh) { <span class="mt-muted msb-small" data-testid="mtp-req-behaviour">@beh</span> }
                                                    @if (req.Change is { Differences.Count: > 0 } chd) { <span class="mt-muted msb-small" data-testid="mtp-req-change-detail">@string.Join(" · ", chd.Differences)</span> }
                                                    @if (req.SpecificationPath is { Length: > 0 } rp) { <span class="mt-muted msb-small mtp-req-source" data-testid="mtp-req-source"><code>@rp</code></span> }
                                                    <span class="mtp-req-levels" data-testid="mtp-req-levels">
                                                        @foreach (var (chip, chipTone) in P.CoverageChips(req.Coverage)) { <span class="msb-status msb-tone-@chipTone">@chip</span> }
                                                    </span>
                                                    @if (CanWrite && !ReadOnlyPlan && current.Review is not (TestCaseReviewState.Excluded or TestCaseReviewState.Superseded))
                                                    {
                                                        @if (req.Suggestion is { } sug)
                                                        {
                                                            <span class="mtp-req-actions">
                                                                <button type="button" class="btn btn-secondary btn-sm" disabled="@(Dirty || _busy || _ws?.Requirements is null)" title="@(Dirty ? "Lagre først." : null)" @onclick="() => ConfirmRequirementAsync(sug)" data-testid="mtp-req-confirm">Bekreft kobling</button>
                                                                <button type="button" class="msb-link" disabled="@(Dirty || _busy)" @onclick="() => RejectRequirementAsync(sug)" data-testid="mtp-req-reject">Avvis</button>
                                                            </span>
                                                        }
                                                        else if (req.Relation == RequirementRelation.Confirmed && current.RequirementLinks.Any(l => RequirementLinkPresentation.Key(l.RequirementId, l.SpecificationPath) == RequirementLinkPresentation.Key(req.RequirementId, req.SpecificationPath)))
                                                        {
                                                            <span class="mtp-req-actions"><button type="button" class="msb-link" disabled="@(Dirty || _busy)" @onclick="() => UnlinkRequirementAsync(req)" data-testid="mtp-req-unlink">Fjern bekreftet kobling</button></span>
                                                        }
                                                    }
                                                </li>
                                            }
                                        </ul>
                                        @if (hiddenWeak > 0)
                                        {
                                            <button type="button" class="msb-link msb-small" @onclick="() => _showAllSuggestions = true" data-testid="mtp-req-more">Vis @hiddenWeak svakere forslag</button>
                                        }
                                        <span class="mt-muted msb-small">Forslag er ikke koblinger før en person bekrefter dem, og teller ikke som dekning. Godkjent er ikke utført; utført er ikke bestått.</span>
                                    </div>
                                }
                                <div class="mtp-ctx" data-testid="mtp-ctx-why">
                                    <span class="mtp-ctx-label">Hvorfor dette forventede resultatet?</span>
                                    <span>@P.ExpectedBasisText(current)</span>
                                </div>
                                @if (current.Source.Kind != ScenarioSourceKind.Manual && current.Generated.ExpectedResult is { Length: > 0 } fromSource && fromSource != _form.ExpectedResult)
                                {
                                    <div class="mtp-ctx" data-testid="mtp-ctx-source-expected"><span class="mtp-ctx-label">Kildens forventede resultat</span><span>@fromSource</span></div>
                                }
                                @if (current.Generated.OpenQuestions.Count > 0)
                                {
                                    <div class="mtp-ctx" data-testid="mtp-ctx-questions"><span class="mtp-ctx-label">Åpne spørsmål</span><ul>@foreach (var q in current.Generated.OpenQuestions) { <li>@q</li> }</ul></div>
                                }
                                @if (current.Generated.Evidence.Count > 0)
                                {
                                    <details class="mtp-ctx-more" data-testid="mtp-ctx-evidence">
                                        <summary>Kildebevis (@current.Generated.Evidence.Count)</summary>
                                        <ul>@foreach (var ev in current.Generated.Evidence.Take(12)) { <li><span class="mt-muted">@P.EvidenceLabel(ev.Kind):</span> <code>@ev.Reference</code></li> }</ul>
                                    </details>
                                }
                                <div class="mtp-ctx mtp-translate" data-testid="mtp-translation">
                                    <span class="mtp-ctx-label">Oversettelse</span>
                                    @if (P.TranslationStatus(current) is { } trs)
                                    {
                                        <span data-testid="mtp-translation-nb">@trs.Text</span>
                                    }
                                    else
                                    {
                                        <span class="mt-muted">Ingen norsk oversettelse ennå.</span>
                                    }
                                    @if (CanWrite && !ReadOnlyPlan && current.ParentScenario is { } scenarioKey)
                                    {
                                        <button type="button" class="btn btn-secondary btn-sm" disabled="@(Dirty || _busy || !_translationAvailable)" title="@(Dirty ? "Lagre først." : _translationAvailable ? null : "Oversettelse er ikke satt opp.")" @onclick="() => TranslateAsync(scenarioKey)" data-testid="mtp-translate">Oversett</button>
                                    }
                                </div>
                            </aside>
                        }
                    </section>
                </div>
            }
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "draft")] public Guid? DraftParameter { get; set; }
    [SupplyParameterFromQuery(Name = "panel")] public string? PanelParameter { get; set; }
    /// <summary>A case to open (drill-down from Test Coverage / Requirements Traceability); shown even when it is technical.</summary>
    [SupplyParameterFromQuery(Name = "case")] public string? CaseParameter { get; set; }

    /// <summary>The discovered scenario a case belongs to (its own discovery id, or its parent scenario's); null for a case written by hand.</summary>
    private static string? DiscoverScenarioId(TestCaseDraft c) =>
        c.ParentScenario is { Length: > 0 } parent ? parent : c.Source.Kind == ScenarioSourceKind.ProjectDiscovery && c.Source.ScenarioId is { Length: > 0 } id ? id : null;

    /// <summary>Opens the case's scenario in Finn og forstå with its user story chosen (unsaved edits are guarded by the navigation lock).</summary>
    private async Task ShowInDiscoverAsync(TestCaseDraft c, string scenarioId)
    {
        if (_ws?.ProjectKey is { } key)
        {
            var filter = await TabDraftStore.ReadAsync<ScenarioBrowserPresentation.Filter>(JS, TabDraftStore.DiscoverFilterKey(key)) ?? new ScenarioBrowserPresentation.Filter();
            await TabDraftStore.WriteAsync(JS, TabDraftStore.DiscoverFilterKey(key), filter with { Story = c.Generated.Story?.Key, Queue = null, Query = "" });
            await TabDraftStore.WriteAsync(JS, TabDraftStore.DiscoverContextKey(key),
                new ScenarioWorkspacePresentation.WorkContext(c.Generated.Story?.Key, scenarioId, ScenarioWorkspacePresentation.Tabs.Scenarios, c.EffectiveTitle));
        }
        Nav.NavigateTo(M.DiscoverRoute);
    }

    private static readonly (string Key, string Label)[] Tools = [("cases", "Testtilfeller"), ("export", "Eksporter"), ("versions", "Versjoner"), ("changes", "Kildeendringer")];

    private bool _loading = true, _busy, _showTechnical, _archiveAsk, _excludeAsk, _translationAvailable = true;
    /// <summary>The editor's language view; reset to the default (Norsk when a translation exists) for each case.</summary>
    private EditorLanguage _lang = EditorLanguage.Original;
    private bool _storyOpen;
    private string _query = string.Empty, _tool = "cases", _excludeWhy = string.Empty, _conflictText = string.Empty, _conflictWhy = string.Empty;
    private string? _error, _notice, _selectedId, _conflictChoice;
    private ManualTestingWorkspace.Snapshot? _ws;
    private List<TestPlanDraftSummary> _plans = [], _archived = [];
    private TestPlanDraft? _plan;
    private P.CaseForm? _form;
    private List<string> _selection = [];
    /// <summary>What to do once unsaved edits are saved or discarded: open another case, change tool or plan, or navigate.</summary>
    private Func<Task>? _pending;
    private ICurrentWorkspaceProjection? _projection;

    private ITestPlanSuggestionsApiService? Api => ServiceProvider.GetService(typeof(ITestPlanSuggestionsApiService)) as ITestPlanSuggestionsApiService;
    private bool CanWrite => _ws?.Plans?.CanWrite ?? false;
    private bool ReadOnlyPlan => _plan is not null && _archived.Any(a => a.Id == _plan.Id);
    private IReadOnlyList<TestDataOption> TestDataOptions => _ws?.Plans?.TestData ?? [];
    private TestCaseDraft? Selected => _plan?.Cases.FirstOrDefault(c => P.IdOf(c) == _selectedId);
    private bool Dirty => _form is not null && Selected is { } s && _form.IsDirty(s);
    private static int ActiveCases(TestPlanDraft p) => p.Cases.Count(c => c.Review is not (TestCaseReviewState.Excluded or TestCaseReviewState.Superseded));

    protected override async Task OnInitializedAsync()
    {
        _projection = ServiceProvider.GetService(typeof(ICurrentWorkspaceProjection)) as ICurrentWorkspaceProjection;
        if (_projection is not null) _projection.Changed += OnProjectChanged;
        if (PanelParameter is { } panel && Tools.Any(t => t.Key == panel)) _tool = panel;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _ws = await new ManualTestingWorkspace(ServiceProvider).LoadAsync(requirements: true);
            _error = _ws.Error;
            _plans = [.. (_ws.Plans?.Drafts ?? []).OrderByDescending(p => p.UpdatedAt)];
            _archived = [.. _ws.Plans?.ArchivedDrafts ?? []];
            if (Api is { } api) { try { _translationAvailable = (await api.TranslationAsync())?.Available ?? false; } catch (Exception e) when (e is not OperationCanceledException) { } }
            if (_ws.ProjectKey is { } key)
                _selection = [.. await TabDraftStore.ReadAsync<string[]>(JS, TabDraftStore.SelectionKey(key)) ?? []];
            await LoadTraceAsync();
            var id = DraftParameter is { } wanted && (_plans.Any(p => p.Id == wanted) || _archived.Any(p => p.Id == wanted)) ? wanted : _plans.FirstOrDefault()?.Id;
            if (id is { } draftId) await OpenPlanAsync(draftId);
            if (CaseParameter is { Length: > 0 } wantedCase && _plan?.Cases.FirstOrDefault(c => P.IdOf(c) == wantedCase) is { } linked)
            {
                if (P.TechnicalReason(linked) is not null) _showTechnical = true;
                Open(P.IdOf(linked));
            }
        }
        finally { _loading = false; }
    }

    private async Task OpenPlanAsync(Guid id)
    {
        if (Api is not { } api) return;
        var (draft, error) = await api.DraftAsync(id);
        if (draft is null) { _error = P.Friendly(error, "Planen kunne ikke lastes."); return; }
        _plan = draft;
        _archiveAsk = _excludeAsk = false;
        var first = P.Rows(draft, _showTechnical).Rows.SelectMany(r => r.Cases).FirstOrDefault() ?? draft.Cases.FirstOrDefault();
        Open(_selectedId is { } keep && draft.Cases.Any(c => P.IdOf(c) == keep) ? keep : first is null ? null : P.IdOf(first));
    }

    private void Open(string? caseId)
    {
        _selectedId = caseId;
        _form = Selected is { } c ? P.CaseForm.From(c) : null;
        _lang = _form is null ? EditorLanguage.Original : P.DefaultLanguage(_form);
        _excludeAsk = false;
        _excludeWhy = string.Empty;
        _conflictChoice = null;
        _conflictText = Selected?.Generated.ExpectedResult ?? string.Empty;
        _conflictWhy = string.Empty;
    }

    /// <summary>Another case: never loses unsaved edits (asks first).</summary>
    private Task SelectAsync(string caseId)
    {
        if (caseId == _selectedId) return Task.CompletedTask;
        if (Dirty) { _pending = () => { Open(caseId); return Task.CompletedTask; }; return Task.CompletedTask; }
        Open(caseId);
        _notice = null;
        return Task.CompletedTask;
    }

    /// <summary>A tool of the plan (cases, export, versions, source changes). Unsaved edits are kept: the editor is reopened with them.</summary>
    private void SetTool(string key)
    {
        if (key == _tool) return;
        if (Dirty && _tool == "cases") { _pending = () => { _tool = key; Discard(); return Task.CompletedTask; }; return; }
        _tool = key;
    }

    private Task ChoosePlanAsync(ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var id) || id == _plan?.Id) return Task.CompletedTask;
        Task Go() { _selectedId = null; return OpenPlanAsync(id); }
        if (Dirty) { _pending = Go; return Task.CompletedTask; }
        return Go();
    }

    private void OnBeforeNavigation(LocationChangingContext context)
    {
        if (!Dirty) return;
        var target = context.TargetLocation;
        context.PreventNavigation();
        _pending = () => { _form = null; _selectedId = null; Nav.NavigateTo(target); return Task.CompletedTask; };
    }

    private async Task SaveAndContinueAsync()
    {
        if (await SaveAsync() && _pending is { } next) { _pending = null; await next(); }
    }

    private async Task DiscardAndContinue()
    {
        Discard();
        if (_pending is { } next) { _pending = null; await next(); }
    }

    private void Discard() { if (Selected is { } c) _form = P.CaseForm.From(c); _notice = null; }

    private async Task<bool> SaveAsync()
    {
        if (_plan is null || _form is null || Api is not { } api) return false;
        _busy = true; _error = null;
        try
        {
            var (draft, error) = await api.SaveAsync(_plan.Id, P.SaveWith(_plan, _form));
            if (draft is null) { _error = P.Friendly(error, "Testtilfellet kunne ikke lagres."); return false; }
            _plan = draft;
            Open(_form.CaseId);
            _notice = "Lagret.";
            return true;
        }
        finally { _busy = false; }
    }

    /// <summary>A new revision of the plan from a tool (restore, refresh): the editor follows it.</summary>
    private Task ReplacedAsync(TestPlanDraft draft)
    {
        _plan = draft;
        Open(_selectedId is { } keep && draft.Cases.Any(c => P.IdOf(c) == keep) ? keep : draft.Cases.Select(P.IdOf).FirstOrDefault());
        _notice = $"Planen er oppdatert (revisjon {draft.Revision}).";
        return Task.CompletedTask;
    }

    private async Task ReviewAsync(TestCaseReviewState state, string? rationale = null)
    {
        if (_plan is null || Selected is not { } c || Api is not { } api) return;
        _busy = true; _error = null;
        try
        {
            var (draft, error) = await api.ReviewAsync(_plan.Id, new ReviewTestCaseRequest(_plan.Revision, P.IdOf(c), state, rationale));
            if (draft is null) { _error = P.Friendly(error, "Statusen kunne ikke endres."); return; }
            _plan = draft;
            Open(P.IdOf(c));
            _notice = $"Status: {P.ReviewLabel(state)}.";
        }
        finally { _busy = false; }
    }

    private Task ExcludeAsync() => ReviewAsync(TestCaseReviewState.Excluded, _excludeWhy.Trim());

    private async Task ResolveConflictAsync()
    {
        if (_plan is null || Selected is not { } c || Api is not { } api) return;
        _busy = true; _error = null;
        try
        {
            var (draft, error) = await api.ResolveConflictAsync(_plan.Id, new ResolveConflictRequest(_plan.Revision, P.IdOf(c), _conflictText.Trim(), _conflictChoice, _conflictWhy.Trim()));
            if (draft is null) { _error = P.Friendly(error, "Konflikten kunne ikke avklares."); return; }
            _plan = draft;
            Open(P.IdOf(c));
            _notice = "Konflikten er avklart. Testtilfellet kan nå gjennomgås og godkjennes.";
        }
        finally { _busy = false; }
    }

    private bool _designOpen = true;

    /// <summary>Accepts a test-design proposal: the existing add-from-variant path (the server re-derives the proposal from the scenario's
    /// evidence and refuses it when it no longer applies or a case with its title exists — no duplicate cases).</summary>
    private async Task AcceptDesignAsync(TestCaseVariantProposal v)
    {
        if (_plan is null || Api is not { } api || Selected?.ParentScenario is not { } scenarioKey || Dirty) return;
        _busy = true; _error = null;
        try
        {
            var before = _plan.Cases.Select(P.IdOf).ToHashSet(StringComparer.Ordinal);
            var (draft, error) = await api.AddManualCaseAsync(_plan.Id, new AddManualTestCaseRequest(_plan.Revision, v.Title, v.Basis, null, ScenarioKey: scenarioKey, Variant: v.Key));
            if (draft is null) { _error = P.Friendly(error, "Forslaget kunne ikke legges til."); return; }
            _plan = draft;
            Open(draft.Cases.Select(P.IdOf).FirstOrDefault(id => !before.Contains(id)) ?? _selectedId);
            _notice = $"«{v.Title}» er lagt til som nytt testtilfelle (utkast). Gå gjennom og lagre.";
        }
        finally { _busy = false; }
    }

    /// <summary>Rejects or defers a proposal for the scenario (saved with the plan; who and when recorded by the server).</summary>
    private async Task DecideDesignAsync((TestCaseVariantProposal Proposal, string Decision) d)
    {
        if (_plan is null || Api is not { } api || Selected?.ParentScenario is not { } scenarioKey || Dirty) return;
        _busy = true; _error = null;
        try
        {
            var (saved, error) = await api.SaveAsync(_plan.Id, P.DesignDecisionRequest(_plan, scenarioKey, d.Proposal, d.Decision));
            if (saved is null) { _error = P.Friendly(error, "Avgjørelsen ble ikke lagret."); return; }
            _plan = saved; Open(_selectedId);
            _notice = d.Decision == TestDesignDecisions.Rejected ? $"Forslaget «{d.Proposal.Title}» er avvist." : $"Forslaget «{d.Proposal.Title}» er utsatt.";
        }
        finally { _busy = false; }
    }

    private async Task AddCaseAsync(string scenarioKey, string scenarioTitle)
    {
        if (_plan is null || Api is not { } api) return;
        if (Dirty) { _pending = () => AddCaseAsync(scenarioKey, scenarioTitle); return; }
        _busy = true; _error = null;
        try
        {
            var before = _plan.Cases.Select(P.IdOf).ToHashSet(StringComparer.Ordinal);
            var (draft, error) = await api.AddManualCaseAsync(_plan.Id, new AddManualTestCaseRequest(_plan.Revision, $"Nytt testtilfelle: {scenarioTitle}", null, null, ScenarioKey: scenarioKey));
            if (draft is null) { _error = P.Friendly(error, "Testtilfellet kunne ikke legges til."); return; }
            _plan = draft;
            Open(draft.Cases.Select(P.IdOf).FirstOrDefault(id => !before.Contains(id)) ?? _selectedId);
            _notice = "Nytt testtilfelle lagt til. Skriv teststegene og lagre.";
        }
        finally { _busy = false; }
    }

    private async Task TranslateAsync(string scenarioKey)
    {
        if (_plan is null || Api is not { } api) return;
        _busy = true; _error = null;
        try
        {
            var (result, error) = await api.TranslateAsync(_plan.Id, new TranslateScenarioRequest(_plan.Revision, scenarioKey, Target: ScenarioPlanning.Norwegian));
            if (result is null) { _error = P.Friendly(error, "Oversettelsen feilet."); return; }
            if (result.Draft is { } draft) { _plan = draft; Open(_selectedId); }
            _notice = result.Message;
        }
        finally { _busy = false; }
    }

    /// <summary>Translate all: the existing plan translation (stories and requirement wording too). Person-written and edited text is kept.</summary>
    private async Task TranslateAllAsync()
    {
        if (_plan is null || Api is not { } api) return;
        _busy = true; _error = null;
        try
        {
            var (result, error) = await api.TranslateAllAsync(_plan.Id, new TranslatePlanRequest(_plan.Revision, Target: ScenarioPlanning.Norwegian));
            if (result is null) { _error = P.Friendly(error, "Oversettelsen feilet."); return; }
            if (result.Draft is { } draft) { _plan = draft; Open(_selectedId); }
            _notice = result.Message + (result.Failed.Count > 0 ? $" {result.Failed.Count} kunne ikke oversettes og er fortsatt på originalspråket." : "");
        }
        finally { _busy = false; }
    }

    private async Task ArchiveAsync()
    {
        if (_plan is null || Api is not { } api) return;
        _busy = true; _error = null;
        try
        {
            var (summary, error) = await api.ArchiveAsync(_plan.Id, new TestPlanLifecycleRequest(_plan.Revision));
            if (summary is null) { _error = P.Friendly(error, "Planen kunne ikke arkiveres."); return; }
            _archiveAsk = false;
            _plans.RemoveAll(p => p.Id == summary.Id);
            _archived.Insert(0, summary);
            _plan = _plan with { Revision = summary.Revision };
            _notice = $"«{summary.PlanName}» er arkivert. Den kan gjenopprettes fra Lagrede planer.";
        }
        finally { _busy = false; }
    }

    private async Task UnarchiveAsync()
    {
        if (_plan is null || Api is not { } api) return;
        _busy = true; _error = null;
        try
        {
            var (summary, error) = await api.UnarchiveAsync(_plan.Id, new TestPlanLifecycleRequest(_plan.Revision));
            if (summary is null) { _error = P.Friendly(error, "Planen kunne ikke gjenopprettes."); return; }
            _archived.RemoveAll(p => p.Id == summary.Id);
            _plans.Insert(0, summary);
            await OpenPlanAsync(summary.Id);
            _notice = $"«{summary.PlanName}» er gjenopprettet.";
        }
        finally { _busy = false; }
    }

    /// <summary>The scenarios chosen in Finn og forstå become test cases: in this plan, or in a new one. The selection is then cleared.</summary>
    private async Task FromSelectionAsync(List<string> candidateIds, bool intoCurrent)
    {
        if (_ws?.ProjectKey is not { } key || _ws.Discovery is not { } discovery || Api is not { } api) return;
        if (Dirty) { _pending = () => FromSelectionAsync(candidateIds, intoCurrent); return; }
        _busy = true; _error = null;
        try
        {
            var (draft, error) = await api.CreateProjectAsync(new CreateProjectTestPlanRequest
            {
                ProjectKey = key, ProjectName = _ws.ProjectName, DiscoveryId = discovery.DiscoveryId, CandidateIds = candidateIds,
                PlanName = intoCurrent ? null : $"Testplan {DateTime.Now:yyyy-MM-dd}",
                DraftId = intoCurrent ? _plan?.Id : null, BaseRevision = intoCurrent ? _plan?.Revision : null,
            });
            if (draft is null) { _error = P.Friendly(error, "Planen kunne ikke lages."); return; }
            await TabDraftStore.RemoveAsync(JS, TabDraftStore.SelectionKey(key));
            _selection = [];
            _plan = draft;
            _tool = "cases";
            if (_plans.All(p => p.Id != draft.Id))
                _plans.Insert(0, new TestPlanDraftSummary(draft.Id, draft.GuideKey, draft.PlanName, draft.DeliveryLabel, draft.Revision, draft.Cases.Count, 0, 0, 0, 0, 0, draft.UpdatedBy, draft.UpdatedAt));
            _selectedId = null;
            var first = P.Rows(draft, _showTechnical).Rows.SelectMany(r => r.Cases).FirstOrDefault();
            Open(first is null ? null : P.IdOf(first));
            _notice = $"{candidateIds.Count} scenario{(candidateIds.Count == 1 ? "" : "er")} lagt til i «{draft.PlanName}».";
        }
        finally { _busy = false; }
    }

    /// <summary>Executed / passed per requirement across saved plans (completed manual runs); null until loaded or when not available.</summary>
    private PreparedCaseTraceView? _trace;
    private (int Revision, string CaseId, PreparedCaseTraceView? Trace, List<ProjectRequirementOption>? Requirements, List<P.LinkedRequirement> Rows)? _linkedMemo;

    /// <summary>The case's linked and suggested requirements, computed once per saved case revision (never per render or keystroke: the
    /// suggester reads the whole requirement list).</summary>
    private List<P.LinkedRequirement> Linked(TestCaseDraft c)
    {
        var id = P.IdOf(c);
        if (_linkedMemo is { } m && m.Revision == _plan!.Revision && m.CaseId == id && ReferenceEquals(m.Trace, _trace) && ReferenceEquals(m.Requirements, _ws?.Requirements)) return m.Rows;
        var rows = P.LinkedRequirements(c, _plan!, _ws?.Requirements, _trace, _ws?.Discovery?.Candidates);
        _linkedMemo = (_plan!.Revision, id, _trace, _ws?.Requirements, rows);
        return rows;
    }
    private bool _showAllSuggestions;

    private async Task LoadTraceAsync()
    {
        _trace = null;
        if (Api is not { } api || _ws?.ProjectKey is not { } key || _ws.Requirements is not { Count: > 0 } requirements) return;
        try
        {
            var (trace, _) = await api.PreparedCaseTraceAsync(key, new PreparedCaseTraceRequest([.. requirements.Select(r => r.SpecificationPath).Distinct()],
                [.. requirements.Select(r => r.RequirementId)], requirements.GroupBy(r => r.RequirementId, StringComparer.OrdinalIgnoreCase).ToDictionary(g => g.Key, g => g.First().Title, StringComparer.OrdinalIgnoreCase)));
            _trace = trace;
        }
        catch (Exception e) when (e is not OperationCanceledException) { _trace = null; }
    }

    /// <summary>Confirms a suggested requirement for this case (the existing confirm: who and when are recorded by the server). Never automatic.</summary>
    private Task ConfirmRequirementAsync(RequirementSuggestion s) =>
        SaveRequirementChangeAsync(c => ScenarioCentricPresentation.Confirm(c, s, null), $"{s.RequirementId} er bekreftet for testtilfellet.");

    private Task RejectRequirementAsync(RequirementSuggestion s) =>
        SaveRequirementChangeAsync(c => ScenarioCentricPresentation.Reject(c, s), $"Forslaget {s.RequirementId} er avvist for testtilfellet.");

    private Task UnlinkRequirementAsync(P.LinkedRequirement r) =>
        SaveRequirementChangeAsync(c => RequirementLinkPresentation.Unlink(c, r.RequirementId, r.SpecificationPath), $"Den bekreftede koblingen til {r.RequirementId} er fjernet.");

    /// <summary>Saves one requirement-link change of the selected case on its own (only when nothing else is unsaved), with the project's
    /// requirement list so the server can check a new link.</summary>
    private async Task SaveRequirementChangeAsync(Func<TestCaseDraft, TestCaseDraft> change, string done)
    {
        if (_plan is null || Selected is not { } c || Dirty || Api is not { } api) return;
        _busy = true; _error = null;
        try
        {
            var (saved, error) = await api.SaveAsync(_plan.Id, P.RequirementChangeRequest(_plan, P.IdOf(c), change, _ws?.Requirements));
            if (saved is null) { _error = P.Friendly(error, "Koblingen ble ikke lagret."); return; }
            _plan = saved; Open(_selectedId); _notice = done;
        }
        finally { _busy = false; }
    }

    private void OnProjectChanged() => _ = InvokeAsync(async () => { _ws = null; _plan = null; _form = null; _selectedId = null; _pending = null; await LoadAsync(); StateHasChanged(); });

    public void Dispose() { if (_projection is not null) _projection.Changed -= OnProjectChanged; }
}
