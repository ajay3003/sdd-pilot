    /// <summary>Saves one requirement-link change of the selected case on its own (only when nothing else is unsaved), with the project's
    /// requirement list so the server can check a new link.</summary>
    private async Task SaveRequirementChangeAsync(Func<TestCaseDraft, TestCaseDraft> change, string done)
    {
        if (_plan is null || Selected is not { } c || Dirty || Api is not { } api) return;
        _busy = true; _error = null;
        try
        {
            var (saved, error) = await api.SaveAsync(_plan.Id, P.RequirementChangeRequest(_plan, P.IdOf(c), change, _ws?.Requirements));
