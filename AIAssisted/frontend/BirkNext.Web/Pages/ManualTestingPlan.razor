    private async Task AddCaseAsync(string scenarioKey, string scenarioTitle)
    {
        if (_plan is null || Api is not { } api) return;
        if (Dirty) { _pending = () => AddCaseAsync(scenarioKey, scenarioTitle); return; }
        _busy = true; _error = null;
        try
        {
            var before = _plan.Cases.Select(P.IdOf).ToHashSet(StringComparer.Ordinal);
            var (draft, error) = await api.AddManualCaseAsync(_plan.Id, new AddManualTestCaseRequest(_plan.Revision, $"Nytt testtilfelle: {scenarioTitle}", null, null, ScenarioKey: scenarioKey));
            if (draft is null) { _error = error ?? "Testtilfellet kunne ikke legges til."; return; }
            _plan = draft;
            Open(draft.Cases.Select(P.IdOf).FirstOrDefault(id => !before.Contains(id)) ?? _selectedId);
            _notice = "Nytt testtilfelle lagt til. Skriv teststegene og lagre.";
        }
        finally { _busy = false; }
    }

