    private async Task ArchiveAsync()
    {
        if (_plan is null || Api is not { } api) return;
        _busy = true; _error = null;
        try
        {
            var (summary, error) = await api.ArchiveAsync(_plan.Id, new TestPlanLifecycleRequest(_plan.Revision));
            if (summary is null) { _error = P.Friendly(error, "Testplanen kunne ikke arkiveres."); return; }
            _archiveAsk = false;
            _plans.RemoveAll(p => p.Id == summary.Id);
            _archived.Insert(0, summary);
            _plan = _plan with { Revision = summary.Revision };
            _notice = $"«{summary.PlanName}» er arkivert. Den kan gjenopprettes fra Lagrede testplaner i Testplaner.";
        }
        finally { _busy = false; }
    }

    private async Task UnarchiveAsync()
    {
        if (_plan is null || Api is not { } api) return;
        _busy = true; _error = null;
