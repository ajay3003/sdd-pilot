@page "/manual-testing/plan"
@using P2 = BirkNext.Web.Services.AdoTestPlansPresentation
@using BirkNext.TestPlanning
@using BirkNext.TestCoverage
@using BirkNext.Web.Services
@using M = BirkNext.Web.Services.ManualTestingPresentation
@using P = BirkNext.Web.Services.PlanPreparePresentation
@using TC = BirkNext.Web.Services.TechnicalCoveragePresentation
@using SC = BirkNext.Web.Services.SpecContextPresentation
@using MR = BirkNext.Web.Services.ManualRunPresentation
@implements IDisposable
@inject IServiceProvider ServiceProvider
@inject NavigationManager Nav
@inject IJSRuntime JS

@* Planlegg og klargjør (2026-11-23): the one place a manual tester prepares test cases. One plan at a time as a master-detail editor — the
   plan's scenarios with their cases (several per scenario) on the left, the selected case on the right: title, purpose, preconditions, Test
   Data (need + linked assets), steps with an action and an expected result each, the expected result, and its Norwegian translation for review.
   User story, requirements and evidence are context. Tools of the plan are tabs of the same page: Eksporter (the existing Azure DevOps export),
   Versjoner (revision history), Kildeendringer (impact + safe refresh). Saving sends only human-owned edits against the plan's revision (a
   stale save is refused, never merged); unsaved edits are never lost. An archived plan opens read-only until restored. *@
<PageTitle>Planlegg og klargjør</PageTitle>
<NavigationLock ConfirmExternalNavigation="@Dirty" OnBeforeInternalNavigation="OnBeforeNavigation" />

<div class="mt msb-page mtp" data-testid="mtp" aria-busy="@(_loading ? "true" : "false")">
    <BirkNext.Web.Components.TestingWorkspaceHeader Workspace="Manuell testing" HomeRoute="@M.HomeRoute" Stages="M.Stages" Current="plan" Title="Planlegg og klargjør"
        ProjectName="@_ws?.ProjectName" Context="@_ws?.SnapshotBasis"
        Lead="Skriv og gjennomgå testtilfellene for scenarioene du valgte, oversett dem og eksporter dem til Azure DevOps Test Plans.">
        <Help><BirkNext.Web.Components.HelpLink Topic="manual-testing" Text="Slik fungerer det" /></Help>
    </BirkNext.Web.Components.TestingWorkspaceHeader>

    @if (_loading)
    {
        <div class="msb-skeleton" role="status" data-testid="mtp-loading"><span>Laster …</span></div>
    }
    else if (_ws?.ProjectKey is null)
    {
        <p class="msb-empty" data-testid="mtp-no-project">Velg en applikasjon i prosjektlisten først.</p>
    }
    else
    {
        @if (_error is { } error)
        {
            <p class="mt-alert" role="alert" data-testid="mtp-error">@error
                <button type="button" class="msb-link" disabled="@_busy" @onclick="LoadAsync" data-testid="mtp-retry">Last inn på nytt</button></p>
        }
        @if (!_loading && _plan is not null && !CanWrite)
        {
            <p class="mtp-notice" role="status" data-testid="mtp-read-only">Du har lesetilgang til testplanen. Du kan se alt, men endringer kan ikke lagres.</p>
        }
        @if (_notice is { } notice)
        {
            <p class="mtp-notice" role="status" data-testid="mtp-notice">@notice</p>
        }

        @if (_selection.Count > 0 && _ws.Discovery is not null)
        {
            var notInPlan = _plan is null ? _selection : _selection.Where(id => _plan.Cases.All(c => c.Source.ScenarioId != id)).ToList();
            @if (notInPlan.Count > 0)
            {
                <section class="mtp-selection" aria-label="Valgte scenarioer" data-testid="mtp-selection">
                    <span><strong>@notInPlan.Count</strong> scenario@(notInPlan.Count == 1 ? "" : "er") valgt i Finn og forstå.</span>
                    @if (_plan is not null && CanWrite && !ReadOnlyPlan)
                    {
                        <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick="() => FromSelectionAsync(notInPlan, true)" data-testid="mtp-selection-add">Legg til i «@_plan.PlanName»</button>
                    }
                    @if (CanWrite)
                    {
                        <button type="button" class="btn btn-outline-primary btn-sm" disabled="@_busy" @onclick="() => FromSelectionAsync(notInPlan, false)" data-testid="mtp-selection-new">Ny testplan med disse</button>
                    }
                    <a class="msb-link" href="@M.DiscoverRoute">Endre utvalget</a>
                </section>
            }
        }

        @if (_plans.Count == 0 && _plan is null)
        {
            <section class="msb-empty mtp-empty" data-testid="mtp-no-plan">
                <p>Ingen testplan ennå. Velg scenarioer i <a href="@M.DiscoverRoute">Finn og forstå</a>, eller <a href="@($"{M.PlansRoute}?create=1")" data-testid="mtp-create-plan">opprett testplan</a>.</p>
                @if (_archived.Count > 0) { <p class="mt-muted msb-small"><a href="@($"{M.PlansRoute}?plans=archived")">@_archived.Count arkivert@(_archived.Count == 1 ? "" : "e") testplan@(_archived.Count == 1 ? "" : "er")</a></p> }
            </section>
        }
        else if (_plan is { } plan)
        {
            var status = _ws.Plans?.PlanStatus is { } st && st.TryGetValue(plan.Id, out var s) ? s : null;
            <div class="mtp-planbar" data-testid="mtp-planbar">
                @if (_plans.Count > 1 || ReadOnlyPlan)
                {
                    <label class="mtp-field mtp-inline">
                        <span>Testplan</span>
                        <select value="@plan.Id" @onchange="ChoosePlanAsync" data-testid="mtp-plan-select">
                            @foreach (var p in _plans)
                            {
                                <option value="@p.Id">@p.PlanName</option>
                            }
                            @if (ReadOnlyPlan) { <option value="@plan.Id">@plan.PlanName (arkivert)</option> }
                        </select>
                    </label>
                }
                else
                {
                    <h2 class="msb-h mtp-plan-name" data-testid="mtp-plan-name">@plan.PlanName</h2>
                }
                <span class="mt-muted msb-small" data-testid="mtp-plan-counts">@P.ScenarioCount(plan) scenario@(P.ScenarioCount(plan) == 1 ? "" : "er") · @ActiveCases(plan) testtilfelle@(ActiveCases(plan) == 1 ? "" : "r") · @plan.Cases.Count(c => c.Review == TestCaseReviewState.Accepted) godkjent · revisjon @plan.Revision</span>
                <span class="mtp-spacer"></span>
                @* «Overfør testplan» (2026-11-25) lives on the Testplaner tab: the button opens it for this testplan. *@
                <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick="() => GoTransfer(plan.Id)" data-testid="mtp-transfer">Overfør testplan</button>
                <a class="msb-link" href="@M.PlansRoute" data-testid="mtp-manage-plans">Administrer testplaner</a>
                @* Automatic translation (2026-11-25): missing Norwegian text is translated in the background when the test plan opens. *@
                @if (_auto == AutoTranslation.Running)
                {
                    <InlineLoading Text="Oversetter …" Class="mt-muted msb-small" TestId="mtp-auto-translating" />
                }
                else if (_auto == AutoTranslation.Failed)
                {
                    <span class="mtp-auto is-failed" role="status" data-testid="mtp-auto-failed" title="@_autoError">Kunne ikke oversette — originalteksten vises.
                        <button type="button" class="msb-link" @onclick="() => StartAutoTranslation(retry: true)" data-testid="mtp-auto-retry">Prøv igjen</button></span>
                }
                else if (_auto == AutoTranslation.Unavailable)
                {
                    <span class="mtp-auto mt-muted msb-small" role="status" data-testid="mtp-auto-unavailable" title="@_translationReason">Automatisk oversettelse er ikke tilgjengelig her — originalteksten vises.</span>
                }
                @if (CanWrite && !ReadOnlyPlan)
                {
                    <button type="button" class="msb-link" disabled="@(_busy || Dirty)" @onclick="() => _archiveAsk = true" data-testid="mtp-archive">Arkiver testplan</button>
                }
            </div>

            @if (_archiveAsk)
            {
                <div class="mtp-confirm" role="group" aria-label="Arkiver testplan" data-testid="mtp-archive-confirm">
                    <span>Arkiver «@plan.PlanName»? Planen blir skrivebeskyttet og vises under arkiverte planer. Ingenting slettes, og du kan gjenopprette den.</span>
                    <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick="ArchiveAsync" data-testid="mtp-archive-yes">Arkiver</button>
                    <button type="button" class="msb-link" @onclick="() => _archiveAsk = false" data-testid="mtp-archive-no">Avbryt</button>
                </div>
            }
            @if (ReadOnlyPlan)
            {
                <p class="mtp-source-banner" role="status" data-testid="mtp-archived">
                    <strong>Testplanen er arkivert</strong> og kan bare leses.
                    @if (CanWrite) { <button type="button" class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="UnarchiveAsync" data-testid="mtp-unarchive">Gjenopprett</button> }
                </p>
            }
            @* A saved plan is independent of the specification selected in Finn og forstå (2026-11-25): one neutral line about where its cases come
               from — never a warning. Each case's source status is resolved from its own specification. *@
            @if (P.PlanSourceLine(plan) is { } sourceLine)
            {
                <p class="mt-muted msb-small mtp-plan-source" data-testid="mtp-plan-source">@sourceLine</p>
            }
            @if (!ReadOnlyPlan && status is not null && status.State is not ("Klar" or "Ikke sammenlignet"))
            {
                <p class="mtp-source-banner" role="status" data-testid="mtp-source-changed">
                    <strong>Kildegrunnlaget er endret.</strong> @status.Message
                    <button type="button" class="msb-link" @onclick='() => SetTool("changes")'>Se hva som er endret</button>
                </p>
            }

            <nav class="mtp-tools" aria-label="Testplan" data-testid="mtp-tools">
                @foreach (var (key, label) in Tools)
                {
                    <button type="button" class="mtp-tool" aria-pressed="@(_tool == key ? "true" : "false")" @onclick="() => SetTool(key)" data-testid="mtp-tool" data-tool="@key">@label</button>
                }
                <a class="msb-link mtp-tools-advanced" href="@($"{M.LegacyPlanRoute}?draft={plan.Id}&advanced=1")" data-testid="mtp-advanced">Avanserte verktøy</a>
            </nav>

            @PreviewDialog()
            @if (_tool == "versions" && Api is { } versionsApi)
            {
                <BirkNext.Web.Components.ManualTesting.PlanVersionsPanel Draft="plan" Api="versionsApi" CanWrite="CanWrite" ReadOnly="ReadOnlyPlan" Dirty="Dirty" Restored="ReplacedAsync" />
            }
            else if (_tool == "changes" && Api is { } changesApi)
            {
                <BirkNext.Web.Components.ManualTesting.PlanSourceChangesPanel Draft="plan" Api="changesApi" CanWrite="CanWrite" ReadOnly="ReadOnlyPlan" Dirty="Dirty" Refreshed="ReplacedAsync" />
            }
            else
            {
                var (rows, hidden) = P.Rows(plan, _showTechnical, _query);
                <div class="mtp-layout">
                    <nav class="mtp-master" aria-label="Scenarioer og testtilfeller" data-testid="mtp-master">
                        @if (plan.PlannedScenarios is { Count: > 0 } plannedItems && PlannedOnly(plan) is { Count: > 0 } notPrepared)
                        {
                            @* Scenario-only plan items (2026-11-26): planned, not prepared. Preparing one creates its case through the normal flow (no duplicate item). *@
                            <section class="mtp-planned" aria-label="Planlagte scenarioer uten testtilfelle" data-testid="mtp-planned">
                                <span class="mtp-ctx-label">Planlagt – ikke klargjort (@notPrepared.Count)</span>
                                <ul class="mtp-planned-list">
                                    @foreach (var item in notPrepared)
                                    {
                                        var it = item;
                                        <li data-testid="mtp-planned-item" data-scenario="@it.ScenarioId">
                                            <span class="mtp-planned-title">@(it.StoryId is { } sid && it.NumberInStory is { } n ? $"{sid} · AC {n} — " : "")@it.Title</span>
                                            <span class="msb-status msb-tone-muted" data-testid="mtp-planned-state">Scenario – ikke klargjort</span>
                                            @if (plan.Suites.Any(s => s.Id == it.SuiteId)) { <span class="mt-muted msb-small">@PlanStructure.PathOf(plan.Suites, it.SuiteId)</span> }
                                            <button type="button" class="msb-link" @onclick="() => OpenPreview(new(null, it))" data-testid="mtp-planned-preview">Forhåndsvis</button>
                                            <button type="button" class="msb-link" @onclick="() => _prepItem = it.ScenarioId" data-testid="mtp-planned-ready">@(it.StoryId is null ? "Klargjør scenario" : "Klargjør AC")</button>
                                            @if (CanWrite && !ReadOnlyPlan)
                                            {
                                                <button type="button" class="msb-link" disabled="@(_busy || Dirty)" @onclick="() => PrepareItemAsync(it)" data-testid="mtp-planned-prepare">Forbered testtilfelle</button>
                                            }
                                        </li>
                                    }
                                </ul>
                            </section>
                        }
                        <div class="mtp-master-tools">
                            <input type="search" class="mtp-search" placeholder="Søk i scenarioer, krav …" aria-label="Søk" value="@_query" @oninput="e => _query = e.Value?.ToString() ?? string.Empty" data-testid="mtp-search" />
                            <label class="mtp-toggle"><input type="checkbox" checked="@_showTechnical" @onchange="e => _showTechnical = e.Value is true" data-testid="mtp-technical" /> Vis teknisk innhold</label>
                            @if (CanWrite && !ReadOnlyPlan)
                            {
                                <button type="button" class="msb-link" disabled="@_busy" @onclick="() => OpenNewCaseAsync(null, null)" data-testid="mtp-new-case">+ Nytt testtilfelle</button>
                            }
                            @if (!_showTechnical && hidden > 0)
                            {
                                <span class="mt-muted msb-small" data-testid="mtp-hidden">@hidden teknisk@(hidden == 1 ? "" : "e") testtilfelle@(hidden == 1 ? "" : "r") skjult</span>
                            }
                        </div>
                        @if (PlanSuiteEditing.ShowTree(plan))
                        {
                            <div class="mtp-suite-tools" data-testid="mtp-suite-tools">
                                <button type="button" class="msb-link" @onclick="() => _collapsedSuites.Clear()" data-testid="mtp-suites-expand">Vis alle grupper</button>
                                <button type="button" class="msb-link" @onclick="() => _collapsedSuites = [.. plan.Suites.Select(x => x.Id)]" data-testid="mtp-suites-collapse">Skjul alle</button>
                                @if (CanWrite && !ReadOnlyPlan)
                                {
                                    <button type="button" class="msb-link" aria-expanded="@(_manageSuites ? "true" : "false")" @onclick="() => { _manageSuites = !_manageSuites; _suiteError = null; }" data-testid="mtp-suites-manage">Testgrupper</button>
                                }
                            </div>
                        }
                        else if (CanWrite && !ReadOnlyPlan && (plan.Suites.Count > 0 || PlanSuiteEditing.IsEmpty(plan)))
                        {
                            <div class="mtp-suite-tools"><button type="button" class="msb-link" aria-expanded="@(_manageSuites ? "true" : "false")" @onclick="() => { _manageSuites = !_manageSuites; _suiteError = null; }" data-testid="mtp-suites-manage">Testgrupper</button></div>
                        }
                        @if (_manageSuites) { @SuitePanel(plan) }
                        @if (PlanSuiteEditing.IsEmpty(plan) && plan.Suites.Count == 0)
                        {
                            @* A plan with nothing in it is a valid plan (2026-11-26), not an error. *@
                            <section class="msb-empty mtp-plan-empty" data-testid="mtp-plan-empty">
                                <p><strong>Testplanen er tom.</strong></p>
                                <p class="mt-muted msb-small">Opprett testgrupper for å organisere testplanen, eller legg til et testtilfelle direkte. Du kan også legge til scenarioer fra Finn og forstå senere.</p>
                                @if (CanWrite && !ReadOnlyPlan)
                                {
                                    <div class="mtp-plan-empty-actions">
                                        <button type="button" class="btn btn-outline-primary btn-sm" disabled="@_busy" @onclick="() => { _manageSuites = true; _suiteError = null; }" data-testid="mtp-plan-empty-suite">Opprett testgruppe</button>
                                        <button type="button" class="btn btn-outline-primary btn-sm" disabled="@_busy" @onclick="() => OpenNewCaseAsync(null, null)" data-testid="mtp-plan-empty-case">Legg til testtilfelle</button>
                                    </div>
                                }
                            </section>
                        }
                        else if (rows.Count == 0 && !PlanSuiteEditing.IsEmpty(plan))
                        {
                            <p class="msb-empty" data-testid="mtp-rows-none">@(hidden > 0 && !_showTechnical ? "Alle testtilfellene i testplanen er tekniske. Slå på «Vis teknisk innhold» for å se dem." : "Ingen treff.")</p>
                        }
                        <ul class="mtp-scenarios">
                            @if (PlanSuiteEditing.ShowTree(plan))
                            {
                                @SuiteTree(plan, rows, null, 0)
                                @foreach (var loose in rows.Where(r => plan.Suites.All(x => x.Id != r.Cases.FirstOrDefault()?.SuiteId))) { @RowItem(loose) }
                            }
                            else
                            {
                                @foreach (var row in rows) { @RowItem(row) }
                            }
                        </ul>
                    </nav>

                    <section class="mtp-detail" aria-label="Testtilfelle" data-testid="mtp-detail">
                        @if (_newCase is { } nc)
                        {
                            <section class="mtp-new" aria-label="Nytt testtilfelle" data-testid="mtp-new" data-scenario="@(nc.ScenarioKey ?? "")">
                                <h3 class="mtp-new-title">Nytt testtilfelle</h3>
                                <p class="mt-muted msb-small" data-testid="mtp-new-context">@(nc.ScenarioTitle is { } ncTitle ? $"Under scenarioet «{ncTitle}»." : "Skrives direkte i testplanen, uten scenario.")</p>
                                <label class="msb-small">Tittel
                                    <input type="text" class="mtp-lcell" value="@nc.Title" @oninput="e => nc.Title = e.Value?.ToString() ?? string.Empty" data-testid="mtp-new-title-input" /></label>
                                <div class="mtw-kind">
                                    <span class="mtp-ctx-label">Testtype</span>
                                    <div class="mtw-seg" role="radiogroup" aria-label="Testtype for det nye testtilfellet">
                                        @foreach (var (k, label) in new[] { (ScenarioTestKind.Manual, "Manuell"), (ScenarioTestKind.Technical, "Teknisk") })
                                        {
                                            var kind = k;
                                            <button type="button" role="radio" class="mtw-seg-btn is-@kind.ToString().ToLowerInvariant()" aria-checked="@(nc.Kind == kind ? "true" : "false")"
                                                    @onclick="() => nc.Kind = kind" data-testid="mtp-new-kind-option" data-kind="@kind">@label</button>
                                        }
                                    </div>
                                </div>
                                <p class="mt-muted msb-small" data-testid="mtp-new-kind-hint">@P.SuggestionText(nc.Suggestion)</p>
                                @* Suite, test level and scenario type (2026-11-26): the suite's level is only a proposal; the case keeps its own level when moved. *@
                                @if (_plan is { Suites.Count: > 0 } suitePlan)
                                {
                                    <label class="msb-small">Testgruppe
                                        <select class="msb-select" @onchange="e => { nc.SuiteId = e.Value?.ToString(); nc.Level = suitePlan.Suites.FirstOrDefault(x => x.Id == nc.SuiteId)?.TestLevel ?? nc.Level; }" data-testid="mtp-new-suite">
                                            <option value="" selected="@(nc.SuiteId is null)">@(nc.ScenarioKey is null ? "Velg testgruppe" : "Samme som scenarioet")</option>
                                            @foreach (var (sid, spath) in PlanSuiteEditing.Choices(suitePlan)) { <option value="@sid" selected="@(nc.SuiteId == sid)">@spath</option> }
                                        </select></label>
                                }
                                <label class="msb-small">Testnivå
                                    <select class="msb-select" @onchange="e => nc.Level = Enum.TryParse<ScenarioTestLevel>(e.Value?.ToString(), out var lv) ? lv : null" data-testid="mtp-new-level">
                                        <option value="" selected="@(nc.Level is null)">Ikke angitt</option>
                                        @foreach (var lv in TestLevelClassifier.Order) { <option value="@lv" selected="@(nc.Level == lv)">@TestLevelClassifier.Label(lv)</option> }
                                    </select></label>
                                @if (nc.SuiteId is { } chosenSuite && _plan?.Suites.FirstOrDefault(x => x.Id == chosenSuite)?.TestLevel is { } suiteLevel && nc.Level is { } caseLevel && suiteLevel != caseLevel)
                                {
                                    <p class="mt-muted msb-small" data-testid="mtp-new-level-differs">Testgruppen er for «@TestLevelClassifier.Label(suiteLevel)»; testtilfellet blir «@TestLevelClassifier.Label(caseLevel)». Det er lov — gruppen er bare organisering.</p>
                                }
                                <label class="msb-small">Scenariotype
                                    <select class="msb-select" @onchange="e => nc.Type = Enum.TryParse<ScenarioRequirementType>(e.Value?.ToString(), out var ty) ? ty : null" data-testid="mtp-new-type">
                                        <option value="" selected="@(nc.Type is null)">Ikke angitt</option>
                                        @foreach (var ty in ScenarioTypeClassifier.Order) { <option value="@ty" selected="@(nc.Type == ty)">@ScenarioTypeClassifier.Label(ty)</option> }
                                    </select></label>
                                <div class="mtp-new-actions">
                                    <button type="button" class="btn btn-primary btn-sm" disabled="@(_busy || nc.Kind is null || string.IsNullOrWhiteSpace(nc.Title))" @onclick="CreateCaseAsync" data-testid="mtp-new-create">Legg til</button>
                                    <button type="button" class="msb-link" @onclick="() => _newCase = null" data-testid="mtp-new-cancel">Avbryt</button>
                                </div>
                            </section>
                        }
                        @if (_pending is not null)
                        {
                            <div class="mtp-unsaved" role="alertdialog" aria-label="Ulagrede endringer" data-testid="mtp-unsaved">
                                <span>Du har ulagrede endringer i «@_form?.Title».</span>
                                <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick="SaveAndContinueAsync" data-testid="mtp-unsaved-save">Lagre og fortsett</button>
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="DiscardAndContinue" data-testid="mtp-unsaved-discard">Forkast endringene</button>
                                <button type="button" class="msb-link" @onclick="() => _pending = null" data-testid="mtp-unsaved-cancel">Avbryt</button>
                            </div>
                        }
                        @* «Klargjør AC» for a planned scenario WITHOUT a test case (2026-11-26): preparation needs no case, and none is created here. *@
                        @if (_prepItem is { } prepId && _ws?.ProjectKey is { } prepKey && _ws.Discovery?.Candidates.FirstOrDefault(x => x.CandidateId == prepId) is { } prepScenario)
                        {
                            <div class="mtp-prep-item" data-testid="mtp-prep-item">
                                <button type="button" class="msb-link mtp-prep-close" @onclick="() => _prepItem = null" data-testid="mtp-prep-close">Lukk klargjøring</button>
                                <BirkNext.Web.Components.ManualTesting.ScenarioPreparationPanel ProjectKey="@prepKey" Scenario="prepScenario"
                                    Cases="@(_plan!.Cases.Where(x => x.Source.ScenarioId == prepId).ToList())" ReadOnly="@(!CanWrite)" />
                            </div>
                        }
                        else if (Selected is not { } current || _form is null)
                        {
                            @* Testplaner v4 (2026-11-26): an empty plan is not a dead end at «Velg et testtilfelle». Cases are optional. *@
                            @if (_plan is { } emptyPlan && emptyPlan.Cases.Count == 0)
                            {
                                var plannedOnly = emptyPlan.PlannedScenarios?.Count ?? 0;
                                <div class="msb-empty mtp-empty-plan" data-testid="mtp-plan-empty" data-planned="@plannedOnly">
                                    @if (plannedOnly == 0)
                                    {
                                        <p><strong>Ingen scenarioer i testplanen ennå.</strong> Testgruppene finnes; legg til scenarioer i dem.</p>
                                    }
                                    else
                                    {
                                        <p><strong>Ingen testtilfeller i denne testplanen.</strong> Testtilfeller er valgfrie: de @plannedOnly planlagte scenarioene kan klargjøres og gjennomføres uten. Velg «Klargjør AC» eller «Forbered testtilfelle» ved et scenario.</p>
                                    }
                                    <span class="mtp-empty-actions">
                                        @if (CanWrite && !ReadOnlyPlan) { <button type="button" class="btn btn-primary btn-sm" @onclick="() => _addScenarios = true" data-testid="mtp-add-scenarios">Legg til scenarioer</button> }
                                        <a class="btn btn-secondary btn-sm" href="@M.DiscoverRoute" data-testid="mtp-find-scenarios">Finn scenarioer</a>
                                        <a class="msb-link" href="@M.PlansRoute" data-testid="mtp-go-plans">Gå til Testplaner</a>
                                    </span>
                                </div>
                            }
                            else
                            {
                                <p class="msb-empty" data-testid="mtp-detail-none">Velg et testtilfelle eller et planlagt scenario i listen.</p>
                            }
                        }
                        else
                        {
                            var readonlyCase = !CanWrite || ReadOnlyPlan || current.Review is TestCaseReviewState.Excluded or TestCaseReviewState.Superseded;
                            var crumbScenario = current.ParentScenario is { } crumbKey ? _plan!.Cases.FirstOrDefault(x => x.Source.Kind != ScenarioSourceKind.Manual && x.Source.ScenarioId == crumbKey) : null;
                            @if (plan.Suites.Count > 1 || PlanSuiteEditing.Hierarchical(plan))
                            {
                                <label class="mtp-case-suite msb-small" data-testid="mtp-case-suite-label">Testgruppe
                                    <select class="msb-select" disabled="@(_busy || !CanWrite || ReadOnlyPlan || Dirty)" title="@(Dirty ? "Lagre endringene i testtilfellet før du flytter det." : null)"
                                            @onchange="e => MoveCaseAsync(current.Source.ScenarioId, e.Value?.ToString())" data-testid="mtp-case-suite">
                                        @foreach (var (sid, spath) in PlanSuiteEditing.Choices(plan)) { <option value="@sid" selected="@(current.SuiteId == sid)">@spath</option> }
                                    </select></label>
                            }
                            <nav class="mtw-crumbs" aria-label="Plassering" data-testid="mtp-breadcrumb">
                                @if (current.Generated.Story is { } crumbStory) { <span data-testid="mtp-breadcrumb-story">@ScenarioWorkspacePresentation.StoryLabel(crumbStory)</span><span aria-hidden="true"> › </span> }
                                else { <span class="mt-muted">Uten brukerhistorie</span><span aria-hidden="true"> › </span> }
                                @if (crumbScenario is not null && !ReferenceEquals(crumbScenario, current)) { <span data-testid="mtp-breadcrumb-scenario">Scenario «@crumbScenario.EffectiveTitle»</span><span aria-hidden="true"> › </span> }
                                <span>Testtilfelle</span>
                                @if (DiscoverScenarioId(current) is { } discoverId)
                                {
                                    <button type="button" class="msb-link" @onclick="() => ShowInDiscoverAsync(current, discoverId)" data-testid="mtp-show-in-discover">Vis scenarioet i Finn og forstå</button>
                                }
                            </nav>
                            <div class="mtp-detail-head">
                                <span class="msb-status msb-tone-@P.ReviewTone(current.Review)" data-testid="mtp-detail-state">@P.ReviewLabel(current.Review)</span>
                                @if (P.SourceLabel(current) is { } src)
                                {
                                    <span class="msb-status msb-tone-warn" title="@current.SourceStateReason" data-testid="mtp-detail-source">@src</span>
                                }
                                @if (P.TechnicalReason(current) is { } why) { <span class="msb-status msb-tone-muted" data-testid="mtp-detail-technical">@why</span> }
                                @if (current.Source.Kind == ScenarioSourceKind.Manual) { <span class="msb-status msb-tone-muted">Skrevet av en person</span> }
                            </div>
                            @if (current.SourceStateReason is { Length: > 0 } reason && current.SourceState is not null and not CaseSourceState.Current)
                            {
                                <p class="mtp-source-banner" data-testid="mtp-case-source-reason">@reason</p>
                            }
                            @if (current.HasUnresolvedConflict && current.Generated.Conflicts is { Count: > 0 } conflicts)
                            {
                                <div class="mtp-conflict" data-testid="mtp-conflict">
                                    <p><strong>Kildene er uenige om forventet resultat.</strong> Velg hvilket som gjelder, eller skriv det selv, og begrunn valget. Testtilfellet kan ikke godkjennes før dette er avklart.</p>
                                    <ul class="mtp-claims">
                                        @foreach (var claim in conflicts.SelectMany(x => x.Claims).DistinctBy(x => x.CandidateId + x.Expected))
                                        {
                                            <li>
                                                <label><input type="radio" name="mtp-claim" checked="@(_conflictChoice == claim.CandidateId)" disabled="@readonlyCase"
                                                              @onchange="() => { _conflictChoice = claim.CandidateId; _conflictText = claim.Expected; }" data-testid="mtp-claim" />
                                                    <span>@claim.Expected</span> <span class="mt-muted msb-small">(@claim.SourceCategory)</span></label>
                                            </li>
                                        }
                                    </ul>
                                    @if (!readonlyCase)
                                    {
                                        <label class="mtp-field"><span>Forventet resultat som gjelder</span><textarea rows="2" value="@_conflictText" @oninput="e => _conflictText = e.Value?.ToString() ?? string.Empty" data-testid="mtp-conflict-expected"></textarea></label>
                                        <label class="mtp-field"><span>Begrunnelse</span><input type="text" value="@_conflictWhy" @oninput="e => _conflictWhy = e.Value?.ToString() ?? string.Empty" data-testid="mtp-conflict-why" /></label>
                                        <button type="button" class="btn btn-secondary btn-sm" disabled="@(_busy || Dirty || string.IsNullOrWhiteSpace(_conflictText) || string.IsNullOrWhiteSpace(_conflictWhy))"
                                                title="@(Dirty ? "Lagre først." : null)" @onclick="ResolveConflictAsync" data-testid="mtp-conflict-resolve">Avklar konflikten</button>
                                    }
                                </div>
                            }

                            @if (current.Generated.Story is { } us)
                            {
                                @* The user story (2026-11-25): a prominent, quiet card in the editor's language — Norsk shows the plan's stored translation
                                   («Oversett alle» translates stories with their cases), Original the source, Sammenlign both. Details one click away. *@
                                var objectives = P.StoryObjectiveCoverage(_plan!, us);
                                var refs = StoryInterpretation.ReferencedStories(us.Description);
                                var nbStory = P.StoryIn(_plan, us, norwegian: true);
                                var ogStory = P.StoryIn(_plan, us, norwegian: false);
                                var storyCompare = _lang == EditorLanguage.Compare && nbStory.Translated;
                                var shown = _lang == EditorLanguage.Norwegian || storyCompare ? nbStory : ogStory;
                                <section class="mtp-us is-story" aria-label="Brukerhistorie" data-testid="mtp-story" data-language="@(shown.Translated ? "nb" : "original")">
                                    <div class="mtp-us-head">
                                        @if (us.StoryId is { Length: > 0 } usid) { <span class="mtw-us">@usid</span> }
                                        @if (us.Priority is { Length: > 0 } prio) { <span class="mtw-prio" data-testid="mtp-story-priority">@prio</span> }
                                        <h3 class="mtp-us-title" data-testid="mtp-story-title">@shown.Title</h3>
                                        @if (storyCompare && ogStory.Title != nbStory.Title) { <span class="mtp-us-original-title" data-testid="mtp-story-title-original"><span class="mtp-lang-tag">Original</span>@ogStory.Title</span> }
                                        @if (objectives.Count > 0)
                                        {
                                            var expectations = objectives.Where(o => o.Objective.Kind == StoryObjectiveKind.Verification).ToList();
                                            <span class="mtw-chip msb-tone-muted" title="Forventede resultater fra «Uavhengig test» som er nevnt i planens testtilfeller (ordtreff — et hint, ikke utviklertestdekning)." data-testid="mtp-story-coverage">@expectations.Count(o => o.Covered)/@expectations.Count forventede resultater nevnt i testtilfeller</span>
                                        }
                                    </div>
                                    @if (storyCompare)
                                    {
                                        <div class="mtp-us-compare" data-testid="mtp-story-compare">
                                            <p class="mtw-story-lead"><span class="mtp-lang-tag">Norsk</span> @nbStory.Description</p>
                                            <p class="mtw-story-lead"><span class="mtp-lang-tag">Original</span> @ogStory.Description</p>
                                        </div>
                                    }
                                    else if (shown.Description is { Length: > 0 } desc) { <p class="mtw-story-lead" data-testid="mtp-story-description">@desc</p> }
                                    @if (_lang != EditorLanguage.Original && !nbStory.Translated)
                                    {
                                        <p class="mtp-us-note" data-testid="mtp-story-untranslated" title="«Oversett alle» oversetter brukerhistorien sammen med testtilfellene.">Ikke oversatt ennå — vises på originalspråket.</p>
                                    }
                                    else if (nbStory.Stale && _lang != EditorLanguage.Original)
                                    {
                                        <p class="mtp-us-note is-warn" data-testid="mtp-story-stale" title="Oversett på nytt med «Oversett alle».">Kilden er endret etter oversettelsen.</p>
                                    }
                                    <div class="mtw-story-foot">
                                        @if (refs.Count > 0) { @foreach (var rf in refs) { <span class="mtp-chip" data-testid="mtp-story-ref">@rf</span> } }
                                        <button type="button" class="mtw-toggle" aria-expanded="@(_storyOpen ? "true" : "false")" @onclick="() => _storyOpen = !_storyOpen" data-testid="mtp-story-toggle">@(_storyOpen ? "Skjul detaljer" : "Detaljer")</button>
                                    </div>
                                    @if (_storyOpen)
                                    {
                                        <div class="mtp-us-body">
                                            @if (storyCompare && (nbStory.Why is { Length: > 0 } || ogStory.Why is { Length: > 0 }))
                                            {
                                                <div class="mtp-us-block" data-testid="mtp-story-why"><span class="mtp-ctx-label">Hvorfor denne prioriteten</span>
                                                    <div class="mtp-us-compare" data-testid="mtp-story-why-compare">
                                                        <p><span class="mtp-lang-tag">Norsk</span> @nbStory.Why</p>
                                                        <p><span class="mtp-lang-tag">Original</span> @ogStory.Why</p>
                                                    </div></div>
                                            }
                                            else if (shown.Why is { Length: > 0 } why2)
                                            {
                                                <div class="mtp-us-block" data-testid="mtp-story-why"><span class="mtp-ctx-label">Hvorfor denne prioriteten</span><p>@why2</p></div>
                                            }
                                            @if (shown.IndependentTest is { Length: > 0 } independent)
                                            {
                                                <div class="mtp-us-block" data-testid="mtp-story-independent">
                                                    <span class="mtp-ctx-label">Uavhengig test</span>
                                                    @if (storyCompare)
                                                    {
                                                        <div class="mtp-us-compare" data-testid="mtp-story-independent-compare">
                                                            <p class="mtp-quote"><span class="mtp-lang-tag">Norsk</span> @nbStory.IndependentTest</p>
                                                            <p class="mtp-quote"><span class="mtp-lang-tag">Original</span> @ogStory.IndependentTest</p>
                                                        </div>
                                                    }
                                                    else { <p class="mtp-quote">@independent</p> }
                                                    @* 2026-11-26: test preparation, not coverage — actions with their expected results in source order. «Nevnt i et testtilfelle» is a
                                                       word match against this plan's manual cases (a hint); developer-test coverage is per acceptance scenario, never here. *@
                                                    <ol class="mtp-prep-steps" data-testid="mtp-prep-steps">
                                                        @foreach (var step in P.PreparationSteps(objectives))
                                                        {
                                                            <li class="mtp-prep-step" data-testid="mtp-prep-step">
                                                                <span class="mtp-prep-action" data-testid="mtp-prep-action">@(step.Action ?? "Ingen handling oppgitt i kilden")</span>@if (step.ActionInterpreted) { <span class="msb-tag" title="Tolket av BirkNext fra originalsetningen: «@step.ActionSource»">tolket av BirkNext</span> }
                                                                @foreach (var oc in step.Expected)
                                                                {
                                                                    <span class="mtp-prep-expected" data-testid="mtp-objective" data-covered="@(oc.Covered ? "true" : "false")"
                                                                          title="@(oc.Covered ? "Nevnt i: " + string.Join(", ", oc.CaseTitles.Take(3)) : "Ikke nevnt i planens testtilfeller")">
                                                                        <span class="mtp-ctx-label">Forventet</span> <span class="mtp-obj-text">@oc.Objective.Text</span>
                                                                        @if (oc.Objective.NeedsReview) { <span class="msb-tag" title="Tolket av BirkNext fra originalsetningen: «@oc.Objective.Source»">tolket av BirkNext</span> }
                                                                        @if (oc.Covered) { <span class="mtp-obj-cov is-mentioned" data-testid="mtp-objective-covered">Nevnt i et testtilfelle</span> }
                                                                        else { <span class="mtp-obj-cov is-not-mentioned" data-testid="mtp-objective-gap">Ikke nevnt i planens testtilfeller</span> }
                                                                    </span>
                                                                }
                                                            </li>
                                                        }
                                                    </ol>
                                                    <p class="mt-muted msb-small" data-testid="mtp-prep-note">Dette er testforberedelse, ikke utviklertestdekning. Utviklertester vurderes per akseptansescenario («Hva er allerede kontrollert?»).</p>
                                                </div>
                                            }
                                        </div>
                                    }
                                </section>
                            }
                            @* The scenario the selected case comes from: its acceptance criterion number, never "US1 — …" (the card above names the story). *@
                            <h3 class="mtp-scenario-heading" data-testid="mtp-scenario-heading">@P.ScenarioHeading(current, _lang)</h3>
                            @* «Hva er allerede kontrollert?» (2026-11-25): the scenario's source tests as Finn og forstå reviews them; read-only here, never a result. *@
                            @if (ScenarioCandidateOf(current) is { } scenarioCandidate)
                            {
                                var planTech = TC.Of(scenarioCandidate, PlanTechDecisions(scenarioCandidate), _ws?.Discovery?.TestsReadForScenarios ?? false);
                                <details class="mtw-tech mtp-tech" data-testid="mtp-tech" data-state="@planTech.State">
                                    <summary><span class="mtp-ctx-label">Hva er allerede kontrollert?</span> <span class="msb-status msb-tone-@planTech.Tone" data-testid="mtp-tech-state">@planTech.Label</span>
                                        @if (BirkNext.Web.Services.DeveloperTestCoveragePresentation.PrioritiseManual(planTech.State)) { <span class="msb-status msb-tone-warn" data-testid="mtp-tech-priority">Prioriter manuell test</span> }</summary>
                                    <p class="msb-small" data-testid="mtp-tech-meaning">@BirkNext.Web.Services.DeveloperTestCoveragePresentation.Meaning(planTech.State)</p>
                                    @if (planTech.Tests.Count == 0)
                                    {
                                        <p class="mt-muted msb-small">@(planTech.State == TC.State.NotAssessed ? "Testene i kilden er ikke lest for scenariohenvisninger ennå." : "Ingen automatisk test i kilden nevner scenarioet.")</p>
                                    }
                                    else
                                    {
                                        <p class="mt-muted msb-small" data-testid="mtp-tech-result">@TC.NoResult. Vurder i Finn og forstå om et manuelt testtilfelle fortsatt trengs; automatiske tester fjerner ingenting her.</p>
                                        <ul class="mtp-tech-list">
                                            @foreach (var tr in planTech.Tests)
                                            {
                                                <li data-testid="mtp-tech-test" data-link="@tr.Link"><span class="mtw-tech-layer">@tr.Layer</span> @tr.ReadableName — <span class="msb-small">@TC.LinkLabel(tr.Link)@(tr.Link == TC.Link.Confirmed ? $", {TC.ExtentLabel(tr.Extent).ToLowerInvariant()}" : "")</span></li>
                                            }
                                        </ul>
                                    }
                                </details>
                                @* «Fra spesifikasjonen» (2026-11-25): the same explicit-id context as Finn og forstå, when the scenario's specification is the one loaded. *@
                                @if (PlanSpecItems(scenarioCandidate) is { Count: > 0 } planSpecItems)
                                {
                                    var planSpec = SC.For(planSpecItems, scenarioCandidate.RequirementIds, scenarioCandidate.Story?.StoryId);
                                    <details class="mtw-spec mtp-spec" data-testid="mtp-spec-context" data-direct="@planSpec.Direct.Count">
                                        <summary><span class="mtp-ctx-label">Fra spesifikasjonen</span> <span class="msb-small mt-muted">@SC.Summary(planSpec)</span></summary>
                                        @foreach (var kind in SC.Order.Where(k => planSpec.Count(k, direct: true) > 0))
                                        {
                                            <div class="mtw-spec-group" data-kind="@kind"><span class="mtw-spec-heading">@SC.Heading(kind)</span>
                                                <ul>@foreach (var item in planSpec.Direct.Where(i => i.Kind == kind))
                                                {
                                                    <li class="mtw-spec-item @(item.Historical ? "is-historical" : null)" data-testid="mtp-spec-item"><span class="mtw-spec-title">@(item.Id is { Length: > 0 } id && id != item.Title ? $"{id}: " : "")@item.Title</span>
                                                        @if (item.Status is { } specStatus) { <span class="msb-tag">@specStatus</span> }
                                                        @if (item.Text is { Length: > 0 } t) { <span class="mtw-spec-text">@t</span> }
                                                        @if (item.StatusNote is { Length: > 0 } note) { <span class="mt-muted msb-small">@note</span> }</li>
                                                }</ul></div>
                                        }
                                        <p class="mt-muted msb-small">Alle spesielle situasjoner, avklaringer, mål, avhengigheter og «Dette inngår ikke» finnes under «Fra spesifikasjonen» i Finn og forstå.</p>
                                    </details>
                                }
                            }

                            var hasNb = _form.HasTranslation;
                            var showO = _lang != EditorLanguage.Norwegian;
                            var showN = hasNb && _lang != EditorLanguage.Original;
                            var emptyNb = !hasNb && _lang != EditorLanguage.Original;
                            var compare = showO && showN;
                            var tstatus = P.TranslationStatus(current);
                            var stale = hasNb && ScenarioPlanning.StateOf(current) == TranslationState.SourceChanged;
                            var gaps = P.UntranslatedFields(_form);
                            var canTranslate = CanWrite && !ReadOnlyPlan && current.ParentScenario is not null;
                            <div class="mtp-editor @(compare ? "is-compare" : "")" data-language="@_lang" data-testid="mtp-editor">
                                <div class="mtp-langbar" data-testid="mtp-translation-review">
                                    <div class="mtp-seg" role="radiogroup" aria-label="Språk i testtilfellet" data-testid="mtp-lang">
                                        @foreach (var lang in new[] { EditorLanguage.Norwegian, EditorLanguage.Original, EditorLanguage.Compare })
                                        {
                                            var l = lang;
                                            <button type="button" role="radio" aria-checked="@(_lang == l ? "true" : "false")" class="mtp-seg-btn @(_lang == l ? "is-on" : "")"
                                                    @onclick="() => SetLangAsync(l)" data-lang="@l" data-testid="mtp-lang-option">@P.LanguageLabel(l)</button>
                                        }
                                    </div>
                                    @if (tstatus is { } ts) { <span class="msb-status msb-tone-@ts.Tone" data-testid="mtp-translation-state">@ts.Text</span> }
                                    @if (hasNb && P.IsProtectedTranslation(current))
                                    {
                                        <span class="mt-muted msb-small" data-testid="mtp-translation-protected">Beholdes ved ny maskinoversettelse.</span>
                                    }
                                    @if (gaps.Count > 0)
                                    {
                                        <span class="msb-status msb-tone-warn" title="@string.Join(", ", gaps)" data-testid="mtp-translation-gaps">Delvis oversatt: @gaps.Count @(gaps.Count == 1 ? "felt" : "felter") mangler</span>
                                    }
                                </div>

                                @if (stale && _lang != EditorLanguage.Original)
                                {
                                    <p class="mtp-source-banner" data-testid="mtp-translation-stale">Originalteksten er endret etter at den ble oversatt. Sammenlign og oppdater den norske teksten før du godkjenner.
                                        @if (!compare) { <button type="button" class="msb-link" @onclick="() => _lang = EditorLanguage.Compare" data-testid="mtp-translation-compare">Sammenlign</button> }</p>
                                }

                                @if (emptyNb)
                                {
                                    <div class="mtp-lang-empty" data-testid="mtp-lang-empty">
                                        <p><strong>Ingen norsk oversettelse finnes ennå.</strong></p>
                                        <p class="mt-muted msb-small">@(_auto == AutoTranslation.Running ? "Oversetter …" : "Manglende oversettelser lages automatisk når testplanen åpnes.") Originalteksten er gjeldende til en oversettelse er laget og gjennomgått.</p>
                                        <div class="mtp-lang-empty-actions">
                                            @if (canTranslate)
                                            {
                                                <button type="button" class="btn btn-primary btn-sm" disabled="@(Dirty || _busy || !_translationAvailable)" title="@(Dirty ? "Lagre først." : _translationAvailable ? null : "Oversettelse er ikke satt opp.")"
                                                        @onclick="() => TranslateAsync(current.ParentScenario!)" data-testid="mtp-translate-inline">Oversett til norsk</button>
                                            }
                                            @if (_lang == EditorLanguage.Norwegian)
                                            {
                                                <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _lang = EditorLanguage.Original" data-testid="mtp-lang-show-original">Vis originalen</button>
                                            }
                                        </div>
                                    </div>
                                }

                                @{ var caseSuggestion = P.SuggestKind(ScenarioCaseOf(current), ScenarioDecision(ScenarioCaseOf(current))); }
                                <div class="mtw-kind mtp-case-kind" data-testid="mtp-kind" data-kind="@(_form.TestKind?.ToString() ?? "")">
                                    <span class="mtp-ctx-label">Testtype</span>
                                    <div class="mtw-seg" role="radiogroup" aria-label="Testtype for testtilfellet">
                                        @foreach (var (k, label) in new[] { (ScenarioTestKind.Manual, "Manuell"), (ScenarioTestKind.Technical, "Teknisk") })
                                        {
                                            var kind = k;
                                            <button type="button" role="radio" class="mtw-seg-btn is-@kind.ToString().ToLowerInvariant()" aria-checked="@(_form.TestKind == kind ? "true" : "false")" disabled="@readonlyCase"
                                                    @onclick="() => _form.TestKind = kind" data-testid="mtp-kind-option" data-kind="@kind">@label</button>
                                        }
                                    </div>
                                    @if (_form.TestKind is null) { <span class="msb-status msb-tone-warn" data-testid="mtp-kind-unset">Ikke angitt</span> }
                                    <span class="mt-muted msb-small" data-testid="mtp-kind-hint">@P.SuggestionText(caseSuggestion)</span>
                                </div>
                                <div class="mtp-case-classes" data-testid="mtp-case-classes">
                                    <label class="msb-small"><span class="mtp-ctx-label">Testnivå</span>
                                        <select class="msb-select" disabled="@readonlyCase" @onchange="e => _form.TestLevel = Enum.TryParse<ScenarioTestLevel>(e.Value?.ToString(), out var lv) ? lv : null" data-testid="mtp-case-level">
                                            <option value="" selected="@(_form.TestLevel is null)">Ikke angitt</option>
                                            @foreach (var lv in TestLevelClassifier.Order) { <option value="@lv" selected="@(_form.TestLevel == lv)">@TestLevelClassifier.Label(lv)</option> }
                                        </select></label>
                                    <label class="msb-small"><span class="mtp-ctx-label">Scenariotype</span>
                                        <select class="msb-select" disabled="@readonlyCase" @onchange="e => _form.ScenarioType = Enum.TryParse<ScenarioRequirementType>(e.Value?.ToString(), out var ty) ? ty : null" data-testid="mtp-case-type">
                                            <option value="" selected="@(_form.ScenarioType is null)">Ikke angitt</option>
                                            @foreach (var ty in ScenarioTypeClassifier.Order) { <option value="@ty" selected="@(_form.ScenarioType == ty)">@ScenarioTypeClassifier.Label(ty)</option> }
                                        </select></label>
                                    <span class="mt-muted msb-small">Testmetode: @(_form.TestKind switch { ScenarioTestKind.Manual => "Manuell", ScenarioTestKind.Technical => "Teknisk", _ => "ikke angitt" })</span>
                                </div>
                                @if (showO || showN)
                                {
                                    @if (compare)
                                    {
                                        <div class="mtp-lhead" aria-hidden="true"><span></span><span>Original</span><span>Norsk</span></div>
                                    }
                                    <div class="mtp-lrow" data-field="title">
                                        <span class="mtp-lrow-label">Tittel</span>
                                        @if (showO) { <input type="text" class="mtp-lcell" value="@_form.Title" @oninput="e => _form.Title = e.Value?.ToString() ?? string.Empty" disabled="@readonlyCase" aria-label="Tittel (original)" data-testid="mtp-title" /> }
                                        @if (showN)
                                        {
                                            <span class="mtp-lcell-wrap">
                                                <input type="text" class="mtp-lcell" value="@_form.TranslatedTitle" @oninput="e => _form.TranslatedTitle = e.Value?.ToString() ?? string.Empty" disabled="@readonlyCase" aria-label="Tittel (norsk)" placeholder="@_form.Title" data-testid="mtp-tr-title" />
                                                @if (P.IsUntranslated(_form, _form.Title, _form.TranslatedTitle)) { <span class="mtp-untr" data-testid="mtp-untranslated">Ikke oversatt</span> }
                                            </span>
                                        }
                                    </div>
                                    <div class="mtp-lrow" data-field="purpose">
                                        <span class="mtp-lrow-label">Formål</span>
                                        @if (showO) { <textarea class="mtp-lcell mtp-auto" rows="2" value="@_form.Purpose" @oninput="e => _form.Purpose = e.Value?.ToString() ?? string.Empty" disabled="@readonlyCase" aria-label="Formål (original)" data-testid="mtp-purpose"></textarea> }
                                        @if (showN)
                                        {
                                            <span class="mtp-lcell-wrap">
                                                <textarea class="mtp-lcell mtp-auto" rows="2" value="@_form.TranslatedPurpose" @oninput="e => _form.TranslatedPurpose = e.Value?.ToString() ?? string.Empty" disabled="@readonlyCase" aria-label="Formål (norsk)" placeholder="@_form.Purpose" data-testid="mtp-tr-purpose"></textarea>
                                                @if (P.IsUntranslated(_form, _form.Purpose, _form.TranslatedPurpose)) { <span class="mtp-untr" data-testid="mtp-untranslated">Ikke oversatt</span> }
                                            </span>
                                        }
                                    </div>
                                    <div class="mtp-lrow" data-field="preconditions">
                                        <span class="mtp-lrow-label">Forutsetninger</span>
                                        @if (showO) { <textarea class="mtp-lcell mtp-auto" rows="2" value="@_form.Preconditions" @oninput="e => _form.Preconditions = e.Value?.ToString() ?? string.Empty" disabled="@readonlyCase" aria-label="Forutsetninger (original)" data-testid="mtp-preconditions"></textarea> }
                                        @if (showN)
                                        {
                                            <span class="mtp-lcell-wrap">
                                                <textarea class="mtp-lcell mtp-auto" rows="2" value="@_form.TranslatedPreconditions" @oninput="e => _form.TranslatedPreconditions = e.Value?.ToString() ?? string.Empty" disabled="@readonlyCase" aria-label="Forutsetninger (norsk)" placeholder="@_form.Preconditions" data-testid="mtp-tr-preconditions"></textarea>
                                                @if (P.IsUntranslated(_form, _form.Preconditions, _form.TranslatedPreconditions)) { <span class="mtp-untr" data-testid="mtp-untranslated">Ikke oversatt</span> }
                                            </span>
                                        }
                                    </div>
                                }

                                <div class="mtp-field">
                                    <span>Testdata</span>
                                    <div class="mtp-testdata">
                                        <select value="@_form.TestDataNeed" @onchange="e => _form.TestDataNeed = Enum.TryParse<TestDataNeed>(e.Value?.ToString(), out var n) ? n : TestDataNeed.Unknown" disabled="@readonlyCase" aria-label="Testdatabehov" data-testid="mtp-testdata-need">
                                            @foreach (var need in Enum.GetValues<TestDataNeed>())
                                            {
                                                <option value="@need">@P.TestDataNeedLabel(need)</option>
                                            }
                                        </select>
                                        @foreach (var assetId in _form.TestDataAssetIds)
                                        {
                                            var link = current.TestData.FirstOrDefault(d => d.AssetId == assetId);
                                            var option = TestDataOptions.FirstOrDefault(o => o.AssetId == assetId);
                                            <span class="mtp-chip" data-testid="mtp-testdata-link">@(option?.Alias ?? link?.Alias ?? assetId)@(link is { Resolved: false } ? " (finnes ikke)" : "")
                                                @if (!readonlyCase) { <button type="button" class="mtp-chip-x" aria-label="@($"Fjern testdata {option?.Alias ?? assetId}")" @onclick="() => _form.TestDataAssetIds.Remove(assetId)" data-testid="mtp-testdata-remove">✕</button> }
                                            </span>
                                        }
                                        @if (!readonlyCase && TestDataOptions.Any(o => !_form.TestDataAssetIds.Contains(o.AssetId)))
                                        {
                                            <select aria-label="Koble testdata" value="" @onchange="e => { if (e.Value?.ToString() is { Length: > 0 } v && !_form.TestDataAssetIds.Contains(v)) _form.TestDataAssetIds.Add(v); }" data-testid="mtp-testdata-add">
                                                <option value="">+ Koble testdata …</option>
                                                @foreach (var o in TestDataOptions.Where(o => !_form.TestDataAssetIds.Contains(o.AssetId)))
                                                {
                                                    <option value="@o.AssetId">@P.TestDataOptionLabel(o)</option>
                                                }
                                            </select>
                                        }
                                    </div>
                                    @if (current.Generated.RequiredTestData is { Length: > 0 } required) { <span class="mt-muted msb-small" data-testid="mtp-testdata-source">Kilden sier: @required</span> }
                                    @if (!readonlyCase && TestDataOptions.Count == 0)
                                    {
                                        <span class="mt-muted msb-small" data-testid="mtp-testdata-none">Ingen testdata er registrert for prosjektet ennå. <a href="test-data">Registrer testdata</a></span>
                                    }
                                </div>

                                @* «Hva trenger du før du starter?» (2026-11-25): what the existing readiness needs from a person — how the result is observed, access and
                                   environment, and anything that stops the test now. Saved with the case like every other field; nothing is filled in for the tester. *@
                                @{ var beforeFilled = new[] { _form.ObservationMethod, _form.EnvironmentPrerequisites }.Count(v => !string.IsNullOrWhiteSpace(v)); var hindered = !string.IsNullOrWhiteSpace(_form.BlockedBy); }
                                @* Collapsed by default (UX pass 2026-11-25); the summary says what is filled in, and a recorded hindrance keeps it open. *@
                                <details class="mtp-before" open="@hindered" data-testid="mtp-before">
                                    <summary><span class="mtp-ctx-label">Før du starter</span> <span class="mt-muted msb-small" data-testid="mtp-before-summary">@(hindered ? "Hindring registrert — testen kan ikke starte" : $"{beforeFilled} av 2 fylt ut · ingen hindring")</span></summary>
                                    <label class="mtp-field">
                                        <span>Slik ser du resultatet</span>
                                        <textarea class="mtp-lcell mtp-auto" rows="2" value="@_form.ObservationMethod" @oninput="e => _form.ObservationMethod = e.Value?.ToString() ?? string.Empty" disabled="@readonlyCase"
                                                  placeholder="@(current.Generated.ObservationMethod ?? "For eksempel: i skjermbildet, i en rapport, i loggen eller i en melding")" data-testid="mtp-observation"></textarea>
                                    </label>
                                    <label class="mtp-field">
                                        <span>Tilgang og miljø</span>
                                        <textarea class="mtp-lcell mtp-auto" rows="2" value="@_form.EnvironmentPrerequisites" @oninput="e => _form.EnvironmentPrerequisites = e.Value?.ToString() ?? string.Empty" disabled="@readonlyCase"
                                                  placeholder="@(current.Generated.EnvironmentPrerequisites ?? "For eksempel: QA-miljø, rolle, tilganger og systemer som må være oppe")" data-testid="mtp-environment"></textarea>
                                    </label>
                                    <label class="mtp-field">
                                        <span>Hindring (stopper testen nå)</span>
                                        <textarea class="mtp-lcell mtp-auto" rows="2" value="@_form.BlockedBy" @oninput="e => _form.BlockedBy = e.Value?.ToString() ?? string.Empty" disabled="@readonlyCase"
                                                  placeholder="Tom = ingen kjent hindring. Skriv hva som mangler, hvem som eier det og eventuelt dato." data-testid="mtp-blocked-by"></textarea>
                                    </label>
                                </details>

                                @if (showO || showN)
                                {
                                    <fieldset class="mtp-steps" data-testid="mtp-steps">
                                        <legend>Teststeg <span class="msb-tag" data-testid="mtp-steps-count">@_form.Steps.Count</span></legend>
                                        @if (_form.Steps.Count == 0) { <p class="mt-muted msb-small" data-testid="mtp-steps-none">Ingen teststeg ennå. Beskriv hva testeren gjør, og hva som skal skje, ett steg om gangen.</p> }
                                        else if (!readonlyCase) { <p class="mt-muted msb-small mtp-steps-hint" data-testid="mtp-steps-hint">Ctrl+Enter i et steg legger til et nytt steg under.</p> }
                                        <ol>
                                            @foreach (var (step, i) in _form.Steps.Select((st, i) => (st, i)))
                                            {
                                                var index = i;
                                                <li class="mtp-step" @key="step.Key" data-testid="mtp-step">
                                                    <span class="mtp-step-no" aria-hidden="true">@(index + 1)</span>
                                                    <div class="mtp-step-body">
                                                        <div class="mtp-lrow" data-field="step-action">
                                                            <span class="mtp-lrow-label">Handling</span>
                                                            @if (showO) { <textarea class="mtp-lcell mtp-auto" rows="2" value="@step.Action" @oninput="e => step.Action = e.Value?.ToString() ?? string.Empty" @onkeydown="e => StepKey(e, index)" disabled="@readonlyCase" aria-label="@($"Handling, steg {index + 1}")" placeholder="Hva gjør testeren?" data-testid="mtp-step-action"></textarea> }
                                                            @if (showN)
                                                            {
                                                                <span class="mtp-lcell-wrap" data-testid="mtp-tr-step">
                                                                    <textarea class="mtp-lcell mtp-auto" rows="2" value="@step.TranslatedAction" @oninput="e => step.TranslatedAction = e.Value?.ToString() ?? string.Empty" disabled="@readonlyCase" aria-label="@($"Handling på norsk, steg {index + 1}")" placeholder="@step.Action" data-testid="mtp-tr-step-action"></textarea>
                                                                    @if (P.IsUntranslated(_form, step.Action, step.TranslatedAction)) { <span class="mtp-untr" data-testid="mtp-untranslated">Ikke oversatt</span> }
                                                                </span>
                                                            }
                                                        </div>
                                                        <div class="mtp-lrow" data-field="step-expected">
                                                            <span class="mtp-lrow-label">Forventet resultat</span>
                                                            @if (showO) { <textarea class="mtp-lcell mtp-auto" rows="2" value="@step.Expected" @oninput="e => step.Expected = e.Value?.ToString() ?? string.Empty" @onkeydown="e => StepKey(e, index)" disabled="@readonlyCase" aria-label="@($"Forventet resultat, steg {index + 1}")" placeholder="Hva skal skje?" data-testid="mtp-step-expected"></textarea> }
                                                            @if (showN)
                                                            {
                                                                <span class="mtp-lcell-wrap">
                                                                    <textarea class="mtp-lcell mtp-auto" rows="2" value="@step.TranslatedExpected" @oninput="e => step.TranslatedExpected = e.Value?.ToString() ?? string.Empty" disabled="@readonlyCase" aria-label="@($"Forventet resultat på norsk, steg {index + 1}")" placeholder="@step.Expected" data-testid="mtp-tr-step-expected"></textarea>
                                                                    @if (P.IsUntranslated(_form, step.Expected, step.TranslatedExpected)) { <span class="mtp-untr" data-testid="mtp-untranslated">Ikke oversatt</span> }
                                                                </span>
                                                            }
                                                        </div>
                                                    </div>
                                                    @if (P.StepWarning(step.Action, step.Expected) is { } stepWarn)
                                                    {
                                                        <span class="mtp-step-warn" role="note" data-testid="mtp-step-warning">
                                                            <strong>Teststeget bør konkretiseres.</strong> @string.Join(" ", stepWarn)
                                                        </span>
                                                    }
                                                    @if (!readonlyCase)
                                                    {
                                                        <span class="mtp-step-tools">
                                                            <button type="button" class="mtp-icon" disabled="@(index == 0)" @onclick="() => _form.MoveStep(index, -1)" aria-label="@($"Flytt steg {index + 1} opp")" data-testid="mtp-step-up">↑</button>
                                                            <button type="button" class="mtp-icon" disabled="@(index == _form.Steps.Count - 1)" @onclick="() => _form.MoveStep(index, 1)" aria-label="@($"Flytt steg {index + 1} ned")" data-testid="mtp-step-down">↓</button>
                                                            <button type="button" class="mtp-icon" @onclick="() => _form.InsertStepAfter(index)" aria-label="@($"Nytt steg under steg {index + 1}")" title="Nytt steg under" data-testid="mtp-step-insert">+</button>
                                                            <button type="button" class="mtp-icon" @onclick="() => _form.DuplicateStep(index)" aria-label="@($"Dupliser steg {index + 1}")" title="Dupliser" data-testid="mtp-step-duplicate">⧉</button>
                                                            <button type="button" class="mtp-icon mtp-icon-danger" @onclick="() => _form.RemoveStep(index)" aria-label="@($"Fjern steg {index + 1}")" title="Fjern" data-testid="mtp-step-remove">✕</button>
                                                        </span>
                                                    }
                                                </li>
                                            }
                                        </ol>
                                        @if (!readonlyCase)
                                        {
                                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _form.AddStep()" data-testid="mtp-step-add">+ Teststeg</button>
                                        }
                                    </fieldset>

                                    <div class="mtp-lrow" data-field="expected">
                                        <span class="mtp-lrow-label">Samlet forventet resultat</span>
                                        @if (showO) { <textarea class="mtp-lcell mtp-auto" rows="3" value="@_form.ExpectedResult" @oninput="e => _form.ExpectedResult = e.Value?.ToString() ?? string.Empty" disabled="@readonlyCase" aria-label="Samlet forventet resultat (original)" data-testid="mtp-expected"></textarea> }
                                        @if (showN)
                                        {
                                            <span class="mtp-lcell-wrap">
                                                <textarea class="mtp-lcell mtp-auto" rows="3" value="@_form.TranslatedExpected" @oninput="e => _form.TranslatedExpected = e.Value?.ToString() ?? string.Empty" disabled="@readonlyCase" aria-label="Samlet forventet resultat (norsk)" placeholder="@_form.ExpectedResult" data-testid="mtp-tr-expected"></textarea>
                                                @if (P.IsUntranslated(_form, _form.ExpectedResult, _form.TranslatedExpected)) { <span class="mtp-untr" data-testid="mtp-untranslated">Ikke oversatt</span> }
                                            </span>
                                        }
                                    </div>
                                }

                                @if (!readonlyCase && P.QualityHints(_form) is { Count: > 0 } hints)
                                {
                                    <div class="mtp-quality" data-testid="mtp-quality">
                                        <span class="mtp-ctx-label">Kvalitetsråd</span>
                                        <ul>@foreach (var h in hints) { <li data-testid="mtp-quality-hint">@h</li> }</ul>
                                    </div>
                                }
                                @if (showN && !readonlyCase)
                                {
                                    <p class="mt-muted msb-small">Den norske teksten lagres sammen med testtilfellet og overskrives ikke av en ny maskinoversettelse når du har redigert den. Originalteksten er fortsatt gjeldende kilde.</p>
                                }
                            </div>

                            @* «Historikk» (2026-11-25): who changed or reviewed this case, when and why — stored on the case, newest first; read-only. *@
                            @* «Testgjennomføring» (2026-11-25): «Start test» only when execution in BirkNext is switched on (System settings; Azure DevOps Test
                               Plans is the default). The case's runs are always shown when there are any, each with where it was executed and whether it was
                               run on the case as it is now — a result from an earlier version never counts for the current one. *@
                            var caseRuns = _planRuns.Where(r => r.CaseId == current.Source.ScenarioId).OrderByDescending(r => r.StartedAt).ToList();
                            var adoResults = _adoResults.Where(r => r.CaseId == current.Source.ScenarioId).ToList();
                            @if (_executionEnabled || caseRuns.Count > 0 || adoResults.Count > 0)
                            {
                                var currentFingerprint = ManualRunRules.CaseFingerprint(current);
                                <section class="mtp-runs" aria-label="Testgjennomføring" data-testid="mtp-runs">
                                    <div class="mtp-runs-head">
                                        <span class="mtp-ctx-label">Testgjennomføring</span>
                                        @if (_executionEnabled && CanWrite && !ReadOnlyPlan && current.Review is not (TestCaseReviewState.Excluded or TestCaseReviewState.Superseded))
                                        {
                                            @if (Dirty) { <span class="mt-muted msb-small" data-testid="mtp-run-save-first">Lagre endringene før du starter testen.</span> }
                                            else { <a class="btn btn-primary btn-sm" href="@($"{MR.ExecuteRoute}?draft={_plan!.Id}&case={Uri.EscapeDataString(current.Source.ScenarioId)}")" data-testid="mtp-run-start">Start test i BirkNext</a> }
                                        }
                                        else if (!_executionEnabled)
                                        {
                                            <span class="mt-muted msb-small" data-testid="mtp-run-off">Gjennomføres i Azure DevOps Test Plans.</span>
                                        }
                                    </div>
                                    @if (caseRuns.Count == 0 && (_executionEnabled || adoResults.Count == 0))
                                    {
                                        <p class="mt-muted msb-small" data-testid="mtp-runs-none">Ikke gjennomført i BirkNext ennå.</p>
                                    }
                                    @* Phase 2: results fetched from Azure DevOps, kept apart from BirkNext runs and never combined into one outcome. *@
                                    @if (adoResults.Count > 0)
                                    {
                                        <ul class="mtp-run-list" aria-label="Gjennomført i Azure DevOps">
                                            @foreach (var r in adoResults.Take(10))
                                            {
                                                <li data-testid="mtp-ado-result" data-current="@(r.Current ? "true" : "false")">
                                                    <span class="msb-status msb-tone-@P2.ResultTone(r.Outcome)">@AdoResultOutcome.Label(r.Outcome)</span>
                                                    <span class="msb-small">@((r.CompletedAt ?? r.FetchedAt).ToLocalTime().ToString("dd.MM.yyyy HH:mm"))@(r.Tester is { } t ? $" · {t}" : "")@(r.Configuration is { } cfg ? $" · {cfg}" : "") · Gjennomført i Azure DevOps</span>
                                                    @if (!r.Current) { <span class="msb-tag" data-testid="mtp-ado-earlier" title="Testtilfellet er endret etter at det ble sendt til Azure DevOps; resultatet gjelder ikke versjonen som er lagret nå.">Fra en tidligere versjon</span> }
                                                    @if (r.WebUrl is { } url) { <a class="msb-link" href="@url" target="_blank" rel="noopener noreferrer" data-testid="mtp-ado-open">Åpne</a> }
                                                </li>
                                            }
                                        </ul>
                                    }
                                    @* Both kinds are listed (v1.0 acceptance 2026-11-25): a fetched Azure DevOps result used to hide every BirkNext run of the case. *@
                                    @if (caseRuns.Count > 0)
                                    {
                                        <ul class="mtp-run-list" aria-label="Gjennomført i BirkNext">
                                            @foreach (var run in caseRuns.Take(10))
                                            {
                                                var earlier = run.CaseFingerprint != currentFingerprint;
                                                <li data-testid="mtp-run" data-current="@(earlier ? "false" : "true")">
                                                    <span class="msb-status msb-tone-@MR.RunTone(run.State, run.Outcome)">@MR.RunLabel(run.State, run.Outcome)</span>
                                                    <span class="msb-small">@run.StartedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @run.Tester · Gjennomført i BirkNext</span>
                                                    @if (earlier) { <span class="msb-tag" data-testid="mtp-run-earlier" title="Testtilfellet er endret etter kjøringen; resultatet gjelder ikke versjonen som er lagret nå.">Fra en tidligere versjon</span> }
                                                    <a class="msb-link" href="@($"{MR.ExecuteRoute}?run={run.Id}")" data-testid="mtp-run-open">Åpne</a>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </section>
                            }
                            var history = P.CaseHistory(current);
                            @if (history.Count > 0)
                            {
                                <details class="mtw-why mtp-history" data-testid="mtp-history"><summary>Historikk (@history.Count)</summary>
                                    <ul>@foreach (var h in history) { <li data-testid="mtp-history-item"><span class="mt-muted msb-small">@h.At.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @h.By</span> @h.What</li> }</ul>
                                </details>
                            }
                            @if (!readonlyCase)
                            {
                                var problems = P.ReadyProblems(current);
                                <div class="mtp-actions is-sticky" role="toolbar" aria-label="Handlinger for testtilfellet" data-testid="mtp-actions">
                                    @if (Dirty) { <span class="mtp-dirty-dot" data-testid="mtp-dirty">Ulagrede endringer</span> }
                                    <button type="button" class="btn btn-primary" disabled="@(!Dirty || _busy)" @onclick="SaveAsync" data-testid="mtp-save">Lagre</button>
                                    <button type="button" class="btn btn-secondary" disabled="@(!Dirty || _busy)" @onclick="Discard" data-testid="mtp-discard">Forkast endringer</button>
                                    <button type="button" class="btn btn-outline-secondary" @onclick="() => OpenPreview(new(current.Source.ScenarioId, null))" data-testid="mtp-preview-open">Forhåndsvisning</button>
                                    <span class="mtp-spacer"></span>
                                    @if (current.Review is TestCaseReviewState.Generated or TestCaseReviewState.NeedsClarification)
                                    {
                                        <button type="button" class="btn btn-secondary" disabled="@(Dirty || _busy || problems.Count > 0)" title="@(Dirty ? "Lagre først." : string.Join(" ", problems))"
                                                @onclick="() => ReviewAsync(TestCaseReviewState.UnderReview)" data-testid="mtp-ready">Klar for gjennomgang</button>
                                    }
                                    @if (current.Review != TestCaseReviewState.NeedsClarification)
                                    {
                                        <button type="button" class="btn btn-secondary" disabled="@(Dirty || _busy)" @onclick="() => ReviewAsync(TestCaseReviewState.NeedsClarification)" data-testid="mtp-clarify">Trenger avklaring</button>
                                    }
                                    @if (current.Review != TestCaseReviewState.Accepted)
                                    {
                                        <button type="button" class="btn btn-primary" disabled="@(Dirty || _busy || problems.Count > 0)" title="@(Dirty ? "Lagre først." : string.Join(" ", problems))"
                                                @onclick="() => ReviewAsync(TestCaseReviewState.Accepted)" data-testid="mtp-approve">Godkjenn</button>
                                    }
                                    <button type="button" class="msb-link" disabled="@(Dirty || _busy)" @onclick="() => _excludeAsk = true" data-testid="mtp-exclude">Utelat</button>
                                </div>
                                @if (_excludeAsk)
                                {
                                    <div class="mtp-confirm" role="group" aria-label="Utelat testtilfellet" data-testid="mtp-exclude-confirm">
                                        <label class="mtp-field"><span>Hvorfor utelates testtilfellet?</span><input type="text" value="@_excludeWhy" @oninput="e => _excludeWhy = e.Value?.ToString() ?? string.Empty" data-testid="mtp-exclude-why" /></label>
                                        <button type="button" class="btn btn-secondary btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_excludeWhy))" @onclick="ExcludeAsync" data-testid="mtp-exclude-yes">Utelat</button>
                                        <button type="button" class="msb-link" @onclick="() => _excludeAsk = false">Avbryt</button>
                                    </div>
                                }
                                @if (problems.Count > 0 && !Dirty)
                                {
                                    <div class="mtp-readiness" data-testid="mtp-readiness"><span class="mtp-ctx-label">Før godkjenning</span>
                                        <ul class="mtp-problems" data-testid="mtp-problems">@foreach (var pr in problems) { <li>@pr</li> }</ul></div>
                                }
                            }
                            else if (current.Review == TestCaseReviewState.Excluded && CanWrite && !ReadOnlyPlan)
                            {
                                <div class="mtp-actions"><button type="button" class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="() => ReviewAsync(TestCaseReviewState.UnderReview)" data-testid="mtp-include">Ta med igjen</button></div>
                            }

                            var parentKey = current.ParentScenario;
                            var scenarioCase = parentKey is null ? null : _plan!.Cases.FirstOrDefault(x => x.Source.Kind != ScenarioSourceKind.Manual && x.Source.ScenarioId == parentKey);
                            var linkedAll = Linked(current);
                            var linkedIds = linkedAll.Select(l => l.RequirementId).ToHashSet(StringComparer.OrdinalIgnoreCase);
                            var designReqs = _ws?.Requirements is { } allReqs && RequirementLinkPresentation.SpecificationPathOf(current) is { } ownSpec
                                    ? allReqs.Where(r => linkedIds.Contains(r.RequirementId) && BirkNext.Specifications.SpecificationCatalogRules.SamePath(r.SpecificationPath, ownSpec)).ToList() : [];
                            @if (ScenarioCandidateOf(current) is { } prepCandidate && _ws?.ProjectKey is { } projectForPrep)
                            {
                                <BirkNext.Web.Components.ManualTesting.ScenarioPreparationPanel ProjectKey="@projectForPrep" Scenario="prepCandidate"
                                    Cases="@(_plan!.Cases.Where(x => x.Source.ScenarioId == prepCandidate.CandidateId || x.ParentScenario == prepCandidate.CandidateId).ToList())" ReadOnly="@(!CanWrite)" />
                            }
                            <details class="mtp-design" open="@_designOpen" data-testid="mtp-design">
                                <summary @onclick="() => _designOpen = !_designOpen" @onclick:preventDefault="true"><span class="msb-h">Vis teknisk analyse</span>
                                    <span class="mt-muted msb-small">Testdesign, verifiseringspunkter og forslag til flere tester</span></summary>
                                @if (_designOpen)
                                {
                                    <BirkNext.Web.Components.ManualTesting.TestDesignPanel Facts="TestDesignAdvisor.FactsOf(current)" Scenario="scenarioCase ?? current" Case="current"
                                        TestData="TestDesignAdvisor.TestData(current)"
                                        Siblings="@(parentKey is null ? [] : _plan!.Cases.Where(x => x.ParentScenario == parentKey))"
                                        Decisions="@(_plan!.DesignDecisions?.Where(d => d.ScenarioKey == parentKey).ToList())"
