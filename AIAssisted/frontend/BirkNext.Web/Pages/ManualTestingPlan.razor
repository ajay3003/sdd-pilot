                                            @if (sameTitle) { <span class="mtp-case-title is-same" data-testid="mtp-case-same">@(Dirty && id == _selectedId ? "● " : "")Testtilfellet</span> }
                                            else { <span class="mtp-case-title">@(Dirty && id == _selectedId ? "● " : "")@c.EffectiveTitle</span> }
                                            @if (c.Edits.TestKind is { } savedKind) { <span class="mtw-kind-tag is-@savedKind.ToString().ToLowerInvariant()" data-testid="mtp-case-kind" data-kind="@savedKind">@P.CaseKindLabel(savedKind)</span> }
                                            <span class="msb-status msb-tone-@P.ReviewTone(c.Review)" data-testid="mtp-case-state">@P.ReviewLabel(c.Review)</span>
                                            @if (c.HasUnresolvedConflict) { <span class="msb-status msb-tone-bad" data-testid="mtp-case-conflict">Kildekonflikt</span> }
                                            else if (source is not null) { <span class="msb-status msb-tone-warn" data-testid="mtp-case-source">@source</span> }
                                        </button>
                                    </li>
                                }
                            </ul>
                            </details>
                            @if (CanWrite && !ReadOnlyPlan && row.Key.Length > 0)
                            {
                                <button type="button" class="msb-link mtp-add-case" disabled="@_busy" @onclick="() => OpenNewCaseAsync(row.Key, row.Title)" data-testid="mtp-add-case">+ Testtilfelle</button>
                            }
                        </li>
    };

    // ── Scenario-only items and the read-only preview (2026-11-26) ─────────────────────────────────────────────────────────────────────────

    /// <summary>Planned scenarios no current case of the plan represents yet (a prepared case replaces the item in the list; the item stays stored).</summary>
    private static List<PlannedScenario> PlannedOnly(TestPlanDraft plan) =>
        [.. (plan.PlannedScenarios ?? []).Where(p => !plan.Cases.Any(c => c.ParentScenario == p.ScenarioId && c.Review is not (TestCaseReviewState.Superseded or TestCaseReviewState.Excluded)))
            .OrderBy(p => p.Order)];

    /// <summary>«Forbered testtilfelle» for a planned scenario: the normal «add to this plan» flow creates its generated case (the server skips a
    /// scenario the plan already holds as a case, so a retry never duplicates). Needs the scenario in the current discovery.</summary>
    private async Task PrepareItemAsync(PlannedScenario item)
    {
        if (_plan is null || Api is not { } api || _ws?.ProjectKey is not { } key) return;
        // 2026-11-26 fix: the plan's own discovery (the one the item was planned from), not the specification this page happens to have loaded;
        // the server validates the scenario. Before, a scenario of another specification was refused here and no case was created.
        var discoveryId = _plan.DiscoveryId ?? _ws.Discovery?.DiscoveryId;
        if (discoveryId is null) { _error = "Oppdagelsen scenarioet ble planlagt fra er ikke tilgjengelig. Åpne Finn og forstå og prøv igjen."; return; }
        _busy = true; _error = null;
        try
        {
            var (draft, error) = await api.CreateProjectAsync(new CreateProjectTestPlanRequest
            { ProjectKey = key, DiscoveryId = discoveryId, CandidateIds = [item.ScenarioId], DraftId = _plan.Id, BaseRevision = _plan.Revision });
            if (draft is null) { _error = P.Friendly(error, "Testtilfellet kunne ikke forberedes."); return; }
            _plan = draft;
            if (draft.Cases.FirstOrDefault(c => c.ParentScenario == item.ScenarioId) is { } made) Open(P.IdOf(made));
            _notice = "Testtilfellet er forberedt. Scenarioet ligger fortsatt i samme testgruppe.";
        }
        finally { _busy = false; }
    }

    /// <summary>The open preview: a case (by id; shown from the editor's CURRENT values, saved or not) or a scenario-only item.</summary>
    private sealed record PreviewTarget(string? CaseId, PlannedScenario? Item);
    private PreviewTarget? _preview;

    /// <summary>Ctrl+Enter (or Cmd+Enter) in a step adds an empty step directly below it.</summary>
    private void StepKey(KeyboardEventArgs e, int index)
    {
        if (_form is null || e.Key != "Enter" || !(e.CtrlKey || e.MetaKey)) return;
        _form.InsertStepAfter(index);
    }

    private RenderFragment PreviewDialog() => __builder =>
    {
        if (_preview is not { } target || _plan is not { } plan) return;
        var c = target.CaseId is { } cid ? plan.Cases.FirstOrDefault(x => P.IdOf(x) == cid) : null;
        var form = c is not null && _form is { } f && f.CaseId == P.IdOf(c) ? f : null;
        var unsaved = form is not null && c is not null && form.IsDirty(c);
        var suiteId = c?.SuiteId ?? target.Item?.SuiteId;
        var wantNb = _lang != EditorLanguage.Original;
        var hasNb = form?.HasTranslation == true || (form is null && c?.Translation(ScenarioPlanning.Norwegian) is not null);
        var showNb = wantNb && hasNb;
        var compare = _lang == EditorLanguage.Compare && hasNb;
        var nbOrigin = c?.Translation(ScenarioPlanning.Norwegian)?.Origin;
        var story = c?.Generated.Story;
        @* 2026-11-26 fix: a real modal (backdrop + panel above the page, own scroll, focus moved in and back). Before, the markup had no styles and
           rendered as ordinary content at the top of the page, so nothing appeared to happen where the tester was working. Read-only: no inputs,
           no save, approval or execution controls. *@
        <div class="mtp-preview-backdrop" data-testid="mtp-preview" @onclick="ClosePreviewAsync">
            <section class="mtp-preview" role="dialog" aria-modal="true" aria-labelledby="mtp-preview-title" tabindex="-1" @ref="_previewRef"
                     @onclick:stopPropagation="true" @onkeydown="PreviewKey" data-testid="mtp-preview-dialog">
                <header class="mtp-preview-head">
                    <div class="mtp-preview-head-text">
                        <span class="mtp-ctx-label">Forhåndsvisning · @plan.PlanName@(suiteId is { } sid && plan.Suites.Any(s => s.Id == sid) ? $" · {PlanStructure.PathOf(plan.Suites, sid)}" : "")</span>
                        <h2 id="mtp-preview-title" class="mtp-preview-title" data-testid="mtp-preview-title">@(c is not null ? P.ScenarioHeading(c, _lang) : (target.Item!.StoryId is { } usid && target.Item.NumberInStory is { } acn ? $"{usid} · AC {acn} — {target.Item.Title}" : target.Item.Title))</h2>
                        <span class="mtp-preview-badges">
                            @if (unsaved) { <span class="msb-status msb-tone-warn" data-testid="mtp-preview-unsaved">Ulagret utkast</span> }
                            else if (c is not null) { <span class="msb-status msb-tone-muted" data-testid="mtp-preview-saved">Lagret versjon</span> }
                            <span class="msb-status msb-tone-muted" data-testid="mtp-preview-language">@(_lang switch { EditorLanguage.Norwegian => "Norsk", EditorLanguage.Compare => "Sammenlign", _ => "Original" })</span>
                            @if (wantNb && !hasNb) { <span class="msb-status msb-tone-warn" data-testid="mtp-preview-no-nb">Norsk oversettelse mangler – viser originalen</span> }
                            else if (showNb && nbOrigin is TranslationOrigin.Machine) { <span class="msb-status msb-tone-warn" data-testid="mtp-preview-machine">Maskinoversatt – ikke gjennomgått</span> }
                        </span>
                    </div>
                    <div class="mtp-preview-actions">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="PrintAsync" data-testid="mtp-preview-print">Skriv ut</button>
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="ClosePreviewAsync" data-testid="mtp-preview-close">Lukk forhåndsvisning</button>
                    </div>
                </header>
                <div class="mtp-preview-body">
                    <section class="mtp-preview-sec" aria-label="Scenario" data-testid="mtp-preview-scenario">
                        <h3>Scenario</h3>
                        <p class="mtp-preview-meta">@(story?.StoryId is { } st ? $"{st}{(story.Title is { Length: > 0 } stt ? " — " + stt : "")}" : target.Item?.StoryId ?? "Uten brukerhistorie")@(story?.Priority is { } pri ? $" · {pri}" : "")@((story?.SpecificationPath ?? target.Item?.SpecificationPath) is { } spec ? $" · {spec}" : "")</p>
                        <p>@(c?.Generated.Title ?? target.Item!.Title)</p>
                        <p><strong>Forventet atferd:</strong> @(c?.Generated.ExpectedResult ?? target.Item?.ExpectedBehaviour ?? "Ikke oppgitt i kilden – må avklares")</p>
                    </section>
                    <section class="mtp-preview-sec" aria-label="Testtilfelle" data-testid="mtp-preview-case">
                        <h3>Testtilfelle</h3>
                        @if (form is null && c is null)
                        {
                            <p class="mt-muted" data-testid="mtp-preview-no-case">Ingen testtilfelle er klargjort.</p>
                        }
                        else
                        {
                            // The editor's CURRENT values (saved or not); the Norwegian side from the form's translation fields.
                            var ogTitle = form?.Title ?? c!.EffectiveTitle;
                            var ogPurpose = form?.Purpose ?? c!.EffectivePurpose;
                            var ogPre = form?.Preconditions ?? c!.EffectivePreconditions;
                            var ogExpected = form?.ExpectedResult ?? c!.EffectiveExpected;
                            var ogSteps = form is not null ? form.Steps.Where(st => !string.IsNullOrWhiteSpace(st.Action) || !string.IsNullOrWhiteSpace(st.Expected)).Select(st => (st.Action, (string?)st.Expected, st.TranslatedAction, (string?)st.TranslatedExpected)).ToList()
                                : c!.EffectiveSteps.Select((st, i) => (st, c.EffectiveStepExpected.ElementAtOrDefault(i), "", (string?)null)).ToList();
                            string Pick(string? og, string? nb) => showNb && !string.IsNullOrWhiteSpace(nb) ? nb!.Trim() : Given(og);
                            <dl class="mtp-preview-dl">
                                <dt>Tittel</dt><dd data-testid="mtp-preview-case-title">@Pick(ogTitle, form?.TranslatedTitle)</dd>
                                @if (compare) { <dt class="mtp-preview-og">Original</dt><dd class="mtp-preview-og" data-testid="mtp-preview-case-title-original">@Given(ogTitle)</dd> }
                                <dt>Formål</dt><dd data-testid="mtp-preview-purpose">@Pick(ogPurpose, form?.TranslatedPurpose)</dd>
                                <dt>Forutsetninger</dt><dd data-testid="mtp-preview-preconditions">@Pick(ogPre, form?.TranslatedPreconditions)</dd>
                                <dt>Testdata</dt><dd data-testid="mtp-preview-testdata">@((form?.TestDataAssetIds.Count ?? c!.TestData.Count) is var td and > 0 ? $"{td} koblet testdatasett" : (form?.TestDataNeed ?? c!.EffectiveTestDataNeed) == TestDataNeed.Required ? "Kreves – ikke koblet" : "Ikke angitt")</dd>
                            </dl>
                            @if (ogSteps.Count == 0) { <p class="msb-tone-warn" data-testid="mtp-preview-no-steps">Teststeg: Ikke angitt</p> }
                            else
                            {
                                <table class="mtp-preview-steps" data-testid="mtp-preview-steps">
                                    <thead><tr><th scope="col">Steg</th><th scope="col">Handling</th><th scope="col">Forventet resultat</th></tr></thead>
                                    <tbody>@for (var i = 0; i < ogSteps.Count; i++)
                                    {
                                        var stp = ogSteps[i];
                                        <tr data-testid="mtp-preview-step"><td>@(i + 1)</td>
                                            <td>@Pick(stp.Item1, stp.Item3)@if (compare) { <span class="mtp-preview-og">Original: @Given(stp.Item1)</span> }</td>
                                            <td>@Pick(stp.Item2, stp.Item4)@if (compare) { <span class="mtp-preview-og">Original: @Given(stp.Item2)</span> }</td></tr>
                                    }</tbody>
                                </table>
                            }
                            <p><strong>Samlet forventet resultat:</strong> <span data-testid="mtp-preview-expected">@Pick(ogExpected, form?.TranslatedExpected)</span></p>
                        }
                    </section>
                    <section class="mtp-preview-sec" aria-label="Klargjøringsstatus" data-testid="mtp-preview-status">
                        <h3>Klargjøringsstatus</h3>
                        @if (c is null) { <p data-testid="mtp-preview-status-text">Scenario – ikke klargjort. Ikke klart til kjøring.</p> }
                        else
                        {
                            var problems = P.ReadyProblems(c);
                            <p data-testid="mtp-preview-status-text">@(c.Review == TestCaseReviewState.Accepted ? "Godkjent" : "Ikke godkjent") · @(problems.Count == 0 ? "ingen kjente mangler (lagret versjon)" : $"{problems.Count} mangler (lagret versjon)")</p>
                        }
                        <p class="mt-muted msb-small">Forhåndsvisningen lagrer ingenting og endrer ikke status, godkjenning eller oversettelse. Testgjennomføring skjer i Testplaner.</p>
                    </section>
                </div>
            </section>
        </div>
    };

    private Task PreviewKey(KeyboardEventArgs e) => e.Key == "Escape" ? ClosePreviewAsync() : Task.CompletedTask;

    private ElementReference _previewRef;
    private bool _focusPreview, _focusPreviewButton;

    /// <summary>Opens the preview and moves focus into it (Escape and «Lukk forhåndsvisning» close it and return focus).</summary>
    private void OpenPreview(PreviewTarget target) { _preview = target; _focusPreview = true; }

    private Task ClosePreviewAsync() { _preview = null; _focusPreviewButton = true; return Task.CompletedTask; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (_focusPreview && _preview is not null) { _focusPreview = false; await _previewRef.FocusAsync(); }
            else if (_focusPreviewButton) { _focusPreviewButton = false; await JS.InvokeVoidAsync("eval", "document.querySelector('[data-testid=mtp-preview-open]')?.focus()"); }
        }
        catch (Exception e) when (e is JSException or InvalidOperationException or TaskCanceledException) { }
    }

    private static string Given(string? text) => string.IsNullOrWhiteSpace(text) ? "Ikke angitt" : text.Trim();

    private async Task PrintAsync()
    {
        try { await JS.InvokeVoidAsync("print"); } catch (Exception e) when (e is JSException or InvalidOperationException or TaskCanceledException) { }
    }

    // ── Suite tree and suite management (2026-11-26) ───────────────────────────────────────────────────────────────────────────
    // Expanding and collapsing are view state only (never saved). A suite change is one saved revision through the normal plan save.
    private HashSet<string> _collapsedSuites = new(StringComparer.Ordinal);
    private bool _manageSuites;
    private string? _suiteError;
    private string _newSuiteName = "";
    private string? _newSuiteParent;
    private readonly Dictionary<string, string> _suiteMoveTarget = new(StringComparer.Ordinal);

    private RenderFragment SuiteTree(TestPlanDraft plan, List<P.ScenarioRow> rows, string? parent, int depth) => __builder =>
    {
        foreach (var suite in PlanStructure.Children(plan.Suites, parent).ToList())
        {
            var id = suite.Id;
            var mine = rows.Where(r => r.Cases.FirstOrDefault()?.SuiteId == id).ToList();
            var count = PlanSuiteEditing.CasesIn(plan, id);
            var holdsSelected = _selectedId is not null && plan.Cases.FirstOrDefault(c => P.IdOf(c) == _selectedId) is { } sel && (sel.SuiteId == id || PlanSuiteEditing.IsDescendant(plan.Suites, sel.SuiteId, id));
            var open = holdsSelected || !_collapsedSuites.Contains(id);
            if (_query.Length > 0 && mine.Count == 0 && !rows.Any(r => PlanSuiteEditing.IsDescendant(plan.Suites, r.Cases.FirstOrDefault()?.SuiteId, id))) continue;
            <li class="mtp-suite @(depth > 0 ? "is-child" : null)" data-testid="mtp-suite" data-suite="@id" data-depth="@depth">
                <button type="button" class="mtp-suite-head" aria-expanded="@(open ? "true" : "false")" @onclick="() => ToggleSuite(id)" data-testid="mtp-suite-toggle">
                    <span class="mtp-suite-caret" aria-hidden="true">@(open ? "▾" : "▸")</span><span class="mtp-suite-name">@suite.Name</span>
                    <span class="mtp-suite-count" data-testid="mtp-suite-count">@count</span>
                    @if (suite.TestLevel is { } level && depth == 0 && suite.Name != TestLevelClassifier.Label(level)) { <span class="mtp-suite-level">@TestLevelClassifier.Label(level)</span> }
                </button>
                @if (open)
                {
                    <ul class="mtp-scenarios is-nested">
                        @foreach (var row in mine) { @RowItem(row) }
                        @SuiteTree(plan, rows, id, depth + 1)
                        @if (count == 0 && mine.Count == 0) { <li class="mt-muted msb-small mtp-suite-empty" data-testid="mtp-suite-empty">0 testtilfeller</li> }
                        @if (CanWrite && !ReadOnlyPlan) { <li class="mtp-suite-add"><button type="button" class="msb-link" disabled="@_busy" @onclick="() => OpenNewCaseInSuiteAsync(suite)" data-testid="mtp-suite-new-case">+ Nytt testtilfelle</button></li> }
                    </ul>
                }
            </li>
        }
    };

    private void ToggleSuite(string id) { if (!_collapsedSuites.Remove(id)) _collapsedSuites.Add(id); }

    private RenderFragment SuitePanel(TestPlanDraft plan) => __builder =>
    {
        var choices = PlanSuiteEditing.Choices(plan);
        <section class="mtp-suite-panel" aria-label="Testgrupper" data-testid="mtp-suite-panel">
            <p class="mt-muted msb-small">Endringer i testgruppene lagres som en ny versjon av testplanen. Testtilfellene, stegene og godkjenningene endres ikke.</p>
            <ul class="mtp-suite-edit-list">
                @foreach (var (suite, depth) in PlanStructure.Flatten(plan.Suites))
                {
                    var s = suite;
                    var cases = plan.Cases.Count(c => c.SuiteId == s.Id);
                    <li style="padding-left:@(depth * 1.1)rem" data-testid="mtp-suite-edit" data-suite="@s.Id">
                        <input class="mtp-lcell mtp-suite-rename" value="@s.Name" aria-label="@($"Navn på testgruppen {s.Name}")" disabled="@_busy"
                               @onchange="e => ApplySuiteAsync(PlanSuiteEditing.Rename(plan, s.Id, e.Value?.ToString() ?? string.Empty))" data-testid="mtp-suite-rename" />
                        <select class="msb-select" aria-label="@($"Flytt testgruppen {s.Name}")" disabled="@_busy" @onchange="e => ApplySuiteAsync(PlanSuiteEditing.Move(plan, s.Id, NullIfEmpty(e.Value?.ToString())))" data-testid="mtp-suite-move">
                            <option value="" selected="@(s.ParentId is null)">Øverst</option>
                            @foreach (var (cid, cpath) in choices.Where(c => c.Id != s.Id && !PlanSuiteEditing.IsDescendant(plan.Suites, c.Id, s.Id))) { <option value="@cid" selected="@(s.ParentId == cid)">Under: @cpath</option> }
                        </select>
                        @if (cases > 0)
                        {
                            <select class="msb-select" aria-label="Flytt testtilfellene til" @onchange="e => _suiteMoveTarget[s.Id] = e.Value?.ToString() ?? string.Empty" data-testid="mtp-suite-remove-target">
                                <option value="">Flytt @cases testtilfelle@(cases == 1 ? "" : "r") til …</option>
                                @foreach (var (cid, cpath) in choices.Where(c => c.Id != s.Id)) { <option value="@cid">@cpath</option> }
                            </select>
                        }
                        <button type="button" class="msb-link" disabled="@_busy" @onclick="() => ApplySuiteAsync(PlanSuiteEditing.Remove(plan, s.Id, NullIfEmpty(_suiteMoveTarget.GetValueOrDefault(s.Id))))" data-testid="mtp-suite-remove">Fjern gruppe</button>
                    </li>
                }
            </ul>
            <div class="mtp-suite-new" data-testid="mtp-suite-new">
                <input class="mtp-lcell" placeholder="Ny testgruppe" value="@_newSuiteName" @oninput="e => _newSuiteName = e.Value?.ToString() ?? string.Empty" data-testid="mtp-suite-new-name" />
                <select class="msb-select" aria-label="Plassering" @onchange="e => _newSuiteParent = NullIfEmpty(e.Value?.ToString())" data-testid="mtp-suite-new-parent">
                    <option value="">Øverst</option>
                    @foreach (var (cid, cpath) in choices) { <option value="@cid" selected="@(_newSuiteParent == cid)">Under: @cpath</option> }
                </select>
                <button type="button" class="btn btn-outline-primary btn-sm" disabled="@(_busy || _newSuiteName.Trim().Length == 0)" @onclick="AddSuiteAsync" data-testid="mtp-suite-add">Ny gruppe</button>
            </div>
            @if (plan.Suites.Count > 0)
            {
                @* «Lagre som mal» (2026-11-26): only the suite structure is saved — never cases, steps, results, test data, ADO ids or history. *@
                <div class="mtp-suite-template" data-testid="mtp-save-template">
                    <input class="mtp-lcell" placeholder="Navn på malen" value="@_templateName" @oninput="e => _templateName = e.Value?.ToString() ?? string.Empty" data-testid="mtp-save-template-name" />
                    <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(_busy || _templateName.Trim().Length == 0)" @onclick="SaveAsTemplateAsync" data-testid="mtp-save-template-button">Lagre som mal</button>
                    <span class="mt-muted msb-small">Bare testgruppene lagres i malen, ikke testtilfellene.</span>
                </div>
            }
            @if (_suiteError is { } se) { <p class="mt-alert msb-small" role="alert" data-testid="mtp-suite-error">@se</p> }
        </section>
    };

    private static string? NullIfEmpty(string? v) => string.IsNullOrWhiteSpace(v) ? null : v;

    private string _templateName = "";

    /// <summary>Saves the plan's stored suite structure as a custom template (the server reads the plan; unsaved case edits play no part).</summary>
    private async Task SaveAsTemplateAsync()
    {
        if (_plan is null || Api is not { } api || _templateName.Trim().Length == 0) return;
        _busy = true; _suiteError = null;
        try
        {
            var (template, error) = await api.CreateTemplateAsync(new SaveTestPlanTemplateRequest(_templateName.Trim(), null, FromPlan: _plan.Id));
            if (template is null) { _suiteError = P.Friendly(error, "Malen kunne ikke lagres."); return; }
            _templateName = "";
            _notice = $"Malen «{template.Name}» er lagret. Du finner den under Systeminnstillinger → Manuell testing → Testplanmaler.";
        }
        finally { _busy = false; }
    }

    private async Task AddSuiteAsync()
    {
        if (_plan is null) return;
        if (await ApplySuiteAsync(PlanSuiteEditing.Add(_plan, _newSuiteName, _newSuiteParent))) { _newSuiteName = ""; }
    }

    private Task MoveCaseAsync(string caseId, string? suiteId) =>
        _plan is null || suiteId is null ? Task.CompletedTask : ApplySuiteAsync(PlanSuiteEditing.MoveCase(_plan, caseId, suiteId), "Testtilfellet er flyttet.");

    /// <summary>Saves a suite change as one revision (the plan as stored with the new suites/memberships). Refused while the case form has unsaved edits.</summary>
    private async Task<bool> ApplySuiteAsync(PlanSuiteEditing.Edit edit, string notice = "Testgruppene er lagret.")
    {
        _suiteError = edit.Error;
        if (edit.Error is not null || _plan is null || Api is not { } api) return false;
        if (Dirty) { _suiteError = "Lagre eller forkast endringene i testtilfellet først."; return false; }
        _busy = true;
        try
        {
            var (draft, error) = await api.SaveAsync(_plan.Id, TestPlanSuggestionsPresentation.ToSaveRequest(edit.Plan));
            if (draft is null) { _suiteError = P.Friendly(error, "Testgruppene kunne ikke lagres."); return false; }
            _plan = draft;
            if (_selectedId is { } keep) Open(keep);
            _notice = notice;
            return true;
        }
        finally { _busy = false; }
    }


    private async Task<bool> SaveAsync()
    {
        if (_plan is null || _form is null || Api is not { } api) return false;
        _busy = true; _error = null;
        try
        {
            await SettleAutoTranslationAsync();
            var (draft, error) = await api.SaveAsync(_plan.Id, P.SaveWith(_plan, _form));
            if (draft is null) { _error = P.Friendly(error, "Testtilfellet kunne ikke lagres."); return false; }
            _plan = draft;
            Open(_form.CaseId);
            _notice = "Lagret.";
            return true;
        }
        finally { _busy = false; }
    }

    /// <summary>A new revision of the plan from a tool (restore, refresh): the editor follows it.</summary>
    private Task ReplacedAsync(TestPlanDraft draft)
    {
        _plan = draft;
        Open(_selectedId is { } keep && draft.Cases.Any(c => P.IdOf(c) == keep) ? keep : draft.Cases.Select(P.IdOf).FirstOrDefault());
        _notice = $"Testplanen er oppdatert (revisjon {draft.Revision}).";
        return Task.CompletedTask;
    }

    private async Task ReviewAsync(TestCaseReviewState state, string? rationale = null)
    {
        if (_plan is null || Selected is not { } c || Api is not { } api) return;
        _busy = true; _error = null;
        try
        {
            var (draft, error) = await api.ReviewAsync(_plan.Id, new ReviewTestCaseRequest(_plan.Revision, P.IdOf(c), state, rationale));
            if (draft is null) { _error = P.Friendly(error, "Statusen kunne ikke endres."); return; }
            _plan = draft;
            Open(P.IdOf(c));
            _notice = $"Status: {P.ReviewLabel(state)}.";
        }
        finally { _busy = false; }
    }

    private Task ExcludeAsync() => ReviewAsync(TestCaseReviewState.Excluded, _excludeWhy.Trim());

