                                    }
                                </div>
                                </div>
                            </aside>
                        }
                    </section>
                </div>
            }
        }
    }
</div>

@if (_addScenarios && _plan is { } addPlan && ServiceProvider.GetService(typeof(ITestPlanSuggestionsApiService)) is ITestPlanSuggestionsApiService addApi && _ws?.ProjectKey is { } addKey)
