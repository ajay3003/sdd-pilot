        if (_newCase is { } nc) { nc.SuiteId = suite.Id; nc.Level = suite.TestLevel; }
    }

    private async Task OpenNewCaseAsync(string? scenarioKey, string? scenarioTitle)
    {
        if (_plan is null) return;
        await LoadScenarioKindsAsync();
        var scenarioCase = scenarioKey is null ? null : _plan.Cases.FirstOrDefault(x => x.Source.Kind != ScenarioSourceKind.Manual && x.Source.ScenarioId == scenarioKey);
        var suggestion = P.SuggestKind(scenarioCase, ScenarioDecision(scenarioCase));
        _newCase = new NewCaseForm
        {
            ScenarioKey = scenarioKey, ScenarioTitle = scenarioTitle,
            Title = scenarioTitle is { } st ? $"Nytt testtilfelle: {st}" : "",
            Kind = suggestion?.Reviewed is ScenarioTestKind.Manual or ScenarioTestKind.Technical ? suggestion.Reviewed : null, Suggestion = suggestion,
        };
    }

    private async Task CreateCaseAsync()
    {
        if (_newCase is not { Kind: { } kind } nc || string.IsNullOrWhiteSpace(nc.Title)) return;
        await AddCaseAsync(nc.ScenarioKey, nc.Title.Trim(), kind, nc.SuiteId, nc.Level, nc.Type);
    }

    private async Task AddCaseAsync(string? scenarioKey, string title, ScenarioTestKind kind, string? suiteId = null, ScenarioTestLevel? level = null, ScenarioRequirementType? type = null)
    {
        if (_plan is null || Api is not { } api) return;
        if (Dirty) { _pending = () => AddCaseAsync(scenarioKey, title, kind, suiteId, level, type); return; }
        _busy = true; _error = null;
        try
        {
            var before = _plan.Cases.Select(P.IdOf).ToHashSet(StringComparer.Ordinal);
            var (draft, error) = await api.AddManualCaseAsync(_plan.Id, new AddManualTestCaseRequest(_plan.Revision, title, null, null, ScenarioKey: scenarioKey, TestKind: kind,
                SuiteId: suiteId, TestLevel: level, ScenarioType: type));
            if (draft is null) { _error = P.Friendly(error, "Testtilfellet kunne ikke legges til."); return; }
            _plan = draft;
            Open(draft.Cases.Select(P.IdOf).FirstOrDefault(id => !before.Contains(id)) ?? _selectedId);
            _newCase = null;
            _notice = $"Nytt testtilfelle lagt til ({P.CaseKindLabel(kind).ToLowerInvariant()}). Skriv teststegene og lagre.";
        }
        finally { _busy = false; }
    }

