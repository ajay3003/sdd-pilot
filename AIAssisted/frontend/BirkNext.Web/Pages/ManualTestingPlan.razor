    /// <summary>
    /// Automatic translation (2026-11-25): when the test plan opens, the text with no Norwegian translation yet — this plan only — is translated in
    /// the background with the configured translator (offline by default). Existing translations are shown at once and never replaced: edited,
    /// person-written, approved and outdated ones stay (the server's «only missing» mode). One request per plan revision per session; a newer plan
    /// or request makes an older answer irrelevant; editing and navigation never wait for it.
    /// </summary>
    private void StartAutoTranslation(bool retry = false)
    {
        if (_plan is not { } plan || Api is not { } api || !CanWrite || ReadOnlyPlan || !P.MissingTranslation(plan)) { _auto = AutoTranslation.Idle; return; }
        if (!_translationAvailable) { _auto = AutoTranslation.Unavailable; return; }
        var call = Registry.Begin(plan.Id, plan.Revision, retry,
            () => api.TranslateAllAsync(plan.Id, new TranslatePlanRequest(plan.Revision, Target: ScenarioPlanning.Norwegian, OnlyMissing: true)));
        if (call is null)
        {
            var (_, error) = Registry.Outcome(plan.Id, plan.Revision);
            (_auto, _autoError) = error is null ? (AutoTranslation.Idle, null) : (AutoTranslation.Failed, error);
            return;
        }
        _auto = AutoTranslation.Running; _autoError = null;
        _autoTask = FinishAutoTranslationAsync(plan.Id, plan.Revision, call, ++_autoGeneration);
    }

    private async Task FinishAutoTranslationAsync(Guid planId, int revision, Task<(TranslateScenarioResult? Result, string? Error)> call, int generation)
    {
        TranslateScenarioResult? result = null; string? error = null;
        try { (result, error) = await call; }
        catch (Exception e) when (e is not OperationCanceledException) { error = e.Message; }
        var failure = result is null ? error : result.Failed.Count > 0 ? $"{result.Failed.Count} tekst(er) kunne ikke oversettes." : null;
        Registry.End(planId, revision, call, failure);
        // Another plan, a newer request or a closed page: this answer is not shown (what the server saved is read with the plan next time).
        if (_disposed || generation != _autoGeneration || _plan?.Id != planId) return;
        if (result is null && error is not null && P.IsStale(error))
        {
            // The tester saved meanwhile: the server refused the translation, so nothing of theirs was overwritten. Once more, on the new revision.
            _auto = AutoTranslation.Idle;
            StartAutoTranslation();
        }
        else
        {
            if (result?.Draft is { } draft && draft.Revision > _plan.Revision) ApplyTranslated(draft);
            (_auto, _autoError) = failure is null ? (AutoTranslation.Idle, null) : (AutoTranslation.Failed, failure);
        }
        await InvokeAsync(StateHasChanged);
    }

