    private readonly Dictionary<string, Dictionary<string, TC.Decision>> _scenarioTests = new(StringComparer.OrdinalIgnoreCase);
    private (string Path, IReadOnlyList<SC.Item> Items)? _planSpec;

    /// <summary>The specification context for a scenario, only when its specification is the one loaded (built once, from the existing semantic model).</summary>
    private IReadOnlyList<SC.Item> PlanSpecItems(DiscoveredScenario c)
    {
        if (_ws?.Specification is not { Status: BirkNext.Web.Services.Explorers.ExplorerArtifactStatus.Loaded, Selected: { } sel, Content: { Length: > 0 } text }) return [];
        var path = sel.SourcePath ?? sel.FileName;
        if (c.Story?.SpecificationPath is not { } storySpec || !BirkNext.Specifications.SpecificationCatalogRules.SamePath(storySpec, path)) return [];
        if (_planSpec is not { } cached || cached.Path != path)
        {
            try { _planSpec = (path, SC.Items(SpecExplorerService.BuildSemanticModel(SpecExplorerService.Parse(text), text))); }
            catch (Exception e) when (e is not OperationCanceledException) { _planSpec = (path, []); }
        }
        return _planSpec.Value.Items;
    }

    /// <summary>The discovered scenario a case belongs to (its own scenario, or the parent scenario of a hand-written case).</summary>
    private DiscoveredScenario? ScenarioCandidateOf(TestCaseDraft c) =>
        c.ParentScenario is { } key ? _ws?.Discovery?.Candidates.FirstOrDefault(x => x.CandidateId == key) : null;

    private IReadOnlyDictionary<string, TC.Decision> PlanTechDecisions(DiscoveredScenario c) =>
        c.Story?.SpecificationPath is { } spec && _scenarioTests.TryGetValue(spec, out var d) ? d : new Dictionary<string, TC.Decision>();
    private readonly Dictionary<string, Dictionary<string, ScenarioTestKindDecision>> _scenarioKinds = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>The scenario a case belongs to (its own source case, or the discovered case of its parent scenario).</summary>
    private TestCaseDraft? ScenarioCaseOf(TestCaseDraft? c) => c?.ParentScenario is { } key
        ? _plan?.Cases.FirstOrDefault(x => x.Source.Kind != ScenarioSourceKind.Manual && x.Source.ScenarioId == key) : null;

    private ScenarioTestKindDecision? ScenarioDecision(TestCaseDraft? scenarioCase) =>
        scenarioCase?.Generated.Story?.SpecificationPath is { } spec && _scenarioKinds.TryGetValue(spec, out var decided)
        && decided.TryGetValue(scenarioCase.Source.ScenarioId, out var d) ? d : null;

    /// <summary>Reads (never writes) the reviewed Manuell/Teknisk decisions of the plan's specifications, once per specification.</summary>
    private async Task LoadScenarioKindsAsync()
    {
        if (_plan?.ProjectKey is not { } key || Api is not { } api) return;
        foreach (var spec in _plan.Cases.Select(c => c.Generated.Story?.SpecificationPath).OfType<string>().Distinct(StringComparer.OrdinalIgnoreCase))
        {
            if (_scenarioKinds.ContainsKey(spec)) continue;
            _scenarioKinds[spec] = [];
            try
            {
                var (doc, _) = await api.StoryGroupingAsync(key, spec);
                if (doc is not null)
                {
                    _scenarioKinds[spec] = StoryGroupingEngine.TestKindDecisions(doc).ToDictionary(kv => kv.Key, kv => StoryGroupingEngine.TestKindDecision(doc, kv.Key)!, StringComparer.Ordinal);
                    _scenarioTests[spec] = StoryGroupingEngine.TestLinkDecisions(doc).ToDictionary(kv => kv.Key, kv => TC.ToDecision(kv.Value), StringComparer.Ordinal);
                }
            }
            catch (Exception e) when (e is not OperationCanceledException) { } // no suggestion is shown; nothing is blocked
        }
    }

    /// <summary>«+ Nytt testtilfelle» inside a suite: no scenario; the suite is chosen and its level proposed (the tester may change it).</summary>
    private async Task OpenNewCaseInSuiteAsync(TestSuiteDraft suite)
    {
