    /// <summary>The scenarios chosen in Finn og forstå become test cases: in this plan, or in a new one. The selection is then cleared.</summary>
    private async Task FromSelectionAsync(List<string> candidateIds, bool intoCurrent)
    {
        if (_ws?.ProjectKey is not { } key || _ws.Discovery is not { } discovery || Api is not { } api) return;
        if (Dirty) { _pending = () => FromSelectionAsync(candidateIds, intoCurrent); return; }
        _busy = true; _error = null;
        try
        {
            var (draft, error) = await api.CreateProjectAsync(new CreateProjectTestPlanRequest
            {
                ProjectKey = key, ProjectName = _ws.ProjectName, DiscoveryId = discovery.DiscoveryId, CandidateIds = candidateIds,
                PlanName = intoCurrent ? null : M.SuggestedPlanName(DateTime.Now),
                DraftId = intoCurrent ? _plan?.Id : null, BaseRevision = intoCurrent ? _plan?.Revision : null,
            });
            if (draft is null) { _error = P.Friendly(error, "Kunne ikke opprette testplan."); return; }
            await TabDraftStore.RemoveAsync(JS, TabDraftStore.SelectionKey(key));
            _selection = [];
            _plan = draft;
            _tool = "cases";
            if (_plans.All(p => p.Id != draft.Id))
                _plans.Insert(0, new TestPlanDraftSummary(draft.Id, draft.GuideKey, draft.PlanName, draft.DeliveryLabel, draft.Revision, draft.Cases.Count, 0, 0, 0, 0, 0, draft.UpdatedBy, draft.UpdatedAt));
            _selectedId = null;
            var first = P.Rows(draft, _showTechnical).Rows.SelectMany(r => r.Cases).FirstOrDefault();
            Open(first is null ? null : P.IdOf(first));
            _notice = $"{candidateIds.Count} scenario{(candidateIds.Count == 1 ? "" : "er")} lagt til i «{draft.PlanName}».";
        }
        finally { _busy = false; }
    }

    /// <summary>Executed / passed per requirement across saved plans (completed manual runs); null until loaded or when not available.</summary>
    private PreparedCaseTraceView? _trace;
    private (int Revision, string CaseId, PreparedCaseTraceView? Trace, List<ProjectRequirementOption>? Requirements, List<P.LinkedRequirement> Rows)? _linkedMemo;

    /// <summary>The case's linked and suggested requirements, computed once per saved case revision (never per render or keystroke: the
    /// suggester reads the whole requirement list).</summary>
    private List<P.LinkedRequirement> Linked(TestCaseDraft c)
    {
        var id = P.IdOf(c);
        if (_linkedMemo is { } m && m.Revision == _plan!.Revision && m.CaseId == id && ReferenceEquals(m.Trace, _trace) && ReferenceEquals(m.Requirements, _ws?.Requirements)) return m.Rows;
        var rows = P.LinkedRequirements(c, _plan!, _ws?.Requirements, _trace, _ws?.Discovery?.Candidates);
        _linkedMemo = (_plan!.Revision, id, _trace, _ws?.Requirements, rows);
        return rows;
    }
    private bool _showAllSuggestions;

    private async Task LoadTraceAsync()
    {
        _trace = null;
        if (Api is not { } api || _ws?.ProjectKey is not { } key || _ws.Requirements is not { Count: > 0 } requirements) return;
        try
        {
            var (trace, _) = await api.PreparedCaseTraceAsync(key, new PreparedCaseTraceRequest([.. requirements.Select(r => r.SpecificationPath).Distinct()],
                [.. requirements.Select(r => r.RequirementId)], requirements.GroupBy(r => r.RequirementId, StringComparer.OrdinalIgnoreCase).ToDictionary(g => g.Key, g => g.First().Title, StringComparer.OrdinalIgnoreCase)));
            _trace = trace;
        }
        catch (Exception e) when (e is not OperationCanceledException) { _trace = null; }
    }

