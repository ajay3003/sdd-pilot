@page "/dashboard"
@using BirkNext.Web.Components
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@inject IDashboardSnapshotService Snapshot
@inject RuntimeReviewSessionService RuntimeReviews
@inject QualityReviewSessionService QualitySession
@inject IWorkspaceSessionService Workspace
@inject IReportExportService ExportService
@inject IJSRuntime JS

<PageTitle>Dashboard</PageTitle>

@* ── Onboarding ───────────────────────────────────────────────────────────── *@
@if (!_hasAnyWorkspace && !_hasAnySnapshot)
{
    <div class="dashboard-onboarding-card" data-testid="onboarding-card">
        <div class="dashboard-onboarding-text">
            <strong>New to QA Review Studio?</strong>
            <span>Follow the recommended workflow to get started with the platform phase by phase.</span>
        </div>
        <a href="getting-started" class="btn-primary dashboard-onboarding-btn">Start Recommended Workflow</a>
    </div>
}

    <PageHeader Title="SDD Governance Dashboard">
        <StatusChip Status="neutral" Label="@_projectPhase" />
        @if (_hasAnyScore)
        {
            <StatusChip Status="@(_overallScore >= 80 ? "healthy" : _overallScore >= 50 ? "warning" : "critical")"
                        Label="@_overallScoreLabel" />
        }
        @if (_hasAnySnapshot)
        {
            <StatusChip Status="neutral" Label="This session" />
        }
    </PageHeader>

    @if (_hasAnySnapshot)
    {
        <div style="display:flex;justify-content:flex-end;margin-bottom:.5rem">
            <button style="background:#1d4ed8;color:#fff;border:none;padding:.35rem .85rem;border-radius:5px;cursor:pointer;font-size:.78rem" @onclick="ExportHtml">Export HTML</button>
        </div>
    }

    @* ══════════════════════════════════════════════════════════════════════════
       ZONE 1 · EXECUTIVE SUMMARY
       KPI Strip → Governance Status → Readiness Summary
       ══════════════════════════════════════════════════════════════════════════ *@

    @* ── KPI Strip ─────────────────────────────────────────────────────────── *@
    <div class="db-kpi-strip" aria-label="Key performance indicators">
        <MetricCard Value="@($"{_governanceLoadPercent}%")"
                    Label="Governance"
                    Sublabel="@(_governanceLoadPercent == 100 ? "Complete" : _governanceLoadPercent > 0 ? "Partial" : "Setup")"
                    Variant="@(_governanceLoadPercent == 100 ? "success" : _governanceLoadPercent > 0 ? "warning" : null)" />
        <MetricCard Value="@TraceabilityHealthVal"
                    Label="Traceability"
                    Sublabel="@KpiStatusLabel(_traceabilityScore, _traceabilityHasData)"
                    Variant="@(_traceabilityHasData ? (_traceabilityScore >= 80 ? "success" : _traceabilityScore >= 50 ? "warning" : "danger") : null)" />
        <MetricCard Value="@ComplianceHealthVal"
                    Label="Compliance"
                    Sublabel="@KpiStatusLabel(_complianceScore, _complianceHasData)"
                    Variant="@(_complianceHasData ? (_complianceScore >= 80 ? "success" : _complianceScore >= 50 ? "warning" : "danger") : null)" />
        <MetricCard Value="@QaHealthVal"
                    Label="QA"
                    Sublabel="@KpiStatusLabel(_qaScore, _qaHasData)"
                    Variant="@(_qaHasData ? (_qaScore >= 80 ? "success" : _qaScore >= 50 ? "warning" : "danger") : null)" />
        <MetricCard Value="@DeliveryHealthVal"
                    Label="Delivery"
                    Sublabel="@KpiStatusLabel(_deliveryScore, _deliveryHasData)"
                    Variant="@(_deliveryHasData ? (_deliveryScore >= 80 ? "success" : _deliveryScore >= 50 ? "warning" : "danger") : null)" />
        @if (_perfReport?.ReadinessReport is { HasData: true } perfKpi)
        {
            <MetricCard Value="@perfKpi.OverallScore.ToString()"
                        Label="Performance"
                        Sublabel="@ReadinessStateLabel(perfKpi.OverallState)"
                        Variant="@(perfKpi.OverallState == PerformanceReadinessState.Ready ? "success" : perfKpi.OverallState == PerformanceReadinessState.MostlyReady ? "warning" : "danger")" />
        }
        else
        {
            <MetricCard Value="—" Label="Performance" Sublabel="@RuntimeStatusLabel(RuntimeReviews.PerformanceReview.Status)" />
        }
    </div>

    @* ── Health Summary ────────────────────────────────────────────────────── *@
    <section class="db-section">
        <SectionHeader Title="Project Health" />
        <div class="db-health-grid" aria-label="Project health by dimension">

            <div class="db-health-card">
                <span class="db-health-label">Governance</span>
                <span class="db-health-value @(_governanceLoadPercent == 100 ? "db-val-good" : _governanceLoadPercent > 0 ? "db-val-warn" : "db-val-empty")">@_governanceLoadPercent%</span>
                <StatusChip Status="@(_governanceLoadPercent == 100 ? "healthy" : _governanceLoadPercent > 0 ? "warning" : "neutral")"
                            Label="@(_governanceLoadPercent == 100 ? "Complete" : _governanceLoadPercent > 0 ? "Partial" : "Setup")" />
            </div>

            <div class="db-health-card">
                <span class="db-health-label">Traceability</span>
                <span class="db-health-value @(_traceabilityHasData ? ScoreClass(_traceabilityScore) : "db-val-empty")">@TraceabilityHealthVal</span>
                <StatusChip Status="@(_traceabilityHasData ? (_traceabilityScore >= 80 ? "healthy" : _traceabilityScore >= 50 ? "warning" : "critical") : "neutral")"
                            Label="@KpiStatusLabel(_traceabilityScore, _traceabilityHasData)" />
            </div>

            <div class="db-health-card">
                <span class="db-health-label">Compliance</span>
                <span class="db-health-value @(_complianceHasData ? ScoreClass(_complianceScore) : "db-val-empty")">@ComplianceHealthVal</span>
                <StatusChip Status="@(_complianceHasData ? (_complianceScore >= 80 ? "healthy" : _complianceScore >= 50 ? "warning" : "critical") : "neutral")"
                            Label="@KpiStatusLabel(_complianceScore, _complianceHasData)" />
            </div>

            <div class="db-health-card">
                <span class="db-health-label">QA</span>
                <span class="db-health-value @(_qaHasData ? ScoreClass(_qaScore) : "db-val-empty")">@QaHealthVal</span>
                <StatusChip Status="@(_qaHasData ? (_qaScore >= 80 ? "healthy" : _qaScore >= 50 ? "warning" : "critical") : "neutral")"
                            Label="@KpiStatusLabel(_qaScore, _qaHasData)" />
            </div>

            <div class="db-health-card">
                <span class="db-health-label">Delivery</span>
                <span class="db-health-value @(_deliveryHasData ? ScoreClass(_deliveryScore) : "db-val-empty")">@DeliveryHealthVal</span>
                <StatusChip Status="@(_deliveryHasData ? (_deliveryScore >= 80 ? "healthy" : _deliveryScore >= 50 ? "warning" : "critical") : "neutral")"
                            Label="@KpiStatusLabel(_deliveryScore, _deliveryHasData)" />
            </div>

            @if (_perfReport?.ReadinessReport is { HasData: true } perfHealth)
            {
                <div class="db-health-card">
                    <span class="db-health-label">Performance</span>
                    <span class="db-health-value @ScoreClass(perfHealth.OverallScore)">@perfHealth.OverallScore</span>
                    <StatusChip Status="@(perfHealth.OverallState == PerformanceReadinessState.Ready ? "healthy" : perfHealth.OverallState == PerformanceReadinessState.MostlyReady ? "warning" : "critical")"
                                Label="@ReadinessStateLabel(perfHealth.OverallState)" />
                </div>
            }
            else
            {
                <div class="db-health-card">
                    <span class="db-health-label">Performance</span>
                    <span class="db-health-value db-val-empty">—</span>
                    <StatusChip Status="@RuntimeStatusChip(RuntimeReviews.PerformanceReview.Status)"
                                Label="@RuntimeStatusLabel(RuntimeReviews.PerformanceReview.Status)" />
                </div>
            }

        </div>
    </section>

    @* ── Governance Status ─────────────────────────────────────────────────── *@
    <section class="db-section">
        <SectionHeader Title="Governance Status" Description="Loaded · Reviewed · Analyzed" />
        <div class="db-artifact-grid">

            <div class="db-artifact-card db-artifact-constitution @(_constitutionLoaded ? "db-artifact-loaded" : "")">
                <div class="db-artifact-icon" aria-hidden="true">⚖</div>
                <div class="db-artifact-name">Constitution</div>
                <div class="db-artifact-badges">
                    @if (_constitutionLoaded)  { <span class="db-badge db-badge-loaded">Loaded</span> }
                    @if (_constitutionAnalyzed) { <span class="db-badge db-badge-analyzed">Analyzed</span> }
                    @if (!_constitutionLoaded)  { <span class="db-badge db-badge-empty">Not loaded</span> }
                </div>
                @if (Snapshot.ComplianceReport?.HasConstitution == true)
                {
                    <div class="db-artifact-stats">
                        <span class="db-stat-pill">@Snapshot.ComplianceReport.Coverage.TotalItems rules</span>
                    </div>
                }
                else if (Workspace.Get(WorkspaceArtifactKind.Constitution) is { } wsConst)
                {
                    <div class="db-artifact-stats">
                        @if (wsConst.FileName is not null)    { <span class="db-stat-pill">@wsConst.FileName</span> }
                        @if (Workspace.ProjectName is not null) { <span class="db-stat-pill">@Workspace.ProjectName</span> }
                        <span class="db-stat-pill">@wsConst.LoadedAt.ToString("HH:mm")</span>
                    </div>
                }
                <div class="db-artifact-progress-track" aria-hidden="true">
                    <div class="db-artifact-progress-fill" style="width: @((_constitutionLoaded ? 50 : 0) + (_constitutionAnalyzed ? 50 : 0))%"></div>
                </div>
                <a href="constitution-explorer" class="db-artifact-action">Open Constitution Explorer →</a>
            </div>

            <div class="db-artifact-card db-artifact-specification @(_specLoaded ? "db-artifact-loaded" : "")">
                <div class="db-artifact-icon" aria-hidden="true">📋</div>
                <div class="db-artifact-name">Specification</div>
                <div class="db-artifact-badges">
                    @if (_specLoaded)               { <span class="db-badge db-badge-loaded">Loaded</span> }
                    @if (_specAnalyzed) { <span class="db-badge db-badge-reviewed">Reviewed</span> }
                    @if (_specAnalyzed)              { <span class="db-badge db-badge-analyzed">Analyzed</span> }
                    @if (!_specLoaded) { <span class="db-badge db-badge-empty">Not loaded</span> }
                </div>
                @if (Snapshot.TraceabilityReport is { Health.TotalRequirements: > 0 } specTrace)
                {
                    <div class="db-artifact-stats">
                        <span class="db-stat-pill">@specTrace.Health.TotalRequirements requirements</span>
                        <span class="db-stat-pill">@specTrace.SpecificationCoverage.CoveragePercentage.ToString("0")% coverage</span>
                    </div>
                }
                else if (Workspace.Get(WorkspaceArtifactKind.Specification) is { } wsSpec)
                {
                    <div class="db-artifact-stats">
                        @if (wsSpec.FileName is not null)      { <span class="db-stat-pill">@wsSpec.FileName</span> }
                        @if (Workspace.ProjectName is not null) { <span class="db-stat-pill">@Workspace.ProjectName</span> }
                        <span class="db-stat-pill">@wsSpec.LoadedAt.ToString("HH:mm")</span>
                    </div>
                }
                <div class="db-artifact-progress-track" aria-hidden="true">
                    <div class="db-artifact-progress-fill" style="width: @((_specLoaded ? 50 : 0) + (_specAnalyzed ? 50 : 0))%"></div>
                </div>
                <a href="extract" class="db-artifact-action">Open Specification Review →</a>
            </div>

            <div class="db-artifact-card db-artifact-plan @(_planLoaded ? "db-artifact-loaded" : "")">
                <div class="db-artifact-icon" aria-hidden="true">🗺</div>
                <div class="db-artifact-name">Plan</div>
                <div class="db-artifact-badges">
                    @if (_planLoaded)   { <span class="db-badge db-badge-loaded">Loaded</span> }
                    @if (_planAnalyzed) { <span class="db-badge db-badge-analyzed">Analyzed</span> }
                    @if (!_planLoaded)  { <span class="db-badge db-badge-empty">Not loaded</span> }
                </div>
                @if (Snapshot.TraceabilityReport?.HasPlan == true)
                {
                    <div class="db-artifact-stats">
                        <span class="db-stat-pill">@Snapshot.TraceabilityReport.PlanCoverage.TotalItems items</span>
                    </div>
                }
                else if (Workspace.Get(WorkspaceArtifactKind.Plan) is { } wsPlan)
                {
                    <div class="db-artifact-stats">
                        @if (wsPlan.FileName is not null)      { <span class="db-stat-pill">@wsPlan.FileName</span> }
                        @if (Workspace.ProjectName is not null) { <span class="db-stat-pill">@Workspace.ProjectName</span> }
                        <span class="db-stat-pill">@wsPlan.LoadedAt.ToString("HH:mm")</span>
                    </div>
                }
                <div class="db-artifact-progress-track" aria-hidden="true">
                    <div class="db-artifact-progress-fill" style="width: @((_planLoaded ? 50 : 0) + (_planAnalyzed ? 50 : 0))%"></div>
                </div>
                <a href="plan-explorer" class="db-artifact-action">Open Plan Explorer →</a>
            </div>

            <div class="db-artifact-card db-artifact-tasks @(_tasksLoaded ? "db-artifact-loaded" : "")">
                <div class="db-artifact-icon" aria-hidden="true">✅</div>
                <div class="db-artifact-name">Tasks</div>
                <div class="db-artifact-badges">
                    @if (_tasksLoaded) { <span class="db-badge db-badge-loaded">Loaded</span> }
                    @if (_tasksAnalyzed) { <span class="db-badge db-badge-analyzed">Analyzed</span> }
                    @if (!_tasksLoaded)  { <span class="db-badge db-badge-empty">Not loaded</span> }
                </div>
                @if (Snapshot.TraceabilityReport is { Health.TotalTasks: > 0 } taskTrace)
                {
                    <div class="db-artifact-stats">
                        <span class="db-stat-pill">@taskTrace.Health.TotalTasks tasks</span>
                        <span class="db-stat-pill">@taskTrace.TaskCoverage.CoveragePercentage.ToString("0")% coverage</span>
                    </div>
                }
                else if (Workspace.Get(WorkspaceArtifactKind.Tasks) is { } wsTasks)
                {
                    <div class="db-artifact-stats">
                        @if (wsTasks.FileName is not null)     { <span class="db-stat-pill">@wsTasks.FileName</span> }
                        @if (Workspace.ProjectName is not null) { <span class="db-stat-pill">@Workspace.ProjectName</span> }
                        <span class="db-stat-pill">@wsTasks.LoadedAt.ToString("HH:mm")</span>
                    </div>
                }
                <div class="db-artifact-progress-track" aria-hidden="true">
                    <div class="db-artifact-progress-fill" style="width: @((_tasksLoaded ? 50 : 0) + (_tasksAnalyzed ? 50 : 0))%"></div>
                </div>
                <a href="task-explorer" class="db-artifact-action">Open Task Explorer →</a>
            </div>

        </div>
    </section>

    @* ── Readiness Summary ──────────────────────────────────────────────────── *@
    <section class="db-section">
        <SectionHeader Title="Readiness Summary" />
        @if (Snapshot.DeliveryReport is not null || Snapshot.ReadinessReport is not null)
        {
            <div class="db-readiness-grid">
                @ReadinessCard("Development", Snapshot.DeliveryReport?.DevelopmentDecision.State, Snapshot.DeliveryReport?.Health.DevelopmentScore, "quality-review")
                @ReadinessCard("Testing",     Snapshot.DeliveryReport?.TestingDecision.State,     Snapshot.DeliveryReport?.Health.TestingScore,     "quality-review")
                @ReadinessCard("Release",     Snapshot.DeliveryReport?.ReleaseDecision.State,     Snapshot.DeliveryReport?.Health.ReleaseScore,      "quality-review")
                @ReadinessCardScore("QA Readiness", Snapshot.ReadinessReport?.OverallScore, "quality-review")
            </div>
        }
        else
        {
            <div class="db-section-empty">
                Run a Quality Review with Readiness packs selected to populate this section.
                <div class="db-empty-actions">
                    <a href="quality-review" class="db-qa-btn">Quality Review</a>
                </div>
            </div>
        }
    </section>

    @* ══════════════════════════════════════════════════════════════════════════
       ZONE 2 · DECISION SUPPORT
       Top Risks → Top Recommendations → Recent Activity
       ══════════════════════════════════════════════════════════════════════════ *@

    @* ── Top Risks ──────────────────────────────────────────────────────────── *@
    <section class="db-section db-zone-start">
        <SectionHeader Title="Top Risks" />
        @{
            var topRisks = _topRisks.ToList();
        }
        @if (topRisks.Count > 0)
        {
            <div class="issue-cards">
                @foreach (var (Title, Severity, Category, Detail) in topRisks)
                {
                    <IssueCard Severity="@Severity" Component="@Category" Description="@Title" SuggestedFix="@Detail" />
                }
            </div>
        }
        else
        {
            <div class="db-section-empty">
                No risks detected. Run Quality Review to surface governance risks.
                <div class="db-empty-actions">
                    <a href="quality-review" class="db-qa-btn">Run Quality Review</a>
                </div>
            </div>
        }
    </section>

    @* ── Top Recommendations ────────────────────────────────────────────────── *@
    <section class="db-section">
        <SectionHeader Title="Top Recommendations" />
        @{
            var topRecs = _topRecs.ToList();
        }
        @if (topRecs.Count > 0)
        {
            <div class="db-rec-cards">
                @{ int recIdx = 0; }
                @foreach (var (Text, Category, ActionHref) in topRecs)
                {
                    recIdx++;
                    <div class="db-rec-card">
                        <div class="db-rec-num" aria-hidden="true">@recIdx</div>
                        <div class="db-rec-body">
                            <div class="db-rec-text">@Text</div>
                            <div class="db-rec-footer">
                                <span class="db-rec-cat">@Category</span>
                                <a href="@ActionHref" class="db-rec-action">Open →</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="db-section-empty">
                No recommendations yet. Run Quality Review with the QA Auditor or Delivery Readiness pack to generate actionable recommendations.
            </div>
        }
    </section>

    @* ── Recent Activity ────────────────────────────────────────────────────── *@
    <section class="db-section">
        <SectionHeader Title="Recent Activity" />
        <div class="db-timeline">
            @{
                bool anyActivity = false;

                if (Snapshot.AuditReport is not null)
                {
                    anyActivity = true;
                    <div class="db-tl-entry">
                        <span class="db-tl-dot db-tl-dot-analyzed" aria-hidden="true"></span>
                        <div class="db-tl-body">
                            <span class="db-tl-action">Quality Review — QA Auditor completed</span>
                            <span class="db-tl-meta">@Snapshot.AuditReport.Health.TotalFindings finding@(Snapshot.AuditReport.Health.TotalFindings != 1 ? "s" : "")</span>
                        </div>
                    </div>
                }

                if (Snapshot.DeliveryReport is not null)
                {
                    anyActivity = true;
                    <div class="db-tl-entry">
                        <span class="db-tl-dot db-tl-dot-analyzed" aria-hidden="true"></span>
                        <div class="db-tl-body">
                            <span class="db-tl-action">Quality Review — Delivery Readiness completed</span>
                            <span class="db-tl-meta">@Snapshot.DeliveryReport.Health.OverallReadinessScore.ToString("0")% overall readiness</span>
                        </div>
                    </div>
                }

                if (Snapshot.TraceabilityReport is not null)
                {
                    anyActivity = true;
                    <div class="db-tl-entry">
                        <span class="db-tl-dot db-tl-dot-analyzed" aria-hidden="true"></span>
                        <div class="db-tl-body">
                            <span class="db-tl-action">Artifact Traceability completed</span>
                            <span class="db-tl-meta">@Snapshot.TraceabilityReport.Health.CoveragePercentage.ToString("0")% coverage</span>
                        </div>
                    </div>
                }

                if (Snapshot.ComplianceReport is not null)
                {
                    anyActivity = true;
                    <div class="db-tl-entry">
                        <span class="db-tl-dot db-tl-dot-analyzed" aria-hidden="true"></span>
                        <div class="db-tl-body">
                            <span class="db-tl-action">Quality Review — Constitution Compliance completed</span>
                            <span class="db-tl-meta">@Snapshot.ComplianceReport.Coverage.CompliancePercentage.ToString("0")% compliant</span>
                        </div>
                    </div>
                }

                if (Snapshot.ReadinessReport is not null)
                {
                    anyActivity = true;
                    <div class="db-tl-entry">
                        <span class="db-tl-dot db-tl-dot-analyzed" aria-hidden="true"></span>
                        <div class="db-tl-body">
                            <span class="db-tl-action">Quality Review — QA Readiness completed</span>
                            <span class="db-tl-meta">@Snapshot.ReadinessReport.OverallScore.ToString("0")% overall</span>
                        </div>
                    </div>
                }

                if (_perfReport is not null)
                {
                    anyActivity = true;
                    <div class="db-tl-entry">
                        <span class="db-tl-dot db-tl-dot-perf" aria-hidden="true"></span>
                        <div class="db-tl-body">
                            <span class="db-tl-action">Performance Review completed</span>
                            <span class="db-tl-meta">@_perfReport.Assets.Count assets · @FormatBytes(_perfReport.Health.TotalTransferBytes) transfer</span>
                        </div>
                    </div>
                }

                if (!anyActivity)
                {
                    <div class="db-tl-empty">
                        No analyses have been run this session.
                    </div>
                }
            }
        </div>
    </section>

    @* ══════════════════════════════════════════════════════════════════════════
       ZONE 3 · OPERATIONAL ACTIONS
       Analysis Summary → Quick Actions
       ══════════════════════════════════════════════════════════════════════════ *@

    @* ── Analysis Summary ───────────────────────────────────────────────────── *@
    <section class="db-section db-zone-start">
        <SectionHeader Title="Analysis Summary" Description="Run each analysis to populate" />
        <div class="db-analysis-grid">

            @* Artifact Traceability *@
            <div class="db-analysis-card">
                <div class="db-analysis-card-header">
                    <span class="db-analysis-card-title">Artifact Traceability</span>
                    <a href="artifact-traceability" class="db-summary-open" aria-label="Open Artifact Traceability">Open →</a>
                </div>
                @if (Snapshot.TraceabilityReport is { } tr)
                {
                    <div class="db-analysis-score @ScoreClass(tr.Health.CoveragePercentage)">@tr.Health.CoveragePercentage.ToString("0")%</div>
                    <span class="db-analysis-status @KpiStatusClass(tr.Health.CoveragePercentage, true)">@KpiStatusLabel(tr.Health.CoveragePercentage, true)</span>
                    <div class="db-analysis-chips">
                        <span class="db-count-chip db-count-good">@tr.Health.CoveredCount covered</span>
                        @if (tr.Health.PartialCount > 0) { <span class="db-count-chip db-count-warn">@tr.Health.PartialCount partial</span> }
                        @if (tr.Health.MissingCount > 0) { <span class="db-count-chip db-count-poor">@tr.Health.MissingCount missing</span> }
                    </div>
                }
                else
                {
                    <div class="db-analysis-empty">
                        Not run — populate by running Artifact Traceability.
                        <a href="artifact-traceability" class="db-analysis-run-link">Run now →</a>
                    </div>
                }
            </div>

            @* Constitution Compliance *@
            <div class="db-analysis-card">
                <div class="db-analysis-card-header">
                    <span class="db-analysis-card-title">Constitution Compliance</span>
                    <a href="quality-review" class="db-summary-open" aria-label="Open Quality Review">Open →</a>
                </div>
                @if (Snapshot.ComplianceReport is { } cr)
                {
                    <div class="db-analysis-score @ScoreClass(cr.Coverage.CompliancePercentage)">@cr.Coverage.CompliancePercentage.ToString("0")%</div>
                    <span class="db-analysis-status @KpiStatusClass(cr.Coverage.CompliancePercentage, true)">@KpiStatusLabel(cr.Coverage.CompliancePercentage, true)</span>
                    <div class="db-analysis-chips">
                        <span class="db-count-chip db-count-good">@cr.Coverage.CompliantItems compliant</span>
                        @if (cr.Coverage.PartialItems > 0)  { <span class="db-count-chip db-count-warn">@cr.Coverage.PartialItems partial</span> }
                        @if (cr.Coverage.MissingItems > 0)  { <span class="db-count-chip db-count-poor">@cr.Coverage.MissingItems missing</span> }
                        @if (cr.Violations.Count > 0)        { <span class="db-count-chip db-count-poor">@cr.Violations.Count violations</span> }
                    </div>
                }
                else
                {
                    <div class="db-analysis-empty">
                        Not run — populate by running Quality Review.
                        <a href="quality-review" class="db-analysis-run-link">Run now →</a>
                    </div>
                }
            </div>

            @* QA Audit *@
            <div class="db-analysis-card">
                <div class="db-analysis-card-header">
                    <span class="db-analysis-card-title">QA Audit</span>
                    <a href="quality-review" class="db-summary-open" aria-label="Open Quality Review">Open →</a>
                </div>
                @if (Snapshot.AuditReport is { } ar)
                {
                    <div class="db-analysis-score @ScoreClass(ar.Health.AuditScore)">@ar.Health.AuditScore.ToString("0")</div>
                    <span class="db-analysis-status @KpiStatusClass(ar.Health.AuditScore, true)">@KpiStatusLabel(ar.Health.AuditScore, true)</span>
                    @if (_topAuditRiskTitle is not null)
                    {
                        <div class="db-analysis-finding">@_topAuditRiskTitle</div>
                    }
                    <div class="db-analysis-chips">
                        @if (ar.Health.CriticalCount > 0) { <span class="db-count-chip db-count-poor">@ar.Health.CriticalCount critical</span> }
                        @if (ar.Health.HighCount > 0)     { <span class="db-count-chip db-count-poor">@ar.Health.HighCount high</span> }
                        @if (ar.Health.MediumCount > 0)   { <span class="db-count-chip db-count-warn">@ar.Health.MediumCount medium</span> }
                        @if (ar.Health.CriticalCount == 0 && ar.Health.HighCount == 0)
                        { <span class="db-count-chip db-count-good">No critical findings</span> }
                    </div>
                }
                else
                {
                    <div class="db-analysis-empty">
                        Not run — populate by running Quality Review.
                        <a href="quality-review" class="db-analysis-run-link">Run now →</a>
                    </div>
                }
            </div>

            @* Delivery Readiness *@
            <div class="db-analysis-card">
                <div class="db-analysis-card-header">
                    <span class="db-analysis-card-title">Delivery Readiness</span>
                    <a href="quality-review" class="db-summary-open" aria-label="Open Quality Review">Open →</a>
                </div>
                @if (Snapshot.DeliveryReport is { } dr)
                {
                    <div class="db-analysis-score @ScoreClass(dr.Health.OverallReadinessScore)">@dr.Health.OverallReadinessScore.ToString("0")%</div>
                    <span class="db-analysis-status @ReadinessStatusClass(dr.DevelopmentDecision.State)">@ReadinessStateLabel(dr.DevelopmentDecision.State)</span>
                    @if (_topBlockerTitle is not null)
                    {
                        <div class="db-analysis-finding">@_topBlockerTitle</div>
                    }
                    <div class="db-analysis-chips">
                        <span class="db-count-chip @(dr.DevelopmentDecision.State == ReadinessState.Ready ? "db-count-good" : dr.DevelopmentDecision.State == ReadinessState.MostlyReady ? "db-count-warn" : "db-count-poor")">Dev</span>
                        <span class="db-count-chip @(dr.TestingDecision.State     == ReadinessState.Ready ? "db-count-good" : dr.TestingDecision.State     == ReadinessState.MostlyReady ? "db-count-warn" : "db-count-poor")">Test</span>
                        <span class="db-count-chip @(dr.ReleaseDecision.State     == ReadinessState.Ready ? "db-count-good" : dr.ReleaseDecision.State     == ReadinessState.MostlyReady ? "db-count-warn" : "db-count-poor")">Release</span>
                    </div>
                }
                else
                {
                    <div class="db-analysis-empty">
                        Not run — populate by running Quality Review.
                        <a href="quality-review" class="db-analysis-run-link">Run now →</a>
                    </div>
                }
            </div>

            @* Frontend Quality Review *@
            <div class="db-analysis-card">
                <div class="db-analysis-card-header">
                    <span class="db-analysis-card-title">Frontend Quality Review</span>
                    <a href="frontend-quality-review" class="db-summary-open" aria-label="Open Frontend Quality Review">Open →</a>
                </div>
                @if (_fqrReport is { } fqrCard)
                {
                    <div class="db-analysis-score @ScoreClass(fqrCard.OverallScore)">@fqrCard.OverallScore</div>
                    <span class="db-analysis-status @KpiStatusClass(fqrCard.OverallScore, true)">@KpiStatusLabel(fqrCard.OverallScore, true)</span>
                    @if (fqrCard.Findings.OrderBy(f => f.Severity).FirstOrDefault() is { } topFqrFinding)
                    {
                        <div class="db-analysis-finding">@topFqrFinding.Title</div>
                    }
                    <div class="db-analysis-chips">
                        @{ var fqrCritical = fqrCard.Findings.Count(f => f.Severity == FrontendQualitySeverity.Critical); }
                        @{ var fqrHigh     = fqrCard.Findings.Count(f => f.Severity == FrontendQualitySeverity.High); }
                        @if (fqrCritical > 0) { <span class="db-count-chip db-count-poor">@fqrCritical critical</span> }
                        @if (fqrHigh > 0)     { <span class="db-count-chip db-count-poor">@fqrHigh high</span> }
                        @if (fqrCritical == 0 && fqrHigh == 0)
                        { <span class="db-count-chip db-count-good">No critical findings</span> }
                    </div>
                }
                else if (RuntimeReviews.QualityReview.Status != RuntimeReviewStatus.NotRun)
                {
                    <span class="db-analysis-status @RuntimeStatusClass(RuntimeReviews.QualityReview.Status)">@RuntimeStatusLabel(RuntimeReviews.QualityReview.Status)</span>
                    @if (RuntimeReviews.QualityReview.ErrorMessage is not null)
                    {
                        <div class="db-analysis-finding">@RuntimeReviews.QualityReview.ErrorMessage</div>
                    }
                }
                else
                {
                    <div class="db-analysis-empty">
                        Not run — analyse performance, security, accessibility, standards, and readiness in one review.
                        <a href="frontend-quality-review" class="db-analysis-run-link">Run now →</a>
                    </div>
                }
            @* API Quality Review *@
            <div class="db-analysis-card">
                <div class="db-analysis-card-header">
                    <span class="db-analysis-card-title">API Quality Review</span>
                    <a href="api-quality-review" class="db-summary-open" aria-label="Open API Quality Review">Open →</a>
                </div>
                @if (_aqrReport is { } aqrCard)
                {
                    <div class="db-analysis-score @ScoreClass(aqrCard.OverallScore)">@aqrCard.OverallScore</div>
                    <span class="db-analysis-status @KpiStatusClass(aqrCard.OverallScore, true)">@KpiStatusLabel(aqrCard.OverallScore, true)</span>
                    @if (aqrCard.Findings.OrderBy(f => f.Severity).FirstOrDefault() is { } topAqrFinding)
                    {
                        <div class="db-analysis-finding">@topAqrFinding.Title</div>
                    }
                    <div class="db-analysis-chips">
                        @{ var aqrCritical = aqrCard.Findings.Count(f => f.Severity == ApiQualitySeverity.Critical); }
                        @{ var aqrHigh     = aqrCard.Findings.Count(f => f.Severity == ApiQualitySeverity.High); }
                        @if (aqrCritical > 0) { <span class="db-count-chip db-count-poor">@aqrCritical critical</span> }
                        @if (aqrHigh > 0)     { <span class="db-count-chip db-count-poor">@aqrHigh high</span> }
                        @if (aqrCritical == 0 && aqrHigh == 0)
                        { <span class="db-count-chip db-count-good">@(aqrCard.IsDeploymentReady ? "Deployment Ready" : "No critical findings")</span> }
                    </div>
                }
                else if (RuntimeReviews.ApiQualityReview.Status != RuntimeReviewStatus.NotRun)
                {
                    <span class="db-analysis-status @RuntimeStatusClass(RuntimeReviews.ApiQualityReview.Status)">@RuntimeStatusLabel(RuntimeReviews.ApiQualityReview.Status)</span>
                    @if (RuntimeReviews.ApiQualityReview.ErrorMessage is not null)
                    {
                        <div class="db-analysis-finding">@RuntimeReviews.ApiQualityReview.ErrorMessage</div>
                    }
                }
                else
                {
                    <div class="db-analysis-empty">
                        Not run — analyse connectivity, security, performance, REST, GraphQL, OpenAPI, and readiness.
                        <a href="api-quality-review" class="db-analysis-run-link">Run now →</a>
                    </div>
                }
            </div>

            </div>

        </div>
    </section>

    @* ── Quick Actions ───────────────────────────────────────────────────────── *@
    <section class="db-section">
        <SectionHeader Title="Quick Actions" />
        <div class="db-quick-actions">
            <div class="db-qa-group">
                <div class="db-qa-group-label">Review</div>
                <div class="db-qa-buttons">
                    <a href="constitution-explorer"  class="db-qa-btn">Constitution Explorer</a>
                    <a href="extract"                class="db-qa-btn">Specification Review</a>
                    <a href="plan-explorer"          class="db-qa-btn">Plan Explorer</a>
                    <a href="task-explorer"          class="db-qa-btn">Task Explorer</a>
                </div>
            </div>
            <div class="db-qa-group">
                <div class="db-qa-group-label">Analysis</div>
                <div class="db-qa-buttons">
                    <a href="artifact-traceability"   class="db-qa-btn">Artifact Traceability</a>
                    <a href="quality-review"          class="db-qa-btn">Quality Review</a>
                    <a href="frontend-quality-review"  class="db-qa-btn">Frontend Quality Review</a>
                    <a href="api-quality-review"       class="db-qa-btn">API Quality Review</a>
                </div>
            </div>
            <div class="db-qa-group">
                <div class="db-qa-group-label">AI</div>
                <div class="db-qa-buttons">
                    <a href="ai-change-auditor" class="db-qa-btn">AI Change Review</a>
                </div>
            </div>
        </div>
    </section>

@code {
    // ── Runtime review session ────────────────────────────────────────────────

    private WasmSecurityReviewReport?    _securityReport => RuntimeReviews.SecurityReview.Report;
    private WasmPerformanceReviewReport? _perfReport     => RuntimeReviews.PerformanceReview.Report;
    private FrontendQualityReviewReport? _fqrReport      => RuntimeReviews.QualityReview.Report;
    private ApiQualityReviewReport?      _aqrReport      => RuntimeReviews.ApiQualityReview.Report;

    // ── Snapshot aliases ──────────────────────────────────────────────────────

    private bool _hasAnySnapshot =>
        Snapshot.TraceabilityReport is not null ||
        Snapshot.ComplianceReport   is not null ||
        Snapshot.AuditReport        is not null ||
        Snapshot.DeliveryReport     is not null ||
        Snapshot.ReadinessReport    is not null ||
        QualitySession.Status       != AnalysisSessionStatus.NotRun ||
        RuntimeReviews.SecurityReview.HasResult ||
        RuntimeReviews.PerformanceReview.HasResult ||
        RuntimeReviews.QualityReview.HasResult ||
        RuntimeReviews.ApiQualityReview.HasResult;

    private bool _hasAnyWorkspace =>
        Workspace.Has(WorkspaceArtifactKind.Constitution) ||
        Workspace.Has(WorkspaceArtifactKind.Specification) ||
        Workspace.Has(WorkspaceArtifactKind.Plan) ||
        Workspace.Has(WorkspaceArtifactKind.Tasks) ||
        Workspace.Has(WorkspaceArtifactKind.DataModel);

    // ── Artifact loaded / analyzed ────────────────────────────────────────────

    private bool _constitutionLoaded =>
        Workspace.Has(WorkspaceArtifactKind.Constitution);

    private bool _constitutionAnalyzed =>
        Snapshot.TraceabilityReport?.HasConstitution == true ||
        Snapshot.ComplianceReport?.HasConstitution == true ||
        Snapshot.AuditReport?.HasConstitution == true ||
        Snapshot.DeliveryReport?.HasConstitution == true ||
        Snapshot.ReadinessReport?.HasConstitution == true;

    private bool _specLoaded =>
        Workspace.Has(WorkspaceArtifactKind.Specification);

    private bool _specAnalyzed =>
        Snapshot.TraceabilityReport?.HasSpecification == true ||
        Snapshot.ComplianceReport?.HasSpecification == true ||
        Snapshot.AuditReport?.HasSpecification == true ||
        Snapshot.ReadinessReport?.HasSpecification == true;

    private bool _planLoaded =>
        Workspace.Has(WorkspaceArtifactKind.Plan);

    private bool _planAnalyzed =>
        Snapshot.TraceabilityReport?.HasPlan == true ||
        Snapshot.ComplianceReport?.HasPlan == true ||
        Snapshot.AuditReport?.HasPlan == true ||
        Snapshot.DeliveryReport?.HasPlan == true ||
        Snapshot.ReadinessReport?.HasPlan == true;

    private bool _tasksLoaded =>
        Workspace.Has(WorkspaceArtifactKind.Tasks);

    private bool _tasksAnalyzed =>
        Snapshot.TraceabilityReport?.HasTasks == true ||
        Snapshot.AuditReport?.HasTasks == true ||
        Snapshot.DeliveryReport?.HasTasks == true ||
        Snapshot.ReadinessReport?.HasTasks == true;

    // ── Pre-computed health scores (numeric) ──────────────────────────────────

    private bool _traceabilityHasData => Snapshot.TraceabilityReport is not null;
    private double _traceabilityScore => Snapshot.TraceabilityReport is { } tr
        ? tr.Health.CoveragePercentage
        : 0;

    private bool _complianceHasData => Snapshot.ComplianceReport is not null;
    private double _complianceScore => Snapshot.ComplianceReport?.Health.CompliancePercentage ?? 0;

    private bool _qaHasData => QualitySession.HasResult || Snapshot.AuditReport is not null || Snapshot.ReadinessReport is not null;
    private double _qaScore => QualitySession.Report is { } report
        ? report.OverallScore
        : Snapshot.AuditReport is { } ar
            ? ar.Health.AuditScore
            : Snapshot.ReadinessReport?.OverallScore ?? 0;

    private bool _deliveryHasData => Snapshot.DeliveryReport is not null;
    private double _deliveryScore => Snapshot.DeliveryReport?.Health.OverallReadinessScore ?? 0;

    // ── Overall health ────────────────────────────────────────────────────────

    private double _overallScore
    {
        get
        {
            var scores = new List<double>();
            if (Snapshot.TraceabilityReport is not null) scores.Add(_traceabilityScore);
            if (Snapshot.ComplianceReport is not null)   scores.Add(_complianceScore);
            if (_qaHasData)                              scores.Add(_qaScore);
            if (Snapshot.DeliveryReport is not null)     scores.Add(_deliveryScore);
            if (_securityReport is not null)             scores.Add(_securityReport.Health.Score);
            if (_perfReport?.ReadinessReport is { HasData: true } perf) scores.Add(perf.OverallScore);
            return scores.Count > 0 ? scores.Average() : 0;
        }
    }

    private bool _hasAnyScore =>
        Snapshot.TraceabilityReport is not null || Snapshot.ComplianceReport is not null ||
        Snapshot.AuditReport is not null        || Snapshot.DeliveryReport is not null  ||
        QualitySession.HasResult                ||
        Snapshot.ReadinessReport is not null    || _securityReport is not null ||
        _perfReport?.ReadinessReport is { HasData: true };

    private string _overallScoreLabel => _overallScore >= 80 ? "Healthy" : _overallScore >= 50 ? "Needs Attention" : "At Risk";

    // ── Project phase & governance KPI ────────────────────────────────────────

    private string _projectPhase =>
        _tasksAnalyzed ? "Testing" :
        _planLoaded    ? "Implementation" :
        _specLoaded    ? "Specification" : "Setup";

    private int _governanceLoadPercent =>
        (_constitutionLoaded ? 25 : 0) + (_specLoaded ? 25 : 0) +
        (_planLoaded         ? 25 : 0) + (_tasksLoaded ? 25 : 0);

    // ── Top risks ─────────────────────────────────────────────────────────────

    private IEnumerable<(string Title, string Severity, string Category, string? Detail)> _topRisks
    {
        get
        {
            var list = new List<(string, string, string, string?)>();
            if (Snapshot.AuditReport is { } ar)
                list.AddRange(ar.Risks
                    .OrderBy(r => r.Severity)
                    .Take(3)
                    .Select(r => (r.Title, r.Severity.ToString(), r.Category.ToString(), r.Mitigation)));
            if (list.Count < 3 && Snapshot.DeliveryReport is { } dr)
                list.AddRange(dr.Blockers
                    .OrderBy(b => b.Severity)
                    .Take(3 - list.Count)
                    .Select(b => (b.Title, b.Severity.ToString(), b.Category, (string?)b.Description)));
            return list.Take(3);
        }
    }

    // ── Top recommendations ───────────────────────────────────────────────────

    private IEnumerable<(string Text, string Category, string ActionHref)> _topRecs
    {
        get
        {
            var list = new List<(string, string, string)>();
            if (Snapshot.AuditReport is { } ar)
                list.AddRange(ar.Recommendations
                    .OrderBy(r => r.Priority)
                    .Take(3)
                    .Select(r => (r.Text, r.Category.ToString(), "quality-review")));
            if (list.Count < 3 && Snapshot.DeliveryReport is { } dr)
                list.AddRange(dr.Recommendations
                    .OrderBy(r => r.Priority)
                    .Take(3 - list.Count)
                    .Select(r => (r.Text, r.Category, "quality-review")));
            return list.Take(3);
        }
    }

    // ── Health Summary values ─────────────────────────────────────────────────

    private string TraceabilityHealthVal =>
        Snapshot.TraceabilityReport is { } tr
            ? $"{tr.Health.CoveragePercentage:0}%"
            : "—";

    private string ComplianceHealthVal =>
        Snapshot.ComplianceReport is { } cr
            ? $"{cr.Health.CompliancePercentage:0}%"
            : "—";

    private string QaHealthVal =>
        QualitySession.Report is { } report
            ? $"{report.OverallScore:0}/100"
            : Snapshot.AuditReport is { } ar
                ? $"{ar.Health.AuditScore:0}/100"
                : Snapshot.ReadinessReport is { } qr ? $"{qr.OverallScore:0}/100" : "-";
    private string DeliveryHealthVal =>
        Snapshot.DeliveryReport is { } dr
            ? $"{dr.Health.OverallReadinessScore:0}%"
            : "—";

    // ── Top findings for analysis cards ──────────────────────────────────────

    private string? _topAuditRiskTitle =>
        Snapshot.AuditReport?.Risks?.OrderBy(r => r.Severity).FirstOrDefault()?.Title;

    private string? _topBlockerTitle =>
        Snapshot.DeliveryReport?.Blockers?.OrderBy(b => b.Severity).FirstOrDefault()?.Title;

    // ── Render helpers ────────────────────────────────────────────────────────

    private static string ScoreClass(double score) =>
        score >= 80 ? "db-val-good" : score >= 50 ? "db-val-warn" : "db-val-poor";

    private static string KpiStatusClass(double score, bool hasData) =>
        !hasData ? "db-status-notrun" :
        score >= 80 ? "db-status-healthy" :
        score >= 50 ? "db-status-warning" : "db-status-critical";

    private static string KpiStatusLabel(double score, bool hasData) =>
        !hasData ? "Not Run" :
        score >= 80 ? "Healthy" :
        score >= 50 ? "Warning" : "Critical";

    private static string RuntimeStatusLabel(RuntimeReviewStatus status) => status switch
    {
        RuntimeReviewStatus.Running   => "Running",
        RuntimeReviewStatus.Completed => "Completed",
        RuntimeReviewStatus.Failed    => "Failed",
        _                             => "Not Run",
    };

    private static string RuntimeStatusClass(RuntimeReviewStatus status) => status switch
    {
        RuntimeReviewStatus.Running   => "db-status-warning",
        RuntimeReviewStatus.Completed => "db-status-healthy",
        RuntimeReviewStatus.Failed    => "db-status-critical",
        _                             => "db-status-notrun",
    };

    private static string RuntimeStatusChip(RuntimeReviewStatus status) => status switch
    {
        RuntimeReviewStatus.Running   => "warning",
        RuntimeReviewStatus.Completed => "healthy",
        RuntimeReviewStatus.Failed    => "critical",
        _                             => "neutral",
    };

    private static string ReadinessStatusClass(ReadinessState state) => state switch
    {
        ReadinessState.Ready       => "db-status-healthy",
        ReadinessState.MostlyReady => "db-status-warning",
        ReadinessState.Blocked     => "db-status-critical",
        _                          => "db-status-critical",
    };

    private static string PerformanceStatusClass(PerformanceReadinessState state) => state switch
    {
        PerformanceReadinessState.Ready       => "db-status-healthy",
        PerformanceReadinessState.MostlyReady => "db-status-warning",
        PerformanceReadinessState.HighRisk    => "db-status-critical",
        _                                     => "db-status-warning",
    };

    private static string ReadinessStateLabel(ReadinessState state) => state switch
    {
        ReadinessState.Ready       => "Ready",
        ReadinessState.MostlyReady => "Mostly Ready",
        ReadinessState.NotReady    => "Not Ready",
        ReadinessState.Blocked     => "Blocked",
        _                          => "—",
    };

    private static string ReadinessStateLabel(PerformanceReadinessState state) => state switch
    {
        PerformanceReadinessState.Ready            => "Ready",
        PerformanceReadinessState.MostlyReady      => "Mostly Ready",
        PerformanceReadinessState.NeedsImprovement => "Needs Improvement",
        PerformanceReadinessState.HighRisk         => "High Risk",
        _                                          => "Not Assessed",
    };

    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0)        return "0 B";
        if (bytes < 1_024)     return $"{bytes} B";
        if (bytes < 1_048_576) return $"{bytes / 1024} KB";
        return $"{bytes / 1_048_576.0:F1} MB";
    }

    // ── RenderFragment helpers ────────────────────────────────────────────────

    private RenderFragment ReadinessCard(string label, ReadinessState? state, double? score, string href) => __builder =>
    {
        <div class="db-readiness-card">
            <div class="db-readiness-label">@label</div>
            @if (state.HasValue && score.HasValue)
            {
                <div class="db-readiness-score @ScoreClass(score.Value)">@score.Value.ToString("0")%</div>
                <div class="db-readiness-state @ReadinessStatusClass(state.Value)">@ReadinessStateLabel(state.Value)</div>
            }
            else
            {
                <div class="db-readiness-score db-val-empty">—</div>
                <div class="db-readiness-state db-status-notrun">Not Run</div>
            }
            <a href="@href" class="db-readiness-link">Open →</a>
        </div>
    };

    private RenderFragment ReadinessCardScore(string label, double? score, string href) => __builder =>
    {
        <div class="db-readiness-card">
            <div class="db-readiness-label">@label</div>
            @if (score.HasValue)
            {
                <div class="db-readiness-score @ScoreClass(score.Value)">@score.Value.ToString("0")%</div>
                <div class="db-readiness-state @KpiStatusClass(score.Value, true)">@KpiStatusLabel(score.Value, true)</div>
            }
            else
            {
                <div class="db-readiness-score db-val-empty">—</div>
                <div class="db-readiness-state db-status-notrun">Not Run</div>
            }
            <a href="@href" class="db-readiness-link">Open →</a>
        </div>
    };

    // ── Actions ───────────────────────────────────────────────────────────────

    private async Task ExportHtml()
    {
        if (!_hasAnySnapshot) return;
        var html = ExportService.ExportDashboardSummary(
            Workspace.ProjectName,
            Snapshot.TraceabilityReport,
            Snapshot.ComplianceReport,
            Snapshot.AuditReport,
            Snapshot.DeliveryReport,
            Snapshot.ReadinessReport,
            _perfReport);
        await JS.InvokeVoidAsync("downloadHtmlFile", $"dashboard-summary-{DateTime.UtcNow:yyyy-MM-dd}.html", html);
    }

    // ── Data loading ──────────────────────────────────────────────────────────

}
