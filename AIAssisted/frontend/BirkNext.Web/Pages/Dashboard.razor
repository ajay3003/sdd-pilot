@page "/dashboard"
@using BirkNext.Web.Components
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using BirkNext.Web.Services.Explorers
@inject IDashboardSnapshotService Snapshot
@inject RuntimeReviewSessionService RuntimeReviews
@inject QualityReviewSessionService QualitySession
@inject IWorkspaceSessionService Workspace
@inject ICurrentWorkspaceProjection CurrentWorkspace
@inject IReportExportService ExportService
@inject IWorkflowReadinessService WorkflowReadiness
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Dashboard</PageTitle>

@if (ResetNotice is { } notice)
{
    <div class="notification @(notice.Warn ? "notification-warning" : "notification-success")" role="status" data-testid="reset-notice">
        <strong>@notice.Title</strong> @notice.Text
    </div>
}

@* ── Onboarding ───────────────────────────────────────────────────────────── *@
@if (!_hasAnyWorkspace && !_hasAnySnapshot)
{
    <div class="dashboard-onboarding-card" data-testid="onboarding-card">
        <div class="dashboard-onboarding-text">
            <strong>New to QA Review Studio?</strong>
            <span>Follow the recommended workflow to get started with the platform phase by phase.</span>
        </div>
        <a href="getting-started" class="btn-primary dashboard-onboarding-btn">Start Recommended Workflow</a>
    </div>
}

    <PageHeader Title="SDD Governance Dashboard" Description="A cross-review governance overview: evidence availability, analysis state, manual reviews and actual results — reported separately.">
        @if (_hasAnyScore)
        {
            <span class="db-pill is-@(_overallScore >= 80 ? "good" : "attention")" data-testid="db-quality-among-assessed">@_overallScoreLabel</span>
            <span class="db-assessment-coverage" data-testid="db-assessment-coverage" title="Quality is averaged over assessed areas only. Areas without evidence are coverage gaps, not low quality.">@_assessmentCoverageLabel</span>
        }
        @if (_hasAnySnapshot)
        {
            <button type="button" class="btn-secondary db-export-btn" @onclick="ExportHtml">Export HTML</button>
        }
    </PageHeader>

    @* ══ 1 · Workspace summary ═══════════════════════════════════════════════════
       Driven only by the current-workspace read model (ICurrentWorkspaceProjection), the same one Recommended Workflow reads. *@
    <section class="db-workspace-panel" aria-labelledby="db-workspace-heading" data-testid="db-workspace-panel">
        <h2 id="db-workspace-heading" class="db-visually-hidden">Current project</h2>
        @if (_workspace is null)
        {
            <p class="db-workspace-message" role="status">Loading project…</p>
        }
        else if (_workspace.State == CurrentWorkspaceState.NoWorkspace)
        {
            <div class="db-workspace-empty">
                <p class="db-workspace-message">No workspace loaded. Import your project ZIP (documents and source in one upload) or open a Demo Project to begin.</p>
                <div class="db-workspace-actions">
                    <a href="project-import" class="db-btn-primary" data-testid="db-import-project">Import Project</a>
                    <a href="demo-projects" class="db-btn-secondary">Open Demo Projects</a>
                </div>
            </div>
        }
        else
        {
            @if (_workspace.IsImportedProject && _workspace.State == CurrentWorkspaceState.Loaded)
            {
                <p class="db-import-success" role="status" data-testid="db-import-success">
                    <span aria-hidden="true">✓ </span><strong>Project imported successfully.</strong>
                    @(_anythingReviewed ? " Review results below come from this session." : " Nothing has been reviewed or tested yet.")
                </p>
            }
            <div class="db-workspace-info">
                <div class="db-workspace-identity">
                    <span class="db-workspace-label">@(_workspace.IsImportedProject ? "Imported project" : _workspace.ProjectLoaded ? "Project" : "Workspace")</span>
                    <span class="db-workspace-project" data-testid="db-workspace-name">@(_workspace.ProjectName ?? _workspace.WorkspaceName)</span>
                </div>
                @if (_workspace.State == CurrentWorkspaceState.Error)
                {
                    <span class="db-workspace-count" data-testid="db-workspace-roles">Failed to load the project's documents</span>
                }
                else if (_workspace.ProjectLoaded && !_workspace.ProjectInCatalog)
                {
                    <span class="db-workspace-count" data-testid="db-workspace-roles">Documents unavailable — the project is no longer in the catalog</span>
                }
                else
                {
                    <span class="db-workspace-count" data-testid="db-workspace-roles">@DashboardPresentation.WorkspaceSummary(_workspace)</span>
                }
                <span class="db-workspace-env is-@DashboardPresentation.Tone(_environment.Status)" data-testid="db-test-environment">@_environment.Text</span>
            </div>
            <div class="db-workspace-meta">
                @if (_workspace.ModuleLabel is { } reviewModule)
                {
                    <span data-testid="db-workspace-modules">Reviewing module @reviewModule@(_workspace.PackLabel is { } viewedPack ? $" · pack {viewedPack}" : "")</span>
                }
                else if (_workspace.ModuleRequired)
                {
                    <span data-testid="db-workspace-modules">No module chosen yet — reviews check one module at a time</span>
                }
                <span data-testid="db-save-status" title="Save status. A workspace is loaded whether or not it is saved.">@_workspace.SaveStatusLabel</span>
            </div>
        }
    </section>

    @* ══ 2 · Recommended next step ══════════════════════════════════════════════ *@
    @if (_nextStep is { } next)
    {
        <section class="db-next-step" aria-labelledby="db-next-heading" data-testid="db-next-step" data-key="@next.Key">
            <h2 id="db-next-heading" class="db-next-eyebrow">Recommended next step</h2>
            <p class="db-next-title" data-testid="db-next-title">@next.Title</p>
            <p class="db-next-reason" data-testid="db-next-reason"><span class="db-next-k">Why:</span> @next.Reason</p>
            <p class="db-next-achieves" data-testid="db-next-achieves"><span class="db-next-k">What it does:</span> @next.Achieves</p>
            <div class="db-next-actions">
                <a href="@next.Href" class="db-btn-primary" data-testid="db-next-action">@next.ActionLabel</a>
                <a href="getting-started" class="db-btn-link">See the full recommended workflow</a>
            </div>
            @if (next.Then.Count > 0)
            {
                <div class="db-next-then" data-testid="db-next-then">
                    <span class="db-next-k">Then:</span>
                    <ol>
                        @foreach (var step in next.Then)
                        {
                            <li>@step</li>
                        }
                    </ol>
                </div>
            }
        </section>
    }
    else if (_workspace?.WorkspaceLoaded == true && _workflowReadiness is null)
    {
        <section class="db-next-step" aria-label="Recommended next step" data-testid="db-next-step">
            <p class="db-workspace-message" role="status">Working out the recommended next step…</p>
        </section>
    }

    @if (_workspace is { WorkspaceLoaded: true } || _workspace?.State == CurrentWorkspaceState.Error)
    {
        @* ══ 3 · What BirkNext found · 4 · Needs attention ══════════════════════ *@
        <div class="db-overview-grid">
            <section class="db-panel" aria-labelledby="db-found-heading" data-testid="db-found">
                <h2 id="db-found-heading" class="db-h2">Evidence inventory</h2>
                <p class="db-muted" data-testid="db-inventory-note">Inventory only — presence does not mean reviewed or verified.</p>
                @if (_found.Count == 0)
                {
                    <p class="db-muted">No project documents were found.</p>
                }
                else
                {
                    <ul class="db-found-list">
                        @foreach (var fact in _found)
                        {
                            <li data-testid="db-found-fact" data-key="@fact.Key">@fact.Text</li>
                        }
                    </ul>
                }
                @if (_workspace.Overview is { PackCount: > 0 } packOverview)
                {
                    <details class="db-details" data-testid="db-pack-list">
                        <summary>Show feature packs</summary>
                        <ul class="db-pack-list">
                            @foreach (var group in packOverview.Packs.GroupBy(p => p.Module))
                            {
                                <li>
                                    @if (packOverview.HasModules) { <span class="db-pack-module">@ArtifactModules.Label(group.Key)</span> }
                                    <ul>
                                        @foreach (var pack in group)
                                        {
                                            <li title="@pack.Pack">@pack.DisplayName <span class="db-muted">· @pack.RolesPresent.Count document type@(pack.RolesPresent.Count == 1 ? "" : "s")</span></li>
                                        }
                                    </ul>
                                </li>
                            }
                        </ul>
                    </details>
                }
                @if (_workflowReadiness?.Inputs.Source is { Status: ProjectInputStatus.Ready or ProjectInputStatus.NeedsAttention })
                {
                    <p class="db-muted db-source-link">Source analysis available · <a href="source-analysis">View technical evidence</a></p>
                }
            </section>

            <section class="db-panel" aria-labelledby="db-attention-heading" data-testid="db-attention">
                <h2 id="db-attention-heading" class="db-h2">Needs attention</h2>
                @if (_attention.Count == 0)
                {
                    <p class="db-muted" data-testid="db-attention-none">Nothing needs attention right now. Optional reviews that have not run are listed under Available next reviews.</p>
                }
                else
                {
                    <ul class="db-attention-list">
                        @foreach (var item in _attention)
                        {
                            <li class="db-attention-item @(item.Informational ? "is-info" : "is-attention")" data-testid="db-attention-item" data-key="@item.Key">
                                <span class="db-attention-kind">@(item.Informational ? "Note" : "Attention")</span>
                                <div class="db-attention-body">
                                    <span class="db-attention-text">@item.Text</span>
                                    @if (item.Detail is { Length: > 0 } detail) { <span class="db-attention-detail">@detail</span> }
                                    @if (item.Items is { Count: > 0 } where)
                                    {
                                        <details class="db-details">
                                            <summary>Details</summary>
                                            <ul class="db-detail-list">
                                                @foreach (var line in where) { <li>@line</li> }
                                            </ul>
                                        </details>
                                    }
                                </div>
                                <a href="@item.Href" class="db-attention-action" data-testid="db-attention-action">@item.ActionLabel</a>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>

        @* Available next reviews: not problems — optional reviews, applicable reviews, runtime reviews waiting for setup. *@
        @if (_nextReviews.Count > 0)
        {
            <section class="db-section" aria-labelledby="db-next-reviews-heading" data-testid="db-next-reviews">
                <h2 id="db-next-reviews-heading" class="db-h2">Available next reviews</h2>
                <ul class="db-attention-list">
                    @foreach (var item in _nextReviews)
                    {
                        <li class="db-attention-item is-info" data-testid="db-next-review" data-key="@item.Key">
                            <span class="db-attention-kind">Available</span>
                            <div class="db-attention-body"><span class="db-attention-text">@item.Text</span>@if (item.Detail is { Length: > 0 } d) { <span class="db-attention-detail">@d</span> }</div>
                            <a href="@item.Href" class="db-attention-action">@item.ActionLabel</a>
                        </li>
                    }
                </ul>
            </section>
        }

        @* ══ 5 · Review availability ════════════════════════════ *@
        <section class="db-section" aria-labelledby="db-readiness-heading" data-testid="db-review-readiness">
            <h2 id="db-readiness-heading" class="db-h2">Review availability</h2>
            <p class="db-section-lead">Shows whether required input exists for a review. Available does not mean reviewed, passed, verified or release-ready.</p>
            <ul class="db-readiness-list">
                @foreach (var row in _readiness)
                {
                    <li class="db-readiness-row" data-testid="db-readiness-row" data-key="@row.Key" data-status="@row.Status">
                        <span class="db-readiness-name">@row.Label</span>
                        <span class="db-pill is-@DashboardPresentation.Tone(row.Status)"><span aria-hidden="true">@DashboardPresentation.Icon(row.Status) </span>@row.StatusLabel</span>
                        <span class="db-readiness-text">@row.Text</span>
                    </li>
                }
            </ul>
        </section>
    }

    @* ══ 6 · Project Health ═══════════════════════════════════════════════════════ *@
    <section class="db-section" aria-labelledby="db-health-heading" data-testid="db-health">
        <h2 id="db-health-heading" class="db-h2">Assessment status</h2>
        @{
            var prominent = _health.Where(a => a.Prominent).ToList();
            var compact = _health.Where(a => !a.Prominent).ToList();
        }
        @if (prominent.Count > 0)
        {
            <div class="db-health-grid" aria-label="Project health areas with something to do or a result">
                @foreach (var area in prominent)
                {
                    <div class="db-health-card is-@DashboardPresentation.Tone(area.Status)" data-testid="db-health-area" data-key="@area.Key" data-status="@area.Status">
                        <h3 class="db-health-label">@area.Area</h3>
                        <span class="db-health-help">@area.Help</span>
                        <span class="db-pill is-@DashboardPresentation.Tone(area.Status)" data-testid="db-health-status"><span aria-hidden="true">@DashboardPresentation.Icon(area.Status) </span>@DashboardPresentation.Label(area.Status)</span>
                        @if (area.Result is { } result) { <span class="db-health-result" data-testid="db-health-result">@result</span> }
                        <span class="db-health-text">@area.Explanation</span>
                        @if (area.ActionLabel is { } action && area.Href is { } href) { <a href="@href" class="db-health-action">@action</a> }
                    </div>
                }
            </div>
        }
        @if (compact.Count > 0)
        {
            <ul class="db-health-rows" aria-label="Project health areas without results yet">
                @foreach (var area in compact)
                {
                    <li class="db-health-row" data-testid="db-health-area" data-key="@area.Key" data-status="@area.Status">
                        <span class="db-health-row-name">@area.Area <span class="db-health-help">@area.Help</span></span>
                        <span class="db-pill is-@DashboardPresentation.Tone(area.Status)" data-testid="db-health-status"><span aria-hidden="true">@DashboardPresentation.Icon(area.Status) </span>@DashboardPresentation.Label(area.Status)</span>
                        <span class="db-health-text">@area.Explanation</span>
                        @if (area.ActionLabel is { } action && area.Href is { } href) { <a href="@href" class="db-health-action">@action</a> }
                    </li>
                }
            </ul>
        }
    </section>

    @* ══ 7 · Project Artifacts ══════════════════════════════════════════════════
       Availability (from the current workspace's project-wide pack overview) and review decisions (the workflow's review gates) are
       separate facts: one primary status, the rest secondary. Files live under Details only. *@
    <section class="db-section" aria-labelledby="db-artifacts-heading">
        <h2 id="db-artifacts-heading" class="db-h2">Project Artifacts</h2>
        <div class="db-artifact-grid">
            @foreach (var role in CurrentWorkspaceSnapshot.WorkflowRoles)
            {
                var card = DashboardPresentation.Card(role, _workspace, _workflowReadiness?.ReviewFor(role), Analyzed(role), ReviewFacts(role));
                <div class="db-artifact-card is-@DashboardPresentation.Tone(card.Status)" data-testid="db-artifact-card" data-role="@role" data-status="@card.Status" data-availability="@(_workspace?.Role(role).Availability ?? ArtifactRoleAvailability.Missing)">
                    <h3 class="db-artifact-name">@card.Title</h3>
                    <span class="db-artifact-summary" data-testid="db-artifact-summary">@card.Summary</span>
                    <span class="db-pill is-@DashboardPresentation.Tone(card.Status)" data-testid="db-artifact-status"><span aria-hidden="true">@DashboardPresentation.Icon(card.Status) </span>@card.StatusLabel</span>
                    @if (card.Meta.Length > 0) { <span class="db-artifact-meta" data-testid="db-artifact-meta">@card.Meta</span> }
                    @if (_workflowReadiness?.ReviewFor(role) is { } review && card.Status != DashboardStatus.NotApplicable)
                    {
                        <span class="db-visually-hidden" data-testid="db-artifact-review" data-state="@review.State">@review.Label</span>
                    }
                    @foreach (var line in card.Attention)
                    {
                        <span class="db-artifact-attention" data-testid="db-artifact-attention"><span aria-hidden="true">! </span>@line</span>
                    }
                    <a href="@card.Href" class="db-artifact-action" data-testid="db-artifact-action">@card.ActionLabel</a>
                    @if (card.Files.Count > 0 || card.Provenance.Count > 0 || card.AttentionItems.Count > 0)
                    {
                        <details class="db-details db-artifact-details" data-testid="db-artifact-details">
                            <summary>Show files</summary>
                            @if (card.AttentionItems.Count > 0)
                            {
                                <ul class="db-detail-list">
                                    @foreach (var line in card.AttentionItems) { <li>@line</li> }
                                </ul>
                            }
                            @if (card.Files.Count > 0)
                            {
                                <ul class="db-detail-list db-file-list">
                                    @foreach (var file in card.Files) { <li>@file</li> }
                                    @if (card.MoreFiles > 0) { <li class="db-muted">+@card.MoreFiles more — open the explorer to see all</li> }
                                </ul>
                            }
                            @foreach (var line in card.Provenance) { <p class="db-provenance">@line</p> }
                        </details>
                    }
                </div>
            }
        </div>
    </section>

    @* ══ 8 · Test / release evidence (never the same as review readiness) ═══════ *@
    <section class="db-section" aria-labelledby="db-release-heading" data-testid="db-release-evidence">
        <h2 id="db-release-heading" class="db-h2">Test and release evidence</h2>
        @if (Snapshot.DeliveryReport is not null || Snapshot.ReadinessReport is not null)
        {
            <p class="db-section-lead">From the latest Document Quality Review readiness packs. Review readiness above is not a release decision.</p>
            <div class="db-readiness-grid">
                @ReadinessCard("Development", Snapshot.DeliveryReport?.DevelopmentDecision.State, Snapshot.DeliveryReport?.Health.DevelopmentScore, "quality/document")
                @ReadinessCard("Testing",     Snapshot.DeliveryReport?.TestingDecision.State,     Snapshot.DeliveryReport?.Health.TestingScore,     "quality/document")
                @ReadinessCard(Snapshot.DeliveryReport?.ReleaseSignificant == true ? "Release" : "Documentation gate (advisory)", Snapshot.DeliveryReport?.ReleaseDecision.State, Snapshot.DeliveryReport?.Health.ReleaseScore, "quality/document",
                    advisory: Snapshot.DeliveryReport?.ReleaseSignificant != true)
                @ReadinessCardScore("QA Readiness", Snapshot.ReadinessReport?.OverallScore, "quality/document")
            </div>
        }
        else
        {
            <div class="db-section-empty" data-testid="db-release-empty">
                No test or release evidence yet. It comes from reviews and testing — "Ready to review" above does not mean ready for release.
                <div class="db-empty-actions">
                    <a href="quality/document" class="db-qa-btn">Run Document Quality Review with readiness packs</a>
                </div>
            </div>
        }
    </section>

    @* ══ Top Risks: "no risks" only after an assessment ═══════════════════════ *@
    <section class="db-section" aria-labelledby="db-risks-heading" data-testid="db-risks" data-assessed="@(_risks.Assessed ? "true" : "false")">
        <h2 id="db-risks-heading" class="db-h2">Current review risks</h2>
        @{
            var topRisks = _topRisks.ToList();
        }
        @if (topRisks.Count > 0)
        {
            <p class="db-section-lead">@_risks.Message Showing the most severe.</p>
            <div class="issue-cards">
                @foreach (var (Title, Severity, Category, Detail) in topRisks)
                {
                    <IssueCard Severity="@Severity" Component="@Category" Description="@Title" SuggestedFix="@Detail" />
                }
            </div>
        }
        else
        {
            <div class="db-section-empty" data-testid="db-risks-message">
                @_risks.Message
                @if (!_risks.Assessed)
                {
                    <div class="db-empty-actions">
                        <a href="quality/document" class="db-qa-btn">Run Document Quality Review</a>
                    </div>
                }
            </div>
        }
    </section>

    @* ── Top Recommendations ────────────────────────────────────────────────── *@
    <section class="db-section" aria-label="Top recommendations">
        <h2 class="db-h2">Top Recommendations</h2>
        @{
            var topRecs = _topRecs.ToList();
        }
        @if (topRecs.Count > 0)
        {
            <div class="db-rec-cards">
                @{ int recIdx = 0; }
                @foreach (var (Text, Category, ActionHref) in topRecs)
                {
                    recIdx++;
                    <div class="db-rec-card">
                        <div class="db-rec-num" aria-hidden="true">@recIdx</div>
                        <div class="db-rec-body">
                            <div class="db-rec-text">@Text</div>
                            <div class="db-rec-footer">
                                <span class="db-rec-cat">@Category</span>
                                <a href="@ActionHref" class="db-rec-action">Open →</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="db-section-empty">
                No recommendations yet. Run Document Quality Review with the QA Auditor or Delivery Readiness pack to generate actionable recommendations.
            </div>
        }
    </section>

    @* ══ Advanced: review results by analysis, session activity and every tool. Secondary to the tester workflow above. ══ *@
    <section class="db-section db-zone-start" aria-labelledby="db-advanced-heading" data-testid="db-advanced">
        <h2 id="db-advanced-heading" class="db-h2">Analysis details</h2>
        <details class="db-advanced">
            <summary>Show results by analysis, recent activity and all tools</summary>
    @* ── Recent Activity ────────────────────────────────────────────────────── *@
    <section class="db-section">
        <SectionHeader Title="Recent Activity" />
        <div class="db-timeline">
            @{
                bool anyActivity = false;

                if (Snapshot.AuditReport is not null)
                {
                    anyActivity = true;
                    <div class="db-tl-entry">
                        <span class="db-tl-dot db-tl-dot-analyzed" aria-hidden="true"></span>
                        <div class="db-tl-body">
                            <span class="db-tl-action">Document Quality Review — QA Auditor completed</span>
                            <span class="db-tl-meta">@Snapshot.AuditReport.Health.TotalFindings finding@(Snapshot.AuditReport.Health.TotalFindings != 1 ? "s" : "")</span>
                        </div>
                    </div>
                }

                if (Snapshot.DeliveryReport is not null)
                {
                    anyActivity = true;
                    <div class="db-tl-entry">
                        <span class="db-tl-dot db-tl-dot-analyzed" aria-hidden="true"></span>
                        <div class="db-tl-body">
                            <span class="db-tl-action">Document Quality Review — Delivery Readiness completed</span>
                            <span class="db-tl-meta">@Snapshot.DeliveryReport.Health.OverallReadinessScore.ToString("0")% overall readiness</span>
                        </div>
                    </div>
                }

                if (Snapshot.TraceabilityReport is not null)
                {
                    anyActivity = true;
                    <div class="db-tl-entry">
                        <span class="db-tl-dot db-tl-dot-analyzed" aria-hidden="true"></span>
                        <div class="db-tl-body">
                            <span class="db-tl-action">Requirements Traceability completed</span>
                            <span class="db-tl-meta">@(Snapshot.TraceabilityReport.Health.HasAssessedCoverage ? $"{Snapshot.TraceabilityReport.Health.CoveragePercentage:0}% across assessed transitions" : "No transition coverage assessed")</span>
                        </div>
                    </div>
                }

                if (Snapshot.ComplianceReport is not null)
                {
                    anyActivity = true;
                    <div class="db-tl-entry">
                        <span class="db-tl-dot db-tl-dot-analyzed" aria-hidden="true"></span>
                        <div class="db-tl-body">
                            <span class="db-tl-action">Document Quality Review — Constitution Compliance completed</span>
                            <span class="db-tl-meta">@Snapshot.ComplianceReport.Coverage.CompliancePercentage.ToString("0")% compliant</span>
                        </div>
                    </div>
                }

                if (Snapshot.ReadinessReport is not null)
                {
                    anyActivity = true;
                    <div class="db-tl-entry">
                        <span class="db-tl-dot db-tl-dot-analyzed" aria-hidden="true"></span>
                        <div class="db-tl-body">
                            <span class="db-tl-action">Document Quality Review — QA Readiness completed</span>
                            <span class="db-tl-meta">@Snapshot.ReadinessReport.OverallScore.ToString("0")% overall</span>
                        </div>
                    </div>
                }

                if (_perfReport is not null)
                {
                    anyActivity = true;
                    <div class="db-tl-entry">
                        <span class="db-tl-dot db-tl-dot-perf" aria-hidden="true"></span>
                        <div class="db-tl-body">
                            <span class="db-tl-action">Performance Review completed</span>
                            <span class="db-tl-meta">@_perfReport.Assets.Count assets · @FormatBytes(_perfReport.Health.TotalTransferBytes) transfer</span>
                        </div>
                    </div>
                }

                if (!anyActivity)
                {
                    <div class="db-tl-empty">
                        No analyses have been run this session.
                    </div>
                }
            }
        </div>
    </section>

    @* ── Analysis Summary ───────────────────────────────────────────────────── *@
    <section class="db-section">
        <SectionHeader Title="Analysis Summary" Description="Run each analysis to populate" />
        <div class="db-analysis-grid">

            @* Requirements Traceability *@
            <div class="db-analysis-card">
                <div class="db-analysis-card-header">
                    <span class="db-analysis-card-title">Requirements Traceability</span>
                    <a href="artifact-traceability" class="db-summary-open" aria-label="Open Requirements Traceability">Open →</a>
                </div>
                @if (Snapshot.TraceabilityReport is { } tr)
                {
                    @if (tr.Health.HasAssessedCoverage)
                    {
                        <div class="db-analysis-score @ScoreClass(tr.Health.CoveragePercentage)">@tr.Health.CoveragePercentage.ToString("0")%</div>
                        <span class="db-analysis-status @KpiStatusClass(tr.Health.CoveragePercentage, true)">@KpiStatusLabel(tr.Health.CoveragePercentage, true) across assessed transitions</span>
                    }
                    else
                    {
                        <span class="db-analysis-status">Not assessed — no traceability transitions could be checked</span>
                    }
                    <div class="db-analysis-chips">
                        <span class="db-count-chip db-count-good">@tr.Health.CoveredCount covered</span>
                        @if (tr.Health.PartialCount > 0) { <span class="db-count-chip db-count-warn">@tr.Health.PartialCount partial</span> }
                        @if (tr.Health.MissingCount > 0) { <span class="db-count-chip db-count-poor">@tr.Health.MissingCount missing</span> }
                    </div>
                }
                else
                {
                    <div class="db-analysis-empty">
                        Not run — populate by running Requirements Traceability.
                        <a href="artifact-traceability" class="db-analysis-run-link">Run now →</a>
                    </div>
                }
            </div>

            @* Constitution Compliance *@
            <div class="db-analysis-card">
                <div class="db-analysis-card-header">
                    <span class="db-analysis-card-title">Constitution Compliance</span>
                    <a href="quality/document" class="db-summary-open" aria-label="Open Document Quality Review">Open →</a>
                </div>
                @if (Snapshot.ComplianceReport is { } cr)
                {
                    <div class="db-analysis-score @ScoreClass(cr.Coverage.CompliancePercentage)">@cr.Coverage.CompliancePercentage.ToString("0")%</div>
                    <span class="db-analysis-status @KpiStatusClass(cr.Coverage.CompliancePercentage, true)">@KpiStatusLabel(cr.Coverage.CompliancePercentage, true)</span>
                    <div class="db-analysis-chips">
                        <span class="db-count-chip db-count-good">@cr.Coverage.CompliantItems compliant</span>
                        @if (cr.Coverage.PartialItems > 0)  { <span class="db-count-chip db-count-warn">@cr.Coverage.PartialItems partial</span> }
                        @if (cr.Coverage.MissingItems > 0)  { <span class="db-count-chip db-count-poor">@cr.Coverage.MissingItems missing</span> }
                        @if (cr.Violations.Count > 0)        { <span class="db-count-chip db-count-poor">@cr.Violations.Count violations</span> }
                    </div>
                }
                else
                {
                    <div class="db-analysis-empty">
                        Not run — populate by running Document Quality Review.
                        <a href="quality/document" class="db-analysis-run-link">Run now →</a>
                    </div>
                }
            </div>

            @* QA Audit *@
            <div class="db-analysis-card">
                <div class="db-analysis-card-header">
                    <span class="db-analysis-card-title">QA Audit</span>
                    <a href="quality/document" class="db-summary-open" aria-label="Open Document Quality Review">Open →</a>
                </div>
                @if (Snapshot.AuditReport is { } ar)
                {
                    <div class="db-analysis-score @ScoreClass(ar.Health.AuditScore)">@ar.Health.AuditScore.ToString("0")</div>
                    <span class="db-analysis-status @KpiStatusClass(ar.Health.AuditScore, true)">@KpiStatusLabel(ar.Health.AuditScore, true)</span>
                    @if (_topAuditRiskTitle is not null)
                    {
                        <div class="db-analysis-finding">@_topAuditRiskTitle</div>
                    }
                    <div class="db-analysis-chips">
                        @if (ar.Health.CriticalCount > 0) { <span class="db-count-chip db-count-poor">@ar.Health.CriticalCount critical</span> }
                        @if (ar.Health.HighCount > 0)     { <span class="db-count-chip db-count-poor">@ar.Health.HighCount high</span> }
                        @if (ar.Health.MediumCount > 0)   { <span class="db-count-chip db-count-warn">@ar.Health.MediumCount medium</span> }
                        @if (ar.Health.CriticalCount == 0 && ar.Health.HighCount == 0)
                        { <span class="db-count-chip db-count-good">No critical findings</span> }
                    </div>
                }
                else
                {
                    <div class="db-analysis-empty">
                        Not run — populate by running Document Quality Review.
                        <a href="quality/document" class="db-analysis-run-link">Run now →</a>
                    </div>
                }
            </div>

            @* Delivery Readiness *@
            <div class="db-analysis-card">
                <div class="db-analysis-card-header">
                    <span class="db-analysis-card-title">Delivery Readiness</span>
                    <a href="quality/document" class="db-summary-open" aria-label="Open Document Quality Review">Open →</a>
                </div>
                @if (Snapshot.DeliveryReport is { } dr)
                {
                    <div class="db-analysis-score @ScoreClass(dr.Health.OverallReadinessScore)">@dr.Health.OverallReadinessScore.ToString("0")%</div>
                    <span class="db-analysis-status @ReadinessStatusClass(dr.DevelopmentDecision.State)">@ReadinessStateLabel(dr.DevelopmentDecision.State)</span>
                    @if (_topBlockerTitle is not null)
                    {
                        <div class="db-analysis-finding">@_topBlockerTitle</div>
                    }
                    <div class="db-analysis-chips">
                        <span class="db-count-chip @(dr.DevelopmentDecision.State == ReadinessState.Ready ? "db-count-good" : dr.DevelopmentDecision.State == ReadinessState.MostlyReady ? "db-count-warn" : "db-count-poor")">Dev</span>
                        <span class="db-count-chip @(dr.TestingDecision.State     == ReadinessState.Ready ? "db-count-good" : dr.TestingDecision.State     == ReadinessState.MostlyReady ? "db-count-warn" : "db-count-poor")">Test</span>
                        <span class="db-count-chip @(dr.ReleaseDecision.State     == ReadinessState.Ready ? "db-count-good" : dr.ReleaseDecision.State     == ReadinessState.MostlyReady ? "db-count-warn" : "db-count-poor")">@(dr.ReleaseSignificant ? "Release" : "Doc gate")</span>
                    </div>
                }
                else
                {
                    <div class="db-analysis-empty">
                        Not run — populate by running Document Quality Review.
                        <a href="quality/document" class="db-analysis-run-link">Run now →</a>
                    </div>
                }
            </div>

            @* Frontend Quality Review *@
            <div class="db-analysis-card">
                <div class="db-analysis-card-header">
                    <span class="db-analysis-card-title">Frontend Quality Review</span>
                    <a href="frontend-quality-review" class="db-summary-open" aria-label="Open Frontend Quality Review">Open →</a>
                </div>
                @if (_fqrReport is { } fqrCard)
                {
                    @if (fqrCard.OverallScore.HasValue)
                    {
                        <div class="db-analysis-score @ScoreClass(fqrCard.OverallScore.Value)">@fqrCard.OverallScore.Value</div>
                        <span class="db-analysis-status @KpiStatusClass(fqrCard.OverallScore.Value, true)">@KpiStatusLabel(fqrCard.OverallScore.Value, true)</span>
                    }
                    else
                    {
                        <span class="db-analysis-status">Partial assessment — no overall score</span>
                    }
                    @if (fqrCard.Findings.OrderBy(f => f.Severity).FirstOrDefault() is { } topFqrFinding)
                    {
                        <div class="db-analysis-finding">@topFqrFinding.Title</div>
                    }
                    <div class="db-analysis-chips">
                        @{ var fqrCritical = fqrCard.Findings.Count(f => f.Severity == FrontendQualitySeverity.Critical); }
                        @{ var fqrHigh     = fqrCard.Findings.Count(f => f.Severity == FrontendQualitySeverity.High); }
                        @if (fqrCritical > 0) { <span class="db-count-chip db-count-poor">@fqrCritical critical</span> }
                        @if (fqrHigh > 0)     { <span class="db-count-chip db-count-poor">@fqrHigh high</span> }
                        @if (fqrCritical == 0 && fqrHigh == 0)
                        { <span class="db-count-chip db-count-good">No critical findings</span> }
                    </div>
                }
                else if (RuntimeReviews.QualityReview.Status != RuntimeReviewStatus.NotRun)
                {
                    <span class="db-analysis-status @RuntimeStatusClass(RuntimeReviews.QualityReview.Status)">@RuntimeStatusLabel(RuntimeReviews.QualityReview.Status)</span>
                    @if (RuntimeReviews.QualityReview.ErrorMessage is not null)
                    {
                        <div class="db-analysis-finding">@RuntimeReviews.QualityReview.ErrorMessage</div>
                    }
                }
                else
                {
                    <div class="db-analysis-empty">
                        Not run — analyse performance, security, accessibility, standards, and readiness in one review.
                        <a href="frontend-quality-review" class="db-analysis-run-link">Run now →</a>
                    </div>
                }
            </div>

            @* API Quality Review *@
            <div class="db-analysis-card">
                <div class="db-analysis-card-header">
                    <span class="db-analysis-card-title">API Quality Review</span>
                    <a href="api-quality-review" class="db-summary-open" aria-label="Open API Quality Review">Open →</a>
                </div>
                @if (_aqrReport is { } aqrCard)
                {
                    var aqrCompleted = aqrCard.Targets.Count(t => t.Status == BirkNext.ApiReview.ApiReviewTargetStatus.Completed);
                    var aqrBlocked = aqrCard.Targets.Count(t => t.Status == BirkNext.ApiReview.ApiReviewTargetStatus.Blocked);
                    <div class="db-analysis-score">@aqrCompleted/@aqrCard.Targets.Count</div>
                    <span class="db-analysis-status @(aqrBlocked > 0 ? "db-status-warn" : "db-status-ok")">@(aqrBlocked > 0 ? $"{aqrBlocked} target(s) blocked" : "API targets reviewed")</span>
                    @if (aqrCard.Findings.OrderBy(f => f.Severity).FirstOrDefault() is { } topAqrFinding)
                    {
                        <div class="db-analysis-finding">@topAqrFinding.Title</div>
                    }
                    <div class="db-analysis-chips">
                        @{ var aqrCritical = aqrCard.Findings.Count(f => f.Severity == BirkNext.ApiReview.ApiReviewSeverity.Critical); }
                        @{ var aqrHigh     = aqrCard.Findings.Count(f => f.Severity == BirkNext.ApiReview.ApiReviewSeverity.High); }
                        @if (aqrCritical > 0) { <span class="db-count-chip db-count-poor">@aqrCritical critical</span> }
                        @if (aqrHigh > 0)     { <span class="db-count-chip db-count-poor">@aqrHigh high</span> }
                        @if (aqrCritical == 0 && aqrHigh == 0)
                        { <span class="db-count-chip db-count-good">@(aqrCard.AnyCompleted ? "No high findings" : "Not assessed")</span> }
                    </div>
                }
                else if (RuntimeReviews.ApiQualityReview.Status != RuntimeReviewStatus.NotRun)
                {
                    <span class="db-analysis-status @RuntimeStatusClass(RuntimeReviews.ApiQualityReview.Status)">@RuntimeStatusLabel(RuntimeReviews.ApiQualityReview.Status)</span>
                    @if (RuntimeReviews.ApiQualityReview.ErrorMessage is not null)
                    {
                        <div class="db-analysis-finding">@RuntimeReviews.ApiQualityReview.ErrorMessage</div>
                    }
                }
                else
                {
                    <div class="db-analysis-empty">
                        Not run — analyse connectivity, security, performance, REST, GraphQL, OpenAPI, and readiness.
                        <a href="api-quality-review" class="db-analysis-run-link">Run now →</a>
                    </div>
                }
            </div>

            @* Integration Quality Review *@
            <div class="db-analysis-card">
                <div class="db-analysis-card-header">
                    <span class="db-analysis-card-title">Integration Quality Review</span>
                    <a href="integration-quality-review" class="db-summary-open" aria-label="Open Integration Quality Review">Open →</a>
                </div>
                @if (_iqrReport is { } iqrCard)
                {
                    @* The review has no score by design: outcome, domain coverage and findings, never "healthy". *@
                    <span class="db-analysis-status" data-testid="db-iqr-outcome">@BirkNext.Integrations.IntegrationReviewLabels.Outcome(iqrCard.Outcome)</span>
                    @if (iqrCard.Findings.OrderBy(f => f.Severity).FirstOrDefault() is { } topIqrFinding)
                    {
                        <div class="db-analysis-finding">@topIqrFinding.Title</div>
                    }
                    <div class="db-analysis-chips">
                        @{ var iqrHighOrWorse = iqrCard.Findings.Count(f => f.Severity is BirkNext.Integrations.IntegrationFindingSeverityV2.Critical or BirkNext.Integrations.IntegrationFindingSeverityV2.High); }
                        @if (iqrHighOrWorse > 0) { <span class="db-count-chip db-count-poor">@iqrHighOrWorse high or critical</span> }
                        <span class="db-count-chip" data-testid="db-iqr-coverage">@iqrCard.Domains.Count(d => d.ChecksAssessed > 0)/@iqrCard.Domains.Count domains assessed</span>
                        <span class="db-count-chip">@iqrCard.TopicsReviewed topics</span>
                    </div>
                }
                else if (RuntimeReviews.IntegrationQualityReview.Status != RuntimeReviewStatus.NotRun)
                {
                    <span class="db-analysis-status @RuntimeStatusClass(RuntimeReviews.IntegrationQualityReview.Status)">@RuntimeStatusLabel(RuntimeReviews.IntegrationQualityReview.Status)</span>
                    @if (RuntimeReviews.IntegrationQualityReview.ErrorMessage is not null)
                    {
                        <div class="db-analysis-finding">@RuntimeReviews.IntegrationQualityReview.ErrorMessage</div>
                    }
                }
                else
                {
                    <div class="db-analysis-empty">
                        Not run — analyse configured service integrations, health checks, ownership, and readiness.
                        <a href="integration-quality-review" class="db-analysis-run-link">Run now →</a>
                    </div>
                }
            </div>

            </div>
    </section>

    @* ── Quick Actions ───────────────────────────────────────────────────────── *@
    <section class="db-section">
        <SectionHeader Title="Quick Actions" />
        <div class="db-quick-actions">
            <div class="db-qa-group">
                <div class="db-qa-group-label">Review</div>
                <div class="db-qa-buttons">
                    <a href="constitution-explorer"  class="db-qa-btn">Constitution Explorer</a>
                    <a href="specification-explorer" class="db-qa-btn">Specification Explorer</a>
                    <a href="plan-explorer"          class="db-qa-btn">Plan Explorer</a>
                    <a href="task-explorer"          class="db-qa-btn">Task Explorer</a>
                </div>
            </div>
            <div class="db-qa-group">
                <div class="db-qa-group-label">Analysis</div>
                <div class="db-qa-buttons">
                    <a href="artifact-traceability"   class="db-qa-btn">Requirements Traceability</a>
                    <a href="quality/document"          class="db-qa-btn">Document Quality Review</a>
                    <a href="frontend-quality-review"  class="db-qa-btn">Frontend Quality Review</a>
                    <a href="api-quality-review"       class="db-qa-btn">API Quality Review</a>
                    <a href="integration-quality-review" class="db-qa-btn">Integration Quality Review</a>
                </div>
            </div>
            <div class="db-qa-group">
                <div class="db-qa-group-label">AI</div>
                <div class="db-qa-buttons">
                    <a href="ai-change-auditor" class="db-qa-btn">AI Change Review</a>
                </div>
            </div>
        </div>
    </section>
        </details>
    </section>

@code {
    // ── Workspace status ──────────────────────────────────────────────────────

    /// <summary>The current workspace (null while it loads). Every presence fact on this page comes from it.</summary>
    private CurrentWorkspaceSnapshot? _workspace;

    protected override void OnInitialized()
    {
        CurrentWorkspace.Changed += OnWorkspaceChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await RefreshWorkspaceAsync();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error initializing Dashboard: {ex.Message}");
        }
    }

    private void OnWorkspaceChanged() => _ = InvokeAsync(RefreshWorkspaceAsync);

    private async Task RefreshWorkspaceAsync()
    {
        _workspace = await CurrentWorkspace.GetAsync();
        StateHasChanged();
        await RefreshWorkflowReadinessAsync();
    }

    public void Dispose() => CurrentWorkspace.Changed -= OnWorkspaceChanged;

    private bool Available(WorkspaceArtifactType role) => _workspace?.Has(role) == true;

    // ── Tester-facing projection: every value from shared state, none invented here ─────────────────────────────

    private (DashboardStatus Status, string Text) _environment => DashboardPresentation.TestEnvironment(_workflowReadiness);
    private DashboardNextStep? _nextStep => _workspace is null ? null : DashboardPresentation.NextStep(_workspace, _workflowReadiness);
    private IReadOnlyList<DashboardFoundFact> _found => _workspace is null ? [] : DashboardPresentation.Found(_workspace, _workflowReadiness);
    private IReadOnlyList<DashboardAttentionItem> _attention => _workspace is null ? [] : DashboardPresentation.NeedsAttention(_workspace, _workflowReadiness, _reviews);
    private IReadOnlyList<DashboardAttentionItem> _nextReviews => _workspace is null ? [] : DashboardPresentation.AvailableNextReviews(_workspace, _workflowReadiness, _reviews);
    private IReadOnlyList<DashboardReadinessRow> _readiness => _workspace is null ? [] : DashboardPresentation.ReviewReadiness(_workspace, _workflowReadiness, _reviews);
    private IReadOnlyList<DashboardHealthArea> _health => DashboardPresentation.Health(_workspace, _workflowReadiness, _reviews);
    private DashboardRiskState _risks => DashboardPresentation.Risks(_reviews);

    /// <summary>Anything reviewed or tested: a session result or a recorded review decision. Import alone is never a review.</summary>
    private bool _anythingReviewed => _hasAnySnapshot
        || _workflowReadiness?.DocumentReviewGates.Select(ArtifactReviewPresentation.Of).Any(r => r.IsDecided || r.State == ArtifactReviewState.Stale) == true;

    /// <summary>This session's review results, as the presentation reads them.</summary>
    private DashboardReviewFacts _reviews => new()
    {
        DocumentReview = QualitySession.Status,
        DocumentReviewAt = QualitySession.RunTimestamp,
        DocumentReviewFindings = QualitySession.Report?.TotalFindings ?? 0,
        DocumentReviewSevere = QualitySession.Report is { } dqr ? dqr.CriticalCount + dqr.HighCount : 0,
        DocumentReviewScope = DocumentReviewScope(),
        QaAssessed = _qaAssessed,
        QaScore = _qaScore,
        TraceabilityRun = Snapshot.TraceabilityReport is not null,
        TraceabilityCoverage = Snapshot.TraceabilityReport is { Health.HasAssessedCoverage: true } tr ? tr.Health.CoveragePercentage : null,
        ComplianceRun = Snapshot.ComplianceReport is not null,
        ComplianceScore = _complianceScore,
        DeliveryRun = Snapshot.DeliveryReport is not null,
        DevelopmentDecision = Snapshot.DeliveryReport?.DevelopmentDecision.State,
        TestingDecision = Snapshot.DeliveryReport?.TestingDecision.State,
        ReleaseDecision = Snapshot.DeliveryReport?.ReleaseDecision.State,
        ReleaseSignificant = Snapshot.DeliveryReport?.ReleaseSignificant ?? false,
        RisksAssessed = Snapshot.AuditReport is not null || Snapshot.DeliveryReport is not null,
        RiskCount = (Snapshot.AuditReport?.Risks.Count ?? 0) + (Snapshot.DeliveryReport?.Blockers.Count ?? 0),
        Performance = RuntimeReviews.PerformanceReview.Status,
        PerformanceScore = _perfReport?.ReadinessReport is { HasData: true, OverallScore: { } perfScore } ? perfScore : null,
        PerformanceState = _perfReport?.ReadinessReport?.OverallState,
        RuntimeEvidence = RuntimeReviews.PerformanceReview.HasResult || RuntimeReviews.SecurityReview.HasResult || RuntimeReviews.QualityReview.HasResult
                          || RuntimeReviews.ApiQualityReview.HasResult || RuntimeReviews.IntegrationQualityReview.HasResult,
    };

    /// <summary>"pack Revision System (001-x) · module Person": what the latest Document Quality Review read, from its recorded inputs.</summary>
    private string? DocumentReviewScope()
    {
        var inputs = QualitySession.ReviewInputs;
        if (inputs.Count == 0) return null;
        var pack = inputs.Select(i => i.Pack).FirstOrDefault(p => p is not null);
        var module = inputs.Select(i => i.Module).FirstOrDefault(m => m is not null);
        var summary = pack is null ? null : _workspace?.Overview?.Packs.FirstOrDefault(p => p.Pack == pack && (module is null || p.Module == module));
        var parts = new List<string>();
        if (pack is not null) parts.Add($"pack {(summary is null ? pack : ProjectPackOverview.PackName(summary))}");
        if (module is not null) parts.Add($"module {ArtifactModules.Label(module)}");
        return parts.Count == 0 ? null : string.Join(" · ", parts);
    }

    private bool Analyzed(WorkspaceArtifactType role) => role switch
    {
        WorkspaceArtifactType.Constitution => _constitutionAnalyzed,
        WorkspaceArtifactType.Specification => _specAnalyzed,
        WorkspaceArtifactType.Plan => _planAnalyzed,
        WorkspaceArtifactType.Tasks => _tasksAnalyzed,
        _ => _dataModelAnalyzed,
    };

    /// <summary>Facts from this session's review reports for a document type (requirements, phases, tasks, rules). Only after a review ran.</summary>
    private IReadOnlyList<string>? ReviewFacts(WorkspaceArtifactType role) => role switch
    {
        WorkspaceArtifactType.Constitution when Snapshot.ComplianceReport is { HasConstitution: true } cr => [$"{cr.Coverage.TotalItems} rules checked"],
        WorkspaceArtifactType.Specification when Snapshot.TraceabilityReport is { Health.TotalRequirements: > 0 } st =>
            [$"{st.Health.TotalRequirements} requirements", st.HasPlan && st.SpecificationCoverage.HasApplicablePopulation ? $"{st.SpecificationCoverage.CoveragePercentage:0}% covered by the plan" : "Plan coverage not assessed"],
        WorkspaceArtifactType.Plan when Snapshot.TraceabilityReport is { HasPlan: true } pt =>
            [$"{pt.Health.TotalPlanItems} plan phases", pt.HasTasks && pt.PlanCoverage.HasApplicablePopulation ? $"{pt.PlanCoverage.CoveredItems} of {pt.PlanCoverage.TotalItems} align with task phases" : "Task alignment not assessed"],
        WorkspaceArtifactType.Tasks when Snapshot.TraceabilityReport is { Health.TotalTasks: > 0 } tt =>
            [$"{tt.Health.TotalTasks} tasks", tt.HasSpecification && tt.TaskCoverage.HasApplicablePopulation ? $"{tt.TaskCoverage.CoveredItems} of {tt.TaskCoverage.TotalItems} reference requirements" : "Requirement references not assessed"],
        _ => null,
    };

    // ── Workflow readiness ────────────────────────────────────────────────────

    private WorkflowReadiness? _workflowReadiness;

    private async Task RefreshWorkflowReadinessAsync()
    {
        try
        {
            _workflowReadiness = await WorkflowReadiness.GetReadinessAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading workflow readiness: {ex.Message}");
        }
    }

    // ── Runtime review session ────────────────────────────────────────────────

    private WasmSecurityReviewReport?    _securityReport => RuntimeReviews.SecurityReview.Report;
    private WasmPerformanceReviewReport? _perfReport     => RuntimeReviews.PerformanceReview.Report;
    private FrontendQualityReviewReport? _fqrReport      => RuntimeReviews.QualityReview.Report;
    private BirkNext.ApiReview.ApiReviewReport? _aqrReport => RuntimeReviews.ApiQualityReview.Report;
    private BirkNext.Integrations.IntegrationReviewResult? _iqrReport => RuntimeReviews.IntegrationQualityReview.Report;

    // ── Snapshot aliases ──────────────────────────────────────────────────────

    private bool _hasAnySnapshot =>
        Snapshot.TraceabilityReport is not null ||
        Snapshot.ComplianceReport   is not null ||
        Snapshot.AuditReport        is not null ||
        Snapshot.DeliveryReport     is not null ||
        Snapshot.ReadinessReport    is not null ||
        QualitySession.Status       != AnalysisSessionStatus.NotRun ||
        RuntimeReviews.SecurityReview.HasResult ||
        RuntimeReviews.PerformanceReview.HasResult ||
        RuntimeReviews.QualityReview.HasResult ||
        RuntimeReviews.ApiQualityReview.HasResult ||
        RuntimeReviews.IntegrationQualityReview.HasResult;

    // While the workspace loads it is not "no workspace": the onboarding card waits for the snapshot.
    private bool _hasAnyWorkspace =>
        _workspace is null || _workspace.State != CurrentWorkspaceState.NoWorkspace;

    // ── Artifact loaded / analyzed ────────────────────────────────────────────

    private bool _constitutionAnalyzed =>
        Snapshot.TraceabilityReport?.HasConstitution == true ||
        Snapshot.ComplianceReport?.HasConstitution == true ||
        Snapshot.AuditReport?.HasConstitution == true ||
        Snapshot.DeliveryReport?.HasConstitution == true ||
        Snapshot.ReadinessReport?.HasConstitution == true;

    private bool _specAnalyzed =>
        Snapshot.TraceabilityReport?.HasSpecification == true ||
        Snapshot.ComplianceReport?.HasSpecification == true ||
        Snapshot.AuditReport?.HasSpecification == true ||
        Snapshot.ReadinessReport?.HasSpecification == true;

    private bool _planAnalyzed =>
        Snapshot.TraceabilityReport?.HasPlan == true ||
        Snapshot.ComplianceReport?.HasPlan == true ||
        Snapshot.AuditReport?.HasPlan == true ||
        Snapshot.DeliveryReport?.HasPlan == true ||
        Snapshot.ReadinessReport?.HasPlan == true;

    private bool _tasksAnalyzed =>
        Snapshot.TraceabilityReport?.HasTasks == true ||
        Snapshot.AuditReport?.HasTasks == true ||
        Snapshot.DeliveryReport?.HasTasks == true ||
        Snapshot.ReadinessReport?.HasTasks == true;

    private bool _dataModelAnalyzed =>
        false;  // Data Model analysis not yet integrated into report system

    // ── Pre-computed health scores (numeric) ──────────────────────────────────

    private bool _traceabilityHasData => Snapshot.TraceabilityReport is not null;
    private double _traceabilityScore => Snapshot.TraceabilityReport is { } tr
        ? tr.Health.CoveragePercentage
        : 0;

    private bool _complianceHasData => Snapshot.ComplianceReport is not null;
    private double _complianceScore => Snapshot.ComplianceReport?.Health.CompliancePercentage ?? 0;

    private bool _qaHasData => QualitySession.HasResult || Snapshot.AuditReport is not null || Snapshot.ReadinessReport is not null;
    private double _qaScore => QualitySession.Report is { } report
        ? report.OverallScore
        : Snapshot.AuditReport is { } ar
            ? ar.Health.AuditScore
            : Snapshot.ReadinessReport?.OverallScore ?? 0;

    private bool _deliveryHasData => Snapshot.DeliveryReport is not null;
    private double _deliveryScore => Snapshot.DeliveryReport?.Health.OverallReadinessScore ?? 0;

    // ── Overall health ────────────────────────────────────────────────────────

    /// <summary>A QA result only counts as assessed when there was a specification to assess. A report built without one (insufficient
    /// data) scores 0 by construction — that is missing evidence, not low quality, so it never enters the quality average.</summary>
    private bool _qaAssessed => DashboardQualityAggregate.QaAssessed(_qaHasData, QualitySession.HasResult,
        Available(WorkspaceArtifactType.Specification) && (QualitySession.Report is not { AssessedPacks: 0 }),
        Snapshot.AuditReport?.HasSpecification, Snapshot.ReadinessReport?.HasSpecification);

    /// <summary>The six dashboard quality areas: (assessed?, score). Not-assessed areas lower coverage, never quality.</summary>
    private IReadOnlyList<(bool Assessed, double Score)> _qualityAreas =>
    [
        (Snapshot.TraceabilityReport is not null, _traceabilityScore),
        (Snapshot.ComplianceReport is not null, _complianceScore),
        (_qaAssessed, _qaScore),
        (Snapshot.DeliveryReport is not null, _deliveryScore),
        (_securityReport?.Health.Score is not null, _securityReport?.Health.Score ?? 0),
        (_perfReport?.ReadinessReport is { HasData: true, OverallScore: not null }, _perfReport?.ReadinessReport?.OverallScore ?? 0),
    ];

    /// <summary>Quality among assessed areas only (the denominator is the assessed count). There is no global score over unassessed areas.</summary>
    private DashboardQualityAggregate.Result _quality => DashboardQualityAggregate.Compute(_qualityAreas);

    private double _overallScore => _quality.Quality ?? 0;

    private bool _hasAnyScore => _quality.Quality is not null;

    private string _assessmentCoverageLabel => _quality.CoverageLabel;

    private string _overallScoreLabel => "Quality status for assessed areas only: " + (_overallScore >= 80 ? "Healthy" : _overallScore >= 50 ? "Needs Attention" : "At Risk");

    // ── Top risks ─────────────────────────────────────────────────────────────

    private IEnumerable<(string Title, string Severity, string Category, string? Detail)> _topRisks
    {
        get
        {
            var list = new List<(string, string, string, string?)>();
            if (Snapshot.AuditReport is { } ar)
                list.AddRange(ar.Risks
                    .OrderBy(r => r.Severity)
                    .Take(3)
                    .Select(r => (r.Title, r.Severity.ToString(), r.Category.ToString(), r.Mitigation)));
            if (list.Count < 3 && Snapshot.DeliveryReport is { } dr)
                list.AddRange(dr.Blockers
                    .OrderBy(b => b.Severity)
                    .Take(3 - list.Count)
                    .Select(b => (b.Title, b.Severity.ToString(), b.Category, (string?)b.Description)));
            return list.Take(3);
        }
    }

    // ── Top recommendations ───────────────────────────────────────────────────

    private IEnumerable<(string Text, string Category, string ActionHref)> _topRecs
    {
        get
        {
            var list = new List<(string, string, string)>();
            if (Snapshot.AuditReport is { } ar)
                list.AddRange(ar.Recommendations
                    .OrderBy(r => r.Priority)
                    .Take(3)
                    .Select(r => (r.Text, r.Category.ToString(), "quality/document")));
            if (list.Count < 3 && Snapshot.DeliveryReport is { } dr)
                list.AddRange(dr.Recommendations
                    .OrderBy(r => r.Priority)
                    .Take(3 - list.Count)
                    .Select(r => (r.Text, r.Category, "quality/document")));
            return list.Take(3);
        }
    }

    // ── Top findings for analysis cards ──────────────────────────────────────

    private string? _topAuditRiskTitle =>
        Snapshot.AuditReport?.Risks?.OrderBy(r => r.Severity).FirstOrDefault()?.Title;

    private string? _topBlockerTitle =>
        Snapshot.DeliveryReport?.Blockers?.OrderBy(b => b.Severity).FirstOrDefault()?.Title;

    // ── Render helpers ────────────────────────────────────────────────────────

    private static string ScoreClass(double score) =>
        score >= 80 ? "db-val-good" : score >= 50 ? "db-val-warn" : "db-val-poor";

    private static string KpiStatusClass(double score, bool hasData) =>
        !hasData ? "db-status-notrun" :
        score >= 80 ? "db-status-healthy" :
        score >= 50 ? "db-status-warning" : "db-status-critical";

    private static string KpiStatusLabel(double score, bool hasData) =>
        !hasData ? "Not Run" :
        score >= 80 ? "Healthy" :
        score >= 50 ? "Warning" : "Critical";

    private static string RuntimeStatusLabel(RuntimeReviewStatus status) => status switch
    {
        RuntimeReviewStatus.Running   => "Running",
        RuntimeReviewStatus.Completed => "Completed",
        RuntimeReviewStatus.Failed    => "Failed",
        _                             => "Not Run",
    };

    private static string RuntimeStatusClass(RuntimeReviewStatus status) => status switch
    {
        RuntimeReviewStatus.Running   => "db-status-warning",
        RuntimeReviewStatus.Completed => "db-status-healthy",
        RuntimeReviewStatus.Failed    => "db-status-critical",
        _                             => "db-status-notrun",
    };

    private static string ReadinessStatusClass(ReadinessState state) => state switch
    {
        ReadinessState.Ready       => "db-status-healthy",
        ReadinessState.MostlyReady => "db-status-warning",
        ReadinessState.Blocked     => "db-status-critical",
        _                          => "db-status-critical",
    };

    private static string ReadinessStateLabel(ReadinessState state) => state switch
    {
        ReadinessState.Ready       => "Ready",
        ReadinessState.MostlyReady => "Mostly Ready",
        ReadinessState.NotReady    => "Not Ready",
        ReadinessState.Blocked     => "Blocked",
        _                          => "Not assessed",
    };

    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0)        return "0 B";
        if (bytes < 1_024)     return $"{bytes} B";
        if (bytes < 1_048_576) return $"{bytes / 1024} KB";
        return $"{bytes / 1_048_576.0:F1} MB";
    }

    // ── RenderFragment helpers ────────────────────────────────────────────────

    private RenderFragment ReadinessCard(string label, ReadinessState? state, double? score, string href, bool advisory = false) => __builder =>
    {
        <div class="db-readiness-card">
            <div class="db-readiness-label">@label</div>
            @if (state.HasValue && score.HasValue)
            {
                <div class="db-readiness-score @ScoreClass(score.Value)">@score.Value.ToString("0")%</div>
                @* An advisory documentation gate never reads as a blocked product release. *@
                <div class="db-readiness-state @(advisory ? (state.Value == ReadinessState.Ready ? ReadinessStatusClass(state.Value) : ReadinessStatusClass(ReadinessState.MostlyReady)) : ReadinessStatusClass(state.Value))">@(advisory ? DocumentationGate.StateLabel(state.Value, false) : ReadinessStateLabel(state.Value))</div>
            }
            else
            {
                <div class="db-readiness-state db-status-notrun">Not assessed</div>
            }
            <a href="@href" class="db-readiness-link">Open →</a>
        </div>
    };

    private RenderFragment ReadinessCardScore(string label, double? score, string href) => __builder =>
    {
        <div class="db-readiness-card">
            <div class="db-readiness-label">@label</div>
            @if (score.HasValue)
            {
                <div class="db-readiness-score @ScoreClass(score.Value)">@score.Value.ToString("0")%</div>
                <div class="db-readiness-state @KpiStatusClass(score.Value, true)">@KpiStatusLabel(score.Value, true)</div>
            }
            else
            {
                <div class="db-readiness-state db-status-notrun">Not assessed</div>
            }
            <a href="@href" class="db-readiness-link">Open →</a>
        </div>
    };

    // ── Actions ───────────────────────────────────────────────────────────────

    private async Task ExportHtml()
    {
        if (!_hasAnySnapshot) return;
        var html = ExportService.ExportDashboardSummary(
            Workspace.ProjectName,
            Snapshot.TraceabilityReport,
            Snapshot.ComplianceReport,
            Snapshot.AuditReport,
            Snapshot.DeliveryReport,
            Snapshot.ReadinessReport,
            _perfReport,
            _iqrReport);
        await JS.InvokeVoidAsync("downloadHtmlFile", $"dashboard-summary-{DateTime.UtcNow:yyyy-MM-dd}.html", html);
    }

    // ── Data loading ──────────────────────────────────────────────────────────


    [SupplyParameterFromQuery(Name = "reset")] public string? ResetQuery { get; set; }

    /// <summary>One-time notice after a local data reset (System Settings, or another tab that reset local data).</summary>
    private (string Title, string Text, bool Warn)? ResetNotice => ResetQuery switch
    {
        "done" => ("Local data reset completed.", "Project and workspace state was cleared; installation settings were preserved. No project is loaded.", false),
        "warnings" => ("Local data reset completed with warnings.", "The database was cleared, but some browser or session state could not be cleared. Reload BirkNext to finish.", true),
        "stale" => ("Local data was reset in another tab.", "This tab's previous project state was discarded and not saved. No project is loaded.", true),
        _ => null,
    };
}
