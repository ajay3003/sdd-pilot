@page "/dashboard"
@using BirkNext.Web.Components
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using BirkNext.Web.Services.Explorers
@inject IDashboardSnapshotService Snapshot
@inject RuntimeReviewSessionService RuntimeReviews
@inject QualityReviewSessionService QualitySession
@inject IWorkspaceSessionService Workspace
@inject ICurrentWorkspaceProjection CurrentWorkspace
@inject IReportExportService ExportService
@inject IWorkflowReadinessService WorkflowReadiness
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Dashboard</PageTitle>

@if (ResetNotice is { } notice)
{
    <div class="notification @(notice.Warn ? "notification-warning" : "notification-success")" role="status" data-testid="reset-notice">
        <strong>@notice.Title</strong> @notice.Text
    </div>
}

@* ── Onboarding ───────────────────────────────────────────────────────────── *@
@if (!_hasAnyWorkspace && !_hasAnySnapshot)
{
    <div class="dashboard-onboarding-card" data-testid="onboarding-card">
        <div class="dashboard-onboarding-text">
            <strong>New to QA Review Studio?</strong>
            <span>Follow the recommended workflow to get started with the platform phase by phase.</span>
        </div>
        <a href="getting-started" class="btn-primary dashboard-onboarding-btn">Start Recommended Workflow</a>
    </div>
}

    <PageHeader Title="SDD Governance Dashboard">
        <StatusChip Status="neutral" Label="@_projectPhase" />
        @if (_hasAnyScore)
        {
            <StatusChip Status="@(_overallScore >= 80 ? "healthy" : _overallScore >= 50 ? "warning" : "critical")"
                        Label="@_overallScoreLabel" />
            <span class="db-assessment-coverage" data-testid="db-assessment-coverage" title="Quality is averaged over assessed areas only. Areas without evidence are coverage gaps, not low quality.">@_assessmentCoverageLabel</span>
        }
        @if (_hasAnySnapshot)
        {
            <StatusChip Status="neutral" Label="This session" />
        }
    </PageHeader>

    @* ── Workspace Status Panel ─────────────────────────────────────────────────── *@
    @* Driven only by the current-workspace read model (ICurrentWorkspaceProjection), the same one Recommended Workflow reads. *@
    <section class="db-workspace-panel" role="region" aria-label="Workspace status" data-testid="db-workspace-panel">
        <div class="db-workspace-header">
            <span class="db-workspace-title">Current Workspace</span>
        </div>

        @if (_workspace is null)
        {
            <div class="db-workspace-content">
                <p class="db-workspace-message" role="status">Loading workspace…</p>
            </div>
        }
        else if (_workspace.State == CurrentWorkspaceState.NoWorkspace)
        {
            <div class="db-workspace-content">
                <div class="db-workspace-empty">
                    <p class="db-workspace-message">No workspace loaded. Import your project ZIP (documents and source in one upload) or load a sample project to populate dashboard metrics.</p>
                    <a href="project-import" class="btn-secondary db-workspace-action" data-testid="db-import-project">Import Project →</a>
                    <a href="sample-projects" class="btn-secondary db-workspace-action">Open Sample Projects →</a>
                </div>
            </div>
        }
        else
        {
            <div class="db-workspace-content">
                <div class="db-workspace-info">
                    <span class="db-workspace-project" data-testid="db-workspace-name">📁 @(_workspace.ProjectName ?? _workspace.WorkspaceName)</span>
                    @if (_workspace.IsImportedProject) { <span class="db-workspace-count" data-testid="db-workspace-origin">Imported project archive</span> }
                    @if (_workspace.State == CurrentWorkspaceState.Error)
                    {
                        <span class="db-workspace-count" data-testid="db-workspace-roles">Unable to load workspace artifacts</span>
                    }
                    else if (_workspace.ProjectLoaded && !_workspace.ProjectInCatalog)
                    {
                        <span class="db-workspace-count" data-testid="db-workspace-roles">Artifact availability unavailable</span>
                    }
                    else
                    {
                        <span class="db-workspace-count" data-testid="db-workspace-roles">@_workspace.RoleSummary</span>
                    }
                </div>

                <div class="db-workspace-badges">
                    @foreach (var role in _workspace.Roles)
                    {
                        <span class="db-artifact-badge @(role.IsAvailable ? "is-loaded" : "is-missing")" data-testid="db-role-badge" data-role="@role.Role" data-availability="@role.Availability">
                            @(role.Availability switch { ArtifactRoleAvailability.Available => "✓", ArtifactRoleAvailability.Unknown => "?", _ => "○" }) @role.Label
                        </span>
                    }
                </div>

                <div class="db-workspace-status">
                    <span class="db-status-badge db-status-notrun" data-testid="db-save-status" title="Save status. A workspace is loaded whether or not it is saved.">@_workspace.SaveStatusLabel</span>
                </div>

                @if (_workspace.WorkspaceLoaded && _workspace.AvailableRoleCount == 0)
                {
                    <a href="@(_workspace.IsImportedProject ? "project-import" : "sample-projects")" class="btn-secondary db-workspace-action">@(_workspace.IsImportedProject ? "Open Import Project →" : "Add artifacts →")</a>
                }
                else if (_workspace.WorkspaceLoaded)
                {
                    <a href="getting-started" class="btn-secondary db-workspace-action">Open Recommended Workflow →</a>
                }
            </div>
        }
    </section>

    @if (_hasAnySnapshot)
    {
        <div style="display:flex;justify-content:flex-end;margin-bottom:.5rem">
            <button style="background:#1d4ed8;color:#fff;border:none;padding:.35rem .85rem;border-radius:5px;cursor:pointer;font-size:.78rem" @onclick="ExportHtml">Export HTML</button>
        </div>
    }

    @* ══════════════════════════════════════════════════════════════════════════
       ZONE 1 · EXECUTIVE SUMMARY
       KPI Strip → Governance Status → Readiness Summary
       ══════════════════════════════════════════════════════════════════════════ *@

    @* ── KPI Strip ─────────────────────────────────────────────────────────── *@
    <div class="db-kpi-strip" aria-label="Key performance indicators">
        <div class="db-kpi" data-testid="db-governance-kpi">
            <MetricCard Value="@GovernanceValue"
                        Label="Governance"
                        Sublabel="@GovernanceSublabel"
                        Variant="@GovernanceVariant" />
        </div>
        <MetricCard Value="@TraceabilityHealthVal"
                    Label="Traceability"
                    Sublabel="@KpiStatusLabel(_traceabilityScore, _traceabilityHasData)"
                    Variant="@(_traceabilityHasData ? (_traceabilityScore >= 80 ? "success" : _traceabilityScore >= 50 ? "warning" : "danger") : null)" />
        <MetricCard Value="@ComplianceHealthVal"
                    Label="Compliance"
                    Sublabel="@KpiStatusLabel(_complianceScore, _complianceHasData)"
                    Variant="@(_complianceHasData ? (_complianceScore >= 80 ? "success" : _complianceScore >= 50 ? "warning" : "danger") : null)" />
        <MetricCard Value="@QaHealthVal"
                    Label="QA"
                    Sublabel="@KpiStatusLabel(_qaScore, _qaHasData)"
                    Variant="@(_qaHasData ? (_qaScore >= 80 ? "success" : _qaScore >= 50 ? "warning" : "danger") : null)" />
        <MetricCard Value="@DeliveryHealthVal"
                    Label="Delivery"
                    Sublabel="@KpiStatusLabel(_deliveryScore, _deliveryHasData)"
                    Variant="@(_deliveryHasData ? (_deliveryScore >= 80 ? "success" : _deliveryScore >= 50 ? "warning" : "danger") : null)" />
        @if (_perfReport?.ReadinessReport is { HasData: true, OverallScore: not null } perfKpi)
        {
            <MetricCard Value="@perfKpi.OverallScore.ToString()"
                        Label="Performance"
                        Sublabel="@ReadinessStateLabel(perfKpi.OverallState)"
                        Variant="@(perfKpi.OverallState == PerformanceReadinessState.Ready ? "success" : perfKpi.OverallState == PerformanceReadinessState.MostlyReady ? "warning" : "danger")" />
        }
        else
        {
            <MetricCard Value="—" Label="Performance" Sublabel="@RuntimeStatusLabel(RuntimeReviews.PerformanceReview.Status)" />
        }
        @if (_workflowReadiness is not null)
        {
            <MetricCard Value="@WorkflowValue"
                        Label="Workflow"
                        Sublabel="@WorkflowStatusLabel"
                        Variant="@WorkflowStatusVariant" />
        }
    </div>

    @* ── Health Summary ────────────────────────────────────────────────────── *@
    <section class="db-section">
        <SectionHeader Title="Project Health" />
        <div class="db-health-grid" aria-label="Project health by dimension">

            <div class="db-health-card">
                <span class="db-health-label">Governance</span>
                <span class="db-health-value @(GovernanceAssessed ? "" : "db-val-empty")" data-testid="db-governance-value">@GovernanceValue</span>
                <StatusChip Status="@GovernanceChip" Label="@GovernanceSublabel" />
            </div>

            <div class="db-health-card">
                <span class="db-health-label">Traceability</span>
                <span class="db-health-value @(_traceabilityHasData ? ScoreClass(_traceabilityScore) : "db-val-empty")">@TraceabilityHealthVal</span>
                <StatusChip Status="@(_traceabilityHasData ? (_traceabilityScore >= 80 ? "healthy" : _traceabilityScore >= 50 ? "warning" : "critical") : "neutral")"
                            Label="@KpiStatusLabel(_traceabilityScore, _traceabilityHasData)" />
            </div>

            <div class="db-health-card">
                <span class="db-health-label">Compliance</span>
                <span class="db-health-value @(_complianceHasData ? ScoreClass(_complianceScore) : "db-val-empty")">@ComplianceHealthVal</span>
                <StatusChip Status="@(_complianceHasData ? (_complianceScore >= 80 ? "healthy" : _complianceScore >= 50 ? "warning" : "critical") : "neutral")"
                            Label="@KpiStatusLabel(_complianceScore, _complianceHasData)" />
            </div>

            <div class="db-health-card">
                <span class="db-health-label">QA</span>
                <span class="db-health-value @(_qaHasData ? ScoreClass(_qaScore) : "db-val-empty")">@QaHealthVal</span>
                <StatusChip Status="@(_qaHasData ? (_qaScore >= 80 ? "healthy" : _qaScore >= 50 ? "warning" : "critical") : "neutral")"
                            Label="@KpiStatusLabel(_qaScore, _qaHasData)" />
            </div>

            <div class="db-health-card">
                <span class="db-health-label">Delivery</span>
                <span class="db-health-value @(_deliveryHasData ? ScoreClass(_deliveryScore) : "db-val-empty")">@DeliveryHealthVal</span>
                <StatusChip Status="@(_deliveryHasData ? (_deliveryScore >= 80 ? "healthy" : _deliveryScore >= 50 ? "warning" : "critical") : "neutral")"
                            Label="@KpiStatusLabel(_deliveryScore, _deliveryHasData)" />
            </div>

            @if (_perfReport?.ReadinessReport is { HasData: true, OverallScore: not null } perfHealth)
            {
                <div class="db-health-card">
                    <span class="db-health-label">Performance</span>
                    <span class="db-health-value @ScoreClass(perfHealth.OverallScore!.Value)">@perfHealth.OverallScore</span>
                    <StatusChip Status="@(perfHealth.OverallState == PerformanceReadinessState.Ready ? "healthy" : perfHealth.OverallState == PerformanceReadinessState.MostlyReady ? "warning" : "critical")"
                                Label="@ReadinessStateLabel(perfHealth.OverallState)" />
                </div>
            }
            else
            {
                <div class="db-health-card">
                    <span class="db-health-label">Performance</span>
                    <span class="db-health-value db-val-empty">—</span>
                    <StatusChip Status="@RuntimeStatusChip(RuntimeReviews.PerformanceReview.Status)"
                                Label="@RuntimeStatusLabel(RuntimeReviews.PerformanceReview.Status)" />
                </div>
            }

        </div>
    </section>

    @* ── Governance Status ─────────────────────────────────────────────────── *@
    @* Availability (from the current workspace) and analysis (from this session's reports) are separate facts, shown as separate badges. *@
    <section class="db-section">
        <SectionHeader Title="Project Artifacts" Description="@ArtifactsDescription" />
        <div class="db-artifact-grid">

            <div class="db-artifact-card db-artifact-constitution @(Available(WorkspaceArtifactType.Constitution) ? "db-artifact-loaded" : "")" data-testid="db-artifact-card" data-role="Constitution">
                <div class="db-artifact-icon" aria-hidden="true">⚖</div>
                <div class="db-artifact-name">Constitution</div>
                <div class="db-artifact-badges">@RoleBadges(WorkspaceArtifactType.Constitution, _constitutionAnalyzed)</div>
                @if (Available(WorkspaceArtifactType.Constitution) && Snapshot.ComplianceReport?.HasConstitution == true)
                {
                    <div class="db-artifact-stats">
                        <span class="db-stat-pill">@Snapshot.ComplianceReport.Coverage.TotalItems rules</span>
                    </div>
                }
                else
                {
                    @RoleStats(WorkspaceArtifactType.Constitution)
                }
                <a href="constitution-explorer" class="db-artifact-action">Open Constitution Explorer →</a>
            </div>

            <div class="db-artifact-card db-artifact-specification @(Available(WorkspaceArtifactType.Specification) ? "db-artifact-loaded" : "")" data-testid="db-artifact-card" data-role="Specification">
                <div class="db-artifact-icon" aria-hidden="true">📋</div>
                <div class="db-artifact-name">Specification</div>
                <div class="db-artifact-badges">@RoleBadges(WorkspaceArtifactType.Specification, _specAnalyzed)</div>
                @if (Available(WorkspaceArtifactType.Specification) && Snapshot.TraceabilityReport is { Health.TotalRequirements: > 0 } specTrace)
                {
                    <div class="db-artifact-stats">
                        <span class="db-stat-pill">@specTrace.Health.TotalRequirements requirements</span>
                        <span class="db-stat-pill">@(specTrace.HasPlan && specTrace.SpecificationCoverage.HasApplicablePopulation ? $"{specTrace.SpecificationCoverage.CoveragePercentage:0}% Requirement → Plan" : "Requirement → Plan not assessed")</span>
                    </div>
                }
                else
                {
                    @RoleStats(WorkspaceArtifactType.Specification)
                }
                <a href="specification-explorer" class="db-artifact-action">Open Specification Explorer →</a>
            </div>

            <div class="db-artifact-card db-artifact-plan @(Available(WorkspaceArtifactType.Plan) ? "db-artifact-loaded" : "")" data-testid="db-artifact-card" data-role="Plan">
                <div class="db-artifact-icon" aria-hidden="true">🗺</div>
                <div class="db-artifact-name">Plan</div>
                <div class="db-artifact-badges">@RoleBadges(WorkspaceArtifactType.Plan, _planAnalyzed)</div>
                @if (Available(WorkspaceArtifactType.Plan) && Snapshot.TraceabilityReport?.HasPlan == true)
                {
                    <div class="db-artifact-stats">
                        <span class="db-stat-pill">@Snapshot.TraceabilityReport.Health.TotalPlanItems plan phases</span>
                        @if (Snapshot.TraceabilityReport.HasTasks && Snapshot.TraceabilityReport.PlanCoverage.HasApplicablePopulation)
                        {
                            <span class="db-stat-pill">@Snapshot.TraceabilityReport.PlanCoverage.CoveredItems of @Snapshot.TraceabilityReport.PlanCoverage.TotalItems align with Task phases</span>
                        }
                        else
                        {
                            <span class="db-stat-pill">Plan-to-Task phase alignment not assessed</span>
                        }
                    </div>
                }
                else
                {
                    @RoleStats(WorkspaceArtifactType.Plan)
                }
                <a href="plan-explorer" class="db-artifact-action">Open Plan Explorer →</a>
            </div>

            <div class="db-artifact-card db-artifact-tasks @(Available(WorkspaceArtifactType.Tasks) ? "db-artifact-loaded" : "")" data-testid="db-artifact-card" data-role="Tasks">
                <div class="db-artifact-icon" aria-hidden="true">✅</div>
                <div class="db-artifact-name">Tasks</div>
                <div class="db-artifact-badges">@RoleBadges(WorkspaceArtifactType.Tasks, _tasksAnalyzed)</div>
                @if (Available(WorkspaceArtifactType.Tasks) && Snapshot.TraceabilityReport is { Health.TotalTasks: > 0 } taskTrace)
                {
                    <div class="db-artifact-stats">
                        <span class="db-stat-pill">@taskTrace.Health.TotalTasks tasks</span>
                        <span class="db-stat-pill">@(taskTrace.HasSpecification && taskTrace.TaskCoverage.HasApplicablePopulation ? $"{taskTrace.TaskCoverage.CoveredItems} of {taskTrace.TaskCoverage.TotalItems} Tasks have Requirement/SC references" : "Requirement/SC references not assessed")</span>
                    </div>
                }
                else
                {
                    @RoleStats(WorkspaceArtifactType.Tasks)
                }
                <a href="task-explorer" class="db-artifact-action">Open Task Explorer →</a>
            </div>

            <div class="db-artifact-card db-artifact-datamodel @(Available(WorkspaceArtifactType.DataModel) ? "db-artifact-loaded" : "")" data-testid="db-artifact-card" data-role="DataModel">
                <div class="db-artifact-icon" aria-hidden="true">🗄️</div>
                <div class="db-artifact-name">Data Model</div>
                <div class="db-artifact-badges">@RoleBadges(WorkspaceArtifactType.DataModel, _dataModelAnalyzed)</div>
                @RoleStats(WorkspaceArtifactType.DataModel)
                <a href="data-model-explorer" class="db-artifact-action">Open Data Model Explorer →</a>
            </div>
        </div>
    </section>

    @* ── Readiness Summary ──────────────────────────────────────────────────── *@
    <section class="db-section">
        <SectionHeader Title="Readiness Summary" />
        @if (Snapshot.DeliveryReport is not null || Snapshot.ReadinessReport is not null)
        {
            <div class="db-readiness-grid">
                @ReadinessCard("Development", Snapshot.DeliveryReport?.DevelopmentDecision.State, Snapshot.DeliveryReport?.Health.DevelopmentScore, "quality/document")
                @ReadinessCard("Testing",     Snapshot.DeliveryReport?.TestingDecision.State,     Snapshot.DeliveryReport?.Health.TestingScore,     "quality/document")
                @ReadinessCard("Release",     Snapshot.DeliveryReport?.ReleaseDecision.State,     Snapshot.DeliveryReport?.Health.ReleaseScore,      "quality/document")
                @ReadinessCardScore("QA Readiness", Snapshot.ReadinessReport?.OverallScore, "quality/document")
            </div>
        }
        else
        {
            <div class="db-section-empty">
                Run a Document Quality Review with Readiness packs selected to populate this section.
                <div class="db-empty-actions">
                    <a href="quality/document" class="db-qa-btn">Document Quality Review</a>
                </div>
            </div>
        }
    </section>

    @* ══════════════════════════════════════════════════════════════════════════
       ZONE 2 · DECISION SUPPORT
       Top Risks → Top Recommendations → Recent Activity
       ══════════════════════════════════════════════════════════════════════════ *@

    @* ── Top Risks ──────────────────────────────────────────────────────────── *@
    <section class="db-section db-zone-start">
        <SectionHeader Title="Top Risks" />
        @{
            var topRisks = _topRisks.ToList();
        }
        @if (topRisks.Count > 0)
        {
            <div class="issue-cards">
                @foreach (var (Title, Severity, Category, Detail) in topRisks)
                {
                    <IssueCard Severity="@Severity" Component="@Category" Description="@Title" SuggestedFix="@Detail" />
                }
            </div>
        }
        else
        {
            <div class="db-section-empty">
                No risks detected. Run Document Quality Review to surface governance risks.
                <div class="db-empty-actions">
                    <a href="quality/document" class="db-qa-btn">Run Document Quality Review</a>
                </div>
            </div>
        }
    </section>

    @* ── Top Recommendations ────────────────────────────────────────────────── *@
    <section class="db-section">
        <SectionHeader Title="Top Recommendations" />
        @{
            var topRecs = _topRecs.ToList();
        }
        @if (topRecs.Count > 0)
        {
            <div class="db-rec-cards">
                @{ int recIdx = 0; }
                @foreach (var (Text, Category, ActionHref) in topRecs)
                {
                    recIdx++;
                    <div class="db-rec-card">
                        <div class="db-rec-num" aria-hidden="true">@recIdx</div>
                        <div class="db-rec-body">
                            <div class="db-rec-text">@Text</div>
                            <div class="db-rec-footer">
                                <span class="db-rec-cat">@Category</span>
                                <a href="@ActionHref" class="db-rec-action">Open →</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="db-section-empty">
                No recommendations yet. Run Document Quality Review with the QA Auditor or Delivery Readiness pack to generate actionable recommendations.
            </div>
        }
    </section>

    @* ── Recent Activity ────────────────────────────────────────────────────── *@
    <section class="db-section">
        <SectionHeader Title="Recent Activity" />
        <div class="db-timeline">
            @{
                bool anyActivity = false;

                if (Snapshot.AuditReport is not null)
                {
                    anyActivity = true;
                    <div class="db-tl-entry">
                        <span class="db-tl-dot db-tl-dot-analyzed" aria-hidden="true"></span>
                        <div class="db-tl-body">
                            <span class="db-tl-action">Document Quality Review — QA Auditor completed</span>
                            <span class="db-tl-meta">@Snapshot.AuditReport.Health.TotalFindings finding@(Snapshot.AuditReport.Health.TotalFindings != 1 ? "s" : "")</span>
                        </div>
                    </div>
                }

                if (Snapshot.DeliveryReport is not null)
                {
                    anyActivity = true;
                    <div class="db-tl-entry">
                        <span class="db-tl-dot db-tl-dot-analyzed" aria-hidden="true"></span>
                        <div class="db-tl-body">
                            <span class="db-tl-action">Document Quality Review — Delivery Readiness completed</span>
                            <span class="db-tl-meta">@Snapshot.DeliveryReport.Health.OverallReadinessScore.ToString("0")% overall readiness</span>
                        </div>
                    </div>
                }

                if (Snapshot.TraceabilityReport is not null)
                {
                    anyActivity = true;
                    <div class="db-tl-entry">
                        <span class="db-tl-dot db-tl-dot-analyzed" aria-hidden="true"></span>
                        <div class="db-tl-body">
                            <span class="db-tl-action">Requirements Traceability completed</span>
                            <span class="db-tl-meta">@(Snapshot.TraceabilityReport.Health.HasAssessedCoverage ? $"{Snapshot.TraceabilityReport.Health.CoveragePercentage:0}% across assessed transitions" : "No transition coverage assessed")</span>
                        </div>
                    </div>
                }

                if (Snapshot.ComplianceReport is not null)
                {
                    anyActivity = true;
                    <div class="db-tl-entry">
                        <span class="db-tl-dot db-tl-dot-analyzed" aria-hidden="true"></span>
                        <div class="db-tl-body">
                            <span class="db-tl-action">Document Quality Review — Constitution Compliance completed</span>
                            <span class="db-tl-meta">@Snapshot.ComplianceReport.Coverage.CompliancePercentage.ToString("0")% compliant</span>
                        </div>
                    </div>
                }

                if (Snapshot.ReadinessReport is not null)
                {
                    anyActivity = true;
                    <div class="db-tl-entry">
                        <span class="db-tl-dot db-tl-dot-analyzed" aria-hidden="true"></span>
                        <div class="db-tl-body">
                            <span class="db-tl-action">Document Quality Review — QA Readiness completed</span>
                            <span class="db-tl-meta">@Snapshot.ReadinessReport.OverallScore.ToString("0")% overall</span>
                        </div>
                    </div>
                }

                if (_perfReport is not null)
                {
                    anyActivity = true;
                    <div class="db-tl-entry">
                        <span class="db-tl-dot db-tl-dot-perf" aria-hidden="true"></span>
                        <div class="db-tl-body">
                            <span class="db-tl-action">Performance Review completed</span>
                            <span class="db-tl-meta">@_perfReport.Assets.Count assets · @FormatBytes(_perfReport.Health.TotalTransferBytes) transfer</span>
                        </div>
                    </div>
                }

                if (!anyActivity)
                {
                    <div class="db-tl-empty">
                        No analyses have been run this session.
                    </div>
                }
            }
        </div>
    </section>

    @* ══════════════════════════════════════════════════════════════════════════
       ZONE 3 · OPERATIONAL ACTIONS
       Analysis Summary → Quick Actions
       ══════════════════════════════════════════════════════════════════════════ *@

    @* ── Analysis Summary ───────────────────────────────────────────────────── *@
    <section class="db-section db-zone-start">
        <SectionHeader Title="Analysis Summary" Description="Run each analysis to populate" />
        <div class="db-analysis-grid">

            @* Requirements Traceability *@
            <div class="db-analysis-card">
                <div class="db-analysis-card-header">
                    <span class="db-analysis-card-title">Requirements Traceability</span>
                    <a href="artifact-traceability" class="db-summary-open" aria-label="Open Requirements Traceability">Open →</a>
                </div>
                @if (Snapshot.TraceabilityReport is { } tr)
                {
                    @if (tr.Health.HasAssessedCoverage)
                    {
                        <div class="db-analysis-score @ScoreClass(tr.Health.CoveragePercentage)">@tr.Health.CoveragePercentage.ToString("0")%</div>
                        <span class="db-analysis-status @KpiStatusClass(tr.Health.CoveragePercentage, true)">@KpiStatusLabel(tr.Health.CoveragePercentage, true) across assessed transitions</span>
                    }
                    else
                    {
                        <div class="db-analysis-score">—</div>
                        <span class="db-analysis-status">Traceability transitions not assessed</span>
                    }
                    <div class="db-analysis-chips">
                        <span class="db-count-chip db-count-good">@tr.Health.CoveredCount covered</span>
                        @if (tr.Health.PartialCount > 0) { <span class="db-count-chip db-count-warn">@tr.Health.PartialCount partial</span> }
                        @if (tr.Health.MissingCount > 0) { <span class="db-count-chip db-count-poor">@tr.Health.MissingCount missing</span> }
                    </div>
                }
                else
                {
                    <div class="db-analysis-empty">
                        Not run — populate by running Requirements Traceability.
                        <a href="artifact-traceability" class="db-analysis-run-link">Run now →</a>
                    </div>
                }
            </div>

            @* Constitution Compliance *@
            <div class="db-analysis-card">
                <div class="db-analysis-card-header">
                    <span class="db-analysis-card-title">Constitution Compliance</span>
                    <a href="quality/document" class="db-summary-open" aria-label="Open Document Quality Review">Open →</a>
                </div>
                @if (Snapshot.ComplianceReport is { } cr)
                {
                    <div class="db-analysis-score @ScoreClass(cr.Coverage.CompliancePercentage)">@cr.Coverage.CompliancePercentage.ToString("0")%</div>
                    <span class="db-analysis-status @KpiStatusClass(cr.Coverage.CompliancePercentage, true)">@KpiStatusLabel(cr.Coverage.CompliancePercentage, true)</span>
                    <div class="db-analysis-chips">
                        <span class="db-count-chip db-count-good">@cr.Coverage.CompliantItems compliant</span>
                        @if (cr.Coverage.PartialItems > 0)  { <span class="db-count-chip db-count-warn">@cr.Coverage.PartialItems partial</span> }
                        @if (cr.Coverage.MissingItems > 0)  { <span class="db-count-chip db-count-poor">@cr.Coverage.MissingItems missing</span> }
                        @if (cr.Violations.Count > 0)        { <span class="db-count-chip db-count-poor">@cr.Violations.Count violations</span> }
                    </div>
                }
                else
                {
                    <div class="db-analysis-empty">
                        Not run — populate by running Document Quality Review.
                        <a href="quality/document" class="db-analysis-run-link">Run now →</a>
                    </div>
                }
            </div>

            @* QA Audit *@
            <div class="db-analysis-card">
                <div class="db-analysis-card-header">
                    <span class="db-analysis-card-title">QA Audit</span>
                    <a href="quality/document" class="db-summary-open" aria-label="Open Document Quality Review">Open →</a>
                </div>
                @if (Snapshot.AuditReport is { } ar)
                {
                    <div class="db-analysis-score @ScoreClass(ar.Health.AuditScore)">@ar.Health.AuditScore.ToString("0")</div>
                    <span class="db-analysis-status @KpiStatusClass(ar.Health.AuditScore, true)">@KpiStatusLabel(ar.Health.AuditScore, true)</span>
                    @if (_topAuditRiskTitle is not null)
                    {
                        <div class="db-analysis-finding">@_topAuditRiskTitle</div>
                    }
                    <div class="db-analysis-chips">
                        @if (ar.Health.CriticalCount > 0) { <span class="db-count-chip db-count-poor">@ar.Health.CriticalCount critical</span> }
                        @if (ar.Health.HighCount > 0)     { <span class="db-count-chip db-count-poor">@ar.Health.HighCount high</span> }
                        @if (ar.Health.MediumCount > 0)   { <span class="db-count-chip db-count-warn">@ar.Health.MediumCount medium</span> }
                        @if (ar.Health.CriticalCount == 0 && ar.Health.HighCount == 0)
                        { <span class="db-count-chip db-count-good">No critical findings</span> }
                    </div>
                }
                else
                {
                    <div class="db-analysis-empty">
                        Not run — populate by running Document Quality Review.
                        <a href="quality/document" class="db-analysis-run-link">Run now →</a>
                    </div>
                }
            </div>

            @* Delivery Readiness *@
            <div class="db-analysis-card">
                <div class="db-analysis-card-header">
                    <span class="db-analysis-card-title">Delivery Readiness</span>
                    <a href="quality/document" class="db-summary-open" aria-label="Open Document Quality Review">Open →</a>
                </div>
                @if (Snapshot.DeliveryReport is { } dr)
                {
                    <div class="db-analysis-score @ScoreClass(dr.Health.OverallReadinessScore)">@dr.Health.OverallReadinessScore.ToString("0")%</div>
                    <span class="db-analysis-status @ReadinessStatusClass(dr.DevelopmentDecision.State)">@ReadinessStateLabel(dr.DevelopmentDecision.State)</span>
                    @if (_topBlockerTitle is not null)
                    {
                        <div class="db-analysis-finding">@_topBlockerTitle</div>
                    }
                    <div class="db-analysis-chips">
                        <span class="db-count-chip @(dr.DevelopmentDecision.State == ReadinessState.Ready ? "db-count-good" : dr.DevelopmentDecision.State == ReadinessState.MostlyReady ? "db-count-warn" : "db-count-poor")">Dev</span>
                        <span class="db-count-chip @(dr.TestingDecision.State     == ReadinessState.Ready ? "db-count-good" : dr.TestingDecision.State     == ReadinessState.MostlyReady ? "db-count-warn" : "db-count-poor")">Test</span>
                        <span class="db-count-chip @(dr.ReleaseDecision.State     == ReadinessState.Ready ? "db-count-good" : dr.ReleaseDecision.State     == ReadinessState.MostlyReady ? "db-count-warn" : "db-count-poor")">Release</span>
                    </div>
                }
                else
                {
                    <div class="db-analysis-empty">
                        Not run — populate by running Document Quality Review.
                        <a href="quality/document" class="db-analysis-run-link">Run now →</a>
                    </div>
                }
            </div>

            @* Frontend Quality Review *@
            <div class="db-analysis-card">
                <div class="db-analysis-card-header">
                    <span class="db-analysis-card-title">Frontend Quality Review</span>
                    <a href="frontend-quality-review" class="db-summary-open" aria-label="Open Frontend Quality Review">Open →</a>
                </div>
                @if (_fqrReport is { } fqrCard)
                {
                    @if (fqrCard.OverallScore.HasValue)
                    {
                        <div class="db-analysis-score @ScoreClass(fqrCard.OverallScore.Value)">@fqrCard.OverallScore.Value</div>
                        <span class="db-analysis-status @KpiStatusClass(fqrCard.OverallScore.Value, true)">@KpiStatusLabel(fqrCard.OverallScore.Value, true)</span>
                    }
                    else
                    {
                        <div class="db-analysis-score">—</div>
                        <span class="db-analysis-status">Partial assessment</span>
                    }
                    @if (fqrCard.Findings.OrderBy(f => f.Severity).FirstOrDefault() is { } topFqrFinding)
                    {
                        <div class="db-analysis-finding">@topFqrFinding.Title</div>
                    }
                    <div class="db-analysis-chips">
                        @{ var fqrCritical = fqrCard.Findings.Count(f => f.Severity == FrontendQualitySeverity.Critical); }
                        @{ var fqrHigh     = fqrCard.Findings.Count(f => f.Severity == FrontendQualitySeverity.High); }
                        @if (fqrCritical > 0) { <span class="db-count-chip db-count-poor">@fqrCritical critical</span> }
                        @if (fqrHigh > 0)     { <span class="db-count-chip db-count-poor">@fqrHigh high</span> }
                        @if (fqrCritical == 0 && fqrHigh == 0)
                        { <span class="db-count-chip db-count-good">No critical findings</span> }
                    </div>
                }
                else if (RuntimeReviews.QualityReview.Status != RuntimeReviewStatus.NotRun)
                {
                    <span class="db-analysis-status @RuntimeStatusClass(RuntimeReviews.QualityReview.Status)">@RuntimeStatusLabel(RuntimeReviews.QualityReview.Status)</span>
                    @if (RuntimeReviews.QualityReview.ErrorMessage is not null)
                    {
                        <div class="db-analysis-finding">@RuntimeReviews.QualityReview.ErrorMessage</div>
                    }
                }
                else
                {
                    <div class="db-analysis-empty">
                        Not run — analyse performance, security, accessibility, standards, and readiness in one review.
                        <a href="frontend-quality-review" class="db-analysis-run-link">Run now →</a>
                    </div>
                }
            </div>

            @* API Quality Review *@
            <div class="db-analysis-card">
                <div class="db-analysis-card-header">
                    <span class="db-analysis-card-title">API Quality Review</span>
                    <a href="api-quality-review" class="db-summary-open" aria-label="Open API Quality Review">Open →</a>
                </div>
                @if (_aqrReport is { } aqrCard)
                {
                    var aqrCompleted = aqrCard.Targets.Count(t => t.Status == BirkNext.ApiReview.ApiReviewTargetStatus.Completed);
                    var aqrBlocked = aqrCard.Targets.Count(t => t.Status == BirkNext.ApiReview.ApiReviewTargetStatus.Blocked);
                    <div class="db-analysis-score">@aqrCompleted/@aqrCard.Targets.Count</div>
                    <span class="db-analysis-status @(aqrBlocked > 0 ? "db-status-warn" : "db-status-ok")">@(aqrBlocked > 0 ? $"{aqrBlocked} target(s) blocked" : "API targets reviewed")</span>
                    @if (aqrCard.Findings.OrderBy(f => f.Severity).FirstOrDefault() is { } topAqrFinding)
                    {
                        <div class="db-analysis-finding">@topAqrFinding.Title</div>
                    }
                    <div class="db-analysis-chips">
                        @{ var aqrCritical = aqrCard.Findings.Count(f => f.Severity == BirkNext.ApiReview.ApiReviewSeverity.Critical); }
                        @{ var aqrHigh     = aqrCard.Findings.Count(f => f.Severity == BirkNext.ApiReview.ApiReviewSeverity.High); }
                        @if (aqrCritical > 0) { <span class="db-count-chip db-count-poor">@aqrCritical critical</span> }
                        @if (aqrHigh > 0)     { <span class="db-count-chip db-count-poor">@aqrHigh high</span> }
                        @if (aqrCritical == 0 && aqrHigh == 0)
                        { <span class="db-count-chip db-count-good">@(aqrCard.AnyCompleted ? "No high findings" : "Not assessed")</span> }
                    </div>
                }
                else if (RuntimeReviews.ApiQualityReview.Status != RuntimeReviewStatus.NotRun)
                {
                    <span class="db-analysis-status @RuntimeStatusClass(RuntimeReviews.ApiQualityReview.Status)">@RuntimeStatusLabel(RuntimeReviews.ApiQualityReview.Status)</span>
                    @if (RuntimeReviews.ApiQualityReview.ErrorMessage is not null)
                    {
                        <div class="db-analysis-finding">@RuntimeReviews.ApiQualityReview.ErrorMessage</div>
                    }
                }
                else
                {
                    <div class="db-analysis-empty">
                        Not run — analyse connectivity, security, performance, REST, GraphQL, OpenAPI, and readiness.
                        <a href="api-quality-review" class="db-analysis-run-link">Run now →</a>
                    </div>
                }
            </div>

            @* Integration Quality Review *@
            <div class="db-analysis-card">
                <div class="db-analysis-card-header">
                    <span class="db-analysis-card-title">Integration Quality Review</span>
                    <a href="integration-quality-review" class="db-summary-open" aria-label="Open Integration Quality Review">Open →</a>
                </div>
                @if (_iqrReport is { } iqrCard)
                {
                    @* The review has no score by design: outcome, domain coverage and findings, never "healthy". *@
                    <span class="db-analysis-status" data-testid="db-iqr-outcome">@BirkNext.Integrations.IntegrationReviewLabels.Outcome(iqrCard.Outcome)</span>
                    @if (iqrCard.Findings.OrderBy(f => f.Severity).FirstOrDefault() is { } topIqrFinding)
                    {
                        <div class="db-analysis-finding">@topIqrFinding.Title</div>
                    }
                    <div class="db-analysis-chips">
                        @{ var iqrHighOrWorse = iqrCard.Findings.Count(f => f.Severity is BirkNext.Integrations.IntegrationFindingSeverityV2.Critical or BirkNext.Integrations.IntegrationFindingSeverityV2.High); }
                        @if (iqrHighOrWorse > 0) { <span class="db-count-chip db-count-poor">@iqrHighOrWorse high or critical</span> }
                        <span class="db-count-chip" data-testid="db-iqr-coverage">@iqrCard.Domains.Count(d => d.ChecksAssessed > 0)/@iqrCard.Domains.Count domains assessed</span>
                        <span class="db-count-chip">@iqrCard.TopicsReviewed topics</span>
                    </div>
                }
                else if (RuntimeReviews.IntegrationQualityReview.Status != RuntimeReviewStatus.NotRun)
                {
                    <span class="db-analysis-status @RuntimeStatusClass(RuntimeReviews.IntegrationQualityReview.Status)">@RuntimeStatusLabel(RuntimeReviews.IntegrationQualityReview.Status)</span>
                    @if (RuntimeReviews.IntegrationQualityReview.ErrorMessage is not null)
                    {
                        <div class="db-analysis-finding">@RuntimeReviews.IntegrationQualityReview.ErrorMessage</div>
                    }
                }
                else
                {
                    <div class="db-analysis-empty">
                        Not run — analyse configured service integrations, health checks, ownership, and readiness.
                        <a href="integration-quality-review" class="db-analysis-run-link">Run now →</a>
                    </div>
                }
            </div>

            </div>
    </section>

    @* ── Quick Actions ───────────────────────────────────────────────────────── *@
    <section class="db-section">
        <SectionHeader Title="Quick Actions" />
        <div class="db-quick-actions">
            <div class="db-qa-group">
                <div class="db-qa-group-label">Review</div>
                <div class="db-qa-buttons">
                    <a href="constitution-explorer"  class="db-qa-btn">Constitution Explorer</a>
                    <a href="specification-explorer" class="db-qa-btn">Specification Explorer</a>
                    <a href="plan-explorer"          class="db-qa-btn">Plan Explorer</a>
                    <a href="task-explorer"          class="db-qa-btn">Task Explorer</a>
                </div>
            </div>
            <div class="db-qa-group">
                <div class="db-qa-group-label">Analysis</div>
                <div class="db-qa-buttons">
                    <a href="artifact-traceability"   class="db-qa-btn">Requirements Traceability</a>
                    <a href="quality/document"          class="db-qa-btn">Document Quality Review</a>
                    <a href="frontend-quality-review"  class="db-qa-btn">Frontend Quality Review</a>
                    <a href="api-quality-review"       class="db-qa-btn">API Quality Review</a>
                    <a href="integration-quality-review" class="db-qa-btn">Integration Quality Review</a>
                </div>
            </div>
            <div class="db-qa-group">
                <div class="db-qa-group-label">AI</div>
                <div class="db-qa-buttons">
                    <a href="ai-change-auditor" class="db-qa-btn">AI Change Review</a>
                </div>
            </div>
        </div>
    </section>

@code {
    // ── Workspace status ──────────────────────────────────────────────────────

    /// <summary>The current workspace (null while it loads). Every presence fact on this page comes from it.</summary>
    private CurrentWorkspaceSnapshot? _workspace;

    protected override void OnInitialized()
    {
        CurrentWorkspace.Changed += OnWorkspaceChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await RefreshWorkspaceAsync();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error initializing Dashboard: {ex.Message}");
        }
    }

    private void OnWorkspaceChanged() => _ = InvokeAsync(RefreshWorkspaceAsync);

    private async Task RefreshWorkspaceAsync()
    {
        _workspace = await CurrentWorkspace.GetAsync();
        StateHasChanged();
        await RefreshWorkflowReadinessAsync();
    }

    public void Dispose() => CurrentWorkspace.Changed -= OnWorkspaceChanged;

    private bool Available(WorkspaceArtifactType role) => _workspace?.Has(role) == true;

    /// <summary>Availability, selection and analysis as separate badges. Analysis counts only for an available artifact.</summary>
    private RenderFragment RoleBadges(WorkspaceArtifactType role, bool analyzed) => __builder =>
    {
        var status = _workspace?.Role(role);
        switch (status?.Availability)
        {
            case ArtifactRoleAvailability.Available:
                <span class="db-badge db-badge-loaded">Available@(status.ArtifactCount > 1 ? $" · {status.ArtifactCount}" : "")</span>
                if (status.Selection == ArtifactRoleSelection.SelectionRequired)
                {
                    <span class="db-badge db-badge-empty">Selection required</span>
                }
                if (_workflowReadiness?.ReviewFor(role) is { } review)
                {
                    <span class="db-badge db-badge-review is-@review.State.ToString().ToLowerInvariant()" data-testid="db-artifact-review" data-state="@review.State"
                          title="@review.Summary"><span aria-hidden="true">@review.Icon </span>@review.Label</span>
                }
                if (analyzed)
                {
                    <span class="db-badge db-badge-analyzed">Analyzed</span>
                }
                else
                {
                    <span class="db-badge db-badge-empty">Not analyzed</span>
                }
                break;
            case ArtifactRoleAvailability.Unknown:
                <span class="db-badge db-badge-empty">Availability unknown</span>
                break;
            default:
                <span class="db-badge db-badge-empty">Missing</span>
                break;
        }
    };

    /// <summary>The selected artifact's file and project, or how many artifacts wait for a choice.</summary>
    private RenderFragment RoleStats(WorkspaceArtifactType role) => __builder =>
    {
        var status = _workspace?.Role(role);
        if (status is not { IsAvailable: true }) return;
        <div class="db-artifact-stats">
            @if (status.SelectedArtifact is { } selected)
            {
                <span class="db-stat-pill">@selected.FileName</span>
            }
            else
            {
                <span class="db-stat-pill">@status.ArtifactCount artifacts</span>
            }
            @if (_workspace!.ProjectName is { } project)
            {
                <span class="db-stat-pill">@project</span>
            }
        </div>
    };

    // ── Governance: review decisions on the project's artifact revisions ──────────────────────────────────────────────
    // Availability is context (the workspace card and Project Artifacts); Governance counts only decisions recorded on the
    // revision each document review gate reads now — the same reading Recommended Workflow shows.

    /// <summary>Document review gates that apply (one per available role with a review step; the Data Model's is optional).</summary>
    private IReadOnlyList<ArtifactReviewStatus> DocumentReviews =>
        _workflowReadiness?.DocumentReviewGates.Select(ArtifactReviewPresentation.Of).ToList() ?? [];

    /// <summary>Assessed once a decision exists on a current revision, or an earlier decision has gone stale.</summary>
    private bool GovernanceAssessed => DocumentReviews.Any(r => r.IsDecided || r.State == ArtifactReviewState.Stale);

    private int GovernanceApproved => DocumentReviews.Count(r => r.State == ArtifactReviewState.Approved);

    /// <summary>"—" until assessed; then approved document reviews of those that apply. Never an availability count, never 0%.</summary>
    private string GovernanceValue => GovernanceAssessed ? $"{GovernanceApproved} / {DocumentReviews.Count}" : "—";

    private string GovernanceSublabel
    {
        get
        {
            if (_workspace is null) return "Loading";
            if (_workspace.State == CurrentWorkspaceState.Error) return "Unavailable";
            if (!_workspace.WorkspaceLoaded) return "No workspace";
            if (!GovernanceAssessed) return "Not assessed";
            var needsChanges = DocumentReviews.Count(r => r.State == ArtifactReviewState.NeedsChanges);
            var stale = DocumentReviews.Count(r => r.State == ArtifactReviewState.Stale);
            return needsChanges > 0 ? $"{needsChanges} need{(needsChanges == 1 ? "s" : "")} changes"
                : stale > 0 ? $"{stale} review{(stale == 1 ? "" : "s")} stale"
                : GovernanceApproved == DocumentReviews.Count ? "Document reviews approved"
                : "Document reviews approved so far";
        }
    }

    /// <summary>Success only when every document review is approved; otherwise neutral — the sublabel names what needs attention.</summary>
    private string? GovernanceVariant =>
        GovernanceAssessed && GovernanceApproved == DocumentReviews.Count && DocumentReviews.Count > 0 ? "success" : null;

    private string GovernanceChip =>
        GovernanceVariant == "success" ? "healthy"
        : DocumentReviews.Any(r => r.State is ArtifactReviewState.NeedsChanges or ArtifactReviewState.Stale) ? "warning"
        : "neutral";

    /// <summary>What each card shows. The role count is the workspace card's; repeating it here could contradict an unknown state.</summary>
    private const string ArtifactsDescription = "Availability · review decision on the selected revision · analysis";

    // ── Workflow readiness ────────────────────────────────────────────────────

    private WorkflowReadiness? _workflowReadiness;

    /// <summary>Approved share of the required reviews; "—" when nothing is assessed yet (never 0% by default).</summary>
    private string WorkflowValue => _workflowReadiness?.ReleaseReadinessPercent is { } percent ? $"{percent}%" : "—";

    private string WorkflowStatusLabel => _workflowReadiness switch
    {
        null or { WorkspaceLoaded: false } => "Not assessed",
        { ReleaseReadinessPercent: null } => "Not Started",
        { ReleaseReadinessPercent: 100 } => "Complete",
        { ReleaseReadinessPercent: >= 50 } => "In Progress",
        _ => "Started"
    };

    private string? WorkflowStatusVariant => _workflowReadiness?.ReleaseReadinessPercent switch
    {
        100 => "success",
        >= 50 => "warning",
        _ => null
    };

    private async Task RefreshWorkflowReadinessAsync()
    {
        try
        {
            _workflowReadiness = await WorkflowReadiness.GetReadinessAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading workflow readiness: {ex.Message}");
        }
    }

    // ── Runtime review session ────────────────────────────────────────────────

    private WasmSecurityReviewReport?    _securityReport => RuntimeReviews.SecurityReview.Report;
    private WasmPerformanceReviewReport? _perfReport     => RuntimeReviews.PerformanceReview.Report;
    private FrontendQualityReviewReport? _fqrReport      => RuntimeReviews.QualityReview.Report;
    private BirkNext.ApiReview.ApiReviewReport? _aqrReport => RuntimeReviews.ApiQualityReview.Report;
    private BirkNext.Integrations.IntegrationReviewResult? _iqrReport => RuntimeReviews.IntegrationQualityReview.Report;

    // ── Snapshot aliases ──────────────────────────────────────────────────────

    private bool _hasAnySnapshot =>
        Snapshot.TraceabilityReport is not null ||
        Snapshot.ComplianceReport   is not null ||
        Snapshot.AuditReport        is not null ||
        Snapshot.DeliveryReport     is not null ||
        Snapshot.ReadinessReport    is not null ||
        QualitySession.Status       != AnalysisSessionStatus.NotRun ||
        RuntimeReviews.SecurityReview.HasResult ||
        RuntimeReviews.PerformanceReview.HasResult ||
        RuntimeReviews.QualityReview.HasResult ||
        RuntimeReviews.ApiQualityReview.HasResult ||
        RuntimeReviews.IntegrationQualityReview.HasResult;

    // While the workspace loads it is not "no workspace": the onboarding card waits for the snapshot.
    private bool _hasAnyWorkspace =>
        _workspace is null || _workspace.State != CurrentWorkspaceState.NoWorkspace;

    // ── Artifact loaded / analyzed ────────────────────────────────────────────

    private bool _constitutionAnalyzed =>
        Snapshot.TraceabilityReport?.HasConstitution == true ||
        Snapshot.ComplianceReport?.HasConstitution == true ||
        Snapshot.AuditReport?.HasConstitution == true ||
        Snapshot.DeliveryReport?.HasConstitution == true ||
        Snapshot.ReadinessReport?.HasConstitution == true;

    private bool _specAnalyzed =>
        Snapshot.TraceabilityReport?.HasSpecification == true ||
        Snapshot.ComplianceReport?.HasSpecification == true ||
        Snapshot.AuditReport?.HasSpecification == true ||
        Snapshot.ReadinessReport?.HasSpecification == true;

    private bool _planAnalyzed =>
        Snapshot.TraceabilityReport?.HasPlan == true ||
        Snapshot.ComplianceReport?.HasPlan == true ||
        Snapshot.AuditReport?.HasPlan == true ||
        Snapshot.DeliveryReport?.HasPlan == true ||
        Snapshot.ReadinessReport?.HasPlan == true;

    private bool _tasksAnalyzed =>
        Snapshot.TraceabilityReport?.HasTasks == true ||
        Snapshot.AuditReport?.HasTasks == true ||
        Snapshot.DeliveryReport?.HasTasks == true ||
        Snapshot.ReadinessReport?.HasTasks == true;

    private bool _dataModelAnalyzed =>
        false;  // Data Model analysis not yet integrated into report system

    // ── Pre-computed health scores (numeric) ──────────────────────────────────

    private bool _traceabilityHasData => Snapshot.TraceabilityReport is not null;
    private double _traceabilityScore => Snapshot.TraceabilityReport is { } tr
        ? tr.Health.CoveragePercentage
        : 0;

    private bool _complianceHasData => Snapshot.ComplianceReport is not null;
    private double _complianceScore => Snapshot.ComplianceReport?.Health.CompliancePercentage ?? 0;

    private bool _qaHasData => QualitySession.HasResult || Snapshot.AuditReport is not null || Snapshot.ReadinessReport is not null;
    private double _qaScore => QualitySession.Report is { } report
        ? report.OverallScore
        : Snapshot.AuditReport is { } ar
            ? ar.Health.AuditScore
            : Snapshot.ReadinessReport?.OverallScore ?? 0;

    private bool _deliveryHasData => Snapshot.DeliveryReport is not null;
    private double _deliveryScore => Snapshot.DeliveryReport?.Health.OverallReadinessScore ?? 0;

    // ── Overall health ────────────────────────────────────────────────────────

    /// <summary>A QA result only counts as assessed when there was a specification to assess. A report built without one (insufficient
    /// data) scores 0 by construction — that is missing evidence, not low quality, so it never enters the quality average.</summary>
    private bool _qaAssessed => DashboardQualityAggregate.QaAssessed(_qaHasData, QualitySession.HasResult,
        Available(WorkspaceArtifactType.Specification) && (QualitySession.Report is not { AssessedPacks: 0 }),
        Snapshot.AuditReport?.HasSpecification, Snapshot.ReadinessReport?.HasSpecification);

    /// <summary>The six dashboard quality areas: (assessed?, score). Not-assessed areas lower coverage, never quality.</summary>
    private IReadOnlyList<(bool Assessed, double Score)> _qualityAreas =>
    [
        (Snapshot.TraceabilityReport is not null, _traceabilityScore),
        (Snapshot.ComplianceReport is not null, _complianceScore),
        (_qaAssessed, _qaScore),
        (Snapshot.DeliveryReport is not null, _deliveryScore),
        (_securityReport?.Health.Score is not null, _securityReport?.Health.Score ?? 0),
        (_perfReport?.ReadinessReport is { HasData: true, OverallScore: not null }, _perfReport?.ReadinessReport?.OverallScore ?? 0),
    ];

    /// <summary>Quality among assessed areas only (the denominator is the assessed count). There is no global score over unassessed areas.</summary>
    private DashboardQualityAggregate.Result _quality => DashboardQualityAggregate.Compute(_qualityAreas);

    private double _overallScore => _quality.Quality ?? 0;

    private bool _hasAnyScore => _quality.Quality is not null;

    private string _assessmentCoverageLabel => _quality.CoverageLabel;

    private string _overallScoreLabel => "Quality among assessed: " + (_overallScore >= 80 ? "Healthy" : _overallScore >= 50 ? "Needs Attention" : "At Risk");

    // ── Project phase & governance KPI ────────────────────────────────────────

    private string _projectPhase =>
        _tasksAnalyzed ? "Testing" :
        Available(WorkspaceArtifactType.Plan)          ? "Implementation" :
        Available(WorkspaceArtifactType.Specification) ? "Specification" : "Setup";

    // ── Top risks ─────────────────────────────────────────────────────────────

    private IEnumerable<(string Title, string Severity, string Category, string? Detail)> _topRisks
    {
        get
        {
            var list = new List<(string, string, string, string?)>();
            if (Snapshot.AuditReport is { } ar)
                list.AddRange(ar.Risks
                    .OrderBy(r => r.Severity)
                    .Take(3)
                    .Select(r => (r.Title, r.Severity.ToString(), r.Category.ToString(), r.Mitigation)));
            if (list.Count < 3 && Snapshot.DeliveryReport is { } dr)
                list.AddRange(dr.Blockers
                    .OrderBy(b => b.Severity)
                    .Take(3 - list.Count)
                    .Select(b => (b.Title, b.Severity.ToString(), b.Category, (string?)b.Description)));
            return list.Take(3);
        }
    }

    // ── Top recommendations ───────────────────────────────────────────────────

    private IEnumerable<(string Text, string Category, string ActionHref)> _topRecs
    {
        get
        {
            var list = new List<(string, string, string)>();
            if (Snapshot.AuditReport is { } ar)
                list.AddRange(ar.Recommendations
                    .OrderBy(r => r.Priority)
                    .Take(3)
                    .Select(r => (r.Text, r.Category.ToString(), "quality/document")));
            if (list.Count < 3 && Snapshot.DeliveryReport is { } dr)
                list.AddRange(dr.Recommendations
                    .OrderBy(r => r.Priority)
                    .Take(3 - list.Count)
                    .Select(r => (r.Text, r.Category, "quality/document")));
            return list.Take(3);
        }
    }

