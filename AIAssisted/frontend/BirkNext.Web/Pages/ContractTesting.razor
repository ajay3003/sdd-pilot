@page "/api-quality-review/contracts"
@using BirkNext.ContractTesting
@using BirkNext.ExecutionEvidence
@using BirkNext.SourceDomains
@using BirkNext.Web.Models
@using BirkNext.Web.Components
@inject IServiceProvider Services
@inject IFrontendAnalysisContextFactory ContextFactory
@inject NavigationManager Nav

<PageTitle>Contract Testing</PageTitle>

@* Contract Testing (API Quality Review): import an OpenAPI contract or a GraphQL schema into the registry (immutable versions), explore its operations, generate draft
   tests, bind Test Data pinned by version, check readiness and run through Execution Evidence. Opening anything here never sends a request;
   only "Run selected" does, and only for tests that are Ready. State lives in the URL. *@
<div class="ct" data-testid="ct-page" aria-busy="@(_loading ? "true" : "false")">
    <PageHeader Title="Contract Testing" Description="Import the API contracts Source Analysis found, generate tests and synthetic test data in one step, check what is ready and run it. What was sent and received is saved in Execution Results." />
    <p class="ct-back"><a href="api-quality-review">← API Quality Review</a> · <a href="execution-results">Execution Results</a> · <a href="test-data">Test Data</a> · <a href="integration-suites" data-testid="ct-suites-link">Integration suites</a></p>

    <nav class="ct-workspace" aria-label="Contract Testing workspace" data-testid="ct-workspace">
        @if (_projects is { Count: > 0 } projects)
        {
            <label class="ct-inline ct-project">Project
                <select class="form-control" data-testid="ct-project" value="@(Project ?? "")" @onchange="e => Go(WorkspaceLink(ContractKey is null ? Mode : null, e.Value?.ToString()))">
                    <option value="">All projects</option>
                    @foreach (var p in projects) { <option value="@p.Key">@p.DisplayName · @p.Contracts contract(s)</option> }
                </select>
            </label>
        }
        <span class="ct-modes" aria-label="Workspace">
            @foreach (var (key, label) in Modes)
            {
                var on = ShowWorkspace && Mode == key;
                <a class="ct-mode @(on ? "ct-mode-on" : null)" aria-current="@(on ? "page" : null)" href="@WorkspaceLink(key, Project)" data-testid="ct-mode-@key">@label</a>
            }
        </span>
    </nav>

    @if (_contracts is { Count: > 0 } all)
    {
        <dl class="ct-stats" data-testid="ct-stats">
            <div><dt>Contracts</dt><dd data-testid="ct-stat-contracts">@all.Count</dd></div>
            <div><dt>Operations</dt><dd>@all.Sum(c => c.OperationCount)</dd></div>
            <div><dt>Tests</dt><dd data-testid="ct-stat-tests">@all.Sum(c => c.TestCount)</dd></div>
            <div><dt>Runs against</dt><dd>@(_environment is null ? "no Target Environment" : _environmentName)</dd></div>
        </dl>
    }

    <section class="ct-card ct-env" aria-label="Target Environment" data-testid="ct-env">
        @if (_environment is null) { <p class="ct-muted" data-testid="ct-env-missing">No Target Environment is active. Tests can be explored and prepared; select a Target Environment to run them.</p> }
        else
        {
            <p><strong>Runs against</strong> <span data-testid="ct-env-name">@_environmentName</span> <span class="ct-pill">@_environment.EnvironmentType</span> <code>@_environment.TargetUrl</code></p>
            <details class="ct-run-options"><summary>Base path override for this run</summary>
                <label class="ct-inline">Base path <input data-testid="ct-base-path" @bind="_basePath" @bind:event="oninput" placeholder="(use the contract's binding)" aria-describedby="ct-base-help" /></label>
                <span id="ct-base-help" class="ct-muted">Optional. A path inside this environment (for example /api); hosts are never accepted. The contract's own endpoint and authentication are set per contract.</span>
            </details>
            @if (_attended is { } session)
            {
                <p class="ct-attended" data-testid="ct-attended" data-active="@(session.Active ? "true" : "false")">
                    <strong>Attended session</strong> <span class="ct-muted">(your own sign-in, observed by the Local HTTPS proxy; memory only)</span>:
                    <span data-testid="ct-attended-status">@(session.Active ? $"active · generation {session.Generation} · expires {session.ExpiresAt?.ToLocalTime():HH:mm:ss}" : "none — sign in to the application through the proxy to start one")</span>
                    <button type="button" class="btn btn-secondary" data-testid="ct-attended-refresh" disabled="@_busy" @onclick="RefreshAttendedAsync">Check</button>
                    @if (session.Active) { <button type="button" class="btn btn-secondary" data-testid="ct-attended-end" disabled="@_busy" @onclick="EndAttendedAsync">End attended session</button> }
                </p>
            }
        }
    </section>

    @if (_error is not null) { <p class="ct-error" role="alert" data-testid="ct-error">@_error</p> }
    @if (_message is not null) { <p class="ct-message" role="status" data-testid="ct-message">@_message</p> }

    <div class="ct-layout">
        <aside class="ct-side">
            <section class="ct-card" aria-labelledby="ct-contracts-h" data-testid="ct-contracts">
                <div class="ct-row"><h2 id="ct-contracts-h">Contracts</h2>
                    <a class="btn btn-secondary btn-sm" href="@ImportLink" data-testid="ct-open-import">Import contracts</a></div>
                @if (_contracts is null) { <p class="ct-muted">Loading…</p> }
                else if (_contracts.Count == 0) { <p class="ct-muted" data-testid="ct-contracts-empty">No contracts yet. Import the contracts Source Analysis found, or a file or URL.</p> }
                else
                {
                    @if (_contracts.Count > 5)
                    {
                        <input type="search" class="form-control ct-search" placeholder="Search contracts" aria-label="Search contracts" data-testid="ct-contract-search" @bind="_contractFilter" @bind:event="oninput" />
                    }
                    @foreach (var group in _contracts.Where(c => Matches(_contractFilter, c.Name, c.Key)).GroupBy(c => c.Protocol).OrderBy(g => g.Key))
                    {
                        <h3 class="ct-group-h">@(group.Key == ApiContractProtocol.GraphQl ? "GraphQL" : "REST") <span class="ct-muted">@group.Count()</span></h3>
                        <ul class="ct-list">
                            @foreach (var c in group)
                            {
                                <li class="@(c.Key == ContractKey ? "ct-selected" : null)"><a href="@Link(contract: c.Key, version: null, view: "operations", test: null)" data-testid="ct-contract-link" aria-current="@(c.Key == ContractKey ? "page" : null)">@c.Name</a>
                                    <span class="ct-muted">@(c.Protocol == ApiContractProtocol.GraphQl ? "GraphQL" : "REST") · v@(c.LatestVersion) · @c.OperationCount operations · @c.TestCount tests</span>
                                    @if (c.Lifecycle != ContractLifecycle.Active) { <span class="ct-pill" data-testid="ct-contract-lifecycle">@c.Lifecycle</span> }
                                    @if (c.IdentityState == "NeedsReview") { <span class="ct-pill ct-src-changed" data-testid="ct-contract-identity">identity needs review</span> }</li>
                            }
                        </ul>
                    }
                }
            </section>
        </aside>

        <main class="ct-main">
            @if (ShowWorkspace && Mode == "configure") { @ConfigureView() }
            else if (ShowWorkspace && Mode == "coverage") { @ProjectCoverageView() }
            @if (ShowImport)
            {
            <section class="ct-card" aria-labelledby="ct-import-h" data-testid="ct-import">
                <h2 id="ct-import-h">Import contracts</h2>
                <fieldset class="ct-radios ct-segmented">
                    <legend class="visually-hidden">Source</legend>
                    <label><input type="radio" name="ct-src" checked="@_importFromSource" @onchange="LoadSourceContractsAsync" data-testid="ct-import-source-mode" /> From Source Analysis</label>
                    <label><input type="radio" name="ct-src" checked="@(!_importByUrl && !_importFromSource)" @onchange="FileMode" data-testid="ct-import-file-mode" /> File</label>
                    <label><input type="radio" name="ct-src" checked="@(_importByUrl && !_importFromSource)" @onchange="UrlMode" data-testid="ct-import-url-mode" /> URL</label>
                </fieldset>
                @if (_importFromSource)
                {
                    @SourceImport()
                }
                else if (_importByUrl)
                {
                    <label class="ct-field">Document URL <input data-testid="ct-import-url" @bind="_importUrl" @bind:event="oninput" placeholder="http://localhost:5288/openapi.json" /></label>
                    <p class="ct-muted">Fetched once without credentials; link-local and cloud-metadata addresses are refused.</p>
                }
                else
                {
                    <label class="ct-field">Contract file <InputFile OnChange="PickFile" accept=".json,.yaml,.yml,.graphql,.graphqls,.gql" data-testid="ct-import-file" /></label>
                    <p class="ct-muted">OpenAPI 3 or Swagger 2 (JSON or YAML), or a GraphQL schema (SDL or an introspection result as JSON).</p>
                    @if (_importFileName is not null) { <p class="ct-muted" data-testid="ct-import-picked">@_importFileName (@(_importContent?.Length ?? 0) characters)</p> }
                }
                @if (!_importFromSource)
                {
                    @if (string.IsNullOrEmpty(_importTarget))
                    {
                        <label class="ct-field">Name <span class="ct-muted">(optional; default: the document's title)</span><input data-testid="ct-import-name" @bind="_importName" @bind:event="oninput" maxlength="200" /></label>
                    }
                    <label class="ct-field">Add as
                        <select data-testid="ct-import-target" @bind="_importTarget">
                            <option value="">a new contract</option>
                            @foreach (var c in _contracts ?? []) { <option value="@c.Key">the next version of @c.Name</option> }
                        </select>
                    </label>
                    <button class="btn btn-primary" data-testid="ct-import-submit" disabled="@(_busy || (_importByUrl ? string.IsNullOrWhiteSpace(_importUrl) : _importContent is null))" @onclick="ImportAsync">Import</button>
                }
            </section>
            }
            @if (_detail is null)
            {
                @if (ContractKey is not null) { <section class="ct-card"><p class="ct-muted" data-testid="ct-no-contract">@(_loading ? "Loading…" : "Contract not found.")</p></section> }
            }
            else
            {
                var d = _detail;
                var info = d.Versions.FirstOrDefault(v => v.Version == d.Version);
                <section class="ct-card" aria-labelledby="ct-detail-h" data-testid="ct-detail">
                    <h2 id="ct-detail-h">@d.Contract.Name <span class="ct-muted">@d.Contract.Key</span></h2>
                    <div class="ct-facts">
                        <label class="ct-inline">Version
                            <select data-testid="ct-version" value="@d.Version" @onchange="e => Go(Link(version: int.Parse(e.Value!.ToString()!)))">
                                @foreach (var v in d.Versions.Where(v => !v.Hidden || v.Version == d.Version)) { <option value="@v.Version">v@(v.Version)@(v.Version == d.Contract.LatestVersion ? " (latest)" : "")@(v.Hidden ? " (hidden)" : "")</option> }
                            </select>
                        </label>
                        @if (info is not null)
                        {
                            <span data-testid="ct-version-source">@(info.Source switch { ContractVersionSource.Url => "From URL", ContractVersionSource.SourceSnapshot => "From Source Analysis", _ => "Uploaded" }) · @info.SourceLabel · @info.Format.ToUpperInvariant() · @info.ImportedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                            <span class="ct-muted" title="SHA-256 of the imported document">#@(info.Sha256.Length > 12 ? info.Sha256[..12] : info.Sha256)</span>
                            <span class="ct-pill" data-testid="ct-parse">@(info.ParseSupport == DomainSupport.Supported ? "Fully read" : "Partly read")</span>
                            <span class="ct-pill" data-testid="ct-validation-depth" title="@(info.HasDocument ? "The document text is kept: requests and responses are validated against the full schema." : "Only the parsed contract is kept: responses get a structural (type) check. Re-import the project to get full validation.")">@(info.HasDocument ? "Full schema validation" : "Structural validation")</span>
                        }
                        <a href="@SuiteLink(info)" data-testid="ct-suite-handoff">Build an integration suite →</a>
                    </div>
                    @if (info?.Limitations is { Count: > 0 } limits) { <p class="ct-muted" data-testid="ct-limitations">@string.Join(" ", limits)</p> }
                    @if (d.Contract.IdentityState == "NeedsReview") { @IdentityBanner(d) }
                    @if (d.Contract.Lifecycle == ContractLifecycle.Archived) { <p class="ct-error" data-testid="ct-archived">Archived: read-only. Versions, tests and results are kept; nothing can be imported, generated or run until it is made active again.</p> }
                    else if (d.Contract.Lifecycle == ContractLifecycle.Deprecated) { <p class="ct-message" data-testid="ct-deprecated">Deprecated: tests still run, with a readiness warning.</p> }
                    <ContractEndpointPanel ContractKey="@d.Contract.Key" Protocol="@d.Contract.Protocol" EnvironmentId="@_environment?.EnvironmentId" Changed="ReloadAsync" />

                    <div role="tablist" aria-label="Contract views" class="ct-tabs">
                        @foreach (var (key, label) in Views)
                        {
                            <a role="tab" href="@Link(view: key, test: null)" aria-selected="@(View == key ? "true" : "false")" tabindex="@(View == key ? "0" : "-1")"
                               data-testid="ct-tab-@key" class="ct-tab @(View == key ? "ct-tab-on" : null)">@label@(key == "tests" && _tests is not null ? $" ({_tests.Count})" : "")</a>
                        }
                    </div>
                </section>

                @if (View == "operations") { @OperationsView(d) }
                else if (View == "tests") { @TestsView(d) }
                else if (View == "chains") { @ChainsView(d) }
                else if (View == "coverage") { @CoverageView(d) }
                else if (View == "lifecycle") { @LifecycleView(d) }
                else { @ChangesView(d) }
            }
        </main>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "contract")] public string? ContractKey { get; set; }
    [SupplyParameterFromQuery(Name = "v")] public int? VersionQuery { get; set; }
    [SupplyParameterFromQuery(Name = "view")] public string? ViewQuery { get; set; }
    [SupplyParameterFromQuery(Name = "test")] public Guid? TestId { get; set; }
    [SupplyParameterFromQuery(Name = "from")] public int? FromQuery { get; set; }
    [SupplyParameterFromQuery(Name = "import")] public bool? ImportQuery { get; set; }

    /// <summary>The import panel: always when no contract is open (also the empty start), or on request next to an open contract.</summary>
    [SupplyParameterFromQuery(Name = "mode")] public string? ModeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "project")] public string? Project { get; set; }
    [SupplyParameterFromQuery(Name = "keys")] public string? KeysQuery { get; set; }

    private static readonly (string Key, string Label)[] Modes = [("import", "Import"), ("configure", "Configure environment"), ("coverage", "Project coverage")];
    /// <summary>The workspace (import, bulk configuration, project coverage) shows when no contract is open, or on request next to one.</summary>
    private bool ShowWorkspace => ContractKey is null || ImportQuery == true || ModeQuery is not null;
    private string Mode => ModeQuery is "configure" or "coverage" ? ModeQuery : "import";
    private bool ShowImport => ShowWorkspace && Mode == "import";
    private string ImportLink => WorkspaceLink("import", Project);
    private IReadOnlyList<ContractProject>? _projects;
    /// <summary>The selected project, or the only one there is.</summary>
    private string? EffectiveProject => Project ?? _keysProject ?? (_projects is { Count: 1 } one ? one[0].Key : null);
    /// <summary>The project of the contracts a hand-off preselected (Integration Suite → Resolve environment blockers).</summary>
    private string? _keysProject;

    private static string WorkspaceLink(string? mode, string? project) =>
        "api-quality-review/contracts" + (mode is null && string.IsNullOrEmpty(project) ? "" : "?" + string.Join('&', new[]
        {
            mode is null ? null : $"mode={mode}", string.IsNullOrEmpty(project) ? null : $"project={Uri.EscapeDataString(project)}",
        }.Where(x => x is not null)));
    private string _contractFilter = "", _sourceFilter = "", _sourceState = "all", _testFilter = "", _testState = "all", _opFilter = "";
    private bool _bulkGenerate = true, _breakingOnly;
    private readonly HashSet<string> _sourceSelected = [];
    private SourceContractBulkImportResult? _bulkResult;

    private static bool Matches(string filter, params string?[] values) =>
        string.IsNullOrWhiteSpace(filter) || values.Any(v => v?.Contains(filter.Trim(), StringComparison.OrdinalIgnoreCase) == true);

    private static string SourceKey(SourceContractCandidate c) => $"{c.SnapshotId:N}|{c.ContractId}";

    /// <summary>The module of a source-backed version ("openapi:Autorisasjon/autodoc/openapi.yaml" → Autorisasjon).</summary>
    private static string? SourceModule(string? sourcePath)
    {
        if (sourcePath is null) return null;
        var path = sourcePath[(sourcePath.IndexOf(':') + 1)..].Replace('\\', '/');
        var parts = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 1 ? parts[0] : null;
    }

    /// <summary>Hand-off to the Integration Suite Generator: the snapshot and module this version came from, preselected (generation stays explicit there).</summary>
    private static string SuiteLink(ApiContractVersionInfo? info) =>
        info?.SourceSnapshotId is { } snapshot
            ? $"integration-suites?snapshot={snapshot:D}&scope=api" + (SourceModule(info.SourcePath) is { } module ? $"&modules={Uri.EscapeDataString(module)}" : "")
            : "integration-suites";

    private IEnumerable<SourceContractCandidate> VisibleSources => (_sourceContracts ?? []).Where(c => Matches(_sourceFilter, c.Name, c.File, c.Module)
        && (_sourceState == "all" || (_sourceState == "actionable" ? Actionable(c) : c.State.ToString() == _sourceState)));

    private static string StateLabel(SourceContractCandidate c) => c.State switch
    {
        SourceContractCandidateState.New => "New",
        SourceContractCandidateState.Changed => $"Changed → v{(c.ContractVersion ?? 0) + 1} of {c.ContractKey}",
        SourceContractCandidateState.Archived => $"Archived ({c.ContractKey})",
        SourceContractCandidateState.Moved => $"Moved: same document as {c.ContractKey}",
        SourceContractCandidateState.NeedsReview => c.Identity switch
        {
            ContractIdentityClassification.MovedChanged => "Possibly moved and changed: review",
            ContractIdentityClassification.Ambiguous => "Several possible matches: review",
            _ => "Possible match: review",
        },
        _ => c.ImportedAs is { } done ? $"Up to date ({done})" : "Up to date",
    };

    private void ToggleSource(SourceContractCandidate c, bool on) { if (on) _sourceSelected.Add(SourceKey(c)); else _sourceSelected.Remove(SourceKey(c)); }

    private void ToggleGroup(IEnumerable<SourceContractCandidate> group, bool on)
    {
        foreach (var c in group.Where(Actionable)) ToggleSource(c, on);
    }

    /// <summary>Imports the selected source contracts (new ones and new versions), then generates their tests and test data in the same step.</summary>
    private async Task BulkImportAsync()
    {
        if (Api is not { } api || _sourceContracts is null) return;
        var items = _sourceContracts.Where(c => _sourceSelected.Contains(SourceKey(c))).Select(c => new SourceContractRef(c.SnapshotId, c.ContractId)).ToList();
        if (items.Count == 0) return;
        _busy = true; _error = null; _message = null; _bulkResult = null;
        var (result, error) = await api.ImportFromSourceBulkAsync(new SourceContractBulkImportRequest
            { Items = items, GenerateTests = _bulkGenerate, GenerateTestData = _bulkGenerate, EnvironmentId = _environment?.EnvironmentId });
        _busy = false;
        if (result is null) { _error = error ?? "Nothing was imported."; return; }
        _bulkResult = result;
        _sourceSelected.Clear();
        var tests = result.Items.Sum(i => i.TestsCreated);
        var bound = result.Items.Sum(i => i.DataBound);
        var review = result.Items.Sum(i => i.DataNeedsReview + i.DataUnresolved + i.DataFailed);
        _message = $"{result.Imported} contract(s) imported or updated, {result.Unchanged} unchanged, {result.Failed} failed."
            + (_bulkGenerate ? $" {tests} test(s) generated; test data bound automatically for {bound} operation(s), {review} need a value or a review." : " Tests were not generated.")
            + " Nothing was sent to any API.";
        (_contracts, _) = await api.ProjectContractsAsync(Project);
        (_sourceContracts, _) = await api.ProjectSourceContractsAsync(Project);
    }

    private RenderFragment SourceImport() => __builder =>
    {
        if (_sourceContracts is null) { <p class="ct-muted">Loading the contracts Source Analysis found…</p> return; }
        if (_sourceContracts.Count == 0)
        {
            <p class="ct-muted" data-testid="ct-source-none">No OpenAPI or GraphQL schema contract was found in Source Analysis snapshots. <a href="project-import">Import the project</a> first, or import a file or URL.</p>
            return;
        }
        var counts = _sourceContracts.GroupBy(c => c.State).ToDictionary(g => g.Key, g => g.Count());
        <p class="ct-muted" data-testid="ct-source-summary">@_sourceContracts.Count contract(s) in @_sourceContracts.Select(c => c.Module).Distinct().Count() module(s): @counts.GetValueOrDefault(SourceContractCandidateState.New) new,
            @counts.GetValueOrDefault(SourceContractCandidateState.Changed) changed, @counts.GetValueOrDefault(SourceContractCandidateState.UpToDate) up to date. Only the newest snapshot of each file is listed.</p>
        <div class="ct-filterbar">
            <input type="search" class="form-control ct-search" placeholder="Search name, file or module" aria-label="Search source contracts" data-testid="ct-source-search" @bind="_sourceFilter" @bind:event="oninput" />
            <label class="ct-inline">Show
                <select class="form-control" data-testid="ct-source-state" @bind="_sourceState">
                    <option value="all">All</option><option value="actionable">New and changed</option><option value="UpToDate">Up to date</option><option value="Archived">Archived</option>
                </select>
            </label>
        </div>
        var visible = VisibleSources.ToList();
        if (visible.Count == 0) { <p class="ct-muted" data-testid="ct-source-filtered">No contract matches. @(_sourceState == "actionable" ? "Everything found is already imported and up to date — choose Show: All to see it." : "")</p> }
        <div class="ct-groups" data-testid="ct-source-list">
            @foreach (var group in visible.GroupBy(c => c.Module))
            {
                var selectable = group.Where(Actionable).ToList();
                <details class="ct-group" open="@(visible.Count <= 40)" data-testid="ct-source-group" data-module="@group.Key">
                    <summary>
                        @if (selectable.Count > 0)
                        {
                            <input type="checkbox" aria-label="@($"Select every new or changed contract in {group.Key}")" data-testid="ct-source-group-select"
                                   checked="@selectable.All(c => _sourceSelected.Contains(SourceKey(c)))" @onchange="e => ToggleGroup(group, e.Value is true)" />
                        }
                        <strong>@group.Key</strong> <span class="ct-muted">@group.Count() contract(s) · @group.Sum(c => c.OperationCount) operations</span>
                    </summary>
                    <ul class="ct-list">
                        @foreach (var c in group)
                        {
                            var actionable = Actionable(c);
                            <li data-testid="ct-source-contract" data-file="@c.File" data-state="@c.State" class="ct-source-row">
                                <span class="ct-source-name">
                                    @if (actionable) { <input type="checkbox" aria-label="@($"Select {c.Name} ({c.File})")" data-testid="ct-source-select" checked="@_sourceSelected.Contains(SourceKey(c))" @onchange="e => ToggleSource(c, e.Value is true)" /> }
                                    <strong>@c.Name</strong> <span class="ct-pill">@(c.Type == "OpenApi" ? "REST" : "GraphQL")</span>
                                    <span class="ct-pill ct-src-@c.State.ToString().ToLowerInvariant()" data-testid="ct-source-state-pill">@StateLabel(c)</span>
                                </span>
                                <span class="ct-muted">@SourceFacts(c)@(c.HasDocument ? "" : " · structural validation only")</span>
                                @if (!actionable && c.ImportedAs is { } done) { <span class="ct-muted" data-testid="ct-source-imported">Imported as @done</span> }
                                else if (actionable) { <button class="btn btn-link btn-sm" data-testid="ct-source-import" disabled="@_busy" @onclick="() => ImportSourceAsync(c)">Import only this one</button> }
                                @if (c.State == SourceContractCandidateState.NeedsReview) { @IdentityReview(c) }
                            </li>
                        }
                    </ul>
                </details>
            }
        </div>
        <div class="ct-row ct-runbar ct-sticky" data-testid="ct-bulk-bar">
            <label class="ct-inline"><input type="checkbox" data-testid="ct-bulk-generate" @bind="_bulkGenerate" /> Generate tests and synthetic test data right away</label>
            <button class="btn btn-primary" data-testid="ct-bulk-import" disabled="@(_busy || _sourceSelected.Count == 0)" @onclick="BulkImportAsync">Import selected (@_sourceSelected.Count)</button>
            @if (selectableCount(visible) > 0) { <button class="btn btn-link btn-sm" data-testid="ct-source-select-all" @onclick="() => ToggleGroup(visible, true)">Select all shown</button> }
        </div>
        <p class="ct-muted">A changed file becomes the next version of the contract it was imported as; existing tests stay on their version until you review the update. Nothing is sent to any API.</p>
        if (_bulkResult is { } r) { @BulkResult(r) }
    };

    /// <summary>Importable: not in the registry yet, or changed since its latest version (and not already imported from this very snapshot).</summary>
    private static bool Actionable(SourceContractCandidate c) => c.ImportedAs is null && c.State is SourceContractCandidateState.New or SourceContractCandidateState.Changed or SourceContractCandidateState.Moved;

    private static int selectableCount(IEnumerable<SourceContractCandidate> list) => list.Count(Actionable);

