    private async Task GenerateAsync(IReadOnlyList<string>? operations)
    {
        if (Api is not { } api || _detail is null) return;
        _busy = true; _error = null; _message = null;
        var (created, skipped, error) = await api.GenerateAsync(_detail.Contract.Key, _detail.Version, operations);
        if (error is not null) { _busy = false; _error = error; return; }
        var notTestable = skipped.Count(s => !s.EndsWith(": already exists.", StringComparison.Ordinal));
        _message = (created > 0 ? $"{created} draft test(s) generated from v{_detail.Version}." : "No new tests: every operation already has its tests.")
            + (notTestable > 0 ? $" {notTestable} operation(s) cannot be tested by a contract test (for example subscriptions)." : "");
        _opSelected.Clear();
        // The tests' input values come with them: generated from the contract, validated, and pinned when certain (never on page load).
        await GenerateDataAsync(operations, keepMessage: true);
        _busy = false;
        Go(Link(view: "tests", test: null));
    }

    private ContractTestDataReport? _dataReport;

    /// <summary>Typed synthetic test data for the tests of this version; reports per operation what was bound and what needs a human.</summary>
    private async Task GenerateDataAsync(IReadOnlyList<string>? operations, bool keepMessage = false)
    {
        if (Api is not { } api || _detail is null) return;
        _busy = true;
        if (!keepMessage) { _error = null; _message = null; }
        var (report, error) = await api.GenerateTestDataAsync(_detail.Contract.Key, _detail.Version, operations);
        _busy = false;
        if (report is null) { _error = error; return; }
        _dataReport = report;
        var review = report.Operations.Count(o => o.State is ContractTestDataState.NeedsReview or ContractTestDataState.Unresolved);
        var dataMessage = $"Test data: {report.Bound} operation(s) bound automatically" + (review > 0 ? $", {review} need a value or a review (listed below)." : ".");
        _message = keepMessage && _message is not null ? $"{_message} {dataMessage}" : dataMessage;
        if (!keepMessage) await ReloadAsync();
    }

