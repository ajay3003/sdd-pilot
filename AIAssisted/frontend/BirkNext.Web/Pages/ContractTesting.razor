    /// <summary>Reads the attended session's metadata (never the credential). A host without the proxy shows nothing.</summary>
    private async Task RefreshAttendedAsync()
    {
        if (Proxy is not { } proxy || AttendedRequest is not { } request) return;
        try { _attended = await proxy.AttendedSessionAsync(request); }
        catch (Exception e) when (e is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { _attended = null; }
    }

    private async Task EndAttendedAsync()
    {
        if (Proxy is not { } proxy || AttendedRequest is not { } request) return;
        _busy = true;
        try { _attended = await proxy.EndAttendedSessionAsync(request); _message = _attended.Message; }
        catch (Exception e) when (e is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { _error = "The attended session could not be ended: the proxy service did not answer."; }
        _busy = false;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var context = await ContextFactory.GetActiveContextAsync();
            if (context.ActiveProfileOrNull is { } profile && !string.IsNullOrWhiteSpace(context.TargetUrl))
            {
                _environmentName = profile.Name;
                // The non-secret proxy identity (profile + context fingerprint) lets the backend find the attended session; it never carries a token.
                var identity = ReviewAuthenticationIdentity.ForContext(context);
                _environment = new ContractTestEnvironment
                {
                    EnvironmentId = profile.Id, TargetUrl = context.TargetUrl, EnvironmentType = profile.EnvironmentType.ToString(), IsProduction = profile.EnvironmentType == FrontendEnvironmentType.Production,
                    ProfileId = identity.ProfileId, ContextFingerprint = identity.ContextFingerprint,
                };
            }
        }
        catch (Exception) { _environment = null; }
        await RefreshAttendedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true; _error = null;
        if (Api is not { } api) { _error = "Contract Testing is not available in this host."; _loading = false; return; }
        if (_projects is null) (_projects, _) = await api.ProjectsAsync();
        (_contracts, _error) = await api.ProjectContractsAsync(Project);
        if (ShowImport && _importFromSource && (_sourceContracts is null || _sourceProject != Project))
        { (_sourceContracts, var sourceError) = await api.ProjectSourceContractsAsync(Project); _sourceProject = Project; _error ??= sourceError; }
        if (ShowWorkspace && Mode == "configure") PrepareConfigure();
        if (ShowWorkspace && Mode == "coverage" && EffectiveProject is { } coverageProject) (_projectCoverage, _error) = await api.ProjectCoverageAsync(coverageProject, _environment);
        _detail = null; _tests = null; _options = null; _diff = null; _coverage = null; _retention = null;
        if (ContractKey is { } key && _error is null)
        {
            (_detail, _error) = await api.ContractAsync(key, VersionQuery);
            if (_detail is not null)
            {
                (_tests, var testsError) = await api.TestsAsync(key, _environment);
                _error ??= testsError;
                _selected.RemoveWhere(id => _tests?.All(t => t.Test.Id != id) != false);
                if (TestId is { } id && _tests?.Any(t => t.Test.Id == id) == true) (_options, _error) = await api.DatasetsAsync(id, _environment?.EnvironmentId);
                if (View == "coverage") (_coverage, _error) = await api.CoverageAsync(key, _detail.Version);
                if (View == "chains") (_chains, _error) = await api.ChainsAsync();
                if (View == "lifecycle") (_retention, _error) = await api.RetentionAsync(key);
                if (View == "changes" && _detail.Versions.Count > 1)
                {
                    var to = _detail.Version;
                    var from = FromQuery is { } f && f != to ? f : _detail.Versions.Where(v => v.Version < to).Select(v => (int?)v.Version).Max() ?? _detail.Versions.Min(v => v.Version);
                    if (from != to) (_diff, _error) = await api.DiffAsync(key, Math.Min(from, to), Math.Max(from, to));
                }
            }
        }
        _loading = false;
    }

    private string Link(string? contract = "\0", int? version = -1, string? view = "\0", Guid? test = null, int? from = null)
    {
        var q = new List<string>();
        var c = contract == "\0" ? ContractKey : contract;
        if (c is not null) q.Add($"contract={Uri.EscapeDataString(c)}");
        var v = version == -1 ? VersionQuery : version;
        if (v is not null) q.Add($"v={v}");
        var w = view == "\0" ? ViewQuery : view;
        if (w is not null) q.Add($"view={w}");
        if (test is not null) q.Add($"test={test}");
        if (from is not null) q.Add($"from={from}");
        if (!string.IsNullOrEmpty(Project)) q.Add($"project={Uri.EscapeDataString(Project)}");
        return "api-quality-review/contracts" + (q.Count > 0 ? "?" + string.Join('&', q) : "");
    }

    private void Go(string link) => Nav.NavigateTo(link);

    /// <summary>After an edit, revert or duplicate: reload the open test, or open the new one.</summary>
    private async Task OpenTestAsync(Guid id)
    {
        if (id == TestId) await ReloadAsync();
