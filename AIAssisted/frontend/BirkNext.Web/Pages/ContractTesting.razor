                <div><dt>Ready</dt><dd data-testid="ct-count-ready">@ready</dd></div>
                <div><dt>Not ready</dt><dd>@(_tests.Count - ready - blocked)</dd></div>
                <div><dt>Blocked</dt><dd>@blocked</dd></div>
                <div><dt>Never run</dt><dd>@_tests.Count(t => t.Last is null)</dd></div>
