    /// <summary>Applies the reviewed proposal as a new revision; the old revision and its executions stay bound to the old contract version.</summary>
    private async Task ApplyProposalAsync(ContractTestDefinition test)
    {
        if (Api is not { } api) return;
        _busy = true; _error = null; _message = null;
        var (result, error) = await api.ApplyMigrationAsync(test.Id, test.Revision);
        _busy = false;
        if (result is { Saved: true }) { _proposal = null; _message = result.Message; await ReloadAsync(); }
        else _error = result?.Message ?? error;
    }

    /// <summary>What the operation's tests need before they can run, from the tests themselves (never recomputed here).</summary>
    private (string Label, string State) OperationData(string operation)
    {
        var tests = _tests?.Where(t => t.Test.Operation == operation && t.Test.ReviewState != ContractTestReviewState.Retired).ToList() ?? [];
        if (tests.Count == 0) return ("no tests", "none");
        var positive = tests.Where(t => t.Test.Kind == ContractTestKind.Positive).ToList();
        if (positive.Count > 0 && positive.All(t => t.Test.Inputs.All(i => !i.Required))) return ("no input needed", "ok");
        if (positive.Count > 0 && positive.All(t => t.Test.Binding is not null)) return ($"bound · {positive[0].Test.Binding!.Alias}", "ok");
        var missing = positive.SelectMany(t => t.Readiness.MissingValues).Distinct(StringComparer.Ordinal).ToList();
        return (missing.Count > 0 ? $"needs {string.Join(", ", missing.Take(3))}{(missing.Count > 3 ? "…" : "")}" : "not bound", "missing");
    }

    private static bool MutatingOperation(ContractOperation op) =>
        op.Kind == "mutation" || op.Kind.ToUpperInvariant() is "POST" or "PUT" or "PATCH" or "DELETE";

    private readonly HashSet<string> _opSelected = new(StringComparer.Ordinal);

    private RenderFragment OperationsView(ApiContractDetail d) => __builder =>
    {
        var ops = d.Document.Operations.Where(o => Matches(_opFilter, o.Name, o.Summary, o.OperationId)).ToList();
        var untested = d.Document.Operations.Count(o => _tests?.Any(t => t.Test.Operation == o.Name) != true);
        <section class="ct-card" aria-labelledby="ct-ops-h" data-testid="ct-operations">
        <div class="ct-row">
            <h3 id="ct-ops-h">Operations in v@(d.Version) <span class="ct-muted">@d.Document.Operations.Count · @untested without tests</span></h3>
            <span class="ct-actions">
                @if (_opSelected.Count > 0) { <button class="btn btn-secondary" data-testid="ct-generate-selected" disabled="@_busy" @onclick="() => GenerateAsync([.. _opSelected])">Generate for selected (@_opSelected.Count)</button> }
                <button class="btn btn-primary" data-testid="ct-generate-all" disabled="@_busy" @onclick="() => GenerateAsync(null)">Generate tests and test data</button>
            </span>
        </div>
        <p class="ct-muted">Generating creates draft tests for every operation and synthetic test data from the contract; it never sends a request. Data-changing operations are marked and run only with an explicit confirmation.</p>
        @if (d.Document.Operations.Count == 0) { <p class="ct-muted">This version declares no operations.</p> }
        else
        {
            @if (d.Document.Operations.Count > 8)
            {
                <div class="ct-filterbar"><input type="search" class="form-control ct-search" placeholder="Search operations" aria-label="Search operations" data-testid="ct-op-search" @bind="_opFilter" @bind:event="oninput" /></div>
            }
            <div class="ct-scroll">
                <table class="ct-table" data-testid="ct-op-table">
                    <caption class="visually-hidden">Operations, with the values they need, their documented responses, tests and test data</caption>
                    <thead><tr><th scope="col"><span class="visually-hidden">Select</span></th><th scope="col">Operation</th><th scope="col">Inputs</th><th scope="col">Request body</th><th scope="col">Responses</th><th scope="col">Security</th><th scope="col">Tests · data</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
                    <tbody>
                        @foreach (var op in ops)
                        {
                            var count = _tests?.Count(t => t.Test.Operation == op.Name) ?? 0;
                            var (dataLabel, dataState) = OperationData(op.Name);
                            <tr data-testid="ct-op-row" data-op="@op.Name" data-data="@dataState">
                                <td><input type="checkbox" aria-label="@($"Select {op.Name}")" data-testid="ct-op-select" checked="@_opSelected.Contains(op.Name)" @onchange="e => { if (e.Value is true) _opSelected.Add(op.Name); else _opSelected.Remove(op.Name); }" /></td>
                                <th scope="row"><code>@op.Name</code>@if (MutatingOperation(op)) { <span class="ct-pill ct-mutating" data-testid="ct-op-mutating" title="Runs only with the explicit data-changing confirmation">changes data</span> }@if (op.Deprecated) { <span class="ct-pill">deprecated</span> }
                                    @if (op.Summary is { } s) { <div class="ct-muted">@s</div> }@if (op.OperationId is { } id) { <div class="ct-muted">operationId @id</div> }</th>
                                <td>@if (op.ParameterDetails.Count == 0) { <span class="ct-muted">none</span> } else { @foreach (var p in op.ParameterDetails) { <div>@p.Name <span class="ct-muted">@p.In@(p.Type is null ? "" : " · " + p.Type)@(p.Required ? " · required" : "")</span></div> } }</td>
                                <td>@if (op.RequestContentTypes.Count == 0) { <span class="ct-muted">none</span> } else { <span>@(op.RequestSchema ?? "body")</span> <span class="ct-muted">@string.Join(", ", op.RequestContentTypes)@(op.RequestBodyRequired ? " · required" : "")</span> }</td>
                                <td>@(op.ResultType is { } result ? $"returns {result}" : string.Join(", ", op.ResponseCodes.Select(c => op.ResponseSchemas.TryGetValue(c, out var schema) ? $"{c} {schema}" : c)))</td>
                                <td>@(op.Security.Count == 0 ? "none" : string.Join(", ", op.Security))</td>
                                <td><span data-testid="ct-op-tests">@count</span> <span class="ct-state ct-data-@dataState" data-testid="ct-op-data">@dataLabel</span></td>
                                <td class="ct-actions"><button class="btn btn-secondary btn-sm" data-testid="ct-generate-op" disabled="@_busy" @onclick="() => GenerateAsync([op.Name])" aria-label="@($"Generate tests for {op.Name}")">Generate</button>
                                    <button class="btn btn-link btn-sm" data-testid="ct-propose-op" disabled="@_busy" @onclick="() => ProposeAsync(op.Name)" aria-label="@($"Propose negative tests for {op.Name}")">Propose negatives</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        </section>
    };

    /// <summary>Run options shared by test runs and chain runs: rows, execution limit, stop policy and the attended re-sign-in wait.</summary>
    private RenderFragment RunOptions() => @<details class="ct-run-options" data-testid="ct-run-options">
        <summary>Run options</summary>
        <div class="ct-row">
            <label class="ct-inline"><input type="checkbox" data-testid="ct-stop-on-failure" @bind="_stopOnFailure" /> Stop at the first failure (the remaining calls are skipped, never sent)</label>
            <label class="ct-inline">Only these dataset rows <input class="form-control" data-testid="ct-row-ids" placeholder="all rows (e.g. r-001, r-007)" @bind="_rowIds" @bind:event="oninput" /></label>
            <label class="ct-inline">At most <input type="number" min="1" max="500" class="form-control ct-narrow" data-testid="ct-max-executions" @bind="_maxExecutions" /> executions</label>
            <label class="ct-inline">If the attended session expires, wait up to <input type="number" min="0" max="900" class="form-control ct-narrow" data-testid="ct-reauth-wait" @bind="_reauthWait" /> s for a new sign-in</label>
        </div>
        <p class="ct-muted">A data-driven test runs once per dataset row; rows beyond the limit are listed as not run. A run never falls back to sending without authentication.</p>
    </details>;

