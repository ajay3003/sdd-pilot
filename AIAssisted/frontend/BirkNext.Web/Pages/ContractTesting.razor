                    <ul class="ct-checks">
                        @foreach (var b in blockers)
                        {
                            <li data-testid="ct-blocker" data-area="@b.Area"><span class="ct-state ct-item-@b.State.ToString().ToLowerInvariant()">@b.State</span> <strong>@b.Area</strong> · @b.Tests test(s) — <span class="ct-muted">@b.Example</span></li>
                        }
                    </ul>
                    <p class="ct-muted">Endpoint and authentication are set per contract above; Test Data values in <a href="test-data">Test Data</a> (generated sets are listed under Generate test data).</p>
                </details>
            }
            <div class="ct-filterbar">
                <input type="search" class="form-control ct-search" placeholder="Search tests or operations" aria-label="Search tests" data-testid="ct-test-search" @bind="_testFilter" @bind:event="oninput" />
                <label class="ct-inline">Show
                    <select class="form-control" data-testid="ct-test-filter" @bind="_testState">
                        <option value="all">All tests</option><option value="ready">Ready</option><option value="notready">Not ready</option><option value="blocked">Blocked</option>
                        <option value="data">Missing test data</option><option value="positive">Positive</option><option value="negative">Negative</option><option value="mutating">Changes data</option><option value="impacted">Affected by a newer version</option>
                    </select>
                </label>
            </div>
            <div class="ct-row ct-runbar" data-testid="ct-runbar">
                <label class="ct-inline"><input type="checkbox" data-testid="ct-select-ready" checked="@(VisibleTests.Where(t => t.Readiness.State == ContractTestReadinessState.Ready && (_confirmMutating || !ExecutionRunService_Mutating(t.Test))).All(t => _selected.Contains(t.Test.Id)) && _selected.Count > 0)"
                    @onchange="SelectReady" /> Select every ready test@(_confirmMutating ? "" : " (read-only)")</label>
                <label class="ct-inline"><input type="checkbox" data-testid="ct-confirm-mutating" @bind="_confirmMutating" /> Confirm data-changing calls (POST, PUT, PATCH, DELETE, mutations) for this run</label>
                <button class="btn btn-primary" data-testid="ct-run" disabled="@(_busy || _environment is null || _selected.Count == 0)" @onclick="RunAsync">Run selected (@_selected.Count)</button>
                @if (mutatingSelected > 0 && !_confirmMutating) { <span class="ct-missing" data-testid="ct-mutating-warning">@mutatingSelected selected test(s) change data: they are not sent unless you confirm data-changing calls.</span> }
                @if (_runId is { } runId) { <a data-testid="ct-run-link" href="@($"execution-results?run={runId}")">Open the run in Execution Results →</a> }
            </div>
            @RunOptions()
            <div class="ct-scroll">
                <table class="ct-table" data-testid="ct-test-table">
                    <caption class="visually-hidden">Contract tests with readiness, contract impact and the latest result</caption>
                    <thead><tr><th scope="col"><span class="visually-hidden">Select</span></th><th scope="col">Test</th><th scope="col">Readiness</th><th scope="col">Contract</th><th scope="col">Test Data</th><th scope="col">Latest result</th></tr></thead>
                    <tbody>
                        @foreach (var t in VisibleTests)
                        {
                            var test = t.Test;
                            <tr data-testid="ct-test-row" data-kind="@test.Kind" data-op="@test.Operation" data-state="@t.Readiness.State" class="@(test.Id == TestId ? "ct-selected" : null)">
                                <td><input type="checkbox" data-testid="ct-test-select" aria-label="@($"Select {test.Name}")" checked="@_selected.Contains(test.Id)" @onchange="e => Toggle(test.Id, (bool)e.Value!)" /></td>
                                <th scope="row"><a href="@Link(view: "tests", test: test.Id)" data-testid="ct-test-link">@test.Name</a><div class="ct-muted">@test.ReviewState · @KindLabel(test.Kind)@(ExecutionRunService_Mutating(test) ? " · changes data" : "") · revision @test.Revision</div></th>
                                <td><span class="ct-state ct-state-@t.Readiness.State.ToString().ToLowerInvariant()" data-testid="ct-readiness">@ReadinessLabel(t.Readiness.State)</span>
                                    @if (t.Readiness.MissingValues.Count > 0) { <div class="ct-muted" data-testid="ct-missing">Missing: @string.Join(", ", t.Readiness.MissingValues)</div> }</td>
                                <td>v@(test.ContractVersion)@if (t.Impact is { } impact) { <span class="ct-impact ct-impact-@impact.Level.ToString().ToLowerInvariant()" data-testid="ct-impact">@ImpactLabel(impact.Level) in v@(impact.ToVersion)</span> }</td>
                                <td>@(test.Binding is { } b ? $"{b.Alias}@v{b.Version}" : test.Inputs.Count == 0 ? "not needed" : "not bound")</td>
                                <td>@if (t.Last is { } last) { <a data-testid="ct-last" href="@($"execution-results?run={last.RunId}&call={last.CallId}")"><span class="ct-state ct-run-@last.State.ToString().ToLowerInvariant()">@last.State</span>@(last.HttpStatus is { } code ? $" HTTP {code}" : "")</a> <span class="ct-muted">@last.At.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span> }
                                    else { <span class="ct-muted">never run</span> }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (TestId is { } id && _tests.FirstOrDefault(t => t.Test.Id == id) is { } selected) { @TestDetail(selected) }
        }
    </section>;

    private RenderFragment TestDetail(ContractTestView view) => @<article class="ct-detail" aria-labelledby="ct-test-h" data-testid="ct-test-detail">
        @{ var test = view.Test; }
        <h4 id="ct-test-h">@test.Name <span class="ct-pill" data-testid="ct-review-state">@test.ReviewState · r@(test.Revision)</span></h4>
        @if (test.Description is { Length: > 0 } description) { <p data-testid="ct-description">@description</p> }
        <p data-testid="ct-rationale">@test.Rationale</p>
        <ContractTestEditor Test="@test" Saved="OpenTestAsync" />
        <h5>Readiness: <span data-testid="ct-detail-readiness">@ReadinessLabel(view.Readiness.State)</span></h5>
        <ul class="ct-checks" data-testid="ct-readiness-items">
            @foreach (var item in view.Readiness.Items) { <li data-state="@item.State"><span class="ct-state ct-item-@item.State.ToString().ToLowerInvariant()">@item.State</span> <strong>@item.Area</strong>: @item.Text</li> }
        </ul>
        @if (view.Impact is { } impact)
        {
            <p data-testid="ct-detail-impact"><strong>@ImpactLabel(impact.Level)</strong> of contract v@(impact.ToVersion) on this test (bound to v@(impact.FromVersion)).</p>
            <ul class="ct-checks" data-testid="ct-impact-reasons">@foreach (var r in impact.Reasons) { <li>@r</li> }</ul>
            <button class="btn btn-secondary" data-testid="ct-proposal" disabled="@_busy" @onclick="() => ProposalAsync(test.Id)">Review update proposal for v@(impact.ToVersion)</button>
            @if (_proposal is { } p && p.TestId == test.Id)
            {
                <div class="ct-detail" data-testid="ct-proposal-panel">
                    <strong>Proposed update v@(p.FromVersion) → v@(p.ToVersion) — not saved</strong>
                    @if (p.Differences.Count > 0) { <ul class="ct-checks" data-testid="ct-proposal-diff">@foreach (var d in p.Differences) { <li>@d</li> }</ul> }
                    <ul class="ct-checks ct-muted" data-testid="ct-proposal-notes">@foreach (var n in p.Notes) { <li>@n</li> }</ul>
                    @if (p.Proposed.ContractVersion != test.ContractVersion)
                    { <button class="btn btn-primary" data-testid="ct-proposal-apply" disabled="@_busy" @onclick="() => ApplyProposalAsync(test)">Apply as revision @(test.Revision + 1)</button> }
                </div>
            }
        }

        <h5>Values the test needs</h5>
        @if (test.Inputs.Count == 0) { <p class="ct-muted">None.</p> }
        else
        {
            <table class="ct-table" data-testid="ct-inputs">
                <thead><tr><th scope="col">Name</th><th scope="col">Where</th><th scope="col">Required</th><th scope="col">Type</th></tr></thead>
                <tbody>@foreach (var i in test.Inputs) { <tr><td>@i.Name</td><td>@i.In</td><td>@(i.Required ? "required" : "optional")</td><td>@i.Type</td></tr> }</tbody>
            </table>
        }

        <h5>Test Data</h5>
        <p data-testid="ct-binding">@(test.Binding is { } b ? $"Pinned to {b.Alias}@v{b.Version}." : "No dataset selected.")</p>
        @if (test.Inputs.Count > 0)
        {
            @if (_options is null || _options.Count == 0)
            {
                <p class="ct-muted" data-testid="ct-no-datasets">No dataset or key-value collection in Test Data yet. <a href="test-data">Add data in Test Data</a> with the values above, approve it, and pick it here.</p>
            }
            else
            {
                <ul class="ct-picker" aria-label="Datasets" data-testid="ct-picker">
                    @foreach (var o in _options)
                    {
                        <li data-testid="ct-option" data-alias="@o.Alias" data-compatible="@(o.Compatible ? "true" : "false")">
                            <div><strong>@o.Alias</strong>@if (o.Label is { } label && label != o.Alias) { <span class="ct-muted ct-note">@label</span> } <span class="ct-pill">@o.Kind</span>
                                <span class="ct-pill">@(o.ApprovedVersion is { } av ? $"approved v{av}" : "not approved")</span>@if (o.Environment is { } env) { <span class="ct-pill">@env</span> }</div>
                            <div class="ct-muted">Provides: @(o.Provides.Count == 0 ? "nothing" : string.Join(", ", o.Provides))</div>
                            @if (o.MissingRequired.Count > 0) { <div class="ct-missing" data-testid="ct-option-missing">Missing required: @string.Join(", ", o.MissingRequired)</div> }
                            @if (o.MissingOptional.Count > 0) { <div class="ct-muted">Optional, left out when missing: @string.Join(", ", o.MissingOptional)</div> }
                            @if (o.Problem is { } problem) { <div class="ct-missing">@problem</div> }
                            <button class="btn btn-secondary btn-sm" data-testid="ct-option-use" disabled="@(_busy || o.ApprovedVersion is null)" @onclick="() => BindAsync(test.Id, o)">Use @o.Alias@(o.ApprovedVersion is { } v ? $"@v{v}" : "")</button>
                        </li>
                    }
                </ul>
            }
        }

        <h5>Request template</h5>
        @if (test.Template.Protocol == ExecutionProtocol.GraphQl)
        {
            <pre class="ct-pre" data-testid="ct-template">POST @test.Template.Path

@test.Template.GraphQlQuery@(test.Template.GraphQlVariablesJson is { } vars ? "\n\nvariables " + vars : "")</pre>
        }
        else
        {
            <pre class="ct-pre" data-testid="ct-template">@test.Template.Method @test.Template.Path@(test.Template.Query.Count > 0 ? "?" + string.Join("&", test.Template.Query.Select(q => $"{q.Key}={q.Value}")) : "")@(test.Template.Body is { } body ? "\n\n" + body : "")</pre>
        }
        <p class="ct-muted">Expects @test.Template.ExpectedOutcome. Placeholders are filled from the pinned Test Data when the test runs; nothing is stored resolved.</p>
        <button class="btn btn-link ct-danger" data-testid="ct-delete" disabled="@_busy" @onclick="() => DeleteAsync(test.Id)">Delete test</button>
    </article>;

    private RenderFragment ChangesView(ApiContractDetail d) => @<section class="ct-card" aria-labelledby="ct-changes-h" data-testid="ct-changes">
        <h3 id="ct-changes-h">Changes between versions</h3>
        @if (d.Versions.Count < 2) { <p class="ct-muted" data-testid="ct-changes-single">Only one version. Import a newer document as the next version of this contract to compare.</p> }
        else if (_diff is null) { <p class="ct-muted">Select two versions.</p> }
        else
        {
            <p class="ct-row">
                <label class="ct-inline">Compare
                    <select data-testid="ct-diff-from" value="@_diff.FromVersion" @onchange="CompareFrom">
                        @foreach (var v in d.Versions.Where(v => v.Version != _diff.ToVersion)) { <option value="@v.Version">v@(v.Version)</option> }
                    </select>
                </label>
                <span>with v@(_diff.ToVersion)</span>
            </p>
            var breaking = _diff.Changes.Count(c => ChangeSeverity(c.ContractChange) != "Compatible");
            <dl class="ct-stats ct-stats-sm" data-testid="ct-change-stats">
                <div><dt>Changes</dt><dd>@_diff.Changes.Count</dd></div>
                <div><dt>Potentially breaking</dt><dd data-testid="ct-breaking-count">@breaking</dd></div>
                <div><dt>Compatible</dt><dd>@(_diff.Changes.Count - breaking)</dd></div>
                <div><dt>Tests affected</dt><dd>@_diff.Impacts.Count(i => i.Level != ContractTestImpactLevel.NoEvidence)</dd></div>
            </dl>
            @if (breaking > 0 && breaking < _diff.Changes.Count) { <label class="ct-inline"><input type="checkbox" data-testid="ct-breaking-only" @bind="_breakingOnly" /> Only potentially breaking changes</label> }
            @if (_diff.Changes.Count > 0)
            {
                <div class="ct-scroll">
                    <table class="ct-table" data-testid="ct-change-table">
                        <thead><tr><th scope="col">Change</th><th scope="col">Kind</th><th scope="col">For consumers</th></tr></thead>
                        <tbody>
                            @foreach (var c in _diff.Changes.Where(c => !_breakingOnly || ChangeSeverity(c.ContractChange) != "Compatible"))
                            {
                                <tr data-testid="ct-change-row" data-class="@c.ContractChange"><td>@c.Detail</td><td>@ChangeLabel(c.ContractChange)</td><td>@ChangeSeverity(c.ContractChange)</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <h4>Impact on tests generated from v@(_diff.FromVersion)</h4>
            @if (_diff.Impacts.Count == 0) { <p class="ct-muted" data-testid="ct-no-impacts">No test was generated from v@(_diff.FromVersion).</p> }
            else
            {
                <table class="ct-table" data-testid="ct-impact-table">
                    <thead><tr><th scope="col">Test</th><th scope="col">Impact</th><th scope="col">Why</th></tr></thead>
                    <tbody>
                        @foreach (var i in _diff.Impacts.OrderByDescending(i => i.Level))
                        {
                            <tr data-testid="ct-impact-row" data-level="@i.Level"><th scope="row"><a href="@Link(view: "tests", version: null, test: i.TestId)">@i.TestName</a></th><td><span class="ct-impact ct-impact-@i.Level.ToString().ToLowerInvariant()">@ImpactLabel(i.Level)</span></td><td>@string.Join(" ", i.Reasons)</td></tr>
                        }
                    </tbody>
                </table>
            }
        }
    </section>;

    /// <summary>"3 / 10 (30%)", or NOT ASSESSED when there is nothing to count over or nothing was executed (never 0 % and never covered).</summary>
    private static string CoverageValue(ContractCoverageMetric m) =>
        !m.Assessed ? "NOT ASSESSED" : $"{m.Numerator} / {m.Denominator} ({100.0 * m.Numerator / m.Denominator:0}%)";

    private RenderFragment CoverageView(ApiContractDetail d) => __builder =>
    {
        <section class="ct-card" aria-labelledby="ct-coverage-h" data-testid="ct-coverage">
            <h3 id="ct-coverage-h">Coverage of v@(d.Version)</h3>
            <p class="ct-muted">Definition coverage counts what is defined and prepared; it rises when tests and data are created and is never evidence that the API works.
                Execution coverage is counted only from Execution Evidence of calls that name this exact contract version. Nothing executed = NOT ASSESSED; it is never counted as covered.</p>
            @if (_coverage is null) { <p class="ct-muted">@(_loading ? "Loading…" : "No coverage available.")</p> }
            else
            {
                @foreach (var group in new[] { CoverageGroup.Definition, CoverageGroup.Execution })
                {
                    var metrics = _coverage.Metrics.Where(m => m.Group == group).ToList();
                    if (metrics.Count == 0) continue;
                    <h4 class="ct-group-h" data-testid="ct-coverage-group" data-group="@group">@(group == CoverageGroup.Definition ? "Definition coverage — what is prepared" : "Execution coverage — what documented runs show")</h4>
                    <ul class="ct-meters">
                        @foreach (var m in metrics)
                        {
                            var pct = m.Assessed ? 100.0 * m.Numerator / m.Denominator : 0;
                            <li data-testid="ct-coverage-row" data-metric="@m.Id" data-assessed="@(m.Assessed ? "true" : "false")">
                                <div class="ct-row"><span>@m.Label</span><strong data-testid="ct-coverage-value" class="@(m.Assessed ? null : "ct-not-assessed")">@CoverageValue(m)</strong></div>
                                <div class="ct-meter" role="img" aria-label="@($"{m.Label}: {CoverageValue(m)}")"><span style="width:@(pct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span></div>
                                <div class="ct-muted">@m.Scope@(m.NotAssessed > 0 ? $" · {m.NotAssessed} not assessed" : "") · @m.EvidenceSource</div>
                                @if (m.Note is not null) { <div class="ct-muted">@m.Note</div> }
                            </li>
                        }
                    </ul>
                }
                <p class="ct-muted">Contract @ContractIdentity.ContractRef(_coverage.Key, _coverage.Version) · computed @_coverage.ComputedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</p>
            }
        </section>
    };

    private RenderFragment LifecycleView(ApiContractDetail d) => __builder =>
    {
        <section class="ct-card" aria-labelledby="ct-lifecycle-h" data-testid="ct-lifecycle">
            <h3 id="ct-lifecycle-h">Lifecycle &amp; retention</h3>
            @if (_retention is null) { <p class="ct-muted">@(_loading ? "Loading…" : "Not available.")</p> }
            else
            {
                var r = _retention;
                <p class="ct-muted" data-testid="ct-retention-policy">@r.Policy</p>
                <p class="ct-row ct-runbar">
                    <span>State: <strong data-testid="ct-lifecycle-state">@r.Lifecycle</strong></span>
                    @foreach (var target in Enum.GetValues<ContractLifecycle>().Where(l => l != r.Lifecycle))
                    {
                        <button class="btn btn-secondary" data-testid="ct-lifecycle-@target.ToString().ToLowerInvariant()" disabled="@_busy" @onclick="() => SetLifecycleAsync(d.Contract.Key, target)">@(target switch { ContractLifecycle.Archived => "Archive", ContractLifecycle.Deprecated => "Deprecate", _ => "Make active" })</button>
                    }
                </p>
                <div class="ct-scroll">
                    <table class="ct-table" data-testid="ct-retention-table">
                        <thead><tr><th scope="col">Version</th><th scope="col">Referenced by</th><th scope="col">Actions</th></tr></thead>
                        <tbody>
                            @foreach (var v in r.Versions)
                            {
                                <tr data-testid="ct-retention-row" data-version="@v.Version" data-deletable="@(v.Deletable ? "true" : "false")">
                                    <th scope="row">v@(v.Version)@(v.Hidden ? " (hidden)" : "")</th>
                                    <td>@(v.References.Count == 0 ? "Nothing" : string.Join(", ", v.References))</td>
                                    <td>
                                        @if (!v.Latest) { <button class="btn btn-link btn-sm" data-testid="ct-hide" disabled="@_busy" @onclick="() => SetHiddenAsync(d.Contract.Key, v.Version, !v.Hidden)">@(v.Hidden ? "Show" : "Hide")</button> }
                                        @if (v.Deletable) { <button class="btn btn-link btn-sm ct-danger" data-testid="ct-delete-version" disabled="@_busy" @onclick="() => { _deleteVersion = v.Version; _deleteContract = false; _confirmKey = null; }">Delete…</button> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (r.ContractDeletable) { <button class="btn btn-link ct-danger" data-testid="ct-delete-contract" disabled="@_busy" @onclick="() => { _deleteContract = true; _deleteVersion = null; _confirmKey = null; }">Delete this contract…</button> }
                else { <p class="ct-muted" data-testid="ct-delete-contract-refused">The contract is referenced by tests, execution evidence or a source snapshot, so it can only be archived.</p> }
                @if (_deleteVersion is not null || _deleteContract)
                {
                    <div class="ct-detail" role="group" aria-labelledby="ct-confirm-h" data-testid="ct-confirm">
                        <strong id="ct-confirm-h">@(_deleteContract ? $"Delete contract {d.Contract.Key} permanently?" : $"Delete v{_deleteVersion} of {d.Contract.Key} permanently?")</strong>
                        <label class="ct-field">Type the contract key to confirm <input data-testid="ct-confirm-key" @bind="_confirmKey" @bind:event="oninput" autocomplete="off" /></label>
                        <p class="ct-row ct-runbar">
                            <button class="btn btn-danger" data-testid="ct-confirm-delete" disabled="@(_busy || _confirmKey != d.Contract.Key)" @onclick="() => DeleteAsync(d.Contract.Key)">Delete</button>
                            <button class="btn btn-secondary" data-testid="ct-confirm-cancel" @onclick="() => { _deleteVersion = null; _deleteContract = false; _confirmKey = null; }">Cancel</button>
                        </p>
                    </div>
                }
            }
        </section>
    };

    private async Task SetLifecycleAsync(string key, ContractLifecycle lifecycle)
    {
        if (Api is not { } api) return;
        _busy = true; _message = null;
        _error = await api.SetLifecycleAsync(key, lifecycle);
        _busy = false;
        if (_error is null) { _message = lifecycle switch { ContractLifecycle.Archived => "Archived. Everything is kept and read-only.", ContractLifecycle.Deprecated => "Deprecated.", _ => "Active again." }; await ReloadAsync(); }
    }

    private async Task SetHiddenAsync(string key, int version, bool hidden)
    {
        if (Api is not { } api) return;
        _busy = true; _message = null;
        _error = await api.SetHiddenAsync(key, version, hidden);
        _busy = false;
        if (_error is null) await ReloadAsync();
    }

    private async Task DeleteAsync(string key)
    {
        if (Api is not { } api || _confirmKey is not { } confirm) return;
        _busy = true; _message = null;
        _error = _deleteContract ? await api.DeleteContractAsync(key, confirm) : await api.DeleteVersionAsync(key, _deleteVersion!.Value, confirm);
        _busy = false;
        if (_error is not null) return;
        var deletedContract = _deleteContract;
        _message = deletedContract ? $"Contract {key} deleted." : $"v{_deleteVersion} deleted.";
        _deleteVersion = null; _deleteContract = false; _confirmKey = null;
        if (deletedContract) Go(Link(contract: null, version: null, view: null, test: null));
        else Go(Link(version: null));
    }

    private static string ChangeLabel(ContractChangeClass c) => c switch
    {
        ContractChangeClass.OperationAdded => "Operation added", ContractChangeClass.OperationRemoved => "Operation removed",
        ContractChangeClass.FieldAddedRequired => "Required field added", ContractChangeClass.FieldAddedOptional => "Optional field added", ContractChangeClass.FieldRemoved => "Field removed",
        ContractChangeClass.TypeChanged => "Type changed", ContractChangeClass.RequirednessChanged => "Requiredness changed", ContractChangeClass.TypeAdded => "Type added", ContractChangeClass.TypeRemoved => "Type removed",
        ContractChangeClass.EnumValueAdded => "Enum value added", ContractChangeClass.EnumValueRemoved => "Enum value removed",
        ContractChangeClass.ParameterAddedRequired => "Required parameter added", ContractChangeClass.ParameterAddedOptional => "Optional parameter added",
        ContractChangeClass.ParameterRemoved => "Parameter removed", ContractChangeClass.ParameterChanged => "Parameter changed",
        ContractChangeClass.RequestBodyChanged => "Request body changed", ContractChangeClass.ResponseChanged => "Response changed",
        _ => c.ToString(),
    };

    private static string ChangeSeverity(ContractChangeClass c) => c is ContractChangeClass.OperationAdded or ContractChangeClass.FieldAddedOptional or ContractChangeClass.TypeAdded
        or ContractChangeClass.EnumValueAdded or ContractChangeClass.ParameterAddedOptional or ContractChangeClass.None ? "Compatible" : "Potentially breaking";
}

@code {
    // ── Identity review (moved / renamed contracts) ─────────────────────────────────────────────────────────────────────────
    private string? _sourceProject;

    private RenderFragment IdentityReview(SourceContractCandidate c) => @<div class="ct-review" data-testid="ct-identity-review">
        <p class="ct-muted">This file may continue an existing contract of the project. Nothing is imported until you decide; the decision is recorded.</p>
        <ul class="ct-checks">
            @foreach (var x in c.Candidates)
            {
                <li data-testid="ct-identity-candidate" data-key="@x.Key">
                    <strong>@x.Name</strong> <code>@($"{x.Key}@v{x.LatestVersion}")</code> <span class="ct-muted">@x.SharedOperations/@x.SourceOperations operations shared@(x.SameDocument ? " · identical document" : "")</span>
                    <div class="ct-muted">@string.Join(" · ", x.Evidence)</div>
                    <span class="ct-actions">
                        <button class="btn btn-secondary btn-sm" data-testid="ct-identity-confirm" disabled="@_busy" @onclick="() => DecideAsync(c, x.Key, true)">Continue @x.Key</button>
                        <button class="btn btn-link btn-sm" data-testid="ct-identity-reject" disabled="@_busy" @onclick="() => DecideAsync(c, x.Key, false)">Not this one</button>
                    </span>
                </li>
            }
        </ul>
        <button class="btn btn-link btn-sm" data-testid="ct-identity-new" disabled="@_busy" @onclick="() => DecideAsync(c, null, false)">Import as a new contract</button>
    </div>;

    private async Task DecideAsync(SourceContractCandidate c, string? target, bool confirm)
    {
        if (Api is not { } api) return;
        _busy = true; _error = null; _message = null;
        var (result, error) = await api.DecideIdentityAsync(new ContractIdentityDecisionRequest(c.SnapshotId, c.ContractId, target, confirm));
        _busy = false;
        if (result is null) { _error = error; return; }
        _message = result.Message + " The decision was recorded.";
        (_sourceContracts, _) = await api.ProjectSourceContractsAsync(Project);
        (_contracts, _) = await api.ProjectContractsAsync(Project);
    }

    private string? _assignProject;

    private RenderFragment IdentityBanner(ApiContractDetail d) => @<div class="ct-review" data-testid="ct-identity-banner">
        <strong>Identity needs review.</strong> This contract was stored before contracts were scoped to projects, and its versions point to different projects (or to
        snapshots that no longer exist). It is not continued automatically until you assign its project.
        @if (_projects is { Count: > 0 } projects)
        {
            <span class="ct-inline">
                <select class="form-control" aria-label="Project" data-testid="ct-assign-project" @bind="_assignProject">
                    <option value="">Choose…</option>
                    @foreach (var k in projects.SelectMany(p => p.Keys).Distinct()) { <option value="@k">@k</option> }
                </select>
                <button class="btn btn-secondary btn-sm" data-testid="ct-assign-project-save" disabled="@(_busy || string.IsNullOrEmpty(_assignProject))" @onclick="() => AssignProjectAsync(d.Contract.Key)">Assign project</button>
            </span>
        }
    </div>;

    private async Task AssignProjectAsync(string key)
    {
        if (Api is not { } api || string.IsNullOrEmpty(_assignProject)) return;
        _busy = true; _error = await api.AssignProjectAsync(key, _assignProject); _busy = false;
        if (_error is null) { _message = $"Project {_assignProject} assigned; the decision was recorded."; await ReloadAsync(); }
    }

    // ── Bulk environment configuration ─────────────────────────────────────────────────────────────────────────────────────
    private readonly HashSet<string> _configureSelected = new(StringComparer.Ordinal);
    private ExecutionAuthenticationKind _bulkAuth;
    private BulkBasePathMode _bulkMode = BulkBasePathMode.KeepExisting;
    private string? _bulkPath, _bulkGraphQl, _configureFilter = "";
    private bool _confirmEnvironment;
    private BulkBindingPreview? _bindingPreview;
    private BulkBindingApplyResult? _bindingResult;
    private readonly HashSet<string> _applyRows = new(StringComparer.Ordinal), _confirmRows = new(StringComparer.Ordinal);
    private bool _configurePrepared;

    private void PrepareConfigure()
    {
        if (_configurePrepared) return;
        _configurePrepared = true;
        foreach (var k in (KeysQuery ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)) _configureSelected.Add(k);
        _keysProject = _contracts?.Where(c => _configureSelected.Contains(c.Key)).Select(c => c.ProjectKey).FirstOrDefault(k => k is not null);
    }

    private void SelectShown(IEnumerable<ApiContractSummary> shown) { foreach (var c in shown) _configureSelected.Add(c.Key); }

    private void ToggleConfigure(string key, bool on) { if (on) _configureSelected.Add(key); else _configureSelected.Remove(key); }
    private void ToggleSet(HashSet<string> set, string key, bool on) { if (on) set.Add(key); else set.Remove(key); }

    private RenderFragment ConfigureView() => __builder =>
    {
        <section class="ct-card" aria-labelledby="ct-configure-h" data-testid="ct-configure">
            <h2 id="ct-configure-h">Configure environment for selected contracts</h2>
            @if (_environment is null)
            {
                <p class="ct-muted" data-testid="ct-configure-noenv">Select an approved Target Environment first (the environment selector of BirkNext); its origin stays authoritative and is never taken from a contract.</p>
            }
            else if (EffectiveProject is null)
            {
                <p class="ct-muted" data-testid="ct-configure-noproject">Choose the project above: contracts are configured one project at a time.</p>
            }
            else
            {
                var candidates = (_contracts ?? []).Where(c => c.ProjectKey is not null && Matches(_configureFilter ?? "", c.Name, c.Key, c.Module)).ToList();
                <p class="ct-muted">Environment <strong>@_environmentName</strong> <span class="ct-pill">@_environment.EnvironmentType</span> <code>@_environment.TargetUrl</code>. Preview first: nothing is saved or sent until you apply the rows you approve.</p>
                <div class="ct-filterbar">
                    <input type="search" class="form-control ct-search" placeholder="Search contracts or modules" aria-label="Search contracts" data-testid="ct-configure-search" @bind="_configureFilter" @bind:event="oninput" />
                    <button class="btn btn-link btn-sm" data-testid="ct-configure-all" @onclick="() => SelectShown(candidates)">Select all shown</button>
                    <button class="btn btn-link btn-sm" @onclick="() => _configureSelected.Clear()">Clear</button>
                </div>
                <div class="ct-groups">
                    @foreach (var group in candidates.GroupBy(c => c.Module ?? "(no module)"))
                    {
                        <details class="ct-group" open="@(candidates.Count <= 40)">
                            <summary><strong>@group.Key</strong> <span class="ct-muted">@group.Count() contract(s)</span></summary>
                            <ul class="ct-list">
                                @foreach (var c in group)
                                {
                                    <li><label class="ct-inline"><input type="checkbox" data-testid="ct-configure-select" data-key="@c.Key" checked="@_configureSelected.Contains(c.Key)"
                                        @onchange="e => ToggleConfigure(c.Key, e.Value is true)" /> @c.Name <span class="ct-muted">@(c.Protocol == ApiContractProtocol.GraphQl ? "GraphQL" : "REST")</span></label></li>
                                }
                            </ul>
                        </details>
                    }
                </div>
                <div class="ct-form-row">
                    <label class="ct-inline">Authentication
                        <select class="form-control" data-testid="ct-configure-auth" @bind="_bulkAuth">
                            <option value="@ExecutionAuthenticationKind.None">None (anonymous)</option>
                            <option value="@ExecutionAuthenticationKind.AttendedSession">Attended session (your sign-in)</option>
                            <option value="@ExecutionAuthenticationKind.ClientCredentials">Client credentials (environment credential)</option>
                            <option value="@ExecutionAuthenticationKind.ApiKey">API key (environment credential)</option>
                        </select>
                    </label>
                    <label class="ct-inline">Base path
                        <select class="form-control" data-testid="ct-configure-mode" @bind="_bulkMode">
                            <option value="@BulkBasePathMode.KeepExisting">Keep saved, else the single declared server path</option>
                            <option value="@BulkBasePathMode.FromContractServers">From each contract's declared servers</option>
                            <option value="@BulkBasePathMode.Explicit">One path for all</option>
                        </select>
                    </label>
                    @if (_bulkMode == BulkBasePathMode.Explicit) { <input class="form-control ct-narrow" placeholder="/api" aria-label="Base path" data-testid="ct-configure-path" @bind="_bulkPath" @bind:event="oninput" /> }
                    <input class="form-control ct-narrow" placeholder="/graphql" aria-label="GraphQL endpoint path (GraphQL contracts)" data-testid="ct-configure-graphql" @bind="_bulkGraphQl" @bind:event="oninput" />
                    <button class="btn btn-primary" data-testid="ct-configure-preview" disabled="@(_busy || _configureSelected.Count == 0)" @onclick="PreviewBindingsAsync">Preview (@_configureSelected.Count)</button>
                </div>
                @if (_bindingPreview is { } preview) { @BindingPreview(preview) }
                @if (_bindingResult is { } applied)
                {
                    <ul class="ct-checks" data-testid="ct-configure-result">
                        @foreach (var r in applied.Rows) { <li data-testid="ct-configure-result-row" data-status="@r.Status"><strong>@r.Key</strong> <span class="ct-pill">@r.Status</span> <span class="ct-muted">@r.Message</span></li> }
                    </ul>
                }
            }
        </section>
    };

    private RenderFragment BindingPreview(BulkBindingPreview p) => @<div class="ct-scroll" data-testid="ct-configure-preview-table">
        @if (!p.EnvironmentAllowed) { <p class="ct-error" data-testid="ct-configure-env-refused">@p.EnvironmentProblem</p> }
        <table class="ct-table">
            <caption class="visually-hidden">Proposed bindings</caption>
            <thead><tr><th scope="col">Apply</th><th scope="col">Contract</th><th scope="col">Endpoint</th><th scope="col">Saved</th><th scope="col">Proposed</th><th scope="col">Authentication</th><th scope="col">Status</th></tr></thead>
            <tbody>@foreach (var r in p.Rows)
            {
                var canApply = r.Status is BulkBindingStatus.Applicable or BulkBindingStatus.NeedsReview;
                <tr data-testid="ct-configure-row" data-key="@r.Key" data-status="@r.Status">
                    <td>@if (canApply) { <input type="checkbox" aria-label="@($"Apply {r.Name}")" data-testid="ct-configure-apply-row" checked="@_applyRows.Contains(r.Key)"
                            @onchange="e => ToggleSet(_applyRows, r.Key, e.Value is true)" />
                        @if (r.Status == BulkBindingStatus.NeedsReview) { <label class="ct-inline ct-muted"><input type="checkbox" data-testid="ct-configure-confirm-row" checked="@_confirmRows.Contains(r.Key)"
                            @onchange="e => ToggleSet(_confirmRows, r.Key, e.Value is true)" /> reviewed</label> } }</td>
                    <th scope="row">@r.Name<div class="ct-muted">@(r.Module ?? "")</div></th>
                    <td><span class="ct-pill">@r.Endpoint</span>@foreach (var c in r.Candidates) { <div class="ct-muted">@c.BasePath · @c.Source</div> }</td>
                    <td>@(r.Existing is { } e ? $"{e.BasePath ?? e.GraphQlPath ?? "root"} · {e.Authentication}" : "none")</td>
                    <td>@(r.Protocol == ApiContractProtocol.GraphQl ? r.ProposedGraphQlPath ?? "/graphql" : r.ProposedBasePath ?? "environment root")</td>
                    <td>@r.ProposedAuthentication<div class="ct-muted">@(r.RequiredSchemes.Count == 0 ? "no declared security" : "requires " + string.Join(", ", r.RequiredSchemes)) · @r.Credential</div></td>
                    <td><span class="ct-state ct-bind-@r.Status.ToString().ToLowerInvariant()">@r.Status</span>@foreach (var why in r.Reasons) { <div class="ct-muted">@why</div> }</td>
                </tr>
            }</tbody>
        </table>
        <ul class="ct-checks ct-muted">@foreach (var l in p.Limitations) { <li>@l</li> }</ul>
        <div class="ct-row ct-runbar">
            <label class="ct-inline"><input type="checkbox" data-testid="ct-configure-confirm-env" @bind="_confirmEnvironment" /> I confirm <strong>@_environmentName</strong> (@p.EnvironmentType, @p.TargetOrigin) is the approved environment for these bindings</label>
            <button class="btn btn-primary" data-testid="ct-configure-apply" disabled="@(_busy || !_confirmEnvironment || _applyRows.Count == 0)" @onclick="() => ApplyBindingsAsync(p)">Apply approved (@_applyRows.Count)</button>
        </div>
    </div>;

    private BulkBindingRequest BindingRequest() => new()
    {
        ProjectKey = EffectiveProject ?? "", Environment = _environment!, ContractKeys = [.. _configureSelected], Authentication = _bulkAuth, BasePathMode = _bulkMode,
        BasePath = string.IsNullOrWhiteSpace(_bulkPath) ? null : _bulkPath.Trim(), GraphQlPath = string.IsNullOrWhiteSpace(_bulkGraphQl) ? null : _bulkGraphQl.Trim(),
    };

    private async Task PreviewBindingsAsync()
    {
        if (Api is not { } api || _environment is null) return;
        _busy = true; _error = null; _bindingResult = null; _applyRows.Clear(); _confirmRows.Clear(); _confirmEnvironment = false;
        (_bindingPreview, _error) = await api.PreviewBindingsAsync(BindingRequest());
        foreach (var r in _bindingPreview?.Rows.Where(r => r.Status == BulkBindingStatus.Applicable) ?? []) _applyRows.Add(r.Key);
        _busy = false;
    }

    private async Task ApplyBindingsAsync(BulkBindingPreview preview)
    {
        if (Api is not { } api || _environment is null) return;
        _busy = true; _error = null;
        var items = preview.Rows.Where(r => _applyRows.Contains(r.Key)).Select(r => new BulkBindingApplyItem(r.Key,
            r.Protocol == ApiContractProtocol.Rest ? r.ProposedBasePath : null, r.ProposedGraphQlPath, r.ProposedAuthentication, r.Existing?.UpdatedAt, _confirmRows.Contains(r.Key))).ToList();
        (_bindingResult, _error) = await api.ApplyBindingsAsync(new BulkBindingApplyRequest { ProjectKey = EffectiveProject ?? "", Environment = _environment, ConfirmEnvironment = _confirmEnvironment, Items = items });
        _busy = false;
        if (_bindingResult is { } r) _message = $"{r.Applied} binding(s) applied, {r.NotApplied} not applied (see each row). Nothing was sent to any API.";
        _bindingPreview = null; _applyRows.Clear(); _confirmRows.Clear(); _confirmEnvironment = false;
    }

    // ── Project coverage ───────────────────────────────────────────────────────────────────────────────────────────────────
    private ProjectCoverageReport? _projectCoverage;
    private string _coverageFilter = "all", _coverageSearch = "", _coverageModule = "";

    private static string Value(ProjectCoverageTotal? t) => t is null || !t.Assessed ? "NOT ASSESSED" : $"{t.Numerator} / {t.Denominator}";
    private static double Pct(ProjectCoverageTotal? t) => t is { Assessed: true, Denominator: > 0 } ? 100.0 * t.Numerator / t.Denominator : 0;
    private static ContractCoverageMetric? M(ProjectCoverageContract c, string id) => c.Coverage.Metrics.FirstOrDefault(m => m.Id == id);
    private static string Short(ContractCoverageMetric? m) => m is null || !m.Assessed ? "not assessed" : $"{m.Numerator}/{m.Denominator}";

    private static readonly (string Id, string Label)[] CoverageKpis =
        [("operations-with-tests", "Test definitions"), ("operations-executed", "Executed"), ("operations-verified", "Verified"), ("operations-with-negative-tests", "Negative tests"), ("documented-responses-observed", "Response codes observed")];

    private bool CoverageVisible(ProjectCoverageContract c) =>
        Matches(_coverageSearch, c.Name, c.Key) && (_coverageModule.Length == 0 || (c.Module ?? "(no module)") == _coverageModule) && _coverageFilter switch
        {
            "missing-tests" => M(c, "operations-with-tests") is { } t && t.Numerator < t.Denominator,
            "not-executed" => M(c, "operations-executed") is { } e && e.Numerator < e.Denominator,
            "failed" => c.Coverage.AssertionsFailed > 0 || (M(c, "operations-executed") is { Numerator: > 0 } ex && M(c, "operations-passing") is { } pa && pa.Numerator < ex.Numerator),
            "changed" => c.TestsOnOlderVersions > 0 || c.History.Count > 0,
            "blocked" => c.BlockedTests > 0,
            _ => true,
        };

    private RenderFragment ProjectCoverageView() => __builder =>
    {
        <section class="ct-card" aria-labelledby="ct-pcov-h" data-testid="ct-project-coverage">
            <h2 id="ct-pcov-h">Project coverage</h2>
            @if (EffectiveProject is null) { <p class="ct-muted" data-testid="ct-pcov-noproject">Choose a project above.</p> }
            else if (_projectCoverage is not { } r) { <p class="ct-muted">@(_loading ? "Loading…" : "No coverage available for this project.")</p> }
            else
            {
                var totals = r.Totals.ToDictionary(t => t.Id);
                <p class="ct-muted">@r.DisplayName · @r.Contracts.Count contract(s), each counted once at its latest version. Definition is what is prepared; execution and verification come only from documented runs. Nothing executed shows NOT ASSESSED.</p>
                <div class="ct-kpis" data-testid="ct-pcov-kpis">
                    @foreach (var (id, label) in CoverageKpis)
                    {
                        var t = totals.GetValueOrDefault(id);
                        <div class="ct-kpi" data-testid="ct-pcov-kpi" data-metric="@id" data-assessed="@(t?.Assessed == true ? "true" : "false")">
                            <span class="ct-muted">@label</span><strong data-testid="ct-pcov-value">@Value(t)</strong>
                            <div class="ct-meter" role="img" aria-label="@($"{label}: {Value(t)}")"><span style="width:@(Pct(t).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span></div>
                        </div>
                    }
                    @if (r.Contracts.Any(c => c.ReadinessAssessed))
                    {
                        <div class="ct-kpi" data-testid="ct-pcov-kpi" data-metric="blocked"><span class="ct-muted">Tests not ready</span><strong>@r.Contracts.Sum(c => c.BlockedTests) / @r.Contracts.Sum(c => c.Tests)</strong></div>
                    }
                </div>
                <div class="ct-filterbar">
                    <input type="search" class="form-control ct-search" placeholder="Search contracts" aria-label="Search contracts" data-testid="ct-pcov-search" @bind="_coverageSearch" @bind:event="oninput" />
                    <select class="form-control ct-narrow-select" aria-label="Module" data-testid="ct-pcov-module" @bind="_coverageModule">
                        <option value="">All modules</option>
                        @foreach (var m in r.Contracts.Select(c => c.Module ?? "(no module)").Distinct().OrderBy(m => m)) { <option value="@m">@m</option> }
                    </select>
                    <select class="form-control ct-narrow-select" aria-label="Show" data-testid="ct-pcov-filter" @bind="_coverageFilter">
                        <option value="all">All contracts</option><option value="missing-tests">Missing tests</option><option value="not-executed">Not executed</option>
                        <option value="failed">Failed verification</option><option value="changed">Changed contract</option><option value="blocked">Blocked</option>
                    </select>
                </div>
                @foreach (var module in r.Contracts.Where(CoverageVisible).GroupBy(c => c.Module ?? "(no module)").OrderBy(g => g.Key))
                {
                    <details class="ct-group" open data-testid="ct-pcov-module-group" data-module="@module.Key">
                        <summary><strong>@module.Key</strong> <span class="ct-muted">@module.Count() contract(s) · @module.Sum(c => M(c, "operations-with-tests")?.Denominator ?? 0) operations</span></summary>
                        <ul class="ct-list">
                            @foreach (var c in module)
                            {
                                <li class="ct-pcov-row" data-testid="ct-pcov-contract" data-key="@c.Key">
                                    <span class="ct-source-name"><a href="@Link(contract: c.Key, version: null, view: "coverage", test: null)" data-testid="ct-pcov-open">@c.Name</a> <span class="ct-muted">v@(c.Version)</span>
                                        @if (c.TestsOnOlderVersions > 0) { <span class="ct-pill ct-src-changed">@c.TestsOnOlderVersions test(s) on older versions</span> }</span>
                                    <span class="ct-muted" data-testid="ct-pcov-figures">tests @Short(M(c, "operations-with-tests")) · executed @Short(M(c, "operations-executed")) · verified @Short(M(c, "operations-verified"))@(c.Coverage.LatestExecutionAt is { } at ? $" · last run {at.ToLocalTime():yyyy-MM-dd HH:mm}" : "")</span>
                                    @if (c.BlockerAreas.Count > 0) { <span class="ct-muted" data-testid="ct-pcov-blockers">Blocked: @string.Join(", ", c.BlockerAreas)</span> }
                                    @if (c.History.Count > 0) { <span class="ct-muted" data-testid="ct-pcov-history">History: @string.Join("; ", c.History.Select(h => $"v{h.Version} executed {h.Executed}/{h.Operations}"))</span> }
                                </li>
                            }
                        </ul>
                    </details>
                }
                <ul class="ct-checks ct-muted">@foreach (var l in r.Limitations) { <li>@l</li> }</ul>
            }
        </section>
    };

    // ── Chain suggestions ───────────────────────────────────────────────────────────────────────────────────────────────────
    private IReadOnlyList<ChainSuggestion>? _suggestions;

    private async Task SuggestChainsAsync(string key)
    {
        if (Api is not { } api) return;
        _busy = true; (_suggestions, _error) = await api.ChainSuggestionsAsync(key, _environment); _busy = false;
    }

    private RenderFragment Suggestions(string key, IReadOnlyList<ChainSuggestion> list) => @<div class="ct-suggestions" data-testid="ct-suggestions">
        @if (list.Count == 0) { <p class="ct-muted" data-testid="ct-suggestions-empty">No chain could be derived from this contract's evidence (it needs a typed response field that feeds an item path parameter of the same collection).</p> }
        @foreach (var s in list)
        {
            <article class="ct-suggestion" data-testid="ct-suggestion" data-id="@s.Id">
                <div class="ct-row"><strong>@s.Purpose</strong>
                    <span><span class="ct-pill">@s.Confidence confidence</span> @if (s.Mutating) { <span class="ct-pill ct-mutating">changes data</span> } @if (s.AcceptedChainId is not null) { <span class="ct-pill ct-src-uptodate" data-testid="ct-suggestion-accepted">accepted as draft</span> }</span></div>
                <ol class="ct-steps">@foreach (var st in s.Steps) { <li><code>@st.Operation</code>@foreach (var x in st.Extract) { <span class="ct-muted"> → provides @x.Name (@x.Path)</span> }@foreach (var i in st.Inputs) { <span class="ct-muted"> ← @i.Input from @($"{i.FromStep}.{i.Output}")</span> }</li> }</ol>
                <details><summary>Evidence</summary><ul class="ct-checks">@foreach (var e in s.Evidence) { <li>@e</li> }</ul></details>
                @if (s.Missing.Count > 0) { <ul class="ct-checks ct-missing" data-testid="ct-suggestion-missing">@foreach (var m in s.Missing) { <li>@m</li> }</ul> }
                @if (s.AcceptedChainId is null)
                {
                    <span class="ct-actions">
                        <button class="btn btn-secondary btn-sm" data-testid="ct-suggestion-accept" disabled="@(_busy || s.Steps.Any(x => x.TestId is null))" @onclick="() => AcceptSuggestionAsync(key, s)">Accept as draft</button>
                        <button class="btn btn-link btn-sm" data-testid="ct-suggestion-reject" disabled="@_busy" @onclick="() => RejectSuggestionAsync(key, s)">Reject</button>
                    </span>
                }
            </article>
        }
    </div>;

    private async Task AcceptSuggestionAsync(string key, ChainSuggestion s)
    {
        if (Api is not { } api) return;
        _busy = true; _error = null;
        var (result, error) = await api.AcceptChainSuggestionAsync(key, s.Id);
        _busy = false;
        if (result?.Chain is { } chain) { _message = $"{chain.Name} saved as a draft chain. Review and approve it before it can run."; (_chains, _) = await api.ChainsAsync(); (_suggestions, _) = await api.ChainSuggestionsAsync(key, _environment); }
        else _error = result?.Problems.FirstOrDefault() ?? error;
    }

    private async Task RejectSuggestionAsync(string key, ChainSuggestion s)
    {
        if (Api is not { } api) return;
        _busy = true; _error = await api.RejectChainSuggestionAsync(key, s.Id); _busy = false;
        if (_error is null) { _message = "Suggestion rejected; it will not be offered again."; (_suggestions, _) = await api.ChainSuggestionsAsync(key, _environment); }
    }

    /// <summary>Approving a draft saves a new revision with the same steps in the Approved state (explicit; the chain can then run with the usual gates).</summary>
    private async Task ApproveChainAsync(ContractTestChain chain)
    {
        if (Api is not { } api) return;
        _busy = true; _error = null;
        var (result, error) = await api.SaveChainAsync(chain.Id, new ContractChainSave
        {
            Name = chain.Name, Description = chain.Description, Steps = chain.Steps, ExpectedRevision = chain.Revision, State = ContractChainState.Approved, SuggestionId = chain.SuggestionId,
        });
        _busy = false;
        if (result?.Chain is { } saved && result.Problems.Count == 0) { _message = $"{saved.Name} approved as revision {saved.Revision}."; (_chains, _) = await api.ChainsAsync(); }
        else _error = result?.Problems.FirstOrDefault() ?? error;
    }
}
