    }

    /// <summary>Selects the ready tests that are shown; data-changing tests only once the data-changing confirmation is ticked.</summary>
    private void SelectReady(ChangeEventArgs e)
    {
        foreach (var t in VisibleTests.Where(t => t.Readiness.State == ContractTestReadinessState.Ready && (_confirmMutating || !ExecutionRunService_Mutating(t.Test)))) Toggle(t.Test.Id, e.Value is true);
    }

    private IEnumerable<ContractTestView> VisibleTests => (_tests ?? []).Where(t => Matches(_testFilter, t.Test.Name, t.Test.Operation) && _testState switch
    {
        "ready" => t.Readiness.State == ContractTestReadinessState.Ready,
        "notready" => t.Readiness.State == ContractTestReadinessState.NotReady,
        "blocked" => t.Readiness.State == ContractTestReadinessState.Blocked,
        "data" => t.Readiness.MissingValues.Count > 0 || (t.Test.Binding is null && t.Test.Inputs.Any(i => i.Required)),
        "positive" => t.Test.Kind == ContractTestKind.Positive,
        "negative" => t.Test.Kind != ContractTestKind.Positive,
        "mutating" => ExecutionRunService_Mutating(t.Test),
        "impacted" => t.Impact is { Level: not ContractTestImpactLevel.NoEvidence },
        _ => true,
    });

    /// <summary>What stops tests from running, grouped by readiness area (from the backend readiness, never recomputed): one line per area.</summary>
    private IEnumerable<(string Area, ReadinessItemState State, int Tests, string Example)> Blockers() =>
        (_tests ?? []).SelectMany(t => t.Readiness.Items.Where(i => i.State != ReadinessItemState.Ok).Select(i => (Test: t.Test.Id, Item: i)))
            .GroupBy(x => x.Item.Area)
            .Select(g => (g.Key, g.Max(x => x.Item.State), g.Select(x => x.Test).Distinct().Count(), g.First().Item.Text))
            .OrderByDescending(b => b.Item2).ThenByDescending(b => b.Item3);

