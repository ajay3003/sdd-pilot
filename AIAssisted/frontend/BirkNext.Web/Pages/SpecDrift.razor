@page "/spec-drift"
@using BirkNext.Web.Components
@using BirkNext.Web.Models.Analysis
@using BirkNext.Web.Services
@inject IAnalysisPageModelService AnalysisPageModelService
@inject IWorkspaceSessionService Workspace

<PageTitle>Spec Drift</PageTitle>

<div class="drift-page">
    <PageHeader Title="Spec Drift"
                Description="The single entry point for specification changes, change history, and drift analysis — all in one place." />

    <!-- ── Readiness Panel ────────────────────────────────────────── -->
    @if (PageModel is not null)
    {
        <AnalysisReadinessPanel Model="PageModel" />
    }
    else if (IsLoading)
    {
        <div class="loading-state" role="status">Loading page configuration...</div>
    }
    else if (LoadError is not null)
    {
        <div class="notification notification-error" role="alert">@LoadError</div>
    }

    <!-- ── Analysis Content (only if ready) ────────────────────────── -->
    @if (PageModel?.Summary.CanRun == true)
    {
        <div class="drift-content">
            <!-- Results Section -->
            @if (PageModel.Results.Count > 0)
            {
                <section class="results-section">
                    <h2 class="section-title">Analysis Results</h2>
                    <div class="results-grid">
                        @foreach (var result in PageModel.Results)
                        {
                            <div class="result-card">
                                <div class="result-header">
                                    <h3>@result.Name</h3>
                                    <span class="severity @GetSeverityClass(result.Severity.ToString())">@result.Severity</span>
                                </div>
                                @if (!string.IsNullOrEmpty(result.Summary))
                                {
                                    <p class="summary">@result.Summary</p>
                                }
                                @if (!string.IsNullOrEmpty(result.Details))
                                {
                                    <div class="details">@result.Details</div>
                                }
                                @if (!string.IsNullOrEmpty(result.Recommendation))
                                {
                                    <div class="recommendation">
                                        <strong>Recommendation:</strong> @result.Recommendation
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </section>
            }

            <!-- Summary Section -->
            @if (PageModel.Summary is not null)
            {
                <section class="summary-section">
                    <h2 class="section-title">Summary</h2>
                    <div class="summary-card">
                        <div class="summary-stat">
                            <span class="stat-label">Total Findings</span>
                            <span class="stat-value">@PageModel.Results.Count</span>
                        </div>
                        @if (!string.IsNullOrEmpty(PageModel.Summary.ReadinessMessage))
                        {
                            <div class="summary-text">@PageModel.Summary.ReadinessMessage</div>
                        }
                    </div>
                </section>
            }
        </div>
    }
</div>

@code {
    private AnalysisPageModel? PageModel;
    private bool IsLoading = true;
    private string? LoadError;

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to workspace changes
        Workspace.ReviewContextRebuildNeeded += (s, e) => _ = RefreshPageModel();

        // Load initial model
        await RefreshPageModel();
    }

    private async Task RefreshPageModel()
    {
        try
        {
            IsLoading = true;
            LoadError = null;
            PageModel = await AnalysisPageModelService.GetSpecDriftModelAsync();

            if (PageModel is null)
            {
                LoadError = "Failed to load page configuration";
            }
        }
        catch (Exception ex)
        {
            LoadError = $"Error loading configuration: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private string GetSeverityClass(string? severity) => severity?.ToLower() switch
    {
        "critical" => "critical",
        "warning" => "warning",
        "info" => "info",
        _ => "default"
    };
}

<style>
.drift-page {
    padding: 0 20px;
}

.loading-state {
    text-align: center;
    color: #6b7280;
    padding: 40px 20px;
}

.drift-content {
    margin-top: 32px;
}

.section-title {
    font-size: 18px;
    font-weight: 600;
    color: #111827;
    margin-bottom: 16px;
    border-bottom: 2px solid #e5e7eb;
    padding-bottom: 12px;
}

.results-section {
    margin-bottom: 40px;
}

.results-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
}

.result-card {
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 16px;
    background: white;
    transition: all 0.2s ease;
}

.result-card:hover {
    border-color: #d1d5db;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.07);
}

.result-header {
    display: flex;
    justify-content: space-between;
    align-items: start;
    margin-bottom: 12px;
}

.result-header h3 {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    color: #111827;
}

.severity {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
}

.severity.critical {
    background: #fee2e2;
    color: #991b1b;
}

.severity.warning {
    background: #fef3c7;
    color: #92400e;
}

.severity.info {
    background: #dbeafe;
    color: #1e40af;
}

.summary {
    margin: 8px 0;
    font-size: 14px;
    color: #374151;
}

.details {
    margin: 8px 0;
    padding: 8px;
    background: #f9fafb;
    border-radius: 4px;
    font-size: 13px;
    color: #6b7280;
}

.recommendation {
    margin-top: 8px;
    padding: 8px;
    background: #fef3c7;
    border-left: 3px solid #f59e0b;
    border-radius: 4px;
    font-size: 13px;
}

.summary-section {
    margin-bottom: 40px;
}

.summary-card {
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 20px;
    background: white;
}

.summary-stat {
    display: flex;
    justify-content: space-between;
    margin-bottom: 12px;
}

.stat-label {
    font-size: 13px;
    color: #6b7280;
    font-weight: 500;
}

.stat-value {
    font-size: 20px;
    font-weight: 700;
    color: #3b82f6;
}

.summary-text {
    color: #374151;
    line-height: 1.6;
}
</style>
