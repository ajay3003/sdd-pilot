@page "/documentation-drift"
@page "/spec-drift"
@using BirkNext.Web.Components
@using BirkNext.Web.Services
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject NavigationManager NavigationManager

<PageTitle>Documentation Drift</PageTitle>

@* Documentation Drift compares documentation artifacts — authored ↔ authored, generated ↔ generated, authored ↔ generated. Compare is the
   workspace; Overview, Changes and Drift are views over the same comparison model. Requirement coverage belongs to Traceability & Coverage,
   generated-document freshness to Generated Documentation Health, raw source to Source Analysis. *@
<div class="drift-page">
    <PageHeader Title="Documentation Drift"
                Description="@DocumentationDrift.Description" />

    <div class="sd-tab-strip" role="tablist" aria-label="Documentation Drift views">
        @foreach (var (key, label) in Tabs)
        {
            var tab = key;
            <button type="button" class='sd-tab @(_activeTab == tab ? "is-active" : "")' role="tab" aria-selected="@(_activeTab == tab ? "true" : "false")"
                    data-testid="@(tab == "changes" ? "sd-changes-tab-btn" : $"dd-{tab}-tab-btn")" @onclick="() => SetTab(tab)">@label</button>
        }
    </div>

    <DocumentationDriftPanel View="@_activeTab" OnViewChange="SetTab" />

    @if (_activeTab == "changes")
    {
        <details class="drift-legacy" data-testid="dd-spec-reviews">
            <summary>Saved specification reviews (requirement-level comparisons)</summary>
            <p class="drift-legacy-note">Specification comparisons saved from Compare Specs, with their requirement-level impact. An existing feature, kept here as secondary history.</p>
            <SpecChangesPanel />
        </details>
    }
</div>

@code {
    private static readonly (string Key, string Label)[] Tabs = [("overview", "Overview"), ("compare", "Compare"), ("changes", "Changes"), ("drift", "Drift")];

    /// <summary>Compare is the default. Older links keep working: ?tab=documents and ?tab=actions open Compare.</summary>
    private string _activeTab = "compare";

    protected override void OnInitialized()
    {
        ApplyTab(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    /// <summary>A link from one Documentation Drift URL to another reuses this instance (no parameters change), so the tab follows the location.</summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var path = NavigationManager.ToAbsoluteUri(e.Location).AbsolutePath.TrimEnd('/');
        if (!path.EndsWith("/documentation-drift", StringComparison.OrdinalIgnoreCase) && !path.EndsWith("/spec-drift", StringComparison.OrdinalIgnoreCase)) return;
        ApplyTab(e.Location);
        _ = InvokeAsync(StateHasChanged);
    }

    private void ApplyTab(string location)
    {
        var uri = NavigationManager.ToAbsoluteUri(location);
        _activeTab = QueryHelpers.ParseQuery(uri.Query).TryGetValue("tab", out var tab) ? NormalizeTab(tab!) : "compare";
    }

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;

    public static string NormalizeTab(string tab) => tab switch
    {
        "overview" or "changes" or "drift" or "compare" => tab,
        _ => "compare",
    };

    private void SetTab(string tab) => _activeTab = NormalizeTab(tab);
}
