@page "/documentation-drift"
@page "/spec-drift"
@using BirkNext.Web.Components
@using BirkNext.Web.Services
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject NavigationManager NavigationManager
@inject IWorkspaceSessionService Workspace

<PageTitle>Documentation Drift</PageTitle>

@* Documentation Drift compares documentation artifacts — authored ↔ authored, generated ↔ generated, authored ↔ generated. Compare is the
   workspace; Overview, Changes and Drift are views over the same comparison model. Requirement coverage belongs to Requirements
   Traceability, generated-document freshness to Generated Documentation Health, raw source to Source Analysis. *@
<div class="drift-page">
    <div class="drift-intro">
        <PageHeader Title="Documentation Drift"
                    Description="Find where authored intent and implementation-derived documentation differ, and review changes across project versions." />
        <ReviewDisclosure Text="How Documentation Drift works" CollapseText="Hide how Documentation Drift works" TestId="dd-how-it-works" Class="disclosure-inline disclosure-small">
            <p class="drift-legacy-note">@DocumentationDrift.Description Overview summarizes what can be reviewed; Compare runs one comparison; Changes compares revisions of one document across imports of the same project; Drift lists every module and documentation area with one status. Authored intent and generated documentation stay independent evidence; raw source stays with Source Analysis. <a class="ug-learn-more" href="/user-guide#documentation-drift" data-testid="dd-learn-more">Learn more in the User Guide</a></p>
        </ReviewDisclosure>
    </div>

    <div class="sd-tab-strip" role="tablist" aria-label="Documentation Drift views">
        @foreach (var (key, label) in Tabs)
        {
            var tab = key;
            <button type="button" class='sd-tab @(_activeTab == tab ? "is-active" : "")' role="tab" aria-selected="@(_activeTab == tab ? "true" : "false")"
                    data-testid="@(tab == "changes" ? "sd-changes-tab-btn" : $"dd-{tab}-tab-btn")" @onclick="() => SetTab(tab)">@label</button>
        }
    </div>

    <DocumentationDriftPanel View="@_activeTab" OnViewChange="SetTab" PreselectImport="@_preImport" PreselectModule="@_preModule" PreselectConcern="@_preConcern" />

    @if (_activeTab == "changes")
    {
        @* Requirement-level reviews are stored per Sample Project; another workspace never reads them (no cross-project history). *@
        @if (!string.IsNullOrWhiteSpace(Workspace.CurrentProject))
        {
            <details class="drift-legacy" data-testid="dd-spec-reviews">
                <summary>Saved specification reviews (requirement-level comparisons)</summary>
                <p class="drift-legacy-note">Requirement-level comparisons saved for this workspace from Compare Specs. Secondary history — not the same as imported document revisions.</p>
                <SpecChangesPanel />
            </details>
        }
        else
        {
            <p class="drift-legacy-note" data-testid="dd-spec-reviews-none">Requirement-level specification reviews (Compare Specs) are kept per Demo Project; this workspace has none. Document revisions are compared above.</p>
        }
    }
</div>

@code {
    private static readonly (string Key, string Label)[] Tabs = [("overview", "Overview"), ("compare", "Compare"), ("changes", "Changes"), ("drift", "Drift")];

    /// <summary>Compare is the default. Older links keep working: ?tab=documents and ?tab=actions open Compare.</summary>
    private string _activeTab = "compare";

    protected override void OnInitialized()
    {
        ApplyTab(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    /// <summary>A link from one Documentation Drift URL to another reuses this instance (no parameters change), so the tab follows the location.</summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var path = NavigationManager.ToAbsoluteUri(e.Location).AbsolutePath.TrimEnd('/');
        if (!path.EndsWith("/documentation-drift", StringComparison.OrdinalIgnoreCase) && !path.EndsWith("/spec-drift", StringComparison.OrdinalIgnoreCase)) return;
        ApplyTab(e.Location);
        _ = InvokeAsync(StateHasChanged);
    }

    private void ApplyTab(string location)
    {
        var uri = NavigationManager.ToAbsoluteUri(location);
        var query = QueryHelpers.ParseQuery(uri.Query);
        _activeTab = query.TryGetValue("tab", out var tab) ? NormalizeTab(tab!) : "compare";
        // Context from another page ("Compare in Documentation Drift"): preselects, never runs or saves a comparison.
        _preImport = query.TryGetValue("import", out var import) ? import.ToString() : null;
        _preModule = query.TryGetValue("module", out var module) ? module.ToString() : null;
        _preConcern = query.TryGetValue("concern", out var concern) ? concern.ToString() : null;
    }

    private string? _preImport, _preModule, _preConcern;

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;

    public static string NormalizeTab(string tab) => tab switch
    {
        "overview" or "changes" or "drift" or "compare" => tab,
        _ => "compare",
    };

    private void SetTab(string tab) => _activeTab = NormalizeTab(tab);
}
