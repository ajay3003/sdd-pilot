    private bool _kindSaving, _techSaving;
    private string? _kindError, _techError;

    /// <summary>Reviewers' test-link decisions of the selected specification as plain values (cleared ones left out).</summary>
    private Dictionary<string, TC.Decision> TechDecisions =>
        StoryGroupingEngine.TestLinkDecisions(_groupDoc).ToDictionary(kv => kv.Key, kv => TC.ToDecision(kv.Value), StringComparer.Ordinal);

    /// <summary>Stores a reviewer's decision about one source test for this scenario, with the fingerprints it was made on; nothing else changes.</summary>
    private async Task ReviewTestAsync(S.Item i, TC.TestRow row, TestLinkReview review, TechnicalCoverageExtent extent)
    {
        if (!CanSetKind(i)) return;
        _techSaving = true; _techError = null;
        try
        {
            _techError = await ApplyGroupingAsync([new StoryGroupingOperation { Kind = StoryGroupingOperationKind.SetScenarioTestLink, ScenarioId = i.Id, StoryKey = i.Candidate.Story?.Key,
                TestId = row.Test.TestId, LinkReview = review, Extent = extent, TestFingerprint = row.Test.SourceFingerprint, ScenarioFingerprint = i.Candidate.Fingerprint,
                DisplayId = $"{W.OtherScenarioLabel(i)} · {row.ReadableName}" }]);
        }
        finally { _techSaving = false; }
    }

    /// <summary>A scenario's kind can be chosen when it belongs to the selected specification's stories (its decision is stored with that
    /// specification's grouping) and the person may edit grouping.</summary>
    private bool CanSetKind(S.Item i) => CanEditGrouping && _groupDoc is not null && _groupSpecPath is { } spec
        && i.Candidate.Story?.SpecificationPath is { } p && BirkNext.Specifications.SpecificationCatalogRules.SamePath(p, spec);

    /// <summary>Stores the reviewer's manual/technical choice (null = back to the suggestion) as one grouping change; nothing else changes.</summary>
    private async Task SetKindAsync(S.Item i, ScenarioTestKind? kind)
    {
        if (!CanSetKind(i)) return;
        _kindSaving = true; _kindError = null;
        try
        {
            _kindError = await ApplyGroupingAsync([new StoryGroupingOperation { Kind = StoryGroupingOperationKind.SetScenarioTestKind, ScenarioId = i.Id,
                StoryKey = i.Candidate.Story?.Key, TestKind = kind, DisplayId = $"{W.OtherScenarioLabel(i)}" }]);
        }
        finally { _kindSaving = false; }
    }

