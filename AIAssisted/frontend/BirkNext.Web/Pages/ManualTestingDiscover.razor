    private void Recompute()
    {
        // Reviewers' manual/technical decisions are part of the grouping document: applied (idempotently) whenever it changes.
        _items = S.WithTestKinds(_items, StoryGroupingEngine.TestKindDecisions(_groupDoc), _groupSpecPath);
        _items = S.WithScenarioTypes(_items, StoryGroupingEngine.ScenarioTypeDecisions(_groupDoc), RequirementTexts);
        _items = S.WithStoryStatus(_items, _storyStatus.ToDictionary(kv => kv.Key, kv => kv.Value.Status, StringComparer.Ordinal));
        var techDecisions = TechDecisions; var testsRead = _ws?.Discovery?.TestsReadForScenarios ?? false;
        _items = [.. _items.Select(i => i with { Tech = TC.Of(i.Candidate, techDecisions, testsRead).State })];
        (_queueCounts, _allCount) = S.QueueCounts(_items, _filter);
        try
        {
            _profiles = _groupInputs.Count == 0 ? [] : StoryGroupingEngine.Profiles(_groupInputs, _sections, _groupDoc);
            _orphanPlacements = StoryGroupingEngine.OrphanPlacements(_groupDoc, _groupInputs).Count;
        }
        catch (Exception e) when (e is InvalidOperationException or ArgumentException or NullReferenceException or KeyNotFoundException)
        {
            _profiles = []; _orphanPlacements = 0;
            _groupError = "Grupperingen kunne ikke beregnes.";
        }
    }

    private async Task ReloadGroupingAsync()
    {
        _groupNotice = null;
        await LoadGroupingAsync(ServiceProvider.GetService(typeof(ITestPlanSuggestionsApiService)) as ITestPlanSuggestionsApiService, _loadGeneration);
    }

    /// <summary>«Åpne scenarioer» from the review: the story's scenarios, with its group expanded (the review stays open beside them).</summary>
    private Task OpenStoryFromReviewAsync(string storyKey)
    {
        SelectStory(storyKey);
        if (_profiles.FirstOrDefault(p => p.StoryKey == storyKey) is { } p) _openGroups.Add(NodeKeyOf(p));
        return Task.CompletedTask;
    }

    private string NodeKeyOf(StoryGroupingProfile p) => _groupMode == G.Mode.Business
        ? p.GroupId is { } g && _groupDoc?.Groups.Any(x => x.Id == g) == true ? g : G.UngroupedKey
        : p.PrimaryArea is { } a ? "area:" + a : G.UngroupedKey;

    // An area opens by itself when it holds the selected story, but the tester can still collapse it (2026-11-25: its toggle used to do nothing then).
    private readonly HashSet<string> _closedGroups = new(StringComparer.Ordinal);
    private bool IsOpen(G.GroupNode n) => !_closedGroups.Contains(n.Key) && (_openGroups.Contains(n.Key) || n.Stories.Any(s => s.StoryKey == _filter.Story));
    private void ToggleGroup(string key, bool open)
    {
        if (open) { _openGroups.Remove(key); _closedGroups.Add(key); }
        else { _closedGroups.Remove(key); _openGroups.Add(key); }
    }

    private void SetMode(string? value)
    {
        if (!Enum.TryParse<G.Mode>(value, out var mode)) return;
        _groupMode = mode; _groupModeChosen = true; _drillGroup = null;
        if (mode == G.Mode.None && _filter.Story is not null && _filter.Story != W.NoStory) SelectStory(null);
    }

    /// <summary>The figures of one group: stories, unique scenarios, scenarios with saved cases and distinct established requirements (deduplicated).</summary>
    private string GroupStats(G.GroupNode n)
    {
        var keys = n.Stories.Select(s => s.StoryKey).ToHashSet(StringComparer.Ordinal);
        var scenarios = _items.Where(i => i.Candidate.Story is { } s && keys.Contains(s.Key)).DistinctBy(i => i.Id).ToList();
        var reqs = n.Stories.SelectMany(s => s.Requirements.Where(r => r.Established).Select(r => r.RequirementId)).Distinct(StringComparer.OrdinalIgnoreCase).Count();
        var withCases = scenarios.Count(i => i.Prepared is { Cases: > 0 });
        return $"{scenarios.Count} scenarioer · {reqs} krav{(withCases > 0 ? $" · {withCases} med testtilfeller" : "")}";
    }

    private IReadOnlyList<ProjectRequirementOption> CatalogFor(BirkNext.TestCoverage.CoverageUserStory story) =>
        [.. (_ws?.Requirements ?? []).Where(r => story.SpecificationPath is null || BirkNext.Specifications.SpecificationCatalogRules.SamePath(r.SpecificationPath, story.SpecificationPath))];

    /// <summary>Saves grouping / link operations as one change against the revision read. On success the profiles are recomputed and a story whose
    /// grouping suggestion changed is named; nothing else on the page (scenarios, cases, filters) is touched.</summary>
    /// <summary>A preparation saved in the drawer stored a new revision of the same grouping document: keep the page's copy current.</summary>
    private Task PreparationSavedAsync(StoryGroupingDocument doc)
    {
        if (_groupDoc is not null && BirkNext.Specifications.SpecificationCatalogRules.SamePath(doc.SpecificationPath, _groupDoc.SpecificationPath)) _groupDoc = doc;
        return Task.CompletedTask;
    }

    private async Task<string?> ApplyGroupingAsync(IReadOnlyList<StoryGroupingOperation> ops)
    {
        if (ServiceProvider.GetService(typeof(ITestPlanSuggestionsApiService)) is not ITestPlanSuggestionsApiService api || _ws?.ProjectKey is not { } key || _groupSpecPath is not { } spec || _groupDoc is null)
            return "Grupperingen kan ikke lagres nå.";
        var before = _profiles.ToDictionary(p => p.StoryKey, p => p.SuggestedArea);
        var (doc, error) = await api.ApplyStoryGroupingAsync(key, spec, new StoryGroupingChangeRequest
        {
            // The same change retried after a lost answer has the same id: the server answers with the stored document instead of applying it twice.
            RequestId = G.RequestId(_groupDoc.Revision, ops),
            ExpectedRevision = _groupDoc.Revision, Operations = [.. ops],
            RequirementCatalog = new ProjectRequirementCatalog { ProjectKey = key, Requirements = [.. _ws.Requirements ?? []] },
        });
        if (doc is null) return error ?? "Endringen ble ikke lagret.";
        _groupDoc = doc;
        Recompute();
        var changed = _profiles.Where(p => before.TryGetValue(p.StoryKey, out var was) && !string.Equals(was, p.SuggestedArea, StringComparison.Ordinal))
            .Select(p => _groupInputs.First(i => i.Story.Key == p.StoryKey).Story).Select(s => $"{W.StoryLabel(s)} → «{_profiles.First(p => p.StoryKey == s.Key).SuggestedArea ?? "trenger gruppering"}»").ToList();
        _groupNotice = changed.Count > 0 ? $"Grupperingsforslaget er endret: {string.Join(", ", changed)}. Bekreftede plasseringer er beholdt." : "Lagret.";
        StateHasChanged();
        return null;
    }

    private void StagePlacement(StoryGroupingProfile p, string? area, string? group)
    {
        _placementOps.RemoveAll(o => o.StoryKey == p.StoryKey && (area is not null ? o.Kind == StoryGroupingOperationKind.SetPrimaryArea : o.Kind == StoryGroupingOperationKind.PlaceStory));
        if (area is not null) _placementOps.Add(new StoryGroupingOperation { Kind = StoryGroupingOperationKind.SetPrimaryArea, StoryKey = p.StoryKey, PrimaryArea = area.Length == 0 ? null : area, SuggestedArea = p.SuggestedArea });
        if (group is not null) _placementOps.Add(new StoryGroupingOperation { Kind = StoryGroupingOperationKind.PlaceStory, StoryKey = p.StoryKey, GroupId = group.Length == 0 ? null : group, SuggestedArea = p.SuggestedArea });
        _placementPreview = _groupDoc is null ? [] : G.Preview(_groupInputs, _sections, _groupDoc, _placementOps, _ => true);
    }

    private void StageLeaveUngrouped(StoryGroupingProfile p)
    {
        _placementOps.RemoveAll(o => o.StoryKey == p.StoryKey);
        _placementOps.Add(new StoryGroupingOperation { Kind = StoryGroupingOperationKind.LeaveUngrouped, StoryKey = p.StoryKey, SuggestedArea = p.SuggestedArea });
        _placementPreview = _groupDoc is null ? [] : G.Preview(_groupInputs, _sections, _groupDoc, _placementOps, _ => true);
    }

    private async Task SavePlacementAsync()
    {
        if (await ApplyGroupingAsync([.. _placementOps]) is { } error) { _groupNotice = error; return; }
        _placementOps.Clear(); _placementPreview = [];
    }

    /// <summary>«Godta nytt forslag»: the story follows the new suggestion (its area, and the group that organizes it, when one does).</summary>
    private async Task AcceptSuggestionAsync(StoryGroupingProfile p) => _groupNotice = await ApplyGroupingAsync(
    [
        new StoryGroupingOperation { Kind = StoryGroupingOperationKind.SetPrimaryArea, StoryKey = p.StoryKey, PrimaryArea = p.SuggestedArea, SuggestedArea = p.SuggestedArea },
        new StoryGroupingOperation { Kind = StoryGroupingOperationKind.PlaceStory, StoryKey = p.StoryKey,
            GroupId = p.SuggestedArea is null ? null : _groupDoc?.Groups.FirstOrDefault(g => g.FunctionalAreas.Contains(p.SuggestedArea, StringComparer.OrdinalIgnoreCase))?.Id ?? p.GroupId,
            SuggestedArea = p.SuggestedArea },
    ]) ?? _groupNotice;

    /// <summary>«Behold eksisterende plassering»: the placement stays; the new suggestion is acknowledged so it is not reported again.</summary>
    private async Task KeepPlacementAsync(StoryGroupingProfile p)
    {
        var placement = _groupDoc?.Placements.LastOrDefault(x => x.StoryKey == p.StoryKey);
        _groupNotice = await ApplyGroupingAsync(
        [
            new StoryGroupingOperation { Kind = StoryGroupingOperationKind.SetPrimaryArea, StoryKey = p.StoryKey, PrimaryArea = placement?.PrimaryArea, SuggestedArea = p.SuggestedArea },
            new StoryGroupingOperation { Kind = StoryGroupingOperationKind.PlaceStory, StoryKey = p.StoryKey, GroupId = placement?.GroupId, SuggestedArea = p.SuggestedArea },
        ]) ?? _groupNotice;
    }

    /// <summary>One story row of the rail (flat or inside a group).</summary>
    // ── User story implementation status and scenario type (2026-11-26) ───────────────────────────────────────────────────────
    // The status comes from the server's shared engine (tasks.md through the import's extracted task lines), read once per selected
    // specification in the background (a newer selection makes an older answer irrelevant). The scenario type is the shared classifier with the
    // reviewers' decisions from the grouping document. Neither changes a scenario, a test case, a plan or a source file.

    private Dictionary<string, UserStoryImplementationStatus> _storyStatus = new(StringComparer.Ordinal);
    private UserStoryStatusView? _storyStatusView;
    private bool _storyStatusLoading;
    private string? _storyStatusError, _storyStatusFor, _statusOpenFor;
    private int _storyStatusGeneration;
    private bool _confirmBusy;
    private string? _confirmError;
    private string _confirmNote = "";

    private IReadOnlyDictionary<string, string> RequirementTexts =>
        (_ws?.Requirements ?? []).GroupBy(r => r.RequirementId, StringComparer.OrdinalIgnoreCase).ToDictionary(g => g.Key, g => g.First().Title, StringComparer.OrdinalIgnoreCase);

    /// <summary>The group a scenario is listed under when grouping by test level or by scenario type (each scenario in exactly one group).</summary>
    private string GroupKey(S.Item i) => _groupMode == G.Mode.TestLevel ? i.Level.Level.ToString() : i.TypeKey;

    private string GroupLabel(string key) => _groupMode == G.Mode.TestLevel && Enum.TryParse<ScenarioTestLevel>(key, out var lv) ? TestLevelClassifier.Label(lv) : S.TypeGroupLabel(key);

    private int GroupRank(S.Item i) => _groupMode == G.Mode.TestLevel ? Array.IndexOf(TestLevelClassifier.Order, i.Level.Level) : TypeRank(i.TypeKey);

    private static int TypeRank(string key) => key switch
    {
        nameof(ScenarioRequirementType.Functional) => 0, nameof(ScenarioRequirementType.NonFunctional) => 1, nameof(ScenarioRequirementType.Mixed) => 2,
        nameof(ScenarioRequirementType.Unclassified) => 3, S.RequirementGroup => 4, _ => 5,
    };

    private UserStoryImplementationStatus? StatusOf(string? storyKey) => storyKey is not null && _storyStatus.TryGetValue(storyKey, out var s) ? s : null;

    private async Task LoadStoryStatusAsync()
    {
        if (_ws?.ProjectKey is not { } key || ServiceProvider.GetService(typeof(ITestPlanSuggestionsApiService)) is not ITestPlanSuggestionsApiService api) return;
        var spec = _groupSpecPath ?? SelectedSpecificationPath;
        var scope = $"{key}|{spec}";
        if (_storyStatusFor == scope && (_storyStatusLoading || _storyStatusView is not null)) return;
        var generation = ++_storyStatusGeneration;
        (_storyStatusFor, _storyStatusLoading, _storyStatusError) = (scope, true, null);
        StateHasChanged();
        try
        {
            var (view, error) = await api.StoryStatusAsync(key, spec);
            if (generation != _storyStatusGeneration) return;
            _storyStatusView = view;
            _storyStatusError = view is null ? error ?? "Ukjent feil." : null;
            _storyStatus = view?.Stories.ToDictionary(s => s.StoryKey, StringComparer.Ordinal) ?? new(StringComparer.Ordinal);
            Recompute();
        }
        catch (Exception e) when (e is not OperationCanceledException) { if (generation == _storyStatusGeneration) _storyStatusError = e.Message; }
        finally { if (generation == _storyStatusGeneration) _storyStatusLoading = false; }
        StateHasChanged();
    }

    private Task RetryStoryStatusAsync() { _storyStatusFor = null; _storyStatusView = null; return LoadStoryStatusAsync(); }

    /// <summary>The story's acceptance scenarios by type, counted once each (a mixed scenario only as mixed).</summary>
    private string TypeDistribution(string storyKey)
    {
        var typed = _items.Where(i => i.Candidate.Story?.Key == storyKey && i.TypeResult is not null).GroupBy(i => i.TypeResult!.Type).ToDictionary(g => g.Key, g => g.Count());
        if (typed.Count == 0) return "";
        string Part(ScenarioRequirementType t, string one, string many) => typed.TryGetValue(t, out var n) && n > 0 ? $"{n} {(n == 1 ? one : many)}" : "";
        return string.Join(" · ", new[]
        {
            Part(ScenarioRequirementType.Functional, "funksjonelt", "funksjonelle"), Part(ScenarioRequirementType.NonFunctional, "ikke-funksjonelt", "ikke-funksjonelle"),
            Part(ScenarioRequirementType.Mixed, "blandet", "blandede"), Part(ScenarioRequirementType.Unclassified, "uavklart", "uavklarte"),
        }.Where(x => x.Length > 0));
    }

    /// <summary>The compact status on a story card or rail entry: one badge and the task count (nothing when not loaded).</summary>
    private RenderFragment CompactStatus(string storyKey) => __builder =>
    {
        if (StatusOf(storyKey) is not { } s) return;
        <span class="mtw-impl-compact" data-testid="mtd-story-impl" data-status="@s.Status">
            <span class="msb-status msb-tone-@UserStoryStatusText.Tone(s.Status)">@UserStoryStatusText.Label(s.Status)</span>
            @if (s.ProgressPercent is not null) { <span class="mt-muted">@s.Completed/@s.Eligible oppgaver</span> }
        </span>
    };

    /// <summary>The story card's implementation summary (always shown, whatever the dashboard settings) and, on demand, its evidence.</summary>
    private RenderFragment StoryStatusBlock(string storyKey) => __builder =>
    {
        var s = StatusOf(storyKey);
        if (s is null)
        {
            if (_storyStatusLoading) { <InlineLoading Text="Henter implementeringsstatus …" Class="mt-muted msb-small" TestId="mtd-us-status-loading" /> }
            else if (_storyStatusError is { } err) { <p class="msb-small mt-muted" role="status" data-testid="mtd-us-status-error">Implementeringsstatus kunne ikke hentes (@err). <button type="button" class="msb-link" @onclick="RetryStoryStatusAsync" data-testid="mtd-us-status-retry">Prøv igjen</button></p> }
            return;
        }
        var remaining = s.Open + s.Partial + s.UnknownState;
        var types = TypeDistribution(storyKey);
        var open = _statusOpenFor == s.StoryKey;
        <div class="mtw-impl" data-testid="mtd-us-status" data-status="@s.Status">
            <span class="msb-status msb-tone-@UserStoryStatusText.Tone(s.Status)" data-testid="mtd-us-status-badge">@UserStoryStatusText.Label(s.Status)</span>
            @if (s.ProgressPercent is { } pct)
            {
                <span class="mtw-impl-count" data-testid="mtd-us-status-count">@s.Completed av @s.Eligible oppgaver fullført</span>
                <span class="mtw-impl-bar" role="progressbar" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100" aria-label="Oppgaver fullført"><span style="width:@(pct)%"></span></span>
                <span class="mtw-impl-pct" data-testid="mtd-us-status-pct">@pct %</span>
                @if (remaining > 0) { <span class="mtw-impl-remaining" data-testid="mtd-us-status-remaining">@remaining oppgave@(remaining == 1 ? "" : "r") gjenstår</span> }
            }
            else if (s.Eligible == 0)
            {
                <span class="mt-muted" data-testid="mtd-us-status-unavailable">Oppgavestatus er ikke tilgjengelig.</span>
            }
            else
            {
                <span class="mt-muted" data-testid="mtd-us-status-unavailable">@s.Completed av @s.Eligible oppgaver fullført · framdrift kan ikke beregnes sikkert.</span>
            }
            <span class="mtw-impl-confirm is-@s.Confirmation.ToString().ToLowerInvariant()" data-testid="mtd-us-confirmation">@UserStoryStatusText.Label(s.Confirmation)</span>
            @if (types.Length > 0) { <span class="mtw-impl-types" data-testid="mtd-us-ac-types">Akseptansescenarioer: @types</span> }
            <button type="button" class="mtw-toggle" aria-expanded="@(open ? "true" : "false")" aria-controls="mtd-us-status-details"
                    @onclick="() => { _statusOpenFor = open ? null : s.StoryKey; _confirmError = null; }" data-testid="mtd-us-status-toggle">@(open ? "Skjul statusgrunnlag" : "Se statusgrunnlag")</button>
        </div>
        @if (open) { @StatusDetails(s) }
    };

    private RenderFragment StatusDetails(UserStoryImplementationStatus s) => __builder =>
    {
        var remaining = s.Tasks.Where(t => t.State is not (UserStoryTaskState.Complete or UserStoryTaskState.CancelledOrDeferred)).ToList();
        var done = s.Tasks.Where(t => t.State == UserStoryTaskState.Complete).ToList();
        var cancelled = s.Tasks.Where(t => t.State == UserStoryTaskState.CancelledOrDeferred).ToList();
        var typed = _items.Where(i => i.Candidate.Story?.Key == s.StoryKey && i.TypeResult is not null).ToList();
        <div class="mtw-impl-details" id="mtd-us-status-details" data-testid="mtd-us-status-details">
            <section class="mtw-block" data-testid="mtd-us-status-summary">
                <h3 class="mtp-ctx-label">Implementeringsstatus</h3>
                <p class="msb-small">@s.Explanation</p>
                <ul class="msb-small mtw-impl-facts">
                    <li>Oppgaver: @s.Completed av @s.Eligible fullført@(s.Partial > 0 ? $" · {s.Partial} delvis" : "")@(s.UnknownState > 0 ? $" · {s.UnknownState} med ukjent markering" : "")@(s.Cancelled > 0 ? $" · {s.Cancelled} utgått (ikke telt)" : "")</li>
                    <li data-testid="mtd-us-status-evidence">Grunnlag: @UserStoryStatusText.Label(s.Evidence) — @s.EvidenceText</li>
                    <li>Kildeversjon: @(_storyStatusView?.SnapshotId is { } snap ? $"kildeøyeblikksbilde {snap.ToString()[..8]}" : "ukjent")@(_storyStatusView?.SourceReadAt is { } read ? $", lest {read.ToLocalTime():dd.MM.yyyy HH:mm}" : "")@(_storyStatusView?.SourcesDiffer == true ? " · oppgavene og spesifikasjonen er fra ulike importer" : "")</li>
                    <li data-testid="mtd-us-status-confirmation">Bekreftelse: @UserStoryStatusText.Label(s.Confirmation)@(s.ConfirmedBy is { } by ? $" ({by}, {s.ConfirmedAt?.ToLocalTime():dd.MM.yyyy})" : "")</li>
                </ul>
            </section>
            @if (remaining.Count > 0)
            {
                <section class="mtw-block" data-testid="mtd-us-status-remaining-list">
                    <h3 class="mtp-ctx-label">Gjenstående oppgaver (@remaining.Count)</h3>
                    <ul class="mtw-task-list">@foreach (var t in remaining) { @TaskLine(t) }</ul>
                </section>
            }
            @if (done.Count > 0)
            {
                <details class="mtw-block" data-testid="mtd-us-status-done"><summary class="mtp-ctx-label">Fullførte oppgaver (@done.Count)</summary>
                    <ul class="mtw-task-list">@foreach (var t in done) { @TaskLine(t) }</ul></details>
            }
            @if (cancelled.Count > 0)
            {
                <details class="mtw-block" data-testid="mtd-us-status-cancelled"><summary class="mtp-ctx-label">Utgåtte oppgaver, ikke telt (@cancelled.Count)</summary>
                    <ul class="mtw-task-list">@foreach (var t in cancelled) { @TaskLine(t) }</ul></details>
            }
            @if (s.Dependencies.Count > 0 || s.SharedOpen.Count > 0)
            {
                <section class="mtw-block" data-testid="mtd-us-status-dependencies">
                    <h3 class="mtp-ctx-label">Avhengigheter</h3>
                    <p class="mt-muted msb-small">«Bekreftet avhengighet» står uttrykkelig i oppgaven («depends on», «requires», «after»). «Relatert oppgave» er bare nevnt og endrer ikke statusen. Fellesoppgaver hører til hele spesifikasjonen og telles ikke for brukerhistorien.</p>
                    <ul class="msb-small">
                        @foreach (var d in s.Dependencies.OrderBy(d => d.Kind))
                        {
                            <li data-testid="mtd-us-dependency" data-kind="@d.Kind"><span class="msb-status msb-tone-@(d.Kind == UserStoryDependencyKind.Blocking ? (d.TargetOpen ? "warn" : "ok") : "muted")">@UserStoryStatusText.Label(d.Kind)</span>
                                @d.FromTaskId → @d.ToTaskId@(d.TargetStory is { } ts ? $" ({ts})" : "")@(d.Kind != UserStoryDependencyKind.Unresolved ? (d.TargetOpen ? " · ikke fullført" : " · fullført") : "") <span class="mt-muted">@d.Evidence</span></li>
                        }
                    </ul>
                    @if (s.SharedOpen.Count > 0)
                    {
                        <details data-testid="mtd-us-shared"><summary class="msb-small">Fellesoppgaver i spesifikasjonen som gjenstår (@s.SharedOpen.Count) — mulig avhengighet, ikke bekreftet</summary>
                            <ul class="mtw-task-list">@foreach (var t in s.SharedOpen) { @TaskLine(t) }</ul></details>
                    }
                </section>
            }
            @if (s.Diagnostics.Count > 0)
            {
                <section class="mtw-block" data-testid="mtd-us-status-diagnostics"><h3 class="mtp-ctx-label">Merknader</h3>
                    <ul class="msb-small">@foreach (var d in s.Diagnostics) { <li>@d</li> }</ul></section>
            }
            <section class="mtw-block" data-testid="mtd-us-status-types">
                <h3 class="mtp-ctx-label">Scenarioklassifisering</h3>
                @if (typed.Count == 0) { <p class="mt-muted msb-small">Ingen akseptansescenarioer i utvalget.</p> }
                else
                {
                    <p class="msb-small">@TypeDistribution(s.StoryKey)</p>
                    @if (typed.SelectMany(i => i.TypeResult!.Qualities).Distinct().ToList() is { Count: > 0 } qualities)
                    {
                        <p class="msb-small mt-muted">Kvalitetsegenskaper: @string.Join(", ", qualities.Select(ScenarioTypeClassifier.Label))</p>
                    }
                    <p class="msb-small mt-muted">Typen er vurdert per akseptansescenario fra det scenarioet selv sier; åpne et scenario for begrunnelsen.</p>
                }
            </section>
            <details class="mtw-block" data-testid="mtd-us-status-source"><summary class="mtp-ctx-label">Kildegrunnlag</summary>
                <p class="msb-small">@(s.TasksPath ?? "tasks.md finnes ikke for spesifikasjonen") · regelsett @(_storyStatusView?.RuleVersion)</p>
                <p class="msb-small mt-muted">Spesifikasjon: @s.SpecificationPath</p></details>
            @if (_ws?.Plans?.CanWrite == true && s.Eligible > 0)
            {
                <section class="mtw-block mtw-impl-confirm-form" data-testid="mtd-us-confirm">
                    <h3 class="mtp-ctx-label">Bekreft implementering</h3>
                    <p class="mt-muted msb-small">En bekreftelse er din vurdering av at funksjonaliteten er implementert, og gjelder oppgavegrunnlaget som vises nå. Endres oppgavene, må den gis på nytt. Avkryssede oppgaver bekrefter ikke dette alene.</p>
                    <input class="form-control form-control-sm" placeholder="Begrunnelse (valgfritt)" value="@_confirmNote" @oninput="e => _confirmNote = e.Value?.ToString() ?? string.Empty" data-testid="mtd-us-confirm-note" />
                    @if (s.Confirmation == UserStoryConfirmation.ConfirmedImplemented)
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_confirmBusy" @onclick="() => ConfirmAsync(s, false)" data-testid="mtd-us-unconfirm">Trekk tilbake bekreftelsen</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-primary btn-sm" disabled="@_confirmBusy" @onclick="() => ConfirmAsync(s, true)" data-testid="mtd-us-confirm-button">Bekreft implementert</button>
                    }
                    @if (_confirmError is { } ce) { <p class="mt-alert msb-small" role="alert" data-testid="mtd-us-confirm-error">@ce</p> }
                </section>
            }
        </div>
    };

    private static RenderFragment TaskLine(UserStoryTaskRef t) => __builder =>
    {
        <li class="mtw-task" data-testid="mtd-us-task" data-task="@t.TaskId" data-state="@t.State">
            <span class="mtw-task-id">@t.TaskId</span>
            <span class="msb-status msb-tone-@(t.State switch { UserStoryTaskState.Complete => "ok", UserStoryTaskState.Partial => "progress", UserStoryTaskState.Unknown => "warn", _ => "muted" })">@UserStoryStatusText.Label(t.State)</span>
            <span class="mtw-task-text" title="@t.Text">@(t.Text.Length > 220 ? t.Text[..220] + "…" : t.Text)</span>
            <span class="mtw-task-meta mt-muted">@(t.Link switch { UserStoryTaskLink.ExplicitTag => "Merket i oppgaven", UserStoryTaskLink.StoryPhase => "Via fasen", _ => "Motstridende kobling" })@(t.Phase is { } ph ? $" · {ph}" : "") · linje @t.Line@(t.StateNote is { } sn ? $" · {sn}" : "")@(t.LinkNote is { } ln ? $" · {ln}" : "")</span>
        </li>
    };

    private async Task ConfirmAsync(UserStoryImplementationStatus s, bool confirmed)
    {
        if (_confirmBusy || _ws?.ProjectKey is not { } key || ServiceProvider.GetService(typeof(ITestPlanSuggestionsApiService)) is not ITestPlanSuggestionsApiService api) return;
        _confirmBusy = true; _confirmError = null;
        try
        {
            var (story, error) = await api.ConfirmStoryAsync(new ConfirmUserStoryRequest(key, s.StoryKey, confirmed, string.IsNullOrWhiteSpace(_confirmNote) ? null : _confirmNote.Trim()));
            if (story is null) { _confirmError = error ?? "Bekreftelsen kunne ikke lagres."; return; }
            _storyStatus[story.StoryKey] = story;
            _confirmNote = "";
        }
        finally { _confirmBusy = false; }
    }

    // ── Scenario type in the drawer ──
    private string? _typeDraftFor;
    private ScenarioRequirementType? _typeDraft;
    private HashSet<QualityAttribute> _qualityDraft = [];
    private string _typeReason = "";
    private string? _typeError;
    private bool _typeBusy;

    private RenderFragment ScenarioTypeSection(S.Item item) => __builder =>
    {
        <p class="msb-small mtw-level" data-testid="mtd-detail-level" data-level="@item.Level.Level"><span class="mtp-ctx-label">Testnivå</span> <b>@TestLevelClassifier.Label(item.Level.Level)</b>@(item.Level.Candidate ? " (kandidat)" : "") — <span class="mt-muted">@item.Level.Explanation</span></p>
        if (item.TypeResult is not { } type)
        {
            if (S.IsRequirementOnly(item.Candidate)) { <p class="mt-muted msb-small" data-testid="mtd-detail-type-requirement">Dette er et krav uten akseptansescenario i spesifikasjonen; det får ingen scenariotype.</p> }
            return;
        }
        <details class="mtw-block mtw-type" data-testid="mtd-detail-type" data-type="@type.Type" open="@(type.Basis == ScenarioTypeBasis.Unresolved)">
            <summary><span class="mtp-ctx-label">Scenariotype</span> <b data-testid="mtd-detail-type-label">@ScenarioTypeClassifier.Label(type.Type)</b>@(type.Qualities.Count > 0 ? " · " + string.Join(", ", type.Qualities.Select(ScenarioTypeClassifier.Label)) : "")
                <span class="msb-status msb-tone-@(type.Reviewed ? "ok" : type.Basis == ScenarioTypeBasis.Unresolved ? "warn" : "muted")" data-testid="mtd-detail-type-basis">@ScenarioTypeClassifier.BasisLabel(type.Basis)</span></summary>
            <p class="msb-small" data-testid="mtd-detail-type-why">@type.Explanation</p>
            @if (type.Evidence.Count > 0) { <ul class="msb-small" data-testid="mtd-detail-type-evidence">@foreach (var ev in type.Evidence) { <li>@ev</li> }</ul> }
            <p class="mt-muted msb-small">Scenariotypen er uavhengig av testtype (manuell/teknisk), testnivå og om brukerhistorien er ferdig. Regelsett @type.RuleVersion.</p>
            @if (CanEditGrouping && item.Candidate.Story is not null)
            {
                var draft = _typeDraftFor == item.Id ? _typeDraft : type.Type;
                <div class="mtw-type-review" data-testid="mtd-type-review">
                    <label class="msb-small">Vurdering
                        <select class="msb-select" @onchange="e => { _typeDraftFor = item.Id; _typeDraft = Enum.TryParse<ScenarioRequirementType>(e.Value?.ToString(), out var t) ? t : null; _qualityDraft = [.. type.Qualities]; }" data-testid="mtd-type-select">
                            @foreach (var t in ScenarioTypeClassifier.Order) { <option value="@t" selected="@(draft == t)">@ScenarioTypeClassifier.Label(t)</option> }
                        </select></label>
                    @if (draft is ScenarioRequirementType.NonFunctional or ScenarioRequirementType.Mixed)
                    {
                        <fieldset class="mtw-quality-picks msb-small"><legend>Kvalitetsegenskaper</legend>
                            @foreach (var q in Enum.GetValues<QualityAttribute>())
                            {
                                var quality = q;
                                var on = (_typeDraftFor == item.Id ? _qualityDraft : type.Qualities.ToHashSet()).Contains(quality);
                                <label><input type="checkbox" checked="@on" @onchange="e => ToggleQuality(item, type, quality, e.Value is true)" data-testid="mtd-type-quality" data-quality="@quality" /> @ScenarioTypeClassifier.Label(quality)</label>
                            }
                        </fieldset>
                    }
                    <input class="form-control form-control-sm" placeholder="Begrunnelse" value="@(_typeDraftFor == item.Id ? _typeReason : "")" @oninput="e => { _typeDraftFor = item.Id; _typeDraft ??= type.Type; _typeReason = e.Value?.ToString() ?? string.Empty; }" data-testid="mtd-type-reason" />
                    <button type="button" class="btn btn-outline-primary btn-sm" disabled="@_typeBusy" @onclick="() => SaveTypeAsync(item, type, confirm: _typeDraftFor != item.Id)" data-testid="mtd-type-save">@(_typeDraftFor == item.Id ? "Lagre vurdering" : "Bekreft forslaget")</button>
                    @if (type.Reviewed) { <button type="button" class="msb-link" disabled="@_typeBusy" @onclick="() => ClearTypeAsync(item)" data-testid="mtd-type-clear">Tilbake til forslaget</button> }
                    @if (_typeError is { } te && _typeDraftFor == item.Id) { <p class="mt-alert msb-small" role="alert" data-testid="mtd-type-error">@te</p> }
                </div>
            }
        </details>
    };

    private void ToggleQuality(S.Item item, ScenarioTypeResult type, QualityAttribute quality, bool on)
    {
        if (_typeDraftFor != item.Id) { _typeDraftFor = item.Id; _typeDraft = type.Type; _qualityDraft = [.. type.Qualities]; }
        if (on) _qualityDraft.Add(quality); else _qualityDraft.Remove(quality);
    }

    private async Task SaveTypeAsync(S.Item item, ScenarioTypeResult type, bool confirm)
    {
        var chosen = confirm ? type.Type : _typeDraft ?? type.Type;
        var qualities = confirm ? [.. type.Qualities] : _qualityDraft.ToList();
        await ApplyTypeAsync(item, chosen, qualities, confirm ? "Forslaget bekreftet" : _typeReason);
    }

    private Task ClearTypeAsync(S.Item item) => ApplyTypeAsync(item, null, [], "Tilbake til forslaget");

    private async Task ApplyTypeAsync(S.Item item, ScenarioRequirementType? chosen, List<QualityAttribute> qualities, string? reason)
    {
        if (_typeBusy) return;
        _typeBusy = true; _typeError = null; _typeDraftFor = item.Id;
        try
        {
            _typeError = await ApplyGroupingAsync([new StoryGroupingOperation
            {
                Kind = StoryGroupingOperationKind.SetScenarioType, ScenarioId = item.Candidate.SourceIdentity, StoryKey = item.Candidate.Story?.Key, DisplayId = W.ScenarioLabel(item),
                ScenarioType = chosen, Qualities = qualities, Reason = string.IsNullOrWhiteSpace(reason) ? null : reason.Trim(), ScenarioFingerprint = item.Candidate.Fingerprint,
            }]);
            if (_typeError is null) { _typeDraftFor = null; _typeDraft = null; _typeReason = ""; _qualityDraft = []; }
        }
        finally { _typeBusy = false; }
    }

    private RenderFragment StoryButton((W.StoryEntry Entry, bool ShowTechnical) args) => __builder =>
    {
        var entry = args.Entry; var showTechnical = args.ShowTechnical;
        <button type="button" class="mtw-story @(_filter.Story == entry.Key ? "is-current" : null) @(entry.Story is null ? "is-none" : null)"
