    /// <summary>Everything the workspace derives from the scenario list and the filter, computed once per change (never per render: every keystroke
    /// re-renders, and each pass reads every scenario).</summary>
    private sealed record WorkspaceView(List<W.StoryEntry> Stories, W.StoryEntry? CurrentStory, List<W.StoryEntry> Rail, int HiddenStories,
        (List<S.Item> Shown, int HiddenTechnical) All, List<S.Item> Scope);
    private (S.Filter Filter, List<S.Item> Items, WorkspaceView View)? _viewMemo;

    private (string Id, List<W.ChecklistItem> Items)? _checklistMemo;

    /// <summary>The open scenario's six readiness questions, computed once per scenario.</summary>
    private List<W.ChecklistItem> Checklist(S.Item item)
    {
        if (_checklistMemo is { } m && m.Id == item.Id) return m.Items;
        var items = W.Checklist(TestDesignAdvisor.Readiness(TestDesignAdvisor.AsDraft(item.Candidate)));
        _checklistMemo = (item.Id, items);
        return items;
    }

    private WorkspaceView CurrentView()
    {
        if (_viewMemo is { } m && m.Filter == _filter && ReferenceEquals(m.Items, _items)) return m.View;
        var stories = W.Stories(_items, _filter);
        var (rail, hidden) = W.RailStories(stories, _filter.Technical || _filter.All, _filter.Story);
        var view = new WorkspaceView(stories, stories.FirstOrDefault(s => s.Key == _filter.Story), rail, hidden,
            S.Apply(_items, _filter with { Story = null, Queue = null }), S.Apply(_items, _filter with { Queue = null }).Shown);
        _viewMemo = (_filter, _items, view);
        return view;
    }

    private static readonly (string Tab, string Label)[] TabLabels = [(W.Tabs.Scenarios, "Scenarioer"), (W.Tabs.Cases, "Testtilfeller"), (W.Tabs.Coverage, "Testdekning")];
    private string _tab = W.Tabs.Scenarios;
    private bool _storyDetails, _designOpen, _contextRestored, _showWeak;
    private string? _openRequirement, _focusRequirement, _missingScenario, _activeTitle;
    private (string Id, int Items, PreparedCaseTraceView? Trace, List<ProjectRequirementOption>? Catalog, List<W.RequirementLink> Links)? _linksMemo;

    /// <summary>A user story group (null = «Alle scenarioer»): a filter of the one list. The open scenario stays open.</summary>
    private void SelectStory(string? key)
    {
        _storyDetails = false;
        Set(_filter with { Story = key, Queue = key is null ? _filter.Queue : null });
    }

    private void SetTab(string tab) { _tab = tab; _ = SaveContextAsync(); }

    /// <summary>Opens a scenario in the detail panel (from the list, a breadcrumb, a requirement or the case tab).</summary>
    private void Open(string id)
    {
        _active = id;
        _missingScenario = null;
        _openRequirement = null;
        _activeTitle = _items.FirstOrDefault(i => i.Id == id)?.Title;
        _ = SaveContextAsync();
    }

    private void ToggleRequirement(string id) => _openRequirement = _openRequirement == id ? null : id;

    /// <summary>«Vis alle scenarioer for FR-…»: every scenario naming it, across all stories.</summary>
    private void FilterRequirement(string id)
    {
        _tab = W.Tabs.Scenarios;
        Set(new S.Filter(Requirement: id, All: true));
    }

    /// <summary>A requirement of the story header: shown in the story's coverage.</summary>
    private void OpenRequirementTab(string id) { _focusRequirement = id; SetTab(W.Tabs.Coverage); }

    /// <summary>The open scenario's requirement relations, computed once per scenario / trace / catalog (never per render).</summary>
    private List<W.RequirementLink> Links(S.Item item, List<PreparedCaseTrace> cases)
    {
        if (_linksMemo is { } m && m.Id == item.Id && m.Items == _items.Count && ReferenceEquals(m.Trace, _trace) && ReferenceEquals(m.Catalog, _ws?.Requirements)) return m.Links;
        var links = W.Requirements(item.Candidate, _ws?.Requirements, cases);
        _linksMemo = (item.Id, _items.Count, _trace, _ws?.Requirements, links);
        return links;
    }

    /// <summary>The source's own Given / When / Then (never BirkNext's composed steps); empty when the source has none.</summary>
    private static List<(string Label, string Text)> SourceGwt(DiscoveredScenario c)
    {
        string? T(string key) => c.Template.FirstOrDefault(t => t.Key == key)?.Value is { Length: > 0 } v ? v : null;
        return [.. new[] { ("Gitt", T("given")), ("Når", T("when")), ("Så", T("then")) }.Where(x => x.Item2 is not null).Select(x => (x.Item1, x.Item2!))];
    }

    private static string CaseTone(PreparedCaseTrace k) => k.Stage switch
    {
        PreparedCaseStage.Approved => "ok", PreparedCaseStage.NeedsClarification => "warn", _ => "info",
    };

    private async Task SaveContextAsync()
    {
        if (_ws?.ProjectKey is not { } key) return;
        await TabDraftStore.WriteAsync(JS, TabDraftStore.DiscoverContextKey(key), new W.WorkContext(_filter.Story, _active, _tab, _activeTitle));
    }

    private async Task SelectAll(IEnumerable<S.Item> items) { foreach (var i in items) _selected.Add(i.Id); await KeepAsync(); }

    private async Task ClearSelection() { _selected.Clear(); await KeepAsync(); }

    private async Task KeepAsync()
    {
        if (_ws?.ProjectKey is not { } key) return;
        if (_selected.Count == 0) await TabDraftStore.RemoveAsync(JS, TabDraftStore.SelectionKey(key));
        else await TabDraftStore.WriteAsync(JS, TabDraftStore.SelectionKey(key), _selected.Order(StringComparer.Ordinal).ToArray());
    }

    private async Task PrepareAsync() { await KeepAsync(); Nav.NavigateTo(M.PlanRoute); }

    private async Task PrepareOnlyAsync(string id) { _selected.Add(id); await PrepareAsync(); }

    /// <summary>↑/↓ move, Space selects, Home/End jump — the list keeps one active scenario whose details are shown.</summary>
    private async Task KeyAsync(KeyboardEventArgs e, List<S.Item> page)
    {
        if (page.Count == 0) return;
        var index = Math.Max(0, page.FindIndex(i => i.Id == _active));
        switch (e.Key)
        {
            case "ArrowDown": _active = page[Math.Min(page.Count - 1, index + 1)].Id; break;
            case "ArrowUp": _active = page[Math.Max(0, index - 1)].Id; break;
            case "Home": _active = page[0].Id; break;
            case "End": _active = page[^1].Id; break;
            case " ": if (_active is { } a) await ToggleAsync(a); break;
        }
    }

    private static string RelationLabel(ScenarioRelation relation) => relation switch
    {
        ScenarioRelation.Equivalent => "tilsvarende", ScenarioRelation.Conflicting => "motstridende", ScenarioRelation.Variant => "variant", ScenarioRelation.Related => "samme krav", _ => "duplikat",
    };

    private static string EvidenceKind(string kind) => kind switch
    {
        "specification" => "Spesifikasjon", "requirement" => "Krav", "story" => "Brukerhistorie", "guide-scenario" or "guide-step" => "Systemforståelse",
        "source-file" => "Kildefil", "contract-operation" => "API-kontrakt", "journey" => "Integrasjonsflyt", "journey-run" => "Kjøring", "developer-test" => "Utviklertest",
        "source-evidence" => "Kildebevis", _ => kind,
    };

    private static string StateLabel(DiscoveryCapabilityState state) => state switch
    {
        DiscoveryCapabilityState.Available => "Funnet", DiscoveryCapabilityState.NoEvidence => "Ingen bevis", DiscoveryCapabilityState.NotApplicable => "Ikke aktuelt",
        DiscoveryCapabilityState.Failed => "Kunne ikke leses", _ => state.ToString(),
    };

    /// <summary>
    /// The current workspace changed. Only another project resets the page (its selection belongs to that project); the same project — a module or
    /// specification choice being saved, documents loaded — is read again in place, keeping the selection, the open scenario and the filters.
    /// Before (2026-11-24): every change blanked the page and cleared the tester's selection, so choosing a specification looked like a page refresh.
    /// </summary>
    private void OnProjectChanged() => _ = InvokeAsync(async () =>
    {
        var before = _ws?.ProjectKey;
        var key = (await new ManualTestingWorkspace(ServiceProvider).LoadAsync(discovery: false, requirements: false)).ProjectKey;
        if (!string.Equals(before, key, StringComparison.Ordinal)) { _ws = null; _trace = null; _items = []; _selected.Clear(); _active = null; _filter = S.DefaultView; _missingScenario = null; _activeTitle = null; _tab = W.Tabs.Scenarios; }
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() { if (_projection is not null) _projection.Changed -= OnProjectChanged; }
}
