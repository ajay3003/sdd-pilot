    // ── FR-based grouping (2026-11-24) ───────────────────────────────────────────────────────────────────────────

    private StoryGroupingDocument? _groupDoc;
    private RequirementSectionMap _sections = RequirementSectionMap.Empty;
    private List<StoryGroupingEngine.StoryInputs> _groupInputs = [];
    private List<StoryGroupingProfile> _profiles = [];
    private G.Mode _groupMode = G.Mode.Stories;
    private bool _groupModeChosen, _manageGroups, _groupWritable;
    private string? _groupNotice, _groupSpecPath;
    private readonly HashSet<string> _openGroups = new(StringComparer.Ordinal);
    private readonly List<StoryGroupingOperation> _placementOps = [];
    private List<string> _placementPreview = [];

    /// <summary>Editing needs the same permission as saving a test plan, and a grouping document that could be read.</summary>
    private bool CanEditGrouping => _groupWritable && _ws?.Plans?.CanWrite == true;

    private IEnumerable<G.Mode> AvailableModes => new[] { G.Mode.Business, G.Mode.Functional, G.Mode.Stories, G.Mode.None }
        .Where(m => m switch { G.Mode.Business => _groupDoc is { Groups.Count: > 0 } || _groupMode == G.Mode.Business, G.Mode.Functional => _sections.Sections.Count > 0, _ => true });

    /// <summary>
    /// The grouping of the selected specification: its FR sections (read from the specification text the page already has), the stories with the
    /// browser's own evidence (tasks.md links included), and the stored review decisions. Read once per load; profiles are recomputed only when
    /// the inputs or the decisions change, never per render.
    /// </summary>
    private async Task LoadGroupingAsync(ITestPlanSuggestionsApiService? api, int generation)
    {
        _groupSpecPath = SelectedSpecificationPath?.Replace('\\', '/').TrimStart('/');
        _sections = RequirementSections.Read(_ws?.Specification?.Content);
        var inScope = _items.Where(i => i.Candidate.Story?.SpecificationPath is { } p && _groupSpecPath is not null
            && BirkNext.Specifications.SpecificationCatalogRules.SamePath(p, _groupSpecPath)).ToList();
        _groupInputs = G.Inputs(inScope, _ws?.Evidence, _ws?.Requirements);
        _groupDoc = null; _groupWritable = false;
        if (_groupInputs.Count > 0 && api is not null && _ws?.ProjectKey is { } key && _groupSpecPath is { } spec)
        {
            var (doc, _) = await api.StoryGroupingAsync(key, spec);
            if (generation != _loadGeneration) return;
            _groupWritable = doc is not null;
            _groupDoc = doc ?? new StoryGroupingDocument { ProjectKey = key, SpecificationPath = spec };
        }
        Recompute();
        if (!_groupModeChosen) _groupMode = _groupInputs.Count == 0 ? G.Mode.Stories : G.DefaultMode(_groupDoc, _sections);
        // The group of the open story starts expanded.
        if (_profiles.FirstOrDefault(p => p.StoryKey == _filter.Story) is { } open) _openGroups.Add(NodeKeyOf(open));
    }

    private void Recompute() => _profiles = _groupInputs.Count == 0 ? [] : StoryGroupingEngine.Profiles(_groupInputs, _sections, _groupDoc);

    private string NodeKeyOf(StoryGroupingProfile p) => _groupMode == G.Mode.Business
        ? p.GroupId ?? G.UngroupedKey
        : p.PrimaryArea is { } a ? "area:" + a : p.State == GroupingState.NoRequirements ? G.NoRequirementsKey : G.NeedsGroupingKey;

    private bool IsOpen(G.GroupNode n) => _openGroups.Contains(n.Key) || n.Stories.Any(s => s.StoryKey == _filter.Story);
    private void ToggleGroup(string key) { if (!_openGroups.Remove(key)) _openGroups.Add(key); }

    private void SetMode(string? value)
    {
        if (!Enum.TryParse<G.Mode>(value, out var mode)) return;
        _groupMode = mode; _groupModeChosen = true;
        if (mode == G.Mode.None && _filter.Story is not null && _filter.Story != W.NoStory) SelectStory(null);
    }

    /// <summary>The figures of one group: stories, unique scenarios, scenarios with saved cases and distinct established requirements (deduplicated).</summary>
    private string GroupStats(G.GroupNode n)
    {
        var keys = n.Stories.Select(s => s.StoryKey).ToHashSet(StringComparer.Ordinal);
        var scenarios = _items.Where(i => i.Candidate.Story is { } s && keys.Contains(s.Key)).DistinctBy(i => i.Id).ToList();
        var reqs = n.Stories.SelectMany(s => s.Requirements.Where(r => r.Established).Select(r => r.RequirementId)).Distinct(StringComparer.OrdinalIgnoreCase).Count();
        var withCases = scenarios.Count(i => i.Prepared is { Cases: > 0 });
        return $"{scenarios.Count} scenarioer · {reqs} krav{(withCases > 0 ? $" · {withCases} med testtilfeller" : "")}";
    }

    private IReadOnlyList<ProjectRequirementOption> CatalogFor(BirkNext.TestCoverage.CoverageUserStory story) =>
        [.. (_ws?.Requirements ?? []).Where(r => story.SpecificationPath is null || BirkNext.Specifications.SpecificationCatalogRules.SamePath(r.SpecificationPath, story.SpecificationPath))];

    /// <summary>Saves grouping / link operations as one change against the revision read. On success the profiles are recomputed and a story whose
    /// grouping suggestion changed is named; nothing else on the page (scenarios, cases, filters) is touched.</summary>
    private async Task<string?> ApplyGroupingAsync(IReadOnlyList<StoryGroupingOperation> ops)
    {
        if (ServiceProvider.GetService(typeof(ITestPlanSuggestionsApiService)) is not ITestPlanSuggestionsApiService api || _ws?.ProjectKey is not { } key || _groupSpecPath is not { } spec || _groupDoc is null)
            return "Grupperingen kan ikke lagres nå.";
        var before = _profiles.ToDictionary(p => p.StoryKey, p => p.SuggestedArea);
        var (doc, error) = await api.ApplyStoryGroupingAsync(key, spec, new StoryGroupingChangeRequest
        {
            ExpectedRevision = _groupDoc.Revision, Operations = [.. ops],
            RequirementCatalog = new ProjectRequirementCatalog { ProjectKey = key, Requirements = [.. _ws.Requirements ?? []] },
        });
        if (doc is null) return error ?? "Endringen ble ikke lagret.";
        _groupDoc = doc;
        Recompute();
        var changed = _profiles.Where(p => before.TryGetValue(p.StoryKey, out var was) && !string.Equals(was, p.SuggestedArea, StringComparison.Ordinal))
            .Select(p => _groupInputs.First(i => i.Story.Key == p.StoryKey).Story).Select(s => $"{W.StoryLabel(s)} → «{_profiles.First(p => p.StoryKey == s.Key).SuggestedArea ?? "trenger gruppering"}»").ToList();
        _groupNotice = changed.Count > 0 ? $"Grupperingsforslaget er endret: {string.Join(", ", changed)}. Bekreftede plasseringer er beholdt." : "Lagret.";
        StateHasChanged();
        return null;
    }

    private void StagePlacement(StoryGroupingProfile p, string? area, string? group)
    {
        _placementOps.RemoveAll(o => o.StoryKey == p.StoryKey && (area is not null ? o.Kind == StoryGroupingOperationKind.SetPrimaryArea : o.Kind == StoryGroupingOperationKind.PlaceStory));
        if (area is not null) _placementOps.Add(new StoryGroupingOperation { Kind = StoryGroupingOperationKind.SetPrimaryArea, StoryKey = p.StoryKey, PrimaryArea = area.Length == 0 ? null : area, SuggestedArea = p.SuggestedArea });
        if (group is not null) _placementOps.Add(new StoryGroupingOperation { Kind = StoryGroupingOperationKind.PlaceStory, StoryKey = p.StoryKey, GroupId = group.Length == 0 ? null : group, SuggestedArea = p.SuggestedArea });
        _placementPreview = _groupDoc is null ? [] : G.Preview(_groupInputs, _sections, _groupDoc, _placementOps, _ => true);
    }

    private async Task SavePlacementAsync()
    {
        if (await ApplyGroupingAsync([.. _placementOps]) is { } error) { _groupNotice = error; return; }
        _placementOps.Clear(); _placementPreview = [];
    }

    /// <summary>«Godta nytt forslag»: the story follows the new suggestion (its area, and the group that organizes it, when one does).</summary>
    private async Task AcceptSuggestionAsync(StoryGroupingProfile p) => _groupNotice = await ApplyGroupingAsync(
    [
        new StoryGroupingOperation { Kind = StoryGroupingOperationKind.SetPrimaryArea, StoryKey = p.StoryKey, PrimaryArea = p.SuggestedArea, SuggestedArea = p.SuggestedArea },
        new StoryGroupingOperation { Kind = StoryGroupingOperationKind.PlaceStory, StoryKey = p.StoryKey,
            GroupId = p.SuggestedArea is null ? null : _groupDoc?.Groups.FirstOrDefault(g => g.FunctionalAreas.Contains(p.SuggestedArea, StringComparer.OrdinalIgnoreCase))?.Id ?? p.GroupId,
            SuggestedArea = p.SuggestedArea },
    ]) ?? _groupNotice;

    /// <summary>«Behold eksisterende plassering»: the placement stays; the new suggestion is acknowledged so it is not reported again.</summary>
    private async Task KeepPlacementAsync(StoryGroupingProfile p)
    {
        var placement = _groupDoc?.Placements.LastOrDefault(x => x.StoryKey == p.StoryKey);
        _groupNotice = await ApplyGroupingAsync(
        [
            new StoryGroupingOperation { Kind = StoryGroupingOperationKind.SetPrimaryArea, StoryKey = p.StoryKey, PrimaryArea = placement?.PrimaryArea, SuggestedArea = p.SuggestedArea },
            new StoryGroupingOperation { Kind = StoryGroupingOperationKind.PlaceStory, StoryKey = p.StoryKey, GroupId = placement?.GroupId, SuggestedArea = p.SuggestedArea },
        ]) ?? _groupNotice;
    }

    /// <summary>One story row of the rail (flat or inside a group).</summary>
    private RenderFragment StoryButton((W.StoryEntry Entry, bool ShowTechnical) args) => __builder =>
    {
        var entry = args.Entry; var showTechnical = args.ShowTechnical;
        <button type="button" class="mtw-story @(_filter.Story == entry.Key ? "is-current" : null) @(entry.Story is null ? "is-none" : null)"
                aria-pressed="@(_filter.Story == entry.Key ? "true" : "false")" @onclick="() => SelectStory(entry.Key)" data-testid="mtd-story" data-story="@entry.Key">
            <span class="mtw-story-head"><span class="mtw-us">@entry.Label</span>@if (entry.Priority is { Length: > 0 } pr) { <span class="mtw-prio">@pr</span> }@if (entry.Feature is { } feature) { <span class="mtw-feature">@feature</span> }</span>
            <span class="mtw-story-title">@entry.Title</span>
            <span class="mtw-story-meta" data-testid="mtd-story-counts">@(entry.Declared is { } declared ? $"{declared} scenarioer" : showTechnical ? $"{entry.Discovered} scenarioer" : $"{entry.Shown} for manuell testing")@(entry.WithCases > 0 ? $" · {entry.WithCases} med testtilfeller" : "")@(entry.Declared is not null && entry.Shown != entry.Discovered ? $" · {entry.Shown} i utvalget" : "")</span>
        </button>
    };

