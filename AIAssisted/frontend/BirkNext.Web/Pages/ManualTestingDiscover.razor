@page "/manual-testing/discover"
@attribute [BirkNext.Web.Services.ReviewContextNotRead]
@using BirkNext.TestPlanning
@using BirkNext.Sdd
@using BirkNext.Web.Services
@using M = BirkNext.Web.Services.ManualTestingPresentation
@using S = BirkNext.Web.Services.ScenarioBrowserPresentation
@using W = BirkNext.Web.Services.ScenarioWorkspacePresentation
@using TC = BirkNext.Web.Services.TechnicalCoveragePresentation
@using DT = BirkNext.Web.Services.DeveloperTestCoveragePresentation
@using SC = BirkNext.Web.Services.SpecContextPresentation
@using G = BirkNext.Web.Services.StoryGroupingPresentation
@implements IDisposable
@inject IServiceProvider ServiceProvider
@inject IJSRuntime JS
@inject NavigationManager Nav

@* Finn og forstå (2026-11-24 redesign): a User Story–aware, scenario-first workspace. Stories group and give business context (never a
   compulsory step: «Alle scenarioer» and search reach everything; scenarios without a story have their own group). The open scenario shows the
   source's Given/When/Then, its requirements by relation (named, confirmed, suggested), a six-question readiness list from stored evidence, and
   its saved test cases with direct links. The story, scenario and tab are remembered per tab; a specification change never silently opens another
   scenario. Earlier (2026-11-23): scenarios first. The stored discovery result of the project, browsed as test scenarios (search, filters, a
   compact list and a detail panel); user stories, requirements and evidence are context of a scenario, not the way in. Selecting scenarios
   hands them to Plan & prepare (the same per-tab selection that page restores). Read only: nothing is prepared, approved or changed here. *@
<PageTitle>Finn og forstå — Manuell testing</PageTitle>

<div class="mt msb-page mtd-page" data-testid="mtd" aria-busy="@(_loading ? "true" : "false")">
    <BirkNext.Web.Components.TestingWorkspaceHeader Workspace="Manuell testing" HomeRoute="@M.HomeRoute" Stages="M.Stages" Current="discover" Title="Finn og forstå"
        ProjectName="@_ws?.ProjectName" Context="@_ws?.SnapshotBasis"
        Lead="Hvilke scenarioer må testes? Søk, filtrer og velg scenarioer, og gå videre til å forberede testtilfeller." />

    @if (_ws?.ProjectKey is not null)
    {
        <BirkNext.Web.Components.SpecificationScopePicker Changed="OnScopeChangedAsync" ShowDiscoverLink="false">
            <Actions>
                @* Scenarios load by themselves for the chosen module and specification (2026-11-25): no «Oppdag» step for the tester. *@
                @if (_discovering) { <InlineLoading Text="Henter scenarioer …" Class="mt-muted msb-small" TestId="mtd-discovering" /> }
            </Actions>
        </BirkNext.Web.Components.SpecificationScopePicker>
    }
    @if (_loading)
    {
        <div class="msb-skeleton" role="status" data-testid="mtd-loading"><span>@(_discovering ? "Henter scenarioer …" : "Laster scenarioer …")</span></div>
    }
    else if (_ws?.ProjectKey is null)
    {
        <p class="msb-empty" data-testid="mtd-no-project">Ingen applikasjon er valgt. <a href="project-import">Importer eller velg en applikasjon</a>.</p>
    }
    else
    {
        @if (_ws.Error is { } error) { <p class="mt-alert" role="alert" data-testid="mtd-error">@error</p> }
        var discovery = _ws.Discovery;
        var (shown, hidden) = S.Apply(_items, _filter);
        var pageItems = shown.Take(_limit).ToList();
        var active = pageItems.FirstOrDefault(i => i.Id == _active) ?? _items.FirstOrDefault(i => i.Id == _active);
        var preparedCases = _items.Sum(i => i.Prepared?.Cases ?? 0);

        @* A. Context: where the scenarios come from (primary) and the whole discovery's figures (secondary, one line). *@
        <section class="msb-context" aria-label="Status" data-testid="mtd-context">
            <div class="msb-context-source">
                @if (discovery?.Basis is { } basis)
                {
                    <span class="msb-dot @(basis.Kind == DiscoveryBasisKind.Historical ? "is-info" : basis.Complete ? "is-ok" : "is-warn")" aria-hidden="true"></span>
                    <span data-testid="mtd-basis"><strong>@PlanSourcePresentation.BasisTitle(basis)</strong> <span class="mt-muted">@PlanSourcePresentation.BasisSources(basis)</span></span>
                }
                else if (discovery is not null)
                {
                    <span class="msb-dot" aria-hidden="true"></span>
                    <span class="mt-muted" data-testid="mtd-basis">Oppdaget @discovery.DiscoveredAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")@(discovery.SnapshotLabel is { } sl ? $" · {sl}" : "")</span>
                }
            </div>
            @if (discovery is not null)
            {
                <p class="msb-facts-line mt-muted" data-testid="mtd-kpis">
                    <span title="Alle scenarioer i siste oppdagelse — alle kilder i applikasjonen, også tekniske"><b data-testid="mtd-count-suggestions">@_items.Count</b> forslag totalt</span>
                    <span title="Scenarioer fra valgt spesifikasjon; resten kommer fra kode, kontrakter, grensesnitt og flyter for hele applikasjonen"><b data-testid="mtd-count-spec">@SpecificationCandidates</b> fra spesifikasjonen</span>
                    <span title="@(CoverageKnown ? "Gjeldende testtilfeller i aktive planer" : "Lagrede planer kunne ikke leses helt — antallet er ukjent")"><b data-testid="mtd-count-prepared">@(CoverageKnown ? preparedCases.ToString() : "ukjent")</b> testtilfeller</span>
                    @if (_workView is not null) { <span title="Scenarioer med testtilfeller laget fra en kilde som er endret"><b data-testid="mtd-count-changed">@_queueCounts.GetValueOrDefault(ScenarioWorkQueue.SourceChanged)</b> kildeendringer</span> }
                    <span><b data-testid="mtd-count-selected">@_selected.Count</b> valgt</span>
                </p>
            }
            @if (_discoverError is { } discoverError)
            {
                <p class="mt-alert" role="alert" data-testid="mtd-discover-error">Kunne ikke hente scenarioer. @discoverError
                    <button type="button" class="msb-link" disabled="@_discovering" @onclick="RetryDiscoveryAsync" data-testid="mtd-discover-retry">Prøv igjen</button></p>
            }
        </section>

        @if (discovery is not null && SpecificationNotice() is { } specNotice)
        {
            <p class="msb-spec-note" role="status" data-testid="mtd-spec-context" data-state="@specNotice.State">@specNotice.Text
                @if (specNotice.State == "none" && _filter != new S.Filter(All: true))
                {
                    <button type="button" class="msb-link" @onclick="() => Set(new S.Filter(All: true))" data-testid="mtd-spec-show-all">Vis alle scenarioer</button>
                }</p>
        }
        @if (discovery is null)
        {
            @if (_discovering) { <InlineLoading Text="Henter scenarioer …" Class="msb-empty" TestId="mtd-sug-loading" /> }
            else if (_discoverError is null)
            {
                <p class="msb-empty" data-testid="mtd-sug-none">Ingen scenarioer er funnet for valgt modul og spesifikasjon ennå.
                    <button type="button" class="msb-link" @onclick="RetryDiscoveryAsync" data-testid="mtd-discover-retry-empty">Hent på nytt</button></p>
            }
        }
        else
        {
            var view = CurrentView();
            var currentStory = view.CurrentStory;
            var showTechnical = _filter.Technical || _filter.All;
            var (railStories, hiddenStories) = (view.Rail, view.HiddenStories);
            var allView = view.All;
            var scope = view.Scope;
            <div class="mtw" data-testid="mtd-workspace">
                @* 1. User stories: a grouping and business context, never a compulsory step («Alle scenarioer» is always one click away). *@
                <nav class="mtw-stories" aria-label="Brukerhistorier" data-testid="mtd-stories">
                    <span class="mtw-h">Brukerhistorier</span>
                    @if (_groupError is { } groupError)
                    {
                        @* Grouping is navigation metadata: when it fails, every story and scenario stays available in the plain list below. *@
                        <div class="msb-callout is-warn mtw-grouping-failed" role="alert" data-testid="mtd-grouping-failed">
                            <strong>Gruppering feilet.</strong> @groupError Alle brukerhistorier og scenarioer er tilgjengelige nedenfor, og testing kan fortsette.
                            <button type="button" class="msb-link" @onclick="ReloadGroupingAsync" data-testid="mtd-grouping-retry">Prøv igjen</button>
                        </div>
                    }
                    else if (_sourceMissing && _groupInputs.Count > 0)
                    {
                        <p class="msb-spec-note msb-small" role="status" data-testid="mtd-grouping-source-missing"><strong>Kilde mangler:</strong> spesifikasjonsteksten er ikke tilgjengelig, så funksjonsområdene kan ikke beregnes. Lagrede grupperinger er beholdt.</p>
                    }
                    @if (_groupInputs.Count > 0)
                    {
                        <label class="mtw-mode msb-small">Brukerhistorier etter
                            <select class="msb-select" @onchange="e => SetMode(e.Value?.ToString())" data-testid="mtd-group-mode">
                                @foreach (var m in AvailableModes) { <option value="@m" selected="@(_groupMode == m)">@G.ModeLabel(m)</option> }
                            </select></label>
                    }
                    <select class="msb-select mtw-story-select" aria-label="Brukerhistorie" @onchange="e => SelectStory(Opt(e))" data-testid="mtd-story-select">
                        <option value="" selected="@(_filter.Story is null)">Alle scenarioer (@allView.Shown.Count)</option>
                        @foreach (var st in railStories) { <option value="@st.Key" selected="@(_filter.Story == st.Key)">@st.Label — @st.Title</option> }
                    </select>
                    <ul class="mtw-story-list">
                        <li><button type="button" class="mtw-story is-all @(_filter.Story is null ? "is-current" : null)" aria-pressed="@(_filter.Story is null ? "true" : "false")"
                                    @onclick="() => { _showAll = true; SelectStory(null); }" data-testid="mtd-story" data-story="">
                            <span class="mtw-story-title">Alle scenarioer</span><span class="mtw-story-meta" data-testid="mtd-story-all-count">@(showTechnical ? $"{_items.Count} scenarioer" : $"{allView.Shown.Count} for manuell testing")@(allView.HiddenTechnical > 0 ? $" · {allView.HiddenTechnical} tekniske skjult" : "") · søk på tvers av alt</span></button></li>
                        @if (_groupMode is G.Mode.Functional or G.Mode.Business && _groupInputs.Count > 0 && _groupError is null)
                        {
                            var tree = G.Tree(_groupMode, _profiles, _groupDoc, _sections);
                            @foreach (var node in tree)
                            {
                                var n = node;
                                var open = IsOpen(n);
                                <li class="mtw-group @(n.Kind == "system" ? "is-system" : null)" data-testid="mtd-group" data-group="@n.Key" data-kind="@n.Kind">
                                    <button type="button" class="mtw-group-head" aria-expanded="@(open ? "true" : "false")" @onclick="() => ToggleGroup(n.Key, open)" data-testid="mtd-sgroup-toggle">
                                        <span class="mtw-caret" aria-hidden="true">@(open ? "▾" : "▸")</span><span class="mtw-group-title">@n.Title</span><span class="mtw-group-count">@n.Stories.Count</span></button>
                                    <span class="mtw-group-meta" data-testid="mtd-group-stats">@(n.Kind == "system" ? $"{n.Stories.Count} brukerhistorie{(n.Stories.Count == 1 ? "" : "r")}" + (n.Stories.Count > 0 ? " · " + GroupStats(n) : " · alle er gruppert") : GroupStats(n))</span>
                                    @if (open)
                                    {
                                        <ul class="mtw-story-list is-nested">
                                            @foreach (var p in n.Stories)
                                            {
                                                var reason = n.Kind == "system" ? G.UngroupedReason(p, _groupMode, _groupDoc) : null;
                                                if (railStories.FirstOrDefault(e => e.Key == p.StoryKey) is { } member)
                                                {
                                                    <li>@StoryButton((member, showTechnical))@if (reason is not null) { <span class="mtw-ungrouped-reason" data-testid="mtd-ungrouped-reason" data-story="@p.StoryKey">@reason@(p.Candidates.Count > 0 && p.State != GroupingState.OnlySuggestions ? $" · mulig: {string.Join(", ", p.Candidates)}" : "")</span> }</li>
                                                }
                                            }
                                        </ul>
                                    }
                                </li>
                            }
                            @foreach (var loose in railStories.Where(e => e.Story is null)) { <li>@StoryButton((loose, showTechnical))</li> }
                        }
                        else if (_groupMode != G.Mode.None || _groupInputs.Count == 0)
                        {
                            @foreach (var st in railStories) { <li>@StoryButton((st, showTechnical))</li> }
                        }
                    </ul>
                    @if (_groupInputs.Count > 0 && _groupError is null && _groupDoc is not null)
                    {
                        var queue = G.ReviewQueue(_profiles).Count;
                        <button type="button" class="msb-link mtw-manage" aria-expanded="@(_reviewGrouping ? "true" : "false")" @onclick="() => { _reviewGrouping = !_reviewGrouping; _manageGroups = false; }" data-testid="mtd-review-grouping">@(_reviewGrouping ? "Lukk gjennomgang" : $"Gjennomgå gruppering ({queue})")</button>
                    }
                    @if (_groupInputs.Count > 0 && CanEditGrouping)
                    {
                        <button type="button" class="msb-link mtw-manage" @onclick="() => { _manageGroups = !_manageGroups; _reviewGrouping = false; }" data-testid="mtd-manage-groups">@(_manageGroups ? "Lukk gruppeadministrasjon" : "Administrer grupper")</button>
                    }
                    @if (_orphanPlacements > 0)
                    {
                        <p class="mt-muted msb-small" data-testid="mtd-grouping-orphans">@_orphanPlacements lagrede plassering@(_orphanPlacements == 1 ? "" : "er") gjelder brukerhistorier som ikke finnes i kilden nå. De er beholdt og gjelder igjen hvis historiene kommer tilbake.</p>
                    }
                    @if (hiddenStories > 0)
                    {
                        <p class="mt-muted msb-small mtw-hidden-stories" data-testid="mtd-stories-hidden">@hiddenStories teknisk@(hiddenStories == 1 ? "" : "e") brukerhistorie@(hiddenStories == 1 ? "" : "r") skjult (om kodebasen, ikke atferd en tester ser).
                            <button type="button" class="msb-link" @onclick="() => Set(_filter with { Technical = true, All = false })">Vis</button></p>
                    }
                </nav>

                <div class="mtw-main">
                    @if (_manageGroups && _groupDoc is not null)
                    {
                        <BirkNext.Web.Components.ManualTesting.GroupOrganizer Document="_groupDoc" Sections="_sections" Inputs="_groupInputs" Profiles="_profiles"
                            OnApply="ApplyGroupingAsync" OnClose="() => _manageGroups = false" />
                    }
                    @if (_reviewGrouping && _groupDoc is not null && _groupError is null)
                    {
                        <BirkNext.Web.Components.ManualTesting.GroupingReview Queue="G.ReviewQueue(_profiles)" Document="_groupDoc" Sections="_sections" Inputs="_groupInputs"
                            Mode="_groupMode == G.Mode.Business ? G.Mode.Business : G.Mode.Functional" CanEdit="CanEditGrouping" OnApply="ApplyGroupingAsync"
                            OnOpenStory="OpenStoryFromReviewAsync" OnClose="() => _reviewGrouping = false" />
                    }
                    @if (_groupNotice is { } notice) { <p class="msb-spec-note" role="status" data-testid="mtd-group-notice">@notice</p> }
                    @* 2. The chosen story (2026-11-25): a prominent, quiet card — who/what/priority at a glance, the rest one click away. *@
                    @if (currentStory is { Story: { } us } entryNow)
                    {
                        var prof = _profiles.FirstOrDefault(p => p.StoryKey == us.Key);
                        <section class="mtw-story-card is-story" aria-label="Brukerhistorie" data-testid="mtd-story-head">
                            @if (prof is not null && _groupMode is G.Mode.Functional or G.Mode.Business && _groupError is null)
                            {
                                var home = NodeKeyOf(prof);
                                var homeTitle = G.Tree(_groupMode, _profiles, _groupDoc, _sections).FirstOrDefault(n => n.Key == home)?.Title;
                                <button type="button" class="mtw-back" @onclick="() => BackToGroup(home)" data-testid="mtd-story-back">‹ @(homeTitle ?? "Oversikt")</button>
                            }
                            <div class="mtw-story-card-head">
                                <span class="mtw-us">@entryNow.Label</span>@if (us.Priority is { Length: > 0 } p) { <span class="mtw-prio">@p</span> }
                                @{ var storyTitle = ManualTestingLanguage.StoryTitle(us, StoryTranslations, _language); }
                                <h2 class="mtw-story-card-title" data-testid="mtd-story-title" data-language="@(storyTitle.Translated ? "nb" : "original")" title="@storyTitle.Note">@storyTitle.Text</h2>
                                @if (prof is not null)
                                {
                                    <button type="button" class="mtw-chip msb-tone-@G.StatusTone(prof)" aria-expanded="@(_storyGrouping ? "true" : "false")" title="@prof.Explanation"
                                            @onclick="() => _storyGrouping = !_storyGrouping" data-testid="mtd-grouping-chip">
                                        @G.StatusLabel(prof)@(prof.PrimaryArea is { } area ? $" · {area}" : "")@(prof.NeedsReviewFlag ? " · !" : "")
                                    </button>
                                }
                            </div>
                            @if (us.Description is { Length: > 0 } lead) { <p class="mtw-story-lead" data-testid="mtd-story-description" title="@lead">@lead</p> }
                            <div class="mtw-story-foot">
                                <span class="mtw-story-meta" data-testid="mtd-story-scenarios">@W.ScenarioCountText(entryNow)@(entryNow.WithCases > 0 ? $" · {entryNow.WithCases} med testtilfeller" : "")</span>
                                <button type="button" class="mtw-toggle" aria-expanded="@(_storyDetails ? "true" : "false")" @onclick="() => _storyDetails = !_storyDetails" data-testid="mtd-story-toggle">@(_storyDetails ? "Skjul detaljer" : "Detaljer")</button>
                                @if (prof is not null)
                                {
                                    <button type="button" class="mtw-toggle" aria-expanded="@(_storyGrouping ? "true" : "false")" @onclick="() => _storyGrouping = !_storyGrouping" data-testid="mtd-grouping-toggle">Gruppering</button>
                                }
                            </div>
                            @{ var devSummary = DT.Summarize(_items.Where(i => i.Candidate.Story?.Key == us.Key && i.Tech is not null).Select(i => i.Tech!.Value)); }
                            <p class="mtw-devtests msb-small" title="@DT.Caveat" data-testid="mtd-us-devtests" data-with="@devSummary.WithTest" data-total="@devSummary.Total">
                                <span class="msb-status msb-tone-@DT.StoryTone(devSummary)">@DT.StoryText(devSummary)</span>
                                @if (devSummary.NoTest + devSummary.Candidate > 0)
                                {
                                    <button type="button" class="msb-link" @onclick='() => Set(_filter with { Tech = "nodevtest" })' data-testid="mtd-us-devtests-filter">Vis AC uten koblet utviklertest</button>
                                }
                            </p>
                            @StoryStatusBlock(us.Key)
                            @if (prof is not null && (_storyGrouping || prof.NeedsReviewFlag))
                            {
                                <div class="mtw-grouping" data-testid="mtd-grouping" data-state="@prof.State" data-status="@G.StatusLabel(prof)">
                                    <span class="msb-status msb-tone-@G.StatusTone(prof)" data-testid="mtd-grouping-state">@G.StatusLabel(prof)</span>
                                    @if (prof.NeedsReviewFlag) { <span class="msb-status msb-tone-warn" data-testid="mtd-grouping-review-flag">Trenger gjennomgang</span> }
                                    <span data-testid="mtd-grouping-area">@(prof.PrimaryArea ?? G.UngroupedReason(prof, G.Mode.Functional, _groupDoc) ?? "Uten funksjonsområde")@(_groupDoc?.Groups.FirstOrDefault(g => g.Id == prof.GroupId) is { } grp ? $" · {grp.Name}" : "")@(G.StatusBasis(prof) is { } groupBasis ? $" ({groupBasis})" : "")</span>
                                    @if (prof.PrimaryArea is null && prof.Candidates.Count > 0) { <span class="mt-muted msb-small" data-testid="mtd-grouping-candidates">Mulige: @string.Join(", ", prof.Candidates)</span> }
                                    @if (_storyGrouping)
                                    {
                                        <details class="mtw-why" title="Grupperingen er bare navigasjon; den påvirker ikke scenarioer, testtilfeller eller kjøring."><summary>Hvorfor?</summary>
                                            <p class="msb-small" data-testid="mtd-grouping-why">@prof.Explanation</p>
                                            @if (prof.Areas.Count > 0)
                                            {
                                                <ul class="msb-small" data-testid="mtd-grouping-areas">
                                                    @foreach (var a in prof.Areas) { <li><b>@a.Area</b>@(a.Area == prof.PrimaryArea ? " (primært)" : ""): @string.Join(", ", prof.Requirements.Where(r => r.Established && r.Area == a.Area).Select(r => r.DisplayId))@(a.CrossCutting ? " · tverrgående" : "")</li> }
                                                </ul>
                                            }
                                        </details>
                                    }
                                    @if (prof.NeedsReviewFlag)
                                    {
                                        <div class="msb-callout is-warn" data-testid="mtd-grouping-changed">Nytt forslag: «@(prof.SuggestedArea ?? "ingen")». Din plassering er beholdt.
                                            @if (CanEditGrouping)
                                            {
                                                <button type="button" class="msb-link" @onclick="() => AcceptSuggestionAsync(prof)" data-testid="mtd-grouping-accept">Godta</button>
                                                <button type="button" class="msb-link" @onclick="() => KeepPlacementAsync(prof)" data-testid="mtd-grouping-keep">Behold</button>
                                            }
                                        </div>
                                    }
                                    @if (CanEditGrouping && _storyGrouping)
                                    {
                                        <details class="mtw-why" data-testid="mtd-grouping-edit"><summary>Endre plassering</summary>
                                            <label class="msb-small">Funksjonsområde
                                                <select class="msb-select" @onchange="e => StagePlacement(prof, area: e.Value?.ToString(), group: null)" data-testid="mtd-grouping-area-select">
                                                    <option value="">Følg forslaget@(prof.SuggestedArea is { } sa ? $" ({sa})" : "")</option>
                                                    @foreach (var s in _sections.Sections.Select(x => x.Title).Distinct()) { <option value="@s" selected="@(prof.PrimaryArea == s && prof.State == GroupingState.Confirmed)">@s</option> }
                                                </select></label>
                                            @if (_groupDoc is { Groups.Count: > 0 } d)
                                            {
                                                <label class="msb-small">Gruppe
                                                    <select class="msb-select" @onchange="e => StagePlacement(prof, area: null, group: e.Value?.ToString() ?? string.Empty)" data-testid="mtd-grouping-group-select">
                                                        <option value="">Følg forslaget</option>
                                                        @foreach (var g in d.Groups.OrderBy(x => x.Order)) { <option value="@g.Id" selected="@(prof.GroupId == g.Id)">@g.Name</option> }
                                                    </select></label>
                                            }
                                            <button type="button" class="msb-link" @onclick="() => StageLeaveUngrouped(prof)" data-testid="mtd-grouping-leave">La stå uten gruppe</button>
                                            @if (_placementPreview.Count > 0)
                                            {
                                                <ul class="msb-small" data-testid="mtd-grouping-preview">@foreach (var line in _placementPreview) { <li>@line</li> }</ul>
                                                <button type="button" class="btn btn-primary btn-sm" @onclick="SavePlacementAsync" data-testid="mtd-grouping-save">Lagre</button>
                                                <button type="button" class="msb-link" @onclick="() => { _placementOps.Clear(); _placementPreview = []; }">Forkast</button>
                                            }
                                        </details>
                                    }
                                </div>
                            }
                            @if (_storyDetails)
                            {
                                var objectives = W.Objectives(us, scope);
                                <div class="mtw-story-details" data-testid="mtd-story-details">
                                    @if (us.WhyThisPriority is { Length: > 0 } why) { <div class="mtw-block"><span class="mtp-ctx-label">Begrunnelse for prioriteten</span><p data-testid="mtd-story-why">@why</p></div> }
                                    @if (us.IndependentTest is { Length: > 0 } independent)
                                    {
                                        <div class="mtw-block" data-testid="mtd-story-independent">
                                            <span class="mtp-ctx-label">Slik testes brukerhistorien alene</span>
                                            @if (objectives.Count > 0)
                                            {
                                                <ol class="mtp-prep-steps" data-testid="mtd-prep-steps" title="Treff på ord i scenarioene — et hint, ikke en vurdering og ikke utviklertestdekning.">
                                                    @foreach (var step in BirkNext.Web.Services.PlanPreparePresentation.PreparationSteps(objectives))
                                                    {
                                                        <li class="mtp-prep-step">
                                                            <span class="mtp-prep-action">@(step.Action ?? "Ingen handling oppgitt i kilden")</span>
                                                            @foreach (var o in step.Expected)
                                                            {
                                                                <span class="mtp-prep-expected" data-covered="@(o.Covered ? "true" : "false")" data-testid="mtd-story-objective"
                                                                      title="@(o.Covered ? "Nevnt i " + string.Join(", ", o.CaseTitles.Take(3)) : "Ikke nevnt i noe scenario")">
                                                                    <span class="mtp-ctx-label">Forventet</span> <span>@o.Objective.Text</span>
                                                                    <span class="msb-status msb-tone-muted" data-testid="mtd-objective-state">@(o.Covered ? "Nevnt i et scenario" : "Ikke nevnt i scenarioene")</span></span>
                                                            }
                                                        </li>
                                                    }
                                                </ol>
                                            }
                                            else { <p class="mt-muted msb-small">@independent</p> }
                                        </div>
                                    }
                                    @if (prof is not null && _groupDoc is not null)
                                    {
                                        <BirkNext.Web.Components.ManualTesting.StoryRequirementLinks Profile="prof" Document="_groupDoc" Sections="_sections" Inputs="_groupInputs"
                                            Catalog="CatalogFor(us)" CanEdit="CanEditGrouping" OnApply="ApplyGroupingAsync" />
                                    }
                                    else
                                    {
                                        var storyReqs = us.NamedRequirements.Concat(us.TaskRequirements.Select(t => t.RequirementId)).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
                                        @if (storyReqs.Count > 0)
                                        {
                                            <div class="mtw-block"><span class="mtp-ctx-label">Krav</span>
                                                <p>@foreach (var r in storyReqs) { var rid = r; <button type="button" class="msb-req" @onclick="() => OpenRequirementTab(rid)" data-testid="mtd-story-req">@rid</button> }</p></div>
                                        }
                                    }
                                    <p class="mt-muted msb-small" title="@us.SpecificationPath">Kilde: @(us.LineStart is { } storyLine ? $"linje {storyLine}" : "linjenummer er ikke registrert")</p>
                                </div>
                            }
                        </section>
                    }
                    else if (_filter.Story == W.NoStory)
                    {
                        <p class="mtw-story-card mt-muted" data-testid="mtd-story-head">Scenarioer uten brukerhistorie: funnet i kontrakter, kildekode, krav og integrasjonsflyter. De kan fortsatt kobles til krav og få testtilfeller.</p>
                    }

                    @* 3a. Drill-down (2026-11-25): groups → user stories → acceptance criteria. Cards, few words; search and «Alle scenarioer» always one click away. *@
                    @if (ShowOverview)
                    {
                        var groupsNow = G.Tree(_groupMode, _profiles, _groupDoc, _sections);
                        var entries = railStories.Where(e => e.Story is not null).ToDictionary(e => e.Key);
                        var kindCounts = _items.Where(i => i.Candidate.Story is not null).GroupBy(i => i.Candidate.Story!.Key)
                            .ToDictionary(g => g.Key, g => (Manual: g.Count(i => i.Relevance == S.Relevance.Manual), Technical: g.Count(i => i.Relevance == S.Relevance.Technical), Both: g.Count(i => i.Relevance == S.Relevance.Both)));
                        var drilled = _drillGroup is null ? null : groupsNow.FirstOrDefault(n => n.Key == _drillGroup);
                        <section class="mtw-overview" aria-label="Oversikt" data-testid="mtd-overview">
                            <div class="mtw-overview-head">
                                <nav class="mtw-crumbs" aria-label="Plassering" data-testid="mtd-overview-crumbs">
                                    @if (drilled is null) { <span class="mtw-crumb-current">@(G.ModeLabel(_groupMode))</span> }
                                    else
                                    {
                                        <button type="button" class="msb-link" @onclick="() => _drillGroup = null" data-testid="mtd-crumb-groups">@G.ModeLabel(_groupMode)</button><span aria-hidden="true"> › </span>
                                        <span class="mtw-crumb-current">@drilled.Title</span>
                                    }
                                </nav>
                                <input type="search" class="msb-search mtw-overview-search" placeholder="Søk i scenarioer" aria-label="Søk i scenarioer" value="@_filter.Query"
                                       @oninput="e => Set(_filter with { Query = e.Value?.ToString() ?? string.Empty })" data-testid="mtd-overview-search" />
                                @KindViewSwitch()
                                <button type="button" class="msb-link" @onclick="() => _showAll = true" data-testid="mtd-show-all">Alle scenarioer (@allView.Shown.Count)</button>
                            </div>
                            @if (drilled is null)
                            {
                                <ul class="mtw-cards" data-testid="mtd-group-cards">
                                    @foreach (var node in groupsNow.Where(n => n.Stories.Count > 0))
                                    {
                                        var n = node;
                                        var acs = n.Stories.Sum(p => entries.TryGetValue(p.StoryKey, out var e) ? e.Shown : 0);
                                        var prepared = n.Stories.Sum(p => entries.TryGetValue(p.StoryKey, out var e) ? e.WithCases : 0);
                                        var gm = n.Stories.Sum(p => kindCounts.TryGetValue(p.StoryKey, out var kc) ? kc.Manual : 0);
                                        var gt = n.Stories.Sum(p => kindCounts.TryGetValue(p.StoryKey, out var kc) ? kc.Technical : 0);
                                        var gb = n.Stories.Sum(p => kindCounts.TryGetValue(p.StoryKey, out var kc) ? kc.Both : 0);
                                        <li><button type="button" class="mtw-card @(n.Kind == "system" ? "is-system" : "is-group")" @onclick="() => _drillGroup = n.Key" data-testid="mtd-group-card" data-group="@n.Key">
                                            <span class="mtw-card-title">@n.Title</span>
                                            <span class="mtw-card-stats"><b>@n.Stories.Count</b> @(n.Stories.Count == 1 ? "historie" : "historier") · <b>@acs</b> AC</span>
                                            @KindCounts(gm, gt, gb)
                                            @if (acs > 0) { <span class="mtw-card-bar" title="@prepared av @acs AC har testtilfeller"><span style="width:@(Math.Round(100.0 * prepared / acs))%"></span></span> }
                                        </button></li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <ul class="mtw-cards" data-testid="mtd-story-cards">
                                    @foreach (var p in drilled.Stories)
                                    {
                                        if (!entries.TryGetValue(p.StoryKey, out var entry)) { continue; }
                                        var e = entry;
                                        var reason = drilled.Kind == "system" ? G.UngroupedReason(p, _groupMode, _groupDoc) : null;
                                        kindCounts.TryGetValue(e.Key, out var skc);
                                        <li><button type="button" class="mtw-card is-story" @onclick="() => SelectStory(e.Key)" data-testid="mtd-story-card" data-story="@e.Key">
                                            <span class="mtw-card-top"><span class="mtw-us">@e.Label</span>@if (e.Priority is { Length: > 0 } pr) { <span class="mtw-prio">@pr</span> }</span>
                                            <span class="mtw-card-title">@e.Title</span>
                                            <span class="mtw-card-stats"><b>@e.Shown</b> AC@(e.WithCases > 0 ? $" · {e.WithCases} med testtilfeller" : "")</span>
                                            @CompactStatus(e.Key)
                                            @KindCounts(skc.Manual, skc.Technical, skc.Both)
                                            @if (reason is not null) { <span class="mtw-card-reason" data-testid="mtd-story-card-reason">@reason</span> }
                                        </button></li>
                                    }
                                </ul>
                            }
                        </section>
                    }
                    else
                    {
                    @* 3. Tabs over the same scope: the scenarios, their saved test cases, and requirement coverage. *@
                    <div class="mtw-tabs" role="tablist" aria-label="Visning">
                        @foreach (var (tab, label) in TabLabels)
                        {
                            var t = tab;
                            <button type="button" role="tab" class="mtw-tab @(_tab == t ? "is-current" : null)" aria-selected="@(_tab == t ? "true" : "false")" @onclick="() => SetTab(t)" data-testid="mtd-tab" data-tab="@t">@label</button>
                        }
                    </div>

                    @if (_tab == W.Tabs.Cases)
                    {
                        <section class="mtw-panel" aria-label="Testtilfeller" data-testid="mtd-cases">
                            @{ var withCases = scope.Select(i => (Item: i, Cases: W.CasesOf(i.Candidate, _trace))).Where(x => x.Cases.Count > 0).ToList(); var counted = scope.Sum(i => i.Prepared?.Cases ?? 0); }
                            @if (withCases.Count == 0)
                            {
                                <p class="msb-empty" data-testid="mtd-cases-none">@(counted > 0 ? $"{counted} testtilfeller finnes for disse scenarioene, men de kan ikke listes her (de er ikke laget fra spesifikasjonsscenarioer). Åpne dem i Planlegg og klargjør." : "Ingen testtilfeller er forberedt for disse scenarioene ennå.")</p>
                            }
                            else
                            {
                                <ul class="mtw-case-groups">
                                    @foreach (var (item, cases) in withCases)
                                    {
                                        var it = item;
                                        <li data-testid="mtd-case-group"><button type="button" class="msb-link" @onclick="() => Open(it.Id)">@W.ScenarioLabel(it) · @it.Title</button>
                                            <ul class="mtw-cases">@foreach (var k in cases) { <li data-testid="mtd-case"><a href="@W.CaseHref(k)" data-testid="mtd-case-open">@k.Title</a> <span class="msb-status msb-tone-@CaseTone(k)">@W.StageText(k.Stage)</span> <span class="mt-muted msb-small">@W.ExecutionText(k.Execution) · @k.PlanName</span></li> }</ul></li>
                                    }
                                </ul>
                            }
                        </section>
                    }
                    else if (_tab == W.Tabs.Coverage)
                    {
                        <section class="mtw-panel" aria-label="Krav og dekning" data-testid="mtd-coverage">
                            @{ var rows = W.Coverage(currentStory?.Story, scope, _ws.Requirements, _trace); }
                            @if (rows.Count == 0)
                            {
                                <p class="msb-empty" data-testid="mtd-coverage-none">Ingen krav er nevnt av @(currentStory?.Story is null ? "disse scenarioene" : "brukerhistorien, oppgavene eller scenarioene") — det finnes ingen kravdekning å vise. Foreslåtte koblinger ser du per scenario.</p>
                            }
                            else
                            {
                                <table class="mtw-coverage">
                                    <thead><tr><th scope="col">Krav</th><th scope="col">Koblet via</th><th scope="col">Scenarioer</th><th scope="col">Testtilfeller</th><th scope="col">Kjøring</th></tr></thead>
                                    <tbody>
                                        @foreach (var row in rows)
                                        {
                                            var rid = row.Id;
                                            <tr data-testid="mtd-coverage-row" data-requirement="@row.Id" class="@(_focusRequirement == row.Id ? "is-focus" : null)">
                                                <td><button type="button" class="msb-req" @onclick="() => FilterRequirement(rid)" title="Vis scenarioene som nevner kravet">@row.Id</button> <span class="msb-small">@row.Title</span></td>
                                                <td class="mt-muted msb-small">@row.Basis</td>
                                                <td>@row.Scenarios</td>
                                                <td>@(row.Known ? row.PreparedCases == 0 ? "ingen" : $"{row.PreparedCases} ({row.ApprovedCases} godkjent)" : "ukjent")</td>
                                                <td class="mt-muted msb-small">@W.ExecutionText(row.Execution)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                <p class="mt-muted msb-small">Dekning teller bare koblinger som står i kilden eller er bekreftet av en tester. Et testtilfelle er ikke kjørt eller bestått før kjøringen sier det.</p>
                            }
                            @if (currentStory?.Story is not null)
                            {
                                var suggested = W.Suggested(scope, _ws.Requirements, _trace, [.. rows.Select(r => r.Id)]);
                                @if (suggested.Count > 0)
                                {
                                    <div class="mtw-suggested" data-testid="mtd-coverage-suggested">
                                        @{ var strong = suggested.Where(s => !s.Weak).ToList(); var weak = suggested.Count - strong.Count; }
                                        <span class="mtp-ctx-label">Foreslått, ikke koblet (@strong.Count)</span>
                                        <ul class="mtw-links mtw-suggestions">
                                            @foreach (var s in _showWeak ? suggested : strong)
                                            {
                                                <li data-testid="mtd-coverage-suggestion" data-requirement="@s.Id" data-weak="@(s.Weak ? "true" : "false")"><span class="msb-req @(s.Weak ? "mtw-req-muted" : "mtw-req-info")">@s.Id</span>
                                                    <span class="msb-small mtw-clamp" title="@s.Title">@s.Title</span>
                                                    <span class="mt-muted msb-small">@s.Level · @string.Join(", ", s.Scenarios)</span></li>
                                            }
                                        </ul>
                                        @if (weak > 0)
                                        {
                                            <button type="button" class="msb-link" @onclick="() => _showWeak = !_showWeak" data-testid="mtd-coverage-weak-toggle">@(_showWeak ? "Skjul" : "Vis") @weak mulig relaterte (D)</button>
                                        }
                                        <span class="mt-muted msb-small">Forslag teller ikke som dekning. Bekreft dem på testtilfellet i Planlegg og klargjør; begrunnelsen står på hvert scenario.</span>
                                    </div>
                                }
                            }
                        </section>
                    }
                    else
                    {
                        @* Work queues: filtered views of the one scenario list (a scenario can be in several), counted in the current selection. *@
                        @if (_workView is not null)
                        {
                            <nav class="msb-queues" aria-label="Arbeidskøer" data-testid="mtd-queues">
                                @foreach (var (queue, label) in S.Queues)
                                {
                                    var count = queue is { } q ? _queueCounts.GetValueOrDefault(q) : _allCount;
                                    var primary = queue is ScenarioWorkQueue.Recommended or ScenarioWorkQueue.NeedsClarification;
                                    <button type="button" class="msb-queue @(primary ? "is-primary" : null) @(_filter.Queue == queue ? "is-current" : null)" aria-pressed="@(_filter.Queue == queue ? "true" : "false")"
                                            @onclick="() => Set(_filter with { Queue = queue })" data-testid="mtd-queue" data-queue="@(queue?.ToString() ?? "All")">@label <span class="msb-queue-n">@count</span></button>
                                }
                            </nav>
                            <div class="msb-queue-hint" data-testid="mtd-queue-hint">
                                <span data-testid="mtd-queue-short">@S.QueueHint(_filter.Queue)</span>
                                @if (_workView.UnmatchedCases > 0) { <span class="mt-muted"> @_workView.UnmatchedCases testtilfelle(r) hører til scenarioer som ikke lenger finnes i kilden — se planene.</span> }
                                <details class="msb-help" data-testid="mtd-queue-help">
                                    <summary>Hva betyr dette?</summary>
                                    <ul>
                                        <li><b>Anbefalt å forberede:</b> forventet resultat står i spesifikasjonen eller en kontrakt, ingenting må avklares, kilden er oppdatert og scenarioet har ikke testtilfelle ennå. Sortert etter prioritet i kilden; mangler stegene, skrives de under klargjøring.</li>
                                        <li>Klar for klargjøring betyr ikke klar for kjøring — se «Klar til kjøring?» per scenario.</li>
                                        <li><b>Trenger avklaring:</b> manglende eller ubekreftet forventet resultat, motstridende kilder eller åpne spørsmål.</li>
                                        <li>Tallene i fanene gjelder gjeldende utvalg (brukerhistorie, søk, filtre og «Vis teknisk innhold»). Et scenario kan være i flere køer, så tallene summeres ikke. «Forslag totalt» er hele oppdagelsen.</li>
                                    </ul>
                                </details>
                            </div>
                        }
                        else
                        {
                            <p class="mt-alert" role="status" data-testid="mtd-queues-unavailable">Prioriteringen er ikke tilgjengelig@(_workError is { } workError ? $" ({workError})" : "").
                                Alle scenarioer vises; om de har testtilfeller er ukjent.</p>
                        }

                        @* A selection opened from a Testoversikt chart: exactly those scenarios; a scenario this discovery does not hold is counted, never hidden. *@
                        @if (_filter.Identities is { } wantedIds)
                        {
                            var found = _items.Count(i => wantedIds.Contains(i.Candidate.SourceIdentity, StringComparer.Ordinal));
                            <p class="msb-spec-note mtd-overview-selection" role="status" data-testid="mtd-overview-selection">
                                <b>Utvalg fra Testoversikt:</b> @(_filter.Selection ?? "valgte scenarioer") · @found av @wantedIds.Length scenario@(wantedIds.Length == 1 ? "" : "er")
                                @if (found < wantedIds.Length) { <span data-testid="mtd-overview-selection-missing"> (@(wantedIds.Length - found) finnes ikke i forslagene for denne spesifikasjonen nå)</span> }
                                <button type="button" class="msb-link" @onclick="() => Set(DefaultFilter)" data-testid="mtd-overview-selection-clear">Fjern utvalget</button>
                            </p>
                        }
                        @* Search reaches every story; the rest of the filters on demand. *@
                        <div class="msb-toolbar" role="search" data-testid="mtd-toolbar">
                            <input type="search" class="msb-search" placeholder="Søk i scenarioer, krav og områder" aria-label="Søk i scenarioer" value="@_filter.Query"
                                   @oninput="e => Set(_filter with { Query = e.Value?.ToString() ?? string.Empty })" data-testid="mtd-search" />
                            <select class="msb-select" aria-label="Område" @onchange="e => Set(_filter with { Area = Opt(e) })" data-testid="mtd-filter-area">
                                <option value="">Alle områder</option>
                                @foreach (var a in _areas) { <option value="@a" selected="@(_filter.Area == a)">@a</option> }
                            </select>
                            @{ var advanced = S.AdvancedFilterCount(_filter with { Story = null }); }
                            <button type="button" class="msb-more-filters @(advanced > 0 ? "is-active" : null)" aria-expanded="@(_moreFilters ? "true" : "false")" aria-controls="mtd-more-filters"
                                    @onclick="() => _moreFilters = !_moreFilters" data-testid="mtd-more-filters"><span>Flere filtre</span>@if (advanced > 0) { <span class="msb-queue-n" data-testid="mtd-active-filters">@advanced</span> }</button>
                            @KindViewSwitch()
                            @if (S.HasFilters(_filter with { Story = null }))
                            {
                                <button type="button" class="msb-link" @onclick="() => Set(S.ResetFilters(_filter) with { Story = _filter.Story })" data-testid="mtd-reset-filters">Nullstill filtre</button>
                            }
                            <span class="msb-visible mt-muted" data-testid="mtd-visible" aria-live="polite">Viser @shown.Count av @_items.Count forslag@(hidden > 0 ? $" · {hidden} tekniske skjult" : "")</span>
                            @if (hidden > 0)
                            {
                                <button type="button" class="msb-link" @onclick="() => Set(new S.Filter(All: true))" data-testid="mtd-show-all">Vis alle</button>
                            }
                        </div>
                        @if (_filter.Story is not null && _filter.Query.Length > 0 && S.Apply(_items, _filter with { Story = null }).Shown.Count - shown.Count is var elsewhere and > 0)
                        {
                            <p class="msb-spec-note" data-testid="mtd-search-elsewhere">@elsewhere treff i andre brukerhistorier. <button type="button" class="msb-link" @onclick="() => SelectStory(null)">Søk i alle scenarioer</button></p>
                        }
                        @if (_moreFilters)
                        {
                            <div class="msb-filters-more" id="mtd-more-filters" data-testid="mtd-filters-panel">
                                <select class="msb-select" aria-label="Status" @onchange="e => Set(_filter with { Status = Opt(e) })" data-testid="mtd-filter-status">
                                    <option value="">Alle statuser</option>
                                    @foreach (var (key, label) in S.Statuses) { <option value="@key" selected="@(_filter.Status == key)">@label</option> }
                                </select>
                                <select class="msb-select" aria-label="Type" @onchange="e => Set(_filter with { Type = Opt(e) })" data-testid="mtd-filter-type">
                                    <option value="">Alle typer</option>
                                    @foreach (var t in _types) { <option value="@t" selected="@(_filter.Type == t)">@t</option> }
                                </select>
                                @if (_requirementIds.Count > 0)
                                {
                                    <select class="msb-select" aria-label="Krav" @onchange="e => Set(_filter with { Requirement = Opt(e) })" data-testid="mtd-filter-requirement">
                                        <option value="">Alle krav</option>
                                        @foreach (var r in _requirementIds) { <option value="@r" selected="@(_filter.Requirement == r)">@r</option> }
                                    </select>
                                }
                                @if (_priorities.Count > 0)
                                {
                                    <select class="msb-select" aria-label="Prioritet" @onchange="e => Set(_filter with { Priority = Opt(e) })" data-testid="mtd-filter-priority">
                                        <option value="">Alle prioriteter</option>
                                        @foreach (var pr in _priorities) { <option value="@pr" selected="@(_filter.Priority == pr)">@(pr == S.NoPriority ? "Prioritet ikke oppgitt" : pr)</option> }
                                    </select>
                                }
                                <select class="msb-select" aria-label="Testtilnærming" @onchange="e => Set(_filter with { Approach = Enum.TryParse<ExecutionApproach>(Opt(e), out var ap) ? ap : null })" data-testid="mtd-filter-approach">
                                    <option value="">Alle testtilnærminger</option>
                                    @foreach (var ap in Enum.GetValues<ExecutionApproach>()) { <option value="@ap" selected="@(_filter.Approach == ap)">@TestDesignAdvisor.ApproachLabel(ap)</option> }
                                </select>
                                <select class="msb-select" aria-label="Scenariotype" @onchange="e => Set(_filter with { ScenarioType = Opt(e) })" data-testid="mtd-filter-scenario-type">
                                    <option value="">Alle typer</option>
                                    @foreach (var (key, label) in S.TypeFilters) { <option value="@key" selected="@(_filter.ScenarioType == key)">@label</option> }
                                </select>
                                <select class="msb-select" aria-label="Testnivå" @onchange="e => Set(_filter with { TestLevel = Opt(e) })" data-testid="mtd-filter-level">
                                    <option value="">Alle testnivåer</option>
                                    @foreach (var lv in TestLevelClassifier.Order) { <option value="@lv" selected="@(_filter.TestLevel == lv.ToString())">@TestLevelClassifier.Label(lv)</option> }
                                </select>
                                <select class="msb-select" aria-label="Implementeringsstatus" @onchange="e => Set(_filter with { ImplementationStatus = Opt(e) })" data-testid="mtd-filter-impl-status">
                                    <option value="">Alle implementeringsstatuser</option>
                                    @foreach (var st in UserStoryStatusText.FilterOrder) { <option value="@st" selected="@(_filter.ImplementationStatus == st.ToString())">@UserStoryStatusText.Label(st)</option> }
                                </select>
                                <select class="msb-select" aria-label="Automatiske tester" @onchange="e => Set(_filter with { Tech = Opt(e) })" data-testid="mtd-filter-tech">
                                    <option value="">Alle (automatiske tester)</option>
                                    @foreach (var (key, label) in TC.Filters) { <option value="@key" selected="@(_filter.Tech == key)">@label</option> }
                                </select>
                                <select class="msb-select" aria-label="Testplanstatus" @onchange="e => Set(_filter with { PlanStatus = Opt(e) })" data-testid="mtd-filter-plan-status">
                                    <option value="">Alle (testplanstatus)</option>
                                    @foreach (var (key, label) in S.PlanStatusFilters) { <option value="@key" selected="@(_filter.PlanStatus == key)" disabled="@(key is "inchosen" or "notinchosen" && _filter.Plan is null)">@label</option> }
                                </select>
                                @if (S.ActivePlans(_items) is { Count: > 0 } planChoices)
                                {
                                    <select class="msb-select" aria-label="Testplan" @onchange="SetPlanFilter" data-testid="mtd-filter-plan">
                                        <option value="">Velg testplan …</option>
                                        @foreach (var (pid, pname) in planChoices) { <option value="@pid" selected="@(_filter.Plan == pid)">@pname</option> }
                                    </select>
                                }
                            </div>
                        }

                        @* The scenario collection: compact rows, paged, keyboard-navigable, multi-select. *@
                        <section class="msb-list" aria-label="Scenarioer" data-testid="mtd-scenarios">
                            @if (shown.Count == 0)
                            {
                                <p class="msb-empty" data-testid="mtd-empty">@EmptyText() <button type="button" class="msb-link" @onclick="() => Set(DefaultFilter with { Story = _filter.Story })">Nullstill filter</button>
                                    @if (_filter.Queue == ScenarioWorkQueue.Recommended && _queueCounts.GetValueOrDefault(ScenarioWorkQueue.NeedsClarification) > 0)
                                    {
                                        <button type="button" class="msb-link" @onclick="() => Set(_filter with { Queue = ScenarioWorkQueue.NeedsClarification })" data-testid="mtd-empty-clarify">Se hva som må avklares (@_queueCounts[ScenarioWorkQueue.NeedsClarification])</button>
                                    }</p>
                            }
                            else
                            {
                                @GroupingTools(shown)
                                @if (_gPrimary != ScenarioGroupAxis.None)
                                {
                                    var tree = ScenarioGrouping.Build(shown, _gPrimary, _gSecondary);
                                    <div class="mtg-tree" data-testid="mtd-group-tree" data-primary="@_gPrimary" data-secondary="@_gSecondary">
                                        @foreach (var g in tree) { @GroupNode(g, shown.Count) }
                                    </div>
                                }
                                else
                                {
                                <div class="msb-list-head">
                                    <button type="button" class="msb-link" @onclick="() => SelectAll(pageItems)" data-testid="mtd-select-visible">Velg synlige (@pageItems.Count)</button>
                                    @if (_selected.Count > 0) { <button type="button" class="msb-link" @onclick="ClearSelection" data-testid="mtd-clear-selection">Fjern valg</button> }
                                </div>
                                <ul class="msb-rows" role="listbox" aria-multiselectable="true" aria-label="Scenarioer" tabindex="0" @onkeydown="e => KeyAsync(e, pageItems)"
                                    aria-activedescendant="@(active is null ? null : $"msb-row-{active.Id}")" data-testid="mtd-rows">
                                    @foreach (var i in pageItems) { @Row(i) }
                                </ul>
                                @if (shown.Count > _limit)
                                {
                                    <button type="button" class="btn btn-secondary btn-sm msb-more" @onclick="() => _limit += S.PageSize" data-testid="mtd-more">Vis flere (@(shown.Count - _limit) igjen)</button>
                                }
                                }
                            }
                        </section>
                    }
                    }
                </div>

                @* 4. The open scenario: source, requirements, readiness, test cases — then design advice and everything else on demand. *@
                @* On-demand detail drawer (2026-11-25): closed by default; «Vis detaljer» opens it for that scenario; selecting another scenario while it is
                   open updates it, while closed it stays closed; Escape or «Lukk» closes it and keeps the selection. It takes no column in the grid. *@
                <aside id="mtd-drawer" class="msb-detail mtw-detail mtw-drawer @(_drawerOpen ? "is-open" : null)" hidden="@(!_drawerOpen)" role="dialog" aria-modal="false"
                       aria-label="Scenariodetaljer" data-testid="mtd-detail" data-open="@(_drawerOpen ? "true" : "false")" @onkeydown="DrawerKey" tabindex="-1" @ref="_drawer">
                    <div class="mtw-drawer-head">
                        <span class="mtw-drawer-title">Scenariodetaljer</span>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CloseDetailsAsync" data-testid="mtd-drawer-close" aria-label="Lukk detaljer">Lukk</button>
                    </div>
                    @if (active is null)
                    {
                        <p class="mt-muted" data-testid="mtd-detail-empty">@(_missingScenario is { } gone ? $"Scenarioet du sist hadde åpent («{gone}») finnes ikke i gjeldende oppdagelse. Velg et scenario i listen." : "Velg et scenario for å se hva som skal testes.")</p>
                    }
                    else
                    {
                        var c = active.Candidate;
                        var cases = W.CasesOf(c, _trace);
                        var links = Links(active, cases);
                        <nav class="mtw-crumbs" aria-label="Plassering" data-testid="mtd-breadcrumb">
                            @if (c.Story is { } crumbStory)
                            {
                                <button type="button" class="msb-link" @onclick="() => SelectStory(crumbStory.Key)">@W.StoryLabel(crumbStory)</button><span aria-hidden="true"> › </span>
                            }
                            else
                            {
                                <span class="mt-muted">Uten brukerhistorie</span><span aria-hidden="true"> › </span>
                            }
                            <span>@W.ScenarioLabel(active)</span>
                            @if (cases.Count > 0) { <span aria-hidden="true"> › </span><span class="mt-muted">@cases.Count testtilfelle@(cases.Count == 1 ? "" : "r")</span> }
                        </nav>
                        @if (!shown.Any(i => i.Id == active.Id))
                        {
                            <p class="msb-spec-note" data-testid="mtd-detail-outside">Dette scenarioet vises ikke med gjeldende brukerhistorie eller filter. Det er fortsatt åpent her.</p>
                        }
                        <div class="msb-detail-head mtw-ac-head">
                            @{ var detailTitle = ManualTestingLanguage.ScenarioTitle(active, W.RowTitle(active), _language); }
                            <h2 class="msb-detail-title" data-testid="mtd-detail-title" data-language="@(detailTitle.Translated ? "nb" : "original")">@(c.Story is not null && c.NumberInStory is { } acn ? $"{W.AcLabel(acn)} — {detailTitle.Text}" : detailTitle.Text)</h2>
                            <span class="msb-status msb-tone-@active.Status.Tone">@active.Status.Text</span>
                        </div>
                        @* Scenario details redesign (2026-11-26): what to expect, where the scenario is planned and what to do next come first; classification,
                           developer tests, readiness criteria and the source follow, the technical parts on demand. *@
                        @if (detailTitle.Note is { } titleNote) { <p class="mt-muted msb-small mtw-lang-note" data-testid="mtd-detail-lang-note">@titleNote</p> }
                        @if (detailTitle.Original is { } originalTitle) { <p class="msb-original" data-testid="mtd-detail-title-original"><span class="mtp-lang-tag">Original</span> @originalTitle</p> }
                        <section class="mtw-section mtw-expected" aria-label="Forventet resultat" data-testid="mtd-expected">
                            <span class="mtp-ctx-label">Forventet resultat</span>
                            @if (c.ExpectedBehaviour is { Length: > 0 } expected)
                            {
                                var shownExpected = ManualTestingLanguage.Expected(active, expected, _language);
                                <p class="mtw-expected-text" data-testid="mtd-expected-text" data-language="@(shownExpected.Translated ? "nb" : "original")">@shownExpected.Text</p>
                                @if (shownExpected.Original is { } originalExpected) { <p class="msb-original" data-testid="mtd-expected-original"><span class="mtp-lang-tag">Original</span> @originalExpected</p> }
                            }
                            else { <p class="msb-tone-warn" data-testid="mtd-expected-missing">Forventet resultat må avklares — kilden oppgir det ikke.</p> }
                        </section>
                        @DrawerPlans(active)
                        @ScenarioTypeSection(active)
                        @if (!string.Equals(W.RowTitle(active), c.Title, StringComparison.Ordinal) && !string.Equals(active.Title, c.Title, StringComparison.Ordinal)) { <p class="msb-original" data-testid="mtd-detail-original">Opprinnelig tittel: @c.Title</p> }
                        <p class="msb-chips"><span>@active.TypeLabel</span><span>@active.Area</span>@if (active.Relevance != S.Relevance.Manual) { <span>@(active.Relevance == S.Relevance.Both ? "Manuell + teknisk" : "Teknisk")</span> }</p>
                        var kindDecision = StoryGroupingEngine.TestKindDecision(_groupDoc, active.Id); var canSetKind = CanSetKind(active);
                        <div class="mtw-kind" data-testid="mtd-kind" data-kind="@active.Relevance" data-decided="@(active.KindDecided ? "true" : "false")">
                            <span class="mtp-ctx-label">Testtype</span>
                            <div class="mtw-seg" role="radiogroup" aria-label="Testtype for scenarioet">
                                @foreach (var (k, label) in new[] { (ScenarioTestKind.Manual, "Manuell"), (ScenarioTestKind.Technical, "Teknisk"), (ScenarioTestKind.Both, "Begge") })
                                {
                                    var kind = k; var on = S.KindOf(active.Relevance) == kind;
                                    <button type="button" role="radio" class="mtw-seg-btn is-@kind.ToString().ToLowerInvariant()" aria-checked="@(on ? "true" : "false")" disabled="@(!canSetKind || _kindSaving)"
                                            title="@(canSetKind ? null : "Kan bare endres for scenarioer i valgt spesifikasjon, med skrivetilgang.")"
                                            @onclick="() => SetKindAsync(active, on && !active.KindDecided ? kind : on ? null : kind)" data-testid="mtd-kind-option" data-kind="@kind">@label</button>
                                }
                            </div>
                            <span class="msb-small mt-muted" data-testid="mtd-kind-basis">
                                @if (kindDecision is not null)
                                {
                                    @($"Valgt av {kindDecision.By} {kindDecision.At.ToLocalTime():dd.MM.yyyy HH:mm} · forslaget var {S.KindLabel(active.Suggested).ToLowerInvariant()}.")
                                }
                                else
                                {
                                    @($"Ikke vurdert. Automatisk forslag: {S.KindLabel(active.Suggested).ToLowerInvariant()} — {S.SuggestionReason(active)}")
                                }
                            </span>
                            @if (kindDecision is not null && canSetKind)
                            {
                                <button type="button" class="msb-link" disabled="@_kindSaving" @onclick="() => SetKindAsync(active, null)" data-testid="mtd-kind-reset">Tilbake til forslaget</button>
                            }
                            @if (_kindError is not null) { <span class="msb-small msb-tone-warn" role="alert" data-testid="mtd-kind-error">@_kindError</span> }
                        </div>
                        var tech = TC.Of(c, TechDecisions, _ws?.Discovery?.TestsReadForScenarios ?? false);
                        <section class="mtw-tech" aria-label="Hva er allerede kontrollert?" data-testid="mtd-tech" data-state="@tech.State">
                            <div class="mtw-tech-head">
                                <span class="mtp-ctx-label">Hva er allerede kontrollert?</span>
                                <span class="msb-status msb-tone-@tech.Tone" data-testid="mtd-tech-state">@tech.Label</span>
                                @if (tech.Tests.Count > 0) { <span class="mt-muted msb-small" data-testid="mtd-tech-result">@TC.NoResult</span> }
                            </div>
                            <p class="msb-small" data-testid="mtd-tech-meaning">@DT.Meaning(tech.State)</p>
                            @{ var checkpoints = DT.Checkpoints(c, tech.State); }
                            @if (checkpoints.Count > 0 && tech.State != TC.State.NotAssessed)
                            {
                                <div class="mtw-checkpoints" data-testid="mtd-checkpoints">
                                    <span class="mtp-ctx-label">Forventede resultater</span>
                                    <ul>
                                        @foreach (var cp in checkpoints)
                                        {
                                            <li data-testid="mtd-checkpoint" data-state="@cp.State"><span class="msb-status msb-tone-@(cp.State == DT.CheckpointState.CheckedByAssessedTest ? "ok" : "muted")">@cp.Label</span> @cp.Text</li>
                                        }
                                    </ul>
                                    @if (tech.State == TC.State.Partial) { <p class="mt-muted msb-small" data-testid="mtd-checkpoints-partial">Vurderingen sier at testen dekker deler — ikke hvilke. Ingen av resultatene regnes derfor som kontrollert.</p> }
                                </div>
                            }
                            @if (tech.Tests.Count > 0) { <p class="mt-muted msb-small" data-testid="mtd-tech-caveat">@DT.Caveat</p> }
                            @if (tech.State == TC.State.NotAssessed)
                            {
                                <p class="mt-muted msb-small" data-testid="mtd-tech-not-assessed">Testene i kilden er ikke lest for scenariohenvisninger ennå. Importer kilden på nytt for å se hvilke automatiske tester som nevner scenarioet.</p>
                            }
                            else if (tech.Tests.Count == 0)
                            {
                                <p class="mt-muted msb-small" data-testid="mtd-tech-none">Ingen automatisk test i kilden nevner dette scenarioet eller kravene det bygger på. Det betyr ikke at det er risikofritt — bare at ingen kodetest er kjent.</p>
                            }
                            @foreach (var row in tech.Tests)
                            {
                                var r = row;
                                <div class="mtw-tech-row" data-testid="mtd-tech-test" data-link="@r.Link" data-extent="@r.Extent" data-test="@r.Test.TestId">
                                    <div class="mtw-tech-line">
                                        <span class="mtw-tech-layer">@r.Layer</span>
                                        <span class="mtw-tech-name">@r.ReadableName</span>
                                    </div>
                                    <div class="mtw-tech-facts">
                                        <span class="msb-status msb-tone-@(r.Link switch { TC.Link.Confirmed or TC.Link.Explicit => "ok", TC.Link.Review => "warn", TC.Link.Rejected => "bad", _ => "info" })" data-testid="mtd-tech-link">@TC.LinkLabel(r.Link)</span>
                                        @if (r.Link == TC.Link.Confirmed) { <span class="msb-small" data-testid="mtd-tech-extent">@TC.ExtentLabel(r.Extent)</span> }
                                        @if (r.ReviewReason is { } why) { <span class="msb-small msb-tone-warn" data-testid="mtd-tech-review-reason">@why</span> }
                                        @if (r.Decided is { } dd) { <span class="mt-muted msb-small">@($"Vurdert av {dd.By} {dd.At.ToLocalTime():dd.MM.yyyy}")</span> }
                                    </div>
                                    @if (canSetKind)
                                    {
                                        <div class="mtw-tech-actions">
                                            @if (r.Link is not TC.Link.Confirmed)
                                            {
                                                <button type="button" class="msb-link" disabled="@_techSaving" @onclick="() => ReviewTestAsync(active, r, TestLinkReview.Confirmed, TechnicalCoverageExtent.NotAssessed)" data-testid="mtd-tech-confirm">Bekreft kobling</button>
                                            }
                                            @if (r.Link is not TC.Link.Rejected)
                                            {
                                                <button type="button" class="msb-link" disabled="@_techSaving" @onclick="() => ReviewTestAsync(active, r, TestLinkReview.Rejected, TechnicalCoverageExtent.NotAssessed)" data-testid="mtd-tech-reject">Avvis</button>
                                            }
                                            @if (r.Link == TC.Link.Confirmed)
                                            {
                                                <button type="button" class="msb-link" disabled="@_techSaving" @onclick="() => ReviewTestAsync(active, r, TestLinkReview.Confirmed, TechnicalCoverageExtent.Partial)" data-testid="mtd-tech-partial">Dekker deler</button>
                                                <button type="button" class="msb-link" disabled="@_techSaving" title="Velg bare når du har lest hva testen kontrollerer og den dekker alle betingelsene i scenarioet."
                                                        @onclick="() => ReviewTestAsync(active, r, TestLinkReview.Confirmed, TechnicalCoverageExtent.Full)" data-testid="mtd-tech-full">Dekker hele scenarioet</button>
                                            }
                                            @if (r.Decided is not null)
                                            {
                                                <button type="button" class="msb-link" disabled="@_techSaving" @onclick="() => ReviewTestAsync(active, r, TestLinkReview.Cleared, TechnicalCoverageExtent.NotAssessed)" data-testid="mtd-tech-clear">Fjern vurderingen</button>
                                            }
                                        </div>
                                    }
                                    <details class="mtw-why" data-testid="mtd-tech-details"><summary>Vis tekniske detaljer</summary>
                                        <dl class="mtw-tech-dl">
                                            <dt>Klasse</dt><dd data-testid="mtd-tech-class">@(r.Test.ClassName ?? "—")</dd>
                                            <dt>Metode</dt><dd data-testid="mtd-tech-method">@(r.Test.MethodName ?? r.Test.Name)</dd>
                                            <dt>Fil</dt><dd data-testid="mtd-tech-file">@(r.Test.File ?? "—")</dd>
                                            <dt>Hvorfor</dt><dd data-testid="mtd-tech-basis">@r.Test.Basis</dd>
                                            <dt>Rammeverk</dt><dd>@(r.Test.Framework ?? "—") · @(r.Test.Layer ?? "—")</dd>
                                        </dl>
                                    </details>
                                </div>
                            }
                            @if (tech.ReviewedButGone > 0) { <p class="mt-muted msb-small" data-testid="mtd-tech-gone">@tech.ReviewedButGone tidligere vurdert@(tech.ReviewedButGone == 1 ? "" : "e") test@(tech.ReviewedButGone == 1 ? "" : "er") finnes ikke lenger i kilden.</p> }
                            @if (_techError is not null) { <span class="msb-small msb-tone-warn" role="alert" data-testid="mtd-tech-error">@_techError</span> }
                        </section>
                        @if (!string.IsNullOrWhiteSpace(c.Purpose)) { <p data-testid="mtd-detail-purpose">@c.Purpose</p> }
                        @if (_specItems.Count > 0)
                        {
                            var specContext = SC.For(_specItems, c.RequirementIds, c.Story?.StoryId);
                            <details class="mtw-spec" data-testid="mtd-spec-items" data-direct="@specContext.Direct.Count">
                                <summary><span class="mtp-ctx-label">Fra spesifikasjonen</span> <span class="msb-small mt-muted" data-testid="mtd-spec-summary">@SC.Summary(specContext)</span></summary>
                                @foreach (var kind in SC.Order.Where(k => specContext.Count(k, direct: true) > 0))
                                {
                                    <div class="mtw-spec-group" data-testid="mtd-spec-group" data-kind="@kind">
                                        <span class="mtw-spec-heading">@SC.Heading(kind)</span>
                                        <ul>@foreach (var item in specContext.Direct.Where(i => i.Kind == kind)) { @SpecItem(item) }</ul>
                                    </div>
                                }
                                <details class="mtw-why" data-testid="mtd-spec-general"><summary>Generelt for spesifikasjonen</summary>
                                    <p class="mt-muted msb-small">Punkter som ikke nevner scenarioets krav eller brukerhistorie direkte. De kan likevel være relevante.</p>
                                    @foreach (var kind in SC.Order.Where(k => specContext.Count(k, direct: false) > 0))
                                    {
                                        <details class="mtw-spec-group" data-testid="mtd-spec-general-group" data-kind="@kind"><summary>@SC.Heading(kind) (@specContext.Count(kind, direct: false))</summary>
                                            <ul>@foreach (var item in specContext.All.Where(i => i.Kind == kind)) { @SpecItem(item) }</ul>
                                        </details>
                                    }
                                </details>
                            </details>
                        }
                        @if (c.Conflicts.Count > 0)
                        {
                            <div class="msb-callout is-bad" data-testid="mtd-detail-conflict">
                                <strong>Trenger avklaring:</strong> @c.Conflicts[0].Explanation
                                <ul>@foreach (var claim in c.Conflicts.SelectMany(k => k.Claims).DistinctBy(x => x.CandidateId)) { <li>@claim.SourceCategory: «@claim.Expected»</li> }</ul>
                            </div>
                        }

                        var gwt = SourceGwt(c);
                        @if (gwt.Count > 0)
                        {
                            @* «Fra kilden (ordrett)» collapsed by default (2026-11-25), the same accordion as «Kildegrunnlag» in Planlegg og klargjør: open only for the
                               scenario it was opened on (another scenario, story, specification, module or project starts collapsed). The text is unchanged. *@
                            var sourceOpen = _sourceOpenFor == active.Id;
                            <section class="mtw-section mtw-source" aria-label="Fra kilden" data-testid="mtd-detail-source" data-open="@(sourceOpen ? "true" : "false")">
                                <span class="mtp-ctx-label mtp-context-head"><button type="button" class="mtp-context-toggle" aria-expanded="@(sourceOpen ? "true" : "false")" aria-controls="mtd-source-body"
                                        @onclick="() => _sourceOpenFor = sourceOpen ? null : active.Id" data-testid="mtd-source-toggle">Fra kilden (ordrett)</button></span>
                                <div id="mtd-source-body" class="mtp-context-body" hidden="@(!sourceOpen)" data-testid="mtd-source-body">
                                    <dl class="mtw-gwt">@foreach (var (label, text) in gwt) { <dt>@label</dt><dd>@text</dd> }</dl>
                                </div>
                            </section>
                        }

                        <section class="mtw-section" aria-label="Krav" data-testid="mtd-detail-requirements">
                            <span class="mtp-ctx-label">Krav</span>
                            @if (links.Count == 0)
                            {
                                <p class="mt-muted msb-small">Ingen krav er nevnt i kilden, bekreftet av en tester eller foreslått for scenarioet (ikke koblet).</p>
                            }
                            else
                            {
                                <ul class="mtw-links">
                                    @foreach (var l in links)
                                    {
                                        var link = l;
                                        <li data-relation="@link.Relation" data-testid="mtd-req-link">
                                            <button type="button" class="msb-req mtw-req-@W.RelationTone(link) @(_openRequirement == link.Id ? "is-open" : null)" aria-expanded="@(_openRequirement == link.Id ? "true" : "false")"
                                                    @onclick="() => ToggleRequirement(link.Id)" data-testid="mtd-req-chip">@link.Id@(IsTechnicalRequirement(link.Id) ? " · teknisk" : "")</button>
                                            <span class="msb-small mtw-relation">@W.RelationLabel(link)</span>
                                        </li>
                                    }
                                </ul>
                                @if (links.FirstOrDefault(l => l.Id == _openRequirement) is { } open)
                                {
                                    var others = W.ScenariosNaming(_items, open.Id, active.Id);
                                    <div class="mtw-req-panel" data-testid="mtd-req-panel">
                                        <strong>@open.Id</strong>
                                        <p data-testid="mtd-req-text">@(open.Title ?? "Kravteksten finnes ikke i valgt spesifikasjon.")</p>
                                        <p class="msb-small"><b>Hvorfor koblet:</b> @W.RelationLabel(open) — @open.Explanation</p>
                                        @if (open.Relation == W.Relation.Suggested) { <p class="mt-muted msb-small">Et forslag er ikke en kobling. Bekreft eller avvis det på testtilfellet i Planlegg og klargjør.</p> }
                                        @if (others.Count > 0)
                                        {
                                            <p class="msb-small">Også nevnt i @others.Count andre scenario@(others.Count == 1 ? "" : "er"):
                                                @foreach (var o in others.Take(5)) { var oid = o.Id; <button type="button" class="msb-link" @onclick="() => Open(oid)" data-testid="mtd-req-other" title="@o.Title">@W.OtherScenarioLabel(o)</button> }</p>
                                        }
                                        <p class="msb-small">
                                            <button type="button" class="msb-link" @onclick="() => FilterRequirement(open.Id)" data-testid="mtd-req-filter-all">Vis alle scenarioer for @open.Id</button>
                                            · <a href="specification-explorer">Åpne i Specification Explorer</a>
                                        </p>
                                    </div>
                                }
                            }
                        </section>

                        var checklist = Checklist(active);
                        var met = checklist.Count(x => x.State == Tri.Yes);
                        <section class="mtw-section" aria-label="Kildegrunnlag" data-testid="mtd-readiness">
                            <details class="mtw-ready-details" data-testid="mtd-readiness-details">
                            @* Finn og forstå v3 (2026-11-26): these are SOURCE checkpoints (what the source and stored data say), not execution readiness —
                               «16/16» next to «Ikke klar til kjøring» was two different assessments under one name. Execution readiness is «Klargjør AC». *@
                            <summary><span class="mtp-ctx-label">Kildegrunnlag</span> <span class="mtw-met" data-testid="mtd-readiness-count">@met / @checklist.Count</span>
                                <span class="mt-muted msb-small" data-testid="mtd-readiness-meaning">kontrollpunkter i kilden oppfylt · klar til kjøring vurderes i «Klargjør AC»</span>
                                <span class="msb-link msb-small mtw-ready-more">Vis kriterier og mangler</span></summary>
                            <ul class="mtw-checklist">
                                @foreach (var item in checklist)
                                {
                                    <li data-state="@item.State" data-key="@item.Key" data-testid="mtd-readiness-item">
                                        <span class="tdp-mark" aria-hidden="true">@W.Mark(item.State)</span>
                                        <span class="mtw-check-text"><strong>@item.Question</strong> <span class="mtw-check-state">@W.StateText(item.State)</span>
                                            @if (item.State != Tri.Yes) { <span class="mt-muted msb-small">@item.Detail Løses vanligvis av: @item.Owner.</span> }</span>
                                    </li>
                                }
                            </ul>
                            <span class="mt-muted msb-small">Fra det kilden og lagrede data viser for scenarioet. Ukjent teller aldri som oppfylt. Hvert testtilfelle har sin egen status i Planlegg og klargjør.</span>
                            </details>
                            @if (active.Work is { ExecutionNeeds.Count: > 0 } needs) { <p class="msb-exec" data-testid="mtd-detail-exec"><strong>Før kjøring trengs:</strong> @string.Join("; ", needs.ExecutionNeeds)</p> }
                        </section>

                        <section class="mtw-section" aria-label="Testtilfeller" data-testid="mtd-detail-cases">
                            <span class="mtp-ctx-label">Testtilfeller</span>
                            <p class="msb-small" data-testid="mtd-detail-coverage">@CoverageText(active)@if (c.ExistingTests.Count > 0) { <span class="msb-basis">@c.ExistingTests.Count automatisk(e) test(er) refererer kravet — det betyr at testen finnes, ikke at den er bestått.</span> }</p>
                            @if (cases.Count > 0)
                            {
                                <ul class="mtw-cases">@foreach (var k in cases) { <li data-testid="mtd-detail-case"><a href="@W.CaseHref(k)" data-testid="mtd-detail-case-open">@k.Title</a> <span class="msb-status msb-tone-@CaseTone(k)">@W.StageText(k.Stage)</span> <span class="mt-muted msb-small">@W.ExecutionText(k.Execution)</span></li> }</ul>
                            }
                            <div class="msb-detail-actions">
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="() => ToggleAsync(c.CandidateId)" data-testid="mtd-detail-select">@(_selected.Contains(c.CandidateId) ? "Fjern fra valget" : "Velg")</button>
                                <button type="button" class="btn btn-primary btn-sm" @onclick="() => PrepareOnlyAsync(c.CandidateId)" data-testid="mtd-detail-prepare">@(active.Prepared is { Cases: > 0 } ? "Lag enda et testtilfelle" : "Forbered testtilfeller")</button>
                            </div>
                            <span class="mt-muted msb-small">Nye testtilfeller beholder koblingen til scenarioet@(c.Story is { } ks ? $" og {W.StoryLabel(ks)}" : "") automatisk.</span>
                        </section>

                        @if (active.Work is { } work)
                        {
                            @if (work.Clarifications.Count > 0)
                            {
                                <div class="msb-callout is-warn" data-testid="mtd-detail-clarify"><strong>Må avklares før klargjøring:</strong>
                                    <ul>@foreach (var item in work.Clarifications) { <li>@item</li> }</ul></div>
                            }
                            <details class="msb-why" data-testid="mtd-detail-why">
                                <summary>Hvorfor @(active.In(ScenarioWorkQueue.Recommended) ? "anbefalt" : "her")?</summary>
                                <ul>@foreach (var reason in work.Reasons) { <li>@reason</li> }</ul>
                            </details>
                        }
                        var open2 = c.OpenQuestions.Concat(c.Gaps.Where(g => g.Kind != EvidenceGapKind.ContradictoryEvidence).Select(g => g.Question)).Distinct().ToList();
                        @if (open2.Count > 0)
                        {
                            <div class="msb-callout is-warn" data-testid="mtd-detail-questions"><strong>Åpne spørsmål</strong><ul>@foreach (var q in open2.Take(5)) { <li>@q</li> }</ul></div>
                        }

                        @* «Klargjør AC» (2026-11-26): the scenario's own preparation, the same calculation as Planlegg og klargjør. *@
                        @if (_ws?.ProjectKey is { } prepKey)
                        {
                            <BirkNext.Web.Components.ManualTesting.ScenarioPreparationPanel ProjectKey="@prepKey" Scenario="c" OnSaved="PreparationSavedAsync" />
                        }
                        <details class="mtw-more" data-testid="mtd-detail-design" open="@_designOpen" @ontoggle="() => _designOpen = !_designOpen">
                            <summary>Vis teknisk analyse (testdesign og forslag til flere tester)</summary>
                            <BirkNext.Web.Components.ManualTesting.TestDesignPanel Facts="TestDesignAdvisor.FactsOf(c)" Scenario="TestDesignAdvisor.AsDraft(c)" Suitability="active.Suitability" />
                        </details>

                        <details class="mtw-more" data-testid="mtd-detail-more">
                            <summary>Mer om scenarioet</summary>
                            <dl class="msb-facts">
                                @if (c.Preconditions.Count > 0) { <dt>Forutsetninger</dt><dd data-testid="mtd-detail-preconditions">@string.Join("; ", c.Preconditions)</dd> }
                                @if (c.Steps.Count > 0)
                                {
                                    <dt>Steg (BirkNext)</dt>
                                    <dd><ol class="msb-steps">@foreach (var step in c.Steps) { <li>@step.Action@if (step.Expected is { } ex) { <span class="msb-step-expected">→ @ex</span> }</li> }</ol></dd>
                                }
                                <dt>Forventet resultat</dt>
                                <dd data-testid="mtd-detail-expected">@(c.ExpectedBehaviour ?? "Ikke oppgitt") <span class="msb-basis">@S.ExpectedBasis(c)</span></dd>
                                @if (c.TestDataNeeds.Count > 0) { <dt>Testdata</dt><dd>@string.Join("; ", c.TestDataNeeds)</dd> }
                                @if (c.Story is { } story) { <dt>Brukerhistorie</dt><dd data-testid="mtd-detail-story">@W.StoryLabel(story) — @W.StoryTitle(story)</dd> }
                            </dl>
                            @* «Relaterte scenarioer» (2026-11-25): which ones and why, with a way to open them — suggestions from the source evidence, never merged. *@
                            @if (c.Relations.Count > 0 || c.PossibleDuplicates.Count > 0)
                            {
                                <div class="msb-basis mtw-related" data-testid="mtd-detail-relations">
                                    <span class="mtp-ctx-label">Relaterte scenarioer</span>
                                    <ul>
                                        @foreach (var rel in c.Relations.Take(8))
                                        {
                                            var other = _items.FirstOrDefault(x => x.Id == rel.OtherCandidateId); var otherId = rel.OtherCandidateId;
                                            <li data-testid="mtd-related" data-relation="@rel.Relation">
                                                <span class="msb-tag">@RelationLabel(rel.Relation)</span>
                                                @if (other is not null) { <button type="button" class="msb-link" @onclick="() => Open(otherId)" data-testid="mtd-related-open">@W.DetailTitle(other)</button> }
                                                else { <span class="mt-muted">@rel.OtherCandidateId (ikke i gjeldende utvalg)</span> }
                                                <span class="mt-muted msb-small"> — @rel.Reason</span>
                                            </li>
                                        }
                                        @foreach (var dup in c.PossibleDuplicates.Where(d => c.Relations.All(r => r.OtherCandidateId != d)).Take(5))
                                        {
                                            var other = _items.FirstOrDefault(x => x.Id == dup); var dupId = dup;
                                            <li data-testid="mtd-related" data-relation="PossibleDuplicate">
                                                <span class="msb-tag">Mulig overlapp</span>
                                                @if (other is not null) { <button type="button" class="msb-link" @onclick="() => Open(dupId)" data-testid="mtd-related-open">@W.DetailTitle(other)</button> }
                                                else { <span class="mt-muted">@dup</span> }
                                                <span class="mt-muted msb-small"> — nevner samme krav fra en annen kilde; kan dele forberedelse, men tester kanskje noe annet</span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                            <div class="msb-evidence" data-testid="mtd-detail-evidence">
                                <span class="mtp-ctx-label">Hvorfor foreslått, og kildebevis</span>
                                <p>@S.Why(active)</p>
                                <ul>
                                    @foreach (var e in c.Evidence.Where(e => e.Kind != "derived-from"))
                                    {
                                        <li><span class="msb-ev-kind">@EvidenceKind(e.Kind)</span> <code>@e.Reference</code>@if (e.Detail is { } detail) { <span class="mt-muted"> — @detail</span> }</li>
                                    }
                                </ul>
                                <p class="mt-muted msb-small">Kilde: @c.SourceCategory · @c.Engine@(string.IsNullOrEmpty(c.SnapshotKey) ? "" : $" · kildeversjon {c.SnapshotKey[..Math.Min(8, c.SnapshotKey.Length)]}") · @ScenarioCandidateTypes.ConfidenceLabel(c.Confidence)</p>
                            </div>
                        </details>
                    }
                </aside>
            </div>

            @* Continue to Plan & prepare with the selection (sticky). *@
            @if (_selected.Count > 0)
            {
                <div class="msb-selection" role="region" aria-label="Valgte scenarioer" data-testid="mtd-selection">
                    <strong>@_selected.Count valgt</strong>
                    <span class="mt-muted">Ingenting er forberedt eller godkjent ennå.</span>
                    <button type="button" class="msb-link" @onclick="ClearSelection">Fjern valg</button>
                    <button type="button" class="btn btn-primary btn-sm" @onclick="PrepareAsync" data-testid="mtd-prepare">Forbered testtilfeller →</button>
                </div>
            }
        }

        @* Supporting context: requirements and the evidence overview (collapsed). *@
        <details class="msb-context-block" data-testid="mtd-requirements" open="@_reqOpen">
            @{ var designedAll = _trace?.Requirements.ToDictionary(r => r.RequirementId, StringComparer.OrdinalIgnoreCase) ?? []; var reqs = _ws.Requirements ?? []; }
            <summary @onclick="() => _reqOpen = !_reqOpen" @onclick:preventDefault="true" data-testid="mtd-req-toggle"><span class="msb-h">Krav</span> <span class="mt-muted" data-testid="mtd-req-summary">@reqs.Count krav · @reqs.Count(r => designedAll.ContainsKey(r.RequirementId)) med testdesign</span></summary>
            @if (_ws.Requirements is not { Count: > 0 })
            {
                <p class="mt-muted" data-testid="mtd-req-none">@(RequirementLinkPresentation.SpecificationChoiceNeeded(_ws.Specification) ?? RequirementLinkPresentation.EmptyReason(_ws.Evidence, _ws.Requirements)) <a href="specification-explorer">Åpne Specification Explorer</a></p>
            }
            else if (_reqOpen)
            {
                var showTechnical = _filter.Technical || _filter.All;
                var shownReqs = M.FilterRequirements(_ws.Requirements, designedAll, _reqFilter, _reqQuery, showTechnical);
                var hiddenReqs = showTechnical ? 0 : M.FilterRequirements(_ws.Requirements, designedAll, _reqFilter, _reqQuery).Count - shownReqs.Count;
                <div class="msb-toolbar msb-toolbar-inline">
                    <input type="search" class="msb-search" placeholder="Søk i krav (id eller tekst)" aria-label="Søk i krav" value="@_reqQuery" @oninput="e => { _reqQuery = e.Value?.ToString() ?? string.Empty; _reqLimit = 25; }" data-testid="mtd-req-search" />
                    @foreach (var (key, label) in ReqFilters)
                    {
                        <button type="button" class="msb-pill" aria-pressed="@(_reqFilter == key ? "true" : "false")" @onclick="() => { _reqFilter = key; _reqLimit = 25; }" data-testid="mtd-req-filter" data-filter="@key">@label</button>
                    }
                </div>
                <ul class="msb-reqs">
                    @foreach (var r in shownReqs.Take(_reqLimit))
                    {
                        var row = designedAll.GetValueOrDefault(r.RequirementId);
                        var linked = _items.Count(i => i.Candidate.RequirementIds.Contains(r.RequirementId, StringComparer.OrdinalIgnoreCase));
                        <li data-testid="mtd-requirement" data-requirement="@r.RequirementId">
                            <button type="button" class="msb-req" @onclick="() => Set(new S.Filter(Requirement: r.RequirementId, All: true))" title="Vis scenarioer for kravet">@r.RequirementId</button>
                            <span class="msb-req-text">@r.Title</span>
                            @if (ManualTestingRelevance.RequirementReason(r.Title) is { } why) { <span class="msb-tag" title="@why" data-testid="mtd-req-technical">teknisk</span> }
                            <span class="mt-muted msb-small">@linked scenario@(linked == 1 ? "" : "er") · @(row is null ? "ingen testdesign" : row.ApprovedCases > 0 ? "godkjent testtilfelle" : "forberedt")</span>
                        </li>
                    }
                </ul>
                @if (hiddenReqs > 0)
                {
                    <p class="mt-muted msb-small" data-testid="mtd-req-hidden">@hiddenReqs teknisk@(hiddenReqs == 1 ? "" : "e") krav skjult (gjelder kodebasen, ikke atferd en tester ser). Slå på «Vis teknisk innhold» for å se dem.</p>
                }
                @if (shownReqs.Count > _reqLimit) { <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _reqLimit += 25" data-testid="mtd-req-more">Vis flere (@(shownReqs.Count - _reqLimit))</button> }
                <p class="mt-muted msb-small"><a href="test-coverage-review">Test Coverage</a> og <a href="artifact-traceability">Requirements Traceability</a> viser alle koblinger.</p>
            }
        </details>
        @if (_ws.Discovery is { } disc)
        {
            <details class="msb-context-block" data-testid="mtd-sources">
                <summary><span class="msb-h">Kildegrunnlag</span>
                    <span class="mt-muted">@disc.Capabilities.Count(c => c.State == DiscoveryCapabilityState.Available) av @disc.Capabilities.Count kilder fant noe@(disc.Candidates.Count(c => c.Conflicts.Count > 0) is var conflicts and > 0 ? $" · {conflicts} med kildekonflikt" : "")@(disc.Basis is { Complete: false } ? " · kilde mangler" : "")</span></summary>
                <ul class="msb-sources">
                    @foreach (var c in disc.Capabilities)
                    {
                        <li data-testid="mtd-capability" data-capability="@c.Id" data-state="@c.State"><strong>@c.Label</strong> <span class="msb-status msb-tone-@(c.State == DiscoveryCapabilityState.Available ? "ok" : c.State == DiscoveryCapabilityState.Failed ? "bad" : "muted")">@StateLabel(c.State)</span>
                            <span class="mt-muted msb-small">@c.Detail</span></li>
                    }
                </ul>
                @foreach (var l in disc.Limitations.Take(6)) { <p class="mt-muted msb-small">@l</p> }
            </details>
        }
    }
</div>

@code {
    private bool _loading = true, _discovering;
    private string? _discoverError;
    private ManualTestingWorkspace.Snapshot? _ws;

    /// <summary>Runs discovery for the selected application here (explicit only; the same request the planning service always used): one consistent
    /// source basis of the project's own sources, the specification captured at import. The result replaces the list; the selection is kept.</summary>
    /// <summary>The module or specification changed (2026-11-25): everything shown for the previous selection is dropped at once (never shown as the
    /// new one's), then the workspace is read again and the new selection's scenarios load by themselves.</summary>
    private Task OnScopeChangedAsync()
    {
        // An explicit module/specification change (the picker reports only the tester's own choice, never the initial restore) ends the dashboard
        // subset and every filter value tied to the previous specification (story, requirement): no hidden restriction carries over (2026-11-26).
        // Search, type, priority and the other view filters stay; the checkbox selection stays and is reported when outside the new scope.
        if (_filter.Identities is not null || _filter.Selection is not null || _filter.Story is not null || _filter.Requirement is not null)
            Set(_filter with { Identities = null, Selection = null, Story = null, Requirement = null });
        _items = []; _stories = []; _requirementIds = []; _areas = []; _types = []; _priorities = []; _trace = null; _workView = null; _workError = null;
        _active = null; _activeTitle = null; _missingScenario = null; _discoverError = null; _drillGroup = null;
        // Another module or specification starts with the default display grouping («Brukerhistorier»), never an earlier choice.
        (_groupMode, _groupModeChosen) = (G.Mode.Stories, false);
        _sourceOpenFor = null;
        if (_ws is not null) _ws = _ws with { Discovery = null };
        return LoadAsync();
    }

    /// <summary>Selections whose scenarios were already fetched automatically on this page (one automatic attempt per selection: no loop).</summary>
    private readonly HashSet<string> _autoDiscovered = new(StringComparer.Ordinal);
    /// <summary>The scenario whose «Fra kilden (ordrett)» is open (null = collapsed); every other scenario shows it collapsed.</summary>
    private string? _sourceOpenFor;
    private int _discoveryAttempt;

    /// <summary>«Prøv igjen» / «Hent på nytt»: the same safe read again for the current selection.</summary>
    private Task RetryDiscoveryAsync() => DiscoverAsync(_loadGeneration);

    /// <summary>
    /// Fetches the scenarios of the current selection (2026-11-25: automatic, no «Oppdag» button): the same request the planning service always used —
    /// it computes and stores a derived discovery result and changes no plan, test case or decision. Tied to the load that started it: when the tester
    /// chose another module or specification meanwhile, a late answer is not shown and does not reload the page.
    /// </summary>
    private async Task DiscoverAsync(int generation)
    {
        if (_ws?.ProjectKey is not { } key || ServiceProvider.GetService(typeof(ITestPlanSuggestionsApiService)) is not ITestPlanSuggestionsApiService api) return;
        var attempt = ++_discoveryAttempt;
        _discovering = true; _discoverError = null;
        _discoveredWith = SelectedSpecificationPath;
        try
        {
            var (result, error) = await api.DiscoverAsync(new ScenarioDiscoveryRequest
            {
                ProjectKey = key, ProjectName = _ws.ProjectName, SnapshotId = _ws.SnapshotId, EnvironmentId = _ws.EnvironmentId, Workspace = _ws.Evidence,
                MemberSnapshotIds = [.. ManualTestingWorkspace.MemberSnapshots(ServiceProvider)],
            });
            if (generation != _loadGeneration) return;
            if (result is null) { _discoverError = error ?? "Ukjent feil."; return; }
            _discovering = false;
            await LoadAsync();
        }
        // The spinner belongs to the newest attempt: an older one that ends late never hides the spinner of a newer one.
        finally { if (attempt == _discoveryAttempt) _discovering = false; }
    }
    private PreparedCaseTraceView? _trace;
    private List<S.Item> _items = [];
    private List<BirkNext.TestCoverage.CoverageUserStory> _stories = [];
    private List<string> _requirementIds = [];
    private List<string> _areas = [], _types = [];
    private IReadOnlyList<string> _priorities = [];
    private bool _moreFilters;
    private bool _filterRestored;
    private S.Filter _filter = S.DefaultView;
    private ScenarioWorkQueueView? _workView;
    private string? _workError;
    private Dictionary<ScenarioWorkQueue, int> _queueCounts = [];
    private int _allCount;
    private bool CoverageKnown => _workView is { CoverageComplete: true };
    /// <summary>The scenario's saved test cases in plain words: current (draft / in progress / approved) apart from archived, superseded and excluded
    /// cases, which are never counted as current coverage. Unknown when a plan could not be read — never "none".</summary>
    private string CoverageText(S.Item item)
    {
        if (item.Work?.Coverage is not { } k)
            return _workView is null ? "Ukjent — testtilfellene kunne ikke leses"
                : !CoverageKnown ? "Ukjent — en lagret plan kunne ikke leses" : "Ingen testtilfeller ennå";
        var parts = new List<string>();
        if (k.Current > 0)
        {
            var states = new List<string>();
            if (k.Draft > 0) states.Add($"{k.Draft} utkast");
            if (k.InProgress > 0) states.Add($"{k.InProgress} under arbeid");
            if (k.Approved > 0) states.Add($"{k.Approved} godkjent");
            parts.Add($"{k.Current} testtilfelle{(k.Current == 1 ? "" : "r")} ({string.Join(", ", states)}) i {k.Plans.Count} aktiv{(k.Plans.Count == 1 ? "" : "e")} plan{(k.Plans.Count == 1 ? "" : "er")}");
        }
        else parts.Add("Ingen gjeldende testtilfeller");
        if (k.SourceChanged > 0) parts.Add($"{k.SourceChanged} laget fra en kilde som er endret");
        if (k.Archived > 0) parts.Add($"{k.Archived} i arkiverte planer");
        if (k.Historical > 0) parts.Add($"{k.Historical} utgått");
        if (k.Excluded > 0) parts.Add($"{k.Excluded} bevisst utelatt");
        return string.Join(" · ", parts);
    }

    /// <summary>The selected specification (explorer choice) the page read; null when none is chosen.</summary>
    private string? SelectedSpecificationPath => _ws?.Specification is { Status: BirkNext.Web.Services.Explorers.ExplorerArtifactStatus.Loaded, Selected: { } s } ? s.SourcePath ?? s.FileName : null;
    private string? SelectedSpecificationName => _ws?.Specification?.Selected?.DisplayName;

    /// <summary>The specification path the last discovery on this page ran with (null before one ran here).</summary>
    private string? _discoveredWith;

    /// <summary>Scenarios of the discovery that come from a specification (the rest come from application-wide sources).</summary>
    private int SpecificationCandidates => _items.Count(i => i.Candidate.CapabilityId == "specification");

    /// <summary>The specifications the shown specification scenarios were found in (their user stories' files).</summary>
    private IReadOnlyList<string> DiscoveredSpecificationPaths => [.. _items.Where(i => i.Candidate.CapabilityId == "specification")
        .Select(i => i.Candidate.Story?.SpecificationPath).OfType<string>().Distinct(StringComparer.OrdinalIgnoreCase)];

    /// <summary>
    /// Whether the shown scenarios belong to the selected specification. Never pretends: scenarios found in another specification are labelled
    /// with where they come from; none from the selected one is said plainly. Nothing is filtered or invented here.
    /// </summary>
    private (string State, string Text)? SpecificationNotice()
    {
        if (SelectedSpecificationPath is not { } selected) return null;
        var name = SelectedSpecificationName ?? selected;
        if (SpecificationCandidates == 0)
            return ("none", $"Ingen testscenarioer funnet for denne spesifikasjonen («{name}»). Scenarioene under kommer fra kilder for hele applikasjonen.");
        var found = DiscoveredSpecificationPaths;
        if (found.Count == 0 || found.Any(f => string.Equals(f, selected, StringComparison.OrdinalIgnoreCase))) return null;
        var from = string.Join(", ", found);
        // The discovery shown is always the one computed for this selection (DiscoveryScope), so a «stale» list from another one cannot occur.
        return ("other", $"Scenarioene fra spesifikasjonen kommer fra {from}. «{name}» ga ingen egne testscenarioer.");
    }

    private S.Filter DefaultFilter => _workView is null ? new S.Filter() : S.DefaultView;

    /// <summary>Why the current view is empty, per queue (an empty recommended queue is a fact, not an error).</summary>
    private string EmptyText() => _filter.Queue switch
    {
        ScenarioWorkQueue.Recommended when _workView is { DiscoveryCurrent: false } => "Ingen anbefalinger: oppdagelsen er gjort på en eldre kildeversjon enn den gjeldende.",
        ScenarioWorkQueue.Recommended when _workView is { CoverageComplete: false } => "Ingen anbefalinger: en lagret plan kunne ikke leses, så det er ukjent hvilke scenarioer som allerede har testtilfeller.",
        ScenarioWorkQueue.Recommended => "Ingen scenarioer er klare for klargjøring med disse filtrene.",
        ScenarioWorkQueue.NeedsClarification => "Ingen scenarioer trenger avklaring med disse filtrene.",
        ScenarioWorkQueue.Prepared => "Ingen scenarioer har testtilfeller ennå med disse filtrene.",
        ScenarioWorkQueue.SourceChanged => "Ingen testtilfeller er laget fra en kilde som har endret seg.",
        _ => "Ingen scenarioer passer filteret.",
    };
    private readonly HashSet<string> _selected = new(StringComparer.Ordinal);
    private string? _active;
    private int _limit = S.PageSize;
    private bool _reqOpen;
    private int _reqLimit = 25;
    private string _reqFilter = M.AllRequirements;
    private string _reqQuery = string.Empty;
    private ICurrentWorkspaceProjection? _projection;

    private static readonly (string Key, string Label)[] ReqFilters =
        [(M.AllRequirements, "Alle"), (M.WithoutDesign, "Uten testdesign"), (M.PreparedOnly, "Forberedt"), (M.WithApproved, "Godkjent")];

    protected override async Task OnInitializedAsync()
    {
        _projection = ServiceProvider.GetService(typeof(ICurrentWorkspaceProjection)) as ICurrentWorkspaceProjection;
        if (_projection is not null) _projection.Changed += OnProjectChanged;
        await LoadAsync();
    }

    /// <summary>Loads are numbered: when a newer load started (another module or specification chosen meanwhile), an older one stops before it
    /// writes anything, so a slow response can never overwrite a newer choice.</summary>
    private int _loadGeneration;

    private async Task LoadAsync()
    {
        var generation = ++_loadGeneration;
        _loading = true;
        try
        {
            var ws = await new ManualTestingWorkspace(ServiceProvider).LoadAsync();
            if (generation != _loadGeneration) return;
            _ws = ws;
            _trace = null;
            var api = ServiceProvider.GetService(typeof(ITestPlanSuggestionsApiService)) as ITestPlanSuggestionsApiService;
            // Work queues and saved test cases per scenario: computed once on the server over every plan of the application (cases matched by
            // identity across imports). Unavailable → coverage is unknown (never shown as "no test case") and every scenario is listed.
            var candidates = _ws.Discovery?.Candidates ?? [];
            (ScenarioWorkQueueView? View, string? Error) work = (null, null);
            if (api is not null && _ws.ProjectKey is { } projectKey && _ws.Discovery is { } found)
                work = await api.WorkQueuesAsync(projectKey, found.DiscoveryId);
            if (generation != _loadGeneration) return;
            (_workView, _workError) = work;
            // Coming back to the page (from Plan & prepare): the search, filters and queue this tab used for this project.
            if (!_filterRestored && _ws.ProjectKey is { } restoreKey)
            {
                _filterRestored = true;
                if (await TabDraftStore.ReadAsync<S.Filter>(JS, TabDraftStore.DiscoverFilterKey(restoreKey)) is { } kept) _filter = kept;
                if (generation != _loadGeneration) return;
            }
            if (_workView is not null && _workView.DiscoveryId != _ws.Discovery?.DiscoveryId) { _workView = null; _workError = "Arbeidskøene hører til et annet oppdagelsesresultat."; }
            _items = _workView is { } view
                ? S.Items(candidates, view.Items.ToDictionary(w => w.CandidateId, StringComparer.Ordinal))
                : S.Items(candidates, new Dictionary<string, S.Prepared>());
            if (_workView is null && _filter.Queue is not null) _filter = _filter with { Queue = null };
            (_queueCounts, _allCount) = S.QueueCounts(_items, _filter);
            _stories = [.. candidates.Select(c => c.Story).OfType<BirkNext.TestCoverage.CoverageUserStory>().DistinctBy(s => s.Key).OrderBy(s => s.Ordinal)];
            _areas = [.. _items.Select(i => i.Area).Distinct().Order()];
            _types = [.. _items.Select(i => i.TypeLabel).Distinct().Order()];
            _priorities = S.Priorities(_items);
            _requirementIds = [.. candidates.SelectMany(c => c.RequirementIds).Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase)];
            if (!_contextRestored && _ws.ProjectKey is { } contextKey)
            {
                _contextRestored = true;
                if (await TabDraftStore.ReadAsync<W.WorkContext>(JS, TabDraftStore.DiscoverContextKey(contextKey)) is { } context)
                {
                    _active = context.Scenario; _tab = context.Tab is W.Tabs.Cases or W.Tabs.Coverage ? context.Tab : W.Tabs.Scenarios; _activeTitle = context.ScenarioTitle;
                }
                if (generation != _loadGeneration) return;
            }
            // A scenario that no longer exists (another specification, a new discovery) is reported, never silently replaced by another one.
            if (_active is not null && _items.All(i => i.Id != _active)) { _missingScenario = _activeTitle ?? "ukjent scenario"; _active = null; }
            if (_active is null && _missingScenario is null) _active = S.Apply(_items, _filter).Shown.FirstOrDefault()?.Id;
            _activeTitle = _items.FirstOrDefault(i => i.Id == _active)?.Title ?? _activeTitle;
            // No discovery for this exact selection yet: fetch it now, once per selection (the tester never has to press «Oppdag»).
            if (_ws.Discovery is null && _ws.DiscoveryScope is { } scopeKey && api is not null && _autoDiscovered.Add($"{_ws.ProjectKey}|{scopeKey}"))
            {
                await DiscoverAsync(generation);
                return;
            }
            await LoadGroupingAsync(api, generation);
            if (generation != _loadGeneration) return;
            _ = InvokeAsync(LoadStoryStatusAsync);
            if (_ws.ProjectKey is { } key)
            {
                // The selection this tab already holds (also the one Plan & prepare restores): kept only for scenarios that still exist.
                var kept = await TabDraftStore.ReadAsync<string[]>(JS, TabDraftStore.SelectionKey(key)) ?? [];
                foreach (var id in kept.Where(id => _items.Any(i => i.Id == id))) _selected.Add(id);
                if (_ws.Requirements is { Count: > 0 } requirements && api is not null)
                {
                    var (trace, _) = await api.PreparedCaseTraceAsync(key, new PreparedCaseTraceRequest([.. requirements.Select(r => r.SpecificationPath).Distinct()],
                        [.. requirements.Select(r => r.RequirementId)], requirements.GroupBy(r => r.RequirementId, StringComparer.OrdinalIgnoreCase).ToDictionary(g => g.Key, g => g.First().Title, StringComparer.OrdinalIgnoreCase)));
                    if (generation != _loadGeneration) return;
                    _trace = trace;
                }
            }
        }
        finally { if (generation == _loadGeneration) _loading = false; }
    }

    /// <summary>A requirement linked to a scenario stays visible as context; it is only marked when its wording is technical.</summary>
    private bool IsTechnicalRequirement(string id) => _ws?.Requirements?.FirstOrDefault(x => string.Equals(x.RequirementId, id, StringComparison.OrdinalIgnoreCase)) is { } r
        && ManualTestingRelevance.RequirementReason(r.Title) is not null;

    private static string? Opt(ChangeEventArgs e) => e.Value?.ToString() is { Length: > 0 } v ? v : null;

    /// <summary>Filters change what is shown, never the selection (it persists across filters).</summary>
    private void Set(S.Filter filter)
    {
        _filter = filter;
        _limit = S.PageSize;
        if (_ws?.ProjectKey is { } filterKey) _ = TabDraftStore.WriteAsync(JS, TabDraftStore.DiscoverFilterKey(filterKey), filter);
        (_queueCounts, _allCount) = S.QueueCounts(_items, _filter);
        var shown = S.Apply(_items, _filter).Shown;
        // The open scenario stays open when a filter hides it (the detail says so); only an empty detail takes the first shown one.
        if (_active is null && _missingScenario is null) _active = shown.FirstOrDefault()?.Id;
        _ = SaveContextAsync();
    }

    private async Task ToggleAsync(string id)
    {
        if (!_selected.Remove(id)) _selected.Add(id);
        await KeepAsync();
    }

    // ── FR-based grouping (2026-11-24) ───────────────────────────────────────────────────────────────────────────

    private StoryGroupingDocument? _groupDoc;
    private RequirementSectionMap _sections = RequirementSectionMap.Empty;
    private List<StoryGroupingEngine.StoryInputs> _groupInputs = [];
    private List<StoryGroupingProfile> _profiles = [];
    private G.Mode _groupMode = G.Mode.Stories;
    private bool _groupModeChosen, _manageGroups, _groupWritable, _reviewGrouping, _sourceMissing, _storyGrouping, _showAll;
    private string? _drillGroup;

    /// <summary>The drill-down instead of the full list: nothing chosen, no search, grouping available (else the page is as before).</summary>
    private bool ShowOverview => _filter.Story is null && string.IsNullOrWhiteSpace(_filter.Query) && !_showAll && _groupError is null && _groupInputs.Count > 0
        && _groupMode is G.Mode.Functional or G.Mode.Business;

    private void BackToGroup(string groupKey) { _drillGroup = groupKey; _showAll = false; SelectStory(null); }
    private string? _groupNotice, _groupSpecPath, _groupError;
    private int _orphanPlacements;
    private readonly HashSet<string> _openGroups = new(StringComparer.Ordinal);
    private readonly List<StoryGroupingOperation> _placementOps = [];
    private List<string> _placementPreview = [];

    /// <summary>Editing needs the same permission as saving a test plan, and a grouping document that could be read.</summary>
    private bool CanEditGrouping => _groupWritable && _ws?.Plans?.CanWrite == true;

    private IEnumerable<G.Mode> AvailableModes => new[] { G.Mode.Stories, G.Mode.Functional, G.Mode.Business, G.Mode.None }
        .Where(m => m switch { G.Mode.Business => _groupDoc is { Groups.Count: > 0 } || _groupMode == G.Mode.Business, G.Mode.Functional => _sections.Sections.Count > 0, _ => true });

    /// <summary>
    /// The grouping of the selected specification: its FR sections (read from the specification text the page already has), the stories with the
    /// browser's own evidence (tasks.md links included), and the stored review decisions. Read once per load; profiles are recomputed only when
    /// the inputs or the decisions change, never per render.
    /// </summary>
    private async Task LoadGroupingAsync(ITestPlanSuggestionsApiService? api, int generation)
    {
        _groupSpecPath = SelectedSpecificationPath?.Replace('\\', '/').TrimStart('/');
        _sections = RequirementSections.Read(_ws?.Specification?.Content);
        // The specification's own context (edge cases, clarifications, success criteria, dependencies, out of scope): built once per load from the
        // existing semantic model; never re-extracted per click.
        try
        {
            _specItems = _ws?.Specification?.Content is { Length: > 0 } specText
                ? SC.Items(SpecExplorerService.BuildSemanticModel(SpecExplorerService.Parse(specText), specText)) : [];
        }
        catch (Exception e) when (e is not OperationCanceledException) { _specItems = []; }
        var inScope = _items.Where(i => i.Candidate.Story?.SpecificationPath is { } p && _groupSpecPath is not null
            && BirkNext.Specifications.SpecificationCatalogRules.SamePath(p, _groupSpecPath)).ToList();
        _groupInputs = G.Inputs(inScope, _ws?.Evidence, _ws?.Requirements);
        _groupDoc = null; _groupWritable = false; _groupError = null;
        // «Kilde mangler»: stories exist but the specification text (and so its FR sections) is not available; stored decisions are kept as they are.
        _sourceMissing = G.SourceMissing(_groupInputs.Count > 0, _ws?.Specification?.Content);
        if (_groupInputs.Count > 0 && api is not null && _ws?.ProjectKey is { } key && _groupSpecPath is { } spec)
        {
            var (doc, error) = await api.StoryGroupingAsync(key, spec);
            if (generation != _loadGeneration) return;
            (_groupDoc, _groupError, _groupWritable) = G.LoadOutcome(doc, error, ITestPlanSuggestionsApiService.NotAvailable);
        }
        Recompute();
        if (!_groupModeChosen) _groupMode = _groupInputs.Count == 0 ? G.Mode.Stories : G.DefaultMode(_groupDoc, _sections);
        // The group of the open story starts expanded.
        if (_profiles.FirstOrDefault(p => p.StoryKey == _filter.Story) is { } open) _openGroups.Add(NodeKeyOf(open));
    }

    /// <summary>Profiles from the inputs and the decisions. A failure here is «Gruppering feilet» (the plain story list stays), never a lost story.</summary>
    private IReadOnlyList<SC.Item> _specItems = [];

