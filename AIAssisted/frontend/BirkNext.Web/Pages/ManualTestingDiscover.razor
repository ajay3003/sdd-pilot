            <span class="mtw-story-title">@entry.Title</span>
            @CompactStatus(entry.Key)
            <span class="mtw-story-meta" data-testid="mtd-story-counts">@(entry.Declared is { } declared ? $"{declared} scenarioer" : showTechnical ? $"{entry.Discovered} scenarioer" : $"{entry.Shown} for manuell testing")@(entry.WithCases > 0 ? $" · {entry.WithCases} med testtilfeller" : "")@(entry.Declared is not null && entry.Shown != entry.Discovered ? $" · {entry.Shown} i utvalget" : "")</span>
        </button>
    };

    // ── Workspace (2026-11-24) ───────────────────────────────────────────────────────────────────────────────────

    /// <summary>Everything the workspace derives from the scenario list and the filter, computed once per change (never per render: every keystroke
    /// re-renders, and each pass reads every scenario).</summary>
    private sealed record WorkspaceView(List<W.StoryEntry> Stories, W.StoryEntry? CurrentStory, List<W.StoryEntry> Rail, int HiddenStories,
        (List<S.Item> Shown, int HiddenTechnical) All, List<S.Item> Scope);
    private (S.Filter Filter, List<S.Item> Items, WorkspaceView View)? _viewMemo;

    private (string Id, List<W.ChecklistItem> Items)? _checklistMemo;

    /// <summary>The open scenario's six readiness questions, computed once per scenario.</summary>
    private List<W.ChecklistItem> Checklist(S.Item item)
    {
        if (_checklistMemo is { } m && m.Id == item.Id) return m.Items;
        var items = W.Checklist(TestDesignAdvisor.Readiness(TestDesignAdvisor.AsDraft(item.Candidate)));
        _checklistMemo = (item.Id, items);
        return items;
    }

    private WorkspaceView CurrentView()
    {
        if (_viewMemo is { } m && m.Filter == _filter && ReferenceEquals(m.Items, _items)) return m.View;
        var stories = W.Stories(_items, _filter);
        var (rail, hidden) = W.RailStories(stories, _filter.Technical || _filter.All, _filter.Story);
        var view = new WorkspaceView(stories, stories.FirstOrDefault(s => s.Key == _filter.Story), rail, hidden,
            S.Apply(_items, _filter with { Story = null, Queue = null }), S.Apply(_items, _filter with { Queue = null }).Shown);
        _viewMemo = (_filter, _items, view);
        return view;
    }

    private static readonly (string Tab, string Label)[] TabLabels = [(W.Tabs.Scenarios, "Scenarioer"), (W.Tabs.Cases, "Testtilfeller"), (W.Tabs.Coverage, "Krav og dekning")];
    private string _tab = W.Tabs.Scenarios;
    private bool _storyDetails, _designOpen, _contextRestored, _showWeak;
    private string? _openRequirement, _focusRequirement, _missingScenario, _activeTitle;
    private (string Id, int Items, PreparedCaseTraceView? Trace, List<ProjectRequirementOption>? Catalog, List<W.RequirementLink> Links)? _linksMemo;

    /// <summary>A user story group (null = «Alle scenarioer»): a filter of the one list. The open scenario stays open.</summary>
    private void SelectStory(string? key)
    {
        _storyDetails = false;
        _sourceOpenFor = null; // «Fra kilden (ordrett)» starts collapsed for another story
        // The area of a newly chosen story is shown open again (it may have been collapsed earlier).
        if (key is not null && _profiles.FirstOrDefault(p => p.StoryKey == key) is { } chosen) _closedGroups.Remove(NodeKeyOf(chosen));
        Set(_filter with { Story = key, Queue = key is null ? _filter.Queue : null });
    }

    private void SetTab(string tab) { _tab = tab; _ = SaveContextAsync(); }

    /// <summary>Opens a scenario in the detail panel (from the list, a breadcrumb, a requirement or the case tab).</summary>
    private bool _drawerOpen;
    private ElementReference _drawer;

    /// <summary>«Vis detaljer»: select the scenario and open the drawer on it.</summary>
    private async Task OpenDetails(string id)
    {
        Open(id);
        _drawerOpen = true;
        StateHasChanged();
        try { await Task.Yield(); await _drawer.FocusAsync(); } catch (Exception e) when (e is InvalidOperationException or JSException or TaskCanceledException) { }
    }

    private Task CloseDetailsAsync() { _drawerOpen = false; return Task.CompletedTask; }

    private Task DrawerKey(KeyboardEventArgs e) { if (e.Key == "Escape") _drawerOpen = false; return Task.CompletedTask; }

    private void Open(string id)
    {
        _active = id;
        _missingScenario = null;
        _openRequirement = null;
        _activeTitle = _items.FirstOrDefault(i => i.Id == id)?.Title;
        _ = SaveContextAsync();
    }

    private void ToggleRequirement(string id) => _openRequirement = _openRequirement == id ? null : id;

    /// <summary>«Vis alle scenarioer for FR-…»: every scenario naming it, across all stories.</summary>
    private void FilterRequirement(string id)
    {
        _tab = W.Tabs.Scenarios;
        Set(new S.Filter(Requirement: id, All: true));
    }

    /// <summary>A requirement of the story header: shown in the story's coverage.</summary>
    private void OpenRequirementTab(string id) { _focusRequirement = id; SetTab(W.Tabs.Coverage); }

    /// <summary>The open scenario's requirement relations, computed once per scenario / trace / catalog (never per render).</summary>
    private List<W.RequirementLink> Links(S.Item item, List<PreparedCaseTrace> cases)
    {
        if (_linksMemo is { } m && m.Id == item.Id && m.Items == _items.Count && ReferenceEquals(m.Trace, _trace) && ReferenceEquals(m.Catalog, _ws?.Requirements)) return m.Links;
        var links = W.Requirements(item.Candidate, _ws?.Requirements, cases);
        _linksMemo = (item.Id, _items.Count, _trace, _ws?.Requirements, links);
        return links;
    }

    /// <summary>The source's own Given / When / Then (never BirkNext's composed steps); empty when the source has none.</summary>
    private static List<(string Label, string Text)> SourceGwt(DiscoveredScenario c)
    {
        string? T(string key) => c.Template.FirstOrDefault(t => t.Key == key)?.Value is { Length: > 0 } v ? v : null;
        return [.. new[] { ("Gitt", T("given")), ("Når", T("when")), ("Så", T("then")) }.Where(x => x.Item2 is not null).Select(x => (x.Item1, x.Item2!))];
    }

    private static string CaseTone(PreparedCaseTrace k) => k.Stage switch
    {
        PreparedCaseStage.Approved => "ok", PreparedCaseStage.NeedsClarification => "warn", _ => "info",
    };

    private async Task SaveContextAsync()
    {
        if (_ws?.ProjectKey is not { } key) return;
        await TabDraftStore.WriteAsync(JS, TabDraftStore.DiscoverContextKey(key), new W.WorkContext(_filter.Story, _active, _tab, _activeTitle));
    }

    // ── Scenario grouping (2026-11-26) ─────────────────────────────────────────────────────────────────────────────────────────────────────
    // Filtering decides WHICH scenarios are shown; grouping decides HOW the shown ones are organised (one or two independent axes). A group is a
    // view only: nothing is copied, classified or saved on a scenario. The choice is a personal preference kept in this browser (localStorage).
    private const string GroupingPreferenceKey = "birknext.manualTesting.scenarioGrouping";
    private const int GroupRows = 50;
    private ScenarioGroupAxis _gPrimary = ScenarioGroupAxis.None, _gSecondary = ScenarioGroupAxis.None;
    /// <summary>The Manual Testing language (shared with Planlegg og klargjør; per browser). Norsk shows stored translations only.</summary>
    private EditorLanguage _language = ManualTestingLanguage.Default;

    private async Task SetLanguageAsync(EditorLanguage language) { _language = language; await ManualTestingLanguage.WriteAsync(JS, language); }

    private IReadOnlyList<StoryTranslation> StoryTranslations => _workView?.StoryTranslations ?? [];
    private bool _gChosen, _gLoaded;
    private readonly Dictionary<string, bool> _gOpen = new(StringComparer.Ordinal);
    private readonly Dictionary<string, int> _gLimit = new(StringComparer.Ordinal);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_ws?.ProjectKey is { } loadedKey && loadedKey != _gOpenProject) { await LoadOpenGroupsAsync(); StateHasChanged(); }
        if (_gLoaded) return;
        _gLoaded = true;
        if (await ManualTestingLanguage.ReadAsync(JS) is { } language) _language = language;
        try
        {
            if (ScenarioGrouping.Parse(await JS.InvokeAsync<string?>("localStorage.getItem", GroupingPreferenceKey)) is { } saved)
            {
                (_gPrimary, _gSecondary, _gChosen) = (saved.Primary, saved.Secondary, true);
                StateHasChanged();
                return;
            }
        }
        catch (Exception e) when (e is JSException or InvalidOperationException or TaskCanceledException) { }
        ApplyDefaultGrouping();
        StateHasChanged();
    }

    /// <summary>The default when the tester has not chosen: a selected specification by user story, otherwise test level → scenario type.</summary>
    private void ApplyDefaultGrouping()
    {
        if (_gChosen) return;
        (_gPrimary, _gSecondary) = ScenarioGrouping.Default(SelectedSpecificationPath is not null);
    }

    /// <summary>«Tilbakestill gruppering»: Brukerhistorie → Testnivå, the saved choice removed (so later default changes apply), groups collapsed.</summary>
    private async Task ResetGroupingAsync()
    {
        (_gPrimary, _gSecondary) = ScenarioGrouping.Default();
        _gChosen = false;
        try { await JS.InvokeVoidAsync("localStorage.removeItem", GroupingPreferenceKey); }
        catch (Exception e) when (e is JSException or InvalidOperationException or TaskCanceledException) { }
    }

    private async Task SetGroupingAsync(ScenarioGroupAxis primary, ScenarioGroupAxis secondary)
    {
        if (secondary == primary || primary == ScenarioGroupAxis.None) secondary = ScenarioGroupAxis.None;
        (_gPrimary, _gSecondary, _gChosen) = (primary, secondary, true);
        try { await JS.InvokeVoidAsync("localStorage.setItem", GroupingPreferenceKey, ScenarioGrouping.Format(primary, secondary)); }
        catch (Exception e) when (e is JSException or InvalidOperationException or TaskCanceledException) { }
    }

    /// <summary>
    /// Every group starts COLLAPSED (2026-11-26 blocker fix): a group is open only when the tester opened it. Before, a group opened by itself when
    /// 200 or fewer scenarios were shown, so a small scope came up expanded. The tester's expansion is kept for the project in session storage
    /// (it survives re-renders, the drawer, and going to Planlegg og klargjør and back); group paths include the grouping axis, so a new project or
    /// a new grouping starts collapsed unless that exact context was opened before.
    /// </summary>
    private bool IsOpen(string path, int shownCount) => _gOpen.TryGetValue(path, out var open) && open;

    private Task ToggleGroup(string path, int shownCount) { _gOpen[path] = !IsOpen(path, shownCount); return SaveOpenGroupsAsync(); }

    private Task SetAllGroups(IEnumerable<string> paths, bool open) { foreach (var p in paths) _gOpen[p] = open; return SaveOpenGroupsAsync(); }

    private string? _gOpenProject;

    private static string OpenGroupsKey(string project) => $"birknext.manualTesting.openGroups.{project}";

    private async Task SaveOpenGroupsAsync()
    {
        if (_ws?.ProjectKey is not { } key) return;
        try { await JS.InvokeVoidAsync("sessionStorage.setItem", OpenGroupsKey(key), System.Text.Json.JsonSerializer.Serialize(_gOpen.Where(kv => kv.Value).Select(kv => kv.Key).ToArray())); }
        catch (Exception e) when (e is JSException or InvalidOperationException or TaskCanceledException) { }
    }

    /// <summary>Loads the tester's open groups once per project (another project starts collapsed).</summary>
    private async Task LoadOpenGroupsAsync()
    {
        if (_ws?.ProjectKey is not { } key || key == _gOpenProject) return;
        _gOpenProject = key;
        _gOpen.Clear();
        try
        {
            if (await JS.InvokeAsync<string?>("sessionStorage.getItem", OpenGroupsKey(key)) is { Length: > 0 } json
                && System.Text.Json.JsonSerializer.Deserialize<string[]>(json) is { } open)
                foreach (var p in open) _gOpen[p] = true;
        }
        catch (Exception e) when (e is JSException or InvalidOperationException or TaskCanceledException or System.Text.Json.JsonException) { }
    }

    private async Task ClearGroupAsync(IEnumerable<S.Item> items) { foreach (var i in items) _selected.Remove(i.Id); await KeepAsync(); }

    private RenderFragment GroupingTools(IReadOnlyList<S.Item> shown) => __builder =>
    {
        var shownIds = shown.Select(i => i.Id).ToHashSet(StringComparer.Ordinal);
        var inView = _selected.Count(shownIds.Contains);
        var tree = _gPrimary == ScenarioGroupAxis.None ? [] : ScenarioGrouping.Build(shown, _gPrimary, _gSecondary);
        <div class="mtg-tools" data-testid="mtd-grouping-tools">
            <label class="mtg-field">Grupper etter
                <select class="msb-select" @onchange="e => SetGroupingAsync(Enum.TryParse<ScenarioGroupAxis>(e.Value?.ToString(), out var a) ? a : ScenarioGroupAxis.None, _gSecondary)" data-testid="mtd-list-group">
                    @foreach (var a in ScenarioGroupAxes.Choices) { <option value="@a" selected="@(_gPrimary == a)">@ScenarioGroupAxes.Label(a)</option> }
                </select></label>
            @if (_gPrimary != ScenarioGroupAxis.None)
            {
                <label class="mtg-field">Deretter etter
                    <select class="msb-select" @onchange="e => SetGroupingAsync(_gPrimary, Enum.TryParse<ScenarioGroupAxis>(e.Value?.ToString(), out var a) ? a : ScenarioGroupAxis.None)" data-testid="mtd-list-group2">
                        <option value="@ScenarioGroupAxis.None" selected="@(_gSecondary == ScenarioGroupAxis.None)">Én gruppering</option>
                        @foreach (var a in ScenarioGroupAxes.Choices.Where(a => a != ScenarioGroupAxis.None && a != _gPrimary)) { <option value="@a" selected="@(_gSecondary == a)">@ScenarioGroupAxes.Label(a)</option> }
                    </select></label>
                <button type="button" class="msb-link" @onclick="() => SetAllGroups(ScenarioGrouping.Paths(tree), true)" data-testid="mtd-groups-expand">Vis alle grupper</button>
                <button type="button" class="msb-link" @onclick="() => SetAllGroups(ScenarioGrouping.Paths(tree), false)" data-testid="mtd-groups-collapse">Skjul alle</button>
            }
            @if ((_gPrimary, _gSecondary) != ScenarioGrouping.Default())
            {
                <button type="button" class="msb-link" @onclick="ResetGroupingAsync" data-testid="mtd-groups-reset">Tilbakestill gruppering</button>
            }
            <span class="mtp-seg mtg-lang" role="radiogroup" aria-label="Språk" data-testid="mtd-lang">
                @foreach (var l in new[] { EditorLanguage.Norwegian, EditorLanguage.Original, EditorLanguage.Compare })
                {
                    var lang = l;
                    <button type="button" role="radio" class="mtp-seg-btn @(_language == lang ? "is-on" : null)" aria-checked="@(_language == lang ? "true" : "false")"
                            @onclick="() => SetLanguageAsync(lang)" data-lang="@lang" data-testid="mtd-lang-option">@BirkNext.Web.Services.PlanPreparePresentation.LanguageLabel(lang)</button>
                }
            </span>
            <span class="mtg-plan-summary mt-muted msb-small" data-testid="mtd-plan-summary">@shown.Count scenarioer · @shown.Count(S.InActivePlan) i aktive testplaner</span>
            <span class="mtg-summary mt-muted msb-small" data-testid="mtd-selection-summary">
                @(_selected.Count) valgt totalt · @inView i gjeldende visning@(_selected.Count > inView ? $" · {_selected.Count - inView} utenfor gjeldende filter" : "")
            </span>
        </div>
    };

    private RenderFragment GroupNode(ScenarioGrouping.Group g, int shownCount) => __builder =>
    {
        var open = IsOpen(g.Path, shownCount);
        var selectedHere = g.Items.Count(i => _selected.Contains(i.Id));
        var limit = _gLimit.GetValueOrDefault(g.Path, GroupRows);
        var rows = g.Items.Take(limit).ToList();
        <section class="mtg-group is-depth-@g.Depth" data-testid="mtd-sgroup" data-path="@g.Path" data-axis="@g.Axis" data-depth="@g.Depth" aria-label="@($"{g.Label}: {g.Items.Count} scenarioer")">
            <div class="mtg-head">
                <button type="button" class="mtg-toggle" aria-expanded="@(open ? "true" : "false")" @onclick="() => ToggleGroup(g.Path, shownCount)" data-testid="mtd-sgroup-toggle">
                    <span class="mtg-chevron" aria-hidden="true">@(open ? "▾" : "▸")</span>
                    <span class="mtg-label" data-testid="mtd-sgroup-label">@g.Label</span>
                    <span class="mtg-count" data-testid="mtd-sgroup-count">@g.Items.Count</span>
                    @if (selectedHere > 0) { <span class="mtg-selected" data-testid="mtd-sgroup-selected">@selectedHere valgt</span> }
                    @if (g.Candidates > 0) { <span class="mtg-candidates mt-muted msb-small" data-testid="mtd-sgroup-candidates">@g.Candidates kandidat@(g.Candidates == 1 ? "" : "er") (ikke gjennomgått)</span> }
                    @if (g.Axis == ScenarioGroupAxis.Story && ScenarioGrouping.TypeSummary(g.Items) is { Count: > 0 } typeSummary)
                    {
                        <span class="mtg-type-summary mt-muted msb-small" data-testid="mtd-sgroup-type-summary" title="Oppsummering av akseptansescenarioene i brukerhistorien. Brukerhistorien selv har ingen scenariotype.">
                            Akseptansescenarioer: @string.Join(" · ", typeSummary.Select(x => ScenarioGroupAxes.TypeCount(x.Type, x.Count)))
                        </span>
                    }
                </button>
                <span class="mtg-actions">
                    @if (selectedHere < g.Items.Count) { <button type="button" class="msb-link msb-small" @onclick="() => SelectAll(g.Items)" data-testid="mtd-sgroup-select">Velg alle (@g.Items.Count)</button> }
                    @if (selectedHere > 0) { <button type="button" class="msb-link msb-small" @onclick="() => ClearGroupAsync(g.Items)" data-testid="mtd-sgroup-clear">Fjern valg</button> }
                </span>
            </div>
            @if (open)
            {
                @if (g.Children.Count > 0)
                {
                    <div class="mtg-children">@foreach (var child in g.Children) { @GroupNode(child, shownCount) }</div>
                }
                else
                {
                    <ul class="msb-rows mtg-rows" role="listbox" aria-multiselectable="true" aria-label="@g.Label" tabindex="0" @onkeydown="e => KeyAsync(e, rows)" data-testid="mtd-rows">
                        @foreach (var i in rows) { @Row(i) }
                    </ul>
                    @if (g.Items.Count > limit)
                    {
                        <button type="button" class="btn btn-secondary btn-sm msb-more" @onclick="() => _gLimit[g.Path] = limit + GroupRows" data-testid="mtd-sgroup-more">Vis flere i gruppen (@(g.Items.Count - limit) igjen)</button>
                    }
                }
            }
        </section>
    };

    /// <summary>The drawer's «Testplaner» (2026-11-26): the scenario's saved plan membership from the server (active first, archived on demand),
    /// each with its suite and case, and ONE primary action from the real state (open the case, or prepare one). Nothing is created on open.</summary>
    private RenderFragment DrawerPlans(S.Item i) => __builder =>
    {
        var all = S.Memberships(i);
        var active = all.Where(m => m.Active).ToList();
        var archived = all.Where(m => !m.Active).ToList();
        <section class="mtw-section mtw-plans @(active.Count > 0 ? "is-in-plan" : null)" aria-label="Testplaner" data-testid="mtd-plans">
            <span class="mtp-ctx-label">Testplaner</span>
            @if (i.Work is null)
            {
                <p class="mt-muted msb-small" data-testid="mtd-plans-unknown">Testplankoblingene er ikke hentet ennå.</p>
            }
            else if (active.Count == 0)
            {
                <p class="msb-small" data-testid="mtd-plans-none">Ikke lagt til i en aktiv testplan.</p>
            }
            else
            {
                <ul class="mtw-plan-list">
                    @foreach (var m in active)
                    {
                        <li data-testid="mtd-plans-item" data-plan="@m.PlanId">
                            <a class="mtw-plan-name" href="@($"{M.PlanRoute}?draft={m.PlanId}")" title="@m.PlanName" data-testid="mtd-plans-plan">@m.PlanName</a>
                            <span class="mt-muted msb-small">@(m.SuitePath is { } sp ? $"{sp} · " : "")@m.CaseTitle · @ReviewLabel(m.Review)</span>
                            <a class="msb-small" href="@($"{M.PlanRoute}?draft={m.PlanId}&case={Uri.EscapeDataString(m.CaseId)}")" data-testid="mtd-plans-case">Åpne testtilfelle</a>
                        </li>
                    }
                </ul>
            }
            @if (archived.Count > 0)
            {
                <details class="mtw-why" data-testid="mtd-plans-archived"><summary>Arkiverte testplaner (@archived.DistinctBy(m => m.PlanId).Count())</summary>
                    <ul class="mtw-plan-list">@foreach (var m in archived) { <li><a href="@($"{M.PlanRoute}?draft={m.PlanId}")">@m.PlanName</a> <span class="mt-muted msb-small">@m.CaseTitle</span></li> }</ul>
                </details>
            }
            <div class="mtw-plans-actions">
                @if (active.Count == 1)
                {
                    var only = active[0];
                    <a class="btn btn-primary btn-sm" href="@($"{M.PlanRoute}?draft={only.PlanId}&case={Uri.EscapeDataString(only.CaseId)}")" data-testid="mtd-plans-primary">Åpne testtilfelle</a>
                }
                else if (active.Count > 1)
                {
                    <a class="btn btn-primary btn-sm" href="@($"{M.PlanRoute}?draft={active[0].PlanId}&case={Uri.EscapeDataString(active[0].CaseId)}")" data-testid="mtd-plans-primary">Åpne første testtilfelle</a>
                }
                else
                {
                    <button type="button" class="btn btn-primary btn-sm" @onclick="() => PrepareOnlyAsync(i.Id)" data-testid="mtd-plans-primary">Forbered testtilfelle</button>
                }
            </div>
        </section>
    };

    private static string ReviewLabel(TestCaseReviewState r) => r switch
    {
        TestCaseReviewState.Accepted => "godkjent",
        TestCaseReviewState.Generated => "utkast",
        TestCaseReviewState.NeedsClarification => "trenger avklaring",
        _ => "under arbeid",
    };

    // ── Saved test plan membership on the row (2026-11-26) ───────────────────────────────────────────────────────────────────────────────
    // Only from the server's stored plans. Nothing is shown while the work view is not loaded (never a false «Ikke i testplan»).
    private string? _plansOpenFor;

    /// <summary>The chosen plan for «I/Ikke i valgt testplan»; clearing it also clears those two statuses (they need a plan).</summary>
    private void SetPlanFilter(ChangeEventArgs e)
    {
        var plan = Guid.TryParse(e.Value?.ToString(), out var id) ? id : (Guid?)null;
        Set(_filter with { Plan = plan, PlanStatus = plan is null && _filter.PlanStatus is "inchosen" or "notinchosen" ? null : _filter.PlanStatus });
    }

    private RenderFragment PlanLine(S.Item i) => __builder =>
    {
        if (i.Work is null) return;
        var all = S.Memberships(i);
        var active = all.Where(m => m.Active).DistinctBy(m => m.PlanId).ToList();
        var open = _plansOpenFor == i.Id;
        <span class="mtw-row-plans @(active.Count > 0 ? "is-in-plan" : all.Count > 0 ? "is-archived" : "is-none")" data-testid="mtd-scenario-plans" data-plans="@active.Count">
            @if (active.Count > 0)
            {
                var first = active[0];
                <span class="mtw-plan-icon" aria-hidden="true">▤</span>
                <a class="mtw-plan-name" href="@($"{M.PlanRoute}?draft={first.PlanId}&case={Uri.EscapeDataString(first.CaseId)}")" title="@first.PlanName" @onclick:stopPropagation="true" data-testid="mtd-scenario-plan">@first.PlanName</a>
                <button type="button" class="msb-link mtw-plan-more" aria-expanded="@(open ? "true" : "false")" @onclick:stopPropagation="true" @onclick="() => _plansOpenFor = open ? null : i.Id" data-testid="mtd-scenario-plans-more">
                    @(active.Count > 1 ? $"+{active.Count - 1} plan{(active.Count == 2 ? "" : "er")}" : "Se testplaner")</button>
            }
            else if (all.Count > 0)
            {
                <button type="button" class="msb-link mtw-plan-more" aria-expanded="@(open ? "true" : "false")" @onclick:stopPropagation="true" @onclick="() => _plansOpenFor = open ? null : i.Id" data-testid="mtd-scenario-plans-more">Kun i arkivert testplan</button>
            }
            else
            {
                <span data-testid="mtd-scenario-no-plan">Ikke i testplan</span>
            }
        </span>
        @if (open && all.Count > 0)
        {
            <span class="mtw-plan-pop" role="group" aria-label="Testplaner for scenarioet" @onclick:stopPropagation="true" data-testid="mtd-plan-pop">
                <span class="mtw-plan-pop-h">@(active.Count > 0 ? $"Ligger i {active.Count} aktiv{(active.Count == 1 ? "" : "e")} testplan{(active.Count == 1 ? "" : "er")}" : "Bare i arkiverte testplaner")</span>
                @foreach (var m in all)
                {
                    <span class="mtw-plan-pop-row @(m.Active ? null : "is-archived")" data-testid="mtd-plan-pop-row" data-plan="@m.PlanId" data-active="@(m.Active ? "true" : "false")">
                        <a href="@($"{M.PlanRoute}?draft={m.PlanId}")" data-testid="mtd-plan-pop-plan">@m.PlanName</a>@(m.Active ? "" : " (arkivert)")
                        <span class="mt-muted msb-small">@(m.SuitePath is { } sp ? $"Testgruppe: {sp} · " : "")@m.CaseTitle</span>
                        <a class="msb-small" href="@($"{M.PlanRoute}?draft={m.PlanId}&case={Uri.EscapeDataString(m.CaseId)}")" data-testid="mtd-plan-pop-case">Åpne testtilfelle</a>
                    </span>
                }
            </span>
        }
    };

    /// <summary>One scenario row (the same row in the flat list and inside a group).</summary>
    private RenderFragment Row(S.Item i) => __builder =>
    {
        var selected = _selected.Contains(i.Id);
                        <li id="@($"msb-row-{i.Id}")" role="option" aria-selected="@(selected ? "true" : "false")" class="msb-row mtw-ac-row @(i.Id == _active ? "is-active" : null) @(selected ? "is-selected" : null) @(S.InActivePlan(i) ? "is-in-plan" : null)"
                            data-testid="mtd-scenario" data-id="@i.Id" data-relevance="@i.Relevance" @onclick="() => Open(i.Id)">
                            <input type="checkbox" class="msb-check" checked="@selected" aria-label="@($"Velg {i.Title}")" @onclick:stopPropagation="true"
                                   @onchange="() => ToggleAsync(i.Id)" data-testid="mtd-select" />
                            <span class="msb-row-main">
                                @if (i.Candidate.Story is { } rs && i.Candidate.NumberInStory is not null)
                                {
                                    <span class="mtw-row-label" data-testid="mtd-scenario-label">@W.ScenarioLabel(i)@(_filter.Story is null ? $" · {W.StoryLabel(rs)}" : "")</span>
                                }
                                @{ var rowTitle = ManualTestingLanguage.ScenarioTitle(i, W.RowTitle(i), _language); }<span class="msb-row-title" data-testid="mtd-scenario-title" data-language="@(rowTitle.Translated ? "nb" : "original")" title="@rowTitle.Note">@rowTitle.Text</span>
                                <span class="msb-row-meta">@i.Area@(i.Candidate.Story?.Priority is { } pri ? $" · {pri}" : "")@(i.Relevance switch { S.Relevance.Technical => " · teknisk", S.Relevance.Both => " · manuell + teknisk", _ => i.KindDecided ? " · manuell" : "" })@(i.KindDecided ? " (valgt)" : "")@if (i.Tech is { } techState && TC.ListTag(techState) is { } techTag) { <span class="mtw-tech-tag is-@(techState.ToString().ToLowerInvariant())" data-testid="mtd-scenario-tech"> · @techTag</span> }<span class="msb-approach" title="@string.Join(" ", i.Suitability.Approaches.Select(a => a.Reason))" data-testid="mtd-scenario-approach"> · Foreslått: @string.Join(" · ", i.Suitability.Approaches.Take(2).Select(a => TestDesignAdvisor.ApproachLabel(a.Approach)))</span></span>
                                @if (i.TypeResult is { } rowType && ScenarioTypeClassifier.RowLabel(rowType) is { } typeLabel)
                                {
                                    <span class="mtw-type-tag is-@rowType.Type.ToString().ToLowerInvariant()" data-testid="mtd-scenario-type" data-type="@rowType.Type">@typeLabel</span>
                                }
                                @if (i.Candidate.RequirementIds.Count > 0)
                                {
                                    <span class="mtw-row-reqs" data-testid="mtd-scenario-reqs">@foreach (var r in i.Candidate.RequirementIds.Take(4)) { <span class="mtw-fr">@r</span> }@if (i.Candidate.RequirementIds.Count > 4) { <span class="mtw-fr is-more">+@(i.Candidate.RequirementIds.Count - 4)</span> }</span>
                                }
                                @PlanLine(i)
                            </span>
                            @if (i.Prepared is { Cases: > 0 } prep) { <span class="msb-count" title="Testtilfeller i lagrede planer">@prep.Cases</span> }
                            <span class="msb-status msb-tone-@i.Status.Tone" data-testid="mtd-scenario-status">@i.Status.Text</span>
                            <button type="button" class="btn btn-outline-secondary btn-sm mtw-details-btn" @onclick:stopPropagation="true" @onclick="() => OpenDetails(i.Id)"
                                    aria-controls="mtd-drawer" aria-expanded="@(_drawerOpen && i.Id == _active ? "true" : "false")" data-testid="mtd-show-details">Vis detaljer</button>
                        </li>
    };

    private async Task SelectAll(IEnumerable<S.Item> items) { foreach (var i in items) _selected.Add(i.Id); await KeepAsync(); }

    private async Task ClearSelection() { _selected.Clear(); await KeepAsync(); }

    private async Task KeepAsync()
    {
        if (_ws?.ProjectKey is not { } key) return;
        if (_selected.Count == 0) await TabDraftStore.RemoveAsync(JS, TabDraftStore.SelectionKey(key));
        else await TabDraftStore.WriteAsync(JS, TabDraftStore.SelectionKey(key), _selected.Order(StringComparer.Ordinal).ToArray());
    }

    private async Task PrepareAsync() { await KeepAsync(); Nav.NavigateTo(M.PlanRoute); }

    /// <summary>«Forbered testtilfelle» for ONE scenario (cross-page context hardening, 2026-11-26). The intent travels explicitly in the address —
    /// the scenario's candidate id and, when it is already in an active plan, that plan — instead of through the multi-selection and Planlegg's
    /// remembered plan/case (which opened the PREVIOUS US/AC after a module or specification change). The multi-selection is not touched.</summary>
    private Task PrepareOnlyAsync(string id)
    {
        var item = _items.FirstOrDefault(i => i.Id == id);
        var plan = item is null ? null : S.Memberships(item).FirstOrDefault(m => m.Active)?.PlanId;
        Nav.NavigateTo($"{M.PlanRoute}?scenario={Uri.EscapeDataString(id)}{(plan is { } p ? $"&draft={p}" : "")}");
        return Task.CompletedTask;
    }

    /// <summary>↑/↓ move, Space selects, Home/End jump — the list keeps one active scenario whose details are shown.</summary>
    private async Task KeyAsync(KeyboardEventArgs e, List<S.Item> page)
    {
        if (page.Count == 0) return;
        var index = Math.Max(0, page.FindIndex(i => i.Id == _active));
        switch (e.Key)
        {
            case "ArrowDown": _active = page[Math.Min(page.Count - 1, index + 1)].Id; break;
            case "ArrowUp": _active = page[Math.Max(0, index - 1)].Id; break;
            case "Home": _active = page[0].Id; break;
            case "End": _active = page[^1].Id; break;
            case " ": if (_active is { } a) await ToggleAsync(a); break;
        }
    }

    private static string RelationLabel(ScenarioRelation relation) => relation switch
    {
        ScenarioRelation.Equivalent => "tilsvarende", ScenarioRelation.Conflicting => "motstridende", ScenarioRelation.Variant => "variant", ScenarioRelation.Related => "samme krav", _ => "duplikat",
    };

    private static string EvidenceKind(string kind) => kind switch
    {
        "specification" => "Spesifikasjon", "requirement" => "Krav", "story" => "Brukerhistorie", "guide-scenario" or "guide-step" => "Systemforståelse",
        "source-file" => "Kildefil", "contract-operation" => "API-kontrakt", "journey" => "Integrasjonsflyt", "journey-run" => "Kjøring", "developer-test" => "Utviklertest",
        "source-evidence" => "Kildebevis", _ => kind,
    };

    private static string StateLabel(DiscoveryCapabilityState state) => state switch
    {
        DiscoveryCapabilityState.Available => "Funnet", DiscoveryCapabilityState.NoEvidence => "Ingen bevis", DiscoveryCapabilityState.NotApplicable => "Ikke aktuelt",
        DiscoveryCapabilityState.Failed => "Kunne ikke leses", _ => state.ToString(),
    };

    /// <summary>
    /// The current workspace changed. Only another project resets the page (its selection belongs to that project); the same project — a module or
    /// specification choice being saved, documents loaded — is read again in place, keeping the selection, the open scenario and the filters.
    /// Before (2026-11-24): every change blanked the page and cleared the tester's selection, so choosing a specification looked like a page refresh.
    /// </summary>
    private void OnProjectChanged() => _ = InvokeAsync(async () =>
    {
        var before = _ws?.ProjectKey;
        var key = (await new ManualTestingWorkspace(ServiceProvider).LoadAsync(discovery: false, requirements: false)).ProjectKey;
        if (!string.Equals(before, key, StringComparison.Ordinal)) { _ws = null; _trace = null; _items = []; _selected.Clear(); _active = null; _filter = S.DefaultView; _missingScenario = null; _activeTitle = null; _tab = W.Tabs.Scenarios; (_groupMode, _groupModeChosen) = (G.Mode.Stories, false); _sourceOpenFor = null; }
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() { if (_projection is not null) _projection.Changed -= OnProjectChanged; }
}
