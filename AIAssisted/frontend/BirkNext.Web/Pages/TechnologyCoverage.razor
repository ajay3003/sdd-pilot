@page "/technology-coverage"
@using BirkNext.Applicability
@using BirkNext.Technology
@using BirkNext.Web.Models
@using P = BirkNext.Web.Services.TechnologyCoveragePresentation
@using G = BirkNext.Web.Services.TechnologyCoverageGuidance
@inject ProjectApplicabilityState State
@implements IDisposable

<PageTitle>Technology &amp; Analysis Coverage</PageTitle>

@* What BirkNext can and cannot assess for the active project. Tool coverage is not project quality: an unsupported technology is a
   limitation of BirkNext, shown neutrally, and is never counted as a failure or as 0 in any score. Project findings come first; the
   product-wide support reference is a separate, collapsed section. *@
<div class="sd-workspace tc-page" data-testid="tc-page">
    <h1 class="tc-title">Technology &amp; Analysis Coverage</h1>
    <p class="sd-muted" data-testid="tc-intro">Which technologies this project uses, how much of each BirkNext can analyze, and which reviews apply. A technology BirkNext does not support is a tool limitation — it is shown here, never scored as a project problem.</p>

    @if (!State.Loaded)
    {
        <p class="sd-muted" role="status">Loading…</p>
    }
    else
    {
        @if (State.Profile is null)
        {
            <p class="sd-muted" data-testid="tc-no-target">No Target Environment selected. Source technology comes from the current source snapshot; runtime reviews and configured integrations need a target.</p>
        }
        var coverage = State.Coverage;
        var source = coverage?.Source;
        @foreach (var notice in coverage?.Notices ?? [])
        {
            <p class="sd-reason" role="status" data-testid="tc-notice">@notice</p>
        }
        @if (coverage is null && State.LoadError is { } loadError)
        {
            <p class="sd-reason" role="alert" data-testid="tc-unavailable">@loadError.UserMessage Applicability below uses the target and workspace only.</p>
        }

        <section class="tc-section tc-project" aria-labelledby="tc-project-h" data-testid="tc-project">
            <h2 id="tc-project-h">Project coverage</h2>
            <p class="sd-muted">What was found in this project's source snapshot and which BirkNext reviews apply to it.</p>

            <dl class="sd-summary tc-summary" data-testid="tc-summary">
                <div><dt>Source snapshot</dt><dd class="tc-small" data-testid="tc-snapshot" title="@coverage?.SourceArchive">@(coverage?.SourceArchive ?? "None")</dd></div>
                <div><dt>Files in archive</dt><dd data-testid="tc-total">@(source?.TotalFiles.ToString() ?? "—")</dd></div>
                <div><dt>Files analyzed</dt><dd data-testid="tc-analyzed">@(source?.AnalyzedFiles.ToString() ?? "—")</dd></div>
                <div><dt>Source files not analyzed</dt><dd data-testid="tc-unsupported-files">@(source?.UnsupportedSourceFiles.ToString() ?? "—")</dd></div>
                <div><dt>Technologies detected</dt><dd data-testid="tc-technologies">@(source?.Technologies.Count.ToString() ?? "—")</dd></div>
                <div><dt>Domain extensions</dt><dd class="tc-small" data-testid="tc-extensions">@(coverage?.DomainExtensions is { Count: > 0 } ext ? string.Join(", ", ext) : "None (generic project)")</dd></div>
            </dl>
            @if (coverage?.SourceSnapshotId is { } snapshotId)
            {
                <details class="tc-provenance" data-testid="tc-provenance"><summary>Snapshot provenance</summary>
                    <dl class="tc-facts"><div><dt>Archive</dt><dd>@coverage.SourceArchive</dd></div><div><dt>Snapshot id</dt><dd><code>@snapshotId</code></dd></div>
                        @if (coverage.AnalyzedAt is { } analyzedAt) { <div><dt>Analyzed</dt><dd>@analyzedAt.ToLocalTime().ToString("g")</dd></div> }
                        <div><dt>Environment</dt><dd>@coverage.EnvironmentId</dd></div></dl>
                </details>
            }

            @{ var attention = G.Attention(ReviewCatalog.All.Select(r => State.For(r.ReviewId)), source);
               var actions = ReviewCatalog.All.Where(r => State.For(r.ReviewId)?.Status is ApplicabilityStatus.NeedsConfiguration or ApplicabilityStatus.NeedsRefresh or ApplicabilityStatus.NotEnoughEvidence)
                   .Select(r => G.ReviewAction(r, State.For(r.ReviewId))).OfType<CoverageAction>().DistinctBy(a => a.Href).ToList(); }
            <section class="tc-attention" aria-labelledby="tc-attention-h" data-testid="tc-attention">
                <h3 id="tc-attention-h">What needs attention</h3>
                @if (attention.Count == 0)
                {
                    <p class="sd-muted" data-testid="tc-attention-none">Nothing needs attention: every applicable review has what it needs.</p>
                }
                else
                {
                    <ul class="tc-attention-list">
                        @foreach (var item in attention)
                        {
                            <li data-testid="tc-attention-@item.Key" class="@(item.Neutral ? "tc-neutral" : "")">
                                @item.Text
                                @if (item.Key == "unanalyzed") { <text> · </text><button type="button" class="tc-link" data-testid="tc-attention-unanalyzed-open" @onclick="() => _showUnanalyzed = true">View files not analyzed</button> }
                            </li>
                        }
                    </ul>
                    @if (actions.Count > 0)
                    {
                        <div class="tc-actions" data-testid="tc-attention-actions">@foreach (var action in actions) { <a class="tc-action" href="@action.Href">@action.Label</a> }</div>
                    }
                }
            </section>

            <section aria-labelledby="tc-reviews-h">
                <h3 id="tc-reviews-h">Reviews for this project</h3>
                <p class="sd-muted">Only applicable reviews contribute to quality. Not applicable, unsupported and not-enough-evidence reviews are coverage gaps, not low quality.</p>
                <div class="sd-scroll tc-stack-wrap" tabindex="0" role="region" aria-label="Review applicability">
                    <table class="tc-stack" data-testid="tc-reviews">
                        <thead><tr><th scope="col">Review</th><th scope="col">Status</th><th scope="col">Why</th><th scope="col">Next action</th></tr></thead>
                        <tbody>
                            @foreach (var review in ReviewCatalog.All)
                            {
                                var a = State.For(review.ReviewId);
                                var next = G.ReviewAction(review, a);
                                <tr data-testid="tc-review-@review.ReviewId" data-status="@a?.Status">
                                    <th scope="row"><a href="@review.Route">@review.DisplayName</a><span class="sd-context">@review.Purpose</span></th>
                                    <td data-label="Status">@if (a is not null) { <span class="sd-pill sd-pill-@P.Tone(a.Status)">@ScoreSemantics.Label(a.Status)</span> }</td>
                                    <td data-label="Why">@a?.Reason
                                        @if (review.ReviewId == "source-analysis" && source is not null && G.SourceAnalysisSplit(source) is { } split && (split.Analyzed.Count > 0 || split.DetectionOnly.Count > 0))
                                        {
                                            <dl class="tc-split" data-testid="tc-source-split">
                                                @if (split.Analyzed.Count > 0) { <div><dt>Analyzed</dt><dd>@string.Join(", ", split.Analyzed)</dd></div> }
                                                @if (split.DetectionOnly.Count > 0) { <div><dt>Detection only</dt><dd>@string.Join(", ", split.DetectionOnly)</dd></div> }
                                            </dl>
                                        }
                                    </td>
                                    <td data-label="Next action">
                                        @if (next is not null) { <a class="tc-action" href="@next.Href" data-testid="tc-review-action">@next.Label<span class="visually-hidden"> for @review.DisplayName</span></a> }
                                        else if (!string.IsNullOrWhiteSpace(a?.Action)) { <span class="sd-muted">@a!.Action</span> }
                                        else { <span class="sd-muted">—</span> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <section aria-labelledby="tc-detected-h">
                <h3 id="tc-detected-h">Detected technologies</h3>
                @if (source is null || source.Technologies.Count == 0)
                {
                    <p class="sd-empty" data-testid="tc-no-technologies">@(source is null ? "Analyze the project's source in Source Analysis to see its technologies." : "No technology BirkNext recognises was found in the analyzed archive.")</p>
                }
                else
                {
                    <p class="sd-muted">Only technologies found in this project. Detection is not analysis: <strong>Detection only</strong> means BirkNext recognises the technology but cannot analyze it — a BirkNext limitation, not a project problem.</p>
                    <div class="tc-filters" data-testid="tc-detected-filters">
                        <label>Search technologies <input type="search" @bind="_techSearch" @bind:event="oninput" data-testid="tc-detected-search" /></label>
                        <label>Support <select @bind="_techState" data-testid="tc-detected-state"><option value="">All</option><option value="Supported">Supported</option><option value="Partial">Partial</option><option value="None">Detection only</option></select></label>
                        <label>Category <select @bind="_techArea" data-testid="tc-detected-area"><option value="">All</option>@foreach (var area in source.Technologies.Select(t => t.Area).Distinct().Order()) { <option value="@area">@P.Area(area)</option> }</select></label>
                    </div>
                    var shown = source.Technologies.Where(MatchesDetected).OrderBy(t => t.Area).ToList();
                    <p class="sd-muted" role="status" data-testid="tc-detected-count">Showing @shown.Count of @source.Technologies.Count detected technologies.</p>
                    <div class="sd-scroll tc-stack-wrap" tabindex="0" role="region" aria-label="Detected technologies">
                        <table class="tc-stack" data-testid="tc-detected">
                            <thead><tr><th scope="col">Technology</th><th scope="col">Detected</th><th scope="col">Overall support</th><th scope="col">Main limitation</th><th scope="col">Next action</th></tr></thead>
                            <tbody>
                                @foreach (var t in shown)
                                {
                                    var descriptor = TechnologySupportRegistry.Find(t.TechnologyId);
                                    var overall = descriptor?.Overall ?? SupportLevel.Unsupported;
                                    var action = G.TechnologyAction(t, descriptor);
                                    var open = _openTech.Contains(t.TechnologyId);
                                    <tr data-testid="tc-tech-@t.TechnologyId" data-overall="@descriptor?.Overall">
                                        <th scope="row">
                                            @if (t.TechnologyId == "iac.terraform") { <a href="source-analysis?area=Infrastructure" data-testid="tc-terraform-source-analysis">@t.DisplayName</a> }
                                            else { @t.DisplayName }
                                            <span class="sd-context">@P.Area(t.Area)</span>
                                        </th>
                                        <td data-label="Detected">@P.Confidence(t.Confidence)<span class="sd-context">@t.Files file(s)</span></td>
                                        <td data-label="Overall support"><span class="sd-pill sd-pill-@P.Tone(overall)" data-testid="tc-overall">@G.ProjectSupport(overall)</span></td>
                                        <td data-label="Main limitation" class="tc-limit">@G.MainLimitation(descriptor)</td>
                                        <td data-label="Next action">
                                            @if (action is not null) { <a class="tc-action" href="@action.Href">@action.Label<span class="visually-hidden"> for @t.DisplayName</span></a><br /> }
                                            else { <span class="sd-muted">No BirkNext action</span><br /> }
                                            <button type="button" class="tc-link" aria-expanded="@(open ? "true" : "false")" aria-controls="tc-details-@Id(t.TechnologyId)" data-testid="tc-details-toggle"
                                                    @onclick="() => Toggle(t.TechnologyId)">@(open ? "Hide support details" : "View support details")<span class="visually-hidden"> for @t.DisplayName</span></button>
                                        </td>
                                    </tr>
                                    @if (open)
                                    {
                                        <tr class="tc-details-row" id="tc-details-@Id(t.TechnologyId)" data-testid="tc-details-@t.TechnologyId">
                                            <td colspan="5">
                                                <dl class="tc-dimensions">
                                                    @foreach (var (dimension, level) in descriptor?.Dimensions ?? [])
                                                    {
                                                        <div><dt>@TechnologySupportRegistry.Label(dimension)</dt><dd><span class="sd-pill sd-pill-@P.Tone(level)">@G.CapabilityLabel(level)</span></dd></div>
                                                    }
                                                </dl>
                                                <p class="tc-detail-text"><strong>Limitations:</strong> @(descriptor?.Limitations ?? "Unknown technology.")</p>
                                                <p class="tc-detail-text"><strong>Evidence (file names):</strong> @string.Join(", ", t.Evidence)@(t.Files > t.Evidence.Count ? $" (+{t.Files - t.Evidence.Count} more)" : "")</p>
                                                <p class="tc-detail-text"><strong>Providers:</strong> @(descriptor is { ProviderIds.Count: > 0 } ? string.Join(", ", descriptor.ProviderIds) : "None") · <span class="sd-context">@t.TechnologyId</span></p>
                                                <p class="sd-muted tc-detail-text">Runtime observation is separate from source analysis: a technology declared in source is not a verified runtime resource.</p>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (source.UnsupportedSourceFiles > 0 || G.Unanalyzed(source).Count > 0)
                    {
                        var list = G.Unanalyzed(source);
                        <details class="tc-unanalyzed" id="tc-unanalyzed" data-testid="tc-unanalyzed" open="@_showUnanalyzed">
                            <summary>View files not analyzed (@source.UnsupportedSourceFiles)</summary>
                            <p class="sd-muted">BirkNext detects these languages but has no source analyzer for them. The files are counted, not judged: this is a tool limitation, not a project finding.</p>
                            <div class="sd-scroll tc-stack-wrap" tabindex="0" role="region" aria-label="Source files not analyzed">
                                <table class="tc-stack">
                                    <thead><tr><th scope="col">Files</th><th scope="col">Detected technology</th><th scope="col">Reason</th><th scope="col">Available BirkNext capability</th></tr></thead>
                                    <tbody>
                                        @foreach (var u in list)
                                        {
                                            <tr data-testid="tc-unanalyzed-@u.Technology.TechnologyId">
                                                <td data-label="Files"><ul class="tc-files">@foreach (var file in u.Technology.Evidence) { <li><code>@file</code></li> }</ul>@if (u.Technology.Files > u.Technology.Evidence.Count) { <span class="sd-context">+@(u.Technology.Files - u.Technology.Evidence.Count) more file(s) not listed</span> }</td>
                                                <td data-label="Detected technology">@u.Technology.DisplayName</td>
                                                <td data-label="Reason">Source analysis is not available in BirkNext for @u.Technology.DisplayName.</td>
                                                <td data-label="Available BirkNext capability">@(u.AvailableCapabilities.Count > 0 ? string.Join(", ", u.AvailableCapabilities) : "Detection only")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </details>
                    }
                }
            </section>
        </section>

        <section class="tc-section tc-reference" aria-labelledby="tc-reference-h">
            <h2 id="tc-reference-h">BirkNext support reference</h2>
            <p class="sd-muted">What BirkNext can support in general, for every technology it knows — product capability, not findings about this project.</p>
            <details data-testid="tc-registry">
                <summary>Show full support matrix (@TechnologySupportRegistry.Technologies.Count technologies)</summary>
                <div class="tc-filters" data-testid="tc-reference-filters">
                    <label>Search technologies <input type="search" @bind="_refSearch" @bind:event="oninput" data-testid="tc-reference-search" /></label>
                    <label>Category <select @bind="_refArea" data-testid="tc-reference-area"><option value="">All</option>@foreach (var area in Enum.GetValues<TechnologyArea>()) { <option value="@area">@P.Area(area)</option> }</select></label>
                    <label>Capability <select @bind="_refCapability" data-testid="tc-reference-capability"><option value="">Any (overall)</option>@foreach (var d in Enum.GetValues<SupportDimension>()) { <option value="@d">@TechnologySupportRegistry.Label(d)</option> }</select></label>
                    <label>Support state <select @bind="_refState" data-testid="tc-reference-state"><option value="">All</option><option value="Supported">Supported</option><option value="Partial">Partial</option><option value="None">Detection only / not available</option></select></label>
                </div>
                @{ var filtering = !string.IsNullOrWhiteSpace(_refSearch) || _refArea.Length > 0 || _refCapability.Length > 0 || _refState.Length > 0; }
                @foreach (var area in Enum.GetValues<TechnologyArea>())
                {
                    var rows = TechnologySupportRegistry.Matrix(area).Where(t => G.MatchesReference(t, _refSearch, AreaFilter, CapabilityFilter, _refState)).ToList();
                    if (rows.Count == 0) continue;
                    <details class="tc-category" data-testid="tc-category-@area" open="@filtering" @key="(area, filtering)">
                        <summary>@P.Area(area) <span class="sd-context">@rows.Count technolog@(rows.Count == 1 ? "y" : "ies")</span></summary>
                        <div class="sd-scroll" tabindex="0" role="region" aria-label="@P.Area(area) support">
                            <table class="tc-matrix">
                                <thead><tr><th scope="col">Technology</th>@foreach (var d in Enum.GetValues<SupportDimension>()) { <th scope="col">@TechnologySupportRegistry.Label(d)</th> }<th scope="col">Providers</th></tr></thead>
                                <tbody>
                                    @foreach (var t in rows)
                                    {
                                        <tr data-testid="tc-ref-@t.TechnologyId">
                                            <th scope="row">@t.DisplayName</th>
                                            @foreach (var d in Enum.GetValues<SupportDimension>())
                                            {
                                                var level = t.Level(d);
                                                <td>@(level == SupportLevel.NotApplicable ? "—" : G.CapabilityLabel(level))</td>
                                            }
                                            <td class="tc-limit">@(t.ProviderIds.Count == 0 ? "None" : string.Join(", ", t.ProviderIds))</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </details>
                }
                @if (filtering && !TechnologySupportRegistry.Technologies.Any(t => G.MatchesReference(t, _refSearch, AreaFilter, CapabilityFilter, _refState)))
                {
                    <p class="sd-empty" role="status" data-testid="tc-reference-empty">No technology matches these filters.</p>
                }
            </details>
        </section>
    }
</div>

@code {
    private string _techSearch = "", _techState = "", _techArea = "";
    private string _refSearch = "", _refArea = "", _refCapability = "", _refState = "";
    private bool _showUnanalyzed;
    private readonly HashSet<string> _openTech = new(StringComparer.Ordinal);

    private TechnologyArea? AreaFilter => Enum.TryParse<TechnologyArea>(_refArea, out var a) ? a : null;
    private SupportDimension? CapabilityFilter => Enum.TryParse<SupportDimension>(_refCapability, out var d) ? d : null;

    private bool MatchesDetected(DetectedTechnology t)
    {
        if (_techArea.Length > 0 && t.Area.ToString() != _techArea) return false;
        if (_techSearch.Trim() is { Length: > 0 } term && !t.DisplayName.Contains(term, StringComparison.OrdinalIgnoreCase) && !t.TechnologyId.Contains(term, StringComparison.OrdinalIgnoreCase)) return false;
        return _techState.Length == 0 || G.SupportKey(TechnologySupportRegistry.Find(t.TechnologyId)?.Overall ?? SupportLevel.Unsupported) == _techState;
    }

    private void Toggle(string technologyId) { if (!_openTech.Remove(technologyId)) _openTech.Add(technologyId); }
    private static string Id(string technologyId) => technologyId.Replace('.', '-');

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        await State.RefreshAsync();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= OnChanged;
}
