@page "/sample-projects"
@using BirkNext.Web.Components
@using BirkNext.Web.Models.Library
@using BirkNext.Web.Services

@inject ILibraryPageModelService LibraryPageModelService
@inject IWorkspaceSessionService Workspace

<PageTitle>Sample Projects</PageTitle>

<div class="sample-projects-page">
    <PageHeader Title="Sample Projects"
                Description="Load pre-built sample projects to explore BirkNext features and learn best practices." />

    <!-- ── Readiness Panel ────────────────────────────────────────── -->
    @if (PageModel is not null)
    {
        <LibraryReadinessPanel Model="PageModel" />
    }
    else if (IsLoading)
    {
        <div class="loading-state" role="status">Loading sample projects...</div>
    }
    else if (LoadError is not null)
    {
        <div class="notification notification-error" role="alert">@LoadError</div>
    }

    <!-- ── Project Cards Grid ─────────────────────────────────────── -->
    @if (PageModel?.Items.Count > 0)
    {
        <div class="projects-grid">
            @foreach (var project in PageModel.Items)
            {
                <div class="project-card">
                    <div class="project-card-header">
                        <h2 class="project-name">@project.Name</h2>
                        <span class="project-source-badge">@project.Source</span>
                    </div>

                    <p class="project-description">@project.Description</p>

                    <!-- Included Artifacts -->
                    <div class="project-artifacts">
                        <h3 class="artifacts-title">Included Artifacts</h3>
                        <div class="artifact-badges">
                            @if (!string.IsNullOrEmpty(project.ArtifactKind))
                            {
                                <span class="artifact-badge">
                                    @GetArtifactEmoji(project.ArtifactKind) @project.ArtifactKind
                                </span>
                            }
                            else
                            {
                                <!-- Show multiple artifacts for sample projects -->
                                <span class="artifact-badge">📋 Specification</span>
                                <span class="artifact-badge">📐 Plan</span>
                                <span class="artifact-badge">✅ Tasks</span>
                            }
                        </div>
                    </div>

                    <!-- What You'll Learn -->
                    <div class="project-highlights">
                        <h3 class="highlights-title">What You'll Learn</h3>
                        <ul class="highlights-list">
                            @foreach (var highlight in GetProjectHighlights(project.Name))
                            {
                                <li>@highlight</li>
                            }
                        </ul>
                    </div>

                    <!-- Project Stats -->
                    @if (project.LastUpdated.HasValue)
                    {
                        <div class="project-stats">
                            <div class="stat">
                                <span class="stat-label">Last Updated</span>
                                <span class="stat-value">@project.LastUpdated.Value.ToString("MMM d, yyyy")</span>
                            </div>
                        </div>
                    }

                    <!-- Actions -->
                    <div class="project-actions">
                        @foreach (var action in project.Actions)
                        {
                            <button class="action-btn primary @(action.Enabled ? "" : "is-disabled")"
                                    disabled="@(!action.Enabled)"
                                    title="@(action.Reason ?? action.ExpectedEffect ?? action.Name)">
                                ⬇️ @action.Name
                            </button>
                        }
                        <button class="action-btn secondary">
                            👁️ Preview
                        </button>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state-container">
            <div class="empty-state-icon">📦</div>
            <h2 class="empty-state-title">No sample projects available</h2>
            <p class="empty-state-description">Sample projects will be available soon.</p>
        </div>
    }
</div>

@code {
    private LibraryPageModel? PageModel;
    private bool IsLoading = true;
    private string? LoadError;

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to workspace changes
        Workspace.ReviewContextRebuildNeeded += (s, e) => _ = RefreshPageModel();

        // Load initial model
        await RefreshPageModel();
    }

    private async Task RefreshPageModel()
    {
        try
        {
            IsLoading = true;
            LoadError = null;
            PageModel = await LibraryPageModelService.GetSampleProjectsModelAsync();

            if (PageModel is null)
            {
                LoadError = "Failed to load sample projects";
            }
        }
        catch (Exception ex)
        {
            LoadError = $"Error loading projects: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private string GetArtifactEmoji(string artifactKind) => artifactKind switch
    {
        "Specification" => "📋",
        "Plan" => "📐",
        "Tasks" => "✅",
        "Constitution" => "📜",
        "DataModel" => "🗄️",
        _ => "📦"
    };

    private List<string> GetProjectHighlights(string projectName) => projectName switch
    {
        "E-Commerce Platform" => new()
        {
            "Full end-to-end specification design",
            "Multi-phase delivery planning",
            "Comprehensive test coverage",
            "Risk mitigation strategies"
        },
        "Mobile App MVP" => new()
        {
            "Lean requirements definition",
            "Core feature prioritization",
            "Quick time-to-market planning",
            "Iterative quality approach"
        },
        "Data Pipeline ETL" => new()
        {
            "Technical architecture documentation",
            "Data governance requirements",
            "Compliance and auditing",
            "Performance optimization"
        },
        _ => new()
        {
            "Professional QA practices",
            "Real-world scenario management",
            "Traceability and coverage",
            "Reusable artifact patterns"
        }
    };
}

<style>
.sample-projects-page {
    padding: 0 20px;
}

.loading-state {
    text-align: center;
    color: #6b7280;
    padding: 40px 20px;
}

.projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
    gap: 24px;
    margin: 32px 0;
}

.project-card {
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    background: white;
    overflow: hidden;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
}

.project-card:hover {
    border-color: #3b82f6;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    transform: translateY(-2px);
}

.project-card-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
}

.project-name {
    margin: 0;
    font-size: 20px;
    font-weight: 700;
    color: white;
}

.project-source-badge {
    background: rgba(255, 255, 255, 0.3);
    color: white;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
}

.project-description {
    padding: 16px 20px 0 20px;
    margin: 0;
    color: #6b7280;
    font-size: 14px;
    line-height: 1.6;
}

.project-artifacts {
    padding: 16px 20px;
    border-bottom: 1px solid #f3f4f6;
}

.artifacts-title {
    font-size: 12px;
    font-weight: 600;
    color: #9ca3af;
    text-transform: uppercase;
    margin: 0 0 8px 0;
    letter-spacing: 0.5px;
}

.artifact-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.artifact-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: #f0f9ff;
    color: #0369a1;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
}

.project-highlights {
    padding: 16px 20px;
    border-bottom: 1px solid #f3f4f6;
    flex-grow: 1;
}

.highlights-title {
    font-size: 12px;
    font-weight: 600;
    color: #9ca3af;
    text-transform: uppercase;
    margin: 0 0 8px 0;
    letter-spacing: 0.5px;
}

.highlights-list {
    list-style: none;
    padding: 0;
    margin: 0;
}

.highlights-list li {
    padding: 4px 0;
    color: #374151;
    font-size: 13px;
}

.highlights-list li:before {
    content: "✓ ";
    color: #10b981;
    font-weight: 600;
    margin-right: 6px;
}

.project-stats {
    padding: 12px 20px;
    background: #f9fafb;
    display: flex;
    gap: 16px;
    border-bottom: 1px solid #f3f4f6;
    font-size: 12px;
}

.stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.stat-label {
    color: #9ca3af;
    font-weight: 500;
}

.stat-value {
    color: #374151;
    font-weight: 600;
}

.project-actions {
    padding: 16px 20px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.action-btn {
    flex: 1;
    min-width: 120px;
    padding: 10px 14px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: all 0.2s ease;
}

.action-btn.primary {
    background: #3b82f6;
    color: white;
}

.action-btn.primary:hover:not(.is-disabled) {
    background: #2563eb;
}

.action-btn.secondary {
    background: #f3f4f6;
    color: #374151;
    border: 1px solid #d1d5db;
}

.action-btn.secondary:hover {
    background: #e5e7eb;
}

.action-btn.is-disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.empty-state-container {
    text-align: center;
    padding: 80px 20px;
}

.empty-state-icon {
    font-size: 64px;
    margin-bottom: 16px;
}

.empty-state-title {
    font-size: 24px;
    font-weight: 600;
    color: #111827;
    margin-bottom: 8px;
}

.empty-state-description {
    font-size: 16px;
    color: #6b7280;
}
</style>
