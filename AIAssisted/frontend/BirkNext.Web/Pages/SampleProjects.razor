@page "/sample-projects"
@using System.Runtime.CompilerServices
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using BirkNext.Web.Services.SampleProjects
@using Microsoft.JSInterop
@inject SampleProjectsApiService ProjectsApi
@inject ISampleProjectArtifactDiscovery DocumentDiscovery
@inject IWorkspaceSessionService Workspace
@inject IWorkspaceArtifactStatusService ArtifactStatus
@inject IWorkspaceAutoSaveService AutoSave
@inject IWorkspaceUpdateCoordinator Updates
@inject QualityReviewSessionService QualitySession
@inject IDashboardSnapshotService DashboardSnapshot
@inject ITargetEnvironmentHintExtractor TargetHintExtractor
@inject IFrontendAnalysisSettingsService FrontendSettings
@inject IIntegrationTargetRegistryService IntegrationRegistry
@inject ILogger<SampleProjects> Logger
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="sp-page">
    <div class="sp-page-header">
        <h1 class="sp-page-title">Sample Projects</h1>
        <p class="sp-page-desc">Ready-made example projects. BirkNext scans each folder recursively and detects supported artifacts (constitution, specification, data model, plan, tasks, research) by their content — any filename or folder structure works, and every role is optional. For your own project, use <a href="project-import" data-testid="sp-import-project-link">Import Project</a>: one ZIP provides both the documents and the source.</p>
    </div>

    @if (string.IsNullOrWhiteSpace(Workspace.CurrentProject)
         && Workspace.SddLifecycle.CurrentProjectImportId is { } importId
         && Workspace.SddLifecycle.ProjectImports.FirstOrDefault(i => i.ImportId == importId) is { } imported)
    {
        @* An imported project is the current project. Its artifacts come from the imported archive, not from this catalog. *@
        <div class="sp-workspace-banner" role="status" data-testid="sp-imported-project">
            Current project: <strong>@imported.ProjectName</strong> — artifact source: imported project archive <code>@imported.ArchiveFileName</code>.
            Selecting a Sample Project below makes it the current project instead; the import stays available as history.
            <a href="project-import" data-testid="sp-open-import">Open Import Project</a>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Workspace.CurrentProject))
    {
        var selectedProject = _projects.FirstOrDefault(p => string.Equals(p.Slug, Workspace.CurrentProject, StringComparison.Ordinal));
        if (selectedProject is not null)
        {
            <div class="sp-workspace-banner" role="status" aria-live="polite" data-testid="sp-selected-project">
                Selected Sample Project: <strong>@selectedProject.Name</strong>
            </div>
        }
        else if (!_loading)
        {
            @* The persisted selection points to a project that is no longer in the catalog. Say so explicitly;
               never substitute another project. The user chooses a replacement or clears the selection. *@
            <div class="sp-workspace-banner sp-workspace-banner-stale" role="alert" data-testid="sp-selection-unavailable">
                Previously selected Sample Project <strong>@Workspace.CurrentProject</strong> is unavailable (not found in the catalog).
                Select a Sample Project below or clear the selection.
                <button type="button" class="sp-btn sp-btn-secondary" @onclick="ClearSelectionAsync" disabled="@_clearingSelection" data-testid="sp-clear-selection">Clear selection</button>
            </div>
        }
    }
    @if (_selectionError is not null)
    {
        <div class="sp-workspace-banner sp-workspace-banner-stale" role="alert" data-testid="sp-selection-error">@_selectionError</div>
    }

    @if (_loading)
    {
        <div class="sp-loading">
            <div class="sp-spinner" aria-label="Loading…"></div>
            <span>Discovering sample projects…</span>
        </div>
    }
    else if (_projects.Count == 0)
    {
        @* Sample Projects are optional demo content: an instance without them is not misconfigured. The configuration key is a technical detail. *@
        <section class="sp-empty" aria-labelledby="sp-empty-title" data-testid="sp-empty">
            <div class="sp-empty-icon" aria-hidden="true">📂</div>
            <h2 class="sp-empty-title" id="sp-empty-title">No sample projects are configured</h2>
            <p class="sp-empty-hint">Sample Projects are optional examples. For your own project, use Import Project: one ZIP provides the project documents and the source.</p>
            <a class="sp-btn sp-btn-primary sp-empty-action" href="project-import" data-testid="sp-empty-import">Import Project</a>
            <details class="sp-empty-details" data-testid="sp-empty-details">
                <summary>Technical details for administrators</summary>
                @if (_meta?.Source == "config")
                {
                    <p>The configured sample-project folder was not found. Check <code>SampleProjects:BaseDirectory</code> in <code>appsettings.Local.json</code>.</p>
                }
                else
                {
                    <p>No sample-project folder is configured. To offer examples, set <code>SampleProjects:BaseDirectory</code> in the application configuration.</p>
                }
            </details>
        </section>
    }
    else
    {
        @if (_meta is not null)
        {
            <div class="sp-meta-bar">
                <span class="sp-meta-label">Configured sample projects</span>
                <code class="sp-meta-path">@_meta.ResolvedPath</code>
            </div>
        }
        <div class="sp-project-list">
            @foreach (var project in _projects)
            {
                var discovery = _discovery.GetValueOrDefault(project.Slug);
                var loadState = GetLoadResult(project);
                var readmeOpen = _readmeOpen.Contains(project.Slug);
                var allOpen    = _allFilesOpen.Contains(project.Slug);
                var headingId  = $"sp-name-{project.Slug}";

                <article class="sp-card @(IsCurrentWorkspace(project) ? "sp-card-selected" : "")" aria-labelledby="@headingId" data-testid="sp-card" data-slug="@project.Slug">
                    @* ── Card header ──────────────────────────────────────── *@
                    <div class="sp-card-header">
                        <div class="sp-card-title-row">
                            <span class="sp-card-icon" aria-hidden="true">📁</span>
                            <h2 class="sp-card-name" id="@headingId">@project.Name</h2>
                            @if (IsCurrentWorkspace(project))
                            {
                                <span class="sp-card-selected-badge">✓ Selected</span>
                            }
                            @if (!string.IsNullOrEmpty(project.Domain))
                            {
                                <span class="sp-domain-tag">@project.Domain</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(project.Description))
                        {
                            <p class="sp-card-desc">@project.Description</p>
                        }
                        @if (discovery is not null)
                        {
                            <p class="sp-card-summary" data-testid="sp-artifact-summary">@CoverageSummary(discovery)</p>
                        }
                    </div>

                    @if (discovery is null)
                    {
                        <div class="sp-section sp-discovering" role="status">
                            <span class="sp-btn-spinner" aria-hidden="true"></span> Discovering documents…
                        </div>
                    }
                    else
                    {
                        @* ── Artifact coverage. Roles are optional: nothing here is a project failure. ── *@
                        <section class="sp-section" aria-labelledby="sp-cov-@project.Slug" data-testid="sp-coverage">
                            <h3 class="sp-section-label" id="sp-cov-@project.Slug">Artifact coverage</h3>
                            @if (discovery.DetectedCount == 0)
                            {
                                <p class="sp-coverage-empty" data-testid="sp-no-artifacts">No supported document artifacts detected.@(discovery.Documents.Count > 0 ? " The documents found are listed below." : "")</p>
                            }
                            <ul class="sp-coverage">
                                @foreach (var role in discovery.Roles)
                                {
                                    var explorer = ExplorerFor(role.Role);
                                    <li class="sp-role" data-testid="sp-role" data-role="@role.Role" data-state="@role.State">
                                        <div class="sp-role-row">
                                            <span class="sp-role-name">@SampleArtifactClassifier.Label(role.Role)</span>
                                            <span class="sp-role-count" aria-label="@($"{role.Documents.Count} document{(role.Documents.Count == 1 ? "" : "s")}")">@(role.Documents.Count == 0 ? "—" : role.Documents.Count.ToString())</span>
                                            <span class="sp-role-state sp-state-@RoleStateClass(role)" data-testid="sp-role-state"><span aria-hidden="true">@RoleStateIcon(role)</span> @RoleStateText(role)</span>
                                            @if (role.Documents.Count > 0 && explorer is not null)
                                            {
                                                <a class="sp-reviewer-link"
                                                   href="@explorer.Value.Route"
                                                   aria-disabled="@IsProjectLoading(project)"
                                                   @onclick:preventDefault="true"
                                                   @onclick="() => OpenReviewerAsync(project, explorer.Value.Route)">
                                                    @explorer.Value.Name
                                                </a>
                                            }
                                            else if (role.Documents.Count > 0)
                                            {
                                                <span class="sp-role-note">No dedicated explorer — available as context</span>
                                            }
                                        </div>
                                        @if (role.Documents.Count > 0)
                                        {
                                            <ul class="sp-role-docs">
                                                @foreach (var doc in role.Documents)
                                                {
                                                    var isChosen = role.Documents.Count > 1 && ReferenceEquals(role.Primary, doc);
                                                    <li class="sp-doc" data-testid="sp-role-doc">
                                                        <code class="sp-path">@doc.RelativePath</code>
                                                        <span class="sp-confidence">@doc.Confidence</span>
                                                        @if (isChosen)
                                                        {
                                                            <span class="sp-doc-chosen">Opened by explorers</span>
                                                        }
                                                        @if (doc.DuplicateOf is not null)
                                                        {
                                                            <span class="sp-doc-note">Same content as <code>@doc.DuplicateOf</code></span>
                                                        }
                                                        <details class="sp-why">
                                                            <summary>Why detected?</summary>
                                                            <ul>
                                                                @foreach (var reason in doc.Reasons)
                                                                {
                                                                    <li>@reason</li>
                                                                }
                                                            </ul>
                                                        </details>
                                                    </li>
                                                }
                                            </ul>
                                            @if (role.State == SampleRoleState.Multiple && explorer is not null)
                                            {
                                                <label class="sp-choose">
                                                    <span>Document the @explorer.Value.Name opens</span>
                                                    <select value="@(role.ChosenPath ?? "")" data-testid="sp-choose-document"
                                                            @onchange="e => ChooseDocument(project, role.Role, e.Value?.ToString())">
                                                        <option value="">Choose a document…</option>
                                                        @foreach (var doc in role.Documents)
                                                        {
                                                            <option value="@doc.RelativePath">@doc.RelativePath</option>
                                                        }
                                                    </select>
                                                </label>
                                            }
                                        }
                                    </li>
                                }
                            </ul>
                        </section>

                        @if (discovery.NeedsReview.Count > 0)
                        {
                            <section class="sp-section" aria-labelledby="sp-review-@project.Slug" data-testid="sp-needs-review">
                                <h3 class="sp-section-label sp-section-review" id="sp-review-@project.Slug"><span aria-hidden="true">◐</span> Needs review (@discovery.NeedsReview.Count)</h3>
                                <p class="sp-section-note">Explorers do not open these until the role is clear. Front matter such as <code>type: plan</code> declares a role explicitly.</p>
                                <ul class="sp-doc-list">
                                    @foreach (var doc in discovery.NeedsReview)
                                    {
                                        <li class="sp-doc">
                                            <code class="sp-path">@doc.RelativePath</code>
                                            <span class="sp-doc-note">@string.Join(" ", doc.Reasons)</span>
                                            @if (doc.Candidates.Count > 0)
                                            {
                                                <details class="sp-why">
                                                    <summary>Candidate roles</summary>
                                                    <ul>
                                                        @foreach (var candidate in doc.Candidates)
                                                        {
                                                            <li><strong>@SampleArtifactClassifier.Label(candidate.Role)</strong> (@candidate.Confidence): @string.Join("; ", candidate.Reasons)</li>
                                                        }
                                                    </ul>
                                                </details>
                                            }
                                        </li>
                                    }
                                </ul>
                            </section>
                        }

                        @if (discovery.ParseErrors.Count > 0 || discovery.Error is not null)
                        {
                            <section class="sp-section" aria-labelledby="sp-err-@project.Slug" data-testid="sp-read-errors">
                                <h3 class="sp-section-label sp-section-error" id="sp-err-@project.Slug"><span aria-hidden="true">✕</span> Could not be read (@discovery.ParseErrors.Count)</h3>
                                @if (discovery.Error is not null)
                                {
                                    <p class="sp-section-note">@discovery.Error</p>
                                }
                                <ul class="sp-doc-list">
                                    @foreach (var doc in discovery.ParseErrors)
                                    {
                                        <li class="sp-doc"><code class="sp-path">@doc.RelativePath</code> <span class="sp-doc-note">@string.Join(" ", doc.Reasons)</span></li>
                                    }
                                </ul>
                            </section>
                        }

                        @if (discovery.Unclassified.Count > 0)
                        {
                            <details class="sp-section sp-other" data-testid="sp-other-documents">
                                <summary class="sp-section-label">Other documents (@discovery.Unclassified.Count)</summary>
                                <ul class="sp-doc-list">
                                    @foreach (var doc in discovery.Unclassified)
                                    {
                                        <li class="sp-doc"><code class="sp-path">@doc.RelativePath</code> <span class="sp-doc-note">@string.Join(" ", doc.Reasons)</span></li>
                                    }
                                </ul>
                            </details>
                        }

                        <details class="sp-section sp-discovery-details" data-testid="sp-discovery-details">
                            <summary class="sp-section-label">Discovery details</summary>
                            <dl class="sp-stats">
                                <dt>Files scanned</dt><dd>@(discovery.Stats?.FilesScanned.ToString() ?? "—")</dd>
                                <dt>Markdown documents</dt><dd>@discovery.Documents.Count</dd>
                                <dt>Supported artifacts</dt><dd>@discovery.DetectedCount</dd>
                                <dt>Needs review</dt><dd>@discovery.NeedsReview.Count</dd>
                                <dt>Other documents</dt><dd>@discovery.Unclassified.Count</dd>
                                <dt>Other file types</dt><dd>@discovery.UnsupportedFiles.Count</dd>
                                <dt>Skipped documents</dt><dd>@SkippedText(discovery)</dd>
                                <dt>Ignored folders</dt><dd>@(discovery.Stats is { IgnoredDirectories.Count: > 0 } ignored ? string.Join(", ", ignored.IgnoredDirectories) : "None")</dd>
                                @if (discovery.Stats is { SkippedLinks: > 0 } links)
                                {
                                    <dt>Links not followed</dt><dd>@links.SkippedLinks</dd>
                                }
                                @if (discovery.Stats?.Truncated == true)
                                {
                                    <dt>Limits</dt><dd>Scan limits were reached; some files are not listed.</dd>
                                }
                            </dl>
                        </details>
                    }

                    @* ── Load result ──────────────────────────────────────── *@
                    @if (loadState is not null)
                    {
                        <div class="sp-load-result @(loadState.HasError ? "is-error" : "is-ok")">
                            @loadState.Message
                        </div>
                        @if (!loadState.HasError)
                        {
                            <div class="sp-confirm-panel" role="status" aria-label="Loaded workspace confirmation">
                                <div class="sp-confirm-title">Loaded workspace: @loadState.ProjectName</div>
                                <div class="sp-confirm-grid">
                                    <div class="sp-confirm-column">
                                        <div class="sp-confirm-label">Artifacts available to explorers</div>
                                        @foreach (var file in loadState.LoadedArtifacts)
                                        {
                                            <div class="sp-confirm-row"><span class="sp-confirm-ok" aria-hidden="true">✓</span><span>@file</span></div>
                                        }
                                    </div>
                                    <div class="sp-confirm-column">
                                        <div class="sp-confirm-label">Other documents</div>
                                        @if (loadState.ContextOnlyFiles.Count == 0)
                                        {
                                            <div class="sp-confirm-muted">None</div>
                                        }
                                        else
                                        {
                                            @foreach (var file in loadState.ContextOnlyFiles)
                                            {
                                                <div class="sp-confirm-row"><span class="sp-confirm-context" aria-hidden="true">○</span><span>@file</span></div>
                                            }
                                        }
                                    </div>
                                </div>
                                <div class="sp-confirm-actions" aria-label="Next actions">
                                    @foreach (var action in NextActions)
                                    {
                                        @if (IsReviewerRoute(action.Href))
                                        {
                                            <a class="sp-confirm-link"
                                               href="@action.Href"
                                               aria-disabled="@IsProjectLoading(project)"
                                               @onclick:preventDefault="true"
                                               @onclick="() => OpenReviewerAsync(project, action.Href)">
                                                @action.Label
                                            </a>
                                        }
                                        else
                                        {
                                            <a class="sp-confirm-link" href="@action.Href">@action.Label</a>
                                        }
                                    }
                                </div>
                            </div>
                        }
                        @if (_hintState.TryGetValue(project.Slug, out var hints) && !_ignoredHints.Contains(project.Slug))
                        {
                            <div class="sp-hints-panel" aria-label="Detected Target Environment Hints">
                                <div class="sp-hints-header">
                                    <div>
                                        <div class="sp-hints-title">Detected Target Environment Hints</div>
                                        <p class="sp-hints-note">Review and edit deterministic detections before applying them to the active Target Environment.</p>
                                    </div>
                                    <button class="sp-btn sp-btn-secondary" @onclick="() => IgnoreHints(project.Slug)">Ignore</button>
                                </div>

                                @if (!hints.HasAny)
                                {
                                    <div class="sp-hints-empty">No runtime target hints were found in the loaded sample artifacts.</div>
                                }
                                else
                                {
                                    <div class="sp-hints-grid">
                                        <label class="sp-hint-field">
                                            <span>Environment</span>
                                            <select value="@(hints.EnvironmentType?.ToString() ?? "")" @onchange="e => SetEnvironmentHint(hints, e)">
                                                <option value="">Not detected</option>
                                                @foreach (var env in Enum.GetValues<FrontendEnvironmentType>())
                                                {
                                                    <option value="@env">@env</option>
                                                }
                                            </select>
                                        </label>
                                        <label class="sp-hint-field">
                                            <span>Frontend URL</span>
                                            <input value="@hints.FrontendUrl" @oninput="e => hints.FrontendUrl = e.Value?.ToString()" />
                                        </label>
                                        <label class="sp-hint-field">
                                            <span>REST Base URL</span>
                                            <input value="@hints.RestBaseUrl" @oninput="e => hints.RestBaseUrl = e.Value?.ToString()" />
                                        </label>
                                        <label class="sp-hint-field">
                                            <span>Health Endpoint</span>
                                            <input value="@hints.HealthEndpoint" @oninput="e => hints.HealthEndpoint = e.Value?.ToString()" />
                                        </label>
                                        <label class="sp-hint-field">
                                            <span>Swagger / OpenAPI URL</span>
                                            <input value="@hints.SwaggerUrl" @oninput="e => hints.SwaggerUrl = e.Value?.ToString()" />
                                        </label>
                                        <label class="sp-hint-field">
                                            <span>GraphQL Endpoint</span>
                                            <input value="@hints.GraphQlEndpoint" @oninput="e => hints.GraphQlEndpoint = e.Value?.ToString()" />
                                        </label>
                                        <label class="sp-hint-field">
                                            <span>API Authentication</span>
                                            <select @bind="hints.AuthType">
                                                @foreach (var auth in Enum.GetValues<TargetApiAuthType>())
                                                {
                                                    <option value="@auth">@auth</option>
                                                }
                                            </select>
                                        </label>
                                    </div>

                                    @if (hints.Integrations.Count > 0)
                                    {
                                        <div class="sp-integration-hints">
                                            <div class="sp-hints-subtitle">Integration registry entries</div>
                                            @foreach (var integration in hints.Integrations)
                                            {
                                                <div class="sp-integration-card" @key="integration.Id">
                                                    <div class="sp-integration-row">
                                                        <label class="sp-hint-field">
                                                            <span>Name</span>
                                                            <input @bind="integration.Name" />
                                                        </label>
                                                        <label class="sp-hint-field">
                                                            <span>Provider</span>
                                                            <select @bind="integration.ProviderType">
                                                                @foreach (var provider in IntegrationProviders)
                                                                {
                                                                    <option value="@provider">@provider</option>
                                                                }
                                                            </select>
                                                        </label>
                                                        <label class="sp-hint-field">
                                                            <span>Endpoint</span>
                                                            <input @bind="integration.Endpoint" />
                                                        </label>
                                                        <label class="sp-hint-field">
                                                            <span>Namespace</span>
                                                            <input @bind="integration.Namespace" />
                                                        </label>
                                                        <label class="sp-hint-field">
                                                            <span>Topic</span>
                                                            <input @bind="integration.Topic" />
                                                        </label>
                                                        <label class="sp-hint-field">
                                                            <span>Queue</span>
                                                            <input @bind="integration.Queue" />
                                                        </label>
                                                        <label class="sp-hint-field">
                                                            <span>Consumer Group</span>
                                                            <input @bind="integration.ConsumerGroup" />
                                                        </label>
                                                        <label class="sp-hint-field">
                                                            <span>Subscription</span>
                                                            <input @bind="integration.Subscription" />
                                                        </label>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }

                                    @if (hints.Evidence.Count > 0)
                                    {
                                        <div class="sp-hint-evidence">
                                            <span>Evidence</span>
                                            @foreach (var evidence in hints.Evidence)
                                            {
                                                <code>@evidence</code>
                                            }
                                        </div>
                                    }

                                    <div class="sp-hints-actions">
                                        <button class="sp-btn sp-btn-primary" @onclick="() => ApplyHintsAsync(hints)">Apply to active Target Environment</button>
                                        <a class="sp-btn sp-btn-secondary" href="admin/system-settings">Review Target Environments</a>
                                    </div>
                                }

                                @if (_hintApplyMessages.TryGetValue(project.Slug, out var applyMessage))
                                {
                                    <div class="sp-hints-message" role="status">@applyMessage</div>
                                }
                            </div>
                        }
                    }

                    @* ── README viewer ────────────────────────────────────── *@
                    @if (readmeOpen && _readmeContent.TryGetValue(project.Slug, out var readme))
                    {
                        <div class="sp-readme-box">
                            <div class="sp-readme-header">
                                <span>README.md</span>
                                <button class="sp-readme-close" @onclick="() => CloseReadme(project.Slug)">×</button>
                            </div>
                            <pre class="sp-readme-content">@readme</pre>
                        </div>
                    }

                    @* ── All files viewer ─────────────────────────────────── *@
                    @if (allOpen)
                    {
                        var filter = _fileFilter.GetValueOrDefault(project.Slug, "all");
                        var rows = AllFileRows(project, discovery, filter);
                        <div class="sp-all-files-box" data-testid="sp-all-files">
                            <div class="sp-all-files-header">
                                <span>All Files</span>
                                <select class="sp-file-filter" value="@filter" aria-label="Show files"
                                        @onchange="e => SetFileFilter(project.Slug, e)">
                                    <option value="all">All</option>
                                    <option value="artifacts">Artifacts</option>
                                    <option value="review">Needs review</option>
                                    <option value="other">Other documents</option>
                                    <option value="unsupported">Other file types</option>
                                </select>
                                <button class="sp-readme-close" aria-label="Close file list" @onclick="() => CloseAllFiles(project.Slug)">×</button>
                            </div>
                            <div class="sp-table-wrap">
                                <table class="sp-files-table">
                                    <thead>
                                        <tr><th scope="col">Path</th><th scope="col">Type</th><th scope="col">Detected role</th><th scope="col">Confidence</th><th scope="col">Explorers</th><th scope="col">Reason</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in rows)
                                        {
                                            <tr data-testid="sp-file-row">
                                                <th scope="row"><code class="sp-path">@row.Path</code></th>
                                                <td>@row.Type</td>
                                                <td>@row.Role</td>
                                                <td>@row.Confidence</td>
                                                <td>@row.Used</td>
                                                <td class="sp-file-reason">@row.Reason</td>
                                            </tr>
                                        }
                                        @if (rows.Count == 0)
                                        {
                                            <tr><td colspan="6" class="sp-confirm-muted">No files in this view.</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }

                    @* ── Card actions ─────────────────────────────────────── *@
                    <div class="sp-card-actions">
                        @{
                            var isSelectedProject = IsCurrentWorkspace(project);
                            var isLoading = _loadingSlug == project.Slug;
                            var isDisabled = isSelectedProject || isLoading;
                        }
                        <button class="sp-btn sp-btn-primary"
                                disabled="@isDisabled"
                                @onclick="() => SelectProject(project)"
                                aria-current="@(isSelectedProject ? "true" : "false")">
                            @if (isLoading)
                            { <span class="sp-btn-spinner" aria-hidden="true"></span> }
                            @if (isSelectedProject)
                            { <span aria-hidden="true">✓</span> <span>Selected</span> }
                            else
                            { <span>Select Project</span> }
                        </button>
                        <button class="sp-btn sp-btn-secondary" @onclick="() => ToggleAllFiles(project.Slug)">
                            @(allOpen ? "Hide Files" : "View All Files")
                        </button>
                        @if (project.HasReadme)
                        {
                            <button class="sp-btn sp-btn-secondary" @onclick="() => ToggleReadme(project)">
                                @(readmeOpen ? "Close README" : "README")
                            </button>
                        }
                        <button class="sp-btn sp-btn-icon" title="Copy folder path" aria-label="Copy folder path"
                                @onclick="() => CopyPath(project.AbsolutePath)">
                            <span aria-hidden="true">📋</span>
                        </button>
                    </div>
                </article>
            }
        </div>
    }
</div>

@code {
    private List<SampleProjectDto> _projects = [];
    private SampleProjectsMetaDto? _meta;
    private bool _loading = true;
    private string? _loadingSlug;
    private Dictionary<string, LoadResult> _loadState = [];
    private Dictionary<string, DetectedTargetEnvironmentHints> _hintState = [];
    private Dictionary<string, string> _hintApplyMessages = [];
    private HashSet<string> _ignoredHints = [];
    private HashSet<string> _readmeOpen = [];
    private HashSet<string> _allFilesOpen = [];
    private Dictionary<string, string> _readmeContent = [];
    private Dictionary<string, SampleProjectDiscoveryResult> _discovery = [];
    private Dictionary<string, string> _fileFilter = [];
    private string? _selectionError;
    private bool _clearingSelection;

    private static readonly IReadOnlyList<string> IntegrationProviders =
    [
        "REST",
        "GraphQL",
        "Event Hub",
        "Service Bus",
        "Kafka",
        "RabbitMQ"
    ];

    private int LoadedWorkspaceArtifactCount =>
        ArtifactStatus.GetStatus().ArtifactCount;

    private LoadResult? GetLoadResult(SampleProjectDto project)
    {
        if (_loadState.TryGetValue(project.Slug, out var localState) && localState.HasError)
            return localState;

        if (!IsCurrentWorkspace(project) || LoadedWorkspaceArtifactCount == 0)
            return null;

        var loadedArtifacts = GetWorkspaceLoadedArtifactNames().ToList();
        var contextOnly = project.Files
            .Where(f => f.IsContextOnly && f.Exists)
            .Select(f => f.Filename)
            .ToList();

        var message = $"Loaded {loadedArtifacts.Count} artifact{(loadedArtifacts.Count == 1 ? "" : "s")}.";
        return new LoadResult(project.Name, message, false, loadedArtifacts, contextOnly);
    }

    private bool IsCurrentWorkspace(SampleProjectDto project) =>
        string.Equals(Workspace.CurrentProject, project.Slug, StringComparison.Ordinal);

    private IEnumerable<string> GetWorkspaceLoadedArtifactNames()
    {
        foreach (var kind in new[]
        {
            WorkspaceArtifactKind.Constitution,
            WorkspaceArtifactKind.Specification,
            WorkspaceArtifactKind.DataModel,
            WorkspaceArtifactKind.Plan,
            WorkspaceArtifactKind.Tasks
        })
        {
            if (Workspace.Get(kind) is { } artifact)
                yield return artifact.FileName ?? DefaultArtifactFileName(kind);
        }
    }

    private static string DefaultArtifactFileName(WorkspaceArtifactKind kind) => kind switch
    {
        WorkspaceArtifactKind.Constitution => "constitution.md",
        WorkspaceArtifactKind.Specification => "spec.md",
        WorkspaceArtifactKind.DataModel => "data-model.md",
        WorkspaceArtifactKind.Plan => "plan.md",
        WorkspaceArtifactKind.Tasks => "tasks.md",
        _ => kind.ToString()
    };

    private static readonly IReadOnlyList<NextActionLink> NextActions =
    [
        new("Open Specification Explorer", "specification-explorer"),
        new("Open Data Model Explorer", "data-model-explorer"),
        new("Open Plan Explorer", "plan-explorer"),
        new("Open Task Explorer", "task-explorer"),
        new("Open Document Quality Review", "quality/document"),
        new("Open Dashboard", "dashboard"),
    ];

    private static readonly HashSet<string> ReviewerRoutes = new(StringComparer.OrdinalIgnoreCase)
    {
        "constitution-explorer",
        "specification-explorer",
        "data-model-explorer",
        "plan-explorer",
        "task-explorer"
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var projectsTask = ProjectsApi.GetProjectsAsync();
            var metaTask     = ProjectsApi.GetMetaAsync();
            await Task.WhenAll(projectsTask, metaTask);
            _projects = projectsTask.Result ?? new();
            _meta     = metaTask.Result;
            _loading  = false;
        }
        catch (Exception ex)
        {
            _loading = false;
            _projects = new();
            System.Diagnostics.Debug.WriteLine($"Error loading projects: {ex.Message}");
        }

        // Re-read the catalog for every consumer (Explorers, Dashboard); document classification stays cached per project
        // until its file inventory changes. Each card fills in as its own discovery completes.
        DocumentDiscovery.Invalidate();
        await Task.WhenAll(_projects.Select(DiscoverAsync));
    }

    private async Task DiscoverAsync(SampleProjectDto project)
    {
        try
        {
            _discovery[project.Slug] = await DocumentDiscovery.DiscoverAsync(project);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Sample Project document discovery failed for {ProjectSlug}", project.Slug);
            _discovery[project.Slug] = new SampleProjectDiscoveryResult(project.Slug, [], [], [], project.Discovery,
                SampleArtifactClassifier.RoleOrder.Select(r => new SampleRoleSummary(r, [], null)).ToList(),
                "The project documents could not be read.");
        }
        StateHasChanged();
    }

    private void ChooseDocument(SampleProjectDto project, WorkspaceArtifactType role, string? relativePath)
    {
        DocumentDiscovery.ChooseDocument(project.Slug, role, relativePath);
        // The choice changes which document reviews read: the current workspace (and every page reading it) follows.
        if (IsCurrentWorkspace(project)) Workspace.NotifyArtifactsChanged();
        _ = RefreshDiscoveryAsync(project);
    }

    private async Task RefreshDiscoveryAsync(SampleProjectDto project)
    {
        _discovery[project.Slug] = await DocumentDiscovery.DiscoverAsync(project);
        StateHasChanged();
    }

    private static (string Name, string Route)? ExplorerFor(WorkspaceArtifactType role) => role switch
    {
        WorkspaceArtifactType.Constitution => ("Constitution Explorer", "/constitution-explorer"),
        WorkspaceArtifactType.Specification => ("Specification Explorer", "/specification-explorer"),
        WorkspaceArtifactType.DataModel => ("Data Model Explorer", "/data-model-explorer"),
        WorkspaceArtifactType.Plan => ("Plan Explorer", "/plan-explorer"),
        WorkspaceArtifactType.Tasks => ("Task Explorer", "/task-explorer"),
        _ => null,
    };

    private static string CoverageSummary(SampleProjectDiscoveryResult d)
    {
        var parts = new List<string> { $"{d.DetectedCount} supported artifact{(d.DetectedCount == 1 ? "" : "s")}" };
        if (d.NeedsReview.Count > 0) parts.Add($"{d.NeedsReview.Count} to review");
        if (d.Unclassified.Count > 0) parts.Add($"{d.Unclassified.Count} other document{(d.Unclassified.Count == 1 ? "" : "s")}");
        if (d.ParseErrors.Count > 0) parts.Add($"{d.ParseErrors.Count} unreadable");
        return string.Join(" · ", parts);
    }

    private static string RoleStateClass(SampleRoleSummary role) => role.State switch
    {
        SampleRoleState.Detected => "detected",
        SampleRoleState.Multiple => role.Primary is null ? "review" : "detected",
        _ => "none",
    };

    private static string RoleStateIcon(SampleRoleSummary role) => role.State switch
    {
        SampleRoleState.Detected => "✓",
        SampleRoleState.Multiple => role.Primary is null ? "◐" : "✓",
        _ => "—",
    };

    private static string RoleStateText(SampleRoleSummary role) => role.State switch
    {
        SampleRoleState.Detected => "Detected",
        SampleRoleState.Multiple => role.Primary is null ? "Multiple — choose one" : "Multiple",
        _ => "Not found",
    };

    private static string SkipText(string? reason) => reason switch
    {
        "TooLarge" => "too large",
        "Binary" => "binary content",
        "Unreadable" => "unreadable",
        "DocumentLimit" => "document limit reached",
        _ => reason ?? "",
    };

    private static string SkippedText(SampleProjectDiscoveryResult d) =>
        d.SkippedDocuments.Count == 0 ? "None" : string.Join(", ", d.SkippedDocuments.Select(f => $"{f.RelativePath ?? f.Filename} ({SkipText(f.SkipReason)})"));

    private void SetFileFilter(string slug, ChangeEventArgs e) => _fileFilter[slug] = e.Value?.ToString() ?? "all";

    private sealed record FileRow(string Path, string Type, string Role, string Confidence, string Used, string Reason);

    private static List<FileRow> AllFileRows(SampleProjectDto project, SampleProjectDiscoveryResult? d, string filter)
    {
        var rows = new List<(string Group, FileRow Row)>();
        if (d is not null)
        {
            foreach (var doc in d.Documents)
            {
                var role = d.Roles.FirstOrDefault(r => r.Role == doc.Role);
                var used = doc.Status != ArtifactDiscoveryStatus.Detected ? "No"
                    : role?.Primary is { } p && ReferenceEquals(p, doc) ? (ExplorerFor(doc.Role!.Value) is null ? "Context" : "Yes")
                    : "Choose on card";
                var (group, label) = doc.Status switch
                {
                    ArtifactDiscoveryStatus.Detected => ("artifacts", SampleArtifactClassifier.Label(doc.Role!.Value)),
                    ArtifactDiscoveryStatus.NeedsReview => ("review", "Needs review"),
                    ArtifactDiscoveryStatus.ParseError => ("review", "Could not be read"),
                    _ => ("other", "Other document"),
                };
                rows.Add((group, new FileRow(doc.RelativePath, "Markdown", label,
                    doc.Status is ArtifactDiscoveryStatus.Detected or ArtifactDiscoveryStatus.NeedsReview ? doc.Confidence.ToString() : "—",
                    used, string.Join(" ", doc.Reasons))));
            }
            foreach (var f in d.SkippedDocuments)
                rows.Add(("other", new FileRow(f.RelativePath ?? f.Filename, "Markdown", "Not read", "—", "No", $"Skipped: {SkipText(f.SkipReason)}")));
            foreach (var f in d.UnsupportedFiles)
                rows.Add(("unsupported", new FileRow(f.RelativePath ?? f.Filename, FileType(f.Filename), "—", "—", "No", "Not a document type BirkNext classifies")));
        }
        else
        {
            rows.AddRange(project.Files.Select(f => ("all", new FileRow(f.RelativePath ?? f.Filename, FileType(f.Filename), "…", "…", "…", "Discovering…"))));
        }
        return rows.Where(r => filter == "all" || r.Group == filter).Select(r => r.Row).OrderBy(r => r.Path, StringComparer.Ordinal).ToList();
    }

    private static string FileType(string fileName)
    {
        var ext = System.IO.Path.GetExtension(fileName);
        return string.IsNullOrEmpty(ext) ? "File" : ext.TrimStart('.').ToUpperInvariant();
    }

    private bool IsProjectLoading(SampleProjectDto project) =>
        string.Equals(_loadingSlug, project.Slug, StringComparison.Ordinal);

    private static bool IsReviewerRoute(string? route)
    {
        if (string.IsNullOrWhiteSpace(route)) return false;
        return ReviewerRoutes.Contains(route.Trim().TrimStart('/'));
    }

    private async Task OpenReviewerAsync(SampleProjectDto project, string? route)
    {
        if (!IsReviewerRoute(route) || _loadingSlug is not null)
            return;

        var selected = await SelectProjectCoreAsync(project, requireConfirmation: false);
        if (selected)
            Navigation.NavigateTo(route!);
    }

    private async Task SelectProject(SampleProjectDto project)
    {
        await SelectProjectCoreAsync(project, requireConfirmation: true);
    }

    private async Task<bool> SelectProjectCoreAsync(SampleProjectDto project, bool requireConfirmation)
    {
        System.Diagnostics.Debug.WriteLine("======== DIAG: [SelectProject] START ========");
        if (_loadingSlug is not null)
            return false;

        if (requireConfirmation)
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm",
                $"Select project \"{project.Name}\"?\n\nThis will replace the current project context.");
            if (!confirmed) return false;
        }

        _loadingSlug = project.Slug;
        _loadState.Remove(project.Slug);
        _hintState.Remove(project.Slug);
        _hintApplyMessages.Remove(project.Slug);
        _ignoredHints.Remove(project.Slug);
        StateHasChanged();

        // Every project is selectable: artifact roles are optional, so a project with few or no supported documents is
        // not a failure (Explorers then show a neutral "not detected" state).

        // Only set the project identity; artifact content comes from DocumentResolver
        // (explorers and analysis features all use DocumentResolver directly).
        // The selection is an explicit persisted user choice: save it immediately and, if the save fails, restore the
        // previous selection so the UI never shows a choice that was not persisted.
        var previousSelection = Workspace.CurrentProject;
        _selectionError = null;
        Workspace.CurrentProject = project.Slug;
        if (!await AutoSave.SaveNowAsync())
        {
            Workspace.CurrentProject = previousSelection;
            _selectionError = $"Could not save the selection of \"{project.Name}\". The previous selection was kept. Check that the BirkNext backend is running and try again.";
            Logger.LogWarning("Sample Project selection not persisted; reverted to {PreviousSlug}", previousSelection ?? "(none)");
            _loadingSlug = null;
            StateHasChanged();
            return false;
        }
        Logger.LogInformation("Sample Project selection changed: {ProjectSlug}", project.Slug);

        QualitySession.Clear();
        DashboardSnapshot.ClearQualityReview();

        // Report project selection success
        var discovery = _discovery.GetValueOrDefault(project.Slug);
        var available = discovery?.Documents.Where(d => d.Status == ArtifactDiscoveryStatus.Detected).Select(d => d.RelativePath).ToList() ?? [];
        var other = discovery?.Unclassified.Select(d => d.RelativePath).ToList() ?? [];
        var msg = available.Count == 0
            ? $"Selected {project.Name}. No supported document artifacts were detected."
            : $"Selected {project.Name}. {available.Count} artifact{(available.Count != 1 ? "s" : "")} available for review.";
        _loadState[project.Slug] = new LoadResult(project.Name, msg, false, available, other);

        _loadingSlug = null;
        StateHasChanged();
        System.Diagnostics.Debug.WriteLine("======== DIAG: [SelectProject] END ========");
        return true;
    }

    /// <summary>Explicit user action: clear the persisted Sample Project selection (no automatic re-selection later).</summary>
    private async Task ClearSelectionAsync()
    {
        if (_clearingSelection) return;
        var previousSelection = Workspace.CurrentProject;
        _clearingSelection = true;
        _selectionError = null;
        Workspace.CurrentProject = null;
        if (!await AutoSave.SaveNowAsync())
        {
            Workspace.CurrentProject = previousSelection;
            _selectionError = "Could not clear the Sample Project selection. The previous selection was kept. Check that the BirkNext backend is running and try again.";
        }
        else
        {
            Logger.LogInformation("Sample Project selection cleared (previously {PreviousSlug})", previousSelection ?? "(none)");
            QualitySession.Clear();
            DashboardSnapshot.ClearQualityReview();
        }
        _clearingSelection = false;
        StateHasChanged();
    }

    private async Task ApplyHintsAsync(DetectedTargetEnvironmentHints hints)
    {
        await FrontendSettings.LoadAsync(JS);
        await IntegrationRegistry.LoadAsync(JS);

        var profile = FrontendSettings.ActiveProfile;
        if (profile is null)
        {
            profile = FrontendSettings.CreateProfile(hints.ProjectName, hints.EnvironmentType ?? FrontendEnvironmentType.Local);
        }

        var frontendUrl = NormalizeAbsoluteUrl(hints.FrontendUrl);
        var baseForRelative = FirstAbsolute(frontendUrl, profile.TargetUrl, hints.RestBaseUrl, profile.RestBaseUrl);
        var restBaseUrl = ResolveEndpoint(hints.RestBaseUrl, baseForRelative);
        var healthEndpoint = ResolveEndpoint(hints.HealthEndpoint, FirstAbsolute(restBaseUrl, baseForRelative));
        var swaggerUrl = ResolveEndpoint(hints.SwaggerUrl, FirstAbsolute(restBaseUrl, baseForRelative));
        var graphQlEndpoint = ResolveEndpoint(hints.GraphQlEndpoint, FirstAbsolute(restBaseUrl, baseForRelative));

        var conflicts = new List<string>();
        AddConflict(conflicts, "Frontend URL", profile.TargetUrl, frontendUrl);
        AddConflict(conflicts, "REST Base URL", profile.RestBaseUrl, restBaseUrl);
        AddConflict(conflicts, "Health Endpoint", profile.HealthEndpoint, healthEndpoint);
        AddConflict(conflicts, "Swagger / OpenAPI URL", profile.SwaggerUrl, swaggerUrl);
        AddConflict(conflicts, "GraphQL Endpoint", profile.GraphQlEndpoint, graphQlEndpoint);
        if (hints.EnvironmentType is not null && profile.EnvironmentType != hints.EnvironmentType.Value)
            conflicts.Add($"Environment: {profile.EnvironmentType} -> {hints.EnvironmentType.Value}");
        if (hints.AuthType != TargetApiAuthType.None && profile.ApiAuth.AuthType != TargetApiAuthType.None && profile.ApiAuth.AuthType != hints.AuthType)
            conflicts.Add($"API Authentication: {profile.ApiAuth.AuthType} -> {hints.AuthType}");

        if (conflicts.Count > 0)
        {
            var confirm = await JS.InvokeAsync<bool>("confirm",
                "Apply detected Target Environment hints?\n\nThe following existing settings will be overwritten:\n\n" +
                string.Join("\n", conflicts));
            if (!confirm) return;
        }

        if (!string.IsNullOrWhiteSpace(frontendUrl)) profile.TargetUrl = frontendUrl;
        if (!string.IsNullOrWhiteSpace(restBaseUrl)) profile.RestBaseUrl = restBaseUrl;
        if (!string.IsNullOrWhiteSpace(healthEndpoint)) profile.HealthEndpoint = healthEndpoint;
        if (!string.IsNullOrWhiteSpace(swaggerUrl)) profile.SwaggerUrl = swaggerUrl;
        if (!string.IsNullOrWhiteSpace(graphQlEndpoint))
        {
            profile.GraphQlEndpoint = graphQlEndpoint;
            if (!profile.AllowedGraphQlEndpoints.Contains(graphQlEndpoint, StringComparer.OrdinalIgnoreCase))
                profile.AllowedGraphQlEndpoints.Add(graphQlEndpoint);
        }
        if (hints.EnvironmentType is not null) profile.EnvironmentType = hints.EnvironmentType.Value;
        if (hints.AuthType != TargetApiAuthType.None) profile.ApiAuth.AuthType = hints.AuthType;

        if (!string.IsNullOrWhiteSpace(restBaseUrl) &&
            Uri.TryCreate(restBaseUrl, UriKind.Absolute, out var restUri) &&
            !profile.AllowedRestHosts.Contains(restUri.Host, StringComparer.OrdinalIgnoreCase))
            profile.AllowedRestHosts.Add(restUri.Host);

        foreach (var integration in hints.Integrations)
            integration.Endpoint = ResolveEndpoint(integration.Endpoint, FirstAbsolute(restBaseUrl, graphQlEndpoint, baseForRelative));

        IntegrationRegistry.UpsertFromHints(hints.Integrations, hints.ProjectName);
        FrontendSettings.UpdateProfile(profile);
        await FrontendSettings.SaveAsync(JS);
        await IntegrationRegistry.SaveAsync(JS);

        _hintApplyMessages[hints.ProjectSlug] = $"Applied hints to Target Environment \"{profile.Name}\" and saved {hints.Integrations.Count} integration hint{(hints.Integrations.Count == 1 ? "" : "s")}.";
    }

    private static void AddConflict(List<string> conflicts, string label, string? currentValue, string? nextValue)
    {
        if (string.IsNullOrWhiteSpace(nextValue) ||
            string.IsNullOrWhiteSpace(currentValue) ||
            string.Equals(currentValue.Trim(), nextValue.Trim(), StringComparison.OrdinalIgnoreCase))
            return;

        conflicts.Add($"{label}: {currentValue} -> {nextValue}");
    }

    private static string? FirstAbsolute(params string?[] candidates) =>
        candidates.FirstOrDefault(value =>
            !string.IsNullOrWhiteSpace(value) &&
            Uri.TryCreate(value, UriKind.Absolute, out var uri) &&
            (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps));

    private static string? NormalizeAbsoluteUrl(string? value)
    {
        value = value?.Trim();
        return Uri.TryCreate(value, UriKind.Absolute, out var uri) &&
               (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps)
            ? uri.ToString()
            : null;
    }

    private static string? ResolveEndpoint(string? value, string? baseUrl)
    {
        value = value?.Trim();
        if (string.IsNullOrWhiteSpace(value)) return null;
        if (Uri.TryCreate(value, UriKind.Absolute, out var absolute) &&
            (absolute.Scheme == Uri.UriSchemeHttp || absolute.Scheme == Uri.UriSchemeHttps))
            return absolute.ToString();

        if (value.StartsWith('/') &&
            Uri.TryCreate(baseUrl, UriKind.Absolute, out var baseUri) &&
            (baseUri.Scheme == Uri.UriSchemeHttp || baseUri.Scheme == Uri.UriSchemeHttps))
        {
            var origin = new Uri($"{baseUri.Scheme}://{baseUri.Authority}");
            return new Uri(origin, value).ToString();
        }

        return value;
    }

    private static void SetEnvironmentHint(DetectedTargetEnvironmentHints hints, ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        hints.EnvironmentType = Enum.TryParse<FrontendEnvironmentType>(value, out var parsed) ? parsed : null;
    }

    private void IgnoreHints(string slug)
    {
        _ignoredHints.Add(slug);
        _hintApplyMessages.Remove(slug);
    }

    private async Task ToggleReadme(SampleProjectDto project)
    {
        if (_readmeOpen.Contains(project.Slug))
        {
            CloseReadme(project.Slug);
            return;
        }

        if (!_readmeContent.ContainsKey(project.Slug))
        {
            var content = await ProjectsApi.GetFileAsync(project.Slug, "README.md");
            _readmeContent[project.Slug] = content ?? "(README could not be loaded)";
        }
        _readmeOpen.Add(project.Slug);
    }

    private void CloseReadme(string slug) => _readmeOpen.Remove(slug);

    private void ToggleAllFiles(string slug)
    {
        if (!_allFilesOpen.Remove(slug))
            _allFilesOpen.Add(slug);
    }

    private void CloseAllFiles(string slug) => _allFilesOpen.Remove(slug);

    private async Task CopyPath(string path)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", path);
        }
        catch
        {
            // Clipboard API not available — silently ignore
        }
    }

    private sealed record LoadResult(
        string ProjectName,
        string Message,
        bool HasError,
        IReadOnlyList<string> LoadedArtifacts,
        IReadOnlyList<string> ContextOnlyFiles);

    private sealed record NextActionLink(string Label, string Href);

    private static string NormalizeArtifactText(string text)
    {
        // Strip UTF-8 BOM if present.
        if (text.StartsWith('﻿')) text = text[1..];
        // Normalize Windows / old-Mac line endings to LF.
        return text.Replace("\r\n", "\n").Replace('\r', '\n');
    }
}
