    /// <summary>The structure the new plan gets — the same shared rules the server applies when it creates the plan.</summary>
    private PlanStructureResult ProposedStructure(string template) =>
        PlanStructure.Build(template, [.. SelectedScenarios().Select(c => PlanStructure.FactsOf(c.CandidateId, c, resolvedType: ResolvedType(c)))]);

    /// <summary>The acceptance scenario's own type as the overview resolved it (reviewer's decision included); null = classify from the scenario.</summary>
    private ScenarioRequirementType? ResolvedType(DiscoveredScenario c) =>
        _overview?.Specifications.SelectMany(s => s.Scenarios).FirstOrDefault(x => !x.RequirementOnly && x.Identity == c.SourceIdentity)?.Type;

    /// <summary>The grouping chosen in Finn og forstå as a plan structure key (null when none is saved or it cannot be suites, e.g. test method).</summary>
    private string? _groupingStructure;

    private async Task ReadGroupingStructureAsync()
    {
        try
        {
            var saved = ScenarioGrouping.Parse(await JS.InvokeAsync<string?>("localStorage.getItem", "birknext.manualTesting.scenarioGrouping"));
            // No saved choice = the tester sees the default grouping (Brukerhistorie → Scenariotype), so that is the grouping offered as suites.
            var (primary, secondary) = saved ?? ScenarioGrouping.Default();
            _groupingStructure = ScenarioGroupAxes.StructureKey(primary, secondary);
        }
        catch (Exception e) when (e is JSException or InvalidOperationException or TaskCanceledException) { _groupingStructure = null; }
    }

    private void StartNew()
    {
        _ = InvokeAsync(async () => { await ReadGroupingStructureAsync(); StateHasChanged(); });
        // Every start is a new draft: a new suggested name (local time now) and a new request id; the previous draft is never reused.
        _new = new NewPlanDraft(M.SuggestedPlanName(DateTime.Now)) { Structure = _dashboard.EffectivePlanStructure };
        if (Api is { } api) _ = InvokeAsync(async () =>
        {
            var (templates, _) = await api.TemplatesAsync();
            if (templates is { Count: > 0 }) _templates = templates;
            var (settings, _) = await api.DashboardSettingsAsync();
            if (settings is not null) { _dashboard = settings; if (_new is { } n) n.Structure = settings.EffectivePlanStructure; StateHasChanged(); }
        });
        (_createError, _created) = (null, null);
    }

    private async Task CreateAsync()
    {
        if (_new is not { } draft || _creating || _ws?.ProjectKey is not { } key || Api is not { } api) return;
        if (string.IsNullOrWhiteSpace(draft.Name)) { _createError = "Gi testplanen et navn."; return; }
        _creating = true; _createError = null;
        try
        {
            var withSelection = draft.WithSelection && _selection.Count > 0 && _ws.Discovery is not null;
            var (plan, error) = await api.CreateProjectAsync(new CreateProjectTestPlanRequest
            {
                ProjectKey = key, ProjectName = _ws.ProjectName, PlanName = draft.Name.Trim(), CreationRequestId = draft.RequestId,
                DiscoveryId = withSelection ? _ws.Discovery!.DiscoveryId : "", CandidateIds = withSelection ? [.. _selection] : [], AllowEmpty = !withSelection,
                Structure = withSelection ? draft.Structure : null,
                ScenarioOnly = withSelection && draft.ScenarioOnly,
                TemplateId = !withSelection && draft.Method == NewPlanMethod.FromTemplate ? draft.TemplateId : null,
            });
            // A failed save keeps the draft (same name, same request id: a retry never creates a second test plan).
            if (plan is null) { _createError = P.Friendly(error, "Kunne ikke opprette testplan."); return; }
            if (withSelection) { await TabDraftStore.RemoveAsync(JS, TabDraftStore.SelectionKey(key)); _selection = []; }
            (_new, _created) = (null, plan);
            await LoadAsync();
        }
        finally { _creating = false; }
    }

    private void OpenTransfer(Guid id)
    {
        Nav.NavigateTo(M.TransferRoute(id), replace: true);
        _ = InvokeAsync(async () => { await LoadTransferAsync(id); StateHasChanged(); });
    }

    private async Task LoadTransferAsync(Guid id)
    {
        if (Api is not { } api) return;
        (_transferLoading, _transferError, _transfer) = (true, null, null);
        try
        {
            var (draft, error) = await api.DraftAsync(id);
            if (draft is null || (draft.ProjectKey is { } owner && owner != _ws?.ProjectKey)) { _transferError = error is null ? "Testplanen finnes ikke i denne applikasjonen." : P.Friendly(error, "Testplanen kunne ikke hentes."); return; }
            _transfer = draft;
        }
        finally { _transferLoading = false; }
    }

    private void CloseTransfer() { _transfer = null; Nav.NavigateTo(M.PlansRoute, replace: true); }

    /// <summary>Another project was selected: everything is read again for it (nothing of the previous project stays).</summary>
    private void OnProjectChanged() => _ = InvokeAsync(async () =>
    {
        _ws = null; _overview = null; _overviewError = null; _module = null; _specPath = null; _pack = null; _level = O.Level.Project;
        _follow = new(); _followToggled.Clear(); _followLimit.Clear(); _followGroupPage = 0; _followRestored = false;
        _new = null; _created = null; _transfer = null; _selection = [];
        await LoadAsync(); StateHasChanged();
    });

    public void Dispose() { if (_projection is not null) _projection.Changed -= OnProjectChanged; }
}
