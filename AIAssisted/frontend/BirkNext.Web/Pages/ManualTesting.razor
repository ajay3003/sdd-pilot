@page "/manual-testing"
@page "/manual-testing/plans"
@using BirkNext.TestPlanning
@using BirkNext.Web.Services
@using M = BirkNext.Web.Services.ManualTestingPresentation
@using P = BirkNext.Web.Services.PlanPreparePresentation
@using O = BirkNext.Web.Services.ManualTestingOverviewPresentation
@implements IDisposable
@inject IServiceProvider ServiceProvider
@inject NavigationManager Nav
@inject IJSRuntime JS

@* «3. Testplaner» (2026-11-25), the last Manual Testing tab: create, open, archive and transfer the project's test plans. The same page as the Manual
   Testing home (/manual-testing) — no second test plan system: the saved plans, their counts and «Neste steg» come from the same stored records,
   creation uses the same create call (an explicit empty plan or the scenarios chosen in Finn og forstå), and «Overfør testplan» is the same transfer
   panel (file export by default, direct transfer opt-in). Project is the scope: plans are never hidden because another module is selected. *@
@* UX pass (2026-11-25): /manual-testing is the workspace OVERVIEW («Manuell testing»: one next step, the three steps with their status, the
   counts collapsed); /manual-testing/plans is «3. Testplaner» (create, list, transfer). Before, both addresses showed the Testplaner page, so the
   «Manuell testing» tab led to «Testplaner» and was never marked as the current page. *@
<PageTitle>@(IsHome ? "Testoversikt — Manuell testing" : "Testplaner — Manuell testing")</PageTitle>

<div class="mt msb-page" data-testid="mt" aria-busy="@(_loading ? "true" : "false")">
    <BirkNext.Web.Components.TestingWorkspaceHeader Workspace="Manuell testing" HomeRoute="@M.HomeRoute" Stages="M.Stages" Current="@(IsHome ? null : "plans")" Title="@(IsHome ? "Testoversikt" : "Testplaner")"
        ProjectName="@_ws?.ProjectName" Context="@_ws?.SnapshotBasis"
        Lead="@(IsHome ? "Hvor står testforberedelsen? Velg modul og spesifikasjon her; Finn og forstå viser det samme utvalget." : "Opprett, åpne og overfør testplanene for applikasjonen. Testtilfellene forberedes i Planlegg og klargjør.")">
        <Help><BirkNext.Web.Components.HelpLink Topic="manual-testing" Text="Slik fungerer det" /></Help>
    </BirkNext.Web.Components.TestingWorkspaceHeader>

    @if (_loading)
    {
        <InlineLoading Text="Henter testplaner …" Class="msb-skeleton" TestId="mt-loading" />
    }
    else if (_ws is null)
    {
        <p class="msb-empty" data-testid="mt-error">Manuell testing kunne ikke lastes. <button type="button" class="msb-link" @onclick="LoadAsync">Prøv igjen</button></p>
    }
    else
    {
        var facts = _ws.Facts;
        var next = M.Next(facts);
        @if (_ws.Error is { } error)
        {
            <p class="mt-alert" role="alert" data-testid="mt-error">@error <button type="button" class="btn btn-secondary btn-sm" @onclick="LoadAsync" data-testid="mt-retry">Prøv igjen</button></p>
        }

        @if (facts.ProjectKey is not null && IsHome)
        {
            @* Testoversikt (2026-11-25): the shared selection (module → specification, the same one Finn og forstå reads), the scope the figures use,
               and the parts System Settings → Manuell testing → Testoversikt switches on. Preparation, coverage, readiness, approval and source status
               only — never execution results. *@
            <BirkNext.Web.Components.SpecificationScopePicker Changed="OnScopeChangedAsync" ShowDiscoverLink="false" />
            <div class="mto-head">
                <div class="mtp-seg" role="radiogroup" aria-label="Tallene gjelder" data-testid="mto-level">
                    @foreach (var (level, text, enabled) in new[] { (O.Level.Project, "Hele prosjektet", true), (O.Level.Module, "Valgt modul", _module is not null), (O.Level.Specification, "Valgt spesifikasjon", _specPath is not null) })
                    {
                        var l = level;
                        <button type="button" role="radio" class="mtp-seg-btn @(_level == l ? "is-on" : null)" aria-checked="@(_level == l ? "true" : "false")" disabled="@(!enabled)"
                                @onclick="() => SetLevel(l)" data-level="@l" data-testid="mto-level-option">@text</button>
                    }
                </div>
                <span class="mt-muted msb-small" data-testid="mto-scope">@O.ScopeLabel(CurrentScope)</span>
                @if (CanWrite) { <a class="msb-link msb-small mto-customize" href="admin/system-settings?section=manual-testing" data-testid="mto-customize">Tilpass oversikten</a> }
            </div>
            @if (_overviewLoading)
            {
                <InlineLoading Text="Henter testoversikt …" Class="mt-muted" TestId="mto-loading" />
            }
            else if (_overviewError is { } oe)
            {
                <p class="mt-alert" role="alert" data-testid="mto-error">Kunne ikke hente testoversikten. @oe <button type="button" class="msb-link" @onclick="LoadOverviewAsync" data-testid="mto-retry">Prøv igjen</button></p>
            }
            else if (_overview is { } ov)
            {
                var slice = O.Of(ov, CurrentScope);
                var fig = O.Compute(slice, ov.Plans);
                var explain = On("display.explanations");
                <section class="mto-kpis" aria-label="Nøkkeltall" data-testid="mto-kpis">
                    @if (On("metric.scenarios"))
                    {
                        <a class="mto-kpi" href="@M.DiscoverRoute" data-testid="mto-kpi" data-widget="metric.scenarios"><span class="mto-kpi-k">Scenarioforslag</span>
                            <span class="mto-kpi-v">@(fig.Scenarios?.ToString() ?? "—")</span>
                            @if (explain) { <span class="mto-kpi-e">@(fig.Scenarios is null ? "Ikke tilgjengelig: spesifikasjonen er ikke lagret for prosjektet" : fig.Covered is { } cov ? $"{cov} har testtilfeller" : "")</span> }</a>
                    }
                    @if (On("metric.testCases"))
                    {
                        <a class="mto-kpi" href="@M.PlanRoute" data-testid="mto-kpi" data-widget="metric.testCases"><span class="mto-kpi-k">Testtilfeller</span><span class="mto-kpi-v">@fig.Cases</span>
                            @if (explain) { <span class="mto-kpi-e">Lagret i aktive testplaner</span> }</a>
                    }
                    @if (On("metric.approved"))
                    {
                        <div class="mto-kpi" data-testid="mto-kpi" data-widget="metric.approved"><span class="mto-kpi-k">Godkjente</span><span class="mto-kpi-v">@fig.Approved</span>
                            @if (explain) { <span class="mto-kpi-e">@fig.Approved av @fig.Cases testtilfeller</span> }</div>
                    }
                    @if (On("metric.ready"))
                    {
                        <div class="mto-kpi" data-testid="mto-kpi" data-widget="metric.ready"><span class="mto-kpi-k">Klar til testing</span><span class="mto-kpi-v">@fig.Ready</span>
                            @if (explain) { <span class="mto-kpi-e">@fig.Ready av @fig.Cases · godkjent er ikke det samme som klar</span> }</div>
                    }
                    @if (On("metric.testPlans"))
                    {
                        <a class="mto-kpi" href="@M.PlansRoute" data-testid="mto-kpi" data-widget="metric.testPlans"><span class="mto-kpi-k">Testplaner</span><span class="mto-kpi-v">@fig.Plans</span>
                            @if (explain) { <span class="mto-kpi-e">Med testtilfeller i utvalget</span> }</a>
                    }
                </section>
                <div class="mto-grid">
                    @Chart("chart.preparation", "Testforberedelse", O.Preparation(slice), "Trinnene overlapper og summeres ikke.", false)
                    @Chart("chart.moduleCoverage", _level switch { O.Level.Project => "Testdekning per modul", O.Level.Module => "Testdekning per spesifikasjon", _ => "Testdekning per brukerhistorie" },
                        O.Coverage(slice, _level), slice.ScenariosAvailable ? "Andel scenarioer med minst ett lagret testtilfelle." : "Ikke tilgjengelig: spesifikasjonen er ikke lagret for prosjektet.", true)
                    @Chart("chart.priority", "Scenarioer etter prioritet", O.Priority(slice), "Prioritet slik spesifikasjonen oppgir den.", false)
                    @Chart("chart.coverageGaps", "Manglende testdekning", O.Gaps(slice), "Scenarioer uten lagret testtilfelle.", false)
                    @Chart("chart.blockers", "Testbarhet og blokkeringer", O.Blockers(slice), $"{O.NotReady(slice)} av {fig.Cases} testtilfeller er ikke klare. Ett testtilfelle kan ha flere årsaker.", false)
                    @Chart("chart.sourceChanges", "Kildeendringer", O.SourceChanges(slice), "Sammenlignet med testtilfellets egen spesifikasjon.", false)
                    @Chart("chart.manualTechnical", "Manuelle og tekniske testtilfeller", O.ManualTechnical(slice), "Testtypen som er valgt for testtilfellet.", false)
                    @Chart("chart.moduleApproval", "Godkjenning per modul", O.ModuleApproval(slice), "Godkjente av lagrede testtilfeller.", false)
                    @if (On("chart.history"))
                    {
                        <section class="mto-card" data-testid="mto-widget" data-widget="chart.history"><h3 class="mto-card-h">Utvikling i testforberedelse</h3>
                            <p class="mt-muted msb-small" data-testid="mto-history-unavailable">Historiske tall er ikke tilgjengelige: tilstanden på tidligere tidspunkter lagres ikke, og tall beregnes aldri bakover.</p></section>
                    }
                    @if (On("panel.p1Attention") && O.P1Attention(slice) is { Count: > 0 } attention)
                    {
                        <section class="mto-card mto-attention" data-testid="mto-widget" data-widget="panel.p1Attention"><h3 class="mto-card-h">Viktig å følge opp</h3>
                            <ul>@foreach (var (k, text) in attention) { <li data-key="@k">@text</li> }</ul>
                            <p class="msb-small"><a href="@M.DiscoverRoute">Se scenarioer</a> · <a href="@M.PlanRoute">Se testtilfeller</a></p></section>
                    }
                    @if (On("panel.testPlans") && ov.Plans.Count > 0)
                    {
                        <section class="mto-card" data-testid="mto-widget" data-widget="panel.testPlans"><h3 class="mto-card-h">Testplaner <span class="mt-muted msb-small">(hele prosjektet)</span></h3>
                            <ul class="mto-plans">@foreach (var pl in ov.Plans.Take(6)) { <li><a href="@($"{M.PlanRoute}?draft={pl.Id}")">@pl.Name</a> <span class="mt-muted msb-small">@pl.Cases testtilfeller · @pl.Approved godkjent@(pl.SourceAttention > 0 ? $" · {pl.SourceAttention} med kildeendring" : "")</span></li> }</ul>
                            <p class="msb-small"><a href="@M.PlansRoute">Alle testplaner</a></p></section>
                    }
                    @if (On("panel.recentChanges") && ov.RecentRevisions.Count > 0)
                    {
                        <section class="mto-card" data-testid="mto-widget" data-widget="panel.recentChanges"><h3 class="mto-card-h">Siste endringer</h3>
                            <ul class="mto-plans">@foreach (var r in ov.RecentRevisions.Take(8)) { <li>@r.SavedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · <a href="@($"{M.PlanRoute}?draft={r.PlanId}")">@r.PlanName</a> <span class="mt-muted msb-small">versjon @r.Revision · @r.Reason · @r.SavedBy</span></li> }</ul></section>
                    }
                    @Chart("panel.translationReview", "Oversettelser til gjennomgang", O.Translations(slice), "Fra lagret oversettelsesstatus; ingenting oversettes for å vise dette.", false)
                </div>
                @if (On("display.moduleOverview") && O.Rows(slice, _level) is { Count: > 0 } rows)
                {
                    <section class="mto-card mto-table-card" data-testid="mto-widget" data-widget="display.moduleOverview">
                        <h3 class="mto-card-h">@(_level switch { O.Level.Project => "Oversikt per modul", O.Level.Module => "Oversikt per spesifikasjon", _ => "Oversikt per brukerhistorie" })</h3>
                        <table class="mto-table">
                            <thead><tr><th scope="col">@(_level switch { O.Level.Project => "Modul", O.Level.Module => "Spesifikasjon", _ => "Brukerhistorie" })</th><th scope="col">Scenarioer</th><th scope="col">Med testtilfeller</th><th scope="col">Testtilfeller</th><th scope="col">Godkjent</th><th scope="col">Trenger oppfølging</th></tr></thead>
                            <tbody>
                                @foreach (var row in rows)
                                {
                                    var r = row;
                                    <tr data-testid="mto-row" data-key="@row.Key">
                                        <td>@if (_level == O.Level.Project && row.Module is { } mod && mod != "Uten modultilknytning" && _modules.Contains(mod))
                                            { <button type="button" class="msb-link" @onclick="() => OpenModuleAsync(mod)" data-testid="mto-row-open">@row.Label</button> }
                                            else { @row.Label }</td>
                                        <td>@(row.Scenarios?.ToString() ?? "—")</td><td>@(row.Covered?.ToString() ?? "—")</td><td>@row.Cases</td><td>@row.Approved</td><td>@row.FollowUp</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </section>
                }
            }
        }
        else if (facts.ProjectKey is not null)
        {
            @* 1. Testplan actions *@
            <div class="mt-plan-actions" data-testid="mt-plan-actions">
                <button type="button" class="btn btn-primary" disabled="@(!CanWrite || _creating)" title="@(CanWrite ? null : "Du har ikke tilgang til å opprette testplaner.")"
                        @onclick="StartNew" data-testid="mt-new-plan">+ Ny testplan</button>
                <button type="button" class="btn btn-outline-primary" disabled="@(Active.Count == 0)" title="@(Active.Count == 0 ? "Det finnes ingen aktiv testplan å overføre." : null)"
                        @onclick="() => OpenTransfer(Active[0].Id)" data-testid="mt-transfer">Overfør testplan</button>
                @if (!CanWrite) { <span class="mt-muted msb-small" data-testid="mt-new-plan-why">Du har ikke tilgang til å opprette testplaner.</span> }
            </div>

            @if (_new is { } draft)
            {
                <section class="mt-new-plan" aria-labelledby="mt-new-plan-title" data-testid="mt-new-plan-form">
                    <h2 id="mt-new-plan-title" class="msb-h">Ny testplan</h2>
                    <label class="mtp-field" for="mt-new-plan-name"><span>Navn</span></label>
                    <input id="mt-new-plan-name" class="form-control mt-new-plan-name" maxlength="200" value="@draft.Name" @oninput="e => draft.Name = e.Value?.ToString() ?? string.Empty"
                           disabled="@_creating" aria-describedby="mt-new-plan-help" data-testid="mt-new-plan-name" />
                    <span id="mt-new-plan-help" class="mt-muted msb-small">Foreslått navn med dato og klokkeslett. Du kan skrive et eget navn.</span>
                    @if (_selection.Count > 0 && _ws.Discovery is not null)
                    {
                        <label class="adx-check"><input type="checkbox" checked="@draft.WithSelection" disabled="@_creating" @onchange="e => draft.WithSelection = e.Value is true" data-testid="mt-new-plan-selection" />
                            Ta med @_selection.Count scenario@(_selection.Count == 1 ? "" : "er") valgt i Finn og forstå</label>
                    }
                    @if (_createError is { } ce) { <p class="mt-alert" role="alert" data-testid="mt-new-plan-error">@ce</p> }
                    <div class="mt-new-plan-actions">
                        <button type="button" class="btn btn-primary btn-sm" disabled="@(_creating || string.IsNullOrWhiteSpace(draft.Name))" @onclick="CreateAsync" data-testid="mt-new-plan-create">@(_creating ? "Oppretter …" : "Opprett testplan")</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_creating" @onclick="() => _new = null" data-testid="mt-new-plan-cancel">Avbryt</button>
                    </div>
                </section>
            }
            @if (_created is { } created)
            {
                <p class="mtp-notice" role="status" data-testid="mt-new-plan-done">Testplan opprettet: «@created.PlanName».
                    <a href="@($"{M.PlanRoute}?draft={created.Id}")" data-testid="mt-new-plan-open">Åpne i Planlegg og klargjør</a></p>
            }

            @if (_transfer is { } transferPlan)
            {
                <section class="mt-transfer" aria-label="Overfør testplan" data-testid="mt-transfer-panel">
                    <label class="mtp-field mtp-inline"><span>Testplan</span>
                        <select @onchange="e => OpenTransfer(Guid.TryParse(e.Value?.ToString(), out var id) ? id : transferPlan.Id)" data-testid="mt-transfer-plan">
                            @foreach (var p in Active) { <option value="@p.Id" selected="@(p.Id == transferPlan.Id)">@p.PlanName</option> }
                        </select></label>
                    <button type="button" class="msb-link" @onclick="CloseTransfer" data-testid="mt-transfer-close">Lukk</button>
                    @* A new panel per test plan: it always opens on «Eksporter til fil». *@
                    <BirkNext.Web.Components.ManualTesting.AdoTransferPanel @key="transferPlan.Id" Draft="transferPlan" ProjectKey="@(facts.ProjectKey!)" CanWrite="CanWrite" />
                </section>
            }
            else if (_transferLoading) { <InlineLoading Text="Henter testplanen …" Class="mt-muted" TestId="mt-transfer-loading" /> }
            else if (_transferError is { } te) { <p class="mt-alert" role="alert" data-testid="mt-transfer-error">@te</p> }

            @* 2. Saved test plans *@
            @if (_ws.Plans is { } workspace)
            {
                <BirkNext.Web.Components.ManualTesting.SavedPlans Workspace="workspace" Api="Api" ShowArchived="@(PlansQuery == "archived")" Changed="LoadAsync" />
            }

        }
        else
        {
            <p class="msb-empty" data-testid="mt-no-project">Velg et prosjekt for å se testarbeidet. <a href="@next.Href" data-testid="mt-no-project-link">@next.Label</a></p>
        }
    }
</div>

@code {
    /// <summary>"archived": open the saved-plan list on the archived plans.</summary>
    [SupplyParameterFromQuery(Name = "plans")] public string? PlansQuery { get; set; }
    /// <summary>"1": open «Ny testplan» (from Planlegg og klargjør).</summary>
    [SupplyParameterFromQuery(Name = "create")] public string? CreateQuery { get; set; }
    /// <summary>A test plan id: open «Overfør testplan» for it.</summary>
    [SupplyParameterFromQuery(Name = "transfer")] public string? TransferQuery { get; set; }

    /// <summary>Execution in BirkNext is switched on (System settings; off by default): results are then recorded in BirkNext too.</summary>
    private bool _executionEnabled;
    // ── Testoversikt ──
    private ManualTestingOverview? _overview;
    private ManualTestingDashboardSettings _dashboard = new();
    private bool _overviewLoading;
    private string? _overviewError, _module, _specPath;
    private HashSet<string> _modules = new(StringComparer.Ordinal);
    private O.Level _level = O.Level.Project;
    private int _overviewGeneration;

    private bool On(string id) => _dashboard.IsOn(id);

    private O.Scope CurrentScope => _level switch
    {
        O.Level.Module when _module is not null => new(O.Level.Module, _module, null),
        O.Level.Specification when _specPath is not null => new(O.Level.Specification, _module, _specPath),
        _ => O.Scope.Project,
    };

    private void SetLevel(O.Level level) => _level = level;

    /// <summary>One chart card from the registry: not rendered when switched off, or empty while «Skjul tomme grafer» is on.</summary>
    private RenderFragment Chart(string id, string title, IReadOnlyList<DeliveryBar> bars, string note, bool percent) => builder =>
    {
        if (!On(id) || (bars.Count == 0 && On("display.hideEmpty"))) return;
        builder.OpenElement(0, "section"); builder.AddAttribute(1, "class", "mto-card"); builder.AddAttribute(2, "data-testid", "mto-widget"); builder.AddAttribute(3, "data-widget", id);
        builder.OpenElement(4, "h3"); builder.AddAttribute(5, "class", "mto-card-h"); builder.AddContent(6, title); builder.CloseElement();
        builder.OpenComponent<BirkNext.Web.Components.DeliveryBarChart>(7);
        builder.AddAttribute(8, "Bars", bars); builder.AddAttribute(9, "TestId", "mto-bar"); builder.AddAttribute(10, "Label", title); builder.AddAttribute(11, "Percent", percent);
        builder.AddAttribute(12, "Empty", "Ingen data i utvalget.");
        builder.CloseComponent();
        builder.OpenElement(13, "p"); builder.AddAttribute(14, "class", "mt-muted msb-small"); builder.AddContent(15, note); builder.CloseElement();
        builder.CloseElement();
    };

    /// <summary>The figures for the project, read once (one request); a newer request makes an older answer irrelevant.</summary>
    private async Task LoadOverviewAsync()
    {
        if (_ws?.ProjectKey is not { } key || Api is not { } api) return;
        var generation = ++_overviewGeneration;
        _overviewLoading = true; _overviewError = null;
        try
        {
            var settingsTask = api.DashboardSettingsAsync();
            var (overview, error) = await api.OverviewAsync(key);
            var (settings, _) = await settingsTask;
            if (generation != _overviewGeneration) return;
            _overview = overview; _overviewError = overview is null ? error ?? "Ukjent feil." : null;
            _dashboard = settings ?? new();
        }
        finally { if (generation == _overviewGeneration) _overviewLoading = false; }
        await ReadScopeAsync();
    }

    /// <summary>The shared module and specification (the same choice Finn og forstå uses).</summary>
    private async Task ReadScopeAsync()
    {
        if (ServiceProvider.GetService(typeof(BirkNext.Web.Services.Explorers.IArtifactExplorerContext)) is not BirkNext.Web.Services.Explorers.IArtifactExplorerContext explorer) return;
        try
        {
            var state = await explorer.GetStateAsync(BirkNext.Web.Services.WorkspaceArtifactType.Specification);
            _module = string.IsNullOrEmpty(state.Module) ? null : state.Module;
            _specPath = state.Status == BirkNext.Web.Services.Explorers.ExplorerArtifactStatus.Loaded ? state.Selected?.SourcePath : null;
            _modules = [.. (state.Modules ?? []).Select(m => m.Module).Where(m => m.Length > 0)];
        }
        catch (Exception e) when (e is not OperationCanceledException) { }
        if (_level == O.Level.Specification && _specPath is null) _level = _module is null ? O.Level.Project : O.Level.Module;
        if (_level == O.Level.Module && _module is null) _level = O.Level.Project;
    }

    private async Task OnScopeChangedAsync()
    {
        await ReadScopeAsync();
        StateHasChanged();
    }

    /// <summary>A module row: select it in the shared choice and open Finn og forstå on it (its specification is chosen there when it has several).</summary>
    private async Task OpenModuleAsync(string module)
    {
        if (ServiceProvider.GetService(typeof(BirkNext.Web.Services.Explorers.IArtifactExplorerContext)) is BirkNext.Web.Services.Explorers.IArtifactExplorerContext explorer)
            try { await explorer.SelectModuleAsync(module); } catch (Exception e) when (e is not OperationCanceledException) { }
        Nav.NavigateTo(M.DiscoverRoute);
    }

    /// <summary>The workspace overview (/manual-testing) rather than «3. Testplaner» (/manual-testing/plans).</summary>
    private bool IsHome => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/').Equals(M.HomeRoute, StringComparison.OrdinalIgnoreCase);

    private string DiscoverStatus(ManualTestingPresentation.Facts facts) =>
        facts.SpecificationChoice is not null ? "Velg modul og spesifikasjon"
        : _ws?.Discovery is { } d ? $"{d.Candidates.Count} forslag · {d.Candidates.Count(c => c.NeedsClarification)} trenger avklaring"
        : "Ingen scenarioer funnet ennå";

    private static string StatusSummary(int cases, int approved, int notReady) =>
        $"{cases} testtilfelle{(cases == 1 ? "" : "r")} · {approved} godkjent" + (cases > 0 ? $" · {notReady} ikke klar til kjøring" : "");
    private ITestPlanSuggestionsApiService? Api =>ServiceProvider.GetService(typeof(ITestPlanSuggestionsApiService)) as ITestPlanSuggestionsApiService;
    private bool _loading = true;
    private ManualTestingWorkspace.Snapshot? _ws;
    private ICurrentWorkspaceProjection? _projection;
    private bool CanWrite => _ws?.Plans?.CanWrite == true && Api is not null;
    private IReadOnlyList<TestPlanDraftSummary> Active => _ws?.Plans?.Drafts ?? [];

    /// <summary>«Ny testplan»: a clean draft, created when the tester starts it — its own name (date and time of now) and its own request id. Nothing of
    /// another plan (cases, revision, approvals, Azure DevOps links) is part of it.</summary>
    private sealed class NewPlanDraft(string name)
    {
        public string Name { get; set; } = name;
        public bool WithSelection { get; set; }
        public string RequestId { get; } = Guid.NewGuid().ToString("N");
    }

    private NewPlanDraft? _new;
    private bool _creating;
    private string? _createError;
    private TestPlanDraft? _created;
    private List<string> _selection = [];

    private TestPlanDraft? _transfer;
    private bool _transferLoading;
    private string? _transferError;

    /// <summary>Back on Testoversikt from Testplaner (the same page component): read the figures when they are not there yet.</summary>
    protected override async Task OnParametersSetAsync()
    {
        if (IsHome && !_loading && _ws is not null && _overview is null && !_overviewLoading && _overviewError is null) await LoadOverviewAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        // An older link to the overview with a Testplaner action (?transfer=, ?create=, ?plans=) belongs on «3. Testplaner».
        if (IsHome && (TransferQuery is not null || CreateQuery is not null || PlansQuery is not null))
        {
            var query = Nav.Uri[Nav.Uri.IndexOf('?')..];
            Nav.NavigateTo(M.PlansRoute + query, replace: true); // same component: loading continues below with the same query
        }
        _projection = ServiceProvider.GetService(typeof(ICurrentWorkspaceProjection)) as ICurrentWorkspaceProjection;
        if (_projection is not null) _projection.Changed += OnProjectChanged;
        await LoadAsync();
        if (CreateQuery == "1" && CanWrite) StartNew();
        if (Guid.TryParse(TransferQuery, out var transferId)) await LoadTransferAsync(transferId);
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _ws = await new ManualTestingWorkspace(ServiceProvider).LoadAsync(requirements: true);
            if (_ws.ProjectKey is { } key) _selection = await TabDraftStore.ReadAsync<List<string>>(JS, TabDraftStore.SelectionKey(key)) ?? [];
            // v1.0 acceptance (2026-11-25): with execution in BirkNext switched on, results are not only in Azure DevOps — say where they are.
            if (ServiceProvider.GetService(typeof(IManualTestRunsApiService)) is IManualTestRunsApiService runs)
                try { _executionEnabled = await runs.AvailabilityAsync(); } catch (Exception e) when (e is not OperationCanceledException) { _executionEnabled = false; }
            if (IsHome) await LoadOverviewAsync();
        }
        finally { _loading = false; }
    }

    private void StartNew()
    {
        // Every start is a new draft: a new suggested name (local time now) and a new request id; the previous draft is never reused.
        _new = new NewPlanDraft(M.SuggestedPlanName(DateTime.Now));
        (_createError, _created) = (null, null);
    }

    private async Task CreateAsync()
    {
        if (_new is not { } draft || _creating || _ws?.ProjectKey is not { } key || Api is not { } api) return;
        if (string.IsNullOrWhiteSpace(draft.Name)) { _createError = "Gi testplanen et navn."; return; }
        _creating = true; _createError = null;
        try
        {
            var withSelection = draft.WithSelection && _selection.Count > 0 && _ws.Discovery is not null;
            var (plan, error) = await api.CreateProjectAsync(new CreateProjectTestPlanRequest
            {
                ProjectKey = key, ProjectName = _ws.ProjectName, PlanName = draft.Name.Trim(), CreationRequestId = draft.RequestId,
                DiscoveryId = withSelection ? _ws.Discovery!.DiscoveryId : "", CandidateIds = withSelection ? [.. _selection] : [], AllowEmpty = !withSelection,
            });
            // A failed save keeps the draft (same name, same request id: a retry never creates a second test plan).
            if (plan is null) { _createError = P.Friendly(error, "Kunne ikke opprette testplan."); return; }
            if (withSelection) { await TabDraftStore.RemoveAsync(JS, TabDraftStore.SelectionKey(key)); _selection = []; }
            (_new, _created) = (null, plan);
            await LoadAsync();
        }
        finally { _creating = false; }
    }

    private void OpenTransfer(Guid id)
    {
        Nav.NavigateTo(M.TransferRoute(id), replace: true);
        _ = InvokeAsync(async () => { await LoadTransferAsync(id); StateHasChanged(); });
    }

    private async Task LoadTransferAsync(Guid id)
    {
        if (Api is not { } api) return;
        (_transferLoading, _transferError, _transfer) = (true, null, null);
        try
        {
            var (draft, error) = await api.DraftAsync(id);
            if (draft is null || (draft.ProjectKey is { } owner && owner != _ws?.ProjectKey)) { _transferError = error is null ? "Testplanen finnes ikke i denne applikasjonen." : P.Friendly(error, "Testplanen kunne ikke hentes."); return; }
            _transfer = draft;
        }
        finally { _transferLoading = false; }
    }

    private void CloseTransfer() { _transfer = null; Nav.NavigateTo(M.PlansRoute, replace: true); }

    /// <summary>Another project was selected: everything is read again for it (nothing of the previous project stays).</summary>
    private void OnProjectChanged() => _ = InvokeAsync(async () => { _ws = null; _new = null; _created = null; _transfer = null; _selection = []; await LoadAsync(); StateHasChanged(); });

    public void Dispose() { if (_projection is not null) _projection.Changed -= OnProjectChanged; }
}
