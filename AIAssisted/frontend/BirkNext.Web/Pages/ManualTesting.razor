@page "/manual-testing"
@using BirkNext.TestPlanning
@using BirkNext.Web.Services
@using M = BirkNext.Web.Services.ManualTestingPresentation
@implements IDisposable
@inject IServiceProvider ServiceProvider

@* Manual Testing home: which project, what exists, what is in progress, what needs attention and the one next step — from stored records only
   (saved plans, the last stored discovery, manual runs). The three stages are destinations, never gates. *@
<PageTitle>Manual Testing</PageTitle>

<div class="mt" data-testid="mt" aria-busy="@(_loading ? "true" : "false")">
    <BirkNext.Web.Components.TestingWorkspaceHeader Workspace="Manual Testing" HomeRoute="@M.HomeRoute" Stages="M.Stages" Current="@null" Title="Manual Testing"
        ProjectName="@_ws?.ProjectName" Context="@_ws?.SnapshotBasis"
        Lead="Your manual testing work for the selected project in one place: understand what needs testing, prepare test cases, run them and record what happened.">
        <Help><BirkNext.Web.Components.HelpLink Topic="manual-testing" Text="How this works" /></Help>
    </BirkNext.Web.Components.TestingWorkspaceHeader>

    @if (_loading)
    {
        <p class="mt-muted" role="status" data-testid="mt-loading">Loading the project's test work…</p>
    }
    else if (_ws is null)
    {
        <p class="mt-muted" data-testid="mt-error">Manual Testing could not be loaded.</p>
    }
    else
    {
        var facts = _ws.Facts;
        var next = M.Next(facts);
        @if (_ws.Error is { } error)
        {
            <p class="mt-alert" role="alert" data-testid="mt-error">@error <button type="button" class="btn btn-secondary btn-sm" @onclick="LoadAsync" data-testid="mt-retry">Try again</button></p>
        }
        <section class="mt-next" aria-labelledby="mt-next-title" data-testid="mt-next">
            <h2 id="mt-next-title" class="mt-h">Next step</h2>
            <a class="btn btn-primary" href="@next.Href" data-testid="mt-next-action">@next.Label</a>
            <p class="mt-muted" data-testid="mt-next-why">@next.Why</p>
        </section>

        <BirkNext.Web.Components.GuidedStepList Steps="@M.Steps(facts)" TitleLevel="2" TestId="mt-stages" StepTestId="mt-stage" Label="Manual Testing stages" />

        @if (facts.ProjectKey is not null)
        {
            <div class="mt-grid">
                <section class="mt-card" aria-labelledby="mt-plans-title" data-testid="mt-plans">
                    <h2 id="mt-plans-title" class="mt-h">Saved plans</h2>
                    @if (facts.Plans.Count == 0)
                    {
                        <p class="mt-muted" data-testid="mt-plans-none">No plan yet. <a href="@($"{M.PlanRoute}?area=choose")">Choose scenarios</a> or write a test case by hand in Plan &amp; prepare.</p>
                    }
                    else
                    {
                        <ul class="mt-list">
                            @foreach (var p in facts.Plans.Take(8))
                            {
                                <li data-testid="mt-plan">
                                    <a href="@($"{M.PlanRoute}?draft={p.Id}&area=prepare")"><strong>@p.PlanName</strong></a>
                                    <a class="mt-muted" href="@($"{M.PlanRoute}?draft={p.Id}&area=export")" data-testid="mt-plan-export">Export to Azure DevOps</a>
                                    <span class="mt-muted">@p.Cases case@(p.Cases == 1 ? "" : "s") · @p.Accepted approved@(p.NeedsClarification > 0 ? $" · {p.NeedsClarification} need clarification" : "") · saved @p.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                                </li>
                            }
                        </ul>
                    }
                </section>
                <section class="mt-card" aria-labelledby="mt-runs-title" data-testid="mt-runs">
                    <h2 id="mt-runs-title" class="mt-h">Test runs</h2>
                    @if (facts.Runs.Count == 0)
                    {
                        <p class="mt-muted" data-testid="mt-runs-none">No test run recorded yet. Open a saved case and choose <em>Run this test case</em>, or start one in <a href="@M.ExecuteRoute">Execute &amp; document</a>.</p>
                    }
                    else
                    {
                        <ul class="mt-list">
                            @foreach (var r in M.InProgress(facts).Concat(M.Completed(facts).OrderByDescending(x => x.CompletedAt)).Take(8))
                            {
                                <li data-testid="mt-run" data-state="@r.State" data-outcome="@r.Outcome">
                                    <a href="@($"{M.ExecuteRoute}?run={r.Id}")">@r.Title</a>
                                    <span class="mt-chip mt-tone-@M.RunTone(r.State, r.Outcome)">@M.RunLabel(r.State, r.Outcome)</span>
                                    <span class="mt-muted">@((r.CompletedAt ?? r.StartedAt).ToLocalTime().ToString("yyyy-MM-dd HH:mm")) · @r.Tester@(r.OpenDefects > 0 ? $" · {r.OpenDefects} open defect{(r.OpenDefects == 1 ? "" : "s")}" : "")</span>
                                </li>
                            }
                        </ul>
                    }
                </section>
            </div>
            <p class="mt-muted mt-boundary">Counts come from saved records only. A prepared or approved test case is not an executed test; a run's result is what the tester recorded. Nothing is sent to Azure DevOps.</p>
        }
    }
</div>

@code {
    private bool _loading = true;
    private ManualTestingWorkspace.Snapshot? _ws;
    private ICurrentWorkspaceProjection? _projection;

    protected override async Task OnInitializedAsync()
    {
        _projection = ServiceProvider.GetService(typeof(ICurrentWorkspaceProjection)) as ICurrentWorkspaceProjection;
        if (_projection is not null) _projection.Changed += OnProjectChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try { _ws = await new ManualTestingWorkspace(ServiceProvider).LoadAsync(requirements: true); }
        finally { _loading = false; }
    }

    /// <summary>Another project was selected: everything is read again for it (nothing of the previous project stays).</summary>
    private void OnProjectChanged() => _ = InvokeAsync(async () => { _ws = null; await LoadAsync(); StateHasChanged(); });

    public void Dispose() { if (_projection is not null) _projection.Changed -= OnProjectChanged; }
}
