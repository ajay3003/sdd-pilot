    /// <summary>A coverage bar's module or specification: chosen in the shared selection, and the figures follow it.</summary>
    private async Task NarrowAsync(O.Scope narrow)
    {
        if (_drillBusy) return;
        _drillBusy = true; _drillError = null;
        try
        {
            string? refused = null;
            if (narrow.Level == O.Level.Specification && narrow.Module is { } m && narrow.SpecificationPath is { } path)
                refused = await ManualTestingDrillNavigation.SelectSpecificationAsync(ServiceProvider, m, path);
            else if (narrow.Module is { } module && ServiceProvider.GetService(typeof(BirkNext.Web.Services.Explorers.IArtifactExplorerContext)) is BirkNext.Web.Services.Explorers.IArtifactExplorerContext explorer)
                try { await explorer.SelectModuleAsync(module == ManualTestingDrillNavigation.ProjectLevelModule ? BirkNext.Web.Services.Explorers.ArtifactModules.ProjectLevel : module); }
                catch (Exception e) when (e is not OperationCanceledException) { refused = "Modulen kunne ikke velges: " + e.Message; }
            if (refused is not null) { _drillError = refused; return; }
            await ReadScopeAsync();
            _level = narrow.Level;
            if (_level == O.Level.Specification && _specPath is null || _level == O.Level.Module && _module is null) { _drillError = "Utvalget kunne ikke brukes."; return; }
            _drill = null;
            _pickerKey++;
