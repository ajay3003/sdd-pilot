    /// <summary>A plan's scenario-level execution as one segmented SVG bar with a printed legend (never colour alone; never across plans).</summary>
    private static RenderFragment ExecutionBar(PlanExecutionCounts ex) => __builder =>
    {
        var total = Math.Max(1, ex.Scenarios);
        var segments = new[] { ("passed", ex.Passed, "bestått"), ("failed", ex.Failed, "feilet"), ("blocked", ex.Blocked, "blokkert"), ("notrun", ex.NotRun, "ikke kjørt") };
        var x = 0.0;
        <div class="mto-exec" data-testid="mto-plan-exec" data-notrun="@ex.NotRun" data-passed="@ex.Passed" data-failed="@ex.Failed" data-blocked="@ex.Blocked">
            <svg class="mto-exec-bar" viewBox="0 0 100 6" preserveAspectRatio="none" role="img" aria-label="@($"Gjennomføring i denne planen: {ex.Passed} bestått, {ex.Failed} feilet, {ex.Blocked} blokkert, {ex.NotRun} ikke kjørt av {ex.Scenarios} scenarioer")">
                @foreach (var (key, n, _) in segments.Where(sg => sg.Item2 > 0))
                {
                    var w = 100.0 * n / total;
                    <rect class="mto-exec-seg is-@key" x="@x.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)" y="0" width="@w.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)" height="6" />
                    x += w;
                }
            </svg>
            <span class="mto-exec-legend">@foreach (var (key, n, label) in segments) { <span class="mto-exec-item is-@key"><span class="mto-exec-dot" aria-hidden="true"></span>@n @label</span> }</span>
        </div>
    };

    private string _sortCol = "name";
    private bool _sortDesc;

    private void SortBy(string col) { if (_sortCol == col) _sortDesc = !_sortDesc; else { _sortCol = col; _sortDesc = col != "name"; } }

    private IEnumerable<O.Row> SortRows(IReadOnlyList<O.Row> rows)
    {
        if (_sortCol == "name" && !_sortDesc) return rows; // the presentation's own order
        Func<O.Row, IComparable> key = _sortCol switch
        {
            "scenarios" => r => r.Scenarios ?? -1, "covered" => r => r.Covered ?? -1, "cases" => r => r.Cases, "approved" => r => r.Approved, "followup" => r => r.FollowUp,
            _ => r => r.Label,
        };
        return _sortDesc ? rows.OrderByDescending(key) : rows.OrderBy(key);
    }

