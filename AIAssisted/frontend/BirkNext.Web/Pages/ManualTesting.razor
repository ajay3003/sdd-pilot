@page "/manual-testing"
@using BirkNext.TestPlanning
@using BirkNext.Web.Services
@using M = BirkNext.Web.Services.ManualTestingPresentation
@implements IDisposable
@inject IServiceProvider ServiceProvider

@* Manuell testing (2026-11-23): the tester's work at a glance — the one next step, real counts from saved records (suggestions are never counted
   as test cases), and the saved plans with their source status. The two stages are in the header only (no second navigation). Test cases are
   executed in Azure DevOps Test Plans after the export. *@
<PageTitle>Manuell testing</PageTitle>

<div class="mt msb-page" data-testid="mt" aria-busy="@(_loading ? "true" : "false")">
    <BirkNext.Web.Components.TestingWorkspaceHeader Workspace="Manuell testing" HomeRoute="@M.HomeRoute" Stages="M.Stages" Current="@null" Title="Manuell testing"
        ProjectName="@_ws?.ProjectName" Context="@_ws?.SnapshotBasis"
        Lead="Finn scenarioene som må testes, forbered og gjennomgå testtilfeller, og eksporter dem til Azure DevOps Test Plans.">
        <Help><BirkNext.Web.Components.HelpLink Topic="manual-testing" Text="Slik fungerer det" /></Help>
    </BirkNext.Web.Components.TestingWorkspaceHeader>

    @if (_loading)
    {
        <div class="msb-skeleton" role="status" data-testid="mt-loading"><span>Laster …</span></div>
    }
    else if (_ws is null)
    {
        <p class="msb-empty" data-testid="mt-error">Manuell testing kunne ikke lastes.</p>
    }
    else
    {
        var facts = _ws.Facts;
        var next = M.Next(facts);
        @if (_ws.Error is { } error)
        {
            <p class="mt-alert" role="alert" data-testid="mt-error">@error <button type="button" class="btn btn-secondary btn-sm" @onclick="LoadAsync" data-testid="mt-retry">Prøv igjen</button></p>
        }
        <section class="msb-next" aria-labelledby="mt-next-title" data-testid="mt-next">
            <div>
                <h2 id="mt-next-title" class="msb-h">Neste steg</h2>
                <p class="mt-muted" data-testid="mt-next-why">@next.Why</p>
            </div>
            <a class="btn btn-primary" href="@next.Href" data-testid="mt-next-action">@next.Label</a>
        </section>

        @if (facts.ProjectKey is not null)
        {
            var plans = facts.Plans;
            var cases = plans.Sum(p => p.Cases);
            var approved = plans.Sum(p => p.Accepted);
            var clarify = plans.Sum(p => p.NeedsClarification);
            var statuses = _ws.Plans?.PlanStatus;
            <dl class="msb-counts msb-counts-wide" data-testid="mt-counts" aria-label="Status for applikasjonen">
                <div><dt>Forslag</dt><dd data-testid="mt-count-suggestions">@(_ws.Discovery?.Candidates.Count.ToString() ?? "—")</dd></div>
                <div><dt>Testtilfeller</dt><dd data-testid="mt-count-cases">@cases</dd></div>
                <div><dt>Godkjent</dt><dd data-testid="mt-count-approved">@approved</dd></div>
                <div class="@(clarify > 0 ? "is-warn" : null)"><dt>Trenger avklaring</dt><dd data-testid="mt-count-clarify">@clarify</dd></div>
                <div><dt>Lagrede planer</dt><dd data-testid="mt-count-plans">@plans.Count</dd></div>
            </dl>

            <section aria-labelledby="mt-plans-title" data-testid="mt-plans">
                <h2 id="mt-plans-title" class="msb-h">Lagrede planer</h2>
                @if (plans.Count == 0)
                {
                    <p class="msb-empty" data-testid="mt-plans-none">Ingen plan ennå. <a href="@M.DiscoverRoute">Velg scenarioer</a> eller skriv et testtilfelle selv i Planlegg og forbered.</p>
                }
                else
                {
                    <ul class="msb-plans">
                        @foreach (var p in plans.Take(8))
                        {
                            var status = statuses is not null && statuses.TryGetValue(p.Id, out var s) ? s : null;
                            <li class="msb-plan" data-testid="mt-plan">
                                <div class="msb-plan-main">
                                    <a href="@($"{M.PlanRoute}?draft={p.Id}&area=prepare")" class="msb-plan-name"><strong>@p.PlanName</strong></a>
                                    <span class="mt-muted msb-small">@p.Cases testtilfelle@(p.Cases == 1 ? "" : "r") · @p.Accepted godkjent@(p.NeedsClarification > 0 ? $" · {p.NeedsClarification} trenger avklaring" : "") · lagret @p.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                                </div>
                                @if (status is not null)
                                {
                                    <span class="msb-status msb-tone-@(status.State switch { "Klar" => "ok", "Må gjennomgås" or "Kilde mangler" => "warn", "Ny kildeversjon" => "info", _ => "muted" })" title="@status.Message" data-testid="mt-plan-source">@status.State</span>
                                }
                                <a class="btn btn-secondary btn-sm" href="@($"{M.PlanRoute}?draft={p.Id}&area=prepare")" data-testid="mt-plan-open">Åpne</a>
                                <a class="msb-link" href="@($"{M.PlanRoute}?draft={p.Id}&area=export")" data-testid="mt-plan-export">Eksporter</a>
                            </li>
                        }
                    </ul>
                }
            </section>
            <p class="mt-muted msb-small mt-boundary">Tallene kommer fra lagrede data. Et forslag er ikke et testtilfelle, og et forberedt, godkjent eller eksportert testtilfelle er ikke en kjørt test: manuelle tester kjøres, og resultatene registreres, i Azure DevOps Test Plans. BirkNext skriver aldri til Azure DevOps; eksporten er en fil du importerer der.</p>
        }
    }
</div>

@code {
    private bool _loading = true;
    private ManualTestingWorkspace.Snapshot? _ws;
    private ICurrentWorkspaceProjection? _projection;

    protected override async Task OnInitializedAsync()
    {
        _projection = ServiceProvider.GetService(typeof(ICurrentWorkspaceProjection)) as ICurrentWorkspaceProjection;
        if (_projection is not null) _projection.Changed += OnProjectChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try { _ws = await new ManualTestingWorkspace(ServiceProvider).LoadAsync(requirements: true); }
        finally { _loading = false; }
    }

    /// <summary>Another project was selected: everything is read again for it (nothing of the previous project stays).</summary>
    private void OnProjectChanged() => _ = InvokeAsync(async () => { _ws = null; await LoadAsync(); StateHasChanged(); });

    public void Dispose() { if (_projection is not null) _projection.Changed -= OnProjectChanged; }
}
