    /// <summary>A share of a real count as a thin meter with its text (never colour or length alone).</summary>
    private static RenderFragment Meter(int part, int whole, string what) => __builder =>
    {
        var width = whole <= 0 ? 0 : Math.Round(100.0 * part / whole, 2);
        var share = O.Share(part, whole);
        <span class="mto-meter" role="img" aria-label="@($"{part} av {whole} {what} ({share})")" title="@($"{part:N0} av {whole:N0} {what}")" data-testid="mto-meter">
            <span class="mto-meter-bar" aria-hidden="true"><span class="mto-meter-fill" style="width:@(width.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span></span>
            <span class="mto-meter-t" aria-hidden="true">@share @what</span>
        </span>
    };

    /// <summary>The figures for the project, read once (one request); a newer request makes an older answer irrelevant.</summary>
    private async Task LoadOverviewAsync()
    {
        if (_ws?.ProjectKey is not { } key || Api is not { } api) return;
        var generation = ++_overviewGeneration;
        _overviewLoading = true; _overviewError = null;
        try
        {
            var settingsTask = api.DashboardSettingsAsync();
            var overviewTask = api.OverviewAsync(key);
            var scopeTask = ReadScopeAsync();
            var (overview, error) = await overviewTask;
            var (settings, _) = await settingsTask;
            await scopeTask;
            if (generation != _overviewGeneration) return;
            _overview = overview; _overviewError = overview is null ? error ?? "Ukjent feil." : null;
            _dashboard = settings ?? new();
        }
        finally { if (generation == _overviewGeneration) _overviewLoading = false; }
    }

    /// <summary>The shared module and specification (the same choice Finn og forstå uses).</summary>
    private async Task ReadScopeAsync()
    {
        if (ServiceProvider.GetService(typeof(BirkNext.Web.Services.Explorers.IArtifactExplorerContext)) is not BirkNext.Web.Services.Explorers.IArtifactExplorerContext explorer) return;
        try
        {
            var state = await explorer.GetStateAsync(BirkNext.Web.Services.WorkspaceArtifactType.Specification);
            _module = string.IsNullOrEmpty(state.Module) ? null : state.Module;
            _specPath = state.Status == BirkNext.Web.Services.Explorers.ExplorerArtifactStatus.Loaded ? state.Selected?.SourcePath : null;
            _modules = [.. (state.Modules ?? []).Select(m => m.Module).Where(m => m.Length > 0)];
        }
        catch (Exception e) when (e is not OperationCanceledException) { }
        if (_level == O.Level.Specification && _specPath is null) _level = _module is null ? O.Level.Project : O.Level.Module;
        if (_level == O.Level.Module && _module is null) _level = O.Level.Project;
    }

    private async Task OnScopeChangedAsync()
    {
        _drill = null; _drillError = null;
        await ReadScopeAsync();
        StateHasChanged();
    }

