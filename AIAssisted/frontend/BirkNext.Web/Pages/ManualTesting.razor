@page "/manual-testing"
@page "/manual-testing/plans"
@using BirkNext.TestPlanning
@using BirkNext.Web.Services
@using M = BirkNext.Web.Services.ManualTestingPresentation
@using P = BirkNext.Web.Services.PlanPreparePresentation
@using O = BirkNext.Web.Services.ManualTestingOverviewPresentation
@implements IDisposable
@inject IServiceProvider ServiceProvider
@inject NavigationManager Nav
@inject IJSRuntime JS

@* «3. Testplaner» (2026-11-25), the last Manual Testing tab: create, open, archive and transfer the project's test plans. The same page as the Manual
   Testing home (/manual-testing) — no second test plan system: the saved plans, their counts and «Neste steg» come from the same stored records,
   creation uses the same create call (an explicit empty plan or the scenarios chosen in Finn og forstå), and «Overfør testplan» is the same transfer
   panel (file export by default, direct transfer opt-in). Project is the scope: plans are never hidden because another module is selected. *@
@* UX pass (2026-11-25): /manual-testing is the workspace OVERVIEW («Manuell testing»: one next step, the three steps with their status, the
   counts collapsed); /manual-testing/plans is «3. Testplaner» (create, list, transfer). Before, both addresses showed the Testplaner page, so the
   «Manuell testing» tab led to «Testplaner» and was never marked as the current page. *@
<PageTitle>@(IsHome ? "Testoversikt — Manuell testing" : "Testplaner — Manuell testing")</PageTitle>

<div class="mt msb-page @(IsHome ? "mto-page" : null) @(_draft is not null ? "is-customizing" : null)" data-testid="mt" aria-busy="@(_loading ? "true" : "false")">
    <BirkNext.Web.Components.TestingWorkspaceHeader Workspace="Manuell testing" HomeRoute="@M.HomeRoute" Stages="M.Stages" Current="@(IsHome ? null : "plans")" Title="@(IsHome ? "Testoversikt" : "Testplaner")"
        ProjectName="@_ws?.ProjectName" Context="@_ws?.SnapshotBasis"
        Lead="@(IsHome ? "Testforberedelse, dekning og prioriteringer. Velg modul og spesifikasjon her; Finn og forstå viser det samme utvalget." : "Opprett, åpne og overfør testplanene for applikasjonen. Testtilfellene forberedes i Planlegg og klargjør.")">
        <Help><BirkNext.Web.Components.HelpLink Topic="manual-testing" Text="Slik fungerer det" /></Help>
    </BirkNext.Web.Components.TestingWorkspaceHeader>

    @if (_loading)
    {
        <InlineLoading Text="Henter testplaner …" Class="msb-skeleton" TestId="mt-loading" />
    }
    else if (_ws is null)
    {
        <p class="msb-empty" data-testid="mt-error">Manuell testing kunne ikke lastes. <button type="button" class="msb-link" @onclick="LoadAsync">Prøv igjen</button></p>
    }
    else
    {
        var facts = _ws.Facts;
        var next = M.Next(facts);
        @if (_ws.Error is { } error)
        {
            <p class="mt-alert" role="alert" data-testid="mt-error">@error <button type="button" class="btn btn-secondary btn-sm" @onclick="LoadAsync" data-testid="mt-retry">Prøv igjen</button></p>
        }

        @if (facts.ProjectKey is not null && IsHome)
        {
            @* Testoversikt (2026-11-25): the shared selection (module → specification, the same one Finn og forstå reads), the scope the figures use,
               and the parts System Settings → Manuell testing → Testoversikt switches on. Preparation, coverage, readiness, approval and source status
               only — never execution results. *@
            <BirkNext.Web.Components.SpecificationScopePicker @key="_pickerKey" Changed="OnScopeChangedAsync" ShowDiscoverLink="false" />
            @* Testoversikt redesign (2026-11-26): one toolbar for the scope, the four core figures first, then what needs follow-up, test readiness,
               modules and the rest. Widget ids, settings and figures are unchanged; only the presentation and order changed. *@
            <div class="mto-toolbar" data-testid="mto-toolbar">
                <div class="mto-head">
                    <div class="mtp-seg" role="radiogroup" aria-label="Tallene gjelder" data-testid="mto-level">
                        @foreach (var (level, text, enabled) in new[] { (O.Level.Project, "Hele prosjektet", true), (O.Level.Module, "Valgt modul", _module is not null), (O.Level.Specification, "Valgt spesifikasjon", _specPath is not null) })
                        {
                            var l = level;
                            <button type="button" role="radio" class="mtp-seg-btn @(_level == l ? "is-on" : null)" aria-checked="@(_level == l ? "true" : "false")" disabled="@(!enabled)"
                                    @onclick="() => SetLevel(l)" data-level="@l" data-testid="mto-level-option">@text</button>
                        }
                    </div>
                    <span class="mto-scope-chip" title="@O.ScopeLabel(CurrentScope)" data-testid="mto-scope">@O.ScopeLabel(CurrentScope)</span>
                    @if (CanWrite && _draft is null) { <button type="button" class="msb-link msb-small mto-customize" @onclick="EnterCustomize" data-testid="mto-customize">Tilpass oversikten</button> }
                </div>
            </div>
            @if (_overviewLoading)
            {
                <InlineLoading Text="Henter testoversikt …" Class="mt-muted" TestId="mto-loading" />
            }
            else if (_overviewError is { } oe)
            {
                <p class="mt-alert" role="alert" data-testid="mto-error">Kunne ikke hente testoversikten. @oe <button type="button" class="msb-link" @onclick="LoadOverviewAsync" data-testid="mto-retry">Prøv igjen</button></p>
            }
            else if (_overview is { } ov)
            {
                var slice = O.Of(ov, CurrentScope);
                var fig = O.Compute(slice, ov.Plans);
                var explain = On("display.explanations");
                var attention = O.P1Attention(slice);
                var blockers = O.Blockers(slice);
                var changes = O.SourceChanges(slice);
                @if (_draft is not null) { @CustomizePanel() }
                var kpis = ManualTestingDashboard.KpiSequence(View).Where(KpiShown).ToList();
                <section class="mto-kpis mto-kpis-core" aria-label="Nøkkeltall" data-count="@kpis.Count" data-testid="mto-kpis">
                    @foreach (var kpiId in kpis)
                    {
                        <div class="mto-kpi-slot" data-slot="@kpiId" @key="kpiId">
                            @CoreKpi(kpiId, fig, slice, explain)
                            @if (_draft is not null)
                            {
                                var pos = kpis.IndexOf(kpiId);
                                var name = KpiName(kpiId);
                                <span class="mto-slot-tools" role="group" aria-label="@($"Ordne {name}")" data-testid="mto-slot-tools">
                                    <button type="button" class="mtp-icon" disabled="@(pos == 0)" @onclick="() => MoveKpi(kpiId, -1, kpis)" aria-label="@($"Flytt {name} til venstre")" data-testid="mto-slot-up">←</button>
                                    <button type="button" class="mtp-icon" disabled="@(pos == kpis.Count - 1)" @onclick="() => MoveKpi(kpiId, 1, kpis)" aria-label="@($"Flytt {name} til høyre")" data-testid="mto-slot-down">→</button>
                                    <button type="button" class="msb-link msb-small" @onclick="() => SetShown(kpiId, false)" data-testid="mto-slot-hide">Skjul flis</button>
                                </span>
                            }
                        </div>
                    }
                </section>
                @if (_tileError is { } tileError) { <p class="msb-error" role="alert" data-testid="mto-tile-error">@tileError</p> }
                @if (_tileNotice is { } tileNotice) { <p class="mt-muted msb-small" role="status" data-testid="mto-tile-notice">@tileNotice</p> }
                @if (_tileEditing)
                {
                    <BirkNext.Web.Components.ManualTesting.KpiTileEditor Tile="_tileEdit" Count="TileCountNow" Busy="_tileBusy"
                        OnSave="SaveEditedTileAsync" OnCancel="() => _tileEditing = false" />
                }
                <section class="mto-kpis mto-kpis-secondary" aria-label="Flere nøkkeltall" data-testid="mto-kpis-secondary">
                    @if (On("metric.testPlans"))
                    {
                        <a class="mto-kpi" href="@M.PlansRoute" data-testid="mto-kpi" data-widget="metric.testPlans"><span class="mto-kpi-k">Testplaner</span><span class="mto-kpi-v">@fig.Plans</span>
                            @if (explain) { <span class="mto-kpi-e">Med testtilfeller i utvalget</span> }</a>
                    }
                    @* 2026-11-26: optional user story status and scenario type figures (unique stories / unique acceptance scenarios; «—» when unavailable). *@
                    @Kpi("metric.usInProgress", "US under utvikling", O.StoriesInProgress(slice), "Noen, men ikke alle, oppgaver i tasks.md er fullført", explain)
                    @Kpi("metric.usOpenTasks", "US med uferdige oppgaver", O.StoriesWithOpenTasks(slice), "Minst én direkte oppgave er ikke fullført", explain)
                    @Kpi("metric.usTasksCompleted", "US-oppgaver fullført", O.StoriesTasksCompleted(slice), "Alle oppgaver avkrysset — ikke det samme som implementert", explain)
                    @Kpi("metric.usNeedsClarification", "US-status må avklares", O.StoriesNeedingClarification(slice), "Motstridende eller uforklarte oppgavemarkeringer", explain)
                    @Kpi("metric.functionalScenarios", "Funksjonelle scenarioer", O.ScenariosOfType(slice, ScenarioRequirementType.Functional), "Akseptansescenarioer om oppførsel eller resultat", explain)
                    @Kpi("metric.nonFunctionalScenarios", "Ikke-funksjonelle scenarioer", O.ScenariosOfType(slice, ScenarioRequirementType.NonFunctional), "Blandede scenarioer telles ikke her", explain)
                </section>

                @* «Dette bør følges opp»: only follow-up computed from stored data; a short empty state when nothing in the scope needs it. *@
                var actionWidgets = new[] { "panel.p1Attention", "chart.blockers", "chart.sourceChanges" }.Where(On).ToList();
                @if (actionWidgets.Count > 0)
                {
                    var anyAction = (On("panel.p1Attention") && attention.Count > 0) || (On("chart.blockers") && blockers.Any(b => b.Value > 0)) || (On("chart.sourceChanges") && changes.Any(b => b.Value > 0));
                    <section class="mto-band mto-band-action" aria-labelledby="mto-band-action-h" data-testid="mto-band" data-band="action">
                        <h2 class="mto-band-h" id="mto-band-action-h">Dette bør følges opp</h2>
                        @if (!anyAction)
                        {
                            <p class="mto-band-empty" data-testid="mto-action-empty">Ingenting i utvalget krever oppfølging nå: ingen P1-scenarioer mangler testtilfeller, og ingen testtilfeller er blokkert eller har endret kilde.</p>
                        }
                        <div class="mto-grid mto-grid-3">
                            @if (On("panel.p1Attention") && attention.Count > 0)
                            {
                                <section class="mto-card mto-attention" data-testid="mto-widget" data-widget="panel.p1Attention"><h3 class="mto-card-h">Viktig å følge opp</h3>
                                    <ul class="mto-action-list">@foreach (var (k, text) in attention)
                                        { var key = k; <li data-key="@k"><button type="button" class="mto-action-item mto-attention-open" aria-pressed="@(IsDrill("panel.p1Attention", k) ? "true" : "false")"
                                            @onclick="@(() => ToggleDrill("panel.p1Attention", key))" data-testid="mto-attention-open"><span>@text</span><span class="mto-action-go" aria-hidden="true">›</span></button></li> }</ul>
                                    <p class="msb-small mto-card-links"><a href="@M.DiscoverRoute">Se scenarioer</a> · <a href="@M.PlanRoute">Se testtilfeller</a></p></section>
                            }
                            @ActionList("chart.blockers", "Testbarhet og blokkeringer", "blocker", blockers, $"{O.NotReady(slice)} av {fig.Cases} testtilfeller er ikke klare. Ett testtilfelle kan ha flere årsaker.")
                            @ActionList("chart.sourceChanges", "Kildeendringer", "source", changes, "Sammenlignet med testtilfellets egen spesifikasjon. «Kunne ikke sammenlignes» betyr ikke at noe er fjernet.")
                            @if (On("panel.testPlans") && ov.Plans.Where(pl => pl.Execution is { NotRun: > 0 } || pl.Execution is { Failed: > 0 } || pl.Execution is { Blocked: > 0 }).ToList() is { Count: > 0 } open)
                            {
                                <section class="mto-card mto-actions-card" data-testid="mto-widget" data-widget="panel.planExecution"><h3 class="mto-card-h">Sprintplaner med gjenstående AC-er</h3>
                                    <p class="mt-muted msb-small mto-card-note">Resultater registreres per scenario i hver testplan.</p>
                                    <ul class="mto-action-list">
                                        @foreach (var pl in open.Take(5))
                                        {
                                            var ex = pl.Execution!;
                                            <li><a class="mto-action-item" href="@M.PlansRoute" data-testid="mto-plan-open-items">
                                                <span class="mto-action-icon is-plan" aria-hidden="true"></span>
                                                <span class="mto-action-count">@ex.NotRun</span>
                                                <span class="mto-action-text">ikke kjørt i «@pl.Name»@(ex.Failed + ex.Blocked > 0 ? $" · {ex.Failed} feilet · {ex.Blocked} blokkert" : "")</span>
                                                <span class="mto-action-go" aria-hidden="true">›</span></a></li>
                                        }
                                    </ul></section>
                            }
                        </div>
                    </section>
                }

                <section class="mto-band" aria-labelledby="mto-band-ready-h" data-testid="mto-band" data-band="readiness">
                    <h2 class="mto-band-h" id="mto-band-ready-h">Testberedskap</h2>
                    <div class="mto-grid mto-grid-3">
                        @Chart("chart.preparation", "Testforberedelse", O.Preparation(slice), "Trinnene overlapper og summeres ikke.", false)
                        @Chart("chart.priority", "Scenarioer etter prioritet", O.Priority(slice), "Prioritet slik spesifikasjonen oppgir den.", false)
                        @Chart("chart.coverageGaps", "Manglende testdekning", O.Gaps(slice), "Scenarioer uten tilknyttede manuelle testtilfeller (ikke utviklertester).", false)
                    </div>
                </section>

                <section class="mto-band" aria-labelledby="mto-band-modules-h" data-testid="mto-band" data-band="modules">
                    <h2 class="mto-band-h" id="mto-band-modules-h">@(_level switch { O.Level.Project => "Moduler", O.Level.Module => "Spesifikasjoner", _ => "Brukerhistorier" })</h2>
                    <div class="mto-grid mto-grid-wide">
                        @Chart("chart.moduleCoverage", _level switch { O.Level.Project => "Testdekning per modul", O.Level.Module => "Testdekning per spesifikasjon", _ => "Testdekning per brukerhistorie" },
                            O.Coverage(slice, _level), slice.ScenariosAvailable ? "Andel scenarioer med minst ett lagret manuelt testtilfelle — ikke utviklertestdekning." : "Ikke tilgjengelig: spesifikasjonen er ikke lagret for prosjektet.", true, wide: true, limit: 8)
                        @Chart("chart.moduleApproval", "Godkjenning per modul", O.ModuleApproval(slice), "Godkjente av lagrede testtilfeller.", false, limit: 8)
                    </div>
                    @if (On("display.moduleOverview") && O.Rows(slice, _level) is { Count: > 0 } rows)
                    {
                        <section class="mto-card mto-table-card" data-testid="mto-widget" data-widget="display.moduleOverview">
                            <h3 class="mto-card-h">@(_level switch { O.Level.Project => "Oversikt per modul", O.Level.Module => "Oversikt per spesifikasjon", _ => "Oversikt per brukerhistorie" })</h3>
                            <div class="mto-table-scroll" tabindex="0" role="region" aria-label="Tabell med tall per rad">
                            <table class="mto-table">
                                <thead><tr>
                                    @foreach (var (col, head) in new[] { ("name", _level switch { O.Level.Project => "Modul", O.Level.Module => "Spesifikasjon", _ => "Brukerhistorie" }), ("scenarios", "Scenarioer"), ("covered", "Med testtilfeller"), ("cases", "Testtilfeller"), ("approved", "Godkjent"), ("followup", "Trenger oppfølging") })
                                    {
                                        var c = col;
                                        <th scope="col" aria-sort="@(_sortCol == c ? (_sortDesc ? "descending" : "ascending") : "none")">
                                            <button type="button" class="mto-sort" @onclick="() => SortBy(c)" data-testid="mto-sort" data-col="@c">@head<span class="mto-sort-mark" aria-hidden="true">@(_sortCol == c ? (_sortDesc ? "▾" : "▴") : "")</span></button></th>
                                    }
                                </tr></thead>
                                <tbody>
                                    @foreach (var row in SortRows(rows))
                                    {
                                        var r = row;
                                        <tr data-testid="mto-row" data-key="@row.Key">
                                            <td>@if (_level == O.Level.Project && row.Module is { } mod && mod != "Uten modultilknytning" && _modules.Contains(mod))
                                                { <button type="button" class="msb-link" @onclick="() => OpenModuleAsync(mod)" data-testid="mto-row-open">@row.Label</button> }
                                                else { @row.Label }</td>
                                            <td>@(row.Scenarios?.ToString() ?? "—")</td><td>@(row.Covered?.ToString() ?? "—")</td><td>@row.Cases</td><td>@row.Approved</td><td class="@(row.FollowUp > 0 ? "mto-num-attention" : null)">@row.FollowUp</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            </div>
                        </section>
                    }
                </section>

                @if (_drill is { } dk && O.DrillDown(slice, _level, dk.Chart, dk.Key) is { } drill)
                {
                    @DrillPanel(drill)
                }

                var moreWidgets = new[] { "chart.scenarioReadiness", "chart.manualTechnical", "chart.usImplementation", "chart.scenarioTypes", "chart.nfrCategories", "chart.gapsByType", "chart.history", "panel.testPlans", "panel.recentChanges", "panel.translationReview" };
                @if (moreWidgets.Any(On))
                {
                    <section class="mto-band" aria-labelledby="mto-band-more-h" data-testid="mto-band" data-band="more">
                        <h2 class="mto-band-h" id="mto-band-more-h">Testplaner og mer innsikt</h2>
                        <div class="mto-grid mto-grid-3">
                            @if (On("panel.testPlans") && ov.Plans.Count > 0)
                            {
                                <section class="mto-card mto-plans-card is-wide" data-testid="mto-widget" data-widget="panel.testPlans"><h3 class="mto-card-h">Testplaner <span class="mt-muted msb-small">(hele prosjektet)</span></h3>
                                    <ul class="mto-plan-cards">@foreach (var pl in ov.Plans.OrderByDescending(x => x.UpdatedAt).Take(6))
                                        {
                                            <li class="mto-plan-card" data-testid="mto-plan-card" data-plan="@pl.Id">
                                                <div class="mto-plan-card-head">
                                                    <a class="mto-plan-name" href="@($"{M.PlanRoute}?draft={pl.Id}")" title="@pl.Name">@pl.Name</a>
                                                    @if (pl.SprintLabel is { Length: > 0 } sprint) { <span class="mto-plan-sprint">@sprint</span> }
                                                </div>
                                                <span class="mto-plan-facts mt-muted msb-small">Forberedelse: @pl.Cases testtilfeller · @pl.Approved godkjent@(pl.SourceAttention > 0 ? $" · {pl.SourceAttention} med kildeendring" : "") · endret @pl.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy")</span>
                                                @if (pl.Execution is { Scenarios: > 0 } ex)
                                                {
                                                    @ExecutionBar(ex)
                                                }
                                                else if (pl.Execution is null)
                                                {
                                                    @* An API that predates scenario-level execution sends no counts: never shown as an empty plan (2026-11-26). *@
                                                    <span class="mt-muted msb-small" data-testid="mto-plan-no-exec" data-reason="unavailable">Gjennomføringsstatus er ikke tilgjengelig fra serveren — åpne planen for å se scenarioene.</span>
                                                }
                                                else { <span class="mt-muted msb-small" data-testid="mto-plan-no-exec" data-reason="empty">Gjennomføring: ingen scenarioer i planen ennå</span> }
                                                @if (pl.Suites is { } suites && pl.Execution is { } exs)
                                                {
                                                    <span class="mt-muted msb-small" data-testid="mto-plan-structure">@suites testgrupper · @exs.Scenarios planlagte scenarioer@(pl.PlannedOnly is > 0 ? $" ({pl.PlannedOnly} uten testtilfelle)" : "") · @pl.Cases testtilfeller</span>
                                                }
                                            </li>
                                        }</ul>
                                    <p class="msb-small mto-card-links"><a href="@M.PlansRoute">Se alle testplaner</a></p></section>
                            }
                            @Chart("chart.manualTechnical", "Manuelle og tekniske testtilfeller", O.ManualTechnical(slice), "Testtypen som er valgt for testtilfellet.", false)
                            @Chart("chart.usImplementation", "Implementeringsframdrift for brukerhistorier", O.StoryImplementation(slice),
                                slice.StoriesAvailable ? "Fra oppgavene i tasks.md; hver brukerhistorie telles én gang. «US-oppgaver fullført» er ikke det samme som implementert." : "Ikke tilgjengelig: oppgavene i tasks.md er ikke lest for denne importen.", false)
                            @Chart("chart.scenarioReadiness", "Klargjøring av scenarioer", O.ScenarioReadiness(slice), "Hvert akseptansescenario og hver dokumenterte test telles én gang. Klar til kjøring er ikke et testresultat; valgfrie punkter teller aldri som mangler.", false)
                            @Chart("chart.scenarioTypes", "Scenarioer etter type", O.ScenarioTypes(slice), "Akseptansescenarioer; et blandet scenario telles bare som blandet.", false)
                            @Chart("chart.nfrCategories", "Ikke-funksjonelle scenarioer per kategori", O.NonFunctionalCategories(slice), "Ikke-funksjonelle og blandede scenarioer; et scenario med flere kvalitetsegenskaper står i flere søyler.", false)
                            @Chart("chart.gapsByType", "Manglende dekning etter type", O.GapsByType(slice), "Akseptansescenarioer uten lagret testtilfelle.", false)
                            @if (On("chart.history"))
                            {
                                <section class="mto-card" data-testid="mto-widget" data-widget="chart.history"><h3 class="mto-card-h">Utvikling i testforberedelse</h3>
                                    <p class="mt-muted msb-small" data-testid="mto-history-unavailable">Historiske tall er ikke tilgjengelige: tilstanden på tidligere tidspunkter lagres ikke, og tall beregnes aldri bakover.</p></section>
                            }
                            @if (On("panel.recentChanges") && ov.RecentRevisions.Count > 0)
                            {
                                <section class="mto-card" data-testid="mto-widget" data-widget="panel.recentChanges"><h3 class="mto-card-h">Siste endringer</h3>
                                    <ul class="mto-plans">@foreach (var r in ov.RecentRevisions.Take(8)) { <li>@r.SavedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · <a href="@($"{M.PlanRoute}?draft={r.PlanId}")">@r.PlanName</a> <span class="mt-muted msb-small">versjon @r.Revision · @r.Reason · @r.SavedBy</span></li> }</ul></section>
                            }
                            @Chart("panel.translationReview", "Oversettelser til gjennomgang", O.Translations(slice), "Fra lagret oversettelsesstatus; ingenting oversettes for å vise dette.", false)
                        </div>
                    </section>
                }
            }
        }
        else if (facts.ProjectKey is not null)
        {
            @* 1. Testplan actions *@
            <div class="mt-plan-actions" data-testid="mt-plan-actions">
                <button type="button" class="btn btn-primary" disabled="@(!CanWrite || _creating)" title="@(CanWrite ? null : "Du har ikke tilgang til å opprette testplaner.")"
                        @onclick="StartNew" data-testid="mt-new-plan">+ Ny testplan</button>
                <button type="button" class="btn btn-outline-primary" disabled="@(Active.Count == 0)" title="@(Active.Count == 0 ? "Det finnes ingen aktiv testplan å overføre." : null)"
                        @onclick="() => OpenTransfer(Active[0].Id)" data-testid="mt-transfer">Overfør testplan</button>
                @if (!CanWrite) { <span class="mt-muted msb-small" data-testid="mt-new-plan-why">Du har ikke tilgang til å opprette testplaner.</span> }
            </div>

            @if (_new is { } draft)
            {
                <section class="mt-new-plan" aria-labelledby="mt-new-plan-title" data-testid="mt-new-plan-form">
                    <h2 id="mt-new-plan-title" class="msb-h">Ny testplan</h2>
                    <label class="mtp-field" for="mt-new-plan-name"><span>Navn</span></label>
                    <input id="mt-new-plan-name" class="form-control mt-new-plan-name" maxlength="200" value="@draft.Name" @oninput="e => draft.Name = e.Value?.ToString() ?? string.Empty"
                           disabled="@_creating" aria-describedby="mt-new-plan-help" data-testid="mt-new-plan-name" />
                    <span id="mt-new-plan-help" class="mt-muted msb-small">Foreslått navn med dato og klokkeslett. Du kan skrive et eget navn.</span>
                    @* Three ways to start (2026-11-26): from a template (structure only), completely empty, or from the scenarios chosen in Finn og forstå. *@
                    <fieldset class="mt-new-plan-methods" data-testid="mt-new-plan-methods">
                        <legend class="mtp-field"><span>Hvordan vil du starte?</span></legend>
                        <label class="adx-check"><input type="radio" name="mt-new-plan-method" checked="@(draft.Method == NewPlanMethod.FromTemplate)" disabled="@_creating" @onchange="() => draft.Method = NewPlanMethod.FromTemplate" data-testid="mt-new-plan-from-template" />
                            <span><strong>Fra mal</strong> <span class="mt-muted msb-small">Opprett en testplan med ferdige testgrupper. Legg til testtilfeller selv.</span></span></label>
                        <label class="adx-check"><input type="radio" name="mt-new-plan-method" checked="@(draft.Method == NewPlanMethod.Empty)" disabled="@_creating" @onchange="() => draft.Method = NewPlanMethod.Empty" data-testid="mt-new-plan-empty" />
                            <span><strong>Helt tom testplan</strong> <span class="mt-muted msb-small">Start uten testgrupper eller testtilfeller.</span></span></label>
                        @if (_selection.Count > 0 && _ws.Discovery is not null)
                        {
                            <label class="adx-check"><input type="radio" name="mt-new-plan-method" checked="@draft.WithSelection" disabled="@_creating" @onchange="e => draft.WithSelection = e.Value is not false" data-testid="mt-new-plan-selection" />
                                <span><strong>Fra valgte scenarioer</strong> <span class="mt-muted msb-small">Ta med @_selection.Count scenario@(_selection.Count == 1 ? "" : "er") valgt i Finn og forstå.</span></span></label>
                        }
                    </fieldset>
                    @if (draft.Method == NewPlanMethod.FromTemplate)
                    {
                        var template = Templates.FirstOrDefault(t => t.Id == draft.TemplateId) ?? Templates.FirstOrDefault();
                        <label class="mtp-field" for="mt-new-plan-template"><span>Mal</span></label>
                        <select id="mt-new-plan-template" class="form-select form-select-sm" disabled="@_creating" @onchange="e => draft.TemplateId = e.Value?.ToString() ?? TestPlanTemplateRules.StandardId" data-testid="mt-new-plan-template">
                            @foreach (var t in Templates) { <option value="@t.Id" selected="@(t.Id == template?.Id)">@t.Name@(t.BuiltIn ? "" : " (egen mal)")</option> }
                        </select>
                        @if (template is not null)
                        {
                            <div class="mt-new-plan-preview" data-testid="mt-new-plan-template-preview">
                                <span class="mt-muted msb-small">@(template.Description ?? "Testgruppene i malen")</span>
                                <span class="mt-muted msb-small" data-testid="mt-new-plan-template-note">Oppretter testgrupper uten scenarioer. Legg til scenarioer etter opprettelse med «Legg til scenarioer» (testtilfeller er valgfrie).</span>
                                <ul class="mt-structure-tree">
                                    @foreach (var (suite, depth) in PlanStructure.Flatten(TestPlanTemplateRules.Instantiate(template)))
                                    {
                                        <li style="padding-left:@(depth * 1.1)rem" data-testid="mt-new-plan-template-suite" data-depth="@depth">@suite.Name</li>
                                    }
                                </ul>
                            </div>
                        }
                    }
                    @if (draft.WithSelection)
                    {
                            <label class="mtp-field" for="mt-new-plan-structure"><span>Testplanstruktur</span></label>
                            <select id="mt-new-plan-structure" class="form-select form-select-sm mt-new-plan-structure" disabled="@_creating" @onchange="e => draft.Structure = e.Value?.ToString() ?? PlanStructureTemplates.Default" data-testid="mt-new-plan-structure">
                                @if (_groupingStructure is { } gk)
                                {
                                    @* «Bruk gruppering som testplanstruktur» (2026-11-26): the grouping the tester chose in Finn og forstå, as real suites of the NEW plan. *@
                                    <option value="@gk" selected="@(draft.Structure == gk)" data-testid="mt-new-plan-structure-grouping">Bruk grupperingen fra Finn og forstå: @PlanStructureTemplates.Label(gk)</option>
                                }
                                @foreach (var (key, label, _) in PlanStructureTemplates.All) { <option value="@key" selected="@(draft.Structure == key)">@label</option> }
                            </select>
                            var proposed = ProposedStructure(draft.Structure);
                            <label class="adx-check" data-testid="mt-new-plan-scenario-only-label"><input type="checkbox" checked="@draft.ScenarioOnly" disabled="@_creating" @onchange="e => draft.ScenarioOnly = e.Value is true" data-testid="mt-new-plan-scenario-only" />
                                <span><strong>Legg til scenarioene uten testtilfeller</strong> <span class="mt-muted msb-small">Scenarioene planlegges nå; testtilfeller kan forberedes senere i Planlegg og klargjør. Ingenting markeres som klart til kjøring.</span></span></label>
                            <div class="mt-new-plan-preview" data-testid="mt-new-plan-preview">
                                <span class="mt-muted msb-small">Testgruppene i den nye testplanen (@proposed.Suites.Count testgrupper, @proposed.Assignment.Count testtilfeller):</span>
                                <ul class="mt-structure-tree">
                                    @foreach (var (suite, depth) in PlanStructure.Flatten(proposed.Suites))
                                    {
                                        var count = proposed.Assignment.Values.Count(v => v == suite.Id);
                                        <li style="padding-left:@(depth * 1.1)rem" data-testid="mt-new-plan-suite" data-depth="@depth">@suite.Name@if (count > 0) { <span class="mt-muted msb-small"> · @count testtilfelle@(count == 1 ? "" : "r")</span> }</li>
                                    }
                                </ul>
                                @if (proposed.Suites.Any(x => x.TestLevel == ScenarioTestLevel.EndToEnd) && SelectedScenarios().Any(c => TestLevelClassifier.Of(c.Type).Candidate))
                                {
                                    <p class="mt-muted msb-small" data-testid="mt-new-plan-e2e-candidates">E2E-scenarioene er kandidater fra dokumenterte forretningsflyter. Testtilfellene lages som utkast og må gjennomgås.</p>
                                }
                            </div>
                    }
                    @if (_createError is { } ce) { <p class="mt-alert" role="alert" data-testid="mt-new-plan-error">@ce</p> }
                    <div class="mt-new-plan-actions">
                        <button type="button" class="btn btn-primary btn-sm" disabled="@(_creating || string.IsNullOrWhiteSpace(draft.Name))" @onclick="CreateAsync" data-testid="mt-new-plan-create">@(_creating ? "Oppretter …" : "Opprett testplan")</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_creating" @onclick="() => _new = null" data-testid="mt-new-plan-cancel">Avbryt</button>
                    </div>
                </section>
            }
            @if (_created is { } created)
            {
                <p class="mtp-notice" role="status" data-testid="mt-new-plan-done">Testplan opprettet: «@created.PlanName».
                    <a href="@($"{M.PlanRoute}?draft={created.Id}")" data-testid="mt-new-plan-open">Åpne i Planlegg og klargjør</a></p>
            }

            @if (_transfer is { } transferPlan)
            {
                <section class="mt-transfer" aria-label="Overfør testplan" data-testid="mt-transfer-panel">
                    <label class="mtp-field mtp-inline"><span>Testplan</span>
                        <select @onchange="e => OpenTransfer(Guid.TryParse(e.Value?.ToString(), out var id) ? id : transferPlan.Id)" data-testid="mt-transfer-plan">
                            @foreach (var p in Active) { <option value="@p.Id" selected="@(p.Id == transferPlan.Id)">@p.PlanName</option> }
                        </select></label>
                    <button type="button" class="msb-link" @onclick="CloseTransfer" data-testid="mt-transfer-close">Lukk</button>
                    @* A new panel per test plan: it always opens on «Eksporter til fil». *@
                    <BirkNext.Web.Components.ManualTesting.AdoTransferPanel @key="transferPlan.Id" Draft="transferPlan" ProjectKey="@(facts.ProjectKey!)" CanWrite="CanWrite" />
                </section>
            }
            else if (_transferLoading) { <InlineLoading Text="Henter testplanen …" Class="mt-muted" TestId="mt-transfer-loading" /> }
            else if (_transferError is { } te) { <p class="mt-alert" role="alert" data-testid="mt-transfer-error">@te</p> }

            @* 2. Saved test plans *@
            @if (_ws.Plans is { } workspace)
            {
                <BirkNext.Web.Components.ManualTesting.SavedPlans Workspace="workspace" Api="Api" Discovery="_ws?.Discovery" ShowArchived="@(PlansQuery == "archived")" Changed="LoadAsync" />
            }

        }
        else
        {
            <p class="msb-empty" data-testid="mt-no-project">Velg et prosjekt for å se testarbeidet. <a href="@next.Href" data-testid="mt-no-project-link">@next.Label</a></p>
        }
    }
</div>

@code {
    /// <summary>"archived": open the saved-plan list on the archived plans.</summary>
    [SupplyParameterFromQuery(Name = "plans")] public string? PlansQuery { get; set; }
    /// <summary>"1": open «Ny testplan» (from Planlegg og klargjør).</summary>
    [SupplyParameterFromQuery(Name = "create")] public string? CreateQuery { get; set; }
    /// <summary>A test plan id: open «Overfør testplan» for it.</summary>
    [SupplyParameterFromQuery(Name = "transfer")] public string? TransferQuery { get; set; }

    /// <summary>Execution in BirkNext is switched on (System settings; off by default): results are then recorded in BirkNext too.</summary>
    private bool _executionEnabled;
    // ── Testoversikt ──
    private ManualTestingOverview? _overview;
    private ManualTestingDashboardSettings _dashboard = new();
    private bool _overviewLoading;
    private string? _overviewError, _module, _specPath;
    private HashSet<string> _modules = new(StringComparer.Ordinal);
    private O.Level _level = O.Level.Project;
    private int _overviewGeneration;

    private bool On(string id) => View.IsOn(id);

    private O.Scope CurrentScope => _level switch
    {
        O.Level.Module when _module is not null => new(O.Level.Module, _module, null),
        O.Level.Specification when _specPath is not null => new(O.Level.Specification, _module, _specPath),
        _ => O.Scope.Project,
    };

    private void SetLevel(O.Level level) { _level = level; _drill = null; _drillError = null; }

    // ── Drill-down (2026-11-26): a bar or follow-up line shows the exact records behind it; from there Finn og forstå or Planlegg og klargjør opens
    //    with that selection (module, specification and the scenarios), never a general page. ──
    private (string Chart, string Key)? _drill;
    private string? _drillError;
    private bool _drillBusy, _drillFocus;
    private int _pickerKey;
    private ElementReference _drillHeading;

    private bool IsDrill(string chart, string key) => _drill is { } d && d.Chart == chart && d.Key == key;

    private void ToggleDrill(string chart, string key)
    {
        _drillError = null;
        if (IsDrill(chart, key)) { _drill = null; return; }
        _drill = (chart, key);
        _drillFocus = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_drillFocus || _drill is null) return;
        _drillFocus = false;
        try { await _drillHeading.FocusAsync(); } catch (Exception e) when (e is JSException or InvalidOperationException or ArgumentException) { }
    }

    private const int DrillItemsPerGroup = 5;

    private RenderFragment DrillPanel(O.Drill d) => @<section class="mto-card mto-drill" aria-labelledby="mto-drill-title" data-testid="mto-drill" data-chart="@d.Chart" data-key="@d.Key">
        <div class="mto-drill-h">
            <h3 class="mto-card-h" id="mto-drill-title" tabindex="-1" @ref="_drillHeading">@d.Title <span class="mt-muted msb-small" data-testid="mto-drill-count">(@d.Count)</span></h3>
            @if (d.Narrow is { } narrow && _level != narrow.Level)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_drillBusy" @onclick="() => NarrowAsync(narrow)" data-testid="mto-drill-narrow">
                    Vis oversikten for @(narrow.Level == O.Level.Module ? narrow.Module : O.SpecName(narrow.SpecificationPath))</button>
            }
            <button type="button" class="msb-link" @onclick="CloseDrill" data-testid="mto-drill-close">Lukk</button>
        </div>
        @if (_drillError is { } de) { <p class="mt-alert" role="alert" data-testid="mto-drill-error">@de</p> }
        @if (d.Count == 0) { <p class="mt-muted" data-testid="mto-drill-empty">Ingen i utvalget.</p> }
        @foreach (var g in d.Scenarios.GroupBy(x => x.Specification.Path))
        {
            var spec = g.First().Specification; var ids = g.Select(x => x.Scenario.Identity).ToList(); var count = ids.Count;
            <div class="mto-drill-group" data-testid="mto-drill-group" data-spec="@spec.Path">
                <div class="mto-drill-group-h"><span><b>@spec.Module</b> / @spec.Title · @count scenario@(count == 1 ? "" : "er")</span>
                    <button type="button" class="btn btn-sm btn-outline-primary" disabled="@_drillBusy" @onclick="() => OpenScenariosAsync(spec, ids, d.Title)" data-testid="mto-drill-open">
                        Åpne @(count == 1 ? "det" : $"alle {count}") i Finn og forstå</button></div>
                <ul class="mto-drill-list">
                    @foreach (var x in g.Take(DrillItemsPerGroup))
                    {
                        var one = x;
                        <li><button type="button" class="msb-link" disabled="@_drillBusy" @onclick="() => OpenScenariosAsync(spec, new[] { one.Scenario.Identity }, one.Scenario.Title)" data-testid="mto-drill-scenario">
                            @(one.Scenario.StoryId is { } sid ? $"{sid} · " : "")@one.Scenario.Title</button>
                            <span class="mt-muted msb-small">@(one.Scenario.Priority ?? "Prioritet ikke oppgitt")@(one.Covered ? " · har testtilfeller" : "")</span></li>
                    }
                    @if (count > DrillItemsPerGroup) { <li class="mt-muted msb-small">… og @(count - DrillItemsPerGroup) til — alle vises når du åpner dem i Finn og forstå.</li> }
                </ul>
            </div>
        }
        @foreach (var g in d.Stories.GroupBy(x => x.SpecificationPath))
        {
            var first = g.First(); var count = g.Count();
            <div class="mto-drill-group" data-testid="mto-drill-group" data-spec="@first.SpecificationPath">
                <div class="mto-drill-group-h"><span><b>@first.Module</b> / @O.SpecName(first.SpecificationPath) · @count brukerhistorie@(count == 1 ? "" : "r")</span>
                    <button type="button" class="btn btn-sm btn-outline-primary" disabled="@_drillBusy" @onclick="() => OpenStoriesAsync(first.Module, first.SpecificationPath, null, d.StoryStatus)" data-testid="mto-drill-open">
                        Åpne i Finn og forstå</button></div>
                <ul class="mto-drill-list">
                    @foreach (var st in g.Take(DrillItemsPerGroup * 3))
                    {
                        var story = st;
                        <li><button type="button" class="msb-link" disabled="@_drillBusy" @onclick="() => OpenStoriesAsync(story.Module, story.SpecificationPath, story.StoryKey, null)" data-testid="mto-drill-story">
                            @story.StoryId @story.Title</button>
                            <span class="mt-muted msb-small">@(story.Eligible > 0 ? $"{story.Completed} av {story.Eligible} oppgaver fullført" : "ingen oppgaver i tasks.md")</span></li>
                    }
                    @if (count > DrillItemsPerGroup * 3) { <li class="mt-muted msb-small">… og @(count - DrillItemsPerGroup * 3) til.</li> }
                </ul>
            </div>
        }
        @foreach (var g in d.Cases.GroupBy(x => x.PlanId))
        {
            var first = g.First(); var count = g.Count();
            <div class="mto-drill-group" data-testid="mto-drill-group" data-plan="@first.PlanId">
                <div class="mto-drill-group-h"><span><b>@first.PlanName</b> · @count testtilfelle@(count == 1 ? "" : "r")</span>
                    <a class="btn btn-sm btn-outline-primary" href="@($"{M.PlanRoute}?draft={first.PlanId}")" data-testid="mto-drill-plan">Åpne testplanen</a></div>
                <ul class="mto-drill-list">
                    @foreach (var c in g.Take(DrillItemsPerGroup * 3))
                    {
                        <li><a href="@($"{M.PlanRoute}?draft={c.PlanId}&case={Uri.EscapeDataString(c.CaseId)}")" data-testid="mto-drill-case">@c.Title</a>
                            <span class="mt-muted msb-small">@c.Module · @P.ReviewLabel(c.Review)@(c.Priority is { } pr ? $" · {pr}" : "")</span></li>
                    }
                    @if (count > DrillItemsPerGroup * 3) { <li class="mt-muted msb-small">… og @(count - DrillItemsPerGroup * 3) til i testplanen.</li> }
                </ul>
            </div>
        }
    </section>;

    private void CloseDrill() { _drill = null; _drillError = null; }

    private async Task OpenStoriesAsync(string module, string specificationPath, string? storyKey, UserStoryTaskStatus? status)
    {
        if (_ws?.ProjectKey is not { } key || _drillBusy) return;
        _drillBusy = true; _drillError = null;
        try { _drillError = await ManualTestingDrillNavigation.OpenStoriesAsync(ServiceProvider, JS, Nav, key, module, specificationPath, storyKey, status); }
        finally { _drillBusy = false; }
    }

    /// <summary>An optional figure from the registry: «—» with a reason when it is unavailable, never 0.</summary>
    // ── Custom KPI tiles (2026-11-26): display name + metric; the name never changes classification or counts ──

    private string? _tileMenu, _tileError, _tileNotice;
    private bool _tileEditing, _tileBusy;
    private DashboardKpiTile? _tileEdit;

    private RenderFragment Tile(DashboardKpiTile t, O.Slice slice, bool explain) => __builder =>
    {
        var title = DashboardKpiTiles.DisplayTitle(t);
        var count = O.TileCount(slice, t);
        var declared = O.TileDeclared(slice, t);
        var metric = $"{DashboardKpiTiles.DimensionLabel(t.Dimension)} · {DashboardKpiTiles.MetricLabel(t.Dimension, t.Metric)}";
        <div class="mto-kpi is-core mto-tile" data-testid="mto-tile" data-tile="@t.Id" data-dimension="@t.Dimension" data-metric="@t.Metric">
            <button type="button" class="mto-tile-open" disabled="@(_draft is not null)" @onclick="() => OpenTileAsync(t)" title="@title" aria-label="@($"{title}: {(count?.ToString() ?? "ikke tilgjengelig")} ({metric}). Åpne i Finn og forstå")" data-testid="mto-tile-open">
                <span class="mto-kpi-k"><span class="mto-kpi-icon is-scenarios" aria-hidden="true"></span><span class="mto-tile-title" data-testid="mto-tile-title">@title</span></span>
                <span class="mto-kpi-v" data-testid="mto-tile-count">@(count?.ToString("N0", Nb) ?? "—")</span>
                <span class="msb-tag mto-tile-badge" data-testid="mto-tile-metric">@metric</span>
                @if (explain)
                {
                    <span class="mto-kpi-e" data-testid="mto-tile-explain">@TileExplain(t, slice, count, declared)</span>
                }
            </button>
        </div>
    };

    /// <summary>What a tile's number means; a 0 on a test level says how many scenarios have no stated level, so «0 E2E» is never read as «no E2E».</summary>
    private static string TileExplain(DashboardKpiTile t, O.Slice slice, int? count, int declared)
    {
        if (count is null) return "Ikke tilgjengelig: spesifikasjonen er ikke lagret for prosjektet";
        if (declared > 0) return $"{declared} dokumentert som E2E i kilden – ikke verifisert";
        var unknown = t.Dimension == KpiTileDimension.TestLevel && t.Metric != nameof(ScenarioTestLevel.Unclassified)
            ? O.TileCount(slice, new DashboardKpiTile("x", null, KpiTileDimension.TestLevel, nameof(ScenarioTestLevel.Unclassified))) ?? 0 : 0;
        return count == 0 && unknown > 0 ? $"{unknown:N0} scenarioer har uavklart testnivå – 0 betyr ikke at det ikke finnes slike tester" : "Unike scenarioer i utvalget";
    }

    // ── «Tilpass oversikten» (customisation v5, 2026-11-26) ──
    // One configuration: the existing dashboard settings store (installation-wide; this BirkNext has no per-user preference store, so the layout is
    // the workspace's and says so). The mode edits a DRAFT — nothing is written until «Ferdig», «Avbryt» writes nothing — and only presentation
    // changes: which cards show and in what order. Every number still comes from the same overview calculation.

    private ManualTestingDashboardSettings? _draft;
    private bool _draftReset, _resetAsk, _leaveAsk;
    private ManualTestingDashboardSettings View => _draft ?? _dashboard;

    private static readonly Dictionary<string, string> CoreNames = new(StringComparer.Ordinal)
    {
        ["metric.scenarios"] = "Scenarioforslag", ["metric.testCases"] = "Testtilfeller", ["metric.approved"] = "Godkjente", ["metric.ready"] = "Klar til testing",
    };

    private string KpiName(string id) => CoreNames.TryGetValue(id, out var n) ? n
        : View.EffectiveTiles.FirstOrDefault(t => t.Id == id) is { } t ? DashboardKpiTiles.DisplayTitle(t) : id;

    private bool KpiShown(string id) => CoreNames.ContainsKey(id) ? On(id) : View.EffectiveTiles.FirstOrDefault(t => t.Id == id)?.Visible ?? false;

    private void EnterCustomize() { _draft = _dashboard; _draftReset = false; _resetAsk = false; _leaveAsk = false; _tileError = null; _tileNotice = null; }

    private void SetShown(string id, bool on)
    {
        if (_draft is null) return;
        if (CoreNames.ContainsKey(id) || ManualTestingDashboard.IsKnown(id))
            _draft = _draft with { Visible = new(_draft.Visible, StringComparer.Ordinal) { [id] = on } };
        else
            _draft = _draft with { Tiles = [.. _draft.EffectiveTiles.Select(t => t.Id == id ? t with { Visible = on } : t)] };
    }

    /// <summary>Moves a shown card one place among the shown cards (hidden cards keep their place in the stored order).</summary>
    private void MoveKpi(string id, int delta, IReadOnlyList<string> shown)
    {
        if (_draft is null) return;
        var i = shown.ToList().IndexOf(id);
        var j = i + delta;
        if (i < 0 || j < 0 || j >= shown.Count) return;
        var seq = ManualTestingDashboard.KpiSequence(_draft).ToList();
        var (a, b) = (seq.IndexOf(id), seq.IndexOf(shown[j]));
        (seq[a], seq[b]) = (seq[b], seq[a]);
        _draft = _draft with { KpiOrder = seq };
    }

    private void ResetDraft()
    {
        _draft = new ManualTestingDashboardSettings { PlanStructure = _dashboard.PlanStructure };
        _draftReset = true; _resetAsk = false;
    }

    private bool DraftDirty => _draft is { } d && (_draftReset
        || ManualTestingDashboard.Widgets.Any(w => d.IsOn(w.Id) != _dashboard.IsOn(w.Id))
        || !ManualTestingDashboard.KpiSequence(d).SequenceEqual(ManualTestingDashboard.KpiSequence(_dashboard))
        || System.Text.Json.JsonSerializer.Serialize(d.EffectiveTiles) != System.Text.Json.JsonSerializer.Serialize(_dashboard.EffectiveTiles));

    private void CancelCustomize() { _draft = null; _draftReset = false; _resetAsk = false; _leaveAsk = false; }

    /// <summary>«Ferdig»: one save of the draft (only the switches that differ from what they would otherwise be, the tiles and the order).</summary>
    private async Task SaveCustomizeAsync()
    {
        if (_draft is not { } d || _tileBusy) return;
        if (!DraftDirty) { CancelCustomize(); return; }
        if (ServiceProvider.GetService(typeof(ITestPlanSuggestionsApiService)) is not ITestPlanSuggestionsApiService api) { _tileError = "Oppsettet kan ikke lagres nå."; return; }
        var baseline = _draftReset ? new ManualTestingDashboardSettings() : _dashboard;
        _tileBusy = true; _tileError = null;
        try
        {
            var (settings, error) = await api.SaveDashboardSettingsAsync(new SaveManualTestingDashboardSettingsRequest(
                ManualTestingDashboard.Widgets.Where(w => d.IsOn(w.Id) != baseline.IsOn(w.Id)).ToDictionary(w => w.Id, w => d.IsOn(w.Id), StringComparer.Ordinal))
            {
                Tiles = d.Tiles is null ? null : [.. d.Tiles.Select((x, i) => x with { Order = i })],
                KpiOrder = d.KpiOrder, ResetLayout = _draftReset,
            });
            if (settings is null) { _tileError = $"Oppsettet ble ikke lagret. {error}"; return; }
            _dashboard = settings; _draft = null; _draftReset = false; _leaveAsk = false;
            _tileNotice = "Oppsettet er lagret. Tallene er uendret.";
        }
        finally { _tileBusy = false; }
    }

