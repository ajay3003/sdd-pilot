@page "/technical-testing/plans"
@using BirkNext.TestPlanning
@using BirkNext.Web.Services
@using T = BirkNext.Web.Services.TechnicalTestingPresentation
@using D = BirkNext.Web.Services.TechnicalTestingDashboard
@implements IDisposable
@inject IServiceProvider ServiceProvider
@inject IJSRuntime JS
@inject NavigationManager Nav

@* Technical Testing → Testplaner (2026-11-28): the project's SAME test plans as Manual Testing (one plan entity, never a technical copy), seen from
   their technical cases. A plan of an earlier import of the same application is included (plans follow the application, DEF-V12-01). Execution is
   the plan's recorded scenario results; nothing is run here. *@
<PageTitle>Testplaner · Technical Testing</PageTitle>

<div class="mt tt" data-testid="ttp" aria-busy="@(_loading ? "true" : "false")">
    <BirkNext.Web.Components.TestingWorkspaceHeader Workspace="Technical Testing" HomeRoute="@T.HomeRoute" Stages="T.Stages" Current="@null" Title="Testplaner"
        ProjectName="@_projectName" Lead="Prosjektets testplaner med tekniske testtilfeller. Samme planer som i Manual Testing.">
        <Help><BirkNext.Web.Components.HelpLink Topic="technical-testing" Text="Slik fungerer det" /></Help>
    </BirkNext.Web.Components.TestingWorkspaceHeader>

    @if (_loading)
    {
        <p class="mt-muted" role="status" data-testid="ttp-loading">Henter testplaner …</p>
    }
    else if (_error is { } error)
    {
        <p class="mt-alert" role="alert" data-testid="ttp-error">@error</p>
    }
    else if (_rows.Count == 0)
    {
        <p class="mt-muted" data-testid="ttp-empty">Ingen testplaner for prosjektet ennå. <a href="@T.AssessRoute">Finn og analyser</a></p>
    }
    else
    {
        <ul class="ttp-list" data-testid="ttp-list">
            @foreach (var r in _rows)
            {
                <li class="mt-card" data-testid="ttp-plan" data-plan="@r.Plan.Id" data-technical="@r.Technical.Count">
                    <a class="ttp-name" href="@($"{ManualTestingPresentation.PlanRoute}?draft={r.Plan.Id}")" data-testid="ttp-open">@r.Plan.Name</a>
                    <span class="mt-muted">@r.Plan.Cases testtilfeller · @r.Technical.Count tekniske · @r.Technical.Count(c => c.Review == TestCaseReviewState.Accepted) godkjent tekniske@(r.SourceAffected > 0 ? $" · {r.SourceAffected} påvirket av kildeendring" : "")</span>
                    @if (r.Plan.Execution is { } x)
                    {
                        <span class="mt-muted" data-testid="ttp-execution">Planens kjøring (alle scenarioer): @x.Passed bestått · @x.Failed feilet · @x.Blocked blokkert · @x.NotRun ikke kjørt</span>
                    }
                    @if (r.Technical.Count > 0)
                    {
                        <button type="button" class="btn btn-secondary btn-sm" data-testid="ttp-technical" @onclick="() => OpenTechnicalAsync(r)">Åpne de @r.Technical.Count tekniske testtilfellene</button>
                    }
                </li>
            }
        </ul>
        <p class="mt-muted mt-boundary">Kjøringsresultater for API, integrasjon og E2E: <a href="@T.VerifyRoute">Verifiser og undersøk</a></p>
    }
</div>

@code {
    private sealed record Row(OverviewPlan Plan, IReadOnlyList<OverviewCase> Technical, int SourceAffected);

    private bool _loading = true;
    private string? _error, _projectName, _projectKey;
    private List<Row> _rows = [];
    private ICurrentWorkspaceProjection? _projection;

    protected override async Task OnInitializedAsync()
    {
        _projection = ServiceProvider.GetService(typeof(ICurrentWorkspaceProjection)) as ICurrentWorkspaceProjection;
        if (_projection is not null) _projection.Changed += OnProjectChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; _error = null; _rows = [];
        try
        {
            var ws = await new TechnicalTestingWorkspace(ServiceProvider).LoadAsync();
            _projectKey = ws.Facts.ProjectKey; _projectName = ws.Facts.ProjectName;
            if (_projectKey is not { } project || ServiceProvider.GetService(typeof(ITestPlanSuggestionsApiService)) is not ITestPlanSuggestionsApiService api) return;
            var (snapshot, _) = ManualTestingWorkspace.ResolveSnapshot(ServiceProvider);
            var (last, _) = await api.LastDiscoveryAsync(project, snapshot);
            if (last is null && snapshot is not null) (last, _) = await api.LastDiscoveryAsync(project, null);
            var (overview, error) = await api.OverviewAsync(project);
            if (overview is null) { _error = error is null ? null : "Testplanene kunne ikke leses: " + error; return; }
            var technical = D.TechnicalCases(overview.Cases, D.Classify(last?.ProjectKey == project ? last.Candidates : []));
            _rows = [.. overview.Plans.Select(p =>
            {
                var mine = technical.Where(c => c.PlanId == p.Id).ToList();
                return new Row(p, mine, mine.Count(c => c.SourceState is CaseSourceState.Changed or CaseSourceState.Removed or CaseSourceState.NotCompared or CaseSourceState.SourceUnavailable));
            }).OrderByDescending(r => r.Technical.Count).ThenByDescending(r => r.Plan.UpdatedAt)];
        }
        catch (Exception e) when (e is not OperationCanceledException) { _error = "Testplanene kunne ikke leses."; }
        finally { _loading = false; }
    }

    private async Task OpenTechnicalAsync(Row r)
    {
        if (_projectKey is not { } project) return;
        await ManualTestingDrillNavigation.OpenCasesAsync(JS, Nav, project, $"Tekniske testtilfeller i «{r.Plan.Name}»",
            [.. r.Technical.Select(c => new PlanPreparePresentation.CaseRef(c.PlanId, c.CaseId))]);
    }

    private void OnProjectChanged() => _ = InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    public void Dispose() { if (_projection is not null) _projection.Changed -= OnProjectChanged; }
}
