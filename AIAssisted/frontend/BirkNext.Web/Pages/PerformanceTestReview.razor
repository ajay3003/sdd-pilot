    private RenderFragment ReadinessView() => @<section class="pt-section" aria-labelledby="pt-readiness-h" data-testid="pt-readiness">
        <h2 id="pt-readiness-h">Test readiness</h2>
        @if (_isNew || _dirty)
        {
            <p class="sd-muted" data-testid="pt-readiness-unsaved">@(_isNew
                ? DraftValid ? "This draft is not saved yet. Check readiness saves it as v1 automatically; the backend then evaluates runtime, image, container network, corporate CA trust, limits and environment safety. Nothing runs."
                    : $"Complete the definition first: {string.Join(", ", D.DraftIssues(_draft))}."
                : $"You changed v{_draft.Version}. Readiness is evaluated on saved versions: save the changes as a new version (earlier runs keep theirs).")</p>
            <ul class="ptc-prechecks" data-testid="pt-prechecks">
                @foreach (var c in PreSaveChecks)
                {
                    <li data-testid="pt-precheck" data-key="@c.Key" data-state="@c.Status.Label">@Pill(c.Status, c.Label) <strong>@c.Label</strong>@if (c.Detail is { } detail) { <span class="ptc-check-detail">@detail</span> }</li>
                }
