    private readonly Dictionary<int, string> _statusErrors = [];
    private IReadOnlyList<BirkNext.LocalHttpsProxy.ObservedNetworkEndpoint> _observations = [];
    /// <summary>Persisted Endpoint Discovery history of this environment + target host (null: not read or unreadable — never "no traffic").</summary>
    private BirkNext.LocalHttpsProxy.EndpointObservationHistoryView? _history;
    private bool _historyLoaded;
    /// <summary>The Endpoint Discovery history could not be read: authentication observed only there is unknown, never "not required".</summary>
    private bool _historyFailed;
    private IReadOnlyList<BirkNext.TestData.TestDataAssetSummary> _testDataAssets = [];

    /// <summary>Discovery observations (this browser's Endpoint Discovery store) and central Test Data summaries for the scenario builder. Both optional.</summary>
    /// <summary>
    /// Live Discovery evidence = the persisted Endpoint Discovery history (server-side, survives refresh and restart). Observations this
    /// browser held before runs were recorded are imported once as the baseline — their own timestamps, no invented "new" deltas.
    /// </summary>
    private async Task LoadObservationHistoryAsync()
    {
        _historyLoaded = false;
        if (_profile is not { TargetUrl: { Length: > 0 } targetUrl }) { _history = null; _historyLoaded = true; return; }
        try
        {
            var history = await Api.ObservationHistoryAsync(_profile.Id, targetUrl);
            if (history is { EverRun: false } && Uri.TryCreate(targetUrl, UriKind.Absolute, out var uri) && _observations.Any(o => string.Equals(o.Host, uri.Host, StringComparison.OrdinalIgnoreCase))
                && await Api.ImportObservationBaselineAsync(_profile.Id, uri.Host, _observations))
                history = await Api.ObservationHistoryAsync(_profile.Id, targetUrl);
            _history = history;
            _historyFailed = false;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { (_history, _historyFailed) = (null, true); }
        _historyLoaded = true;
    }

    private async Task LoadScenarioEvidenceAsync()
    {
        if (ServiceProvider.GetService(typeof(IEndpointDiscoveryService)) is IEndpointDiscoveryService discovery && _profile is not null)
        {
            try
            {
                await discovery.LoadAsync(JS);
                var snapshot = discovery.GetSnapshot(_profile.Id);
                _observations = [.. snapshot.Pages.SelectMany(p => p.Endpoints).Concat(snapshot.Shared)];
            }
            catch (Exception ex) when (ex is JSException or InvalidOperationException or System.Text.Json.JsonException) { _observations = []; }
        }
        await LoadObservationHistoryAsync();
        // The registered client, or the host's HttpClient factory (the WASM host does not register the interface itself).
        if (ServiceProvider.GetService(typeof(ITestDataApiService)) is not null || ServiceProvider.GetService(typeof(IHttpClientFactory)) is not null)
        {
            try { _testDataAssets = (await TestDataApiService.Resolve(ServiceProvider).CatalogAsync()).Catalog?.Assets ?? []; }
            catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { _testDataAssets = []; }
        }
    }

    private void MoveStep(int index, int delta)
    {
        var steps = _draft.Scenario.Steps.ToList();
        var target = index + delta;
        if (target < 0 || target >= steps.Count) return;
        (steps[index], steps[target]) = (steps[target], steps[index]);
        Changed(_draft with { Scenario = _draft.Scenario with { Steps = steps } });
    }

    /// <summary>An edit of the operation itself (method, path, body, query document): a declared step is then "Modified from declared operation".</summary>
    private void EditOperation(int index, Func<HttpPerformanceStep, HttpPerformanceStep> change) =>
        UpdateStep(index, x => change(x) is var edited && x.Source is { Modified: false } source && source.Evidence != ScenarioEvidence.Manual ? edited with { Source = source with { Modified = true } } : edited);

    private void SetExpected(int index, string text)
    {
        var parts = text.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        var codes = parts.Select(Int).ToList();
        if (parts.Length == 0 || codes.Any(c => c is null or < 100 or > 599)) { _statusErrors[index] = "Use HTTP status codes 100–599, comma-separated (e.g. 200 or 200, 204). The previous value is kept."; return; }
        _statusErrors.Remove(index);
        UpdateStep(index, x => x with { ExpectedStatusCodes = [.. codes.Select(c => c!.Value).Distinct()] });
    }

    private string? _mapping, _observedReview, _stepMessage;
    private string? _focusTarget;

    private void OpenMapping(string key) { _mapping = _mapping == key ? null : key; _observedReview = null; }

    private void CloseMapping(int index, string variable) { _mapping = null; _observedReview = null; _focusTarget = $"pt-req-{index}-{variable}"; }

    /// <summary>Map Test Data in scenario context: store the alias (never the value), close the dialog and return focus to the requirement row.</summary>
    private void MapAndReturn(int index, string variable, string place, BirkNext.TestData.TestDataDataType type, string alias)
    {
        MapData(index, variable, place, type, alias);
        _stepMessage = $"Step {index + 1}: {variable} mapped to {alias}. The value stays in Test Data.";
        CloseMapping(index, variable);
    }

    private void Unmap(int index, string variable, string place, BirkNext.TestData.TestDataDataType type)
    {
        MapData(index, variable, place, type, null);
        _stepMessage = $"Step {index + 1}: mapping for {variable} removed.";
        _focusTarget = $"pt-req-{index}-{variable}";
    }

    /// <summary>Observed values behind a step's path placeholder (evidence for an explicit review only; nothing is copied).</summary>
    private BirkNext.PerformanceTests.ObservedValueEvidence? ObservedEvidence(HttpPerformanceStep step, string variable, string place) =>
        place != "path" || step.Source is not { Evidence: ScenarioEvidence.ObservedOnly or ScenarioEvidence.DeclaredAndObserved } source ? null
        : BirkNext.PerformanceTests.PerformanceScenarioEngine.ObservedValues(new ScenarioOperation { Key = source.OperationKey ?? "", Origin = source.Origin, Method = step.Method, Path = step.RelativePath },
            variable, _observations, _draft.TargetOrigin);

    /// <summary>After "Add to scenario": focus the new step's heading (the builder announces "Added … as step N. Nothing has run.").</summary>
    private void FocusStep(int number) => _focusTarget = $"pt-step-h-{number}";

    // ── Scenario Authentication: one summary of what the steps require and what they effectively get (TE → scenario default → step) ──────

    private bool _authApplyPreview;
    private const string ApiCredential = BirkNext.PerformanceTests.PerformanceScenarioRuntime.TargetEnvironmentApiCredential;

    private IReadOnlyList<BirkNext.PerformanceTests.StepAuthenticationRequirement> AuthRequirements =>
        BirkNext.PerformanceTests.PerformanceScenarioRuntime.AuthenticationRequirements(_draft, ObservedAuthentication);

    /// <summary>Steps that require authentication but are explicitly set to None: the only steps "Apply the default" changes (overrides are kept).</summary>
    private IReadOnlyList<(int Index, string Name)> NoneButRequired => [.. AuthRequirements
        .Where(r => r.State == BirkNext.PerformanceTests.StepAuthenticationState.Missing && _draft.Scenario.Steps[r.Index].Authentication == StepAuthenticationMode.None)
        .Select(r => (r.Index, r.Step))];

    private RenderFragment ScenarioAuthentication() => __builder =>
    {
        var requirements = AuthRequirements.Where(r => r.State != BirkNext.PerformanceTests.StepAuthenticationState.NotRequired).ToList();
        var unresolved = requirements.Where(r => r.Blocking).ToList();
        var notExecutable = requirements.Where(r => r.State == BirkNext.PerformanceTests.StepAuthenticationState.Configured && r.Effective is { } e && e != ApiCredential).ToList();
        var overrides = _draft.Scenario.Steps.Select((s, i) => (s, i)).Where(x => !x.s.Disabled && x.s.Authentication == StepAuthenticationMode.Override).ToList();
        var noneButRequired = NoneButRequired;
        var defaultText = _draft.AuthenticationReference is { } d ? BirkNext.PerformanceTests.PerformanceScenarioRuntime.AuthenticationSourceName(d) : "None";
        <section class="ptc-panel pt-auth" aria-labelledby="pt-auth-h" data-testid="pt-scenario-auth" id="pt-scenario-auth" tabindex="-1">
            <h3 id="pt-auth-h">Scenario authentication</h3>
            @* Requirements come from the step's recorded observation and from the persisted Endpoint Discovery history. Until that history is read
               (or when it cannot be), "no step requires authentication" would be a claim without evidence — the summary says so instead. *@
            @if (!_historyLoaded && unresolved.Count == 0)
            {
                <InlineLoading Text="Checking endpoint evidence for authentication requirements…" TestId="pt-auth-checking" />
            }
            else
            {
                <p data-testid="pt-auth-summary" data-evidence="@(_historyFailed ? "partial" : "complete")"><strong>@(unresolved.Count > 0 ? $"Authentication unresolved — {unresolved.Count} step{(unresolved.Count == 1 ? "" : "s")} blocked"
                    : notExecutable.Count > 0 ? $"{notExecutable.Count} step{(notExecutable.Count == 1 ? " uses" : "s use")} attended sign-in — not executable by the load generator"
                    : _historyFailed ? "Authentication requirements not fully known"
                    : requirements.Count == 0 ? "No step requires authentication" : "Every step that requires authentication has a configuration")</strong></p>
                @if (_historyFailed)
                {
                    <p class="ptc-sub" role="alert" data-testid="pt-auth-evidence-unavailable">The Endpoint Discovery history could not be read, so authentication observed only there is not checked here.
                        Readiness and the run still check it on the server. <button type="button" class="btn-link btn-sm" data-testid="pt-auth-evidence-retry" @onclick="LoadObservationHistoryAsync">Retry</button></p>
                }
            }
            @* Resolved means configured AND executable by the load generator; an attended sign-in is configured but counted apart. *@
            <p class="ptc-sub" data-testid="pt-auth-counts">Scenario default: @defaultText · @requirements.Count step@(requirements.Count == 1 ? " requires" : "s require") authentication · @(requirements.Count - unresolved.Count - notExecutable.Count) resolved · @unresolved.Count unresolved@(notExecutable.Count > 0 ? $" · {notExecutable.Count} not executable" : "")@(overrides.Count > 0 ? $" · {overrides.Count} step override{(overrides.Count == 1 ? "" : "s")}" : "")
                · the execution credential is checked in Readiness; no token is ever shown or copied.</p>
            <div class="pt-auth-actions">
                @if (_draft.AuthenticationReference != ApiCredential && (requirements.Count > 0 || _draft.AuthenticationReference is not null))
                {
                    <button type="button" class="btn-secondary btn-sm" data-testid="pt-auth-use-te" @onclick="UseTargetEnvironmentCredential">Use Target Environment API credential as scenario default</button>
                }
                @if (noneButRequired.Count > 0 && !_authApplyPreview)
                {
                    <button type="button" class="btn-secondary btn-sm" data-testid="pt-auth-apply" @onclick="() => _authApplyPreview = true">Apply the scenario default to @noneButRequired.Count step@(noneButRequired.Count == 1 ? "" : "s") set to None…</button>
                }
                <a class="btn-link btn-sm" data-testid="pt-auth-configure" href="@($"/admin/system-settings?section=target-environments&tab=auth{(_profile is null ? "" : $"&profile={Uri.EscapeDataString(_profile.Id)}")}")">Configure Target Environment authentication</a>
            </div>
            @if (_authApplyPreview)
            {
                <div class="pt-auth-preview" role="region" aria-label="Preview" data-testid="pt-auth-preview">
                    <p>These steps require authentication but are set to None; they will inherit the scenario default (@defaultText):</p>
                    <ul>@foreach (var (index, name) in noneButRequired) { <li data-testid="pt-auth-preview-step">Step @(index + 1) · @name</li> }</ul>
                    @if (overrides.Count > 0) { <p class="ptc-sub" data-testid="pt-auth-preview-kept">Kept as they are: @overrides.Count step override@(overrides.Count == 1 ? "" : "s").</p> }
                    <button type="button" class="btn-primary btn-sm" data-testid="pt-auth-apply-confirm" @onclick="ApplyDefaultToNoneSteps">Confirm</button>
                    <button type="button" class="btn-secondary btn-sm" data-testid="pt-auth-apply-cancel" @onclick="() => _authApplyPreview = false">Cancel</button>
                </div>
            }
            @if (unresolved.Count > 0 || notExecutable.Count > 0)
            {
                <ul class="pt-auth-steps" data-testid="pt-auth-unresolved">
                    @foreach (var r in unresolved.Concat(notExecutable))
                    {
                        <li data-testid="pt-auth-step" data-index="@r.Index">Step @(r.Index + 1) · @r.Step — @(r.Requirement ?? "authentication required") ·
                            @(r.State switch { BirkNext.PerformanceTests.StepAuthenticationState.Missing => _draft.Scenario.Steps[r.Index].Authentication == StepAuthenticationMode.None ? "set to None" : "no configuration",
                                BirkNext.PerformanceTests.StepAuthenticationState.OverrideOutdated => "unauthenticated override outdated", _ => "attended sign-in — not executable" })
                            <button type="button" class="btn-link btn-sm" data-testid="pt-auth-configure-step" @onclick="() => FocusStep(r.Index + 1)">Configure<span class="visually-hidden"> step @(r.Index + 1)</span></button></li>
                    }
                </ul>
            }
        </section>
    };

    /// <summary>
    /// "Review unresolved items": what still needs a person, grouped by cause (authentication, runtime values and Test Data), with the number
    /// of affected steps or bindings and one action that opens the first of them. Derived from the same rules as the step statuses and Readiness.
    /// </summary>
    private RenderFragment UnresolvedItems() => __builder =>
    {
        var auth = AuthRequirements.Where(r => r.Blocking).Select(r => r.Index).Distinct().ToList();
        var values = _draft.Scenario.Steps.SelectMany((s, i) => s.Disabled ? [] : BirkNext.PerformanceTests.PerformanceScenarioRuntime.Rows(_draft.Scenario, i)
            .Where(r => !r.Resolved).Select(r => (Index: i, r.Parameter.Variable))).ToList();
        if (auth.Count == 0 && values.Count == 0) return;
        <section class="ptc-panel pt-unresolved" aria-labelledby="pt-unresolved-h" data-testid="pt-unresolved">
            <h3 id="pt-unresolved-h">Review unresolved items</h3>
            <ul>
                @if (auth.Count > 0)
                {
                    <li data-testid="pt-unresolved-group" data-cause="authentication"><strong>Authentication</strong> — @auth.Count step@(auth.Count == 1 ? "" : "s") affected
                        <button type="button" class="btn-link btn-sm" data-testid="pt-unresolved-fix" @onclick='() => _focusTarget = "pt-scenario-auth"'>Review scenario authentication</button></li>
                }
                @if (values.Count > 0)
                {
                    <li data-testid="pt-unresolved-group" data-cause="values"><strong>Runtime values and Test Data</strong> — @values.Count parameter binding@(values.Count == 1 ? "" : "s") missing or not approved
                        (@string.Join(", ", values.Select(v => "{" + v.Variable + "}").Distinct()))
                        <button type="button" class="btn-link btn-sm" data-testid="pt-unresolved-fix" @onclick="() => FocusStep(values[0].Index + 1)">Configure step @(values[0].Index + 1)</button></li>
                }
            </ul>
        </section>
    };

    /// <summary>An explicit choice: the scenario default becomes the Target Environment API credential (a reference, never a token). Step overrides
    /// and explicit None stay as they are.</summary>
    private void UseTargetEnvironmentCredential() => Changed(_draft with { AuthenticationReference = ApiCredential });

    /// <summary>Confirmed bulk apply: only steps that require authentication and are set to None inherit the scenario default; overrides are kept.</summary>
    private void ApplyDefaultToNoneSteps()
    {
        var indexes = NoneButRequired.Select(x => x.Index).ToHashSet();
        _authApplyPreview = false;
        Changed(_draft with { Scenario = _draft.Scenario with { Steps = [.. _draft.Scenario.Steps.Select((s, i) => indexes.Contains(i) ? s with { Authentication = StepAuthenticationMode.Inherit } : s)] } });
    }

    /// <summary>"+ New GraphQL definition" / "Review &amp; create GraphQL definition": an unsaved GraphQL draft (REST and GraphQL are never mixed). Nothing runs.</summary>
    private void NewGraphQlDefinition(HttpPerformanceStep? proposed)
    {
        if (_profile is null) return;
        _draft = P.NewDefinition(_profile) with
        {
            Name = proposed is null ? "GraphQL baseline" : $"GraphQL {proposed.GraphQlOperationName}", TargetType = PerformanceTargetType.GraphQlHttp,
            Scenario = new PerformanceScenario { Name = proposed is null ? "Main scenario" : $"GraphQL {proposed.GraphQlOperationName} (proposed)", Steps = proposed is null ? [] : [proposed], SourceKind = "graphql" },
        };
        _isNew = true; _dirty = true; _readiness = null; _runs = []; _baselines = []; _selectedRun = null; _tab = Tab.Scenario;
        _message = proposed is null ? "New GraphQL definition (unsaved). Add GraphQL query operations to it." : "Proposed GraphQL definition created from the captured query document (unsaved). Review the query, map Test Data for its variables and save. Nothing has run.";
        _focusTarget = proposed is null ? null : "pt-step-h-1";
    }

    private void MapData(int index, string variable, string place, BirkNext.TestData.TestDataDataType type, string? alias) => UpdateStep(index, x =>
    {
        var mappings = (x.DataMappings ?? []).Where(m => m.Variable != variable).ToList();
        if (!string.IsNullOrEmpty(alias)) mappings.Add(new ScenarioDataMapping(variable, [alias], type, place));
        return x with { DataMappings = mappings.Count == 0 ? null : mappings };
    });

    /// <summary>One labelled number field with its unit and inline error (aria-invalid + described by the message): nothing invalid is hidden.</summary>
    private RenderFragment NumField(string key, string label, string unit, string? value, string testId, Action<ChangeEventArgs> onChange, IReadOnlyList<WorkloadFieldIssue> issues,
        string min = "0", string step = "1") => __builder =>
    {
        var issue = issues.FirstOrDefault(i => i.Field == key);
        var id = $"pt-field-{key}";
        <div class="ptc-field @(issue is null ? "" : "is-invalid")" data-testid="pt-workload-field" data-field="@key">
            <label for="@id">@label <span class="ptc-unit">(@unit)</span></label>
            <input id="@id" class="ptc-num" type="number" min="@min" step="@step" value="@value" @onchange="onChange" data-testid="@testId"
                   aria-invalid="@(issue is null ? "false" : "true")" aria-describedby="@(issue is null ? null : $"{id}-error")" />
            @if (issue is not null) { <span id="@($"{id}-error")" class="ptc-field-error" data-testid="pt-field-error" data-field="@key" data-safety="@(issue.Safety ? "true" : "false")">@issue.Message</span> }
        </div>
    };

    private async Task FocusFieldAsync(string id)
    {
        try { await JS.InvokeVoidAsync("birknextFocusElement", id); } catch (JSException) { }
    }

    private RenderFragment Workload() => __builder =>
    {
        var w = _draft.Workload;
        var issues = PerformanceWorkloadPresentation.Issues(w, _overview!.Limits, _draft.Scenario.Steps);
        var estimate = PerformanceWorkloadPresentation.Estimate(w, _overview!.Limits, _draft.Scenario.Steps);
        <section class="pt-section" aria-labelledby="pt-workload-h" data-testid="pt-workload" data-valid="@(issues.Count == 0 ? "true" : "false")">
            <h2 id="pt-workload-h">Workload</h2>
            <p class="sd-muted">How much load, and for how long. The backend checks the same rules and its safety limits again before any run.</p>
            @if (issues.Count > 0)
            {
                <div class="ptc-inline-errors" role="alert" data-testid="pt-workload-issues">
                    <strong>@issues.Count problem@(issues.Count == 1 ? "" : "s") to fix before this workload can run:</strong>
                    <ul>@foreach (var i in issues) { var target = $"pt-field-{(i.Field is "duration" ? "steady" : i.Field is "requests" ? "vus" : i.Field)}"; <li><button type="button" class="ptc-link" data-testid="pt-workload-issue" data-field="@i.Field" @onclick="() => FocusFieldAsync(target)">@i.Message</button></li> }</ul>
                </div>
            }
            <div class="ptc-workload-form">
                <fieldset class="ptc-panel" data-testid="pt-workload-definition">
                    <legend>Execution profile</legend>
                    <div class="ptc-grid ptc-grid-2">
                        <div class="ptc-field @(issues.Any(i => i.Field == "purpose") ? "is-invalid" : "")">
                            <label for="pt-field-purpose">Purpose</label>
                            <select id="pt-field-purpose" value="@w.Purpose" @onchange="e => UpdateWorkload(x => x with { Purpose = Enum.Parse<WorkloadPurpose>(e.Value!.ToString()!) })" data-testid="pt-purpose" aria-describedby="pt-purpose-help">
                                @foreach (var p in _overview!.Provider?.Capabilities.Purposes ?? []) { <option value="@p">@p</option> }
                            </select>
                            <span id="pt-purpose-help" class="ptc-field-help">@PerformanceWorkloadPresentation.PurposeMeaning(w.Purpose)</span>
                            @if (issues.FirstOrDefault(i => i.Field == "purpose") is { } pi) { <span class="ptc-field-error" data-testid="pt-field-error" data-field="purpose" data-safety="true">@pi.Message</span> }
                        </div>
                        <div class="ptc-field">
                            <label for="pt-field-mode">Load model</label>
                            <select id="pt-field-mode" value="@w.Mode" @onchange="e => UpdateWorkload(x => x with { Mode = Enum.Parse<WorkloadMode>(e.Value!.ToString()!) })" data-testid="pt-mode" aria-describedby="pt-mode-help">
                                @foreach (var m in _overview!.Provider?.Capabilities.Modes ?? [WorkloadMode.VirtualUsers]) { <option value="@m">@(m == WorkloadMode.VirtualUsers ? "Virtual users" : "Arrival rate (req/s)")</option> }
                            </select>
                            <span id="pt-mode-help" class="ptc-field-help">@(w.Mode == WorkloadMode.VirtualUsers ? "A fixed number of concurrent users; the request rate follows from response times." : "A fixed rate of scenario iterations per second, independent of response times.")</span>
                        </div>
                    </div>
                </fieldset>
                <fieldset class="ptc-panel" data-testid="pt-workload-load">
                    <legend>Load</legend>
                    <div class="ptc-grid ptc-grid-3">
                        @NumField("vus", w.Mode == WorkloadMode.VirtualUsers ? "Virtual users" : "Maximum generator virtual users", "users", w.VirtualUsers?.ToString(CultureInfo.InvariantCulture), "pt-vus",
                            e => UpdateWorkload(x => x with { VirtualUsers = Int(e.Value) }), issues, "1")
                        @if (w.Mode == WorkloadMode.ArrivalRate)
                        {
                            @NumField("start-rate", "Start rate", "req/s", w.StartRequestsPerSecond?.ToString(CultureInfo.InvariantCulture), "pt-start-rate", e => UpdateWorkload(x => x with { StartRequestsPerSecond = Dbl(e.Value) }), issues, "0", "0.1")
                            @NumField("rate", "Target rate", "req/s", w.RequestsPerSecond?.ToString(CultureInfo.InvariantCulture), "pt-rate", e => UpdateWorkload(x => x with { RequestsPerSecond = Dbl(e.Value) }), issues, "0.1", "0.1")
                        }
                    </div>
                </fieldset>
                <fieldset class="ptc-panel" data-testid="pt-workload-timing">
                    <legend>Duration</legend>
                    <div class="ptc-grid ptc-grid-4">
                        @NumField("warmup", "Warm-up", "s", w.WarmupSeconds.ToString(CultureInfo.InvariantCulture), "pt-warmup", e => UpdateWorkload(x => x with { WarmupSeconds = Int(e.Value) ?? 0 }), issues)
                        @NumField("rampup", "Ramp-up", "s", w.RampUpSeconds.ToString(CultureInfo.InvariantCulture), "pt-rampup", e => UpdateWorkload(x => x with { RampUpSeconds = Int(e.Value) ?? 0 }), issues)
                        @NumField("steady", "Steady state", "s", w.SteadyStateSeconds.ToString(CultureInfo.InvariantCulture), "pt-steady", e => UpdateWorkload(x => x with { SteadyStateSeconds = Int(e.Value) ?? 0 }), issues, "10")
                        @NumField("rampdown", "Ramp-down", "s", w.RampDownSeconds.ToString(CultureInfo.InvariantCulture), "pt-rampdown", e => UpdateWorkload(x => x with { RampDownSeconds = Int(e.Value) ?? 0 }), issues)
                    </div>
                    @if (issues.FirstOrDefault(i => i.Field == "duration") is { } di) { <p class="ptc-field-error" data-testid="pt-field-error" data-field="duration" data-safety="true">@di.Message</p> }
                </fieldset>
                <fieldset class="ptc-panel" data-testid="pt-workload-pacing">
                    <legend>Iterations and think time</legend>
                    <dl class="ptc-facts">
                        <div><dt>Iterations</dt><dd data-testid="pt-workload-iterations">Not a separate setting: @(w.Mode == WorkloadMode.VirtualUsers ? "each virtual user repeats the scenario until its phase ends." : "the rate above is scenario iterations per second.")</dd></div>
                        <div><dt>Think time</dt><dd data-testid="pt-workload-think">@PerformanceWorkloadPresentation.ThinkTime(_draft.Scenario.Steps) <button type="button" class="ptc-link" @onclick="() => _tab = Tab.Scenario" data-testid="pt-workload-edit-think">Set per step in Scenario</button></dd></div>
                    </dl>
                </fieldset>
            </div>
            <section class="ptc-panel ptc-estimate" aria-labelledby="pt-estimate-h" data-testid="pt-workload-estimate">
                <h3 id="pt-estimate-h">Estimated load</h3>
                <dl class="ptc-facts">
                    <div><dt>Total duration</dt><dd data-testid="pt-estimate-duration">@P.Duration(estimate.DurationSeconds)</dd></div>
                    <div><dt>Peak load</dt><dd data-testid="pt-estimate-peak">@estimate.PeakLoad</dd></div>
                    <div><dt>Requests (upper bound)</dt><dd data-testid="pt-estimate-requests">~@estimate.MaxRequests.ToString("N0", CultureInfo.InvariantCulture)@(estimate.RequestLimit is { } rl ? $" of {rl.ToString("N0", CultureInfo.InvariantCulture)} allowed" : "")</dd></div>
                </dl>
                <p data-testid="pt-workload-impact">@estimate.Impact An estimate, not a measurement — a run reports what was actually sent.</p>
            </section>
            @if (w.Purpose == WorkloadPurpose.Soak)
            {
                <p class="sd-muted" data-testid="pt-soak-note">Longer controlled runs provide stronger resource-stability evidence (Resources tab). They still do not prove that resources leak or never leak.</p>
            }
            <h3>Timeline</h3>
            @Timeline(w)
            <details class="pt-details"><summary>Phase details</summary>
                <ol class="pt-timeline" data-testid="pt-timeline">@foreach (var line in PerformanceTestRules.Timeline(w)) { <li>@line</li> }</ol>
            </details>
            <h3>Safety <span data-testid="pt-workload-policy">@Pill(D.WorkloadPolicy(w, _overview!.Limits), "Workload policy")</span></h3>
            @if (D.WorkloadPolicy(w, _overview!.Limits).Reason is { } over) { <p class="ptc-reason" data-testid="pt-workload-over">@over</p> }
            @if (_overview!.Limits is { } lim)
            {
                <dl class="ptc-limits" data-testid="pt-safety">
                    <div><dt>Max virtual users</dt><dd>@lim.MaxVirtualUsers</dd></div>
                    <div><dt>Max rate</dt><dd>@lim.MaxRequestsPerSecond.ToString("0.##", CultureInfo.InvariantCulture) req/s</dd></div>
                    <div><dt>Max duration</dt><dd>@P.Duration(lim.MaxDurationSeconds) <span class="ptc-sub">soak @P.Duration(lim.MaxSoakDurationSeconds)</span></dd></div>
                    <div><dt>Max requests</dt><dd>@lim.MaxTotalRequests.ToString("N0", CultureInfo.InvariantCulture)</dd></div>
                    <div class="ptc-limits-this"><dt>This workload</dt><dd>@P.Load(w) <span class="ptc-sub">@P.Duration(w.TotalSeconds)</span></dd></div>
                </dl>
                <p class="sd-muted" data-testid="pt-safety-meaning">The backend enforces these limits; a workload beyond them cannot run. “Within policy” means the configured load is within execution safety limits — it says nothing about performance quality.</p>
            }
        </section>
    };

    private RenderFragment Thresholds() => __builder =>
    {
        var unsaved = _isNew || _dirty;
        var (rows, life) = PerformanceThresholdPresentation.View(_draft.Thresholds, PerformanceThresholdPresentation.EvaluatingRun(_runs, _draft.Id, _draft.Version, unsaved), _draft.Version, unsaved);
        @ThresholdsBody(rows, life)
    };

    private RenderFragment ThresholdsBody(IReadOnlyList<ThresholdRowView> rows, ThresholdLifecycle life) => @<section class="pt-section" aria-labelledby="pt-thresholds-h" data-testid="pt-thresholds">
        <h2 id="pt-thresholds-h">Thresholds</h2>
        <p class="sd-muted">Absolute expectations, evaluated by BirkNext after a run. A metric without a threshold is measured, not passed — and a configured threshold is not an evaluated or passed one.</p>
        <ol class="ptc-lifecycle" aria-label="Threshold lifecycle" data-testid="pt-threshold-lifecycle">
            <li data-testid="pt-threshold-stage" data-key="configured"><strong>@life.Configured</strong> configured</li>
            <li data-testid="pt-threshold-stage" data-key="valid" class="@(life.Valid < life.Configured ? "is-open" : "")"><strong>@life.Valid</strong> valid</li>
            <li data-testid="pt-threshold-stage" data-key="evaluated"><strong>@life.Evaluated</strong> evaluated</li>
            <li data-testid="pt-threshold-stage" data-key="passed"><strong>@life.Passed</strong> passed</li>
            <li data-testid="pt-threshold-stage" data-key="failed" class="@(life.Failed > 0 ? "is-open" : "")"><strong>@life.Failed</strong> failed</li>
        </ol>
        <p class="sd-muted" data-testid="pt-threshold-evaluated-in">Evaluation source: @life.EvaluatedIn</p>
        @if (_draft.Thresholds.Count == 0) { <p class="ptc-inline-empty" data-testid="pt-thresholds-empty">No thresholds configured — runs will be measured, not assessed.</p> }
        else
        {
        <div class="ptc-thr-wrap">
            <table class="ptc-compact-table ptc-thr-table" data-testid="pt-threshold-table">
                <caption class="visually-hidden">Thresholds: metric, condition, target value, unit, policy, validation, readiness impact and the latest evaluation</caption>
                <thead><tr><th scope="col">Metric</th><th scope="col">Condition</th><th scope="col">Target value</th><th scope="col">Unit</th><th scope="col">Policy</th><th scope="col">Validation</th><th scope="col">Readiness impact</th><th scope="col">Latest evaluation</th><th scope="col"><span class="visually-hidden">Remove</span></th></tr></thead>
                <tbody>
                    @foreach (var row in rows)
                    {
                        var index = row.Index; var t = row.Threshold; var n = index + 1;
                        <tr data-testid="pt-threshold-row" data-valid="@(row.Problem is null ? "true" : "false")" data-run-state="@row.RunState">
                            <td data-label="Metric"><select aria-label="Metric of threshold @n" value="@t.Metric" @onchange="e => UpdateThreshold(index, x => x with { Metric = Enum.Parse<PerformanceMetric>(e.Value!.ToString()!) })">@foreach (var m in Enum.GetValues<PerformanceMetric>()) { <option value="@m">@PerformanceTestRules.Label(m)</option> }</select></td>
                            <td data-label="Condition"><select aria-label="Condition of threshold @n" value="@t.Operator" @onchange="e => UpdateThreshold(index, x => x with { Operator = Enum.Parse<ThresholdOperator>(e.Value!.ToString()!) })">@foreach (var o in Enum.GetValues<ThresholdOperator>()) { <option value="@o">@PerformanceTestRules.Symbol(o)</option> }</select></td>
                            <td data-label="Target value"><input aria-label="Target value of threshold @n (@PerformanceTestRules.Unit(t.Metric))" type="number" step="any" min="0" value="@t.Value.ToString(CultureInfo.InvariantCulture)"
                                aria-invalid="@(row.Problem is null ? "false" : "true")" aria-describedby="@(row.Problem is null ? null : $"pt-thr-{index}-problem")"
                                @onchange="e => UpdateThreshold(index, x => x with { Value = Dbl(e.Value) ?? 0 })" data-testid="pt-threshold-value" /></td>
                            <td data-label="Unit">@PerformanceTestRules.Unit(t.Metric)</td>
                            <td data-label="Policy"><select aria-label="Policy of threshold @n" value="@t.Severity" @onchange="e => UpdateThreshold(index, x => x with { Severity = Enum.Parse<ThresholdSeverity>(e.Value!.ToString()!) })"><option value="Required">Required</option><option value="Advisory">Advisory</option></select></td>
                            <td data-label="Validation" data-testid="pt-threshold-validation">@if (row.Problem is { } problem) { <span id="@($"pt-thr-{index}-problem")" class="ptc-field-error">@problem</span> } else { <span>Valid</span> }</td>
                            <td data-label="Readiness impact" data-testid="pt-threshold-impact">@row.Impact</td>
                            <td data-label="Latest evaluation" data-testid="pt-threshold-run"><span class="ptc-thr-run ptc-thr-run-@row.RunState.ToString().ToLowerInvariant()">@row.RunText</span></td>
                            <td><button type="button" class="ptc-remove" aria-label="Remove threshold @n" @onclick="() => Changed(_draft with { Thresholds = _draft.Thresholds.Where((_, j) => j != index).ToList() })">Remove</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        }
        <button type="button" class="btn-secondary ptc-add" @onclick="() => Changed(_draft with { Thresholds = [.. _draft.Thresholds, new PerformanceThreshold { Metric = PerformanceMetric.LatencyP95Ms, Value = 500 }] })" data-testid="pt-add-threshold"><span aria-hidden="true">+</span> Add threshold</button>

        <h3>Drift policy (optional)</h3>
        <p class="sd-muted">Accepted change against the active baseline. Without a policy, comparisons show deltas only — never “Regression”.</p>
        @if (_draft.DriftPolicies.Count == 0) { <p class="ptc-inline-empty" data-testid="pt-drift-empty">No drift policy configured.</p> }
        else
        {
        <div class="sd-scroll" tabindex="0" role="region" aria-label="Drift policy">
            <table class="ptc-compact-table" data-testid="pt-drift-table">
                <thead><tr><th scope="col">Metric</th><th scope="col">Accepted worsening (%)</th><th scope="col">Accepted worsening (absolute)</th><th scope="col">Severity</th><th scope="col"><span class="visually-hidden">Remove</span></th></tr></thead>
                <tbody>
                    @for (var i = 0; i < _draft.DriftPolicies.Count; i++)
                    {
                        var index = i; var p = _draft.DriftPolicies[i];
                        <tr>
                            <td><select aria-label="Drift metric" value="@p.Metric" @onchange="e => UpdateDrift(index, x => x with { Metric = Enum.Parse<PerformanceMetric>(e.Value!.ToString()!) })">@foreach (var m in PerformanceTestRules.ComparedMetrics) { <option value="@m">@PerformanceTestRules.Label(m)</option> }</select></td>
                            <td><input aria-label="Accepted relative change" type="number" step="any" value="@p.AllowedRelativeChangePercent?.ToString(CultureInfo.InvariantCulture)" @onchange="e => UpdateDrift(index, x => x with { AllowedRelativeChangePercent = Dbl(e.Value) })" /></td>
                            <td><input aria-label="Accepted absolute change" type="number" step="any" value="@p.AllowedAbsoluteChange?.ToString(CultureInfo.InvariantCulture)" @onchange="e => UpdateDrift(index, x => x with { AllowedAbsoluteChange = Dbl(e.Value) })" /></td>
                            <td><select aria-label="Drift severity" value="@p.Severity" @onchange="e => UpdateDrift(index, x => x with { Severity = Enum.Parse<ThresholdSeverity>(e.Value!.ToString()!) })"><option value="Required">Required</option><option value="Advisory">Advisory</option></select></td>
                            <td><button type="button" class="ptc-remove" aria-label="Remove drift policy @(index + 1)" @onclick="() => Changed(_draft with { DriftPolicies = _draft.DriftPolicies.Where((_, j) => j != index).ToList() })">Remove</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        }
        <button type="button" class="btn-secondary ptc-add" @onclick="() => Changed(_draft with { DriftPolicies = [.. _draft.DriftPolicies, new PerformanceDriftPolicy { Metric = PerformanceMetric.LatencyP95Ms, AllowedRelativeChangePercent = 20 }] })" data-testid="pt-add-drift"><span aria-hidden="true">+</span> Add drift policy</button>
    </section>;

    private RenderFragment ReadinessView() => @<section class="pt-section" aria-labelledby="pt-readiness-h" data-testid="pt-readiness">
        <h2 id="pt-readiness-h">Test readiness</h2>
        @if (_checkingReadiness)
        {
            <div class="ptc-check-progress" role="status" aria-live="polite" data-testid="pt-check-progress">
                <span>Checking readiness: definition → execution environment → target connectivity (when eligible) → blockers…</span>
                <button type="button" class="btn-secondary ptc-action" data-testid="pt-check-cancel" @onclick="CancelCheck">Cancel</button>
            </div>
        }
        @if (_isNew || _dirty)
        {
            <p class="sd-muted" data-testid="pt-readiness-unsaved">@(_isNew
                ? DraftValid ? "This draft is not saved yet. Check readiness asks to save it as v1; the backend then evaluates runtime, image, container network, corporate CA trust, limits and environment safety. Nothing runs."
                    : $"Complete the definition first: {string.Join(", ", D.DraftIssues(_draft))}."
                : $"You changed v{_draft.Version}. Readiness is evaluated on saved versions: save the changes as a new version (earlier runs keep theirs).")</p>
            <ul class="ptc-prechecks" data-testid="pt-prechecks">
                @foreach (var c in PreSaveChecks)
                {
                    <li data-testid="pt-precheck" data-key="@c.Key" data-state="@c.Status.Label">@Pill(c.Status, c.Label) <strong>@c.Label</strong>@if (c.Detail is { } detail) { <span class="ptc-check-detail">@detail</span> }</li>
                }
            </ul>
            <p class="ptc-cta">@ActionControl(_isNew ? "check-readiness" : "save-version", null, true, "pt-readiness-primary")</p>
        }
        else if (_readiness is null) { <p class="sd-reason">Readiness could not be loaded.</p> }
        else
        {
            var blocking = _readiness.Items.Where(i => i.Blocking).ToList();
            var actionable = D.ActionableBlockers(_readiness);
            <p data-testid="pt-readiness-summary"><strong>@(_readiness.Ready ? "Ready to run." : $"Blocked · {blocking.Count} required prerequisite{(blocking.Count == 1 ? "" : "s")}:")</strong> @(_readiness.Ready ? $"Estimated {P.Duration(_readiness.EstimatedDurationSeconds)}, at most ~{_readiness.EstimatedMaxRequests:N0} requests. Running still asks for confirmation." : blocking.Count == 1 ? $"{blocking[0].Label}: {blocking[0].Detail}" : string.Join(", ", blocking.Select(i => i.Label)))</p>
            @if (blocking.Count > 0)
            {
                <section class="ptc-blocker-callout" aria-labelledby="pt-blocker-h" data-testid="pt-blocker-callout" data-count="@blocking.Count">
                    <h3 id="pt-blocker-h">@(blocking.Count == 1 ? "Target execution blocked" : $"Target execution blocked — {blocking.Count} prerequisites")</h3>
                    @if (blocking.Count == 1)
                    {
                        var only = blocking[0];
                        @* The one detailed explanation on the page; the top card and the list below state the blocker only briefly. *@
                        <p class="ptc-blocker-headline" data-testid="pt-blocker-headline"><strong>@(D.Headline(only) is { Length: > 0 } h ? h : only.Label)</strong></p>
                        <p class="ptc-check-detail" data-testid="pt-blocker-status">Status: Blocked · <span data-testid="pt-blocker-category">@D.BlockerCategory(only)</span></p>
                        <p data-testid="pt-blocker-detail">@only.Detail</p>
                        @if (only.Key == "ca-trust") { <p class="ptc-check-detail" data-testid="pt-blocker-safety">@D.TlsSafetyNote</p> }
                        @if (only.Owner is { } owner) { <p class="ptc-check-detail" data-testid="pt-blocker-owner">Owner: @owner@if (only.ConfigurationKey is { } key) {<span> · Configuration: <code>@key</code></span>}</p> }
                        @if (only.Action is { } a) { <p class="ptc-cta">@ActionControl(a, only, actionable.Count == 1, "pt-blocker-action")</p> }
                    }
                    <p><button type="button" class="ptc-link" data-testid="pt-blocker-count" @onclick="FocusFirstBlockerAsync">@($"Resolve {blocking.Count} required item{(blocking.Count == 1 ? "" : "s")} before running.")</button></p>
                </section>
            }
            <p class="ptc-check-again">
                <button type="button" class="btn-secondary ptc-action" data-testid="pt-check-readiness" disabled="@(_checkingReadiness || _checkingNetwork)" @onclick="CoordinatedCheckAsync"
                        aria-describedby="pt-check-readiness-what">@(_checkingReadiness ? "Checking…" : "Check readiness")</button>
                <span id="pt-check-readiness-what" class="ptc-check-detail">Evaluates v@(_draft.Version) again, including target connectivity from the k6 container when eligible (one request, reused while recent). Never starts a run.</span>
            </p>
            @if (_lastCheck is { } lc && !_checkingReadiness)
            {
                <ol class="ptc-check-steps" aria-label="What Check readiness did" data-testid="pt-check-steps" data-connectivity="@lc.Connectivity">
                    @foreach (var step in lc.Steps)
                    {
                        <li data-testid="pt-check-step" data-key="@step.Key" data-state="@step.State">
                            <span class="ptc-step-state ptc-step-@step.State.ToLowerInvariant()">@(step.State switch { "Done" => "Done", "Skipped" => "Skipped", _ => "Needs attention" })</span>
                            <strong>@step.Label</strong>
                            <span class="ptc-check-detail">@step.Detail</span>
                        </li>
                    }
                </ol>
            }
            @if (_reachability is { } nr)
            {
                <p class="sd-muted" role="status" aria-live="polite" data-testid="pt-network-result" data-state="@nr.State"><strong>@D.ProbeTitle(nr.State)</strong> — @nr.Detail</p>
            }
            <div class="ptc-groups" data-testid="pt-readiness-items">
                @foreach (var group in D.Groups(_isNew, _dirty, _readiness))
                {
                    <section class="ptc-group ptc-group-@group.Name.ToLowerInvariant().Replace(' ', '-')" aria-labelledby="@($"pt-group-{group.Name.Replace(' ', '-')}")" data-testid="pt-readiness-group" data-group="@group.Name">
                        <h3 id="@($"pt-group-{group.Name.Replace(' ', '-')}")">@group.Name</h3>
                        <ul>
                            @foreach (var c in group.Checks)
                            {
                                var item = _readiness.Items.FirstOrDefault(i => i.Key == c.Key);
                                <li id="@($"pt-blocker-{c.Key}")" tabindex="-1" data-testid="@(item is null ? "pt-readiness-local" : "pt-readiness-item")" data-key="@c.Key" data-state="@(item?.State.ToString() ?? c.Status.Label)" data-status="@item?.Status" data-blocking="@(item?.Blocking == true ? "true" : "false")">
                                    @Pill(c.Status, c.Label) <strong>@c.Label</strong>@if (c.Detail is { } detail && !(blocking.Count == 1 && blocking[0].Key == c.Key)) { <span class="ptc-check-detail">@detail</span> }
                                    @if (blocking.Count == 1 && blocking[0].Key == c.Key) { <span class="ptc-check-detail" data-testid="pt-item-see-blocker">See the blocker above.</span> }
                                    @if (item is { Owner: { } owner } && (item.Blocking || item.Key == "ca-trust")) { <span class="ptc-check-detail" data-testid="pt-item-owner">Owner: @owner@if (item.ConfigurationKey is { } key) {<span> · Configuration: <code>@key</code></span>}</span> }
                                    @if (item is { Action: { } action } && (item.Blocking || item.Key == "network") && !(blocking.Count == 1 && blocking[0].Key == item.Key))
                                    {
                                        <span class="ptc-item-action">@ActionControl(action, item, false, $"pt-item-action-{item.Key}")</span>
                                    }
                                    @if (item?.Technical is { } technical) { <details class="ptc-technical-detail" data-testid="pt-item-technical"><summary>Technical detail</summary><code>@technical</code></details> }
                                </li>
                            }
                        </ul>
                    </section>
                }
            </div>
            @if (!(blocking.Count == 1 && blocking[0].Key == "ca-trust"))
            {
                <p class="sd-muted" data-testid="pt-tls-policy">TLS verification is never disabled: an untrusted certificate chain is fixed by trusting the corporate CA, never by skipping verification.</p>
            }
            <div class="ptc-cta" data-testid="pt-readiness-cta">
                @if (_readiness.Ready) { <button type="button" class="btn-primary" @onclick="() => _tab = Tab.Run" data-testid="pt-readiness-run">Run performance test</button> }
            </div>
        }
        <ReviewDisclosure Text="Guided setup" CollapseText="Hide guided setup" Hint="@D.SetupProgress(Setup)" TestId="pt-guided-setup" Class="disclosure-inline" @bind-Expanded="_showSetup">
            <p class="sd-muted" data-testid="pt-setup-vs-readiness">@D.SetupVersusReadiness</p>
            @if (_showSetup)
            {
                <BirkNext.Web.Components.JourneySetupPanel SetupView="Setup" Actions="SetupAction" OnCommand="PerformAction" FocusNext="_focusSetup" />
            }
        </ReviewDisclosure>
    </section>;

    private RenderFragment RunView() => @<section class="pt-section" aria-labelledby="pt-run-h" data-testid="pt-run">
        <h2 id="pt-run-h">Run</h2>
        <dl class="sd-mini">
            <div><dt>Target</dt><dd>@_draft.TargetOrigin</dd></div>
            <div><dt>Environment</dt><dd>@_draft.EnvironmentName (@_draft.EnvironmentType)</dd></div>
            <div><dt>Load</dt><dd>@_draft.Workload.Purpose, @P.Load(_draft.Workload)</dd></div>
            <div><dt>Estimated duration</dt><dd>@P.Duration(_draft.Workload.TotalSeconds)</dd></div>
        </dl>
        <section class="ptc-callout ptc-callout-traffic" aria-labelledby="pt-traffic-h" data-testid="pt-real-traffic">
            <h3 id="pt-traffic-h">This sends real load to the @(_draft.EnvironmentType) target.</h3>
            <dl class="sd-mini">
                <div><dt>Target</dt><dd class="ptc-break">@_draft.TargetOrigin</dd></div>
                <div><dt>Workload</dt><dd>@P.Load(_draft.Workload)</dd></div>
                <div><dt>Estimated duration</dt><dd>@P.Duration(_draft.Workload.TotalSeconds)</dd></div>
                @if (_readiness is { } r0) { <div><dt>At most</dt><dd>~@r0.EstimatedMaxRequests.ToString("N0", CultureInfo.InvariantCulture) requests</dd></div> }
                @if (_readiness?.Limits is { } limits) { <div><dt>Safety limits</dt><dd data-testid="pt-run-limits">≤ @limits.MaxVirtualUsers VUs · ≤ @limits.MaxRequestsPerSecond.ToString("0.##", CultureInfo.InvariantCulture) req/s · ≤ @P.Duration(limits.MaxDurationSeconds) · ≤ @limits.MaxTotalRequests.ToString("N0", CultureInfo.InvariantCulture) requests</dd></div> }
            </dl>
            <p class="sd-muted">Production is refused by the backend; make sure the target owners expect the test. Nothing starts until you select Run performance test.</p>
        </section>
        @if (ActiveRun is { } active)
        {
            @* Execution progress: the lifecycle stage and what was actually observed — never "Running" as proof of load. *@
            <BirkNext.Web.Components.PerformanceExecutionProgress Run="active" />
            @if (active.Resources is { Configured: true } live) { <BirkNext.Web.Components.PerformanceResourceResults Assessment="live" Mode="live" /> }
            <p class="ptc-actions-row"><button type="button" class="btn-secondary" @onclick="CancelAsync" disabled="@(active.State == PerformanceRunState.Cancelling)" data-testid="pt-cancel">Cancel test</button>
                <button type="button" class="btn-secondary" @onclick="RefreshActiveRunAsync" data-testid="pt-progress-refresh">Refresh status</button>
                <button type="button" class="btn-secondary" @onclick="() => { _selectedRun = active; _tab = Tab.Results; }" data-testid="pt-progress-diagnostics">View diagnostics</button></p>
        }
        else
        {
            @if (!_isNew)
            {
                @* What a run executes: the SAVED definition version, readiness re-evaluated by the backend at start, persisted endpoint evidence. *@
                <BirkNext.Web.Components.PerformanceExecutionSummary Definition="_draft" Readiness="_readiness" History="_history"
                    OnConfigureAuthentication="() => PerformAction(PerformanceReadinessActions.EditScenario)" OnReviewScenario="() => PerformAction(PerformanceReadinessActions.EditScenario)"
                    OnAcknowledgeUnauthenticated="AcknowledgeUnauthenticatedAsync" />
                @if (_dirty) { <p class="sd-muted" data-testid="pt-summary-unsaved">Unsaved changes are not part of the run — save them as a new version first.</p> }
            }
            @if (CanRun)
            {
                <label class="ptc-inline-field">Release / version label (optional) <input @bind="_versionLabel" maxlength="100" data-testid="pt-version-label" /></label>
                <button type="button" class="btn-primary ptc-add" @onclick="StartAsync" disabled="@_starting" data-testid="pt-run-start">@(_starting ? "Starting…" : "Run performance test")</button>
            }
            else
            {
                <div class="ptc-empty ptc-empty-blocked" data-testid="pt-run-blocked">
                    <span class="ptc-empty-icon" aria-hidden="true">!</span>
                    <div><h3 data-testid="pt-run-blocked-title">@(_readiness is { Ready: false } && PageState.Label.StartsWith("Blocked — ") ? $"Run test — blocked by {PageState.Label["Blocked — ".Length..]}" : "Run test — not available yet")</h3>
                        <p data-testid="pt-run-disabled">@RunReason</p>
                        <p>@(_isNew ? "Check readiness first — you are asked to save the draft as v1." : _dirty ? "Save your changes as a new version first." : "Resolve the required items in Test readiness.")</p>
                        <p><button type="button" class="btn-secondary" @onclick="() => PerformAction(RunBlockedAction)" data-testid="pt-run-go-readiness">@D.ActionLabel(RunBlockedAction ?? "readiness")</button></p></div>
                </div>
            }
            @if (_startBlockers.Count > 0) { <ul class="sd-list" data-testid="pt-start-blockers">@foreach (var b in _startBlockers) { <li>@b</li> }</ul> }
        }
    </section>;

    private RenderFragment Results() => @<BirkNext.Web.Components.PerformanceRunResults Run="_selectedRun" Current="_draft" ActiveBaseline="ActiveBaseline"
        OnOpenComparison="OpenComparisonAsync" OnOpenHistory="OpenHistory" OnOpenScenario="() => _tab = Tab.Scenario" OnGoRun="() => _tab = Tab.Run" OnExport="ExportAsync" />;

    /// <summary>Results → Compare with the run and the baseline it was compared with already selected, and the comparison loaded (no re-selection).</summary>
    private async Task OpenComparisonAsync(PerformanceTestRun run)
    {
        _compareCurrent = run.RunId.ToString();
        _compareReference = run.Drift is { } d ? "b:" + d.BaselineId : "active";
        _compareFromResults = run.RunId;
        _tab = Tab.Compare;
        await CompareAsync();
    }

    /// <summary>Results → History with the run focused (null = History only).</summary>
    private void OpenHistory(PerformanceTestRun? run)
    {
        _tab = Tab.History;
        _historyFocus = run?.RunId;
        if (run is not null) _focusTarget = $"pt-history-{run.RunId:N}";
    }

    private Guid? _compareFromResults, _historyFocus;

    private RenderFragment DriftView(PerformanceDriftAssessment d, string testId) => @<div class="sd-panel" data-testid="@testId" data-state="@d.State">
        <p>Baseline v@(d.BaselineVersion) / run @P.Short(d.BaselineRunId) · <span class="sd-pill sd-pill-@P.Tone(d.State)">@P.Label(d.State)</span></p>
        @foreach (var n in d.CompatibilityNotes) { <p class="sd-reason">@n</p> }
        @DeltaTable(d.Deltas)
        <p class="sd-muted">Drift is change relative to the baseline; thresholds are absolute expectations. Both are shown; neither explains why performance changed.</p>
    </div>;

    private RenderFragment DeltaTable(List<PerformanceMetricDelta> deltas) => @<div class="sd-scroll" tabindex="0" role="region" aria-label="Metric changes">
        <table data-testid="pt-deltas">
            <thead><tr><th scope="col">Metric</th><th scope="col">Reference</th><th scope="col">This run</th><th scope="col">Change</th><th scope="col">Direction</th><th scope="col">Drift policy</th></tr></thead>
            <tbody>
                @foreach (var x in deltas)
                {
                    <tr data-testid="pt-delta" data-metric="@x.Metric"><th scope="row">@PerformanceTestRules.Label(x.Metric)</th><td>@PerformanceTestRules.Format(x.Reference, x.Metric)</td><td>@PerformanceTestRules.Format(x.Current, x.Metric)</td>
                        <td>@P.Delta(x)</td><td>@x.Direction</td><td>@(x.PolicyState is { } s ? $"{P.Label(s)} ({x.PolicyText})" : "—")</td></tr>
                }
            </tbody>
        </table>
    </div>;

    private RenderFragment CompareView() => @<section class="pt-section" aria-labelledby="pt-compare-h" data-testid="pt-compare">
        <h2 id="pt-compare-h">Compare</h2>
        @if (_runs.Count == 0)
        {
            <div class="ptc-empty" data-testid="pt-compare-empty">
                <span class="ptc-empty-icon" aria-hidden="true">⇄</span>
                <div><h3>No comparable runs yet</h3>
                    <p>A comparison needs a completed run and something to compare it with: the active baseline of this definition (promote a run in History), another baseline version, or a second compatible run.</p>
                    <p><button type="button" class="btn-secondary" @onclick="() => _tab = Tab.History" data-testid="pt-compare-open-history">Open History</button></p></div>
            </div>
        }
        else
        {
            <div class="sd-filterbar">
                <label>Run <select @bind="_compareCurrent" data-testid="pt-compare-current">
                    @foreach (var r in _runs) { <option value="@r.RunId">@P.Short(r.RunId) · @P.Utc(r.CreatedAt) · @r.State</option> }
                </select></label>
                <label>Compare with <select @bind="_compareReference" data-testid="pt-compare-reference">
                    <option value="active">Active baseline</option>
                    @foreach (var b in _baselines) { <option value="b:@b.BaselineId">Baseline v@(b.Version) (@b.Status)</option> }
                    @foreach (var r in _runs) { <option value="@r.RunId">Run @P.Short(r.RunId)</option> }
                </select></label>
                <button type="button" class="btn-secondary" @onclick="CompareAsync" data-testid="pt-compare-go">Compare</button>
            </div>
            @if (_comparison is { } c)
            {
                @if (_runs.FirstOrDefault(x => x.RunId.ToString() == _compareCurrent) is { } compared)
                {
                    <p><button type="button" class="sd-link" @onclick="() => { _selectedRun = compared; _tab = Tab.Results; }" data-testid="pt-compare-back">Back to run results</button></p>
                }
                <p data-testid="pt-compare-kind">@(c.AdHoc ? "Ad-hoc comparison (not the run's original result)." : "The run's original baseline comparison.") @(c.Compatible ? "Compatible runs." : "")</p>
                @foreach (var n in c.CompatibilityNotes) { <p class="sd-reason" data-testid="pt-compare-note">@n</p> }
                @if (c.Drift is { } d) { @DriftView(d, "pt-compare-drift") } else { @DeltaTable(c.Deltas) }
                @if (c.ResourceDrift is not null) { <BirkNext.Web.Components.PerformanceResourceResults Drift="c.ResourceDrift" Mode="drift" /> }
            }
            <BirkNext.Web.Components.PerformanceRegressionPanel EnvironmentId="@_profile!.Id" DefinitionId="@_draft.Id" Runs="_runs" Baselines="_baselines" />
        }
    </section>;

    private RenderFragment History() => @<section class="pt-section" aria-labelledby="pt-history-h" data-testid="pt-history">
        <h2 id="pt-history-h">History</h2>
        <label>Show <select @bind="_filter" data-testid="pt-history-filter">@foreach (var f in Enum.GetValues<HistoryFilter>()) { <option value="@f">@f</option> }</select></label>
        @if (_runs.Count == 0)
        {
            <div class="ptc-empty" data-testid="pt-history-empty">
                <span class="ptc-empty-icon" aria-hidden="true">◷</span>
                <div><h3>No runs yet</h3><p>No performance tests have been executed for this definition.</p>
                    <p><button type="button" class="btn-primary" @onclick="() => _tab = Tab.Run" disabled="@(!CanRun)">Run first test</button></p></div>
            </div>
        }
        else
        {
            <div class="sd-scroll" tabindex="0" role="region" aria-label="Run history">
                <table class="pt-history-table" data-testid="pt-history-table">
                    <thead><tr><th scope="col">Run</th><th scope="col">Date</th><th scope="col">Environment</th><th scope="col">Workload</th><th scope="col">Provider / runtime</th><th scope="col">Execution</th><th scope="col">Quality</th><th scope="col">P95</th><th scope="col">RPS</th><th scope="col">Error rate</th><th scope="col">Memory steady</th><th scope="col">Memory peak</th><th scope="col">Resource status</th><th scope="col">Baseline</th><th scope="col">Actions</th></tr></thead>
                    <tbody>
                        @foreach (var r in FilteredRuns)
                        {
                            var baseline = _baselines.FirstOrDefault(b => b.RunId == r.RunId);
                            <tr data-testid="pt-history-row" data-state="@r.State" id="@($"pt-history-{r.RunId:N}")" tabindex="-1" data-selected="@(_historyFocus == r.RunId ? "true" : "false")" class="@(_historyFocus == r.RunId ? "pt-history-selected" : "")">
                                <th scope="row">@P.Short(r.RunId)<span class="sd-context">v@(r.DefinitionVersion)</span></th>
                                <td>@P.Utc(r.CreatedAt)</td><td>@r.DefinitionSnapshot.EnvironmentName</td><td>@r.DefinitionSnapshot.Workload.Purpose · @P.Load(r.DefinitionSnapshot.Workload)</td><td>k6 @r.ProviderVersion · @(r.RuntimeId == PerformanceProviderIds.PodmanRuntime ? "Podman" : r.RuntimeId ?? "—") @r.RuntimeVersion</td>
                                <td>@P.Label(r.State)</td><td>@P.Label(r.Verdict)</td>
                                <td>@PerformanceTestRules.Format(r.Metrics?.Latency.P95Ms, PerformanceMetric.LatencyP95Ms)</td><td>@PerformanceTestRules.Format(r.Metrics?.RequestsPerSecond, PerformanceMetric.ThroughputRps)</td>
                                <td>@PerformanceTestRules.Format(r.Metrics?.ErrorRatePercent, PerformanceMetric.ErrorRatePercent)</td>
                                <td>@(P.ResourceMemory(r)?.LateSteadyValue is { } ms ? ResourceFormat.Format(ms, P.ResourceMemory(r)!.Metric) : r.Resources is null ? "—" : "Unavailable")</td>
                                <td>@(P.ResourceMemory(r)?.PeakValue is { } mp ? ResourceFormat.Format(mp, P.ResourceMemory(r)!.Metric) : r.Resources is null ? "—" : "Unavailable")</td>
                                <td data-testid="pt-history-resources">@P.ResourceStatus(r)</td>
                                <td>@(baseline is null ? "—" : $"v{baseline.Version} ({baseline.Status})")</td>
                                <td>
                                    <button type="button" class="sd-link" @onclick="() => { _selectedRun = r; _tab = Tab.Results; }">View</button>
                                    <button type="button" class="sd-link" @onclick="() => { _compareCurrent = r.RunId.ToString(); _tab = Tab.Compare; }">Compare</button>
                                    @if (r.State == PerformanceRunState.Completed && r.Metrics is not null && !r.MetricsPartial && baseline is null)
                                    {
                                        <button type="button" class="sd-link" @onclick="() => { _promoteRunId = r.RunId; _promoteError = null; }" data-testid="pt-promote-open">Propose as baseline</button>
                                    }
                                    @if (!r.IsActive)
                                    {
                                        <button type="button" class="sd-link" @onclick="() => DeleteRunAsync(r)" data-testid="pt-run-delete">@(_deleteRunId == r.RunId ? "Confirm delete" : "Delete")</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (_deleteError is { } de) { <p class="sd-reason" role="alert" data-testid="pt-run-delete-error">@de</p> }
        @if (_promoteRunId is { } promote && _runs.FirstOrDefault(r => r.RunId == promote) is { } candidate)
        {
            <div class="sd-panel" data-testid="pt-promote">
                <h3>Propose run @P.Short(promote) as baseline</h3>
                <ul class="sd-list" data-testid="pt-promote-eligibility">
                    @foreach (var check in PerformanceRegressionRules.Eligibility(candidate))
                    {
                        <li data-passed="@(check.Passed ? "true" : "false")">@(check.Passed ? "✓" : check.Blocking ? "✗" : "!") @check.Label — @check.Detail</li>
                    }
                </ul>
                <p>Current baseline: @(ActiveBaseline is { } cur ? $"v{cur.Version} (run {P.Short(cur.RunId)})" : "none")</p>
                @if (ActiveBaseline is { } current && _runs.FirstOrDefault(r => r.RunId == current.RunId) is { } currentRun) { @DeltaTable(PerformanceTestRules.Deltas(currentRun.Metrics, candidate.Metrics)) }
                <label>Reason (optional) <input @bind="_promoteReason" maxlength="300" placeholder="e.g. infrastructure upgraded" data-testid="pt-promote-reason" /></label>
                @if (PerformanceRegressionRules.Eligibility(candidate).Any(c => !c.Blocking && !c.Passed))
                {
                    <label class="sd-check"><input type="checkbox" @bind="_promoteAcceptFailures" data-testid="pt-promote-accept" /> Accept the warnings above and use this run as the reference anyway (recorded with the baseline)</label>
                }
                @if (_promoteError is { } pe) { <p class="sd-reason" role="alert">@pe</p> }
                <button type="button" class="btn-primary" @onclick="ProposeAsync" data-testid="pt-propose-confirm">Propose for approval</button>
                <button type="button" class="btn-secondary" @onclick="PromoteAsync" data-testid="pt-promote-confirm">Propose and approve now</button>
                <button type="button" class="btn-secondary" @onclick="() => _promoteRunId = null">Cancel</button>
            </div>
        }
        <h3>Baselines</h3>
        @if (_decisionError is { } decisionError) { <p class="sd-reason" role="alert" data-testid="pt-baseline-decision-error">@decisionError</p> }
        @if (_baselines.Count == 0) { <p class="sd-muted">No baseline selected yet.</p> }
        else
        {
            <div class="sd-scroll" tabindex="0" role="region" aria-label="Baseline history">
                <table data-testid="pt-baselines">
                    <thead><tr><th scope="col">Version</th><th scope="col">Run</th><th scope="col">Effective</th><th scope="col">P95</th><th scope="col">P99</th><th scope="col">RPS</th><th scope="col">Error rate</th><th scope="col">Reason</th><th scope="col">Status</th><th scope="col">Approval</th></tr></thead>
                    <tbody>
                        @foreach (var b in _baselines)
                        {
                            var br = _runs.FirstOrDefault(r => r.RunId == b.RunId);
                            <tr data-testid="pt-baseline-row" data-status="@b.Status"><th scope="row">v@(b.Version)</th><td>@P.Short(b.RunId)</td><td>@P.Utc(b.EffectiveFrom) – @(b.SupersededAt is null ? "now" : P.Utc(b.SupersededAt))</td>
                                <td>@PerformanceTestRules.Format(br?.Metrics?.Latency.P95Ms, PerformanceMetric.LatencyP95Ms)</td><td>@PerformanceTestRules.Format(br?.Metrics?.Latency.P99Ms, PerformanceMetric.LatencyP99Ms)</td>
                                <td>@PerformanceTestRules.Format(br?.Metrics?.RequestsPerSecond, PerformanceMetric.ThroughputRps)</td><td>@PerformanceTestRules.Format(br?.Metrics?.ErrorRatePercent, PerformanceMetric.ErrorRatePercent)</td>
                                <td>@(b.Reason ?? "—")</td><td>@b.Status</td>
                                <td data-testid="pt-baseline-approval">@ApprovalText(b)
                                    @if (b.Status == PerformanceBaselineStatus.Proposed)
                                    {
                                        <span class="pt-baseline-decide">
                                            <button type="button" class="sd-link" @onclick="() => ApproveBaselineAsync(b)" data-testid="pt-baseline-approve">Approve</button>
                                            @if (_rejectingBaselineId == b.BaselineId)
                                            {
                                                <label>Reason <input @bind="_rejectReason" maxlength="300" data-testid="pt-baseline-reject-reason" /></label>
                                                <button type="button" class="sd-link" @onclick="() => RejectBaselineAsync(b)" data-testid="pt-baseline-reject-confirm">Reject</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="sd-link" @onclick="() => { _rejectingBaselineId = b.BaselineId; _decisionError = null; }" data-testid="pt-baseline-reject">Reject…</button>
                                            }
                                        </span>
                                    }
                                </td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>;
}
