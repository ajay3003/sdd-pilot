    {
        public async Task<(BirkNext.Integrations.SetupProfilePreview? Value, string? Error)> PreviewAsync(BirkNext.Integrations.SetupProfileRequest request)
        { var r = await page.Api.PreviewSetupAsync(page._profile!.Id, page._draft, request); return (r.Value, r.Error); }
        public async Task<(BirkNext.Integrations.SetupApplyResult? Value, string? Error)> ApplyAsync(BirkNext.Integrations.SetupApplyRequest request)
        { var r = await page.Api.ApplySetupAsync(page._profile!.Id, page._draft, request); return (r.Value, r.Error); }
        public async Task<(BirkNext.Integrations.SetupProfileExport? Value, string? Error)> ExportAsync(bool example, BirkNext.Integrations.SetupProfileFormat format)
        { var r = await page.Api.ExportSetupAsync(example ? null : page._profile!.Id, page._isNew ? null : page._draft.Id, format); return (r.Value, r.Error); }
