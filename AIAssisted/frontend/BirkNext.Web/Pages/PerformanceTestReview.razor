@page "/performance-test-review"
@using System.Globalization
@using BirkNext.Applicability
@using BirkNext.PerformanceTests
@using BirkNext.Web.Models
@using P = BirkNext.Web.Services.PerformanceTestPresentation
@using D = BirkNext.Web.Services.PerformanceTestReviewDashboard
@using BirkNext.Web.Shared.Components.Common
@using PerformanceThreshold = BirkNext.PerformanceTests.PerformanceThreshold
@using PerformanceMetric = BirkNext.PerformanceTests.PerformanceMetric
@using PerformanceReadinessState = BirkNext.PerformanceTests.PerformanceReadinessState
@inject IPerformanceTestApiService Api
@inject IFrontendAnalysisContextFactory ContextFactory
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IServiceProvider ServiceProvider
@implements IDisposable

<PageTitle>Performance Test Review</PageTitle>

@* Performance Test Review: controlled HTTP/API load tests against the configured Target Environment. Configured ≠ Ready ≠ Executed ≠ Passed;
   a metric without a threshold is measured, not passed; a missing provider is a tool limitation, never a performance failure. The backend owns
   every safety rule (production refused, relative paths only, read-only methods, query-only GraphQL, load limits). *@
<div class="sd-workspace pt-page ptc" data-testid="pt-page" aria-busy="@(_loaded ? "false" : "true")">
    <BirkNext.Web.Components.ProjectContextStrip />
    @if (_readiness?.Items.FirstOrDefault(i => i.Key == "ca-trust" && i.Status == "Blocked") is { } tlsBlocked)
    {
        @* Runtime execution only: designing, editing and reviewing the test stay available. *@
        <p class="ptc-banner ptc-banner-warning" role="status" data-testid="pt-runtime-blocked">
            <strong>Runtime execution unavailable for @_draft.EnvironmentName.</strong> @(tlsBlocked.Headline.Replace("Execution blocked — ", "TLS validation failed because the ")).
            You can continue designing and reviewing the performance test.
            @if (D.ActionHref(PerformanceReadinessActions.OpenLocalExecutionSetup, _draft.Id.ToString()) is { } tlsHref) { <a href="@tlsHref" data-testid="pt-runtime-blocked-details">View TLS details</a> }
        </p>
    }
    <header class="ptc-header">
        <div class="ptc-header-text">
            <h1 class="pt-title">Performance Test Review</h1>
            <p class="ptc-lead" data-testid="pt-purpose">Measure how configured HTTP/API targets behave under controlled load and verify latency, throughput and errors against explicit expectations. <a class="ug-learn-more" href="/user-guide#performance-test-review" data-testid="pt-learn-more">Learn more</a></p>
        </div>
        @if (_loaded && _profile is not null && _overview is not null)
        {
            <div class="ptc-header-side">
                <span class="ptc-status-line"><span class="ptc-status-label" aria-hidden="true">Test readiness</span> <span data-testid="pt-status">@Pill(PageState, "Test readiness")</span></span>
                <div class="ptc-actions" data-testid="pt-definition-bar">
                    @{ var headerNext = NextStepNow; }
                    @if (headerNext.Action is { } headerAction && headerAction is not ("run" or "history") && ActiveRun is null)
                    {
                        @ActionControl(headerAction, NextItem, true, "pt-primary-action")
                    }
                    <button type="button" class="@(CanRun || ActiveRun is not null ? "btn-primary ptc-run" : "btn-secondary")" @onclick="RunTestAsync" disabled="@(!RunEnabled)" data-testid="pt-run-open" aria-describedby="pt-run-reason">@(ActiveRun is not null ? "View run" : "Run test")</button>
                    <button type="button" class="btn-secondary" @onclick="() => _tab = Tab.Scenario" data-testid="pt-configure">Configure test</button>
                    <button type="button" class="ptc-link" @onclick="NewDefinition" data-testid="pt-new">+ New definition</button>
                </div>
                @if (!CanRun && ActiveRun is null) { <p class="ptc-run-reason" id="pt-run-reason" data-testid="pt-run-reason">@RunReason</p> }
            </div>
        }
    </header>

    @if (!_loaded)
    {
        <div class="ptc-skeleton" role="status" aria-label="Loading Performance Test Review"><span></span><span></span><span></span><span></span></div>
    }
    else if (_profile is null)
    {
        <div class="ptc-empty" data-testid="pt-no-target">
            <span class="ptc-empty-icon" aria-hidden="true">◎</span>
            <div><h2>No performance target configured</h2><p>Select a Target Environment to define performance tests for its HTTP/API target.</p>
                <p><a class="btn-primary" href="admin/system-settings?section=target-environments">Open Target Environments</a></p></div>
        </div>
    }
    else if (_overview is null)
    {
        <div class="ptc-empty ptc-empty-error" role="alert" data-testid="pt-unavailable">
            <span class="ptc-empty-icon" aria-hidden="true">!</span>
            <div><h2>Performance tests could not be loaded</h2><p>Performance tests are stored and executed by the backend; nothing is shown until the overview can be read.</p>
                <BackendRequestNotice Error="Api.LastReadError" OnRetry="() => ReloadAsync(null)" TestId="pt-unavailable-detail" /></div>
        </div>
    }
    else
    {
        <BirkNext.Web.Components.RuntimeAuthenticationCapability OperationKey="@BirkNext.RuntimeAuthentication.RuntimeAuthenticationCatalog.PerformanceK6" Profile="_profile" />
        var groups = D.Groups(_isNew, _dirty, _readiness);
        var (readyCount, requiredCount) = D.RequiredCounts(groups);
        var envSafety = D.EnvironmentSafety(_draft.EnvironmentType, _readiness);
        var engine = D.Engine(_overview.Provider);
        var definitionState = D.DefinitionState(_isNew, _dirty, _draft.Version, DraftValid);

        @if (D.IsProduction(_draft.EnvironmentType))
        {
            <section class="ptc-callout ptc-callout-blocked" role="alert" data-testid="pt-production-block" aria-labelledby="pt-prod-h">
                <span class="ptc-callout-icon" aria-hidden="true">✕</span>
                <div><h2 id="pt-prod-h">Execution blocked</h2><p>Performance tests cannot run against Production. Select a non-production Target Environment.</p></div>
            </section>
        }

        <div class="ptc-primary">
            <section class="ptc-card ptc-accent-info" aria-labelledby="pt-card-target-h" data-testid="pt-card-target">
                <h2 id="pt-card-target-h" class="ptc-card-title"><span class="ptc-icon" aria-hidden="true">◎</span>Target</h2>
                <p class="ptc-value ptc-break" data-testid="pt-hero-target">@(string.IsNullOrWhiteSpace(_draft.TargetOrigin) ? "Not configured" : _draft.TargetOrigin)</p>
                <p class="ptc-sub">@D.TargetLabel(_draft.TargetType) · from the Target Environment</p>
                @if (_targetDrift is { } drift)
                {
                    <p class="ptc-sub ptc-drift" role="status" data-testid="pt-target-drift">The Target Environment changed since this definition was saved (saved: @(drift.SavedOrigin.Length == 0 ? "no target" : drift.SavedOrigin)@(drift.SavedEnvironmentName != drift.LiveEnvironmentName ? $" · {drift.SavedEnvironmentName}" : "")). Save this version to run against @(drift.LiveOrigin.Length == 0 ? "the current environment" : drift.LiveOrigin).</p>
                }
                @if (string.IsNullOrWhiteSpace(_draft.TargetOrigin)) { <p><a href="admin/system-settings?section=target-environments">Configure the target</a></p> }
            </section>

            <section class="ptc-card @(envSafety.Tone switch { PtTone.Blocked => "ptc-accent-blocked", PtTone.Ready => "ptc-accent-ready", PtTone.Attention => "ptc-accent-attention", _ => "ptc-accent-resource" })" aria-labelledby="pt-card-env-h" data-testid="pt-card-environment">
                <h2 id="pt-card-env-h" class="ptc-card-title"><span class="ptc-icon" aria-hidden="true">⌂</span>Environment</h2>
                <p class="ptc-value" data-testid="pt-hero-environment">@_draft.EnvironmentName <span class="ptc-env-type">@_draft.EnvironmentType</span></p>
                <dl class="ptc-facts">
                    <div><dt>Classification</dt><dd>@D.Classification(_draft.EnvironmentType)</dd></div>
                    <div><dt>Safety</dt><dd data-testid="pt-env-safety">@Pill(envSafety, "Environment safety")</dd></div>
                </dl>
            </section>

            <section class="ptc-card ptc-card-readiness ptc-accent-@PageState.ToneClass" aria-labelledby="pt-card-ready-h" data-testid="pt-card-readiness">
                <h2 id="pt-card-ready-h" class="ptc-card-title"><span class="ptc-icon" aria-hidden="true">✓</span>Test readiness</h2>
                <p class="ptc-value" data-testid="pt-hero-readiness">@PageState.Label</p>
                <p class="ptc-sub" data-testid="pt-readiness-count">@(_readiness is null || _isNew || _dirty ? "Whether this definition can run safely. Check readiness evaluates a saved version (you are asked to save a new draft as v1 first)." : $"{readyCount} of {requiredCount} required readiness checks satisfied for this definition")</p>
                @if (PageState.Reason is { } why) { <p class="ptc-reason" data-testid="pt-readiness-reason">@why</p> }
                <ul class="ptc-mini-checks">
                    @foreach (var c in groups.SelectMany(g => g.Checks.Select(c => (g.Name, c))).Where(x => x.Name != "Optional" || x.c.Key is "resources").Take(7))
                    {
                        <li class="ptc-tone-@c.c.Status.ToneClass"><span aria-hidden="true">@c.c.Status.Glyph</span> @c.c.Label<span class="visually-hidden">: @c.c.Status.Label</span></li>
                    }
                </ul>
                <button type="button" class="ptc-link" @onclick="() => _tab = Tab.Readiness" data-testid="pt-view-readiness">View readiness</button>
            </section>

            <section class="ptc-card ptc-card-engine" aria-labelledby="pt-card-engine-h" data-testid="pt-card-engine">
                <h2 id="pt-card-engine-h" class="ptc-card-title"><span class="ptc-icon" aria-hidden="true">⚙</span>Execution engine @Pill(engine, "Execution engine")</h2>
                <dl class="ptc-facts">
                    <div><dt>Provider</dt><dd data-testid="pt-hero-provider">@ProviderText</dd></div>
                    <div><dt>Runtime</dt><dd data-testid="pt-hero-runtime">@RuntimeText</dd></div>
                    <div><dt>Image</dt><dd class="ptc-break" data-testid="pt-hero-image">@ImageText</dd></div>
                </dl>
                <ul class="ptc-chips" aria-label="Supported target types" data-testid="pt-target-chips">
                    @foreach (var t in D.TargetTypes(_overview.Provider?.Capabilities)) { <li class="ptc-chip"><span aria-hidden="true">✓</span> @t</li> }
                </ul>
                <p class="ptc-sub" data-testid="pt-engine-meaning">The load-test tool on this machine. @(engine.Label == "Available" ? D.EngineAvailableMeaning : "")</p>
                @if (engine.Label != "Available") { <p class="ptc-sub"><a href="admin/system-settings?section=performance-test-engines" data-testid="pt-open-engines">Open Performance Test Engines</a></p> }
            </section>
        </div>

        <section class="ptc-definition" aria-labelledby="pt-def-h" data-testid="pt-definition-card">
            <h2 id="pt-def-h" class="visually-hidden">Test definition</h2>
            <label class="ptc-select">Test definition
                <select value="@(_draft.Id)" @onchange="SelectDefinition" data-testid="pt-definition-select">
                    @foreach (var d in _overview.Definitions) { <option value="@d.Id">@d.Name · v@(d.Version)</option> }
                    @if (_isNew) { <option value="">@(_draft.Name) (draft, not saved yet)</option> }
                </select>
            </label>
            <dl class="ptc-def-facts">
                <div><dt>Status</dt><dd data-testid="pt-definition-state"><span data-testid="pt-save-state">@Pill(_saveFailed ? new("Save failed", "✕", PtTone.Blocked) : definitionState, "Test definition")</span></dd></div>
                <div><dt>Scenario</dt><dd>@_draft.Scenario.Name</dd></div>
                <div><dt>Version</dt><dd>@(_isNew ? "—" : $"v{_draft.Version}")</dd></div>
            </dl>
            <div class="ptc-def-save">
                <button type="button" class="@(_dirty && !_isNew ? "btn-primary" : "btn-secondary")" @onclick="SaveAsync" disabled="@((!_dirty && !_isNew) || _saving || _isNew && !DraftValid)" aria-describedby="pt-save-hint" data-testid="pt-save">@(_saving ? "Saving…" : _saveFailed ? "Retry save" : _isNew ? "Save definition" : "Save changes as new version")</button>
                <span class="ptc-save-hint" id="pt-save-hint" data-testid="pt-save-hint">@(_saving ? "Saving the definition…" : _isNew ? DraftValid ? "Check readiness asks to save the draft as v1 first." : $"Required before readiness: {string.Join(", ", D.DraftIssues(_draft))}." : _dirty ? $"Unsaved changes to v{_draft.Version} — saving creates v{_draft.Version + 1}; earlier runs keep theirs." : $"Saved as v{_draft.Version}.")</span>
            </div>
            @if (_saveError is { } saveError) { <p class="ptc-save-error" role="alert" data-testid="pt-save-error">Not saved: @saveError Your changes are kept; retry when the cause is fixed.</p> }
        </section>
        @if (_message is { } message) { <p class="sd-reason" role="status" data-testid="pt-message">@message</p> }
        @* Explicit versions: Draft → Saved vN → Readiness checked for vN → Ready to run. Nothing is saved or versioned without a click. *@
        <ol class="ptc-version-flow" aria-label="Definition version workflow" data-testid="pt-version-flow">
            @foreach (var (key, label, state) in VersionFlow)
            {
                <li class="ptc-flow-step is-@state" data-testid="pt-flow-step" data-step="@key" data-state="@state" aria-current="@(state == "current" ? "step" : null)">@label</li>
            }
        </ol>
        @if (_saveFirstPrompt && _isNew)
        {
            <div class="ptc-save-first" role="alertdialog" aria-labelledby="pt-save-first-h" data-testid="pt-save-first">
                <p id="pt-save-first-h"><strong>Readiness is checked on a saved version.</strong> Save this draft as v1 first? Nothing runs; the draft stays editable and later edits become v2.</p>
                <button type="button" class="btn-primary" disabled="@_saving" data-testid="pt-save-and-check" @onclick="SaveAndCheckAsync">Save as v1 and check readiness</button>
                <button type="button" class="btn-secondary" data-testid="pt-save-first-cancel" @onclick="() => _saveFirstPrompt = false">Not now</button>
            </div>
        }
        @if (_dirty && !_isNew)
        {
            <p class="ptc-unsaved" role="status" data-testid="pt-unsaved-banner"><span aria-hidden="true">✎ </span><strong>Unsaved changes to v@(_draft.Version).</strong>
                Readiness and runs use the saved v@(_draft.Version) until you save these changes as v@(_draft.Version + 1).
                <button type="button" class="btn-link" disabled="@_saving" data-testid="pt-unsaved-save" @onclick="SaveAsync">Save as v@(_draft.Version + 1)</button></p>
        }
        <BirkNext.Web.Components.PerformanceStatusStrip Status="ScenarioStatus" OnOpenScenario="() => _tab = Tab.Scenario" />

        <nav class="ptc-tabs" aria-label="Performance test sections" data-testid="pt-tabs">
            @TabButton(Tab.Overview)
            @foreach (var (group, tabs) in TabGroups)
            {
                <div class="ptc-tab-group" role="group" aria-labelledby="@($"pt-tabgroup-{group.ToLowerInvariant()}")" data-testid="pt-tab-group" data-group="@group">
                    <span class="ptc-tab-group-label" id="@($"pt-tabgroup-{group.ToLowerInvariant()}")">@group</span>
                    <div class="ptc-tab-group-tabs">@foreach (var t in tabs) { @TabButton(t) }</div>
                </div>
            }
        </nav>

        @switch (_tab)
        {
            case Tab.Overview: @Overview() break;
            case Tab.Scenario: @Scenario() break;
            case Tab.Workload: @Workload() break;
            case Tab.Thresholds: @Thresholds() break;
            case Tab.Resources: @ResourcesView() break;
            case Tab.Readiness: @ReadinessView() break;
            case Tab.Run: @RunView() break;
            case Tab.Results: @Results() break;
            case Tab.Compare: @CompareView() break;
            case Tab.History: @History() break;
        }

        <section class="ptc-technical-section" aria-label="Pipeline performance gates" data-testid="pt-delivery-section">
            <ReviewDisclosure Text="Pipeline performance gates" CollapseText="Hide pipeline performance gates" Hint="@($"Pipelines that deliver this target · {DeliveryGateStates.ConfiguredNoExecution}")" TestId="pt-delivery-gates" Class="ptc-technical" @bind-Expanded="_deliveryExpanded">
                @if (_deliveryExpanded)
                {
                    <BirkNext.Web.Components.DeliveryEvidencePanel Categories="@([BirkNext.PipelineReview.ValidationCategory.Performance])" ScopeTargetOrigin="@_draft.TargetOrigin"
                        ScopeEnvironmentName="@_draft.EnvironmentName" ScopeEnvironmentType="@_draft.EnvironmentType" ConfirmedPipelineIds="_draft.DeliveryPipelineIds ?? []" OnConfirmPipelines="ConfirmPipelines"
                        SuggestedSnapshotId="@_draft.Scenario.ContractSnapshotId" SuggestedReason="this scenario's contract source"
                        Note="Performance gates as the pipelines that deliver this target define them — not every pipeline in the source. Choose the snapshot; none is selected automatically." />
                }
            </ReviewDisclosure>
        </section>
        <section class="ptc-technical-section" aria-label="Technical details" data-testid="pt-technical-section">
        <ReviewDisclosure Text="Show technical details" CollapseText="Hide technical details" Hint="IDs, provider and image" TestId="pt-technical" Class="ptc-technical">
            <dl class="ptc-tech">
                <div><dt>Definition ID</dt><dd><code>@(_isNew ? "(not saved)" : _draft.Id)</code></dd></div>
                <div><dt>Comparison fingerprint</dt><dd><code>@(_draft.ComparisonFingerprint is { Length: > 0 } fp ? fp : "—")</code></dd></div>
                @if (_overview.Provider is { } p)
                {
                    <div><dt>Provider ID</dt><dd><code>@p.ProviderId</code></dd></div>
                    <div><dt>Provider detail</dt><dd>@p.Detail</dd></div>
                    @if (p.Runtime is { } rt) { <div><dt>Runtime ID</dt><dd><code>@rt.RuntimeId</code> @rt.Version</dd></div> }
                    <div><dt>Image reference</dt><dd><code>@(p.Image ?? "—")</code></dd></div>
                    <div><dt>Image digest</dt><dd><code>@(p.ImageDigest ?? "—")</code></dd></div>
                    <div><dt>Image pull</dt><dd>@(p.AllowImagePull ? "Allowed on request" : "Disabled (pull on the host)")</dd></div>
                }
            </dl>
        </ReviewDisclosure>
        </section>
    }
</div>

@code {
    private enum Tab { Overview, Scenario, Workload, Thresholds, Resources, Readiness, Run, Results, Compare, History }

    /// <summary>Define (what to test), Execute (whether and when to run), Analyze (what happened). Overview stands alone.</summary>
    private static readonly (string Group, Tab[] Tabs)[] TabGroups =
    [
        ("Define", [Tab.Scenario, Tab.Workload, Tab.Thresholds, Tab.Resources]),
        ("Execute", [Tab.Readiness, Tab.Run]),
        ("Analyze", [Tab.Results, Tab.Compare, Tab.History]),
    ];

    private RenderFragment TabButton(Tab t) => __builder =>
    {
        var badge = TabBadge(t);
        <button type="button" class="ptc-tab" aria-pressed="@(_tab == t ? "true" : "false")" @onclick="() => _tab = t" data-testid="pt-tab-@t.ToString().ToLowerInvariant()">@t@if (badge is { } b) { <span class="ptc-tab-badge ptc-tone-@b.ToneClass"><span aria-hidden="true">@b.Glyph</span><span class="visually-hidden">, @b.Label</span></span> }</button>
    };

    private bool _saving;
    private bool _deliveryExpanded;
    private bool _saveFailed;
    private string? _saveError;
    private List<ResourceTargetStatus> _resourceTargets = [];

    private RenderFragment ResourcesView() => __builder =>
    {
        var current = !_isNew && !_dirty;
        var rows = PerformanceResourcePresentation.Rows(_overview?.Provider, _readiness, current, _runs.FirstOrDefault(r => !r.IsActive), _draft.TargetOrigin);
        var warnings = PerformanceResourcePresentation.Warnings(_overview?.Provider, _readiness, current);
        <section class="pt-section" aria-labelledby="pt-resources-h" data-testid="pt-resources">
            <h2 id="pt-resources-h">Resources</h2>
            <p class="sd-muted">What the k6 load generator runs on. Configuration is not enforcement: each resource is shown as configured, validated, available in the runtime and verified by a run — each from its own evidence.</p>
            @if (!current) { <p class="ptc-reason" data-testid="pt-resources-unsaved">Validation reflects saved versions only — save and check readiness to validate this version.</p> }
            <div class="ptc-res-wrap">
                <table class="ptc-res-table" data-testid="pt-exec-resources">
                    <caption class="visually-hidden">Execution resources by stage: configured, validated, runtime available and execution verified</caption>
                    <thead><tr><th scope="col">Resource</th>@foreach (var s in PerformanceResourcePresentation.StageLabels) { <th scope="col">@s</th> }</tr></thead>
                    <tbody>
                        @foreach (var row in rows)
                        {
                            <tr data-testid="pt-exec-resource" data-key="@row.Key" data-warning="@(row.HasWarning ? "true" : "false")">
                                <th scope="row">@row.Title</th>
                                @foreach (var (stage, label) in new[] { row.Configured, row.Validated, row.Runtime, row.Verified }.Zip(PerformanceResourcePresentation.StageLabels))
                                {
                                    <td data-label="@label" data-testid="pt-exec-stage" data-stage="@label" data-state="@stage.State">
                                        <span class="ptc-stage ptc-stage-@stage.State.ToString().ToLowerInvariant()">@PerformanceResourcePresentation.Label(stage.State)</span>
                                        <span class="ptc-stage-detail">@stage.Detail</span>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <section class="ptc-panel" aria-labelledby="pt-runtime-warnings-h" data-testid="pt-runtime-warnings">
                <h3 id="pt-runtime-warnings-h">Runtime capability warnings</h3>
                @if (warnings.Count == 0) { <p class="sd-muted" data-testid="pt-runtime-warnings-none">@(current && _readiness is not null ? "None reported by the last readiness check." : "Not checked yet.")</p> }
                else { <ul>@foreach (var w in warnings) { <li data-testid="pt-runtime-warning">@w</li> }</ul> }
            </section>
            <h3>Resource Stability observation (optional)</h3>
            <BirkNext.Web.Components.PerformanceResourceConfig Config="_draft.ResourceObservation" Targets="_resourceTargets" Workload="_draft.Workload"
                OnChange="c => Changed(_draft with { ResourceObservation = c })" />
        </section>
    };
    private enum HistoryFilter { All, Baselines, Regressions, ThresholdFailures, Cancelled, ExecutionFailures }

    private bool _loaded;
    private FrontendAnalysisProfile? _profile;
    private BirkNext.LocalHttpsProxy.AuthenticatedReviewIdentity? _identity;
    private PerformanceTestOverview? _overview;
    private PerformanceTestDefinition _draft = new();
    private bool _isNew;
    private bool _dirty;
    private bool _saveFirstPrompt, _saveConfirmed;

    /// <summary>The draft is saved as v1 only after this explicit confirmation; then readiness is checked on that version.</summary>
    private async Task SaveAndCheckAsync()
    {
        _saveConfirmed = true;
        await CheckReadinessAsync();
    }

    private PerformanceScenarioStatus ScenarioStatus => PerformanceScenarioStatusModel.Of(_draft,
        _testDataAssets.Count == 0 ? null : _testDataAssets.Select(a => a.Alias).ToHashSet(StringComparer.Ordinal), _historyLoaded && !_historyFailed ? ObservedAuthentication ?? new HashSet<string>() : null);

    /// <summary>Draft → Saved vN → Readiness checked → Ready to run, each done / current / todo.</summary>
    private IReadOnlyList<(string Key, string Label, string State)> VersionFlow =>
    [
        ("draft", _isNew ? "Draft (not saved)" : _dirty ? $"Unsaved changes to v{_draft.Version}" : "Draft", _isNew || _dirty ? "current" : "done"),
        ("saved", _isNew ? "Saved as v1" : $"Saved as v{_draft.Version}", _isNew || _dirty ? "todo" : "done"),
        ("readiness", "Readiness checked", _isNew || _dirty ? "todo" : _readiness is null ? "current" : "done"),
        ("ready", "Ready to run", _isNew || _dirty || _readiness is null ? "todo" : _readiness.Ready ? "done" : "current"),
    ];
    private PerformanceTestReadiness? _readiness;
    private List<PerformanceTestRun> _runs = [];
    private List<PerformanceBaseline> _baselines = [];
    private PerformanceTestRun? _selectedRun;
    private PerformanceRunComparison? _comparison;
    private string? _compareCurrent;
    private string _compareReference = "active";
    private string? _message;
    private List<string> _startBlockers = [];
    private string? _versionLabel;
    private Tab _tab = Tab.Overview;
    private HistoryFilter _filter = HistoryFilter.All;
    private Guid? _promoteRunId;
    private string? _promoteReason;
    private bool _promoteAcceptFailures;
    private string? _promoteError;
    private string? _decisionError, _rejectReason, _rejectingBaselineId;
    private Guid? _deleteRunId;
    private string? _deleteError;
    private System.Threading.Timer? _poll;
    private PerformanceTargetDrift? _targetDrift;

    // The backend refuses Production; the button follows the same rule so it never offers what the backend will reject.
    private bool CanRun => !_isNew && !_dirty && _readiness?.Ready == true && !(_runs.FirstOrDefault()?.IsActive ?? false) && !D.IsProduction(_draft.EnvironmentType);

    /// <summary>Run test is a flow, not a start: a draft is saved and readiness evaluated first; a run still needs the explicit confirmation in Run.</summary>
    private bool RunEnabled => ActiveRun is not null || !D.IsProduction(_draft.EnvironmentType) && !_dirty && (!_isNew || DraftValid) && !_saving;

    private bool DraftValid => D.DraftIssues(_draft).Count == 0;

    /// <summary>What "Cannot run yet" offers: check readiness for a draft, save edits as a new version, otherwise review the blockers.</summary>
    private string? RunBlockedAction => _isNew ? "check-readiness" : _dirty ? "save-version" : null;

    private NextStep NextStepNow => D.Next(PageState, _isNew, _dirty, _readiness, _runs, ActiveBaseline, DraftValid);

    /// <summary>The readiness item the next action resolves (for its label and disclosure).</summary>
    private PerformanceReadinessItem? NextItem => _readiness?.Items.FirstOrDefault(i => i.Blocking && i.Action == NextStepNow.Action);
    private PerformanceTestRun? ActiveRun => _runs.FirstOrDefault(r => r.IsActive);
    private PerformanceBaseline? ActiveBaseline => _baselines.FirstOrDefault(b => b.Status == PerformanceBaselineStatus.Active && b.ComparisonFingerprint == _draft.ComparisonFingerprint);

    private string RuntimeText => _overview?.Provider?.Runtime is { } rt
        ? rt.Availability == ProviderAvailability.Available ? $"{rt.DisplayName} {rt.Version}" : $"{rt.DisplayName}: {P.Label(rt.Availability)} (tool limitation)"
        : "—";

    private string ImageText => _overview?.Provider is { Image: { } image } p ? $"{PerformanceEngineCapabilityPresentation.ShortImage(image)} — {(p.ImagePresent ? "present" : "missing")}" : "—";

    private PtStatus PageState => D.PageStatus(_isNew, _dirty, _readiness, ActiveRun, _draft.EnvironmentType, DraftValid);

    /// <summary>Why Run is unavailable, shown next to the button (never only in a tooltip).</summary>
    private string RunReason => ActiveRun is not null ? "A run is in progress."
        : D.IsProduction(_draft.EnvironmentType) ? "Blocked: Production is not allowed."
        : _isNew ? DraftValid ? "Run test saves the draft as v1, checks readiness and then asks for confirmation." : "Complete the required fields first."
        : _dirty ? "Save your changes as a new version before running."
        : _readiness is null ? "Readiness could not be evaluated."
        : _readiness.Ready ? "" : $"{PageState.Label}. {PageState.Reason ?? "See Test readiness."}";

    private PtStatus? TabBadge(Tab t) => t switch
    {
        Tab.Scenario => _draft.Scenario.Steps.Count > 0 ? new($"{_draft.Scenario.Steps.Count} step(s)", "✓", PtTone.Ready) : new("No steps", "!", PtTone.Attention),
        Tab.Workload => _overview is not null && PerformanceWorkloadPresentation.Issues(_draft.Workload, _overview.Limits, _draft.Scenario.Steps).Count is > 0 and var wi ? new($"{wi} problem(s)", "!", PtTone.Attention) : null,
        Tab.Thresholds => PerformanceTestRules.ThresholdProblems(_draft.Thresholds).Count(p => p is not null) is > 0 and var ti ? new($"{ti} invalid", "!", PtTone.Attention)
            : _draft.Thresholds.Count > 0 ? new($"{_draft.Thresholds.Count} configured", _draft.Thresholds.Count.ToString(), PtTone.Info) : null,
        Tab.Resources => _draft.ResourceObservation is { Enabled: true } ? new("Enabled", "✓", PtTone.Resource) : new("Optional", "○", PtTone.Neutral),
        Tab.Readiness => PageState.Tone switch { PtTone.Ready => new("Ready", "✓", PtTone.Ready), PtTone.Blocked => new("Blocked", "✕", PtTone.Blocked), PtTone.Running => null, _ => new("Needs action", "!", PtTone.Attention) },
        Tab.Run => ActiveRun is not null ? new("Running", "▶", PtTone.Running) : null,
        Tab.History => _runs.Count > 0 ? new($"{_runs.Count} run(s)", _runs.Count.ToString(), PtTone.Neutral) : null,
        _ => null,
    };

    /// <summary>Status pill: decorative glyph + text; <paramref name="subject"/> prefixes the spoken text ("Readiness status: Needs configuration").</summary>
