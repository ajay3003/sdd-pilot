    private RenderFragment Timeline(PerformanceWorkload w) => __builder =>
    {
        var total = Math.Max(1, w.TotalSeconds);
        <div class="ptc-timeline" data-testid="pt-timeline-visual">
            <p class="visually-hidden">Workload timeline: @D.PhasesText(w).</p>
            <div class="ptc-phase-bar" aria-hidden="true">
                @foreach (var (phase, _, _) in D.PhaseWindows(w))
                {
                    <span class="ptc-phase-segment ptc-phase-@phase.Key" style="flex-grow: @phase.Seconds; flex-basis: @((100.0 * phase.Seconds / total).ToString("0.##", CultureInfo.InvariantCulture))%"></span>
                }
