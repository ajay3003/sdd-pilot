    private void ContinueSetup() { _tab = Tab.Readiness; _showSetup = true; _focusSetup = true; }

    private async Task ReloadAfterProfileAsync() => await ReloadAsync(_isNew ? null : _draft.Id);

    /// <summary>Guided Setup step actions: the owner of each fix, or the same in-page action the readiness list offers.</summary>
    private JourneySetupPresentation.StepAction SetupAction(BirkNext.Integrations.JourneySetupStep step) => step.Kind switch
    {
        BirkNext.Integrations.JourneySetupStepKind.Target or BirkNext.Integrations.JourneySetupStepKind.Environment =>
            new("Open Target Environments", D.ActionHref(PerformanceReadinessActions.ConfigureTarget), "The target and environment come from the Target Environment; production is refused."),
        BirkNext.Integrations.JourneySetupStepKind.Scenario => _isNew ? new("Check readiness", null, "The draft is saved as v1 automatically.", "check-readiness")
            : _dirty ? new("Save changes as new version", null, null, "save-version") : new("Edit scenario", null, null, PerformanceReadinessActions.EditScenario),
        BirkNext.Integrations.JourneySetupStepKind.ExecutionEngine or BirkNext.Integrations.JourneySetupStepKind.ContainerRuntime =>
            new("Open Performance Test Engines", D.ActionHref(PerformanceReadinessActions.OpenEngines), null),
        BirkNext.Integrations.JourneySetupStepKind.NetworkReachability => _isNew || _dirty ? new("Check readiness", null, null, "check-readiness")
            : new("Check container network", null, $"Sends one request from the k6 container to the {_draft.EnvironmentName} target. It is not a load test.", PerformanceReadinessActions.CheckNetwork),
        BirkNext.Integrations.JourneySetupStepKind.CaTrust => new("Open local execution setup", D.ActionHref(PerformanceReadinessActions.OpenLocalExecutionSetup, ContextDefinitionId),
            "Configuration: PerformanceTests:Container:CaBundlePath (a PEM bundle of the corporate CA). TLS verification is never disabled."),
        BirkNext.Integrations.JourneySetupStepKind.Authentication => new("Review authentication", null,
            "Authenticated scenarios use approved non-interactive credentials from the existing authentication mechanisms; Performance Test Review never issues or stores credentials."),
        BirkNext.Integrations.JourneySetupStepKind.Workload => new("Edit workload", null, null, PerformanceReadinessActions.EditWorkload),
        BirkNext.Integrations.JourneySetupStepKind.Thresholds => new("Edit thresholds", null, "Thresholds are configured expectations, not universal standards.", PerformanceReadinessActions.EditThresholds),
        BirkNext.Integrations.JourneySetupStepKind.ResourceObservation => new("Open Resources", null, "Optional; disabled observation is never a failure.", "resources"),
        BirkNext.Integrations.JourneySetupStepKind.Baseline => new("Open history", null, "Promotion to baseline is explicit after a completed run.", "history"),
        _ => _readiness?.Ready == true && !_isNew && !_dirty ? new("Run test", null, "Asks for confirmation before sending real load.", "run") : new("Check readiness", null, null, "check-readiness"),
    };

    private ISetupProfileTransport ProfileTransport => new PerformanceProfileTransport(this);

    /// <summary>Performance setup profiles: same shared panel, Performance endpoints; the target is the page's current Target Environment.</summary>
