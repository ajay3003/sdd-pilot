    /// <summary>An action as a control: a link to the owner page, or a button for an in-page action. <paramref name="primary"/> only for THE next action.</summary>
    private RenderFragment ActionControl(string action, PerformanceReadinessItem? item, bool primary, string testId) => __builder =>
    {
        var label = D.ActionLabel(action, item);
        var css = primary ? "btn-primary" : "btn-secondary";
