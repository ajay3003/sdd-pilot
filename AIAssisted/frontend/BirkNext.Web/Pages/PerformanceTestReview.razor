                        <span class="ptc-phase-label">@phase.Label</span>
                        <span class="ptc-phase-time">@P.Duration(start)–@P.Duration(end) · @P.Duration(phase.Seconds)</span>
                    </li>
                }
            </ol>
        </div>
    };

    /// <summary>One dispatcher for every action (header, Overview, Readiness, Guided Setup): the same operation wherever it is offered.</summary>
    private async Task PerformAction(string? action)
    {
        if (action is not null && D.ActionHref(action, ContextDefinitionId) is { } href) { Nav.NavigateTo(href); return; }
        switch (action)
        {
            case "check-readiness": await CheckReadinessAsync(); break;
            case "save" or "save-version": await SaveAsync(); break;
            case "run": await RunTestAsync(); break;
            case "history": _tab = Tab.History; break;
            case "scenario" or PerformanceReadinessActions.EditScenario:
                _tab = Tab.Scenario;
                // An authentication or execution-credential blocker is fixed in Scenario authentication: focus it (selection and focus, not scrolling).
                if (_readiness?.Items.Any(i => i.Blocking && i.Key is "credential" or "authentication") == true) _focusTarget = "pt-scenario-auth";
                break;
            case PerformanceReadinessActions.EditWorkload: _tab = Tab.Workload; break;
            case PerformanceReadinessActions.EditThresholds: _tab = Tab.Thresholds; break;
            case "resources": _tab = Tab.Resources; break;
            case PerformanceReadinessActions.CheckNetwork: _tab = Tab.Readiness; await CheckNetworkAsync(); break;
            default: _tab = Tab.Readiness; await FocusFirstBlockerAsync(); break;
        }
    }

    /// <summary>
    /// Check readiness: a new, complete draft is saved as v1 first — only after the explicit "Save as v1 and check readiness" — then the backend evaluates the
    /// saved version. Edits of a saved version are never versioned silently: they need "Save changes as new version". Nothing runs.
    /// </summary>
    private async Task CheckReadinessAsync()
    {
        if (_isNew)
        {
            if (!DraftValid) { _message = $"Complete the definition first: {string.Join(", ", D.DraftIssues(_draft))}."; _tab = Tab.Scenario; return; }
            // Saving creates v1: asked, never done silently by a readiness check.
            if (!_saveConfirmed) { _saveFirstPrompt = true; _tab = Tab.Readiness; return; }
            _saveConfirmed = _saveFirstPrompt = false;
            var saved = await SaveCoreAsync();
            if (saved is null) return;
            _message = $"Definition saved as v{saved.Version} before readiness evaluation.";
        }
        else if (_dirty)
        {
            _message = $"You changed v{_draft.Version}. Readiness is evaluated on saved versions: use Save changes as new version first.";
            _tab = Tab.Readiness;
            return;
        }
        _tab = Tab.Readiness;
        await CoordinatedCheckAsync();
    }

    private PerformanceReadinessCheck? _lastCheck;
    private bool _checkingReadiness;
    private CancellationTokenSource? _checkCts;

    /// <summary>
    /// The coordinated readiness check of the saved version (explicit action only — never on load, render, tab switch or polling). The backend reuses
    /// a recent container-network check or makes one bounded check from the k6 container when eligible; a second click while one runs is ignored.
    /// </summary>
    private async Task CoordinatedCheckAsync()
    {
        if (_checkingReadiness || _profile is null || _isNew) return;
        _checkingReadiness = true;
        _checkCts = new CancellationTokenSource();
        StateHasChanged();
        try
        {
            var result = await Api.ReadinessCheckAsync(_profile.Id, _draft.Id, _identity, _checkCts.Token);
            if (result.Value is { } check)
            {
                _readiness = check.Readiness;
                _lastCheck = check;
                if (check.Connectivity == PerformanceConnectivityOutcomes.Checked && check.Reachability is { } reach) _reachability = reach;
            }
            else if (_checkCts.IsCancellationRequested) _message = "Readiness check cancelled. The last saved evaluation is shown.";
            else { _message = result.Error; _readiness = await Api.ReadinessAsync(_profile.Id, _draft.Id, _identity); _lastCheck = null; }
        }
        catch (OperationCanceledException) { _message = "Readiness check cancelled. The last saved evaluation is shown."; }
        finally { _checkingReadiness = false; _checkCts?.Dispose(); _checkCts = null; }
    }

    private void CancelCheck() => _checkCts?.Cancel();

    /// <summary>Run test: autosave a new draft, evaluate readiness, stop at a blocker, otherwise open the explicit run confirmation. Never starts load.</summary>
    private async Task RunTestAsync()
    {
        if (ActiveRun is not null) { _tab = Tab.Run; return; }
        if (_dirty && !_isNew) { _message = "Save your changes as a new version before running; earlier runs keep their version."; _tab = Tab.Readiness; return; }
        await CheckReadinessAsync();
        if (_isNew) return; // the draft could not be saved (message shown)
        if (_readiness?.Ready == true) _tab = Tab.Run;
        else { _tab = Tab.Readiness; await FocusFirstBlockerAsync(); }
    }

    /// <summary>Moves focus once a pending target (new step heading, requirement row after mapping) is rendered.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusTarget is not { } target) return;
        _focusTarget = null;
        try { await JS.InvokeVoidAsync("birknextFocusElement", target); } catch (JSException) { } catch (InvalidOperationException) { }
    }

    private async Task FocusFirstBlockerAsync()
    {
        if (_readiness?.Items.FirstOrDefault(i => i.Blocking) is not { } first) return;
        StateHasChanged();
        try { await JS.InvokeVoidAsync("birknextFocusElement", $"pt-blocker-{first.Key}"); } catch (JSException) { } catch (InvalidOperationException) { }
    }

    private void ConfirmPipelines(IReadOnlyList<string> pipelineIds)
    {
        Changed(_draft with { DeliveryPipelineIds = [.. pipelineIds] });
        _message = _isNew ? "Pipeline mapping set on the draft; it is saved with the definition." : "Pipeline mapping confirmed in your changes — save them as a new version to keep it.";
    }

    /// <summary>An action as a control: a link to the owner page, or a button for an in-page action. <paramref name="primary"/> only for THE next action.</summary>
    private RenderFragment ActionControl(string action, PerformanceReadinessItem? item, bool primary, string testId) => __builder =>
    {
        var label = D.ActionLabel(action, item);
        var css = primary ? "btn-primary" : "btn-secondary";
        if (D.ActionHref(action, ContextDefinitionId) is { } href) { <a class="@css ptc-action" href="@href" data-testid="@testId" data-action="@action">@label</a> }
        else
        {
            var busy = action == PerformanceReadinessActions.CheckNetwork && (_checkingNetwork || _checkingReadiness) || action is "check-readiness" && (_saving || _checkingReadiness) || action == "save-version" && _saving;
            <button type="button" class="@css ptc-action" @onclick="() => PerformAction(action)" disabled="@(busy || action == "check-readiness" && !DraftValid)" data-testid="@testId" data-action="@action"
                aria-describedby="@(action == PerformanceReadinessActions.CheckNetwork ? $"{testId}-disclosure" : null)">@(busy ? "Working…" : label)</button>
            @if (action == PerformanceReadinessActions.CheckNetwork)
            {
                <span class="ptc-check-detail ptc-disclosure" id="@($"{testId}-disclosure")" data-testid="@($"{testId}-disclosure")">This sends one request from the k6 container to the @(_draft.EnvironmentName) target. It is not a load test.</span>
            }
        }
    };

    private PerformanceReachability? _reachability;
    private bool _checkingNetwork;

    /// <summary>Exactly one request from the load-generator container (not a load test, not a run). Readiness refreshes on its own afterwards:
    /// an unchanged definition is never re-saved.</summary>
    private async Task CheckNetworkAsync()
    {
        if (_isNew || _dirty) { await CheckReadinessAsync(); if (_isNew || _dirty || _lastCheck?.Connectivity == PerformanceConnectivityOutcomes.Checked) return; }
        _checkingNetwork = true;
        try
        {
            var result = await Api.NetworkCheckAsync(_profile!.Id, _draft.Id);
            if (result.Value is null) { _message = result.Error; return; }
            _reachability = result.Value;
            _readiness = await Api.ReadinessAsync(_profile.Id, _draft.Id, _identity);
            // Project activity: one event for a failed manual check or an applied TLS repair (never for every check).
            if (ServiceProvider.GetService(typeof(BirkNext.Web.Services.ProjectActivity.ProjectActivityRecorder)) is BirkNext.Web.Services.ProjectActivity.ProjectActivityRecorder activity
                && BirkNext.Web.Services.ProjectActivity.ReviewActivity.NetworkValidation(result.Value, _profile.Id, _profile.Name) is { } validation)
                await activity.RecordAsync(validation);
        }
        finally { _checkingNetwork = false; }
    }

    private string ProviderText => _overview?.Provider is { } p
        ? p.Availability == ProviderAvailability.Available ? $"{p.DisplayName} {p.Version}" : $"{p.DisplayName}: {P.Label(p.Availability)} (tool limitation)"
        : "Unknown";

    private string ResourceOverview => _draft.ResourceObservation is { Enabled: true } ro
        ? $"Enabled · every {ro.SampleIntervalSeconds} s · {ro.Policies.Count} stability / {ro.DriftPolicies.Count} drift polic{(ro.Policies.Count + ro.DriftPolicies.Count == 1 ? "y" : "ies")}"
        : "Disabled";

    private IReadOnlyList<PtCheck> PreSaveChecks =>
    [
        new("target", "Target configured", string.IsNullOrWhiteSpace(_draft.TargetOrigin) ? new("Not configured", "!", PtTone.Attention) : new("Configured", "✓", PtTone.Ready), string.IsNullOrWhiteSpace(_draft.TargetOrigin) ? "Configure the Target Environment." : _draft.TargetOrigin),
        new("engine", "Execution engine available", _overview?.Provider?.Availability == ProviderAvailability.Available ? new("Available", "✓", PtTone.Ready) : new("Not available", "!", PtTone.Attention), ProviderText),
        new("scenario", "Scenario configured", _draft.Scenario.Steps.Count > 0 ? new("Configured", "✓", PtTone.Ready) : new("No steps", "!", PtTone.Attention), $"{_draft.Scenario.Steps.Count} step(s)"),
        new("saved", "Definition version", _isNew ? new("Draft", "✎", PtTone.Attention) : new("Unsaved changes", "✎", PtTone.Attention),
            _isNew ? "Saved automatically as v1 when you check readiness." : "Save the changes as a new version to re-evaluate."),
        new("backend", "Backend checks", new("Pending", "○", PtTone.Neutral), "Runtime, image, container network, corporate CA trust, workload limits and environment safety are evaluated on the saved version."),
    ];

    private string ReadinessText => _isNew ? "Not saved yet" : _dirty ? "Unsaved changes" : _readiness is null ? "—" : _readiness.Ready ? "Ready" : $"Blocked — {_readiness.Blockers.Count} item(s)";

    protected override async Task OnInitializedAsync()
    {
        // No active Target Environment is the "no performance target" state; it is never sent as an empty environment id.
        var activeContext = await ContextFactory.GetActiveContextAsync();
        _profile = activeContext.ActiveProfileOrNull;
        // The proxy identity (profile id + context fingerprint, never a token) lets the backend use the API credential the Local HTTPS proxy captured.
        _identity = BirkNext.Web.Models.ReviewAuthenticationIdentity.ForContext(activeContext);
        // "Back to Performance Test Review" from local execution setup returns to the same saved definition and tab (ids only).
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        var returnDefinition = query.TryGetValue("definition", out var definition) ? definition.ToString() : null;
        if (_profile is not null) { await ReloadAsync(returnDefinition); await LoadScenarioEvidenceAsync(); }
        if (query.TryGetValue("tab", out var tab) && Enum.TryParse<Tab>(tab.ToString(), ignoreCase: true, out var requested)) _tab = requested;
        _loaded = true;
    }

    /// <summary>The saved definition the page is on (null for an unsaved draft) — context for owner-page links.</summary>
    private string? ContextDefinitionId => _isNew ? null : _draft.Id;

    private async Task ReloadAsync(string? select)
    {
        _overview = await Api.OverviewAsync(_profile!.Id);
        if (_overview is null) return;
        var chosen = _overview.Definitions.FirstOrDefault(d => d.Id == select) ?? _overview.Definitions.FirstOrDefault();
        _targetDrift = null;
        if (chosen is null) { _draft = P.NewDefinition(_profile); _isNew = true; _dirty = false; }
        else
        {
            // The Target Environment owns the target: a definition saved against another origin is brought to the live one and must be saved
            // again before it can run (never a load test against a stale origin).
            (_draft, _targetDrift) = P.WithLiveTarget(chosen, _profile);
            _isNew = false;
            _dirty = _targetDrift is not null;
        }
        await RefreshDefinitionStateAsync();
    }

    private async Task RefreshDefinitionStateAsync()
    {
        _resourceTargets = _profile is null ? [] : await Api.ResourceTargetsAsync(_profile.Id, _draft.EnvironmentType);
        _lastCheck = null;
        if (_isNew) { _readiness = null; _runs = []; _baselines = []; _selectedRun = null; return; }
        _readiness = await Api.ReadinessAsync(_profile!.Id, _draft.Id, _identity);
        _runs = await Api.RunsAsync(_profile.Id, _draft.Id);
        _baselines = await Api.BaselinesAsync(_profile.Id, _draft.Id);
        _selectedRun = _runs.FirstOrDefault(r => r.RunId == _selectedRun?.RunId) ?? _runs.FirstOrDefault();
        if (ActiveRun is not null) StartPolling();
    }

    private async Task SelectDefinition(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        if (string.IsNullOrEmpty(id)) return;
        _message = null;
        await ReloadAsync(id);
    }

    private void NewDefinition()
    {
        _draft = P.NewDefinition(_profile!);
        _isNew = true; _dirty = true; _readiness = null; _runs = []; _baselines = []; _selectedRun = null; _tab = Tab.Scenario;
    }

    private void Changed(PerformanceTestDefinition next) { _draft = next; _dirty = true; _saveFailed = false; _saveError = null; }

    /// <summary>Operation identities the persisted Endpoint Discovery history observed with authentication (the backend reads the same set).</summary>
    private IReadOnlySet<string>? ObservedAuthentication => _history?.Operations.Where(o => o.AuthObserved).Select(o => o.Identity).ToHashSet(StringComparer.Ordinal);

    /// <summary>The explicit decision to run authentication-requiring operations without authentication: saved as a new definition version, so it is
    /// auditable with the run that uses it; readiness is re-evaluated by the backend.</summary>
    private async Task AcknowledgeUnauthenticatedAsync(UnauthenticatedExecutionOverride acknowledgement)
    {
        _draft = _draft with { UnauthenticatedOverride = acknowledgement };
        _dirty = true;
        if (await SaveCoreAsync() is { } saved) _message = $"Saved as version {saved.Version}: intentionally unauthenticated for {acknowledgement.Operations.Count} operation(s).";
    }

    /// <summary>An explicit status refresh (the same backend read as polling, which also reconciles a run orphaned by a restart).</summary>
    private Task RefreshActiveRunAsync() => PollAsync();

    private async Task SaveAsync()
    {
        if (await SaveCoreAsync() is { } saved) _message = $"Saved as version {saved.Version}. Earlier runs keep the version they ran with.";
    }

    /// <summary>Saves the editor's definition (a new version only when the content changed) and reloads its readiness.</summary>
    private async Task<PerformanceTestDefinition?> SaveCoreAsync()
    {
        if (_saving) return null;
        _saving = true; _saveError = null;
        try
        {
            var result = await Api.SaveDefinitionAsync(_profile!.Id, _draft, _isNew);
            // A failed save keeps the draft and its unsaved state; it is never silently reverted.
            if (result.Value is null) { _saveFailed = true; _saveError = result.Error ?? "The backend did not accept the definition."; return null; }
            _saveFailed = false;
            await ReloadAsync(result.Value.Id);
            return result.Value;
        }
        finally { _saving = false; }
    }

    // ── Run / poll / cancel ───────────────────────────────────────────────────────────────────────────────────────────

    /// <summary>A start request in flight: a second click does nothing (the backend also allows one active run per environment).</summary>
    private bool _starting;

    private async Task StartAsync()
    {
        if (_starting) return;
        _starting = true;
        _startBlockers = [];
        PerformanceApiResult<PerformanceTestRun> result;
        try { result = await Api.StartAsync(_profile!.Id, new PerformanceRunRequest { DefinitionId = _draft.Id, VersionLabel = _versionLabel, Identity = _identity }); }
        finally { _starting = false; }
        if (result.Value is null) { _message = result.Error; _startBlockers = result.Blockers; return; }
        _message = "Performance test started.";
        _runs.Insert(0, result.Value);
        _selectedRun = result.Value;
        StartPolling();
    }

    private void StartPolling()
    {
        _poll ??= new System.Threading.Timer(async _ => await InvokeAsync(PollAsync), null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
    }

    private async Task PollAsync()
    {
        if (_profile is null || ActiveRun is not { } active) { StopPolling(); return; }
        if (await Api.RunAsync(_profile.Id, active.RunId) is { } latest)
        {
            var i = _runs.FindIndex(r => r.RunId == latest.RunId);
            if (i >= 0) _runs[i] = latest;
            if (_selectedRun?.RunId == latest.RunId) _selectedRun = latest;
            if (!latest.IsActive)
            {
                StopPolling();
                _baselines = await Api.BaselinesAsync(_profile.Id, _draft.Id);
                _message = $"Run {P.Short(latest.RunId)} finished: {P.Label(latest.State)}.";
                // Project activity: a finished run (meaningful failures included, e.g. TLS trust); keyed by run id.
                if (ServiceProvider.GetService(typeof(BirkNext.Web.Services.ProjectActivity.ProjectActivityRecorder)) is BirkNext.Web.Services.ProjectActivity.ProjectActivityRecorder activity
                    && BirkNext.Web.Services.ProjectActivity.ReviewActivity.PerformanceRun(latest, _profile.Id, _profile.Name) is { } runActivity)
                    await activity.RecordAsync(runActivity);
            }
        }
        StateHasChanged();
    }

    private void StopPolling() { _poll?.Dispose(); _poll = null; }

    private async Task CancelAsync()
    {
        if (ActiveRun is not { } active) return;
        if (await Api.CancelAsync(_profile!.Id, active.RunId) is { } cancelling)
        {
            var i = _runs.FindIndex(r => r.RunId == cancelling.RunId);
            if (i >= 0) _runs[i] = cancelling;
            _message = "Cancellation requested; the backend terminates the provider.";
        }
    }

    public void Dispose() { StopPolling(); _checkCts?.Cancel(); }

    // ── Baselines / compare ───────────────────────────────────────────────────────────────────────────────────────────

    private async Task PromoteAsync()
    {
        if (_promoteRunId is not { } runId) return;
        var result = await Api.PromoteAsync(_profile!.Id, new PerformanceBaselinePromotion { RunId = runId, Reason = _promoteReason, AcceptThresholdFailures = _promoteAcceptFailures });
        if (result.Error is not null) { _promoteError = result.Error; return; }
        _message = $"Run {P.Short(runId)} is now baseline v{result.Baseline!.Version}{(result.Superseded is { } s ? $"; v{s.Version} is superseded and kept in history" : "")}.";
        _promoteRunId = null; _promoteReason = null; _promoteAcceptFailures = false; _promoteError = null;
        _baselines = await Api.BaselinesAsync(_profile.Id, _draft.Id);
    }

    /// <summary>Proposes the run as the next baseline: recorded with its eligibility review, never used for comparison until approved.</summary>
    private async Task ProposeAsync()
    {
        if (_promoteRunId is not { } runId) return;
        var result = await Api.ProposeBaselineAsync(_profile!.Id, new PerformanceBaselineProposal { RunId = runId, Reason = _promoteReason, AcceptWarnings = _promoteAcceptFailures });
        if (result.Error is not null) { _promoteError = result.Error; return; }
        _message = $"Run {P.Short(runId)} is proposed as baseline v{result.Baseline!.Version}; it is used for comparison once it is approved.";
        _promoteRunId = null; _promoteReason = null; _promoteAcceptFailures = false; _promoteError = null;
        _baselines = await Api.BaselinesAsync(_profile.Id, _draft.Id);
    }

    private async Task ApproveBaselineAsync(PerformanceBaseline b)
    {
        var result = await Api.ApproveBaselineAsync(_profile!.Id, b.BaselineId, null);
        _decisionError = result.Error;
        if (result.Baseline is { } approved)
            _message = $"Baseline v{approved.Version} is approved and active{(result.Superseded is { } s ? $"; v{s.Version} is superseded and kept" : "")}.";
        _baselines = await Api.BaselinesAsync(_profile.Id, _draft.Id);
    }

    private async Task RejectBaselineAsync(PerformanceBaseline b)
    {
        if (string.IsNullOrWhiteSpace(_rejectReason)) { _decisionError = "Give a reason for the rejection."; return; }
        var result = await Api.RejectBaselineAsync(_profile!.Id, b.BaselineId, _rejectReason);
        _decisionError = result.Error;
        if (result.Error is null) { _rejectingBaselineId = null; _rejectReason = null; _message = $"Proposal v{b.Version} is rejected (kept with the reason)."; }
        _baselines = await Api.BaselinesAsync(_profile.Id, _draft.Id);
    }

    /// <summary>First click asks, the second deletes. The run of a proposed or approved baseline is protected by the backend.</summary>
    private async Task DeleteRunAsync(PerformanceTestRun run)
    {
        if (_deleteRunId != run.RunId) { _deleteRunId = run.RunId; _deleteError = null; return; }
        _deleteError = await Api.DeleteRunAsync(_profile!.Id, run.RunId);
        if (_deleteError is null)
        {
            _message = $"Run {P.Short(run.RunId)} is deleted.";
            _deleteRunId = null;
            _runs = await Api.RunsAsync(_profile.Id, _draft.Id);
            if (_selectedRun?.RunId == run.RunId) _selectedRun = null;
        }
    }

    private static string ApprovalText(PerformanceBaseline b) => b.ApprovalOrLegacy() switch
    {
        BaselineApprovalState.Proposed => $"Proposed{(b.ProposedBy is { } by ? " by " + by : "")}",
        BaselineApprovalState.Rejected => $"Rejected{(b.RejectedBy is { } by ? " by " + by : "")}: {b.DecisionNote}",
        _ => b.Approval is null ? "Approved (before the approval workflow)" : $"Approved{(b.ApprovedBy is { } by ? " by " + by : "")}{(b.ApprovedAt is { } at ? " · " + P.Utc(at) : "")}",
    };

    private async Task CompareAsync()
    {
        _comparison = null;
        if (!Guid.TryParse(_compareCurrent ?? _selectedRun?.RunId.ToString(), out var current)) return;
        if (_compareReference == "active")
        {
            var run = _runs.FirstOrDefault(r => r.RunId == current);
            var active = _baselines.FirstOrDefault(b => b.Status == PerformanceBaselineStatus.Active && b.ComparisonFingerprint == run?.ComparisonFingerprint);
            if (active is null) { _message = "No active baseline for this run's scope."; return; }
            _comparison = await Api.CompareAsync(_profile!.Id, current, null, active.BaselineId);
        }
        else if (_compareReference.StartsWith("b:", StringComparison.Ordinal)) _comparison = await Api.CompareAsync(_profile!.Id, current, null, _compareReference[2..]);
        else if (Guid.TryParse(_compareReference, out var reference)) _comparison = await Api.CompareAsync(_profile!.Id, current, reference, null);
    }

    private async Task ExportAsync(PerformanceTestRun run) =>
        await JS.InvokeVoidAsync("downloadHtmlFile", $"performance-test-{P.Short(run.RunId)}.html", P.Export(run));

