@page "/user-guide"
@using BirkNext.Web.Services
@using BirkNext.Web.Components.Guide
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>User Guide — BirkNext</PageTitle>
<div class="ug-page">
    <PageHeader Title="User Guide" Description="Learn how to configure BirkNext, bind project evidence, prepare test data, review integrations and run supported QA workflows." />

    <div class="ug-shell">
        <aside class="ug-sidebar" aria-label="User Guide navigation">
            <button type="button" class="ug-nav-toggle btn-secondary" aria-expanded="@(_navOpen ? "true" : "false")" aria-controls="ug-nav-panel"
                    data-testid="ug-nav-toggle" @onclick="() => _navOpen = !_navOpen">@(_navOpen ? "Hide guide contents" : "Guide contents")</button>
            <div id="ug-nav-panel" class="ug-nav-panel @(_navOpen ? "is-open" : "")">
                <div class="ug-search" role="search">
                    <label for="ug-search-input" class="ug-search-label">Search guide</label>
                    <input id="ug-search-input" type="search" class="ug-search-input" placeholder="e.g. baseline, reporter, drift" autocomplete="off"
                           aria-describedby="ug-search-status" data-testid="ug-search" @bind="_query" @bind:event="oninput" />
                    <p id="ug-search-status" class="ug-search-status" role="status" aria-live="polite" data-testid="ug-search-status">@SearchStatus</p>
                    @if (_results.Count > 0)
                    {
                        <ul class="ug-search-results" data-testid="ug-search-results">
                            @foreach (var topic in _results)
                            {
                                <li><a href="@topic.Href" data-topic="@topic.Id" data-testid="ug-search-result">@topic.Title<span class="ug-search-group">@topic.Group</span></a></li>
                            }
                        </ul>
                    }
                </div>
                <nav class="ug-nav" aria-label="Guide sections" data-testid="ug-nav">
                    @foreach (var group in UserGuideContent.Groups)
                    {
                        <details class="ug-nav-group" open data-testid="ug-nav-group">
                            <summary class="ug-nav-group-title">@group</summary>
                            <ul>
                                @foreach (var topic in UserGuideContent.Topics.Where(t => t.Group == group))
                                {
                                    <li><a class="ug-nav-link" href="@topic.Href" data-topic="@topic.Id" data-testid="ug-nav-link">@topic.Title</a></li>
                                }
                            </ul>
                        </details>
                    }
                </nav>
            </div>
        </aside>

        <div class="ug-content">
            <section class="ug-home" aria-labelledby="ug-tasks-title">
                <h2 id="ug-tasks-title" class="ug-home-title">Common tasks</h2>
                <div class="ug-task-grid" data-testid="ug-task-cards">
                    @foreach (var card in UserGuideContent.TaskCards)
                    {
                        <article class="ug-task" data-testid="ug-task-card">
                            <h3 class="ug-task-title">@card.Title</h3>
                            <p class="ug-task-purpose">@card.Purpose</p>
                            <p class="ug-task-when"><span class="ug-task-label">When</span> @card.When</p>
                            <div class="ug-task-actions">
                                <a class="ug-open-link" href="@card.Href">@card.OpenLabel <span aria-hidden="true">→</span></a>
                                <a class="ug-guide-link" href="@UserGuideContent.Href(card.GuideId)">Read the guide<span class="visually-hidden">: @card.Title</span></a>
                            </div>
                        </article>
                    }
                </div>
            </section>

            <div class="ug-group" data-group="getting-started"><p class="ug-group-label">@UserGuideContent.GettingStarted</p><GuideGettingStarted /></div>
            <div class="ug-group" data-group="project"><p class="ug-group-label">@UserGuideContent.ProjectEvidence</p><GuideProject /></div>
            <div class="ug-group" data-group="setup"><p class="ug-group-label">@UserGuideContent.TestSetup</p><GuideSetup /></div>
            <div class="ug-group" data-group="testing"><p class="ug-group-label">@UserGuideContent.Testing</p><GuideTesting /></div>
            <div class="ug-group" data-group="governance"><p class="ug-group-label">@UserGuideContent.Governance</p><GuideGovernance /></div>
            <div class="ug-group" data-group="reference"><p class="ug-group-label">@UserGuideContent.Reference</p><GuideReference /></div>
        </div>
    </div>
</div>

@code {
    private bool _navOpen;

    // Arriving from another page with a fragment (for example a feature's Learn more link): land on that section and mark it current.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || new Uri(Navigation.Uri).Fragment.TrimStart('#') is not { Length: > 0 } anchor) return;
        try { await JS.InvokeVoidAsync("userGuide.scrollToSection", anchor); }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }
    private string _queryValue = "";
    private IReadOnlyList<GuideTopic> _results = [];

    private string _query
    {
        get => _queryValue;
        set { _queryValue = value; _results = UserGuideContent.Search(value); }
    }

    private string SearchStatus => _queryValue.Trim().Length == 0 ? ""
        : _results.Count == 0 ? "No guide sections match."
        : $"{_results.Count} guide section{(_results.Count == 1 ? "" : "s")} match.";
}
