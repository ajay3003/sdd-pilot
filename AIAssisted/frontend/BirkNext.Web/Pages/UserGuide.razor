@page "/user-guide"

<PageTitle>User Guide — QA Review Studio</PageTitle>

<div class="ug-page">

    <!-- ── Hero ────────────────────────────────────────────────────────── -->
    <div class="ug-hero">
        <div class="ug-hero-eyebrow">📖 User Guide</div>
        <h1 class="ug-hero-title">QA Review Studio</h1>
        <p class="ug-hero-sub">Everything you need to understand, use, and get value from every feature in the platform — from onboarding to advanced analysis workflows.</p>
        <div class="ug-hero-audience">
            For: Testers · Test Leads · Scrum Masters · Product Owners · Developers · Architects · New Team Members
        </div>
    </div>

    <!-- ── Table of Contents ────────────────────────────────────────────── -->
    <nav class="ug-toc" aria-label="Page contents">
        <a href="#overview" class="ug-toc-link">Overview</a>
        <span class="ug-toc-sep">·</span>
        <a href="#features" class="ug-toc-link">Feature Matrix</a>
        <span class="ug-toc-sep">·</span>
        <a href="#workflow" class="ug-toc-link">Core Workflow</a>
        <span class="ug-toc-sep">·</span>
        <a href="#workflows" class="ug-toc-link">Typical Workflows</a>
        <span class="ug-toc-sep">·</span>
        <a href="#feature-details" class="ug-toc-link">Feature Details</a>
        <span class="ug-toc-sep">·</span>
        <a href="#ai-dev" class="ug-toc-link">AI-Assisted Dev</a>
        <span class="ug-toc-sep">·</span>
        <a href="#faq" class="ug-toc-link">FAQ</a>
        <span class="ug-toc-sep">·</span>
        <a href="#ecosystem" class="ug-toc-link">Ecosystem</a>
        <span class="ug-toc-sep">·</span>
        <a href="#about" class="ug-toc-link">About</a>
    </nav>

    <!-- ── Section 1: Overview ─────────────────────────────────────────── -->
    <section id="overview" class="ug-section">
        <h2 class="ug-section-title">Overview</h2>
        <p class="ug-section-lead">QA Review Studio is a quality engineering platform focused on <strong>Specification Driven Development (SDD)</strong> — connecting requirements, tasks, implementation, and testing in a single traceable workflow that spans the entire delivery lifecycle.</p>

        <div class="ug-cap-grid">
            @foreach (var cap in CoreCapabilities)
            {
                <div class="ug-cap-card">
                    <div class="ug-cap-icon" aria-hidden="true">@cap.Icon</div>
                    <div class="ug-cap-name">@cap.Name</div>
                    <div class="ug-cap-desc">@cap.Desc</div>
                </div>
            }
        </div>

        <h3 class="ug-subsection-title">Who uses it?</h3>
        <div class="ug-audience-grid">
            @foreach (var (Role, Desc) in Audiences)
            {
                <div class="ug-audience-card">
                    <div class="ug-audience-role">@Role</div>
                    <div class="ug-audience-desc">@Desc</div>
                </div>
            }
        </div>
    </section>

    <!-- ── Section 2: Feature Matrix ───────────────────────────────────── -->
    <section id="features" class="ug-section">
        <h2 class="ug-section-title">Full Feature Matrix</h2>
        <p class="ug-section-lead">Every feature at a glance — what it does, what it takes, what it produces, and when to reach for it.</p>

        <div class="ug-table-scroll">
            <table class="ug-table">
                <thead>
                    <tr>
                        <th>Area</th>
                        <th>Feature</th>
                        <th>Purpose</th>
                        <th>Input</th>
                        <th>Output</th>
                        <th>When To Use</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in AllFeatures)
                    {
                        <tr>
                            <td><span class="ug-area-badge ug-area-@f.AreaKey">@f.Area</span></td>
                            <td class="ug-td-feature"><a href="@f.Route" class="ug-inline-link">@f.Name</a></td>
                            <td>@f.Purpose</td>
                            <td class="ug-td-mono">@f.Input</td>
                            <td>@f.Output</td>
                            <td>@f.WhenToUse</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <!-- ── Section 3: Core Workflow ────────────────────────────────────── -->
    <section id="workflow" class="ug-section">
        <h2 class="ug-section-title">Core Workflow</h2>
        <p class="ug-section-lead">The primary path from specification to release — and where each Analysis feature fits in.</p>

        <div class="ug-core-flow-layout">
            <div class="ug-core-flow">
                <div class="ug-flow-node ug-flow-primary">Specification Review</div>
                <div class="ug-flow-conn">↓</div>
                <div class="ug-flow-node ug-flow-primary">QA Artifact Library</div>
                <div class="ug-flow-conn">↓</div>
                <div class="ug-flow-node ug-flow-primary">Traceability &amp; Coverage</div>
                <div class="ug-flow-conn">↓</div>
                <div class="ug-flow-node ug-flow-primary">Implementation Review</div>
                <div class="ug-flow-conn">↓</div>
                <div class="ug-flow-node ug-flow-primary">Impact Analysis</div>
                <div class="ug-flow-conn">↓</div>
                <div class="ug-flow-node ug-flow-primary">Spec Drift</div>
                <div class="ug-flow-conn">↓</div>
                <div class="ug-flow-node ug-flow-terminal">QA Readiness</div>
            </div>

            <div class="ug-flow-branches">
                <h4 class="ug-branches-title">Optional branches</h4>
                <div class="ug-branch-item">
                    <span class="ug-branch-badge">Specification Deltas</span>
                    <span class="ug-branch-when">When specification changes between versions</span>
                </div>
                <div class="ug-branch-item">
                    <span class="ug-branch-badge">Task Deltas</span>
                    <span class="ug-branch-when">When the implementation plan changes</span>
                </div>
                <div class="ug-branch-item">
                    <span class="ug-branch-badge">Code Traceability</span>
                    <span class="ug-branch-when">When implementation evidence exists</span>
                </div>
                <div class="ug-branch-item">
                    <span class="ug-branch-badge">AI Change Review</span>
                    <span class="ug-branch-when">When AI-generated changes need review</span>
                </div>
                <div class="ug-branch-item">
                    <span class="ug-branch-badge">Spec Comparison</span>
                    <span class="ug-branch-when">When comparing two specification documents</span>
                </div>
            </div>
        </div>
    </section>

    <!-- ── Section 4: Typical Workflows ────────────────────────────────── -->
    <section id="workflows" class="ug-section">
        <h2 class="ug-section-title">Typical Workflows</h2>
        <p class="ug-section-lead">Common delivery scenarios and the features that support each one.</p>

        <div class="ug-workflow-grid">
            @foreach (var wf in TypicalWorkflows)
            {
                <div class="ug-workflow-card">
                    <div class="ug-workflow-title">@wf.Title</div>
                    <div class="ug-workflow-flow">
                        @for (var i = 0; i < wf.Steps.Length; i++)
                        {
                            <span class="ug-wf-step">@wf.Steps[i]</span>
                            @if (i < wf.Steps.Length - 1)
                            {
                                <span class="ug-wf-arrow">→</span>
                            }
                        }
                    </div>
                    <div class="ug-workflow-desc">@wf.Desc</div>
                </div>
            }
        </div>
    </section>

    <!-- ── Section 5: Feature Details ──────────────────────────────────── -->
    <section id="feature-details" class="ug-section">
        <h2 class="ug-section-title">Feature Details</h2>
        <p class="ug-section-lead">Expand any feature for full details — purpose, inputs, outputs, recommended users, and when to use or avoid it.</p>

        <div class="ug-feature-grid">
            @foreach (var f in AllFeatures)
            {
                var isOpen = _openFeature.Contains(f.Id);
                <div class="ug-feature-card ug-fcard-@f.AreaKey @(isOpen ? "is-open" : "")">
                    <div class="ug-feature-header" @onclick="() => ToggleFeature(f.Id)">
                        <div>
                            <span class="ug-area-badge ug-area-@f.AreaKey">@f.Area</span>
                            <div class="ug-feature-name">@f.Name</div>
                            <div class="ug-feature-purpose">@f.Purpose</div>
                        </div>
                        <button class="ug-expand-btn" aria-expanded="@isOpen.ToString().ToLower()">@(isOpen ? "▲" : "▼")</button>
                    </div>
                    @if (isOpen)
                    {
                        <div class="ug-feature-body">
                            <div class="ug-fd-row">
                                <div class="ug-fd-item">
                                    <div class="ug-fd-label">Input</div>
                                    <div class="ug-fd-value ug-fd-mono">@f.Input</div>
                                </div>
                                <div class="ug-fd-item">
                                    <div class="ug-fd-label">Output</div>
                                    <div class="ug-fd-value">@f.Output</div>
                                </div>
                            </div>
                            <div class="ug-fd-item">
                                <div class="ug-fd-label">Best Used By</div>
                                <div class="ug-fd-roles">
                                    @foreach (var role in f.BestUsedBy)
                                    {
                                        <span class="ug-role-badge">@role</span>
                                    }
                                </div>
                            </div>
                            <div class="ug-fd-item">
                                <div class="ug-fd-label">Use When</div>
                                <ul class="ug-fd-list">
                                    @foreach (var when in f.UseWhen)
                                    {
                                        <li>@when</li>
                                    }
                                </ul>
                            </div>
                            <div class="ug-fd-item">
                                <div class="ug-fd-label">Avoid When</div>
                                <ul class="ug-fd-list ug-fd-list-avoid">
                                    @foreach (var avoid in f.AvoidWhen)
                                    {
                                        <li>@avoid</li>
                                    }
                                </ul>
                            </div>
                            <a href="@f.Route" class="ug-feature-link-btn">Open @f.Name →</a>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    <!-- ── Section 6: AI-Assisted Development ──────────────────────────── -->
    <section id="ai-dev" class="ug-section">
        <h2 class="ug-section-title">AI-Assisted Development</h2>
        <p class="ug-section-lead">QA Review Studio is built for teams using AI to accelerate implementation. The platform helps you maintain quality, traceability, and governance even when velocity is high.</p>

        <div class="ug-ai-flow-row">
            <div class="ug-ai-flow">
                <div class="ug-ai-node">
                    <div class="ug-ai-node-label">Specification</div>
                    <div class="ug-ai-node-desc">Requirements, user stories, acceptance criteria</div>
                </div>
                <div class="ug-ai-arrow">↓</div>
                <div class="ug-ai-node">
                    <div class="ug-ai-node-label">Tasks</div>
                    <div class="ug-ai-node-desc">Implementation plan aligned to spec</div>
                </div>
                <div class="ug-ai-arrow">↓</div>
                <div class="ug-ai-node">
                    <div class="ug-ai-node-label">Code</div>
                    <div class="ug-ai-node-desc">AI or human implementation</div>
                </div>
                <div class="ug-ai-arrow">↓</div>
                <div class="ug-ai-node ug-ai-node-terminal">
                    <div class="ug-ai-node-label">Testing &amp; Release</div>
                    <div class="ug-ai-node-desc">Risk-informed test execution and governance</div>
                </div>
            </div>
            <div class="ug-ai-concepts">
                <div class="ug-ai-concept">
                    <div class="ug-ai-concept-title">Specification-First Development</div>
                    <p>Every task and implementation decision traces back to a requirement. QA Review Studio enforces this by surfacing alignment gaps early.</p>
                </div>
                <div class="ug-ai-concept">
                    <div class="ug-ai-concept-title">Traceability</div>
                    <p>Maintain a complete chain from requirement to test. Use Traceability &amp; Coverage and Code Traceability to build and verify this chain.</p>
                </div>
                <div class="ug-ai-concept">
                    <div class="ug-ai-concept-title">Regression Awareness</div>
                    <p>Implementation Review identifies Regression Candidates — tasks touching high-sensitivity areas like Security, Authorization, Domain Events, and Audit.</p>
                </div>
                <div class="ug-ai-concept">
                    <div class="ug-ai-concept-title">Governance</div>
                    <p>Spec Drift and QA Readiness ensure that as code evolves, the specification remains the source of truth and coverage is maintained.</p>
                </div>
            </div>
        </div>

        <div class="ug-callout ug-callout-tip">
            <strong>Tip:</strong> When using AI to generate tasks from a spec, run Implementation Review immediately after to catch any tasks that introduce undocumented behavior.
        </div>
    </section>

    <!-- ── Section 7: FAQ ───────────────────────────────────────────────── -->
    <section id="faq" class="ug-section">
        <h2 class="ug-section-title">Frequently Asked Questions</h2>

        <div class="ug-faq">
            @foreach (var faq in AllFaq)
            {
                var isOpen = _openFaq.Contains(faq.Id);
                <div class="ug-faq-item @(isOpen ? "is-open" : "")">
                    <button class="ug-faq-q" @onclick="() => ToggleFaq(faq.Id)">
                        <span>@faq.Question</span>
                        <span class="ug-faq-chevron" aria-hidden="true">@(isOpen ? "▲" : "▼")</span>
                    </button>
                    @if (isOpen)
                    {
                        <div class="ug-faq-a">@((MarkupString)faq.Answer)</div>
                    }
                </div>
            }
        </div>
    </section>

    <!-- ── Section 8: Analysis Ecosystem ───────────────────────────────── -->
    <section id="ecosystem" class="ug-section">
        <h2 class="ug-section-title">Analysis Ecosystem</h2>
        <p class="ug-section-lead">How the Analysis features relate to each other and to the broader delivery workflow.</p>

        <div class="ug-ecosystem-layout">
            <div class="ug-ecosystem-main">
                <h4 class="ug-ecosystem-subtitle">Primary Analysis Chain</h4>
                <div class="ug-eco-flow">
                    <div class="ug-eco-node">Specification Review</div>
                    <div class="ug-eco-conn">↓</div>
                    <div class="ug-eco-node">Specification Deltas</div>
                    <div class="ug-eco-conn">↓</div>
                    <div class="ug-eco-node">Task Deltas</div>
                    <div class="ug-eco-conn">↓</div>
                    <div class="ug-eco-node">Implementation Review</div>
                    <div class="ug-eco-conn">↓</div>
                    <div class="ug-eco-node">Impact Analysis</div>
                    <div class="ug-eco-conn">↓</div>
                    <div class="ug-eco-node">Testing</div>
                    <div class="ug-eco-conn">↓</div>
                    <div class="ug-eco-node ug-eco-terminal">QA Readiness</div>
                </div>
            </div>
            <div class="ug-ecosystem-support">
                <h4 class="ug-ecosystem-subtitle">Supporting Capabilities</h4>
                <div class="ug-support-list">
                    <div class="ug-support-item">
                        <div class="ug-support-name">Traceability &amp; Coverage</div>
                        <div class="ug-support-desc">Links requirements to tests and clarifications throughout the lifecycle.</div>
                    </div>
                    <div class="ug-support-item">
                        <div class="ug-support-name">Code Traceability</div>
                        <div class="ug-support-desc">Connects implementation evidence to requirements for deeper coverage analysis.</div>
                    </div>
                    <div class="ug-support-item">
                        <div class="ug-support-name">Spec Drift</div>
                        <div class="ug-support-desc">Detects coverage gaps, orphan tests, and drift indicators as the codebase evolves.</div>
                    </div>
                    <div class="ug-support-item">
                        <div class="ug-support-name">AI Change Review</div>
                        <div class="ug-support-desc">Reviews AI-generated implementation changes for alignment and quality concerns.</div>
                    </div>
                    <div class="ug-support-item">
                        <div class="ug-support-name">Spec Comparison</div>
                        <div class="ug-support-desc">Side-by-side comparison of two specification versions to identify differences.</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ── Section 9: About ─────────────────────────────────────────────── -->
    <section id="about" class="ug-section ug-about-section">
        <h2 class="ug-section-title">About</h2>
        <div class="ug-about-content">
            <div class="ug-about-block">
                <p class="ug-about-lead">QA Review Studio is a quality engineering platform focused on:</p>
                <ul class="ug-about-list">
                    <li>Specification Driven Development (SDD)</li>
                    <li>Traceability from requirement to test</li>
                    <li>Impact Analysis and risk-based testing</li>
                    <li>AI-Assisted Quality Review</li>
                    <li>Governance across the full delivery lifecycle</li>
                </ul>
            </div>
            <div class="ug-about-meta">
                <div class="ug-about-row">
                    <span class="ug-about-label">Initial concept and implementation</span>
                    <span class="ug-about-value">Ajay Anand</span>
                </div>
                <div class="ug-about-row">
                    <span class="ug-about-label">Version</span>
                    <span class="ug-about-value">Preview</span>
                </div>
                <div class="ug-about-row">
                    <span class="ug-about-label">Platform</span>
                    <span class="ug-about-value">Blazor WebAssembly · .NET 8</span>
                </div>
            </div>
        </div>
    </section>

    <!-- ── Footer ───────────────────────────────────────────────────────── -->
    <footer class="ug-footer">
        QA Review Studio · Initial concept and implementation by Ajay Anand
    </footer>

</div>

@code {
    private readonly HashSet<string> _openFaq = [];
    private readonly HashSet<string> _openFeature = [];

    private void ToggleFaq(string id)
    {
        if (!_openFaq.Add(id)) _openFaq.Remove(id);
    }

    private void ToggleFeature(string id)
    {
        if (!_openFeature.Add(id)) _openFeature.Remove(id);
    }

