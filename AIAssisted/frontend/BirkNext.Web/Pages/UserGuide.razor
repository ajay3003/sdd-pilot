    // ── FAQ ───────────────────────────────────────────────────────────────

    private sealed record FaqItem(string Id, string Question, string Answer);

    private static readonly FaqItem[] AllFaq =
    [
        new("what-is-constitution",
            "What is the Constitution and why does it matter?",
            "<p>The <strong>Constitution</strong> is a governance document (constitution.md) that defines the rules, policies, quality standards, and principles that all other SDD artifacts must comply with. Think of it as the project's law book.</p><p>Use <a href='/constitution-explorer'>Constitution Explorer</a> to review the rule catalog. Then use <a href='/constitution-compliance'>Constitution Compliance</a> to verify that the spec, plan, and tasks all comply with its rules. QA Auditor and Delivery Readiness also factor in constitution compliance as part of their assessments.</p>"),

        new("traceability-vs-artifact-traceability",
            "What is the difference between Traceability & Coverage and Artifact Traceability?",
            "<p><strong>Traceability &amp; Coverage</strong> (inside Specification Review) analyzes relationships <em>within the specification</em> — which requirements have tests, which user stories are covered, and what is missing from the spec.</p><p><strong>Artifact Traceability</strong> (<a href='/artifact-traceability'>/artifact-traceability</a>) analyzes relationships <em>across all four artifacts</em> — does the Constitution→Spec→Plan→Tasks chain hold together? Are constitution rules traceable to spec requirements? Are spec requirements traceable to plan items? Are plan items covered by tasks?</p><p>Use both: Traceability &amp; Coverage for intra-spec QA analysis, and Artifact Traceability for cross-artifact governance coverage.</p>"),

        new("qa-auditor-vs-qa-readiness",
            "What is the difference between QA Auditor and QA Readiness?",
            "<p><strong>QA Auditor</strong> is a <em>deterministic</em>, rule-based audit — it applies specific rules to the artifact set and produces findings, risks, and gaps with no AI involvement. The output is objective: rule X fired because condition Y was true.</p><p><strong>QA Readiness</strong> is an <em>AI-assisted</em> readiness assessment that synthesises all analysis outputs (including QA Auditor findings) into a scored cross-category readiness report with gates for Implementation, Testing, and Release. It answers: <em>Is this feature ready?</em></p><p>Use QA Auditor for objective gap detection. Use QA Readiness for executive readiness sign-off.</p>"),

        new("delivery-readiness-vs-qa-readiness",
            "What is the difference between Delivery Readiness and QA Readiness?",
            "<p><strong>Delivery Readiness</strong> (<a href='/delivery-readiness'>/delivery-readiness</a>) provides go/no-go decisions across three delivery-phase gates: Development, Testing, and Release. It answers: <em>Can we proceed to the next phase?</em> The assessment is deterministic and does not use AI.</p><p><strong>QA Readiness</strong> (<a href='/ai-qa-auditor'>/ai-qa-auditor</a>) is an AI-assisted cross-artifact readiness assessment that scores five quality categories (Specification, Plan, Tasks, Traceability, Compliance) and answers: <em>Is this feature ready for release from a QA perspective?</em></p><p>They are complementary: Delivery Readiness gives you a gate verdict, QA Readiness gives you a quality score and executive summary.</p>"),

        new("embedded-views",
            "Where are Traceability & Coverage, Flow View, and Spec Explorer?",
            "<p>These are embedded tabs inside <strong>Specification Review</strong> (<a href='/extract'>/extract</a>) and appear automatically after a successful spec analysis:</p><ul><li><strong>Traceability &amp; Coverage</strong> — active by default. Shows coverage gaps, missing tests, orphan tests.</li><li><strong>Flow View</strong> — QA readiness by user story. Click the Flow View tab.</li><li><strong>Spec Explorer</strong> — specification structure and navigation. Click the Spec Explorer tab.</li></ul><p>Once analysis completes, switching between tabs does not require re-uploading files. See the <a href='#discovery'>Feature Discovery</a> section for full details.</p>"),

        new("drift-vs-review",
            "What is the difference between Spec Drift and Implementation Review?",
            "<p><strong>Implementation Review</strong> analyses your <em>implementation plan</em> (tasks.md) against the <em>specification</em> to surface alignment gaps, risk, and recommended tests. It answers: <em>Is my task list aligned to the spec?</em></p><p><strong>Spec Drift</strong> analyses the broader gap between what the <em>specification says</em> and what the <em>implementation covers</em> over time. It answers: <em>Has my codebase drifted away from the spec?</em></p>"),

        new("spec-deltas-moved",
            "Where did Specification Deltas go?",
            "<p><strong>Specification Deltas</strong> has been merged into <strong>Spec Drift → Changes tab</strong> (<a href='/spec-drift?tab=changes'>/spec-drift</a>). The Changes tab provides the same capability: paste a baseline and updated specification, run change detection, and save the result. <strong>Spec Drift is the only entry point for specification change analysis.</strong></p>"),

        new("impact-vs-risk",
            "What is the difference between Impact Analysis and Risk & Testing?",
            "<p><strong>Impact Analysis</strong> is a standalone feature that estimates the systemic regression impact of a change — which areas, components, and requirements are affected across the whole project.</p><p><strong>Risk &amp; Testing</strong> is the second tab within <strong>Implementation Review</strong> — it classifies each individual task by its change risk and suggests tests for it specifically. The scope is per-task, not project-wide.</p>"),

        new("regression-candidate",
            "What is a Regression Candidate?",
            "<p>A <strong>Regression Candidate</strong> is a task flagged as likely to require regression testing before release. A task becomes a Regression Candidate if it has High Risk classification, or touches a high-sensitivity area (Security, Authorization, Audit, or Domain Events), or has Medium Risk with recommended tests.</p><p>Find them in the Risk &amp; Testing tab of Implementation Review.</p>"),

        new("qa-readiness-chain",
            "How does QA Readiness use previous analysis?",
