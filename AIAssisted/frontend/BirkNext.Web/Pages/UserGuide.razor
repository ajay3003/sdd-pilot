                        <th>Route</th>
                        <th>How To Access</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>Traceability &amp; Coverage</strong></td>
                        <td>Specification Review</td>
                        <td class="ug-td-mono">/extract</td>
                        <td>Analyse a spec → active by default in Analysis Results</td>
                    </tr>
                    <tr>
                        <td><strong>Flow View</strong></td>
                        <td>Specification Review</td>
                        <td class="ug-td-mono">/extract</td>
                        <td>Analyse a spec → click <strong>Flow View</strong> tab in Analysis Results</td>
                    </tr>
                    <tr>
                        <td><strong>Extraction Review</strong></td>
                        <td>Specification Review</td>
                        <td class="ug-td-mono">/extract</td>
                        <td>Analyse a spec → click <strong>Extraction Review</strong> tab in Analysis Results</td>
                    </tr>
                    <tr>
                        <td><strong>Spec Explorer</strong></td>
                        <td>Specification Review</td>
                        <td class="ug-td-mono">/extract</td>
                        <td>Analyse a spec → click <strong>Spec Explorer</strong> tab in Analysis Results</td>
                    </tr>
                    <tr>
                        <td><strong>Architecture View</strong></td>
                        <td>Specification Review</td>
                        <td class="ug-td-mono">/extract</td>
                        <td>Analyse a spec → click <strong>Architecture View</strong> tab in Analysis Results</td>
                    </tr>
                    <tr>
                        <td><strong>Task Explorer</strong></td>
                        <td>Implementation Review</td>
                        <td class="ug-td-mono">/task-alignment</td>
                        <td>Analyse spec.md + tasks.md → click <strong>Task Explorer</strong> tab in results</td>
