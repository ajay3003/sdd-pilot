    private static readonly Pillar[] Pillars = [new("Artifacts and requirements", "Explore project rules, requirements, plans, tasks and data models; follow traceability across the shared graph."),new("Source Analysis", "Analyze an archive once, retain fingerprinted snapshots, and let consumers choose the evidence they use."),new("Quality reviews", "Run applicable deterministic reviews with explicit evidence and limitations."),new("Testing and operations", "Configure target environments, inspect browser/API evidence, run controlled performance and regression tests, and administer the host.")];
    private static readonly WhereRow[] WhereRows = [new("Source evidence and snapshots","Source Analysis","/source-analysis"),new("Technology/analyzer support","Technology Coverage","/technology-coverage"),new("Target, auth and thresholds","System Settings → Target Environments","/admin/system-settings"),new("Performance engine capability","System Settings → Performance Test Engines","/admin/system-settings"),new("Performance test configuration and runs","Performance Test Review","/performance-test-review"),new("Pipeline definitions and refresh state","Pipeline Review","/pipeline-review"),new("Approved security expectations","Target Environments → Security Expectations","/admin/system-settings"),new("Reset local data","System Settings → Maintenance","/admin/system-settings")];
