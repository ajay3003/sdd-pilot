@page "/test-coverage-review"
@using BirkNext.TestCoverage
@using Markdig
@using BirkNext.Web.Components
@using P = BirkNext.Web.Services.TestCoveragePresentation
@using G = BirkNext.Web.Services.TestCoverageGuidance
@implements IDisposable
@inject ITestCoverageApiService Api
@inject IWorkspaceSessionService Workspace
@inject ICurrentWorkspaceProjection CurrentWorkspace
@inject IServiceProvider Services
@inject IJSRuntime JS

<PageTitle>@TestCoverageText.Title</PageTitle>

@* Test Coverage & Overlap Review: one evidence model (tests, journeys, overlaps, gaps) shown as several views. Source comes only from the
   Source Analysis snapshot; nothing is executed; no coverage percentage. Simple language by default, technical details on demand. *@
<div class="tco-page" data-testid="tco-page" aria-busy="@(_loaded ? "false" : "true")">
    <PageHeader Title="@TestCoverageText.Title" Description="@TestCoverageText.Hero">
        @if (_result is not null)
        {
            <div class="tco-exports" role="group" aria-label="Export">
                <button type="button" class="btn-secondary" data-testid="tco-export-covered" @onclick="() => ExportAsync(ExportKind.CoveredHtml)">Export Covered Tests</button>
                <button type="button" class="btn-secondary" data-testid="tco-export-scope" @onclick="() => ExportAsync(ExportKind.ScopeMarkdown)">Export Remaining QA Scope</button>
                <button type="button" class="btn-secondary" data-testid="tco-export-full" @onclick="() => ExportAsync(ExportKind.FullHtml)">Export Full Review</button>
                <button type="button" class="btn-secondary" data-testid="tco-export-markdown" @onclick="() => ExportAsync(ExportKind.FullMarkdown)">Export Markdown</button>
            </div>
        }
    </PageHeader>

    <p class="tco-note" role="note" data-testid="tco-subtext">@TestCoverageText.Subtext</p>

    <section class="tco-card" aria-labelledby="tco-inputs-heading" data-testid="tco-inputs">
        <h2 id="tco-inputs-heading">Review input</h2>
        <dl class="tco-facts">
            <div><dt>Current project</dt><dd data-testid="tco-project">@(_projectName ?? "No project loaded — source tests are still reviewed; requirement views need project documents")</dd></div>
            @if (_specification is { } spec && (spec.Artifacts.Count > 0 || spec.HasModules))
            {
                <div><dt>Specification</dt><dd data-testid="tco-specification">@P.SpecificationScope(spec)</dd></div>
            }
        </dl>
        <SourceEvidencePrerequisite State="_scope" Prefix="tco" SourceAnalysisEnabled="_sources?.SourceAnalysisEnabled != false" ConsumerName="@TestCoverageText.Title"
                                    Title="Source Analysis snapshot" LoadError="_loadError" ReturnTo="test-coverage-review"
                                    OtherSectionsNote="@TestCoverageText.SourceRequired">
            <div class="tco-selectors">
                <label class="tco-field">Source snapshot
                    <select class="form-control" data-testid="tco-current" value="@(_currentId?.ToString() ?? "")" @onchange="CurrentChanged" disabled="@_busy">
                        @foreach (var s in Snapshots) { <option value="@s.SnapshotId">@Option(s)</option> }
                    </select>
                </label>
                <label class="tco-field">Baseline snapshot <span class="tco-muted">(optional — finds changed code without test changes)</span>
                    <select class="form-control" data-testid="tco-baseline" value="@(_baselineId?.ToString() ?? "")" @onchange="BaselineChanged" disabled="@(_busy || BaselineOptions.Count == 0)">
                        <option value="">No baseline</option>
                        @foreach (var s in BaselineOptions) { <option value="@s.SnapshotId">@Option(s)</option> }
                    </select>
                </label>
            </div>
            @if (CurrentSnapshot is { HasConsumerEvidence: false } stale)
            {
                <p class="tco-notice" role="status" data-testid="tco-snapshot-old">@stale.ConsumerEvidenceNote</p>
            }
            <div class="tco-actions">
                <button type="button" class="btn-primary" data-testid="tco-run" disabled="@(BlockedReason is not null)" aria-describedby="tco-run-help" @onclick="RunAsync">
                    @(_busy ? "Reviewing…" : "Run Test Coverage & Overlap Review")
                </button>
                <p id="tco-run-help" class="tco-muted" role="status" data-testid="tco-run-help">@(BlockedReason ?? "Reads the selected snapshot, the project documents and imported test results. Nothing is uploaded or executed.")</p>
            </div>
            @if (_busy)
            {
                <ol class="tco-phases" data-testid="tco-progress" aria-live="polite">
                    @foreach (var phase in PhaseNames) { <li>@phase</li> }
                </ol>
            }
            @if (_runError is not null) { <p class="tco-error" role="alert" data-testid="tco-error">@_runError</p> }
        </SourceEvidencePrerequisite>
    </section>

    @if (_result is { } r)
    {
        var levels = G.Levels(r);
        var boundaries = G.Boundaries(r);
        <section class="tco-card" aria-labelledby="tco-result-heading" data-testid="tco-result" data-run="@r.RunId">
            <h2 id="tco-result-heading" tabindex="-1" @ref="_resultHeading">Review result</h2>
            <dl class="tco-context" data-testid="tco-context">
                <div><dt>Project context</dt><dd>@(r.ProjectName ?? "No project documents")</dd></div>
                <div><dt>Source evidence</dt><dd>@r.Current.Repository · @r.Current.ArchiveName</dd></div>
                <div><dt>Baseline</dt><dd>@(r.Baseline is { } bl ? $"{bl.ArchiveName} (finds code changed without test changes — not runtime evidence)" : "No baseline selected")</dd></div>
            </dl>
            @if (r.Partial) { <p class="tco-notice" role="status"><strong data-testid="tco-partial">partial review</strong> — some evidence could not be read; see Limitations.</p> }
            @if (NewerExists(r)) { <p class="tco-notice" role="status" data-testid="tco-stale">A newer snapshot exists. This review stays bound to the snapshot above; run it again to review the newer one.</p> }

            <ul class="tco-cards" data-testid="tco-overview-cards">
                <li data-testid="tco-card-tests"><span class="tco-card-value">@r.Inventory.TestsDiscovered</span><span>Tests found</span><span class="tco-muted">@r.Inventory.TestsAnalyzed analyzed · @r.Inventory.TestsWithExecutionEvidence with results</span></li>
                <li data-testid="tco-card-journeys"><span class="tco-card-value">@r.Journeys.Count</span><span>Journeys found</span><span class="tco-muted">@r.Journeys.Count(j => j.Weakest is ConnectionEvidence.Suggested or ConnectionEvidence.NeedsConfirmation) need confirmation</span></li>
                <li data-testid="tco-card-duplicates"><span class="tco-card-value">@r.Overlaps.Count(o => o.Kind == OverlapKind.HighConfidenceOverlap)</span><span>Possible duplicates</span><span class="tco-muted">@(r.QaTests.Count == 0 ? "No QA tests to compare" : $"{r.QaTests.Count} QA tests compared")</span></li>
                <li data-testid="tco-card-gaps"><span class="tco-card-value">@r.Gaps.Count</span><span>Remaining gaps</span><span class="tco-muted">@r.Gaps.Count(g => g.Attention == "Needs attention") need attention</span></li>
                <li data-testid="tco-card-review"><span class="tco-card-value">@r.QaScope.NeedsReview.Count</span><span>Needs review</span><span class="tco-muted">Tester or test-lead decision</span></li>
            </ul>
            <div class="tco-execution" role="note" data-testid="tco-execution-note">
                <strong>Execution evidence:</strong> @r.Inventory.TestsWithExecutionEvidence results imported · execution status @(r.Inventory.TestsWithExecutionEvidence == 0 ? "Not verified" : "from imported results only") · code coverage: @(string.IsNullOrWhiteSpace(r.Inventory.CodeCoverage) || r.Inventory.CodeCoverage == TestCoverageText.NoPercentage ? "Not available" : "from an imported report")
                <span class="tco-muted">@r.Inventory.ExecutionEvidence @r.Inventory.CodeCoverage</span>
            </div>

            <section class="tco-attention" aria-labelledby="tco-attention-heading" data-testid="tco-attention">
                <h3 id="tco-attention-heading">What needs attention</h3>
                <ul class="tco-list">
                    @foreach (var item in G.Attention(r)) { <li data-testid="tco-attention-@item.Key" class="@(item.Neutral ? "tco-muted" : "")">@item.Text</li> }
                </ul>
            </section>

            <section class="tco-recommendation" aria-labelledby="tco-reco-heading" data-testid="tco-recommendation">
                <h3 id="tco-reco-heading">QA recommendation</h3>
                <div class="tco-reco-grid">
                    <div><p class="tco-label">Focus on</p>@RecoList(r.QaScope.Keep, "tco-reco-focus", "Nothing specific identified from the current evidence.")</div>
                    <div><p class="tco-label">Probably do not need to repeat</p>@RecoList(r.QaScope.ProbablyUnnecessary, "tco-reco-not-repeat", "None identified from the current evidence.")</div>
                    <div><p class="tco-label">Needs confirmation</p>@RecoList(r.QaScope.NeedsReview, "tco-reco-confirm", "Nothing waiting for a decision.")</div>
                </div>
                <p class="tco-muted">Generated from this review's evidence. A recommendation never removes a test; "probably do not need to repeat" means review whether QA duplication is necessary.</p>
                <button type="button" class="tco-link" data-testid="tco-reco-open-scope" @onclick='() => _view = "scope"'>Open Remaining QA Scope</button>
            </section>

            <div class="tco-tabs" role="tablist" aria-label="Review views" data-testid="tco-tabs">
                @foreach (var (key, label) in Views)
                {
                    <button type="button" role="tab" id="tco-tab-@key" aria-controls="tco-panel" aria-selected="@(_view == key ? "true" : "false")" tabindex="@(_view == key ? 0 : -1)"
                            class="tco-tab @(_view == key ? "is-active" : "")" data-testid="tco-tab-@key" @onclick="() => _view = key" @onkeydown="e => TabKey(e, key)">@label</button>
                }
            </div>
            <div id="tco-panel" role="tabpanel" aria-labelledby="tco-tab-@_view" class="tco-panel" data-testid="tco-panel" data-view="@_view">
                @switch (_view)
                {
                    case "overview":
                        @if (r.Dimensions is { } testDims)
                        {
                            <h3>Test evidence dimensions</h3>
                            <p class="tco-muted">Kept apart on purpose — there is no single coverage percentage. Discovered ≠ linked ≠ configured in CI ≠ executed ≠ passed.</p>
                            <dl class="tco-facts" data-testid="tco-dimensions">
                                <div><dt>Discovered in source</dt><dd>@testDims.Discovered</dd></div>
                                <div><dt>Explicit requirement links</dt><dd>@testDims.RequirementLinkedExplicit</dd></div>
                                <div><dt>Candidate links only</dt><dd>@testDims.RequirementCandidateOnly</dd></div>
                                <div><dt>Project configured in CI</dt><dd>@testDims.ConfiguredInCi</dd></div>
                                <div><dt>Executed (@testDims.Context)</dt><dd data-testid="tco-dim-executed">@testDims.ExecutedInContext</dd></div>
                                <div><dt>Passed (@testDims.Context)</dt><dd>@testDims.PassedInContext</dd></div>
                                <div><dt>Execution-only results</dt><dd data-testid="tco-dim-execution-only">@testDims.ExecutionOnly</dd></div>
                            </dl>
                            @if (r.ExecutionOnly.Count > 0)
                            {
                                <details class="tco-details" data-testid="tco-execution-only"><summary>@r.ExecutionOnly.Count imported result(s) match no discovered test</summary>
                                    <ul class="tco-list">@foreach (var e in r.ExecutionOnly.Take(50)) { <li>@e.TestName — @e.Result <span class="tco-muted">@(e.Environment ?? "context not recorded") · @e.Basis</span></li> }</ul></details>
                            }
                            @if (r.DiscoveryLimitations.Count > 0) { <ul class="tco-list" data-testid="tco-discovery-limitations">@foreach (var l in r.DiscoveryLimitations) { <li>@l</li> }</ul> }
                        }
                        <h3>What the evidence shows</h3>
                        <dl class="tco-facts tco-evidence-facts" data-testid="tco-levels">
                            <div><dt>Unit-level</dt><dd>@levels.Unit</dd></div>
                            <div><dt>API / integration / database-level</dt><dd>@levels.ApiIntegrationDatabase</dd></div>
                            <div><dt>UI / end-to-end</dt><dd>@levels.UiE2E</dd></div>
                            <div><dt>Unknown level</dt><dd>@levels.Unknown</dd></div>
                            <div><dt>Replace a dependency with a mock/fake</dt><dd>@boundaries.Substituted</dd></div>
                            <div><dt>Use a real dependency</dt><dd>@boundaries.Real</dd></div>
                            <div><dt>QA tests compared</dt><dd>@r.QaTests.Count</dd></div>
                        </dl>
                        @if (r.Inventory.Unsupported.Count > 0) { <ul class="tco-list">@foreach (var u in r.Inventory.Unsupported) { <li data-testid="tco-unsupported">@u.Files @u.Language test file(s) (@u.Framework) — not analyzed.</li> }</ul> }
                        var projects = r.Tests.GroupBy(t => t.Project).OrderBy(g => g.Key).ToList();
                        <details class="tco-details tco-section" data-testid="tco-projects-details">
                            <summary>Test projects · @projects.Count projects · @r.Tests.Count tests</summary>
                            <label class="tco-field tco-inline">Owner <select @bind="_ownerFilter" data-testid="tco-owner-filter"><option value="">All</option><option value="Unknown">Not declared</option><option value="DeveloperAutomated">Developer automation</option><option value="QaAutomated">QA automation</option></select></label>
                            <div class="tco-scroll" role="region" aria-label="Test projects" tabindex="0">
                                <table class="tco-table" data-testid="tco-projects">
                                    <thead><tr><th scope="col">Project</th><th scope="col">Tests</th><th scope="col">Who owns these tests?</th></tr></thead>
                                    <tbody>
                                        @foreach (var g in projects.Where(g => _ownerFilter.Length == 0 || g.First().Ownership.ToString() == _ownerFilter))
                                        {
                                            var project = g.Key;
                                            <tr data-testid="tco-project-row">
                                                <th scope="row">@project</th><td>@g.Count()</td>
                                                <td>
                                                    <select aria-label="Ownership of @project" data-testid="tco-ownership" value="@g.First().Ownership" @onchange="e => DecideAsync(CoverageDecisionKind.ProjectOwnership, project, e.Value?.ToString())">
                                                        <option value="Unknown">Not declared</option>
                                                        <option value="DeveloperAutomated">Developer automation</option>
                                                        <option value="QaAutomated">QA automation</option>
                                                    </select>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </details>
                        break;
                    case "journeys":
                        @if (r.Journeys.Count == 0) { <p class="tco-muted" data-testid="tco-no-journeys">No journey was found in the source evidence (no resolved service, messaging or database connections).</p> }
                        else
                        {
                            <div class="tco-filters" data-testid="tco-journey-filters">
                                <label class="tco-field tco-inline">Coverage <select @bind="_journeyCoverage" data-testid="tco-journey-coverage"><option value="">All</option>@foreach (var c in Enum.GetValues<StepCoverage>()) { <option value="@c">@P.Step(c)</option> }</select></label>
                                <label class="tco-field tco-inline">Connections <select @bind="_journeyConnections" data-testid="tco-journey-connections"><option value="">All</option><option value="pending">Need confirmation</option><option value="none">Nothing to confirm</option></select></label>
                            </div>
                        }
                        var journeys = r.Journeys.Where(MatchesJourney).ToList();
                        @foreach (var j in journeys.Take(_journeyLimit))
                        {
                            var sum = G.Summarize(j);
                            <article class="tco-journey" data-testid="tco-journey" data-weakest="@j.Weakest">
                                <h3>@j.Title</h3>
                                <dl class="tco-journey-facts" data-testid="tco-journey-summary">
                                    <div><dt>Coverage</dt><dd><span class="tco-pill tco-@P.StepTone(G.Weakest(j))">@P.Step(G.Weakest(j))</span></dd></div>
                                    <div><dt>Steps</dt><dd>@sum.Steps</dd></div>
                                    <div><dt>Developer-covered</dt><dd>@sum.Covered</dd></div>
                                    @if (sum.MockOnly > 0) { <div><dt>Mock-only</dt><dd>@sum.MockOnly</dd></div> }
                                    @if (sum.LowerLevelOnly > 0) { <div><dt>Lower level only</dt><dd>@sum.LowerLevelOnly</dd></div> }
                                    @if (sum.NotVerified > 0) { <div><dt>Not verified</dt><dd>@sum.NotVerified</dd></div> }
                                    <div><dt>Runtime verified</dt><dd>@(sum.RuntimeVerified == 0 ? "No" : $"{sum.RuntimeVerified} of {sum.Steps} steps")</dd></div>
                                    <div><dt>Connections to confirm</dt><dd>@sum.NeedConfirmation</dd></div>
                                </dl>
                                @if (j.FocusForTesters.Count > 0) { <p class="tco-focus"><strong>QA focus:</strong> @string.Join(" · ", j.FocusForTesters)</p> }
                                <details class="tco-details tco-steps-details" data-testid="tco-journey-steps">
                                    <summary>View journey steps (@j.Steps.Count)<span class="visually-hidden"> — @j.Title</span></summary>
                                    <ol class="tco-steps">
                                        @foreach (var s in j.Steps)
                                        {
                                            <li class="tco-step" data-testid="tco-step" data-coverage="@s.Developer" data-evidence="@s.Evidence">
                                                <div class="tco-step-head">
                                                    <span class="tco-step-name">@s.FromName → @s.ToName</span>
                                                    <span class="tco-pill tco-@P.StepTone(s.Developer)">@P.Step(s.Developer)</span>
                                                </div>
                                                <p class="tco-muted">@s.DeveloperExplanation Runtime: @s.Runtime.</p>
                                                <p class="tco-muted" data-testid="tco-connection">Connection: @P.Connection(s.Evidence, s.ReviewerDecision)</p>
                                                @if (s.Evidence is ConnectionEvidence.Suggested or ConnectionEvidence.NeedsConfirmation)
                                                {
                                                    <div class="tco-confirm" role="group" aria-label="Confirm connection @s.FromName to @s.ToName">
                                                        <button type="button" class="btn-secondary" data-testid="tco-confirm" @onclick="() => ToggleConnectionAsync(s)">@(s.ReviewerDecision == "Confirmed" ? "Reject" : "Confirm")</button>
                                                        @if (s.ReviewerDecision is null) { <button type="button" class="btn-secondary" data-testid="tco-reject" @onclick="() => RejectConnectionAsync(s)">Reject</button> }
                                                    </div>
                                                }
                                                <details class="tco-details"><summary>Technical details</summary>
                                                    <p>Boundary: @TestCoverageReviewText.Boundary(s.Boundary). QA: @s.QaExplanation</p>
                                                    <ul>@foreach (var p in s.Provenance) { <li><code>@p</code></li> }</ul>
                                                    @if (s.DeveloperTestIds.Count > 0) { <p>Tests: @string.Join(", ", s.DeveloperTestIds.Select(TestName).Take(8))</p> }
                                                </details>
                                            </li>
                                        }
                                    </ol>
                                </details>
                            </article>
                        }
                        @if (journeys.Count > _journeyLimit) { <button type="button" class="btn-secondary" @onclick="() => _journeyLimit += 10">Show more journeys</button> }
                        break;
                    case "components":
                        var dims = r.Components.SelectMany(c => c.Dimensions).Where(d => d.Status != DimensionStatus.NotAssessed || _showNotAssessed).Select(d => d.Dimension).Distinct().ToList();
                        var components = r.Components.Where(MatchesComponent).ToList();
                        <div class="tco-filters" data-testid="tco-component-filters">
                            <label class="tco-field tco-inline">Search component <input type="search" @bind="_componentSearch" @bind:event="oninput" data-testid="tco-component-search" /></label>
                            <label class="tco-field tco-inline">Coverage state <select @bind="_componentState" data-testid="tco-component-state"><option value="">All</option>@foreach (var st in Enum.GetValues<DimensionStatus>().Where(s => s != DimensionStatus.NotAssessed)) { <option value="@st">@P.Dimension(st)</option> }</select></label>
                            <label class="tco-toggle"><input type="checkbox" @bind="_showNotAssessed" data-testid="tco-show-not-assessed" /> Show dimensions that were not assessed</label>
                        </div>
                        <p class="tco-muted">Each cell is source evidence for one dimension — not an execution result (see Execution evidence above). "—" means the dimension was not assessed for that component.</p>
                        <div class="tco-scroll" role="region" aria-label="Component coverage matrix" tabindex="0">
                            <table class="tco-table tco-matrix" data-testid="tco-matrix">
                                <thead><tr><th scope="col">Component</th>@foreach (var d in dims) { <th scope="col">@d</th> }<th scope="col"><span class="visually-hidden">Details</span></th></tr></thead>
                                @foreach (var c in components)
                                {
                                    var open = _openComponents.Contains(c.ComponentId);
                                    <tbody data-testid="tco-component">
                                        <tr>
                                            <th scope="row">@c.Name <span class="tco-muted">(@c.Tests tests@(c.Skipped > 0 ? $", {c.Skipped} skipped" : ""))</span></th>
                                            @foreach (var name in dims)
                                            {
                                                var d = c.Dimensions.FirstOrDefault(x => x.Dimension == name && (x.Status != DimensionStatus.NotAssessed || _showNotAssessed));
                                                <td data-label="@name">@if (d is not null) { <span class="tco-pill tco-@P.DimensionTone(d.Status)" data-testid="tco-dimension" data-status="@d.Status">@P.Dimension(d.Status)</span> } else { <span class="tco-muted" aria-label="Not assessed">—</span> }</td>
                                            }
                                            <td><button type="button" class="tco-link" aria-expanded="@(open ? "true" : "false")" data-testid="tco-component-details-toggle" @onclick="() => ToggleComponent(c.ComponentId)">@(open ? "Hide details" : "View details")<span class="visually-hidden"> for @c.Name</span></button></td>
                                        </tr>
                                        @if (open)
                                        {
                                            <tr class="tco-component-details"><td colspan="@(dims.Count + 2)">
                                                <p class="tco-muted">@c.Type · @c.SourceProject · @c.Tests tests found</p>
                                                <ul class="tco-list">@foreach (var d in c.Dimensions.Where(x => x.Status != DimensionStatus.NotAssessed || _showNotAssessed)) { <li><strong>@d.Dimension</strong> — @P.Dimension(d.Status): @d.Explanation@(d.TestIds.Count > 0 ? $" Tests: {string.Join(", ", d.TestIds.Select(TestName).Take(5))}{(d.TestIds.Count > 5 ? $" (+{d.TestIds.Count - 5})" : "")}" : "")</li> }</ul>
                                            </td></tr>
                                        }
                                    </tbody>
                                }
                            </table>
                        </div>
                        @if (r.PipelineGating.Count > 0)
                        {
                            <details class="tco-details" data-testid="tco-pipeline-gating">
                                <summary>Pipeline test steps (@r.PipelineGating.Count(g => g.Gating.StartsWith("Gates")) gate a deployment)</summary>
                                <p class="tco-muted">From the source snapshot's delivery evidence: a test configured in a pipeline is not a test that gates deployment, and neither is a test that ran or passed.</p>
                                <ul class="tco-list">@foreach (var g in r.PipelineGating) { <li data-testid="tco-pipeline-gate"><strong>@g.Project</strong> — @g.Step in @g.Pipeline · @g.Gating <span class="tco-muted">@g.Execution</span></li> }</ul>
                            </details>
                        }
                        @if (r.Contracts.Count > 0)
                        {
                            <details class="tco-details" data-testid="tco-contracts">
                                <summary>Contract coverage (@r.Contracts.Count(c => c.Links.Count > 0) of @r.Contracts.Count contracts referenced by tests)</summary>
                                <p class="tco-muted">Which contract operations and message roots discovered tests name, from the source snapshot's stored contract evidence. A link means a test targets the contract — not that it ran or passed.</p>
                                <ul class="tco-list">@foreach (var contract in r.Contracts) { <li data-testid="tco-contract"><strong>@contract.Name</strong> <span class="tco-muted">@contract.Format</span> — @contract.Text</li> }</ul>
                            </details>
                        }
                        break;
                    case "requirements":
                        <div class="tco-filters"><label class="tco-field tco-inline">Status <select @bind="_behaviorStatus" data-testid="tco-behavior-status"><option value="">All</option>@foreach (var st in r.Behaviors.Select(b => b.Status).Distinct().Order()) { <option value="@st">@st</option> }</select></label></div>
                        var behaviors = r.Behaviors.Where(b => _behaviorStatus.Length == 0 || b.Status == _behaviorStatus).ToList();
                        @foreach (var behavior in behaviors.Take(_behaviorLimit))
                        {
                            <article class="tco-behavior" data-testid="tco-behavior" data-recommendation="@behavior.Recommendation">
                                <h3>@behavior.Title <span class="tco-pill">@behavior.Status</span></h3>
                                <dl class="tco-journey-facts">
                                    <div><dt>Already tested</dt><dd>@behavior.AlreadyTested.Count</dd></div>
                                    <div><dt>Not verified yet</dt><dd>@behavior.NotVerifiedYet.Count</dd></div>
                                </dl>
                                <p><strong>For testers:</strong> @behavior.ForTesters</p>
                                @if (behavior.AlreadyTested.Count > 0) { <details class="tco-details"><summary>What is already tested (@behavior.AlreadyTested.Count)</summary><ul class="tco-list">@foreach (var t in behavior.AlreadyTested) { <li>@t</li> }</ul></details> }
                                @if (behavior.NotVerifiedYet.Count > 0) { <details class="tco-details"><summary>What is not verified yet (@behavior.NotVerifiedYet.Count)</summary><ul class="tco-list">@foreach (var t in behavior.NotVerifiedYet) { <li>@t</li> }</ul></details> }
                                <details class="tco-details"><summary>Technical details</summary>
                                    <p>@P.Strength(behavior.Strength). Developer tests: @behavior.DeveloperTestIds.Count; QA tests: @behavior.QaTests. @string.Join(" ", behavior.Why)</p>
                                    @if (behavior.WhereTested.Count > 0) { <p>Where: @string.Join("; ", behavior.WhereTested)</p> }
                                </details>
                            </article>
                        }
                        @if (behaviors.Count > _behaviorLimit) { <button type="button" class="btn-secondary" @onclick="() => _behaviorLimit += 25">Show more</button> }
                        break;
                    case "duplicates":
                        <p class="tco-muted">QA tests that developer automation may already cover. BirkNext never removes a test; the test lead decides.</p>
                        @if (r.Overlaps.Count == 0) { <p data-testid="tco-no-overlaps">No QA test was found that overlaps developer automation. Acceptance scenarios from the specification and QA-owned tests are compared.</p> }
                        @if (G.DuplicateContext(r) is { } context) { <p class="tco-notice" data-testid="tco-duplicates-context">@context</p> }
                        <details class="tco-details" data-testid="tco-qa-input"><summary>Where QA tests come from</summary>
                            <p>Acceptance scenarios from the selected specification, test projects marked "QA automation" on the Overview, and Critical E2E flows of the active Target Environment. Manual tests outside machine-readable evidence are not seen, so overlap detection is only as complete as this input.</p>
                        </details>
                        @foreach (var o in r.Overlaps.OrderBy(o => o.Kind))
                        {
                            <article class="tco-overlap" data-testid="tco-overlap" data-kind="@o.Kind">
                                <h3>@o.QaTitle <span class="tco-pill">@P.Overlap(o.Kind)</span></h3>
                                <p>@o.Recommendation</p>
                                <p class="tco-muted">Remaining risk: @o.RemainingRisk</p>
                                <div class="tco-compare">
                                    <div><p class="tco-label">Same</p><p>@(o.Same.Count == 0 ? "—" : string.Join(", ", o.Same))</p></div>
                                    <div><p class="tco-label">Different</p><p>@(o.Different.Count == 0 ? "—" : string.Join(", ", o.Different))</p></div>
                                </div>
                                <details class="tco-details"><summary>Why BirkNext says this</summary>
                                    <p>@P.Strength(o.Strength)</p><ul>@foreach (var reason in o.Reasons) { <li>@reason</li> }</ul>
                                    <p>Developer tests: @string.Join(", ", o.DeveloperTestIds.Select(TestName))</p>
                                </details>
                            </article>
                        }
                        break;
                    case "scope":
                        <p class="tco-muted">@r.Gaps.Count remaining gaps and @(r.QaScope.Keep.Count + r.QaScope.ProbablyUnnecessary.Count + r.QaScope.NeedsReview.Count) recommendations, grouped. Open a group to see its items.</p>
                        @foreach (var group in G.ScopeGroups(r))
                        {
                            <details class="tco-scope-group" data-testid="tco-scope-group" data-group="@group.Key" data-count="@group.Count">
                                <summary><span class="tco-scope-title">@group.Title</span> <span class="tco-pill">@group.Count</span></summary>
                                <p class="tco-muted">@group.Explanation</p>
                                @switch (group.Key)
                                {
                                    case "focus":
                                        <ul class="tco-list" data-testid="tco-scope-keep">@foreach (var k in group.Lines) { <li>@k</li> }</ul>
                                        break;
                                    case "not-repeat":
                                        <ul class="tco-list" data-testid="tco-scope-unnecessary">@if (group.Lines.Count == 0) { <li>None identified from the current evidence.</li> } @foreach (var k in group.Lines) { <li>@k</li> }</ul>
                                        break;
                                    case "decisions":
                                        <ul class="tco-list" data-testid="tco-scope-review">@foreach (var k in group.Lines) { <li>@k</li> }</ul>
                                        break;
                                    case "connections":
                                        var pending = G.PendingConnections(r);
                                        @if (pending.Count > 0)
                                        {
                                            <div class="tco-scroll" role="region" aria-label="Connections needing confirmation" tabindex="0">
                                                <table class="tco-table" data-testid="tco-connections">
                                                    <thead><tr><th scope="col">From</th><th scope="col">To</th><th scope="col">Evidence confidence</th><th scope="col">Journey</th><th scope="col">Action</th></tr></thead>
                                                    <tbody>@foreach (var pc in pending)
                                                    {
                                                        <tr><td>@pc.Step.FromName</td><td>@pc.Step.ToName</td><td>@P.Connection(pc.Step.Evidence, pc.Step.ReviewerDecision)</td><td>@pc.Journey.Title</td>
                                                            <td><button type="button" class="btn-secondary" data-testid="tco-scope-confirm" @onclick="() => ToggleConnectionAsync(pc.Step)">Confirm<span class="visually-hidden"> @pc.Step.FromName to @pc.Step.ToName</span></button>
                                                                <button type="button" class="btn-secondary" data-testid="tco-scope-reject" @onclick="() => RejectConnectionAsync(pc.Step)">Reject<span class="visually-hidden"> @pc.Step.FromName to @pc.Step.ToName</span></button></td></tr>
                                                    }</tbody>
                                                </table>
                                            </div>
                                        }
                                        break;
                                    case "unknown-level":
                                        <ul class="tco-list" data-testid="tco-unknown-level">@foreach (var g in r.Tests.Where(G.IsUnknownLevel).GroupBy(t => t.Project).OrderByDescending(g => g.Count())) { <li>@g.Key — @g.Count() tests</li> }</ul>
                                        break;
                                    default:
                                        <ul class="tco-list" data-testid="tco-gaps">@foreach (var g in group.Gaps) { <li data-testid="tco-gap" data-kind="@g.Kind"><strong>@g.Attention:</strong> @g.Title. <span class="tco-muted">@g.Explanation</span></li> }</ul>
                                        break;
                                }
                            </details>
                        }
                        break;
                    case "documentation":
                        <p class="tco-muted">Readable documentation of covered tests, bound to this snapshot. Export it as HTML or Markdown above.</p>
                        <div class="tco-actions">
                            <button type="button" class="btn-secondary" data-testid="tco-copy-markdown" @onclick="CopyMarkdownAsync">Copy Markdown</button>
                            @if (_copyStatus is { } copyStatus) { <span class="tco-muted" role="status">@copyStatus</span> }
                        </div>
                        <article class="tco-doc-rendered" data-testid="tco-doc-preview" tabindex="0" aria-label="Covered tests documentation preview">@((MarkupString)RenderedDocumentation(r))</article>
                        <details class="tco-details" data-testid="tco-doc-raw-details"><summary>View raw Markdown</summary><pre class="tco-doc" data-testid="tco-doc-raw" tabindex="0">@Preview(r)</pre></details>
                        break;
                }
            </div>
            <details class="tco-details" data-testid="tco-limitations"><summary>Limitations of this review</summary><ul>@foreach (var l in r.Limitations.Concat(TestCoverageReviewText.Limitations)) { <li>@l</li> }</ul></details>
        </section>
    }

    @if (_history.Count > 0)
    {
        <section class="tco-card" aria-labelledby="tco-history-heading" data-testid="tco-history">
            <details class="tco-details">
                <summary><span id="tco-history-heading">Earlier reviews · @_history.Count</span></summary>
                <ul class="tco-list">
                    @foreach (var h in _history)
                    {
                        <li><button type="button" class="tco-link" @onclick="() => OpenAsync(h.RunId)">@h.CompletedAt.ToLocalTime().ToString("g") · @h.Label</button></li>
                    }
                </ul>
            </details>
        </section>
    }
</div>

@code {
    private enum ExportKind { CoveredHtml, ScopeMarkdown, FullHtml, FullMarkdown }
    private static readonly (string Key, string Label)[] Views =
    [
        ("overview", "Overview"), ("journeys", "By Journey"), ("components", "By Component"), ("requirements", "By Requirement / Risk"),
        ("duplicates", "Possible Duplicate Tests"), ("scope", "Remaining QA Scope"), ("documentation", "Covered Tests Documentation"),
    ];
    private static readonly string[] PhaseNames = ["Discovering test projects", "Analyzing tests", "Finding system journeys", "Mapping tests to journeys", "Checking overlaps", "Finding remaining gaps", "Preparing documentation"];
    private ReviewSourceOptions? _sources;
    private readonly ReviewSourceScopeState _scope = new();
    private string? _loadError, _runError, _projectName, _environmentId;
    private Guid? _currentId, _baselineId;
    private TestCoverageReviewResult? _result;
    private BirkNext.Web.Services.Explorers.ArtifactExplorerState? _specification;
    private IReadOnlyList<TestCoverageRunSummary> _history = [];
    private string _view = "overview";
    private bool _busy, _loaded, _showNotAssessed;
    private int _journeyLimit = 10, _behaviorLimit = 25, _gapLimit = 30;
    private ElementReference _resultHeading;
    private readonly CancellationTokenSource _cts = new();

    private IReadOnlyList<ReviewSourceSnapshot> Snapshots => _sources?.Snapshots.OrderByDescending(s => s.AnalyzedAt).ToList() ?? [];
    private ReviewSourceSnapshot? CurrentSnapshot => Snapshots.FirstOrDefault(s => s.SnapshotId == _currentId);
    private List<ReviewSourceSnapshot> BaselineOptions => CurrentSnapshot is { } c ? Snapshots.Where(s => s.RepositoryKey == c.RepositoryKey && s.SnapshotId != c.SnapshotId).ToList() : [];
    private string? BlockedReason => P.RunBlockedReason(_currentId, _busy);

    protected override async Task OnInitializedAsync()
    {
        // Captured once: leaving the page disposes the source, and reading _cts.Token after that throws.
        var token = _cts.Token;
        _projectName = (await CurrentWorkspace.GetAsync()).ProjectName;
        await LoadSpecificationAsync(token);
        if (token.IsCancellationRequested) return;
        var (options, error) = await Api.SourcesAsync(token);
        _sources = options; _loadError = error;
        _scope.Options = options ?? (error is null ? null : new ReviewSourceOptions());
        _currentId = Snapshots.FirstOrDefault()?.SnapshotId;
        _scope.PickPrimary(_currentId);
        _history = await Api.HistoryAsync(token);
        // Critical E2E flows of the active Target Environment count as QA automated tests (definitions and recorded runs only).
        if (Services.GetService<IFrontendAnalysisContextFactory>() is { } contexts)
        {
            try { _environmentId = (await contexts.GetActiveContextAsync()).ActiveProfileOrNull?.Id; }
            catch (Exception ex) when (BackendRequestClassifier.IsRequestFailure(ex) || ex is InvalidOperationException) { _environmentId = null; }
        }
        _loaded = true;
    }

    /// <summary>The specification the requirement views read: the focused module's selected specification in a monorepo, never a template or the first file.</summary>
    private async Task LoadSpecificationAsync(CancellationToken token)
    {
        if (Services.GetService<BirkNext.Web.Services.Explorers.IArtifactExplorerContext>() is not { } artifacts) return;
        try { _specification = await artifacts.GetStateAsync(WorkspaceArtifactType.Specification, token); }
        catch (Exception ex) when (ex is not OperationCanceledException) { _specification = null; }
    }

    private static string Short(string fingerprint) => fingerprint.Length > 8 ? fingerprint[..8] + "…" : fingerprint;
    private static string Option(ReviewSourceSnapshot s) => $"{s.Repository} · {s.ArchiveName} · {s.AnalyzedAt.ToLocalTime():g} · {Short(s.Fingerprint)}{(s.Latest ? " · latest" : "")}{(s.HasConsumerEvidence ? "" : " · needs re-analysis")}";
    private bool NewerExists(TestCoverageReviewResult r) => Snapshots.FirstOrDefault(s => s.SnapshotId == r.Current.SnapshotId) is { Latest: false };
    private string TestName(string id) => _result?.Tests.FirstOrDefault(t => t.TestId == id)?.Name ?? id;

    private void CurrentChanged(ChangeEventArgs e)
    {
        _currentId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        _scope.PickPrimary(_currentId);
        if (_baselineId is { } b && BaselineOptions.All(s => s.SnapshotId != b)) _baselineId = null;
    }

    private void BaselineChanged(ChangeEventArgs e) => _baselineId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;

    private void TabKey(KeyboardEventArgs e, string key)
    {
        var index = Array.FindIndex(Views, v => v.Key == key);
        if (e.Key == "ArrowRight") _view = Views[(index + 1) % Views.Length].Key;
        else if (e.Key == "ArrowLeft") _view = Views[(index + Views.Length - 1) % Views.Length].Key;
        else if (e.Key == "Home") _view = Views[0].Key;
        else if (e.Key == "End") _view = Views[^1].Key;
    }

    private async Task RunAsync()
    {
        if (BlockedReason is not null) return;
        _busy = true; _runError = null;
        try
        {
            var context = Services.GetService<IReviewContextProvider>()?.GetCurrent();
            await LoadSpecificationAsync(_cts.Token);
            var evidence = P.WorkspaceEvidence(Workspace, context, _projectName, _specification);
            var (result, error) = await Api.RunAsync(new TestCoverageReviewRequest { CurrentSnapshotId = _currentId!.Value, BaselineSnapshotId = _baselineId, EnvironmentId = _environmentId, Workspace = evidence }, _cts.Token);
            if (result is null) { _runError = error ?? "The review could not be run."; return; }
            _result = result; _view = "overview";
            _history = await Api.HistoryAsync(_cts.Token);
        }
        finally { _busy = false; }
        StateHasChanged();
        try { await _resultHeading.FocusAsync(); } catch (InvalidOperationException) { } catch (JSException) { }
    }

    private async Task DecideAsync(CoverageDecisionKind kind, string subject, string? value)
    {
        if (_result is null || string.IsNullOrWhiteSpace(value) || CurrentSnapshot is not { } snapshot) return;
        var (_, error) = await Api.DecideAsync(new CoverageDecision { RepositoryKey = snapshot.RepositoryKey, Kind = kind, SubjectKey = subject, Value = value }, _cts.Token);
        if (error is not null) { _runError = error; return; }
        // Decisions are review metadata: re-run so the result shows them next to (never instead of) the source evidence.
        await RunAsync();
    }

    private Task ToggleConnectionAsync(JourneyStep step) => DecideAsync(CoverageDecisionKind.JourneyConnection, step.Id, step.ReviewerDecision == "Confirmed" ? "Rejected" : "Confirmed");
    private Task RejectConnectionAsync(JourneyStep step) => DecideAsync(CoverageDecisionKind.JourneyConnection, step.Id, "Rejected");

    private async Task OpenAsync(Guid runId)
    {
        if (await Api.GetAsync(runId, _cts.Token) is { } result) { _result = result; _view = "overview"; }
    }

    private string _ownerFilter = "", _journeyCoverage = "", _journeyConnections = "", _componentSearch = "", _componentState = "", _behaviorStatus = "";
    private string? _copyStatus;
    private readonly HashSet<string> _openComponents = new(StringComparer.Ordinal);
    private static readonly Markdig.MarkdownPipeline DocumentationPipeline = new Markdig.MarkdownPipelineBuilder().UseAdvancedExtensions().DisableHtml().Build();

    private void ToggleComponent(string id) { if (!_openComponents.Remove(id)) _openComponents.Add(id); }

    private bool MatchesJourney(Journey j) =>
        (_journeyCoverage.Length == 0 || j.Steps.Any(s => s.Developer.ToString() == _journeyCoverage))
        && (_journeyConnections.Length == 0 || (_journeyConnections == "pending") == (G.Summarize(j).NeedConfirmation > 0));

    private bool MatchesComponent(ComponentCoverage c) =>
        (_componentSearch.Trim() is not { Length: > 0 } term || c.Name.Contains(term, StringComparison.OrdinalIgnoreCase) || c.SourceProject.Contains(term, StringComparison.OrdinalIgnoreCase))
        && (_componentState.Length == 0 || c.Dimensions.Any(d => d.Status.ToString() == _componentState));

    /// <summary>A short list with a "+N more" note; the full list lives in Remaining QA Scope.</summary>
    private static RenderFragment RecoList(IReadOnlyList<string> items, string testId, string empty) => __builder =>
    {
        <ul class="tco-list" data-testid="@testId">
            @if (items.Count == 0) { <li class="tco-muted">@empty</li> }
            @foreach (var item in items.Take(4)) { <li>@item</li> }
            @if (items.Count > 4) { <li class="tco-muted">+@(items.Count - 4) more in Remaining QA Scope</li> }
        </ul>
    };

    /// <summary>Rendered preview of the covered-tests documentation. Raw HTML in the Markdown is not rendered (escaped as text).</summary>
    private static string RenderedDocumentation(TestCoverageReviewResult r) => Markdig.Markdown.ToHtml(P.Markdown(r, coveredOnly: true), DocumentationPipeline);

    private async Task CopyMarkdownAsync()
    {
        if (_result is not { } r) return;
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", P.Markdown(r, coveredOnly: true)); _copyStatus = "Markdown copied to the clipboard."; }
        catch (JSException) { _copyStatus = "The browser did not allow copying. Use View raw Markdown and copy manually."; }
    }

    private static string Preview(TestCoverageReviewResult r)
    {
        var markdown = P.Markdown(r, coveredOnly: true);
        return markdown.Length > 6000 ? markdown[..6000] + "\n…" : markdown;
    }

    private async Task ExportAsync(ExportKind kind)
    {
        if (_result is not { } r) return;
        switch (kind)
        {
            case ExportKind.CoveredHtml: await JS.InvokeVoidAsync("downloadHtmlFile", P.FileName(r, "covered-tests", "html"), P.Html(r, coveredOnly: true)); break;
            case ExportKind.ScopeMarkdown: await JS.InvokeVoidAsync("downloadTextFile", P.FileName(r, "remaining-qa-scope", "md"), P.Markdown(r, scopeOnly: true), "text/markdown"); break;
            case ExportKind.FullHtml: await JS.InvokeVoidAsync("downloadHtmlFile", P.FileName(r, "test-coverage-review", "html"), P.Html(r)); break;
            default: await JS.InvokeVoidAsync("downloadTextFile", P.FileName(r, "test-coverage-review", "md"), P.Markdown(r), "text/markdown"); break;
        }
    }

    public void Dispose() { _cts.Cancel(); _cts.Dispose(); }
}
