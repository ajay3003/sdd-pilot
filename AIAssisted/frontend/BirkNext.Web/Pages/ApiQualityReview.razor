@page "/api-quality-review"
@using BirkNext.ApiReview
@using BirkNext.LocalHttpsProxy
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using BirkNext.Web.Components
@using Microsoft.AspNetCore.WebUtilities
@inject IApiReviewService ReviewService
@inject IFrontendAnalysisContextFactory ContextFactory
@inject IEndpointDiscoveryService Discovery
@inject IApiReviewHistoryService History
@inject IAuthenticatedReviewCapabilitiesService Capabilities
@inject RuntimeReviewSessionService RuntimeReviews
@inject IWorkspaceSessionService Workspace
@inject IReportExportService ExportService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>API Quality Review</PageTitle>

<div class="aqr-page">
    <PageHeader Title="API Quality Review"
                Description="Is this API correct, safe, robust, contractually sound and performant? Read-only review of the REST services and GraphQL endpoints of the active Target Environment: discovered by Endpoint Discovery, configured, or described by a contract." />

    @* ── Setup: target environment · API targets · access · contracts · run ── *@
    <section class="aqr-setup" data-testid="aqr-setup" aria-label="Review setup">
        <div class="aqr-setup-grid">
            <div class="aqr-card" data-testid="aqr-environment">
                <h3>Target Environment</h3>
                @if (_context is null)
                {
                    <p class="aqr-muted">Loading the active Target Environment…</p>
                }
                else if (_context.ActiveTargetError is { Length: > 0 } activeError)
                {
                    <p class="aqr-error-inline" data-testid="aqr-active-target-error">@activeError</p>
                }
                else
                {
                    <dl class="aqr-dl">
                        <div><dt>Active target</dt><dd><span class="aqr-env-badge aqr-env-badge-@_context.ActiveProfile.EnvironmentType.ToString().ToLowerInvariant()">@_context.ActiveProfile.EnvironmentType</span> <strong data-testid="aqr-env-name">@_context.ActiveProfile.Name</strong></dd></div>
                        <div><dt>Frontend URL</dt><dd class="aqr-mono">@_context.TargetUrl</dd></div>
                        <div><dt>Authenticated testing method</dt><dd>@AuthenticatedTestingMethodLabels.Option(_context.ActiveProfile.Authentication.AuthenticatedTestingMethod)</dd></div>
                        <div><dt>Production policy</dt><dd>@(IsProduction ? "Passive read-only review; error probes disabled" : "Read-only review with safe error probes")</dd></div>
                    </dl>
                }
            </div>

            <div class="aqr-card" data-testid="aqr-access">
                <h3>Authentication / access</h3>
                @if (_capabilities is { } caps)
                {
                    <p data-testid="aqr-access-mode"><strong>@(caps.AuthenticatedApi ? "Authenticated HTTP via Local HTTPS Proxy" : "Public HTTP only")</strong></p>
                    <p class="aqr-muted">@caps.Reason</p>
                    @if (!caps.AuthenticatedApi && _targets.Any(t => t.AuthRequired))
                    {
                        <p class="aqr-warn" data-testid="aqr-auth-missing">@ApiReviewRunEligibility.NoAuthContextReason @ApiReviewRunEligibility.NoAuthContextAction</p>
                    }
                }
                else
                {
                    <p class="aqr-muted">Resolving authenticated capabilities…</p>
                }
                <p class="aqr-muted">Authenticated requests are executed by the backend gateway (GET/HEAD/OPTIONS, GraphQL queries); the review never receives a token.</p>
            </div>

            <div class="aqr-card" data-testid="aqr-contracts">
                <h3>Contracts</h3>
                @{ var openApi = _targets.Where(t => t.ContractSource is not null).Select(t => t.ContractSource!).Distinct().ToList(); }
                @if (openApi.Count > 0)
                {
                    <p><strong>OpenAPI:</strong> @string.Join(", ", openApi)</p>
                }
                else
                {
                    <p class="aqr-muted">No OpenAPI / Swagger URL configured — live responses are reviewed structurally; contract validation needs a published contract.</p>
                }
                <p><strong>GraphQL schema:</strong> @(_targets.Any(t => t.ApiType == ApiReviewTargetType.GraphQl) ? "retrieved by introspection at run time (query only; disabled introspection is a policy observation, not a failure)" : "no GraphQL endpoint known")</p>
                @if (_history?.Baselines.Count > 0)
                {
                    <p class="aqr-muted" data-testid="aqr-baselines">@_history.Baselines.Count baseline(s) from previous runs enable contract-drift detection.</p>
                }
            </div>
        </div>

        <div class="aqr-card" data-testid="aqr-targets">
            <div class="aqr-card-head">
                <h3>API targets <span class="aqr-muted">(@_targets.Count)</span></h3>
                <a class="aqr-link" href="@ApiReviewRunEligibility.TargetEnvironmentsHref">Endpoint Discovery / configuration →</a>
            </div>
            @if (_targets.Count == 0)
            {
                <p class="aqr-empty" data-testid="aqr-no-targets">@ApiReviewRunEligibility.NoTargetsReason Run the Local HTTPS proxy and use the application (Endpoint Discovery), or configure a REST base URL, GraphQL endpoint or OpenAPI URL on the Target Environment.</p>
            }
            else
            {
                @foreach (var group in new[] { ApiReviewTargetType.Rest, ApiReviewTargetType.GraphQl })
                {
                    var items = _targets.Where(t => t.ApiType == group).ToList();
                    if (items.Count == 0) continue;
                    <h4 class="aqr-group-title">@(group == ApiReviewTargetType.Rest ? "REST" : "GraphQL")</h4>
                    <ul class="aqr-target-list">
                        @foreach (var t in items)
                        {
                            <li class="aqr-target @(_selected.Contains(t.TargetId) ? "aqr-target-selected" : "")" data-testid="aqr-target" data-target-id="@t.TargetId" data-auth="@t.AuthRequired.ToString().ToLowerInvariant()">
                                <label>
                                    <input type="checkbox" checked="@_selected.Contains(t.TargetId)" @onchange="e => ToggleTarget(t.TargetId, (bool)e.Value!)" data-testid="aqr-target-checkbox" />
                                    <span class="aqr-target-name">@t.ServiceName</span>
                                    <span class="aqr-mono aqr-target-url">@t.Url</span>
                                </label>
                                <div class="aqr-target-meta">
                                    <span class="aqr-chip">@t.Source</span>
                                    <span class="aqr-chip">@t.Confidence</span>
                                    <span class="aqr-chip @(t.AuthRequired ? "aqr-chip-auth" : "")">@(t.AuthRequired ? "Authentication required" : "Public")</span>
                                    <span class="aqr-chip">@t.Operations.Count operation(s)@(t.Operations.Any(o => !o.IsSafe) ? $", {t.Operations.Count(o => !o.IsSafe)} write (not executed)" : "")</span>
                                    @if (t.ContractSource is not null) { <span class="aqr-chip">OpenAPI</span> }
                                </div>
                                @if (t.Operations.Count > 0)
                                {
                                    <details class="aqr-ops">
                                        <summary>Operations</summary>
                                        <ul>
                                            @foreach (var o in t.Operations.Take(30))
                                            {
                                                <li class="aqr-mono">@o.Display <span class="aqr-muted">· @(o.ObservedCount > 0 ? $"{o.ObservedCount}× observed" : o.Source.ToString())@(o.IsSafe ? "" : " · write, manual review")</span></li>
                                            }
                                        </ul>
                                    </details>
                                }
                            </li>
                        }
                    </ul>
                }
            }
        </div>

        <div class="aqr-run-row" data-testid="aqr-run-row">
            <PrimaryButton OnClick="RunReview" Disabled="@(!Eligibility.Enabled || _running)" aria-label="Run API Quality Review">
                @if (_running) { <span class="aqr-spinner" aria-hidden="true">⟳</span> }
                @(_running ? "Reviewing…" : "Run API Quality Review")
            </PrimaryButton>
            <span class="aqr-run-reason @(Eligibility.Enabled ? "aqr-run-ok" : "aqr-run-blocked")" data-testid="aqr-run-reason">@Eligibility.Reason</span>
            @if (!Eligibility.Enabled && Eligibility.ActionText is not null)
            {
                <a class="aqr-link" data-testid="aqr-run-action" href="@(Eligibility.ActionHref ?? ApiReviewRunEligibility.TargetEnvironmentsHref)">@Eligibility.ActionText</a>
            }
            @if (_report is not null)
            {
                <button type="button" class="btn-secondary aqr-btn-sm" @onclick="ExportHtml" data-testid="aqr-export">Export HTML</button>
            }
        </div>
        @if (_running)
        {
            <p class="aqr-progress" role="status" aria-live="polite"><span class="aqr-spinner" aria-hidden="true">⟳</span> @_progressMessage</p>
        }
        @if (_errorMessage is not null)
        {
            <div class="aqr-error" role="alert" data-testid="aqr-error">@_errorMessage</div>
        }
    </section>

    @* ── Results ── *@
    @if (_report is { } report)
    {
        <section class="aqr-results" data-testid="aqr-results" aria-label="Review results">
            <div class="aqr-overview" data-testid="aqr-overview">
                <div class="aqr-kpi"><span class="aqr-kpi-label">Target</span><span class="aqr-kpi-value" data-testid="aqr-result-env">@report.Environment.Name</span><span class="aqr-muted">@report.Environment.EnvironmentType · @report.GeneratedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span></div>
                <div class="aqr-kpi"><span class="aqr-kpi-label">Services</span><span class="aqr-kpi-value">REST @report.RestServices · GraphQL @report.GraphQlServices</span></div>
                <div class="aqr-kpi"><span class="aqr-kpi-label">Access</span><span class="aqr-kpi-value aqr-kpi-small" data-testid="aqr-result-access">@ApiReviewExport.AccessLabel(report)</span></div>
                <div class="aqr-kpi" data-testid="aqr-coverage">
                    <span class="aqr-kpi-label">Coverage</span>
                    <span class="aqr-kpi-small">REST operations @report.Coverage.RestOperationsReviewed / @report.Coverage.RestOperationsTotal</span>
                    <span class="aqr-kpi-small">GraphQL operations @report.Coverage.GraphQlOperationsMatched / @report.Coverage.GraphQlOperationsObserved schema-matched</span>
                    <span class="aqr-kpi-small">Contract checks @report.Coverage.ContractChecks · Security checks @report.Coverage.SecurityChecks</span>
                    <span class="aqr-kpi-small">Authenticated @report.Coverage.AuthenticatedExecuted / @report.Coverage.AuthenticatedPlanned · Public @report.Coverage.PublicExecuted / @report.Coverage.PublicPlanned@(report.Coverage.TargetsBlocked > 0 ? $" · {report.Coverage.TargetsBlocked} blocked" : "")</span>
                </div>
                <div class="aqr-kpi" data-testid="aqr-finding-counts">
                    <span class="aqr-kpi-label">Findings</span>
                    <span class="aqr-counts">
                        @foreach (var sev in Enum.GetValues<ApiReviewSeverity>())
                        {
                            var n = report.Findings.Count(f => f.Severity == sev);
                            <span class="aqr-sev aqr-sev-@sev.ToString().ToLowerInvariant()">@sev @n</span>
                        }
                    </span>
                </div>
            </div>

            <nav class="aqr-tabs" role="tablist">
                @foreach (var tab in Tabs)
                {
                    <button type="button" class="aqr-tab @(_tab == tab ? "aqr-tab-active" : "")" role="tab" aria-selected="@(_tab == tab)" data-testid="aqr-tab-@tab.ToLowerInvariant()" @onclick="() => _tab = tab">@tab</button>
                }
            </nav>

            @if (_tab == "Overview")
            {
                <div class="aqr-tablewrap">
                    <table class="aqr-table" data-testid="aqr-services-table">
                        <thead><tr><th>Service</th><th>Type</th><th>Endpoint</th><th>Source</th><th>Access</th><th>Status</th><th>Contract</th><th>Findings</th></tr></thead>
                        <tbody>
                            @foreach (var t in report.Targets)
                            {
                                <tr data-testid="aqr-service-row" data-target-id="@t.Target.TargetId">
                                    <td><strong>@t.Target.ServiceName</strong></td>
                                    <td>@t.Target.ApiType</td>
                                    <td class="aqr-mono">@t.Target.Url</td>
                                    <td>@t.Target.Source</td>
                                    <td><span class="aqr-chip">@t.AccessMode</span></td>
                                    <td><span class="aqr-state aqr-state-@t.Status.ToString().ToLowerInvariant()" data-testid="aqr-service-status">@StatusLabel(t.Status)</span>@if (t.RequiredAction is not null) { <br /><span class="aqr-muted">@t.RequiredAction</span> }</td>
                                    <td>@(t.Contract is null ? "—" : $"{t.Contract.Kind}: {ResultLabel(t.Contract.Status)}")</td>
                                    <td data-testid="aqr-service-findings">@(t.FindingCount is null ? "Not tested" : t.FindingCount.Value.ToString())</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (report.ManualReviewItems.Count > 0)
                {
                    <h4 class="aqr-group-title">Manual review</h4>
                    <ul class="aqr-list">@foreach (var m in report.ManualReviewItems) { <li>@m</li> }</ul>
                }
                @if (report.Limitations.Count > 0)
                {
                    <h4 class="aqr-group-title">Limitations</h4>
                    <ul class="aqr-list aqr-muted">@foreach (var l in report.Limitations) { <li>@l</li> }</ul>
                }
            }
            else if (_tab is "REST" or "GraphQL")
            {
                var type = _tab == "REST" ? ApiReviewTargetType.Rest : ApiReviewTargetType.GraphQl;
                var targets = report.Targets.Where(t => t.Target.ApiType == type).ToList();
                @if (targets.Count == 0) { <p class="aqr-empty">No @_tab targets in this review.</p> }
                @foreach (var t in targets)
                {
                    <div class="aqr-card aqr-target-result" data-testid="aqr-target-result" data-target-id="@t.Target.TargetId">
                        <div class="aqr-card-head">
                            <h3>@t.Target.ServiceName <span class="aqr-mono aqr-muted">@t.Target.Url</span></h3>
                            <span class="aqr-state aqr-state-@t.Status.ToString().ToLowerInvariant()">@StatusLabel(t.Status)</span>
                        </div>
                        <p class="aqr-muted"><strong>Access:</strong> @t.AccessMode — @t.AccessReason @if (t.RequiredAction is not null) { <strong>Action:</strong> @t.RequiredAction }</p>
                        @if (t.Contract is { } contract)
                        {
                            <p><strong>@contract.Kind:</strong> <span class="aqr-state aqr-state-@contract.Status.ToString().ToLowerInvariant()">@ResultLabel(contract.Status)</span> @contract.Note @(contract.Hash is null ? "" : $"· hash {contract.Hash}")</p>
                        }
                        @if (t.Operations.Count > 0)
                        {
                            <div class="aqr-tablewrap">
                                <table class="aqr-table">
                                    <thead><tr><th>Operation</th><th>Executed</th><th>Status</th><th>Content type</th><th>Latency</th><th>Bytes</th><th>Result</th><th>Contract</th><th>Note</th></tr></thead>
                                    <tbody>
                                        @foreach (var o in t.Operations)
                                        {
                                            <tr data-testid="aqr-operation-row">
                                                <td class="aqr-mono">@o.Display</td>
                                                <td>@(o.Executed ? $"yes ({o.AccessMode})" : "no")</td>
                                                <td>@(o.Executed ? o.StatusCode.ToString() : "—")</td>
                                                <td>@(o.ContentType ?? "—")</td>
                                                <td>@(o.ElapsedMs is { } ms ? $"{ms:0} ms" : "—")</td>
                                                <td>@(o.ContentLength?.ToString() ?? "—")</td>
                                                <td><span class="aqr-state aqr-state-@o.Result.ToString().ToLowerInvariant()">@ResultLabel(o.Result)</span></td>
                                                <td>@(o.ContractMatched is null ? "—" : o.ContractMatched.Value ? "matched" : "not documented")</td>
                                                <td class="aqr-muted">@o.Note</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        @RenderChecks(t.Checks.Concat(t.Operations.SelectMany(o => o.Checks.Select(c => c with { Title = $"{o.Display}: {c.Title}" }))).ToList(), null)
                    </div>
                }
            }
            else if (_tab == "Findings")
            {
                @RenderFindings(report.Findings, null)
            }
            else
            {
                var areas = _tab switch
                {
                    "Contracts" => new[] { ApiReviewFindingType.Contract, ApiReviewFindingType.Documentation, ApiReviewFindingType.Drift },
                    "Security" => new[] { ApiReviewFindingType.Security, ApiReviewFindingType.Authorization },
                    "Errors" => new[] { ApiReviewFindingType.Errors },
                    _ => new[] { ApiReviewFindingType.Performance },
                };
                @if (_tab == "Contracts")
                {
                    <div class="aqr-tablewrap">
                        <table class="aqr-table" data-testid="aqr-contracts-table">
                            <thead><tr><th>Service</th><th>Contract</th><th>Status</th><th>Version</th><th>Operations / types</th><th>Mutations</th><th>Deprecated</th><th>Introspection</th><th>Hash</th><th>Note</th></tr></thead>
                            <tbody>
                                @foreach (var t in report.Targets.Where(t => t.Contract is not null))
                                {
                                    var c = t.Contract!;
                                    <tr><td>@t.Target.ServiceName</td><td>@c.Kind</td><td><span class="aqr-state aqr-state-@c.Status.ToString().ToLowerInvariant()">@ResultLabel(c.Status)</span></td><td>@(c.Version ?? "—")</td><td>@c.OperationCount / @c.TypeCount</td><td>@c.MutationCount</td><td>@c.DeprecatedCount</td><td>@(c.IntrospectionEnabled is null ? "—" : c.IntrospectionEnabled.Value ? "enabled" : "disabled")</td><td class="aqr-mono">@(c.Hash ?? "—")</td><td class="aqr-muted">@c.Note</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @foreach (var t in report.Targets.Where(t => t.GraphQlOperationMatches.Count > 0))
                    {
                        <h4 class="aqr-group-title">@t.Target.ServiceName · observed operations</h4>
                        <div class="aqr-tablewrap">
                            <table class="aqr-table" data-testid="aqr-gql-operations">
                                <thead><tr><th>Observed operation</th><th>Root field</th><th>Result</th><th>Note</th></tr></thead>
                                <tbody>@foreach (var m in t.GraphQlOperationMatches) { <tr><td class="aqr-mono">@m.Operation</td><td class="aqr-mono">@(m.MatchedRootField ?? "—")</td><td><span class="aqr-state aqr-state-@m.Result.ToString().ToLowerInvariant()">@ResultLabel(m.Result)</span></td><td class="aqr-muted">@m.Note</td></tr> }</tbody>
                            </table>
                        </div>
                    }
                }
                @RenderChecks(report.Targets.SelectMany(t => t.Checks.Concat(t.Operations.SelectMany(o => o.Checks)).Where(c => areas.Contains(c.Area)).Select(c => c with { Title = $"{t.Target.ServiceName}: {c.Title}" })).ToList(), areas)
                @RenderFindings(report.Findings.Where(f => areas.Contains(f.Type)).ToList(), areas)
            }
        </section>
    }
</div>

@code {
    private static readonly string[] Tabs = ["Overview", "REST", "GraphQL", "Contracts", "Security", "Errors", "Performance", "Findings"];

    private FrontendAnalysisContext? _context;
    private AuthenticatedReviewCapabilities? _capabilities;
    private List<ApiReviewTarget> _targets = [];
    private readonly HashSet<string> _selected = new(StringComparer.Ordinal);
    private ApiReviewHistory? _history;
    private ApiReviewReport? _report;
    private bool _running;
    private string _progressMessage = "";
    private string? _errorMessage;
    private string _tab = "Overview";
    private string? _requestedTargetId;

    private bool IsProduction => _context?.ActiveProfile.EnvironmentType == FrontendEnvironmentType.Production;
    private ApiReviewRunEligibility Eligibility => ApiReviewRunEligibility.Evaluate(_context, _targets, _selected, _capabilities);

    protected override async Task OnInitializedAsync()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (query.TryGetValue("target", out var requested)) _requestedTargetId = requested.ToString();
        _report = RuntimeReviews.ApiQualityReview.Report;
        await History.LoadAsync(JS);
        await Discovery.LoadAsync(JS);
        await RefreshContextAsync();
    }

    private async Task RefreshContextAsync()
    {
        _context = await ContextFactory.GetActiveContextAsync();
        if (_context.ActiveTargetError is not null) { _targets = []; _selected.Clear(); _capabilities = null; return; }
        _history = History.For(_context.ActiveProfile.Id);
        _report ??= _history.LastReport is { } last && last.Environment.EnvironmentId == _context.ActiveProfile.Id ? last : null;
        _targets = ApiReviewTargetResolver.Resolve(_context, Discovery.GetSnapshot(_context.ActiveProfile.Id));
        _selected.Clear();
        foreach (var t in _targets.Where(t => t.Selected)) _selected.Add(t.TargetId);
        if (_requestedTargetId is not null && _targets.Any(t => t.TargetId == _requestedTargetId)) _selected.Add(_requestedTargetId);
        _capabilities = null;
        var identity = _context.ReviewIdentity ?? ReviewAuthenticationIdentity.ForContext(_context);
        try { _capabilities = await Capabilities.ResolveAsync(identity); }
        catch { _capabilities = new AuthenticatedReviewCapabilities { Method = identity.Method, PublicApi = true, Reason = "Authenticated capabilities could not be resolved; public targets only." }; }
    }

    private void ToggleTarget(string id, bool selected) { if (selected) _selected.Add(id); else _selected.Remove(id); }

    /// <summary>Creates the immutable review snapshot from the active environment at Run; settings edited while the review runs never affect it.</summary>
    private async Task RunReview()
    {
        if (_running || _context is null || !Eligibility.Enabled) return;
        _running = true; _errorMessage = null; _progressMessage = "Reviewing selected API targets (read-only)…";
        var context = _context;
        var identity = context.ReviewIdentity ?? ReviewAuthenticationIdentity.ForContext(context);
        var request = BuildRequest(context, identity, _targets, _selected, _history);
        RuntimeReviews.MarkApiQualityRunning(context);
        StateHasChanged();
        try
        {
            var (report, error) = await ReviewService.RunAsync(request);
            if (error is not null || report is null)
            {
                _errorMessage = error ?? "The review returned no result.";
                RuntimeReviews.MarkApiQualityFailed(context, _errorMessage);
            }
            else
            {
                _report = report;
                _tab = "Overview";
                RuntimeReviews.SaveApiQualityResult(report, context);
                await History.RecordAsync(JS, context.ActiveProfile.Id, report);
                _history = History.For(context.ActiveProfile.Id);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Review failed: " + ex.GetType().Name;
            RuntimeReviews.MarkApiQualityFailed(context, _errorMessage);
        }
        finally { _running = false; }
    }

    public static ApiReviewRunRequest BuildRequest(FrontendAnalysisContext context, AuthenticatedReviewIdentity identity, IReadOnlyList<ApiReviewTarget> targets, IReadOnlyCollection<string> selected, ApiReviewHistory? history)
    {
        var production = context.ActiveProfile.EnvironmentType == FrontendEnvironmentType.Production;
        var selectedTargets = targets.Select(t => t with { Selected = selected.Contains(t.TargetId) }).Where(t => t.Selected).ToList();
        return new ApiReviewRunRequest
        {
            Environment = new ApiReviewEnvironmentSnapshot
            {
                EnvironmentId = context.ActiveProfile.Id, Name = context.ActiveProfile.Name, EnvironmentType = context.ActiveProfile.EnvironmentType.ToString(), TargetUrl = context.TargetUrl,
                AuthenticatedTestingMethod = identity.Method, RequiresAuthentication = context.RequiresAuthentication, ContextIdentityDigest = identity.ContextFingerprint, IsProduction = production, CapturedAt = DateTimeOffset.UtcNow,
            },
            Identity = identity, Targets = selectedTargets,
            Policy = new ApiReviewPolicy
            {
                ReadOnly = true, ErrorHandlingProbes = !production, SlowWarningMs = context.PerformanceThresholds.ApiResponseWarningMs, SlowPoorMs = context.PerformanceThresholds.ApiResponsePoorMs,
                LargePayloadBytes = Math.Max(context.PerformanceThresholds.MaxRestPayloadBytes, context.PerformanceThresholds.MaxGraphQlPayloadBytes), IntrospectionExpectedDisabled = production,
            },
            Baselines = history is null ? [] : selectedTargets.Where(t => history.Baselines.ContainsKey(t.TargetId)).Select(t => history.Baselines[t.TargetId]).ToList(),
            FrontendOrigin = Uri.TryCreate(context.TargetUrl, UriKind.Absolute, out var origin) ? origin.GetLeftPart(UriPartial.Authority) : null,
        };
    }

    private async Task ExportHtml()
    {
        if (_report is null) return;
        var html = ExportService.ExportApiReview(_report, Workspace.ProjectName);
        await JS.InvokeVoidAsync("downloadHtmlFile", $"api-quality-review-{DateTime.UtcNow:yyyy-MM-dd}.html", html);
    }

    private RenderFragment RenderChecks(IReadOnlyList<ApiReviewCheck> checks, ApiReviewFindingType[]? areas) => __builder =>
    {
        if (checks.Count == 0) return;
        <details class="aqr-checks" open="@(areas is not null)">
            <summary>Checks (@checks.Count) · @string.Join(" · ", checks.GroupBy(c => c.Result).OrderBy(g => g.Key).Select(g => $"{ResultLabel(g.Key)} {g.Count()}"))</summary>
            <div class="aqr-tablewrap">
                <table class="aqr-table aqr-checks-table" data-testid="aqr-checks-table">
                    <thead><tr><th>Area</th><th>Check</th><th>Result</th><th>Detail</th><th>Evidence</th></tr></thead>
                    <tbody>
                        @foreach (var c in checks)
                        {
                            <tr data-testid="aqr-check-row" data-check-id="@c.CheckId" data-result="@c.Result"><td>@c.Area</td><td>@c.Title</td><td><span class="aqr-state aqr-state-@c.Result.ToString().ToLowerInvariant()">@ResultLabel(c.Result)</span></td><td>@c.Detail</td><td class="aqr-mono aqr-muted">@string.Join(" · ", c.Evidence.Take(5))</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </details>
    };

    private RenderFragment RenderFindings(IReadOnlyList<ApiReviewFinding> findings, ApiReviewFindingType[]? areas) => __builder =>
    {
        <h4 class="aqr-group-title">Findings (@findings.Count)</h4>
        @if (findings.Count == 0)
        {
            <p class="aqr-empty" data-testid="aqr-no-findings">No findings@(areas is null ? "" : " in this area") on the completed targets. Blocked or not-tested targets are listed as such, never as passes.</p>
        }
        else
        {
            <div class="aqr-tablewrap">
                <table class="aqr-table aqr-findings-table" data-testid="aqr-findings-table">
                    <thead><tr><th>Severity</th><th>Type</th><th>Endpoint / operation</th><th>Check</th><th>Result</th><th>Finding</th><th>Evidence</th><th>Recommendation</th></tr></thead>
                    <tbody>
                        @foreach (var f in findings)
                        {
                            <tr data-testid="aqr-finding-row" data-finding-id="@f.Id">
                                <td><span class="aqr-sev aqr-sev-@f.Severity.ToString().ToLowerInvariant()">@f.Severity</span></td>
                                <td>@f.Type@(f.Drift is { } d ? $" · {DriftLabel(d)}" : "")</td>
                                <td class="aqr-mono">@f.Endpoint</td>
                                <td>@f.Check</td>
                                <td><span class="aqr-state aqr-state-@f.Result.ToString().ToLowerInvariant()">@ResultLabel(f.Result)</span></td>
                                <td><strong>@f.Title</strong><br /><span class="aqr-muted">@f.Description</span></td>
                                <td class="aqr-mono aqr-evidence">@string.Join(" · ", f.Evidence.Take(6))</td>
                                <td>@f.Recommendation</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    };

    private static string StatusLabel(ApiReviewTargetStatus status) => status switch
    {
        ApiReviewTargetStatus.Completed => "Completed", ApiReviewTargetStatus.PartiallyCompleted => "Partially completed", ApiReviewTargetStatus.Blocked => "Blocked", _ => "Not tested",
    };

    private static string ResultLabel(ApiReviewCheckResult result) => result switch
    {
        ApiReviewCheckResult.Pass => "Pass", ApiReviewCheckResult.Fail => "Fail", ApiReviewCheckResult.Warning => "Warning", ApiReviewCheckResult.ManualReview => "Manual review",
        ApiReviewCheckResult.NotApplicable => "Not applicable", ApiReviewCheckResult.Blocked => "Blocked", _ => "Not tested",
    };

    private static string DriftLabel(ApiReviewDriftClassification d) => d switch
    {
        ApiReviewDriftClassification.Breaking => "Breaking", ApiReviewDriftClassification.PotentiallyBreaking => "Potentially breaking", ApiReviewDriftClassification.NonBreaking => "Non-breaking", _ => "Informational",
    };
}
