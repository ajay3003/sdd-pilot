    private const string OperationViewAll = "all", OperationViewAttention = "attention", OperationViewNotExecuted = "not-executed";
    private string _operationSearch = "";
    private string _operationView = OperationViewAll;
    private void ClearOperationFilters() { _operationSearch = ""; _operationView = OperationViewAll; }

    /// <summary>An executed operation with a failed check, an observed issue or an error status. A not-executed operation is never "attention":
    /// not executed is not failed.</summary>
    private static bool OperationNeedsAttention(ApiReviewOperationResult o, ApiReviewPolicy policy) =>
        o.Executed && (o.StatusCode >= 400 || o.Checks.Any(c => c.Result == ApiReviewCheckResult.Fail || ApiReviewStatusTaxonomy.Of(c, policy) == ApiReviewCanonicalStatus.IssueDetected));

    private bool OperationShown(ApiReviewOperationResult o) =>
        (_operationSearch.Trim() is not { Length: > 0 } q || o.Display.Contains(q, StringComparison.OrdinalIgnoreCase) || (o.Path?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false))
        && _operationView switch
        {
            OperationViewAttention => OperationNeedsAttention(o, _report?.Policy ?? new()),
            OperationViewNotExecuted => !o.Executed,
            _ => true,
        };

