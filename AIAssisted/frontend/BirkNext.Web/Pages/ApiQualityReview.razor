@page "/api-quality-review"
@using BirkNext.ApiReview
@using BirkNext.LocalHttpsProxy
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using BirkNext.Web.Components
@using Microsoft.AspNetCore.WebUtilities
@inject IApiReviewService ReviewService
@inject IFrontendAnalysisContextFactory ContextFactory
@inject IEndpointDiscoveryService Discovery
@inject IApiReviewHistoryService History
@inject IAuthenticatedReviewCapabilitiesService Capabilities
@inject RuntimeReviewSessionService RuntimeReviews
@inject IWorkspaceSessionService Workspace
@inject IReportExportService ExportService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>API Quality Review</PageTitle>

<div class="aqr-page">
    <PageHeader Title="API Quality Review"
                Description="Review discovered REST and GraphQL APIs for security, contract quality, robustness, error handling, and response timing. Read-only.">
        @if (_report is not null)
        {
            <button type="button" class="btn-secondary" @onclick="ExportHtml" data-testid="aqr-export">Export HTML</button>
        }
    </PageHeader>

    @{
        var access = ApiReviewPresentation.AccessPanel(_context, _capabilities, _targets, _selected);
        var readiness = ApiReviewPresentation.Readiness(Eligibility, _context, _targets, _selected, _capabilities);
        var contracts = ApiReviewPresentation.Contracts(_targets, _selected, _history, _report ?? _history?.LastReport);
        var scope = ApiReviewPresentation.Scope(_targets, _selected);
        var domains = ApiReviewPresentation.Domains(scope, contracts, access.Availability);
    }

    @if (_report is null)
    {
        @*
            1. Decide: what am I reviewing, what scope, what access do I have, can it run — then run it.
            Nothing diagnostic here; every technical surface is one disclosure away under Review details.
        *@
        <section class="aqr-decide" data-testid="aqr-decide" aria-label="Review setup">
            <div class="aqr-decide-cards">

                <section class="aqr-card aqr-target-card" data-testid="aqr-environment" aria-labelledby="aqr-target-heading">
                    <div class="aqr-card-head">
                        <h2 id="aqr-target-heading">Target</h2>
                        <a class="aqr-link" href="@ApiReviewPresentation.TargetEnvironmentsHref" data-testid="aqr-change-target">Change target</a>
                    </div>
                    @if (_context is null)
                    {
                        <p class="aqr-muted">Loading the active Target Environment…</p>
                    }
                    else if (_context.ActiveTargetError is { Length: > 0 } activeError)
                    {
                        <p class="aqr-error-inline" role="alert" data-testid="aqr-active-target-error">@activeError</p>
                    }
                    else
                    {
                        var summary = ApiReviewPresentation.TargetSummary(_context, _capabilities, _targets);
                        @* Review status belongs to Readiness and access to API access; repeating either here said the
                           same thing in slightly different words. *@
                        <dl class="aqr-dl">
                            <div><dt>Environment</dt><dd><strong data-testid="aqr-env-name">@summary.Environment</strong> <span class="aqr-pill aqr-pill-muted">@summary.EnvironmentType</span></dd></div>
                            <div><dt>Frontend</dt><dd class="aqr-mono" data-testid="aqr-env-url">@summary.FrontendUrl</dd></div>
                            <div><dt>Authentication</dt><dd data-testid="aqr-env-auth">@summary.Authentication</dd></div>
                        </dl>
                        <ReviewDisclosure Text="View target details" CollapseText="Hide target details" TestId="aqr-target-details" Class="disclosure-inline">
                            <dl class="aqr-dl aqr-dl-technical">
                                @foreach (var field in summary.Technical)
                                {
                                    <div><dt>@field.Label</dt><dd>@field.Value</dd></div>
                                }
                            </dl>
                        </ReviewDisclosure>
                    }
                </section>

                <section class="aqr-card aqr-scope-card" data-testid="aqr-scope" aria-labelledby="aqr-scope-heading">
                    <div class="aqr-card-head"><h2 id="aqr-scope-heading">Review scope</h2></div>
                    <p class="aqr-scope-headline" data-testid="aqr-scope-headline">@scope.Headline</p>
                    @if (scope.Protocols is { Length: > 0 } protocols)
                    {
                        <p class="aqr-muted" data-testid="aqr-scope-protocols">@protocols</p>
                    }
                    @if (scope.AuthNote is { } authNote)
                    {
                        <p class="aqr-muted" data-testid="aqr-scope-auth">@authNote</p>
                    }
                </section>

                <section class="aqr-card aqr-access-card" data-testid="aqr-access" aria-labelledby="aqr-access-heading">
                    <div class="aqr-card-head"><h2 id="aqr-access-heading">API access</h2></div>
                    @* One vocabulary for the two access paths; the exact internal state stays in the details disclosure. *@
                    <ul class="aqr-access-rows">
                        <li class="aqr-access-row">
                            <span class="aqr-access-label">Public access</span>
                            <span class="aqr-pill aqr-pill-ready" data-testid="aqr-public-access"><span aria-hidden="true">✓</span> Available</span>
                        </li>
                        <li class="aqr-access-row">
                            <span class="aqr-access-label">Authenticated access</span>
                            <span class="aqr-pill aqr-pill-@ApiReviewAccessAvailabilities.Tone(access.Availability)" data-testid="aqr-access-mode" data-availability="@access.Availability">@ApiReviewAccessAvailabilities.Label(access.Availability)</span>
                        </li>
                    </ul>
                    @if (scope.AuthNote is not null)
                    {
                        <p class="aqr-access-summary" data-testid="aqr-access-text">@scope.AuthRequired selected @(scope.AuthRequired == 1 ? "target requires" : "targets require") authenticated access.</p>
                    }
                    @if (access.ActionText is not null)
                    {
                        <div class="aqr-card-actions">
                            <a class="btn-secondary" href="@access.ActionHref" data-testid="aqr-access-action">@access.ActionText</a>
                        </div>
                    }
                </section>

                <section class="aqr-card aqr-readiness aqr-readiness-@readiness.Level.ToString().ToLowerInvariant()" data-testid="aqr-readiness" data-readiness="@readiness.Level" aria-labelledby="aqr-readiness-heading" role="@(readiness.Level == ApiReviewReadinessLevel.Blocked ? "alert" : "status")">
                    <div class="aqr-card-head">
                        <h2 id="aqr-readiness-heading"><span class="aqr-readiness-icon" aria-hidden="true">@ReadinessIcon(readiness.Level)</span> @readiness.Title</h2>
                    </div>
                    <p class="aqr-readiness-message" data-testid="aqr-run-reason">@readiness.Message</p>
                    @if (readiness.Items.Count > 0 && readiness.Level != ApiReviewReadinessLevel.Blocked)
                    {
                        @* While the review can still run, the individual limitations are what the reader opens. *@
                        <ReviewDisclosure Text="View limitations" CollapseText="Hide limitations" TestId="aqr-readiness-limitations" Class="disclosure-inline disclosure-small">
                            <ul class="aqr-readiness-items" data-testid="aqr-readiness-items">
                                @foreach (var item in readiness.Items)
                                {
                                    <li class="aqr-readiness-item aqr-readiness-item-@item.State.ToString().ToLowerInvariant()"><span aria-hidden="true">@ApiReviewReadinessItemStates.Glyph(item.State)</span> @item.Label</li>
                                }
                            </ul>
                            @if (readiness.ActionText is not null && readiness.ActionHref is not null)
                            {
                                <a class="aqr-link" data-testid="aqr-run-action" href="@readiness.ActionHref">@readiness.ActionText</a>
                            }
                        </ReviewDisclosure>
                    }
                    @if (readiness.Level == ApiReviewReadinessLevel.Blocked)
                    {
                        @* While it is blocked they stay visible: they are why the reader cannot proceed. *@
                        @if (readiness.Items.Count > 0)
                        {
                            <ul class="aqr-readiness-items" data-testid="aqr-readiness-items">
                                @foreach (var item in readiness.Items)
                                {
                                    <li class="aqr-readiness-item aqr-readiness-item-@item.State.ToString().ToLowerInvariant()"><span aria-hidden="true">@ApiReviewReadinessItemStates.Glyph(item.State)</span> @item.Label</li>
                                }
                            </ul>
                        }
                        @if (readiness.ActionText is not null && readiness.ActionHref is not null)
                        {
                            <a class="aqr-link" data-testid="aqr-run-action" href="@readiness.ActionHref">@readiness.ActionText</a>
                        }
                    }
                </section>
            </div>

            <div class="aqr-run-row" data-testid="aqr-run-row">
                <PrimaryButton OnClick="RunReview" Disabled="@(!Eligibility.Enabled || _running)" aria-label="Run API Quality Review" data-testid="aqr-run">
                    @if (_running) { <span class="aqr-spinner" aria-hidden="true">⟳</span> }
                    @(_running ? "Reviewing…" : "Run API Quality Review")
                </PrimaryButton>
                @if (_running)
                {
                    <p class="aqr-progress" role="status" aria-live="polite">@_progressMessage</p>
                }
            </div>
            @if (_errorMessage is not null)
            {
                <div class="aqr-error" role="alert" data-testid="aqr-error">@_errorMessage</div>
            }
        </section>

        @* 2. Scope: what the review covers, in review words rather than access or configuration words. *@
        <section class="aqr-section aqr-domains" data-testid="aqr-domains" aria-labelledby="aqr-domains-heading">
            <h2 id="aqr-domains-heading">What will be reviewed</h2>
            <ul class="aqr-domain-grid">
                @foreach (var domain in domains)
                {
                    <li>
                        <article class="aqr-card aqr-domain" data-testid="aqr-domain" data-domain="@domain.Key" data-state="@domain.State">
                            <div class="aqr-domain-head">
                                <h3>@domain.Title</h3>
                                <span class="aqr-pill aqr-pill-@ApiReviewDomainStates.Tone(domain.State)" data-testid="aqr-domain-state">@ApiReviewDomainStates.Label(domain.State)</span>
                            </div>
                            <p class="aqr-domain-purpose">@domain.Purpose</p>
                            @if (domain.Limitation is { Length: > 0 } limitation)
                            {
                                <p class="aqr-domain-limitation" data-testid="aqr-domain-limitation">@limitation</p>
                            }
                        </article>
                    </li>
                }
            </ul>
        </section>

        @* 3. Review details: the configuration behind the decision, collapsed. Nothing here changes the scope above. *@
        <section class="aqr-section aqr-details" data-testid="aqr-details" aria-labelledby="aqr-details-heading">
            <div class="aqr-card-head"><h2 id="aqr-details-heading">Review details</h2></div>

            <ReviewDisclosure Text="API targets" CollapseText="Hide API targets" Hint="@ScopeHint(scope)" TestId="aqr-targets-disclosure" Class="aqr-detail-disclosure">
                <ApiReviewTargetPicker Targets="_targets" Selected="_selected" Toggle="OnToggleTarget" />
            </ReviewDisclosure>

            <ReviewDisclosure Text="Contracts" CollapseText="Hide contracts" Hint="@ContractHint(contracts)" TestId="aqr-contracts-disclosure" Class="aqr-detail-disclosure">
                <ApiReviewContractPanel Contracts="contracts" />
            </ReviewDisclosure>

            <ReviewDisclosure Text="Authentication details" CollapseText="Hide authentication details" Hint="@ApiReviewAccessAvailabilities.Label(access.Availability)" TestId="aqr-access-details" Class="aqr-detail-disclosure">
                <ApiReviewAccessDetails Access="access" />
            </ReviewDisclosure>

            <ReviewDisclosure Text="Read-only review" CollapseText="Hide read-only review" Hint="Safe requests only" TestId="aqr-readonly-disclosure" Class="aqr-detail-disclosure">
                <p data-testid="aqr-readonly-summary">@ApiReviewPresentation.ReadOnlySummary</p>
            </ReviewDisclosure>
        </section>
    }

    @* ── Results (only once a review exists) ── *@
    @if (_report is { } report)
    {
        var result = ApiReviewPresentation.Result(report);
        var summary = result.Metadata;
        <section class="aqr-results" data-testid="aqr-results" aria-labelledby="aqr-result-heading">

            @* ── 1. The result itself: what ran, how it ended, and how to run it again. ────────────────────── *@
            <section class="aqr-card aqr-result-summary" data-testid="aqr-result-summary" aria-labelledby="aqr-result-heading">
                <div class="aqr-result-head">
                    <div>
                        <h2 id="aqr-result-heading">Review result</h2>
                        <p class="aqr-result-state" data-testid="aqr-result-state"><span class="aqr-pill aqr-pill-@ApiReviewResultStates.Tone(result.State)">@result.StateLabel</span></p>
                        <p class="aqr-result-summary-text" data-testid="aqr-result-summary-text">@result.Summary</p>
                    </div>
                    <PrimaryButton OnClick="RunReview" Disabled="@(!Eligibility.Enabled || _running)" data-testid="aqr-run">
                        @(_running ? "Reviewing…" : "Run API Quality Review again")
                    </PrimaryButton>
                </div>
                <dl class="aqr-dl aqr-result-meta" data-testid="aqr-result-meta">
                    <div><dt>Target</dt><dd><strong data-testid="aqr-result-env">@summary.Environment</strong> <span class="aqr-pill aqr-pill-muted">@summary.EnvironmentType</span></dd></div>
                    <div><dt>Completed</dt><dd data-testid="aqr-result-generated">@summary.GeneratedAt</dd></div>
                    <div><dt>Services reviewed</dt><dd data-testid="aqr-result-services">REST @summary.RestServices · GraphQL @summary.GraphQlServices@if (summary.TargetsBlocked > 0) { <span class="aqr-muted"> · @summary.TargetsBlocked not executed</span> }</dd></div>
                    <div><dt>Operations reviewed</dt><dd data-testid="aqr-result-operations">@summary.OperationsReviewed <span class="aqr-muted">read-only requests executed</span></dd></div>
                    <div><dt>Access used</dt><dd><span data-testid="aqr-result-access">@summary.AccessUsed</span> <span class="aqr-muted">@summary.AccessUsedDetail</span></dd></div>
                </dl>
                @if (_running)
                {
                    <p class="aqr-progress" role="status" aria-live="polite">@_progressMessage</p>
                }
                @if (_errorMessage is not null)
                {
                    <div class="aqr-error" role="alert" data-testid="aqr-error">@_errorMessage</div>
                }
            </section>

            @* ── 2. What was found. Findings are defects; manual-review obligations are counted separately. ── *@
            <section class="aqr-card aqr-key-findings-card" data-testid="aqr-key-findings" aria-labelledby="aqr-key-findings-heading">
                <div class="aqr-card-head">
                    <h2 id="aqr-key-findings-heading">Key findings</h2>
                    <button type="button" class="aqr-link aqr-link-button" data-testid="aqr-all-findings" @onclick='() => _tab = "Findings"'>All findings (@result.FindingCount)</button>
                </div>
                <ul class="aqr-sev-strip" aria-label="Findings by severity" data-testid="aqr-finding-counts">
                    @foreach (var sev in summary.Severities)
                    {
                        <li class="aqr-sev aqr-sev-@sev.Severity.ToString().ToLowerInvariant() @(sev.Count == 0 ? "aqr-sev-zero" : "")" data-testid="aqr-sev" data-severity="@sev.Severity"><span class="aqr-sev-label">@sev.Severity</span> <span class="aqr-sev-count">@sev.Count</span></li>
                    }
                </ul>
                @if (report.Findings.Count == 0)
                {
                    <p class="aqr-empty" data-testid="aqr-no-key-findings">No findings on the assessed targets. Targets that were blocked or not assessed are listed as such, never as passes.</p>
                }
                else
                {
                    <ul class="aqr-key-findings">
                        @foreach (var f in ApiReviewPresentation.KeyFindings(report))
                        {
                            <li><span class="aqr-sev aqr-sev-@f.Severity.ToString().ToLowerInvariant()"><span class="aqr-sev-label">@f.Severity</span></span> <span class="aqr-key-finding-title">@f.Title</span> <span class="aqr-muted">@ApiReviewPresentation.ServiceNameOf(report, f.TargetId) · @f.Endpoint</span></li>
                        }
                    </ul>
                }
            </section>

            <div class="aqr-tabs" role="tablist" aria-label="Review result areas">
                @foreach (var tab in Tabs)
                {
                    <button type="button" class="aqr-tab @(_tab == tab ? "aqr-tab-active" : "")" role="tab" id="aqr-tab-btn-@tab.ToLowerInvariant()" aria-selected="@(_tab == tab ? "true" : "false")" aria-controls="aqr-tabpanel" tabindex="@(_tab == tab ? "0" : "-1")" data-testid="aqr-tab-@tab.ToLowerInvariant()" @onclick="() => _tab = tab" @onkeydown="e => OnTabKey(e, tab)">@tab</button>
                }
            </div>

            <div id="aqr-tabpanel" role="tabpanel" aria-labelledby="aqr-tab-btn-@_tab.ToLowerInvariant()" class="aqr-tabpanel" data-testid="aqr-tabpanel" data-tab="@_tab">
            @if (_tab == "Overview")
            {
                <div class="aqr-tablewrap">
                    <table class="aqr-table aqr-services" data-testid="aqr-services-table">
                        <thead><tr><th scope="col">Service</th><th scope="col">Type</th><th scope="col">Access</th><th scope="col">Review status</th><th scope="col">Contract</th><th scope="col">Findings</th></tr></thead>
                        <tbody>
                            @foreach (var t in report.Targets)
                            {
                                var status = ApiReviewStatusLabels.Of(t);
                                var expanded = _expandedServices.Contains(t.Target.TargetId);
                                var detailId = $"aqr-service-details-{t.Target.TargetId}";
                                <tr data-testid="aqr-service-row" data-target-id="@t.Target.TargetId">
                                    <td>
                                        <button type="button" class="aqr-row-toggle" aria-expanded="@(expanded ? "true" : "false")" aria-controls="@detailId" data-testid="aqr-service-toggle" @onclick="() => ToggleService(t.Target.TargetId)">
                                            <span aria-hidden="true">@(expanded ? "▾" : "▸")</span> <strong>@ApiReviewPresentation.DisplayName(t.Target)</strong>
                                        </button>
                                    </td>
                                    <td>@(t.Target.ApiType == ApiReviewTargetType.Rest ? "REST" : "GraphQL")</td>
                                    <td data-testid="aqr-service-access">@ApiReviewStatusLabels.AccessLabel(t.AccessMode)</td>
                                    <td><span class="aqr-pill aqr-pill-@ApiReviewStatusLabels.Tone(status)" data-testid="aqr-service-status" data-status="@status">@ApiReviewStatusLabels.Label(status)</span></td>
                                    <td data-testid="aqr-service-contract">@ApiReviewStatusLabels.ContractLabel(t.Contract)</td>
                                    <td data-testid="aqr-service-findings">@(t.FindingCount is null ? "Not tested" : t.FindingCount.Value.ToString())</td>
                                </tr>
                                <tr id="@detailId" class="aqr-service-details" hidden="@(!expanded)" data-testid="aqr-service-details" data-target-id="@t.Target.TargetId">
                                    <td colspan="6">
                                        <dl class="aqr-dl aqr-dl-technical">
                                            <div><dt>Endpoint</dt><dd class="aqr-mono">@t.Target.Url</dd></div>
                                            <div><dt>Source</dt><dd>@ApiReviewPresentation.SourceLabel(t.Target.Source) · @ApiReviewPresentation.ConfidenceLabel(t.Target.Confidence)</dd></div>
                                            <div><dt>Access</dt><dd>@t.AccessReason</dd></div>
                                            @if (t.RequiredAction is not null) { <div><dt>Next step</dt><dd>@t.RequiredAction</dd></div> }
                                            @if (t.Contract is { } contract) { <div><dt>@contract.Kind</dt><dd>@ApiReviewStatusLabels.ResultLabel(contract.Status)@(contract.Note is { Length: > 0 } ? $" — {contract.Note}" : "")</dd></div> }
                                            <div><dt>Operations</dt><dd>@t.Operations.Count(o => o.Executed) of @t.Operations.Count executed (read-only)</dd></div>
                                        </dl>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @* Obligations, not defects: they are never added to the finding counts above. *@
                <section class="aqr-card aqr-manual" data-testid="aqr-manual-review" aria-labelledby="aqr-manual-heading">
                    <div class="aqr-card-head"><h3 id="aqr-manual-heading">Manual review still required</h3></div>
                    <p class="aqr-muted" data-testid="aqr-manual-count">@report.ManualReviewItems.Count @(report.ManualReviewItems.Count == 1 ? "area remains" : "areas remain") outside the automated, read-only review. These are review obligations, not findings.</p>
                    <ul class="aqr-list">@foreach (var m in report.ManualReviewItems) { <li>@m</li> }</ul>
                </section>
            }
            else if (_tab is "REST" or "GraphQL")
            {
                var type = _tab == "REST" ? ApiReviewTargetType.Rest : ApiReviewTargetType.GraphQl;
                var targets = report.Targets.Where(t => t.Target.ApiType == type).ToList();
                @if (targets.Count == 0) { <p class="aqr-empty">No @_tab targets in this review.</p> }
                @foreach (var t in targets)
                {
                    var status = ApiReviewStatusLabels.Of(t);
                    <div class="aqr-card aqr-target-result" data-testid="aqr-target-result" data-target-id="@t.Target.TargetId">
                        <div class="aqr-card-head">
                            <h3>@ApiReviewPresentation.DisplayName(t.Target) <span class="aqr-mono aqr-muted aqr-target-result-url">@t.Target.Url</span></h3>
                            <span class="aqr-pill aqr-pill-@ApiReviewStatusLabels.Tone(status)">@ApiReviewStatusLabels.Label(status)</span>
                        </div>
                        <p class="aqr-muted"><strong>Access:</strong> @ApiReviewStatusLabels.AccessLabel(t.AccessMode) — @t.AccessReason @if (t.RequiredAction is not null) { <strong>Next step:</strong> @t.RequiredAction }</p>
                        @if (t.Contract is { } contract)
                        {
                            <p><strong>@contract.Kind:</strong> <span class="aqr-state aqr-state-@contract.Status.ToString().ToLowerInvariant()">@ApiReviewStatusLabels.ResultLabel(contract.Status)</span> @contract.Note @(contract.Hash is null ? "" : $"· hash {contract.Hash}")</p>
                        }
                        @if (t.Operations.Count > 0)
                        {
                            <div class="aqr-tablewrap">
                                <table class="aqr-table">
                                    <thead><tr><th scope="col">Operation</th><th scope="col">Executed</th><th scope="col">Status</th><th scope="col">Content type</th><th scope="col">Response time</th><th scope="col">Bytes</th><th scope="col">Result</th><th scope="col">Contract</th><th scope="col">Note</th></tr></thead>
                                    <tbody>
                                        @foreach (var o in t.Operations)
                                        {
                                            <tr data-testid="aqr-operation-row">
                                                <td class="aqr-mono">@o.Display</td>
                                                <td>@(o.Executed ? $"Yes · {ApiReviewStatusLabels.AccessLabel(o.AccessMode)}" : "No")</td>
                                                <td>@(o.Executed ? o.StatusCode.ToString() : "—")</td>
                                                <td>@(o.ContentType ?? "—")</td>
                                                <td>@(o.ElapsedMs is { } ms ? $"{ms:0} ms" : "—")</td>
                                                <td>@(o.ContentLength?.ToString() ?? "—")</td>
                                                <td><span class="aqr-state aqr-state-@o.Result.ToString().ToLowerInvariant()">@ApiReviewStatusLabels.ResultLabel(o.Result)</span></td>
                                                <td>@(o.ContractMatched is null ? "—" : o.ContractMatched.Value ? "Matched" : "Not documented")</td>
                                                <td class="aqr-muted">@o.Note</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        @RenderChecks(t.Checks.Concat(t.Operations.SelectMany(o => o.Checks.Select(c => c with { Title = $"{o.Display}: {c.Title}" }))).ToList(), null)
                        @RenderFindings(report, report.Findings.Where(f => f.TargetId == t.Target.TargetId).ToList(), null)
                    </div>
                }
            }
            else if (_tab == "Findings")
            {
                @RenderFindings(report, report.Findings, null)
            }
            else
            {
                var areas = _tab switch
                {
                    "Contracts" => new[] { ApiReviewFindingType.Contract, ApiReviewFindingType.Documentation, ApiReviewFindingType.Drift },
                    "Security" => new[] { ApiReviewFindingType.Security, ApiReviewFindingType.AccessControl },
                    "Errors" => new[] { ApiReviewFindingType.Errors },
                    _ => new[] { ApiReviewFindingType.Performance },
                };
                @if (_tab == "Security") { <p class="aqr-scope-note" data-testid="aqr-security-note">@ApiReviewPresentation.SecurityScopeNote</p> }
                @if (_tab == "Performance") { <p class="aqr-scope-note" data-testid="aqr-performance-note">@ApiReviewPresentation.PerformanceScopeNote</p> }
                @if (_tab == "Contracts")
                {
                    <div class="aqr-tablewrap">
                        <table class="aqr-table" data-testid="aqr-contracts-table">
                            <thead><tr><th scope="col">Service</th><th scope="col">Contract</th><th scope="col">Status</th><th scope="col">Version</th><th scope="col">Operations / types</th><th scope="col">Mutations</th><th scope="col">Deprecated</th><th scope="col">Introspection</th><th scope="col">Hash</th><th scope="col">Note</th></tr></thead>
                            <tbody>
                                @foreach (var t in report.Targets.Where(t => t.Contract is not null))
                                {
                                    var c = t.Contract!;
                                    <tr><td>@ApiReviewPresentation.DisplayName(t.Target)</td><td>@c.Kind</td><td><span class="aqr-state aqr-state-@c.Status.ToString().ToLowerInvariant()">@ApiReviewStatusLabels.ResultLabel(c.Status)</span></td><td>@(c.Version ?? "—")</td><td>@c.OperationCount / @c.TypeCount</td><td>@c.MutationCount</td><td>@c.DeprecatedCount</td><td>@(c.IntrospectionEnabled is null ? "—" : c.IntrospectionEnabled.Value ? "Enabled" : "Disabled")</td><td class="aqr-mono">@(c.Hash ?? "—")</td><td class="aqr-muted">@c.Note</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @foreach (var t in report.Targets.Where(t => t.GraphQlOperationMatches.Count > 0))
                    {
                        <h4 class="aqr-group-title">@ApiReviewPresentation.DisplayName(t.Target) · observed operations</h4>
                        <div class="aqr-tablewrap">
                            <table class="aqr-table" data-testid="aqr-gql-operations">
                                <thead><tr><th scope="col">Observed operation</th><th scope="col">Root field</th><th scope="col">Result</th><th scope="col">Note</th></tr></thead>
                                <tbody>@foreach (var m in t.GraphQlOperationMatches) { <tr><td class="aqr-mono">@m.Operation</td><td class="aqr-mono">@(m.MatchedRootField ?? "—")</td><td><span class="aqr-state aqr-state-@m.Result.ToString().ToLowerInvariant()">@ApiReviewStatusLabels.ResultLabel(m.Result)</span></td><td class="aqr-muted">@m.Note</td></tr> }</tbody>
                            </table>
                        </div>
                    }
                }
                @RenderChecks(report.Targets.SelectMany(t => t.Checks.Concat(t.Operations.SelectMany(o => o.Checks)).Where(c => areas.Contains(c.Area)).Select(c => c with { Title = $"{ApiReviewPresentation.DisplayName(t.Target)}: {c.Title}" })).ToList(), areas)
                @RenderFindings(report, report.Findings.Where(f => areas.Contains(f.Type)).ToList(), areas)
            }
            </div>

            @*
                ── 3. Review details: how this review was executed and what it could reach. Supporting evidence for
                interpreting the result above, never a competitor to it.
            *@
            <section class="aqr-section aqr-details" data-testid="aqr-result-details" aria-labelledby="aqr-result-details-heading">
                <div class="aqr-card-head"><h2 id="aqr-result-details-heading">Review details</h2></div>

                <ReviewDisclosure Text="Coverage" CollapseText="Hide coverage" Hint="@CoverageHint(summary)" TestId="aqr-coverage-disclosure" Class="aqr-detail-disclosure">
                    <dl class="aqr-coverage-list" data-testid="aqr-coverage">
                        @foreach (var row in summary.Coverage)
                        {
                            <div class="aqr-coverage-row" data-testid="aqr-coverage-row" data-coverage="@row.Label">
                                <dt>@row.Label</dt>
                                <dd><span>@row.Value</span>@if (row.Detail is not null) { <span class="aqr-muted aqr-coverage-detail">@row.Detail</span> }</dd>
                            </div>
                        }
                    </dl>
                </ReviewDisclosure>

                <ReviewDisclosure Text="Review limitations" CollapseText="Hide review limitations" Hint="@($"{ApiReviewPresentation.LimitationSummary.Count} areas not automatically assessed")" TestId="aqr-limitations" Class="aqr-detail-disclosure">
                    <p class="aqr-muted">This review is intentionally read-only. Not automatically assessed:</p>
                    <ul class="aqr-list">@foreach (var l in ApiReviewPresentation.LimitationSummary) { <li>@l</li> }</ul>
                    <ReviewDisclosure Text="View technical limitations" CollapseText="Hide technical limitations" TestId="aqr-limitations-technical" Class="disclosure-inline disclosure-small">
                        <ul class="aqr-list aqr-muted" data-testid="aqr-limitations-list">@foreach (var l in report.Limitations) { <li>@l</li> }</ul>
                    </ReviewDisclosure>
                </ReviewDisclosure>

                <ReviewDisclosure Text="@ApiReviewPresentation.ReadOnlyTitle" CollapseText="Hide read-only review" Hint="No write operations executed" TestId="aqr-readonly" Class="aqr-detail-disclosure">
                    <p data-testid="aqr-readonly-summary">@ApiReviewPresentation.ReadOnlySummary</p>
                    @if (report.Coverage.UnsafeOperationsNotExecuted > 0)
                    {
                        <p class="aqr-muted" data-testid="aqr-unsafe-count">@report.Coverage.UnsafeOperationsNotExecuted write @(report.Coverage.UnsafeOperationsNotExecuted == 1 ? "operation was" : "operations were") observed and not executed. Not executing them says nothing about whether they are safe.</p>
                    }
                </ReviewDisclosure>

                <ReviewDisclosure Text="API targets" CollapseText="Hide API targets" Hint="@ScopeHint(scope)" TestId="aqr-targets-disclosure" Class="aqr-detail-disclosure">
                    <ApiReviewTargetPicker Targets="_targets" Selected="_selected" Toggle="OnToggleTarget" />
                </ReviewDisclosure>

                <ReviewDisclosure Text="Contracts" CollapseText="Hide contracts" Hint="@ContractHint(contracts)" TestId="aqr-contracts-disclosure" Class="aqr-detail-disclosure">
                    <ApiReviewContractPanel Contracts="contracts" />
                </ReviewDisclosure>

                <ReviewDisclosure Text="Authentication details" CollapseText="Hide authentication details" Hint="@ApiReviewAccessAvailabilities.Label(access.Availability)" TestId="aqr-access-details" Class="aqr-detail-disclosure">
                    <ApiReviewAccessDetails Access="access" />
                </ReviewDisclosure>
            </section>
        </section>
    }
</div>

@code {
    private static readonly string[] Tabs = ["Overview", "REST", "GraphQL", "Contracts", "Security", "Errors", "Performance", "Findings"];

    private FrontendAnalysisContext? _context;
    private AuthenticatedReviewCapabilities? _capabilities;
    private List<ApiReviewTarget> _targets = [];
    private readonly HashSet<string> _selected = new(StringComparer.Ordinal);
    private readonly HashSet<string> _expandedServices = new(StringComparer.Ordinal);
    private readonly HashSet<string> _expandedFindings = new(StringComparer.Ordinal);
    private ApiReviewHistory? _history;
    private ApiReviewReport? _report;
    private bool _running;
    private string _progressMessage = "";
    private string? _errorMessage;
    private string _tab = "Overview";
    private string? _requestedTargetId;

    private ApiReviewRunEligibility Eligibility => ApiReviewRunEligibility.Evaluate(_context, _targets, _selected, _capabilities);

    protected override async Task OnInitializedAsync()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (query.TryGetValue("target", out var requested)) _requestedTargetId = requested.ToString();
        _report = RuntimeReviews.ApiQualityReview.Report;
        await History.LoadAsync(JS);
        await Discovery.LoadAsync(JS);
        await RefreshContextAsync();
    }

    private async Task RefreshContextAsync()
    {
        _context = await ContextFactory.GetActiveContextAsync();
        if (_context.ActiveTargetError is not null) { _targets = []; _selected.Clear(); _capabilities = null; return; }
        _history = History.For(_context.ActiveProfile.Id);
        _report ??= _history.LastReport is { } last && last.Environment.EnvironmentId == _context.ActiveProfile.Id ? last : null;
        _targets = ApiReviewTargetResolver.Resolve(_context, Discovery.GetSnapshot(_context.ActiveProfile.Id));
        _selected.Clear();
        foreach (var t in _targets.Where(t => t.Selected)) _selected.Add(t.TargetId);
        if (_requestedTargetId is not null && _targets.Any(t => t.TargetId == _requestedTargetId)) _selected.Add(_requestedTargetId);
        _capabilities = null;
        var identity = _context.ReviewIdentity ?? ReviewAuthenticationIdentity.ForContext(_context);
        try { _capabilities = await Capabilities.ResolveAsync(identity); }
        catch { _capabilities = new AuthenticatedReviewCapabilities { Method = identity.Method, PublicApi = true, Reason = "Authenticated capabilities could not be resolved; public targets only." }; }
    }

    private void ToggleTarget(string id, bool selected) { if (selected) _selected.Add(id); else _selected.Remove(id); }

    private void OnToggleTarget((string TargetId, bool Include) change) => ToggleTarget(change.TargetId, change.Include);

    /// <summary>"4 selected · 3 REST · 1 GraphQL" — every part counted from the selected targets, never a literal.</summary>
    private static string ScopeHint(ApiReviewScopeSummary scope) => scope.Selected == 0
        ? "None selected"
        : string.Join(" · ", new[] { $"{scope.Selected} selected", scope.Protocols }.Where(p => !string.IsNullOrEmpty(p)));

    /// <summary>The coverage facts that matter at a glance, read from the report's own coverage rows.</summary>
    private static string CoverageHint(ApiReviewSummaryModel summary) =>
        summary.Coverage.Count == 0 ? "No coverage recorded" : string.Join(" · ", summary.Coverage.Take(2).Select(r => $"{r.Label}: {r.Value}"));

    /// <summary>The two contract states plus the baseline count, in the order the expanded rows repeat them.</summary>
    private static string ContractHint(ApiReviewContractPanelModel contracts) => string.Join(" · ",
        contracts.Rows.Where(r => r.State != ApiReviewContractState.NotApplicable)
            .Select(r => $"{r.Label}: {ApiReviewContractStates.Label(r.State)}")
            .Append(contracts.HistoryLabel));
    private void ToggleService(string id) { if (!_expandedServices.Remove(id)) _expandedServices.Add(id); }
    private void ToggleFinding(string id) { if (!_expandedFindings.Remove(id)) _expandedFindings.Add(id); }

    /// <summary>Arrow-key navigation between tabs (WAI-ARIA tabs pattern, manual activation on Enter/Space is the button default).</summary>
    private void OnTabKey(KeyboardEventArgs e, string current)
    {
        var index = Array.IndexOf(Tabs, current);
        if (e.Key == "ArrowRight") _tab = Tabs[(index + 1) % Tabs.Length];
        else if (e.Key == "ArrowLeft") _tab = Tabs[(index - 1 + Tabs.Length) % Tabs.Length];
        else if (e.Key == "Home") _tab = Tabs[0];
        else if (e.Key == "End") _tab = Tabs[^1];
    }

    /// <summary>Creates the immutable review snapshot from the active environment at Run; settings edited while the review runs never affect it.</summary>
    private async Task RunReview()
    {
        if (_running || _context is null || !Eligibility.Enabled) return;
        _running = true; _errorMessage = null; _progressMessage = "Reviewing selected API targets (read-only)…";
        var context = _context;
        var identity = context.ReviewIdentity ?? ReviewAuthenticationIdentity.ForContext(context);
        var request = BuildRequest(context, identity, _targets, _selected, _history);
        RuntimeReviews.MarkApiQualityRunning(context);
        StateHasChanged();
        try
        {
            var (report, error) = await ReviewService.RunAsync(request);
            if (error is not null || report is null)
            {
                _errorMessage = error ?? "The review returned no result.";
                RuntimeReviews.MarkApiQualityFailed(context, _errorMessage);
            }
            else
            {
                _report = report;
                _tab = "Overview";
                _expandedServices.Clear();
                _expandedFindings.Clear();
                RuntimeReviews.SaveApiQualityResult(report, context);
                await History.RecordAsync(JS, context.ActiveProfile.Id, report);
                _history = History.For(context.ActiveProfile.Id);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Review failed: " + ex.GetType().Name;
            RuntimeReviews.MarkApiQualityFailed(context, _errorMessage);
        }
        finally { _running = false; }
    }

    public static ApiReviewRunRequest BuildRequest(FrontendAnalysisContext context, AuthenticatedReviewIdentity identity, IReadOnlyList<ApiReviewTarget> targets, IReadOnlyCollection<string> selected, ApiReviewHistory? history)
    {
        var production = context.ActiveProfile.EnvironmentType == FrontendEnvironmentType.Production;
        var selectedTargets = targets.Select(t => t with { Selected = selected.Contains(t.TargetId) }).Where(t => t.Selected).ToList();
        return new ApiReviewRunRequest
        {
            Environment = new ApiReviewEnvironmentSnapshot
            {
                EnvironmentId = context.ActiveProfile.Id, Name = context.ActiveProfile.Name, EnvironmentType = context.ActiveProfile.EnvironmentType.ToString(), TargetUrl = context.TargetUrl,
                AuthenticatedTestingMethod = identity.Method, RequiresAuthentication = context.RequiresAuthentication, ContextIdentityDigest = identity.ContextFingerprint, IsProduction = production, CapturedAt = DateTimeOffset.UtcNow,
            },
            Identity = identity, Targets = selectedTargets,
            Policy = new ApiReviewPolicy
            {
                ReadOnly = true, ErrorHandlingProbes = !production, SlowWarningMs = context.PerformanceThresholds.ApiResponseWarningMs, SlowPoorMs = context.PerformanceThresholds.ApiResponsePoorMs,
                LargePayloadBytes = Math.Max(context.PerformanceThresholds.MaxRestPayloadBytes, context.PerformanceThresholds.MaxGraphQlPayloadBytes), IntrospectionExpectedDisabled = production,
            },
            Baselines = history is null ? [] : selectedTargets.Where(t => history.Baselines.ContainsKey(t.TargetId)).Select(t => history.Baselines[t.TargetId]).ToList(),
            FrontendOrigin = Uri.TryCreate(context.TargetUrl, UriKind.Absolute, out var origin) ? origin.GetLeftPart(UriPartial.Authority) : null,
        };
    }

    private async Task ExportHtml()
    {
        if (_report is null) return;
        var html = ExportService.ExportApiReview(_report, Workspace.ProjectName);
        await JS.InvokeVoidAsync("downloadHtmlFile", $"api-quality-review-{DateTime.UtcNow:yyyy-MM-dd}.html", html);
    }

    private static string ReadinessTone(ApiReviewReadinessLevel level) => level switch
    {
        ApiReviewReadinessLevel.Ready => "ready",
        ApiReviewReadinessLevel.Limited => "warning",
        ApiReviewReadinessLevel.Blocked => "attention",
        _ => "muted",
    };

    private static string ReadinessIcon(ApiReviewReadinessLevel level) => level switch
    {
        ApiReviewReadinessLevel.Ready => "✓",
        ApiReviewReadinessLevel.Limited => "⚠",
        ApiReviewReadinessLevel.Blocked => "✕",
        _ => "…",
    };

    private RenderFragment RenderChecks(IReadOnlyList<ApiReviewCheck> checks, ApiReviewFindingType[]? areas) => __builder =>
    {
        if (checks.Count == 0) return;
        <details class="aqr-checks" open="@(areas is not null)">
            <summary>Checks (@checks.Count) · @string.Join(" · ", checks.GroupBy(c => c.Result).OrderBy(g => g.Key).Select(g => $"{ApiReviewStatusLabels.ResultLabel(g.Key)} {g.Count()}"))</summary>
            <div class="aqr-tablewrap">
                <table class="aqr-table aqr-checks-table" data-testid="aqr-checks-table">
                    <thead><tr><th scope="col">Area</th><th scope="col">Check</th><th scope="col">Result</th><th scope="col">Detail</th><th scope="col">Evidence</th></tr></thead>
                    <tbody>
                        @foreach (var c in checks)
                        {
                            <tr data-testid="aqr-check-row" data-check-id="@c.CheckId" data-result="@c.Result"><td>@c.Area</td><td>@c.Title</td><td><span class="aqr-state aqr-state-@c.Result.ToString().ToLowerInvariant()">@ApiReviewStatusLabels.ResultLabel(c.Result)</span></td><td>@c.Detail</td><td class="aqr-mono aqr-muted">@string.Join(" · ", c.Evidence.Take(5))</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </details>
    };

    private RenderFragment RenderFindings(ApiReviewReport report, IReadOnlyList<ApiReviewFinding> findings, ApiReviewFindingType[]? areas) => __builder =>
    {
        <h4 class="aqr-group-title">Findings (@findings.Count)</h4>
        @if (findings.Count == 0)
        {
            <p class="aqr-empty" data-testid="aqr-no-findings">No findings@(areas is null ? "" : " in this area") on the assessed targets. Blocked or not-assessed targets are listed as such, never as passes.</p>
        }
        else
        {
            <div class="aqr-tablewrap">
                <table class="aqr-table aqr-findings-table" data-testid="aqr-findings-table">
                    <thead><tr><th scope="col">Severity</th><th scope="col">Service</th><th scope="col">Type</th><th scope="col">Endpoint / operation</th><th scope="col">Finding</th><th scope="col"><span class="aqr-visually-hidden">Details</span></th></tr></thead>
                    <tbody>
                        @foreach (var f in findings)
                        {
                            var expanded = _expandedFindings.Contains(f.Id);
                            var detailId = $"aqr-finding-details-{f.Id}";
                            <tr data-testid="aqr-finding-row" data-finding-id="@f.Id" data-severity="@f.Severity">
                                <td><span class="aqr-sev aqr-sev-@f.Severity.ToString().ToLowerInvariant()"><span class="aqr-sev-label">@f.Severity</span></span></td>
                                <td>@ApiReviewPresentation.ServiceNameOf(report, f.TargetId)</td>
                                <td>@f.Type@(f.Drift is { } d ? $" · {ApiReviewStatusLabels.DriftLabel(d)}" : "")</td>
                                <td class="aqr-mono">@f.Endpoint</td>
                                <td><strong>@f.Title</strong></td>
                                <td><button type="button" class="aqr-row-toggle" aria-expanded="@(expanded ? "true" : "false")" aria-controls="@detailId" data-testid="aqr-finding-toggle" @onclick="() => ToggleFinding(f.Id)">@(expanded ? "Hide details" : "Details")</button></td>
                            </tr>
                            <tr id="@detailId" class="aqr-finding-details" hidden="@(!expanded)" data-testid="aqr-finding-details">
                                <td colspan="6">
                                    <dl class="aqr-dl aqr-dl-technical">
                                        <div><dt>Description</dt><dd>@f.Description</dd></div>
                                        <div><dt>Check</dt><dd>@f.Check · <span class="aqr-state aqr-state-@f.Result.ToString().ToLowerInvariant()">@ApiReviewStatusLabels.ResultLabel(f.Result)</span></dd></div>
                                        @if (f.Evidence.Count > 0) { <div><dt>Evidence</dt><dd class="aqr-mono aqr-evidence">@string.Join(" · ", f.Evidence.Take(8))</dd></div> }
                                        <div><dt>Recommendation</dt><dd>@f.Recommendation</dd></div>
                                        @if (f.Result == ApiReviewCheckResult.ManualReview) { <div><dt>Manual verification</dt><dd>Required — this item was not verified automatically.</dd></div> }
                                        @if (f.Drift is { } drift) { <div><dt>Contract drift</dt><dd>@ApiReviewStatusLabels.DriftLabel(drift)</dd></div> }
                                    </dl>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    };
}
