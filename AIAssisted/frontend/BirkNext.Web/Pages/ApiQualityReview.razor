                <thead><tr><th scope="col">Operation</th><th scope="col">Execution</th><th scope="col">Status</th><th scope="col">Response time</th><th scope="col">Review result</th><th scope="col"><span class="aqr-visually-hidden">Details</span></th></tr></thead>
                <tbody>
                    @for (var i = 0; i < rows.Count; i++)
                    {
                        var o = rows[i];
                        var key = $"{t.Target.TargetId}#{i}";
                        var expanded = _expandedOperations.Contains(key);
