@page "/api-quality-review"
@using BirkNext.ApiReview
@using BirkNext.LocalHttpsProxy
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using BirkNext.Web.Components
@using Microsoft.AspNetCore.WebUtilities
@implements IDisposable
@inject IApiReviewService ReviewService
@inject IFrontendAnalysisContextFactory ContextFactory
@inject IEndpointDiscoveryService Discovery
@inject IApiReviewHistoryService History
@inject IAuthenticatedReviewCapabilitiesService Capabilities
@inject RuntimeReviewSessionService RuntimeReviews
@inject IWorkspaceSessionService Workspace
@inject IReportExportService ExportService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IGraphQlSchemaArtifactApiService SchemaArtifacts
@inject IServiceProvider ServiceProvider

<PageTitle>API Quality Review</PageTitle>

<div class="aqr-page">
    <PageHeader Title="API Quality Review"
                Description="Review discovered REST and GraphQL APIs for security, contract quality, robustness, error handling, and response timing. Read-only.">
        @if (_report is not null)
        {
            @* Same action pattern as the Frontend Quality Review result: return to the setup view first, then export.
               "Back" and "Run again" stay apart — one navigates, the other starts work. *@
            <button type="button" class="btn-secondary" @onclick="BackToSetup" data-testid="aqr-back">Back to API Quality Review</button>
            <button type="button" class="btn-secondary" @onclick="RunReview" disabled="@(!Eligibility.Enabled || _running)" data-testid="aqr-run">@(_running ? "Reviewing…" : "Run review again")</button>
            <ExportMenu Options="ExportOptions" TestId="aqr-export" />
        }
    </PageHeader>

    @{
        var access = ApiReviewPresentation.AccessPanel(_context, _capabilities, _targets, _selected);
        var contracts = ApiReviewPresentation.Contracts(_targets, _selected, _history, _report ?? _history?.LastReport, _schemaArtifacts);
        var readiness = ApiReviewPresentation.Readiness(Eligibility, _context, _targets, _selected, _capabilities, contracts);
        var scope = ApiReviewPresentation.Scope(_targets, _selected);
        var domains = ApiReviewPresentation.Domains(scope, contracts, access.Availability);
        var selectedTargets = _targets.Where(t => _selected.Contains(t.TargetId)).ToList();
        var targetAccess = ApiReviewPresentation.TargetAccess(_targets, _selected, access.Availability);
        var readyTargets = targetAccess.Count(t => t.Ready);
        var targetSummary = _context is null ? null : ApiReviewPresentation.TargetSummary(_context, _capabilities, _targets);
        var targetReviews = ApiReviewPreRunPresentation.TargetReviews(_targets, _selected, access.Availability, _schemaArtifacts, _history?.LastReport, _contractBindings);
    }

    @if (_report is null && !_evaluated)
    {
        @* Nothing is a verdict before the required evidence was evaluated: staged progress, or "could not be fully assessed" with Retry. *@
        @AssessingPanel()
    }
    else if (_report is null)
    {
        <div class="aqr-decide" data-testid="aqr-decide">
        @*
            Readiness first. The pre-run answers four questions before anything else: can it run, what will be reviewed, what will not be fully
            reviewed and why, and which optional active checks are on. Configuration and diagnostics are one collapsed section at the end.
        *@
        @{
            var ready = readiness.Items.Where(i => i.State == ApiReviewReadinessItemState.Ok).ToList();
            var limits = readiness.Items.Where(i => i.State == ApiReviewReadinessItemState.Warning).ToList();
            var info = readiness.Items.Where(i => i.State == ApiReviewReadinessItemState.Missing).ToList();
            var blocked = readiness.Level == ApiReviewReadinessLevel.Blocked;
            var knownLimitations = ApiReviewPreRunPresentation.KnownLimitations(targetReviews, _authorizationChecks);
        }
        <BirkNext.Web.Components.GuidedStepList Steps="@ApiReviewWorkflow.Derive(_targets, _selected, _capabilities, _authentication, Eligibility, _context?.ActiveProfileOrNull?.Id)"
                                                TestId="aqr-steps" Label="API Quality Review steps" />
        <section class="aqr-card aqr-decision aqr-readiness aqr-readiness-@readiness.Level.ToString().ToLowerInvariant()" data-testid="aqr-readiness" data-readiness="@readiness.Level" data-decision="@ApiReviewPresentation.Decision(readiness)" aria-labelledby="aqr-readiness-heading" role="@(blocked ? "alert" : "status")">
            <div class="aqr-decision-status">
                <p class="aqr-decision-kicker">Run decision</p>
                <h2 id="aqr-readiness-heading"><span class="aqr-readiness-icon" aria-hidden="true">@ReadinessIcon(readiness.Level)</span> @readiness.Title</h2>
                @if (targetReviews.Count > 0)
                {
                    <p class="aqr-decision-counts" data-testid="aqr-decision-counts">@ApiReviewPreRunPresentation.Counts(targetReviews)</p>
                }
                @if (_runtime is { } runtimeEvidence)
                {
                    @* Runtime evidence is loaded by this review itself (browser history + live capture + persisted history); Bearer observed in it is
                       authenticated traffic seen, never a reusable credential. *@
                    <p class="aqr-decision-evidence" data-testid="aqr-runtime-evidence" data-source="@runtimeEvidence.Source" data-freshness="@runtimeEvidence.Freshness">
                        <span class="aqr-decision-evidence-label">Runtime evidence:</span> @ApiReviewPresentation.RuntimeEvidenceLabel(runtimeEvidence)
                        @if (runtimeEvidence.Available && _context is not null) { <a class="aqr-link" href="@AuthorizationEvidenceHref(_context.ActiveProfile.Id)" data-testid="aqr-view-discovery">View Endpoint Discovery evidence</a> }
                    </p>
                }
                <p class="aqr-decision-refresh" data-testid="aqr-refresh-row">
                    @if (_assessing) { <span role="status" aria-live="polite" data-testid="aqr-refreshing">Refreshing evidence…</span> }
                    else { <button type="button" class="aqr-link-button" @onclick="AssessAsync" data-testid="aqr-refresh-readiness">Refresh readiness</button> }
                    @if (_assessmentError is not null) { <span class="aqr-muted" data-testid="aqr-refresh-error"> · @_assessmentError Showing the last assessed readiness.</span> }
                </p>
                @if (blocked)
                {
                    <p class="aqr-readiness-message" id="aqr-run-reason" data-testid="aqr-run-reason">@readiness.Message</p>
                }
                else if (targetReviews.Count > 0)
                {
                    @* Execution readiness only: can the read-only review run now. What is limited is summarised in one sentence here
                       and listed once, under Known limitations; optional active checks never change this answer. *@
                    <p class="aqr-readiness-message" data-testid="aqr-readiness-summary">@ApiReviewPreRunPresentation.ReadinessSummary(targetReviews, knownLimitations)</p>
                    <span class="aqr-visually-hidden" id="aqr-run-reason" data-testid="aqr-run-reason">@readiness.Message</span>
                }
                else
                {
                    <p class="aqr-readiness-message" id="aqr-run-reason" data-testid="aqr-run-reason">@readiness.Message</p>
                }
            </div>

            @if (blocked)
            {
                @* No enabled Run button while the review cannot run: the exact blockers and one corrective action replace it. *@
                @CapabilityList(false)
                <div class="aqr-blockers" data-testid="aqr-blockers">
                    <h3>Cannot run</h3>
                    <ul data-testid="aqr-decision-group" data-group="blocking">
                        @if (ApiReviewPreRunPresentation.Blockers(targetReviews) is { Count: > 0 } targetBlockers)
                        {
                            @foreach (var blocker in targetBlockers) { <li class="aqr-readiness-item aqr-readiness-item-blocking"><span aria-hidden="true">✕</span> @blocker</li> }
                        }
                        else
                        {
                            <li class="aqr-readiness-item aqr-readiness-item-blocking"><span aria-hidden="true">✕</span> @(readiness.RunUnavailableReason ?? readiness.Message)</li>
                        }
                    </ul>
                    @if (readiness.ActionText is not null && readiness.ActionHref is not null) { <a class="aqr-cta" data-testid="aqr-run-action" href="@readiness.ActionHref">@readiness.ActionText</a> }
                    @if (readiness.Help is not null) { <p class="aqr-help" data-testid="aqr-readiness-help">@readiness.Help</p> }
                    @if (!Eligibility.Enabled && readiness.RunUnavailableReason is { } runUnavailable) { <span class="aqr-visually-hidden" id="aqr-run-unavailable" data-testid="aqr-run-unavailable">@runUnavailable</span> }
                </div>
            }
            else
            {
                <BirkNext.Web.Components.RuntimeAuthenticationSelector OperationKey="@BirkNext.RuntimeAuthentication.RuntimeAuthenticationCatalog.ApiAuthenticatedChecks"
                    Profile="@_context?.ActiveProfileOrNull" ResolutionChanged="r => _authentication = r" />
                @if (ApiReviewPresentation.AuthenticationModeNote(_authentication, _targets.Where(t => _selected.Contains(t.TargetId)).ToList(), _capabilities) is { } modeNote)
                {
                    <p class="aqr-help" role="note" data-testid="aqr-auth-mode-note">@modeNote</p>
                }
                @CapabilityList(true)
                <div class="aqr-run-row" data-testid="aqr-run-row">
                    <PrimaryButton OnClick="RunReview" Disabled="@(!Eligibility.Enabled || _running)" aria-label="Run API Quality Review" data-testid="aqr-run" aria-describedby="@(!Eligibility.Enabled ? "aqr-run-reason" : null)">
                        @if (_running) { <span class="loading-spinner" aria-hidden="true"></span> }
                        @(_running ? "Reviewing..." : "Run API Quality Review")
                    </PrimaryButton>
                    <span class="aqr-muted aqr-run-note" data-testid="aqr-run-note">Runs the read-only review (safe requests only). Optional active checks run only when explicitly enabled and ready.</span>
                    @if (_running) { <p class="aqr-progress" role="status" aria-live="polite">@_progressMessage</p> }
                </div>
                @if (readiness.ActionText is not null && readiness.ActionHref is not null) { <a class="aqr-link" data-testid="aqr-run-action" href="@readiness.ActionHref">@readiness.ActionText</a> }
                @if (readiness.Help is not null) { <p class="aqr-help" data-testid="aqr-readiness-help">@readiness.Help</p> }
            }

            @if (!blocked && readiness.Items.Count > 0)
            {
                <ReviewDisclosure Text="View readiness details" CollapseText="Hide readiness details" Class="disclosure-inline disclosure-small" TestId="aqr-readiness-details">
                    <div class="aqr-decision-groups" data-testid="aqr-readiness-items">
                        @DecisionGroup("ready", "Ready", ready)
                        @DecisionGroup("limitation", "Limitations", limits)
                        @DecisionGroup("informational", "Informational", info)
                    </div>
                </ReviewDisclosure>
            }
        </section>
        @if (_errorMessage is not null) { <div class="aqr-error" role="alert" data-testid="aqr-error">@_errorMessage</div> }

        @* ── Target · API targets · Access: one compact line each ── *@
        <section class="aqr-overview" data-testid="aqr-overview" aria-label="Review scope">
            <dl class="aqr-summary-strip">
                <div data-testid="aqr-environment">
                    <dt>Target</dt>
                    <dd>
                        @if (_context is null) { <InlineLoading Text="Loading the active Target Environment…" Class="aqr-muted" Inline="true" /> }
                        else if (_context.ActiveTargetError is { Length: > 0 } activeError) { <span class="aqr-error-inline" role="alert" data-testid="aqr-active-target-error">@activeError</span> }
                        else if (targetSummary is not null)
                        {
                            <strong data-testid="aqr-env-name">@targetSummary.Environment</strong>
                            <MetaBadge Kind="BadgeKind.Environment" Text="@targetSummary.EnvironmentType" />
                            <span> · </span><span class="aqr-mono" data-testid="aqr-env-url">@HostOf(targetSummary.FrontendUrl)</span>
                            <span class="aqr-muted aqr-strip-note" data-testid="aqr-env-auth" aria-describedby="aqr-frontend-signin-help">Frontend sign-in: <span data-testid="aqr-target-authentication">@targetSummary.Authentication</span></span>
                            <span class="aqr-visually-hidden" id="aqr-frontend-signin-help" data-testid="aqr-frontend-signin-help">Frontend access does not require sign-in; selected APIs may still require authenticated access.</span>
                        }
                        else { <span class="aqr-muted">No Target Environment selected.</span> }
                        <a class="aqr-link aqr-strip-link" href="@ApiReviewPresentation.TargetEnvironmentsHref" data-testid="aqr-change-target">Change target</a>
                    </dd>
                </div>
                <div data-testid="aqr-scope">
                    <dt>API targets</dt>
                    <dd><strong data-testid="aqr-scope-headline">@(scope.Selected == 0 ? "None selected" : $"{scope.Selected} selected")</strong>@if (targetReviews.Count > 0) {<span> · </span><span data-testid="aqr-scope-protocols">@ApiReviewPreRunPresentation.TargetCoverage(targetReviews).Split(" · ", 2).ElementAtOrDefault(1)</span>}</dd>
                </div>
                <div data-testid="aqr-access">
                    <dt>Access</dt>
                    <dd>
                        <strong class="aqr-access-count" data-testid="aqr-target-access-summary" data-ready="@readyTargets" data-count="@targetAccess.Count">@readyTargets/@targetAccess.Count available</strong>
                        <span class="aqr-muted aqr-strip-note" data-testid="aqr-access-mode">@(targetAccess.Count == 0 ? "No API targets selected" : ApiReviewPresentation.ApiAccessLabel(access.Availability, targetAccess.Any(t => t.Requirement == "Authenticated")))</span>
                    </dd>
                </div>
            </dl>
        </section>

        @* ── API targets: the primary detailed section ── *@
        <section class="aqr-section aqr-target-section" id="aqr-targets-section" data-testid="aqr-target-section" aria-labelledby="aqr-targets-heading">
            <div class="aqr-card-head"><h2 id="aqr-targets-heading">API targets</h2><span class="aqr-muted">@ScopeHint(scope)</span></div>
            @if (targetReviews.Count == 0)
            {
                <p class="aqr-muted" data-testid="aqr-no-targets">@(_targets.Count == 0 ? ApiReviewRunEligibility.NoTargetsReason : "No API target is selected. Choose targets below.")</p>
            }
            <ul class="aqr-target-reviews" data-testid="aqr-target-reviews">
                @foreach (var review in targetReviews)
                {
                    <li class="aqr-card aqr-target-review" data-testid="aqr-target-review" data-target-id="@review.Target.TargetId" data-type="@review.Type" data-state="@review.State">
                        <div class="aqr-target-review-head">
                            <h3>@review.Name</h3>
                            <span class="aqr-pill aqr-pill-@StateTone(review.State)" data-testid="aqr-target-review-state">@review.StatusLine</span>
                        </div>
                        <p class="aqr-mono aqr-target-review-endpoint" data-testid="aqr-target-review-endpoint">@(ApiReviewPresentation.SafeEndpointUrl(review.Target) ?? ApiReviewPresentation.SafeEndpointPath(review.Target))</p>
                        <dl class="aqr-target-facts">
                            <div><dt>Type</dt><dd>@review.Type</dd></div>
                            <div><dt>Runtime review</dt><dd data-testid="aqr-target-review-runtime">@(review.AccessReady ? "Available" : "Blocked — access unavailable")</dd></div>
                            <div><dt>Access</dt><dd data-testid="aqr-target-review-access">@review.Access@(review.AccessReady ? "" : " · unavailable")</dd></div>
                            <div><dt>Operations</dt><dd>@review.Operations</dd></div>
                            <div><dt>@review.ContractLabel</dt><dd data-testid="aqr-target-review-contract">@review.ContractValue</dd></div>
                            @if (review.FallbackValue is { } fallback)
                            {
                                <div><dt>Published schema</dt><dd data-testid="aqr-target-review-fallback">@fallback</dd></div>
                                <div><dt>Contract compatibility</dt><dd data-testid="aqr-target-review-compatibility">@(fallback == "Configured" ? "Available to assess" : "Not assessed until schema evidence exists")</dd></div>
                            }
                            else if (review.Binding is { } binding)
                            {
                                <div><dt>Contract compatibility</dt><dd data-testid="aqr-target-review-compatibility">@binding.CompatibilityLabel</dd></div>
                                @if (binding.SnapshotId is { } snapshotId && binding.State == ApiReviewContractBindingState.SourceBound)
                                {
                                    <div><dt>Contract provenance</dt><dd data-testid="aqr-target-review-contract-provenance">@binding.File · @binding.SnapshotSource · snapshot <code title="@snapshotId">@snapshotId.ToString("N")[..8]</code></dd></div>
                                }
                            }
                        </dl>
                        @if (review.ContractNote is { } note) { <p class="aqr-muted aqr-target-review-note" data-testid="aqr-target-review-note">@note</p> }
                        <div class="aqr-target-runs">
                            @if (review.WillRun.Count > 0)
                            {
                                <p data-testid="aqr-target-review-runs"><strong>What can run</strong> @string.Join(" · ", review.WillRun)</p>
                            }
                            @if (review.WillNotRun.Count > 0)
                            {
                                <p data-testid="aqr-target-review-not-runs"><strong>What cannot run</strong> @string.Join(" · ", review.WillNotRun)</p>
                            }
                        </div>
                        @switch (review.Action)
                        {
                            case ApiReviewTargetAction.ConfigureContract:
                                @if (_context?.ActiveProfileOrNull is { } contractProfile)
                                {
                                    <a class="aqr-link" data-testid="aqr-target-configure-contract" href="@ContractConfigurationHref(contractProfile.Id)">Choose contract (override)</a>
                                }
                                break;
                            case ApiReviewTargetAction.ConfigureFallback:
                                <button type="button" class="aqr-link-button" data-testid="aqr-target-configure-fallback" @onclick="ShowSchemaArtifacts">@(review.FallbackValue == "Configured" ? "Manage fallback schema" : "Configure fallback")</button>
                                break;
                            case ApiReviewTargetAction.FixAccess when readiness.Level != ApiReviewReadinessLevel.Blocked:
                                @* When the whole review is blocked, the run decision's one action is the fix; cards do not repeat it. *@
                                <a class="aqr-link" data-testid="aqr-target-fix-access" href="@ApiReviewPresentation.AuthenticationHref(_context)">Fix access</a>
                                break;
                        }
                    </li>
                }
            </ul>
            <ReviewDisclosure Text="@($"Change API selection ({_targets.Count} available)")" CollapseText="Hide API selection" Hint="@scope.Protocols" TestId="aqr-targets-disclosure" Class="aqr-targets-disclosure" @bind-Expanded="_targetsExpanded">
                <ApiReviewTargetPicker Targets="_targets" Selected="_selected" Toggle="OnToggleTarget" LastReport="_history?.LastReport" AccessAvailability="@access.Availability"
                                       EnvironmentId="@(_context?.ActiveProfile.Id)" SchemaArtifacts="_schemaArtifacts" AddSchemaArtifact="ShowSchemaArtifacts" />
            </ReviewDisclosure>
        </section>

        @* ── Review coverage: one compact summary, details on demand ── *@
        <section class="aqr-section aqr-coverage-summary" data-testid="aqr-domains" aria-labelledby="aqr-domains-heading">
            <h2 id="aqr-domains-heading">Review coverage</h2>
            <dl class="aqr-coverage-strip" data-testid="aqr-coverage-strip">
                @foreach (var domain in domains)
                {
                    <div data-testid="aqr-domain" data-domain="@domain.Key" data-state="@domain.State">
                        <dt>@domain.Title</dt>
                        <dd><span class="aqr-pill aqr-pill-@ApiReviewDomainStates.Tone(domain.State)" data-testid="aqr-domain-state">@ApiReviewDomainStates.Label(domain.State)</span></dd>
                    </div>
                }
            </dl>
            @if (targetReviews.Count > 0)
            {
                <p class="aqr-muted" data-testid="aqr-target-coverage"><strong>Targets</strong> @ApiReviewPreRunPresentation.TargetCoverage(targetReviews)</p>
            }
            <ReviewDisclosure Text="View coverage details" CollapseText="Hide coverage details" Class="disclosure-inline disclosure-small" TestId="aqr-coverage-details">
                <ul class="aqr-domain-list">
                    @foreach (var domain in domains)
                    {
                        <li data-testid="aqr-domain-detail" data-domain="@domain.Key">
                            <strong>@domain.Title</strong> — @ApiReviewDomainStates.Label(domain.State).
                            <span data-testid="aqr-domain-limitation">@(domain.Limitation ?? domain.Purpose)</span>
                        </li>
                    }
                </ul>
            </ReviewDisclosure>
        </section>

        @* ── Known limitations: everything that limits the planned review, once, in one place. None blocks the read-only review. ── *@
        @if (knownLimitations.Count > 0)
        {
            <section class="aqr-section aqr-known-limitations" data-testid="aqr-known-limitations" aria-labelledby="aqr-limitations-heading">
                <div class="aqr-card-head"><h2 id="aqr-limitations-heading">Known limitations</h2><span class="aqr-muted">Do not block the read-only review</span></div>
                @* The top three first; the rest stay one click away (View all limitations), never mixed with blockers. *@
                <dl class="aqr-limitation-list">
                    @foreach (var limitation in knownLimitations.Take(3))
                    {
                        <div data-testid="aqr-known-limitation"><dt>@limitation.Area</dt><dd>@limitation.Text</dd></div>
                    }
                </dl>
                @if (knownLimitations.Count > 3)
                {
                    <details class="aqr-limitations-more" data-testid="aqr-limitations-more">
                        <summary>View all limitations (@knownLimitations.Count)</summary>
                        <dl class="aqr-limitation-list">
                            @foreach (var limitation in knownLimitations.Skip(3))
                            {
                                <div data-testid="aqr-known-limitation"><dt>@limitation.Area</dt><dd>@limitation.Text</dd></div>
                            }
                        </dl>
                    </details>
                }
            </section>
        }

        @* ── Optional active checks: each card says its state, why, and the one thing to do. Neither blocks the read-only review. ── *@
        <section class="aqr-section aqr-additional-checks" data-testid="aqr-additional-checks" aria-labelledby="aqr-additional-heading">
            <div class="aqr-card-head"><h2 id="aqr-additional-heading">Optional active checks</h2><span class="aqr-muted">These checks can send bounded requests. Review or enable them before running if you want them included.</span></div>
            <div class="aqr-active-check-cards">
                <section class="aqr-active-check aqr-active-check-@(_fuzzingLevel == ApiFuzzingLevel.Off ? "neutral" : "active")" data-testid="aqr-fuzzing-summary" aria-labelledby="aqr-fuzzing-card-heading">
                    <h3 id="aqr-fuzzing-card-heading">Safe fuzzing</h3>
                    <p><strong data-testid="aqr-fuzzing-state">@ApiFuzzingPresentation.LevelLabel(_fuzzingLevel)</strong></p>
                    @if (_fuzzingLevel == ApiFuzzingLevel.Off) { <p class="aqr-muted" data-testid="aqr-fuzzing-off">No active fuzz requests will be sent. Optional — the read-only API review can still run.</p> }
                    else { <p class="aqr-muted" data-testid="aqr-fuzzing-on">Bounded, deterministic invalid/boundary requests to this non-production API. Not a penetration test.</p> }
                    <button type="button" class="btn-secondary fa-btn-sm" data-testid="aqr-configure-fuzzing" aria-controls="aqr-fuzzing-config" @onclick="OpenFuzzingConfiguration">Configure safe fuzzing</button>
                </section>
                <section class="aqr-active-check aqr-active-check-@AuthorizationTone" data-testid="aqr-authorization-card" aria-labelledby="aqr-authorization-card-heading">
                    <h3 id="aqr-authorization-card-heading">Authorization checks</h3>
                    <p><strong data-testid="aqr-authorization-summary">@_authorizationChecks.Headline</strong></p>
                    @if (_authorizationChecks.Available > 0 && _authorizationChecks.Ready < _authorizationChecks.Available)
                    {
                        <p class="aqr-muted" data-testid="aqr-authorization-blockers">@ApiReviewPreRunPresentation.AuthorizationBlockerSummary(_authorizationChecks)</p>
                    }
                    <p class="aqr-muted" data-testid="aqr-authorization-impact">@AuthorizationImpact</p>
                    @if (_context?.ActiveProfileOrNull is { } profile)
                    {
                        <a class="aqr-link" data-testid="aqr-configure-authorization" href="@AuthorizationConfigurationHref(profile.Id)" @onclick="RememberSelection">Review authorization checks</a>
                    }
                    else { <span class="aqr-muted" data-testid="aqr-configure-authorization-disabled">Select a Target Environment to configure authorization checks.</span> }
                </section>
            </div>
            <ReviewDisclosure Text="Configure active checks" CollapseText="Hide active checks" Class="disclosure-inline disclosure-small" TestId="aqr-active-checks-details" @bind-Expanded="_activeChecksExpanded">
                <div class="aqr-check-grid">
                    <div id="aqr-fuzzing-config" tabindex="-1" @ref="_fuzzingConfigElement"></div>
                    <ReviewDisclosure Text="Safe fuzzing" CollapseText="Safe fuzzing" Hint="@FuzzingHint" TestId="aqr-fuzzing-disclosure" Class="aqr-check-disclosure" @bind-Expanded="_fuzzingExpanded">
                        <p class="aqr-check-summary">Safe fuzzing sends a bounded set of deterministic invalid/boundary requests to non-production APIs. It is not a penetration test. REST GET/HEAD/OPTIONS only for operations from the published OpenAPI contract · GraphQL queries from the schema only · no GraphQL mutations · no attack dictionaries · never Production.</p>
                        <ApiSafeFuzzingPanel Context="_context" BuildReviewRequest="FuzzingReviewRequest" ProjectName="@Workspace.ProjectName" LevelChanged="OnFuzzingLevelChanged" />
                    </ReviewDisclosure>
                    <ReviewDisclosure Text="Authorization checks" CollapseText="Authorization checks" Hint="@_authorizationChecks.Headline" TestId="aqr-authorization-disclosure" Class="aqr-check-disclosure">
                        <p class="aqr-check-summary">Verify that configured identities are correctly allowed or denied for selected API operations.</p>
                        <ApiAuthorizationScenariosPanel Context="_context" BuildReviewRequest="FuzzingReviewRequest" ProjectName="@Workspace.ProjectName"
                                                        Checks="_authorizationChecks" Execution="_securityExecution" />
                    </ReviewDisclosure>
                </div>
            </ReviewDisclosure>
        </section>

        @* ── Technical setup & diagnostics: collapsed; every raw detail lives here ── *@
        <section class="aqr-section aqr-details" data-testid="aqr-details" aria-labelledby="aqr-details-heading">
            <h2 id="aqr-details-heading" class="aqr-visually-hidden">Technical setup &amp; diagnostics</h2>
            <ReviewDisclosure Text="Technical setup &amp; diagnostics" CollapseText="Hide technical setup &amp; diagnostics" Hint="Contract/schema, GraphQL fallback, authentication evidence, read-only policy" TestId="aqr-diagnostics" Class="aqr-diagnostics" @bind-Expanded="_diagnosticsExpanded">
                <dl class="aqr-dl aqr-setup-summary" data-testid="aqr-setup-summary">
                    <div><dt>Authenticated access</dt><dd data-testid="aqr-setup-auth">@ApiReviewAccessAvailabilities.Label(access.Availability)</dd></div>
                    @if (targetSummary is not null) { <div><dt>Method</dt><dd data-testid="aqr-setup-method">@targetSummary.Authentication</dd></div> }
                    @foreach (var row in contracts.Rows.Where(r => r.State != ApiReviewContractState.NotApplicable))
                    {
                        <div><dt>@(row.Label == "REST" ? "REST contract" : "GraphQL schema")</dt><dd>@ApiReviewContractStates.HeaderSummary(row.State)</dd></div>
                    }
                    <div><dt>Previous baseline</dt><dd>@contracts.HistoryLabel</dd></div>
                </dl>
                <ReviewDisclosure Text="Contract/schema details" CollapseText="Hide contract/schema details" Hint="@ContractHint(contracts)" TestId="aqr-contracts-disclosure" Class="aqr-detail-disclosure">
                    <ApiReviewContractPanel Contracts="contracts" />
                </ReviewDisclosure>
                @{ var restSelected = _targets.Where(t => t.ApiType == ApiReviewTargetType.Rest && _selected.Contains(t.TargetId)).ToList(); }
                <ReviewDisclosure Text="Runtime observations" CollapseText="Hide runtime observations" Hint="@RuntimeObservationsHint(restSelected)" TestId="aqr-runtime-observations" Class="aqr-detail-disclosure" @bind-Expanded="_runtimeObservationsExpanded">
                    @if (_runtimeObservationsExpanded)
                    {
                        <BirkNext.Web.Components.ApiRuntimeObservationsPanel Targets="restSelected" EnvironmentId="@(_context?.ActiveProfile.Id ?? "")"
                            ContractSnapshots="@(restSelected.ToDictionary(t => t.TargetId, t => _contractBindings.GetValueOrDefault(t.TargetId)?.SnapshotId, StringComparer.Ordinal))" />
                    }
                </ReviewDisclosure>
                <ReviewDisclosure Text="Source contract evidence" CollapseText="Hide source contract evidence" Hint="Published contract in a Source Analysis snapshot · separate from runtime behaviour" TestId="aqr-source-contracts" Class="aqr-detail-disclosure" @bind-Expanded="_sourceContractsExpanded">
                    @if (_sourceContractsExpanded) { <BirkNext.Web.Components.SourceDomains.SourceContractEvidencePanel EnvironmentId="@(_context?.ActiveProfile.Id ?? "")" /> }
                </ReviewDisclosure>
                <ReviewDisclosure Text="Canonical operations" CollapseText="Hide canonical operations" Hint="shared identity · implementing source symbols · VERIFIES tests · contracts" TestId="aqr-canonical" Class="aqr-detail-disclosure" @bind-Expanded="_canonicalExpanded">
                    @if (_canonicalExpanded) { <BirkNext.Web.Components.CanonicalOperationLookup Scope="@CorrelationPresentation.Scope(_context?.ActiveProfileOrNull?.Id)" /> }
                </ReviewDisclosure>
                <ReviewDisclosure Text="Pipeline quality gates" CollapseText="Hide pipeline quality gates" Hint="@DeliveryGateStates.NoSnapshot" TestId="aqr-delivery-gates" Class="aqr-detail-disclosure" @bind-Expanded="_deliveryExpanded">
                    @if (_deliveryExpanded) { <BirkNext.Web.Components.DeliveryEvidencePanel EnvironmentId="@(_context?.ActiveProfile.Id ?? "")" Categories="@([BirkNext.PipelineReview.ValidationCategory.Api, BirkNext.PipelineReview.ValidationCategory.Security, BirkNext.PipelineReview.ValidationCategory.Smoke, BirkNext.PipelineReview.ValidationCategory.HealthCheck, BirkNext.PipelineReview.ValidationCategory.Contract])" /> }
                </ReviewDisclosure>
                <ReviewDisclosure Text="Test data readiness" CollapseText="Hide test data readiness" Hint="Shared Test Data catalog · aliases and approval only, never values" TestId="aqr-test-data" Class="aqr-detail-disclosure" @bind-Expanded="_testDataExpanded">
                    @if (_testDataExpanded) { <BirkNext.Web.Components.TestDataReadinessSummary Kinds="@([BirkNext.TestData.TestDataKind.Structured, BirkNext.TestData.TestDataKind.Scalar, BirkNext.TestData.TestDataKind.EntityReference, BirkNext.TestData.TestDataKind.ExpectedResult])" /> }
                </ReviewDisclosure>
                @if (_context is not null && _targets.Any(t => t.ApiType == ApiReviewTargetType.GraphQl))
                {
                    var gqlTargets = _targets.Where(t => t.ApiType == ApiReviewTargetType.GraphQl).ToList();
                    var configured = gqlTargets.Count(t => _schemaArtifacts.ContainsKey(t.TargetId));
                    <div id="aqr-schema-artifacts" tabindex="-1" @ref="_schemaArtifactsElement">
                        <ReviewDisclosure Text="GraphQL fallback schema (SDL)" CollapseText="Hide GraphQL fallback schema" Hint="@(configured == 0 ? "Not configured" : $"{configured} of {gqlTargets.Count} configured")" TestId="aqr-schema-artifacts-disclosure" Class="aqr-detail-disclosure" @bind-Expanded="_schemaArtifactsExpanded">
                            <GraphQlSchemaArtifactPanel EnvironmentId="@_context.ActiveProfile.Id" Targets="gqlTargets" Artifacts="_schemaArtifacts" LoadError="@_schemaArtifactsError" Changed="OnSchemaArtifactsChanged" />
                        </ReviewDisclosure>
                    </div>
                }
                <ReviewDisclosure Text="View authentication evidence" CollapseText="Hide authentication evidence" Hint="@ApiReviewAccessAvailabilities.Label(access.Availability)" TestId="aqr-access-details" Class="aqr-detail-disclosure">
                    <ApiReviewAccessDetails Access="access" />
                </ReviewDisclosure>
                <ReviewDisclosure Text="Read-only execution policy" CollapseText="Hide read-only execution policy" Hint="Safe requests only · REST GET/HEAD/OPTIONS · GraphQL queries" TestId="aqr-readonly-disclosure" Class="aqr-detail-disclosure">
                    <p class="aqr-muted">Safe requests only: authenticated requests are executed by the backend gateway. The review does not receive a token; credentials remain memory-only.</p>
                    <dl class="aqr-dl aqr-readonly-methods" data-testid="aqr-readonly-summary">
                        <div><dt>REST</dt><dd>GET, HEAD, OPTIONS</dd></div><div><dt>GraphQL</dt><dd>Queries only</dd></div>
                        <div><dt>Never executed</dt><dd>Mutations, write operations and destructive operations</dd></div>
                        <div><dt>Timing note</dt><dd class="aqr-muted" data-testid="aqr-timing-scope">@ApiReviewPresentation.TimingScopeShort</dd></div>
                    </dl>
                </ReviewDisclosure>
                @if (targetSummary is not null)
                {
                    <ReviewDisclosure Text="Target details" CollapseText="Hide target details" Hint="@targetSummary.Environment" TestId="aqr-target-details" Class="aqr-detail-disclosure">
                        <dl class="aqr-dl aqr-dl-technical">
                            @foreach (var field in targetSummary.Technical) { <div><dt>@field.Label</dt><dd>@field.Value</dd></div> }
                        </dl>
                    </ReviewDisclosure>
                }
            </ReviewDisclosure>
        </section>

        </div>
    }
    @* ── Results (only once a review exists) ── *@
    @if (_report is { } report)
    {
        var result = ApiReviewPresentation.Result(report);
        var summary = result.Metadata;
        var outcome = ApiReviewPostRunPresentation.Outcome(report);
        var issues = ApiReviewPresentation.LogicalIssues(report);
        var limitationRows = ApiReviewPostRunPresentation.Limitations(report);
        <section class="aqr-results" data-testid="aqr-results" aria-labelledby="aqr-result-heading">

            @* ── 1. The result: execution, assessment, manual review and coverage are four facts, never one badge. "Completed" is the
                  execution, never the quality verdict. ─────────────────────────────────────────────────────────────────────────────── *@
            <section class="aqr-card aqr-result-summary" data-testid="aqr-result-summary" aria-labelledby="aqr-result-heading">
                <h2 id="aqr-result-heading">Review result</h2>
                @if (_reportFromHistory)
                {
                    <p class="aqr-stored-result" role="status" data-testid="aqr-stored-result">Stored result of a previous run in this browser — historical, not current readiness. Run the review again for a current result.</p>
                }
                <dl class="aqr-outcome" data-testid="aqr-result-state">
                    <div data-testid="aqr-outcome-execution"><dt>Automated review</dt><dd><span class="aqr-pill aqr-pill-@(outcome.Execution == "Completed" ? "muted" : outcome.Execution == "Failed" ? "attention" : "warning")">@outcome.Execution</span></dd></div>
                    <div data-testid="aqr-outcome-assessment"><dt>Review outcome</dt><dd><span class="aqr-pill aqr-pill-@(outcome.Assessment == "Issues identified" ? "warning" : "muted")">@outcome.Assessment</span></dd></div>
                    <div data-testid="aqr-result-manual"><dt>Manual review</dt><dd><span class="aqr-pill aqr-pill-@(report.ManualReviewItems.Count > 0 ? "attention" : "muted")">@outcome.ManualReview</span></dd></div>
                    <div data-testid="aqr-outcome-coverage"><dt>Coverage</dt><dd><span class="aqr-pill aqr-pill-@(outcome.CoverageLimited ? "warning" : "muted")">@outcome.Coverage</span></dd></div>
                </dl>
                <p class="aqr-result-headline" data-testid="aqr-result-headline"><strong>@ApiReviewPostRunPresentation.Headline(outcome, limitationRows)</strong></p>
                @* Why coverage is limited, next to the state — coverage gaps, not findings; each links to the tab holding its evidence. *@
                @if (outcome.CoverageLimited && limitationRows.Count > 0)
                {
                    <div class="aqr-coverage-why" data-testid="aqr-coverage-why">
                        <p class="aqr-coverage-why-title"><strong>Coverage limited because:</strong></p>
                        <ul>
                            @foreach (var limitation in limitationRows)
                            {
                                <li data-testid="aqr-coverage-reason" data-key="@limitation.Key" data-category="@limitation.Category">
                                    <span class="aqr-muted">@limitation.Category:</span> @limitation.Title
                                    <button type="button" class="aqr-link-button" data-testid="aqr-coverage-reason-link" @onclick="() => OpenTab(limitation.Tab)"
                                            aria-label="@($"View {limitation.Title} in {ApiReviewPresentation.TabLabel(limitation.Tab)}")">View in @ApiReviewPresentation.TabLabel(limitation.Tab)</button>
                                </li>
                            }
                        </ul>
                    </div>
                }
                <p class="aqr-result-summary-text" data-testid="aqr-result-summary-text">@result.Summary</p>
                <dl class="aqr-result-counts" data-testid="aqr-result-counts">
                    <div><dt>Logical issues</dt><dd data-testid="aqr-count-issues">@outcome.LogicalIssues</dd></div>
                    <div><dt>Source findings</dt><dd data-testid="aqr-count-findings">@outcome.SourceFindings</dd></div>
                    <div><dt>Services reviewed</dt><dd data-testid="aqr-result-services">@outcome.ServicesReviewed/@outcome.Services</dd></div>
                    <div><dt>Read-only requests executed</dt><dd data-testid="aqr-result-operations">@outcome.RequestsExecuted</dd></div>
                </dl>
                <dl class="aqr-dl aqr-result-meta" data-testid="aqr-result-meta">
                    <div><dt>Target</dt><dd><strong data-testid="aqr-result-env">@summary.Environment</strong> <MetaBadge Kind="BadgeKind.Environment" Text="@summary.EnvironmentType" /></dd></div>
                    <div><dt>Completed</dt><dd data-testid="aqr-result-generated">@summary.GeneratedAt</dd></div>
                    <div><dt>Authenticated access</dt><dd data-testid="aqr-result-access">@outcome.AuthenticatedAccess</dd></div>
                    <div><dt>Read-only</dt><dd class="aqr-muted" data-testid="aqr-result-readonly">Write operations are never executed automatically.</dd></div>
                </dl>
                @if (_running)
                {
                    <p class="aqr-progress" role="status" aria-live="polite">@_progressMessage</p>
                }
                @if (_errorMessage is not null)
                {
                    <div class="aqr-error" role="alert" data-testid="aqr-error">@_errorMessage</div>
                }
            </section>

            <div class="aqr-tabs" role="tablist" aria-label="Review result areas">
                @foreach (var tab in Tabs)
                {
                    <button type="button" class="aqr-tab @(_tab == tab ? "aqr-tab-active" : "")" role="tab" id="aqr-tab-btn-@tab.ToLowerInvariant()" aria-selected="@(_tab == tab ? "true" : "false")" aria-controls="aqr-tabpanel" tabindex="@(_tab == tab ? "0" : "-1")" data-testid="aqr-tab-@tab.ToLowerInvariant()" @onclick="() => _tab = tab" @onkeydown="e => OnTabKey(e, tab)">@ApiReviewPresentation.TabLabel(tab)</button>
                }
            </div>

            <div id="aqr-tabpanel" role="tabpanel" aria-labelledby="aqr-tab-btn-@_tab.ToLowerInvariant()" class="aqr-tabpanel" tabindex="0" data-testid="aqr-tabpanel" data-tab="@_tab">
            @if (_tab == "Overview")
            {
                @* Decision first: what needs attention (canonical logical issues), what was and was not covered and why, what a person must
                   still review, then a compact service summary. Operations, evidence and raw checks live in their tabs; observations in Findings. *@
                <section class="aqr-overview-section aqr-key-findings-card" data-testid="aqr-key-findings" aria-labelledby="aqr-key-findings-heading">
                    <div class="aqr-card-head">
                        <h3 id="aqr-key-findings-heading">What needs attention</h3>
                        <button type="button" class="aqr-link aqr-link-button" data-testid="aqr-all-findings" @onclick="() => ShowFindings()">View all @result.FindingCount source @(result.FindingCount == 1 ? "finding" : "findings") in Findings</button>
                    </div>
                    @if (report.Findings.Count > 0)
                    {
                        <p class="aqr-muted" data-testid="aqr-issue-counts">@result.IssueCount logical @(result.IssueCount == 1 ? "issue" : "issues") · @result.FindingCount source @(result.FindingCount == 1 ? "finding" : "findings") <span class="aqr-issue-legend">— one logical issue can be observed on several services; each observation is a source finding.</span></p>
                        <ul class="aqr-sev-strip" aria-label="Source findings by severity" data-testid="aqr-finding-counts">
                            <li class="aqr-sev-strip-label">Source findings by severity</li>
                            @foreach (var sev in summary.Severities)
                            {
                                <li class="aqr-sev aqr-sev-@sev.Severity.ToString().ToLowerInvariant() @(sev.Count == 0 ? "aqr-sev-zero" : "")" data-testid="aqr-sev" data-severity="@sev.Severity"><span class="aqr-sev-label">@sev.Severity</span> <span class="aqr-sev-count">@sev.Count</span></li>
                            }
                        </ul>
                        <ul class="aqr-key-findings aqr-issue-cards">
                            @foreach (var issue in issues)
                            {
                                var area = ApiReviewPresentation.FindingArea(issue.Type);
                                <li class="aqr-issue-card" data-testid="aqr-key-issue" data-sources="@issue.Sources.Count" data-issue="@issue.Key">
                                    <div class="aqr-issue-card-head">
                                        <span class="aqr-sev aqr-sev-@issue.Severity.ToString().ToLowerInvariant()"><span class="aqr-sev-label">@issue.Severity</span></span>
                                        <h4 class="aqr-key-finding-title">@issue.Title</h4>
                                        <span class="aqr-pill aqr-pill-muted" data-testid="aqr-key-issue-area">@ApiReviewPresentation.TabLabel(area)</span>
                                    </div>
                                    <p class="aqr-muted" data-testid="aqr-key-issue-affects">Affected: @string.Join(", ", issue.Affects) · @issue.Sources.Count @(issue.Sources.Count == 1 ? "observation" : "observations")</p>
                                    @if (issue.Sources.Select(f => f.Recommendation).FirstOrDefault(r => !string.IsNullOrWhiteSpace(r)) is { } recommendation)
                                    {
                                        <p class="aqr-issue-recommendation" data-testid="aqr-key-issue-recommendation">@recommendation</p>
                                    }
                                    <p class="aqr-issue-links">
                                        <button type="button" class="aqr-link-button" data-testid="aqr-key-issue-evidence" @onclick="() => OpenTab(area)">View @ApiReviewPresentation.TabLabel(area).ToLowerInvariant() evidence</button>
                                        <button type="button" class="aqr-link-button aqr-key-issue-link" data-testid="aqr-key-issue-occurrences" @onclick="() => ShowFindings(issue: issue.Key)" aria-label="@($"View {issue.Sources.Count} occurrence{(issue.Sources.Count == 1 ? "" : "s")} of {issue.Title} in Findings")">View findings (@issue.Sources.Count)</button>
                                    </p>
                                </li>
                            }
                        </ul>
                    }
                    else if (outcome.RequestsExecuted == 0)
                    {
                        <p class="aqr-empty" data-testid="aqr-nothing-executed">No request was executed, so nothing was assessed — the absence of findings is not a result. See Coverage &amp; limitations below.</p>
                    }
                    else
                    {
                        <p class="aqr-empty" data-testid="aqr-no-key-findings">No automated issues identified on the reviewed services. This is not a full validation: coverage limitations and manual review below still apply.</p>
                    }
                </section>

                <section class="aqr-overview-section" data-testid="aqr-coverage-section" aria-labelledby="aqr-coverage-heading">
                    <h3 id="aqr-coverage-heading">Coverage &amp; limitations</h3>
                    <dl class="aqr-coverage-list" data-testid="aqr-coverage">
                        @foreach (var row in ApiReviewPostRunPresentation.Coverage(report))
                        {
                            <div class="aqr-coverage-row" data-testid="aqr-coverage-row" data-coverage="@row.Domain" data-limited="@(row.Limited ? "true" : "false")">
                                <dt>@row.Domain</dt>
                                <dd><span data-testid="aqr-coverage-state">@row.State</span>@if (row.Reason is not null) { <span class="aqr-muted aqr-coverage-detail">@row.Reason</span> }@if (row.Detail is not null) { <span class="aqr-muted aqr-coverage-detail" data-testid="aqr-coverage-fact">@row.Detail</span> }</dd>
                            </div>
                        }
                    </dl>
                    @if (limitationRows.Count > 0)
                    {
                        <h4 class="aqr-group-title">Coverage gaps</h4>
                        <p class="aqr-muted">Testability and review-completeness limits — not findings, never counted as issues, and without a severity.</p>
                        <ul class="aqr-limitations" data-testid="aqr-main-limitations">
                            @foreach (var limitation in limitationRows)
                            {
                                <li data-testid="aqr-main-limitation-row" data-key="@limitation.Key" data-category="@limitation.Category"><span class="aqr-pill aqr-pill-muted">@limitation.Category</span> <strong>@limitation.Title</strong> <span class="aqr-muted">@limitation.Reason</span></li>
                            }
                        </ul>
                    }
                </section>

                @* Obligations, not defects: never added to issue or finding counts, never a warning or failure. *@
                <section class="aqr-overview-section aqr-manual" data-testid="aqr-manual-review" aria-labelledby="aqr-manual-heading">
                    <h3 id="aqr-manual-heading" tabindex="-1">@ApiReviewPostRunPresentation.ManualReviewLabel(report)</h3>
                    <p class="aqr-muted" data-testid="aqr-manual-count">@ApiReviewPresentation.ManualReviewAreas.Count areas remain outside the automated, read-only review. These are residual review obligations, not findings. @ApiReviewPostRunPresentation.ManualReviewAreasNote</p>
                    <ul class="aqr-manual-areas" data-testid="aqr-manual-areas">@foreach (var m in ApiReviewPresentation.ManualReviewAreas) { <li>@m</li> }</ul>
                    <ReviewDisclosure Text="View manual review details" CollapseText="Hide manual review details" TestId="aqr-limitations" Class="disclosure-inline disclosure-small">
                        <p class="aqr-muted">This review is intentionally read-only. These areas are not automatically assessed:</p>
                        <ul class="aqr-list" data-testid="aqr-limitation-areas">
                            @foreach (var obligation in ApiReviewPresentation.ManualReviewObligations)
                            {
                                var guide = ApiReviewPresentation.ManualObligationGuide(obligation.Area);
                                <li data-testid="aqr-limitation-area">
                                    <strong>@obligation.Area</strong>
                                    <ul class="aqr-list aqr-muted">@foreach (var detail in obligation.Details) { <li data-testid="aqr-limitation-detail">@detail</li> }</ul>
                                    <dl class="aqr-obligation" data-testid="aqr-obligation">
                                        <div><dt>Purpose</dt><dd>@guide.Purpose</dd></div>
                                        <div><dt>Evidence required</dt><dd>@guide.Evidence</dd></div>
                                    </dl>
                                    @if (_context?.ActiveProfileOrNull is { } decisionProfile)
                                    {
                                        <BirkNext.Web.Components.ManualDecisionPanel Module="@BirkNext.ManualReview.ManualReviewModules.ApiQuality" ScopeKey="@decisionProfile.Id" SubjectKey="@obligation.Area"
                                            AppliesTo="@string.Join(", ", report.Targets.Select(t => t.Target.ServiceName).Distinct())" TestId="aqr-obligation-decision" />
                                    }
                                </li>
                            }
                        </ul>
                        <p class="aqr-muted" data-testid="aqr-obligation-note">Each decision is stored with the reviewer, evidence references and its history for this Target Environment. The automated run never marks an obligation as done, and a decision never changes the automated result.</p>
                    </ReviewDisclosure>
                </section>

                <section class="aqr-overview-section" data-testid="aqr-service-summary" aria-labelledby="aqr-services-heading">
                    <h3 id="aqr-services-heading">Services</h3>
                    <p class="aqr-muted" data-testid="aqr-reviewed-help">@ApiReviewEvidencePresentation.ReviewedHelp</p>
                    <div class="aqr-tablewrap" tabindex="0" role="region" aria-label="Service summary">
                        <table class="aqr-table aqr-services" data-testid="aqr-services-table">
                            <thead><tr><th scope="col">Service</th><th scope="col">Type</th><th scope="col">Access</th><th scope="col">Operations reviewed</th><th scope="col">Contract/schema</th><th scope="col">Review state</th><th scope="col">Source findings</th></tr></thead>
                            <tbody>
                                @foreach (var row in ApiReviewPostRunPresentation.Services(report))
                                {
                                    var t = row.Result;
                                    var status = ApiReviewStatusLabels.Of(t);
                                    var expanded = _expandedServices.Contains(t.Target.TargetId);
                                    var detailId = $"aqr-service-details-{t.Target.TargetId}";
                                    <tr data-testid="aqr-service-row" data-target-id="@t.Target.TargetId">
                                        <td>
                                            <button type="button" class="aqr-row-toggle" aria-expanded="@(expanded ? "true" : "false")" aria-controls="@detailId" data-testid="aqr-service-toggle" @onclick="() => ToggleService(t.Target.TargetId)">
                                                <span aria-hidden="true">@(expanded ? "▾" : "▸")</span> <strong>@(ApiReviewPresentation.DisplayName(t.Target) is { Length: > 0 } serviceName ? serviceName : t.Target.Url)</strong>
                                            </button>
                                        </td>
                                        <td>@(t.Target.ApiType == ApiReviewTargetType.Rest ? "REST" : "GraphQL")</td>
                                        <td data-testid="aqr-service-access">@row.Access</td>
                                        <td data-testid="aqr-service-operations">@row.Operations</td>
                                        <td data-testid="aqr-service-contract">@row.ContractOrSchema</td>
                                        <td><span class="aqr-pill aqr-pill-@(row.Limited ? "warning" : "muted")" data-testid="aqr-service-status" data-status="@status">@row.ReviewState</span></td>
                                        <td data-testid="aqr-service-findings">@if (t.FindingCount is null) { <span>Not tested</span> } else { <button type="button" class="aqr-link-button" @onclick="() => ShowFindings(service: t.Target.TargetId)" aria-label="@($"View {t.FindingCount} source findings of {ApiReviewPresentation.DisplayName(t.Target)} in Findings")">@t.FindingCount</button> }</td>
                                    </tr>
                                    <tr id="@detailId" class="aqr-service-details" hidden="@(!expanded)" data-testid="aqr-service-details" data-target-id="@t.Target.TargetId">
                                        <td colspan="7">
                                            <dl class="aqr-dl aqr-dl-technical">
                                                <div><dt>Endpoint</dt><dd class="aqr-mono aqr-break">@t.Target.Url</dd></div>
                                                <div><dt>Source</dt><dd>@ApiReviewPresentation.SourceLabel(t.Target.Source) · @ApiReviewPresentation.ConfidenceLabel(t.Target.Confidence)</dd></div>
                                                <div><dt>Access</dt><dd>@t.AccessReason</dd></div>
                                                @if (t.RequiredAction is not null) { <div><dt>Next step</dt><dd>@t.RequiredAction</dd></div> }
                                                <div><dt>Operations</dt><dd>@t.Operations.Count(o => o.Executed) of @t.Operations.Count executed (read-only)</dd></div>
                                            </dl>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
            else if (_tab is "REST" or "GraphQL")
            {
                var type = _tab == "REST" ? ApiReviewTargetType.Rest : ApiReviewTargetType.GraphQl;
                var targets = report.Targets.Where(t => t.Target.ApiType == type).ToList();
                @if (targets.Count == 0) { <p class="aqr-empty">No @_tab targets in this review.</p> }
                else if ((type == ApiReviewTargetType.Rest ? ApiReviewPostRunPresentation.Rest(report) : ApiReviewPostRunPresentation.GraphQl(report)) is { } protocol)
                {
                    <section class="aqr-card aqr-protocol-summary" data-testid="aqr-protocol-summary" data-protocol="@_tab" aria-labelledby="aqr-protocol-heading">
                        <div class="aqr-card-head"><h3 id="aqr-protocol-heading">@_tab review</h3><span class="aqr-pill aqr-pill-@(protocol.ReviewState == "Reviewed" ? "muted" : "warning")" data-testid="aqr-protocol-state">@protocol.ReviewState</span></div>
                        <dl class="aqr-dl aqr-protocol-facts">@foreach (var (label, value) in protocol.Facts) { <div><dt>@label</dt><dd>@value</dd></div> }</dl>
                        @if (protocol.Note is { } protocolNote) { <p class="aqr-muted" data-testid="aqr-protocol-note">@protocolNote</p> }
                        <p class="aqr-muted" data-testid="aqr-reviewed-help">@ApiReviewEvidencePresentation.ReviewedHelp</p>
                    </section>
                }
                var allOperations = targets.SelectMany(t => type == ApiReviewTargetType.GraphQl ? t.Operations.Where(o => o.Executed) : t.Operations).ToList();
                var shownOperations = allOperations.Count(OperationShown);
                var notCompleted = targets.Where(t => t.Status is not ApiReviewTargetStatus.Completed).ToList();
                @if (allOperations.Count > 0 || notCompleted.Count > 0)
                {
                    <div class="aqr-op-toolbar" role="group" aria-label="@($"Find {_tab} operations")" data-testid="aqr-op-toolbar">
                        @if (allOperations.Count > 0)
                        {
                            <input type="search" class="form-control aqr-op-search" placeholder="Search operations…" aria-label="Search operations" data-testid="aqr-op-search"
                                   value="@_operationSearch" @oninput="e => _operationSearch = e.Value?.ToString() ?? string.Empty" />
                            <select class="form-control aqr-op-view" aria-label="Show operations" data-testid="aqr-op-view" value="@_operationView" @onchange="e => _operationView = e.Value?.ToString() ?? OperationViewAll">
                                <option value="@OperationViewAll">All operations</option>
                                <option value="@OperationViewAttention">Needs attention (failed check, issue or error status)</option>
                                <option value="@OperationViewNotExecuted">Not executed</option>
                            </select>
                            <span class="aqr-muted" role="status" data-testid="aqr-op-count">Showing @shownOperations of @allOperations.Count operations</span>
                            @if (_operationSearch.Length > 0 || _operationView != OperationViewAll)
                            {
                                <button type="button" class="aqr-link-button" data-testid="aqr-op-clear" @onclick="ClearOperationFilters">Clear</button>
                            }
                        }
                        @if (notCompleted.Count > 0)
                        {
                            @* Blocked or partly reviewed services first: their cards hold the reason and the next step. *@
                            <span class="aqr-op-jump" data-testid="aqr-op-jump">Not fully reviewed:
                                @foreach (var nc in notCompleted)
                                {
                                    <button type="button" class="aqr-link-button" data-testid="aqr-op-jump-target" data-target-id="@nc.Target.TargetId"
                                            @onclick="() => FocusTarget(nc.Target.TargetId)">@ApiReviewPresentation.DisplayName(nc.Target) (@ApiReviewStatusLabels.Label(ApiReviewStatusLabels.Of(nc)))</button>
                                }
                            </span>
                        }
                    </div>
                }
                @foreach (var t in targets)
                {
                    var status = ApiReviewStatusLabels.Of(t);
                    <div class="aqr-card aqr-target-result" data-testid="aqr-target-result" data-target-id="@t.Target.TargetId" id="@($"aqr-target-{t.Target.TargetId}")" tabindex="-1">
                        <div class="aqr-card-head">
                            <h3>@ApiReviewPresentation.DisplayName(t.Target) <span class="aqr-mono aqr-muted aqr-target-result-url">@t.Target.Url</span></h3>
                            <span class="aqr-pill aqr-pill-@ApiReviewStatusLabels.Tone(status)">@ApiReviewStatusLabels.Label(status)</span>
                        </div>
                        <p class="aqr-muted"><strong>Access:</strong> @ApiReviewStatusLabels.AccessLabel(t.AccessMode) — @t.AccessReason @if (t.RequiredAction is not null) { <strong>Next step:</strong> @t.RequiredAction }</p>
                        @* Compact contract/schema status only; the explanation, baseline and drift are owned by Contracts. *@
                        <p class="aqr-contract-badge" data-testid="aqr-contract-badge">
                            <strong>@(type == ApiReviewTargetType.Rest ? "Contract" : "Schema"):</strong>
                            @if (t.Contract is { } contract)
                            {
                                <span class="aqr-state aqr-state-@contract.Status.ToString().ToLowerInvariant()">@ApiReviewEvidencePresentation.ContractState(contract)</span>
                                @if (type == ApiReviewTargetType.GraphQl && contract.Note is { Length: > 0 }) { <span class="aqr-muted"> — @contract.Note</span> }
                            }
                            else { <span class="aqr-state">@(type == ApiReviewTargetType.Rest ? "No contract" : "Not assessed")</span> }
                            <button type="button" class="aqr-link-button" data-testid="aqr-view-contract" @onclick='() => _tab = "Contracts"'>View contract details</button>
                        </p>
                        @{
                            // For GraphQL the review's own safe requests and the observed business operations are different
                            // sets; each is rendered once. Observed operations live in the observed-operations table below.
                            var requestRows = type == ApiReviewTargetType.GraphQl ? t.Operations.Where(o => o.Executed).ToList() : t.Operations;
                        }
                        @if (requestRows.Count > 0)
                        {
                            <h4 class="aqr-group-title">@(type == ApiReviewTargetType.GraphQl ? "Review requests executed" : "Operations")</h4>
                            @RenderOperations(t, requestRows)
                        }
                        @if (type == ApiReviewTargetType.GraphQl) { @RenderObservedOperations(t) }
                        @RenderChecks(t.Checks.Concat(t.Operations.SelectMany(o => ApiReviewEvidencePresentation.OperationChecks(o).Select(c => c with { Title = $"{o.Display}: {c.Title}" }))).ToList(), null)
                        @RenderFindingSummary(report.Findings.Where(f => f.TargetId == t.Target.TargetId).ToList(), "for this service", () => ShowFindings(service: t.Target.TargetId))
                    </div>
                }
            }
            else if (_tab == "Findings")
            {
                @RenderFindings(report)
            }
            else
            {
                var areas = _tab switch
                {
                    "Contracts" => new[] { ApiReviewFindingType.Contract, ApiReviewFindingType.Documentation, ApiReviewFindingType.Drift },
                    "Security" => new[] { ApiReviewFindingType.Security, ApiReviewFindingType.AccessControl },
                    "Errors" => new[] { ApiReviewFindingType.Errors },
                    _ => new[] { ApiReviewFindingType.Performance },
                };
                var domainChecks = ApiReviewPresentation.DomainChecks(report, areas);
                @if (_tab == "Security")
                {
                    <p class="aqr-scope-note" data-testid="aqr-security-note">@ApiReviewPresentation.SecurityLead</p>
                    <ReviewDisclosure Text="About these security checks" CollapseText="Hide about these security checks" TestId="aqr-security-about" Class="disclosure-inline disclosure-small">
                        <p class="aqr-muted" data-testid="aqr-security-scope">@ApiReviewPresentation.SecurityScopeNote</p>
                        <p class="aqr-muted" data-testid="aqr-runtime-security-warning">@BirkNext.RuntimeSecurity.RuntimeSecurityWording.NotAPenetrationTest</p>
                    </ReviewDisclosure>
                    @RenderSecurityEvidence(report)
                    <section class="aqr-subsection" aria-labelledby="aqr-security-checks-heading">
                        <h3 id="aqr-security-checks-heading">All security checks</h3>
                        @RenderChecks(domainChecks, areas)
                    </section>
                }
                else if (_tab == "Performance")
                {
                    @if (limitationRows.FirstOrDefault(l => l.Key == "performance") is { } sample)
                    {
                        <p class="aqr-scope-note aqr-scope-note-strong" role="note" data-testid="aqr-performance-sample"><strong>@sample.Reason</strong></p>
                    }
                    <p class="aqr-scope-note aqr-scope-note-strong" data-testid="aqr-performance-note">@ApiReviewPresentation.PerformanceScopeNote</p>
                    @* Ownership: AQR observes single-request latency only; acceptance-level performance is owned elsewhere and never implied here. *@
                    <p class="aqr-muted" data-testid="aqr-performance-ownership"><strong>Owned here:</strong> single-request latency observations from this review's own requests.
                        <strong>Not owned here:</strong> load testing, workload behaviour, API response Warning/Poor thresholds and performance acceptance criteria — those belong to
                        <a href="/performance-test-review" data-testid="aqr-performance-owner-link">Performance Test Review</a> and Performance Quality. Nothing on this tab implies load-test acceptance.</p>
                    @* The thresholds THIS review was evaluated with, from its own policy snapshot — never today's settings. *@
                    <p class="aqr-muted" data-testid="aqr-performance-thresholds">@ApiReviewPresentation.PerformanceThresholdsNote(report.Policy)</p>
                    <dl class="aqr-dl aqr-protocol-facts" data-testid="aqr-performance-summary">
                        @foreach (var (label, value) in ApiReviewPostRunPresentation.Performance(report)) { <div><dt>@label</dt><dd>@value</dd></div> }
                    </dl>
                    <ReviewDisclosure Text="Performance policy used" CollapseText="Hide performance policy" Hint="@ApiReviewPresentation.ProfileLabel(report.Policy.PerformanceProfile)" TestId="aqr-performance-policy" Class="disclosure-inline disclosure-small">
                        <dl class="aqr-dl aqr-performance-policy" data-testid="aqr-performance-policy-list">
                            @foreach (var (label, value) in ApiReviewPresentation.PerformancePolicy(report.Policy))
                            {
                                <div><dt>@label</dt><dd>@value</dd></div>
                            }
                        </dl>
                    </ReviewDisclosure>
                    @RenderChecks(domainChecks, areas, evidenceInDetails: true)
                }
                else if (_tab == "Contracts")
                {
                    @RenderContracts(report, domainChecks, areas)
                }
                else
                {
                    @* Errors: observed errors (failures and warnings of executed checks) are kept apart from checks that were not executed. *@
                    <section class="aqr-subsection" aria-labelledby="aqr-errors-heading" data-testid="aqr-errors">
                        <h3 id="aqr-errors-heading">Error handling</h3>
                        <p class="aqr-muted" data-testid="aqr-errors-intro">How the reviewed services answer unknown routes, unsupported methods and failures, from the review's own read-only requests. A check that was not executed is Not tested — never a failure and never a pass.</p>
                        @if (domainChecks.Count == 0)
                        {
                            <p class="aqr-empty" data-testid="aqr-errors-empty">No error-handling check ran in this review, so error handling is Not assessed.</p>
                        }
                        else
                        {
                            <ul class="aqr-errors-counts" data-testid="aqr-errors-counts" aria-label="Error-handling checks by result">
                                <li data-result="Fail">Observed failures: @domainChecks.Count(c => c.Result == ApiReviewCheckResult.Fail)</li>
                                <li data-result="Warning">Warnings: @domainChecks.Count(c => c.Result == ApiReviewCheckResult.Warning)</li>
                                <li data-result="Pass">No issue observed: @domainChecks.Count(c => c.Result == ApiReviewCheckResult.Pass)</li>
                                <li data-result="NotTested">Not tested (not executed): @domainChecks.Count(c => c.Result is ApiReviewCheckResult.NotTested or ApiReviewCheckResult.Blocked)</li>
                            </ul>
                            @RenderChecks(domainChecks, areas)
                        }
                    </section>
                }
                @RenderFindingSummary(report.Findings.Where(f => areas.Contains(f.Type)).ToList(), "in this area", () => ShowFindings(area: _tab))
            }
            </div>

            @*
                ── 3. Technical & execution details: how this review ran. One collapsed section, Overview only.
            *@
            @if (_tab == "Overview")
            {
                <section class="aqr-section aqr-details" data-testid="aqr-result-details" aria-labelledby="aqr-result-details-heading">
                    <h2 id="aqr-result-details-heading" class="aqr-visually-hidden" tabindex="-1" @ref="_reviewDetailsHeading">Technical &amp; execution details</h2>
                    <ReviewDisclosure Text="Technical &amp; execution details" CollapseText="Hide technical &amp; execution details" Hint="Read-only policy, authentication, API targets, technical limitations" TestId="aqr-technical" Class="aqr-diagnostics">
                        <ReviewDisclosure Text="Shared quality evidence" CollapseText="Hide shared quality evidence" Hint="API, security and performance evidence from the same requests" TestId="aqr-quality-evidence" Class="aqr-detail-disclosure" @bind-Expanded="_qualityEvidenceExpanded">
                            @if (_qualityEvidenceExpanded) { <QualityEvidenceSummary ProfileId="@(_context?.ActiveProfile.Id ?? "")" ApiReport="report" /> }
                        </ReviewDisclosure>
                        <ReviewDisclosure Text="@ApiReviewPresentation.ReadOnlyTitle" CollapseText="Hide read-only review" Hint="No write operations executed" TestId="aqr-readonly" Class="aqr-detail-disclosure">
                            <p data-testid="aqr-readonly-summary">@ApiReviewPresentation.ReadOnlySummary</p>
                            @if (report.Coverage.UnsafeOperationsNotExecuted > 0)
                            {
                                <p class="aqr-muted" data-testid="aqr-unsafe-count">@report.Coverage.UnsafeOperationsNotExecuted write @(report.Coverage.UnsafeOperationsNotExecuted == 1 ? "operation was" : "operations were") observed and not executed. Not executing them says nothing about whether they are safe.</p>
                            }
                        </ReviewDisclosure>
                        <ReviewDisclosure Text="Authentication details" CollapseText="Hide authentication details" Hint="@ApiReviewAccessAvailabilities.Label(access.Availability)" TestId="aqr-access-details" Class="aqr-detail-disclosure">
                            <ApiReviewAccessDetails Access="@ApiReviewPresentation.AccessPanel(_context, report.Access, report.Targets.Select(t => t.Target).ToList(), report.Targets.Select(t => t.Target.TargetId).ToList())" />
                        </ReviewDisclosure>
                        <ReviewDisclosure Text="API targets" CollapseText="Hide API targets" Hint="@ScopeHint(scope)" TestId="aqr-targets-disclosure" Class="aqr-detail-disclosure">
                            <ApiReviewTargetPicker Targets="@(report.Targets.Select(t => t.Target).ToList())" Selected="@(report.Targets.Select(t => t.Target.TargetId).ToList())" ReadOnly="true" />
                        </ReviewDisclosure>
                        <ReviewDisclosure Text="Technical limitations" CollapseText="Hide technical limitations" Hint="@($"{report.Limitations.Count}")" TestId="aqr-limitations-technical" Class="aqr-detail-disclosure">
                            <ul class="aqr-list aqr-muted" data-testid="aqr-limitations-list">@foreach (var l in report.Limitations) { <li>@l</li> }</ul>
                        </ReviewDisclosure>
                    </ReviewDisclosure>
                </section>
            }
        </section>
    }
</div>

@code {
    private bool _canonicalExpanded;
    private static readonly string[] Tabs = ["Overview", "REST", "GraphQL", "Contracts", "Security", "Errors", "Performance", "Findings"];

    private FrontendAnalysisContext? _context;
    private AuthenticatedReviewCapabilities? _capabilities;
    private List<ApiReviewTarget> _targets = [];
    private IReadOnlyDictionary<string, GraphQlSchemaArtifact> _schemaArtifacts = new Dictionary<string, GraphQlSchemaArtifact>();
    /// <summary>REST contract per target, resolved from existing evidence (configured URL, then Source Analysis contract evidence). Never copied.</summary>
    private IReadOnlyDictionary<string, ApiReviewContractBinding> _contractBindings = new Dictionary<string, ApiReviewContractBinding>();

    /// <summary>Resolves REST contracts from this environment's Source Analysis snapshots (read-only); failure leaves configured/none bindings.</summary>
    private async Task<IReadOnlyDictionary<string, ApiReviewContractBinding>> LoadContractBindingsCoreAsync(FrontendAnalysisContext context, IReadOnlyList<ApiReviewTarget> targets)
    {
        var snapshots = (IReadOnlyList<BirkNext.Integrations.IqrSourceSnapshot>)[];
        if (targets.Any(t => t.ApiType == ApiReviewTargetType.Rest) && ServiceProvider.GetService<IIntegrationCatalogApiService>() is { } api)
        {
            try
            {
                var withOpenApi = (await api.ListSourceSnapshotSummariesAsync(context.ActiveProfile.Id)).Where(s => s.OpenApiContracts > 0).ToList();
                snapshots = [.. (await Task.WhenAll(withOpenApi.Select(s => api.GetSourceSnapshotAsync(s.Id)))).OfType<BirkNext.Integrations.IqrSourceSnapshot>()];
            }
            catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException or InvalidOperationException) { snapshots = []; }
        }
        return targets.Where(t => t.ApiType == ApiReviewTargetType.Rest)
            .ToDictionary(t => t.TargetId, t => ApiReviewContractBindings.Resolve(t, snapshots), StringComparer.Ordinal);
    }
    private string? _schemaArtifactsError;
    private readonly HashSet<string> _selected = new(StringComparer.Ordinal);
    private readonly HashSet<string> _expandedServices = new(StringComparer.Ordinal);
    private readonly HashSet<string> _expandedFindings = new(StringComparer.Ordinal);
    private ApiReviewHistory? _history;
    private ApiReviewReport? _report;
    private bool _running;
    private bool _schemaArtifactsExpanded;
    private bool _runtimeObservationsExpanded;

    /// <summary>"12 observed requests on 2 REST targets · Endpoint Discovery · not verified" — observed is never verified.</summary>
    private static string RuntimeObservationsHint(IReadOnlyList<ApiReviewTarget> rest)
    {
        var observed = rest.SelectMany(t => t.Operations).Count(o => o.Source == ApiReviewTargetSource.DiscoveredTraffic && o.OperationType == BirkNext.LocalHttpsProxy.GraphQlOperationType.None);
        return rest.Count == 0 ? "No REST target selected"
            : observed == 0 ? "No runtime request observed for the selected REST targets"
            : $"{observed} observed request{(observed == 1 ? "" : "s")} on {rest.Count} REST target{(rest.Count == 1 ? "" : "s")} · Endpoint Discovery · not verified";
    }
    /// <summary>The selection picker opens only when nothing is selected; the target cards above it are the primary detail.</summary>
    private bool _targetsExpanded;
    private bool _diagnosticsExpanded;
    private bool _focusSchemaArtifacts;
    private ElementReference _schemaArtifactsElement;
    private ApiFuzzingLevel _fuzzingLevel = ApiFuzzingLevel.Off;
    private bool _activeChecksExpanded;
    private bool _fuzzingExpanded;
    private bool _focusFuzzing;
    private ElementReference _fuzzingConfigElement;

    /// <summary>Opens the ONE safe fuzzing configuration (the panel below) and moves focus to it; the card holds no second setting.</summary>
    private void OpenFuzzingConfiguration()
    {
        _activeChecksExpanded = true;
        _fuzzingExpanded = true;
        _focusFuzzing = true;
    }

    /// <summary>Warning when checks exist but are not ready; ready when some can run; neutral when none apply. Text always carries it.</summary>
    private string AuthorizationTone => _authorizationChecks.Available == 0 ? "neutral"
        : _authorizationChecks.Ready == _authorizationChecks.Available ? "ready"
        : _authorizationChecks.Ready > 0 ? "ready" : "warning";
    private string FuzzingHint => $"{ApiFuzzingPresentation.LevelLabel(_fuzzingLevel)} · optional";
    /// <summary>Configured and suggested authorization checks for the selected targets, with per-check readiness (recomputed on every render).</summary>
    private AuthorizationCheckSummary _authorizationChecks => AuthorizationCheckCatalog.Build(
        _context?.SecuritySettings.RuntimeSecurity, _targets.Where(t => _selected.Contains(t.TargetId)).ToList(),
        _authorizationInputs.SourceEndpoints, _authorizationInputs.PackExpectations, _authorizationPermission.Permitted, _authorizationPermission.Reason);
    private AuthorizationCheckInputs _authorizationInputs = AuthorizationCheckInputs.Empty;
    private BirkNext.RuntimeSecurity.SecurityExecutionStatus? _securityExecution;
    private (bool? Permitted, string? Reason) _authorizationPermission => AuthorizationCheckInputsLoader.ExecutionPermission(_context, _securityExecution);
    /// <summary>Optional checks never block the read-only review; said in words beside their state.</summary>
    private string AuthorizationImpact => _authorizationChecks.Ready > 0
        ? "Optional · runs only when started · does not block read-only API review."
        : "Not run · does not block read-only API review.";
    private string _progressMessage = "";
    private string? _errorMessage;
    private string _tab = "Overview";
    [SupplyParameterFromQuery(Name = "tab")] public string? TabParam { get; set; }
    private string? _urlTab;

    protected override void OnParametersSet()
    {
        var fromUrl = Tabs.FirstOrDefault(t => string.Equals(t, TabParam, StringComparison.OrdinalIgnoreCase)) ?? "Overview";
        if (_urlTab != fromUrl) { _tab = fromUrl; _urlTab = fromUrl; }
    }

    /// <summary>Writes the result tab to the URL after the user changes it (replace: no history entry per click; other parameters are kept).</summary>
    private void SyncTabToUrl()
    {
        if (_report is null || _urlTab == _tab) return;
        _urlTab = _tab;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("tab", _tab == "Overview" ? null : _tab.ToLowerInvariant()), replace: true);
    }
    private string? _requestedTargetId;
    private List<string>? _requestedSelection;

    /// <summary>Execution permission and suggestion evidence for authorization checks. Optional: a missing backend leaves both unknown.</summary>
    private async Task<(BirkNext.RuntimeSecurity.SecurityExecutionStatus? Security, AuthorizationCheckInputs Inputs)> LoadAuthorizationInputsCoreAsync(
        FrontendAnalysisContext context, IReadOnlyList<ApiReviewTarget> targets)
    {
        BirkNext.RuntimeSecurity.SecurityExecutionStatus? security;
        try { security = await ReviewService.GetSecurityExecutionAsync(context.ActiveProfile.Id); }
        catch (Exception e) when (e is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { security = null; }
        return (security, await new AuthorizationCheckInputsLoader(ServiceProvider).LoadAsync(context.ActiveProfile.Id, targets));
    }

    /// <summary>This page's URL with the current API selection, so browser Back and "Back to API Quality Review" restore it.</summary>
    private string SelectionUrl() =>
        $"/api-quality-review?targets={Uri.EscapeDataString(string.Join(',', _targets.Where(t => _selected.Contains(t.TargetId)).Select(t => t.TargetId)))}";

    /// <summary>Records the selection in this history entry before leaving for the editor (the link itself then navigates).</summary>
    private void RememberSelection() => Navigation.NavigateTo(SelectionUrl(), replace: true);

    private ApiReviewRunEligibility Eligibility => ApiReviewRunEligibility.Evaluate(_context, _targets, _selected, _capabilities, _authentication?.Effective);

    protected override async Task OnInitializedAsync()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (query.TryGetValue("target", out var requested)) _requestedTargetId = requested.ToString();
        if (query.TryGetValue("targets", out var selection))
            _requestedSelection = selection.ToString().Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        _report = RuntimeReviews.ApiQualityReview.Report;
        await AssessAsync();
    }

    // ── Readiness assessment ─────────────────────────────────────────────────────────────────────────────────────────
    // One generation at a time: a newer assessment (Refresh readiness, Retry) cancels the older one, and only the current generation commits.
    // Everything the decision renders is computed into locals and committed together, so no render ever mixes a half-loaded state; until the
    // first commit the page shows staged progress — never Blocked. A refresh keeps the last assessed readiness visible ("Refreshing evidence…").
    private static readonly (string Key, string Label)[] AssessmentStages =
    [
        ("target", "Loading target"), ("evidence", "Loading API evidence"), ("correlate", "Correlating runtime observations"),
        ("auth", "Evaluating authentication"), ("capabilities", "Evaluating review capabilities"), ("contracts", "Loading contract bindings"),
        ("authorization", "Loading authorization checks"), ("readiness", "Calculating readiness"),
    ];
    private int _generation;
    private ReviewAssessment? _assessment;
    private bool _evaluated, _assessing;
    private string? _assessmentError;
    private RuntimeEvidence? _runtime;

    private async Task AssessAsync()
    {
        _assessment?.Cancel();
        var a = new ReviewAssessment(++_generation, AssessmentStages);
        _assessment = a;
        _assessing = true;
        _assessmentError = null;
        void Changed() { if (_generation == a.Generation) _ = InvokeAsync(StateHasChanged); }
        try
        {
            await History.LoadAsync(JS);
            var context = await a.StageAsync("target", _ => ContextFactory.GetActiveContextAsync(), Changed);
            if (!a.IsCurrent(_generation)) return;
            if (context.ActiveTargetError is not null)
            {
                foreach (var key in AssessmentStages.Skip(1).Select(s => s.Key)) a.Skip(key, "no active target");
                Commit(a, context, null, [], null, (new Dictionary<string, GraphQlSchemaArtifact>(), null), new Dictionary<string, ApiReviewContractBinding>(), (null, AuthorizationCheckInputs.Empty));
                return;
            }
            RuntimeEvidence? runtime = null;
            try
            {
                runtime = await a.StageAsync("evidence", ct => RuntimeEvidenceLoader.LoadAsync(Discovery, JS, ServiceProvider.GetService<ILocalHttpsProxyApiService>(),
                    ServiceProvider.GetService<IEndpointObservationHistoryApiService>(), context.ActiveProfile.Id, context.ReviewIdentity?.ContextFingerprint, context.TargetUrl, ct),
                    Changed, r => r.Available ? $"{r.ApiObservations} observed" : "none observed");
            }
            catch (Exception ex) when (ex is not OperationCanceledException || !a.Cancelled)
            {
                // Optional evidence: the review continues with configured targets; with none, readiness is "could not be assessed", never Blocked.
                Log(a, $"runtime evidence failed: {ex.GetType().Name}");
            }
            if (!a.IsCurrent(_generation)) return;
            var targets = await a.StageAsync("correlate", _ => Task.FromResult(ApiReviewTargetResolver.Resolve(context, runtime?.Snapshot ?? new EndpointDiscoverySnapshot())), Changed,
                t => $"{t.Count} API target{(t.Count == 1 ? "" : "s")}");
            if (runtime is null && targets.Count == 0)
            {
                Fail(a, "Runtime evidence could not be assessed, so the API targets are unknown. Nothing was evaluated as blocked.");
                return;
            }
            var identity = context.ReviewIdentity ?? ReviewAuthenticationIdentity.ForContext(context);
            var capabilities = await a.StageAsync("auth", async ct =>
            {
                try { return await Capabilities.ResolveAsync(identity, ct); }
                catch (Exception ex) when (ex is not OperationCanceledException || !a.Cancelled)
                {
                    return new AuthenticatedReviewCapabilities { Method = identity.Method, PublicApi = true, Reason = "Authenticated capabilities could not be resolved; public targets only." };
                }
            }, Changed);
            var schemas = await a.StageAsync("capabilities", _ => LoadSchemaArtifactsCoreAsync(context, targets), Changed);
            var bindings = await a.StageAsync("contracts", _ => LoadContractBindingsCoreAsync(context, targets), Changed);
            var authorization = await a.StageAsync("authorization", _ => LoadAuthorizationInputsCoreAsync(context, targets), Changed);
            if (!a.IsCurrent(_generation)) return;
            await a.StageAsync("readiness", _ => Task.FromResult(true), Changed);
            Commit(a, context, runtime, targets, capabilities, schemas, bindings, authorization);
        }
        catch (OperationCanceledException) when (a.Cancelled) { }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException or InvalidOperationException or Microsoft.JSInterop.JSException)
        {
            Fail(a, $"The review evidence could not be loaded ({ex.GetType().Name}). Nothing was evaluated as blocked.");
        }
        finally
        {
            // The step list ends with the operation: steps an early outcome made unnecessary read "skipped", never "pending" or Running.
            a.Finish();
            if (_generation == a.Generation) _assessing = false;
            Log(a, $"assessment {(a.Cancelled ? "cancelled" : "finished")} in {a.Elapsed.TotalMilliseconds:0} ms: "
                + string.Join(", ", a.Stages.Select(s => $"{s.Key}={s.State}{(s.Duration is { } d ? $"/{d.TotalMilliseconds:0}ms" : "")}")));
        }
    }

    private void Fail(ReviewAssessment a, string message)
    {
        if (!a.IsCurrent(_generation)) return;
        _assessmentError = message;
    }

    /// <summary>The one atomic commit of an evaluated assessment; the current selection is kept where its targets still exist.</summary>
    private void Commit(ReviewAssessment a, FrontendAnalysisContext context, RuntimeEvidence? runtime, List<ApiReviewTarget> targets, AuthenticatedReviewCapabilities? capabilities,
        (IReadOnlyDictionary<string, GraphQlSchemaArtifact> Artifacts, string? Error) schemas, IReadOnlyDictionary<string, ApiReviewContractBinding> bindings,
        (BirkNext.RuntimeSecurity.SecurityExecutionStatus? Security, AuthorizationCheckInputs Inputs) authorization)
    {
        if (!a.IsCurrent(_generation)) return;
        var selected = new List<string>();
        if (_evaluated && _selected.Count > 0 && _selected.All(id => targets.Any(t => t.TargetId == id))) selected.AddRange(_selected);
        else
        {
            // A selection carried in the URL (returning from a deep link, or browser Back) wins over the default selection.
            var restored = _requestedSelection?.Where(id => targets.Any(t => t.TargetId == id)).ToList();
            if (restored is { Count: > 0 }) selected.AddRange(restored);
            else selected.AddRange(targets.Where(t => t.Selected).Select(t => t.TargetId));
            if (_requestedTargetId is not null && targets.Any(t => t.TargetId == _requestedTargetId)) selected.Add(_requestedTargetId);
        }
        _context = context;
        _runtime = runtime;
        _history = context.ActiveTargetError is null ? History.For(context.ActiveProfile.Id) : null;
        // The last report is the current result only for the same environment AND the same target it reviewed; after the Target Environment's URL
        // changed it stays in History, never shown as the result for the new target.
        var fromSession = _report is not null;
        _report ??= _history?.LastReport is { } last && last.Environment.EnvironmentId == context.ActiveProfile.Id
            && (string.IsNullOrEmpty(last.Environment.TargetUrl) // a report saved before the target was recorded: legacy, kept
                || string.Equals(last.Environment.TargetUrl.TrimEnd('/'), context.TargetUrl?.TrimEnd('/'), StringComparison.OrdinalIgnoreCase)) ? last : null;
        _reportFromHistory = !fromSession && _report is not null;
        _targets = targets;
        _capabilities = capabilities;
        (_schemaArtifacts, _schemaArtifactsError) = schemas;
        _contractBindings = bindings;
        (_securityExecution, _authorizationInputs) = authorization;
        _selected.Clear();
        foreach (var id in selected) _selected.Add(id);
        if (!_evaluated) _targetsExpanded = _selected.Count == 0;
        _evaluated = true;
    }

    private void Log(ReviewAssessment a, string message) =>
        (ServiceProvider.GetService(typeof(ILogger<ApiQualityReview>)) as ILogger)?.LogInformation("API Quality Review readiness (generation {Generation}): {Message}", a.Generation, message);

    /// <summary>Before the first evaluated snapshot: the shared staged progress (OperationProgress — delayed, compact, then every step; never
    /// red), or "Readiness could not be fully assessed" with Retry.</summary>
    private RenderFragment AssessingPanel() => __builder =>
    {
        var failed = _assessmentError is not null && !_assessing;
        <OperationProgress Title="Assessing API review readiness…" Stages="@(_assessment?.Stages ?? [])" Error="@(failed ? _assessmentError : null)"
                           FailedTitle="@ReviewDecisions.FailedTitle" OnRetry="AssessAsync" Kicker="Run decision" HeadingId="aqr-readiness-heading"
                           Class="@($"aqr-card aqr-decision aqr-readiness aqr-readiness-{(failed ? "failed" : "assessing")}")"
                           TestId="aqr-readiness" StagesTestId="aqr-assessment-stages" StageTestId="aqr-assessment-stage"
                           ErrorTestId="aqr-assessment-error" RetryTestId="aqr-assessment-retry"
                           data-readiness="@(failed ? "FailedToAssess" : "Assessing")" data-decision="@(failed ? ReviewDecision.FailedToAssess : ReviewDecision.Assessing)" />
    };

