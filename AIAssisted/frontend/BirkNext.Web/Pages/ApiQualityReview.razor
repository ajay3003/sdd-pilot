    /// <summary>
    /// The check table (Error handling is the reference pattern: Area · Check · Result · Detail · Evidence). With
    /// <paramref name="evidenceInDetails"/> the evidence column folds into a per-row disclosure so a single-area tab stays narrow.
    /// </summary>
    private RenderFragment RenderChecks(IReadOnlyList<ApiReviewCheck> checks, ApiReviewFindingType[]? areas, bool evidenceInDetails = false) => __builder =>
    {
        if (checks.Count == 0) return;
        <details class="aqr-checks" open="@(areas is not null)">
            <summary>@ApiReviewEvidencePresentation.CheckSummary(checks, _report!.Policy)</summary>
            <div class="aqr-tablewrap" tabindex="0" role="region" aria-label="Review checks">
                <table class="aqr-table aqr-checks-table" data-testid="aqr-checks-table">
                    @if (evidenceInDetails)
                    {
                        <thead><tr><th scope="col">Check</th><th scope="col">Result</th><th scope="col">Detail</th></tr></thead>
                    }
                    else
                    {
                        <thead><tr><th scope="col">Area</th><th scope="col">Check</th><th scope="col">Result</th><th scope="col">Detail</th><th scope="col">Evidence</th></tr></thead>
                    }
                    <tbody>
                        @foreach (var c in checks)
                        {
                            <tr data-testid="aqr-check-row" data-check-id="@c.CheckId" data-result="@c.Result">
                                @if (!evidenceInDetails) { <td>@ApiReviewStatusLabels.AreaLabel(c.Area)</td> }
                                <td>@ApiReviewEvidencePresentation.CheckTitle(c)</td>
                                <td><span class="aqr-state">@ApiReviewEvidencePresentation.CheckLabel(c, _report!.Policy)</span></td>
                                <td>@ApiReviewEvidencePresentation.CheckDetail(c, _report!.Policy)
                                    @if (evidenceInDetails && c.Evidence.Count > 0)
                                    {
                                        <details class="aqr-inline-evidence" data-testid="aqr-check-evidence"><summary>Evidence (@c.Evidence.Count)</summary><p class="aqr-mono aqr-muted aqr-break">@string.Join(" · ", c.Evidence.Take(8))</p></details>
                                    }
                                </td>
                                @if (!evidenceInDetails) { <td class="aqr-mono aqr-muted aqr-break">@string.Join(" · ", c.Evidence.Take(5))</td> }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </details>
    };

    /// <summary>
    /// Review requests of one service: the summary row keeps the decision columns (operation, execution, status, timing, review
    /// result); content type, payload, contract match and the note open in a detail row.
    /// </summary>
    private RenderFragment RenderOperations(ApiReviewTargetResult t, IReadOnlyList<ApiReviewOperationResult> rows) => __builder =>
    {
        <div class="aqr-tablewrap" tabindex="0" role="region" aria-label="@($"Operations · {ApiReviewPresentation.DisplayName(t.Target)}")">
