    /// <summary>Arrow-key navigation between tabs (WAI-ARIA tabs pattern, manual activation on Enter/Space is the button default).</summary>
    private void OnTabKey(KeyboardEventArgs e, string current)
    {
        var index = Array.IndexOf(Tabs, current);
        var next = e.Key switch
        {
            "ArrowRight" => Tabs[(index + 1) % Tabs.Length],
            "ArrowLeft" => Tabs[(index - 1 + Tabs.Length) % Tabs.Length],
            "Home" => Tabs[0],
            "End" => Tabs[^1],
            _ => current,
        };
        if (next == current) return;
        _tab = next;
        _focusId = $"aqr-tab-btn-{next.ToLowerInvariant()}"; // focus follows the selection (the old tab now has tabindex -1)
    }

