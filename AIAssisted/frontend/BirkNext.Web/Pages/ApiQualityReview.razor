    /// <summary>An executed operation's review in words ("1 issue observed · 0 failed checks"); a skipped one says why it was not executed.</summary>
    private static string OperationReview(ApiReviewOperationResult o, ApiReviewPolicy policy)
    {
        if (!o.Executed) return ApiReviewEvidencePresentation.Execution(o);
        var states = o.Checks.Select(c => ApiReviewStatusTaxonomy.Of(c, policy)).ToList();
        var issues = states.Count(x => x == ApiReviewCanonicalStatus.IssueDetected);
        var failed = o.Checks.Count(c => c.Result == ApiReviewCheckResult.Fail);
        return $"{issues} issue{(issues == 1 ? "" : "s")} observed · {failed} failed check{(failed == 1 ? "" : "s")}";
    }

