    /// <summary>The capability list; when Run is blocked the blocker owns the single corrective action, so capability actions are hidden.</summary>
    private RenderFragment CapabilityList(bool showActions) => __builder =>
    {
        @* Capability-level readiness: each review capability is decided on its own; one that cannot run never blocks the others. *@
        <ul class="aqr-capabilities" data-testid="aqr-capabilities" aria-label="What this review will run">
            @foreach (var cap in ReviewCapabilities)
            {
                <li class="aqr-capability aqr-capability-@(cap.Runs ? "runs" : "skipped")" data-testid="aqr-capability" data-key="@cap.Key" data-state="@cap.State">
                    <span class="aqr-capability-label">@cap.Label</span>
                    <span class="aqr-state aqr-state-@(cap.Runs ? "pass" : "muted")" data-testid="aqr-capability-state">@BirkNext.Web.Services.ApiReviewCapabilities.StateLabel(cap.State)@(cap.Runs ? "" : " · skipped")</span>
                    <span class="aqr-muted aqr-capability-detail">@cap.Detail</span>
                    @if (showActions && cap.ActionText is not null && cap.ActionHref is not null) { <a class="aqr-link" href="@cap.ActionHref" data-testid="aqr-capability-action">@cap.ActionText</a> }
                </li>
