    /// <summary>The selected targets' capability-level readiness (static, public, runtime evidence, active authenticated, authorization).</summary>
    private IReadOnlyList<BirkNext.Web.Services.ApiReviewCapability> ReviewCapabilities =>
        BirkNext.Web.Services.ApiReviewCapabilities.Evaluate(_targets.Where(t => _selected.Contains(t.TargetId)).ToList(), _capabilities, _authentication,
            ApiReviewPresentation.AuthenticationHref(_context), _authorizationPermission.Permitted, _authorizationPermission.Reason, DateTimeOffset.UtcNow);

    /// <summary>Creates the immutable review snapshot from the active environment at Run; settings edited while the review runs never affect it.</summary>
    private async Task RunReview()
    {
        if (_running || _context is null || !Eligibility.Enabled) return;
        _running = true; _errorMessage = null; _progressMessage = "Reviewing selected API targets (read-only)…";
        var context = _context;
        var identity = context.ReviewIdentity ?? ReviewAuthenticationIdentity.ForContext(context);
        // The resolved mode is fixed for the run; it never changes during it.
        var request = BuildRequest(context, identity, _targets, _selected, _history) with { AuthenticationMode = _authentication?.Effective ?? BirkNext.RuntimeAuthentication.RuntimeAuthenticationMode.Auto };
        RuntimeReviews.MarkApiQualityRunning(context);
        StateHasChanged();
        try
        {
            var (report, error) = await ReviewService.RunAsync(request);
            if (error is not null || report is null)
            {
                _errorMessage = error ?? "The review returned no result.";
                RuntimeReviews.MarkApiQualityFailed(context, _errorMessage);
            }
            else
            {
                _report = report;
                _reportFromHistory = false;
                _tab = "Overview";
                _expandedServices.Clear();
                _expandedFindings.Clear();
                RuntimeReviews.SaveApiQualityResult(report, context);
                await History.RecordAsync(JS, context.ActiveProfile.Id, report);
                _history = History.For(context.ActiveProfile.Id);
                // Project activity: the completed review with its own outcome (never "passed"); recording never fails the review.
                if (ServiceProvider.GetService<BirkNext.Web.Services.ProjectActivity.ProjectActivityRecorder>() is { } activity)
                    await activity.RecordAsync(BirkNext.Web.Services.ProjectActivity.ReviewActivity.ApiQuality(report, context.ActiveProfile.Id, context.ActiveProfile.Name));
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Review failed: " + ex.GetType().Name;
            RuntimeReviews.MarkApiQualityFailed(context, _errorMessage);
        }
        finally { _running = false; }
    }

    /// <summary>The review snapshot safe fuzzing analyses and runs with (same targets, identity and environment); null when nothing is selected.</summary>
    private ApiReviewRunRequest? FuzzingReviewRequest()
    {
        if (_context is null || _context.ActiveTargetError is not null || _selected.Count == 0) return null;
        var identity = _context.ReviewIdentity ?? ReviewAuthenticationIdentity.ForContext(_context);
        return BuildRequest(_context, identity, _targets, _selected, _history);
    }

    /// <summary>
    /// Security tab evidence, grouped: a compact summary, then Authentication, CORS, Headers and Documentation exposure as
    /// subsections. Authentication enforcement is the deliberate anonymous probe — authentication only, never authorization.
    /// </summary>
    private RenderFragment RenderSecurityEvidence(ApiReviewReport report) => __builder =>
    {
        <dl class="aqr-security-summary" data-testid="aqr-security-summary">
            @foreach (var (key, title, value) in ApiReviewPresentation.SecuritySummary(report))
            {
                <div data-testid="aqr-security-summary-item" data-key="@key">
                    <dt>@if (SecuritySection(key) is { } section) { <button type="button" class="aqr-link-button" data-testid="aqr-security-summary-link" @onclick="() => _focusId = section">@title</button> } else { @title }</dt>
                    <dd>@value</dd>
                </div>
            }
        </dl>
        <p class="aqr-muted" data-testid="aqr-security-evidence-kind"><strong>Evidence kind:</strong> runtime observations from the review's own read-only requests. No static source analysis is part of this review, and authentication observed is not authorization verified.</p>
        <p class="aqr-muted" data-testid="aqr-security-manual"><strong>Manual assessment:</strong> authorization between roles and tenants is a manual review obligation; its recorded decision and history are kept once, in
            <button type="button" class="aqr-link-button" data-testid="aqr-security-manual-link" @onclick='() => { _tab = "Overview"; _focusId = "aqr-manual-heading"; }'>Overview → Manual review</button>. A recorded decision never changes these results.</p>
        var enforcement = report.Targets.Where(t => t.AuthenticationEnforcement is not null).ToList();
        <section class="aqr-subsection" data-testid="aqr-security-authentication" aria-labelledby="aqr-sec-auth-h">
            <h3 id="aqr-sec-auth-h" tabindex="-1">Authentication enforcement</h3>
            <p class="aqr-muted" data-testid="aqr-auth-enforcement-note">One safe read-only request per authenticated target is repeated without any credential. Unauthenticated access rejected as expected confirms that authentication is required. It does not verify authorization correctness between identities or roles.</p>
            <p class="aqr-muted" data-testid="aqr-authorization-correctness"><strong>Authorization correctness:</strong> Not validated by this review — it needs explicit authorization checks with identity expectations.</p>
            @if (enforcement.Count == 0) { <p class="aqr-empty">No selected target requires authentication, so enforcement was not probed.</p> }
            else
            {
                <div class="aqr-tablewrap" tabindex="0" role="region" aria-label="Authentication enforcement">
                    <table class="aqr-table" data-testid="aqr-auth-enforcement">
                        <thead><tr><th scope="col">Service</th><th scope="col">Result</th><th scope="col">Anonymous probe</th><th scope="col">Detail</th></tr></thead>
                        <tbody>
                            @foreach (var t in enforcement)
                            {
                                var e = t.AuthenticationEnforcement!;
                                <tr data-testid="aqr-auth-enforcement-row" data-status="@e.Status">
                                    <td>@ApiReviewPresentation.DisplayName(t.Target)</td>
                                    <td><span class="aqr-state aqr-state-@ApiFuzzingPresentation.EnforcementTone(e.Status)">@ApiFuzzingPresentation.EnforcementLabel(e.Status)</span></td>
                                    <td class="aqr-mono aqr-break">@(e.Probe ?? "—")@if (e.StatusCode is { } httpStatus) { <span class="aqr-muted"> → HTTP @httpStatus</span> }</td>
                                    <td>@e.Reason</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        var corsTargets = report.Targets.Where(t => t.CorsProbes.Count > 0).ToList();
        <section class="aqr-subsection" data-testid="aqr-security-cors" aria-labelledby="aqr-sec-cors-h">
            <h3 id="aqr-sec-cors-h" tabindex="-1">CORS</h3>
            <p class="aqr-muted">Anonymous preflights from the frontend origin, configured allowed origins and one synthetic foreign origin (@BirkNext.RuntimeSecurity.CorsProbeRules.ForeignOrigin — never a real external site). This is the observed configuration: browser enforcement was not exercised. No CORS headers is not a network failure and not a finding by itself.</p>
            @if (corsTargets.Count == 0) { <p class="aqr-empty">No CORS preflights recorded for this review.</p> }
            @foreach (var t in corsTargets)
            {
                <div class="aqr-tablewrap" tabindex="0" role="region" aria-label="@($"CORS · {ApiReviewPresentation.DisplayName(t.Target)}")">
                    <table class="aqr-table" data-testid="aqr-cors-matrix" data-target-id="@t.Target.TargetId">
                        <caption class="aqr-table-caption">@ApiReviewPresentation.DisplayName(t.Target)</caption>
                        <thead><tr><th scope="col">Origin</th><th scope="col">Allow-Origin</th><th scope="col">Credentials</th><th scope="col">Assessment</th><th scope="col"><span class="aqr-visually-hidden">Details</span></th></tr></thead>
                        <tbody>
                            @for (var i = 0; i < t.CorsProbes.Count; i++)
                            {
                                var o = t.CorsProbes[i];
                                var key = $"cors:{t.Target.TargetId}:{i}";
                                var expanded = _expandedOperations.Contains(key);
                                var detailId = $"aqr-cors-details-{t.Target.TargetId}-{i}";
                                <tr data-testid="aqr-cors-row" data-kind="@o.Kind" data-assessment="@o.Assessment">
                                    <td><span class="aqr-mono aqr-break">@o.Origin</span> <span class="aqr-muted">@CorsKindLabel(o.Kind)</span></td>
                                    <td class="aqr-mono aqr-break">@(o.AllowOrigin ?? "absent")</td>
                                    <td>@(o.AllowCredentials ? "true" : "absent/false")</td>
                                    <td><span class="aqr-state aqr-state-@(o.Assessment is BirkNext.RuntimeSecurity.CorsAssessment.AsExpected ? "pass" : o.Assessment is BirkNext.RuntimeSecurity.CorsAssessment.Observation or BirkNext.RuntimeSecurity.CorsAssessment.NotVerified ? "muted" : "fail")" data-testid="aqr-cors-assessment">@ApiReviewPresentation.CorsLabel(o.Assessment)</span></td>
                                    <td><button type="button" class="aqr-row-toggle" aria-expanded="@(expanded ? "true" : "false")" aria-controls="@detailId" aria-label="@($"{(expanded ? "Hide" : "Show")} CORS evidence for {o.Origin}")" data-testid="aqr-cors-toggle" @onclick="() => ToggleOperation(key)">@(expanded ? "Hide" : "Details")</button></td>
                                </tr>
                                <tr id="@detailId" class="aqr-finding-details" hidden="@(!expanded)" data-testid="aqr-cors-details">
                                    <td colspan="5">
                                        <dl class="aqr-dl aqr-dl-technical">
                                            <div><dt>Probe</dt><dd>@o.Kind</dd></div>
                                            <div><dt>Expected</dt><dd>@o.Expected</dd></div>
                                            <div><dt>Observed</dt><dd>@o.Observed</dd></div>
                                            @if (o.Note is { Length: > 0 }) { <div><dt>Note</dt><dd>@o.Note</dd></div> }
                                        </dl>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        var headerTargets = report.Targets.Where(t => t.SecurityHeaders.Count > 0).ToList();
        <section class="aqr-subsection" data-testid="aqr-security-headers" aria-labelledby="aqr-sec-headers-h">
            <h3 id="aqr-sec-headers-h" tabindex="-1">Headers</h3>
            <p class="aqr-muted" data-testid="aqr-header-expectations-note">@(report.Policy.ExpectedSecurityHeaders is null ? "This review predates saved response-header expectations; BirkNext's default API headers (HSTS, X-Content-Type-Options) were required." : "Required header names come from the selected Target Environment's API review safety settings (presence only; no header values are stored). Document-level headers are assessed on the frontend document by FQR HTTP Security.")</p>
            @if (headerTargets.Count == 0) { <p class="aqr-empty">No response headers were assessed.</p> }
            @foreach (var t in headerTargets)
            {
                <div class="aqr-tablewrap" tabindex="0" role="region" aria-label="@($"Security headers · {ApiReviewPresentation.DisplayName(t.Target)}")">
                    <table class="aqr-table" data-testid="aqr-header-expectations" data-target-id="@t.Target.TargetId">
                        <caption class="aqr-table-caption">@ApiReviewPresentation.DisplayName(t.Target)</caption>
                        <thead><tr><th scope="col">Header</th><th scope="col">Expected</th><th scope="col">Observed</th><th scope="col">Result</th></tr></thead>
                        <tbody>
                            @foreach (var h in t.SecurityHeaders)
                            {
                                <tr data-testid="aqr-header-row" data-header="@h.Header" data-result="@h.Result">
                                    <td class="aqr-mono">@h.Header</td>
                                    <td>@(h.Expected ? "Yes" : "No")</td>
                                    <td class="aqr-mono aqr-break">@(h.Present ? h.ObservedValue ?? "present" : "absent")</td>
                                    <td><span class="aqr-state aqr-state-@ApiFuzzingPresentation.HeaderResultTone(h.Result)">@ApiFuzzingPresentation.HeaderResultLabel(h.Result)</span> <span class="aqr-muted">@h.Note</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        var exposures = report.Targets.Where(t => t.DocumentationExposure is not null).GroupBy(t => t.DocumentationExposure!.Origin).Select(g => g.First()).ToList();
        <section class="aqr-subsection" data-testid="aqr-security-documentation" aria-labelledby="aqr-sec-docs-h">
            <h3 id="aqr-sec-docs-h" tabindex="-1">Documentation exposure</h3>
            <p class="aqr-muted">Anonymous GETs of a few same-origin documentation paths, judged against the Target Environment's expectation. Public documentation is not a defect by itself; without a configured expectation the result is not a pass or a fail.</p>
            @if (exposures.Count == 0) { <p class="aqr-empty">Not verified — no documentation probes recorded.</p> }
            else
            {
                <div class="aqr-tablewrap" tabindex="0" role="region" aria-label="API documentation exposure">
                    <table class="aqr-table" data-testid="aqr-docs-exposure">
                        <thead><tr><th scope="col">API origin</th><th scope="col">Probes</th><th scope="col">Observed</th><th scope="col">Expectation</th><th scope="col">Assessment</th></tr></thead>
                        <tbody>
                            @foreach (var t in exposures)
                            {
                                var d = t.DocumentationExposure!;
                                <tr data-testid="aqr-docs-exposure-row" data-assessment="@d.Assessment">
                                    <td class="aqr-mono aqr-break">@d.Origin</td>
                                    <td class="aqr-mono aqr-break">@(d.Probes.Count == 0 ? "none sent" : string.Join(", ", d.Probes.Select(p => $"{p.Path} → {(p.StatusCode?.ToString() ?? "—")}")))</td>
                                    <td>@BirkNext.RuntimeSecurity.ApiDocumentationExposureRules.Label(d.Observed)</td>
                                    <td>@RuntimeSecurityExpectationsEditor.ExposureLabel(d.Expectation)</td>
                                    <td><span class="aqr-state aqr-state-@(d.Assessment == BirkNext.RuntimeSecurity.ApiDocumentationAssessment.UnexpectedExposure ? "fail" : d.Assessment == BirkNext.RuntimeSecurity.ApiDocumentationAssessment.AsExpected ? "pass" : "muted")">@d.Assessment</span> <span class="aqr-muted">@d.Reason</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    };

    private static string CorsKindLabel(BirkNext.RuntimeSecurity.CorsProbeKind kind) => kind switch
    {
        BirkNext.RuntimeSecurity.CorsProbeKind.FrontendOrigin => "frontend origin",
        BirkNext.RuntimeSecurity.CorsProbeKind.ConfiguredAllowedOrigin => "configured allowed origin",
        _ => "synthetic foreign origin",
    };

    public static ApiReviewRunRequest BuildRequest(FrontendAnalysisContext context, AuthenticatedReviewIdentity identity, IReadOnlyList<ApiReviewTarget> targets, IReadOnlyCollection<string> selected, ApiReviewHistory? history)
    {
        var production = context.ActiveProfile.EnvironmentType == FrontendEnvironmentType.Production;
        var selectedTargets = targets.Select(t => t with { Selected = selected.Contains(t.TargetId) }).Where(t => t.Selected).ToList();
        return new ApiReviewRunRequest
        {
            Environment = new ApiReviewEnvironmentSnapshot
            {
                EnvironmentId = context.ActiveProfile.Id, Name = context.ActiveProfile.Name, EnvironmentType = context.ActiveProfile.EnvironmentType.ToString(), TargetUrl = context.TargetUrl,
                AuthenticatedTestingMethod = identity.Method, RequiresAuthentication = context.RequiresAuthentication, ContextIdentityDigest = identity.ContextFingerprint, IsProduction = production, CapturedAt = DateTimeOffset.UtcNow,
            },
            Identity = identity, Targets = selectedTargets,
            Policy = new ApiReviewPolicy
            {
                ReadOnly = true, ErrorHandlingProbes = !production, IntrospectionExpectedDisabled = production,
                // One setting per check (see ApiReviewPolicy): per-request response time → Single Request Latency (one threshold, so no
                // poor tier); REST payload → REST Payload; GraphQL payload → GraphQL Payload. The payload threshold used to be the larger
                // of REST and GraphQL, so a 500 KB REST setting was evaluated — and shown — as 1,048,576 bytes.
                SlowWarningMs = context.PerformanceThresholds.MaxSingleRequestLatencyMs, SlowPoorMs = null, LatencySource = ApiReviewPresentation.LatencySourceLabel,
                PerformanceProfile = ApiReviewPresentation.ProfileOf(context.PerformanceThresholds.Mode),
                AverageLatencyWarningMs = context.PerformanceThresholds.MaxAverageApiLatencyMs,
                CompressionMinimumBytes = context.PerformanceThresholds.CompressionMinPayloadBytes,
                RestPayloadWarningBytes = context.PerformanceThresholds.MaxRestPayloadBytes, GraphQlPayloadWarningBytes = context.PerformanceThresholds.MaxGraphQlPayloadBytes,
                LargePayloadBytes = context.PerformanceThresholds.MaxRestPayloadBytes,
                // Target Environment API review settings own the header policy; only presence is evaluated.
                ExpectedSecurityHeaders = [.. context.SecuritySettings.ExpectedSecurityHeaders],
                // Runtime security expectations (documentation exposure, CORS) are copied into the run: history never re-binds to newer settings.
                RuntimeSecurity = BirkNext.RuntimeSecurity.ApiRuntimeSecurityPolicy.From(context.SecuritySettings.RuntimeSecurity),
            },
            Baselines = history is null ? [] : selectedTargets.Where(t => history.Baselines.ContainsKey(t.TargetId)).Select(t => history.Baselines[t.TargetId]).ToList(),
            FrontendOrigin = Uri.TryCreate(context.TargetUrl, UriKind.Absolute, out var origin) ? origin.GetLeftPart(UriPartial.Authority) : null,
        };
    }

    /// <summary>
    /// Return to the setup view. A view transition and nothing else: it starts no review, records nothing, and clears
    /// no state the run produced.
    ///
    /// It deliberately does NOT call <see cref="RefreshContextAsync"/>, which the Frontend Quality Review's equivalent
    /// can afford to. That method re-hydrates <c>_report</c> from history (<c>_report ??= _history.LastReport</c>), so
    /// calling it here would put the result straight back and the button would appear to do nothing — and it rebuilds
    /// the target selection from the saved configuration, which would silently discard whatever the user had ticked.
    ///
    /// The completed run is untouched: it stays in <see cref="IApiReviewHistoryService"/> and in the runtime session,
    /// so the landing view still shows it and re-opening the page restores it.
    /// </summary>
    private void BackToSetup() => _report = null;

    private async Task ExportHtml()
    {
        if (_report is null) return;
        var html = ExportService.ExportApiReview(_report, Workspace.ProjectName, _history?.FuzzRuns.FirstOrDefault());
        await JS.InvokeVoidAsync("downloadHtmlFile", $"api-quality-review-{DateTime.UtcNow:yyyy-MM-dd}.html", html);
    }

    /// <summary>One run-decision group (Ready / Limitations / Informational); limitations never share a style with blockers.</summary>
    private static RenderFragment DecisionGroup(string key, string title, IReadOnlyList<ApiReviewReadinessItem> items) => __builder =>
    {
        if (items.Count == 0) return;
        <section class="aqr-decision-group aqr-decision-@key" data-testid="aqr-decision-group" data-group="@key" aria-labelledby="@($"aqr-dg-{key}")">
            <h3 id="@($"aqr-dg-{key}")">@title</h3>
            <ul>@foreach (var item in items) { <li class="aqr-readiness-item aqr-readiness-item-@item.State.ToString().ToLowerInvariant()"><span aria-hidden="true">@ApiReviewReadinessItemStates.Glyph(item.State)</span> @item.Label</li> }</ul>
        </section>
    };

    private static string ReadinessTone(ApiReviewReadinessLevel level) => level switch
    {
        ApiReviewReadinessLevel.Ready => "ready",
        ApiReviewReadinessLevel.Limited => "warning",
        ApiReviewReadinessLevel.Blocked => "blocked",
        ApiReviewReadinessLevel.NeedsReview => "warning", // a decision is required: a warning, never muted
        _ => "muted",
    };

    private static string ReadinessIcon(ApiReviewReadinessLevel level) => level switch
    {
        ApiReviewReadinessLevel.Ready => "✓",
        ApiReviewReadinessLevel.Limited => "⚠",
        ApiReviewReadinessLevel.Blocked => "✕",
        _ => "…",
    };

    /// <summary>
    /// The check table (Error handling is the reference pattern: Area · Check · Result · Detail · Evidence). With
    /// <paramref name="evidenceInDetails"/> the evidence column folds into a per-row disclosure so a single-area tab stays narrow.
    /// </summary>
    private RenderFragment RenderChecks(IReadOnlyList<ApiReviewCheck> checks, ApiReviewFindingType[]? areas, bool evidenceInDetails = false) => __builder =>
    {
        if (checks.Count == 0) return;
        <details class="aqr-checks" open="@(areas is not null)">
            <summary>@ApiReviewEvidencePresentation.CheckSummary(checks, _report!.Policy)</summary>
            <div class="aqr-tablewrap" tabindex="0" role="region" aria-label="Review checks">
                <table class="aqr-table aqr-checks-table" data-testid="aqr-checks-table">
                    @if (evidenceInDetails)
                    {
                        <thead><tr><th scope="col">Check</th><th scope="col">Result</th><th scope="col">Detail</th></tr></thead>
                    }
                    else
                    {
                        <thead><tr><th scope="col">Area</th><th scope="col">Check</th><th scope="col">Result</th><th scope="col">Detail</th><th scope="col">Evidence</th></tr></thead>
                    }
                    <tbody>
                        @foreach (var c in checks)
                        {
                            <tr data-testid="aqr-check-row" data-check-id="@c.CheckId" data-result="@c.Result">
                                @if (!evidenceInDetails) { <td>@ApiReviewStatusLabels.AreaLabel(c.Area)</td> }
                                <td>@ApiReviewEvidencePresentation.CheckTitle(c)</td>
                                <td><span class="aqr-state">@ApiReviewEvidencePresentation.CheckLabel(c, _report!.Policy)</span></td>
                                <td>@ApiReviewEvidencePresentation.CheckDetail(c, _report!.Policy)
                                    @if (evidenceInDetails && c.Evidence.Count > 0)
                                    {
                                        <details class="aqr-inline-evidence" data-testid="aqr-check-evidence"><summary>Evidence (@c.Evidence.Count)</summary><p class="aqr-mono aqr-muted aqr-break">@string.Join(" · ", c.Evidence.Take(8))</p></details>
                                    }
                                </td>
                                @if (!evidenceInDetails) { <td class="aqr-mono aqr-muted aqr-break">@string.Join(" · ", c.Evidence.Take(5))</td> }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </details>
    };

    /// <summary>
    /// Review requests of one service: the summary row keeps the decision columns (operation, execution, status, timing, review
    /// result); content type, payload, contract match and the note open in a detail row.
    /// </summary>
    private RenderFragment RenderOperations(ApiReviewTargetResult t, IReadOnlyList<ApiReviewOperationResult> rows) => __builder =>
    {
        <div class="aqr-tablewrap" tabindex="0" role="region" aria-label="@($"Operations · {ApiReviewPresentation.DisplayName(t.Target)}")">
            <table class="aqr-table aqr-operations-table" data-testid="aqr-operations-table">
                <thead><tr><th scope="col">Operation</th><th scope="col">Execution</th><th scope="col">Status</th><th scope="col">Response time</th><th scope="col">Review result</th><th scope="col"><span class="aqr-visually-hidden">Details</span></th></tr></thead>
                <tbody>
                    @for (var i = 0; i < rows.Count; i++)
                    {
                        var o = rows[i];
                        var key = $"{t.Target.TargetId}#{i}";
                        var expanded = _expandedOperations.Contains(key);
                        var detailId = $"aqr-op-details-{t.Target.TargetId}-{i}";
                        var payloadCell = ApiReviewEvidencePresentation.PayloadSize(o);
                        if (!OperationShown(o)) continue;
                        <tr data-testid="aqr-operation-row" data-executed="@(o.Executed ? "true" : "false")" data-attention="@(OperationNeedsAttention(o, _report?.Policy ?? new()) ? "true" : "false")">
                            <td class="aqr-mono aqr-break">@o.Display</td>
                            <td>@ApiReviewEvidencePresentation.Execution(o)@(o.Executed ? $" · {ApiReviewStatusLabels.AccessLabel(o.AccessMode)}" : "")</td>
                            <td>@(o.Executed ? o.StatusCode.ToString() : "—")</td>
                            <td>@(o.ElapsedMs is { } ms ? $"{ms:0} ms" : "—")</td>
                            <td><span class="aqr-state" data-testid="aqr-operation-review">@OperationReview(o, _report?.Policy ?? new())</span></td>
                            <td><button type="button" class="aqr-row-toggle" aria-expanded="@(expanded ? "true" : "false")" aria-controls="@detailId" aria-label="@($"{(expanded ? "Hide" : "Show")} details for {o.Display}")" data-testid="aqr-operation-toggle" @onclick="() => ToggleOperation(key)">@(expanded ? "Hide" : "Details")</button></td>
                        </tr>
                        <tr id="@detailId" class="aqr-finding-details" hidden="@(!expanded)" data-testid="aqr-operation-details">
                            <td colspan="6">
                                <dl class="aqr-dl aqr-dl-technical">
                                    <div><dt>Content type</dt><dd>@(o.ContentType ?? "—")</dd></div>
                                    <div><dt>Payload size</dt><dd data-testid="aqr-operation-payload">@payloadCell.Primary@if (payloadCell.Secondary is { } payloadDetail) { <span class="aqr-muted aqr-payload-detail"> @payloadDetail</span> }</dd></div>
                                    <div><dt>Contract</dt><dd>@(o.ContractMatched is null ? "—" : o.ContractMatched.Value ? "Matched" : "Not documented")</dd></div>
                                    @if (o.Note is { Length: > 0 }) { <div><dt>Note</dt><dd>@o.Note</dd></div> }
                                    @if (o.Checks.Count > 0) { <div><dt>Checks</dt><dd>@string.Join(" · ", o.Checks.Select(c => $"{c.Title}: {ApiReviewEvidencePresentation.CheckLabel(c, _report?.Policy ?? new())}"))</dd></div> }
                                </dl>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    };

    /// <summary>
    /// The observed GraphQL inventory, rendered once: one row per observed document variant, with RUNTIME and CONTRACT in
    /// separate columns (the review never executes an observed business operation; the __typename probe is its own row in the
    /// requests table). Without a schema the Contract column says "Not assessed" for every row — never an empty table under a
    /// "0 observed" line. Incompatible rows open to their violations; compatible rows stay compact.
    /// </summary>
    private RenderFragment RenderObservedOperations(ApiReviewTargetResult t) => __builder =>
    {
        var counts = ApiReviewPresentation.GraphQlCounts(t);
        var compatibility = t.GraphQlCompatibility;
        <h4 class="aqr-group-title">@ApiReviewPresentation.DisplayName(t.Target) · observed operations</h4>
        <p class="aqr-muted" data-testid="aqr-gql-counts">@counts.Summary</p>
        @if (t.GraphQlTechnology is { } technology)
        {
            @* Metadata only: which GraphQL stack the evidence points to, with its confidence and provenance. Never a status or a finding. *@
            <section class="aqr-gql-technology" data-testid="aqr-gql-technology" aria-label="@($"GraphQL technology · {ApiReviewPresentation.DisplayName(t.Target)}")">
                <dl class="aqr-dl aqr-gql-technology-list">
                    <div><dt>GraphQL server</dt><dd data-testid="aqr-gql-tech-server">@ApiReviewGraphQlCompatibilityPresentation.TechnologyLabel(technology.Server)@if (ApiReviewGraphQlCompatibilityPresentation.SourceLabel(technology.Server.Source) is { Length: > 0 } serverSource) { <span class="aqr-muted"> · @serverSource</span> }</dd></div>
                    <div><dt>GraphQL client</dt><dd data-testid="aqr-gql-tech-client">@ApiReviewGraphQlCompatibilityPresentation.TechnologyLabel(technology.Client)@if (ApiReviewGraphQlCompatibilityPresentation.SourceLabel(technology.Client.Source) is { Length: > 0 } clientSource) { <span class="aqr-muted"> · @clientSource</span> }</dd></div>
                </dl>
                <ReviewDisclosure Text="View technology evidence" CollapseText="Hide technology evidence" TestId="@($"aqr-gql-tech-evidence-{t.Target.TargetId}")" Class="disclosure-inline disclosure-small">
                    <ul class="aqr-list aqr-muted" data-testid="aqr-gql-tech-evidence-list">
                        @foreach (var line in technology.Server.Evidence) { <li>Server: @line</li> }
                        @if (technology.Server.Note is { } serverNote) { <li>Server: @serverNote</li> }
                        @foreach (var line in technology.Client.Evidence) { <li>Client: @line</li> }
                        @if (technology.Client.Note is { } clientNote) { <li>Client: @clientNote</li> }
                        <li>Informational only: technology detection never changes schema source, compatibility or severity.</li>
                    </ul>
                </ReviewDisclosure>
            </section>
        }
        @if (compatibility is { Observed: > 0 })
        {
            <div class="aqr-tablewrap" tabindex="0" role="region" aria-label="Observed GraphQL operations">
                <table class="aqr-table" data-testid="aqr-gql-operations">
                    <thead><tr><th scope="col">Operation</th><th scope="col">Type</th><th scope="col">Observations</th><th scope="col">Runtime</th><th scope="col">Contract</th><th scope="col"><span class="aqr-visually-hidden">Details</span></th></tr></thead>
                    <tbody>
                        @foreach (var o in compatibility.Operations)
                        {
                            var key = $"gql:{t.Target.TargetId}:{o.DocumentHash}";
                            var expanded = _expandedOperations.Contains(key);
                            var detailId = $"aqr-gql-details-{t.Target.TargetId}-{o.DocumentHash}";
                            <tr data-testid="aqr-gql-operation-row" data-compatibility="@o.Status" data-historical="@(o.Historical ? "true" : "false")">
                                <td class="aqr-mono">@(o.OperationName ?? "(anonymous)")@if (o.Historical) { <span class="aqr-pill aqr-pill-muted aqr-gql-historical" data-testid="aqr-gql-historical">Historical</span> }</td>
                                <td>@o.OperationType</td>
                                <td>@o.ObservationCount</td>
                                <td class="aqr-muted" data-testid="aqr-gql-runtime">@ApiReviewGraphQlCompatibilityPresentation.RuntimeLabel(o.OperationType)</td>
                                <td>
                                    <span class="aqr-state aqr-state-@ApiReviewGraphQlCompatibilityPresentation.StatusTone(o.Status)" data-testid="aqr-gql-contract">@ApiReviewGraphQlCompatibilityPresentation.StatusLabel(o.Status)</span>
                                    @if (o.Status == GraphQlCompatibilityStatus.Incompatible)
                                    {
                                        <ReviewDisclosure Text="@($"{o.Issues.Count} validation issue{(o.Issues.Count == 1 ? "" : "s")}")" CollapseText="Hide validation issues" Class="disclosure-inline disclosure-small" TestId="@($"aqr-gql-issues-{o.DocumentHash}")">
                                            <ul class="aqr-gql-issues" data-testid="aqr-gql-issue-list">@foreach (var issue in o.Issues) { <li><span class="aqr-mono">@issue.Code</span> — @issue.Message</li> }</ul>
                                            <p class="aqr-muted">Observed: @o.EvidenceSource · @o.ObservationCount observation@(o.ObservationCount == 1 ? "" : "s")@(o.Historical ? " (historical evidence only)" : "") · Schema: @ApiReviewGraphQlCompatibilityPresentation.SchemaSourceLabel(compatibility)</p>
                                            <p><strong>Recommended action:</strong> @ApiReviewGraphQlCompatibilityPresentation.RecommendedActionFor(t.GraphQlTechnology)</p>
                                        </ReviewDisclosure>
                                    }
                                </td>
                                <td><button type="button" class="aqr-row-toggle" aria-expanded="@(expanded ? "true" : "false")" aria-controls="@detailId" aria-label="@($"{(expanded ? "Hide" : "Show")} details for {o.OperationName ?? "anonymous operation"}")" data-testid="aqr-gql-operation-toggle" @onclick="() => ToggleOperation(key)">@(expanded ? "Hide" : "Details")</button></td>
                            </tr>
                            <tr id="@detailId" class="aqr-finding-details" hidden="@(!expanded)" data-testid="aqr-gql-operation-details">
                                <td colspan="6">
                                    <dl class="aqr-dl aqr-dl-technical">
                                        <div><dt>Last observed</dt><dd>@(o.LastObservedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd></div>
                                        <div><dt>Observed in</dt><dd>@o.EvidenceSource@(o.Historical ? " (historical evidence only)" : "")</dd></div>
                                        @if (o.Status == GraphQlCompatibilityStatus.NotAssessed && o.NotAssessedReason is { } why) { <div><dt>Contract</dt><dd class="aqr-gql-reason">Not assessed — @why</dd></div> }
                                        @if (o.DeprecatedUsage.Count > 0) { <div><dt>Deprecated usage</dt><dd class="aqr-gql-deprecated" data-testid="aqr-gql-deprecated">Observation: @string.Join("; ", o.DeprecatedUsage)</dd></div> }
                                    </dl>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (counts.Observed > 0)
        {
            @* A report recorded before compatibility existed: the observed operations, with nothing claimed about them. *@
            <div class="aqr-tablewrap" tabindex="0" role="region" aria-label="Observed GraphQL operations">
                <table class="aqr-table" data-testid="aqr-gql-operations">
                    <thead><tr><th scope="col">Operation</th><th scope="col">Runtime</th><th scope="col">Contract</th><th scope="col">Note</th></tr></thead>
                    <tbody>
                        @foreach (var o in t.Operations.Where(o => !o.Executed)) { <tr data-testid="aqr-gql-operation-row"><td class="aqr-mono">@o.Display</td><td class="aqr-muted">Not executed</td><td class="aqr-muted">Not assessed</td><td class="aqr-muted">@o.Note</td></tr> }
                    </tbody>
                </table>
            </div>
        }
    };

    /// <summary>
    /// Contracts owns contract/schema detail: source, status, structural baseline and drift per service, then GraphQL
    /// client/server compatibility, drift comparison and the remaining contract checks. "No previous baseline" is
    /// informational; "Unavailable" is not a contract failure; compatibility and drift are never counted together.
    /// </summary>
    private RenderFragment RenderContracts(ApiReviewReport report, IReadOnlyList<ApiReviewCheck> domainChecks, ApiReviewFindingType[] areas) => __builder =>
    {
        <dl class="aqr-dl aqr-contract-causes" data-testid="aqr-contract-causes">
            @foreach (var cause in ApiReviewPostRunPresentation.ContractCauses(report))
            {
                <div data-testid="aqr-contract-cause" data-key="@cause.Key"><dt>@cause.Label</dt><dd><strong>@cause.State</strong>@if (cause.Reason is { } why) { <span class="aqr-muted"> — Reason: @why</span> }</dd></div>
            }
        </dl>
        var withContract = report.Targets.Count(t => t.Contract is { Available: true });
        @* Coverage of contract evidence, never of the API: a service without a usable contract is reviewed structurally only. *@
        <p class="aqr-contract-coverage" data-testid="aqr-contract-coverage" data-with="@withContract" data-total="@report.Targets.Count">
            <strong>Contract evidence:</strong> @withContract of @report.Targets.Count service@(report.Targets.Count == 1 ? "" : "s") had a usable contract or schema@(withContract < report.Targets.Count ? $" · {report.Targets.Count - withContract} reviewed without contract validation (not assessed against a contract)" : "").
        </p>
        <h3 id="aqr-contracts-status-heading">Contract and schema status</h3>
        <div class="aqr-tablewrap" tabindex="0" role="region" aria-labelledby="aqr-contracts-status-heading">
            <table class="aqr-table" data-testid="aqr-contracts-table">
                <thead><tr><th scope="col">Service</th><th scope="col">Contract/schema source</th><th scope="col">Status</th><th scope="col">Baseline &amp; drift</th></tr></thead>
                <tbody>
                    @foreach (var t in report.Targets)
                    {
                        var c = t.Contract;
                        var rest = t.Target.ApiType == ApiReviewTargetType.Rest;
                        var driftChecks = t.Checks.Concat(t.Operations.SelectMany(o => o.Checks)).Where(x => x.Area == ApiReviewFindingType.Drift).ToList();
                        var driftFindings = report.Findings.Count(f => f.TargetId == t.Target.TargetId && f.Type == ApiReviewFindingType.Drift);
                        <tr data-testid="aqr-contract-status-row" data-target-id="@t.Target.TargetId">
                            <td><strong>@ApiReviewPresentation.DisplayName(t.Target)</strong> <span class="aqr-muted">@(rest ? "REST" : "GraphQL")</span></td>
                            <td data-testid="aqr-contract-source">
                                @if (rest) { @(c?.Source is { Length: > 0 } || t.Target.ContractSource is not null ? "Published OpenAPI" : "No contract configured") }
                                else if (t.GraphQlCompatibility is { } compat) { @ApiReviewGraphQlCompatibilityPresentation.SchemaSourceLabel(compat) }
                                else { <span>Runtime introspection</span> }
                            </td>
                            <td>
                                @if (c is null)
                                {
                                    <span class="aqr-state" data-testid="aqr-contract-status">@(rest && t.Target.ContractSource is null ? "Not configured" : "Not assessed")</span>
                                    <span class="aqr-muted">@(rest && t.Target.ContractSource is null ? " — structural review only; contract validation unavailable." : " — no contract evidence recorded.")</span>
                                }
                                else
                                {
                                    <span class="aqr-state" data-testid="aqr-contract-status">@ApiReviewEvidencePresentation.ContractState(c)</span>
                                    @if (c.Note is { Length: > 0 }) { <span class="aqr-muted"> — @c.Note</span> }
                                    @if (c.Available)
                                    {
                                        <ReviewDisclosure Text="View contract metadata" CollapseText="Hide contract metadata" Class="disclosure-inline disclosure-small">
                                            <dl class="aqr-dl aqr-dl-technical">
                                                <div><dt>Kind</dt><dd>@c.Kind</dd></div>
                                                <div><dt>Version</dt><dd>@(c.Version ?? "Not recorded")</dd></div>
                                                <div><dt>Operations / types</dt><dd>@c.OperationCount / @c.TypeCount</dd></div>
                                                <div><dt>Mutations / deprecated</dt><dd>@c.MutationCount / @c.DeprecatedCount</dd></div>
                                                <div><dt>Introspection</dt><dd>@(c.IntrospectionEnabled is null ? "Not recorded" : c.IntrospectionEnabled.Value ? "Enabled" : "Disabled or rejected")</dd></div>
                                                <div><dt>Hash</dt><dd class="aqr-mono aqr-break">@(c.Hash ?? "Not recorded")</dd></div>
                                            </dl>
                                        </ReviewDisclosure>
                                    }
                                }
                            </td>
                            <td data-testid="aqr-contract-drift">
                                @if (driftFindings > 0)
                                {
                                    <span class="aqr-state aqr-state-warning">Drift detected</span> <span class="aqr-muted">· @driftFindings @(driftFindings == 1 ? "change" : "changes")</span>
                                    <button type="button" class="aqr-link-button" data-testid="aqr-contract-drift-findings" @onclick="() => ShowFindings(service: t.Target.TargetId, area: ApiReviewPresentation.FindingArea(ApiReviewFindingType.Drift))">View drift findings</button>
                                }
                                else if (driftChecks.Count > 0) { <span class="aqr-state">Compared</span> <span class="aqr-muted">· no drift in the compared evidence</span> }
                                else { <span class="aqr-state aqr-state-muted">@ApiReviewPostRunPresentation.NoComparableRuntimeBaseline</span> <span class="aqr-muted">· informational@(t.Baseline is not null ? "; this run recorded the first runtime structural baseline (source: runtime observation), not a contract baseline" : "")</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="aqr-muted">Structural baselines hold contract hashes, root fields and response shapes — never values.</p>
        @if (report.Targets.Where(t => t.GraphQlCompatibility is { Observed: > 0 }).ToList() is { Count: > 0 } gqlTargets)
        {
            <h3 id="aqr-contracts-compat-heading">GraphQL client/server compatibility</h3>
            <p class="aqr-muted">Are the GraphQL operations the frontend actually sends still valid against the server's current contract? Observed operations are validated, never executed.</p>
            @foreach (var t in gqlTargets) { @RenderCompatibilityCard(t, t.GraphQlCompatibility!) }
        }
        <h3 id="aqr-contracts-drift-heading">Drift comparison</h3>
        <p class="aqr-muted">Compares available evidence with previous baselines. No changes detected does not establish contract or schema coverage.</p>
        @RenderChecks(domainChecks.Where(c => c.Area == ApiReviewFindingType.Drift).ToList(), areas)
        @if (!domainChecks.Any(c => c.Area == ApiReviewFindingType.Drift)) { <p class="aqr-empty">Not compared — no previous baseline for these services. The first review records one.</p> }
        @if (report.Targets.SelectMany(t => t.GraphQlCompatibility?.SchemaChangeImpact ?? []).ToList() is { Count: > 0 } impact)
        {
            <h4 class="aqr-group-title">Client impact</h4>
            <ul data-testid="aqr-gql-client-impact">@foreach (var line in impact) { <li>@line</li> }</ul>
        }
        @if (domainChecks.Where(c => c.Area != ApiReviewFindingType.Drift).ToList() is { Count: > 0 } other && other.Any(c => c.Result is not (ApiReviewCheckResult.NotTested or ApiReviewCheckResult.Blocked)))
        {
            <h3 id="aqr-contracts-checks-heading">Contract checks</h3>
            @RenderChecks(other, areas)
        }
        else
        {
            <p class="aqr-empty" data-testid="aqr-contract-checks-not-run"><strong>Contract checks:</strong> Not run — Reason: no usable contract or schema was available.</p>
        }
    };

    /// <summary>
    /// Contracts → GraphQL client/server compatibility for one endpoint: schema source, the five counts (never merged with drift),
    /// coverage, current vs historical-only, and the incompatible operations. Drift and its client impact are the next section.
    /// </summary>
    private RenderFragment RenderCompatibilityCard(ApiReviewTargetResult t, ApiReviewGraphQlCompatibility c) => __builder =>
    {
        <section class="aqr-card aqr-gql-compatibility" data-testid="aqr-gql-compatibility" aria-label="@($"GraphQL client/server compatibility · {ApiReviewPresentation.DisplayName(t.Target)}")">
            <h4 class="aqr-group-title">Client/server compatibility · @ApiReviewPresentation.DisplayName(t.Target)</h4>
            <dl class="aqr-dl aqr-gql-compatibility-counts">
                <div><dt>Schema source</dt><dd data-testid="aqr-gql-schema-source">@ApiReviewGraphQlCompatibilityPresentation.SchemaSourceLabel(c)@if (c.SchemaRetrievedAt is { } at) { <span class="aqr-muted"> · retrieved @at.ToString("yyyy-MM-dd HH:mm")</span> }</dd></div>
                @if (c.RuntimeSchemaOutcome is { } runtimeOutcome) { <div><dt>Runtime introspection</dt><dd data-testid="aqr-gql-runtime-outcome">@runtimeOutcome</dd></div> }
                @if (c.ConfiguredArtifact is { } snapshot)
                {
                    <div><dt>Schema artifact</dt><dd data-testid="aqr-gql-artifact"><span class="aqr-break">@snapshot.FileName</span> <span class="aqr-muted">· sha256 <span class="aqr-mono">@snapshot.ShortHash</span> · updated @snapshot.UpdatedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC@(snapshot.UsedForCompatibility ? "" : " · fallback, not used")</span></dd></div>
                }
                <div><dt>Observed operations</dt><dd data-testid="aqr-gql-observed">@c.Observed@if (c.HistoricalOnly > 0) { <span class="aqr-muted"> (@c.Current current · @c.HistoricalOnly historical-only)</span> }</dd></div>
                <div><dt>Assessed</dt><dd data-testid="aqr-gql-assessed">@c.Assessed</dd></div>
                <div><dt>Compatible</dt><dd data-testid="aqr-gql-compatible">@(c.Assessed == 0 ? "—" : c.Compatible.ToString())</dd></div>
                <div><dt>Incompatible</dt><dd data-testid="aqr-gql-incompatible">@(c.Assessed == 0 ? "—" : c.Incompatible.ToString())</dd></div>
                <div><dt>Not assessed</dt><dd data-testid="aqr-gql-not-assessed">@c.NotAssessed</dd></div>
                <div><dt>Contract coverage</dt><dd data-testid="aqr-gql-coverage">@ApiReviewGraphQlCompatibilityPresentation.Coverage(c)</dd></div>
            </dl>
            @if (c.ConfiguredArtifactProblem is { } artifactProblem)
            {
                <p class="aqr-muted" data-testid="aqr-gql-artifact-problem">Configured schema artifact not used: @artifactProblem</p>
            }
            @if (c.Operations.Where(o => o.DeprecatedUsage.Count > 0).ToList() is { Count: > 0 } deprecatedOps)
            {
                <p class="aqr-muted" data-testid="aqr-gql-deprecated-summary">Observation (not an incompatibility): @deprecatedOps.Count compatible operation@(deprecatedOps.Count == 1 ? " uses" : "s use") deprecated schema members.</p>
            }
            @if (c.NotAssessedReason is { } reason)
            {
                <p class="aqr-muted" data-testid="aqr-gql-not-assessed-reason">Not assessed: @reason Compatibility is not the same as reachability: the endpoint itself was reviewed separately.</p>
            }
            @foreach (var o in c.Operations.Where(o => o.Status == GraphQlCompatibilityStatus.Incompatible))
            {
                <div class="aqr-gql-incompatible" data-testid="aqr-gql-incompatible-detail">
                    <p><strong class="aqr-mono">@(o.OperationName ?? "(anonymous)")</strong> · @o.OperationType · <span class="aqr-state aqr-state-fail">Incompatible</span>@if (o.Historical) { <span class="aqr-pill aqr-pill-muted aqr-gql-historical">Historical</span> }</p>
                    <p>@o.Issues[0].Message@(o.Issues.Count > 1 ? $" (+{o.Issues.Count - 1} more)" : "")</p>
                    <p class="aqr-muted">Observed: @o.EvidenceSource · @o.ObservationCount observation@(o.ObservationCount == 1 ? "" : "s") · Last observed @(o.LastObservedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</p>
                </div>
            }
        </section>
    };

    // ── Findings: the one canonical list of source-finding occurrences ─────────────────────────────────────────────────

    private string _filterSeverity = "";
    private string _filterService = "";
    private string _filterArea = "";
    private string _filterIssue = "";
    private bool FiltersActive => _filterSeverity.Length + _filterService.Length + _filterArea.Length + _filterIssue.Length > 0;
    private void ClearFindingFilters() { _filterSeverity = ""; _filterService = ""; _filterArea = ""; _filterIssue = ""; }

    /// <summary>Opens Findings filtered to one service, area or logical issue (the area tabs and Key issues link here).</summary>
    private void ShowFindings(string? service = null, string? area = null, string? issue = null)
    {
        ClearFindingFilters();
        _filterService = service ?? ""; _filterArea = area ?? ""; _filterIssue = issue ?? "";
        OpenTab("Findings");
    }

    /// <summary>
    /// What an area or service tab shows instead of repeating the occurrence table: the count, the severity split and one link to
    /// Findings. "No findings" is scoped to the assessed targets; blocked or not-assessed checks are shown by the checks above.
    /// </summary>
    private RenderFragment RenderFindingSummary(IReadOnlyList<ApiReviewFinding> findings, string scope, Action open) => __builder =>
    {
        <div class="aqr-finding-summary" data-testid="aqr-area-findings" data-count="@findings.Count">
            @if (findings.Count == 0)
            {
                <p class="aqr-empty" data-testid="aqr-no-findings">No findings @scope on the assessed targets. Blocked or not-assessed checks are listed as such, never as passes.</p>
            }
            else
            {
                <p>
                    <strong data-testid="aqr-area-findings-count">Findings @scope: @findings.Count</strong>
                    <span class="aqr-muted" data-testid="aqr-area-findings-severity">@string.Join(" · ", findings.GroupBy(f => f.Severity).OrderBy(g => g.Key).Select(g => $"{g.Key} {g.Count()}"))</span>
                    <button type="button" class="btn-secondary aqr-view-findings" data-testid="aqr-view-findings" @onclick="open">View in Findings</button>
                </p>
            }
        </div>
    };

    private RenderFragment RenderFindings(ApiReviewReport report) => __builder =>
    {
        var issues = ApiReviewPresentation.LogicalIssues(report);
        var issueOf = issues.SelectMany(i => i.Sources.Select(f => (f.Id, Issue: i))).GroupBy(x => x.Id).ToDictionary(g => g.Key, g => g.First().Issue, StringComparer.Ordinal);
        var shown = report.Findings.Where(f =>
            (_filterSeverity.Length == 0 || f.Severity.ToString() == _filterSeverity)
            && (_filterService.Length == 0 || f.TargetId == _filterService)
            && (_filterArea.Length == 0 || ApiReviewPresentation.FindingArea(f.Type) == _filterArea)
            && (_filterIssue.Length == 0 || ApiReviewPresentation.LogicalIssueKey(f) == _filterIssue)).ToList();
        <p class="aqr-muted" data-testid="aqr-findings-lead">Every source finding is listed here once. A <strong>logical issue</strong> groups the same rule on the same endpoint; each row is one <strong>occurrence</strong> observed on a service.</p>
        @if (report.Findings.Count > 0)
        {
            <div class="aqr-filters" role="group" aria-label="Filter source findings" data-testid="aqr-finding-filters">
                <label>Severity
                    <select @bind="_filterSeverity" data-testid="aqr-filter-severity">
                        <option value="">All</option>
                        @foreach (var s in report.Findings.Select(f => f.Severity).Distinct().OrderBy(s => s)) { <option value="@s">@s</option> }
                    </select>
                </label>
                <label>Service
                    <select @bind="_filterService" data-testid="aqr-filter-service">
                        <option value="">All</option>
                        @foreach (var id in report.Findings.Select(f => f.TargetId).Distinct()) { <option value="@id">@ApiReviewPresentation.ServiceNameOf(report, id)</option> }
                    </select>
                </label>
                <label>Type
                    <select @bind="_filterArea" data-testid="aqr-filter-type">
                        <option value="">All</option>
                        @foreach (var a in report.Findings.Select(f => ApiReviewPresentation.FindingArea(f.Type)).Distinct()) { <option value="@a">@ApiReviewPresentation.TabLabel(a)</option> }
                    </select>
                </label>
                <label>Logical issue
                    <select @bind="_filterIssue" data-testid="aqr-filter-issue">
                        <option value="">All</option>
                        @foreach (var i in issues) { <option value="@i.Key">@i.Title (@i.Sources.Count)</option> }
                    </select>
                </label>
                @if (FiltersActive) { <button type="button" class="btn-secondary" data-testid="aqr-filter-clear" @onclick="ClearFindingFilters">Clear filters</button> }
            </div>
        }
        <h3 class="aqr-group-title" data-testid="aqr-findings-count">Source findings (@(FiltersActive ? $"{shown.Count} of {report.Findings.Count}" : $"{report.Findings.Count}"))</h3>
        @if (report.Findings.Count == 0)
        {
            <p class="aqr-empty" data-testid="aqr-no-findings">No findings on the assessed targets. Blocked or not-assessed targets are listed as such, never as passes.</p>
        }
        else if (shown.Count == 0)
        {
            <p class="aqr-empty" data-testid="aqr-no-filtered-findings">No source findings match the selected filters. <button type="button" class="aqr-link-button" @onclick="ClearFindingFilters">Clear filters</button></p>
        }
        else
        {
            <div class="aqr-tablewrap" tabindex="0" role="region" aria-label="Source findings">
                <table class="aqr-table aqr-findings-table" data-testid="aqr-findings-table">
                    <thead><tr><th scope="col">Severity</th><th scope="col">Service</th><th scope="col">Type</th><th scope="col">Endpoint / operation</th><th scope="col">Finding</th><th scope="col">Logical issue</th><th scope="col"><span class="aqr-visually-hidden">Details</span></th></tr></thead>
                    <tbody>
                        @foreach (var f in shown)
                        {
                            var expanded = _expandedFindings.Contains(f.Id);
                            var detailId = $"aqr-finding-details-{f.Id}";
                            var issue = issueOf.GetValueOrDefault(f.Id);
                            var service = ApiReviewPresentation.ServiceNameOf(report, f.TargetId);
                            <tr data-testid="aqr-finding-row" data-finding-id="@f.Id" data-severity="@f.Severity" data-issue="@issue?.Key">
                                <td><span class="aqr-sev aqr-sev-@f.Severity.ToString().ToLowerInvariant()"><span class="aqr-sev-label">@f.Severity</span></span></td>
                                <td>@service</td>
                                <td>@ApiReviewStatusLabels.AreaLabel(f.Type)@(f.Drift is { } d ? $" · {ApiReviewStatusLabels.DriftLabel(d)}" : "")</td>
                                <td class="aqr-mono aqr-break">@f.Endpoint</td>
                                <td><strong>@f.Title</strong></td>
                                <td data-testid="aqr-finding-issue">@(issue is null ? "—" : issue.Sources.Count == 1 ? "Single occurrence" : $"1 of {issue.Sources.Count} occurrences")</td>
                                <td><button type="button" class="aqr-row-toggle" aria-expanded="@(expanded ? "true" : "false")" aria-controls="@detailId" aria-label="@($"{(expanded ? "Hide" : "Show")} details for {f.Title} on {service}")" data-testid="aqr-finding-toggle" @onclick="() => ToggleFinding(f.Id)">@(expanded ? "Hide details" : "Details")</button></td>
                            </tr>
                            <tr id="@detailId" class="aqr-finding-details" hidden="@(!expanded)" data-testid="aqr-finding-details">
                                <td colspan="7">
                                    <dl class="aqr-dl aqr-dl-technical">
                                        @if (issue is not null)
                                        {
                                            <div><dt>Logical issue</dt><dd data-testid="aqr-finding-logical-issue">@issue.Title · @issue.Sources.Count @(issue.Sources.Count == 1 ? "occurrence" : "occurrences") on @string.Join(", ", issue.Affects)</dd></div>
                                        }
                                        <div><dt>Description</dt><dd>@f.Description</dd></div>
                                        <div><dt>Check</dt><dd>@f.Check · <span class="aqr-state aqr-state-@f.Result.ToString().ToLowerInvariant()" data-testid="aqr-finding-check-result">@ApiReviewStatusLabels.FindingCheckLabel(f)</span></dd></div>
                                        @if (f.Evidence.Count > 0) { <div><dt>Evidence</dt><dd class="aqr-mono aqr-evidence">@string.Join(" · ", f.Evidence.Take(8))</dd></div> }
                                        <div><dt>Recommendation</dt><dd>@f.Recommendation</dd></div>
                                        @if (f.StandardsReferences.Count > 0) { <div><dt>Standards</dt><dd><StandardReferences References="f.StandardsReferences" /></dd></div> }
                                        @if (f.Result == ApiReviewCheckResult.ManualReview) { <div><dt>Manual verification</dt><dd>Required — this item was not verified automatically.</dd></div> }
                                        @if (f.Drift is { } drift) { <div><dt>Contract drift</dt><dd>@ApiReviewStatusLabels.DriftLabel(drift)</dd></div> }
                                    </dl>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    };
}
