@page "/api-quality-review"
@using BirkNext.ApiReview
@using BirkNext.LocalHttpsProxy
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using BirkNext.Web.Components
@using Microsoft.AspNetCore.WebUtilities
@inject IApiReviewService ReviewService
@inject IFrontendAnalysisContextFactory ContextFactory
@inject IEndpointDiscoveryService Discovery
@inject IApiReviewHistoryService History
@inject IAuthenticatedReviewCapabilitiesService Capabilities
@inject RuntimeReviewSessionService RuntimeReviews
@inject IWorkspaceSessionService Workspace
@inject IReportExportService ExportService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IGraphQlSchemaArtifactApiService SchemaArtifacts

<PageTitle>API Quality Review</PageTitle>

<div class="aqr-page">
    <PageHeader Title="API Quality Review"
                Description="Review discovered REST and GraphQL APIs for security, contract quality, robustness, error handling, and response timing. Read-only.">
        @if (_report is not null)
        {
            @* Same action pattern as the Frontend Quality Review result: return to the setup view first, then export.
               "Back" and "Run again" stay apart — one navigates, the other starts work. *@
            <button type="button" class="btn-primary" @onclick="BackToSetup" data-testid="aqr-back">Back to API Quality Review</button>
            <button type="button" class="btn-secondary" @onclick="ExportHtml" data-testid="aqr-export">Export HTML</button>
        }
    </PageHeader>

    @{
        var access = ApiReviewPresentation.AccessPanel(_context, _capabilities, _targets, _selected);
        var contracts = ApiReviewPresentation.Contracts(_targets, _selected, _history, _report ?? _history?.LastReport, _schemaArtifacts);
        var readiness = ApiReviewPresentation.Readiness(Eligibility, _context, _targets, _selected, _capabilities, contracts);
        var scope = ApiReviewPresentation.Scope(_targets, _selected);
        var domains = ApiReviewPresentation.Domains(scope, contracts, access.Availability);
    }

    @if (_report is null)
    {
        @*
            1. Decide: what am I reviewing, what scope, what access do I have, can it run — then run it.
            Nothing diagnostic here; every technical surface is one disclosure away under Review details.
        *@
        <section class="aqr-decide" data-testid="aqr-decide" aria-label="Review setup">
            <div class="aqr-decide-cards">

                <section class="aqr-card aqr-target-card" data-testid="aqr-environment" aria-labelledby="aqr-target-heading">
                    <div class="aqr-card-head">
                        <h2 id="aqr-target-heading">Target</h2>
                        <a class="aqr-link" href="@ApiReviewPresentation.TargetEnvironmentsHref" data-testid="aqr-change-target">Change target</a>
                    </div>
                    @if (_context is null)
                    {
                        <p class="aqr-muted">Loading the active Target Environment…</p>
                    }
                    else if (_context.ActiveTargetError is { Length: > 0 } activeError)
                    {
                        <p class="aqr-error-inline" role="alert" data-testid="aqr-active-target-error">@activeError</p>
                    }
                    else
                    {
                        var summary = ApiReviewPresentation.TargetSummary(_context, _capabilities, _targets);
                        @* Review status belongs to Readiness and access to API access; repeating either here said the
                           same thing in slightly different words. *@
                        @* Label above value: a quarter-width card cannot hold a fixed label column and still show the value. *@
                        <dl class="aqr-dl aqr-dl-stacked">
                            <div><dt>Environment</dt><dd><strong data-testid="aqr-env-name">@summary.Environment</strong> <span class="aqr-pill aqr-pill-muted">@summary.EnvironmentType</span></dd></div>
                            <div><dt>Frontend</dt><dd class="aqr-mono" data-testid="aqr-env-url">@summary.FrontendUrl</dd></div>
                            <div>
                                <dt>Frontend sign-in</dt>
                                <dd data-testid="aqr-env-auth" aria-describedby="@(scope.AuthRequired > 0 ? "aqr-frontend-signin-help" : null)">@summary.Authentication</dd>
                                @if (scope.AuthRequired > 0)
                                {
                                    @* Frontend sign-in and API authentication are separate facts; say so where both are visible. *@
                                    <dd class="aqr-help" id="aqr-frontend-signin-help" data-testid="aqr-frontend-signin-help">@(_context.RequiresAuthentication
                                        ? "Applies to the frontend only. Selected APIs may still require authenticated access independently."
                                        : "Frontend access does not require sign-in; selected APIs may still require authenticated access.")</dd>
                                }
                            </div>
                        </dl>
                        <ReviewDisclosure Text="View target details" CollapseText="Hide target details" TestId="aqr-target-details" Class="disclosure-inline">
                            <dl class="aqr-dl aqr-dl-technical">
                                @foreach (var field in summary.Technical)
                                {
                                    <div><dt>@field.Label</dt><dd>@field.Value</dd></div>
                                }
                            </dl>
                        </ReviewDisclosure>
                    }
                </section>

                <section class="aqr-card aqr-scope-card" data-testid="aqr-scope" aria-labelledby="aqr-scope-heading">
                    <div class="aqr-card-head"><h2 id="aqr-scope-heading">Review scope</h2></div>
                    <p class="aqr-scope-headline" data-testid="aqr-scope-headline">@scope.Headline</p>
                    @if (scope.Protocols is { Length: > 0 } protocols)
                    {
                        <p class="aqr-muted" data-testid="aqr-scope-protocols">@protocols</p>
                    }
                    @if (scope.AuthNote is { } authNote)
                    {
                        <p class="aqr-muted" data-testid="aqr-scope-auth">@authNote</p>
                    }
                </section>

                <section class="aqr-card aqr-access-card" data-testid="aqr-access" aria-labelledby="aqr-access-heading">
                    <div class="aqr-card-head"><h2 id="aqr-access-heading">API access</h2></div>
                    @* One vocabulary for the two access paths; the exact internal state stays in the details disclosure. *@
                    <ul class="aqr-access-rows">
                        <li class="aqr-access-row">
                            <span class="aqr-access-label">Authenticated API context</span>
                            <span class="aqr-pill aqr-pill-@ApiReviewAccessAvailabilities.Tone(access.Availability)" data-testid="aqr-access-mode" data-availability="@access.Availability">@ApiReviewAccessAvailabilities.Label(access.Availability)</span>
                        </li>
                        @* Readiness is judged per selected target against ITS requirement: public reachability never stands in for an
                           authenticated target, and "Public access: Available" was a constant with no evidence behind it. *@
                        @if (ApiReviewPresentation.TargetAccess(_targets, _selected, access.Availability) is { Count: > 0 } targetAccess)
                        {
                            var ready = targetAccess.Count(t => t.Ready);
                            <li class="aqr-access-row">
                                <span class="aqr-access-label">Selected target access</span>
                                <span class="aqr-pill aqr-pill-@(ready == targetAccess.Count ? "ready" : "attention")" data-testid="aqr-target-access-summary">@ready of @targetAccess.Count ready</span>
                            </li>
                            <li class="aqr-access-targets">
                                <ul class="aqr-target-access-list" data-testid="aqr-target-access-list">
                                    @foreach (var t in targetAccess)
                                    {
                                        <li data-testid="aqr-target-access-row" data-ready="@(t.Ready ? "true" : "false")"><span class="aqr-target-access-name">@t.Name</span> <span class="aqr-muted">@t.Type · @t.Requirement</span> <span class="aqr-state aqr-state-@(t.Ready ? "pass" : "blocked")">@t.State</span></li>
                                    }
                                </ul>
                            </li>
                        }
                    </ul>
                    @* How many targets need it is Review scope's fact, and while the readiness card offers the way to
                       Authentication, this card does not offer it a second time. *@
                    @if (access.ActionText is not null && readiness.ActionHref is null)
                    {
                        <p class="aqr-card-actions">
                            <a class="@(access.Availability == ApiReviewAccessAvailability.Available ? "aqr-link aqr-link-quiet" : "aqr-link")" href="@access.ActionHref" data-testid="aqr-access-action">@access.ActionText</a>
                        </p>
                    }
                </section>

                <section class="aqr-card aqr-readiness aqr-readiness-@readiness.Level.ToString().ToLowerInvariant()" data-testid="aqr-readiness" data-readiness="@readiness.Level" aria-labelledby="aqr-readiness-heading" role="@(readiness.Level == ApiReviewReadinessLevel.Blocked ? "alert" : "status")">
                    <div class="aqr-card-head">
                        <h2 id="aqr-readiness-heading"><span class="aqr-readiness-icon" aria-hidden="true">@ReadinessIcon(readiness.Level)</span> @readiness.Title</h2>
                    </div>
                    <p class="aqr-readiness-message" id="aqr-run-reason" data-testid="aqr-run-reason">@readiness.Message</p>
                    @if (readiness.Items.Count > 0 && readiness.Level != ApiReviewReadinessLevel.Blocked)
                    {
                        @* While the review can still run, the individual limitations are what the reader opens. *@
                        <ReviewDisclosure Text="View limitation details" CollapseText="Hide limitation details" TestId="aqr-readiness-limitations" Class="disclosure-inline disclosure-small">
                            <ul class="aqr-readiness-items" data-testid="aqr-readiness-items">
                                @foreach (var item in readiness.Items)
                                {
                                    <li class="aqr-readiness-item aqr-readiness-item-@item.State.ToString().ToLowerInvariant()"><span aria-hidden="true">@ApiReviewReadinessItemStates.Glyph(item.State)</span> @item.Label</li>
                                }
                            </ul>
                        </ReviewDisclosure>
                        @if (readiness.ActionText is not null && readiness.ActionHref is not null)
                        {
                            <p class="aqr-card-actions"><a class="aqr-link" data-testid="aqr-run-action" href="@readiness.ActionHref">@readiness.ActionText</a></p>
                        }
                    }
                    @if (readiness.Level == ApiReviewReadinessLevel.Blocked)
                    {
                        @* While it is blocked they stay visible: they are why the reader cannot proceed. *@
                        @if (readiness.Items.Count > 0)
                        {
                            <ul class="aqr-readiness-items" data-testid="aqr-readiness-items">
                                @foreach (var item in readiness.Items)
                                {
                                    <li class="aqr-readiness-item aqr-readiness-item-@item.State.ToString().ToLowerInvariant()"><span aria-hidden="true">@ApiReviewReadinessItemStates.Glyph(item.State)</span> @item.Label</li>
                                }
                            </ul>
                        }
                        @if (readiness.ActionText is not null && readiness.ActionHref is not null)
                        {
                            @* The one action that unblocks the run: a button-styled link, never a disabled control. *@
                            <p class="aqr-card-actions">
                                <a class="aqr-cta" data-testid="aqr-run-action" href="@readiness.ActionHref"
                                   aria-describedby="@(readiness.Help is not null ? "aqr-readiness-help" : null)">@readiness.ActionText</a>
                            </p>
                        }
                        @if (readiness.Help is not null)
                        {
                            <p class="aqr-help" id="aqr-readiness-help" data-testid="aqr-readiness-help">@readiness.Help</p>
                        }
                    }
                </section>
            </div>

            <div class="aqr-run-row" data-testid="aqr-run-row">
                @* Disabled Run carries its reason programmatically, so it does not depend on seeing the blocker card. *@
                <PrimaryButton OnClick="RunReview" Disabled="@(!Eligibility.Enabled || _running)" aria-label="Run API Quality Review" data-testid="aqr-run"
                               aria-describedby="@(!Eligibility.Enabled ? (readiness.RunUnavailableReason is not null ? "aqr-run-unavailable" : "aqr-run-reason") : null)">
                    @if (_running) { <span class="aqr-spinner" aria-hidden="true">⟳</span> }
                    @(_running ? "Reviewing…" : "Run API Quality Review")
                </PrimaryButton>
                @if (!Eligibility.Enabled && readiness.RunUnavailableReason is { } runUnavailable)
                {
                    <span class="aqr-visually-hidden" id="aqr-run-unavailable" data-testid="aqr-run-unavailable">@runUnavailable</span>
                }
                @if (_running)
                {
                    <p class="aqr-progress" role="status" aria-live="polite">@_progressMessage</p>
                }
            </div>
            @if (_errorMessage is not null)
            {
                <div class="aqr-error" role="alert" data-testid="aqr-error">@_errorMessage</div>
            }
        </section>

        @* 2. Scope: what the review covers, in review words rather than access or configuration words. *@
        <section class="aqr-section aqr-domains" data-testid="aqr-domains" aria-labelledby="aqr-domains-heading">
            <h2 id="aqr-domains-heading">What will be reviewed</h2>
            <ul class="aqr-domain-grid">
                @foreach (var domain in domains)
                {
                    <li>
                        <article class="aqr-card aqr-domain" data-testid="aqr-domain" data-domain="@domain.Key" data-state="@domain.State">
                            <div class="aqr-domain-head">
                                <h3>@domain.Title</h3>
                                <span class="aqr-pill aqr-pill-@ApiReviewDomainStates.Tone(domain.State)" data-testid="aqr-domain-state">@ApiReviewDomainStates.Label(domain.State)</span>
                            </div>
                            <p class="aqr-domain-purpose">@domain.Purpose</p>
                            @if (domain.Limitation is { Length: > 0 } limitation)
                            {
                                <p class="aqr-domain-limitation" data-testid="aqr-domain-limitation">@limitation</p>
                            }
                        </article>
                    </li>
                }
            </ul>
        </section>

        @* 3. Review details: the configuration behind the decision, collapsed. Nothing here changes the scope above. *@
        <section class="aqr-section aqr-details" data-testid="aqr-details" aria-labelledby="aqr-details-heading">
            <div class="aqr-card-head"><h2 id="aqr-details-heading">Review details</h2></div>

            @* Open by default and bound, so a re-render never re-opens it after the reader collapsed it. *@
            <ReviewDisclosure Text="API targets" CollapseText="Hide API targets" Hint="@ScopeHint(scope)" TestId="aqr-targets-disclosure" Class="aqr-detail-disclosure"
                              @bind-Expanded="_targetsExpanded">
                <ApiReviewTargetPicker Targets="_targets" Selected="_selected" Toggle="OnToggleTarget" LastReport="_history?.LastReport" />
            </ReviewDisclosure>

            <ReviewDisclosure Text="Contracts" CollapseText="Hide contracts" Hint="@ContractHint(contracts)" TestId="aqr-contracts-disclosure" Class="aqr-detail-disclosure">
                <ApiReviewContractPanel Contracts="contracts" />
            </ReviewDisclosure>
            @if (_context is not null && _targets.Any(t => t.ApiType == ApiReviewTargetType.GraphQl))
            {
                var gqlTargets = _targets.Where(t => t.ApiType == ApiReviewTargetType.GraphQl).ToList();
                var configured = gqlTargets.Count(t => _schemaArtifacts.ContainsKey(t.TargetId));
                <ReviewDisclosure Text="GraphQL schema artifacts" CollapseText="Hide GraphQL schema artifacts" Hint="@(configured == 0 ? "None configured" : $"{configured} of {gqlTargets.Count} configured")" TestId="aqr-schema-artifacts-disclosure" Class="aqr-detail-disclosure">
                    <GraphQlSchemaArtifactPanel EnvironmentId="@_context.ActiveProfile.Id" Targets="gqlTargets" Artifacts="_schemaArtifacts" LoadError="@_schemaArtifactsError" Changed="OnSchemaArtifactsChanged" />
                </ReviewDisclosure>
            }


            <ReviewDisclosure Text="Authentication details" CollapseText="Hide authentication details" Hint="@ApiReviewAccessAvailabilities.Label(access.Availability)" TestId="aqr-access-details" Class="aqr-detail-disclosure">
                <ApiReviewAccessDetails Access="access" />
            </ReviewDisclosure>

            <ReviewDisclosure Text="Read-only review" CollapseText="Hide read-only review" Hint="Safe requests only" TestId="aqr-readonly-disclosure" Class="aqr-detail-disclosure">
                @* The safe-method allowlist is the review's, not this page's; this only states it. *@
                <dl class="aqr-dl aqr-readonly-methods" data-testid="aqr-readonly-summary">
                    <div><dt>REST</dt><dd>GET, HEAD, OPTIONS</dd></div>
                    <div><dt>GraphQL</dt><dd>Queries only</dd></div>
                    <div><dt>Never executed</dt><dd>Mutations, write operations and destructive operations</dd></div>
                    <div><dt>Timing note</dt><dd class="aqr-muted" data-testid="aqr-timing-scope">@ApiReviewPresentation.TimingScopeShort</dd></div>
                </dl>
            </ReviewDisclosure>
        </section>
    }

    @* ── Results (only once a review exists) ── *@
    @if (_report is { } report)
    {
        var result = ApiReviewPresentation.Result(report);
        var summary = result.Metadata;
        <section class="aqr-results" data-testid="aqr-results" aria-labelledby="aqr-result-heading">

            @* ── 1. The result itself: what ran, how it ended, and how to run it again. ────────────────────── *@
            <section class="aqr-card aqr-result-summary" data-testid="aqr-result-summary" aria-labelledby="aqr-result-heading">
                <div class="aqr-result-head">
                    <div>
                        <h2 id="aqr-result-heading">Review result</h2>
                        @* Execution and manual review are separate facts. One badge saying "Completed — manual review
                           required" read as though the automated review had not finished; it always finishes. *@
                        <p class="aqr-result-state" data-testid="aqr-result-state">
                            <span class="aqr-pill aqr-pill-@ApiReviewResultStates.Tone(result.State)">@result.StateLabel</span>
                            @if (result.ManualReviewCount > 0)
                            {
                                <span class="aqr-pill aqr-pill-attention" data-testid="aqr-result-manual">Manual review required · @result.ManualReviewCount @(result.ManualReviewCount == 1 ? "area" : "areas")</span>
                            }
                        </p>
                        <p class="aqr-result-summary-text" data-testid="aqr-result-summary-text">@result.Summary</p>
                    </div>
                    <PrimaryButton OnClick="RunReview" Disabled="@(!Eligibility.Enabled || _running)" data-testid="aqr-run">
                        @(_running ? "Reviewing…" : "Run API Quality Review again")
                    </PrimaryButton>
                </div>
                <dl class="aqr-dl aqr-result-meta" data-testid="aqr-result-meta">
                    <div><dt>Target</dt><dd><strong data-testid="aqr-result-env">@summary.Environment</strong> <span class="aqr-pill aqr-pill-muted">@summary.EnvironmentType</span></dd></div>
                    <div><dt>Completed</dt><dd data-testid="aqr-result-generated">@summary.GeneratedAt</dd></div>
                    <div><dt>Services reviewed</dt><dd data-testid="aqr-result-services">REST @summary.RestServices · GraphQL @summary.GraphQlServices@if (summary.TargetsBlocked > 0) { <span class="aqr-muted"> · @summary.TargetsBlocked not executed</span> }</dd></div>
                    <div><dt>Operations reviewed</dt><dd data-testid="aqr-result-operations">@summary.OperationsReviewed <span class="aqr-muted">read-only requests executed</span></dd></div>
                    <div><dt>Access used</dt><dd><span data-testid="aqr-result-access">@summary.AccessUsed</span> <span class="aqr-muted">@summary.AccessUsedDetail</span></dd></div>
                </dl>
                @if (_running)
                {
                    <p class="aqr-progress" role="status" aria-live="polite">@_progressMessage</p>
                }
                @if (_errorMessage is not null)
                {
                    <div class="aqr-error" role="alert" data-testid="aqr-error">@_errorMessage</div>
                }
            </section>

            @* ── 2. What was found. Findings are defects; manual-review obligations are counted separately. ── *@
            <section class="aqr-card aqr-key-findings-card" data-testid="aqr-key-findings" aria-labelledby="aqr-key-findings-heading">
                <div class="aqr-card-head">
                    <h2 id="aqr-key-findings-heading">Key issues</h2>
                    <button type="button" class="aqr-link aqr-link-button" data-testid="aqr-all-findings" @onclick='() => _tab = "Findings"'>All source findings (@result.FindingCount)</button>
                </div>
                @if (report.Findings.Count > 0)
                {
                    @* Two layers, both counted: what to act on, and the raw observations behind it. *@
                    <p class="aqr-muted" data-testid="aqr-issue-counts">@result.IssueCount logical @(result.IssueCount == 1 ? "issue" : "issues") · @result.FindingCount source @(result.FindingCount == 1 ? "finding" : "findings")</p>
                }
                <ul class="aqr-sev-strip" aria-label="Source findings by severity" data-testid="aqr-finding-counts">
                    @foreach (var sev in summary.Severities)
                    {
                        <li class="aqr-sev aqr-sev-@sev.Severity.ToString().ToLowerInvariant() @(sev.Count == 0 ? "aqr-sev-zero" : "")" data-testid="aqr-sev" data-severity="@sev.Severity"><span class="aqr-sev-label">@sev.Severity</span> <span class="aqr-sev-count">@sev.Count</span></li>
                    }
                </ul>
                @if (report.Findings.Count == 0)
                {
                    <p class="aqr-empty" data-testid="aqr-no-key-findings">No findings on the assessed targets. Targets that were blocked or not assessed are listed as such, never as passes.</p>
                }
                else
                {
                    <ul class="aqr-key-findings">
                        @foreach (var issue in ApiReviewPresentation.KeyIssues(report))
                        {
                            <li data-testid="aqr-key-issue" data-sources="@issue.Sources.Count">
                                <span class="aqr-sev aqr-sev-@issue.Severity.ToString().ToLowerInvariant()"><span class="aqr-sev-label">@issue.Severity</span></span>
                                <span class="aqr-key-finding-title">@issue.Title</span>
                                <span class="aqr-muted" data-testid="aqr-key-issue-affects">@string.Join(", ", issue.Affects) · @issue.Endpoint@(issue.Sources.Count > 1 ? $" · {issue.Sources.Count} source observations" : "")</span>
                            </li>
                        }
                    </ul>
                }
            </section>

            <div class="aqr-tabs" role="tablist" aria-label="Review result areas">
                @foreach (var tab in Tabs)
                {
                    <button type="button" class="aqr-tab @(_tab == tab ? "aqr-tab-active" : "")" role="tab" id="aqr-tab-btn-@tab.ToLowerInvariant()" aria-selected="@(_tab == tab ? "true" : "false")" aria-controls="aqr-tabpanel" tabindex="@(_tab == tab ? "0" : "-1")" data-testid="aqr-tab-@tab.ToLowerInvariant()" @onclick="() => _tab = tab" @onkeydown="e => OnTabKey(e, tab)">@ApiReviewPresentation.TabLabel(tab)</button>
                }
            </div>

            <div id="aqr-tabpanel" role="tabpanel" aria-labelledby="aqr-tab-btn-@_tab.ToLowerInvariant()" class="aqr-tabpanel" data-testid="aqr-tabpanel" data-tab="@_tab">
            @if (_tab == "Overview")
            {
                <p class="aqr-muted" data-testid="aqr-reviewed-help">@ApiReviewEvidencePresentation.ReviewedHelp</p>
                <div class="aqr-tablewrap" tabindex="0" role="region" aria-label="Review evidence table">
                    <table class="aqr-table aqr-services" data-testid="aqr-services-table">
                        <thead><tr><th scope="col">Service</th><th scope="col">Type</th><th scope="col">Access</th><th scope="col">Review status</th><th scope="col">Contract</th><th scope="col">Source findings</th></tr></thead>
                        <tbody>
                            @foreach (var t in report.Targets)
                            {
                                var status = ApiReviewStatusLabels.Of(t);
                                var expanded = _expandedServices.Contains(t.Target.TargetId);
                                var detailId = $"aqr-service-details-{t.Target.TargetId}";
                                <tr data-testid="aqr-service-row" data-target-id="@t.Target.TargetId">
                                    <td>
                                        <button type="button" class="aqr-row-toggle" aria-expanded="@(expanded ? "true" : "false")" aria-controls="@detailId" data-testid="aqr-service-toggle" @onclick="() => ToggleService(t.Target.TargetId)">
                                            <span aria-hidden="true">@(expanded ? "▾" : "▸")</span> <strong>@ApiReviewPresentation.DisplayName(t.Target)</strong>
                                        </button>
                                    </td>
                                    <td>@(t.Target.ApiType == ApiReviewTargetType.Rest ? "REST" : "GraphQL")</td>
                                    <td data-testid="aqr-service-access">@ApiReviewStatusLabels.AccessLabel(t.AccessMode)</td>
                                    <td><span class="aqr-pill aqr-pill-@ApiReviewStatusLabels.Tone(status)" data-testid="aqr-service-status" data-status="@status">@ApiReviewStatusLabels.Label(status)</span></td>
                                    <td data-testid="aqr-service-contract">@ApiReviewStatusLabels.ContractLabel(t.Contract)</td>
                                    <td data-testid="aqr-service-findings">@(t.FindingCount is null ? "Not tested" : t.FindingCount.Value.ToString())</td>
                                </tr>
                                <tr id="@detailId" class="aqr-service-details" hidden="@(!expanded)" data-testid="aqr-service-details" data-target-id="@t.Target.TargetId">
                                    <td colspan="6">
                                        <dl class="aqr-dl aqr-dl-technical">
                                            <div><dt>Endpoint</dt><dd class="aqr-mono">@t.Target.Url</dd></div>
                                            <div><dt>Source</dt><dd>@ApiReviewPresentation.SourceLabel(t.Target.Source) · @ApiReviewPresentation.ConfidenceLabel(t.Target.Confidence)</dd></div>
                                            <div><dt>Access</dt><dd>@t.AccessReason</dd></div>
                                            @if (t.RequiredAction is not null) { <div><dt>Next step</dt><dd>@t.RequiredAction</dd></div> }
                                            @if (t.Contract is { } contract) { <div><dt>@contract.Kind</dt><dd>@ApiReviewEvidencePresentation.ContractState(contract)@(contract.Note is { Length: > 0 } ? $" — {contract.Note}" : "")</dd></div> }
                                            <div><dt>Operations</dt><dd>@t.Operations.Count(o => o.Executed) of @t.Operations.Count executed (read-only)</dd></div>
                                        </dl>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @* Obligations, not defects: they are never added to the finding counts above. *@
                <section class="aqr-card aqr-manual" data-testid="aqr-manual-review" aria-labelledby="aqr-manual-heading">
                    <div class="aqr-card-head"><h3 id="aqr-manual-heading">Manual review still required</h3></div>
                    <p class="aqr-muted" data-testid="aqr-manual-count">@report.ManualReviewItems.Count @(report.ManualReviewItems.Count == 1 ? "area remains" : "areas remain") outside the automated, read-only review. These are review obligations, not findings.</p>
                    <ul class="aqr-list">@foreach (var m in report.ManualReviewItems) { <li>@m</li> }</ul>
                </section>
            }
            else if (_tab is "REST" or "GraphQL")
            {
                var type = _tab == "REST" ? ApiReviewTargetType.Rest : ApiReviewTargetType.GraphQl;
                var targets = report.Targets.Where(t => t.Target.ApiType == type).ToList();
                @if (targets.Count == 0) { <p class="aqr-empty">No @_tab targets in this review.</p> }
                @foreach (var t in targets)
                {
                    var status = ApiReviewStatusLabels.Of(t);
                    <div class="aqr-card aqr-target-result" data-testid="aqr-target-result" data-target-id="@t.Target.TargetId">
                        <div class="aqr-card-head">
                            <h3>@ApiReviewPresentation.DisplayName(t.Target) <span class="aqr-mono aqr-muted aqr-target-result-url">@t.Target.Url</span></h3>
                            <span class="aqr-pill aqr-pill-@ApiReviewStatusLabels.Tone(status)">@ApiReviewStatusLabels.Label(status)</span>
                        </div>
                        <p class="aqr-muted">@ApiReviewEvidencePresentation.ReviewedHelp</p>
                        <p class="aqr-muted"><strong>Access:</strong> @ApiReviewStatusLabels.AccessLabel(t.AccessMode) — @t.AccessReason @if (t.RequiredAction is not null) { <strong>Next step:</strong> @t.RequiredAction }</p>
                        @if (t.Contract is { } contract)
                        {
                            <p><strong>@contract.Kind:</strong> <span class="aqr-state aqr-state-@contract.Status.ToString().ToLowerInvariant()">@ApiReviewEvidencePresentation.ContractState(contract)</span> @contract.Note @(contract.Hash is null ? "" : $"· hash {contract.Hash}")</p>
                        }
                        @{
                            // For GraphQL the review's own safe requests and the observed business operations are different
                            // sets; each is rendered once. Observed operations live in the observed-operations table below.
                            var requestRows = type == ApiReviewTargetType.GraphQl ? t.Operations.Where(o => o.Executed).ToList() : t.Operations;
                        }
                        @if (requestRows.Count > 0)
                        {
                            @if (type == ApiReviewTargetType.GraphQl) { <h4 class="aqr-group-title">@ApiReviewPresentation.DisplayName(t.Target) · review requests executed</h4> }
                            <div class="aqr-tablewrap" tabindex="0" role="region" aria-label="Review evidence table">
                                <table class="aqr-table">
                                    <thead><tr><th scope="col">Operation</th><th scope="col">Execution</th><th scope="col">Status</th><th scope="col">Content type</th><th scope="col">Response time</th><th scope="col">Bytes</th><th scope="col">Review checks</th><th scope="col">Contract</th><th scope="col">Note</th></tr></thead>
                                    <tbody>
                                        @foreach (var o in requestRows)
                                        {
                                            <tr data-testid="aqr-operation-row">
                                                <td class="aqr-mono">@o.Display</td>
                                                <td>@ApiReviewEvidencePresentation.Execution(o)@(o.Executed ? $" · {ApiReviewStatusLabels.AccessLabel(o.AccessMode)}" : "")</td>
                                                <td>@(o.Executed ? o.StatusCode.ToString() : "—")</td>
                                                <td>@(o.ContentType ?? "—")</td>
                                                <td>@(o.ElapsedMs is { } ms ? $"{ms:0} ms" : "—")</td>
                                                <td>@(o.ContentLength?.ToString() ?? "—")</td>
                                                <td><span class="aqr-state">@(o.Executed ? $"Warnings: {o.Checks.Count(c => c.Result == ApiReviewCheckResult.Warning)} · Failed checks: {o.Checks.Count(c => c.Result == ApiReviewCheckResult.Fail)}" : ApiReviewStatusLabels.ResultLabel(o.Result))</span></td>
                                                <td>@(o.ContractMatched is null ? "—" : o.ContractMatched.Value ? "Matched" : "Not documented")</td>
                                                <td class="aqr-muted">@o.Note</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        @if (type == ApiReviewTargetType.GraphQl) { @RenderObservedOperations(t) }
                        @RenderChecks(t.Checks.Concat(t.Operations.SelectMany(o => ApiReviewEvidencePresentation.OperationChecks(o).Select(c => c with { Title = $"{o.Display}: {c.Title}" }))).ToList(), null)
                        @RenderFindings(report, report.Findings.Where(f => f.TargetId == t.Target.TargetId).ToList(), null)
                    </div>
                }
            }
            else if (_tab == "Findings")
            {
                @RenderFindings(report, report.Findings, null)
            }
            else
            {
                var areas = _tab switch
                {
                    "Contracts" => new[] { ApiReviewFindingType.Contract, ApiReviewFindingType.Documentation, ApiReviewFindingType.Drift },
                    "Security" => new[] { ApiReviewFindingType.Security, ApiReviewFindingType.AccessControl },
                    "Errors" => new[] { ApiReviewFindingType.Errors },
                    _ => new[] { ApiReviewFindingType.Performance },
                };
                @if (_tab == "Security") { <p class="aqr-scope-note" data-testid="aqr-security-note">@ApiReviewPresentation.SecurityScopeNote</p> }
                @if (_tab == "Performance")
                {
                    <p class="aqr-scope-note" data-testid="aqr-performance-note">@ApiReviewPresentation.PerformanceScopeNote</p>
                    @* The thresholds THIS review was evaluated with, from its own policy snapshot — never today's settings. *@
                    <p class="aqr-muted" data-testid="aqr-performance-thresholds">@ApiReviewPresentation.PerformanceThresholdsNote(report.Policy)</p>
                    <ReviewDisclosure Text="Performance policy used" CollapseText="Hide performance policy" Hint="@ApiReviewPresentation.ProfileLabel(report.Policy.PerformanceProfile)" TestId="aqr-performance-policy" Class="disclosure-inline disclosure-small">
                        <dl class="aqr-dl aqr-performance-policy" data-testid="aqr-performance-policy-list">
                            @foreach (var (label, value) in ApiReviewPresentation.PerformancePolicy(report.Policy))
                            {
                                <div><dt>@label</dt><dd>@value</dd></div>
                            }
                        </dl>
                    </ReviewDisclosure>
                }
                @if (_tab == "Contracts")
                {
                    <h3>Contract availability</h3>
                    <div class="aqr-tablewrap" tabindex="0" role="region" aria-label="Review evidence table">
                        <table class="aqr-table" data-testid="aqr-contracts-table">
                            <thead><tr><th scope="col">Service</th><th scope="col">Contract</th><th scope="col">Availability</th><th scope="col">Evidence</th></tr></thead>
                            <tbody>
                                @foreach (var t in report.Targets)
                                {
                                    var c = t.Contract;
                                    if (c is null)
                                    {
                                        <tr><td>@ApiReviewPresentation.DisplayName(t.Target)</td><td colspan="3">@(t.Target.ContractSource is null && t.Target.ApiType == ApiReviewTargetType.Rest ? "No contract configured" : "Not tested - no contract evidence recorded")</td></tr>
                                        continue;
                                    }
                                    <tr>
                                        <td>@ApiReviewPresentation.DisplayName(t.Target)</td>
                                        <td>@c.Kind</td>
                                        <td><span class="aqr-state">@ApiReviewEvidencePresentation.ContractState(c)</span></td>
                                        <td>
                                            <p class="aqr-muted">@c.Note</p>
                                            @if (c.Available)
                                            {
                                                <ReviewDisclosure Text="View contract metadata" CollapseText="Hide contract metadata" Class="disclosure-inline disclosure-small">
                                                    <dl class="aqr-dl aqr-dl-technical">
                                                        <div><dt>Version</dt><dd>@(c.Version ?? "Not recorded")</dd></div>
                                                        <div><dt>Operations / types</dt><dd>@c.OperationCount / @c.TypeCount</dd></div>
                                                        <div><dt>Mutations / deprecated</dt><dd>@c.MutationCount / @c.DeprecatedCount</dd></div>
                                                        <div><dt>Introspection</dt><dd>@(c.IntrospectionEnabled is null ? "Not recorded" : c.IntrospectionEnabled.Value ? "Enabled" : "Disabled or rejected")</dd></div>
                                                        <div><dt>Hash</dt><dd class="aqr-mono">@(c.Hash ?? "Not recorded")</dd></div>
                                                    </dl>
                                                </ReviewDisclosure>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @foreach (var t in report.Targets.Where(t => t.GraphQlOperationMatches.Count > 0)) { @RenderObservedOperations(t) }
                }
                var domainChecks = ApiReviewPresentation.DomainChecks(report, areas);
                @if (_tab == "Contracts")
                {
                    @* Contract source (above) → client/server compatibility → schema drift → detailed validation. Compatibility and drift
                       are separate questions and are never counted together. *@
                    @if (report.Targets.Where(t => t.GraphQlCompatibility is { Observed: > 0 }).ToList() is { Count: > 0 } gqlTargets)
                    {
                        <h3>GraphQL client/server compatibility</h3>
                        <p class="aqr-muted">Are the GraphQL operations the frontend actually sends still valid against the server's current contract? Observed operations are validated, never executed.</p>
                        @foreach (var t in gqlTargets) { @RenderCompatibilityCard(t, t.GraphQlCompatibility!) }
                    }
                    <h3>Drift comparison</h3>
                    <p class="aqr-muted">Compares available evidence with previous baselines. No changes detected does not establish contract or schema coverage.</p>
                    @RenderChecks(domainChecks.Where(c => c.Area == ApiReviewFindingType.Drift).ToList(), areas)
                    @if (!domainChecks.Any(c => c.Area == ApiReviewFindingType.Drift)) { <p>Not tested - no drift comparison recorded.</p> }
                    @if (report.Targets.SelectMany(t => t.GraphQlCompatibility?.SchemaChangeImpact ?? []).ToList() is { Count: > 0 } impact)
                    {
                        <h4 class="aqr-group-title">Client impact</h4>
                        <ul data-testid="aqr-gql-client-impact">@foreach (var line in impact) { <li>@line</li> }</ul>
                    }
                    @RenderChecks(domainChecks.Where(c => c.Area != ApiReviewFindingType.Drift).ToList(), areas)
                }
                else { @RenderChecks(domainChecks, areas) }
                @RenderFindings(report, report.Findings.Where(f => areas.Contains(f.Type)).ToList(), areas)
            }
            </div>

            @*
                ── 3. Review details: how this review was executed and what it could reach. Supporting evidence for
                interpreting the result above, never a competitor to it.
            *@
            @if (_tab == "Overview")
            {
                <section class="aqr-section aqr-details" data-testid="aqr-result-details" aria-labelledby="aqr-result-details-heading">
                    <div class="aqr-card-head"><h2 id="aqr-result-details-heading" tabindex="-1" @ref="_reviewDetailsHeading">Review details</h2></div>

                    <ReviewDisclosure Text="Coverage" CollapseText="Hide coverage" Hint="@CoverageHint(summary)" TestId="aqr-coverage-disclosure" Class="aqr-detail-disclosure">
                        <dl class="aqr-coverage-list" data-testid="aqr-coverage">
                            @foreach (var row in summary.Coverage)
                            {
                                <div class="aqr-coverage-row" data-testid="aqr-coverage-row" data-coverage="@row.Label">
                                    <dt>@row.Label</dt>
                                    <dd><span>@row.Value</span>@if (row.Detail is not null) { <span class="aqr-muted aqr-coverage-detail">@row.Detail</span> }</dd>
                                </div>
                            }
                        </dl>
                    </ReviewDisclosure>

                    @* The same obligations the result card counts, with their detail — not a second, longer list that made
                       the page say three areas here and five there. *@
                    <ReviewDisclosure Text="Review limitations" CollapseText="Hide review limitations" Hint="@($"{ApiReviewPresentation.ManualReviewAreas.Count} manual review areas")" TestId="aqr-limitations" Class="aqr-detail-disclosure">
                        <p class="aqr-muted">This review is intentionally read-only. These areas are not automatically assessed, and are review obligations rather than findings:</p>
                        <ul class="aqr-list" data-testid="aqr-limitation-areas">
                            @foreach (var obligation in ApiReviewPresentation.ManualReviewObligations)
                            {
                                <li data-testid="aqr-limitation-area">
                                    <strong>@obligation.Area</strong>
                                    <ul class="aqr-list aqr-muted">@foreach (var detail in obligation.Details) { <li data-testid="aqr-limitation-detail">@detail</li> }</ul>
                                </li>
                            }
                        </ul>
                        <ReviewDisclosure Text="View technical limitations" CollapseText="Hide technical limitations" TestId="aqr-limitations-technical" Class="disclosure-inline disclosure-small">
                            <ul class="aqr-list aqr-muted" data-testid="aqr-limitations-list">@foreach (var l in report.Limitations) { <li>@l</li> }</ul>
                        </ReviewDisclosure>
                    </ReviewDisclosure>

                    <ReviewDisclosure Text="@ApiReviewPresentation.ReadOnlyTitle" CollapseText="Hide read-only review" Hint="No write operations executed" TestId="aqr-readonly" Class="aqr-detail-disclosure">
                        <p data-testid="aqr-readonly-summary">@ApiReviewPresentation.ReadOnlySummary</p>
                        @if (report.Coverage.UnsafeOperationsNotExecuted > 0)
                        {
                            <p class="aqr-muted" data-testid="aqr-unsafe-count">@report.Coverage.UnsafeOperationsNotExecuted write @(report.Coverage.UnsafeOperationsNotExecuted == 1 ? "operation was" : "operations were") observed and not executed. Not executing them says nothing about whether they are safe.</p>
                        }
                    </ReviewDisclosure>

                    <ReviewDisclosure Text="API targets" CollapseText="Hide API targets" Hint="@ScopeHint(scope)" TestId="aqr-targets-disclosure" Class="aqr-detail-disclosure">
                        <ApiReviewTargetPicker Targets="@(report.Targets.Select(t => t.Target).ToList())" Selected="@(report.Targets.Select(t => t.Target.TargetId).ToList())" ReadOnly="true" />
                    </ReviewDisclosure>

                    <ReviewDisclosure Text="Authentication details" CollapseText="Hide authentication details" Hint="@ApiReviewAccessAvailabilities.Label(access.Availability)" TestId="aqr-access-details" Class="aqr-detail-disclosure">
                        <ApiReviewAccessDetails Access="@ApiReviewPresentation.AccessPanel(_context, report.Access, report.Targets.Select(t => t.Target).ToList(), report.Targets.Select(t => t.Target.TargetId).ToList())" />
                    </ReviewDisclosure>
                </section>
            }
            else
            {
                <button type="button" class="aqr-link aqr-link-button" data-testid="aqr-review-details-link" @onclick="ShowReviewDetails">View coverage, authentication and review limitations on Overview</button>
            }
        </section>
    }
</div>

@code {
    private static readonly string[] Tabs = ["Overview", "REST", "GraphQL", "Contracts", "Security", "Errors", "Performance", "Findings"];

    private FrontendAnalysisContext? _context;
    private AuthenticatedReviewCapabilities? _capabilities;
    private List<ApiReviewTarget> _targets = [];
    private IReadOnlyDictionary<string, GraphQlSchemaArtifact> _schemaArtifacts = new Dictionary<string, GraphQlSchemaArtifact>();
    private string? _schemaArtifactsError;
    private readonly HashSet<string> _selected = new(StringComparer.Ordinal);
    private readonly HashSet<string> _expandedServices = new(StringComparer.Ordinal);
    private readonly HashSet<string> _expandedFindings = new(StringComparer.Ordinal);
    private ApiReviewHistory? _history;
    private ApiReviewReport? _report;
    private bool _running;
    /// <summary>API targets is the one pre-run detail open by default; everything else under Review details starts collapsed.</summary>
    private bool _targetsExpanded = true;
    private string _progressMessage = "";
    private string? _errorMessage;
    private string _tab = "Overview";
    private string? _requestedTargetId;

    private ApiReviewRunEligibility Eligibility => ApiReviewRunEligibility.Evaluate(_context, _targets, _selected, _capabilities);

    protected override async Task OnInitializedAsync()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (query.TryGetValue("target", out var requested)) _requestedTargetId = requested.ToString();
        _report = RuntimeReviews.ApiQualityReview.Report;
        await History.LoadAsync(JS);
        await Discovery.LoadAsync(JS);
        await RefreshContextAsync();
    }

    private async Task RefreshContextAsync()
    {
        _context = await ContextFactory.GetActiveContextAsync();
        if (_context.ActiveTargetError is not null) { _targets = []; _selected.Clear(); _capabilities = null; return; }
        _history = History.For(_context.ActiveProfile.Id);
        _report ??= _history.LastReport is { } last && last.Environment.EnvironmentId == _context.ActiveProfile.Id ? last : null;
        _targets = ApiReviewTargetResolver.Resolve(_context, Discovery.GetSnapshot(_context.ActiveProfile.Id));
        await LoadSchemaArtifactsAsync();
        _selected.Clear();
        foreach (var t in _targets.Where(t => t.Selected)) _selected.Add(t.TargetId);
        if (_requestedTargetId is not null && _targets.Any(t => t.TargetId == _requestedTargetId)) _selected.Add(_requestedTargetId);
        _capabilities = null;
        var identity = _context.ReviewIdentity ?? ReviewAuthenticationIdentity.ForContext(_context);
        try { _capabilities = await Capabilities.ResolveAsync(identity); }
        catch { _capabilities = new AuthenticatedReviewCapabilities { Method = identity.Method, PublicApi = true, Reason = "Authenticated capabilities could not be resolved; public targets only." }; }
    }

    /// <summary>Trusted schema artifacts of THIS environment only; a failure leaves none (never another environment's) and says so.</summary>
    private async Task LoadSchemaArtifactsAsync()
    {
        _schemaArtifactsError = null;
        if (_context is null || !_targets.Any(t => t.ApiType == ApiReviewTargetType.GraphQl)) { _schemaArtifacts = new Dictionary<string, GraphQlSchemaArtifact>(); return; }
        try
        {
            _schemaArtifacts = (await SchemaArtifacts.ListAsync(_context.ActiveProfile.Id)).ToDictionary(a => a.TargetId, StringComparer.Ordinal);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _schemaArtifacts = new Dictionary<string, GraphQlSchemaArtifact>();
            _schemaArtifactsError = "Configured schema artifacts could not be loaded from the BirkNext backend.";
        }
    }

    private async Task OnSchemaArtifactsChanged() => await LoadSchemaArtifactsAsync();

    private ElementReference _reviewDetailsHeading;
    private bool _focusReviewDetails;
    private void ShowReviewDetails() { _tab = "Overview"; _focusReviewDetails = true; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusReviewDetails)
        {
            _focusReviewDetails = false;
            await _reviewDetailsHeading.FocusAsync();
        }
    }

    private void ToggleTarget(string id, bool selected) { if (selected) _selected.Add(id); else _selected.Remove(id); }

    private void OnToggleTarget((string TargetId, bool Include) change) => ToggleTarget(change.TargetId, change.Include);

    /// <summary>"4 selected · 3 REST · 1 GraphQL" — every part counted from the selected targets, never a literal.</summary>
    private static string ScopeHint(ApiReviewScopeSummary scope) => scope.Selected == 0
        ? "None selected"
        : string.Join(" · ", new[] { $"{scope.Selected} selected", scope.Protocols }.Where(p => !string.IsNullOrEmpty(p)));

    /// <summary>The coverage facts that matter at a glance, read from the report's own coverage rows.</summary>
    private static string CoverageHint(ApiReviewSummaryModel summary) =>
        summary.Coverage.Count == 0 ? "No coverage recorded" : string.Join(" · ", summary.Coverage.Take(2).Select(r => $"{r.Label}: {r.Value}"));

    /// <summary>The two contract states plus the baseline count, in the order the expanded rows repeat them.</summary>
    private static string ContractHint(ApiReviewContractPanelModel contracts) => string.Join(" · ",
        contracts.Rows.Where(r => r.State != ApiReviewContractState.NotApplicable)
            .Select(r => $"{r.Label}: {ApiReviewContractStates.HeaderSummary(r.State)}")
            .Append(contracts.HistoryLabel));
    private void ToggleService(string id) { if (!_expandedServices.Remove(id)) _expandedServices.Add(id); }
    private void ToggleFinding(string id) { if (!_expandedFindings.Remove(id)) _expandedFindings.Add(id); }

    /// <summary>Arrow-key navigation between tabs (WAI-ARIA tabs pattern, manual activation on Enter/Space is the button default).</summary>
    private void OnTabKey(KeyboardEventArgs e, string current)
    {
        var index = Array.IndexOf(Tabs, current);
        if (e.Key == "ArrowRight") _tab = Tabs[(index + 1) % Tabs.Length];
        else if (e.Key == "ArrowLeft") _tab = Tabs[(index - 1 + Tabs.Length) % Tabs.Length];
        else if (e.Key == "Home") _tab = Tabs[0];
        else if (e.Key == "End") _tab = Tabs[^1];
    }

    /// <summary>Creates the immutable review snapshot from the active environment at Run; settings edited while the review runs never affect it.</summary>
    private async Task RunReview()
    {
        if (_running || _context is null || !Eligibility.Enabled) return;
        _running = true; _errorMessage = null; _progressMessage = "Reviewing selected API targets (read-only)…";
        var context = _context;
        var identity = context.ReviewIdentity ?? ReviewAuthenticationIdentity.ForContext(context);
        var request = BuildRequest(context, identity, _targets, _selected, _history);
        RuntimeReviews.MarkApiQualityRunning(context);
        StateHasChanged();
        try
        {
            var (report, error) = await ReviewService.RunAsync(request);
            if (error is not null || report is null)
            {
                _errorMessage = error ?? "The review returned no result.";
                RuntimeReviews.MarkApiQualityFailed(context, _errorMessage);
            }
            else
            {
                _report = report;
                _tab = "Overview";
                _expandedServices.Clear();
                _expandedFindings.Clear();
                RuntimeReviews.SaveApiQualityResult(report, context);
                await History.RecordAsync(JS, context.ActiveProfile.Id, report);
                _history = History.For(context.ActiveProfile.Id);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Review failed: " + ex.GetType().Name;
            RuntimeReviews.MarkApiQualityFailed(context, _errorMessage);
        }
        finally { _running = false; }
    }

    public static ApiReviewRunRequest BuildRequest(FrontendAnalysisContext context, AuthenticatedReviewIdentity identity, IReadOnlyList<ApiReviewTarget> targets, IReadOnlyCollection<string> selected, ApiReviewHistory? history)
    {
        var production = context.ActiveProfile.EnvironmentType == FrontendEnvironmentType.Production;
        var selectedTargets = targets.Select(t => t with { Selected = selected.Contains(t.TargetId) }).Where(t => t.Selected).ToList();
        return new ApiReviewRunRequest
        {
            Environment = new ApiReviewEnvironmentSnapshot
            {
                EnvironmentId = context.ActiveProfile.Id, Name = context.ActiveProfile.Name, EnvironmentType = context.ActiveProfile.EnvironmentType.ToString(), TargetUrl = context.TargetUrl,
                AuthenticatedTestingMethod = identity.Method, RequiresAuthentication = context.RequiresAuthentication, ContextIdentityDigest = identity.ContextFingerprint, IsProduction = production, CapturedAt = DateTimeOffset.UtcNow,
            },
            Identity = identity, Targets = selectedTargets,
            Policy = new ApiReviewPolicy
            {
                ReadOnly = true, ErrorHandlingProbes = !production, IntrospectionExpectedDisabled = production,
                // One setting per check (see ApiReviewPolicy): per-request response time → Single Request Latency (one threshold, so no
                // poor tier); REST payload → REST Payload; GraphQL payload → GraphQL Payload. The payload threshold used to be the larger
                // of REST and GraphQL, so a 500 KB REST setting was evaluated — and shown — as 1,048,576 bytes.
                SlowWarningMs = context.PerformanceThresholds.MaxSingleRequestLatencyMs, SlowPoorMs = null, LatencySource = ApiReviewPresentation.LatencySourceLabel,
                PerformanceProfile = ApiReviewPresentation.ProfileOf(context.PerformanceThresholds.Mode),
                AverageLatencyWarningMs = context.PerformanceThresholds.MaxAverageApiLatencyMs,
                CompressionMinimumBytes = context.PerformanceThresholds.CompressionMinPayloadBytes,
                RestPayloadWarningBytes = context.PerformanceThresholds.MaxRestPayloadBytes, GraphQlPayloadWarningBytes = context.PerformanceThresholds.MaxGraphQlPayloadBytes,
                LargePayloadBytes = context.PerformanceThresholds.MaxRestPayloadBytes,
            },
            Baselines = history is null ? [] : selectedTargets.Where(t => history.Baselines.ContainsKey(t.TargetId)).Select(t => history.Baselines[t.TargetId]).ToList(),
            FrontendOrigin = Uri.TryCreate(context.TargetUrl, UriKind.Absolute, out var origin) ? origin.GetLeftPart(UriPartial.Authority) : null,
        };
    }

    /// <summary>
    /// Return to the setup view. A view transition and nothing else: it starts no review, records nothing, and clears
    /// no state the run produced.
    ///
    /// It deliberately does NOT call <see cref="RefreshContextAsync"/>, which the Frontend Quality Review's equivalent
    /// can afford to. That method re-hydrates <c>_report</c> from history (<c>_report ??= _history.LastReport</c>), so
    /// calling it here would put the result straight back and the button would appear to do nothing — and it rebuilds
    /// the target selection from the saved configuration, which would silently discard whatever the user had ticked.
    ///
    /// The completed run is untouched: it stays in <see cref="IApiReviewHistoryService"/> and in the runtime session,
    /// so the landing view still shows it and re-opening the page restores it.
    /// </summary>
    private void BackToSetup() => _report = null;

    private async Task ExportHtml()
    {
        if (_report is null) return;
        var html = ExportService.ExportApiReview(_report, Workspace.ProjectName);
        await JS.InvokeVoidAsync("downloadHtmlFile", $"api-quality-review-{DateTime.UtcNow:yyyy-MM-dd}.html", html);
    }

    private static string ReadinessTone(ApiReviewReadinessLevel level) => level switch
    {
        ApiReviewReadinessLevel.Ready => "ready",
        ApiReviewReadinessLevel.Limited => "warning",
        ApiReviewReadinessLevel.Blocked => "attention",
        _ => "muted",
    };

    private static string ReadinessIcon(ApiReviewReadinessLevel level) => level switch
    {
        ApiReviewReadinessLevel.Ready => "✓",
        ApiReviewReadinessLevel.Limited => "⚠",
        ApiReviewReadinessLevel.Blocked => "✕",
        _ => "…",
    };

    private RenderFragment RenderChecks(IReadOnlyList<ApiReviewCheck> checks, ApiReviewFindingType[]? areas) => __builder =>
    {
        if (checks.Count == 0) return;
        <details class="aqr-checks" open="@(areas is not null)">
            <summary>@ApiReviewEvidencePresentation.CheckSummary(checks, _report!.Policy)</summary>
            <div class="aqr-tablewrap" tabindex="0" role="region" aria-label="Review evidence table">
                <table class="aqr-table aqr-checks-table" data-testid="aqr-checks-table">
                    <thead><tr><th scope="col">Area</th><th scope="col">Check</th><th scope="col">Result</th><th scope="col">Detail</th><th scope="col">Evidence</th></tr></thead>
                    <tbody>
                        @foreach (var c in checks)
                        {
                            <tr data-testid="aqr-check-row" data-check-id="@c.CheckId" data-result="@c.Result"><td>@ApiReviewStatusLabels.AreaLabel(c.Area)</td><td>@ApiReviewEvidencePresentation.CheckTitle(c)</td><td><span class="aqr-state">@ApiReviewEvidencePresentation.CheckLabel(c, _report!.Policy)</span></td><td>@ApiReviewEvidencePresentation.CheckDetail(c, _report!.Policy)</td><td class="aqr-mono aqr-muted">@string.Join(" · ", c.Evidence.Take(5))</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </details>
    };

    /// <summary>
    /// The observed GraphQL inventory, rendered once: one row per observed document variant, with RUNTIME and CONTRACT in
    /// separate columns (the review never executes an observed business operation; the __typename probe is its own row in the
    /// requests table). Without a schema the Contract column says "Not assessed" for every row — never an empty table under a
    /// "0 observed" line. Incompatible rows open to their violations; compatible rows stay compact.
    /// </summary>
    private RenderFragment RenderObservedOperations(ApiReviewTargetResult t) => __builder =>
    {
        var counts = ApiReviewPresentation.GraphQlCounts(t);
        var compatibility = t.GraphQlCompatibility;
        <h4 class="aqr-group-title">@ApiReviewPresentation.DisplayName(t.Target) · observed operations</h4>
        <p class="aqr-muted" data-testid="aqr-gql-counts">@counts.Summary</p>
        @if (t.GraphQlTechnology is { } technology)
        {
            @* Metadata only: which GraphQL stack the evidence points to, with its confidence and provenance. Never a status or a finding. *@
            <section class="aqr-gql-technology" data-testid="aqr-gql-technology" aria-label="@($"GraphQL technology · {ApiReviewPresentation.DisplayName(t.Target)}")">
                <dl class="aqr-dl aqr-gql-technology-list">
                    <div><dt>GraphQL server</dt><dd data-testid="aqr-gql-tech-server">@ApiReviewGraphQlCompatibilityPresentation.TechnologyLabel(technology.Server)@if (ApiReviewGraphQlCompatibilityPresentation.SourceLabel(technology.Server.Source) is { Length: > 0 } serverSource) { <span class="aqr-muted"> · @serverSource</span> }</dd></div>
                    <div><dt>GraphQL client</dt><dd data-testid="aqr-gql-tech-client">@ApiReviewGraphQlCompatibilityPresentation.TechnologyLabel(technology.Client)@if (ApiReviewGraphQlCompatibilityPresentation.SourceLabel(technology.Client.Source) is { Length: > 0 } clientSource) { <span class="aqr-muted"> · @clientSource</span> }</dd></div>
                </dl>
                <ReviewDisclosure Text="View technology evidence" CollapseText="Hide technology evidence" TestId="@($"aqr-gql-tech-evidence-{t.Target.TargetId}")" Class="disclosure-inline disclosure-small">
                    <ul class="aqr-list aqr-muted" data-testid="aqr-gql-tech-evidence-list">
                        @foreach (var line in technology.Server.Evidence) { <li>Server: @line</li> }
                        @if (technology.Server.Note is { } serverNote) { <li>Server: @serverNote</li> }
                        @foreach (var line in technology.Client.Evidence) { <li>Client: @line</li> }
                        @if (technology.Client.Note is { } clientNote) { <li>Client: @clientNote</li> }
                        <li>Informational only: technology detection never changes schema source, compatibility or severity.</li>
                    </ul>
                </ReviewDisclosure>
            </section>
        }
        @if (compatibility is { Observed: > 0 })
        {
            <div class="aqr-tablewrap" tabindex="0" role="region" aria-label="Observed GraphQL operations">
                <table class="aqr-table" data-testid="aqr-gql-operations">
                    <thead><tr><th scope="col">Operation</th><th scope="col">Type</th><th scope="col">Observations</th><th scope="col">Runtime</th><th scope="col">Contract</th><th scope="col">Last observed</th></tr></thead>
                    <tbody>
                        @foreach (var o in compatibility.Operations)
                        {
                            <tr data-testid="aqr-gql-operation-row" data-compatibility="@o.Status" data-historical="@(o.Historical ? "true" : "false")">
                                <td class="aqr-mono">@(o.OperationName ?? "(anonymous)")@if (o.Historical) { <span class="aqr-pill aqr-pill-muted aqr-gql-historical" data-testid="aqr-gql-historical">Historical</span> }</td>
                                <td>@o.OperationType</td>
                                <td>@o.ObservationCount</td>
                                <td class="aqr-muted" data-testid="aqr-gql-runtime">@ApiReviewGraphQlCompatibilityPresentation.RuntimeLabel(o.OperationType)</td>
                                <td>
                                    <span class="aqr-state aqr-state-@ApiReviewGraphQlCompatibilityPresentation.StatusTone(o.Status)" data-testid="aqr-gql-contract">@ApiReviewGraphQlCompatibilityPresentation.StatusLabel(o.Status)</span>
                                    @if (o.Status == GraphQlCompatibilityStatus.Incompatible)
                                    {
                                        <ReviewDisclosure Text="@($"{o.Issues.Count} validation issue{(o.Issues.Count == 1 ? "" : "s")}")" CollapseText="Hide validation issues" Class="disclosure-inline disclosure-small" TestId="@($"aqr-gql-issues-{o.DocumentHash}")">
                                            <ul class="aqr-gql-issues" data-testid="aqr-gql-issue-list">@foreach (var issue in o.Issues) { <li><span class="aqr-mono">@issue.Code</span> — @issue.Message</li> }</ul>
                                            <p class="aqr-muted">Observed: @o.EvidenceSource · @o.ObservationCount observation@(o.ObservationCount == 1 ? "" : "s")@(o.Historical ? " (historical evidence only)" : "") · Schema: @ApiReviewGraphQlCompatibilityPresentation.SchemaSourceLabel(compatibility)</p>
                                            <p><strong>Recommended action:</strong> @ApiReviewGraphQlCompatibilityPresentation.RecommendedActionFor(t.GraphQlTechnology)</p>
                                        </ReviewDisclosure>
                                    }
                                    else if (o.Status == GraphQlCompatibilityStatus.NotAssessed && o.NotAssessedReason is { } why)
                                    {
                                        <span class="aqr-muted aqr-gql-reason"> · @why</span>
                                    }
                                    @if (o.DeprecatedUsage.Count > 0)
                                    {
                                        <span class="aqr-muted aqr-gql-deprecated" data-testid="aqr-gql-deprecated"> · Observation: @string.Join("; ", o.DeprecatedUsage)</span>
                                    }
                                </td>
                                <td class="aqr-muted">@(o.LastObservedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (counts.Observed > 0)
        {
            @* A report recorded before compatibility existed: the observed operations, with nothing claimed about them. *@
            <div class="aqr-tablewrap" tabindex="0" role="region" aria-label="Observed GraphQL operations">
                <table class="aqr-table" data-testid="aqr-gql-operations">
                    <thead><tr><th scope="col">Operation</th><th scope="col">Runtime</th><th scope="col">Contract</th><th scope="col">Note</th></tr></thead>
                    <tbody>
                        @foreach (var o in t.Operations.Where(o => !o.Executed)) { <tr data-testid="aqr-gql-operation-row"><td class="aqr-mono">@o.Display</td><td class="aqr-muted">Not executed</td><td class="aqr-muted">Not assessed</td><td class="aqr-muted">@o.Note</td></tr> }
                    </tbody>
                </table>
            </div>
        }
    };

    /// <summary>
    /// Contracts → GraphQL client/server compatibility for one endpoint: schema source, the five counts (never merged with drift),
    /// coverage, current vs historical-only, and the incompatible operations. Drift and its client impact are the next section.
    /// </summary>
    private RenderFragment RenderCompatibilityCard(ApiReviewTargetResult t, ApiReviewGraphQlCompatibility c) => __builder =>
    {
        <section class="aqr-card aqr-gql-compatibility" data-testid="aqr-gql-compatibility" aria-label="@($"GraphQL client/server compatibility · {ApiReviewPresentation.DisplayName(t.Target)}")">
            <h4 class="aqr-group-title">Client/server compatibility · @ApiReviewPresentation.DisplayName(t.Target)</h4>
            <dl class="aqr-dl aqr-gql-compatibility-counts">
                <div><dt>Schema source</dt><dd data-testid="aqr-gql-schema-source">@ApiReviewGraphQlCompatibilityPresentation.SchemaSourceLabel(c)@if (c.SchemaRetrievedAt is { } at) { <span class="aqr-muted"> · retrieved @at.ToString("yyyy-MM-dd HH:mm")</span> }</dd></div>
                @if (c.RuntimeSchemaOutcome is { } runtimeOutcome) { <div><dt>Runtime introspection</dt><dd data-testid="aqr-gql-runtime-outcome">@runtimeOutcome</dd></div> }
                @if (c.ConfiguredArtifact is { } snapshot)
                {
                    <div><dt>Schema artifact</dt><dd data-testid="aqr-gql-artifact"><span class="aqr-break">@snapshot.FileName</span> <span class="aqr-muted">· sha256 <span class="aqr-mono">@snapshot.ShortHash</span> · updated @snapshot.UpdatedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC@(snapshot.UsedForCompatibility ? "" : " · fallback, not used")</span></dd></div>
                }
                <div><dt>Observed operations</dt><dd data-testid="aqr-gql-observed">@c.Observed@if (c.HistoricalOnly > 0) { <span class="aqr-muted"> (@c.Current current · @c.HistoricalOnly historical-only)</span> }</dd></div>
                <div><dt>Assessed</dt><dd data-testid="aqr-gql-assessed">@c.Assessed</dd></div>
                <div><dt>Compatible</dt><dd data-testid="aqr-gql-compatible">@(c.Assessed == 0 ? "—" : c.Compatible.ToString())</dd></div>
                <div><dt>Incompatible</dt><dd data-testid="aqr-gql-incompatible">@(c.Assessed == 0 ? "—" : c.Incompatible.ToString())</dd></div>
                <div><dt>Not assessed</dt><dd data-testid="aqr-gql-not-assessed">@c.NotAssessed</dd></div>
                <div><dt>Contract coverage</dt><dd data-testid="aqr-gql-coverage">@ApiReviewGraphQlCompatibilityPresentation.Coverage(c)</dd></div>
            </dl>
            @if (c.ConfiguredArtifactProblem is { } artifactProblem)
            {
                <p class="aqr-muted" data-testid="aqr-gql-artifact-problem">Configured schema artifact not used: @artifactProblem</p>
            }
            @if (c.Operations.Where(o => o.DeprecatedUsage.Count > 0).ToList() is { Count: > 0 } deprecatedOps)
            {
                <p class="aqr-muted" data-testid="aqr-gql-deprecated-summary">Observation (not an incompatibility): @deprecatedOps.Count compatible operation@(deprecatedOps.Count == 1 ? " uses" : "s use") deprecated schema members.</p>
            }
            @if (c.NotAssessedReason is { } reason)
            {
                <p class="aqr-muted" data-testid="aqr-gql-not-assessed-reason">Not assessed: @reason Compatibility is not the same as reachability: the endpoint itself was reviewed separately.</p>
            }
            @foreach (var o in c.Operations.Where(o => o.Status == GraphQlCompatibilityStatus.Incompatible))
            {
                <div class="aqr-gql-incompatible" data-testid="aqr-gql-incompatible-detail">
                    <p><strong class="aqr-mono">@(o.OperationName ?? "(anonymous)")</strong> · @o.OperationType · <span class="aqr-state aqr-state-fail">Incompatible</span>@if (o.Historical) { <span class="aqr-pill aqr-pill-muted aqr-gql-historical">Historical</span> }</p>
                    <p>@o.Issues[0].Message@(o.Issues.Count > 1 ? $" (+{o.Issues.Count - 1} more)" : "")</p>
                    <p class="aqr-muted">Observed: @o.EvidenceSource · @o.ObservationCount observation@(o.ObservationCount == 1 ? "" : "s") · Last observed @(o.LastObservedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</p>
                </div>
            }
        </section>
    };

    private RenderFragment RenderFindings(ApiReviewReport report, IReadOnlyList<ApiReviewFinding> findings, ApiReviewFindingType[]? areas) => __builder =>
    {
        <h4 class="aqr-group-title">Source findings (@findings.Count)</h4>
        @if (findings.Count == 0)
        {
            <p class="aqr-empty" data-testid="aqr-no-findings">No findings@(areas is null ? "" : " in this area") on the assessed targets. Blocked or not-assessed targets are listed as such, never as passes.</p>
        }
        else
        {
            <div class="aqr-tablewrap" tabindex="0" role="region" aria-label="Review evidence table">
                <table class="aqr-table aqr-findings-table" data-testid="aqr-findings-table">
                    <thead><tr><th scope="col">Severity</th><th scope="col">Service</th><th scope="col">Type</th><th scope="col">Endpoint / operation</th><th scope="col">Finding</th><th scope="col"><span class="aqr-visually-hidden">Details</span></th></tr></thead>
                    <tbody>
                        @foreach (var f in findings)
                        {
                            var expanded = _expandedFindings.Contains(f.Id);
                            var detailId = $"aqr-finding-details-{f.Id}";
                            <tr data-testid="aqr-finding-row" data-finding-id="@f.Id" data-severity="@f.Severity">
                                <td><span class="aqr-sev aqr-sev-@f.Severity.ToString().ToLowerInvariant()"><span class="aqr-sev-label">@f.Severity</span></span></td>
                                <td>@ApiReviewPresentation.ServiceNameOf(report, f.TargetId)</td>
                                <td>@ApiReviewStatusLabels.AreaLabel(f.Type)@(f.Drift is { } d ? $" · {ApiReviewStatusLabels.DriftLabel(d)}" : "")</td>
                                <td class="aqr-mono">@f.Endpoint</td>
                                <td><strong>@f.Title</strong></td>
                                <td><button type="button" class="aqr-row-toggle" aria-expanded="@(expanded ? "true" : "false")" aria-controls="@detailId" aria-label="@($"{(expanded ? "Hide" : "Show")} evidence for {f.Title} on {ApiReviewPresentation.ServiceNameOf(report, f.TargetId)}")" data-testid="aqr-finding-toggle" @onclick="() => ToggleFinding(f.Id)">@(expanded ? "Hide details" : "Details")</button></td>
                            </tr>
                            <tr id="@detailId" class="aqr-finding-details" hidden="@(!expanded)" data-testid="aqr-finding-details">
                                <td colspan="6">
                                    <dl class="aqr-dl aqr-dl-technical">
                                        <div><dt>Description</dt><dd>@f.Description</dd></div>
                                        <div><dt>Check</dt><dd>@f.Check · <span class="aqr-state aqr-state-@f.Result.ToString().ToLowerInvariant()" data-testid="aqr-finding-check-result">@ApiReviewStatusLabels.FindingCheckLabel(f)</span></dd></div>
                                        @if (f.Evidence.Count > 0) { <div><dt>Evidence</dt><dd class="aqr-mono aqr-evidence">@string.Join(" · ", f.Evidence.Take(8))</dd></div> }
                                        <div><dt>Recommendation</dt><dd>@f.Recommendation</dd></div>
                                        @if (f.Result == ApiReviewCheckResult.ManualReview) { <div><dt>Manual verification</dt><dd>Required — this item was not verified automatically.</dd></div> }
                                        @if (f.Drift is { } drift) { <div><dt>Contract drift</dt><dd>@ApiReviewStatusLabels.DriftLabel(drift)</dd></div> }
                                    </dl>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    };
}
