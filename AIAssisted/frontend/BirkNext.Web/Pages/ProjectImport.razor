@page "/project-import"
@using BirkNext.Integrations
@using BirkNext.ProjectImport
@using BirkNext.Web.Services
@using BirkNext.Web.Services.ProjectImport
@using BirkNext.Web.Services.ProjectEvidence
@using BirkNext.Web.Services.Explorers
@using BirkNext.Web.Services.SampleProjects
@using BirkNext.Web.Models
@using BirkNext.Web.Components.ProjectImport
@using Microsoft.AspNetCore.Components.Forms
@inject IProjectImportApiService Api
@inject ProjectImportActivation Activation
@inject IFrontendAnalysisContextFactory ContextFactory
@inject ProjectApplicabilityState Applicability
@inject IWorkspaceAutoSaveService AutoSave
@inject IJSRuntime JS
@inject IServiceProvider ServiceProvider
@inject ProjectImportSession Session
@implements IDisposable
@using Phase = BirkNext.Web.Services.ProjectImport.ProjectImportPhase

@* Project Import: one archive, uploaded once. Its documents become artifacts in the Shared Artifact Repository and its source becomes a
   Source Analysis snapshot. The two stay separate evidence domains; they share only the import identity and the archive fingerprint. *@
<PageTitle>Import Project</PageTitle>
<div class="pi-page">
    <PageHeader Title="Import Project" Description="Import source code, project documents or additional evidence. Upload one ZIP containing source code, supported project documents, or both.">
        @* The primary import action is always here, before and after the first import (never only at the end of the page). It opens the one
           existing upload flow below; nothing is imported until a file is chosen and its preview confirmed. *@
        @if (!ZipFormOpen)
        {
            <button type="button" class="btn btn-primary" id="pi-header-import" data-testid="pi-header-import" aria-controls="pi-choose" aria-expanded="false"
                    disabled="@Session.IsBusy" title="@(Session.IsBusy ? "An import is running" : null)" @onclick="ImportZipFromHeader">Import ZIP</button>
        }
        @if (GitSources is not null && !GitFormOpen)
        {
            <button type="button" class="btn btn-secondary" id="pi-header-git" data-testid="pi-header-git" aria-controls="pi-git" aria-expanded="false"
                    disabled="@Session.IsBusy" title="@(Session.IsBusy ? "An import is running" : null)" @onclick="OpenGit">Import from Git</button>
        }
        @if (_phase == Phase.Result)
        {
            @* Same place as Back in the review pages' post-run headers. Secondary: the next steps below stay the primary actions. *@
            <button type="button" class="btn-secondary" data-testid="pi-back" @onclick="BackToImportProject">Back to Import Project</button>
        }
    </PageHeader>
    <BirkNext.Web.Components.ProjectContextStrip RequiresEnvironment="false" />

    @if (_phase == Phase.Choose)
    {
        @* ── Upload: shown without a current project, or after Import ZIP. It sits right under
           the header so the action and its form are together; the current import below stays as it is until a new import succeeds. ── *@
        @if (Activation.Current is null && !_showUpload && !_showGit)
        {
            <section class="pi-card pi-start" data-testid="pi-start" aria-label="Start">
                <h2>No project is imported yet</h2>
                <ul class="pi-start-ways">
                    <li><strong>Import ZIP</strong> — a ZIP from your computer with source code, project documents or both.</li>
                    @if (GitSources is not null) { <li><strong>Import from Git</strong> — a repository on this computer or a Git URL, read-only.</li> }
                </ul>
                <p class="pi-muted">BirkNext shows what it found before anything is imported. <a href="demo-projects">Demo Projects</a> remain available as optional examples.</p>
            </section>
        }
        @if (_showUpload)
        {
        <section class="pi-card pi-choose" id="pi-choose" aria-labelledby="pi-choose-heading" data-testid="pi-choose">
            <h2 id="pi-choose-heading" tabindex="-1">@UploadHeading</h2>
            <p class="pi-muted">One ZIP with project source, project documents, or both. BirkNext shows what it found before anything is imported.</p>
            @if (Activation.Current is { } keep)
            {
                <p class="pi-muted" data-testid="pi-choose-keeps">@keep.ProjectName stays the current import until the new import succeeds. Imported packages remain available in history.</p>
            }
            @if (Activation.CurrentApplication is not null)
            {
                @* "Belongs to project" (2026-11-21): one field over every project (the entries of the Project list) plus "New project". Replaces the
                   "Add evidence to current application" / "Import another application" choice: the project a ZIP belongs to cannot be read from its
                   content (a second repository of the same application looks like another application), so the tester says it here. *@
                var projects = ProjectChoices();
                var chosenProject = TargetProject();
                <div class="pi-intent pi-belongs" data-testid="pi-intent">
                    <label class="pi-belongs-field" for="pi-target-project"><strong>Belongs to project</strong></label>
                    <select id="pi-target-project" data-testid="pi-target-project" disabled="@Session.IsBusy" @onchange="e => SetProject(e.Value?.ToString())">
                        @foreach (var project in projects)
                        {
                            <option value="@project.Id" selected="@(Session.Target == ImportTarget.CurrentApplication && chosenProject?.Id == project.Id)">@project.Name</option>
                        }
                        <option value="@NewProjectValue" selected="@(Session.Target == ImportTarget.NewApplication)">＋ New project (named after the ZIP)</option>
                    </select>
                </div>
                <p class="pi-muted" data-testid="pi-choose-target" data-target="@Session.Target" data-project="@chosenProject?.Id">@(chosenProject is null
                    ? "The ZIP starts a new project, listed in the Project list. Existing projects and their evidence stay as they are."
                    : $"The ZIP is added as evidence for {chosenProject.Name}. Nothing already imported is replaced; a supporting package never replaces the project's primary documents.")</p>
            }
            @* Optional roles, the same vocabulary as Source Management and Target Environments → Project. Saved after the import only where the
               content supports them; nothing ticked = detected from content. *@
            <fieldset class="pi-intent pi-roles" id="pi-roles" tabindex="-1" data-testid="pi-roles" disabled="@Session.IsBusy">
                <legend>1. What does this ZIP contain? <span class="pi-muted">Tick one or more</span></legend>
                <div class="pi-role-grid">
                    @foreach (var role in ImportRoleChoice.Choices)
                    {
                        <label class="pi-role-option"><input type="checkbox" checked="@Session.ChosenRoles.Contains(role)" data-testid="pi-zip-role" data-role="@role"
                               @onchange="e => ToggleRole(role, e.Value is true)" /> @ApplicationContexts.RoleLabel(role)</label>
                    }
                    <label class="pi-role-option pi-role-detect"><input type="checkbox" checked="@Session.DetectRoles" data-testid="pi-zip-detect"
                           @onchange="e => SetDetect(e.Value is true)" /> Not sure — let BirkNext detect it</label>
                </div>
                @if (Session.ChosenRoles.Contains(PackageEvidenceRole.PrimaryApplicationSource) && TargetProject() is { } primaryApp
                     && PackagesOf(primaryApp.Id).Any(p => p.Role == PackageEvidenceRole.PrimaryApplicationSource))
                {
                    <p class="pi-warning" role="status" data-testid="pi-roles-primary-note">@primaryApp.Name already has a primary application source. If this ZIP is a different application, choose <strong>New project</strong> under Belongs to project; otherwise it is added as a contributing application source.</p>
                }
                <p class="pi-muted pi-small" data-testid="pi-roles-where">After the import the roles appear in Manage sources and, when the active Target Environment tests this project, in its Project roles. A role the content does not show is not saved.</p>
            </fieldset>
            <div class="pi-zip-step" data-testid="pi-method-zip">
                <p class="pi-step-title"><strong>2. Choose the ZIP</strong> <span class="pi-muted">ZIP · maximum 50 MB · documents up to 1 MB each</span></p>
                <div class="pi-actions">
                    @if (CanChooseFile)
                    {
                        <label class="pi-file-button">
                            <InputFile @key="_inputGeneration" id="pi-choose-file" class="pi-file-input" accept=".zip" OnChange="ChooseAsync" disabled="@Session.IsBusy"
                                       aria-label="Choose the ZIP (maximum 50 MB)" data-testid="pi-choose-file" data-generation="@_inputGeneration" />
                            <span aria-hidden="true">Choose ZIP file</span>
                        </label>
                    }
                    else
                    {
                        @* Looks unavailable until the content question is answered; a click says why instead of doing nothing. *@
                        <button type="button" class="pi-file-button is-disabled" aria-disabled="true" aria-describedby="@(_choiceHint ? "pi-choose-hint" : null)"
                                data-testid="pi-choose-locked" @onclick="ChooseLockedClicked">Choose ZIP file</button>
                    }
                    <button type="button" class="btn-secondary" data-testid="pi-choose-cancel" @onclick="CloseUpload">Cancel</button>
                </div>
                @if (_choiceHint && !CanChooseFile)
                {
                    <p class="pi-warning" id="pi-choose-hint" role="alert" data-testid="pi-choose-hint">Tick what the ZIP contains first, or “Not sure — let BirkNext detect it”.</p>
                }
            </div>
            <p class="pi-muted pi-small" data-testid="pi-source-only-note">To analyze a source archive on its own, upload it in <a href="source-analysis">Source Analysis</a>: it creates the same source analysis, but no project documents, and it does not become the current project. It is still listed below with the imported sources.</p>
        </section>
        }
        @if (_showGit && GitSources is not null)
        {
            <section class="pi-card pi-git" id="pi-git" data-testid="pi-method-git" aria-label="Import from Git">
                <BirkNext.Web.Components.GitImportWizard OnImport="StartGitQueueAsync" />
                <div class="pi-actions"><button type="button" class="btn-secondary" data-testid="pi-git-cancel" @onclick="CloseGit">Cancel</button></div>
            </section>
        }
        @if (Activation.Current is { } current)
        {
            var currentSource = ProjectImportPresentation.CurrentSource(current, DateTimeOffset.UtcNow);
            var currentSnapshot = CurrentSnapshot(current);
            var analysis = ImportProjectOverview.SourceAnalysis(currentSource, currentSnapshot);
            var sourceRole = ImportProjectOverview.SourceRole(_setup, currentSource.SnapshotId, currentSource.SourceDetected);
            var application = Activation.CurrentApplication;
            var packages = ApplicationPackages();
            var currentPackage = packages.FirstOrDefault(p => p.ImportId == current.ImportId);
            <div class="pi-current-group" data-testid="pi-current">
            @if (application is not null)
            {
                @* ── 0 · Target application: the logical application all imported evidence belongs to (never the package imported last) ── *@
                <section class="pi-card pi-application" aria-labelledby="pi-application-heading" data-testid="pi-application" data-application="@application.Id">
                    @if (_renaming == application.Id)
                    {
                        <form class="pi-rename" data-testid="pi-rename" @onsubmit="() => SaveRenameAsync(application.Id)" @onsubmit:preventDefault>
                            <label for="pi-rename-input"><span class="pi-current-eyebrow">Project name</span></label>
                            <input id="pi-rename-input" class="pi-name-input" maxlength="@ApplicationContexts.MaxNameLength" value="@_renameValue" @oninput="e => { _renameValue = e.Value?.ToString() ?? string.Empty; _renameProblem = null; }"
                                   aria-invalid="@(_renameProblem is null ? "false" : "true")" data-testid="pi-rename-input" />
                            <button type="submit" class="btn-primary" disabled="@_renameBusy" data-testid="pi-rename-save">Save name</button>
                            <button type="button" class="btn-secondary" @onclick="CancelRename" data-testid="pi-rename-cancel">Cancel</button>
                            @if (_renameProblem is { } renameProblem) { <span class="pi-warning" role="alert" data-testid="pi-rename-problem">@renameProblem</span> }
                        </form>
                    }
                    else
                    {
                        <h2 id="pi-application-heading" class="pi-current-heading"><span class="pi-current-eyebrow">Target application</span> <strong data-testid="pi-application-name">@application.Name</strong>
                            <button type="button" class="pi-link-button" id="pi-rename-open" @onclick="() => StartRename(application)" aria-label="Rename @application.Name" data-testid="pi-rename-open">Rename</button></h2>
                    }
                    <p class="pi-muted" data-testid="pi-application-count">Imported evidence packages: @packages.Count</p>
                    <ul class="pi-application-packages" aria-label="Evidence packages of @application.Name">
                        @foreach (var package in packages)
                        {
                            var packageAnalysis = ImportProjectOverview.SourceAnalysis(ProjectImportPresentation.CurrentSource(package.Record, DateTimeOffset.UtcNow), CurrentSnapshot(package.Record));
                            <li class="pi-application-package" data-testid="pi-application-package" data-import="@package.ImportId" data-role="@package.Role">
                                <strong>@package.DisplayName</strong>
                                <span class="pi-badge pi-badge-neutral" data-testid="pi-application-package-role">@ApplicationContexts.RoleLabel(package.Role)</span>
                                @* Package-specific: each package keeps its own Source Analysis result. *@
                                @if (packageAnalysis.State != ImportAnalysisState.NoSource) { <span class="pi-muted" data-testid="pi-application-package-analysis">Source Analysis: @packageAnalysis.Status</span> }
                                @if (package.ImportId == current.ImportId) { <span class="pi-muted">· documents shown</span> }
                            </li>
                        }
                    </ul>
                    @foreach (var other in packages.Where(p => ApplicationContexts.LooksLikeAnotherApplication(p, packages, application)))
                    {
                        @* An application imported as "more evidence" of another one (M2LB under Tiltak 2): say so and offer the one-click fix. *@
                        <div class="pi-warning pi-another-app" role="status" data-testid="pi-another-application" data-import="@other.ImportId">
                            <p><strong>@other.DisplayName looks like a different application.</strong> It has its own startup project and its name does not match
                                @application.Name. It was added as more evidence for @application.Name, so the Project list shows one entry for both.</p>
                            <div class="pi-actions">
                                <button type="button" class="btn-primary btn-sm" disabled="@_moving" @onclick="() => MakeOwnProjectAsync(other)" data-testid="pi-another-application-move">Make @other.DisplayName its own project</button>
                                <button type="button" class="btn-secondary btn-sm" disabled="@_moving" @onclick="() => KeepWithApplicationAsync(other)" data-testid="pi-another-application-keep">Keep it with @application.Name</button>
                            </div>
                            <p class="pi-muted">Nothing is re-imported or deleted either way; you can change it later in Manage sources → Belongs to project.</p>
                        </div>
                    }
                    @if (_moveMessage is { } moveMessage) { <p class="pi-muted" role="status" data-testid="pi-move-message">@moveMessage</p> }
                    @if (_setup is { Packs.Count: > 0 } appSetup)
                    {
                        @* Application readiness: all evidence of the workspace is evaluated, never only the package being inspected. *@
                        <dl class="pi-facts pi-application-readiness" data-testid="pi-application-readiness">
                            @foreach (var line in appSetup.Packs.SelectMany(p => p.Sources.OrderBy(SourceSetupPresentation.Order).Select(ImportProjectOverview.Line)).DistinctBy(l => l.Key))
                            {
                                <div data-testid="pi-application-readiness-row" data-role="@line.Key"><dt>@line.Label@(line.Optional ? " (optional)" : "")</dt><dd>@line.State</dd></div>
                            }
                        </dl>
                    }
                </section>
            }
            @* ── A · Current project summary: import, documents, source analysis, source role and test environment are separate statuses ── *@
            <section class="pi-card pi-current" aria-labelledby="pi-current-heading" data-testid="pi-current-card">
                @* One imported package: the package whose documents are shown. The application is the card above. *@
                <h2 id="pi-current-heading" tabindex="-1" class="pi-current-heading"><span class="pi-current-eyebrow">Current import</span> <strong data-testid="pi-current-name">@current.ProjectName</strong></h2>
                <p class="pi-current-success" data-testid="pi-current-success"><span aria-hidden="true">✓ </span><strong>@current.ProjectName imported successfully.</strong> @ImportProjectOverview.ImportedKind(current, currentSource). Import means BirkNext found and recorded the contents — nothing has been reviewed or tested yet.</p>
                @if (application is not null)
                {
                    <dl class="pi-facts" data-testid="pi-current-association">
                        @if (currentPackage is not null) { <div><dt>Role</dt><dd data-testid="pi-current-package-role">@ApplicationContexts.RoleLabel(currentPackage.Role)</dd></div> }
                        <div><dt>Associated application</dt><dd data-testid="pi-current-application">@application.Name</dd></div>
                    </dl>
                }
                <p class="pi-current-summary" data-testid="pi-current-summary">@ImportProjectOverview.Summary(current, _workspace, currentSource)</p>
                @PackageCapabilities(current)
                <dl class="pi-current-status">
                    <div data-testid="pi-current-documents"><dt>Documents</dt><dd>@(current.ArtifactDocumentCount > 0 && _workspace?.Overview is { } docOverview ? ImportProjectOverview.DocumentTypes(docOverview) : DocumentsFact(current))</dd></div>
                    <div data-testid="pi-current-source" data-has-snapshot="@(currentSource.SnapshotId is null ? "false" : "true")" data-state="@analysis.State">
                        <dt>Source Analysis</dt>
                        <dd>
                            <span class="pi-badge pi-badge-@ProjectImportPresentation.ToneClass(analysis.Tone)" data-testid="pi-current-source-status">@analysis.Status</span>
                            @if (analysis.Explanation is { } explanation) { <span class="pi-muted" data-testid="pi-current-source-explanation"> @explanation</span> }
                            @if (analysis.Areas is { } areas) { <span class="pi-areas" data-testid="pi-current-source-areas">@areas</span> }
                            @if (analysis.HasDetails && currentSource.SnapshotId is { } detailSnapshot) { <a href="@ProjectImportPresentation.SourceAnalysisHref(detailSnapshot)" data-testid="pi-current-analysis-details">View analysis details</a> }
                        </dd>
                    </div>
                    @if (sourceRole is { } role)
                    {
                        <div data-testid="pi-current-role" data-identified="@(role.Identified ? "true" : "false")">
                            <dt>Source role</dt>
                            <dd><span class="pi-badge pi-badge-@(role.Identified ? "available" : "neutral")" data-testid="pi-current-role-status">@role.Status</span>@if (PackageRoleNote(currentPackage, application) is { } note) { <span class="pi-muted" data-testid="pi-current-role-note"> @note</span> } else if (role.Detail is { } roleDetail) { <span class="pi-muted" data-testid="pi-current-role-detail"> @roleDetail</span> }</dd>
                        </div>
                    }
                    <div data-testid="pi-current-environment"><dt>Test environment</dt><dd><span class="pi-badge pi-badge-@(_hasTarget ? "available" : "partial")">@(_environmentName ?? "Not selected")</span></dd></div>
                </dl>
                @if (_currentRetryMessage is { } retryMessage) { <p class="pi-warning" role="status" data-testid="pi-current-retry-message">@retryMessage</p> }
            </section>

            @* ── B · Needs attention, grouped by who resolves it (documents ≠ testing setup ≠ source analysis ≠ environment) ── *@
            @{ var attention = ImportProjectOverview.Attention(_workspace, _setup, currentSource, _hasTarget); var open = attention.Count(a => !a.Informational); }
            <section class="pi-card pi-attention" aria-labelledby="pi-attention-heading" data-testid="pi-attention">
                <h2 id="pi-attention-heading">Needs attention <span class="pi-muted" data-testid="pi-attention-count">@(open > 0 ? $"· {open} thing{(open == 1 ? "" : "s")} need{(open == 1 ? "s" : "")} attention" : "· nothing to resolve")</span></h2>
                @if (attention.Count == 0)
                {
                    <p class="pi-muted">Nothing needs attention. You can start reviewing.</p>
                }
                else
                {
                    @foreach (var (group, title, items) in ImportProjectOverview.Grouped(attention))
                    {
                        <div class="pi-attention-group" data-testid="pi-attention-group" data-group="@group">
                            <h3 class="pi-attention-group-title">@title</h3>
                            <ul class="pi-attention-list">
                                @foreach (var item in items)
                                {
                                    <li class="pi-attention-item @(item.Informational ? "is-info" : "is-attention")" data-testid="pi-attention-item" data-key="@item.Key">
                                        <span class="pi-attention-kind">@(item.Informational ? "Note" : "Attention")</span>
                                        <span class="pi-attention-body"><span class="pi-attention-text">@item.Text</span>@if (item.Detail is { Length: > 0 } detail) { <span class="pi-muted">@detail</span> }</span>
                                        <a href="@item.Href" class="pi-attention-action" data-testid="pi-attention-action">@item.ActionLabel</a>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                }
            </section>

            @* ── C · What can I do now? Only actions useful in the current state; Source Analysis is technical evidence, so secondary ── *@
            <section class="pi-card" aria-labelledby="pi-next-now-heading" data-testid="pi-now">
                <h2 id="pi-next-now-heading">What can I do now?</h2>
                <div class="pi-actions">
                    @if (FirstExplorer(current) is { } explorer) { <a class="btn-primary" href="@explorer.Route" data-testid="pi-current-open-documents">Review project documents</a> }
                    @if (_setup is { Packs.Count: > 0 })
                    {
                        <a class="btn-secondary" href="#pi-setup-heading" data-testid="pi-current-open-setup">Review testing setup</a>
                        <a class="btn-secondary" href="integration-quality-review" data-testid="pi-current-open-integrations">Review integrations</a>
                    }
                    @if (currentSource.SnapshotId is { } openSnapshot)
                    {
                        <a class="btn-secondary" href="@ProjectImportPresentation.SourceAnalysisHref(openSnapshot)" data-testid="pi-current-open-source">View Source Analysis</a>
                    }
                    else if (currentSource.CanRetry)
                    {
                        <button type="button" class="btn-secondary" data-testid="pi-current-retry-source" disabled="@_retrying" @onclick="() => RetryCurrentSourceAsync(current)">@(_retrying ? "Retrying…" : "Retry creating source analysis")</button>
                    }
                    @* One import action: the project the ZIP belongs to (this one, another one or a new one) is chosen in the form. *@
                    <button type="button" class="btn-secondary" id="pi-current-import-another" data-testid="pi-current-import-another" aria-expanded="@(_showUpload ? "true" : "false")" aria-controls="pi-choose" @onclick="ImportMoreEvidence">Import ZIP</button>
                    <a href="sources" class="btn-secondary" data-testid="pi-manage-sources">Manage sources</a>
                    <button type="button" class="btn-secondary" data-testid="pi-close" @onclick="CloseCurrent">Clear current import</button>
                </div>
                <p class="pi-muted" data-testid="pi-close-help">Clearing only stops showing this package's documents. The application@(application is null ? "" : $" {application.Name}"), its evidence packages, their source analysis and Integration Quality Review bindings are unchanged: nothing is deleted or unbound. Imported data remains available in history.</p>
            </section>

            @* ── D · Project contents ── *@
            <section class="pi-card pi-project-artifacts" aria-labelledby="pi-artifacts-heading" data-testid="pi-current-candidates" data-import="@current.ImportId">
                <h2 id="pi-artifacts-heading">Project contents</h2>
                @* Status per kind of content, from what the import and its stored snapshot already hold (nothing is analyzed for this). *@
                <dl class="pi-facts pi-contents-status" data-testid="pi-contents-status">
                    <div><dt>Source code</dt><dd data-testid="pi-contents-source">@(currentSource.SourceDetected ? "Available" : "Not in this archive")</dd></div>
                    @if (currentSnapshot is { InfrastructureFormats.Count: > 0 } iacSnapshot) { <div><dt>Infrastructure</dt><dd data-testid="pi-contents-infrastructure">@string.Join(", ", iacSnapshot.InfrastructureFormats) detected</dd></div> }
                    @if (currentSnapshot?.Areas.FirstOrDefault(a => a.Area == "Contracts") is { Status: "Complete" or "Partial" } contracts) { <div><dt>Contracts/schemas</dt><dd data-testid="pi-contents-contracts">Detected@(contracts.Status == "Partial" ? " · partially analyzed" : "")</dd></div> }
                </dl>
                @if (current.ArtifactDocumentCount > 0) { <ProjectArtifactCandidateReview @key="current.ImportId" LabelledBy="pi-artifacts-heading" /> }
                else { <p class="pi-muted" data-testid="pi-current-no-artifacts">No supported project documents were found. @(currentSource.SourceDetected ? "The source code can still be reviewed." : "")</p> }
            </section>
            </div>
        }

        @* ── E · Testing / integration setup detected ── *@
        @if (_setup is { } setup && ImportProjectOverview.DetectedPacks(setup, Activation.Imports.Count > 0) is { Count: > 0 } detectedPacks)
        {
            <section class="pi-card pi-setup-summary" aria-labelledby="pi-setup-heading" data-testid="pi-setup-summary">
                <h2 id="pi-setup-heading" tabindex="-1">Testing setup detected</h2>
                @foreach (var pack in detectedPacks)
                {
                    var lines = pack.Sources.OrderBy(SourceSetupPresentation.Order).Select(ImportProjectOverview.Line).ToList();
                    <div class="pi-setup-pack" data-testid="pi-setup-pack" data-pack="@pack.PackId">
                        <h3 class="pi-setup-pack-name">@pack.DisplayName</h3>
                        <p class="pi-setup-headline" data-testid="pi-setup-headline">@ImportProjectOverview.SetupHeadline(pack)</p>
                        <ul class="pi-setup-lines">
                            @foreach (var line in lines)
                            {
                                <li class="pi-setup-line @(line.NeedsAttention ? "is-attention" : "")" data-testid="pi-setup-line" data-role="@line.Key">
                                    <span class="pi-setup-line-label">@line.Label@(line.Optional ? " (optional)" : "")</span>
                                    <span class="pi-setup-line-state"><span class="visually-hidden">@(line.NeedsAttention ? "Needs attention: " : "")</span>@line.State</span>
                                    @if (line.ActionLabel is { } actionLabel && line.Href is { } actionHref) { <a href="@actionHref" aria-label="@line.ActionName" class="pi-setup-line-action" data-testid="pi-setup-line-action">@actionLabel</a> }
                                </li>
                            }
                        </ul>
                        @if (!setup.BindingsRead) { <p class="pi-muted" data-testid="pi-setup-environment">Integration review requires a test environment. <a href="@NavigationCatalog.TargetEnvironmentsRoute">Select test environment</a></p> }
                    </div>
                }
                <details class="pi-details" data-testid="pi-setup-all-details">
                    <summary>Review setup details</summary>
                    <TestPackSourceSetupPanel Setup="setup" />
                </details>
            </section>
        }

        @* ── F · Previously imported projects (most recent first; opening one never re-imports or changes evidence) ── *@
        @if (ProjectImportHistory.Previous(Activation.Imports, Activation.Current?.ImportId, _setup) is { Count: > 0 } previous)
        {
            <section class="pi-card pi-previous" aria-labelledby="pi-previous-heading" data-testid="pi-previous">
                <h2 id="pi-previous-heading">Previously imported packages and sources</h2>
                <p class="pi-muted" data-testid="pi-previous-help">Each keeps its own source analysis, which testing setups and Integration Quality Review use directly — whichever project is current. <strong>Show this package</strong> only changes which package's documents BirkNext shows: it does not re-import, analyze, or change saved review evidence or integration bindings.</p>
                <p class="pi-muted" data-testid="pi-current-guidance">Choose the primary application/system when possible. Documentation, infrastructure and supporting packages can still contribute evidence without becoming the current project: bind them in <a href="@ProjectEvidenceResolver.ProjectTabHref(null)">Target Environment → Project</a>.</p>
                @if (_useMessage is { } useMessage) { <p class="pi-warning" role="status" data-testid="pi-use-message">@useMessage</p> }
                <ul class="pi-previous-list" aria-label="Previously imported projects and sources">
                    @foreach (var row in previous)
                    {
                        var rowAnalysis = ImportProjectOverview.SourceAnalysis(row.HasSource, row.SnapshotId, row.Snapshot);
                        var rowRole = ImportProjectOverview.SourceRole(_setup, row.SnapshotId, row.HasSource);
                        <li class="pi-previous-row" data-testid="pi-previous-row" data-origin="@row.Origin" data-import="@row.ImportId" data-snapshot="@row.SnapshotId">
                            <div class="pi-setup-head">
                                <strong class="pi-previous-name" data-testid="pi-previous-name">@row.DisplayName</strong>
                                <span class="pi-muted" data-testid="pi-previous-contents">@ImportProjectOverview.Contents(row)</span>
                                @if (ApplicationOf(row.ImportId) is { } rowApplication) { <span class="pi-muted" data-testid="pi-previous-application">Application: @rowApplication.Name</span> }
                            </div>
                            @if (row.ImportId is { } rowImport && Activation.Imports.FirstOrDefault(i => i.ImportId == rowImport) is { } rowRecord && row.Origin == PreviousImportOrigin.ProjectImport)
                            {
                                @PackageCapabilities(rowRecord)
                            }
                            <dl class="pi-previous-facts">
                                @if (rowRole is { } previousRole) { <div><dt>Source role</dt><dd data-testid="pi-previous-role">@previousRole.Status</dd></div> }
                                @if (row.HasSource) { <div><dt>Source Analysis</dt><dd><span class="pi-badge pi-badge-@ProjectImportPresentation.ToneClass(rowAnalysis.Tone)" data-testid="pi-previous-analysis">@rowAnalysis.Status</span></dd></div> }
                                @if (row.ConfigurationEnvironments.Count > 0)
                                {
                                    <div><dt>Environment labels</dt><dd data-testid="pi-previous-environment-labels" title="Labels found in source, not proof of deployment.">@string.Join(" · ", row.ConfigurationEnvironments)<span class="visually-hidden"> (labels found in source, not proof of deployment)</span></dd></div>
                                }
                                @* IQR bindings belong to a target environment: shown only when one is selected and the source is actually bound. *@
                                @if (_setup is { BindingsRead: true } && row.BoundIntegrations.Count > 0) { <div><dt>IQR bindings</dt><dd data-testid="pi-previous-binding-count">@row.BoundIntegrations.Count</dd></div> }
                                <div><dt>Imported</dt><dd data-testid="pi-previous-when">@ImportProjectOverview.Date(row.ImportedAt)</dd></div>
                            </dl>
                            <div class="pi-actions">
                                @if (row.CanUseAsCurrent) { <button type="button" class="btn-secondary" data-testid="pi-previous-use" aria-label="@($"Show {row.DisplayName}'s documents")" @onclick="() => UseAsCurrent(row.ImportId!)">Show this package</button> }
                                @if (row.SnapshotId is { } openRowSnapshot) { <a class="btn-secondary" href="@ProjectImportPresentation.SourceAnalysisHref(openRowSnapshot)" data-testid="pi-previous-open-source" aria-label="@($"Open {row.DisplayName} in Source Analysis")">Open Source Analysis</a> }
                            </div>
                            <details class="pi-details" data-testid="pi-previous-details">
                                <summary>Details<span class="visually-hidden"> of @row.DisplayName</span></summary>
                                <dl class="pi-facts">
                                    <div><dt>Origin</dt><dd>@(row.Origin == PreviousImportOrigin.ProjectImport ? "Project Import" : "Source Analysis upload (not a project: no documents)")</dd></div>
                                    <div><dt>Archive</dt><dd><span data-testid="pi-previous-archive">@row.ArchiveFileName</span> · imported @row.ImportedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd></div>
                                    <div><dt>Source Analysis</dt><dd data-testid="pi-previous-source">@(row.SnapshotId is { } rowSnapshot ? $"Snapshot {ProjectImportHistory.ShortId(rowSnapshot)} · {row.SourceStatus}" : row.SourceStatus)</dd></div>
                                    @if (rowAnalysis.Explanation is { } rowExplanation) { <div><dt>Analysis</dt><dd>@rowExplanation</dd></div> }
                                    @if (rowAnalysis.Areas is { } rowAreas) { <div><dt>Analysis areas</dt><dd data-testid="pi-previous-areas">@rowAreas</dd></div> }
                                    <div><dt>Documents</dt><dd data-testid="pi-previous-documents">@row.Documents</dd></div>
                                    <div><dt>Source role</dt><dd data-testid="pi-previous-logical">@(row.LogicalSources.Count > 0 ? string.Join(", ", row.LogicalSources) : row.HasSource ? "Not identified" : "None")</dd></div>
                                    @if (rowRole is { Detail: { } roleWhy }) { <div><dt>Why</dt><dd data-testid="pi-previous-role-detail">@roleWhy</dd></div> }
                                    @foreach (var match in row.LogicalSources) { <div><dt>Testing setup</dt><dd data-testid="pi-previous-match">Matches the @match source requirement</dd></div> }
                                    @if (row.HasSource && _setup is { BindingsRead: true }) { <div><dt>IQR bindings</dt><dd data-testid="pi-previous-bindings">@ProjectImportHistory.BindingsText(row.BoundIntegrations, true)</dd></div> }
                                    <div><dt>Fingerprint</dt><dd><code title="@row.Fingerprint">@ProjectImportPresentation.ShortFingerprint(row.Fingerprint)</code></dd></div>
                                    @if (row.InfrastructureFormats.Count > 0) { <div><dt>Infrastructure as Code</dt><dd>@string.Join(", ", row.InfrastructureFormats)</dd></div> }
                                    @if (row.ConfigurationEnvironments.Count > 0) { <div><dt>Environment labels in source</dt><dd data-testid="pi-previous-environments">@string.Join(", ", row.ConfigurationEnvironments) <span class="pi-muted">(source labels, not deployed environments)</span></dd></div> }
                                </dl>
                                @if (row.BoundIntegrations.Count > 0 && _setup is { BindingsRead: true }) { <div class="pi-actions"><a href="integration-quality-review?view=evidence" data-testid="pi-previous-bindings-link">View @row.DisplayName bindings in IQR</a></div> }
                            </details>
                        </li>
                    }
                </ul>
            </section>
        }

        @* ── G · Technical details (the one provenance view; collapsed) ── *@
        @if (Activation.Current is { } technical)
        {
            var techSource = ProjectImportPresentation.CurrentSource(technical, DateTimeOffset.UtcNow);
            var techSnapshot = CurrentSnapshot(technical);
            <section class="pi-card pi-technical" aria-labelledby="pi-technical-heading">
                <h2 id="pi-technical-heading" class="pi-technical-heading">Technical details</h2>
                <details class="pi-details" data-testid="pi-current-technical">
                    <summary>Show import provenance, source analysis and environment labels<span class="visually-hidden"> of @technical.ProjectName</span></summary>
                    <dl class="pi-facts">
                        <div><dt>Archive</dt><dd data-testid="pi-current-archive">@technical.ArchiveFileName</dd></div>
                        <div><dt>Imported</dt><dd>@technical.ImportedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd></div>
                        <div><dt>Import</dt><dd><code>@technical.ImportId</code></dd></div>
                        <div><dt>Fingerprint</dt><dd><code title="@technical.ArchiveSha256" data-testid="pi-current-fingerprint">@ProjectImportPresentation.ShortFingerprint(technical.ArchiveSha256)</code></dd></div>
                        <div><dt>Source role</dt><dd data-testid="pi-current-logical">@(ProjectImportHistory.LogicalSources(_setup, techSnapshot?.SnapshotId ?? technical.SourceSnapshotId) is { Count: > 0 } logical ? string.Join(", ", logical) : techSource.SnapshotId is null ? "None" : "Not identified")</dd></div>
                        @* The snapshot's own status: Failed there is the application-code analyzer's outcome only (no production project). *@
                        <div><dt>Source Analysis</dt><dd data-testid="pi-current-snapshot">@techSource.Status@(techSnapshot is null ? "" : $" · {techSnapshot.Status}")@(techSnapshot?.Status switch { "Partial" => " (some areas could not be fully analyzed)", "Failed" => " (code analysis found no supported production project; other areas are analyzed separately)", _ => "" })</dd></div>
                        @if (techSnapshot is { Areas.Count: > 0 } withAreas) { <div><dt>Analysis areas</dt><dd data-testid="pi-current-areas">@string.Join(" · ", withAreas.Areas.Select(a => $"{a.Area}: {ImportProjectOverview.AreaStatus(a.Status)}"))</dd></div> }
                        <div><dt>Source detail</dt><dd data-testid="pi-current-source-detail">@techSource.Detail</dd></div>
                        @if (techSource.SnapshotId is not null && _setup is { BindingsRead: true })
                        {
                            <div><dt>IQR bindings</dt><dd data-testid="pi-current-bindings">@ProjectImportHistory.BindingsText(techSnapshot?.BoundIntegrations ?? [], true)</dd></div>
                        }
                        @if (techSnapshot is { ConfigurationEnvironments.Count: > 0 } withEnvironments)
                        {
                            <div><dt>Environment labels in source</dt><dd data-testid="pi-current-environments">@string.Join(", ", withEnvironments.ConfigurationEnvironments) <span class="pi-muted">(source labels, not deployed environments)</span></dd></div>
                        }
                        @if (techSnapshot is { InfrastructureFormats.Count: > 0 } withIac) { <div><dt>Infrastructure as Code</dt><dd>@string.Join(", ", withIac.InfrastructureFormats)</dd></div> }
                        @if (techSnapshot?.InfrastructureAutomation is { } automation) { <div><dt>Infrastructure automation</dt><dd data-testid="pi-current-automation">@automation</dd></div> }
                        <div><dt>Target Environment</dt><dd>@(_environmentName ?? "None selected") <span class="pi-muted">(the test environment runtime reviews use)</span></dd></div>
                    </dl>
                </details>
            </section>
        }

        @if (_failure is { } failure) { <ProjectImportFailure Failure="failure" /> }
    }
    else if (_phase is Phase.Validating or Phase.Classifying or Phase.Importing)
    {
        <section class="pi-card" aria-labelledby="pi-progress-heading" data-testid="pi-progress" aria-busy="true">
            <h2 id="pi-progress-heading">@(_phase == Phase.Importing ? "Importing the project" : "Checking the archive")</h2>
            <p class="pi-status" role="status" aria-live="polite" aria-atomic="true" data-testid="pi-status">
                @(_phase switch
                {
                    Phase.Validating => $"Uploading and validating {_fileName}, then detecting document roles and source…",
                    Phase.Classifying => $"Archive accepted. Detecting document roles: {_classified} of {_classifyTotal} Markdown documents…",
                    _ => _progress?.Stage ?? "Starting the project import…",
                })
            </p>
            @if (_phase == Phase.Importing && _progress is { StageNumber: { } stageNumber, StageCount: { } stageCount })
            {
                <p class="pi-muted" data-testid="pi-stage-count">Source Analysis stage @stageNumber of @stageCount</p>
            }
            @if (_phase == Phase.Validating && Session.UploadTotalBytes > 0)
            {
                @* Measured: bytes read from the chosen file and sent, of its size. *@
                <progress class="pi-progress" max="@Session.UploadTotalBytes" value="@Session.UploadedBytes" aria-label="Archive uploaded" data-testid="pi-upload-progress">@ProjectImportPresentation.Size(Session.UploadedBytes) of @ProjectImportPresentation.Size(Session.UploadTotalBytes)</progress>
                <p class="pi-muted" data-testid="pi-upload-bytes">Uploaded @ProjectImportPresentation.Size(Session.UploadedBytes) of @ProjectImportPresentation.Size(Session.UploadTotalBytes)</p>
            }
            else if (_phase is Phase.Validating or Phase.Importing)
            {
                @* Stage n of N is not a share of the work: no percentage is shown for the analysis. *@
                <progress class="pi-progress pi-progress-indeterminate" aria-label="Project import in progress"></progress>
            }
            @if (_phase is Phase.Validating or Phase.Classifying or Phase.Importing)
            {
                @if (_phase == Phase.Importing && _progress is { Detail.Length: > 0 } currentProgress)
                {
                    <p class="pi-muted" data-testid="pi-stage-detail">@currentProgress.Detail</p>
                }
                @if (_preview is { } activePreview)
                {
                    <p class="pi-muted" data-testid="pi-progress-detail">Documents: @activePreview.Documents.Count · Source files: @activePreview.Source.SourceFiles</p>
                }
                <p class="pi-muted" data-testid="pi-elapsed">Elapsed: @ElapsedText(_elapsed)</p>
            }
            @if (_phase == Phase.Classifying && _classifyTotal > 0)
            {
                <progress class="pi-progress" max="@_classifyTotal" value="@_classified" aria-label="Documents classified">@_classified of @_classifyTotal</progress>
            }
            <p class="pi-muted" data-testid="pi-background-note">You can leave this page: the import continues and is shown under Activity. Come back here to see it.</p>
            @if (Session.CanCancel)
            {
                <div class="pi-actions"><button type="button" class="btn-secondary" data-testid="pi-cancel-running" @onclick="CancelRunning">@(_phase == Phase.Importing ? "Cancel import" : "Cancel upload")</button></div>
            }
        </section>
    }
    else if (_phase == Phase.Preview && _preview is { } preview && _discovery is { } discovery)
    {
        <section class="pi-card pi-archive" aria-labelledby="pi-archive-heading" data-testid="pi-preview">
            <h2 id="pi-archive-heading" tabindex="-1">@preview.Archive.FileName</h2>
            @if (Session.GitRevision is { } git)
            {
                <p class="pi-muted" data-testid="pi-git-revision">From Git: @git.Repository · branch @git.Branch · commit <code>@git.ShortSha</code>@(git.CommittedAt is { } at ? $" ({at.UtcDateTime:yyyy-MM-dd HH:mm} UTC)" : "") · retrieved @git.RetrievedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC. The commit, not the branch, is what is imported.</p>
            }
            <dl class="pi-facts">
                @if (StartsNewProject)
                {
                    <div class="pi-name-row"><dt><label for="pi-new-project-name">Project name</label></dt>
                        <dd>
                            <input id="pi-new-project-name" class="pi-name-input" maxlength="@ApplicationContexts.MaxNameLength" value="@NewProjectNameShown(preview)"
                                   @oninput="e => Session.NewProjectName = e.Value?.ToString()" disabled="@Session.IsBusy" aria-describedby="pi-new-project-name-note"
                                   aria-invalid="@(NewProjectNameProblem(preview) is null ? "false" : "true")" data-testid="pi-new-project-name" />
                            <span class="pi-muted pi-small" id="pi-new-project-name-note" data-testid="pi-project-name">Suggested @ProjectImportPresentation.NameBasis(preview.ProjectNameBasis): @preview.ProjectName. Change it if you like — you can also rename the project later.</span>
                            @if (NewProjectNameProblem(preview) is { } nameProblem) { <span class="pi-warning" role="alert" data-testid="pi-new-project-name-problem">@nameProblem</span> }
                        </dd></div>
                }
                else
                {
                    <div><dt>Project</dt><dd data-testid="pi-project-name">@(TargetProject()?.Name ?? preview.ProjectName) <span class="pi-muted">· package @preview.ProjectName (@ProjectImportPresentation.NameBasis(preview.ProjectNameBasis))</span></dd></div>
                }
                <div><dt>Size</dt><dd>@ProjectImportPresentation.Size(preview.Archive.SizeBytes) · @preview.Archive.EntryCount.ToString("N0") entries</dd></div>
                <div><dt>Fingerprint</dt><dd><code title="@preview.Archive.Sha256" data-testid="pi-fingerprint">@ProjectImportPresentation.ShortFingerprint(preview.Archive.Sha256)</code></dd></div>
            </dl>
            <p class="pi-muted">Archive accepted. Nothing is imported until you choose Import project.</p>
        </section>

        @if (_duplicate is { } duplicate && !_importAgain)
        {
            <section class="pi-card pi-tone-neutral" aria-labelledby="pi-duplicate-heading" data-testid="pi-duplicate" data-current="@(duplicate.IsCurrent ? "true" : "false")">
                <h2 id="pi-duplicate-heading">Matching imported source already exists</h2>
                <dl class="pi-facts">
                    <div><dt>Archive</dt><dd>@duplicate.ArchiveFileName</dd></div>
                    <div><dt>Fingerprint</dt><dd><code title="@duplicate.Fingerprint">@ProjectImportPresentation.ShortFingerprint(duplicate.Fingerprint)</code></dd></div>
                    <div><dt>Imported</dt><dd>@duplicate.ImportedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd></div>
                </dl>
                @if (duplicate.SameContentDifferentArchive)
                {
                    <p class="pi-muted" data-testid="pi-duplicate-content">A different archive with exactly the same files (same content fingerprint; another name, compression or entry order) is already @(duplicate.IsCurrent ? "the current project" : "imported"). Choose what to do; nothing is chosen for you.</p>
                }
                else
                {
                    <p class="pi-muted">This exact archive (the same bytes, whatever its file name) is already @(duplicate.IsCurrent ? "the current project" : "imported"). Choose what to do; nothing is chosen for you.</p>
                }
                <p class="pi-muted" data-testid="pi-duplicate-again-help">@(duplicate.SameContentDifferentArchive
                    ? "Import again records this archive as its own import with its own snapshot; the existing import and its snapshot stay unchanged. Nothing is deleted."
                    : "Import again records another import of the same archive. Its source analysis is reused when it is still the current snapshot; otherwise a new snapshot is created, and the earlier snapshot and its import facts are kept in that import's history. Nothing is deleted or rewritten.")</p>
                <div class="pi-actions">
                    @if (duplicate.ImportId is { } existingImport && !duplicate.IsCurrent && Activation.Imports.Any(i => i.ImportId == existingImport))
                    {
                        <button type="button" class="btn-primary" data-testid="pi-duplicate-use" @onclick="() => UseExisting(existingImport)">Use existing import</button>
                    }
                    else if (duplicate.SnapshotId is { } existingSnapshot)
                    {
                        <a class="btn-primary" href="@ProjectImportPresentation.SourceAnalysisHref(existingSnapshot)" data-testid="pi-duplicate-open-source">Open existing snapshot in Source Analysis</a>
                    }
                    <button type="button" class="btn-secondary" data-testid="pi-duplicate-import-again" @onclick="() => _importAgain = true">Import again</button>
                </div>
            </section>
        }

        <div class="pi-columns">
            <ProjectImportArtifacts Discovery="discovery" />
            <ProjectImportSource Detection="preview.Source" Row="ProjectImportPresentation.SourcePreview(preview.Source, SourceAnalysisAvailable)" />
        </div>
        @TargetEnvironmentFact

        @if (Warnings(preview, discovery) is { Count: > 0 } warnings)
        {
            <section class="pi-card" aria-labelledby="pi-warnings-heading" data-testid="pi-warnings">
                <h2 id="pi-warnings-heading">Also in the archive</h2>
                <ul class="pi-list">@foreach (var w in warnings) { <li>@w</li> }</ul>
            </section>
        }

        @if (!ProjectImportPresentation.HasImportableContent(preview, discovery))
        {
            <section class="pi-card pi-tone-neutral" role="status" data-testid="pi-nothing">
                <h2>@ProjectImportPresentation.OutcomeTitle(ProjectImportOutcome.NothingToImport)</h2>
                <p>The archive is valid, but it has no supported project documents and no source. Nothing was activated.</p>
            </section>
        }
        <div class="pi-actions">
            <button type="button" class="btn-primary" data-testid="pi-import" disabled="@(!ProjectImportPresentation.HasImportableContent(preview, discovery) || (_duplicate is not null && !_importAgain) || NewProjectNameProblem(preview) is not null)" @onclick="ImportAsync">@(_failure is null ? "Import project" : "Retry import")</button>
            <button type="button" class="btn-secondary" data-testid="pi-cancel" @onclick="CancelAsync">Choose another file</button>
        </div>
        @if (_failure is { } commitFailure)
        {
            <section class="pi-card pi-tone-rejected" role="alert" data-testid="pi-commit-failure" data-code="@commitFailure.Code">
                @if (commitFailure.Code == "IMPORT_CANCELLED")
                {
                    <h2>The import was cancelled</h2>
                    <p>@commitFailure.Message</p>
                }
                else
                {
                    <h2>The import did not return a result</h2>
                    <p>@commitFailure.Message</p>
                    <p>The workspace did not finish updating. Source Analysis may already have saved its snapshot. Retrying this staged archive reuses a completed snapshot.</p>
                }
                @if (!string.IsNullOrWhiteSpace(commitFailure.CorrelationId)) { <p>Reference: <code>@commitFailure.CorrelationId</code></p> }
            </section>
        }
    }
    else if (_phase == Phase.Result && _preview is { } done && _discovery is { } doneDiscovery)
    {
        var outcome = ProjectImportPresentation.Outcome(done, doneDiscovery, _commit?.Source);
        var tone = ProjectImportPresentation.ToneClass(ProjectImportPresentation.OutcomeTone(outcome));
        <section class="pi-card pi-outcome pi-tone-@tone" aria-labelledby="pi-outcome-heading" data-testid="pi-result" data-outcome="@outcome">
            <h2 id="pi-outcome-heading" tabindex="-1"><span class="pi-badge pi-badge-@tone">@(outcome == ProjectImportOutcome.Imported ? "Imported" : "Imported with notes")</span> @ProjectImportPresentation.OutcomeTitle(outcome)</h2>
            @if (Session.KeptSelectionNote is { } kept) { <p class="pi-muted" role="status" data-testid="pi-kept-selection">@kept</p> }
            @if (Session.ResultSummary is { } summary)
            {
                <dl class="pi-facts" data-testid="pi-result-association">
                    <div><dt>Role</dt><dd data-testid="pi-result-role">@summary.RoleLabel</dd></div>
                    <div><dt>Associated application</dt><dd data-testid="pi-result-application">@summary.ApplicationName</dd></div>
                </dl>
            }
            @if (Session.RoleOutcome is { Length: > 0 } roleOutcome) { <p class="pi-muted" role="status" data-testid="pi-result-roles">@roleOutcome</p> }
            @* A source of a multi-system test pack whose partner source is not imported: said right after the import, with the one action that fixes it. *@
            @foreach (var gap in ImportProjectOverview.PartnerSourceGaps(_setup, Activation.Current is { } justImported ? ProjectImportPresentation.CurrentSource(justImported, DateTimeOffset.UtcNow).SnapshotId : null))
            {
                <div class="pi-warning pi-partner-source" role="status" data-testid="pi-partner-source" data-pack="@gap.PackId" data-role="@gap.RoleKey">
                    <strong>Also import the @gap.MissingLabel source.</strong> @ImportProjectOverview.PartnerSourceText(gap)
                    <button type="button" class="btn-secondary btn-sm" data-testid="pi-partner-source-import" @onclick="ImportZipFromHeader">Import ZIP</button>
                </div>
            }
            <p><strong>@done.ProjectName</strong> imported successfully. Import means BirkNext found and recorded the contents — nothing has been reviewed or tested yet. Imported is not reviewed or approved: review the documents next.</p>
            @if (Session.GitQueue.Count > 0)
            {
                <p class="pi-next-repo" data-testid="pi-git-next">Next repository (@(Session.GitQueueTotal - Session.GitQueue.Count + 1) of @Session.GitQueueTotal): <strong>@Session.GitQueue[0].Label</strong>
                    <button type="button" class="btn-primary btn-sm" @onclick="NextInGitQueue" data-testid="pi-git-next-button">Import next</button></p>
            }
            @if (Session.AutoDrafts.Count > 0)
            {
                <div class="pi-auto-drafts" data-testid="pi-auto-drafts">
                    <h3 class="pi-subheading">Test Data XML fixtures</h3>
                    <p class="pi-auto-draft-summary" role="status" data-testid="pi-auto-draft-summary">@string.Join(" · ", Session.AutoDrafts.GroupBy(d => d.Kind).OrderBy(g => g.Key).Select(g => $"{g.Count()} {XmlFixtureAutoDraftOutcome.Label(g.Key).ToLowerInvariant()}"))@(Session.AutoDrafts.Any(d => !d.Created && d.Kind != XmlFixtureAutoDraftKind.AlreadyCurrent) ? " — the import itself succeeded; the fixture below is incomplete until it is created in Test Data." : "")</p>
                    <ul>
                        @foreach (var d in Session.AutoDrafts)
                        {
                            <li data-testid="pi-auto-draft" data-created="@(d.Created ? "true" : "false")" data-kind="@d.Kind"><strong>@XmlFixtureAutoDraftOutcome.Label(d.Kind)</strong> · @d.Context@(d.Alias is null ? "" : $" ({d.Alias})"): @d.Message
                                @if (d.Created || d.Kind == XmlFixtureAutoDraftKind.AlreadyCurrent) { <a href="test-data" data-testid="pi-auto-draft-link">Review and approve in Test Data</a> }
                                else if (d.Kind == XmlFixtureAutoDraftKind.NeedsDecision) { <a href="test-data" data-testid="pi-auto-draft-decide">Decide in Test Data → XML fixtures</a> }</li>
                        }
                    </ul>
                    @if (Session.AutoDrafts.Any(d => d.Retryable))
                    {
                        <button type="button" class="btn-secondary btn-sm" data-testid="pi-auto-draft-retry" disabled="@_autoDraftBusy" @onclick="RetryAutoDraftAsync">@(_autoDraftBusy ? "Retrying…" : "Retry XML fixture draft")</button>
                        <span class="pi-muted"> Uses this import's snapshot again — nothing is reimported; a draft that already exists is not created twice.</span>
                    }
                </div>
            }
            @if (ProjectImportPresentation.Notes(done, doneDiscovery, _commit?.Source) is { Count: > 0 } notes)
            {
                <ul class="pi-list" data-testid="pi-notes">@foreach (var note in notes) { <li>@note</li> }</ul>
            }
            @if (_saveWarning) { <p class="pi-warning" role="alert" data-testid="pi-save-warning">The import is active in this browser session, but the workspace could not be saved. It may not survive a reload.</p> }
            <details class="pi-details">
                <summary>Technical details</summary>
                <dl class="pi-facts" data-testid="pi-provenance">
                    <div><dt>Import</dt><dd><code data-testid="pi-import-id">@done.ImportId</code></dd></div>
                    <div><dt>Archive</dt><dd>@done.Archive.FileName</dd></div>
                    <div><dt>Fingerprint</dt><dd><code title="@done.Archive.Sha256">@ProjectImportPresentation.ShortFingerprint(done.Archive.Sha256)</code></dd></div>
                </dl>
            </details>
        </section>

        <div class="pi-columns">
            <ProjectImportArtifacts Discovery="doneDiscovery" Imported="true" />
            @if (_commit?.Source is { } source)
            {
                <ProjectImportSource Detection="done.Source" Row="ProjectImportPresentation.SourceResult(source)" Result="source">
                    @if (source.CanRetry)
                    {
                        <div class="pi-actions">
                            <button type="button" class="btn-secondary" data-testid="pi-retry-source" disabled="@_retrying" @onclick="RetrySourceAsync">@(_retrying ? "Retrying…" : "Retry creating source snapshot")</button>
                        </div>
                        <p class="pi-muted">The archive stays staged until @(_commit.StagedUntil?.ToLocalTime().ToString("HH:mm") ?? "it expires"), so no new upload is needed.</p>
                    }
                </ProjectImportSource>
            }
        </div>

        @if (doneDiscovery.HasArtifacts)
        {
            <section class="pi-card" data-testid="pi-candidate-review"><ProjectArtifactCandidateReview /></section>
        }

        @TargetEnvironmentFact
        @ProjectNext(done.ImportId)

        <div class="pi-result-actions">
            <section class="pi-action-group" aria-labelledby="pi-next-heading">
                <h2 id="pi-next-heading" class="pi-action-heading">Next steps</h2>
                <div class="pi-actions" data-testid="pi-next">
                    @if (doneDiscovery.HasArtifacts && ImportProjectOverview.ReviewNext(doneDiscovery.DetectedRoles.Select(r => r.Role), _modules) is { } explorer) { <a class="btn-primary" href="@explorer.Route" data-testid="pi-open-documents">@explorer.Label</a> }
                    @if (_commit?.Source.SnapshotId is { } resultSnapshot)
                    {
                        <a class="@(doneDiscovery.HasArtifacts ? "btn-secondary" : "btn-primary")" href="@ProjectImportPresentation.SourceAnalysisHref(resultSnapshot)" data-testid="pi-open-source">Open Source Analysis</a>
                    }
                    <a class="btn-secondary" href="manual-testing" data-testid="pi-open-manual-testing">Plan manual tests</a>
                    <a class="btn-secondary" href="dashboard" data-testid="pi-open-workflow">Project Dashboard</a>
                </div>
            </section>
            @* Two different things: Back only leaves this result view (the import stays saved and current); Import another opens the file
               chooser for the next archive at once. *@
            <section class="pi-action-group" aria-labelledby="pi-import-actions-heading">
                <h2 id="pi-import-actions-heading" class="pi-action-heading">Import</h2>
                <div class="pi-actions" data-testid="pi-import-actions">
                    <button type="button" class="btn-secondary" data-testid="pi-back-bottom" @onclick="BackToImportProject">Back to Import Project</button>
                    <button type="button" class="btn-secondary" data-testid="pi-import-another" aria-controls="pi-choose" @onclick="ImportZipFromHeader">Import ZIP</button>
                </div>
            </section>
        </div>
    }
</div>

@code {
    // The import session (stage, archive, preview, progress, result, failure) lives in ProjectImportSession, not in this page: leaving the page
    // never stops or forgets an import, and returning shows it again. These are views onto it so the markup reads as before.
    private int _classified { get => Session.Classified; set => Session.Classified = value; }
    private int _classifyTotal { get => Session.ClassifyTotal; set => Session.ClassifyTotal = value; }
    private Phase _phase { get => Session.Phase; set => Session.Phase = value; }
    private string? _fileName { get => Session.FileName; set => Session.FileName = value; }
    private ProjectImportPreview? _preview { get => Session.Preview; set => Session.Preview = value; }
    private ProjectImportArtifactDiscovery? _discovery { get => Session.Discovery; set => Session.Discovery = value; }
    private ProjectImportCommitResult? _commit { get => Session.Commit; set => Session.Commit = value; }
    private SourceUploadFailure? _failure { get => Session.Failure; set => Session.Failure = value; }
    /// <summary>Shown beside the import only; never sent with it and never a condition for the source snapshot.</summary>
    private bool _hasTarget;
    private bool _saveWarning { get => Session.SaveWarning; set => Session.SaveWarning = value; }
    private bool _retrying;
    private ProjectImportCommitEvent? _progress { get => Session.Progress; set => Session.Progress = value; }
    /// <summary>Changes on every reset or failure: the file input is re-created, so choosing the very same ZIP again always fires a change.</summary>
    private int _inputGeneration { get => Session.InputGeneration; set => Session.InputGeneration = value; }
    private string? _currentRetryMessage;
    private DateTimeOffset? _importStartedAt => Session.StartedAt;
    private TimeSpan _elapsed;
    private System.Threading.Timer? _elapsedTimer;
    private string? _focusId;

    /// <summary>The packs' source setup and the stored snapshots, read from the backend; null when unavailable (the page works without it).</summary>
    private SourceSetupView? _setup;
    private string? _environmentId;
    /// <summary>The active Target Environment's name (the test environment), or null when none is selected.</summary>
    private string? _environmentName;
    /// <summary>The current workspace with its project-wide pack overview; null in hosts without the projection (the summary then omits counts).</summary>
    private CurrentWorkspaceSnapshot? _workspace;
    private ProjectImportDuplicate? _duplicate { get => Session.Duplicate; set => Session.Duplicate = value; }
    private bool _importAgain { get => Session.ImportAgain; set => Session.ImportAgain = value; }
    private string? _useMessage;
    /// <summary>The upload block is shown while a project is current only after "Import another project" (or when a choice failed).</summary>
    private bool _showUpload { get => Session.ShowUpload; set => Session.ShowUpload = value; }
    private bool _disposed;
    private Phase _renderedPhase;

    protected override async Task OnInitializedAsync()
    {
        // Returning to the page while an import runs (or after it finished elsewhere) shows that import: the page observes the session.
        if (_phase == Phase.Result && Session.ResultSeen) Session.Reset();
        Session.Changed += OnSessionChanged;
        _renderedPhase = _phase;
        if (Session.IsBusy) StartElapsedTimer();
        if (ServiceProvider.GetService<ICurrentWorkspaceProjection>() is { } projection) projection.Changed += OnWorkspaceChanged;
        if (ServiceProvider.GetService<IArtifactExplorerContext>() is { } explorer) explorer.Changed += OnExplorerChanged;
        if (ServiceProvider.GetService<IFrontendAnalysisSettingsService>() is { } settings) settings.Changed += OnEnvironmentChanged;
        if (ServiceProvider.GetService<NavigationManager>() is { } navigation)
        {
            navigation.LocationChanged += OnLocationChanged;
            if (ImportRequested(navigation.Uri) && !Session.IsBusy) ShowUpload();
        }
        await LoadEnvironmentAsync();
        await LoadSetupAsync();
        await LoadWorkspaceAsync();
        await LoadModulesAsync();
    }

    /// <summary>The module the tester focused under Artifact candidates, so the next step names it; null without an explorer context.</summary>
    private ArtifactModuleOverview? _modules;

    private async Task LoadModulesAsync()
    {
        if (ServiceProvider.GetService<IArtifactExplorerContext>() is not { } explorer) return;
        try { _modules = await explorer.GetModuleOverviewAsync(); }
        catch (Exception ex) when (ex is not OutOfMemoryException) { _modules = null; }
    }

    private void OnExplorerChanged(object? sender, EventArgs e) => _ = InvokeAsync(async () => { await LoadModulesAsync(); StateHasChanged(); });

    private void OnEnvironmentChanged() => _ = InvokeAsync(async () => { await LoadEnvironmentAsync(); await LoadProjectEvidenceAsync(); StateHasChanged(); });

    private async Task LoadWorkspaceAsync()
    {
        if (ServiceProvider.GetService<ICurrentWorkspaceProjection>() is not { } projection) return;
        try
        {
            // The current-project card describes the current import only. When a Target Environment Project makes the explorers read another
            // project, its document overview is not this import's.
            var snapshot = await projection.GetAsync();
            _workspace = Activation.Current is { } current && snapshot.ProjectSlug != ProjectImportScope.For(current.ImportId) ? null : snapshot;
        }
        catch (Exception ex) when (ex is not OutOfMemoryException) { _workspace = null; }
    }

    private void OnWorkspaceChanged() => _ = InvokeAsync(async () => { await LoadWorkspaceAsync(); StateHasChanged(); });

    /// <summary>
    /// The package as project evidence: its classification (from content, never the archive name) and the capabilities it actually provides,
    /// each judged on its own. What it does not contain is stated neutrally — a documentation-only or source-only package is not deficient.
    /// </summary>
    private RenderFragment PackageCapabilities(SddProjectImportRecord record) => __builder =>
    {
        if (ServiceProvider.GetService<IWorkspaceSessionService>() is not { } session) return;
        var package = ProjectEvidencePackages.Of(record, session.SddLifecycle, _setup);
        <div class="pi-capabilities" data-testid="pi-capabilities" data-classification="@package.Classification" data-status="@package.Status">
            <span class="pi-badge pi-badge-neutral" data-testid="pi-classification">@package.Classification</span>
            @foreach (var capability in package.Capabilities.Where(c => !(package.SourcePending && c.Capability == ProjectEvidenceCapability.ApplicationSource)))
            {
                <span class="pi-badge pi-badge-@(capability.Status == PackageCapabilityStatus.Ready ? "available" : "partial")" data-testid="pi-capability"
                      data-capability="@capability.Capability">@ProjectEvidencePackages.CapabilityLabel(capability.Capability) · @capability.Fact</span>
            }
            @if (package.SourcePending)
            {
                <span class="pi-badge pi-badge-neutral" data-testid="pi-capability-pending">Source · role pending Source Analysis</span>
            }
            @foreach (var lacking in package.NotProvided)
            {
                <span class="pi-muted pi-not-provided" data-testid="pi-not-provided">@lacking</span>
            }
        </div>
    };

    /// <summary>An active Target Environment id is stored but it cannot be resolved (deleted, invalid) — not the same as none selected.</summary>
    private bool _targetUnavailable;

    /// <summary>
    /// The active Target Environment, read from the canonical environment settings. The review context is only a convenience: it also checks
    /// the authenticated session and the profile's configuration, and its failure must never make a selected environment read "not selected".
    /// </summary>
    private async Task LoadEnvironmentAsync()
    {
        _hasTarget = false; _targetUnavailable = false; _environmentId = null; _environmentName = null;
        try
        {
            var context = await ContextFactory.GetActiveContextAsync();
            _environmentId = context.ActiveProfileOrNull?.Id;
            _environmentName = context.ActiveProfileOrNull?.Name is { Length: > 0 } name ? name : null;
        }
        catch (Exception ex) when (ex is not OutOfMemoryException) { }
        if (string.IsNullOrWhiteSpace(_environmentId) && ServiceProvider.GetService<IFrontendAnalysisSettingsService>() is { } settings)
        {
            try
            {
                await settings.LoadAsync(JS);
                if (settings.ActiveProfile is { Id: { Length: > 0 } id } active)
                {
                    _environmentId = id;
                    _environmentName = active.Name is { Length: > 0 } activeName ? activeName : null;
                }
                else _targetUnavailable = !string.IsNullOrWhiteSpace(settings.Settings?.ActiveProfileId);
            }
            catch (Exception ex) when (ex is not OutOfMemoryException) { }
        }
        _hasTarget = !string.IsNullOrWhiteSpace(_environmentId);
    }

    private async Task LoadSetupAsync()
    {
        if (ServiceProvider.GetService<IIntegrationJourneysApiService>() is not { } journeys) return;
        try { _setup = (await journeys.SourceSetupAsync(_environmentId)).Value; }
        catch (Exception ex) when (ex is not OutOfMemoryException) { _setup = null; }
    }

    private SourceSetupSnapshot? CurrentSnapshot(SddProjectImportRecord record) =>
        _setup is null ? null : ProjectImportHistory.SnapshotsOf(record, _setup.Snapshots).OrderByDescending(s => s.SnapshotId == record.SourceSnapshotId).FirstOrDefault();

    /// <summary>Makes an earlier import current again from what the workspace holds: no upload, no new snapshot, no binding change.</summary>
    private async Task UseAsCurrent(string importId)
    {
        _useMessage = Activation.UseAsCurrent(importId) ? null : "That import is no longer recorded in this workspace.";
        if (_useMessage is not null) return;
        _focusId = "pi-current-heading";
        // Wait for the save so the choice survives closing the tab right after it; say so when it could not be stored.
        if (!await AutoSave.SaveNowAsync()) _useMessage = "The package is shown in this tab, but the choice could not be saved yet. It is saved automatically when the connection is back; until then a new tab may show the previous package.";
        // Source setup reads stored snapshots and bindings only (never re-imports or binds); refresh it so the cards follow the change.
        await LoadSetupAsync();
    }

    /// <summary>"Import more evidence" / "Import another application": reveals the upload block for that target and moves focus to its file
    /// chooser. Nothing changes until a file is chosen.</summary>
    private void ShowUpload()
    {
        // Opened from the address (?import=…): Cancel returns focus to the page's own Import ZIP, never to a button of an earlier import.
        _uploadOrigin = Activation.Current is null ? "pi-header-import" : "pi-current-import-another";
        ShowUpload(ImportTarget.CurrentApplication);
    }

    private void ShowUpload(ImportTarget target)
    {
        if (!Session.IsBusy) Session.Target = target;
        _showUpload = true;
        _showGit = false;
        _focusId = CanChooseFile ? "pi-choose-file" : "pi-roles";
    }

    /// <summary>Header "Import ZIP": the same upload flow from anywhere on the page, including the result of an import. Keeps the chosen intent
    /// (Add evidence is the default for an existing application; nothing is replaced). Never starts an import by itself.</summary>
    private void ImportZipFromHeader()
    {
        if (Session.IsBusy) return;
        if (_phase == Phase.Result) BackToImportProject();
        _uploadOrigin = "pi-header-import";
        ShowUpload(Session.Target);
    }

    /// <summary>The ZIP form is open (its header button is hidden then: one Import ZIP on screen at a time).</summary>
    private bool ZipFormOpen => _phase == Phase.Choose && _showUpload;
    private bool GitFormOpen => _phase == Phase.Choose && _showGit;
    private bool _showGit;

    /// <summary>The file button unlocks only after the content question is answered: one or more roles, or "Not sure".</summary>
    private bool CanChooseFile => ImportRoleChoice.Answered(Session.ChosenRoles, Session.DetectRoles);

    /// <summary>A role and "Not sure" exclude each other: ticking one clears the other.</summary>
    private void ToggleRole(PackageEvidenceRole role, bool on)
    {
        if (on) { Session.ChosenRoles.Add(role); Session.DetectRoles = false; } else Session.ChosenRoles.Remove(role);
    }

    /// <summary>"Choose ZIP file" before the content question is answered: say why, and move to the question.</summary>
    private bool _choiceHint;

    private void ChooseLockedClicked() { _choiceHint = true; _focusId = "pi-roles"; }

    private void SetDetect(bool on)
    {
        Session.DetectRoles = on;
        if (on) Session.ChosenRoles.Clear();
    }

    private void OpenGit()
    {
        if (Session.IsBusy) return;
        if (_phase == Phase.Result) BackToImportProject();
        _showGit = true;
        _showUpload = false;
        _focusId = "pi-git";
    }

    private void CloseGit() { _showGit = false; _focusId = GitSources is null ? "pi-header-import" : "pi-header-git"; }

    private void ImportMoreEvidence() { _uploadOrigin = "pi-current-import-another"; if (!Session.IsBusy) Session.TargetApplicationId = null; ShowUpload(ImportTarget.CurrentApplication); }

    private const string NewProjectValue = "new";

    /// <summary>The projects a ZIP can belong to: every project with imports (the entries of the Project list), by name.</summary>
    private IReadOnlyList<SddApplicationContext> ProjectChoices() =>
        [.. (Activation.Lifecycle.Applications ?? []).Where(a => ApplicationContexts.Imports(Activation.Lifecycle, a.Id).Count > 0).OrderBy(a => a.Name, StringComparer.OrdinalIgnoreCase)];

    /// <summary>The project the next import goes to; null = a new project.</summary>
    private SddApplicationContext? TargetProject() => Session.Target == ImportTarget.NewApplication ? null
        : ApplicationContexts.Find(Activation.Lifecycle, Session.TargetApplicationId) ?? Activation.CurrentApplication;

    private IReadOnlyList<ApplicationPackage> PackagesOf(string applicationId) =>
        ApplicationContexts.Packages(Activation.Lifecycle, applicationId, _setup);

    /// <summary>"Belongs to project" changed (only before a file is chosen; an import in progress keeps its project).</summary>
    private void SetProject(string? value)
    {
        if (Session.IsBusy) return;
        if (value == NewProjectValue) { Session.Target = ImportTarget.NewApplication; Session.TargetApplicationId = null; }
        else { Session.Target = ImportTarget.CurrentApplication; Session.TargetApplicationId = value; }
    }

    /// <summary>The import intent chosen in the upload form (only before a file is chosen; an import in progress keeps its target).</summary>
    private void SetTarget(ImportTarget target)
    {
        if (!Session.IsBusy) Session.Target = target;
    }

    /// <summary>Where focus returns when the upload is cancelled: the control that opened it.</summary>
    private string _uploadOrigin = "pi-current-import-another";

    private string UploadHeading => Activation.CurrentApplication is not { } application ? "Choose a project archive"
        : TargetProject() is { } project ? $"Import a ZIP into {project.Name}" : "Import a ZIP as a new project";

    private bool _moving;
    private string? _moveMessage;

    /// <summary>"Make … its own project": moves the package to a new project named after it (nothing re-imported, unbound or deleted).</summary>
    private async Task MakeOwnProjectAsync(ApplicationPackage package)
    {
        if (ServiceProvider.GetService<IWorkspaceSessionService>() is not { } session) return;
        _moving = true;
        var (moved, problem) = ApplicationContexts.MoveImport(session.SddLifecycle, package.ImportId, null, package.DisplayName, DateTimeOffset.UtcNow);
        _moveMessage = moved is null ? problem : $"{package.DisplayName} is now its own project. Choose it in the Project list; nothing was re-imported or deleted.";
        if (moved is not null)
        {
            if (!await AutoSave.SaveNowAsync()) _moveMessage += " The change could not be saved yet; it is saved automatically when the connection is back.";
            ServiceProvider.GetService<BirkNext.Web.Services.ProjectEvidence.IProjectEvidenceService>()?.Invalidate();
            // The Project list re-renders on the workspace's Changed event: both projects are listed at once.
            ServiceProvider.GetService<ICurrentWorkspaceProjection>()?.Invalidate();
        }
        _moving = false;
    }

    // ── Project name: typed in the preview for a new project, or renamed on the project card ──

    /// <summary>The ZIP starts a new project (its name is then asked in the preview).</summary>
    private bool StartsNewProject => Session.Target == ImportTarget.NewApplication || Activation.CurrentApplication is null;

    private string NewProjectNameShown(ProjectImportPreview preview) => Session.NewProjectName ?? ApplicationContexts.SuggestedName(preview.ProjectName);

    private string? NewProjectNameProblem(ProjectImportPreview preview) =>
        !StartsNewProject ? null : ApplicationContexts.NameProblem(Activation.Lifecycle, NewProjectNameShown(preview));

    private string? _renaming;
    private string _renameValue = "";
    private string? _renameProblem;
    private bool _renameBusy;

    private void StartRename(SddApplicationContext application)
    {
        _renaming = application.Id; _renameValue = application.Name; _renameProblem = null; _focusId = "pi-rename-input";
    }

    private void CancelRename() { _renaming = null; _renameProblem = null; _focusId = "pi-rename-open"; }

    /// <summary>Saves the new name at once (the Project list follows); nothing is re-imported and no package is renamed.</summary>
    private async Task SaveRenameAsync(string applicationId)
    {
        if (ApplicationContexts.Rename(Activation.Lifecycle, applicationId, _renameValue) is { } problem) { _renameProblem = problem; return; }
        _renameBusy = true;
        var saved = await AutoSave.SaveNowAsync();
        _renameBusy = false;
        _renaming = null;
        _moveMessage = saved ? null : "The new name could not be saved yet; it is saved automatically when the connection is back.";
        ServiceProvider.GetService<BirkNext.Web.Services.ProjectEvidence.IProjectEvidenceService>()?.Invalidate();
        ServiceProvider.GetService<ICurrentWorkspaceProjection>()?.Invalidate();
        _focusId = "pi-rename-open";
    }

    /// <summary>"Keep it with …": the tester's answer, stored on the package so the warning does not come back.</summary>
    private async Task KeepWithApplicationAsync(ApplicationPackage package)
    {
        package.Record.KeptWithApplication = true;
        _moveMessage = null;
        await AutoSave.SaveNowAsync();
    }

    /// <summary>The current application's packages with their roles (classified from the backend's source setup).</summary>
    private IReadOnlyList<ApplicationPackage> ApplicationPackages() =>
        ServiceProvider.GetService<IWorkspaceSessionService>() is { } session && Activation.CurrentApplication is { } application
            ? ApplicationContexts.Packages(session.SddLifecycle, application.Id, _setup) : [];

    private SddApplicationContext? ApplicationOf(string? importId) =>
        importId is null || ServiceProvider.GetService<IWorkspaceSessionService>() is not { } session ? null
        : ApplicationContexts.Find(session.SddLifecycle, session.SddLifecycle.ProjectImports.FirstOrDefault(i => i.ImportId == importId)?.ApplicationId);

    /// <summary>A package that is not the primary source, said as what it is — not as the application's source being missing (Part of an
    /// application whose primary source may be another package).</summary>
    private static string? PackageRoleNote(ApplicationPackage? package, SddApplicationContext? application) =>
        package is null || application is null ? null : package.Role switch
        {
            PackageEvidenceRole.SupportingSource => $"Supporting/shared source for {application.Name}. This package is not the primary {application.Name} application source.",
            PackageEvidenceRole.RelatedApplicationSource => $"Source of a related application/system, kept as evidence for {application.Name}.",
            PackageEvidenceRole.Infrastructure => $"Infrastructure evidence for {application.Name}.",
            _ => null,
        };

    /// <summary>?import=… (every "Import source" action) opens import mode; also when it arrives while this page is already shown.</summary>
    private static bool ImportRequested(string uri) =>
        Uri.TryCreate(uri, UriKind.Absolute, out var parsed) && parsed.Query.TrimStart('?').Split('&').Any(part => part.Split('=')[0] == "import");

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (ImportRequested(e.Location) && _phase is Phase.Choose) { _ = InvokeAsync(() => { ShowUpload(); StateHasChanged(); }); return; }
        // Cancel dropped ?import from the address: focus returns to its origin after the router's own focus-on-navigate (h1) has run.
        if (_focusAfterNavigation is { } origin) { _focusAfterNavigation = null; _ = InvokeAsync(async () => { await Task.Yield(); _focusId = origin; StateHasChanged(); }); }
    }

    private string? _focusAfterNavigation;

    /// <summary>Cancel import mode: the chosen file (if any) is dropped; the current project and history are unchanged. Not "Clear current project".</summary>
    private void CloseUpload()
    {
        Reset();
        _failure = null;
        _showUpload = false;
        _focusId = Activation.Current is null ? "pi-header-import" : _uploadOrigin;
        _uploadOrigin = "pi-current-import-another";
        // Leave import mode in the address too, so a reload does not reopen it.
        if (ServiceProvider.GetService<NavigationManager>() is { } navigation && ImportRequested(navigation.Uri))
        {
            _focusAfterNavigation = _focusId;
            navigation.NavigateTo("project-import", replace: true);
        }
    }

    private void UseExisting(string importId)
    {
        var staging = _preview?.StagingId;
        Reset();
        if (staging is { } stagingId) _ = DiscardQuietlyAsync(stagingId);
        UseAsCurrent(importId);
    }

    /// <summary>
    /// Starts the upload/check of the chosen ZIP as a session operation. The browser file is first copied into memory while this page shows
    /// its input (a local read, measured in bytes); the upload to the backend and everything after it then run from that copy, so leaving
    /// the page no longer breaks them (the file input is removed with the page).
    /// </summary>
    private void ChooseAsync(InputFileChangeEventArgs args)
    {
        if (!CanChooseFile) { _focusId = "pi-roles"; return; }
        _retrying = false; _currentRetryMessage = null; _useMessage = null;
        var file = args.File;
        // Opened here, while the file input is still on the page: the browser file stream starts its read when it is opened. The session
        // then copies it and uploads from the copy, after the page has already switched to the progress view (input removed) or was left.
        Stream? browserFile = file.Size > ProjectImportSession.MaxUploadBytes ? null : file.OpenReadStream(ProjectImportSession.MaxUploadBytes);
        Func<CancellationToken, Task<Stream>> open = browserFile is null
            ? _ => throw new IOException("The selected ZIP exceeds the upload limit.")
            : ct => ProjectImportSession.CopyToMemoryAsync(browserFile, ct);
        StartElapsedTimer();
        // The page starts the work and does not wait for it: the session owns it (the page may be left at any time).
        _ = Session.StartPreviewAsync(file.Name, file.Size, open, _setup);
    }

    private IGitSourcesApiService? GitSources => ServiceProvider.GetService(typeof(IGitSourcesApiService)) as IGitSourcesApiService;

    /// <summary>Git mode: the session stages the branch's current commit through the same preview (started only by the person's choice).</summary>
    private void StartGitAsync((BirkNext.GitSources.GitImportRequest Request, string Label) choice)
    {
        _retrying = false; _currentRetryMessage = null; _useMessage = null;
        StartElapsedTimer();
        if (GitSources is not { } git) return;
        _ = Session.StartGitPreviewAsync(choice.Label, ct => git.ImportAsync(choice.Request, ct), _setup, choice.Request.Roles);
    }

    /// <summary>Git mode, several repositories: the first is staged now; each next one is offered on the result (one review per package).</summary>
    private void StartGitQueueAsync(IReadOnlyList<(BirkNext.GitSources.GitImportRequest Request, string Label)> queue)
    {
        if (queue.Count == 0) return;
        Session.GitQueue = [.. queue.Skip(1)];
        Session.GitQueueTotal = queue.Count;
        StartGitAsync(queue[0]);
    }

    /// <summary>The next repository of the Git queue (after the previous one's result was shown).</summary>
    private void NextInGitQueue()
    {
        if (Session.GitQueue.Count == 0) return;
        var next = Session.GitQueue[0];
        Session.GitQueue = [.. Session.GitQueue.Skip(1)];
        StartGitAsync(next);
    }

    /// <summary>Starts the import of the staged archive. A repeated click while it runs returns the running import; no second one starts.</summary>
    private void ImportAsync()
    {
        StartElapsedTimer();
        _ = Session.StartImportAsync();
    }

    /// <summary>Explicit cancellation of the running upload or import (leaving the page never cancels).</summary>
    private void CancelRunning() => Session.Cancel();

    /// <summary>The session moved on (here or while the page was not shown): follow-up reads and focus when a stage is reached.</summary>
    private void OnSessionChanged() => _ = InvokeAsync(async () =>
    {
        if (_disposed) return;
        var previous = _renderedPhase;
        _renderedPhase = _phase;
        if (previous != _phase)
        {
            if (!Session.IsBusy) StopElapsedTimer();
            if (_phase == Phase.Preview) { await LoadEnvironmentAsync(); _focusId = "pi-archive-heading"; }
            else if (_phase == Phase.Result) { await LoadSetupAsync(); await LoadProjectEvidenceAsync(); await AutoDraftAsync(); _focusId = "pi-outcome-heading"; }
            else if (_phase == Phase.Choose && previous == Phase.Result) await LoadSetupAsync();
            else if (_phase == Phase.Choose && _failure is not null) _focusId = "pi-choose-file";
        }
        if (!_disposed) StateHasChanged();
    });

    /// <summary>
    /// After a commit that produced (or reused) a source snapshot: draft each Test Pack's canonical XML fixture from that snapshot when nothing
    /// needs a person (see <see cref="XmlFixtureAutoDraft"/>). Once per snapshot; never approves.
    /// </summary>
    private async Task AutoDraftAsync()
    {
        if (_commit?.Source is not { State: ProjectImportSourceState.Created or ProjectImportSourceState.Reused, SnapshotId: { } snapshot } || Session.AutoDraftSnapshot == snapshot) return;
        Session.AutoDraftSnapshot = snapshot;
        await RunAutoDraftAsync(snapshot);
    }

    private bool _autoDraftBusy;

    /// <summary>Runs the draft for the import's snapshot; a failure is kept as a retryable outcome, never dropped.</summary>
    private async Task RunAutoDraftAsync(Guid snapshot)
    {
        try { Session.AutoDrafts = await XmlFixtureAutoDraft.RunAsync(ServiceProvider, snapshot, Session.Target == ImportTarget.CurrentApplication); }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or InvalidOperationException)
        { Session.AutoDrafts = [XmlFixtureAutoDraft.Failure($"The XML fixture draft could not run ({ex.GetType().Name}).")]; }
    }

    /// <summary>Retry without reimporting: the same snapshot; the catalog is read again, so a draft created meanwhile counts as already generated.</summary>
    private async Task RetryAutoDraftAsync()
    {
        if (Session.AutoDraftSnapshot is not { } snapshot || _autoDraftBusy) return;
        _autoDraftBusy = true;
        try { await RunAutoDraftAsync(snapshot); }
        finally { _autoDraftBusy = false; }
    }

    private async Task RetrySourceAsync()
    {
        if (_preview is not { } preview || _commit is null) return;
        _retrying = true;
        try
        {
            var (commit, error) = await Api.CommitAsync(preview.StagingId);
            // The user may have left the result view while this ran: the import record is still updated, the page state is not revived.
            var stillShown = ReferenceEquals(_preview, preview) && _commit is not null;
            if (commit is not null)
            {
                if (stillShown) _commit = commit;
                Activation.UpdateSource(preview.ImportId, commit.Source, commit.StagingId, commit.StagedUntil);
                _saveWarning = !await AutoSave.SaveNowAsync();
                if (commit.Source.SnapshotId is not null) await Applicability.RefreshAsync();
            }
            else if (error is not null && stillShown)
            {
                _commit = _commit with { Source = _commit.Source with { State = ProjectImportSourceState.Failed, CanRetry = error.Code != "IMPORT_STAGING_EXPIRED", Code = error.Code, Message = error.Message } };
            }
        }
        catch (HttpRequestException ex) when (ReferenceEquals(_preview, preview) && _commit is not null) { _commit = _commit with { Source = _commit.Source with { Message = BackendRequestClassifier.FromException("Project import", ex).UserMessage } }; }
        catch (HttpRequestException) { /* left the result view; the record keeps its last known source state */ }
        finally { _retrying = false; }
    }

    /// <summary>
    /// "Back to Import Project": navigation, not rollback. Clears only this page's import session (result, preview, fingerprint, progress,
    /// errors, file input) and shows the upload view. The import record, its documents and artifact selections, its Source Analysis snapshot,
    /// the current project and IQR bindings are untouched, and the staged archive is kept so the current card can still retry the source.
    /// Unlike "Import another project" it does not open the file chooser.
    /// </summary>
    private void BackToImportProject()
    {
        Reset();
        _showUpload = false;
        // Focus the top of the upload view (the just-imported current project), not the chooser at the end of the page.
        _focusId = Activation.Current is null ? "pi-header-import" : "pi-current-heading";
    }

    private void CancelAsync()
    {
        // The preview is replaced at once; releasing the staged archive must never block or undo the reset (it also expires on its own).
        var staging = _preview?.StagingId;
        Reset();
        _showUpload = true;
        if (staging is { } stagingId) _ = DiscardQuietlyAsync(stagingId);
    }

    private Task DiscardQuietlyAsync(Guid stagingId) => Session.DiscardQuietlyAsync(stagingId);

    /// <summary>Clears every archive-specific value (preview, roles, source, fingerprint, name, errors, progress) and re-creates the file input.</summary>
    private void Reset()
    {
        StopElapsedTimer();
        _retrying = false;
        Session.Reset();
        _renderedPhase = _phase;
        _focusId = "pi-choose-file";
    }

    private async Task RetryCurrentSourceAsync(SddProjectImportRecord record)
    {
        if (record.SourceStagingId is not { } stagingId) return;
        _retrying = true; _currentRetryMessage = null;
        try
        {
            var (commit, error) = await Api.CommitAsync(stagingId);
            if (commit is not null)
            {
                Activation.UpdateSource(record.ImportId, commit.Source, commit.StagingId, commit.StagedUntil);
                _saveWarning = !await AutoSave.SaveNowAsync();
                if (commit.Source.SnapshotId is not null) await Applicability.RefreshAsync();
                else _currentRetryMessage = commit.Source.Message ?? "The source snapshot could still not be created.";
            }
            else if (error is not null)
            {
                // An expired staging cannot be retried; the record says so instead of offering the action again.
                Activation.UpdateSource(record.ImportId, new ProjectImportSourceResult { State = ProjectImportSourceState.Failed, Message = error.Message,
                    CanRetry = error.Code != "IMPORT_STAGING_EXPIRED" }, error.Code == "IMPORT_STAGING_EXPIRED" ? null : stagingId, record.SourceStagedUntil);
                _currentRetryMessage = error.Message;
            }
        }
        catch (HttpRequestException ex) { _currentRetryMessage = BackendRequestClassifier.FromException("Project import", ex).UserMessage; }
        finally { _retrying = false; }
    }

    private bool SourceAnalysisAvailable => ServiceProvider.GetService<FeatureVisibilityService>() is not { IsLoaded: true } visibility || visibility.SourceAnalysis;

    private void CloseCurrent()
    {
        Activation.Close();
        _ = AutoSave.SaveNowAsync();
    }

    private void Fail(SourceUploadFailure failure) { StopElapsedTimer(); _failure = failure; _inputGeneration++; _phase = Phase.Choose; _showUpload = true; _renderedPhase = _phase; _focusId = "pi-choose-file"; Session.NotifyChanged(); }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_phase == Phase.Result) Session.ResultSeen = true;
        if (_focusId is not { } id) return;
        _focusId = null;
        try { await JS.InvokeVoidAsync("birknextFocusElement", id); } catch (JSException) { }
    }

    public void Dispose()
    {
        // Unsubscribe only: the import (if any) keeps running in the session and is shown again on return.
        _disposed = true;
        Session.Changed -= OnSessionChanged;
        _elapsedTimer?.Dispose();
        if (ServiceProvider.GetService<ICurrentWorkspaceProjection>() is { } projection) projection.Changed -= OnWorkspaceChanged;
        if (ServiceProvider.GetService<IArtifactExplorerContext>() is { } explorer) explorer.Changed -= OnExplorerChanged;
        if (ServiceProvider.GetService<IFrontendAnalysisSettingsService>() is { } settings) settings.Changed -= OnEnvironmentChanged;
        if (ServiceProvider.GetService<NavigationManager>() is { } navigation) navigation.LocationChanged -= OnLocationChanged;
    }

    private void StartElapsedTimer()
    {
        _elapsed = _importStartedAt is { } started ? DateTimeOffset.UtcNow - started : TimeSpan.Zero;
        _elapsedTimer?.Dispose();
        _elapsedTimer = new System.Threading.Timer(_ => _ = InvokeAsync(() =>
        {
            if (_importStartedAt is { } started && _phase is Phase.Validating or Phase.Classifying or Phase.Importing)
            {
                _elapsed = DateTimeOffset.UtcNow - started;
                StateHasChanged();
            }
        }), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void StopElapsedTimer()
    {
        _elapsedTimer?.Dispose();
        _elapsedTimer = null;
    }

    private static string ElapsedText(TimeSpan elapsed) => elapsed.TotalHours >= 1
        ? $"{(int)elapsed.TotalHours}:{elapsed.Minutes:00}:{elapsed.Seconds:00}"
        : $"{(int)elapsed.TotalMinutes}:{elapsed.Seconds:00}";

    private static IReadOnlyList<string> Warnings(ProjectImportPreview preview, ProjectImportArtifactDiscovery discovery)
    {
        var list = new List<string>();
        if (discovery.NeedsReview.Count > 0) list.Add($"{discovery.NeedsReview.Count} document(s) could fit more than one role; they are not imported as artifacts: {string.Join(", ", discovery.NeedsReview.Take(5).Select(d => d.RelativePath))}{(discovery.NeedsReview.Count > 5 ? ", …" : "")}");
        if (discovery.Unclassified.Count > 0) list.Add($"{discovery.Unclassified.Count} other Markdown document(s) (README, checklists, notes, templates) are not project artifacts.");
        if (discovery.Skipped.Count > 0) list.Add($"{discovery.Skipped.Count} document(s) could not be read: {string.Join(", ", discovery.Skipped.Take(5).Select(d => $"{d.RelativePath} ({d.Reason})"))}{(discovery.Skipped.Count > 5 ? ", …" : "")}");
        if (preview.OtherFiles > 0) list.Add($"{preview.OtherFiles:N0} other file(s) — images, scripts, configuration and similar — are neither documents nor analyzed source.");
        foreach (var limitation in preview.Source.Limitations) list.Add(limitation);
        return list;
    }

    /// <summary>"Specifications, Plans, Tasks, Data Models, Constitutions": the document types found. What requires clarification is listed under
    /// Needs attention from the pack-aware overview, never inferred from the import record's role list.</summary>
    private static string DocumentsFact(SddProjectImportRecord record) =>
        record.ArtifactDocumentCount == 0 ? "No supported project documents" :
        string.Join(", ", record.DetectedRoles.Concat(record.AmbiguousRoles).Distinct().Select(Label));

    private static string Label(string role) => Enum.TryParse<WorkspaceArtifactType>(role, out var type)
        ? ImportProjectOverview.Title(type) switch { "Tasks" => "Tasks", "Research / supporting analysis" => "Research", var t => t + "s" }
        : role;

    private static (string Route, string Label)? FirstExplorer(SddProjectImportRecord record)
    {
        foreach (var role in SampleArtifactClassifier.RoleOrder.Where(r => r != WorkspaceArtifactType.Research))
            if (record.DetectedRoles.Contains(role.ToString()) || record.AmbiguousRoles.Contains(role.ToString()))
                return (ProjectInputPresentation.ExplorerRoute(role), BirkNext.Web.Services.Explorers.ArtifactExplorerRoles.Label(role) + " Explorer");
        return null;
    }

    private ProjectEvidenceView? _projectView;
    private bool _projectDeferred;

    /// <summary>Target Environment → Project after a successful import (optional: no environment, no service — no suggestion). Import never waits on it.</summary>
    private async Task LoadProjectEvidenceAsync()
    {
        _projectView = null; _projectDeferred = false;
        if (ServiceProvider.GetService(typeof(IProjectEvidenceService)) is not IProjectEvidenceService evidence) return;
        try { _projectView = await evidence.GetAsync(refresh: true); }
        catch (Exception ex) when (ex is not OutOfMemoryException) { _projectView = null; }
    }

    /// <summary>
    /// What the import means for the environment's logical project — never a forced setup step: A no project yet → configure (with a proposal
    /// when exactly one application candidate exists); D the import can satisfy a required role → review &amp; bind; B it adds compatible
    /// evidence → review; C nothing the project needs → no prompt. Nothing is bound here.
    /// </summary>
    private RenderFragment ProjectNext(string importId) => __builder =>
    {
        if (_projectDeferred || _projectView is not { EnvironmentId: { Length: > 0 } environmentId } view) return;
        var package = view.Packages.FirstOrDefault(p => p.ImportId == importId);
        if (!view.IsConfigured)
        {
            if (!view.Packages.Any(p => p.Capabilities.Count > 0)) return;
            var application = (ServiceProvider.GetService(typeof(IProjectEvidenceService)) as IProjectEvidenceService)?.TargetApplicationOf(environmentId);
            <section class="pi-card pi-project-next" aria-labelledby="pi-project-h" data-testid="pi-project-next" data-state="configure">
                @if (application is { } app)
                {
                    @* WHAT the environment represents is known: this import is evidence that may belong to it — never bound automatically. *@
                    <h2 id="pi-project-h">Available for Target Application @app.Name</h2>
                    <p>This import may be evidence for @app.Name. Review Project evidence to bind it; the import is complete either way and nothing is bound automatically.</p>
                    <div class="pi-actions">
                        <a class="btn-primary" href="@ProjectEvidenceResolver.ProjectTabHref(environmentId)" data-testid="pi-project-configure">Review Project evidence</a>
                        <button type="button" class="btn-secondary" data-testid="pi-project-later" @onclick="() => _projectDeferred = true">Later</button>
                    </div>
                }
                else
                {
                    <h2 id="pi-project-h">Target Application not chosen yet</h2>
                    <p>BirkNext found evidence for an application. Choose the Target Application this environment represents first; its Project evidence is bound next. The import is complete either way.</p>
                    @if (view.SuggestedProject is { } suggested)
                    {
                        <p data-testid="pi-project-suggested">Detected application <strong>@suggested.DisplayName</strong> — @suggested.ClassificationReason</p>
                    }
                    else if (view.ProjectCandidates.Count > 1)
                    {
                        <p data-testid="pi-project-candidates">Applications detected: @string.Join(", ", view.ProjectCandidates.Select(p => p.DisplayName)).</p>
                    }
                    <div class="pi-actions">
                        <a class="btn-primary" href="@TargetApplications.TabHref(environmentId)" data-testid="pi-project-configure">Configure Target Application</a>
                        <button type="button" class="btn-secondary" data-testid="pi-project-later" @onclick="() => _projectDeferred = true">Configure later</button>
                    </div>
                }
            </section>
            return;
        }
        if (package is null) return;
        var roles = view.Rows.Where(r => ProjectEvidencePackages.Satisfies(package, r.Role.Capability) && !r.Bound.Any(b => b.ImportId == importId)
            && (!r.IsResolved || r.Role.Cardinality == ProjectEvidenceCardinality.Multiple)).ToList();
        var required = roles.FirstOrDefault(r => r.Blocks);
        if (required is not null)
        {
            <section class="pi-card pi-project-next" aria-labelledby="pi-project-h" data-testid="pi-project-next" data-state="required">
                <h2 id="pi-project-h">Required evidence candidate found</h2>
                <p><strong>@required.Role.Label</strong> of @view.ProjectName · @package.ArchiveFileName (@ProjectEvidencePackages.WhyMatches(package, required.Role.Capability)). Not bound until you confirm it.</p>
                <div class="pi-actions"><a class="btn-primary" href="@ProjectEvidenceResolver.ProjectTabHref(environmentId, required.Role.RoleKey)" data-testid="pi-project-review">Review &amp; bind</a></div>
            </section>
        }
        else if (roles.Count > 0)
        {
            <section class="pi-card pi-project-next" aria-labelledby="pi-project-h" data-testid="pi-project-next" data-state="compatible">
                <h2 id="pi-project-h">New compatible project evidence available</h2>
                <p>@package.ArchiveFileName can add @string.Join(", ", roles.Select(r => r.Role.Label.ToLowerInvariant())) to @view.ProjectName. The project stays usable; nothing is bound automatically.</p>
                <div class="pi-actions"><a class="btn-secondary" href="@ProjectEvidenceResolver.ProjectTabHref(environmentId, roles[0].Role.RoleKey)" data-testid="pi-project-review">Review project evidence</a></div>
            </section>
        }
    };

    private RenderFragment TargetEnvironmentFact => __builder =>
    {
        var project = _projectView is { EnvironmentId: { Length: > 0 } viewEnvironment } view && viewEnvironment == _environmentId ? view : null;
        var row = ProjectImportPresentation.TargetEnvironment(_hasTarget, _environmentName, _targetUnavailable, project);
        <dl class="pi-facts pi-target" data-testid="pi-target" data-state="@(_hasTarget ? "selected" : _targetUnavailable ? "unavailable" : "none")">
            <div><dt>Target Environment</dt><dd>@row.Status <span class="pi-muted">— @row.Detail</span></dd></div>
        </dl>
    };

}
