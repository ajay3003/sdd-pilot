@page "/project-import"
@using BirkNext.Integrations
@using BirkNext.ProjectImport
@using BirkNext.Web.Services
@using BirkNext.Web.Services.ProjectImport
@using BirkNext.Web.Services.SampleProjects
@using BirkNext.Web.Models
@using BirkNext.Web.Components.ProjectImport
@using Microsoft.AspNetCore.Components.Forms
@inject IProjectImportApiService Api
@inject ProjectImportActivation Activation
@inject IFrontendAnalysisContextFactory ContextFactory
@inject ProjectApplicabilityState Applicability
@inject IWorkspaceAutoSaveService AutoSave
@inject IJSRuntime JS
@inject IServiceProvider ServiceProvider
@implements IDisposable

@* Project Import: one archive, uploaded once. Its documents become artifacts in the Shared Artifact Repository and its source becomes a
   Source Analysis snapshot. The two stay separate evidence domains; they share only the import identity and the archive fingerprint. *@
<PageTitle>Import Project</PageTitle>
<div class="pi-page">
    <PageHeader Title="Import Project" Description="Import a real project. Upload one ZIP containing source code, supported project documents, or both.">
        @if (_phase == Phase.Result)
        {
            @* Same place as Back in the review pages' post-run headers. Secondary: the next steps below stay the primary actions. *@
            <button type="button" class="btn-secondary" data-testid="pi-back" @onclick="BackToImportProject">Back to Import Project</button>
        }
    </PageHeader>

    @if (_phase == Phase.Choose)
    {
        @if (Activation.Current is { } current)
        {
            var currentSource = ProjectImportPresentation.CurrentSource(current, DateTimeOffset.UtcNow);
            var currentSnapshot = CurrentSnapshot(current);
            var analysis = ImportProjectOverview.SourceAnalysis(currentSource, currentSnapshot);
            var sourceRole = ImportProjectOverview.SourceRole(_setup, currentSource.SnapshotId, currentSource.SourceDetected);
            <div class="pi-current-group" data-testid="pi-current">
            @* ── A · Current project summary: import, documents, source analysis, source role and test environment are separate statuses ── *@
            <section class="pi-card pi-current" aria-labelledby="pi-current-heading" data-testid="pi-current-card">
                <h2 id="pi-current-heading" tabindex="-1" class="pi-current-heading"><span class="pi-current-eyebrow">Current project</span> <strong data-testid="pi-current-name">@current.ProjectName</strong></h2>
                <p class="pi-current-success" data-testid="pi-current-success"><span aria-hidden="true">✓ </span><strong>Project imported successfully.</strong> @ImportProjectOverview.ImportedKind(current, currentSource). Import means BirkNext found and recorded the contents — nothing has been reviewed or tested yet.</p>
                <p class="pi-current-summary" data-testid="pi-current-summary">@ImportProjectOverview.Summary(current, _workspace, currentSource)</p>
                <dl class="pi-current-status">
                    <div data-testid="pi-current-documents"><dt>Documents</dt><dd>@(current.ArtifactDocumentCount > 0 && _workspace?.Overview is { } docOverview ? ImportProjectOverview.DocumentTypes(docOverview) : DocumentsFact(current))</dd></div>
                    <div data-testid="pi-current-source" data-has-snapshot="@(currentSource.SnapshotId is null ? "false" : "true")" data-state="@analysis.State">
                        <dt>Source Analysis</dt>
                        <dd>
                            <span class="pi-badge pi-badge-@ProjectImportPresentation.ToneClass(analysis.Tone)" data-testid="pi-current-source-status">@analysis.Status</span>
                            @if (analysis.Explanation is { } explanation) { <span class="pi-muted" data-testid="pi-current-source-explanation"> @explanation</span> }
                            @if (analysis.Areas is { } areas) { <span class="pi-areas" data-testid="pi-current-source-areas">@areas</span> }
                            @if (analysis.HasDetails && currentSource.SnapshotId is { } detailSnapshot) { <a href="@ProjectImportPresentation.SourceAnalysisHref(detailSnapshot)" data-testid="pi-current-analysis-details">View analysis details</a> }
                        </dd>
                    </div>
                    @if (sourceRole is { } role)
                    {
                        <div data-testid="pi-current-role" data-identified="@(role.Identified ? "true" : "false")">
                            <dt>Source role</dt>
                            <dd><span class="pi-badge pi-badge-@(role.Identified ? "available" : "neutral")" data-testid="pi-current-role-status">@role.Status</span>@if (role.Detail is { } roleDetail) { <span class="pi-muted" data-testid="pi-current-role-detail"> @roleDetail</span> }</dd>
                        </div>
                    }
                    <div data-testid="pi-current-environment"><dt>Test environment</dt><dd><span class="pi-badge pi-badge-@(_hasTarget ? "available" : "partial")">@(_environmentName ?? "Not selected")</span></dd></div>
                </dl>
                @if (_currentRetryMessage is { } retryMessage) { <p class="pi-warning" role="status" data-testid="pi-current-retry-message">@retryMessage</p> }
            </section>

            @* ── B · Needs attention, grouped by who resolves it (documents ≠ testing setup ≠ source analysis ≠ environment) ── *@
            @{ var attention = ImportProjectOverview.Attention(_workspace, _setup, currentSource, _hasTarget); var open = attention.Count(a => !a.Informational); }
            <section class="pi-card pi-attention" aria-labelledby="pi-attention-heading" data-testid="pi-attention">
                <h2 id="pi-attention-heading">Needs attention <span class="pi-muted" data-testid="pi-attention-count">@(open > 0 ? $"· {open} thing{(open == 1 ? "" : "s")} need{(open == 1 ? "s" : "")} attention" : "· nothing to resolve")</span></h2>
                @if (attention.Count == 0)
                {
                    <p class="pi-muted">Nothing needs attention. You can start reviewing.</p>
                }
                else
                {
                    @foreach (var (group, title, items) in ImportProjectOverview.Grouped(attention))
                    {
                        <div class="pi-attention-group" data-testid="pi-attention-group" data-group="@group">
                            <h3 class="pi-attention-group-title">@title</h3>
                            <ul class="pi-attention-list">
                                @foreach (var item in items)
                                {
                                    <li class="pi-attention-item @(item.Informational ? "is-info" : "is-attention")" data-testid="pi-attention-item" data-key="@item.Key">
                                        <span class="pi-attention-kind">@(item.Informational ? "Note" : "Attention")</span>
                                        <span class="pi-attention-body"><span class="pi-attention-text">@item.Text</span>@if (item.Detail is { Length: > 0 } detail) { <span class="pi-muted">@detail</span> }</span>
                                        <a href="@item.Href" class="pi-attention-action" data-testid="pi-attention-action">@item.ActionLabel</a>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                }
            </section>

            @* ── C · What can I do now? Only actions useful in the current state; Source Analysis is technical evidence, so secondary ── *@
            <section class="pi-card" aria-labelledby="pi-next-now-heading" data-testid="pi-now">
                <h2 id="pi-next-now-heading">What can I do now?</h2>
                <div class="pi-actions">
                    @if (FirstExplorer(current) is { } explorer) { <a class="btn-primary" href="@explorer.Route" data-testid="pi-current-open-documents">Review project documents</a> }
                    @if (_setup is { Packs.Count: > 0 })
                    {
                        <a class="btn-secondary" href="#pi-setup-heading" data-testid="pi-current-open-setup">Review testing setup</a>
                        <a class="btn-secondary" href="integration-quality-review" data-testid="pi-current-open-integrations">Review integrations</a>
                    }
                    @if (currentSource.SnapshotId is { } openSnapshot)
                    {
                        <a class="btn-secondary" href="@ProjectImportPresentation.SourceAnalysisHref(openSnapshot)" data-testid="pi-current-open-source">View Source Analysis</a>
                    }
                    else if (currentSource.CanRetry)
                    {
                        <button type="button" class="btn-secondary" data-testid="pi-current-retry-source" disabled="@_retrying" @onclick="() => RetryCurrentSourceAsync(current)">@(_retrying ? "Retrying…" : "Retry creating source analysis")</button>
                    }
                    <button type="button" class="btn-secondary" data-testid="pi-current-import-another" aria-expanded="@(_showUpload ? "true" : "false")" aria-controls="pi-choose" @onclick="ShowUpload">Import another project</button>
                    <button type="button" class="btn-secondary" data-testid="pi-close" @onclick="CloseCurrent">Clear current project</button>
                </div>
                <p class="pi-muted" data-testid="pi-close-help">Clearing only stops showing this as the current project. Imported data remains available in history: nothing is deleted, and Integration Quality Review bindings do not change.</p>
            </section>

            @* ── D · Project contents ── *@
            <section class="pi-card pi-project-artifacts" aria-labelledby="pi-artifacts-heading" data-testid="pi-current-candidates" data-import="@current.ImportId">
                <h2 id="pi-artifacts-heading">Project contents</h2>
                @* Status per kind of content, from what the import and its stored snapshot already hold (nothing is analyzed for this). *@
                <dl class="pi-facts pi-contents-status" data-testid="pi-contents-status">
                    <div><dt>Source code</dt><dd data-testid="pi-contents-source">@(currentSource.SourceDetected ? "Available" : "Not in this archive")</dd></div>
                    @if (currentSnapshot is { InfrastructureFormats.Count: > 0 } iacSnapshot) { <div><dt>Infrastructure</dt><dd data-testid="pi-contents-infrastructure">@string.Join(", ", iacSnapshot.InfrastructureFormats) detected</dd></div> }
                    @if (currentSnapshot?.Areas.FirstOrDefault(a => a.Area == "Contracts") is { Status: "Complete" or "Partial" } contracts) { <div><dt>Contracts/schemas</dt><dd data-testid="pi-contents-contracts">Detected@(contracts.Status == "Partial" ? " · partially analyzed" : "")</dd></div> }
                </dl>
                @if (current.ArtifactDocumentCount > 0) { <ProjectArtifactCandidateReview @key="current.ImportId" LabelledBy="pi-artifacts-heading" /> }
                else { <p class="pi-muted" data-testid="pi-current-no-artifacts">No supported project documents were found. @(currentSource.SourceDetected ? "The source code can still be reviewed." : "")</p> }
            </section>
            </div>
        }

        @* ── E · Testing / integration setup detected ── *@
        @if (_setup is { Packs.Count: > 0 } setup)
        {
            <section class="pi-card pi-setup-summary" aria-labelledby="pi-setup-heading" data-testid="pi-setup-summary">
                <h2 id="pi-setup-heading" tabindex="-1">Testing setup detected</h2>
                @foreach (var pack in setup.Packs)
                {
                    var lines = pack.Sources.OrderBy(SourceSetupPresentation.Order).Select(ImportProjectOverview.Line).ToList();
                    <div class="pi-setup-pack" data-testid="pi-setup-pack" data-pack="@pack.PackId">
                        <h3 class="pi-setup-pack-name">@pack.DisplayName</h3>
                        <p class="pi-setup-headline" data-testid="pi-setup-headline">@ImportProjectOverview.SetupHeadline(pack)</p>
                        <ul class="pi-setup-lines">
                            @foreach (var line in lines)
                            {
                                <li class="pi-setup-line @(line.NeedsAttention ? "is-attention" : "")" data-testid="pi-setup-line" data-role="@line.Key">
                                    <span class="pi-setup-line-label">@line.Label@(line.Optional ? " (optional)" : "")</span>
                                    <span class="pi-setup-line-state"><span class="visually-hidden">@(line.NeedsAttention ? "Needs attention: " : "")</span>@line.State</span>
                                    @if (line.ActionLabel is { } actionLabel && line.Href is { } actionHref) { <a href="@actionHref" aria-label="@line.ActionName" class="pi-setup-line-action" data-testid="pi-setup-line-action">@actionLabel</a> }
                                </li>
                            }
                        </ul>
                        @if (!setup.BindingsRead) { <p class="pi-muted" data-testid="pi-setup-environment">Integration review requires a test environment. <a href="@NavigationCatalog.TargetEnvironmentsRoute">Select test environment</a></p> }
                    </div>
                }
                <details class="pi-details" data-testid="pi-setup-all-details">
                    <summary>Review setup details</summary>
                    <TestPackSourceSetupPanel Setup="setup" />
                </details>
            </section>
        }

        @* ── F · Previously imported projects (most recent first; opening one never re-imports or changes evidence) ── *@
        @if (ProjectImportHistory.Previous(Activation.Imports, Activation.Current?.ImportId, _setup) is { Count: > 0 } previous)
        {
            <section class="pi-card pi-previous" aria-labelledby="pi-previous-heading" data-testid="pi-previous">
                <h2 id="pi-previous-heading">Previously imported projects and sources</h2>
                <p class="pi-muted" data-testid="pi-previous-help">Each keeps its own source analysis, which testing setups and Integration Quality Review use directly — whichever project is current. <strong>Set as current project</strong> only changes which project's documents BirkNext shows: it does not re-import, analyze, or change saved review evidence or integration bindings.</p>
                @if (_useMessage is { } useMessage) { <p class="pi-warning" role="status" data-testid="pi-use-message">@useMessage</p> }
                <ul class="pi-previous-list" aria-label="Previously imported projects and sources">
                    @foreach (var row in previous)
                    {
                        var rowAnalysis = ImportProjectOverview.SourceAnalysis(row.HasSource, row.SnapshotId, row.Snapshot);
                        var rowRole = ImportProjectOverview.SourceRole(_setup, row.SnapshotId, row.HasSource);
                        <li class="pi-previous-row" data-testid="pi-previous-row" data-origin="@row.Origin" data-import="@row.ImportId" data-snapshot="@row.SnapshotId">
                            <div class="pi-setup-head">
                                <strong class="pi-previous-name" data-testid="pi-previous-name">@row.DisplayName</strong>
                                <span class="pi-muted" data-testid="pi-previous-contents">@ImportProjectOverview.Contents(row)</span>
                            </div>
                            <dl class="pi-previous-facts">
                                @if (rowRole is { } previousRole) { <div><dt>Source role</dt><dd data-testid="pi-previous-role">@previousRole.Status</dd></div> }
                                @if (row.HasSource) { <div><dt>Source Analysis</dt><dd><span class="pi-badge pi-badge-@ProjectImportPresentation.ToneClass(rowAnalysis.Tone)" data-testid="pi-previous-analysis">@rowAnalysis.Status</span></dd></div> }
                                @if (row.ConfigurationEnvironments.Count > 0)
                                {
                                    <div><dt>Environment labels</dt><dd data-testid="pi-previous-environment-labels" title="Labels found in source, not proof of deployment.">@string.Join(" · ", row.ConfigurationEnvironments)<span class="visually-hidden"> (labels found in source, not proof of deployment)</span></dd></div>
                                }
                                @* IQR bindings belong to a target environment: shown only when one is selected and the source is actually bound. *@
                                @if (_setup is { BindingsRead: true } && row.BoundIntegrations.Count > 0) { <div><dt>IQR bindings</dt><dd data-testid="pi-previous-binding-count">@row.BoundIntegrations.Count</dd></div> }
                                <div><dt>Imported</dt><dd data-testid="pi-previous-when">@ImportProjectOverview.Date(row.ImportedAt)</dd></div>
                            </dl>
                            <div class="pi-actions">
                                @if (row.CanUseAsCurrent) { <button type="button" class="btn-secondary" data-testid="pi-previous-use" aria-label="@($"Set {row.DisplayName} as current project")" @onclick="() => UseAsCurrent(row.ImportId!)">Set as current project</button> }
                                @if (row.SnapshotId is { } openRowSnapshot) { <a class="btn-secondary" href="@ProjectImportPresentation.SourceAnalysisHref(openRowSnapshot)" data-testid="pi-previous-open-source" aria-label="@($"Open {row.DisplayName} in Source Analysis")">Open Source Analysis</a> }
                            </div>
                            <details class="pi-details" data-testid="pi-previous-details">
                                <summary>Details<span class="visually-hidden"> of @row.DisplayName</span></summary>
                                <dl class="pi-facts">
                                    <div><dt>Origin</dt><dd>@(row.Origin == PreviousImportOrigin.ProjectImport ? "Project Import" : "Source Analysis upload (not a project: no documents)")</dd></div>
                                    <div><dt>Archive</dt><dd><span data-testid="pi-previous-archive">@row.ArchiveFileName</span> · imported @row.ImportedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd></div>
                                    <div><dt>Source Analysis</dt><dd data-testid="pi-previous-source">@(row.SnapshotId is { } rowSnapshot ? $"Snapshot {ProjectImportHistory.ShortId(rowSnapshot)} · {row.SourceStatus}" : row.SourceStatus)</dd></div>
                                    @if (rowAnalysis.Explanation is { } rowExplanation) { <div><dt>Analysis</dt><dd>@rowExplanation</dd></div> }
                                    @if (rowAnalysis.Areas is { } rowAreas) { <div><dt>Analysis areas</dt><dd data-testid="pi-previous-areas">@rowAreas</dd></div> }
                                    <div><dt>Documents</dt><dd data-testid="pi-previous-documents">@row.Documents</dd></div>
                                    <div><dt>Source role</dt><dd data-testid="pi-previous-logical">@(row.LogicalSources.Count > 0 ? string.Join(", ", row.LogicalSources) : row.HasSource ? "Not identified" : "None")</dd></div>
                                    @if (rowRole is { Detail: { } roleWhy }) { <div><dt>Why</dt><dd data-testid="pi-previous-role-detail">@roleWhy</dd></div> }
                                    @foreach (var match in row.LogicalSources) { <div><dt>Testing setup</dt><dd data-testid="pi-previous-match">Matches the @match source requirement</dd></div> }
                                    @if (row.HasSource && _setup is { BindingsRead: true }) { <div><dt>IQR bindings</dt><dd data-testid="pi-previous-bindings">@ProjectImportHistory.BindingsText(row.BoundIntegrations, true)</dd></div> }
                                    <div><dt>Fingerprint</dt><dd><code title="@row.Fingerprint">@ProjectImportPresentation.ShortFingerprint(row.Fingerprint)</code></dd></div>
                                    @if (row.InfrastructureFormats.Count > 0) { <div><dt>Infrastructure as Code</dt><dd>@string.Join(", ", row.InfrastructureFormats)</dd></div> }
                                    @if (row.ConfigurationEnvironments.Count > 0) { <div><dt>Environment labels in source</dt><dd data-testid="pi-previous-environments">@string.Join(", ", row.ConfigurationEnvironments) <span class="pi-muted">(source labels, not deployed environments)</span></dd></div> }
                                </dl>
                                @if (row.BoundIntegrations.Count > 0 && _setup is { BindingsRead: true }) { <div class="pi-actions"><a href="integration-quality-review?view=evidence" data-testid="pi-previous-bindings-link">View @row.DisplayName bindings in IQR</a></div> }
                            </details>
                        </li>
                    }
                </ul>
            </section>
        }

        @* ── G · Technical details (the one provenance view; collapsed) ── *@
        @if (Activation.Current is { } technical)
        {
            var techSource = ProjectImportPresentation.CurrentSource(technical, DateTimeOffset.UtcNow);
            var techSnapshot = CurrentSnapshot(technical);
            <section class="pi-card pi-technical" aria-labelledby="pi-technical-heading">
                <h2 id="pi-technical-heading" class="pi-technical-heading">Technical details</h2>
                <details class="pi-details" data-testid="pi-current-technical">
                    <summary>Show import provenance, source analysis and environment labels<span class="visually-hidden"> of @technical.ProjectName</span></summary>
                    <dl class="pi-facts">
                        <div><dt>Archive</dt><dd data-testid="pi-current-archive">@technical.ArchiveFileName</dd></div>
                        <div><dt>Imported</dt><dd>@technical.ImportedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd></div>
                        <div><dt>Import</dt><dd><code>@technical.ImportId</code></dd></div>
                        <div><dt>Fingerprint</dt><dd><code title="@technical.ArchiveSha256" data-testid="pi-current-fingerprint">@ProjectImportPresentation.ShortFingerprint(technical.ArchiveSha256)</code></dd></div>
                        <div><dt>Source role</dt><dd data-testid="pi-current-logical">@(ProjectImportHistory.LogicalSources(_setup, techSnapshot?.SnapshotId ?? technical.SourceSnapshotId) is { Count: > 0 } logical ? string.Join(", ", logical) : techSource.SnapshotId is null ? "None" : "Not identified")</dd></div>
                        @* The snapshot's own status: Failed there is the application-code analyzer's outcome only (no production project). *@
                        <div><dt>Source Analysis</dt><dd data-testid="pi-current-snapshot">@techSource.Status@(techSnapshot is null ? "" : $" · {techSnapshot.Status}")@(techSnapshot?.Status switch { "Partial" => " (some areas could not be fully analyzed)", "Failed" => " (code analysis found no supported production project; other areas are analyzed separately)", _ => "" })</dd></div>
                        @if (techSnapshot is { Areas.Count: > 0 } withAreas) { <div><dt>Analysis areas</dt><dd data-testid="pi-current-areas">@string.Join(" · ", withAreas.Areas.Select(a => $"{a.Area}: {ImportProjectOverview.AreaStatus(a.Status)}"))</dd></div> }
                        <div><dt>Source detail</dt><dd data-testid="pi-current-source-detail">@techSource.Detail</dd></div>
                        @if (techSource.SnapshotId is not null && _setup is { BindingsRead: true })
                        {
                            <div><dt>IQR bindings</dt><dd data-testid="pi-current-bindings">@ProjectImportHistory.BindingsText(techSnapshot?.BoundIntegrations ?? [], true)</dd></div>
                        }
                        @if (techSnapshot is { ConfigurationEnvironments.Count: > 0 } withEnvironments)
                        {
                            <div><dt>Environment labels in source</dt><dd data-testid="pi-current-environments">@string.Join(", ", withEnvironments.ConfigurationEnvironments) <span class="pi-muted">(source labels, not deployed environments)</span></dd></div>
                        }
                        @if (techSnapshot is { InfrastructureFormats.Count: > 0 } withIac) { <div><dt>Infrastructure as Code</dt><dd>@string.Join(", ", withIac.InfrastructureFormats)</dd></div> }
                        @if (techSnapshot?.InfrastructureAutomation is { } automation) { <div><dt>Infrastructure automation</dt><dd data-testid="pi-current-automation">@automation</dd></div> }
                        <div><dt>Target Environment</dt><dd>@(_environmentName ?? "None selected") <span class="pi-muted">(the test environment runtime reviews use)</span></dd></div>
                    </dl>
                </details>
            </section>
        }

        @* ── H · Import another project: the full upload block only without a current project, or after "Import another project" ── *@
        @if (Activation.Current is null || _showUpload)
        {
        <section class="pi-card pi-choose" id="pi-choose" aria-labelledby="pi-choose-heading" data-testid="pi-choose">
            <h2 id="pi-choose-heading">@(Activation.Current is null ? "Choose a project archive" : "Import another project")</h2>
            <p>Upload one ZIP containing project source, project documents, or both. BirkNext shows what it found before anything is imported.</p>
            <ul class="pi-outcomes" data-testid="pi-outcomes">
                <li>Project documents</li>
                <li>Source code</li>
                <li>Contracts and schemas</li>
                <li>Infrastructure configuration</li>
            </ul>
            <p class="pi-muted" data-testid="pi-candidates-note">If several documents could be the same document for one feature, you choose which one after import.</p>
            <div class="pi-actions">
                <label class="pi-file-button">
                    <InputFile @key="_inputGeneration" id="pi-choose-file" class="pi-file-input" accept=".zip" OnChange="ChooseAsync" aria-label="Choose project ZIP (maximum 50 MB)" data-testid="pi-choose-file" data-generation="@_inputGeneration" />
                    <span aria-hidden="true">Choose project ZIP</span>
                </label>
                <span class="pi-muted">ZIP · maximum 50 MB · documents up to 1 MB each</span>
            </div>
            <p class="pi-muted" data-testid="pi-source-only-note"><a href="demo-projects">Demo Projects</a> remain available as optional examples. To analyze a source archive on its own, upload it in <a href="source-analysis">Source Analysis</a>: it creates the same source analysis, but no project documents, and it does not become the current project. It is still listed below with the imported sources.</p>
        </section>
        }
        @if (_failure is { } failure) { <ProjectImportFailure Failure="failure" /> }
    }
    else if (_phase is Phase.Validating or Phase.Classifying or Phase.Importing)
    {
        <section class="pi-card" aria-labelledby="pi-progress-heading" data-testid="pi-progress" aria-busy="true">
            <h2 id="pi-progress-heading">@(_phase == Phase.Importing ? "Importing the project" : "Checking the archive")</h2>
            <p class="pi-status" role="status" aria-live="polite" aria-atomic="true" data-testid="pi-status">
                @(_phase switch
                {
                    Phase.Validating => $"Uploading and validating {_fileName}, then detecting document roles and source…",
                    Phase.Classifying => $"Archive accepted. Detecting document roles: {_classified} of {_classifyTotal} Markdown documents…",
                    _ => _progress?.Stage ?? "Starting the project import…",
                })
            </p>
            @if (_phase == Phase.Importing && _progress is { StageNumber: { } stageNumber, StageCount: { } stageCount })
            {
                <p class="pi-muted" data-testid="pi-stage-count">Source Analysis stage @stageNumber of @stageCount</p>
            }
            @if (_phase is Phase.Validating or Phase.Importing)
            {
                <progress class="pi-progress pi-progress-indeterminate" aria-label="Project import in progress"></progress>
            }
            @if (_phase is Phase.Validating or Phase.Classifying or Phase.Importing)
            {
                @if (_phase == Phase.Importing && _progress is { Detail.Length: > 0 } currentProgress)
                {
                    <p class="pi-muted" data-testid="pi-stage-detail">@currentProgress.Detail</p>
                }
                @if (_preview is { } activePreview)
                {
                    <p class="pi-muted" data-testid="pi-progress-detail">Documents: @activePreview.Documents.Count · Source files: @activePreview.Source.SourceFiles</p>
                }
                <p class="pi-muted" data-testid="pi-elapsed">Elapsed: @ElapsedText(_elapsed)</p>
            }
            @if (_phase == Phase.Classifying && _classifyTotal > 0)
            {
                <progress class="pi-progress" max="@_classifyTotal" value="@_classified" aria-label="Documents classified">@_classified of @_classifyTotal</progress>
            }
        </section>
    }
    else if (_phase == Phase.Preview && _preview is { } preview && _discovery is { } discovery)
    {
        <section class="pi-card pi-archive" aria-labelledby="pi-archive-heading" data-testid="pi-preview">
            <h2 id="pi-archive-heading" tabindex="-1">@preview.Archive.FileName</h2>
            <dl class="pi-facts">
                <div><dt>Project name</dt><dd data-testid="pi-project-name">@preview.ProjectName <span class="pi-muted">(@ProjectImportPresentation.NameBasis(preview.ProjectNameBasis))</span></dd></div>
                <div><dt>Size</dt><dd>@ProjectImportPresentation.Size(preview.Archive.SizeBytes) · @preview.Archive.EntryCount.ToString("N0") entries</dd></div>
                <div><dt>Fingerprint</dt><dd><code title="@preview.Archive.Sha256" data-testid="pi-fingerprint">@ProjectImportPresentation.ShortFingerprint(preview.Archive.Sha256)</code></dd></div>
            </dl>
            <p class="pi-muted">Archive accepted. Nothing is imported until you choose Import project.</p>
        </section>

        @if (_duplicate is { } duplicate && !_importAgain)
        {
            <section class="pi-card pi-tone-neutral" aria-labelledby="pi-duplicate-heading" data-testid="pi-duplicate" data-current="@(duplicate.IsCurrent ? "true" : "false")">
                <h2 id="pi-duplicate-heading">Matching imported source already exists</h2>
                <dl class="pi-facts">
                    <div><dt>Archive</dt><dd>@duplicate.ArchiveFileName</dd></div>
                    <div><dt>Fingerprint</dt><dd><code title="@duplicate.Fingerprint">@ProjectImportPresentation.ShortFingerprint(duplicate.Fingerprint)</code></dd></div>
                    <div><dt>Imported</dt><dd>@duplicate.ImportedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd></div>
                </dl>
                <p class="pi-muted">This exact archive (same content, whatever its file name) is already @(duplicate.IsCurrent ? "the current project" : "imported"). Choose what to do; nothing is chosen for you.</p>
                <p class="pi-muted" data-testid="pi-duplicate-again-help">Import again updates that same import (no second history entry) and reuses its source analysis unless Source Analysis has changed since. Nothing is deleted.</p>
                <div class="pi-actions">
                    @if (duplicate.ImportId is { } existingImport && !duplicate.IsCurrent && Activation.Imports.Any(i => i.ImportId == existingImport))
                    {
                        <button type="button" class="btn-primary" data-testid="pi-duplicate-use" @onclick="() => UseExisting(existingImport)">Use existing import</button>
                    }
                    else if (duplicate.SnapshotId is { } existingSnapshot)
                    {
                        <a class="btn-primary" href="@ProjectImportPresentation.SourceAnalysisHref(existingSnapshot)" data-testid="pi-duplicate-open-source">Open existing snapshot in Source Analysis</a>
                    }
                    <button type="button" class="btn-secondary" data-testid="pi-duplicate-import-again" @onclick="() => _importAgain = true">Import again</button>
                </div>
            </section>
        }

        <div class="pi-columns">
            <ProjectImportArtifacts Discovery="discovery" />
            <ProjectImportSource Detection="preview.Source" Row="ProjectImportPresentation.SourcePreview(preview.Source, SourceAnalysisAvailable)" />
        </div>
        @TargetEnvironmentFact

        @if (Warnings(preview, discovery) is { Count: > 0 } warnings)
        {
            <section class="pi-card" aria-labelledby="pi-warnings-heading" data-testid="pi-warnings">
                <h2 id="pi-warnings-heading">Also in the archive</h2>
                <ul class="pi-list">@foreach (var w in warnings) { <li>@w</li> }</ul>
            </section>
        }

        @if (!ProjectImportPresentation.HasImportableContent(preview, discovery))
        {
            <section class="pi-card pi-tone-neutral" role="status" data-testid="pi-nothing">
                <h2>@ProjectImportPresentation.OutcomeTitle(ProjectImportOutcome.NothingToImport)</h2>
                <p>The archive is valid, but it has no supported project documents and no source. Nothing was activated.</p>
            </section>
        }
        <div class="pi-actions">
            <button type="button" class="btn-primary" data-testid="pi-import" disabled="@(!ProjectImportPresentation.HasImportableContent(preview, discovery) || (_duplicate is not null && !_importAgain))" @onclick="ImportAsync">@(_failure is null ? "Import project" : "Retry import")</button>
            <button type="button" class="btn-secondary" data-testid="pi-cancel" @onclick="CancelAsync">Choose another file</button>
        </div>
        @if (_failure is { } commitFailure)
        {
            <section class="pi-card pi-tone-rejected" role="alert" data-testid="pi-commit-failure" data-code="@commitFailure.Code">
                <h2>The import did not return a result</h2>
                <p>@commitFailure.Message</p>
                <p>The workspace did not finish updating. Source Analysis may already have saved its snapshot. Retrying this staged archive reuses a completed snapshot.</p>
                @if (!string.IsNullOrWhiteSpace(commitFailure.CorrelationId)) { <p>Reference: <code>@commitFailure.CorrelationId</code></p> }
            </section>
        }
    }
    else if (_phase == Phase.Result && _preview is { } done && _discovery is { } doneDiscovery)
    {
        var outcome = ProjectImportPresentation.Outcome(done, doneDiscovery, _commit?.Source);
        var tone = ProjectImportPresentation.ToneClass(ProjectImportPresentation.OutcomeTone(outcome));
        <section class="pi-card pi-outcome pi-tone-@tone" aria-labelledby="pi-outcome-heading" data-testid="pi-result" data-outcome="@outcome">
            <h2 id="pi-outcome-heading" tabindex="-1"><span class="pi-badge pi-badge-@tone">@(outcome == ProjectImportOutcome.Imported ? "Imported" : "Imported with notes")</span> @ProjectImportPresentation.OutcomeTitle(outcome)</h2>
            <p><strong>@done.ProjectName</strong> is now the current project. Imported is not reviewed or approved: review the documents next.</p>
            @if (ProjectImportPresentation.Notes(done, doneDiscovery, _commit?.Source) is { Count: > 0 } notes)
            {
                <ul class="pi-list" data-testid="pi-notes">@foreach (var note in notes) { <li>@note</li> }</ul>
            }
            @if (_saveWarning) { <p class="pi-warning" role="alert" data-testid="pi-save-warning">The import is active in this browser session, but the workspace could not be saved. It may not survive a reload.</p> }
            <details class="pi-details">
                <summary>Technical details</summary>
                <dl class="pi-facts" data-testid="pi-provenance">
                    <div><dt>Import</dt><dd><code data-testid="pi-import-id">@done.ImportId</code></dd></div>
                    <div><dt>Archive</dt><dd>@done.Archive.FileName</dd></div>
                    <div><dt>Fingerprint</dt><dd><code title="@done.Archive.Sha256">@ProjectImportPresentation.ShortFingerprint(done.Archive.Sha256)</code></dd></div>
                </dl>
            </details>
        </section>

        <div class="pi-columns">
            <ProjectImportArtifacts Discovery="doneDiscovery" Imported="true" />
            @if (_commit?.Source is { } source)
            {
                <ProjectImportSource Detection="done.Source" Row="ProjectImportPresentation.SourceResult(source)" Result="source">
                    @if (source.CanRetry)
                    {
                        <div class="pi-actions">
                            <button type="button" class="btn-secondary" data-testid="pi-retry-source" disabled="@_retrying" @onclick="RetrySourceAsync">@(_retrying ? "Retrying…" : "Retry creating source snapshot")</button>
                        </div>
                        <p class="pi-muted">The archive stays staged until @(_commit.StagedUntil?.ToLocalTime().ToString("HH:mm") ?? "it expires"), so no new upload is needed.</p>
                    }
                </ProjectImportSource>
            }
        </div>

        @if (doneDiscovery.HasArtifacts)
        {
            <section class="pi-card" data-testid="pi-candidate-review"><ProjectArtifactCandidateReview /></section>
        }

        @TargetEnvironmentFact

        <div class="pi-result-actions">
            <section class="pi-action-group" aria-labelledby="pi-next-heading">
                <h2 id="pi-next-heading" class="pi-action-heading">Next steps</h2>
                <div class="pi-actions" data-testid="pi-next">
                    @if (doneDiscovery.HasArtifacts && FirstExplorerFor(doneDiscovery) is { } explorer) { <a class="btn-primary" href="@explorer.Route" data-testid="pi-open-documents">Review documents in @explorer.Label</a> }
                    @if (_commit?.Source.SnapshotId is { } resultSnapshot)
                    {
                        <a class="@(doneDiscovery.HasArtifacts ? "btn-secondary" : "btn-primary")" href="@ProjectImportPresentation.SourceAnalysisHref(resultSnapshot)" data-testid="pi-open-source">Open Source Analysis</a>
                    }
                    <a class="btn-secondary" href="getting-started" data-testid="pi-open-workflow">Recommended Workflow</a>
                </div>
            </section>
            @* Two different things: Back only leaves this result view (the import stays saved and current); Import another opens the file
               chooser for the next archive at once. *@
            <section class="pi-action-group" aria-labelledby="pi-import-actions-heading">
                <h2 id="pi-import-actions-heading" class="pi-action-heading">Import</h2>
                <div class="pi-actions" data-testid="pi-import-actions">
                    <button type="button" class="btn-secondary" data-testid="pi-back-bottom" @onclick="BackToImportProject">Back to Import Project</button>
                    @ImportAnotherButton("pi-import-another", "pi-import-another-file")
                </div>
            </section>
        </div>
    }
</div>

@code {
    private enum Phase { Choose, Validating, Classifying, Preview, Importing, Result }
    private int _classified;
    private int _classifyTotal;
    private Phase _phase = Phase.Choose;
    private string? _fileName;
    private ProjectImportPreview? _preview;
    private ProjectImportArtifactDiscovery? _discovery;
    private ProjectImportCommitResult? _commit;
    private SourceUploadFailure? _failure;
    /// <summary>Shown beside the import only; never sent with it and never a condition for the source snapshot.</summary>
    private bool _hasTarget;
    private bool _saveWarning;
    private bool _retrying;
    private ProjectImportCommitEvent? _progress;
    /// <summary>Changes on every reset or failure: the file input is re-created, so choosing the very same ZIP again always fires a change.</summary>
    private int _inputGeneration;
    private string? _currentRetryMessage;
    private DateTimeOffset? _importStartedAt;
    private TimeSpan _elapsed;
    private System.Threading.Timer? _elapsedTimer;
    private string? _focusId;

    /// <summary>The packs' source setup and the stored snapshots, read from the backend; null when unavailable (the page works without it).</summary>
    private SourceSetupView? _setup;
    private string? _environmentId;
    /// <summary>The active Target Environment's name (the test environment), or null when none is selected.</summary>
    private string? _environmentName;
    /// <summary>The current workspace with its project-wide pack overview; null in hosts without the projection (the summary then omits counts).</summary>
    private CurrentWorkspaceSnapshot? _workspace;
    private ProjectImportDuplicate? _duplicate;
    private bool _importAgain;
    private string? _useMessage;
    /// <summary>The upload block is shown while a project is current only after "Import another project" (or when a choice failed).</summary>
    private bool _showUpload;

    protected override async Task OnInitializedAsync()
    {
        if (ServiceProvider.GetService<ICurrentWorkspaceProjection>() is { } projection) projection.Changed += OnWorkspaceChanged;
        await LoadEnvironmentAsync();
        await LoadSetupAsync();
        await LoadWorkspaceAsync();
    }

    private async Task LoadWorkspaceAsync()
    {
        if (ServiceProvider.GetService<ICurrentWorkspaceProjection>() is not { } projection) return;
        try { _workspace = await projection.GetAsync(); }
        catch (Exception ex) when (ex is not OutOfMemoryException) { _workspace = null; }
    }

    private void OnWorkspaceChanged() => _ = InvokeAsync(async () => { await LoadWorkspaceAsync(); StateHasChanged(); });

    private async Task LoadEnvironmentAsync()
    {
        try
        {
            var context = await ContextFactory.GetActiveContextAsync();
            _environmentId = context.ActiveProfileOrNull?.Id;
            _environmentName = context.ActiveProfileOrNull?.Name is { Length: > 0 } name ? name : null;
            _hasTarget = !string.IsNullOrWhiteSpace(_environmentId);
        }
        catch (Exception) { _hasTarget = false; _environmentId = null; _environmentName = null; }
    }

    private async Task LoadSetupAsync()
    {
        if (ServiceProvider.GetService<IIntegrationJourneysApiService>() is not { } journeys) return;
        try { _setup = (await journeys.SourceSetupAsync(_environmentId)).Value; }
        catch (Exception ex) when (ex is not OutOfMemoryException) { _setup = null; }
    }

    private SourceSetupSnapshot? CurrentSnapshot(SddProjectImportRecord record) =>
        _setup is null ? null : ProjectImportHistory.SnapshotsOf(record, _setup.Snapshots).OrderByDescending(s => s.SnapshotId == record.SourceSnapshotId).FirstOrDefault();

    /// <summary>Makes an earlier import current again from what the workspace holds: no upload, no new snapshot, no binding change.</summary>
    private async Task UseAsCurrent(string importId)
    {
        _useMessage = Activation.UseAsCurrent(importId) ? null : "That import is no longer recorded in this workspace.";
        if (_useMessage is not null) return;
        _ = AutoSave.SaveNowAsync(); _focusId = "pi-current-heading";
        // Source setup reads stored snapshots and bindings only (never re-imports or binds); refresh it so the cards follow the change.
        await LoadSetupAsync();
    }

    /// <summary>"Import another project": reveals the upload block and moves focus to its file chooser. Nothing changes until a file is chosen.</summary>
    private void ShowUpload()
    {
        _showUpload = true;
        _focusId = "pi-choose-file";
    }

    private void UseExisting(string importId)
    {
        var staging = _preview?.StagingId;
        Reset();
        if (staging is { } stagingId) _ = DiscardQuietlyAsync(stagingId);
        UseAsCurrent(importId);
    }

    /// <summary>
    /// "Import another project": opens the file chooser directly (a real file input behind a button-styled label, keyboard-operable like
    /// Choose project ZIP). It used to only reset the page and scroll to the upload section at its very end, so a second click was needed
    /// and the action looked like it did nothing. Cancelling the chooser changes nothing; the current project stays current until a new
    /// import succeeds.
    /// </summary>
    private RenderFragment ImportAnotherButton(string testId, string inputId) => __builder =>
    {
        <label class="pi-file-button pi-file-button-secondary" data-testid="@testId">
            <InputFile @key="_inputGeneration" id="@inputId" class="pi-file-input" accept=".zip" OnChange="ChooseAsync"
                       aria-label="Import another project: choose project ZIP (maximum 50 MB)" data-testid="@inputId" data-generation="@_inputGeneration" />
            <span aria-hidden="true">Import another project</span>
        </label>
    };

    private async Task ChooseAsync(InputFileChangeEventArgs args)
    {
        // A new archive starts a new import session: nothing of the previous result (commit, warnings, duplicate choice) carries over.
        // Persisted history, the current project, snapshots and IQR bindings are untouched.
        _commit = null; _saveWarning = false; _retrying = false; _duplicate = null; _importAgain = false; _currentRetryMessage = null; _useMessage = null;
        _failure = null;
        // The progress card shows the preview's counts: the previous archive's preview must not be shown while this one validates.
        _preview = null; _discovery = null; _classified = 0; _classifyTotal = 0;
        _fileName = args.File.Name;
        _phase = Phase.Validating;
        _progress = new ProjectImportCommitEvent { Stage = "Uploading and validating the archive", Detail = "Reading the ZIP and checking its entries." };
        StartElapsedTimer();
        try
        {
            await using var stream = args.File.OpenReadStream(50 * 1024 * 1024);
            var (preview, error) = await Api.PreviewAsync(args.File.Name, stream);
            if (preview is null) { _failure = error; _inputGeneration++; _phase = Phase.Choose; _showUpload = true; StopElapsedTimer(); _focusId = "pi-choose-file"; return; }
            _preview = preview;
            _phase = Phase.Classifying;
            _classified = 0;
            _classifyTotal = preview.Documents.Count;
            StateHasChanged();
            _duplicate = ProjectImportHistory.Duplicate(preview.Archive.Sha256, Activation.Imports, Activation.Current?.ImportId, _setup);
            _importAgain = false;
            _discovery = await ProjectImportArtifactDiscovery.FromAsync(preview, new Progress<(int Done, int Total)>(p =>
            {
                _classified = p.Done;
                _classifyTotal = p.Total;
                StateHasChanged();
            }));
            await LoadEnvironmentAsync();
            _phase = Phase.Preview;
            StopElapsedTimer();
            _focusId = "pi-archive-heading";
        }
        catch (IOException) { Fail(new("ARCHIVE_TOO_LARGE", "upload", "The selected ZIP exceeds the 50 MB upload limit.", Limit: 50L * 1024 * 1024)); }
        catch (HttpRequestException ex) { Fail(new("IMPORT_UNAVAILABLE", "upload", $"{BackendRequestClassifier.FromException("Project import", ex).UserMessage} Nothing was imported.")); }
        catch (TaskCanceledException) { Fail(new("IMPORT_TIMEOUT", "upload", "The archive check did not finish before the request timed out. Nothing was imported; retry.")); }
        catch (Exception ex) when (BackendRequestClassifier.IsRequestFailure(ex)) { Fail(new("IMPORT_PREVIEW_FAILED", "validation", BackendRequestClassifier.FromException("Project import", ex).UserMessage)); }
        catch (Exception ex) when (ex is not OutOfMemoryException) { Fail(new("IMPORT_PREVIEW_FAILED", "validation", "The archive could not be previewed. Nothing was imported; choose it again and retry.")); }
    }

    private async Task ImportAsync()
    {
        if (_preview is not { } preview || _discovery is not { } discovery) return;
        _failure = null;
        _progress = new ProjectImportCommitEvent { Stage = "Starting the project import", Detail = "Sending the staged archive to the existing import service." };
        StartElapsedTimer();
        _phase = Phase.Importing;
        ProjectImportCommitResult? commit;
        SourceUploadFailure? error;
        var progress = new Progress<ProjectImportCommitEvent>(update =>
        {
            if (_phase == Phase.Importing)
            {
                _progress = update;
                _ = InvokeAsync(StateHasChanged);
            }
        });
        try { (commit, error) = await Api.CommitWithProgressAsync(preview.StagingId, progress); }
        catch (HttpRequestException ex) { (commit, error) = (null, new SourceUploadFailure("IMPORT_UNAVAILABLE", "upload", $"{BackendRequestClassifier.FromException("Project import", ex).UserMessage} Nothing was activated; retry.")); }
        catch (TaskCanceledException) { (commit, error) = (null, new SourceUploadFailure("IMPORT_TIMEOUT", "upload", "The import did not finish before the request timed out. Nothing was activated in this workspace; retry — the same archive reuses a snapshot that was already created.")); }
        catch (Exception ex) when (BackendRequestClassifier.IsRequestFailure(ex)) { (commit, error) = (null, new SourceUploadFailure("IMPORT_RESPONSE_INVALID", "commit", BackendRequestClassifier.FromException("Project import", ex).UserMessage)); }
        catch (Exception ex) when (ex is not OutOfMemoryException) { (commit, error) = (null, new SourceUploadFailure("IMPORT_FAILED", "commit", "The import stopped before a result was returned. Retry the staged archive; a completed source snapshot will be reused.")); }
        if (commit is null)
        {
            // Nothing is activated without a commit result: the workspace never holds half an import.
            StopElapsedTimer();
            _failure = error;
            _phase = error?.Code == "IMPORT_STAGING_EXPIRED" ? Phase.Choose : Phase.Preview;
            if (_phase == Phase.Choose) { _preview = null; _discovery = null; _inputGeneration++; _showUpload = true; }
            return;
        }
        _commit = commit;
        try
        {
            _progress = new ProjectImportCommitEvent { Stage = "Activating project documents", Detail = "Applying the classified candidates to the Shared Artifact Repository." };
            StateHasChanged();
            Activation.Activate(preview, discovery, commit);
            _progress = new ProjectImportCommitEvent { Stage = "Saving the workspace", Detail = "Saving the import selection and provenance." };
            StateHasChanged();
            _saveWarning = !await AutoSave.SaveNowAsync();
            if (commit.Source.SnapshotId is not null) { await Applicability.RefreshAsync(); await LoadSetupAsync(); }
            _failure = null;
            _phase = Phase.Result;
            _focusId = "pi-outcome-heading";
        }
        catch (Exception ex) when (ex is not OutOfMemoryException)
        {
            _failure = new("PROJECT_IMPORT_ACTIVATION_FAILED", "workspace", "The workspace update did not finish. Source Analysis may already have saved its snapshot; retry this staged archive to continue.", CorrelationId: null);
            _phase = Phase.Preview;
        }
        finally { StopElapsedTimer(); }
    }

    private async Task RetrySourceAsync()
    {
        if (_preview is not { } preview || _commit is null) return;
        _retrying = true;
        try
        {
            var (commit, error) = await Api.CommitAsync(preview.StagingId);
            // The user may have left the result view while this ran: the import record is still updated, the page state is not revived.
            var stillShown = ReferenceEquals(_preview, preview) && _commit is not null;
            if (commit is not null)
            {
                if (stillShown) _commit = commit;
                Activation.UpdateSource(preview.ImportId, commit.Source, commit.StagingId, commit.StagedUntil);
                _saveWarning = !await AutoSave.SaveNowAsync();
                if (commit.Source.SnapshotId is not null) await Applicability.RefreshAsync();
            }
            else if (error is not null && stillShown)
            {
                _commit = _commit with { Source = _commit.Source with { State = ProjectImportSourceState.Failed, CanRetry = error.Code != "IMPORT_STAGING_EXPIRED", Code = error.Code, Message = error.Message } };
            }
        }
        catch (HttpRequestException ex) when (ReferenceEquals(_preview, preview) && _commit is not null) { _commit = _commit with { Source = _commit.Source with { Message = BackendRequestClassifier.FromException("Project import", ex).UserMessage } }; }
        catch (HttpRequestException) { /* left the result view; the record keeps its last known source state */ }
        finally { _retrying = false; }
    }

    /// <summary>
    /// "Back to Import Project": navigation, not rollback. Clears only this page's import session (result, preview, fingerprint, progress,
    /// errors, file input) and shows the upload view. The import record, its documents and artifact selections, its Source Analysis snapshot,
    /// the current project and IQR bindings are untouched, and the staged archive is kept so the current card can still retry the source.
    /// Unlike "Import another project" it does not open the file chooser.
    /// </summary>
    private void BackToImportProject()
    {
        Reset();
        _showUpload = false;
        // Focus the top of the upload view (the just-imported current project), not the chooser at the end of the page.
        _focusId = Activation.Current is null ? "pi-choose-file" : "pi-current-heading";
    }

    private void CancelAsync()
    {
        // The preview is replaced at once; releasing the staged archive must never block or undo the reset (it also expires on its own).
        var staging = _preview?.StagingId;
        Reset();
        _showUpload = true;
        if (staging is { } stagingId) _ = DiscardQuietlyAsync(stagingId);
    }

    private async Task DiscardQuietlyAsync(Guid stagingId)
    {
        try { await Api.DiscardAsync(stagingId); }
        catch (Exception ex) when (ex is not OutOfMemoryException) { /* the staging expires on its own */ }
    }

    /// <summary>Clears every archive-specific value (preview, roles, source, fingerprint, name, errors, progress) and re-creates the file input.</summary>
    private void Reset()
    {
        StopElapsedTimer();
        _preview = null; _discovery = null; _commit = null; _failure = null; _saveWarning = false; _retrying = false; _duplicate = null; _importAgain = false;
        _progress = null; _fileName = null; _classified = 0; _classifyTotal = 0;
        _inputGeneration++;
        _phase = Phase.Choose;
        _focusId = "pi-choose-file";
    }

    private async Task RetryCurrentSourceAsync(SddProjectImportRecord record)
    {
        if (record.SourceStagingId is not { } stagingId) return;
        _retrying = true; _currentRetryMessage = null;
        try
        {
            var (commit, error) = await Api.CommitAsync(stagingId);
            if (commit is not null)
            {
                Activation.UpdateSource(record.ImportId, commit.Source, commit.StagingId, commit.StagedUntil);
                _saveWarning = !await AutoSave.SaveNowAsync();
                if (commit.Source.SnapshotId is not null) await Applicability.RefreshAsync();
                else _currentRetryMessage = commit.Source.Message ?? "The source snapshot could still not be created.";
            }
            else if (error is not null)
            {
                // An expired staging cannot be retried; the record says so instead of offering the action again.
                Activation.UpdateSource(record.ImportId, new ProjectImportSourceResult { State = ProjectImportSourceState.Failed, Message = error.Message,
                    CanRetry = error.Code != "IMPORT_STAGING_EXPIRED" }, error.Code == "IMPORT_STAGING_EXPIRED" ? null : stagingId, record.SourceStagedUntil);
                _currentRetryMessage = error.Message;
            }
        }
        catch (HttpRequestException ex) { _currentRetryMessage = BackendRequestClassifier.FromException("Project import", ex).UserMessage; }
        finally { _retrying = false; }
    }

    private bool SourceAnalysisAvailable => ServiceProvider.GetService<FeatureVisibilityService>() is not { IsLoaded: true } visibility || visibility.SourceAnalysis;

    private void CloseCurrent()
    {
        Activation.Close();
        _ = AutoSave.SaveNowAsync();
    }

    private void Fail(SourceUploadFailure failure) { StopElapsedTimer(); _failure = failure; _inputGeneration++; _phase = Phase.Choose; _showUpload = true; _focusId = "pi-choose-file"; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusId is not { } id) return;
        _focusId = null;
        try { await JS.InvokeVoidAsync("birknextFocusElement", id); } catch (JSException) { }
    }

    public void Dispose()
    {
        _elapsedTimer?.Dispose();
        if (ServiceProvider.GetService<ICurrentWorkspaceProjection>() is { } projection) projection.Changed -= OnWorkspaceChanged;
    }

    private void StartElapsedTimer()
    {
        _importStartedAt = DateTimeOffset.UtcNow;
        _elapsed = TimeSpan.Zero;
        _elapsedTimer?.Dispose();
        _elapsedTimer = new System.Threading.Timer(_ => _ = InvokeAsync(() =>
        {
            if (_importStartedAt is { } started && _phase is Phase.Validating or Phase.Classifying or Phase.Importing)
            {
                _elapsed = DateTimeOffset.UtcNow - started;
                StateHasChanged();
            }
        }), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void StopElapsedTimer()
    {
        _elapsedTimer?.Dispose();
        _elapsedTimer = null;
        _importStartedAt = null;
    }

    private static string ElapsedText(TimeSpan elapsed) => elapsed.TotalHours >= 1
        ? $"{(int)elapsed.TotalHours}:{elapsed.Minutes:00}:{elapsed.Seconds:00}"
        : $"{(int)elapsed.TotalMinutes}:{elapsed.Seconds:00}";

    private static IReadOnlyList<string> Warnings(ProjectImportPreview preview, ProjectImportArtifactDiscovery discovery)
    {
        var list = new List<string>();
        if (discovery.NeedsReview.Count > 0) list.Add($"{discovery.NeedsReview.Count} document(s) could fit more than one role; they are not imported as artifacts: {string.Join(", ", discovery.NeedsReview.Take(5).Select(d => d.RelativePath))}{(discovery.NeedsReview.Count > 5 ? ", …" : "")}");
        if (discovery.Unclassified.Count > 0) list.Add($"{discovery.Unclassified.Count} other Markdown document(s) (README, checklists, notes, templates) are not project artifacts.");
        if (discovery.Skipped.Count > 0) list.Add($"{discovery.Skipped.Count} document(s) could not be read: {string.Join(", ", discovery.Skipped.Take(5).Select(d => $"{d.RelativePath} ({d.Reason})"))}{(discovery.Skipped.Count > 5 ? ", …" : "")}");
        if (preview.OtherFiles > 0) list.Add($"{preview.OtherFiles:N0} other file(s) — images, scripts, configuration and similar — are neither documents nor analyzed source.");
        foreach (var limitation in preview.Source.Limitations) list.Add(limitation);
        return list;
    }

    /// <summary>"Specifications, Plans, Tasks, Data Models, Constitutions": the document types found. What requires clarification is listed under
    /// Needs attention from the pack-aware overview, never inferred from the import record's role list.</summary>
    private static string DocumentsFact(SddProjectImportRecord record) =>
        record.ArtifactDocumentCount == 0 ? "No supported project documents" :
        string.Join(", ", record.DetectedRoles.Concat(record.AmbiguousRoles).Distinct().Select(Label));

    private static string Label(string role) => Enum.TryParse<WorkspaceArtifactType>(role, out var type)
        ? ImportProjectOverview.Title(type) switch { "Tasks" => "Tasks", "Research / supporting analysis" => "Research", var t => t + "s" }
        : role;

    private static (string Route, string Label)? FirstExplorer(SddProjectImportRecord record)
    {
        foreach (var role in SampleArtifactClassifier.RoleOrder.Where(r => r != WorkspaceArtifactType.Research))
            if (record.DetectedRoles.Contains(role.ToString()) || record.AmbiguousRoles.Contains(role.ToString()))
                return (ProjectInputPresentation.ExplorerRoute(role), BirkNext.Web.Services.Explorers.ArtifactExplorerRoles.Label(role) + " Explorer");
        return null;
    }

    private RenderFragment TargetEnvironmentFact => __builder =>
    {
        var row = ProjectImportPresentation.TargetEnvironment(_hasTarget);
        <dl class="pi-facts pi-target" data-testid="pi-target">
            <div><dt>Target Environment</dt><dd>@row.Status <span class="pi-muted">— @row.Detail</span></dd></div>
        </dl>
    };

    private static (string Route, string Label)? FirstExplorerFor(ProjectImportArtifactDiscovery discovery) =>
        discovery.DetectedRoles.Where(r => r.Role != WorkspaceArtifactType.Research).Select(r => r.Role).Cast<WorkspaceArtifactType?>().FirstOrDefault() is { } role
            ? (ProjectInputPresentation.ExplorerRoute(role), BirkNext.Web.Services.Explorers.ArtifactExplorerRoles.Label(role) + " Explorer")
            : null;
}
