@using BirkNext.CriticalE2E
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using BirkNext.Web.Shared.Components.Common
@using BirkNext.TestData
@inject ICriticalE2EApiService Api

@*
    A form, not a canvas. A critical flow is a short ordered list of typed steps; each step names what it acts on the way a
    tester would, and the selector behind that is one disclosure away. Everything here is a typed choice.
*@
<section class="e2e-editor" data-testid="e2e-editor" aria-labelledby="e2e-editor-heading">
    <h2 id="e2e-editor-heading" tabindex="-1" @ref="_heading">@(string.IsNullOrWhiteSpace(_draft.Id) ? "New critical flow" : "Edit critical flow")</h2>

    <div class="e2e-editor-grid">
        <label>Module
            @* Modules come from the registered delivery modules. A typed label stays possible, but it is a manual label and never counts. *@
            <select data-testid="e2e-editor-module" value="@ModuleChoice" @onchange="ModuleChanged" aria-describedby="e2e-editor-module-help">
                <option value="">Unassigned / diagnostic</option>
                @foreach (var module in RegisteredModules)
                {
                    <option value="@module">@module</option>
                }
                @if (ModuleUnresolved && !_manualModule)
                {
                    <option value="@_draft.Module">@_draft.Module · unresolved module</option>
                }
                <option value="@ManualChoice">Manual label…</option>
            </select>
            <span class="e2e-help @(ModuleUnresolved ? "e2e-fragile" : "")" id="e2e-editor-module-help" data-testid="e2e-editor-module-help">@ModuleHelp</span>
        </label>
        @if (_manualModule)
        {
            <label>Manual label <input data-testid="e2e-editor-module-manual" @bind="_draft.Module" aria-describedby="e2e-editor-module-help" /></label>
        }
        <label class="e2e-editor-name">Flow name <input data-testid="e2e-editor-name" @bind="_draft.Name" placeholder="e.g. Foreta plassering" /></label>
        <label>Purpose
            <select data-testid="e2e-editor-kind" value="@_draft.Kind" @onchange="e => _draft.Kind = Enum.Parse<CriticalE2EFlowKind>(e.Value!.ToString()!)">
                <option value="@CriticalE2EFlowKind.Critical">Critical user flow</option>
                <option value="@CriticalE2EFlowKind.Diagnostic">Smoke / diagnostic</option>
            </select>
        </label>
        <label>Execution
            <select data-testid="e2e-editor-mode" value="@_draft.Mode" @onchange="ModeChanged" disabled="@(_picking is not null)" aria-describedby="e2e-editor-mode-help">
                @foreach (var mode in new[] { CriticalE2EExecutionMode.CompanionBrowser, CriticalE2EExecutionMode.AutomatedIntegration })
                {
                    <option value="@mode">@CriticalE2EPresentation.ExecutionLabel(mode)</option>
                }
            </select>
            <span class="e2e-help" id="e2e-editor-mode-help">@(_draft.Mode == CriticalE2EExecutionMode.CompanionBrowser ? CriticalE2EPresentation.AttendedHelp : "Executed by BirkNext against configured APIs; no browser is involved.")</span>
        </label>
        <label class="e2e-editor-check">
            <input type="checkbox" data-testid="e2e-editor-required" @bind="_draft.RequiredForRelease" /> Required for release
        </label>
        <label class="e2e-editor-check">
            <input type="checkbox" data-testid="e2e-editor-enabled" @bind="_draft.Enabled" /> Enabled
        </label>
    </div>
    @if (_draft.Kind == CriticalE2EFlowKind.Diagnostic && _draft.RequiredForRelease)
    {
        <p class="e2e-help" data-testid="e2e-editor-diagnostic-required">Smoke / diagnostic flows never count toward release coverage, even when marked required.</p>
    }

    <ReviewDisclosure Text="Flow details" CollapseText="Hide flow details" Hint="@DetailsHint" TestId="e2e-editor-details" Class="e2e-disclosure">
        @* Where automation starts and stops, structured, with where the proposal came from. Shown with every result: a browser pass
           never claims what lies beyond the boundary. *@
        <fieldset class="e2e-fieldset" data-testid="e2e-editor-boundary">
            <legend>Automation boundary</legend>
            <div class="e2e-editor-grid">
                <label>Start <input data-testid="e2e-editor-boundary-start" value="@_draft.BoundaryStart" placeholder="Approved application page" @onchange="BoundaryStartChanged" /></label>
                <label>End <input data-testid="e2e-editor-boundary-end" value="@_draft.BoundaryEnd" placeholder="Browser-visible outcome" @onchange="BoundaryEndChanged" /></label>
                <label class="e2e-editor-wide">Downstream verification <input data-testid="e2e-editor-boundary-downstream" value="@_draft.BoundaryDownstream" placeholder="e.g. Service Bus / Bufdata verified separately" @onchange="BoundaryDownstreamChanged" /></label>
                <label class="e2e-editor-check e2e-editor-wide">
                    <input type="checkbox" data-testid="e2e-editor-boundary-covers" checked="@_draft.BoundaryCoversDownstream" @onchange="BoundaryCoversChanged" />
                    This flow's own steps also verify the downstream result
                </label>
            </div>
            <p class="e2e-help" data-testid="e2e-editor-boundary-source">Source: @_draft.BoundarySource@(_draft.BoundaryNote is { Length: > 0 } boundaryNote ? $" · {boundaryNote}" : "")</p>
            <button type="button" class="btn-secondary btn-small" data-testid="e2e-editor-boundary-suggest" @onclick="SuggestBoundary">Suggest from Integration Topology</button>
            @if (_draft.AutomationBoundary.Length > 0)
            {
                <p class="e2e-help" data-testid="e2e-editor-boundary-legacy">Legacy note: @_draft.AutomationBoundary</p>
            }
        </fieldset>

        @* Central Test Data owns reusable approved data. The flow keeps references (aliases); values stay in Test Data and reach only the
           backend while a run executes. *@
        <fieldset class="e2e-fieldset" data-testid="e2e-editor-testdata">
            <legend>Test Data</legend>
            <p class="e2e-help">Source: Test Data · status <strong data-testid="e2e-editor-testdata-status">@TestDataStatus</strong></p>
            @if (TestDataAssets.Count == 0)
            {
                <p class="e2e-muted" data-testid="e2e-editor-testdata-none">No Test Data assets are available. Create or approve them in Test Data.</p>
            }
            else
            {
                <label class="e2e-toggle"><input type="checkbox" data-testid="e2e-editor-testdata-all" @bind="_showUnapproved" /> Show assets that are not approved</label>
                <ul class="e2e-assets" data-testid="e2e-editor-testdata-assets" aria-label="Test Data assets used by this flow">
                    @foreach (var asset in CriticalE2EPresentation.CompatibleAssets(TestDataAssets, EnvironmentName, _showUnapproved))
                    {
                        var alias = asset.Alias;
                        <li>
                            <label class="e2e-toggle">
                                <input type="checkbox" data-testid="e2e-editor-asset-@alias" checked="@_draft.TestDataAliases.Contains(alias)" @onchange="e => ToggleAsset(alias, (bool)e.Value!)" />
                                <span class="e2e-mono">@alias</span>
                            </label>
                            <span class="e2e-help">@CriticalE2EPresentation.AssetLine(asset)</span>
                        </li>
                    }
                </ul>
            }
            @foreach (var variable in _draft.Placeholders())
            {
                var mapping = _draft.DataMappings.FirstOrDefault(m => m.Variable == variable);
                var type = mapping?.DataType ?? TestDataDataType.SimpleValues;
                <div class="e2e-step-fields" data-testid="e2e-editor-mapping-@variable">
                    <label>@("${data:" + variable + "}") type
                        <select data-testid="e2e-editor-mapping-type-@variable" value="@type" @onchange="e => MapVariable(variable, mapping?.AssetAliases ?? [], Enum.Parse<TestDataDataType>(e.Value!.ToString()!))">
                            @foreach (var dataType in Enum.GetValues<TestDataDataType>())
                            {
                                <option value="@dataType">@TestDataDataTypes.Label(dataType)</option>
                            }
                        </select>
                    </label>
                    <label>Test Data asset
                        <select data-testid="e2e-editor-mapping-asset-@variable" value="@(mapping?.AssetAliases.FirstOrDefault() ?? "")" @onchange="e => MapVariable(variable, AliasList(e.Value?.ToString()), type)">
                            <option value="">Not mapped</option>
                            @foreach (var asset in CriticalE2EPresentation.CompatibleAssets(TestDataAssets, EnvironmentName, _showUnapproved).Where(a => TestDataDataTypes.Of(a) == type))
                            {
                                <option value="@asset.Alias">@asset.Alias</option>
                            }
                        </select>
                    </label>
                </div>
            }
            <p class="e2e-help">Use <span class="e2e-mono">${data:name}</span> in a value, route or outcome to map it to a Test Data asset.
                <a class="e2e-link" data-testid="e2e-editor-testdata-open" href="@TestDataHref">Open Test Data</a></p>
            @if (_draft.TestDataPolicy.Length > 0)
            {
                <p class="e2e-help" data-testid="e2e-editor-testdata-legacy">Legacy note: @_draft.TestDataPolicy</p>
            }
        </fieldset>

        <div class="e2e-editor-grid">
            <label>Flow source
                <select data-testid="e2e-editor-source" value="@_draft.Source" @onchange="e => _draft.Source = Enum.Parse<CriticalE2EFlowSource>(e.Value!.ToString()!)">
                    @foreach (var source in new[] { CriticalE2EFlowSource.Manual, CriticalE2EFlowSource.BrowserDiscovery, CriticalE2EFlowSource.ObservedJourney, CriticalE2EFlowSource.RequirementDriven })
                    {
                        <option value="@source">@CriticalE2EPresentation.FlowSourceLabel(source)</option>
                    }
                </select>
            </label>
            <label>Requirement / use case (optional) <input data-testid="e2e-editor-requirement" @bind="_draft.RequirementRef" placeholder="e.g. FR-012" /></label>
            <label class="e2e-editor-wide">Description <input data-testid="e2e-editor-description" @bind="_draft.Description" /></label>
        </div>
    </ReviewDisclosure>

    <h3 class="e2e-steps-heading">Steps</h3>
    @if (_draft.Mode == CriticalE2EExecutionMode.CompanionBrowser && !PickReady)
    {
        @* Said once, above the steps: every step's picker points here instead of repeating it. *@
        <div class="e2e-pick-unavailable" id="e2e-pick-unavailable" data-testid="e2e-pick-unavailable" role="status">
            <p class="e2e-pick-unavailable-title"><strong>Browser selection unavailable</strong></p>
            <p>@(ElementPick?.Message ?? "Browser Companion status is not known yet.")</p>
            <p class="e2e-pick-unavailable-actions">
                <a class="e2e-cta" href="@SetupHref" data-testid="e2e-pick-setup">Open Browser Companion setup</a>
                <button type="button" class="btn-link" data-testid="e2e-pick-recheck" @onclick="OnCheckElementPick">Check again</button>
            </p>
        </div>
    }

    @if (_draft.Steps.Count == 0)
    {
        <p class="e2e-muted" data-testid="e2e-no-steps">No steps yet. Add the first step of the journey.</p>
    }
    <ol class="e2e-steps" data-testid="e2e-steps">
        @for (var index = 0; index < _draft.Steps.Count; index++)
        {
            var i = index;
            var step = _draft.Steps[i];
            @* Native dragover cancellation enables drop without dispatching every pointer movement through Blazor. *@
            <li @key="step.StepId" class="e2e-step @(_dragged is not null && _dropBefore == step.StepId ? "e2e-drop-target" : "")" data-testid="e2e-step-@i" data-step-id="@step.StepId" aria-labelledby="@($"e2e-step-title-{i}")"
                ondragover="event.preventDefault()" @ondragenter="() => _dropBefore = step.StepId" @ondrop="() => DropBefore(step.StepId)" @ondrop:stopPropagation>
                @* A step card: what it is in one line, then what it acts on, then how it is judged. *@
                <div class="e2e-step-head">
                    <span class="e2e-drag-handle" data-testid="e2e-step-drag-@i" draggable="@(_picking is null ? "true" : "false")" title="Drag to reorder" aria-hidden="true"
                          @ondragstart="() => StartDrag(step.StepId)" @ondragend="EndDrag">⋮⋮</span>
                    <h4 class="e2e-step-title" id="@($"e2e-step-title-{i}")" data-testid="e2e-step-title-@i">Step @(i + 1) · @StepActionLabel(step)</h4>
                    <div class="e2e-step-actions" role="group" aria-label="@($"Step {i + 1} actions")">
                        <button type="button" class="btn-link" data-testid="e2e-step-up-@i" title="Move step up" aria-label="@($"Move step {i + 1} up")" disabled="@(i == 0 || _picking is not null)" @ref="_upButtons[step.StepId]" @onclick="() => MoveStep(step.StepId, i - 1, true)">↑ Move up</button>
                        <button type="button" class="btn-link" data-testid="e2e-step-down-@i" title="Move step down" aria-label="@($"Move step {i + 1} down")" disabled="@(i == _draft.Steps.Count - 1 || _picking is not null)" @ref="_downButtons[step.StepId]" @onclick="() => MoveStep(step.StepId, i + 1, false)">↓ Move down</button>
                        <button type="button" class="btn-link" data-testid="e2e-step-before-@i" aria-label="@($"Insert step before step {i + 1}")" disabled="@(_picking is not null)" @onclick="() => InsertStep(i)">Insert before</button>
                        <button type="button" class="btn-link" data-testid="e2e-step-after-@i" aria-label="@($"Insert step after step {i + 1}")" disabled="@(_picking is not null)" @onclick="() => InsertStep(i + 1)">Insert after</button>
                        <button type="button" class="btn-link e2e-step-remove" data-testid="e2e-step-remove-@i" aria-label="@($"Remove step {i + 1}")" disabled="@(_picking is not null)" @onclick="() => RemoveStep(step.StepId)">Remove step</button>
                    </div>
                </div>
                <div class="e2e-step-fields">
                    <label>Step name <input data-testid="e2e-step-name-@i" value="@step.Description" placeholder="e.g. Open Generelle roller"
                           @onchange="e => Replace(i, step with { Description = Text(e) })" /></label>
                    <label>Action
                        @if (_draft.Mode == CriticalE2EExecutionMode.CompanionBrowser)
                        {
                            <select @ref="_actionFields[step.StepId]" data-testid="e2e-step-action-@i" value="@step.BrowserAction" aria-label="@($"Step {i + 1} action")"
                                    @onchange="e => ActionChanged(i, Enum.Parse<CompanionActionKind>(e.Value!.ToString()!))">
                                @* Picking is how a step is authored, not something a step does. *@
                                @foreach (var action in Enum.GetValues<CompanionActionKind>().Where(a => a != CompanionActionKind.PickElement))
                                {
                                    <option value="@action">@ActionLabel(action)</option>
                                }
                            </select>
                        }
                        else
                        {
                            <select @ref="_actionFields[step.StepId]" data-testid="e2e-step-action-@i" value="@step.IntegrationAction" aria-label="@($"Step {i + 1} action")"
                                    @onchange="e => Replace(i, step with { IntegrationAction = Enum.Parse<CriticalE2EIntegrationKind>(e.Value!.ToString()!) })">
                                @foreach (var action in Enum.GetValues<CriticalE2EIntegrationKind>())
                                {
                                    <option value="@action">@action</option>
                                }
                            </select>
                        }
                    </label>
                </div>

                @if (_draft.Mode != CriticalE2EExecutionMode.CompanionBrowser)
                {
                    <div class="e2e-step-fields">
                        <label>Path or operation <input data-testid="e2e-step-target-@i" value="@(step.PathOrOperation ?? "")" placeholder="path or operation"
                               @onchange="e => Replace(i, step with { PathOrOperation = e.Value?.ToString() })" /></label>
                        <label>Value <input data-testid="e2e-step-value-@i" value="@(step.Value ?? "")" @onchange="e => Replace(i, step with { Value = e.Value?.ToString() })" /></label>
                        <label>Expected <input data-testid="e2e-step-expected-@i" value="@(step.Expected ?? "")" @onchange="e => Replace(i, step with { Expected = e.Value?.ToString() })" /></label>
                    </div>
                }
                else
                {
                    @if (step.BrowserAction == CompanionActionKind.Navigate)
                    {
                        @* Navigate is a page step, not an element: a route, never a picked target. *@
                        <div class="e2e-step-fields">
                            <label>Route <input data-testid="e2e-step-value-@i" value="@(step.Value ?? "")" placeholder="/admin/general-roles"
                                   @onchange="e => Replace(i, step with { Value = e.Value?.ToString() })" /></label>
                        </div>
                    }
                    @if (TargetsElement(step))
                    {
                        var target = CriticalE2EPresentation.Target(step.Selector);
                        _picks.TryGetValue(step.StepId, out var pick);
                        <div class="e2e-target" data-testid="e2e-step-target-summary-@i">
                            @* Identity first, as a person reads it; the strategy that finds it second; raw selector internals are
                               one disclosure further down. Unique and Captured on are shown only when a pick just proved them. *@
                            <dl class="e2e-target-main e2e-target-facts">
                                <div><dt>Selected element</dt><dd class="e2e-target-identity" data-testid="e2e-step-identity-@i">@(pick?.Element is { Recommended: not null } picked ? CriticalE2EPresentation.Identity(picked) : target.Identity)</dd></div>
                                @if (target.Strategy.Length > 0)
                                {
                                    <div><dt>Selector</dt><dd data-testid="e2e-step-strategy-@i">@target.Strategy</dd></div>
                                }
                                @if (pick?.Element is { Recommended: not null } e)
                                {
                                    <div><dt>Unique</dt><dd data-testid="e2e-step-unique-@i">Yes</dd></div>
                                    <div><dt>Captured on</dt><dd class="e2e-mono" data-testid="e2e-step-captured-@i">@e.PageRoute</dd></div>
                                }
                            </dl>
                            @if (step.Selector is { } selected && target.Strategy.Length > 0)
                            {
                                var stability = CompanionSelectorQuality.Stability(selected);
                                <p class="e2e-help" data-testid="e2e-step-stability-@i">Selector stability: <strong>@CompanionSelectorQuality.Label(stability)</strong></p>
                                @if (CompanionSelectorQuality.Warning(selected) is { } warning)
                                {
                                    <p class="e2e-fragile" data-testid="e2e-step-fragile-@i">@warning</p>
                                    <label class="e2e-editor-check">
                                        <input type="checkbox" data-testid="e2e-step-reviewed-@i" checked="@step.SelectorReviewed" @onchange="e => Replace(i, step with { SelectorReviewed = (bool)e.Value! })" />
                                        Reviewed: no stronger unique selector exists (required before release use)
                                    </label>
                                }
                            }
                            <button type="button" class="btn-secondary e2e-pick" data-testid="e2e-step-pick-@i" @ref="_pickButtons[step.StepId]"
                                    disabled="@(!PickReady || _picking is not null)"
                                    aria-describedby="@(PickReady ? null : "e2e-pick-unavailable")"
                                    @onclick="() => PickAsync(i)">
                                @(_picking == step.StepId ? "Waiting for selection in the browser…" : target.Strategy.Length > 0 ? "Change selection" : "Select from browser")
                            </button>
                        </div>
                        @if (_picking == step.StepId)
                        {
                            <p class="e2e-pick-note" role="status" data-testid="e2e-step-pick-selecting-@i">Selecting: click the element in the application page. Esc cancels.</p>
                        }
                        @if (pick is { } p && p.Outcome != CriticalE2EPickOutcome.Picked || pick?.Element is { Recommended: null })
                        {
                            <p class="e2e-pick-note e2e-pick-note-problem" role="alert" data-testid="e2e-step-pick-note-@i">
                                @PickProblem(pick!)
                                @if (pick!.Outcome is CriticalE2EPickOutcome.Blocked or CriticalE2EPickOutcome.Unsupported)
                                {
                                    <a class="e2e-link" href="@SetupHref">Open Browser Companion setup</a>
                                }
                            </p>
                        }
                        else if (pick?.Element is { } element)
                        {
                            <p class="e2e-pick-note" role="status" data-testid="e2e-step-pick-note-@i">
                                Selected @CriticalE2EPresentation.Identity(element).@(!element.Visible ? " It is currently hidden." : !element.Enabled ? " It is currently disabled." : "")
                            </p>
                        }
                        <ReviewDisclosure Text="Selector details" CollapseText="Hide selector details" TestId="@($"e2e-step-selector-details-{i}")" Class="disclosure-inline disclosure-small">
                            <div class="e2e-step-fields">
                                <label>Strategy
                                    <select data-testid="e2e-step-selector-kind-@i" value="@(step.Selector?.Kind ?? CompanionSelectorKind.TestId)"
                                            @onchange="e => Replace(i, step with { Selector = (step.Selector ?? new CompanionSelector()) with { Kind = Enum.Parse<CompanionSelectorKind>(e.Value!.ToString()!) } })">
                                        @foreach (var kind in Enum.GetValues<CompanionSelectorKind>())
                                        {
                                            <option value="@kind">@CriticalE2EPresentation.StrategyLabel(kind)</option>
                                        }
                                    </select>
                                </label>
                                @if (step.Selector?.Kind == CompanionSelectorKind.Role)
                                {
                                    @* A role selector is a role AND an accessible name; a single box could only ever hold one. *@
                                    <label>Role <input data-testid="e2e-step-selector-role-@i" aria-label="@($"Step {i + 1} role")" placeholder="button" value="@(step.Selector?.Role ?? "")"
                                           @onchange="e => Replace(i, step with { Selector = step.Selector! with { Role = e.Value?.ToString() } })" /></label>
                                    <label>Name <input data-testid="e2e-step-selector-name-@i" aria-label="@($"Step {i + 1} accessible name")" placeholder="accessible name" value="@(step.Selector?.Name ?? "")"
                                           @onchange="e => Replace(i, step with { Selector = step.Selector! with { Name = e.Value?.ToString() } })" /></label>
                                }
                                else
                                {
                                    <label>Value <input data-testid="e2e-step-selector-@i" aria-label="@($"Step {i + 1} selector")" value="@(step.Selector?.Value ?? "")"
                                           @onchange="e => Replace(i, step with { Selector = (step.Selector ?? new CompanionSelector()) with { Value = e.Value?.ToString() ?? string.Empty } })" /></label>
                                }
                            </div>
                            @if (pick?.Element is { } described)
                            {
                                <table class="e2e-candidates" data-testid="e2e-step-candidates-@i">
                                    <caption>Candidates found on @described.PageRoute</caption>
                                    <thead><tr><th scope="col">Strategy</th><th scope="col">Selector</th><th scope="col">Matches</th></tr></thead>
                                    <tbody>
                                        @foreach (var c in described.Candidates)
                                        {
                                            <tr><td>@CriticalE2EPresentation.StrategyLabel(c.Selector.Kind)</td><td>@c.Selector.Describe()</td><td>@c.MatchCount@(c.Unique ? " (unique)" : "")</td></tr>
                                        }
                                    </tbody>
                                </table>
                                <p class="e2e-help" data-testid="e2e-step-route-note-@i">Captured on @CriticalE2ERoutes.Normalize(described.PageRoute). The page the step runs on is stored with the step and enforced when the flow runs.</p>
                            }
                        </ReviewDisclosure>
                    }
                    @if (step.BrowserAction is not CompanionActionKind.Navigate)
                    {
                        @* Captured page, execution page and expected destination are three facts. A destination is never inferred. *@
                        <div class="e2e-step-fields" data-testid="e2e-step-page-@i">
                            @if (step.CapturedOnRoute is { Length: > 0 } captured)
                            {
                                <p class="e2e-help" data-testid="e2e-step-captured-on-@i">Captured on <span class="e2e-mono">@captured</span></p>
                            }
                            <label>Runs on page <input data-testid="e2e-step-execution-route-@i" value="@(step.ExecutionRoute ?? "")" placeholder="/admin/emergency-access"
                                   @onchange="e => Replace(i, step with { ExecutionRoute = Blank(e.Value?.ToString()) })" /></label>
                            @if (!CriticalE2EAuthoring.IsAssertion(step.BrowserAction))
                            {
                                <label>Expected destination <input data-testid="e2e-step-destination-@i" value="@(step.ExpectedDestination ?? "")" placeholder="optional, e.g. /admin/general-roles"
                                       @onchange="e => Replace(i, step with { ExpectedDestination = Blank(e.Value?.ToString()) })" /></label>
                            }
                        </div>
                        @if (_suggestedDestination.TryGetValue(step.StepId, out var proposal) && proposal != step.ExpectedDestination)
                        {
                            <p class="e2e-help" data-testid="e2e-step-destination-suggestion-@i">Suggested destination <span class="e2e-mono">@proposal</span> (from the link target).
                                <button type="button" class="btn-link" data-testid="e2e-step-destination-use-@i" @onclick="() => Replace(i, step with { ExpectedDestination = proposal })">Use</button></p>
                        }
                    }
                    @if (NeedsValue(step))
                    {
                        <div class="e2e-step-fields">
                            <label>Value <input data-testid="e2e-step-value-@i" value="@(step.Value ?? "")" placeholder="Synthetic test value"
                                   @onchange="e => Replace(i, step with { Value = e.Value?.ToString() })" /></label>
                        </div>
                    }
                    @if (NeedsExpected(step))
                    {
                        <div class="e2e-step-fields">
                            <label>@(step.BrowserAction is CompanionActionKind.AssertRoute or CompanionActionKind.WaitForRoute ? "Expected route" : "Expected")
                                <input data-testid="e2e-step-expected-@i" value="@(step.Expected ?? "")"
                                       @onchange="e => Replace(i, step with { Expected = e.Value?.ToString() })" /></label>
                        </div>
                    }
                }
                @if (CriticalE2EAuthoring.IsAssertion(step.BrowserAction) || step.IsIntegrationStep && step.Expect is not null)
                {
                    <label class="e2e-editor-check e2e-step-final">
                        <input type="checkbox" data-testid="e2e-step-final-@i" checked="@step.IsFinalAssertion"
                               @onchange="e => Replace(i, step with { IsFinalAssertion = (bool)e.Value! })" /> This assertion is the final business outcome
                    </label>
                }
                else if (step.IsFinalAssertion)
                {
                    @* The old boolean is kept as legacy metadata; it never proves anything on its own. *@
                    <p class="e2e-fragile e2e-step-final" data-testid="e2e-step-legacy-final-@i">Legacy assertion marker · concrete outcome required
                        <button type="button" class="btn-link" data-testid="e2e-step-legacy-clear-@i" @onclick="() => Replace(i, step with { IsFinalAssertion = false })">Remove marker</button></p>
                }
            </li>
        }
    </ol>
    <div class="e2e-drop-end @(_dragged is not null && _dropBefore == "" ? "e2e-drop-target" : "")" data-testid="e2e-drop-end"
         ondragover="event.preventDefault()" @ondragenter='() => _dropBefore = ""' @ondrop='() => DropBefore("")'>@(_dragged is not null ? "Drop here to move to the end" : "")</div>
    <p class="e2e-order-status" role="status" aria-live="polite" data-testid="e2e-order-status">@_orderStatus</p>
    <button type="button" class="btn-secondary" data-testid="e2e-step-add" @ref="_addButton" disabled="@(_picking is not null)" @onclick="AddStep">Add step</button>

    @* The final business outcome: what must be true. "The last click succeeded" is not one. *@
    <fieldset class="e2e-fieldset e2e-outcome" data-testid="e2e-editor-outcome">
        <legend>Final business outcome</legend>
        @if (CriticalE2EReleaseRules.LegacyAssertionMarker(Definition))
        {
            <p class="e2e-fragile" role="status" data-testid="e2e-editor-outcome-legacy">Legacy assertion marker · concrete outcome required</p>
        }
        <div class="e2e-step-fields">
            <label>Outcome
                <select data-testid="e2e-editor-outcome-kind" value="@(_draft.FinalOutcome?.Kind.ToString() ?? "")" @onchange="OutcomeKindChanged">
                    <option value="">None defined</option>
                    @foreach (var kind in Enum.GetValues<CriticalE2EOutcomeKind>())
                    {
                        <option value="@kind">@CriticalE2EPresentation.OutcomeKindLabel(kind)</option>
                    }
                </select>
            </label>
            @if (_draft.FinalOutcome is { } outcome)
            {
                @if (CriticalE2EPresentation.OutcomeNeedsExpected(outcome.Kind))
                {
                    <label>@(outcome.Kind is CriticalE2EOutcomeKind.UrlEquals or CriticalE2EOutcomeKind.UrlContains ? "Expected path" : "Expected text or value")
                        <input data-testid="e2e-editor-outcome-expected" value="@(outcome.Expected ?? "")" @onchange="e => _draft.FinalOutcome = outcome with { Expected = Blank(e.Value?.ToString()) }" /></label>
                }
                @if (CriticalE2EPresentation.OutcomeNeedsElement(outcome.Kind) || outcome.Kind == CriticalE2EOutcomeKind.SuccessMessageVisible)
                {
                    <label>Element role <input data-testid="e2e-editor-outcome-role" value="@(outcome.Selector?.Role ?? "")" placeholder="status"
                           @onchange="e => _draft.FinalOutcome = outcome with { Selector = (outcome.Selector ?? new CompanionSelector { Kind = CompanionSelectorKind.Role }) with { Kind = CompanionSelectorKind.Role, Role = Blank(e.Value?.ToString()) } }" /></label>
                    <label>Accessible name <input data-testid="e2e-editor-outcome-name" value="@(outcome.Selector?.Name ?? "")"
                           @onchange="e => _draft.FinalOutcome = outcome with { Selector = (outcome.Selector ?? new CompanionSelector { Kind = CompanionSelectorKind.Role }) with { Kind = CompanionSelectorKind.Role, Name = Blank(e.Value?.ToString()) } }" /></label>
                }
                @if (outcome.Kind == CriticalE2EOutcomeKind.ProviderVerified)
                {
                    <label>Verification provider <input data-testid="e2e-editor-outcome-provider" value="@(outcome.ProviderId ?? "")"
                           @onchange="e => _draft.FinalOutcome = outcome with { ProviderId = Blank(e.Value?.ToString()) }" /></label>
                    <p class="e2e-help">Without an approved verification provider the run is Inconclusive, never Passed.</p>
                }
            }
        </div>
        <p class="e2e-help" data-testid="e2e-editor-outcome-text">@CriticalE2EReleaseRules.OutcomeText(Definition)</p>
        @if (_draft.FinalOutcome is null && SuggestedOutcome is { } suggestion)
        {
            <p class="e2e-help" data-testid="e2e-editor-outcome-suggestion">Suggested: @CriticalE2EReleaseRules.Describe(suggestion)
                <button type="button" class="btn-link" data-testid="e2e-editor-outcome-use" @onclick="() => _draft.FinalOutcome = suggestion">Use</button></p>
        }
    </fieldset>

    @if (_draft.Kind == CriticalE2EFlowKind.Critical && _draft.RequiredForRelease)
    {
        var readiness = Readiness;
        <section class="e2e-editor-readiness" data-testid="e2e-editor-readiness" aria-label="Release readiness">
            <p><strong data-testid="e2e-editor-readiness-summary">@readiness.Summary</strong></p>
            @if (readiness.Blockers.Count > 0)
            {
                <ul data-testid="e2e-editor-readiness-blockers">
                    @foreach (var blocker in readiness.Blockers)
                    {
                        <li data-key="@blocker.Key">@blocker.Text</li>
                    }
                </ul>
            }
            <p class="e2e-help">A build identity is needed as well before a run counts as release evidence.</p>
        </section>
    }

    @* Say it before the run does. A flow with no final assertion can never pass, and finding that out at run time wastes
       a signed-in browser session. *@
    @if (Problem is { Length: > 0 } problem)
    {
        <p class="e2e-editor-problem" role="status" data-testid="e2e-editor-problem">@problem</p>
    }

    <div class="e2e-editor-actions">
        <button type="button" class="btn-primary" data-testid="e2e-editor-save" disabled="@(Problem is not null)" @onclick="Save">Save flow</button>
        <button type="button" class="btn-secondary" data-testid="e2e-editor-cancel" @onclick="OnCancel">Cancel</button>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public CriticalE2EFlowDefinition Flow { get; set; } = new();
    [Parameter] public string EnvironmentId { get; set; } = "";
    [Parameter] public string ProfileId { get; set; } = "";
    [Parameter] public EventCallback<CriticalE2EFlowDefinition> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public string? EnvironmentType { get; set; }
    /// <summary>Whether "Select from browser" can be used now (from the overview). The pick itself re-checks everything.</summary>
    [Parameter] public CriticalE2EEngineStatus? ElementPick { get; set; }
    [Parameter] public EventCallback OnCheckElementPick { get; set; }
    /// <summary>Where Browser Companion is set up: the Target Environment, never this page.</summary>
    [Parameter] public string SetupHref { get; set; } = "/admin/system-settings?section=target-environments&tab=browser";
    /// <summary>Registered delivery modules: the module choices. Anything else is a manual label.</summary>
    [Parameter] public IReadOnlyList<string> RegisteredModules { get; set; } = [];
    /// <summary>Central Test Data summaries (no values): what the flow can reference.</summary>
    [Parameter] public IReadOnlyList<TestDataAssetSummary> TestDataAssets { get; set; } = [];
    /// <summary>The environment's Integration Topology, for boundary proposals. Null when none is available.</summary>
    [Parameter] public BirkNext.IntegrationTopology.IntegrationTopologyView? Topology { get; set; }
    [Parameter] public string? EnvironmentName { get; set; }

    private const string ManualChoice = "__manual";
    private bool _manualModule;
    private bool _showUnapproved;
    private readonly Dictionary<string, string> _suggestedDestination = [];

    private CriticalE2EFlowDefinition Definition => _draft.ToDefinition(ProfileId, EnvironmentId);
    private bool ModuleUnresolved => _draft.Module.Trim().Length > 0 && !RegisteredModules.Contains(_draft.Module.Trim(), StringComparer.OrdinalIgnoreCase);
    private string ModuleChoice => _manualModule ? ManualChoice : RegisteredModules.FirstOrDefault(m => string.Equals(m, _draft.Module.Trim(), StringComparison.OrdinalIgnoreCase)) ?? _draft.Module;
    private string ModuleHelp => _draft.Module.Trim().Length == 0
        ? RegisteredModules.Count == 0 ? "No registered delivery modules. Register modules under Module coverage." : "Unassigned · never counts toward release coverage"
        : ModuleUnresolved ? $"Unresolved module · {CriticalE2EPresentation.ManualModuleNote}" : "Registered delivery module";
    private IReadOnlyList<string> TestDataIssues => CriticalE2EPresentation.TestDataIssues(Definition, _draft.Placeholders(), TestDataAssets);
    private CriticalE2EFlowReadiness Readiness => CriticalE2EReleaseRules.Evaluate(Definition, RegisteredModules, TestDataIssues);
    private string TestDataStatus => Readiness.TestDataStatus;
    private string DetailsHint => $"Boundary {(Definition.Boundary is { Explicit: true } ? "explicit" : "not explicit")} · Test Data {TestDataStatus.ToLowerInvariant()}";
    private string TestDataHref => $"/test-data?consumer={CriticalE2ETestDataConsumer}";
    private const string CriticalE2ETestDataConsumer = "critical-e2e";

    /// <summary>A proposal only: the last action's own expected destination becomes "page is loaded".</summary>
    private CriticalE2EFinalOutcome? SuggestedOutcome => _draft.Steps.LastOrDefault(s => s.ExpectedDestination is { Length: > 0 }) is { } last
        ? new CriticalE2EFinalOutcome { Kind = CriticalE2EOutcomeKind.UrlEquals, Expected = last.ExpectedDestination } : null;

    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static List<string> AliasList(string? alias) => string.IsNullOrWhiteSpace(alias) ? [] : [alias];

    private void ModuleChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? "";
        _manualModule = value == ManualChoice;
        if (!_manualModule) _draft.Module = value;
    }

    private void OutcomeKindChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        _draft.FinalOutcome = string.IsNullOrEmpty(value) ? null : (_draft.FinalOutcome ?? new CriticalE2EFinalOutcome()) with { Kind = Enum.Parse<CriticalE2EOutcomeKind>(value) };
    }

    private void EditBoundary(Action change)
    {
        change();
        _draft.BoundaryEdited();
    }

    private static string Text(ChangeEventArgs e) => e.Value?.ToString() ?? "";
    private void BoundaryStartChanged(ChangeEventArgs e) => EditBoundary(() => _draft.BoundaryStart = Text(e));
    private void BoundaryEndChanged(ChangeEventArgs e) => EditBoundary(() => _draft.BoundaryEnd = Text(e));
    private void BoundaryDownstreamChanged(ChangeEventArgs e) => EditBoundary(() => _draft.BoundaryDownstream = Text(e));
    private void BoundaryCoversChanged(ChangeEventArgs e) => EditBoundary(() => _draft.BoundaryCoversDownstream = e.Value is true);

    private void SuggestBoundary() => _draft.ApplyBoundary(CriticalE2EBoundarySuggestion.For(_draft.Mode, Topology));

    private void ToggleAsset(string alias, bool used)
    {
        _draft.TestDataAliases.Remove(alias);
        if (used) _draft.TestDataAliases.Add(alias);
    }

    private void MapVariable(string variable, IReadOnlyList<string> aliases, TestDataDataType type)
    {
        // A type change keeps an alias only if it still fits.
        var fitting = aliases.Where(a => TestDataAssets.FirstOrDefault(x => x.Alias == a) is { } asset && TestDataDataTypes.Of(asset) == type).ToList();
        _draft.Map(variable, fitting, type, _draft.Steps.Any(s => s.ExecutionRoute?.Contains("${data:" + variable + "}") == true || s.ExpectedDestination?.Contains("${data:" + variable + "}") == true) ? "route parameter"
            : _draft.FinalOutcome?.Expected?.Contains("${data:" + variable + "}") == true ? "expected result" : "step value");
    }

    private CriticalE2EFlowDraft _draft = new();
    private CriticalE2EFlowDefinition? _source;
    private string? _picking;
    private string? _focusAfterPick;
    private readonly Dictionary<string, CriticalE2EElementPickResult> _picks = [];
    private readonly Dictionary<string, ElementReference> _pickButtons = [];
    private readonly Dictionary<string, ElementReference> _actionFields = [];
    private readonly Dictionary<string, ElementReference> _upButtons = [];
    private readonly Dictionary<string, ElementReference> _downButtons = [];
    private string? _focusStep;
    private string _focusControl = "action";
    private ElementReference _addButton;
    private string? _dragged;
    private string? _dropBefore;
    private string _orderStatus = "";
    private ElementReference _heading;

    /// <summary>
    /// The draft is rebuilt only when a different flow is handed in. Rebuilding on every parameter set threw away the
    /// author's unsaved edits whenever the page re-rendered — for example after checking the companion again.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_source, Flow)) return;
        _source = Flow;
        _draft = CriticalE2EFlowDraft.From(Flow);
        _picks.Clear();
        _pickButtons.Clear();
        _actionFields.Clear();
        _upButtons.Clear();
        _downButtons.Clear();
        _focusAfterPick = null;
        _focusStep = null;
        _orderStatus = "";
        EndDrag();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusStep is { } id)
        {
            _focusStep = null;
            var controls = _focusControl == "up" ? _upButtons : _focusControl == "down" ? _downButtons : _actionFields;
            var control = controls.GetValueOrDefault(id, _addButton);
            try { await control.FocusAsync(); } catch (InvalidOperationException) { /* prerender */ }
        }
        // Opening the editor moves focus to its heading, so a keyboard user lands in it rather than on the page's list.
        if (firstRender)
        {
            try { await _heading.FocusAsync(); } catch (InvalidOperationException) { /* not rendered (e.g. prerender) */ }
        }
        // Focus goes back to the control that started the pick, so a keyboard user continues where they were.
        if (_focusAfterPick is { } index && _pickButtons.TryGetValue(index, out var button))
        {
            _focusAfterPick = null;
            try { await button.FocusAsync(); } catch (InvalidOperationException) { /* not rendered (e.g. prerender) */ }
        }
    }

    private bool PickReady => ElementPick?.State == CriticalE2EEngineState.Ready;

    private static bool TargetsElement(CriticalE2EStepDefinition step) => step.BrowserAction is { } action
        && action is not (CompanionActionKind.Navigate or CompanionActionKind.AssertRoute or CompanionActionKind.WaitForRoute or CompanionActionKind.PickElement);

    private static bool NeedsValue(CriticalE2EStepDefinition step) => step.BrowserAction is CompanionActionKind.Fill or CompanionActionKind.Select;

    private static bool NeedsExpected(CriticalE2EStepDefinition step) => step.BrowserAction is CompanionActionKind.WaitForText or CompanionActionKind.WaitForRoute
        or CompanionActionKind.AssertText or CompanionActionKind.AssertValue or CompanionActionKind.AssertRoute;

    private static string StepActionLabel(CriticalE2EStepDefinition step) =>
        step.BrowserAction is { } browser ? ActionLabel(browser) : step.IntegrationAction?.ToString() ?? "Step";

    private static string ActionLabel(CompanionActionKind action) => action switch
    {
        CompanionActionKind.WaitForVisible => "Wait for visible",
        CompanionActionKind.WaitForText => "Wait for text",
        CompanionActionKind.WaitForRoute => "Wait for route",
        CompanionActionKind.AssertVisible => "Assert visible",
        CompanionActionKind.AssertHidden => "Assert hidden",
        CompanionActionKind.AssertText => "Assert text",
        CompanionActionKind.AssertValue => "Assert value",
        CompanionActionKind.AssertRoute => "Assert route",
        CompanionActionKind.ReadValue => "Read value",
        _ => action.ToString(),
    };

    /// <summary>Why a pick did not produce a selector. Each outcome keeps its own words; none of them is "failed".</summary>
    private static string PickProblem(CriticalE2EElementPickResult pick) => pick switch
    {
        { Outcome: CriticalE2EPickOutcome.Picked, Element: { } element } => $"Cannot use this selector. {CriticalE2EPresentation.NoSelectorReason(element)}",
        { Outcome: CriticalE2EPickOutcome.Cancelled } => "Selection cancelled. Nothing was changed.",
        { Outcome: CriticalE2EPickOutcome.TimedOut } => "No element was selected in time. Nothing was changed.",
        { Outcome: CriticalE2EPickOutcome.Unsupported } => pick.Message,
        { Outcome: CriticalE2EPickOutcome.Failed } => $"Element picking failed: {pick.Message}",
        _ => pick.Message,
    };

    /// <summary>
    /// Asks the paired companion to let the tester click the element in the application, then stores the strongest
    /// selector that identified it uniquely. Nothing is stored when no selector is unique: guessing is how a step ends up
    /// driving the wrong control.
    /// </summary>
    private async Task PickAsync(int index)
    {
        if (_picking is not null) return;
        var id = _draft.Steps[index].StepId;
        var draft = _draft;
        _picking = id;
        _picks.Remove(id);
        try
        {
            var result = await Api.PickElementAsync(new CriticalE2EElementPickRequest
            {
                ProfileId = ProfileId, EnvironmentId = EnvironmentId, EnvironmentType = EnvironmentType,
            });
            if (!ReferenceEquals(draft, _draft)) return;
            index = _draft.Steps.FindIndex(s => s.StepId == id);
            if (index < 0) return;
            if (result is { Status: CriticalE2EStatus.Passed, Element: { Recommended: { } recommended } element })
            {
                // The pick proposes; the author edits. The action and name follow the element, the page it was picked on is
                // recorded, and a link's own target is offered as the destination — never applied silently.
                var current = _draft.Steps[index];
                var action = current.BrowserAction is CompanionActionKind.Click or null && !CriticalE2EAuthoring.IsAssertion(current.BrowserAction) ? CriticalE2EAuthoring.SuggestAction(element) : current.BrowserAction!.Value;
                var captured = CriticalE2ERoutes.Normalize(element.PageRoute);
                _draft.Steps[index] = current with
                {
                    Selector = recommended,
                    BrowserAction = action,
                    Description = string.IsNullOrWhiteSpace(current.Description) ? CriticalE2EAuthoring.SuggestName(action, element) : current.Description,
                    CapturedOnRoute = captured.Length > 0 ? captured : null,
                    ExecutionRoute = current.ExecutionRoute ?? (captured.Length > 0 ? captured : null),
                    SelectorReviewed = false,
                };
                if (CriticalE2EAuthoring.SuggestDestination(element) is { } destination) _suggestedDestination[id] = destination;
                else _suggestedDestination.Remove(id);
            }
            _picks[id] = result;
        }
        catch (Exception ex)
        {
            if (ReferenceEquals(draft, _draft)) _picks[id] = new CriticalE2EElementPickResult { Outcome = CriticalE2EPickOutcome.Failed, Message = BackendRequestClassifier.FromException("Element picking", ex, "POST api/critical-e2e/pick-element").Detail };
        }
        finally
        {
            _picking = null;
            if (ReferenceEquals(draft, _draft)) _focusAfterPick = id;
        }
    }

    private void ActionChanged(int index, CompanionActionKind action)
    {
        var step = _draft.Steps[index];
        // A route step carries no element; an element step starts from an empty target rather than a stale one.
        _draft.Steps[index] = step with
        {
            BrowserAction = action,
            Selector = action is CompanionActionKind.Navigate or CompanionActionKind.AssertRoute or CompanionActionKind.WaitForRoute ? null : step.Selector ?? new CompanionSelector(),
        };
    }

    private void RemoveStep(string id)
    {
        if (_picking is not null) return;
        var index = _draft.Steps.FindIndex(s => s.StepId == id);
        if (index < 0) return;
        _draft.Steps.RemoveAt(index);
        _picks.Remove(id);
        _actionFields.Remove(id);
        _upButtons.Remove(id);
        _downButtons.Remove(id);
        _pickButtons.Remove(id);
        _focusStep = _draft.Steps.Count == 0 ? "" : _draft.Steps[Math.Min(index, _draft.Steps.Count - 1)].StepId;
        _focusControl = "action";
        _orderStatus = $"Step {index + 1} removed. {_draft.Steps.Count} steps.";
    }

    /// <summary>The same rule the backend applies, so the editor refuses what a run would refuse.</summary>
    private string? Problem => _draft.Problem(ProfileId, EnvironmentId);

    private void ModeChanged(ChangeEventArgs e)
    {
        if (_picking is not null) return;
        var mode = Enum.Parse<CriticalE2EExecutionMode>(e.Value!.ToString()!);
        // Steps do not survive a mode change: a browser step and an integration step share no fields, and silently
        // keeping half-populated rows is how a flow ends up unrunnable for reasons nobody can see.
        _draft.Mode = mode;
        _draft.Steps = [];
        _picks.Clear();
    }

    private void Replace(int index, CriticalE2EStepDefinition step) => _draft.Steps[index] = step;

    private void AddStep() => InsertStep(_draft.Steps.Count);

    private void InsertStep(int index)
    {
        if (_picking is not null) return;
        _focusStep = _draft.InsertStep(index).StepId;
        _focusControl = "action";
        _orderStatus = $"Step {index + 1} inserted. Choose its action.";
    }

    private void MoveStep(string id, int destination, bool? up = null)
    {
        if (_picking is not null || !_draft.MoveStep(id, destination)) return;
        _focusStep = id;
        // At a boundary the initiating button becomes disabled; use the opposite move control on the same card.
        _focusControl = up == true ? (destination == 0 ? "down" : "up")
            : up == false ? (destination == _draft.Steps.Count - 1 ? "up" : "down") : "action";
        _orderStatus = $"{StepActionLabel(_draft.Steps[destination])} moved to step {destination + 1} of {_draft.Steps.Count}.";
    }

    private void StartDrag(string id)
    {
        if (_picking is null) _dragged = id;
    }

    private void EndDrag() { _dragged = null; _dropBefore = null; }

    private void DropBefore(string targetId)
    {
        if (_dragged is { } id && id != targetId)
        {
            var source = _draft.Steps.FindIndex(s => s.StepId == id);
            var target = targetId == "" ? _draft.Steps.Count : _draft.Steps.FindIndex(s => s.StepId == targetId);
            if (source >= 0 && target >= 0) MoveStep(id, target > source ? target - 1 : target);
        }
        EndDrag();
    }

    private Task Save() => OnSave.InvokeAsync(_draft.ToDefinition(ProfileId, EnvironmentId));
}
