@page "/release-readiness"
@using BirkNext.Governance
@using BirkNext.Interpretation
@using BirkNext.Web.Components
@using BirkNext.Web.Services.ProjectEvidence
@inject ICanonicalInterpretationApiService Api
@inject IFrontendAnalysisContextFactory ContextFactory
@inject IServiceProvider Services
@inject NavigationManager Nav

<PageTitle>Release Readiness</PageTitle>

@* The test lead's release assessment for a scope (release/1): one decision with reasons, separate dimensions, findings and next actions. The live
   assessment is a draft, recomputed on every change; a frozen assessment is opened by id and never falls back to the latest. A release decision
   (go/no-go) is a person's record beside a frozen assessment: it never changes it and never deploys anything. *@
<div class="rr" data-testid="release-readiness">
    <header class="rr-head">
        <h1>Release Readiness</h1>
        <p class="rr-lead" data-testid="rr-intro">Assess whether a release is ready based on requirements, traceability, test coverage, test execution, quality findings and unresolved risks.
            Review the evidence and outstanding actions before making a release decision.</p>
        <p class="rr-lead rr-small">Readiness is evidence-based. Completed task checkboxes do not prove implementation, successful testing or approval for deployment.</p>
        @if (_scope is not null)
        {
            <p class="rr-muted rr-context" data-testid="rr-context">Target Application: <strong data-testid="rr-application">@(_applicationName ?? "not set")</strong>
                · Environment: <span data-testid="rr-environment">@_environmentName</span>
                @if (ReportId is null) { <span> · Scope: <span data-testid="rr-scope-label">@ScopeLabel()</span></span> }</p>
        }
    </header>

    @if (_initialising)
    {
        <InlineLoading Text="Loading the active project…" Class="rr-muted" />
    }
    else if (_scope is null)
    {
        <p class="rr-muted" data-testid="rr-no-scope">Select a Target Environment first. Release readiness is always assessed for one application in one environment.</p>
    }
    else if (ReportId is not null)
    {
        <p><a href="release-readiness?tab=history" data-testid="rr-back">← Release Readiness</a></p>
        @if (_reportError is not null) { <p class="rr-error" role="alert" data-testid="rr-report-error">@_reportError</p> }
        else if (_report is null) { <InlineLoading Text="Loading the frozen assessment…" Class="rr-muted" /> }
        else
        {
            <section class="rr-card" aria-labelledby="rr-report-h" data-testid="rr-report">
                <h2 id="rr-report-h">@_report.Name <span class="rr-badge" data-testid="rr-report-kind">@(Incomplete(_report.Assessment.Decision) ? "Frozen assessment · incomplete" : "Frozen assessment")</span></h2>
                <p class="rr-muted" data-testid="rr-report-frozen">Frozen @_report.FrozenAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC · scope @Scope(_report.Assessment.ScopeReference)
                    · rules @_report.Assessment.RuleSetVersion, @_report.Assessment.PolicySetVersion
                    @if (_report.Assessment.ScopeReference.InterpretationId is { } i) { <span> · relationship analysis @i.ToString("D")[..8]</span> }
                    · this assessment never changes.</p>
            </section>
            @Summary(_report.Assessment)
            @Dimensions(_report.Assessment)
            <section class="rr-card" aria-labelledby="rr-signoff-h" data-testid="rr-signoff">
                <h2 id="rr-signoff-h">Release decision</h2>
                <p class="rr-muted">A release decision records a person's go/no-go about this frozen assessment. It never changes the assessment's evidence or computed result,
                    and it does not deploy anything.</p>
                @if (_report.SignOffs.Count > 0)
                {
                    <ul class="rr-list">
                        @foreach (var s in _report.SignOffs)
                        {
                            <li data-testid="rr-signoff-entry"><strong>@OutcomeLabel(s.Outcome)</strong> by @s.By · @s.At.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC@(s.Note is null ? "" : $" — {s.Note}")</li>
                        }
                    </ul>
                }
                <div class="rr-form">
                    <label>Decision
                        <select @bind="_signOutcome" data-testid="rr-signoff-outcome">
                            @foreach (var o in Enum.GetValues<SignOffOutcome>()) { <option value="@o">@OutcomeLabel(o)</option> }
                        </select>
                    </label>
                    <label class="rr-grow">Note (required unless accepting a plain Ready assessment)
                        <input class="form-control" @bind="_signNote" data-testid="rr-signoff-note" placeholder="Accepted risk, limitation or reason" />
                    </label>
                    <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="SignOffAsync" data-testid="rr-signoff-submit">Record decision</button>
                </div>
                @if (_signError is not null) { <p class="rr-error" role="alert" data-testid="rr-signoff-error">@_signError</p> }
            </section>
        }
    }
    else
    {
        <div class="rr-tabs" role="tablist" aria-label="Release Readiness">
            @foreach (var (key, label) in Tabs)
            {
                <button type="button" role="tab" id="@($"rr-tab-{key}")" class="rr-tab @(_tab == key ? "is-active" : "")" aria-selected="@(_tab == key ? "true" : "false")"
                        aria-controls="rr-tabpanel" data-testid="@($"rr-tab-{key}")" @onclick="() => _tab = key">@label</button>
            }
        </div>
        <div id="rr-tabpanel" role="tabpanel" aria-labelledby="@($"rr-tab-{_tab}")" class="rr-panel">
            @if (_error is not null) { <p class="rr-error" role="alert" data-testid="rr-error">@_error</p> }
            else if (_assessment is null) { <InlineLoading Text="Assessing the release scope…" Class="rr-muted" /> }
            else if (_tab == "scope") { @ScopeSection(_assessment) }
            else if (_tab == "findings") { @FindingsSection(_assessment) }
            else if (_tab == "history") { @HistorySection(_assessment) }
            else
            {
                @if (!Prepared(_assessment))
                {
                    <section class="rr-card rr-decision rr-notassessed" aria-labelledby="rr-decision-h" data-testid="rr-decision" data-decision="@_assessment.Decision">
                        <h2 id="rr-decision-h"><span class="rr-icon" aria-hidden="true">?</span> Release Readiness — Not assessed</h2>
                        <p data-testid="rr-reason">Required relationship evidence has not been prepared.</p>
                        <p class="rr-muted rr-small">Readiness reads requirements, tests and findings from the project's relationship analysis. Analyze the project's relationships first;
                            nothing is assessed (and nothing counts as zero) until then.</p>
                        <div class="rr-actions">
                            <a class="btn btn-primary" href="correlation-review" data-testid="rr-analyze">Analyze relationships</a>
                            <button type="button" class="btn btn-secondary" data-testid="rr-prerequisites" @onclick="@(() => _tab = "scope")">View missing prerequisites</button>
                        </div>
                    </section>
                }
                else
                {
                    @Summary(_assessment)
                }
                @Dimensions(_assessment)
            }
        </div>
    }
</div>

@code {
    private static readonly (string Key, string Label)[] Tabs = [("overview", "Overview"), ("scope", "Scope & Evidence"), ("findings", "Findings"), ("history", "Reports & History")];

    [SupplyParameterFromQuery(Name = "report")] public Guid? ReportId { get; set; }
    /// <summary>Opens a tab directly (?tab=scope|findings|history).</summary>
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    private bool _initialising = true, _busy, _selectModules;
    private string _tab = "overview";
    private string? _scope, _applicationName, _environmentName, _error, _freezeError, _reportError, _signError, _name, _signNote, _moduleFilter;
    private SignOffOutcome _signOutcome = SignOffOutcome.Accepted;
    private List<string> _modules = [];
    private readonly SortedSet<string> _selected = new(StringComparer.OrdinalIgnoreCase);
    private ReleaseReadinessAssessment? _assessment;
    private ReleaseReadinessReport? _report;
    private IReadOnlyList<ReleaseReadinessReportSummary> _reports = [];
    private Guid? _loadedReport;
    private int _findingsVersion;

    protected override async Task OnInitializedAsync()
    {
        var profile = (await ContextFactory.GetActiveContextAsync()).ActiveProfileOrNull;
        _scope = CorrelationPresentation.Scope(profile?.Id);
        // The context's profile is a data-minimized copy without the Target Application: read it from the saved profile (the canonical scope stays the
        // environment id; the application is what the release is about).
        var saved = profile is null ? null : Services.GetService<IFrontendAnalysisSettingsService>()?.Settings.Profiles.FirstOrDefault(p => p.Id == profile.Id);
        (_applicationName, _environmentName) = (TargetApplications.Of(saved)?.Name, profile?.Name);
        _initialising = false;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Tab is "scope" or "findings" or "history") _tab = Tab;
        if (_scope is null) return;
        if (ReportId is { } id)
        {
            if (_loadedReport == id) return;
            (_loadedReport, _report, _reportError) = (id, null, null);
            var (report, error) = await Api.ReleaseReportAsync(_scope, id);
            _report = report;
            _reportError = report is null ? error ?? "This report does not exist in this project." : null;
            return;
        }
        if (_loadedReport is null && _assessment is not null) return;
        _loadedReport = null;
        await Task.WhenAll(AssessAsync(), LoadReportsAsync());
    }

    private async Task ToggleAsync(string module, bool on)
    {
        if (on) _selected.Add(module); else _selected.Remove(module);
        await AssessAsync();
    }

    /// <summary>Entire project (no module filter) or the chosen modules. Switching back to the entire project clears the choice.</summary>
    private async Task ScopeModeAsync(bool selectModules)
    {
        _selectModules = selectModules;
        if (!selectModules && _selected.Count > 0) { _selected.Clear(); await AssessAsync(); }
    }

    private async Task AssessAsync()
    {
        if (_scope is null) return;
        (_assessment, _error) = (null, null);
        (_assessment, _error) = await Api.ReleaseReadinessAsync(_scope, [.. _selected], _name);
        if (_assessment is { AvailableModules.Count: > 0 } a) _modules = [.. a.AvailableModules];
        _findingsVersion++;
    }

    private async Task LoadReportsAsync()
    {
        if (_scope is null) return;
        _reports = (await Api.ReleaseReportsAsync(_scope)).Items;
    }

    private async Task FreezeAsync()
    {
        if (_scope is null || string.IsNullOrWhiteSpace(_name)) return;
        (_busy, _freezeError) = (true, null);
        var (report, error) = await Api.FreezeReleaseAsync(_scope, new(_name.Trim(), [.. _selected]));
        _busy = false;
        if (report is null) { _freezeError = error ?? "The assessment could not be frozen."; return; }
        Nav.NavigateTo($"release-readiness?report={report.Id}");
    }

    private async Task SignOffAsync()
    {
        if (_scope is null || _report is null) return;
        (_busy, _signError) = (true, null);
        var (report, error) = await Api.SignOffReleaseAsync(_scope, _report.Id, new(_signOutcome, _signNote));
        _busy = false;
        if (report is null) { _signError = error ?? "The release decision could not be recorded."; return; }
        (_report, _signNote) = (report, null);
    }

    /// <summary>A relationship analysis exists: without one nothing is assessed (the scope, requirements and tests are unknown).</summary>
    private static bool Prepared(ReleaseReadinessAssessment a) => a.ScopeReference.InterpretationId is not null;

    private static bool Incomplete(GateDecision d) => d == GateDecision.NotAssessed;

    private string ScopeLabel() => _selected.Count == 0 ? "Entire project" : string.Join(", ", _selected);

    /// <summary>The page a dimension links to, by its own name.</summary>
    private static string PageLabel(string href) => href.Split('?')[0] switch
    {
        "correlation-review" => "Relationship Review",
        "traceability" => "Traceability",
        "delivery-reporting" => "Functional Quality Scope",
        "specification-explorer" => "Specification Explorer",
        "api-quality-review" => "API Quality Review",
        "integration-quality-review" => "Integration Quality Review",
        "frontend-quality-review" => "Frontend Quality Review",
        "performance-test-review" => "Performance Test Review",
        "critical-e2e-regression" => "Critical E2E Regression",
        var other => other,
    };

    private static string Scope(ReleaseScopeReference s) => s.Modules.Count == 0 ? "entire project" : string.Join(", ", s.Modules);

    private static string OutcomeLabel(SignOffOutcome o) => o switch
    {
        SignOffOutcome.AcceptedWithRisk => "Accepted with risk",
        _ => o.ToString(),
    };

    private static string Icon(GateDecision d) => d switch
    {
        GateDecision.Ready => "✓",
        GateDecision.ReadyWithLimitations => "!",
        GateDecision.PassedWithException => "✓!",
        GateDecision.Blocked => "✕",
        _ => "?",
    };

    /// <summary>Imported TRX results in the workspace (reported as found, never as execution of the release scope).</summary>
    private ReleaseExecutionEvidence? Execution => Services.GetService(typeof(WorkspaceArtifactRepository)) is WorkspaceArtifactRepository repository
        ? ReleaseReadinessPresentation.Execution(repository.SddLifecycle?.TestExecutions, null) : null;

    /// <summary>A count, or "Not assessed" when it is unknown — never 0 for unknown.</summary>
    private static string Count(int? value) => value is { } v ? v.ToString() : "Not assessed";

    private RenderFragment Summary(ReleaseReadinessAssessment a) => __builder =>
    {
        var f = a.Facts;
        var missing = a.Dimensions.Count(d => d.Applicability != DimensionApplicability.NotApplicable && d.State == GateDecision.NotAssessed);
        <section class="rr-card rr-decision rr-@a.Decision.ToString().ToLowerInvariant()" aria-labelledby="rr-decision-h" data-testid="rr-decision" data-decision="@a.Decision">
            <h2 id="rr-decision-h"><span class="rr-icon" aria-hidden="true">@Icon(a.Decision)</span> @GovernancePolicies.DecisionLabel(a.Decision)</h2>
            <p data-testid="rr-reason">@a.Reason</p>
            @* Executive summary: what is in scope, what is assessed, tested and executed, and what blocks — each "Not assessed" when unknown. *@
            <ul class="rr-metrics" data-testid="rr-facts" aria-label="Release figures">
                @foreach (var m in ReleaseReadinessPresentation.Metrics(a, Execution))
                {
                    <li class="rr-metric is-@m.Tone" data-testid="rr-metric" data-key="@m.Key">
                        <span class="rr-metric-value" data-testid="@($"rr-fact-{m.Key}")">@m.Value</span>
                        <span class="rr-metric-label">@m.Label</span>
                        @if (m.Detail.Length > 0) { <span class="rr-metric-detail">@m.Detail</span> }
                    </li>
                }
            </ul>
            @{ var causes = ReleaseReadinessPresentation.BlockingCauses(a); var gaps = ReleaseReadinessPresentation.RequiredGaps(a); var steps = ReleaseReadinessPresentation.NextSteps(a); }
            @if (causes.Count > 0)
            {
                <h3 class="rr-sub">What blocks release?</h3>
                <ul class="rr-causes" data-testid="rr-blockers">
                    @foreach (var c in causes)
                    {
                        <li class="rr-cause" data-testid="rr-cause" data-key="@c.Key">
                            <strong>@c.Title</strong>
                            <span class="rr-small">@c.Detail</span>
                            <span class="rr-small rr-muted">Affects: @string.Join(" · ", c.Dimensions)</span>
                            <a href="@c.Href" class="rr-small" data-testid="rr-cause-link">@c.ActionLabel</a>
                        </li>
                    }
                </ul>
            }
            @if (gaps.Count > 0)
            {
                <h3 class="rr-sub">Required evidence not assessed</h3>
                <ul class="rr-list" data-testid="rr-gaps">@foreach (var g in gaps) { <li><strong>@g.Title</strong> — @g.Summary</li> }</ul>
            }
            @if (steps.Count > 0)
            {
                <h3 class="rr-sub">What should I do next?</h3>
                <ol class="rr-list" data-testid="rr-next">
                    @foreach (var (title, action, href) in steps)
                    {
                        <li><strong>@title:</strong> @action @if (href is not null) { <a href="@href" class="rr-small">Open</a> }</li>
                    }
                </ol>
            }
        </section>
    };

    /// <summary>Evidence dimensions grouped Required → Optional → Not applicable, worst state first, with a tally per group and a state legend.</summary>
    private RenderFragment Dimensions(ReleaseReadinessAssessment a) => __builder =>
    {
        <section class="rr-card" aria-labelledby="rr-dims-h" data-testid="rr-dimensions">
            <h2 id="rr-dims-h">Evidence dimensions</h2>
            <p class="rr-muted rr-small rr-legend" data-testid="rr-legend">
                <span class="rr-chip is-ready">✓ Ready</span> <span class="rr-chip is-limited">! Ready with limitations</span> <span class="rr-chip is-blocked">✕ Blocked</span>
                <span class="rr-chip is-notassessed">? Not assessed</span> — a required dimension that is Blocked blocks the release; one that is Not assessed keeps it Not assessed.</p>
            @foreach (var g in ReleaseReadinessPresentation.Groups(a))
            {
                <div class="rr-dim-group" data-testid="rr-dim-group" data-applicability="@g.Applicability">
                    <h3 class="rr-sub">@g.Title <span class="rr-muted rr-small" data-testid="rr-dim-tally">@g.Tally</span></h3>
                    <p class="rr-muted rr-small">@g.Explanation</p>
                    <ul class="rr-dim-list">
                        @foreach (var d in g.Dimensions)
                        {
                            <li class="rr-dim-row is-@ReleaseReadinessPresentation.Tone(d.State)" data-testid="rr-dimension" data-key="@d.Key" data-state="@d.State" data-applicability="@d.Applicability">
                                <span class="rr-chip is-@ReleaseReadinessPresentation.Tone(d.State)"><span aria-hidden="true">@Icon(d.State) </span>@GovernancePolicies.DecisionLabel(d.State)</span>
                                <span class="rr-dim-main"><strong>@d.Title</strong> <span class="rr-summary">@d.Summary</span>
                                    @if (d.Evidence.Count > 0)
                                    {
                                        <details><summary>Evidence (@d.Evidence.Count)</summary><ul class="rr-list rr-small">@foreach (var e in d.Evidence) { <li>@e</li> }</ul></details>
                                    }</span>
                                <span class="rr-dim-action rr-small">@if (d.NextAction is not null && d.State != GateDecision.Ready) { <span>@d.NextAction </span> }
                                    @if (d.Href is not null) { <a href="@d.Href" data-testid="rr-dimension-link">Open @PageLabel(d.Href)</a> }</span>
                            </li>
                        }
                    </ul>
                </div>
            }
        </section>
    };

    private RenderFragment ScopeSection(ReleaseReadinessAssessment a) => __builder =>
    {
        <section class="rr-card" aria-labelledby="rr-scope-h" data-testid="rr-scope">
            <h2 id="rr-scope-h">Release scope</h2>
            <fieldset class="rr-scope-mode">
                <legend class="rr-small">What does this release cover?</legend>
                <label><input type="radio" name="rr-scope-mode" checked="@(!_selectModules)" data-testid="rr-scope-entire" @onchange="() => ScopeModeAsync(false)" /> Entire project</label>
                <label><input type="radio" name="rr-scope-mode" checked="@_selectModules" data-testid="rr-scope-selected" @onchange="() => ScopeModeAsync(true)" /> Selected modules</label>
            </fieldset>
            @if (_selectModules)
            {
                @if (_modules.Count == 0)
                {
                    <p class="rr-muted" data-testid="rr-no-modules">@(Prepared(a)
                        ? "No module of the latest relationship analysis has a feature pack (a Delivery snapshot with specifications), so only the entire project can be assessed."
                        : "Modules come from the project's relationship analysis, which has not been prepared yet. Analyze relationships first.")</p>
                }
                else
                {
                    <input class="form-control rr-module-search" placeholder="Filter modules" aria-label="Filter modules" @bind="_moduleFilter" @bind:event="oninput" data-testid="rr-module-search" />
                    <fieldset class="rr-modules" aria-label="Modules">
                        @foreach (var m in _modules.Where(m => string.IsNullOrWhiteSpace(_moduleFilter) || m.Contains(_moduleFilter.Trim(), StringComparison.OrdinalIgnoreCase)))
                        {
                            <label><input type="checkbox" checked="@_selected.Contains(m)" @onchange="e => ToggleAsync(m, (bool)e.Value!)" data-testid="rr-module" data-module="@m" /> @m</label>
                        }
                    </fieldset>
                    <p class="rr-muted rr-small">Findings of other modules never weigh on the chosen ones. With no module chosen, the entire project is assessed.</p>
                }
            }
            @if (a.Dimensions.FirstOrDefault(d => d.Key == ReadinessDimensionKey.ScopeClarity) is { } scope)
            {
                <p data-testid="rr-scope-summary"><strong>In scope:</strong> @scope.Summary</p>
                @if (scope.Evidence.Count > 0) { <ul class="rr-list rr-small" data-testid="rr-scope-features">@foreach (var e in scope.Evidence) { <li>@e</li> }</ul> }
            }
        </section>
        <section class="rr-card" aria-labelledby="rr-evidence-h" data-testid="rr-evidence">
            <h2 id="rr-evidence-h">Evidence used</h2>
            <dl class="rr-evidence-list">
                <div><dt>Relationship analysis</dt><dd data-testid="rr-evidence-analysis">@if (a.ScopeReference.InterpretationId is { } i)
                    { <span>@i.ToString("D")[..8] · </span><a href="correlation-review?tab=history">Open the analysis history</a> }
                    else { <span>Not prepared · </span><a href="correlation-review" data-testid="rr-evidence-analyze">Analyze relationships</a> }</dd></div>
                <div><dt>Rules</dt><dd>@a.RuleSetVersion · @a.PolicySetVersion</dd></div>
                <div><dt>Evaluated</dt><dd>@a.EvaluatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC (draft — recomputed on every change)</dd></div>
            </dl>
            @{ var missing = a.Dimensions.Where(d => d.Applicability != DimensionApplicability.NotApplicable && d.State == GateDecision.NotAssessed).ToList(); }
            @if (missing.Count > 0)
            {
                <h3 class="rr-sub">Not assessed</h3>
                <ul class="rr-list" data-testid="rr-missing">
                    @foreach (var d in missing)
                    {
                        <li data-key="@d.Key"><strong>@d.Title</strong> (@ReleaseReadinessRules.ApplicabilityLabel(d.Applicability).ToLowerInvariant()) — @d.Summary
                            @if (d.Href is not null) { <a href="@d.Href">Open @PageLabel(d.Href)</a> }</li>
                    }
                </ul>
            }
        </section>
    };

    private RenderFragment FindingsSection(ReleaseReadinessAssessment a) => __builder =>
    {
        @if (!Prepared(a))
        {
            <section class="rr-card" data-testid="rr-findings-not-assessed">
                <h2>Findings</h2>
                <p>Governance not assessed — Analyze project relationships before evaluating governance rules.</p>
            </section>
        }
        else
        {
            @if (a.Blockers.Count > 0)
            {
                <section class="rr-card" aria-labelledby="rr-block-h"><h2 id="rr-block-h">Blocking</h2>
                    <ul class="rr-list" data-testid="rr-findings-blockers">@foreach (var b in a.Blockers) { <li>@b</li> }</ul></section>
            }
            <GovernanceGatePanel Scope="@(_scope!)" Version="_findingsVersion" Modules="@(_selected.Count > 0 ? [.. _selected] : null)" TestId="rr-governance" />
        }
    };

    private RenderFragment HistorySection(ReleaseReadinessAssessment a) => __builder =>
    {
        <section class="rr-card" aria-labelledby="rr-freeze-h" data-testid="rr-freeze-card">
            <h2 id="rr-freeze-h">Freeze this assessment</h2>
            <p class="rr-muted rr-small">The current assessment is a draft and changes with the evidence. Freezing keeps exactly what is known now — scope, environment, relationship
                analysis, rule and policy versions, dimensions and findings — as an assessment that never changes. It is not an approval: a person records the
                release decision on the frozen assessment.</p>
            <dl class="rr-freeze-summary" data-testid="rr-freeze-summary" aria-label="What a freeze records">
                @foreach (var (label, value) in ReleaseReadinessPresentation.FreezeSummary(a)) { <div><dt>@label</dt><dd>@value</dd></div> }
            </dl>
            @if (Incomplete(a.Decision))
            {
                <p class="rr-warning rr-small" data-testid="rr-freeze-incomplete">This assessment is Not assessed: a frozen copy is labelled incomplete and records what was missing.</p>
            }
            <div class="rr-form">
                <label class="rr-grow">Report name
                    <input class="form-control" @bind="_name" @bind:event="oninput" data-testid="rr-name" placeholder="e.g. Skolenærvær 1.4 or Sprint 47" />
                </label>
                <button type="button" class="btn btn-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_name))" @onclick="FreezeAsync" data-testid="rr-freeze">
                    @(Incomplete(a.Decision) ? "Freeze incomplete assessment" : "Freeze assessment")</button>
            </div>
            @if (_freezeError is not null) { <p class="rr-error" role="alert" data-testid="rr-freeze-error">@_freezeError</p> }
        </section>
        <section class="rr-card" aria-labelledby="rr-reports-h" data-testid="rr-reports">
            <h2 id="rr-reports-h">Frozen assessments</h2>
            @if (_reports.Count == 0) { <p class="rr-muted" data-testid="rr-reports-empty">No assessment has been frozen for this environment yet.</p> }
            else
            {
                <div class="rr-table-wrap">
                    <table class="rr-table">
                        <thead><tr><th scope="col">Name</th><th scope="col">Frozen</th><th scope="col">Scope</th><th scope="col">Result</th><th scope="col">Analysis</th><th scope="col">Release decision</th><th scope="col"><span class="visually-hidden">Inspect</span></th></tr></thead>
                        <tbody>
                            @foreach (var r in _reports)
                            {
                                <tr data-testid="rr-report-row">
                                    <th scope="row"><a href="@($"release-readiness?report={r.Id}")">@r.Name</a></th>
                                    <td>@r.FrozenAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC</td>
                                    <td>@(r.Modules.Count == 0 ? "Entire project" : string.Join(", ", r.Modules))</td>
                                    <td><strong>@GovernancePolicies.DecisionLabel(r.Decision)</strong>@(Incomplete(r.Decision) ? " · incomplete" : "")</td>
                                    <td>@(r.InterpretationId is { } i ? i.ToString("D")[..8] : "None")</td>
                                    <td>@(r.LatestSignOff is { } o ? OutcomeLabel(o) : "Not recorded")</td>
                                    <td><button type="button" class="btn btn-secondary btn-sm" aria-expanded="@(_inspected == r.Id ? "true" : "false")" data-testid="rr-report-inspect"
                                                @onclick="() => InspectAsync(r.Id)">@(_inspected == r.Id ? "Close" : "Inspect")<span class="visually-hidden"> @r.Name</span></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (_inspected is not null) { @HistoryInspector(a) }
            }
        </section>
    };

    // ── History inspector (NEXT57): a frozen assessment beside the current draft ───────────────────────────────────────────

    private Guid? _inspected;
    private ReleaseReadinessReport? _inspectedReport;
    private string? _inspectError;
    private bool _inspecting;

    private async Task InspectAsync(Guid id)
    {
        if (_scope is null) return;
        if (_inspected == id) { (_inspected, _inspectedReport) = (null, null); return; }
        (_inspected, _inspectedReport, _inspectError, _inspecting) = (id, null, null, true);
        var (report, error) = await Api.ReleaseReportAsync(_scope, id);
        if (_inspected != id) return;
        (_inspectedReport, _inspectError, _inspecting) = (report, report is null ? error ?? "The frozen assessment could not be read." : null, false);
    }

    /// <summary>The frozen assessment's own facts (never recomputed) and, per dimension, its frozen state against the current draft.</summary>
    private RenderFragment HistoryInspector(ReleaseReadinessAssessment current) => __builder =>
    {
        <section class="rr-history-inspector" aria-live="polite" data-testid="rr-history-inspector">
            @if (_inspecting) { <InlineLoading Text="Loading the frozen assessment…" Class="rr-muted" /> }
            else if (_inspectError is { } error) { <LoadError Title="The frozen assessment could not be loaded" Message="@error" OnRetry="() => InspectAsync(_inspected!.Value)" TestId="rr-inspect-error" /> }
            else if (_inspectedReport is { } r)
            {
                var frozen = r.Assessment;
                <h3 class="rr-sub">@r.Name <span class="rr-badge">Frozen @r.FrozenAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC</span></h3>
                <dl class="rr-freeze-summary" data-testid="rr-inspect-summary">
                    @foreach (var (label, value) in ReleaseReadinessPresentation.FreezeSummary(frozen)) { <div><dt>@label</dt><dd>@value</dd></div> }
                    <div><dt>Release decision</dt><dd>@(r.SignOffs.LastOrDefault() is { } s ? $"{OutcomeLabel(s.Outcome)} by {s.By}" : "Not recorded")</dd></div>
                </dl>
                <h4 class="rr-sub">Compared with the current draft</h4>
                var changes = ReleaseReadinessPresentation.Compare(frozen, current);
                <p class="rr-muted rr-small" data-testid="rr-compare-summary">@(changes.Count(c => c.Changed) is var n and > 0 ? $"{n} dimension{(n == 1 ? "" : "s")} changed since it was frozen." : "No dimension changed since it was frozen.")
                    Result then: <strong>@GovernancePolicies.DecisionLabel(frozen.Decision)</strong> · now: <strong>@GovernancePolicies.DecisionLabel(current.Decision)</strong>. The frozen assessment itself never changes.</p>
                <ul class="rr-dim-list">
                    @foreach (var c in changes)
                    {
                        <li class="rr-dim-row rr-compare-row @(c.Changed ? "is-changed" : "")" data-testid="rr-compare-row" data-key="@c.Key" data-changed="@(c.Changed ? "true" : "false")">
                            <strong>@c.Title</strong>
                            <span class="rr-chip is-@(c.Then is { } t ? ReleaseReadinessPresentation.Tone(t) : "notassessed")">@(c.Then is { } then ? GovernancePolicies.DecisionLabel(then) : "Not in the frozen assessment")</span>
                            <span aria-hidden="true">→</span>
                            <span class="rr-chip is-@(c.Now is { } n2 ? ReleaseReadinessPresentation.Tone(n2) : "notassessed")">@(c.Now is { } now ? GovernancePolicies.DecisionLabel(now) : "Not in the current draft")</span>
                        </li>
                    }
                </ul>
                <p><a href="@($"release-readiness?report={r.Id}")" data-testid="rr-inspect-open">Open the frozen assessment</a></p>
            }
        </section>
    };
}
