@page "/sources"
@using BirkNext.Integrations
@using BirkNext.GitSources
@using BirkNext.Web.Models
@using BirkNext.Web.Services.ProjectImport
@inject ProjectImportActivation Activation
@inject ProjectImportSession Session
@inject IFrontendAnalysisContextFactory Contexts
@inject IServiceProvider Services
@inject NavigationManager Nav
@inject IJSRuntime JS
@using BirkNext.Web.Services.ProjectEvidence
@implements IDisposable

<PageTitle>Source Management</PageTitle>

@* One view of every imported source package, whatever its origin (a chosen ZIP or an Azure DevOps repository): its evidence capabilities
   (what its content shows), its roles (the person's confirmed decision — the canonical role Project Evidence and every consumer reads;
   several allowed), the applications it is associated with (Target Environment → Project Evidence), its snapshots and analysis.
   Summary tiles (they filter the list), a toolbar, a scannable list and an inspector with the actions. Nothing here deletes a snapshot or a
   frozen report. *@
<div class="sm" data-testid="source-management">
    <header class="sm-head">
        <div class="sm-head-text">
            <h1>Source Management</h1>
            <p class="sm-lead">Imported ZIP archives and linked Azure DevOps repositories: what each contains, the role it plays, the applications it is evidence for, and how it is updated.</p>
        </div>
        <div class="sm-head-actions" role="group" aria-label="Source actions">
            @if (_links.Count > 0)
            {
                <BusyButton Class="btn-secondary" Text="@($"Check all linked repositories ({_links.Count})")" BusyText="Checking linked repositories…" Busy="_checkingAll"
                            Disabled="_busy" OnClick="CheckAllAsync" TestId="sm-check-all" title="Read-only: compares each branch's remote commit with the last imported one. Nothing is imported." />
            }
            <a class="btn-secondary" href="snapshots" data-testid="sm-registry">Snapshot Registry</a>
            <a class="btn-primary" href="project-import?import=1" data-testid="sm-import">Import source</a>
        </div>
    </header>

    <details class="sm-origins" data-testid="sm-origin-help">
        <summary>ZIP or Git — how sources are updated</summary>
        <dl>
            <dt><span class="sm-chip sm-chip-zip">ZIP</span></dt>
            <dd>An archive you uploaded. It never changes by itself; upload a newer ZIP to add a revision. Earlier revisions and their snapshots are kept.</dd>
            <dt><span class="sm-chip sm-chip-git">Git</span></dt>
            <dd>A linked Azure DevOps repository and branch (or pinned commit). <em>Check for updates</em> only compares the remote commit with the imported one; a new revision is imported only when you choose <em>Import revision</em>, through the normal import review.</dd>
        </dl>
    </details>

    @if (_error is not null) { <LoadError Title="Something could not be completed" Message="@_error" TestId="sm-error" /> }
    @if (_linksError is not null) { <LoadError Title="Linked repositories could not be read" Message="@_linksError" OnRetry="ReloadAsync" TestId="sm-links-error" /> }
    @if (_notice is not null) { <p class="sm-notice" role="status" data-testid="sm-notice">@_notice</p> }

    @if (!_loaded)
    {
        <LoadingSkeleton Lines="5" Text="Loading sources…" TestId="sm-loading" />
    }
    else if (_rows.Count == 0)
    {
        <section class="sm-empty" data-testid="sm-empty">
            <h2>No sources yet</h2>
            <p>Import a project ZIP, or link an Azure DevOps repository, to see its capabilities, roles and analysis here.</p>
            <a class="btn-primary" href="project-import?import=1">Import source</a>
        </section>
    }
    else
    {
        var summary = SourceManagementPresentation.Summary(_facts);
        @* Logical sources and their versions (analysis baselines) first: the list below shows imported packages, where each version of one source is a row. *@
        @if (Services.GetService(typeof(SourceContextApiService)) is not null)
        {
            <BirkNext.Web.Components.SourceManagement.SourceContextPanel OnChanged="ReloadAsync" />
        }
        <ul class="sm-tiles" data-testid="sm-summary" aria-label="Imported package summary — choose a tile to filter the list">
            <li>@Tile("sm-summary-total", summary.Total, summary.Total == 1 ? "source" : "sources", $"{summary.Zip} ZIP · {summary.Git} Git imported packages (each version is one)", null, () => _filter = new() { Sort = _filter.Sort })</li>
            <li>@Tile("sm-summary-review", summary.NeedsReview, "requiring review", summary.NeedsReview == 0 ? "No open decisions" : "Role or association to decide",
                summary.NeedsReview > 0 ? "attention" : null, () => _filter = _filter with { ReviewOnly = true })</li>
            <li>@Tile("sm-summary-analyzed", summary.Analyzed, "analyzed", "Every area present analyzed completely", null, () => _filter = _filter with { Analysis = nameof(SourceAnalysisBucket.Analyzed) })</li>
            <li>@Tile("sm-summary-partial", summary.Partial, "partly analyzed", "Some areas partial or not supported", summary.Partial > 0 ? "partial" : null,
                () => _filter = _filter with { Analysis = nameof(SourceAnalysisBucket.Partial) })</li>
            @if (summary.Failed > 0)
            {
                <li>@Tile("sm-summary-failed", summary.Failed, "analysis failed", "No present area could be read", "attention", () => _filter = _filter with { Analysis = nameof(SourceAnalysisBucket.Failed) })</li>
            }
            <li>@Tile("sm-summary-not-analyzed", summary.NotAnalyzed, "not analyzed", "No snapshot, or nothing analyzable", null, () => _filter = _filter with { Analysis = nameof(SourceAnalysisBucket.NotAnalyzed) })</li>
            <li>@Tile("sm-summary-applications", summary.Applications, summary.Applications == 1 ? "application" : "applications", "Distinct applications these sources serve", null, null)</li>
        </ul>
        <span class="visually-hidden" data-testid="sm-summary-zip">@summary.Zip ZIP</span>
        <span class="visually-hidden" data-testid="sm-summary-git">@summary.Git Git</span>

        @if (_bulkCheck is not null) { @BulkCheckTable() }

        var shown = SourceManagementPresentation.Apply(_facts, _filter);
        <div class="sm-workspace @(SelectedFacts is not null ? "has-inspector" : null)">
            <section class="sm-list-panel" aria-labelledby="sm-list-heading">
                <h2 id="sm-list-heading" class="visually-hidden">Sources</h2>
                <div class="sm-toolbar" role="search" data-testid="sm-toolbar">
                    <label class="sm-search"><span class="visually-hidden">Search sources by name</span>
                        <input type="search" placeholder="Search by name" value="@_filter.Search" @oninput="e => _filter = _filter with { Search = e.Value?.ToString() ?? string.Empty }" data-testid="sm-search" /></label>
                    @if (_facts.Any(f => f.Origin == "ZIP") && _facts.Any(f => f.Origin == "Git"))
                    {
                        <label><span class="visually-hidden">Origin</span>
                            <select value="@_filter.Origin" @onchange="e => _filter = _filter with { Origin = e.Value?.ToString() ?? string.Empty }" data-testid="sm-filter-origin">
                                <option value="">All origins</option><option value="ZIP">ZIP</option><option value="Git">Git</option>
                            </select></label>
                    }
                    @if (SourceManagementPresentation.CapabilityOptions(_facts) is { Count: > 1 } capabilities)
                    {
                        <label><span class="visually-hidden">Capability</span>
                            <select value="@_filter.Capability" @onchange="e => _filter = _filter with { Capability = e.Value?.ToString() ?? string.Empty }" data-testid="sm-filter-capability">
                                <option value="">All capabilities</option>
                                @foreach (var capability in capabilities) { <option value="@capability">@capability</option> }
                            </select></label>
                    }
                    <label><span class="visually-hidden">Analysis status</span>
                        <select value="@_filter.Analysis" @onchange="e => _filter = _filter with { Analysis = e.Value?.ToString() ?? string.Empty }" data-testid="sm-filter-analysis">
                            <option value="">Any analysis status</option>
                            <option value="@nameof(SourceAnalysisBucket.Analyzed)">Analyzed</option>
                            <option value="@nameof(SourceAnalysisBucket.Partial)">Partly analyzed</option>
                            <option value="@nameof(SourceAnalysisBucket.Failed)">Analysis failed</option>
                            <option value="@nameof(SourceAnalysisBucket.NotAnalyzed)">Not analyzed</option>
                        </select></label>
                    <label class="sm-toggle"><input type="checkbox" checked="@_filter.ReviewOnly" @onchange="e => _filter = _filter with { ReviewOnly = (bool)e.Value! }" data-testid="sm-filter-review" /> Requires review</label>
                    <label><span class="visually-hidden">Sort</span>
                        <select value="@_filter.Sort" @onchange="SetSort" data-testid="sm-sort">
                            <option value="name">Sort: name</option><option value="updated">Sort: last updated</option><option value="analysis">Sort: analysis</option>
                        </select></label>
                    <span class="sm-count" role="status" data-testid="sm-count">@(_filter.IsActive ? $"{shown.Count} of {_facts.Count}" : $"{_facts.Count}") shown</span>
                    @if (_filter.IsActive) { <button type="button" class="btn-link" @onclick="() => _filter = new() { Sort = _filter.Sort }" data-testid="sm-clear-filters">Clear filters</button> }
                </div>

                @if (shown.Count == 0)
                {
                    <p class="sm-empty-inline" data-testid="sm-no-match">No source matches these filters. <button type="button" class="btn-link" @onclick="() => _filter = new() { Sort = _filter.Sort }">Clear filters</button></p>
                }
                <ul class="sm-list" data-testid="sm-table" aria-label="Sources">
                    @foreach (var f in shown)
                    {
                        var selected = _selectedKey == f.Key;
                        <li class="sm-item @(selected ? "is-selected" : null) @(f.NeedsReview ? "needs-review" : null)" data-testid="sm-row" data-origin="@f.Origin" data-key="@f.Key"
                            aria-current="@(selected ? "true" : null)">
                            <div class="sm-item-main">
                                <button type="button" class="sm-open" data-testid="sm-open" aria-expanded="@(selected ? "true" : "false")" aria-controls="sm-detail" @onclick="() => Open(f.Key)">@f.Name</button>
                                <span class="sm-chip sm-chip-@f.Origin.ToLowerInvariant()" data-testid="sm-origin">@f.Origin</span>
                                @if (f.NeedsReview) { <span class="sm-chip sm-chip-attention" data-testid="sm-review-flag" title="@f.ReviewReason">Requires review</span> }
                            </div>
                            <div class="sm-item-roles" data-testid="sm-roles">@RoleLine(f)</div>
                            <div class="sm-item-facts">
                                <div class="sm-facet"><span class="sm-facet-label">Capabilities</span>
                                    <span class="sm-chips" data-testid="sm-capabilities">
                                        @if (f.Capabilities.Count == 0) { <span class="sm-quiet">@(f.Imported ? "None detected" : "Not imported")</span> }
                                        @foreach (var c in f.Capabilities.Take(4)) { <span class="sm-chip">@c</span> }
                                        @if (f.Capabilities.Count > 4) { <span class="sm-chip sm-chip-more" title="@string.Join(", ", f.Capabilities.Skip(4))">+@(f.Capabilities.Count - 4)</span> }
                                    </span></div>
                                <div class="sm-facet"><span class="sm-facet-label">Analysis</span>
                                    <span class="sm-chips" data-testid="sm-analysis" data-bucket="@f.Bucket">@AnalysisChips(f)</span></div>
                            </div>
                            <div class="sm-item-meta">
                                <span data-testid="sm-associated">@(f.Applications.Count > 0 ? string.Join(", ", f.Applications.Select(a => $"{a.Application} ({a.Environment})")) : "No application yet")</span>
                                @if (f.SnapshotId is { } snap) { <span>Snapshot <code>@snap.ToString()[..8]</code></span> }
                                @if (f.Commit is { } commit) { <span>Commit <code>@commit</code></span> }
                                <span>@SourceManagementPresentation.Updated(f.UpdatedAt)</span>
                            </div>
                        </li>
                    }
                </ul>
            </section>
            @if (SelectedRow is { } open && SelectedFacts is { } openFacts)
            {
                @Detail(open, openFacts)
            }
        </div>
    }
</div>

@code {
    private sealed record Row(string Key, string Name, string Origin, SddProjectImportRecord? Record, GitSourceLink? Link);

    private static readonly PackageEvidenceRole[] RoleChoices = [.. Enum.GetValues<PackageEvidenceRole>().Where(r => r != PackageEvidenceRole.NotClassified)];
    private SddApplicationContext? _application;
    private List<Row> _rows = [];
    private List<SourceRowFacts> _facts = [];
    private IReadOnlyList<GitSourceLink> _links = [];
    private readonly Dictionary<string, IReadOnlyList<GitSourceMatch>> _matches = new(StringComparer.Ordinal);
    private string? _environmentId, _error, _linksError, _editing, _notice, _selectedKey;
    private string _tab = "overview";
    private SourceListFilter _filter = new();
    private ProjectEvidenceView? _evidence;
    /// <summary>Per-area analysis outcomes of the stored snapshots (the shared source setup read the Snapshot Registry uses too).</summary>
    private IReadOnlyList<SourceSetupSnapshot> _setup = [];
    private bool _loaded, _copied;
    private readonly LoadSequence _loads = new();
    private IProjectEvidenceService? Evidence => Services.GetService(typeof(IProjectEvidenceService)) as IProjectEvidenceService;
    private IFrontendAnalysisSettingsService? Settings => Services.GetService(typeof(IFrontendAnalysisSettingsService)) as IFrontendAnalysisSettingsService;
    private bool _busy;
    // The roles being edited: kept across renders (a set built inside the fragment would be rebuilt, and a ticked role lost, on every re-render).
    private HashSet<string> _draftRoles = new(StringComparer.Ordinal);

    private Row? SelectedRow => _rows.FirstOrDefault(r => r.Key == _selectedKey);
    private SourceRowFacts? SelectedFacts => _facts.FirstOrDefault(f => f.Key == _selectedKey);

    private void ToggleRoleEditor(Row row, bool open = false)
    {
        _editing = open || _editing != row.Key ? row.Key : null;
        _draftRoles = new(SavedRoles(row), StringComparer.Ordinal);
    }

    private static IReadOnlyList<string> SavedRoles(Row row) => row.Link is { Roles.Count: > 0 } l ? l.Roles : row.Record?.ConfirmedRoles ?? [];

    private bool RolesChanged(Row row) => !_draftRoles.SetEquals(SavedRoles(row));

    private IGitSourcesApiService? Git => Services.GetService(typeof(IGitSourcesApiService)) as IGitSourcesApiService;

    protected override Task OnInitializedAsync() => ReloadAsync();

    /// <summary>Initial load and Retry: import records at once, then linked repositories and Project Evidence. "No sources" is shown only
    /// after the load — never while it runs.</summary>
    private async Task ReloadAsync()
    {
        var load = _loads.Begin();
        _linksError = null;
        try { _environmentId = (await Contexts.GetActiveContextAsync()).ActiveProfileOrNull?.Id; } catch (InvalidOperationException) { }
        if (!load.IsCurrent) return;
        if (_environmentId is not null && Git is { } git)
        {
            var (items, error) = await git.LinksAsync(_environmentId, load.Token);
            if (!load.IsCurrent) return;
            _links = items;
            _linksError = error;
        }
        // Capabilities and the active environment's associations come from the shared Project Evidence read (no inference on this page).
        if (Evidence is { } evidence)
        {
            try { _evidence = await evidence.GetAsync(_environmentId); }
            catch (Exception ex) when (ex is not OutOfMemoryException) { _evidence = null; }
            if (!load.IsCurrent) return;
        }
        if (Services.GetService(typeof(IIntegrationJourneysApiService)) is IIntegrationJourneysApiService journeys)
        {
            try { _setup = (await journeys.SourceSetupAsync(_environmentId))?.Value?.Snapshots ?? []; }
            catch (Exception ex) when (ex is not OutOfMemoryException) { _setup = []; }
            if (!load.IsCurrent) return;
        }
        Build();
        _loaded = true;
        _loads.End(load);
    }

    public void Dispose() => _loads.Dispose();

    private ElementReference _detailHeading;
    private bool _focusDetail;

    /// <summary>Opening a source moves focus to its inspector: announced to screen readers, and on a narrow screen (inspector below the list)
    /// scrolled into view instead of opening out of sight.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusDetail) return;
        _focusDetail = false;
        try { await _detailHeading.FocusAsync(); } catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException) { }
    }

    private void Open(string key)
    {
        _selectedKey = _selectedKey == key ? null : key;
        _tab = "overview";
        _notice = null;
        _copied = false;
        _focusDetail = _selectedKey is not null;
        if (SelectedRow is { } row) ToggleRoleEditor(row, open: true);
        else _editing = null;
    }

    private ProjectEvidencePackage? PackageOf(Row row) => row.Record is { } r ? _evidence?.Packages.FirstOrDefault(p => p.ImportId == r.ImportId) : null;

    private PackageAssociation? AssociationOf(Row row) => row.Record is { } r ? _evidence?.Associations.FirstOrDefault(a => a.Package.ImportId == r.ImportId) : null;

    /// <summary>Applications the source is evidence for: every Target Environment whose Project Evidence references the import (shared records).</summary>
    private IReadOnlyList<(string Application, string Environment)> AssociatedApplications(Row row)
    {
        if (row.Record is not { } record || Settings?.Settings.Profiles is not { } profiles) return [];
        return [.. profiles.Where(p => p.Project?.Evidence.Any(e => e.Sources.Any(s => s.ImportId == record.ImportId)) == true)
            .Select(p => (TargetApplications.Of(p)?.Name ?? p.Project!.ProjectName, p.Name))];
    }

    /// <summary>A decision is open: the active environment's association needs review, or the role is neither confirmed nor classified.</summary>
    private string? ReviewReason(Row row) =>
        AssociationOf(row) is { State: EvidenceAssociationState.NeedsReview } a ? $"Association needs review: {a.Detail}"
        : row.Record is { } r && r.ConfirmedRoles.Count == 0 && AssociationOf(row) is { Role: PackageEvidenceRole.NotClassified } ? "No role: assign what this source is"
        : null;

    /// <summary>
    /// Analysis per area the snapshot contains, with the outcome from the shared rule (SourceSetupOutcome.Overall) — exactly what the Snapshot
    /// Registry shows for the same snapshot. The snapshot's own status is the application-code analyzer's outcome only (a Terraform package
    /// without application code reads "Failed" there), so it is never shown as the package's analysis. Capabilities (what the content shows)
    /// come from Project Evidence and carry no analysis status here.
    /// </summary>
    private SourceRowFacts Facts(Row row)
    {
        var package = PackageOf(row);
        var areas = row.Record?.SourceSnapshotId is { } snapshotId ? _setup.FirstOrDefault(s => s.SnapshotId == snapshotId)?.Areas : null;
        var analysis = SourceManagementPresentation.Chips(areas);
        var bucket = SourceManagementPresentation.Bucket(row.Record is not null, areas);
        string? note = row.Record is null ? "Not imported"
            : row.Record.SourceSnapshotId is null ? "Not analyzed"
            : areas is null ? "Analysis not loaded"
            : analysis.Count == 0 ? "Nothing analyzable detected" : null;
        var reason = ReviewReason(row);
        return new(row.Key, row.Name, row.Origin, row.Record is not null,
            package is { Capabilities.Count: > 0 } p ? [.. p.Capabilities.Select(c => ProjectEvidencePackages.CapabilityLabel(c.Capability))] : [],
            analysis, bucket, note, reason is not null, reason, SavedRoles(row),
            AssociatedApplications(row), row.Record?.ImportedAt, row.Record?.SourceSnapshotId, row.Record?.Git?.ShortSha);
    }

    private static readonly (string Key, string Label)[] DetailTabs =
        [("overview", "Overview"), ("roles", "Capabilities & Roles"), ("associations", "Associations"), ("snapshots", "Snapshots"), ("evidence", "Analysis & Evidence"), ("history", "History")];

    private RenderFragment Tile(string testId, int value, string label, string detail, string? tone, Action? filter) => __builder =>
    {
        if (filter is null)
        {
            <div class="sm-tile @(tone is null ? null : $"is-{tone}")" data-testid="@testId"><strong class="sm-tile-value">@value</strong> <span class="sm-tile-label">@label</span><span class="sm-tile-detail">@detail</span></div>
        }
        else
        {
            <button type="button" class="sm-tile @(tone is null ? null : $"is-{tone}")" data-testid="@testId" @onclick="filter" title="Filter the list"><strong class="sm-tile-value">@value</strong> <span class="sm-tile-label">@label</span><span class="sm-tile-detail">@detail</span></button>
        }
    };

    /// <summary>Confirmed roles as chips; without a confirmed role, one quiet line (not repeated noise on every row).</summary>
    private RenderFragment RoleLine(SourceRowFacts f) => __builder =>
    {
        if (f.ConfirmedRoles.Count > 0)
        {
            <span class="sm-facet-label">Roles</span>
            foreach (var role in f.ConfirmedRoles) { <span class="sm-chip sm-chip-role">@Label(role)</span> }
            <span class="sm-quiet">confirmed</span>
        }
        else { <span class="sm-quiet">Role detected from content</span> }
    };

    private RenderFragment AnalysisChips(SourceRowFacts f) => __builder =>
    {
        if (f.Analysis.Count == 0) { <span class="sm-quiet">@f.AnalysisNote</span> return; }
        foreach (var chip in f.Analysis)
        {
            <span class="sm-chip sm-status sm-status-@chip.Tone" data-status="@chip.Status" title="@chip.Meaning"><span class="sm-status-dot" aria-hidden="true"></span>@chip.Dimension · @chip.StatusText</span>
        }
    };

    private RenderFragment Detail(Row row, SourceRowFacts facts) => __builder =>
    {
        var association = AssociationOf(row);
        <section id="sm-detail" class="sm-detail" data-testid="sm-detail" data-key="@row.Key" aria-labelledby="sm-detail-title">
            <header class="sm-detail-head">
                <div class="sm-detail-title">
                    <h2 id="sm-detail-title" tabindex="-1" @ref="_detailHeading">@row.Name</h2>
                    <span class="sm-chip sm-chip-@row.Origin.ToLowerInvariant()">@row.Origin</span>
                    @if (facts.NeedsReview) { <span class="sm-chip sm-chip-attention">Requires review</span> }
                </div>
                <button type="button" class="sm-close" aria-label="Close details" @onclick="() => Open(row.Key)" data-testid="sm-close">×</button>
            </header>
            @if (facts.ReviewReason is { } why)
            {
                <p class="sm-review-callout" role="note" data-testid="sm-review-reason"><strong>Requires review.</strong> @why
                    <a href="@ProjectEvidenceResolver.ProjectTabHref(_environmentId)">Decide in Project Evidence</a></p>
            }
            <div class="sm-detail-actions" role="group" aria-label="Update this source">
                @if (row.Link is { } link)
                {
                    <BusyButton Class="btn-secondary btn-sm" Text="Check for updates" BusyText="Checking…" Disabled="@(_busy || _checkingAll)" OnClick="() => CheckAsync(link)" TestId="sm-check" />
                    <button type="button" class="btn-primary btn-sm" disabled="@_busy" @onclick="() => ImportRevision(link)" data-testid="sm-import-revision">@(GitUpdateStates.CommitToImport(link) is { } commit ? $"Import revision {commit[..8]}" : "Import branch head")</button>
                }
                else { <a class="btn-primary btn-sm" href="project-import?import=1" data-testid="sm-upload-version">Upload new version</a> }
                <span class="sm-action-sep" aria-hidden="true"></span>
                <button type="button" class="sm-link-action" @onclick='() => SelectTab(row, "roles")' data-testid="sm-edit-roles">Manage roles</button>
                <a class="sm-link-action" href="@ProjectEvidenceResolver.ProjectTabHref(_environmentId)" data-testid="sm-associate">Associate with application</a>
                @if (row.Record?.SourceSnapshotId is { } evidence) { <a class="sm-link-action" href="@($"source-analysis?snapshot={evidence:D}")" data-testid="sm-evidence">View evidence</a> }
                <a class="sm-link-action" href="snapshots" data-testid="sm-snapshots">View snapshots</a>
            </div>
            <div class="sm-tabs" role="tablist" aria-label="@($"{row.Name} details")">
                @foreach (var (key, label) in DetailTabs)
                {
                    <button type="button" role="tab" id="@($"sm-tab-{key}")" aria-selected="@(_tab == key ? "true" : "false")" aria-controls="sm-tabpanel" class="sm-tab"
                            tabindex="@(_tab == key ? "0" : "-1")" data-testid="sm-tab" data-tab="@key" @onclick="() => SelectTab(row, key)" @onkeydown="e => TabKey(row, e)">@label</button>
                }
            </div>
            <div id="sm-tabpanel" role="tabpanel" aria-labelledby="@($"sm-tab-{_tab}")" class="sm-tabpanel" data-testid="sm-tabpanel" data-tab="@_tab" tabindex="0">
                @switch (_tab)
                {
                    case "roles":
                        @RoleEditor(row, facts)
                        break;
                    case "associations":
                        var apps = facts.Applications;
                        @if (apps.Count == 0)
                        {
                            <div class="sm-empty-card" data-testid="sm-no-associations"><strong>Not associated with any application yet.</strong>
                                <span>A source becomes evidence for an application when you associate it under Target Environments → Project Evidence.</span></div>
                        }
                        else
                        {
                            <ul class="sm-assoc-list" data-testid="sm-association-list">
                                @foreach (var (app, env) in apps) { <li><span class="sm-assoc-source">@row.Name</span><span aria-hidden="true">→</span><strong>@app</strong><span class="sm-chip">@env</span></li> }
                            </ul>
                        }
                        @if (association is { State: EvidenceAssociationState.NeedsReview or EvidenceAssociationState.NotAssociated } a)
                        {
                            <p class="sm-quiet" data-testid="sm-association-why">Active environment: @a.StateLabel — @a.Detail</p>
                        }
                        <a href="@ProjectEvidenceResolver.ProjectTabHref(_environmentId)" data-testid="sm-associate-link">Review associations in Project Evidence</a>
                        break;
                    case "snapshots":
                        @if (row.Record?.SourceSnapshotId is { } current)
                        {
                            <div class="sm-card" data-testid="sm-current-snapshot">
                                <span class="sm-facet-label">Current snapshot</span>
                                <code class="sm-snapshot-id">@current.ToString("D")</code>
                                @if (row.Record.Git is { } git) { <span class="sm-quiet">commit @git.ShortSha · @git.Branch</span> }
                                <span class="sm-quiet">Imported @SourceManagementPresentation.Updated(row.Record.ImportedAt)</span>
                                <div class="sm-card-actions">
                                    <button type="button" class="btn-secondary btn-sm" @onclick="() => CopyAsync(current.ToString())" data-testid="sm-copy-snapshot">@(_copied ? "Copied" : "Copy id")</button>
                                    <a class="btn-secondary btn-sm" href="@($"source-analysis?snapshot={current:D}")">Open in Source Analysis</a>
                                </div>
                            </div>
                        }
                        else { <div class="sm-empty-card"><strong>No snapshot yet.</strong><span>@(row.Record is null ? "This repository has not been imported." : "The source part of this import was not analyzed.")</span></div> }
                        <a href="snapshots" data-testid="sm-snapshots-link">Open the Snapshot Registry — every revision, comparisons</a>
                        break;
                    case "evidence":
                        <div class="sm-card" data-testid="sm-analysis-detail">
                            <span class="sm-facet-label">Analysis by area</span>
                            <span class="sm-quiet">@SourceManagementPresentation.BucketLabel(facts.Bucket) — the same outcome the Snapshot Registry shows for this snapshot.</span>
                            @if (facts.Analysis.Count == 0) { <span class="sm-quiet">@facts.AnalysisNote</span> }
                            else
                            {
                                <ul class="sm-dim-list">
                                    @foreach (var chip in facts.Analysis)
                                    {
                                        <li><span>@chip.Dimension <span class="sm-quiet sm-small">@chip.Meaning</span></span><span class="sm-chip sm-status sm-status-@chip.Tone"><span class="sm-status-dot" aria-hidden="true"></span>@chip.StatusText</span></li>
                                    }
                                </ul>
                            }
                        </div>
                        <div class="sm-card"><span class="sm-facet-label">Capabilities (from its content)</span>
                            <span class="sm-chips">@if (facts.Capabilities.Count == 0) { <span class="sm-quiet">None detected</span> } @foreach (var c in facts.Capabilities) { <span class="sm-chip">@c</span> }</span></div>
                        @if (row.Record?.SourceSnapshotId is { } snapshot)
                        {
                            <p class="sm-links"><a href="@($"source-analysis?snapshot={snapshot:D}")">Open Source Analysis</a> · <a href="technology-coverage">Technology Coverage</a> · <a href="generated-documentation">Generated documentation</a></p>
                        }
                        break;
                    case "history":
                        @History(row)
                        break;
                    default:
                        <dl class="sm-overview">
                            <div><dt>Origin</dt><dd>@row.Origin@if (row.Link is { } l) { <span> · @l.Organization / @l.Project / @l.Repository · @(l.PinnedCommit is { } pin ? $"commit {pin[..8]}" : l.Branch)</span> } else if (row.Record is { } r) { <span> · @r.ArchiveFileName</span> }</dd></div>
                            <div><dt>Roles</dt><dd>@RoleLine(facts)</dd></div>
                            <div><dt>Capabilities</dt><dd class="sm-chips">@if (facts.Capabilities.Count == 0) { <span class="sm-quiet">@(facts.Imported ? "None detected" : "Not imported")</span> } @foreach (var c in facts.Capabilities) { <span class="sm-chip">@c</span> }</dd></div>
                            <div><dt>Update path</dt><dd data-testid="sm-updates">@Updates(row)</dd></div>
                            <div><dt>Analysis</dt><dd class="sm-chips">@AnalysisChips(facts)</dd></div>
                            <div><dt>Applications</dt><dd>@(facts.Applications.Count == 0 ? "None yet" : string.Join(", ", facts.Applications.Select(a => a.Application).Distinct(StringComparer.OrdinalIgnoreCase)))</dd></div>
                        </dl>
                        break;
                }
            </div>
        </section>
    };

    private void SetSort(ChangeEventArgs e) => _filter = _filter with { Sort = e.Value?.ToString() is { Length: > 0 } sort ? sort : "name" };

    private void SelectTab(Row row, string key)
    {
        _tab = key;
        if (key == "roles" && _editing != row.Key) ToggleRoleEditor(row, open: true);
    }

    /// <summary>Arrow keys move between tabs (WAI-ARIA tabs pattern); Home/End go to the first/last.</summary>
    private void TabKey(Row row, KeyboardEventArgs e)
    {
        var index = Array.FindIndex(DetailTabs, t => t.Key == _tab);
        var next = e.Key switch { "ArrowRight" => (index + 1) % DetailTabs.Length, "ArrowLeft" => (index + DetailTabs.Length - 1) % DetailTabs.Length, "Home" => 0, "End" => DetailTabs.Length - 1, _ => -1 };
        if (next >= 0) SelectTab(row, DetailTabs[next].Key);
    }

    private async Task CopyAsync(string text)
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", text); _copied = true; }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException) { _copied = false; }
    }

    /// <summary>
    /// Rows: each import record of the current application (its origin from its own provenance — a ZIP never becomes Git), joined to the link of the
    /// repository it came from by organization + repository id; then linked repositories not imported yet.
    /// </summary>
    private void Build()
    {
        _application = Activation.CurrentApplication;
        var records = _application is null ? Activation.Imports : ApplicationContexts.Imports(Activation.Lifecycle, _application.Id);
        var rows = records.Select(r => new Row(r.ImportId, r.ProjectName, r.Git is null ? "ZIP" : "Git", r,
            r.Git is { } g ? _links.FirstOrDefault(l => string.Equals(l.Organization, g.Organization, StringComparison.OrdinalIgnoreCase) && l.RepositoryId == g.RepositoryId) : null)).ToList();
        rows.AddRange(_links.Where(l => rows.All(r => r.Link?.Id != l.Id)).Select(l => new Row(l.Id, l.Repository, "Git", null, l)));
        _rows = rows;
        _facts = [.. rows.Select(Facts)];
    }

    private static string Label(string role) => Enum.TryParse<PackageEvidenceRole>(role, out var r) ? ApplicationContexts.RoleLabel(r) : role;

    /// <summary>The shared update state (GitUpdateStates) in words, with the commit or the reason. Compared by commit, never by timestamp.</summary>
    private static string Updates(Row row)
    {
        if (row.Link is not { } link) return "Upload a newer ZIP to update";
        var state = GitUpdateStates.Of(link);
        return state switch
        {
            GitUpdateState.UpdateAvailable => $"Update available ({link.LastCheck!.RemoteCommit?[..8]})",
            GitUpdateState.UpToDate => $"Up to date ({link.LastCheck!.CheckedAt.UtcDateTime:yyyy-MM-dd HH:mm} UTC)",
            GitUpdateState.NotImported => $"Not imported — remote {link.LastCheck!.RemoteCommit?[..8]}",
            GitUpdateState.NotChecked => "Not checked",
            _ => $"{GitUpdateStates.Label(state)}{(link.LastCheck?.Problem is { } problem ? $" — {problem}" : "")}",
        };
    }

    /// <summary>History as a timeline: imports of this source (newest first), the last update check, and — for a repository — earlier ZIP imports
    /// that may be the same code (the person decides).</summary>
    private RenderFragment History(Row row) => __builder =>
    {
        var events = new List<(DateTimeOffset At, string Text)>();
        if (row.Link is { } link)
        {
            events.AddRange(link.Imports.Select(i => (i.ImportedAt, $"Imported commit {i.CommitSha[..Math.Min(8, i.CommitSha.Length)]} from {i.Branch}")));
            if (link.LastCheck is { } check) events.Add((check.CheckedAt, $"Checked for updates: {GitUpdateStates.Label(GitUpdateStates.Of(link))}"));
        }
        if (row.Record is { } record && (row.Link is null || row.Link.Imports.All(i => i.ImportId != record.ImportId)))
            events.Add((record.ImportedAt, $"Imported from {(string.IsNullOrEmpty(record.ArchiveFileName) ? "a ZIP" : record.ArchiveFileName)}"));
        if (events.Count == 0) { <div class="sm-empty-card"><strong>No history yet.</strong><span>Imports and update checks appear here.</span></div> }
        else
        {
            <ol class="sm-timeline" data-testid="sm-timeline">
                @foreach (var (at, text) in events.OrderByDescending(e => e.At))
                {
                    <li><time datetime="@at.ToString("O")">@SourceManagementPresentation.Updated(at)</time><span>@text</span></li>
                }
            </ol>
        }
        if (row.Link is { } historyLink)
        {
            <div class="sm-card">
                <span class="sm-facet-label">Earlier ZIP imports of this repository?</span>
                <p class="sm-quiet">Names alone are never evidence; matches are by content or commit, and you decide.</p>
                <div><BusyButton Class="btn-secondary btn-sm" Text="Find earlier imports" BusyText="Searching…" Disabled="_busy" OnClick="() => MatchesAsync(historyLink)" TestId="sm-matches" /></div>
                @if (_matches.TryGetValue(historyLink.Id, out var matches)) { @MatchList(historyLink, matches) }
            </div>
        }
        else if (row.Record is { } zip)
        {
            <p class="sm-quiet">Upload a newer ZIP of @zip.ProjectName to add a revision; this one stays in the Snapshot Registry.</p>
        }
    };

    // ── "Check all linked repositories": read-only, a few at a time; each row keeps its own outcome (partial success is normal) ───────────

    private bool _checkingAll;
    private IReadOnlyList<(GitSourceLink Link, string? Error)>? _bulkCheck;
    private const int CheckConcurrency = 3;

    private async Task CheckAllAsync()
    {
        if (Git is not { } git || _environmentId is null || _links.Count == 0) return;
        (_checkingAll, _error, _bulkCheck) = (true, null, null);
        try
        {
            var gate = new SemaphoreSlim(CheckConcurrency);
            var results = await Task.WhenAll(_links.Select(async link =>
            {
                await gate.WaitAsync();
                try
                {
                    var (updated, error) = await git.CheckAsync(link.Id, _environmentId);
                    return (Link: updated ?? link, Error: updated is null ? error ?? "The check failed." : null);
                }
                finally { gate.Release(); }
            }));
            _links = [.. _links.Select(l => results.FirstOrDefault(r => r.Link.Id == l.Id) is { Link: { } r } && r.Id == l.Id ? r : l)];
            _bulkCheck = results;
            Build();
        }
        finally { _checkingAll = false; }
    }

    private RenderFragment BulkCheckTable() => __builder =>
    {
        <section class="sm-bulk" data-testid="sm-bulk-check" aria-labelledby="sm-bulk-heading">
            <header class="sm-bulk-head">
                <h2 id="sm-bulk-heading">Update check — @_bulkCheck!.Count linked repositor@(_bulkCheck.Count == 1 ? "y" : "ies")</h2>
                <button type="button" class="sm-link-action" @onclick="() => _bulkCheck = null" data-testid="sm-bulk-close">Dismiss</button>
            </header>
            <p class="sm-quiet">Read-only — nothing was imported, no snapshot was created.</p>
            <ul class="sm-bulk-list">
                @foreach (var (link, error) in _bulkCheck)
                {
                    var state = GitUpdateStates.Of(link);
                    <li data-testid="sm-bulk-row" data-state="@state">
                        <strong>@link.Repository</strong><span class="sm-quiet">@link.Project · @(link.PinnedCommit is { } p ? $"commit {p[..8]}" : link.Branch)</span>
                        <span class="sm-quiet">imported @(link.LastImport?.CommitSha is { } imported ? imported[..8] : "—") · remote @(link.LastCheck?.RemoteCommit is { } remote ? remote[..8] : "—")</span>
                        <span class="sm-chip @(error is not null || state is GitUpdateState.CheckFailed or GitUpdateState.BranchUnavailable or GitUpdateState.AuthenticationRequired ? "sm-status-failed" : state == GitUpdateState.UpdateAvailable ? "sm-chip-attention" : null)">@(error ?? GitUpdateStates.Label(state))</span>
                    </li>
                }
            </ul>
        </section>
    };

    private async Task CheckAsync(GitSourceLink link)
    {
        if (Git is not { } git || _environmentId is null) return;
        (_busy, _error) = (true, null);
        try
        {
            var (updated, error) = await git.CheckAsync(link.Id, _environmentId);
            if (updated is null) { _error = error; return; }
            _links = [.. _links.Select(l => l.Id == updated.Id ? updated : l)];
            Build();
        }
        finally { _busy = false; }
    }

    /// <summary>Imports the link's revision (pinned commit or branch head) through the normal Project Import review.</summary>
    private void ImportRevision(GitSourceLink link)
    {
        if (Git is not { } git) return;
        // The revision the person reviewed: the commit the last check reported (or the pinned one) — a branch that moved since is never imported
        // silently; without a check, the branch head at import time (shown as the branch).
        var commit = GitUpdateStates.CommitToImport(link);
        var request = new GitImportRequest(link.RepositoryId, link.Branch) { OrganizationUrl = link.OrganizationUrl, Commit = commit };
        _ = Session.StartGitPreviewAsync($"{link.Repository} @ {commit?[..8] ?? link.Branch}", ct => git.ImportAsync(request, ct), null);
        Nav.NavigateTo("project-import");
    }

    private async Task MatchesAsync(GitSourceLink link)
    {
        if (Git is not { } git || _environmentId is null) return;
        (_busy, _error) = (true, null);
        try
        {
            var (items, error) = await git.MatchesAsync(link.Id, _environmentId);
            if (error is not null) { _error = error; return; }
            _matches[link.Id] = items;
        }
        finally { _busy = false; }
    }

    private async Task DecideAsync(GitSourceLink link, Guid snapshot, bool associate)
    {
        if (Git is not { } git || _environmentId is null) return;
        var (updated, error) = await git.DecideAsync(link.Id, _environmentId, new GitAssociationRequest(snapshot, associate));
        if (updated is null) { _error = error; return; }
        _links = [.. _links.Select(l => l.Id == updated.Id ? updated : l)];
        Build();
        await MatchesAsync(updated);
    }

    private async Task SaveRolesAsync(Row row, HashSet<string> roles)
    {
        _error = null;
        if (row.Link is { } link && Git is { } git && _environmentId is not null)
        {
            var (updated, error) = await git.LinkAsync(new GitLinkRequest(link.OrganizationUrl, link.RepositoryId, link.Branch, link.PinnedCommit, [.. roles], _environmentId, link.BirkNextProject));
            if (updated is null) { _error = error; return; }
            _links = [.. _links.Select(l => l.Id == updated.Id ? updated : l)];
        }
        // The import record holds the canonical role every consumer reads (Project Evidence associations, explorers); a linked repository's
        // imported revision gets the same roles, so the two never disagree.
        if (row.Record is { } record)
        {
            record.ConfirmedRoles = [.. roles];
            if (Services.GetService(typeof(IWorkspaceAutoSaveService)) is IWorkspaceAutoSaveService autoSave && !await autoSave.SaveNowAsync()) _error = "The roles could not be saved durably; try again.";
            (Services.GetService(typeof(BirkNext.Web.Services.ProjectEvidence.IProjectEvidenceService)) as BirkNext.Web.Services.ProjectEvidence.IProjectEvidenceService)?.Invalidate();
        }
        if (_error is null) _notice = $"Roles of {row.Name} saved. Project Evidence and every review use them; associations you confirmed per application are unchanged.";
        Build();
        _draftRoles = new(roles, StringComparer.Ordinal);
        _tab = "overview";
        if (Evidence is { } evidence)
        {
            try { _evidence = await evidence.GetAsync(_environmentId, refresh: true); } catch (Exception ex) when (ex is not OutOfMemoryException) { }
            Build();
        }
    }

    private RenderFragment RoleEditor(Row row, SourceRowFacts facts) => __builder =>
    {
        var current = _draftRoles;
        var association = AssociationOf(row);
        <div class="sm-role-panel" data-testid="sm-role-editor">
            <div class="sm-role-grid">
                <div class="sm-card"><span class="sm-facet-label">Detected capabilities</span><span class="sm-quiet">From the content, read-only</span>
                    <span class="sm-chips" data-testid="sm-detected">@if (facts.Capabilities.Count == 0) { <span class="sm-quiet">@(facts.Imported ? "None detected" : "Not imported")</span> } @foreach (var c in facts.Capabilities) { <span class="sm-chip">@c</span> }</span></div>
                <div class="sm-card"><span class="sm-facet-label">Detected role</span>
                    @if (association is { } a && a.Role != PackageEvidenceRole.NotClassified)
                    {
                        <span data-testid="sm-role-why">@ApplicationContexts.RoleLabel(a.Role)@(a.RoleConfirmed ? " (confirmed)" : " — from its content")</span>
                    }
                    else { <span class="sm-quiet">Not classified from its content</span> }</div>
                <div class="sm-card"><span class="sm-facet-label">Effective role</span>
                    <span data-testid="sm-effective-role">@(SavedRoles(row) is { Count: > 0 } saved ? string.Join(", ", saved.Select(Label)) + " — assigned by you" : association is { Role: not PackageEvidenceRole.NotClassified } d ? $"{ApplicationContexts.RoleLabel(d.Role)} — detected (no role assigned)" : "None — assign a role below")</span>
                    <span class="sm-quiet">What Project Evidence and every review read.</span></div>
            </div>
            <fieldset class="sm-roles"><legend>Assigned roles — several allowed; none = the role detected from content</legend>
                @foreach (var role in RoleChoices)
                {
                    <label class="sm-role-option"><input type="checkbox" checked="@current.Contains(role.ToString())" @onchange="e => { if ((bool)e.Value!) current.Add(role.ToString()); else current.Remove(role.ToString()); }" data-testid="sm-role" data-role="@role" /> @ApplicationContexts.RoleLabel(role)</label>
                }
            </fieldset>
            <p class="sm-quiet sm-small">A role says what this source is; the application it is evidence for is chosen per Target Environment in Project Evidence (unchanged here).</p>
            @if (RolesChanged(row)) { <p class="sm-unsaved" role="status" data-testid="sm-unsaved">Unsaved role changes.</p> }
            <div class="sm-role-actions">
                <BusyButton Class="btn-primary btn-sm" Text="Save roles" BusyText="Saving…" Disabled="@(!RolesChanged(row))" OnClick="() => SaveRolesAsync(row, current)" TestId="sm-save-roles" />
                <button type="button" class="btn-secondary btn-sm" disabled="@(!RolesChanged(row))" @onclick="() => ToggleRoleEditor(row, open: true)" data-testid="sm-reset-roles">Discard changes</button>
            </div>
        </div>
    };

    private RenderFragment MatchList(GitSourceLink link, IReadOnlyList<GitSourceMatch> matches) => __builder =>
    {
        <div class="sm-matches" data-testid="sm-match-list">
            @if (matches.Count == 0) { <p class="sm-quiet">No earlier import appears to be this repository (names alone are never evidence).</p> }
            @foreach (var m in matches)
            {
                <div class="sm-match" data-testid="sm-match" data-strength="@m.Strength">
                    <div><strong>@(m.Strength switch { GitSourceMatchStrength.SameContent => "Same content", GitSourceMatchStrength.SameCommit => "Same commit", _ => "Possible existing imported source" })</strong>
                        <span class="sm-quiet"> · @m.ArchiveFileName · snapshot @m.SnapshotId.ToString()[..8] · @string.Join(" ", m.Evidence)</span>
                        @if (m.Decision is { } decision) { <span class="sm-chip">@decision</span> }</div>
                    <div class="sm-card-actions">
                        <button type="button" class="btn-secondary btn-sm" @onclick="() => DecideAsync(link, m.SnapshotId, true)" data-testid="sm-associate-match">Associate with this repository</button>
                        <button type="button" class="btn-secondary btn-sm" @onclick="() => DecideAsync(link, m.SnapshotId, false)" data-testid="sm-keep-separate">Keep separate</button>
                        <a class="sm-link-action" href="@($"source-analysis?snapshot={m.SnapshotId:D}")">Review evidence</a>
                    </div>
                </div>
            }
        </div>
    };
}
