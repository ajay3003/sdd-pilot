@page "/sources"
@using BirkNext.GitSources
@using BirkNext.Web.Models
@using BirkNext.Web.Services.ProjectImport
@inject ProjectImportActivation Activation
@inject ProjectImportSession Session
@inject IFrontendAnalysisContextFactory Contexts
@inject IServiceProvider Services
@inject NavigationManager Nav
@using BirkNext.Web.Services.ProjectEvidence

<PageTitle>Source Management</PageTitle>

@* One view of every imported source package, whatever its origin (a chosen ZIP or an Azure DevOps repository): its evidence capabilities
   (what its content shows), its roles (the person's confirmed decision — the canonical role Project Evidence and every consumer reads;
   several allowed), the applications it is associated with (Target Environment → Project Evidence), its snapshots and analysis. A compact
   grid; a row opens its detail panel, where the actions are. Nothing here deletes a snapshot or a frozen report. *@
<div class="sm" data-testid="source-management">
    <header class="sm-head">
        <h1>Source Management</h1>
        <p class="sm-muted">Manage imported ZIP and connected Git sources, their evidence capabilities, revisions and associations.
            <a href="project-import?import=1" data-testid="sm-import">Import source</a></p>
    </header>
    @if (_error is not null) { <p class="sm-error" role="alert" data-testid="sm-error">@_error</p> }
    @if (_notice is not null) { <p class="sm-notice" role="status" data-testid="sm-notice">@_notice</p> }
    @if (_rows.Count == 0)
    {
        <p class="sm-muted" data-testid="sm-empty">No source packages yet. <a href="project-import?import=1">Import a ZIP or an Azure DevOps repository</a>.</p>
    }
    else
    {
        <ul class="sm-summary" data-testid="sm-summary" aria-label="Source summary">
            <li data-testid="sm-summary-total"><strong>@_rows.Count</strong> source@(_rows.Count == 1 ? "" : "s")</li>
            <li data-testid="sm-summary-zip"><strong>@_rows.Count(r => r.Origin == "ZIP")</strong> ZIP</li>
            <li data-testid="sm-summary-git"><strong>@_rows.Count(r => r.Origin == "Git")</strong> Git</li>
            <li data-testid="sm-summary-review"><strong>@_rows.Count(NeedsReview)</strong> requiring review</li>
            <li data-testid="sm-summary-applications"><strong>@_rows.SelectMany(r => AssociatedApplications(r).Select(a => a.Application)).Distinct(StringComparer.OrdinalIgnoreCase).Count()</strong> associated application@(_rows.SelectMany(r => AssociatedApplications(r).Select(a => a.Application)).Distinct(StringComparer.OrdinalIgnoreCase).Count() == 1 ? "" : "s")</li>
            @foreach (var group in _rows.GroupBy(AnalysisSummary).OrderBy(g => g.Key, StringComparer.Ordinal))
            {
                <li data-testid="sm-summary-analysis" data-status="@group.Key"><strong>@group.Count()</strong> @group.Key.ToLowerInvariant()</li>
            }
        </ul>
        @if (_links.Count > 0)
        {
            <p class="sm-bulk-actions"><button type="button" class="btn-secondary btn-sm" disabled="@(_checkingAll || _busy)" data-testid="sm-check-all" @onclick="CheckAllAsync">
                @(_checkingAll ? "Checking…" : $"Check all linked repositories ({_links.Count})")</button>
                <span class="sm-muted sm-small">Read-only: compares each branch's remote commit with the last imported one. Nothing is imported.</span></p>
            @if (_bulkCheck is not null) { @BulkCheckTable() }
        }
        <div class="sm-table-wrap">
            <table class="sm-table" data-testid="sm-table">
                <thead><tr><th scope="col">Source</th><th scope="col">Origin</th><th scope="col">Capabilities</th><th scope="col">Associated applications</th><th scope="col">Current snapshot</th><th scope="col">Analysis status</th><th scope="col">Last updated</th></tr></thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        var selected = _selectedKey == row.Key;
                        <tr data-testid="sm-row" data-origin="@row.Origin" data-key="@row.Key" class="@(selected ? "sm-row-selected" : null)" aria-selected="@(selected ? "true" : "false")">
                            <th scope="row">
                                <button type="button" class="sm-open" data-testid="sm-open" aria-expanded="@(selected ? "true" : "false")" aria-controls="sm-detail" @onclick="() => Open(row)">@row.Name</button>
                                <div class="sm-muted sm-small" data-testid="sm-roles">@Roles(row)</div>
                            </th>
                            <td><span class="sm-badge sm-badge-@row.Origin.ToLowerInvariant()">@row.Origin</span>@if (row.Link is { } l) { <div class="sm-muted sm-small">@l.Organization / @l.Project · @(l.PinnedCommit is { } p ? $"commit {p[..8]}" : l.Branch)</div> }</td>
                            <td data-testid="sm-capabilities">@CapabilityText(row)</td>
                            <td data-testid="sm-associated">@(AssociatedApplications(row) is { Count: > 0 } apps ? string.Join(", ", apps.Select(a => $"{a.Application} ({a.Environment})")) : "—")</td>
                            <td>@(row.Record?.SourceSnapshotId is { } snap ? snap.ToString()[..8] : "—")@if (row.Record?.Git is { } g) { <div class="sm-muted sm-small">commit @g.ShortSha</div> }</td>
                            <td data-testid="sm-analysis">@AnalysisStatus(row)</td>
                            <td>@(row.Record is { } r ? r.ImportedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm") + " UTC" : "Not imported")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_rows.FirstOrDefault(r => r.Key == _selectedKey) is { } open)
        {
            @Detail(open)
        }
    }
</div>

@code {
    private sealed record Row(string Key, string Name, string Origin, SddProjectImportRecord? Record, GitSourceLink? Link);

    private static readonly PackageEvidenceRole[] RoleChoices = [.. Enum.GetValues<PackageEvidenceRole>().Where(r => r != PackageEvidenceRole.NotClassified)];
    private SddApplicationContext? _application;
    private List<Row> _rows = [];
    private IReadOnlyList<GitSourceLink> _links = [];
    private readonly Dictionary<string, IReadOnlyList<GitSourceMatch>> _matches = new(StringComparer.Ordinal);
    private string? _environmentId, _error, _editing, _notice, _selectedKey;
    private string _tab = "overview";
    private ProjectEvidenceView? _evidence;
    private IProjectEvidenceService? Evidence => Services.GetService(typeof(IProjectEvidenceService)) as IProjectEvidenceService;
    private IFrontendAnalysisSettingsService? Settings => Services.GetService(typeof(IFrontendAnalysisSettingsService)) as IFrontendAnalysisSettingsService;
    private bool _busy;
    // The roles being edited: kept across renders (a set built inside the fragment would be rebuilt, and a ticked role lost, on every re-render).
    private HashSet<string> _draftRoles = new(StringComparer.Ordinal);

    private void ToggleRoleEditor(Row row, bool open = false)
    {
        _editing = open || _editing != row.Key ? row.Key : null;
        _draftRoles = new(SavedRoles(row), StringComparer.Ordinal);
    }

    private static IReadOnlyList<string> SavedRoles(Row row) => row.Link is { Roles.Count: > 0 } l ? l.Roles : row.Record?.ConfirmedRoles ?? [];

    private bool RolesChanged(Row row) => !_draftRoles.SetEquals(SavedRoles(row));

    private IGitSourcesApiService? Git => Services.GetService(typeof(IGitSourcesApiService)) as IGitSourcesApiService;

    protected override async Task OnInitializedAsync()
    {
        try { _environmentId = (await Contexts.GetActiveContextAsync()).ActiveProfileOrNull?.Id; } catch (InvalidOperationException) { }
        if (_environmentId is not null && Git is { } git) _links = (await git.LinksAsync(_environmentId)).Items;
        Build();
        // Capabilities and the active environment's associations come from the shared Project Evidence read (no inference on this page).
        if (Evidence is { } evidence)
        {
            try { _evidence = await evidence.GetAsync(_environmentId); }
            catch (Exception ex) when (ex is not OutOfMemoryException) { _evidence = null; }
        }
    }

    private void Open(Row row)
    {
        _selectedKey = _selectedKey == row.Key ? null : row.Key;
        _tab = "overview";
        _notice = null;
        if (_selectedKey is not null) ToggleRoleEditor(row, open: true);
        else _editing = null;
    }

    private ProjectEvidencePackage? PackageOf(Row row) => row.Record is { } r ? _evidence?.Packages.FirstOrDefault(p => p.ImportId == r.ImportId) : null;

    private PackageAssociation? AssociationOf(Row row) => row.Record is { } r ? _evidence?.Associations.FirstOrDefault(a => a.Package.ImportId == r.ImportId) : null;

    private string CapabilityText(Row row) => PackageOf(row) is { Capabilities.Count: > 0 } p
        ? string.Join(", ", p.Capabilities.Select(c => ProjectEvidencePackages.CapabilityLabel(c.Capability))) : row.Record is null ? "Not imported" : "None detected";

    /// <summary>Applications the source is evidence for: every Target Environment whose Project Evidence references the import (shared records).</summary>
    private IReadOnlyList<(string Application, string Environment)> AssociatedApplications(Row row)
    {
        if (row.Record is not { } record || Settings?.Settings.Profiles is not { } profiles) return [];
        return [.. profiles.Where(p => p.Project?.Evidence.Any(e => e.Sources.Any(s => s.ImportId == record.ImportId)) == true)
            .Select(p => (TargetApplications.Of(p)?.Name ?? p.Project!.ProjectName, p.Name))];
    }

    /// <summary>A decision is open: the active environment's association needs review, or the role is neither confirmed nor classified.</summary>
    private bool NeedsReview(Row row) => AssociationOf(row) is { State: EvidenceAssociationState.NeedsReview }
        || row.Record is { } r && r.ConfirmedRoles.Count == 0 && AssociationOf(row) is { Role: PackageEvidenceRole.NotClassified };

    /// <summary>
    /// Analysis per dimension the package actually contains ("Infrastructure: Analyzed · Docs: Partial") — the same reading as Project Evidence.
    /// The snapshot's own status is the application-code analyzer's outcome only (a Terraform package without application code reads "Failed"
    /// there), so it is never shown as the package's analysis.
    /// </summary>
    private string AnalysisStatus(Row row)
    {
        if (row.Record is null) return "Not imported";
        if (PackageOf(row) is not { } package) return row.Record.SourceSnapshotId is null ? "Not analyzed" : "Analysis not loaded";
        var dimensions = BirkNext.Web.Components.TargetEnvironmentProjectPane.AnalysisDimensions(package);
        return dimensions.Count == 0 ? package.SnapshotId is null ? "Not analyzed" : "Nothing analyzable detected"
            : string.Join(" · ", dimensions.Select(d => $"{d.Label}: {DimensionText(d.Status)}"));
    }

    private static string DimensionText(PackageCapabilityStatus status) => status switch
        { PackageCapabilityStatus.Ready => "Analyzed", PackageCapabilityStatus.Partial => "Partial", _ => "Failed" };

    /// <summary>Summary bucket: every contained dimension analyzed, some only partly (or failed), or nothing analyzed.</summary>
    private string AnalysisSummary(Row row) => PackageOf(row) is { } package && BirkNext.Web.Components.TargetEnvironmentProjectPane.AnalysisDimensions(package) is { Count: > 0 } d
        ? d.All(x => x.Status == PackageCapabilityStatus.Ready) ? "Analyzed" : "Partly analyzed" : "Not analyzed";

    private static readonly (string Key, string Label)[] DetailTabs =
        [("overview", "Overview"), ("roles", "Capabilities & Roles"), ("associations", "Associations"), ("snapshots", "Snapshots"), ("evidence", "Analysis & Evidence"), ("history", "History")];

    private RenderFragment Detail(Row row) => __builder =>
    {
        var association = AssociationOf(row);
        <section id="sm-detail" class="sm-detail" data-testid="sm-detail" data-key="@row.Key" aria-labelledby="sm-detail-title">
            <header class="sm-detail-head">
                <h2 id="sm-detail-title">@row.Name</h2>
                <div class="sm-detail-actions">
                    @if (row.Link is { } link)
                    {
                        <button type="button" class="btn-secondary btn-sm" disabled="@_busy" @onclick="() => CheckAsync(link)" data-testid="sm-check">Check for updates</button>
                        <button type="button" class="btn-secondary btn-sm" disabled="@_busy" @onclick="() => ImportRevision(link)" data-testid="sm-import-revision">@(GitUpdateStates.CommitToImport(link) is { } commit ? $"Import revision {commit[..8]}" : "Import branch head")</button>
                    }
                    else { <a class="btn-secondary btn-sm" href="project-import?import=1" data-testid="sm-upload-version">Upload new version</a> }
                    <button type="button" class="btn-secondary btn-sm" @onclick='() => _tab = "roles"' data-testid="sm-edit-roles">Manage roles</button>
                    <a class="btn-secondary btn-sm" href="@ProjectEvidenceResolver.ProjectTabHref(_environmentId)" data-testid="sm-associate">Associate with application</a>
                    @if (row.Record?.SourceSnapshotId is { } evidence) { <a class="btn-secondary btn-sm" href="@($"source-analysis?snapshot={evidence:D}")" data-testid="sm-evidence">View evidence</a> }
                    <a class="btn-secondary btn-sm" href="snapshots" data-testid="sm-snapshots">View snapshots</a>
                </div>
            </header>
            <div class="sm-tabs" role="tablist" aria-label="@($"{row.Name} details")">
                @foreach (var (key, label) in DetailTabs)
                {
                    <button type="button" role="tab" id="@($"sm-tab-{key}")" aria-selected="@(_tab == key ? "true" : "false")" aria-controls="sm-tabpanel" class="sm-tab"
                            data-testid="sm-tab" data-tab="@key" @onclick="() => SelectTab(row, key)">@label</button>
                }
            </div>
            <div id="sm-tabpanel" role="tabpanel" aria-labelledby="@($"sm-tab-{_tab}")" class="sm-tabpanel" data-testid="sm-tabpanel" data-tab="@_tab">
                @switch (_tab)
                {
                    case "roles":
                        @RoleEditor(row)
                        break;
                    case "associations":
                        var apps = AssociatedApplications(row);
                        @if (apps.Count == 0) { <p class="sm-muted" data-testid="sm-no-associations">Not associated with any application yet. Associate it under Target Environments → Project Evidence.</p> }
                        else { <ul data-testid="sm-association-list">@foreach (var (app, env) in apps) { <li><strong>@app</strong> · @env</li> }</ul> }
                        @if (association is { State: EvidenceAssociationState.NeedsReview or EvidenceAssociationState.NotAssociated } a)
                        {
                            <p class="sm-muted" data-testid="sm-association-why">Active environment: @a.StateLabel — @a.Detail</p>
                        }
                        <a href="@ProjectEvidenceResolver.ProjectTabHref(_environmentId)" data-testid="sm-associate-link">Review associations in Project Evidence</a>
                        break;
                    case "snapshots":
                        <p>Current snapshot: @(row.Record?.SourceSnapshotId is { } current ? current.ToString() : "none")@if (row.Record?.Git is { } git) { <span> · commit @git.ShortSha</span> }</p>
                        <a href="snapshots" data-testid="sm-snapshots-link">Open the Snapshot Registry</a>
                        break;
                    case "evidence":
                        <p data-testid="sm-analysis-detail">Analysis: @AnalysisStatus(row)</p>
                        <p>Capabilities (from its content): @CapabilityText(row)</p>
                        @if (row.Record?.SourceSnapshotId is { } snapshot) { <a href="@($"source-analysis?snapshot={snapshot:D}")">Open Source Analysis</a> }
                        break;
                    case "history":
                        @if (row.Link is { } historyLink)
                        {
                            <p class="sm-muted">Earlier ZIP imports that may be this repository. Names alone are never evidence; you decide.</p>
                            <button type="button" class="btn-secondary btn-sm" disabled="@_busy" @onclick="() => MatchesAsync(historyLink)" data-testid="sm-matches">Find earlier imports</button>
                            @if (_matches.TryGetValue(historyLink.Id, out var matches)) { @MatchList(historyLink, matches) }
                        }
                        else { <p class="sm-muted">Imported @(row.Record?.ImportedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm") ?? "—") UTC from @(row.Record?.ArchiveFileName ?? "a ZIP"). Upload a newer ZIP to add a revision.</p> }
                        break;
                    default:
                        <dl class="sm-overview">
                            <dt>Origin</dt><dd>@row.Origin@if (row.Link is { } l) { <span> · @l.Organization / @l.Project / @l.Repository · @(l.PinnedCommit ?? l.Branch)</span> }</dd>
                            <dt>Roles</dt><dd>@Roles(row)</dd>
                            <dt>Capabilities</dt><dd>@CapabilityText(row)</dd>
                            <dt>Updates</dt><dd data-testid="sm-updates">@Updates(row)</dd>
                            <dt>Analysis</dt><dd>@AnalysisStatus(row)</dd>
                        </dl>
                        break;
                }
            </div>
        </section>
    };

    private void SelectTab(Row row, string key)
    {
        _tab = key;
        if (key == "roles" && _editing != row.Key) ToggleRoleEditor(row, open: true);
    }

    /// <summary>
    /// Rows: each import record of the current application (its origin from its own provenance — a ZIP never becomes Git), joined to the link of the
    /// repository it came from by organization + repository id; then linked repositories not imported yet.
    /// </summary>
    private void Build()
    {
        _application = Activation.CurrentApplication;
        var records = _application is null ? Activation.Imports : ApplicationContexts.Imports(Activation.Lifecycle, _application.Id);
        var rows = records.Select(r => new Row(r.ImportId, r.ProjectName, r.Git is null ? "ZIP" : "Git", r,
            r.Git is { } g ? _links.FirstOrDefault(l => string.Equals(l.Organization, g.Organization, StringComparison.OrdinalIgnoreCase) && l.RepositoryId == g.RepositoryId) : null)).ToList();
        rows.AddRange(_links.Where(l => rows.All(r => r.Link?.Id != l.Id)).Select(l => new Row(l.Id, l.Repository, "Git", null, l)));
        _rows = rows;
    }

    private static string Roles(Row row)
    {
        var confirmed = row.Link is { Roles.Count: > 0 } link ? link.Roles : row.Record?.ConfirmedRoles ?? [];
        return confirmed.Count > 0 ? string.Join(", ", confirmed.Select(Label)) + " · confirmed" : "Detected from content";
    }

    private static string Label(string role) => Enum.TryParse<PackageEvidenceRole>(role, out var r) ? ApplicationContexts.RoleLabel(r) : role;

    /// <summary>The shared update state (GitUpdateStates) in words, with the commit or the reason. Compared by commit, never by timestamp.</summary>
    private static string Updates(Row row)
    {
        if (row.Link is not { } link) return "Upload a newer ZIP to update";
        var state = GitUpdateStates.Of(link);
        return state switch
        {
            GitUpdateState.UpdateAvailable => $"Update available ({link.LastCheck!.RemoteCommit?[..8]})",
            GitUpdateState.UpToDate => $"Up to date ({link.LastCheck!.CheckedAt.UtcDateTime:yyyy-MM-dd HH:mm} UTC)",
            GitUpdateState.NotImported => $"Not imported — remote {link.LastCheck!.RemoteCommit?[..8]}",
            GitUpdateState.NotChecked => "Not checked",
            _ => $"{GitUpdateStates.Label(state)}{(link.LastCheck?.Problem is { } problem ? $" — {problem}" : "")}",
        };
    }

    // ── "Check all linked repositories": read-only, a few at a time; each row keeps its own outcome (partial success is normal) ───────────

    private bool _checkingAll;
    private IReadOnlyList<(GitSourceLink Link, string? Error)>? _bulkCheck;
    private const int CheckConcurrency = 3;

    private async Task CheckAllAsync()
    {
        if (Git is not { } git || _environmentId is null || _links.Count == 0) return;
        (_checkingAll, _error, _bulkCheck) = (true, null, null);
        var gate = new SemaphoreSlim(CheckConcurrency);
        var results = await Task.WhenAll(_links.Select(async link =>
        {
            await gate.WaitAsync();
            try
            {
                var (updated, error) = await git.CheckAsync(link.Id, _environmentId);
                return (Link: updated ?? link, Error: updated is null ? error ?? "The check failed." : null);
            }
            finally { gate.Release(); }
        }));
        _links = [.. _links.Select(l => results.FirstOrDefault(r => r.Link.Id == l.Id) is { Link: { } r } && r.Id == l.Id ? r : l)];
        _bulkCheck = results;
        _checkingAll = false;
        Build();
    }

    private RenderFragment BulkCheckTable() => __builder =>
    {
        <div class="sm-table-wrap" data-testid="sm-bulk-check">
            <table class="sm-table">
                <caption class="sm-muted sm-small">Checked @_bulkCheck!.Count linked repositor@(_bulkCheck.Count == 1 ? "y" : "ies") — nothing was imported, no snapshot was created.</caption>
                <thead><tr><th scope="col">Azure DevOps project</th><th scope="col">Repository</th><th scope="col">Branch</th><th scope="col">Imported revision</th><th scope="col">Remote revision</th><th scope="col">Status</th></tr></thead>
                <tbody>
                    @foreach (var (link, error) in _bulkCheck)
                    {
                        var state = GitUpdateStates.Of(link);
                        <tr data-testid="sm-bulk-row" data-state="@state">
                            <td>@link.Project</td><th scope="row">@link.Repository</th><td>@(link.PinnedCommit is { } p ? $"commit {p[..8]}" : link.Branch)</td>
                            <td>@(link.LastImport?.CommitSha is { } imported ? imported[..8] : "—")</td>
                            <td>@(link.LastCheck?.RemoteCommit is { } remote ? remote[..8] : "—")</td>
                            <td>@(error ?? GitUpdateStates.Label(state))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    };

    private async Task CheckAsync(GitSourceLink link)
    {
        if (Git is not { } git || _environmentId is null) return;
        (_busy, _error) = (true, null);
        var (updated, error) = await git.CheckAsync(link.Id, _environmentId);
        _busy = false;
        if (updated is null) { _error = error; return; }
        _links = [.. _links.Select(l => l.Id == updated.Id ? updated : l)];
        Build();
    }

    /// <summary>Imports the link's revision (pinned commit or branch head) through the normal Project Import review.</summary>
    private void ImportRevision(GitSourceLink link)
    {
        if (Git is not { } git) return;
        // The revision the person reviewed: the commit the last check reported (or the pinned one) — a branch that moved since is never imported
        // silently; without a check, the branch head at import time (shown as the branch).
        var commit = GitUpdateStates.CommitToImport(link);
        var request = new GitImportRequest(link.RepositoryId, link.Branch) { OrganizationUrl = link.OrganizationUrl, Commit = commit };
        _ = Session.StartGitPreviewAsync($"{link.Repository} @ {commit?[..8] ?? link.Branch}", ct => git.ImportAsync(request, ct), null);
        Nav.NavigateTo("project-import");
    }

    private async Task MatchesAsync(GitSourceLink link)
    {
        if (Git is not { } git || _environmentId is null) return;
        (_busy, _error) = (true, null);
        var (items, error) = await git.MatchesAsync(link.Id, _environmentId);
        _busy = false;
        if (error is not null) { _error = error; return; }
        _matches[link.Id] = items;
    }

    private async Task DecideAsync(GitSourceLink link, Guid snapshot, bool associate)
    {
        if (Git is not { } git || _environmentId is null) return;
        var (updated, error) = await git.DecideAsync(link.Id, _environmentId, new GitAssociationRequest(snapshot, associate));
        if (updated is null) { _error = error; return; }
        _links = [.. _links.Select(l => l.Id == updated.Id ? updated : l)];
        Build();
        await MatchesAsync(updated);
    }

    private async Task SaveRolesAsync(Row row, HashSet<string> roles)
    {
        _error = null;
        if (row.Link is { } link && Git is { } git && _environmentId is not null)
        {
            var (updated, error) = await git.LinkAsync(new GitLinkRequest(link.OrganizationUrl, link.RepositoryId, link.Branch, link.PinnedCommit, [.. roles], _environmentId, link.BirkNextProject));
            if (updated is null) { _error = error; return; }
            _links = [.. _links.Select(l => l.Id == updated.Id ? updated : l)];
        }
        // The import record holds the canonical role every consumer reads (Project Evidence associations, explorers); a linked repository's
        // imported revision gets the same roles, so the two never disagree.
        if (row.Record is { } record)
        {
            record.ConfirmedRoles = [.. roles];
            if (Services.GetService(typeof(IWorkspaceAutoSaveService)) is IWorkspaceAutoSaveService autoSave && !await autoSave.SaveNowAsync()) _error = "The roles could not be saved durably; try again.";
            (Services.GetService(typeof(BirkNext.Web.Services.ProjectEvidence.IProjectEvidenceService)) as BirkNext.Web.Services.ProjectEvidence.IProjectEvidenceService)?.Invalidate();
        }
        if (_error is null) _notice = $"Roles of {row.Name} saved. Project Evidence and every review use them; associations you confirmed per application are unchanged.";
        Build();
        _draftRoles = new(roles, StringComparer.Ordinal);
        _tab = "overview";
        if (Evidence is { } evidence)
        {
            try { _evidence = await evidence.GetAsync(_environmentId, refresh: true); } catch (Exception ex) when (ex is not OutOfMemoryException) { }
        }
    }

    private RenderFragment RoleEditor(Row row) => __builder =>
    {
        var current = _draftRoles;
        var association = AssociationOf(row);
        <div class="sm-role-panel" data-testid="sm-role-editor">
            <p><strong>Detected capabilities</strong> (from the content, read-only): <span data-testid="sm-detected">@CapabilityText(row)</span></p>
            @if (association is { } a && a.Role != PackageEvidenceRole.NotClassified)
            {
                <p class="sm-muted" data-testid="sm-role-why">Detected role: @ApplicationContexts.RoleLabel(a.Role)@(a.RoleConfirmed ? " (confirmed)" : " — from its content")</p>
            }
            <fieldset class="sm-roles"><legend>Assigned roles — several allowed; none = the role detected from content</legend>
                @foreach (var role in RoleChoices)
                {
                    <label><input type="checkbox" checked="@current.Contains(role.ToString())" @onchange="e => { if ((bool)e.Value!) current.Add(role.ToString()); else current.Remove(role.ToString()); }" data-testid="sm-role" data-role="@role" /> @ApplicationContexts.RoleLabel(role)</label>
                }
            </fieldset>
            <p class="sm-muted sm-small">A role says what this source is; the application it is evidence for is chosen per Target Environment in Project Evidence (unchanged here).</p>
            @if (RolesChanged(row)) { <p class="sm-unsaved" role="status" data-testid="sm-unsaved">Unsaved role changes.</p> }
            <div class="sm-role-actions">
                <button type="button" class="btn-primary btn-sm" disabled="@(!RolesChanged(row))" @onclick="() => SaveRolesAsync(row, current)" data-testid="sm-save-roles">Save roles</button>
                <button type="button" class="btn-secondary btn-sm" disabled="@(!RolesChanged(row))" @onclick="() => ToggleRoleEditor(row, open: true)" data-testid="sm-reset-roles">Discard changes</button>
            </div>
        </div>
    };

    private RenderFragment MatchList(GitSourceLink link, IReadOnlyList<GitSourceMatch> matches) => __builder =>
    {
        <div class="sm-matches" data-testid="sm-match-list">
            @if (matches.Count == 0) { <p class="sm-muted">No earlier import appears to be this repository (names alone are never evidence).</p> }
            @foreach (var m in matches)
            {
                <div class="sm-match" data-testid="sm-match" data-strength="@m.Strength">
                    <strong>@(m.Strength switch { GitSourceMatchStrength.SameContent => "Same content", GitSourceMatchStrength.SameCommit => "Same commit", _ => "Possible existing imported source" })</strong>
                    · @m.ArchiveFileName · snapshot @m.SnapshotId.ToString()[..8] · @string.Join(" ", m.Evidence)
                    @if (m.Decision is { } decision) { <span class="sm-badge">@decision</span> }
                    <button type="button" class="btn-secondary btn-sm" @onclick="() => DecideAsync(link, m.SnapshotId, true)" data-testid="sm-associate-match">Associate with this repository</button>
                    <button type="button" class="btn-secondary btn-sm" @onclick="() => DecideAsync(link, m.SnapshotId, false)" data-testid="sm-keep-separate">Keep separate</button>
                    <a class="btn-secondary btn-sm" href="@($"source-analysis?snapshot={m.SnapshotId:D}")">Review evidence</a>
                </div>
            }
        </div>
    };
}
