@page "/source-analysis"
@using BirkNext.Web.Services
@using BirkNext.Web.Components
@using BirkNext.Web.Models
@using Microsoft.AspNetCore.Components.Forms
@using BirkNext.Integrations
@using BirkNext.SourceDomains
@using BirkNext.Web.Components.SourceDomains
@using BirkNext.Web.Services.ProjectImport
@inject IIntegrationCatalogApiService Api
@inject IFrontendAnalysisContextFactory ContextFactory
@inject ProjectApplicabilityState Applicability
@inject ICurrentWorkspaceProjection CurrentWorkspace
@inject SourceAnalysisSnapshotState SnapshotState
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IServiceProvider ServiceProvider

@* Source Analysis: one selected stored source snapshot drives four areas (Overview, Architecture, Data, Quality Evidence), so no summary can mix
   snapshots. Review decisions come first (status + reason, things needing attention); analyzer output, provenance and limitations are one
   disclosure away. Opening it never re-analyzes. Source only: nothing live is contacted. *@
<PageTitle>Source Analysis</PageTitle>
<div class="sa-page">
    <PageHeader Title="Source Analysis" Description="What the source shows: architecture, data design and quality evidence from a stored source snapshot." />
    @if (ReturnTarget is { } back)
    {
        <p class="sa-return" data-testid="sa-return"><a href="@back.Route" data-testid="sa-return-link">Back to @back.Label</a> <span class="sa-muted">— snapshots analyzed here can be chosen there.</span></p>
    }
    @* Source snapshots need no Target Environment: a target is runtime context, so it is shown here, never required. *@
    @if (!_loaded)
    {
        <p class="sa-safety" role="note" data-testid="sa-safety">@SourceAnalysisOverview.SafetyNote</p>
        <p class="sa-muted" role="status">Loading source snapshots…</p>
    }
    else
    {
        @* One compact evidence-mode context: everything below is source only. The explanation of statuses and runtime-dependent evidence is one
           disclosure away. The source snapshot belongs to the workspace; the Target Environment is runtime context for other reviews. *@
        <section class="sa-context" aria-label="Evidence context" data-testid="sa-target-context">
            <dl class="sa-context-facts">
                <div><dt>Evidence mode</dt><dd data-testid="sa-evidence-mode">Source only</dd></div>
                <div><dt>Snapshot</dt><dd data-testid="sa-source-state">@SourceStateSummary</dd></div>
                <div><dt>Runtime verification</dt><dd data-testid="sa-runtime-verification">Not performed here</dd></div>
                <div><dt>Target Environment</dt><dd data-testid="sa-target-state">@(_profile is null ? "Not selected" : "Selected")</dd></div>
            </dl>
            <p class="sa-safety" role="note" data-testid="sa-safety">@SourceAnalysisOverview.SafetyNote</p>
            <ReviewDisclosure Text="How to read statuses" CollapseText="Hide status guide" TestId="sa-status-legend" Class="disclosure-inline">
                <div class="sa-muted sa-status-guide" data-testid="sa-status-guide">
                    <p>Source Analysis describes evidence in the selected source snapshot.</p>
                    <p><strong>Not found in source</strong> means no supporting evidence was detected here. It does not prove the capability is absent at runtime.</p>
                    <p><strong>Partial</strong> means useful evidence was produced, but analysis coverage is incomplete — not a failure.</p>
                    <p><strong>Inferred</strong> means a relationship or value was derived indirectly and is not direct source proof.</p>
                    <p data-testid="sa-runtime-dependent">Runtime and deployment state are not assessed here. Runtime-dependent evidence is @(_profile is null ? "not available here — select a Target Environment for runtime reviews" : "available to runtime reviews, never to Source Analysis").</p>
                </div>
                <dl class="sa-legend" data-testid="sa-status-legend-list">
                    @foreach (var (dimension, examples) in StatusLegend)
                    {
                        <div data-dimension="@dimension">
                            <dt>@SourceStatusPresentation.DimensionLabel(dimension)</dt>
                            <dd>@foreach (var example in examples) { <SourceStatusBadge Dimension="dimension" Label="@example" /> } <span>@SourceStatusPresentation.DimensionHelp(dimension)</span></dd>
                        </div>
                    }
                </dl>
            </ReviewDisclosure>
        </section>
        var selected = _busy ? null : _snapshots.FirstOrDefault(s => s.Id.ToString() == _selected);
        <section class="sa-card sa-snapshot-bar" aria-labelledby="sa-snapshot-heading" data-testid="sa-snapshot-bar">
            <div class="sa-snapshot-head">
                <h2 id="sa-snapshot-heading">Current snapshot</h2>
                @if (selected is not null)
                {
                    <p class="sa-current-title" data-testid="sa-current" data-snapshot="@selected.Id">
                        <strong data-testid="sa-current-archive">@selected.Archive.FileName</strong>
                        <span class="sa-muted"><span data-testid="sa-current-files">@selected.Archive.FilesAnalyzed</span> files · Analyzed <span data-testid="sa-current-analyzed">@SourceAnalysisOverview.Utc(selected.AnalyzedAt)</span></span>
                    </p>
                }
            </div>
            @if (selected is not null)
            {
                var coverage = SourceAnalysisReview.Coverage(selected);
                <div class="sa-coverage" data-testid="sa-coverage" data-status="@coverage.Status">
                    <p class="sa-coverage-head"><span class="sa-muted">Analysis coverage</span>
                        <SourceStatusBadge Dimension="SourceStatusDimension.Completeness" Label="@coverage.Status" HiddenPrefix="Analysis coverage: " TestId="sa-current-evidence" /></p>
                    @if (coverage.Status != "Complete")
                    {
                        <ul class="sa-coverage-reasons" aria-label="Why the analysis coverage is @coverage.Status.ToLowerInvariant()" data-testid="sa-coverage-reasons">
                            @foreach (var reason in coverage.Reasons) { <li data-testid="sa-coverage-reason">@reason</li> }
                        </ul>
                        <p class="sa-muted">Partial is not an analysis failure: every area below shows the evidence that was produced.</p>
                    }
                    @if (coverage.Limitations.Count > 0)
                    {
                        <ReviewDisclosure Text="@($"View limitations ({coverage.Limitations.Count})")" CollapseText="Hide limitations" TestId="sa-coverage-limitations" Class="disclosure-small">
                            <ul class="sa-list" data-testid="sa-coverage-limitation-list">@foreach (var l in coverage.Limitations) { <li>@l</li> }</ul>
                        </ReviewDisclosure>
                    }
                </div>
            }
            <div class="sa-controls">
                <label class="sa-field">Change snapshot
                    <select id="sa-snapshot-select" class="form-control" @bind="_selected" @bind:after="SnapshotChanged" data-testid="source-snapshot" disabled="@(_busy || _snapshots.Count == 0)">
                        <option value="">@(_snapshots.Count == 0 ? "No stored snapshot yet" : "Select a source snapshot")</option>
                        @foreach (var snapshot in _snapshots) { <option value="@snapshot.Id">@SourceAnalysisOverview.OptionLabel(snapshot)</option> }
                    </select>
                </label>
                @* Import Project is the recommended path; a source-only upload stays available. Without a snapshot these actions are offered once,
                   in the empty state below. *@
                @if (!NoSnapshotSelected)
                {
                    <div class="sa-upload-group">
                        <a class="btn-secondary sa-secondary-action" href="project-import" data-testid="sa-import-project">Import project</a>
                        <label class="btn-secondary sa-secondary-action sa-file-label">
                            <InputFile class="sa-file-input" accept=".zip" OnChange="Upload" disabled="@_busy" aria-label="Upload source only (.zip, maximum 50 MB)" data-testid="sa-upload" />
                            <span aria-hidden="true">Upload source</span>
                        </label>
                        <span class="sa-muted sa-helper">ZIP · maximum 50 MB</span>
                    </div>
                }
            </div>
            @if (selected is not null)
            {
                <ReviewDisclosure Text="View snapshot details" CollapseText="Hide snapshot details" TestId="sa-snapshot-details" Class="disclosure-small">
                    <dl class="sa-facts sa-facts-compact" data-testid="sa-snapshot-facts">
                        <div><dt>Fingerprint</dt><dd><code class="sa-mono" data-testid="sa-current-fingerprint" title="@selected.Archive.Sha256">@selected.Archive.Sha256</code></dd></div>
                        <div><dt>Commit</dt><dd>@selected.Commit@(selected.Branch is { } branch ? $" · {branch}" : "")</dd></div>
                        <div><dt>Created by</dt><dd data-testid="sa-current-origin">@(selected.ProjectImport is { } import ? $"Project Import · {SourceAnalysisOverview.Utc(import.ImportedAt)}" : "Source-only upload")</dd></div>
                        <div><dt>Analyzed</dt><dd>@selected.AnalyzedAt.ToString("u")</dd></div>
                        <div><dt>Analyzer version</dt><dd>@selected.AnalyzerVersion@(selected.Architecture is { } av ? $" · architecture v{av.AnalyzerVersion}" : "")@(selected.DatabaseArchitecture is { } dv ? $" · database v{dv.AnalyzerVersion}" : "")</dd></div>
                        <div><dt>Snapshot id</dt><dd><code class="sa-mono">@selected.Id</code></dd></div>
                    </dl>
                    @if (selected.ProjectImport is { } provenance)
                    {
                        <p class="sa-muted" data-testid="sa-import-provenance" data-import="@provenance.ImportId">
                            Created from Project Import <code class="sa-mono">@provenance.ImportId</code> — the same archive the project documents were imported from.
                            <a href="project-import" data-testid="sa-import-link">View the imported project</a>
                        </p>
                    }
                </ReviewDisclosure>
            }
            @if (_busy) { <p class="sa-status" role="status" data-testid="sa-analyzing">Analyzing source… The architecture and database are extracted from the archive.</p> }
            @if (_error is { } uploadFailure)
            {
                <section class="sa-error-card" role="alert" aria-labelledby="sa-error-heading" data-testid="sa-error">
                    <h3 id="sa-error-heading">@UploadErrorTitle(uploadFailure)</h3>
                    <p>@uploadFailure.Message</p>
                    @if (!string.IsNullOrWhiteSpace(uploadFailure.EntryPath)) { <p class="sa-error-path"><strong>Archive entry:</strong> <code>@uploadFailure.EntryPath</code></p> }
                    <p><strong>What to do:</strong> @uploadFailure.Guidance</p>
                    <details class="sa-error-details">
                        <summary>Technical details</summary>
                        <dl>
                            <div><dt>Error code</dt><dd><code>@uploadFailure.Code</code></dd></div>
                            <div><dt>Stage</dt><dd>@uploadFailure.StageLabel</dd></div>
                            @if (uploadFailure.Actual is { } actual) { <div><dt>Observed</dt><dd>@FormatUploadValue(uploadFailure.Code, actual)</dd></div> }
                            @if (uploadFailure.Limit is { } limit) { <div><dt>Limit</dt><dd>@FormatUploadValue(uploadFailure.Code, limit)</dd></div> }
                        </dl>
                    </details>
                </section>
            }
        </section>

        @if (_busy)
        {
            <section class="sa-card sa-progress" aria-labelledby="sa-progress-heading" data-testid="sa-analyzing-areas">
                <h2 id="sa-progress-heading">Analysis in progress</h2>
                <dl class="sa-facts">
                    <div><dt>Source snapshot</dt><dd data-testid="sa-progress-archive">@(_pendingArchive ?? "Uploaded archive")</dd></div>
                    <div><dt>Architecture</dt><dd><span class="sa-pill sa-pill-muted">Analyzing</span></dd></div>
                    <div><dt>Data</dt><dd><span class="sa-pill sa-pill-muted">Analyzing</span></dd></div>
                    <div><dt>Quality evidence</dt><dd><span class="sa-pill sa-pill-muted">Analyzing</span> <span class="sa-muted">Observability · Infrastructure · Configuration · CI/CD · Contracts</span></dd></div>
                </dl>
                <p class="sa-muted">The uploaded archive is being analyzed. @SourceAnalysisOverview.SafetyNote</p>
            </section>
        }
        else if (selected is null)
        {
            <section class="sa-card sa-empty" aria-labelledby="sa-empty-heading" data-testid="sa-empty">
                <span class="sa-empty-icon" aria-hidden="true"></span>
                <div class="sa-empty-body">
                    <h2 id="sa-empty-heading">@EmptyHeading</h2>
                    @if (EmptyReason is { } reason)
                    {
                        <p class="sa-empty-reason" role="status" data-testid="sa-empty-reason" data-reason="@reason.Kind">@reason.Text</p>
                        @if (reason.CanRetry || reason.ImportLink)
                        {
                            <p class="sa-empty-reason-actions">
                                @if (reason.CanRetry) { <button type="button" class="btn-primary" data-testid="sa-retry-import-snapshot" disabled="@_retryingImport" @onclick="RetryImportSnapshotAsync">@(_retryingImport ? "Retrying…" : "Retry creating source snapshot")</button> }
                                @if (reason.ImportLink) { <a href="project-import" data-testid="sa-empty-reason-import">Open Import Project</a> }
                            </p>
                        }
                        @if (_retryImportMessage is { } retryMessage) { <p class="sa-empty-reason" role="alert" data-testid="sa-retry-import-message">@retryMessage</p> }
                    }
                    <p>Import the project (one ZIP for documents and source), upload a source-only archive, or choose an existing snapshot to explore:</p>
                    <ul class="sa-preview" data-testid="sa-preview">
                        <li><strong>Architecture</strong> — components, dependencies, messaging channels, datastores and external systems found in source.</li>
                        <li><strong>Data</strong> — database candidates, tables/entities, relationships and indexes from EF models, migrations and SQL.</li>
                        <li><strong>Quality evidence</strong> — observability, infrastructure as code, configuration, CI/CD pipelines and contracts.</li>
                        <li><strong>Snapshot changes</strong> — compare an analysis with another stored snapshot of the source.</li>
                    </ul>
                    <dl class="sa-actions sa-action-list" data-testid="sa-empty-actions">
                        <div>
                            <dt>Recommended</dt>
                            <dd><a class="sa-file-button sa-file-primary" href="project-import" data-testid="sa-empty-import-project">Import Project</a> <span class="sa-muted">one ZIP for project documents and source</span></dd>
                        </div>
                        <div>
                            <dt>Advanced</dt>
                            <dd>
                                <label class="sa-file-button">
                                    <InputFile class="sa-file-input" accept=".zip" OnChange="Upload" disabled="@_busy" aria-label="Upload source only (ZIP, maximum 50 MB)" data-testid="sa-empty-upload" />
                                    <span aria-hidden="true">Upload source only</span>
                                </label>
                                <span class="sa-muted">ZIP · maximum 50 MB</span>
                            </dd>
                        </div>
                        <div>
                            <dt>Existing</dt>
                            <dd>
                                <button type="button" class="btn-secondary" data-testid="sa-choose-existing" disabled="@(_snapshots.Count == 0)" aria-describedby="@(_snapshots.Count == 0 ? "sa-no-snapshots" : null)" @onclick="FocusSelectorAsync">Choose existing snapshot</button>
                                @if (_snapshots.Count == 0) { <span class="sa-muted" id="sa-no-snapshots">No stored snapshot yet.</span> }
                            </dd>
                        </div>
                    </dl>
                </div>
            </section>
        }
        else
        {
            @* Exactly four top-level areas, as real links (?area= deep links); the current one carries aria-current="page". *@
            <nav class="sa-areas" aria-label="Source Analysis areas" data-testid="sa-areas">
                <ul class="sa-area-list">
                    @foreach (var area in SourceAnalysisAreas.Top)
                    {
                        <li><a id="@($"sa-area-{AreaSlug(area)}")" class="sa-area-tab" href="@AreaHref(area)" aria-current="@(_area == area ? "page" : null)"
                               data-testid="@($"area-{AreaSlug(area).ToLowerInvariant()}")" @onclick="() => OpenArea(area)" @onclick:preventDefault>@area</a></li>
                    }
                </ul>
            </nav>
            @if (_area == SourceAnalysisAreas.Overview)
            {
                var reviewAreas = SourceAnalysisReview.ReviewAreas(selected);
                var limitations = SourceAnalysisReview.Limitations(selected);
                <section class="sa-card sa-summary" aria-labelledby="sa-current-heading" data-testid="sa-overview-summary">
                    <h2 id="sa-current-heading" tabindex="-1">Analysis summary</h2>
                    <ul class="sa-summary-rows" data-testid="sa-summary-rows">
                        @foreach (var row in SourceAnalysisReview.CoreRows(selected)) { @SummaryRow(row) }
                    </ul>
                    <h3 class="sa-summary-subheading">Quality evidence</h3>
                    <ul class="sa-summary-rows sa-summary-rows-compact" data-testid="sa-evidence-rows">
                        @foreach (var row in SourceAnalysisReview.EvidenceRows(selected)) { @SummaryRow(row) }
                    </ul>
                </section>
                <section class="sa-card sa-attention" aria-labelledby="sa-attention-heading" data-testid="sa-attention">
                    <h2 id="sa-attention-heading">Review needed <span class="sa-count" data-testid="sa-attention-count">@SourceAnalysisReview.Plural(reviewAreas.Count, "area", "areas")</span></h2>
                    @if (reviewAreas.Count == 0) { <p class="sa-muted" data-testid="sa-attention-none">Nothing in this snapshot needs review.</p> }
                    else
                    {
                        <p class="sa-muted" data-testid="sa-attention-note">Evidence worth a look, per area. These are analyzer results of different kinds — unresolved source relationships, declarations to interpret, classification gaps and heuristic parses — not application defects, so they are not added together.</p>
                        <ul class="sa-attention-list">
                            @foreach (var (areaTitle, items) in reviewAreas)
                            {
                                @foreach (var item in items)
                                {
                                    <li data-testid="sa-attention-item" data-key="@item.Key" data-area="@areaTitle"><span class="sa-attention-area">@areaTitle</span> <span>@item.Text</span> <a href="@ReviewHref(item.Area, item.Domain)" @onclick="() => OpenReview(item.Area, item.Domain, item.View)" @onclick:preventDefault>Review<span class="visually-hidden">@(" " + areaTitle + ": " + item.Text)</span></a></li>
                                }
                            }
                        </ul>
                        <p class="sa-muted">Review opens the area; nothing is confirmed or accepted automatically.</p>
                    }
                    <div class="sa-actions" data-testid="sa-overview-actions">
                        <button type="button" class="btn-primary" data-testid="sa-review-architecture" @onclick="() => OpenReview(SourceAnalysisAreas.Architecture, null, null)">Review architecture</button>
                        <button type="button" class="btn-secondary" data-testid="sa-review-data" @onclick="() => OpenReview(SourceAnalysisAreas.Data, null, null)">Review data</button>
                        <button type="button" class="btn-secondary" data-testid="sa-review-observability" @onclick='() => OpenReview(SourceAnalysisAreas.Quality, "Observability", null)'>Review observability</button>
                    </div>
                    <ReviewDisclosure Text="@($"Analyzer limitations ({limitations})")" CollapseText="Hide analyzer limitations" TestId="sa-analyzer-limitations" Class="disclosure-small">
                        <p class="sa-muted">What the analyzers could not interpret with certainty. Limitations of source analysis — not application defects. Each area lists its own under Analyzer details.</p>
                    </ReviewDisclosure>
                </section>
                @if (selected.EvidenceDomains is { } evidence)
                {
                    var summary = SourceEvidenceDomainsPresentation.LinkSummary(evidence.CrossDomain);
                    <ReviewDisclosure Text="@($"View cross-source relationships ({evidence.CrossDomain.Links.Count})")" CollapseText="Hide cross-source relationships" TestId="sa-cross-domain-disclosure" Class="disclosure-small">
                        <section class="sa-card" aria-labelledby="sa-links-heading" data-testid="sa-cross-domain">
                            <h3 id="sa-links-heading">Cross-source relationships <SourceStatusBadge Dimension="SourceStatusDimension.Completeness" Label="@SourceDomainText.Label(evidence.CrossDomain.Status)" TestId="sa-cross-domain-status" /></h3>
                            @if (evidence.CrossDomain.Status == SourceDomainStatus.Complete) { <p class="sa-muted" data-testid="sa-cross-domain-scope">Relationship matching complete for this snapshot — every supported matching pass ran over this source. It does not establish completeness for the whole project.</p> }
                            @if (summary.Count == 0) { <p class="sa-muted" data-testid="sa-cross-domain-empty">@(evidence.CrossDomain.StatusReason ?? "No relationships between the source-evidence domains of this snapshot.")</p> }
                            else
                            {
                                <div class="sd-scroll" tabindex="0" role="region" aria-label="Cross-source relationships">
                                    <table class="sd-links-table" data-testid="sa-cross-domain-table">
                                        <thead><tr><th scope="col">Relationship</th><th scope="col">Linked</th><th scope="col">Unresolved</th></tr></thead>
                                        <tbody>@foreach (var s in summary) { <tr data-testid="sa-cross-domain-row" data-type="@s.Type"><th scope="row">@s.Label</th><td>@s.Linked</td><td>@s.Unresolved</td></tr> }</tbody>
                                    </table>
                                </div>
                                <p class="sa-muted">Unresolved means no matching declaration was found in the selected source — it may be managed elsewhere. It is not a failure.</p>
                                <ReviewDisclosure Text="@($"View relationships ({evidence.CrossDomain.Links.Count})")" CollapseText="Hide relationships" TestId="sa-cross-domain-links" Class="disclosure-inline">
                                    <div class="sd-scroll" tabindex="0" role="region" aria-label="Relationship details">
                                        <table>
                                            <thead><tr><th scope="col">From</th><th scope="col">To</th><th scope="col">Evidence</th><th scope="col">Basis</th></tr></thead>
                                            <tbody>@foreach (var l in evidence.CrossDomain.Links.Take(300)) { <tr data-testid="sa-cross-domain-link" data-resolved="@(l.Resolved ? "true" : "false")"><th scope="row">@l.FromLabel<span class="sd-context">@SourceDomainText.Label(l.Type)</span></th><td>@l.ToLabel</td><td><SourceStatusBadge Dimension="SourceStatusDimension.Confidence" Label="@SourceDomainText.Label(l.State)" /></td><td>@l.Basis</td></tr> }</tbody>
                                        </table>
                                    </div>
                                </ReviewDisclosure>
                                @if (evidence.CrossDomain.EnvironmentMappings.Count > 0)
                                {
                                    <p class="sa-muted" data-testid="sa-environment-mappings">Environments across formats: @string.Join(" · ", evidence.CrossDomain.EnvironmentMappings.Select(m => $"{m.Kind} ({SourceDomainText.Label(m.State)})"))</p>
                                }
                            }
                        </section>
                        <BirkNext.Web.Components.GeneratedDocumentation.GeneratedDocumentationSourceSummary Snapshot="selected" />
                    </ReviewDisclosure>
                }
            }
            else if (_area == SourceAnalysisAreas.Quality)
            {
                <SourceViewNav Label="Quality evidence domains" Views="SourceAnalysisAreas.QualityDomains" Current="@(_domain ?? "")" CurrentChanged="OpenDomain" Prefix="sa-quality" Slug="SourceAnalysisAreas.Slug" TestId="sa-quality-nav" />
                @if (_domain is null)
                {
                    <section class="sa-card" aria-labelledby="sa-quality-heading" data-testid="sa-quality-landing">
                        <h2 id="sa-quality-heading" tabindex="-1">Quality evidence</h2>
                        <ul class="sa-summary-rows" data-testid="sa-quality-rows">
                            @foreach (var row in SourceAnalysisReview.QualityRows(selected)) { @SummaryRow(row, true) }
                        </ul>
                    </section>
                }
                else if (_domain == "Observability")
                {
                    @if (selected.Observability is { } observability)
                    {
                        <ObservabilityWorkspace @key="observability.Id" Snapshot="observability" Previous="@PreviousObservability(selected)" ChooseSnapshot="FocusSelectorAsync" Layers="@selected.EvidenceDomains?.CrossDomain.ObservabilityLayers" />
                    }
                    else { <p class="sa-card" data-testid="observability-missing">This historical source snapshot predates observability analysis. Upload the same source archive to create a new immutable analysis.</p> }
                }
                else if (_domain == "Tests")
                {
                    <BirkNext.Web.Components.SourceDomains.TestEvidenceWorkspace @key="selected.Id" Snapshot="selected" />
                }
                else if (_domain == "Dependencies")
                {
                    <BirkNext.Web.Components.SourceDomains.DependencyEvidenceWorkspace @key="selected.Id" Snapshot="selected" Snapshots="_snapshots" />
                }
                else if (selected.EvidenceDomains is { } evidence)
                {
                    var previous = SourceEvidenceDomainsPresentation.Previous(_snapshots, selected);
                    @if (_domain == "Infrastructure") { <InfrastructureWorkspace @key="evidence.Id" Evidence="evidence" Previous="previous" /> }
                    else if (_domain == "Configuration") { <ConfigurationWorkspace @key="evidence.Id" Evidence="evidence" Previous="previous" /> }
                    else if (_domain == "CI/CD") { <PipelineWorkspace @key="evidence.Id" Evidence="evidence" Previous="previous" /> }
                    else { <ContractsWorkspace @key="evidence.Id" Evidence="evidence" Previous="previous" SourceName="@selected.Archive.FileName" /> }
                }
                else { <p class="sa-card" data-testid="evidence-missing">@SourceEvidenceDomainsPresentation.HistoricalNote</p> }
            }
            else if (_area == SourceAnalysisAreas.Architecture)
            {
                @if (selected.Architecture is { } architecture)
                {
                    <ArchitectureWorkspace @key="architecture.SnapshotId" Snapshot="architecture" Previous="@PreviousArchitectures(selected)" OpenDatabase="OpenDatabase" ChooseSnapshot="FocusSelectorAsync" InitialTab="@_architectureTab" />
                }
                else { <p class="sa-card" data-testid="architecture-missing">This historical source snapshot predates architecture extraction. Upload the same source archive to create a new immutable analysis.</p> }
            }
            else
            {
                @if (selected.DatabaseArchitecture is { } database) { <DatabaseWorkspace @key="database.SnapshotId" Snapshot="database" Previous="@Previous(selected)" FocusDatabaseId="@_focusDatabase" InitialTab="@_databaseTab" ChooseSnapshot="FocusSelectorAsync" /> }
                else { <p class="sa-card" data-testid="database-missing">This historical source snapshot predates database extraction. Upload the same source archive to create a new immutable analysis.</p> }
            }
        }
    }
</div>
@code {
    /// <summary>The review that sent the user here (an allow-listed internal route identifier — never an arbitrary URL).</summary>
    [SupplyParameterFromQuery(Name = "returnTo")] public string? ReturnTo { get; set; }
    [SupplyParameterFromQuery(Name = "area")] public string? Area { get; set; }
    /// <summary>The quality-evidence domain under Quality Evidence (observability, infrastructure, configuration, cicd, contracts).</summary>
    [SupplyParameterFromQuery(Name = "view")] public string? View { get; set; }
    /// <summary>An exact snapshot to open (Import Project links its own snapshot by id). Never substituted by another snapshot.</summary>
    [SupplyParameterFromQuery(Name = "snapshot")] public string? SnapshotParam { get; set; }
    private string? _linkedMissing;
    private BirkNext.Web.Models.SddProjectImportRecord? _currentImport;
    private static readonly Dictionary<string, string> ReturnTargets = new(StringComparer.Ordinal)
    {
        ["dependency-review"] = "Dependency Review",
        ["security-classification-review"] = "M01 – Gradert tilgang (Kode 6/7)",
        ["integration-quality-review"] = "Integration Quality Review",
    };
    private (string Route, string Label)? ReturnTarget => ReturnTo is { } key && ReturnTargets.TryGetValue(key, out var label) ? (key, label) : null;

    private static string AreaSlug(string area) => area.Replace("/", "").Replace(" ", "");
    /// <summary>The deep link of an area: the current query (selected snapshot, return target) with only the area (and view) replaced.</summary>
    private string AreaHref(string area) => Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["area"] = SourceAnalysisAreas.AreaParam(area), ["view"] = null });
    private string ReviewHref(string area, string? domain) => area == SourceAnalysisAreas.Quality && domain is not null
        ? Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["area"] = SourceAnalysisAreas.AreaParam(area), ["view"] = SourceAnalysisAreas.Slug(domain) })
        : AreaHref(area);
    /// <summary>The status dimensions with the labels each one uses — kept apart in the legend as on every page. One badge never describes
    /// several dimensions.</summary>
    private static readonly (SourceStatusDimension Dimension, string[] Examples)[] StatusLegend =
    [
        (SourceStatusDimension.Confidence, ["Detected in source", "Confirmed in source", "Inferred", "Not found in source"]),
        (SourceStatusDimension.Completeness, ["Complete", "Partial", "Not assessed"]),
        (SourceStatusDimension.Resolution, ["Resolved", "Unresolved", "Ambiguous", "Conflict"]),
        (SourceStatusDimension.ReviewAction, ["No action", "Needs review", "Needs confirmation"]),
        (SourceStatusDimension.Runtime, ["Not assessed here"]),
        (SourceStatusDimension.ParserSupport, ["Supported", "Partial"]),
    ];
