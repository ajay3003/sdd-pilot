@page "/source-analysis"
@using BirkNext.Web.Services
@using BirkNext.Web.Components
@using BirkNext.Web.Models
@using Microsoft.AspNetCore.Components.Forms
@using BirkNext.Integrations
@using BirkNext.SourceDomains
@using BirkNext.Web.Components.SourceDomains
@inject IIntegrationCatalogApiService Api
@inject IFrontendAnalysisContextFactory ContextFactory
@inject ProjectApplicabilityState Applicability
@inject IJSRuntime JS

@* Source Analysis landing workspace: one selected stored source snapshot drives every area (Overview, Architecture, Database, Observability), so no
   summary can mix snapshots. Architecture and Database keep their own models; this page only reads their stored results — opening it
   never re-analyzes. Source only: nothing live is contacted. Hiding the feature (Feature Visibility) hides the menu entry only. *@
<PageTitle>Source Analysis</PageTitle>
<div class="sa-page">
    <PageHeader Title="Source Analysis" Description="Architecture, database design, observability and reusable source evidence (infrastructure, configuration, CI/CD, contracts) derived from source snapshots — created by Import Project or by a source-only upload." />
    @if (ReturnTarget is { } back)
    {
        <p class="sa-return" data-testid="sa-return"><a href="@back.Route" data-testid="sa-return-link">Back to @back.Label</a> <span class="sa-muted">— snapshots analyzed here can be chosen there.</span></p>
    }
    <p class="sa-safety" role="note" data-testid="sa-safety">@SourceAnalysisOverview.SafetyNote</p>
    @* Source snapshots need no Target Environment: a target is runtime context, so it is shown here, never required. *@
    @if (!_loaded)
    {
        <p class="sa-muted" role="status">Loading source snapshots…</p>
    }
    else
    {
        <dl class="sa-target-context" data-testid="sa-target-context">
            <div><dt>Target Environment</dt><dd data-testid="sa-target-state">@(_profile is null ? "Not selected" : "Selected")</dd></div>
            <div><dt>Runtime-dependent evidence</dt><dd>@(_profile is null ? "Not available — select a Target Environment for runtime reviews" : "Available to runtime reviews")</dd></div>
        </dl>
        <section class="sa-card sa-snapshot-bar" aria-labelledby="sa-snapshot-heading" data-testid="sa-snapshot-bar">
            <h2 id="sa-snapshot-heading">Source snapshot</h2>
            <div class="sa-controls">
                <div class="sa-upload-group">
                    @* Import Project is the recommended path: one archive feeds project documents and this snapshot. A source-only upload stays
                       available for archives that are source only, or to analyze the same source again. *@
                    <a class="sa-file-button@(_snapshots.Count == 0 ? " sa-file-primary" : "")" href="project-import" data-testid="sa-import-project">Import Project</a>
                    <label class="sa-file-button">
                        <InputFile class="sa-file-input" accept=".zip" OnChange="Upload" disabled="@_busy" aria-label="Upload source only (.zip, maximum 50 MB)" data-testid="sa-upload" />
                        <span aria-hidden="true">Upload source only</span>
                    </label>
                    <span class="sa-muted">ZIP · maximum 50 MB</span>
                </div>
                <label class="sa-field">Existing snapshot
                    <select id="sa-snapshot-select" class="form-control" @bind="_selected" @bind:after="SnapshotChanged" data-testid="source-snapshot" disabled="@(_busy || _snapshots.Count == 0)">
                        <option value="">@(_snapshots.Count == 0 ? "No stored snapshot yet" : "Select a source snapshot")</option>
                        @foreach (var snapshot in _snapshots) { <option value="@snapshot.Id">@SourceAnalysisOverview.OptionLabel(snapshot)</option> }
                    </select>
                </label>
            </div>
            @if (_busy) { <p class="sa-status" role="status" data-testid="sa-analyzing">Analyzing source… The architecture and database are extracted from the archive.</p> }
            @if (_error is { } uploadFailure)
            {
                <section class="sa-error-card" role="alert" aria-labelledby="sa-error-heading" data-testid="sa-error">
                    <h3 id="sa-error-heading">@UploadErrorTitle(uploadFailure)</h3>
                    <p>@uploadFailure.Message</p>
                    @if (!string.IsNullOrWhiteSpace(uploadFailure.EntryPath)) { <p class="sa-error-path"><strong>Archive entry:</strong> <code>@uploadFailure.EntryPath</code></p> }
                    <p><strong>What to do:</strong> @uploadFailure.Guidance</p>
                    <details class="sa-error-details">
                        <summary>Technical details</summary>
                        <dl>
                            <div><dt>Error code</dt><dd><code>@uploadFailure.Code</code></dd></div>
                            <div><dt>Stage</dt><dd>@uploadFailure.StageLabel</dd></div>
                            @if (uploadFailure.Actual is { } actual) { <div><dt>Observed</dt><dd>@FormatUploadValue(uploadFailure.Code, actual)</dd></div> }
                            @if (uploadFailure.Limit is { } limit) { <div><dt>Limit</dt><dd>@FormatUploadValue(uploadFailure.Code, limit)</dd></div> }
                        </dl>
                    </details>
                </section>
            }
        </section>

        var selected = _busy ? null : _snapshots.FirstOrDefault(s => s.Id.ToString() == _selected);
        @if (_busy)
        {
            <section class="sa-card sa-progress" aria-labelledby="sa-progress-heading" data-testid="sa-analyzing-areas">
                <h2 id="sa-progress-heading">Analysis in progress</h2>
                <dl class="sa-facts">
                    <div><dt>Source snapshot</dt><dd data-testid="sa-progress-archive">@(_pendingArchive ?? "Uploaded archive")</dd></div>
                    <div><dt>Architecture</dt><dd><span class="sa-pill sa-pill-muted">Analyzing</span></dd></div>
                    <div><dt>Database</dt><dd><span class="sa-pill sa-pill-muted">Analyzing</span></dd></div>
                    <div><dt>Observability</dt><dd><span class="sa-pill sa-pill-muted">Analyzing</span></dd></div>
                    <div><dt>Source evidence</dt><dd><span class="sa-pill sa-pill-muted">Analyzing</span> <span class="sa-muted">Infrastructure · Configuration · CI/CD · Contracts</span></dd></div>
                </dl>
                <p class="sa-muted">The uploaded archive is being analyzed. @SourceAnalysisOverview.SafetyNote</p>
                <div class="sa-area-grid">
                    @foreach (var (area, provides) in new[] { ("Architecture", SourceAnalysisOverview.ArchitectureProvides), ("Database", SourceAnalysisOverview.DatabaseProvides), ("Observability", SourceObservabilityPresentation.Provides) })
                    {
                        <article class="sa-area-preview" data-testid="sa-area-card" data-area="@area">
                            <h3>@area <span class="sa-pill sa-pill-muted">Analyzing</span></h3>
                            <p class="sa-muted">Will provide: @string.Join(" · ", provides)</p>
                        </article>
                    }
                </div>
            </section>
        }
        else if (selected is null)
        {
            <section class="sa-card sa-empty" aria-labelledby="sa-empty-heading" data-testid="sa-empty">
                <span class="sa-empty-icon" aria-hidden="true"></span>
                <div class="sa-empty-body">
                    <h2 id="sa-empty-heading">No source snapshot selected</h2>
                    <p>Import the project (one ZIP for documents and source), upload a source-only archive, or choose an existing snapshot to explore:</p>
                    <ul class="sa-preview" data-testid="sa-preview">
                        <li><strong>Architecture</strong> — components, dependencies, messaging channels, data stores and external systems found in source.</li>
                        <li><strong>Database structure</strong> — database candidates, tables/entities, relationships and indexes from EF models, migrations and SQL.</li>
                        <li><strong>Observability</strong> — correlation and tracing boundaries, logging quality and telemetry configuration found in source.</li>
                        <li><strong>Source evidence</strong> — infrastructure as code, configuration, CI/CD pipelines and contracts, reusable by every review.</li>
                        <li><strong>Snapshot changes</strong> — compare an analysis with another stored snapshot of the source.</li>
                    </ul>
                    <div class="sa-actions">
                        <a class="sa-file-button sa-file-primary" href="project-import" data-testid="sa-empty-import-project">Import Project</a>
                        <label class="sa-file-button">
                            <InputFile class="sa-file-input" accept=".zip" OnChange="Upload" disabled="@_busy" aria-label="Upload source only (ZIP, maximum 50 MB)" data-testid="sa-empty-upload" />
                            <span aria-hidden="true">Upload source only</span>
                        </label>
                        <button type="button" class="btn-secondary" data-testid="sa-choose-existing" disabled="@(_snapshots.Count == 0)" aria-describedby="@(_snapshots.Count == 0 ? "sa-no-snapshots" : null)" @onclick="FocusSelectorAsync">Choose existing snapshot</button>
                        @if (_snapshots.Count == 0) { <span class="sa-muted" id="sa-no-snapshots">No stored snapshot yet.</span> }
                    </div>
                </div>
            </section>
        }
        else
        {
            <nav class="sa-areas sa-area-groups" aria-label="Source Analysis areas" data-testid="sa-areas">
                @foreach (var (group, areas) in AreaGroups)
                {
                    <div class="sa-area-group" role="group" aria-label="@group" data-testid="sa-area-group">
                        <span class="sa-area-group-label" aria-hidden="true">@group</span>
                        @foreach (var area in areas)
                        {
                            <button type="button" id="@($"sa-area-{AreaSlug(area)}")" class="sa-area-tab @(_area == area ? "active" : "")" aria-pressed="@(_area == area ? "true" : "false")"
                                    data-testid="@($"area-{AreaSlug(area).ToLowerInvariant()}")" @onclick="() => OpenArea(area)">@area</button>
                        }
                    </div>
                }
            </nav>
            @if (_area == "Overview")
            {
                <section class="sa-card sa-current" aria-labelledby="sa-current-heading" data-testid="sa-current" data-snapshot="@selected.Id">
                    <h2 id="sa-current-heading" tabindex="-1">Current snapshot</h2>
                    <p class="sa-current-title"><strong data-testid="sa-current-archive">@selected.Archive.FileName</strong> <span class="sa-pill sa-pill-@(selected.Status == SourceAnalysisStatus.Ready ? "complete" : "partial")"><span class="visually-hidden">Source evidence: </span><span data-testid="sa-current-evidence">@SourceAnalysisOverview.SourceEvidence(selected.Status)</span></span></p>
                    <dl class="sa-facts sa-facts-compact">
                        <div><dt>Fingerprint</dt><dd><code data-testid="sa-current-fingerprint" title="@selected.Archive.Sha256">@SourceAnalysisOverview.ShortFingerprint(selected.Archive.Sha256)</code></dd></div>
                        <div><dt>Analyzed</dt><dd data-testid="sa-current-analyzed">@SourceAnalysisOverview.Utc(selected.AnalyzedAt)</dd></div>
                        <div><dt>Files</dt><dd data-testid="sa-current-files">@selected.Archive.FilesAnalyzed</dd></div>
                        <div><dt>Commit</dt><dd>@selected.Commit@(selected.Branch is { } branch ? $" · {branch}" : "")</dd></div>
                        <div><dt>Created by</dt><dd data-testid="sa-current-origin">@(selected.ProjectImport is { } import ? $"Project Import · {SourceAnalysisOverview.Utc(import.ImportedAt)}" : "Source-only upload")</dd></div>
                    </dl>
                    @if (selected.ProjectImport is { } provenance)
                    {
                        <p class="sa-muted" data-testid="sa-import-provenance" data-import="@provenance.ImportId">
                            Created from Project Import <code class="sa-mono">@provenance.ImportId</code> — the same archive the project documents were imported from.
                            <a href="project-import" data-testid="sa-import-link">View the imported project</a>
                        </p>
                    }
                    <div class="sa-actions">
                        <button type="button" class="btn-secondary" data-testid="sa-change-snapshot" @onclick="FocusSelectorAsync">Change snapshot</button>
                        <ReviewDisclosure Text="Full fingerprint" CollapseText="Hide full fingerprint" TestId="sa-fingerprint" Class="disclosure-inline">
                            <code class="sa-mono">@selected.Archive.Sha256</code>
                        </ReviewDisclosure>
                    </div>
                </section>

                <section class="sa-areas-section" aria-labelledby="sa-areas-heading" data-testid="sa-overview-areas">
                    <h2 id="sa-areas-heading">Analysis areas</h2>
                    <div class="sa-area-grid">
                        @foreach (var card in new[] { SourceAnalysisOverview.Architecture(selected), SourceAnalysisOverview.Database(selected), SourceAnalysisOverview.Observability(selected) })
                        {
                            var headingId = $"sa-card-{card.Area.ToLowerInvariant()}";
                            <article class="sa-card sa-area-card" aria-labelledby="@headingId" data-testid="sa-area-card" data-area="@card.Area" data-status="@card.Status" data-analysis="@card.AnalysisId">
                                <h3 id="@headingId">@card.Title <span class="sa-pill sa-pill-@card.Tone" data-testid="sa-area-status">@card.Status</span></h3>
                                <p class="sa-muted">@card.Description</p>
                                @if (card.Reason is { } reason) { <p class="sa-reason" data-testid="sa-area-reason">@reason</p> }
                                @if (card.Metrics.Count > 0)
                                {
                                    <dl class="sa-metrics" data-testid="sa-area-metrics">
                                        @foreach (var metric in card.Metrics) { <div data-testid="sa-metric" data-metric="@metric.Label"><dt>@metric.Label</dt><dd>@metric.Value</dd></div> }
                                    </dl>
                                }
                                <p class="sa-limitation" data-testid="sa-area-limitation">@card.Limitation</p>
                                <div class="sa-actions">
                                    <button type="button" class="btn-primary" data-testid="@($"sa-open-{card.Area.ToLowerInvariant()}")" @onclick="() => OpenFromCard(card.Area)">@card.Action</button>
                                </div>
                            </article>
                        }
                    </div>
                </section>

                <section class="sa-areas-section" aria-labelledby="sa-evidence-heading" data-testid="sa-overview-evidence">
                    <h2 id="sa-evidence-heading">Source evidence</h2>
                    <p class="sa-muted">Reusable evidence other reviews consume from this snapshot. @SourceEvidenceDomainsPresentation.Boundary</p>
                    <ul class="sd-rows">
                        @foreach (var row in SourceEvidenceDomainsPresentation.Rows(selected))
                        {
                            var rowHeading = $"sa-row-{SourceEvidenceDomainsPresentation.Slug(row.Area)}";
                            <li class="sd-row" data-testid="sa-evidence-row" data-area="@row.Area" data-status="@row.Status" aria-labelledby="@rowHeading">
                                <h3 id="@rowHeading">@row.Title <span class="sd-pill sd-pill-@row.Tone" data-testid="sa-evidence-status">@row.Status</span></h3>
                                <div class="sd-row-body">
                                    @if (row.Metrics.Count > 0)
                                    {
                                        <dl class="sd-row-metrics" data-testid="sa-evidence-metrics">
                                            @foreach (var metric in row.Metrics) { <div data-testid="sa-evidence-metric" data-metric="@metric.Label"><dt>@metric.Label</dt><dd>@metric.Value</dd></div> }
                                        </dl>
                                    }
                                    <p class="sa-muted" data-testid="sa-evidence-reason">@(row.Reason ?? row.Description)</p>
                                </div>
                                <button type="button" class="btn-secondary" data-testid="@($"sa-open-{SourceEvidenceDomainsPresentation.Slug(row.Area)}")" @onclick="() => OpenFromCard(row.Area)">Open @row.Title<span class="visually-hidden"> evidence</span></button>
                            </li>
                        }
                    </ul>
                    @if (selected.EvidenceDomains is { } evidence)
                    {
                        var summary = SourceEvidenceDomainsPresentation.LinkSummary(evidence.CrossDomain);
                        <section class="sa-card" aria-labelledby="sa-links-heading" data-testid="sa-cross-domain">
                            <h3 id="sa-links-heading">Cross-source relationships <span class="sd-pill sd-pill-@SourceEvidenceDomainsPresentation.Tone(evidence.CrossDomain.Status)">@SourceDomainText.Label(evidence.CrossDomain.Status)</span></h3>
                            @if (summary.Count == 0) { <p class="sa-muted" data-testid="sa-cross-domain-empty">@(evidence.CrossDomain.StatusReason ?? "No relationships between the source-evidence domains of this snapshot.")</p> }
                            else
                            {
                                <div class="sd-scroll" tabindex="0" role="region" aria-label="Cross-source relationships">
                                    <table class="sd-links-table" data-testid="sa-cross-domain-table">
                                        <thead><tr><th scope="col">Relationship</th><th scope="col">Linked</th><th scope="col">Unresolved</th></tr></thead>
                                        <tbody>@foreach (var s in summary) { <tr data-testid="sa-cross-domain-row" data-type="@s.Type"><th scope="row">@s.Label</th><td>@s.Linked</td><td>@s.Unresolved</td></tr> }</tbody>
                                    </table>
                                </div>
                                <p class="sa-muted">Unresolved means no matching declaration was found in the selected source — it may be managed elsewhere. It is not a failure.</p>
                                <ReviewDisclosure Text="@($"View relationships ({evidence.CrossDomain.Links.Count})")" CollapseText="Hide relationships" TestId="sa-cross-domain-links" Class="disclosure-inline">
                                    <div class="sd-scroll" tabindex="0" role="region" aria-label="Relationship details">
                                        <table>
                                            <thead><tr><th scope="col">From</th><th scope="col">To</th><th scope="col">Evidence</th><th scope="col">Basis</th></tr></thead>
                                            <tbody>@foreach (var l in evidence.CrossDomain.Links.Take(300)) { <tr data-testid="sa-cross-domain-link" data-resolved="@(l.Resolved ? "true" : "false")"><th scope="row">@l.FromLabel<span class="sd-context">@SourceDomainText.Label(l.Type)</span></th><td>@l.ToLabel</td><td><span class="sd-pill sd-pill-@SourceEvidenceDomainsPresentation.Tone(l.State)">@SourceDomainText.Label(l.State)</span></td><td>@l.Basis</td></tr> }</tbody>
                                        </table>
                                    </div>
                                </ReviewDisclosure>
                                @if (evidence.CrossDomain.EnvironmentMappings.Count > 0)
                                {
                                    <p class="sa-muted" data-testid="sa-environment-mappings">Environments across formats: @string.Join(" · ", evidence.CrossDomain.EnvironmentMappings.Select(m => $"{m.Kind} ({SourceDomainText.Label(m.State)})"))</p>
                                }
                            }
                        </section>
                    }
                </section>
            }
            else if (_area is "Infrastructure" or "Configuration" or "CI/CD" or "Contracts")
            {
                @if (selected.EvidenceDomains is { } evidence)
                {
                    var previous = SourceEvidenceDomainsPresentation.Previous(_snapshots, selected);
                    @if (_area == "Infrastructure") { <InfrastructureWorkspace @key="evidence.Id" Evidence="evidence" Previous="previous" /> }
                    else if (_area == "Configuration") { <ConfigurationWorkspace @key="evidence.Id" Evidence="evidence" Previous="previous" /> }
                    else if (_area == "CI/CD") { <PipelineWorkspace @key="evidence.Id" Evidence="evidence" Previous="previous" /> }
                    else { <ContractsWorkspace @key="evidence.Id" Evidence="evidence" Previous="previous" /> }
                }
                else { <p class="sa-card" data-testid="evidence-missing">@SourceEvidenceDomainsPresentation.HistoricalNote</p> }
            }
            else if (_area == "Architecture")
            {
                @if (selected.Architecture is { } architecture)
                {
                    <ArchitectureWorkspace @key="architecture.SnapshotId" Snapshot="architecture" Previous="@PreviousArchitectures(selected)" OpenDatabase="OpenDatabase" ChooseSnapshot="FocusSelectorAsync" />
                }
                else { <p class="sa-card" data-testid="architecture-missing">This historical source snapshot predates architecture extraction. Upload the same source archive to create a new immutable analysis.</p> }
            }
            else if (_area == "Observability")
            {
                @if (selected.Observability is { } observability)
                {
                    <ObservabilityWorkspace @key="observability.Id" Snapshot="observability" Previous="@PreviousObservability(selected)" ChooseSnapshot="FocusSelectorAsync" Layers="@selected.EvidenceDomains?.CrossDomain.ObservabilityLayers" />
                }
                else { <p class="sa-card" data-testid="observability-missing">This historical source snapshot predates observability analysis. Upload the same source archive to create a new immutable analysis.</p> }
            }
            else
            {
                @if (selected.DatabaseArchitecture is { } database) { <DatabaseWorkspace @key="database.SnapshotId" Snapshot="database" Previous="@Previous(selected)" FocusDatabaseId="@_focusDatabase" InitialTab="@_databaseTab" ChooseSnapshot="FocusSelectorAsync" /> }
                else { <p class="sa-card" data-testid="database-missing">This historical source snapshot predates database extraction. Upload the same source archive to create a new immutable analysis.</p> }
            }
        }
    }
</div>
@code {
    /// <summary>The review that sent the user here (an allow-listed internal route identifier — never an arbitrary URL).</summary>
    [SupplyParameterFromQuery(Name = "returnTo")] public string? ReturnTo { get; set; }
    private static readonly Dictionary<string, string> ReturnTargets = new(StringComparer.Ordinal)
    {
        ["dependency-review"] = "Dependency Review",
        ["security-classification-review"] = "Security Classification",
        ["integration-quality-review"] = "Integration Quality Review",
    };
    private (string Route, string Label)? ReturnTarget => ReturnTo is { } key && ReturnTargets.TryGetValue(key, out var label) ? (key, label) : null;

    /// <summary>Core analysis areas, then the reusable source-evidence domains — grouped so the navigation stays readable.</summary>
    private static readonly (string Group, string[] Areas)[] AreaGroups = DocumentationCatalog.SourceAnalysisGroups
        .Select(group => (group.Label, group.Areas.ToArray())).ToArray();
    private static string AreaSlug(string area) => area.Replace("/", "");
    private string _area = "Overview";
    private string? _focusDatabase;
    private string? _databaseTab;
    private string? _focusId;
    private bool _loaded;
    private string? _pendingArchive;

    private void OpenArea(string area) { _area = area; _focusDatabase = null; _databaseTab = null; }
    /// <summary>From an Overview card: the same selected snapshot, the matching area; Open Database Diagram lands on the diagram.</summary>
    private void OpenFromCard(string area)
    {
        OpenArea(area);
        if (area == "Database") _databaseTab = "Diagram";
        _focusId = $"sa-area-{AreaSlug(area)}";
    }
    private void OpenDatabase(string databaseModelId) { _focusDatabase = databaseModelId; _area = "Database"; }
    // A new or reselected snapshot changes the source input: applicability (sidebar, Recommended Workflow) re-reads it now.
    private void SnapshotChanged() { _focusDatabase = null; _databaseTab = null; _ = Applicability.RefreshAsync(); }
    private async Task FocusSelectorAsync() { try { await JS.InvokeVoidAsync("birknextFocusElement", "sa-snapshot-select"); } catch (JSException) { } }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusId is not { } id) return;
        _focusId = null;
        try { await JS.InvokeVoidAsync("birknextFocusElement", id); } catch (JSException) { }
    }

    private IReadOnlyList<(string Label, BirkNext.SourceArchitecture.ArchitectureSnapshot Snapshot)> PreviousArchitectures(IqrSourceSnapshot current) =>
        _snapshots.Where(s => s.Id != current.Id && s.Architecture is not null).OrderByDescending(s => s.AnalyzedAt)
            .Select(s => ($"{s.Archive.FileName} · {s.AnalyzedAt:u}", s.Architecture!)).ToList();
    /// <summary>The latest earlier Observability analysis of the SAME repository (repository key, else archive name) — never another repository.</summary>
    private BirkNext.SourceObservability.SourceObservabilitySnapshot? PreviousObservability(IqrSourceSnapshot current) =>
        _snapshots.Where(s => s.Id != current.Id && s.AnalyzedAt < current.AnalyzedAt && s.Observability is not null && SameRepository(s, current)).OrderByDescending(s => s.AnalyzedAt).FirstOrDefault()?.Observability;
    private static bool SameRepository(IqrSourceSnapshot a, IqrSourceSnapshot b) =>
        a.Repository is { } ra && b.Repository is { } rb ? ra.Key == rb.Key : a.Archive.FileName == b.Archive.FileName;
    private FrontendAnalysisProfile? _profile; private IReadOnlyList<IqrSourceSnapshot> _snapshots = []; private string _selected = ""; private SourceUploadFailure? _error; private bool _busy;
    protected override async Task OnInitializedAsync() { var context = await ContextFactory.GetActiveContextAsync(); _profile = context.ActiveProfileOrNull; await Load(); _loaded = true; }
    private async Task Load() { try { _snapshots = await Api.ListSourceSnapshotsAsync(_profile?.Id ?? ""); if (_selected == "") _selected = _snapshots.FirstOrDefault()?.Id.ToString() ?? ""; } catch (Exception) { _error = new("SOURCE_SNAPSHOT_LIST_FAILED", "upload", "Stored source snapshots could not be loaded. Existing selections are unchanged."); } }
    private async Task Upload(InputFileChangeEventArgs args)
    {
        _busy = true; _error = null; _pendingArchive = args.File.Name;
        try { await using var stream = args.File.OpenReadStream(50 * 1024 * 1024); var (snapshot, error) = await Api.AnalyzeSourceSnapshotDetailedAsync(_profile?.Id ?? "", args.File.Name, stream); _error = error; if (snapshot is not null) { await Load(); _selected = snapshot.Id.ToString(); _area = "Overview"; SnapshotChanged(); _focusId = "sa-current-heading"; } }
        catch (IOException) { _error = new("ARCHIVE_TOO_LARGE", "upload", "The selected ZIP exceeds the 50 MB upload limit.", Limit: 50L * 1024 * 1024); }
        catch (HttpRequestException ex) when (BackendRequestClassifier.FromException("Source upload", ex).IsTransportFailure) { _error = new("SOURCE_ANALYSIS_UNAVAILABLE", "upload", "Source Analysis could not be reached. Existing snapshots are unchanged; retry when the service is available."); }
        catch (HttpRequestException ex) { _error = new("SOURCE_UPLOAD_FAILED", "upload", $"{BackendRequestClassifier.FromException("Source upload", ex).UserMessage} Existing snapshots are unchanged."); }
        catch (TaskCanceledException) { _error = new("SOURCE_UPLOAD_TIMEOUT", "upload", "The source upload did not finish before the request timed out. Check the snapshot list before retrying; the server may have completed analysis."); }
        catch (Exception) { _error = new("SOURCE_UPLOAD_FAILED", "upload", "The source upload could not be completed. Existing snapshots are unchanged; correct the archive or retry."); }
        finally { _busy = false; }
    }
    private BirkNext.DatabaseArchitecture.DatabaseArchitectureSnapshot? Previous(IqrSourceSnapshot current) => _snapshots.Where(s => s.IntegrationId == current.IntegrationId && s.AnalyzedAt < current.AnalyzedAt && s.DatabaseArchitecture is not null).OrderByDescending(s => s.AnalyzedAt).FirstOrDefault()?.DatabaseArchitecture;
    private static string UploadErrorTitle(SourceUploadFailure failure) => failure.Stage switch
    {
        "prerequisite" => "Target Environment required",
        "validation" => "Source archive rejected",
        "analysis" => "Source analysis did not complete",
        "persistence" => "Source snapshot could not be saved",
        _ => "Source upload could not be completed",
    };
    private static string FormatUploadValue(string code, long value) => code.Contains("SIZE", StringComparison.OrdinalIgnoreCase)
        ? $"{value / (1024d * 1024):0.#} MB" : value.ToString("N0");
}
