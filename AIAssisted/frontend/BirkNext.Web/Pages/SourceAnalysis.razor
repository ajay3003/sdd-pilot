    private void OpenArea(string area)
    {
        _area = area; _domain = null; _focusDatabase = null; _databaseTab = null; _architectureTab = null;
        Navigation.NavigateTo(AreaHref(area));
    }
    private void OpenDomain(string domain)
    {
        _area = SourceAnalysisAreas.Quality; _domain = domain;
        Navigation.NavigateTo(ReviewHref(SourceAnalysisAreas.Quality, domain));
    }
    /// <summary>From a summary row or attention item: the same snapshot, the matching area or quality domain, focus moved to its navigation.</summary>
    private void OpenReview(string area, string? domain, string? view)
    {
        if (area == SourceAnalysisAreas.Quality && domain is not null) OpenDomain(domain);
        else OpenArea(area);
        if (area == SourceAnalysisAreas.Architecture) _architectureTab = view;
        _focusId = $"sa-area-{AreaSlug(area)}";
    }
    private void OpenDatabase(string databaseModelId) { _focusDatabase = databaseModelId; _area = SourceAnalysisAreas.Data; }

    /// <summary>One summary row: domain, status (never colour only), the primary reason for a non-complete status and where to review it.</summary>
    private RenderFragment SummaryRow(SourceSummaryRow row, bool open = false) =>
        @<li class="sa-summary-row" data-testid="sa-summary-row" data-key="@row.Key" data-status="@row.Status">
            <span class="sa-summary-title">@row.Title</span>
            <SourceStatusBadge Dimension="SourceStatusDimension.Completeness" Label="@row.Status" TestId="sa-summary-status" />
            @if (row.Reason is { } reason) { <span class="sa-summary-reason" data-testid="sa-summary-reason">@reason</span> }
            @if (row.Detail is { } detail) { <span class="sa-muted sa-summary-detail">@detail</span> }
            <a class="sa-summary-open" href="@ReviewHref(row.Area, row.Domain)" data-testid="@($"sa-open-{row.Key}")" @onclick="() => OpenReview(row.Area, row.Domain, null)" @onclick:preventDefault>@(open ? "Open" : "Review")<span class="visually-hidden">@(" " + row.Title)</span></a>
        </li>;
    // A new or reselected snapshot changes the source input: applicability (sidebar, Recommended Workflow) re-reads it now.
    private void SnapshotChanged()
    {
        _focusDatabase = null; _databaseTab = null;
        if (_snapshotKey is { } key) SnapshotState.SelectSnapshot(key, _selected);
        _ = Applicability.RefreshAsync();
    }
    private async Task FocusSelectorAsync() { try { await JS.InvokeVoidAsync("birknextFocusElement", "sa-snapshot-select"); } catch (JSException) { } }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusId is not { } id) return;
        _focusId = null;
        try { await JS.InvokeVoidAsync("birknextFocusElement", id); } catch (JSException) { }
    }

    private IReadOnlyList<(string Label, BirkNext.SourceArchitecture.ArchitectureSnapshot Snapshot)> PreviousArchitectures(IqrSourceSnapshot current) =>
        _snapshots.Where(s => s.Id != current.Id && s.Architecture is not null).OrderByDescending(s => s.AnalyzedAt)
            .Select(s => ($"{s.Archive.FileName} · {s.AnalyzedAt:u}", s.Architecture!)).ToList();
    /// <summary>The latest earlier Observability analysis of the SAME repository (repository key, else archive name) — never another repository.</summary>
    private BirkNext.SourceObservability.SourceObservabilitySnapshot? PreviousObservability(IqrSourceSnapshot current) =>
        _snapshots.Where(s => s.Id != current.Id && s.AnalyzedAt < current.AnalyzedAt && s.Observability is not null && SameRepository(s, current)).OrderByDescending(s => s.AnalyzedAt).FirstOrDefault()?.Observability;
    private static bool SameRepository(IqrSourceSnapshot a, IqrSourceSnapshot b) =>
        a.Repository is { } ra && b.Repository is { } rb ? ra.Key == rb.Key : a.Archive.FileName == b.Archive.FileName;
    /// <summary>No snapshot is shown (none stored, or none chosen) and no upload is running: the empty state offers the actions once.</summary>
    private sealed record EmptyState(string Kind, string Text, bool ImportLink, bool CanRetry = false);
    private bool _retryingImport;
    private string? _retryImportMessage;

    private string SourceStateSummary => !NoSnapshotSelected ? "Current" : EmptyReason?.Kind switch
    {
        "LinkedSnapshotMissing" => "Linked snapshot missing",
        "ImportWithoutSnapshot" when _currentImport?.SourceState == nameof(BirkNext.ProjectImport.ProjectImportSourceState.Failed) => "Not created — save failed",
        "ImportWithoutSnapshot" => "Not created",
        "ImportWithoutSource" => "No source in this project",
        _ => "None",
    };

    /// <summary>Creates the imported project's snapshot from its still-staged archive (no new upload), then selects that exact snapshot.</summary>
    private async Task RetryImportSnapshotAsync()
    {
        if (_currentImport is not { SourceStagingId: { } stagingId } record
            || ServiceProvider.GetService<BirkNext.Web.Services.ProjectImport.IProjectImportApiService>() is not { } importApi
            || ServiceProvider.GetService<ProjectImportActivation>() is not { } activation) return;
        _retryingImport = true; _retryImportMessage = null;
        try
        {
            var (commit, error) = await importApi.CommitAsync(stagingId);
            if (commit is null) { _retryImportMessage = error?.Message ?? "The snapshot could not be created."; return; }
            activation.UpdateSource(record.ImportId, commit.Source, commit.StagingId, commit.StagedUntil);
            if (ServiceProvider.GetService<IWorkspaceAutoSaveService>() is { } autoSave) await autoSave.SaveNowAsync();
            if (commit.Source.SnapshotId is not { } created) { _retryImportMessage = commit.Source.Message ?? "The snapshot could still not be created."; return; }
            SnapshotState.Invalidate();
            await Load();
            if (_snapshots.Any(s => s.Id == created)) { _selected = created.ToString(); _linkedMissing = null; SnapshotChanged(); }
        }
        catch (HttpRequestException ex) { _retryImportMessage = BackendRequestClassifier.FromException("Source snapshot retry", ex).UserMessage; }
        finally { _retryingImport = false; }
    }

    /// <summary>Why nothing is selected, kept apart: a missing linked snapshot, an imported project without source or without a snapshot, or no snapshot at all.</summary>
    private EmptyState? EmptyReason
    {
        get
        {
            if (_linkedMissing is { } missing)
                return new("LinkedSnapshotMissing", $"Snapshot {missing[..8]}{(_currentImport is { } import ? $" of the imported project {import.ProjectName}" : "")} is not among the stored source snapshots (for example after a local data reset). Choose another snapshot, or create it again from Import Project.", true);
            if (_currentImport is not { SourceSnapshotId: null } current)
                return _snapshots.Count > 0 ? new("NoneSelected", "Stored snapshots exist; choose one to explore.", false) : null;
            var source = ProjectImportPresentation.CurrentSource(current, DateTimeOffset.UtcNow);
            return source.SourceDetected
                ? new("ImportWithoutSnapshot", $"Imported project {current.ProjectName}: {source.Detail}", true, source.CanRetry)
                : new("ImportWithoutSource", $"The current imported project {current.ProjectName} has no source, so it has no source snapshot. Upload source separately if you have it.", false);
        }
    }

    private string EmptyHeading => EmptyReason?.Kind switch
    {
        "LinkedSnapshotMissing" => "Linked source snapshot not found",
        "ImportWithoutSnapshot" => "Source detected, but no snapshot was created",
        "ImportWithoutSource" => "This project has no source",
        _ => "No source snapshot selected",
    };

    private bool NoSnapshotSelected => !_busy && _snapshots.All(s => s.Id.ToString() != _selected);
    private FrontendAnalysisProfile? _profile; private IReadOnlyList<IqrSourceSnapshot> _snapshots = []; private string _selected = ""; private SourceUploadFailure? _error; private bool _busy;
    protected override async Task OnInitializedAsync()
    {
        var context = await ContextFactory.GetActiveContextAsync();
        _profile = context.ActiveProfileOrNull;
        var workspace = await CurrentWorkspace.GetAsync();
        _snapshotKey = new(_profile?.Id ?? "", workspace.WorkspaceId, workspace.ProjectSlug, workspace.Version);
        await Load();
        _loaded = true;
    }
    private async Task Load()
    {
        if (_snapshotKey is not { } key) return;
        try
        {
            _snapshots = await SnapshotState.GetOrLoadAsync(key, () => Api.ListSourceSnapshotsAsync(key.EnvironmentId));
            _currentImport = ServiceProvider.GetService<ProjectImportActivation>()?.Current;
            _linkedMissing = null;
            bool Stored(string? id) => id is not null && _snapshots.Any(s => s.Id.ToString() == id);
            var requested = Guid.TryParse(SnapshotParam, out var requestedId) ? requestedId.ToString() : null;
            var linked = _currentImport?.SourceSnapshotId?.ToString();
            var remembered = SnapshotState.SelectedSnapshotId(key);
            if (requested is not null)
            {
                // An exact link opens that snapshot or says it is missing; it never falls back to another one.
                _selected = Stored(requested) ? requested : "";
                if (!Stored(requested)) _linkedMissing = requested;
            }
            else if (Stored(remembered)) _selected = remembered!;
            else if (Stored(linked)) _selected = linked!;
            else
            {
                if (linked is not null) _linkedMissing = linked;
                // The current imported project has no snapshot (no source, or its snapshot was not created): an unrelated snapshot is never
                // presented as current; the selector still lists every stored snapshot.
                var importWithoutSnapshot = _currentImport is not null && linked is null;
                _selected = _linkedMissing is null && !importWithoutSnapshot ? _snapshots.FirstOrDefault()?.Id.ToString() ?? "" : "";
            }
            SnapshotState.SelectSnapshot(key, _selected);
        }
        catch (Exception) { _error = new("SOURCE_SNAPSHOT_LIST_FAILED", "upload", "Stored source snapshots could not be loaded. Existing selections are unchanged."); }
    }
    private async Task Upload(InputFileChangeEventArgs args)
    {
        _busy = true; _error = null; _pendingArchive = args.File.Name;
        try { await using var stream = args.File.OpenReadStream(50 * 1024 * 1024); var (snapshot, error) = await Api.AnalyzeSourceSnapshotDetailedAsync(_profile?.Id ?? "", args.File.Name, stream); _error = error; if (snapshot is not null) { SnapshotState.Invalidate(); await Load(); _selected = snapshot.Id.ToString(); SnapshotChanged(); _area = SourceAnalysisAreas.Overview; _domain = null; Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["area"] = null, ["view"] = null })); _focusId = "sa-current-heading"; } }
        catch (IOException) { _error = new("ARCHIVE_TOO_LARGE", "upload", "The selected ZIP exceeds the 50 MB upload limit.", Limit: 50L * 1024 * 1024); }
        catch (HttpRequestException ex) when (BackendRequestClassifier.FromException("Source upload", ex).IsTransportFailure) { _error = new("SOURCE_ANALYSIS_UNAVAILABLE", "upload", "Source Analysis could not be reached. Existing snapshots are unchanged; retry when the service is available."); }
        catch (HttpRequestException ex) { _error = new("SOURCE_UPLOAD_FAILED", "upload", $"{BackendRequestClassifier.FromException("Source upload", ex).UserMessage} Existing snapshots are unchanged."); }
        catch (TaskCanceledException) { _error = new("SOURCE_UPLOAD_TIMEOUT", "upload", "The source upload did not finish before the request timed out. Check the snapshot list before retrying; the server may have completed analysis."); }
        catch (Exception) { _error = new("SOURCE_UPLOAD_FAILED", "upload", "The source upload could not be completed. Existing snapshots are unchanged; correct the archive or retry."); }
        finally { _busy = false; }
    }
    private BirkNext.DatabaseArchitecture.DatabaseArchitectureSnapshot? Previous(IqrSourceSnapshot current) => _snapshots.Where(s => s.IntegrationId == current.IntegrationId && s.AnalyzedAt < current.AnalyzedAt && s.DatabaseArchitecture is not null).OrderByDescending(s => s.AnalyzedAt).FirstOrDefault()?.DatabaseArchitecture;
    private static string UploadErrorTitle(SourceUploadFailure failure) => failure.Stage switch
    {
        "prerequisite" => "Target Environment required",
        "validation" => "Source archive rejected",
        "analysis" => "Source analysis did not complete",
        "persistence" => "Source snapshot could not be saved",
        _ => "Source upload could not be completed",
    };
    private static string FormatUploadValue(string code, long value) => code.Contains("SIZE", StringComparison.OrdinalIgnoreCase)
        ? $"{value / (1024d * 1024):0.#} MB" : value.ToString("N0");
