@page "/correlation-review"
@using BirkNext.Interpretation
@using BirkNext.Integrations
@using BirkNext.Web.Components
@using BirkNext.Web.Models
@using BirkNext.Web.Services.ProjectEvidence
@inject ICanonicalInterpretationApiService Api
@inject IIntegrationCatalogApiService Catalog
@inject IFrontendAnalysisContextFactory ContextFactory
@inject IServiceProvider Services
@implements IDisposable

<PageTitle>Relationship Review</PageTitle>

<div class="cr" data-testid="correlation-review">
    <header class="cr-head">
        <h1>Relationship Review</h1>
        <p class="cr-lead" data-testid="cr-intro">Discover, validate and govern relationships across project evidence.</p>
        <p class="cr-muted cr-lead">Requirements, user stories, source code, APIs, contracts and tests — decisions made here are shared by every BirkNext module, so a relationship is reviewed once.
            A suggestion is never treated as established, and a confirmed relationship is not proof that anything was implemented, executed or passed.</p>
        @if (_scope is not null)
        {
            <p class="cr-muted cr-context" data-testid="cr-scope">Target Application: <strong data-testid="cr-application">@(_applicationName ?? "not set")</strong>
                · Environment: <span data-testid="cr-environment">@_environmentName</span>
                @if (_summary is { InterpretationId: not null } ctx)
                {
                    <span data-testid="cr-context-analysis"> · Last analyzed @ctx.InterpretedAt!.Value.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC · rules @string.Join(", ", ctx.RuleSetVersions)
                        · @_rows.Count(r => _selected.Contains(r.Id)) of @_rows.Count sources</span>
                }
            </p>
        }
    </header>

    @if (_initialising)
    {
        <InlineLoading Text="Loading the active project…" Class="cr-muted" />
    }
    else if (_scope is null)
    {
        <p class="cr-muted" data-testid="cr-no-scope">Select a Target Environment first. Relationships are always reviewed for one application in one environment.</p>
    }
    else
    {
        <div class="cr-tabs cr-page-tabs" role="tablist" aria-label="Relationship Review">
            @foreach (var (key, label) in Tabs)
            {
                <button type="button" role="tab" id="@($"cr-tab-{key}")" class="cr-tab @(_tab == key ? "is-active" : "")" aria-selected="@(_tab == key ? "true" : "false")"
                        tabindex="@(_tab == key ? "0" : "-1")" @onkeydown="TabKey"
                        aria-controls="cr-tabpanel" data-testid="@($"cr-tab-{key}")" @onclick="() => _tab = key">@label@(key == "review" && _queue is { } tq ? $" ({tq.Decisions})" : "")</button>
            }
        </div>
        <div id="cr-tabpanel" role="tabpanel" aria-labelledby="@($"cr-tab-{_tab}")" class="cr-panel">
            @if (_tab == "review") { @QueueSection() }
            else if (_tab == "relationships") { @ExploreSection() }
            else if (_tab == "history") { @GovernanceSection() @HistorySection() }
            else { @OverviewSection() @SourcesSection() }
        </div>
    }
</div>

@code {
    private static readonly (string, string)[] InterpretStages = [("interpret", "Analyzing relationships in the stored evidence"), ("refresh", "Refreshing the review queue")];
    private static readonly (string Key, string Label)[] Tabs = [("overview", "Overview"), ("review", "Needs Review"), ("relationships", "Relationships"), ("history", "History & Governance")];
    /// <summary>Quick filters of the relationship explorer: the entity kinds the review is about.</summary>
    private static readonly (CanonicalEntityType Type, string Label)[] ExploreKinds =
    [
        (CanonicalEntityType.Requirement, "Requirements"), (CanonicalEntityType.UserStory, "User stories"), (CanonicalEntityType.SourceSymbol, "Source code"),
        (CanonicalEntityType.ApiOperation, "APIs"), (CanonicalEntityType.Contract, "Contracts"), (CanonicalEntityType.Test, "Tests"),
    ];

    /// <summary>Opens a tab directly (?tab=review|relationships|history), e.g. from Release Readiness.</summary>
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }
    /// <summary>Opens the queue on one item type (?tab=review&amp;type=IdentityConflict), e.g. from a blocked governance gate.</summary>
    [SupplyParameterFromQuery(Name = "type")] public string? QueueType { get; set; }

    private string _tab = "overview";
    private string? _applicationName, _environmentName;
    private bool _historyLoaded, _customizeSources;
    private IReadOnlyList<RelationshipSource> _rows = [];

    /// <summary>Relationships are analyzed once an interpretation exists; before that every count is "Not analyzed", never 0.</summary>
    private bool Analyzed => _summary?.InterpretationId is not null;

    private RenderFragment OverviewSection() => __builder =>
    {
        if (!_historyLoaded) { <InlineLoading Text="Loading the latest analysis…" Class="cr-muted" /> }
        else if (_summary is { InterpretationId: not null } sum)
        {
            var totalRelations = sum.RelationsByType.Values.Sum();
            <ul class="cr-metrics" data-testid="cr-metrics" aria-label="Relationship governance metrics">
                <li>@Metric("cr-sum-entities", sum.EntitiesByType.Values.Sum(), "Entities", "Distinct canonical entities in the latest analysis", null, () => _tab = "relationships")</li>
                <li>@Metric("cr-sum-established", sum.EstablishedRelations, "Established", "Explicit, derived or confirmed relationships", null, () => _tab = "relationships")</li>
                <li>@Metric("cr-sum-suggestions", sum.Suggestions, "Suggested", "Optional proposals — never counted until confirmed", null, () => OpenQueueAsync(ReviewItemKind.Suggestion, null))</li>
                <li>@Metric("cr-sum-review", sum.Decisions, "Decisions required", "Questions someone must answer", sum.Decisions > 0 ? "attention" : null, () => OpenQueueAsync(ReviewItemKind.Decision, null))</li>
                <li>@Metric("cr-sum-conflicts", sum.Conflicts, "Identity conflicts", "Part of the decisions; can block release readiness", sum.Conflicts > 0 ? "blocking" : null,
                    () => OpenQueueAsync(ReviewItemKind.Decision, ReviewItemType.IdentityConflict))</li>
                <li>@Metric("cr-sum-not-counted", sum.NotCounted, "Not counted", "Ambiguous alternatives, unresolved references or rejected", null, (Action?)null)</li>
            </ul>
            <p class="cr-muted cr-small" data-testid="cr-accounting">@totalRelations relationships = @sum.EstablishedRelations established + @sum.CandidateRelations candidates + @sum.NotCounted not counted. Identity conflicts are part of the decisions, not an addition to them.</p>
            @if (sum.Conflicts > 0 || sum.Decisions > 0)
            {
                <section class="cr-card cr-attention" aria-labelledby="cr-attention-h" data-testid="cr-attention">
                    <h2 id="cr-attention-h">Governance attention</h2>
                    <GovernanceGatePanel Scope="@(_scope!)" Version="_governanceVersion" MaxFindings="3" TestId="cr-overview-governance" />
                    <p><button type="button" class="btn btn-primary btn-sm" data-testid="cr-overview-review"
                               @onclick="() => OpenQueueAsync(ReviewItemKind.Decision, sum.Conflicts > 0 ? ReviewItemType.IdentityConflict : null)">
                        @(sum.Conflicts > 0 ? $"Resolve {sum.Conflicts} identity conflict{(sum.Conflicts == 1 ? "" : "s")}" : $"Review {sum.Decisions} decision{(sum.Decisions == 1 ? "" : "s")}")</button></p>
                </section>
            }
            <section class="cr-card" aria-labelledby="cr-summary-h" data-testid="cr-summary">
                <h2 id="cr-summary-h">Latest analysis</h2>
                <p class="cr-muted">@sum.InterpretedAt!.Value.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC · rules @string.Join(", ", sum.RuleSetVersions)
                    · <span data-testid="cr-sum-candidates">@sum.CandidateRelations</span> candidate relationships (not counted)</p>
                <p class="cr-muted" data-testid="cr-sum-contracts">Contracts: @sum.Contracts.LogicalContracts logical · @sum.Contracts.Versions versions · @sum.Contracts.DistinctContents distinct contents · @sum.Contracts.Occurrences occurrences in packages</p>
                @if (sum.Packages.Count > 0)
                {
                    <ul class="cr-packages" aria-label="Packages and what they provide">
                        @foreach (var p in sum.Packages)
                        {
                            <li data-testid="cr-sum-package"><strong>@p.Name</strong>
                                @foreach (var c in p.Capabilities) { <MetaBadge Kind="BadgeKind.Type" Text="@CorrelationPresentation.CapabilityLabel(c)" /> }
                                @if (p.Libraries.Count > 0) { <span class="cr-muted"> · @p.Libraries.Count shared librar@(p.Libraries.Count == 1 ? "y" : "ies")</span> }
                            </li>
                        }
                    </ul>
                }
            </section>
        }
        else
        {
            <section class="cr-card" aria-labelledby="cr-summary-h" data-testid="cr-not-analyzed">
                <h2 id="cr-summary-h">Relationships <span class="cr-count">Not analyzed</span></h2>
                <p class="cr-muted">Relationships have not been analyzed for @(_applicationName ?? "this application") yet. Analyze relationships from the source evidence below;
                    until then nothing is counted as established, needing review or conflicting.</p>
                <dl class="cr-counts">
                    <div><dt>Established relationships</dt><dd class="cr-na">Not analyzed</dd></div>
                    <div><dt>Decisions needed</dt><dd class="cr-na">Not analyzed</dd></div>
                    <div><dt>Conflicts</dt><dd class="cr-na">Not analyzed</dd></div>
                    <div><dt>Governance</dt><dd class="cr-na">Not assessed</dd></div>
                </dl>
            </section>
        }
    };

    private RenderFragment SourcesSection() => __builder =>
    {
        <section class="cr-card" aria-labelledby="cr-interpret-h" data-testid="cr-interpret">
            <h2 id="cr-interpret-h">Source evidence</h2>
            <p class="cr-muted">Reads stored Source Analysis snapshots only (no archive is parsed again). Each analysis is recorded as a new, frozen version; an unchanged
                one is reused, and earlier versions never change.</p>
            @if (_rows.Count == 0) { <p class="cr-muted" data-testid="cr-no-sources">No Source Analysis snapshots are stored for this environment yet. Import the project's sources first.</p> }
            else
            {
                <p data-testid="cr-source-summary">@SourceSummary()</p>
                @if (_delivery is { } delivery)
                {
                    <label class="cr-delivery" data-testid="cr-delivery"><input type="checkbox" checked="@_includeDelivery" @onchange="e => _includeDelivery = (bool)e.Value!" data-testid="cr-delivery-include" />
                        Include Delivery snapshot <strong>@(delivery.Label ?? delivery.Id[..Math.Min(8, delivery.Id.Length)])</strong>
                        <span class="cr-muted cr-small">— the feature packs, requirements, stories and tasks Release Readiness and Traceability read. Without it the analysis has no release scope.</span></label>
                }
                else if (_historyLoaded)
                {
                    <p class="cr-muted cr-small" data-testid="cr-no-delivery">No Delivery snapshot has been analyzed for this project yet: feature packs (the release scope) come from a Delivery snapshot. Import the
                        project's work items in Delivery Reports, then analyze it from there or here.</p>
                }
                <p class="cr-muted" data-testid="cr-source-outcomes">@string.Join(" · ", _rows.GroupBy(r => r.Outcome).OrderBy(g => g.Key).Select(g => $"{g.Count()} {g.First().OutcomeLabel.ToLowerInvariant()}"))</p>
                <div class="cr-actions">
                    <button type="button" class="btn btn-primary" disabled="@(AnalyzeBlockedReason is not null)" @onclick="InterpretAsync" data-testid="cr-interpret-run"
                            aria-describedby="@(AnalyzeBlockedReason is null ? "cr-interpret-what" : "cr-interpret-blocked")">Analyze relationships</button>
                    <button type="button" class="btn btn-secondary" aria-expanded="@(_customizeSources ? "true" : "false")" aria-controls="cr-source-list"
                            data-testid="cr-customize" @onclick="() => _customizeSources = !_customizeSources">@(_customizeSources ? "Hide sources" : "Customize sources")</button>
                </div>
                @if (AnalyzeBlockedReason is { } blocked) { <p id="cr-interpret-blocked" class="cr-muted cr-small" data-testid="cr-interpret-blocked">@blocked</p> }
                else
                {
                    @* What a (re)analysis does, before it runs: a new frozen version only when inputs changed; earlier results and decisions are kept. *@
                    <p id="cr-interpret-what" class="cr-muted cr-small" data-testid="cr-interpret-what">@(_summary is { InterpretationId: not null } current
                        ? $"The current analysis is from {current.InterpretedAt!.Value.UtcDateTime:yyyy-MM-dd HH:mm} UTC. Analyzing again records a new frozen version only if the selected sources or rules changed (otherwise it is reused); earlier versions and review decisions are kept, and the current results stay visible while it runs."
                        : "The first analysis is recorded as a frozen version; nothing is counted as established before it.")</p>
                }
                @if (_customizeSources)
                {
                    <ul class="cr-sources" id="cr-source-list" aria-label="Sources to analyze">
                        @foreach (var s in _rows)
                        {
                            <li data-testid="cr-source-row" data-id="@s.Id" data-outcome="@s.Outcome"><label><input type="checkbox" checked="@_selected.Contains(s.Id)" @onchange="e => Toggle(s.Id, (bool)e.Value!)" data-testid="cr-source" />
                                @s.Label</label>
                                <span class="cr-status cr-status-@s.Outcome.ToString().ToLowerInvariant()" data-testid="cr-source-status">@s.OutcomeLabel</span>
                                @if (s.Associated) { <MetaBadge Kind="BadgeKind.Scope" Text="Associated" /> }
                                <span class="cr-muted">· @s.AnalyzedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC</span>
                                @if (s.Detail is not null) { <span class="cr-muted cr-source-detail" data-testid="cr-source-detail">@s.Detail</span> }
                            </li>
                        }
                    </ul>
                    <button type="button" class="btn btn-secondary btn-sm" data-testid="cr-reset-sources" @onclick="ResetSelection">Reset to the default selection</button>
                }
            }
            @if (_interpreting is { } run)
            {
                <OperationProgress Title="Analyzing relationships in the selected sources…" Stages="run.Stages" RunningText="working…" HeadingId="cr-interpret-heading"
                                   TestId="cr-interpret-progress" StagesTestId="cr-interpret-stages" StageTestId="cr-interpret-stage" />
            }
            @if (_interpretError is not null)
            {
                <p class="cr-error" role="alert" data-testid="cr-interpret-error">@_interpretError</p>
                @if (_summary is { InterpretationId: not null } kept) { <p class="cr-muted cr-small" data-testid="cr-interpret-kept">The previous analysis (@kept.InterpretedAt!.Value.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC) is unchanged and still the current one.</p> }
            }
            @if (_lastRun is { } last)
            {
                @* A confirmation of this action, dismissible — the saved result itself is described by "Latest analysis" above. *@
                <p class="cr-muted cr-confirm" role="status" data-testid="cr-interpret-result">@(last.Reused
                    ? "Nothing changed in the selected sources or rules: the existing analysis was reused (no new version)."
                    : "A new frozen analysis version was recorded.") @($"{last.EntityCount} entities · {last.RelationCount} relationships · rules {string.Join(", ", last.RuleSetVersions)}")
                    <button type="button" class="btn btn-link btn-sm" data-testid="cr-interpret-dismiss" @onclick="() => _lastRun = null">Dismiss<span class="visually-hidden"> confirmation</span></button></p>
            }
        </section>
    };

    private string SourceSummary()
    {
        var selected = _rows.Count(r => _selected.Contains(r.Id));
        var associated = _rows.Count(r => r.Associated);
        var basis = associated > 0
            ? $"the {associated} source{(associated == 1 ? "" : "s")} associated with {_applicationName ?? "the Target Application"} in Project Evidence"
            : "every analyzed source (none is associated with the Target Application in Project Evidence yet)";
        return $"{selected} of {_rows.Count} source{(_rows.Count == 1 ? "" : "s")} selected · default: {basis}.";
    }

    private RenderFragment GovernanceSection() => __builder =>
    {
        if (!_historyLoaded) { <InlineLoading Text="Loading governance…" Class="cr-muted" /> }
        else if (!Analyzed)
        {
            <section class="cr-card" aria-labelledby="cr-gov-h" data-testid="cr-governance-not-assessed">
                <h2 id="cr-gov-h">Governance</h2>
                <p>Governance not assessed — Analyze project relationships before evaluating governance rules.</p>
            </section>
        }
        else
        {
            <GovernanceGatePanel Scope="@_scope" Version="_governanceVersion" TestId="cr-governance" />
        }
    };

    private RenderFragment QueueSection() => __builder =>
    {
        <section class="cr-card" aria-labelledby="cr-queue-h" data-testid="cr-queue">
            <h2 id="cr-queue-h">Needs review <span class="cr-count" data-testid="cr-decision-count">@(_queue?.Decisions ?? 0) decision@(_queue?.Decisions == 1 ? "" : "s")</span></h2>
            <p class="cr-muted">One shared queue for every surface: a question answered here is answered for Delivery, Traceability, Topology, IQR, AQR and Project Evidence.
                <strong>Required decisions</strong> block or change an interpretation; <strong>optional suggestions</strong> count nowhere until confirmed.</p>
            <div class="cr-queue-tools">
                <div class="cr-tabs" role="tablist" aria-label="Review items">
                    <button type="button" role="tab" class="cr-tab @(_kind == ReviewItemKind.Decision ? "is-active" : "")" aria-selected="@(_kind == ReviewItemKind.Decision ? "true" : "false")"
                            data-testid="cr-kind-decisions" @onclick="() => KindAsync(ReviewItemKind.Decision)">Required decisions (@(_queue?.Decisions ?? 0))</button>
                    <button type="button" role="tab" class="cr-tab @(_kind == ReviewItemKind.Suggestion ? "is-active" : "")" aria-selected="@(_kind == ReviewItemKind.Suggestion ? "true" : "false")"
                            data-testid="cr-kind-suggestions" @onclick="() => KindAsync(ReviewItemKind.Suggestion)">Optional suggestions (@(_queue?.Suggestions ?? 0))</button>
                </div>
                @if (_queue is { } counts && (_kind == ReviewItemKind.Decision ? counts.DecisionsByType : counts.SuggestionsByType) is { Count: > 0 } byType)
                {
                    <label class="cr-filter">Type
                        <select @onchange="e => FilterAsync((string?)e.Value)" data-testid="cr-type-filter">
                            <option value="">All types</option>
                            @foreach (var (t, n) in byType) { <option value="@t" selected="@(t == _type)">@CorrelationQueueGroups.TypeOption(t, n)</option> }
                        </select>
                    </label>
                }
                <label class="cr-filter">Group by
                    <select value="@_groupBy" @onchange="e => _groupBy = e.Value?.ToString() ?? CorrelationQueueGroups.ByType" data-testid="cr-group-by">
                        <option value="@CorrelationQueueGroups.ByType">Review type</option>
                        <option value="@CorrelationQueueGroups.BySource">Source entity</option>
                        <option value="@CorrelationQueueGroups.ByTarget">Target entity</option>
                    </select>
                </label>
            </div>
            @if (_queueLoading && _queue is null) { <InlineLoading Text="Loading the review queue…" Class="cr-muted" /> }
            else if (_queueError is not null) { <LoadError Title="Shared review queue unavailable" Message="@_queueError" OnRetry="LoadQueueAsync" TestId="cr-queue-error" /> }
            else if (_queue is { Page.Items.Count: 0 }) { <p class="cr-muted" data-testid="cr-queue-empty">@(!Analyzed ? "Not analyzed — analyze relationships on the Overview tab to find what needs review." : _kind == ReviewItemKind.Decision ? "Nothing waits for a decision." : "No suggestions.")</p> }
            else if (_queue is { } queue)
            {
                var q = queue.Page;
                var selected = SelectedItem(q.Items);
                @* The queue as a compact, grouped list beside one inspector: the selected question with all its evidence and the focused decision. *@
                <div class="cr-review" data-testid="cr-review" aria-busy="@(_queueLoading ? "true" : "false")">
                    <div class="cr-review-list">
                        @foreach (var group in CorrelationQueueGroups.Group(q.Items, _groupBy))
                        {
                            <div class="cr-group" data-testid="cr-group" data-group="@group.Key">
                                <p class="cr-group-h"><strong>@group.Label</strong> <span class="cr-muted">@group.Items.Count</span></p>
                                <ul class="cr-items" aria-label="@group.Label">
                                    @foreach (var item in group.Items)
                                    {
                                        var current = item;
                                        var isSelected = selected?.ReviewItemId == item.ReviewItemId;
                                        <li class="cr-item @(isSelected ? "is-selected" : "")" data-testid="cr-queue-item" data-rule="@item.RuleId" data-type="@item.Type" data-selected="@(isSelected ? "true" : "false")">
                                            <button type="button" class="cr-item-btn" aria-pressed="@(isSelected ? "true" : "false")" data-testid="cr-item-open" @onclick="() => _selectedItem = current.ReviewItemId">
                                                <span class="cr-item-line">
                                                    <MetaBadge Kind="BadgeKind.Type" Text="@CanonicalReviewQueue.Label(item.Type)" TestId="cr-item-type" />
                                                    @if (item.Relation is { } r) { <span class="cr-item-title">@r.Source.DisplayName <span class="cr-verb">@CorrelationPresentation.RelationLabel(r.Type)</span> @r.Target.DisplayName</span> }
                                                    else if (item.Subject is { } subject) { <span class="cr-item-title">@subject.DisplayName</span> }
                                                </span>
                                                <span class="cr-muted cr-item-reason">@item.Reason</span>
                                                @if (item.AffectedConsumers.Count > 0) { <span class="cr-muted cr-small" data-testid="cr-affects">Affects @item.AffectedConsumers.Count consumer@(item.AffectedConsumers.Count == 1 ? "" : "s")</span> }
                                            </button>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                        <div class="cr-pager">
                            <button type="button" class="btn btn-secondary btn-sm" disabled="@(q.Skip == 0 || _queueLoading)" @onclick="() => PageAsync(-1)">Previous</button>
                            <span class="cr-muted">@(q.Skip + 1)–@(q.Skip + q.Items.Count) of @q.Total</span>
                            <button type="button" class="btn btn-secondary btn-sm" disabled="@(q.Skip + q.Items.Count >= q.Total || _queueLoading)" @onclick="() => PageAsync(1)">Next</button>
                        </div>
                    </div>
                    <div class="cr-inspector" aria-live="polite" data-testid="cr-inspector">
                        @if (selected is { } chosen) { @Inspector(chosen) }
                    </div>
                </div>
            }
            @if (_decisionError is not null) { <p class="cr-error" role="alert">@_decisionError</p> }
        </section>
    };

    /// <summary>The selected review question: both sides, status, reason, every piece of evidence with its rule, who is affected, then the decision.</summary>
    private RenderFragment Inspector(ReviewItemView item) => __builder =>
    {
        <article class="cr-inspect" data-testid="cr-inspect" data-item="@item.ReviewItemId">
            <header class="cr-inspect-head">
                <MetaBadge Kind="BadgeKind.Type" Text="@CanonicalReviewQueue.Label(item.Type)" />
                @if (item.Relation is { } rel)
                {
                    var (status, label, explanation) = CorrelationPresentation.Status(rel);
                    <SemanticStatusBadge Status="status" QualifiedLabel="@label" Explanation="@explanation" />
                }
                else
                {
                    <SemanticStatusBadge Status="@(item.Kind == ReviewItemKind.Decision ? SemanticStatus.NeedsReview : SemanticStatus.Inferred)" QualifiedLabel="@item.State" />
                }
            </header>
            @if (item.Relation is { } r)
            {
                <div class="cr-inspect-sides">
                    @foreach (var (role, side) in new[] { ("Source", r.Source), ("Target", r.Target) })
                    {
                        <div class="cr-inspect-side" data-testid="cr-inspect-side">
                            <span class="cr-muted cr-small">@role</span>
                            <span><MetaBadge Kind="BadgeKind.Type" Text="@CorrelationPresentation.TypeLabel(side.Type)" /> <strong>@side.DisplayName</strong></span>
                            <code class="cr-small" title="Canonical identity">@side.IdentityKey</code>
                        </div>
                    }
                </div>
                <p class="cr-inspect-verb"><span class="cr-verb">@CorrelationPresentation.RelationLabel(r.Type)</span>@(string.Equals(r.Explanation, item.Reason, StringComparison.Ordinal) ? "" : $" · {r.Explanation}")</p>
            }
            else if (item.Subject is { } subject) { <p><strong>@subject.DisplayName</strong> <code class="cr-small">@subject.IdentityKey</code></p> }
            <p data-testid="cr-inspect-reason">@item.Reason</p>
            @if (item.AffectedConsumers.Count > 0) { <p class="cr-muted" data-testid="cr-inspect-affects">Affects: @string.Join(" · ", item.AffectedConsumers)</p> }
            @if (item.Relation is { Evidence.Count: > 0 } withEvidence)
            {
                <details class="cr-evidence" open data-testid="cr-inspect-evidence"><summary>Why linked · evidence (@withEvidence.Evidence.Count)</summary>
                    <ul>@foreach (var e in withEvidence.Evidence.Take(15)) { <li><code>@e.Kind</code> @e.Reference @(e.Detail is null ? "" : $"· {e.Detail}")</li> }</ul>
                    <p class="cr-muted">Rule @item.RuleId@(item.RuleSetVersion is null ? "" : $" · {item.RuleSetVersion}")</p>
                </details>
            }
            @if (item.Relation is { } conf) { <p class="cr-muted cr-small" data-testid="cr-inspect-confidence">Confidence: @conf.Confidence · rule @conf.RuleId · @conf.Resolution</p> }
            @if (item.TargetKey is not null)
            {
                <div class="cr-inspect-tools">
                    <button type="button" class="btn btn-secondary btn-sm" aria-expanded="@(_previewFor == item.ReviewItemId ? "true" : "false")" data-testid="cr-preview-impact"
                            @onclick="() => TogglePreviewAsync(item)">@(_previewFor == item.ReviewItemId ? "Hide decision impact" : "Preview the impact of each decision")</button>
                    <button type="button" class="btn btn-secondary btn-sm" aria-expanded="@(_historyFor == item.TargetKey ? "true" : "false")" data-testid="cr-item-history-toggle"
                            @onclick="() => ToggleItemHistoryAsync(item)">@(_historyFor == item.TargetKey ? "Hide decision history" : "Decision history")</button>
                </div>
                @if (_previewFor == item.ReviewItemId)
                {
                    @if (_previewLoading) { <InlineLoading Text="Walking the impact of both entities…" Class="cr-muted" /> }
                    <div class="cr-preview" data-testid="cr-preview">
                        @foreach (var o in CorrelationDecisionImpact.Preview(item, ImpactOf(item.Relation?.Source.Key), ImpactOf(item.Relation?.Target.Key)))
                        {
                            <section class="cr-preview-outcome" data-testid="cr-preview-outcome" data-outcome="@o.Outcome" data-governance="@(o.ChangesGovernance ? "true" : "false")">
                                <h4>If you choose “@o.Label”</h4>
                                <ul>@foreach (var c in o.Consequences) { <li>@c</li> }</ul>
                            </section>
                        }
                    </div>
                }
                @if (_historyFor == item.TargetKey)
                {
                    @if (_itemHistory is null) { <InlineLoading Text="Loading the decision history…" Class="cr-muted" /> }
                    else if (_itemHistory.Count == 0) { <p class="cr-muted" data-testid="cr-item-history-empty">No decision has been recorded for this question yet.</p> }
                    else
                    {
                        <ol class="cr-item-history" data-testid="cr-item-history">
                            @foreach (var h in _itemHistory)
                            {
                                <li data-testid="cr-item-history-entry">#@h.Sequence · <strong>@h.Outcome</strong> by @h.Reviewer · @h.DecidedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC@(h.SupersededById is null ? "" : " · superseded")
                                    @if (!string.IsNullOrWhiteSpace(h.Notes)) { <span> — @h.Notes</span> }</li>
                            }
                        </ol>
                    }
                }
            }
            @if (item.Candidates is { Count: > 1 } alternatives)
            {
                <ul class="cr-candidates" aria-label="Alternatives" data-testid="cr-candidates">
                    @foreach (var c in alternatives)
                    {
                        <li><span>@c.Target.DisplayName</span> <span class="cr-muted">@c.Target.SourceIdentity</span>
                            <button type="button" class="btn btn-secondary btn-sm" disabled="@_saving" data-testid="cr-choose" @onclick="() => ChooseAsync(c)">Choose this</button></li>
                    }
                </ul>
                <div class="cr-actions">
                    <button type="button" class="btn btn-secondary btn-sm" disabled="@_saving" data-testid="cr-none" @onclick="() => RejectAllAsync(alternatives)">None of these</button>
                </div>
            }
            else if (item.TargetKey is null)
            {
                <p class="cr-muted" data-testid="cr-resolve-in-source">@item.Resolution</p>
            }
            else if (item.Type == ReviewItemType.IdentityConflict && item.Relation is { } conflict)
            {
                @IdentityConflict(item, conflict)
            }
            else
            {
                <div class="cr-actions">
                    <input class="form-control form-control-sm" placeholder="Note (optional)" value="@_notes.GetValueOrDefault(item.ReviewItemId)" @onchange="e => _notes[item.ReviewItemId] = (string?)e.Value" aria-label="Review note" />
                    <button type="button" class="btn btn-secondary btn-sm" disabled="@_saving" @onclick="() => DecideAsync(item, ReviewDecisionOutcome.Confirmed)" data-testid="cr-confirm">Confirm</button>
                    <button type="button" class="btn btn-secondary btn-sm" disabled="@_saving" @onclick="() => DecideAsync(item, ReviewDecisionOutcome.Rejected)" data-testid="cr-reject">Reject</button>
                    <button type="button" class="btn btn-secondary btn-sm" disabled="@_saving" @onclick="() => DecideAsync(item, ReviewDecisionOutcome.Deferred)" data-testid="cr-defer">Defer</button>
                </div>
            }
        </article>
    };

    /// <summary>The selected item on this page; the first when none is selected or the selection was decided (the next question comes up).</summary>
    private ReviewItemView? SelectedItem(IReadOnlyList<ReviewItemView> items) =>
        items.FirstOrDefault(i => i.ReviewItemId == _selectedItem) ?? items.FirstOrDefault();

    private string? _selectedItem;
    private string? _previewFor, _historyFor;
    private bool _previewLoading;
    private IReadOnlyList<ReviewDecisionView>? _itemHistory;
    private readonly Dictionary<string, CanonicalImpactView?> _impacts = new(StringComparer.Ordinal);

    private CanonicalImpactView? ImpactOf(string? key) => key is not null ? _impacts.GetValueOrDefault(key) : null;

    /// <summary>Loads the shared impact walk of both entities (once each) and shows what Confirm, Reject and Defer would change. Decides nothing.</summary>
    private async Task TogglePreviewAsync(ReviewItemView item)
    {
        if (_previewFor == item.ReviewItemId) { _previewFor = null; return; }
        _previewFor = item.ReviewItemId;
        if (_scope is null || item.Relation is not { } r) return;
        _previewLoading = true;
        try
        {
            foreach (var key in new[] { r.Source.Key, r.Target.Key }.Where(k => !_impacts.ContainsKey(k)))
                _impacts[key] = (await Api.ImpactAsync(_scope, key)).Impact;
        }
        finally { _previewLoading = false; }
    }

    /// <summary>Every recorded decision on this question (append-only; superseded ones stay listed).</summary>
    private async Task ToggleItemHistoryAsync(ReviewItemView item)
    {
        if (_historyFor == item.TargetKey) { (_historyFor, _itemHistory) = (null, null); return; }
        (_historyFor, _itemHistory) = (item.TargetKey, null);
        if (_scope is null) return;
        var (items, _) = await Api.DecisionsAsync(_scope, item.TargetKey);
        if (_historyFor == item.TargetKey) _itemHistory = items ?? [];
    }
    private string _groupBy = CorrelationQueueGroups.ByType;

    private RenderFragment ExploreSection() => __builder =>
    {
        <section class="cr-card" aria-labelledby="cr-explore-h" data-testid="cr-explore">
            <h2 id="cr-explore-h">Relationship explorer</h2>
            @if (!Analyzed)
            {
                <p class="cr-muted" data-testid="cr-explore-not-analyzed">Not analyzed — analyze relationships on the Overview tab before exploring them.</p>
            }
            else
            {
                <div class="cr-chips" role="group" aria-label="Show relationships of">
                    @foreach (var (type, label) in ExploreKinds)
                    {
                        <button type="button" class="cr-chip @(_exploreType == type.ToString() ? "is-active" : "")" aria-pressed="@(_exploreType == type.ToString() ? "true" : "false")"
                                data-testid="cr-explore-kind" data-kind="@type" @onclick="() => ExploreKind(type)">@label</button>
                    }
                </div>
                <form class="cr-search" @onsubmit="Explore" @onsubmit:preventDefault>
                    <select @bind="_exploreType" aria-label="Entity type" data-testid="cr-explore-type">
                        <option value="">Any type</option>
                        @foreach (var t in Enum.GetValues<CanonicalEntityType>()) { <option value="@t">@CorrelationPresentation.TypeLabel(t)</option> }
                    </select>
                    <input class="form-control" placeholder="Search by name or identity (e.g. FR-001, US1, AbsenceApi, GET /api/…)" @bind="_exploreText" aria-label="Search relationships" data-testid="cr-explore-text" />
                    <button type="submit" class="btn btn-secondary" data-testid="cr-explore-run">Search</button>
                </form>
                @if (_exploreSearch is not null)
                {
                    <RelationshipExplorer Scope="@(_scope!)" Search="@_exploreSearch" EntityType="@ExploreType" TestId="cr-explorer" />
                }
            }
        </section>
    };

    private RenderFragment HistorySection() => __builder =>
    {
        <section class="cr-card" aria-labelledby="cr-history-h" data-testid="cr-history">
            <h2 id="cr-history-h">Analysis and decision history</h2>
            @if (_snapshots.Count == 0) { <p class="cr-muted">Not analyzed — no relationship analysis has been recorded for this environment.</p> }
            else
            {
                <table class="cr-table">
                    <thead><tr><th>Recorded</th><th>Sources</th><th>Rules</th><th>Entities</th><th>Relations</th><th>Decisions applied</th><th>Trigger</th></tr></thead>
                    <tbody>
                        @foreach (var s in _snapshots)
                        {
                            <tr data-testid="cr-snapshot"><td>@s.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC</td><td>@string.Join(", ", s.SourceSnapshots.Select(x => x.Label ?? x.Id))</td>
                                <td>@string.Join(", ", s.RuleSetVersions)</td><td>@s.EntityCount</td><td>@s.RelationCount</td><td>@s.DecisionSequence</td><td>@s.Trigger</td></tr>
                        }
                    </tbody>
                </table>
                @if (_snapshots.Count > 1)
                {
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="CompareAsync" data-testid="cr-compare">Compare the latest two</button>
                    @if (_comparison is { } c)
                    {
                        <p class="cr-muted" data-testid="cr-comparison">@c.Added.Count added · @c.Removed.Count removed · @c.Changed.Count changed@(c.RuleSetChanges.Count > 0 ? $" · rules {string.Join("; ", c.RuleSetChanges)}" : "")</p>
                    }
                }
            }
            @if (_decisions.Count > 0)
            {
                <h3 class="cr-sub">Decision history</h3>
                <ul class="cr-decisions">
                    @foreach (var d in _decisions.Take(30))
                    {
                        <li data-testid="cr-decision">#@d.Sequence · @d.Outcome · @d.TargetKind · <span class="cr-muted">@d.Reviewer, @d.DecidedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC@(d.SupersededById is null ? "" : " · superseded")</span>
                            @if (!string.IsNullOrWhiteSpace(d.Notes)) { <span> — @d.Notes</span> }</li>
                    }
                </ul>
            }
        </section>
    };


    private RenderFragment Metric(string testId, int value, string label, string detail, string? tone, Func<Task>? open) => __builder =>
    {
        if (open is null)
        {
            <div class="cr-metric @(tone is null ? null : $"is-{tone}")" data-testid="@($"{testId}-tile")"><strong data-testid="@testId">@value</strong><span class="cr-metric-label">@label</span><small>@detail</small></div>
        }
        else
        {
            <button type="button" class="cr-metric @(tone is null ? null : $"is-{tone}")" data-testid="@($"{testId}-tile")" @onclick="open"><strong data-testid="@testId">@value</strong><span class="cr-metric-label">@label</span><small>@detail</small></button>
        }
    };

    private RenderFragment Metric(string testId, int value, string label, string detail, string? tone, Action? open) =>
        Metric(testId, value, label, detail, tone, open is null ? null : () => { open(); return Task.CompletedTask; });

    /// <summary>
    /// An identity conflict: the two entities side by side, what each option means, and a written rationale before Confirm or Reject (the backend
    /// refuses either without one). Deferring needs none and changes nothing: the release block stays until a reviewer decides.
    /// </summary>
    private RenderFragment IdentityConflict(ReviewItemView item, CanonicalRelationView conflict) => __builder =>
    {
        var rationale = _notes.GetValueOrDefault(item.ReviewItemId);
        var hasRationale = !string.IsNullOrWhiteSpace(rationale);
        <div class="cr-conflict" data-testid="cr-conflict">
            <div class="cr-conflict-sides">
                @foreach (var side in new[] { conflict.Source, conflict.Target })
                {
                    <div class="cr-conflict-side" data-testid="cr-conflict-side">
                        <MetaBadge Kind="BadgeKind.Type" Text="@CorrelationPresentation.TypeLabel(side.Type)" />
                        <strong>@side.DisplayName</strong>
                        <span class="cr-muted cr-small" title="Canonical identity">@side.IdentityKey</span>
                        @if (!string.IsNullOrWhiteSpace(side.SourceIdentity)) { <span class="cr-muted cr-small">@side.SourceIdentity</span> }
                    </div>
                }
            </div>
            @* Source evidence for a human decision: each entity's declared identity, aliases (and who declared them) and occurrences, side by side —
               one disclosure, so the options, rationale and decision stay right below the issue instead of after two long inspectors. *@
            <details class="cr-conflict-evidence-more" data-testid="cr-conflict-evidence-more">
                <summary>Inspect source evidence for both entities (declarations, aliases, located occurrences)</summary>
                <div class="cr-conflict-evidence" data-testid="cr-conflict-evidence">
                    <RelationshipEntityInspector Scope="@(_scope!)" EntityId="conflict.Source.Id" Compact="true" TestId="cr-conflict-source" />
                    <RelationshipEntityInspector Scope="@(_scope!)" EntityId="conflict.Target.Id" Compact="true" TestId="cr-conflict-target" />
                </div>
            </details>
            <ul class="cr-conflict-options cr-small">
                <li><strong>Same entity</strong> — the alias is valid; both names mean one thing. Consumers merge them.</li>
                <li><strong>Separate entities</strong> — the alias declaration is wrong or ambiguous; they stay apart.</li>
                <li><strong>Defer</strong> — decide later. Nothing changes and release readiness stays blocked.</li>
            </ul>
            <label class="cr-rationale">Rationale <span class="cr-muted cr-small">(required to confirm or reject — recorded with your name and the time)</span>
                <textarea rows="2" data-testid="cr-rationale" value="@rationale" @oninput="e => _notes[item.ReviewItemId] = e.Value?.ToString()"
                          placeholder="Why these are, or are not, the same entity"></textarea></label>
            <div class="cr-actions">
                <button type="button" class="btn btn-primary btn-sm" disabled="@(_saving || !hasRationale)" data-testid="cr-conflict-same" @onclick="() => DecideAsync(item, ReviewDecisionOutcome.Confirmed)">Same entity</button>
                <button type="button" class="btn btn-secondary btn-sm" disabled="@(_saving || !hasRationale)" data-testid="cr-conflict-separate" @onclick="() => DecideAsync(item, ReviewDecisionOutcome.Rejected)">Separate entities</button>
                <button type="button" class="btn btn-secondary btn-sm" disabled="@_saving" data-testid="cr-defer" @onclick="() => DecideAsync(item, ReviewDecisionOutcome.Deferred)">Defer</button>
            </div>
        </div>
    };

    private async Task OpenQueueAsync(ReviewItemKind kind, ReviewItemType? type)
    {
        (_tab, _kind, _type, _skip) = ("review", kind, type, 0);
        await LoadQueueAsync();
    }

    private void TabKey(KeyboardEventArgs e)
    {
        var index = Array.FindIndex(Tabs, t => t.Key == _tab);
        var next = e.Key switch { "ArrowRight" => (index + 1) % Tabs.Length, "ArrowLeft" => (index + Tabs.Length - 1) % Tabs.Length, "Home" => 0, "End" => Tabs.Length - 1, _ => -1 };
        if (next >= 0) _tab = Tabs[next].Key;
    }

    private BirkNext.Snapshots.SnapshotReference? _delivery;
    private bool _includeDelivery = true;
    private bool _initialising = true, _queueLoading, _saving;
    /// <summary>Bumped after every decision or interpretation: the governance gate is evaluated again (one fact, recomputed).</summary>
    private int _governanceVersion;
    private string? _scope, _queueError, _decisionError, _interpretError, _exploreText, _exploreSearch, _exploreType;
    private readonly HashSet<Guid> _selected = [];
    private ReviewAssessment? _interpreting;
    private InterpretationSnapshotView? _lastRun;
    private ReviewQueueView? _queue;
    private ReviewItemKind _kind = ReviewItemKind.Decision;
    private ReviewItemType? _type;
    private int _skip, _generation;
    private List<InterpretationSnapshotView> _snapshots = [];
    private List<ReviewDecisionView> _decisions = [];
    private InterpretationComparison? _comparison;
    private CanonicalSummaryView? _summary;
    private readonly Dictionary<string, string?> _notes = [];

    private CanonicalEntityType? ExploreType => Enum.TryParse<CanonicalEntityType>(_exploreType, out var t) ? t : null;

    protected override async Task OnInitializedAsync()
    {
        var profile = (await ContextFactory.GetActiveContextAsync()).ActiveProfileOrNull;
        _scope = CorrelationPresentation.Scope(profile?.Id);
        // The context is the application under test (Target Application), shown with its environment — never the environment's name as "project".
        // The context's profile is a data-minimized copy without the Target Application, so it is read from the saved profile (as the project strip does).
        var saved = profile is null ? null : Services.GetService<IFrontendAnalysisSettingsService>()?.Settings.Profiles.FirstOrDefault(p => p.Id == profile.Id);
        (_applicationName, _environmentName) = (TargetApplications.Of(saved)?.Name, profile?.Name);
        if (Tab is "review" or "relationships" or "history") _tab = Tab;
        if (Enum.TryParse<ReviewItemType>(QueueType, out var queueType))
            (_type, _kind) = (queueType, queueType is ReviewItemType.TestLink or ReviewItemType.CapabilityRelation or ReviewItemType.SourceSymbol ? ReviewItemKind.Suggestion : ReviewItemKind.Decision);
        _initialising = false;
        if (_scope is null) return;
        _governanceVersion++;
        await Task.WhenAll(LoadSourcesAsync(), LoadQueueAsync(), LoadHistoryAsync());
    }

    /// <summary>Stored snapshots with their real per-area outcome (Source Analysis setup) and Project Evidence association; the default selection is
    /// the associated sources. Setup and evidence are optional: without them the code analyzer's status is shown and every usable source is selected.</summary>
    private async Task LoadSourcesAsync()
    {
        List<IqrSourceSnapshotSummary> stored = [];
        try { stored = [.. await Catalog.ListSourceSnapshotSummariesAsync(_scope!) ?? []]; }
        catch (Exception e) when (BackendRequestClassifier.IsRequestFailure(e)) { _interpretError = "Source Analysis snapshots could not be listed."; }
        SourceSetupView? setup = null;
        ProjectEvidenceView? evidence = null;
        if (stored.Count > 0)
        {
            if (Services.GetService<IIntegrationJourneysApiService>() is { } journeys)
            {
                try { setup = (await journeys.SourceSetupAsync(_scope)).Value; }
                catch (Exception e) when (BackendRequestClassifier.IsRequestFailure(e)) { }
            }
            if (Services.GetService<IProjectEvidenceService>() is { } projectEvidence)
            {
                try { evidence = await projectEvidence.GetAsync(_scope); }
                catch (Exception e) when (BackendRequestClassifier.IsRequestFailure(e)) { }
            }
        }
        _rows = RelationshipReviewSources.Of(stored, setup, evidence);
        ResetSelection();
        StateHasChanged();
    }

    private void ResetSelection() { _selected.Clear(); _selected.UnionWith(RelationshipReviewSources.DefaultSelection(_rows)); }

    private void Toggle(Guid id, bool on) { if (on) _selected.Add(id); else _selected.Remove(id); }

    /// <summary>Why Analyze relationships is unavailable (null when it can run): one analysis at a time, and at least one source.</summary>
    private string? AnalyzeBlockedReason => _interpreting is not null ? "An analysis is running; wait for it to finish."
        : _selected.Count == 0 ? "Select at least one source (Customize sources) to analyze."
        : null;

    private async Task InterpretAsync()
    {
        if (_scope is null || AnalyzeBlockedReason is not null) return;
        var run = new ReviewAssessment(++_generation, InterpretStages);
        (_interpreting, _interpretError) = (run, null);
        void Changed() => _ = InvokeAsync(StateHasChanged);
        try
        {
            Guid? deliveryId = _includeDelivery && _delivery is { } d && Guid.TryParse(d.Id, out var parsed) ? parsed : null;
            var (snapshot, error) = await run.StageAsync("interpret", ct => Api.InterpretAsync(_scope, new([.. _selected], deliveryId, Trigger: "Relationship Review"), ct), Changed);
            if (error is not null) { _interpretError = error; return; }
            _lastRun = snapshot;
            await run.StageAsync("refresh", async _ => { await Task.WhenAll(LoadQueueAsync(), LoadHistoryAsync()); return true; }, Changed);
        }
        catch (OperationCanceledException) { }
        finally { _interpreting = null; run.Dispose(); }
    }

    private async Task LoadQueueAsync()
    {
        if (_scope is null) return;
        (_queueLoading, _queueError) = (true, null);
        var (queue, error) = await Api.ReviewItemsAsync(_scope, _kind, _type, _skip, 20);
        (_queue, _queueError, _queueLoading) = (queue, error, false);
        StateHasChanged();
    }

    private async Task LoadHistoryAsync()
    {
        if (_scope is null) return;
        _snapshots = [.. (await Api.SnapshotsAsync(_scope)).Items];
        // The Delivery snapshot the latest analysis that had one used: offered (and selected) so re-analyzing never drops the release scope silently.
        _delivery = _snapshots.SelectMany(s => s.SourceSnapshots).FirstOrDefault(r => r.Type == BirkNext.Snapshots.SnapshotType.Delivery);
        _summary = (await Api.SummaryAsync(_scope)).Summary;
        _decisions = [.. (await Api.DecisionsAsync(_scope)).Items];
        _historyLoaded = true;
        StateHasChanged();
    }

    private async Task FilterAsync(string? type) { _type = Enum.TryParse<ReviewItemType>(type, out var t) ? t : null; _skip = 0; await LoadQueueAsync(); }

    private async Task KindAsync(ReviewItemKind kind) { (_kind, _type, _skip) = (kind, null, 0); await LoadQueueAsync(); }

    private async Task PageAsync(int direction) { _skip = Math.Max(0, _skip + direction * 20); await LoadQueueAsync(); }

    private async Task DecideAsync(ReviewItemView item, ReviewDecisionOutcome outcome)
    {
        if (_scope is null || item.TargetKind is not { } kind || item.TargetKey is null) return;
        (_saving, _decisionError) = (true, null);
        string? error;
        try { (_, error) = await Api.DecideAsync(_scope, new(kind, item.TargetKey, outcome, null, _notes.GetValueOrDefault(item.ReviewItemId))); }
        finally { _saving = false; }
        if (error is not null) { _decisionError = error; return; }
        _notes.Remove(item.ReviewItemId);
        _governanceVersion++;
        await Task.WhenAll(LoadQueueAsync(), LoadHistoryAsync());
    }

    /// <summary>Choosing one alternative confirms that relation; the shared registry then closes the whole question for every surface.</summary>
    private Task ChooseAsync(CanonicalRelationView relation) => DecideRelationsAsync([relation], ReviewDecisionOutcome.Confirmed);

    private Task RejectAllAsync(IReadOnlyList<CanonicalRelationView> relations) => DecideRelationsAsync(relations, ReviewDecisionOutcome.Rejected);

    private async Task DecideRelationsAsync(IReadOnlyList<CanonicalRelationView> relations, ReviewDecisionOutcome outcome)
    {
        if (_scope is null) return;
        (_saving, _decisionError) = (true, null);
        foreach (var r in relations)
        {
            var (_, error) = await Api.DecideAsync(_scope, new(ReviewTargetKind.Relation, r.RelationKey, outcome));
            if (error is not null) { _decisionError = error; break; }
        }
        _saving = false;
        _governanceVersion++;
        await Task.WhenAll(LoadQueueAsync(), LoadHistoryAsync());
    }

    private void Explore() => _exploreSearch = string.IsNullOrWhiteSpace(_exploreText) ? "" : _exploreText.Trim();

    private void ExploreKind(CanonicalEntityType type)
    {
        _exploreType = _exploreType == type.ToString() ? "" : type.ToString();
        Explore();
    }

    private async Task CompareAsync()
    {
        if (_scope is null || _snapshots.Count < 2) return;
        _comparison = (await Api.CompareAsync(_scope, _snapshots[1].Id, _snapshots[0].Id)).Comparison;
    }

    public void Dispose() => _interpreting?.Dispose();
}
