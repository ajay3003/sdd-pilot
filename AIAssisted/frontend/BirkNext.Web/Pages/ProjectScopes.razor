@page "/project-scopes"
@inject NavigationManager Nav

@* Project Test Setup was removed (2026-11-19): testers work directly with the selected imported project, its source evidence, requirements,
   scenarios and tests — no test area has to be created or approved first. This route stays so old links and bookmarks keep working: the
   systems and connections views go to Integration Topology, everything else to project selection. Stored test areas and the scope history
   recorded in plans and delivery reports are kept and stay readable; nothing is deleted. *@
<PageTitle>Project Test Setup has moved</PageTitle>

<div class="container py-3" data-testid="pts-retired">
    <p role="status">Project Test Setup is no longer needed: choose a project and start testing. Opening <a href="@_target" data-testid="pts-retired-target">@_label</a>…</p>
</div>

@code {
    [SupplyParameterFromQuery(Name = "view")] public string? ViewQuery { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? TabQuery { get; set; }
    [SupplyParameterFromQuery(Name = "system")] public string? SystemQuery { get; set; }

    private string _target = BirkNext.Web.Services.ProjectTestSetupRetirement.ProjectsRoute;
    private string _label = "project selection";

    protected override void OnInitialized()
    {
        (_target, _label) = BirkNext.Web.Services.ProjectTestSetupRetirement.RedirectFor(ViewQuery, TabQuery, SystemQuery);
        Nav.NavigateTo(_target, replace: true);
    }
}
