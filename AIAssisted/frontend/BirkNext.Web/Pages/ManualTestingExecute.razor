            @if (run.State != ManualRunState.Abandoned)
            {
                <div class="mte-row" data-testid="mte-attach-row">
                    <label class="mte-field"><span>Attach a file</span>
                        <InputFile OnChange="AttachAsync" accept=".png,.jpg,.jpeg,.gif,.webp,.pdf,.txt,.log,.csv,.json,.xml,.har" disabled="@_attaching" data-testid="mte-attach" /></label>
                    <label class="mte-field"><span>Label (optional)</span><input value="@_attLabel" @oninput="e => _attLabel = e.Value?.ToString() ?? string.Empty" maxlength="200" data-testid="mte-attach-label" /></label>
                    <label class="mte-field"><span>Belongs to</span>
                        <select @onchange="e => _attStep = int.TryParse(e.Value?.ToString(), out var v) ? v : null" data-testid="mte-attach-step">
                            <option value="" selected="@(_attStep is null)">Whole run</option>
                            @foreach (var st in run.Steps) { <option value="@st.Number" selected="@(_attStep == st.Number)">Step @st.Number</option> }
                        </select></label>
                </div>
                @if (_attaching) { <p class="mt-muted" role="status" data-testid="mte-attaching">Attaching…</p> }
                @if (_attachError is not null) { <p class="mt-alert" role="alert" data-testid="mte-attach-error">@_attachError</p> }
            }
        </section>
    };

    private RenderFragment Defects(ManualTestRun run, bool editable) => __builder =>
    {
        <section class="mt-card" aria-labelledby="mte-df-title" data-testid="mte-defects">
            <h2 id="mte-df-title" class="mt-h">Defects</h2>
            <p class="mt-muted">Recorded here as local observations. To track a defect in Azure DevOps, register it there and add its number or link as the external reference; BirkNext never creates or changes work items.</p>
            @if (_defects.Count == 0) { <p class="mt-muted" data-testid="mte-defects-none">No defect recorded.</p> }
            <ul class="mte-items">
                @foreach (var d in _defects.ToList())
                {
                    <li data-testid="mte-defect" data-status="@d.Status">
                        <strong>@d.Title</strong>
                        <span class="mt-chip mt-tone-@M.DefectStatusTone(d.Status)" data-testid="mte-defect-status">@M.DefectStatusLabel(d.Status)</span>
                        @if (d.Severity is { } sev) { <span class="mt-chip mt-tone-warn">@sev</span> }
                        <span class="mt-muted">@(d.Step is { } st ? $"step {st}" : "whole run")@(d.ExternalReference is { } ext ? $" · external: {ext}" : " · local observation")@(d.RecordedBy.Length > 0 ? $" · {d.RecordedBy}" : " · not saved yet")</span>
                        @if (d.Actual is { Length: > 0 } a) { <span class="mt-muted">Actual: @a</span> }
                        @if (d.History is { Count: > 0 } history)
                        {
                            <ol class="mte-defect-history" data-testid="mte-defect-history">
                                @foreach (var h in history)
                                {
                                    <li>@h.At.ToLocalTime().ToString("yyyy-MM-dd HH:mm") · @h.By: @M.DefectStatusLabel(h.From) → @M.DefectStatusLabel(h.To)@(h.Note is { Length: > 0 } note ? $" — {note}" : "")@(h.ExternalReference is { } x ? $" · work item {x}" : "")@if (h.RetestRunId is { } rr) { <text> · </text><a href="@($"{M.ExecuteRoute}?run={rr}")">retest run</a> }</li>
                                }
                            </ol>
                        }
                        @if (editable)
                        {
                            <label class="mte-field mte-inline"><span class="visually-hidden">Status of @d.Title</span>
                                <select @onchange="e => SetDefectStatus(d, e.Value?.ToString())" data-testid="mte-defect-status-select">
                                    @foreach (var ds in new[] { ManualDefectStatus.Open, ManualDefectStatus.ReadyForRetest, ManualDefectStatus.Closed })
                                    { <option value="@ds" selected="@(d.Status == ds)">@M.DefectStatusLabel(ds)</option> }
                                </select></label>
                            <button type="button" class="btn btn-secondary btn-sm" aria-label="@($"Remove defect {d.Title}")" @onclick="() => { _defects.Remove(d); _dirty = true; }">Remove</button>
                        }
                        else if (_followUp?.DefectId == d.Id)
                        {
                            @* Follow-up after the run: only the defect changes; the run's results and evidence stay as recorded. *@
                            <div class="mte-row" data-testid="mte-followup">
                                <label class="mte-field"><span>New status</span>
                                    <select @onchange="e => _followUp = _followUp with { Status = Enum.TryParse<ManualDefectStatus>(e.Value?.ToString(), out var v) ? v : _followUp.Status }" data-testid="mte-followup-status">
                                        @foreach (var fs in new[] { ManualDefectStatus.Open, ManualDefectStatus.ReadyForRetest, ManualDefectStatus.Closed })
                                        { <option value="@fs" selected="@(_followUp.Status == fs)">@M.DefectStatusLabel(fs)</option> }
                                    </select></label>
                                <label class="mte-field"><span>Note</span><input value="@_followUp.Note" @oninput="e => _followUp = _followUp with { Note = e.Value?.ToString() }" maxlength="2000" data-testid="mte-followup-note" /></label>
                                <label class="mte-field"><span>Work item (optional)</span><input value="@_followUp.ExternalReference" @oninput="e => _followUp = _followUp with { ExternalReference = e.Value?.ToString() }" placeholder="Number or https link" maxlength="1000" data-testid="mte-followup-external" /></label>
                                <label class="mte-field"><span>Verified by retest run (optional)</span>
                                    <select @onchange="e => _followUp = _followUp with { RetestRunId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null }" data-testid="mte-followup-retest">
                                        <option value="" selected="@(_followUp.RetestRunId is null)">No retest run</option>
                                        @foreach (var r in RetestCandidates(run)) { <option value="@r.Id" selected="@(_followUp.RetestRunId == r.Id)">@M.RunLabel(r.State, r.Outcome) · @r.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") · @r.Tester</option> }
                                    </select></label>
                            </div>
                            <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick="() => SaveFollowUpAsync(run)" data-testid="mte-followup-save">Save follow-up</button>
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _followUp = null" data-testid="mte-followup-cancel">Cancel</button>
                        }
                        else if (run.State != ManualRunState.InProgress)
                        {
                            <button type="button" class="btn btn-secondary btn-sm" data-testid="mte-defect-followup" @onclick="() => _followUp = new FollowUp(d.Id, d.Status, null, d.ExternalReference, null)">Follow up</button>
                        }
                    </li>
                }
            </ul>
            @if (editable)
            {
                <div class="mte-row">
                    <label class="mte-field"><span>Title</span><input value="@_newDefect.Title" @oninput="e => _newDefect = _newDefect with { Title = e.Value?.ToString() ?? string.Empty }" maxlength="300" data-testid="mte-df-title" /></label>
                    <label class="mte-field"><span>Severity</span>
                        <select @onchange="e => _newDefect = _newDefect with { Severity = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString() }" data-testid="mte-df-severity">
                            <option value="" selected="@(_newDefect.Severity is null)">Not assessed</option>
                            @foreach (var s in R.Severities) { <option value="@s" selected="@(_newDefect.Severity == s)">@s</option> }
                        </select></label>
                    <label class="mte-field"><span>Step</span>
                        <select @onchange="e => _newDefect = _newDefect with { Step = int.TryParse(e.Value?.ToString(), out var v) ? v : null }" data-testid="mte-df-step">
                            <option value="" selected="@(_newDefect.Step is null)">Whole run</option>
                            @foreach (var s in run.Steps) { <option value="@s.Number" selected="@(_newDefect.Step == s.Number)">Step @s.Number</option> }
                        </select></label>
                    <label class="mte-field"><span>External reference (optional)</span><input value="@_newDefect.ExternalReference" @oninput="e => _newDefect = _newDefect with { ExternalReference = e.Value?.ToString() }" placeholder="Work item number or https link" maxlength="1000" data-testid="mte-df-external" /></label>
                </div>
                <div class="mte-row">
                    <label class="mte-field"><span>Expected</span><textarea rows="2" @oninput="e => _newDefect = _newDefect with { Expected = e.Value?.ToString() }" data-testid="mte-df-expected">@_newDefect.Expected</textarea></label>
                    <label class="mte-field"><span>Actual</span><textarea rows="2" @oninput="e => _newDefect = _newDefect with { Actual = e.Value?.ToString() }" data-testid="mte-df-actual">@_newDefect.Actual</textarea></label>
                    <label class="mte-field"><span>How to reproduce</span><textarea rows="2" @oninput="e => _newDefect = _newDefect with { Reproduction = e.Value?.ToString() }" data-testid="mte-df-repro">@_newDefect.Reproduction</textarea></label>
                </div>
                <button type="button" class="btn btn-secondary btn-sm" disabled="@string.IsNullOrWhiteSpace(_newDefect.Title)" @onclick="AddDefect" data-testid="mte-df-add">Add defect</button>
            }
        </section>
    };

    private static bool LinkOk(string value) => Uri.TryCreate(value.Trim(), UriKind.Absolute, out var u) && (u.Scheme == "https" || u.Scheme == "http") && u.Host.Length > 0;

    private void SetOutcome(int n, ManualStepOutcome o) { _steps[n] = (o, _steps.GetValueOrDefault(n).Actual); _dirty = true; }
    private void SetActual(int n, string? actual) { _steps[n] = (_steps.GetValueOrDefault(n).Outcome, actual); _dirty = true; }

    private void AddEvidence()
    {
        _evidence.Add(new ManualRunEvidence { Kind = _evKind, Label = _evLabel.Trim(), Reference = _evReference.Trim(), Step = _evStep });
        _evLabel = ""; _evReference = ""; _evStep = null; _dirty = true;
    }

    private void DefectFor(ManualRunStep s)
    {
        _newDefect = new ManualRunDefect { Step = s.Number, Expected = s.Expected, Actual = _steps.GetValueOrDefault(s.Number).Actual, Title = _newDefect.Title };
    }

    private void AddDefect()
    {
        _defects.Add(_newDefect with { Title = _newDefect.Title.Trim(), Status = ManualDefectStatus.Open });
        _newDefect = new(); _dirty = true;
    }

    private void SetDefectStatus(ManualRunDefect d, string? value)
    {
        var i = _defects.IndexOf(d);
        if (i >= 0 && Enum.TryParse<ManualDefectStatus>(value, out var status)) { _defects[i] = d with { Status = status }; _dirty = true; }
    }

    // ── Follow-up after a run (defects) and attachments ─────────────────────────────────────────────────────────────

    private sealed record FollowUp(string DefectId, ManualDefectStatus Status, string? Note, string? ExternalReference, Guid? RetestRunId);
    private FollowUp? _followUp;
    private string _attLabel = "";
    private int? _attStep;
    private bool _attaching;
    private string? _attachError;

    /// <summary>Completed runs of the same case started after this one — the runs that can verify a fix.</summary>
    private IEnumerable<ManualRunSummary> RetestCandidates(ManualTestRun run) =>
        (_ws?.Runs ?? []).Where(r => r.CaseKey == run.CaseKey && r.Id != run.Id && r.State == ManualRunState.Completed && r.StartedAt >= run.StartedAt).OrderByDescending(r => r.StartedAt);

    private async Task SaveFollowUpAsync(ManualTestRun run)
    {
        if (_followUp is not { } f || _runs is null || _ws?.ProjectKey is not { } key) return;
        _busy = true;
        try
        {
            var (updated, error) = await _runs.UpdateDefectAsync(key, run.Id, f.DefectId,
                new UpdateManualDefectRequest(run.Revision, f.Status, f.Note, string.IsNullOrWhiteSpace(f.ExternalReference) ? null : f.ExternalReference.Trim(), f.RetestRunId));
            if (updated is null) { Fail(error ?? "The defect could not be updated."); return; }
            Use(updated); _followUp = null;
            Info("Defect updated. The run's results and evidence are unchanged.");
            await LoadDefectsAsync(key);
        }
        finally { _busy = false; }
    }

    private async Task AttachAsync(InputFileChangeEventArgs args)
    {
        if (_run is not { } run || _runs is null || _ws?.ProjectKey is not { } key) return;
        _attachError = null;
        var file = args.File;
        const long max = 10 * 1024 * 1024;
        if (file.Size > max) { _attachError = $"\"{file.Name}\" is larger than 10 MB and was not attached."; return; }
        _attaching = true;
        try
        {
            byte[] bytes;
            using (var buffer = new MemoryStream())
            {
                await using var stream = file.OpenReadStream(max);
                await stream.CopyToAsync(buffer);
                bytes = buffer.ToArray();
            }
            var (updated, error) = await _runs.AttachAsync(key, run.Id, run.Revision, _attStep, string.IsNullOrWhiteSpace(_attLabel) ? null : _attLabel.Trim(), file.Name, bytes);
            if (updated is null) { _attachError = error ?? "The file could not be attached."; return; }
            if (run.State == ManualRunState.InProgress)
            {
                // Keep this tab's unsaved results: take the new revision and add the stored file to the evidence list being edited.
                var added = updated.Evidence.Where(e => _evidence.All(x => x.Id != e.Id) && run.Evidence.All(x => x.Id != e.Id)).ToList();
                _run = updated with { Steps = run.Steps };
                _evidence.AddRange(added);
            }
            else Use(updated);
            _attLabel = ""; _attStep = null;
            Info($"\"{file.Name}\" attached.");
        }
        catch (IOException) { _attachError = $"\"{file.Name}\" could not be read."; }
        finally { _attaching = false; }
    }

    private async Task DownloadAttachmentAsync(ManualRunEvidence e)
    {
        if (_run is not { } run || _runs is null || _ws?.ProjectKey is not { } key) return;
        var (bytes, error) = await _runs.AttachmentAsync(key, run.Id, e.Reference);
        if (bytes is null) { Fail(error ?? "The attachment could not be downloaded."); return; }
        await JS.InvokeVoidAsync("downloadBase64File", e.FileName ?? "attachment", Convert.ToBase64String(bytes), e.ContentType ?? "application/octet-stream");
    }

    // ── Project defect list ─────────────────────────────────────────────────────────────────────────────────────────

    private List<ManualDefectListItem>? _defectList;
    private string? _defectListError;
    private bool _defectsAll;

    private async Task LoadDefectsAsync(string key)
    {
        if (_runs is null) return;
        var (list, error) = await _runs.DefectsAsync(key);
        (_defectList, _defectListError) = (list, list is null ? error : null);
    }

    private async Task DownloadDefectsAsync()
    {
        if (_defectList is not { Count: > 0 } list) return;
        await JS.InvokeVoidAsync("downloadTextFile", $"manual-test-defects-{DateTime.Now:yyyy-MM-dd}.csv", M.DefectsCsv(list), "text/csv;charset=utf-8");
    }

    private RenderFragment DefectList() => __builder =>
    {
        if (_defectList is null && _defectListError is null) return;
        var shown = (_defectList ?? []).Where(i => _defectsAll || i.Defect.Status != ManualDefectStatus.Closed).ToList();
        <section class="mt-card" aria-labelledby="mte-dl-title" data-testid="mte-defect-list">
            <h2 id="mte-dl-title" class="mt-h">Defects</h2>
            @if (_defectListError is not null) { <p class="mt-alert" role="alert">@_defectListError</p> }
            else
            {
                <p class="mt-muted" data-testid="mte-defect-list-count">@((_defectList ?? []).Count(i => i.Defect.Status != ManualDefectStatus.Closed)) not closed · @((_defectList ?? []).Count) in all runs of this project.
                    <label class="mte-inline"><input type="checkbox" checked="@_defectsAll" @onchange="e => _defectsAll = e.Value is true" data-testid="mte-defect-list-all" /> Show closed defects too</label>
                    @if ((_defectList ?? []).Count > 0) { <button type="button" class="btn btn-secondary btn-sm" @onclick="DownloadDefectsAsync" data-testid="mte-defect-list-download">Download defects (CSV)</button> }</p>
                @if (shown.Count == 0) { <p class="mt-muted" data-testid="mte-defect-list-none">@(_defectsAll ? "No defect has been recorded." : "No open defect.")</p> }
                <ul class="mte-items">
                    @foreach (var i in shown)
                    {
                        <li data-testid="mte-defect-list-item" data-status="@i.Defect.Status">
                            <strong>@i.Defect.Title</strong>
                            <span class="mt-chip mt-tone-@M.DefectStatusTone(i.Defect.Status)">@M.DefectStatusLabel(i.Defect.Status)</span>
                            @if (i.Defect.Severity is { } sev) { <span class="mt-chip mt-tone-warn">@sev</span> }
                            <span class="mt-muted">@i.RunTitle · @M.RunLabel(i.RunState, i.RunOutcome) · @i.RunStartedAt.ToLocalTime().ToString("yyyy-MM-dd") · @i.Tester@(i.Defect.ExternalReference is { } x ? $" · work item {x}" : "")</span>
                            <a href="@($"{M.ExecuteRoute}?run={i.RunId}")" data-testid="mte-defect-list-open">Open run</a>
                        </li>
                    }
                </ul>
            }
        </section>
    };

    private SaveManualRunRequest Request() => new()
    {
        BaseRevision = _run!.Revision, Notes = _notes, Environment = _runEnvironment,
        Steps = [.. _run.Steps.Select(s => new ManualStepInput(s.Number, _steps.GetValueOrDefault(s.Number).Outcome, _steps.GetValueOrDefault(s.Number).Actual))],
        Evidence = [.. _evidence], Defects = [.. _defects],
    };

    private async Task<bool> SaveAsync()
    {
        if (_run is null) return false;
        _busy = true;
        var (run, error) = await _runs!.SaveAsync(_ws!.ProjectKey!, _run.Id, Request());
        _busy = false;
        if (run is null) { Fail(error ?? "Your results could not be saved. They are still on this page; try again."); return false; }
        Use(run);
        Info($"Progress saved ({DateTime.Now:HH:mm}). You can leave and resume this run later.");
        return true;
    }

    private async Task CompleteAsync()
    {
        if (_run is null) return;
        if (_dirty && !await SaveAsync()) return;
        _busy = true;
        var (run, error) = await _runs!.CompleteAsync(_ws!.ProjectKey!, _run.Id, _run.Revision);
        _busy = false;
        if (run is null) { Fail(error ?? "The run could not be completed."); return; }
        Use(run);
        Info($"Run completed: {R.OutcomeLabel(run.Outcome)}. It is kept in the run history and cannot be changed.");
        _ws = await new ManualTestingWorkspace(ServiceProvider).LoadAsync(discovery: false, requirements: false);
    }

    private async Task AbandonAsync()
    {
        if (_run is null) return;
        if (_dirty && !await SaveAsync()) return;
        _busy = true;
        var (run, error) = await _runs!.AbandonAsync(_ws!.ProjectKey!, _run.Id, _run.Revision, _abandonReason.Trim());
        _busy = false;
        if (run is null) { Fail(error ?? "The run could not be stopped."); return; }
        Use(run);
        Info("Run stopped. It stays in the history and never counts as an execution.");
    }
}
