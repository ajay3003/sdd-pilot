@page "/wasm-performance-review"
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@inject IBlazorWasmPerformanceReviewService ReviewService
@inject IFrontendAnalysisContextFactory ContextFactory
@inject RuntimeReviewSessionService RuntimeReviews
@inject IWorkspaceSessionService Workspace
@inject IReportExportService ExportService
@inject IJSRuntime JS

<PageTitle>Blazor WASM Performance Review</PageTitle>

<div class="wpr-page">

    <PageHeader Title="Blazor WASM Performance Review"
                Description="Analyse a deployed Blazor WebAssembly application for client-side and architecture-specific performance issues: bundle size, compression, caching, startup waterfall, and Blazor runtime patterns." />

    @* ── Review Target Card ───────────────────────────────────────────────── *@
    <div class="wpr-target-card">
        <div class="wpr-target-header">
            <h2 class="wpr-target-title">Review Target</h2>
            <div class="wpr-target-actions">
                <a href="/admin/system-settings" class="btn-secondary wpr-settings-btn">
                    Open Frontend Analysis Settings
                </a>
                @if (_report is not null)
                {
                    <SecondaryButton OnClick="RefreshContext">Refresh</SecondaryButton>
                }
                <PrimaryButton OnClick="RunReview"
                               Disabled="@(_running || _context is null || !_context.HasTargetUrl)"
                               aria-label="Run Blazor WASM Performance Review">
                    @if (_running) { <span class="wpr-spinner" aria-hidden="true">⟳</span> }
                    @(_running ? "Analysing…" : "Run Performance Review")
                </PrimaryButton>
            </div>
        </div>

        @if (_context is not null)
        {
            <div class="wpr-target-grid">
                <div class="wpr-target-item">
                    <span class="wpr-target-label">Profile</span>
                    <div class="wpr-target-value">
                        <span class="wpr-env-badge wpr-env-@(_context.ActiveProfile.EnvironmentType.ToString().ToLower())">
                            @_context.ActiveProfile.EnvironmentType
                        </span>
                        <span class="wpr-target-profile-name">@_context.ActiveProfile.Name</span>
                    </div>
                </div>
                <div class="wpr-target-item">
                    <span class="wpr-target-label">Target URL</span>
                    <div class="wpr-target-value">
                        @if (_context.HasTargetUrl)
                        {
                            <code class="wpr-target-url">@_context.TargetUrl</code>
                        }
                        else
                        {
                            <span class="wpr-target-missing">Not configured — <a href="/admin/system-settings">open settings</a></span>
                        }
                    </div>
                </div>
                <div class="wpr-target-item">
                    <span class="wpr-target-label">Thresholds</span>
                    <div class="wpr-target-value">
                        <span class="wpr-threshold-badge">@_context.PerformanceThresholds.Mode</span>
                    </div>
                </div>
                <div class="wpr-target-item">
                    <span class="wpr-target-label">Authentication</span>
                    <div class="wpr-target-value">
                        <span>@_context.AuthenticationType</span>
                        @if (_context.RequiresAuthentication)
                        { <span class="wpr-auth-tag">Required</span> }
                    </div>
                </div>
                @if (_report is not null)
                {
                    <div class="wpr-target-item">
                        <span class="wpr-target-label">Auth Status</span>
                        <div class="wpr-target-value">
                            <StatusChip Status="@(_context.IsAuthenticatedSessionAvailable ? "healthy" : "neutral")"
                                        Label="@(_context.IsAuthenticatedSessionAvailable ? "Authenticated" : "Anonymous")" />
                        </div>
                    </div>
                    @if (_report.ApiAnalysis is not null)
                    {
                        <div class="wpr-target-item">
                            <span class="wpr-target-label">Detected</span>
                            <div class="wpr-target-value">
                                @if (_report.ApiAnalysis.HasGraphQL)
                                { <span class="wpr-detect-badge wpr-detect-gql">GraphQL</span> }
                                @if (_report.ApiAnalysis.HasOpenApi)
                                { <span class="wpr-detect-badge wpr-detect-rest">REST</span> }
                                @if (!_report.ApiAnalysis.HasGraphQL && !_report.ApiAnalysis.HasOpenApi)
                                { <span class="wpr-detect-none">None detected</span> }
                            </div>
                        </div>
                    }
                    <div class="wpr-target-item">
                        <span class="wpr-target-label">Last Scan</span>
                        <div class="wpr-target-value">
                            <span class="wpr-scan-time">@_report.ReviewedAt.ToString("yyyy-MM-dd HH:mm") UTC</span>
                        </div>
                    </div>
                }
            </div>

            @if (_running)
            {
                <p class="wpr-scan-progress" aria-live="polite">
                    Discovering assets — this may take a moment for large applications…
                </p>
            }
            @if (_context.HasValidationErrors)
            {
                <div class="wpr-banner wpr-banner-error" role="alert">
                    <span aria-hidden="true">✗</span>
                    Profile has configuration errors: @string.Join(" | ", _context.ValidationErrors)
                </div>
            }
            @if (_context.HasValidationWarnings)
            {
                <div class="wpr-banner wpr-banner-warn" role="status">
                    <span aria-hidden="true">⚠</span>
                    @string.Join(" | ", _context.ValidationWarnings)
                </div>
            }
            @if (_context.AuthRequiredButUnavailable)
            {
                <div class="wpr-banner wpr-banner-info" role="status">
                    <span aria-hidden="true">ℹ</span>
                    This application requires authentication. Only anonymous startup and public asset performance can be analysed.
                    Authenticated API, GraphQL, and page-load performance require authenticated browser session support.
                </div>
            }
        }
        else
        {
            <div class="wpr-banner wpr-banner-warn" role="status">
                <span aria-hidden="true">⚠</span>
                Loading frontend analysis profile…
            </div>
        }
    </div>

    @* ── Error banner ─────────────────────────────────────────────────────── *@
    @if (_error is not null)
    {
        <div class="wpr-banner wpr-banner-error wpr-banner-standalone" role="alert">
            <span aria-hidden="true">✗</span> @_error
        </div>
    }

    @* ── Results ─────────────────────────────────────────────────────────── *@
    @if (_report is not null)
    {
        var h   = _report.Health;
        var rdy = _report.ReadinessReport;

        <div style="display:flex;justify-content:flex-end;margin-bottom:.5rem">
            <button style="background:#1d4ed8;color:#fff;border:none;padding:.35rem .85rem;border-radius:5px;cursor:pointer;font-size:.78rem" @onclick="ExportHtml">Export HTML</button>
        </div>

        @* ── Scan Summary Strip ───────────────────────────────────────────── *@
        <div class="wpr-summary-strip" aria-label="Scan summary">
            <MetricCard Value="@h.AssetsDiscovered.ToString()" Label="Assets" />
            @if (_report.StartupMetrics is not null)
            {
                <MetricCard Value="@_report.StartupMetrics.StartupRequestCount.ToString()" Label="Startup Requests" />
            }
            @if (_report.ApiAnalysis?.HasOpenApi == true)
            {
                <MetricCard Value="@_report.ApiAnalysis.RestEndpointCount.ToString()" Label="REST Endpoints" />
            }
            @if (_report.ApiAnalysis?.HasGraphQL == true)
            {
                <MetricCard Value="@_report.ApiAnalysis.GraphQLOperations.Count.ToString()" Label="GraphQL Ops" />
            }
            @if (_report.StartupMetrics is not null)
            {
                <MetricCard Value="@FormatBytes(_report.StartupMetrics.FrameworkDownloadBytes)" Label="Framework Size" />
                <MetricCard Value="@FormatBytes(_report.StartupMetrics.ApplicationDownloadBytes)" Label="App Size" />
            }
            <MetricCard Value="@FormatBytes(h.TotalTransferBytes)" Label="Total Transfer" />
            @if (_report.IsBlazorWasm)
            {
                <MetricCard Value="✓" Label="Blazor WASM" Variant="success" />
            }
        </div>

        @* ── Performance Readiness Dashboard ─────────────────────────────── *@
        @if (rdy is not null && rdy.HasData)
        {
            <div class="wpr-readiness-dashboard">
                <div class="wpr-readiness-card @ReadinessStateClass(rdy.OverallState)"
                     aria-label="Overall performance readiness: @ReadinessStateLabel(rdy.OverallState), score @rdy.OverallScore">
                    <div class="wpr-readiness-left">
                        <div class="wpr-readiness-score">@rdy.OverallScore</div>
                        <div class="wpr-readiness-label">@ReadinessStateLabel(rdy.OverallState)</div>
                        <div class="wpr-readiness-sub">out of 100</div>
                    </div>
                    <div class="wpr-readiness-counts" aria-label="Finding counts by severity">
                        @if (rdy.Health.CriticalFindings > 0)
                        {
                            <div class="wpr-count-pill wpr-count-critical">
                                <span class="wpr-count-value">@rdy.Health.CriticalFindings</span>
                                <span class="wpr-count-label">Critical</span>
                            </div>
                        }
                        @if (rdy.Health.HighFindings > 0)
                        {
                            <div class="wpr-count-pill wpr-count-high">
                                <span class="wpr-count-value">@rdy.Health.HighFindings</span>
                                <span class="wpr-count-label">High</span>
                            </div>
                        }
                        @if (rdy.Health.MediumFindings > 0)
                        {
                            <div class="wpr-count-pill wpr-count-medium">
                                <span class="wpr-count-value">@rdy.Health.MediumFindings</span>
                                <span class="wpr-count-label">Medium</span>
                            </div>
                        }
                        @if (rdy.Health.LowFindings > 0)
                        {
                            <div class="wpr-count-pill wpr-count-low">
                                <span class="wpr-count-value">@rdy.Health.LowFindings</span>
                                <span class="wpr-count-label">Low</span>
                            </div>
                        }
                        @if (rdy.Health.CriticalFindings == 0 && rdy.Health.HighFindings == 0 &&
                             rdy.Health.MediumFindings == 0 && rdy.Health.LowFindings == 0)
                        {
                            <span class="wpr-all-clear">No actionable findings</span>
                        }
                    </div>
                </div>
            </div>

            @* ── Category Scores ──────────────────────────────────────────── *@
            <SectionHeader Title="Category Scores" />
            <div class="wpr-category-grid" role="list" aria-label="Performance category scores">
                @foreach (var cat in rdy.Categories)
                {
                    <button class="wpr-cat-card @ReadinessStateClass(cat.State)"
                            role="listitem"
                            @onclick="() => SetTab(DrilldownTab(cat.CategoryName))"
                            title="Explore @cat.CategoryName details"
                            aria-label="@cat.CategoryName: @(cat.WasAssessed ? cat.Score.ToString() : "not assessed"), @ReadinessStateLabel(cat.State)">
                        <div class="wpr-cat-name">@cat.CategoryName</div>
                        <div class="wpr-cat-score @(cat.WasAssessed ? "" : "wpr-cat-score-na")">
                            @(cat.WasAssessed ? cat.Score.ToString() : "—")
                        </div>
                        <div class="wpr-cat-status">@ReadinessStateLabel(cat.State)</div>
                        <div class="wpr-cat-findings">
                            @if (!cat.WasAssessed)          { <span>Not assessed</span> }
                            else if (cat.FindingsCount == 0) { <span>No issues</span> }
                            else                             { <span>@cat.FindingsCount finding@(cat.FindingsCount != 1 ? "s" : "")</span> }
                        </div>
                    </button>
                }
            </div>

            @* ── Top Risks ────────────────────────────────────────────────── *@
            @if (rdy.TopRisks.Count > 0)
            {
                <SectionHeader Title="Top Risks" />
                <div class="issue-cards">
                    @foreach (var risk in rdy.TopRisks)
                    {
                        <IssueCard Severity="@risk.Severity.ToString()"
                                   Component="@CategoryLabel(risk.Category)"
                                   Description="@(string.IsNullOrEmpty(risk.Description) ? risk.Title : $"{risk.Title} — {risk.Description}")"
                                   SuggestedFix="@risk.Recommendation" />
                    }
                </div>
            }

            @* ── Top Recommendations ──────────────────────────────────────── *@
            @if (rdy.TopRecommendations.Count > 0)
            {
                <SectionHeader Title="Top Recommendations" />
                <div class="rec-cards">
                    @foreach (var rec in rdy.TopRecommendations)
                    {
                        <RecommendationCard Title="@rec.Title"
                                            Description="@(string.IsNullOrEmpty(rec.Description) ? CategoryLabel(rec.Category) : $"{CategoryLabel(rec.Category)} — {rec.Description}")" />
                    }
                </div>
            }
        }
        else
        {
            @* Asset type breakdown when full readiness is unavailable *@
            @if (_report.Assets.Count > 0)
            {
                <p class="wpr-partial-note">
                    Asset discovery completed. Full performance analysis not available for this review.
                </p>
                <div class="wpr-asset-type-summary">
                    @foreach (var grp in _report.Assets.GroupBy(a => a.Type).OrderBy(g => g.Key))
                    {
                        var grpBytes = grp.Where(a => a.StatusCode is >= 200 and < 300)
                                          .Sum(a => a.ContentLength ?? a.DownloadedBytes);
                        <div class="wpr-type-row">
                            <span class="wpr-type-name">@AssetTypeLabel(grp.Key)</span>
                            <span class="wpr-type-count">@grp.Count() asset@(grp.Count() != 1 ? "s" : "")</span>
                            <span class="wpr-type-size">@FormatBytes(grpBytes)</span>
                        </div>
                    }
                </div>
            }
        }

        @* ── Detailed Tabs ────────────────────────────────────────────────── *@
        <div class="wpr-tab-bar" role="tablist" aria-label="Performance analysis details">
            <button class="wpr-tab @(_tab == "overview" ? "is-active" : "")" @onclick='() => SetTab("overview")' role="tab" aria-selected="@(_tab == "overview")">Performance Readiness</button>
            <button class="wpr-tab @(_tab == "startup"  ? "is-active" : "")" @onclick='() => SetTab("startup")'  role="tab" aria-selected="@(_tab == "startup")">Startup</button>
            <button class="wpr-tab @(_tab == "assets"   ? "is-active" : "")" @onclick='() => SetTab("assets")'   role="tab" aria-selected="@(_tab == "assets")">
                Assets @if (_report.Assets.Count > 0) { <span class="wpr-tab-count">@_report.Assets.Count</span> }
            </button>
            <button class="wpr-tab @(_tab == "api"     ? "is-active" : "")" @onclick='() => SetTab("api")'     role="tab" aria-selected="@(_tab == "api")">API Analysis</button>
            <button class="wpr-tab @(_tab == "caching" ? "is-active" : "")" @onclick='() => SetTab("caching")' role="tab" aria-selected="@(_tab == "caching")">Caching &amp; Compression</button>
            <button class="wpr-tab @(_tab == "blazor"  ? "is-active" : "")" @onclick='() => SetTab("blazor")'  role="tab" aria-selected="@(_tab == "blazor")">Blazor Review</button>
            <button class="wpr-tab @(_tab == "recs"    ? "is-active" : "")" @onclick='() => SetTab("recs")'    role="tab" aria-selected="@(_tab == "recs")">Recommendations</button>
        </div>

        <div class="wpr-tab-body" role="tabpanel">

            @* ── Performance Readiness (renamed from Overview) ────────────── *@
            @if (_tab == "overview")
            {
                <p class="wpr-tab-intro">
                    Contextual information about this performance review scan.
                    The readiness score, category breakdown, risks, and recommendations are shown above.
                </p>

                <SectionHeader Title="Scan Context" />
                <KeyValueList>
                    <InfoRow Label="Scan Type">
                        <StatusChip Status="@(_context?.IsAuthenticatedSessionAvailable == true ? "healthy" : "neutral")"
                                    Label="@(_context?.IsAuthenticatedSessionAvailable == true ? "Authenticated" : "Anonymous Only")" />
                    </InfoRow>
                    <InfoRow Label="Auth Required" Value="@(_context?.RequiresAuthentication == true ? "Yes" : "No")" />
                    <InfoRow Label="GraphQL Analysis" Value="@(_report.ApiAnalysis?.HasGraphQL == true ? $"Detected — {_report.ApiAnalysis.GraphQLOperations.Count} operation(s)" : "Not detected")" />
                    <InfoRow Label="REST Analysis" Value="@(_report.ApiAnalysis?.HasOpenApi == true ? $"Detected — {_report.ApiAnalysis.RestEndpointCount} endpoint(s)" : "Not detected")" />
                    <InfoRow Label="Configuration Source" Value="@($"Frontend Analysis Settings — {_context?.ActiveProfile.Name ?? "Unknown"}")" />
                    <InfoRow Label="Threshold Mode" Value="@(_context?.PerformanceThresholds.Mode.ToString() ?? "Default")" />
                    <InfoRow Label="Target" Value="@_report.TargetUrl" />
                    <InfoRow Label="Scan Completed" Value="@(_report.ReviewedAt.ToString("yyyy-MM-dd HH:mm:ss") + " UTC")" />
                </KeyValueList>

                @if (_report.Limitations.Count > 0)
                {
                    <SectionHeader Title="Analysis Limitations" />
                    <ul class="wpr-limitations-list">
                        @foreach (var lim in _report.Limitations) { <li>@lim</li> }
                    </ul>
                }

                <div class="wpr-drill-links">
                    <span class="wpr-drill-label">Explore details:</span>
                    <button class="wpr-link-btn" @onclick='() => SetTab("startup")'>Startup Analysis →</button>
                    <button class="wpr-link-btn" @onclick='() => SetTab("api")'>API Analysis →</button>
                    <button class="wpr-link-btn" @onclick='() => SetTab("caching")'>Caching &amp; Compression →</button>
                    <button class="wpr-link-btn" @onclick='() => SetTab("recs")'>All Recommendations →</button>
                </div>
            }

            @* ── Startup ─────────────────────────────────────────────────── *@
            @if (_tab == "startup")
            {
                <p class="wpr-tab-intro">
                    Startup analysis evaluates the asset composition that determines initial load time:
                    total download size, framework footprint, request count, and per-asset size.
                </p>

                @if (_report.StartupMetrics is not null)
                {
                    <SectionHeader Title="Startup Metrics" />
                    <div class="wpr-metric-grid">
                        @foreach (var m in _report.Metrics)
                        {
                            <div class="wpr-metric-card wpr-metric-@m.Status">
                                <span class="wpr-metric-value">@m.Value</span>
                                <span class="wpr-metric-label">@m.Name</span>
                                @if (m.Threshold is not null)
                                { <span class="wpr-metric-threshold">Threshold: @m.Threshold</span> }
                            </div>
                        }
                    </div>

                    @if (_report.Findings.Any(f => f.Category == PerformanceCategory.Startup))
                    {
                        <SectionHeader Title="@("Startup Findings (" + StartupFindingCount() + ")")" />
                        <div class="wpr-findings-list">
                            @foreach (var f in StartupFindings())
                            { @FindingCard(f) }
                        </div>

                        @if (_report.Recommendations.Count > 0)
                        {
                            <p class="wpr-rec-note">
                                @_report.Recommendations.Count recommendation@(_report.Recommendations.Count != 1 ? "s" : "") generated —
                                <button class="wpr-link-btn" @onclick='() => SetTab("recs")'>view all →</button>
                            </p>
                        }
                    }
                    else
                    {
                        <p class="wpr-empty-findings">No startup performance issues detected. The asset composition looks healthy.</p>
                    }
                }
                else
                {
                    <p class="wpr-empty-tab">Run a review to see startup analysis.</p>
                }
            }

            @* ── Assets ──────────────────────────────────────────────────── *@
            @if (_tab == "assets")
            {
                @if (_report.Assets.Count == 0)
                {
                    <p class="wpr-empty-tab">No assets discovered.</p>
                }
                else
                {
                    <div class="wpr-asset-controls">
                        <input type="search"
                               class="form-control wpr-asset-search"
                               placeholder="Search by URL or type…"
                               aria-label="Search assets"
                               value="@_assetSearch"
                               @oninput="e => _assetSearch = e.Value?.ToString() ?? string.Empty" />

                        <div class="wpr-filter-chips" role="group" aria-label="Filter by asset type">
                            <button class="wpr-filter-chip @(_assetTypeFilter == null ? "is-active" : "")"
                                    @onclick="() => _assetTypeFilter = null">All</button>
                            @foreach (var t in Enum.GetValues<AssetType>())
                            {
                                var cnt = _report.Assets.Count(a => a.Type == t);
                                @if (cnt > 0)
                                {
                                    <button class="wpr-filter-chip @(_assetTypeFilter == t ? "is-active" : "")"
                                            @onclick="() => _assetTypeFilter = t">
                                        @AssetTypeLabel(t) <span class="wpr-chip-count">@cnt</span>
                                    </button>
                                }
                            }
                        </div>
                    </div>

                    <p class="wpr-asset-count-line">
                        Showing @FilteredSortedAssets(_report.Assets).Count() of @_report.Assets.Count assets
                        @if (FilteredSortedAssets(_report.Assets).Count() < _report.Assets.Count)
                        {
                            <button class="wpr-clear-filters" @onclick="ClearAssetFilters">Clear filters</button>
                        }
                    </p>

                    <div class="wpr-table-wrap">
                        <table class="wpr-table">
                            <thead>
                                <tr>
                                    <th class="wpr-th-sortable @SortClass("url")"    @onclick='() => SortBy("url")'>Asset @SortIcon("url")</th>
                                    <th class="wpr-th-sortable @SortClass("type")"   @onclick='() => SortBy("type")'>Type @SortIcon("type")</th>
                                    <th class="wpr-th-sortable @SortClass("size")"   @onclick='() => SortBy("size")'>Size @SortIcon("size")</th>
                                    <th class="wpr-th-sortable @SortClass("enc")"    @onclick='() => SortBy("enc")'>Encoding @SortIcon("enc")</th>
                                    <th class="wpr-th-sortable @SortClass("cache")"  @onclick='() => SortBy("cache")'>Cache-Control @SortIcon("cache")</th>
                                    <th class="wpr-th-sortable @SortClass("time")"   @onclick='() => SortBy("time")'>Time @SortIcon("time")</th>
                                    <th class="wpr-th-sortable @SortClass("status")" @onclick='() => SortBy("status")'>Status @SortIcon("status")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in FilteredSortedAssets(_report.Assets))
                                {
                                    var rowClass = a.StatusCode is >= 400 or 0 ? "wpr-row-error" : "";
                                    var sizeVal  = a.ContentLength ?? (a.DownloadedBytes > 0 ? a.DownloadedBytes : (long?)null);
                                    <tr class="@rowClass">
                                        <td class="wpr-asset-url" title="@a.Url">
                                            @TrimUrl(a.Url)
                                            @if (a.Error is not null)
                                            { <span class="wpr-asset-error" title="@a.Error"> ⚠</span> }
                                        </td>
                                        <td><span class="wpr-type-chip">@AssetTypeLabel(a.Type)</span></td>
                                        <td class="wpr-num">@(sizeVal.HasValue ? FormatBytes(sizeVal.Value) : "—")</td>
                                        <td>@(a.ContentEncoding ?? "—")</td>
                                        <td class="wpr-cache-cell" title="@(a.CacheControl ?? "")">@TruncateCache(a.CacheControl)</td>
                                        <td class="wpr-num">@(a.DownloadTimeMs > 0 ? $"{a.DownloadTimeMs:F0} ms" : "—")</td>
                                        <td>@StatusBadge(a.StatusCode)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

            @* ── API Analysis ────────────────────────────────────────────── *@
            @if (_tab == "api")
            {
                <p class="wpr-tab-intro">
                    API operations detected during the automated scan. GraphQL endpoints are probed
                    with a minimal detection query; REST endpoints are discovered via OpenAPI documentation.
                    Runtime request analysis requires browser instrumentation.
                </p>

                @if (_report.ApiAnalysis is null)
                {
                    <p class="wpr-empty-tab">Run a review to see API analysis.</p>
                }
                else
                {
                    var api = _report.ApiAnalysis;

                    @if (api.HasGraphQL)
                    {
                        <SectionHeader Title="GraphQL Operations" />

                        <div class="wpr-api-endpoint-info">
                            <span class="wpr-api-badge wpr-api-graphql">GraphQL</span>
                            <span class="wpr-api-endpoint-url" title="@api.GraphQLEndpoint">@api.GraphQLEndpoint</span>
                            @if (api.GraphQLIntrospectionEnabled)
                            { <span class="wpr-api-badge wpr-api-warn" title="Introspection is enabled in production">Introspection ON</span> }
                            else
                            { <span class="wpr-api-badge wpr-api-ok">Introspection OFF</span> }
                            @if (api.GraphQLResponseCompressed)
                            { <span class="wpr-api-badge wpr-api-ok">Compressed</span> }
                            else
                            { <span class="wpr-api-badge wpr-api-warn">Not compressed</span> }
                        </div>

                        <div class="wpr-table-wrap">
                            <table class="wpr-table">
                                <thead>
                                    <tr>
                                        <th>Operation</th>
                                        <th>Type</th>
                                        <th>Calls</th>
                                        <th>Avg Latency</th>
                                        <th>Largest Response</th>
                                        <th>Req Payload</th>
                                        <th>Errors</th>
                                        <th>Recommendation</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var op in api.GraphQLOperations)
                                    {
                                        <tr>
                                            <td class="wpr-gql-op-name">@op.OperationName</td>
                                            <td><span class="wpr-gql-type-badge wpr-gql-@op.Type.ToString().ToLower()">@op.Type</span></td>
                                            <td class="wpr-num">@op.Calls</td>
                                            <td class="wpr-num">@(op.AverageLatencyMs > 0 ? $"{op.AverageLatencyMs:F0} ms" : "—")</td>
                                            <td class="wpr-num">@(op.LargestResponseBytes > 0 ? FormatBytes(op.LargestResponseBytes) : "—")</td>
                                            <td class="wpr-num">@(op.RequestPayloadBytes > 0 ? FormatBytes(op.RequestPayloadBytes) : "—")</td>
                                            <td class="wpr-num @(op.ErrorCount > 0 ? "wpr-status-warn" : "")">@op.ErrorCount</td>
                                            <td class="wpr-gql-rec">@(op.Recommendation ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <p class="wpr-api-scan-note">
                            Operations shown are those observed during the automated scan. Runtime analysis of
                            application queries requires browser instrumentation.
                        </p>
                    }
                    else
                    {
                        <div class="wpr-api-not-detected">
                            <span class="wpr-api-nd-label">GraphQL not detected</span>
                            <span class="wpr-api-nd-detail">Probed: /graphql, /api/graphql, /v1/graphql, /_graphql, /graph</span>
                        </div>
                    }

                    <SectionHeader Title="REST Endpoints" />

                    @if (api.HasOpenApi)
                    {
                        <div class="wpr-api-endpoint-info">
                            <span class="wpr-api-badge wpr-api-rest">OpenAPI</span>
                            <a class="wpr-api-endpoint-url" href="@api.OpenApiUrl" target="_blank" rel="noopener noreferrer">@api.OpenApiUrl</a>
                            <span class="wpr-api-nd-detail">@api.RestEndpointCount endpoint@(api.RestEndpointCount != 1 ? "s" : "") discovered</span>
                        </div>

                        <div class="wpr-table-wrap">
                            <table class="wpr-table">
                                <thead>
                                    <tr>
                                        <th>Method</th>
                                        <th>Path</th>
                                        <th>Summary</th>
                                        <th>Auth</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ep in api.RestEndpoints.Take(50))
                                    {
                                        <tr>
                                            <td><span class="wpr-method-badge wpr-method-@ep.Method.ToLower()">@ep.Method</span></td>
                                            <td class="wpr-rest-path" title="@ep.Path">@ep.Path</td>
                                            <td class="wpr-rest-summary">@(ep.Summary ?? "—")</td>
                                            <td>@(ep.HasAuthRequirement ? "Required" : "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (api.RestEndpoints.Count > 50)
                        { <p class="wpr-api-scan-note">Showing 50 of @api.RestEndpoints.Count endpoints.</p> }
                    }
                    else
                    {
                        <div class="wpr-api-not-detected">
                            <span class="wpr-api-nd-label">No OpenAPI documentation found</span>
                            <span class="wpr-api-nd-detail">Probed: /swagger/v1/swagger.json, /swagger.json, /openapi.json, /openapi/v3/swagger.json</span>
                        </div>
                    }

                    @if (api.Findings.Count > 0)
                    {
                        <SectionHeader Title="@("API Findings (" + api.Findings.Count + ")")" />
                        <div class="wpr-findings-list">
                            @foreach (var f in api.Findings.OrderBy(f => f.Severity))
                            { @FindingCard(f) }
                        </div>
                    }
                }
            }

            @* ── Caching & Compression ───────────────────────────────────── *@
            @if (_tab == "caching")
            {
                <p class="wpr-tab-intro">
                    HTTP caching and compression analysis for Blazor framework assets and static files.
                    Checks Cache-Control, ETag, and Content-Encoding headers against recommended practices.
                </p>

                @if (_report.CachingAnalysis is null)
                {
                    <p class="wpr-empty-tab">Run a review to see caching &amp; compression analysis.</p>
                }
                else
                {
                    var cch = _report.CachingAnalysis;
                    var m   = cch.Metrics;

                    <SectionHeader Title="Compression &amp; Cache Summary" />
                    <div class="wpr-metric-grid">
                        <div class="wpr-metric-card @(m.CompressedAssets == m.TotalAssets && m.TotalAssets > 0 ? "wpr-metric-good" : m.CompressedAssets > 0 ? "wpr-metric-warning" : "wpr-metric-poor")">
                            <span class="wpr-metric-value">@m.CompressedAssets / @m.TotalAssets</span>
                            <span class="wpr-metric-label">Compressed assets</span>
                        </div>
                        <div class="wpr-metric-card @(m.BrotliAssets > 0 ? "wpr-metric-good" : "wpr-metric-poor")">
                            <span class="wpr-metric-value">@m.BrotliAssets</span>
                            <span class="wpr-metric-label">Brotli</span>
                            @if (m.GzipAssets > 0) { <span class="wpr-metric-threshold">GZip: @m.GzipAssets</span> }
                        </div>
                        <div class="wpr-metric-card @(m.CacheOptimizedAssets == m.TotalAssets && m.TotalAssets > 0 ? "wpr-metric-good" : m.CacheOptimizedAssets > 0 ? "wpr-metric-warning" : "wpr-metric-poor")">
                            <span class="wpr-metric-value">@m.CacheOptimizedAssets</span>
                            <span class="wpr-metric-label">Cache optimised</span>
                        </div>
                        <div class="wpr-metric-card @(m.AssetsWithoutCacheHeaders == 0 ? "wpr-metric-good" : "wpr-metric-poor")">
                            <span class="wpr-metric-value">@m.AssetsWithoutCacheHeaders</span>
                            <span class="wpr-metric-label">Missing cache headers</span>
                        </div>
                        <div class="wpr-metric-card @(m.UncompressedLargeAssets == 0 ? "wpr-metric-good" : "wpr-metric-poor")">
                            <span class="wpr-metric-value">@m.UncompressedLargeAssets</span>
                            <span class="wpr-metric-label">Large uncompressed</span>
                        </div>
                    </div>

                    @if (cch.AssetSummaries.Count > 0)
                    {
                        <SectionHeader Title="Asset Detail" />

                        <div class="wpr-filter-chips wpr-cch-filters" role="group" aria-label="Filter caching view">
                            <button class="wpr-filter-chip @(_cchFilter == "all"          ? "is-active" : "")" @onclick='() => _cchFilter = "all"'>All (@cch.AssetSummaries.Count)</button>
                            <button class="wpr-filter-chip @(_cchFilter == "framework"    ? "is-active" : "")" @onclick='() => _cchFilter = "framework"'>Framework (@CachingCount("framework"))</button>
                            <button class="wpr-filter-chip @(_cchFilter == "uncompressed" ? "is-active" : "")" @onclick='() => _cchFilter = "uncompressed"'>Not Compressed (@CachingCount("uncompressed"))</button>
                            <button class="wpr-filter-chip @(_cchFilter == "uncached"     ? "is-active" : "")" @onclick='() => _cchFilter = "uncached"'>Not Cached (@CachingCount("uncached"))</button>
                        </div>

                        <div class="wpr-table-wrap">
                            <table class="wpr-table">
                                <thead>
                                    <tr>
                                        <th>Asset</th>
                                        <th>Type</th>
                                        <th>Cache-Control</th>
                                        <th>ETag</th>
                                        <th>Encoding</th>
                                        <th>Size</th>
                                        <th>Status</th>
                                        <th>Recommendation</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in FilteredCachingSummaries().Take(100))
                                    {
                                        <tr>
                                            <td class="wpr-asset-url" title="@s.Url">@TrimUrl(s.Url)</td>
                                            <td><span class="wpr-type-chip">@AssetTypeLabel(s.Type)</span></td>
                                            <td class="wpr-cache-cell" title="@(s.CacheControl ?? "")">@(s.CacheControl is null ? "—" : TruncateCache(s.CacheControl))</td>
                                            <td class="wpr-cch-etag">@(s.HasETag ? "✓" : "—")</td>
                                            <td>@CchEncodingBadge(s.CompressionStatus)</td>
                                            <td class="wpr-num">@(s.SizeBytes > 0 ? FormatBytes(s.SizeBytes) : "—")</td>
                                            <td>@CchStatusBadge(s)</td>
                                            <td class="wpr-gql-rec">@(s.Recommendation ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (FilteredCachingSummaries().Count() > 100)
                        { <p class="wpr-api-scan-note">Showing first 100 of @FilteredCachingSummaries().Count() filtered assets.</p> }
                    }

                    @if (cch.Findings.Count > 0)
                    {
                        <SectionHeader Title="@("Caching &amp; Compression Findings (" + cch.Findings.Count + ")")" />
                        <div class="wpr-findings-list">
                            @foreach (var f in cch.Findings.OrderBy(f => f.Severity))
                            { @FindingCard(f) }
                        </div>
                    }
                }
            }

            @* ── Blazor Review ───────────────────────────────────────────── *@
            @if (_tab == "blazor")
            {
                <p class="wpr-tab-intro">
                    Blazor-specific runtime patterns: lazy loading, IL trimming, render mode usage,
                    and framework configuration.
                </p>
                @if (!_report.Findings.Any(f => f.Category is PerformanceCategory.BlazorRuntime or PerformanceCategory.Configuration))
                {
                    <p class="wpr-empty-tab">Blazor runtime analysis not yet implemented.</p>
                }
                else
                {
                    <div class="wpr-findings-list">
                        @foreach (var f in _report.Findings
                            .Where(f => f.Category is PerformanceCategory.BlazorRuntime or PerformanceCategory.Configuration)
                            .OrderBy(f => f.Severity))
                        { @FindingCard(f) }
                    </div>
                }
            }

            @* ── Recommendations ─────────────────────────────────────────── *@
            @if (_tab == "recs")
            {
                @if (_report.Recommendations.Count == 0)
                {
                    <p class="wpr-empty-tab">No recommendations available — run a full performance review to generate them.</p>
                }
                else
                {
                    <ol class="wpr-rec-list">
                        @foreach (var r in _report.Recommendations.OrderBy(r => r.Priority))
                        {
                            <li class="wpr-rec-item">
                                <div class="wpr-rec-header">
                                    <span class="wpr-rec-priority" aria-label="Priority @r.Priority">#@r.Priority</span>
                                    <span class="wpr-rec-title">@r.Title</span>
                                    <span class="wpr-category-chip">@CategoryLabel(r.Category)</span>
                                </div>
                                <p class="wpr-rec-desc">@r.Description</p>
                            </li>
                        }
                    </ol>
                }
            }

        </div>
    }
    else if (!_running)
    {
        @* ── Empty state ─────────────────────────────────────────────────── *@
        <EmptyState Icon="⚡" Title="Ready to analyse"
                    Description="Run a performance review to get a readiness score, category analysis, top risks, and actionable recommendations for your Blazor WASM application.">
            <PrimaryButton OnClick="RunReview"
                           Disabled="@(_context is null || !_context?.HasTargetUrl == true)"
                           aria-label="Run Blazor WASM Performance Review">
                Run Performance Review
            </PrimaryButton>
            @if (_context is not null && !_context.HasTargetUrl)
            {
                <p class="wpr-empty-note">
                    Configure a target URL in <a href="/admin/system-settings">Frontend Analysis Settings</a>.
                </p>
            }
        </EmptyState>
    }

</div>

@code {
    private FrontendAnalysisContext? _context;

    private bool    _running;
    private string? _error;
    private WasmPerformanceReviewReport? _report;
    private string  _tab = "overview";
    private readonly HashSet<string> _expandedFindings = [];

    // Assets tab state
    private string     _assetSearch     = "";
    private AssetType? _assetTypeFilter;
    private string     _sortColumn      = "type";
    private bool       _sortAscending   = true;

    // Caching tab state
    private string _cchFilter = "all";

    protected override async Task OnInitializedAsync()
    {
        _context = await ContextFactory.GetActiveContextAsync();

        _report = RuntimeReviews.PerformanceReview.Report;
    }

    private async Task ExportHtml()
    {
        if (_report is null) return;
        var html = ExportService.ExportPerformanceReview(_report, Workspace.ProjectName);
        await JS.InvokeVoidAsync("downloadHtmlFile", $"performance-review-{DateTime.UtcNow:yyyy-MM-dd}.html", html);
    }

    private async Task RunReview()
    {
        if (_context is null || !_context.HasTargetUrl) return;

        _running = true;
        _error   = null;
        _report  = null;
        RuntimeReviews.MarkPerformanceRunning(_context);
        StateHasChanged();

        try
        {
            var report = await ReviewService.RunReviewAsync(_context.TargetUrl);
            if (report.ErrorMessage is not null)
            {
                _error = report.ErrorMessage;
                RuntimeReviews.MarkPerformanceFailed(_context, _error);
            }
            else
            {
                _report = report;
                RuntimeReviews.SavePerformanceResult(report, _context);
                _tab    = "overview";
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _error = "Review could not be completed. Check that the target URL is reachable.";
            RuntimeReviews.MarkPerformanceFailed(_context, _error);
            _ = ex;
        }
        finally
        {
            _running = false;
        }
    }

    private async Task RefreshContext()
    {
        _context = await ContextFactory.GetActiveContextAsync();
    }

    private void SetTab(string tab) => _tab = tab;

    private void ToggleFinding(string id)
    {
        if (!_expandedFindings.Remove(id)) _expandedFindings.Add(id);
    }

    private void SortBy(string column)
    {
        if (_sortColumn == column) _sortAscending = !_sortAscending;
        else { _sortColumn = column; _sortAscending = true; }
    }

    private void ClearAssetFilters()
    {
        _assetSearch     = "";
        _assetTypeFilter = null;
    }

    // ── Readiness helpers ────────────────────────────────────────────────────

    private static string ReadinessStateLabel(PerformanceReadinessState state) => state switch
    {
        PerformanceReadinessState.Ready            => "Ready",
        PerformanceReadinessState.MostlyReady      => "Mostly Ready",
        PerformanceReadinessState.NeedsImprovement => "Needs Improvement",
        PerformanceReadinessState.HighRisk         => "High Risk",
        _                                          => "Not Assessed"
    };

    private static string ReadinessStateClass(PerformanceReadinessState state) => state switch
    {
        PerformanceReadinessState.Ready            => "wpr-rdy-good",
        PerformanceReadinessState.MostlyReady      => "wpr-rdy-warning",
        PerformanceReadinessState.NeedsImprovement => "wpr-rdy-poor",
        PerformanceReadinessState.HighRisk         => "wpr-rdy-critical",
        _                                          => "wpr-rdy-unknown"
    };

    private static string DrilldownTab(string categoryName) => categoryName switch
    {
        "Startup"      => "startup",
        "API"          => "api",
        "GraphQL"      => "api",
        "Caching"      => "caching",
        "Compression"  => "caching",
        "Architecture" => "blazor",
        _              => "assets"
    };

    // ── Caching tab helpers ──────────────────────────────────────────────────

    private IEnumerable<AssetCachingSummary> FilteredCachingSummaries()
    {
        if (_report?.CachingAnalysis is null) return [];
        var all = _report.CachingAnalysis.AssetSummaries;
        return _cchFilter switch
        {
            "framework"    => all.Where(s => IsCachingFrameworkType(s.Type)),
            "uncompressed" => all.Where(s => s.CompressionStatus == CompressionStatus.NotCompressed),
            "uncached"     => all.Where(s => s.CacheStatus == CacheStatus.NotCached),
            _              => all
        };
    }

    private int CachingCount(string filter)
    {
        if (_report?.CachingAnalysis is null) return 0;
        var all = _report.CachingAnalysis.AssetSummaries;
        return filter switch
        {
            "framework"    => all.Count(s => IsCachingFrameworkType(s.Type)),
            "uncompressed" => all.Count(s => s.CompressionStatus == CompressionStatus.NotCompressed),
            "uncached"     => all.Count(s => s.CacheStatus == CacheStatus.NotCached),
            _              => all.Count
        };
    }

    private static bool IsCachingFrameworkType(AssetType t) =>
        t is AssetType.FrameworkDll or AssetType.WasmRuntime or AssetType.FrameworkJs
          or AssetType.ApplicationDll or AssetType.SatelliteAssembly;

    private static MarkupString CchEncodingBadge(CompressionStatus status)
    {
        var (cls, label) = status switch
        {
            CompressionStatus.Brotli  => ("wpr-cch-enc-br",    "br"),
            CompressionStatus.Gzip    => ("wpr-cch-enc-gz",    "gzip"),
            CompressionStatus.Other   => ("wpr-cch-enc-other", "other"),
            _                         => ("wpr-cch-enc-none",  "none")
        };
        return new MarkupString($"<span class=\"wpr-cch-enc {cls}\">{label}</span>");
    }

    private static MarkupString CchStatusBadge(AssetCachingSummary s)
    {
        bool compressed = s.CompressionStatus != CompressionStatus.NotCompressed;
        bool cached     = s.CacheStatus == CacheStatus.ProperlyOptimized;
        var (cls, label) = (compressed, cached) switch
        {
            (true,  true)  => ("wpr-cch-status-ok",      "Optimised"),
            (true,  false) => ("wpr-cch-status-partial",  "Compressed"),
            (false, true)  => ("wpr-cch-status-partial",  "Cached"),
            _              => ("wpr-cch-status-poor",     "Not optimised")
        };
        return new MarkupString($"<span class=\"wpr-cch-status {cls}\">{label}</span>");
    }

    // ── Startup tab helpers ──────────────────────────────────────────────────

    private IEnumerable<PerformanceFinding> StartupFindings() =>
        _report?.Findings
                .Where(f => f.Category == PerformanceCategory.Startup)
                .OrderBy(f => f.Severity)
            ?? Enumerable.Empty<PerformanceFinding>();

    private int StartupFindingCount() =>
        _report?.Findings.Count(f => f.Category == PerformanceCategory.Startup) ?? 0;

    // ── Computed helpers ─────────────────────────────────────────────────────

    private List<DiscoveredAsset> SuccessAssets() =>
        _report?.Assets.Where(a => a.StatusCode is >= 200 and < 300).ToList() ?? [];

    // ── Assets tab ───────────────────────────────────────────────────────────

    private IEnumerable<DiscoveredAsset> FilteredSortedAssets(IReadOnlyList<DiscoveredAsset> all)
    {
        var q = all.AsEnumerable();

        if (_assetTypeFilter.HasValue)
            q = q.Where(a => a.Type == _assetTypeFilter.Value);

        if (!string.IsNullOrWhiteSpace(_assetSearch))
        {
            var term = _assetSearch.Trim();
            q = q.Where(a =>
                a.Url.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                AssetTypeLabel(a.Type).Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        q = (_sortColumn, _sortAscending) switch
        {
            ("url",    true)  => q.OrderBy(a => a.Url),
            ("url",    false) => q.OrderByDescending(a => a.Url),
            ("type",   true)  => q.OrderBy(a => a.Type).ThenBy(a => a.Url),
            ("type",   false) => q.OrderByDescending(a => a.Type).ThenByDescending(a => a.Url),
            ("size",   true)  => q.OrderBy(a => a.ContentLength ?? a.DownloadedBytes),
            ("size",   false) => q.OrderByDescending(a => a.ContentLength ?? a.DownloadedBytes),
            ("enc",    true)  => q.OrderBy(a => a.ContentEncoding ?? ""),
            ("enc",    false) => q.OrderByDescending(a => a.ContentEncoding ?? ""),
            ("cache",  true)  => q.OrderBy(a => a.CacheControl ?? ""),
            ("cache",  false) => q.OrderByDescending(a => a.CacheControl ?? ""),
            ("time",   true)  => q.OrderBy(a => a.DownloadTimeMs),
            ("time",   false) => q.OrderByDescending(a => a.DownloadTimeMs),
            ("status", true)  => q.OrderBy(a => a.StatusCode),
            ("status", false) => q.OrderByDescending(a => a.StatusCode),
            _                 => q
        };

        return q;
    }

    private string SortClass(string col) => _sortColumn == col ? "wpr-th-active" : "";

    private MarkupString SortIcon(string col)
    {
        var icon = _sortColumn == col
            ? $"<span class=\"wpr-sort-icon wpr-sort-icon-active\">{(_sortAscending ? "▲" : "▼")}</span>"
            : "<span class=\"wpr-sort-icon\">⇅</span>";
        return new MarkupString(icon);
    }

    private static MarkupString StatusBadge(int code)
    {
        var cls = code switch { >= 200 and < 300 => "wpr-status-ok", 0 => "wpr-status-err", _ => "wpr-status-warn" };
        var txt = code == 0 ? "ERR" : code.ToString();
        return new MarkupString($"<span class=\"{cls}\">{txt}</span>");
    }

    private RenderFragment FindingCard(PerformanceFinding f) => builder =>
    {
        var expanded = _expandedFindings.Contains(f.Id);
        var sevCls   = f.Severity.ToString().ToLower();
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", $"wpr-finding wpr-finding-{sevCls}");
            builder.OpenElement(2, "button");
            builder.AddAttribute(3, "class", "wpr-finding-header");
            builder.AddAttribute(4, "aria-expanded", expanded.ToString().ToLower());
            builder.AddAttribute(5, "onclick", EventCallback.Factory.Create(this, () => ToggleFinding(f.Id)));
                builder.OpenElement(6, "div");
                builder.AddAttribute(7, "class", "wpr-finding-title-row");
                    builder.OpenElement(8, "span");
                    builder.AddAttribute(9, "class", $"wpr-sev-badge wpr-sev-{sevCls}");
                    builder.AddContent(10, f.Severity.ToString());
                    builder.CloseElement();
                    builder.OpenElement(11, "span");
                    builder.AddAttribute(12, "class", "wpr-finding-title");
                    builder.AddContent(13, f.Title);
                    builder.CloseElement();
                    builder.OpenElement(14, "span");
                    builder.AddAttribute(15, "class", "wpr-finding-id");
                    builder.AddContent(16, f.Id);
                    builder.CloseElement();
                builder.CloseElement();
                builder.OpenElement(17, "span");
                builder.AddAttribute(18, "class", "wpr-chevron");
                builder.AddAttribute(19, "aria-hidden", "true");
                builder.AddContent(20, expanded ? "▲" : "▼");
                builder.CloseElement();
            builder.CloseElement();
        if (expanded)
        {
            builder.OpenElement(21, "div");
            builder.AddAttribute(22, "class", "wpr-finding-body");
                builder.OpenElement(23, "p");
                builder.AddAttribute(24, "class", "wpr-finding-desc");
                builder.AddContent(25, f.Description);
                builder.CloseElement();
                builder.OpenElement(26, "div");
                builder.AddAttribute(27, "class", "wpr-finding-rec");
                builder.AddContent(28, $"Recommendation: {f.Recommendation}");
                builder.CloseElement();
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    // ── Label helpers ────────────────────────────────────────────────────────

    private static string AssetTypeLabel(AssetType t) => t switch
    {
        AssetType.Index             => "Index",
        AssetType.FrameworkJs       => "Framework JS",
        AssetType.BootManifest      => "Boot Manifest",
        AssetType.FrameworkDll      => "Framework DLL",
        AssetType.ApplicationDll    => "App DLL",
        AssetType.SatelliteAssembly => "Satellite",
        AssetType.WasmRuntime       => "WASM Runtime",
        AssetType.Css               => "CSS",
        AssetType.JavaScript        => "JavaScript",
        AssetType.Font              => "Font",
        AssetType.Image             => "Image",
        AssetType.Other             => "Other",
        _                           => t.ToString()
    };

    private static string CategoryLabel(PerformanceCategory c) => c switch
    {
        PerformanceCategory.Startup       => "Startup",
        PerformanceCategory.Assets        => "Assets",
        PerformanceCategory.ApiCalls      => "API Calls",
        PerformanceCategory.Caching       => "Caching",
        PerformanceCategory.Compression   => "Compression",
        PerformanceCategory.BlazorRuntime => "Blazor Runtime",
        PerformanceCategory.Network       => "Network",
        PerformanceCategory.Configuration => "Configuration",
        _                                 => c.ToString()
    };

    private static string TrimUrl(string url) =>
        url.Length > 80 ? "…" + url[^77..] : url;

    private static string TruncateCache(string? value) =>
        value is null ? "—" : value.Length > 30 ? value[..27] + "…" : value;

    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0)        return "0 B";
        if (bytes < 1_024)     return $"{bytes} B";
        if (bytes < 1_048_576) return $"{bytes / 1024} KB";
        return $"{bytes / 1_048_576.0:F1} MB";
    }
}
