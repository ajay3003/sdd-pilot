    /* Readiness Dashboard */
    .wpr-rdy-overall-card { align-items: center; border: 2px solid var(--border, #3a3a4a); border-radius: 10px; display: flex; flex-wrap: wrap; gap: 1.25rem; justify-content: space-between; margin-bottom: 1.75rem; padding: 1.25rem 1.75rem; }
    .wpr-rdy-overall-card.wpr-rdy-good     { border-color: #a6e3a1; }
    .wpr-rdy-overall-card.wpr-rdy-warning  { border-color: #f9e2af; }
    .wpr-rdy-overall-card.wpr-rdy-poor     { border-color: #fab387; }
    .wpr-rdy-overall-card.wpr-rdy-critical { border-color: #f38ba8; }
    .wpr-rdy-overall-left { display: flex; align-items: baseline; gap: 1rem; }
    .wpr-rdy-overall-score { font-size: 2.75rem; font-weight: 800; font-family: monospace; line-height: 1; }
    .wpr-rdy-overall-card.wpr-rdy-good     .wpr-rdy-overall-score { color: #a6e3a1; }
    .wpr-rdy-overall-card.wpr-rdy-warning  .wpr-rdy-overall-score { color: #f9e2af; }
    .wpr-rdy-overall-card.wpr-rdy-poor     .wpr-rdy-overall-score { color: #fab387; }
    .wpr-rdy-overall-card.wpr-rdy-critical .wpr-rdy-overall-score { color: #f38ba8; }
    .wpr-rdy-overall-card.wpr-rdy-unknown  .wpr-rdy-overall-score { color: var(--text-muted, #888); }
    .wpr-rdy-overall-state { font-size: 1.1rem; font-weight: 600; }
    .wpr-rdy-overall-right { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
    .wpr-rdy-all-clear { font-size: 0.82rem; color: #a6e3a1; opacity: 0.85; }

    .wpr-rdy-score-grid { display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); margin-bottom: 1.75rem; }
    .wpr-rdy-category-card { background: var(--surface-raised, #1e1e2e); border: 2px solid var(--border, #3a3a4a); border-radius: 8px; color: inherit; cursor: pointer; display: flex; flex-direction: column; gap: 0.25rem; padding: 1rem 1.1rem; text-align: left; transition: border-color .15s, background .12s; }
    .wpr-rdy-category-card:hover { background: color-mix(in srgb, var(--accent, #7c8cf8) 5%, transparent); }
    .wpr-rdy-category-card.wpr-rdy-good     { border-color: #a6e3a1; }
    .wpr-rdy-category-card.wpr-rdy-warning  { border-color: #f9e2af; }
    .wpr-rdy-category-card.wpr-rdy-poor     { border-color: #fab387; }
    .wpr-rdy-category-card.wpr-rdy-critical { border-color: #f38ba8; }
    .wpr-rdy-category-card.wpr-rdy-unknown  { border-style: dashed; opacity: 0.7; }
    .wpr-rdy-cat-name { font-size: 0.78rem; font-weight: 600; opacity: 0.7; text-transform: uppercase; letter-spacing: .04em; }
    .wpr-rdy-cat-score { font-size: 1.6rem; font-weight: 800; font-family: monospace; line-height: 1.15; }
    .wpr-rdy-category-card.wpr-rdy-good     .wpr-rdy-cat-score { color: #a6e3a1; }
