@code {
    private string   _targetUrl     = "";
    private bool     _running;
    private bool     _attempted;
    private bool     _inputExpanded = true;
    private string?  _error;
    private WasmPerformanceReviewReport? _report;
    private string   _tab           = "overview";
    private readonly HashSet<string> _expandedFindings = [];

    // Assets tab state
    private string     _assetSearch   = "";
    private AssetType? _assetTypeFilter;
    private string     _sortColumn    = "type";
    private bool       _sortAscending = true;

    protected override void OnInitialized()
    {
        var cached = ReviewService.GetCached();
        if (cached is not null)
        {
            _report        = cached;
            _targetUrl     = cached.TargetUrl;
            _inputExpanded = false;
        }
    }

    private async Task RunReview()
    {
        _attempted = true;
        if (string.IsNullOrWhiteSpace(_targetUrl)) return;

        _running = true;
        _error   = null;
        StateHasChanged();

        try
        {
            var report = await ReviewService.RunReviewAsync(_targetUrl.Trim());
            if (report.ErrorMessage is not null)
            {
                _error = report.ErrorMessage;
            }
            else
            {
                _report        = report;
                _inputExpanded = false;
                _tab           = "startup";
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _error = "Review could not be completed. Check that the target URL is reachable.";
            _ = ex;
        }
        finally
        {
            _running = false;
        }
    }

    private void SetTab(string tab) => _tab = tab;
    private void ToggleInput() => _inputExpanded = !_inputExpanded;

    private void ToggleFinding(string id)
    {
        if (!_expandedFindings.Remove(id)) _expandedFindings.Add(id);
    }

    private void SortBy(string column)
    {
        if (_sortColumn == column) _sortAscending = !_sortAscending;
        else { _sortColumn = column; _sortAscending = true; }
    }

    private void ClearAssetFilters()
    {
        _assetSearch     = "";
        _assetTypeFilter = null;
    }

    // ── Readiness dashboard helpers ──────────────────────────────────────────

    private static string ReadinessStateLabel(PerformanceReadinessState state) => state switch
    {
        PerformanceReadinessState.Ready            => "Ready",
        PerformanceReadinessState.MostlyReady      => "Mostly Ready",
        PerformanceReadinessState.NeedsImprovement => "Needs Improvement",
        PerformanceReadinessState.HighRisk         => "High Risk",
        _                               => "Not Assessed"
    };

    private static string ReadinessStateClass(PerformanceReadinessState state) => state switch
    {
        PerformanceReadinessState.Ready            => "wpr-rdy-good",
        PerformanceReadinessState.MostlyReady      => "wpr-rdy-warning",
        PerformanceReadinessState.NeedsImprovement => "wpr-rdy-poor",
        PerformanceReadinessState.HighRisk         => "wpr-rdy-critical",
        _                               => "wpr-rdy-unknown"
    };

    private static string DrilldownTab(string categoryName) => categoryName switch
    {
        "Startup"      => "startup",
        "API"          => "api",
        "GraphQL"      => "api",
        "Caching"      => "caching",
        "Compression"  => "caching",
        "Architecture" => "blazor",
        _              => "assets"
    };

    // ── Caching & Compression tab state and helpers ──────────────────────────

    private string _cchFilter = "all";

    private IEnumerable<AssetCachingSummary> FilteredCachingSummaries()
    {
        if (_report?.CachingAnalysis is null) return [];
        var all = _report.CachingAnalysis.AssetSummaries;
        return _cchFilter switch
        {
            "framework"    => all.Where(s => IsCachingFrameworkType(s.Type)),
            "uncompressed" => all.Where(s => s.CompressionStatus == CompressionStatus.NotCompressed),
            "uncached"     => all.Where(s => s.CacheStatus == CacheStatus.NotCached),
            _              => all
        };
    }

    private int CachingCount(string filter)
    {
        if (_report?.CachingAnalysis is null) return 0;
        var all = _report.CachingAnalysis.AssetSummaries;
        return filter switch
        {
            "framework"    => all.Count(s => IsCachingFrameworkType(s.Type)),
            "uncompressed" => all.Count(s => s.CompressionStatus == CompressionStatus.NotCompressed),
            "uncached"     => all.Count(s => s.CacheStatus == CacheStatus.NotCached),
            _              => all.Count
        };
    }

    private static bool IsCachingFrameworkType(AssetType t) =>
        t is AssetType.FrameworkDll or AssetType.WasmRuntime or AssetType.FrameworkJs
          or AssetType.ApplicationDll or AssetType.SatelliteAssembly;

    private static MarkupString CchEncodingBadge(CompressionStatus status)
    {
        var (cls, label) = status switch
        {
            CompressionStatus.Brotli        => ("wpr-cch-enc-br",   "br"),
            CompressionStatus.Gzip          => ("wpr-cch-enc-gz",   "gzip"),
            CompressionStatus.Other         => ("wpr-cch-enc-other","other"),
            _                               => ("wpr-cch-enc-none", "none")
        };
        return new MarkupString($"<span class=\"wpr-cch-enc {cls}\">{label}</span>");
    }

    private static MarkupString CchStatusBadge(AssetCachingSummary s)
    {
        bool compressed = s.CompressionStatus != CompressionStatus.NotCompressed;
        bool cached     = s.CacheStatus == CacheStatus.ProperlyOptimized;
        var (cls, label) = (compressed, cached) switch
        {
            (true,  true)  => ("wpr-cch-status-ok",      "Optimised"),
            (true,  false) => ("wpr-cch-status-partial",  "Compressed"),
            (false, true)  => ("wpr-cch-status-partial",  "Cached"),
            _              => ("wpr-cch-status-poor",     "Not optimised")
        };
        return new MarkupString($"<span class=\"wpr-cch-status {cls}\">{label}</span>");
    }

    // ── Startup tab helpers ──────────────────────────────────────────────────

    private IEnumerable<PerformanceFinding> StartupFindings() =>
        _report?.Findings
                .Where(f => f.Category == PerformanceCategory.Startup)
                .OrderBy(f => f.Severity)
            ?? Enumerable.Empty<PerformanceFinding>();

    private int StartupFindingCount() =>
        _report?.Findings.Count(f => f.Category == PerformanceCategory.Startup) ?? 0;

    // ── Overview computed helpers ────────────────────────────────────────────

    private List<DiscoveredAsset> SuccessAssets() =>
        _report?.Assets.Where(a => a.StatusCode is >= 200 and < 300).ToList() ?? [];

    private int CompressedCount() =>
        SuccessAssets().Count(a => !string.IsNullOrEmpty(a.ContentEncoding));

    private int CachedCount() =>
        SuccessAssets().Count(a => !string.IsNullOrEmpty(a.CacheControl));

    private int ErrorAssetCount() =>
        _report?.Assets.Count(a => a.StatusCode == 0 || a.StatusCode >= 400) ?? 0;

    // ── Assets tab ───────────────────────────────────────────────────────────

    private IEnumerable<DiscoveredAsset> FilteredSortedAssets(IReadOnlyList<DiscoveredAsset> all)
    {
        var q = all.AsEnumerable();

        if (_assetTypeFilter.HasValue)
            q = q.Where(a => a.Type == _assetTypeFilter.Value);

        if (!string.IsNullOrWhiteSpace(_assetSearch))
        {
            var term = _assetSearch.Trim();
            q = q.Where(a =>
                a.Url.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                AssetTypeLabel(a.Type).Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        q = (_sortColumn, _sortAscending) switch
        {
            ("url",    true)  => q.OrderBy(a => a.Url),
            ("url",    false) => q.OrderByDescending(a => a.Url),
            ("type",   true)  => q.OrderBy(a => a.Type).ThenBy(a => a.Url),
            ("type",   false) => q.OrderByDescending(a => a.Type).ThenByDescending(a => a.Url),
            ("size",   true)  => q.OrderBy(a => a.ContentLength ?? a.DownloadedBytes),
            ("size",   false) => q.OrderByDescending(a => a.ContentLength ?? a.DownloadedBytes),
            ("enc",    true)  => q.OrderBy(a => a.ContentEncoding ?? ""),
            ("enc",    false) => q.OrderByDescending(a => a.ContentEncoding ?? ""),
            ("cache",  true)  => q.OrderBy(a => a.CacheControl ?? ""),
            ("cache",  false) => q.OrderByDescending(a => a.CacheControl ?? ""),
            ("time",   true)  => q.OrderBy(a => a.DownloadTimeMs),
            ("time",   false) => q.OrderByDescending(a => a.DownloadTimeMs),
            ("status", true)  => q.OrderBy(a => a.StatusCode),
            ("status", false) => q.OrderByDescending(a => a.StatusCode),
            _                 => q
        };

        return q;
    }

    private string SortClass(string col) => _sortColumn == col ? "wpr-th-active" : "";

    private MarkupString SortIcon(string col)
    {
        var icon = _sortColumn == col
            ? $"<span class=\"wpr-sort-icon wpr-sort-icon-active\">{(_sortAscending ? "▲" : "▼")}</span>"
            : "<span class=\"wpr-sort-icon\">⇅</span>";
        return new MarkupString(icon);
    }

    private static MarkupString StatusBadge(int code)
    {
        var cls = code switch { >= 200 and < 300 => "wpr-status-ok", 0 => "wpr-status-err", _ => "wpr-status-warn" };
        var txt = code == 0 ? "ERR" : code.ToString();
        return new MarkupString($"<span class=\"{cls}\">{txt}</span>");
    }

    private RenderFragment FindingCard(PerformanceFinding f) => builder =>
    {
        var expanded = _expandedFindings.Contains(f.Id);
        var sevCls   = f.Severity.ToString().ToLower();
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", $"wpr-finding wpr-finding-{sevCls}");
            builder.OpenElement(2, "button");
            builder.AddAttribute(3, "class", "wpr-finding-header");
            builder.AddAttribute(4, "onclick", EventCallback.Factory.Create(this, () => ToggleFinding(f.Id)));
                builder.OpenElement(5, "div");
                builder.AddAttribute(6, "class", "wpr-finding-title-row");
                    builder.OpenElement(7, "span");
                    builder.AddAttribute(8, "class", $"wpr-sev-badge wpr-sev-{sevCls}");
                    builder.AddContent(9, f.Severity.ToString());
                    builder.CloseElement();
                    builder.OpenElement(10, "span");
                    builder.AddAttribute(11, "class", "wpr-finding-title");
                    builder.AddContent(12, f.Title);
                    builder.CloseElement();
                    builder.OpenElement(13, "span");
                    builder.AddAttribute(14, "class", "wpr-finding-id");
                    builder.AddContent(15, f.Id);
                    builder.CloseElement();
                builder.CloseElement();
                builder.OpenElement(16, "span");
                builder.AddAttribute(17, "class", "wpr-chevron");
                builder.AddContent(18, expanded ? "▲" : "▼");
                builder.CloseElement();
            builder.CloseElement();
        if (expanded)
        {
            builder.OpenElement(19, "div");
            builder.AddAttribute(20, "class", "wpr-finding-body");
                builder.OpenElement(21, "p");
                builder.AddAttribute(22, "class", "wpr-finding-desc");
                builder.AddContent(23, f.Description);
                builder.CloseElement();
                builder.OpenElement(24, "div");
                builder.AddAttribute(25, "class", "wpr-finding-rec");
                builder.AddContent(26, $"Recommendation: {f.Recommendation}");
                builder.CloseElement();
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    // ── Label helpers ────────────────────────────────────────────────────────

    private static string AssetTypeLabel(AssetType t) => t switch
    {
        AssetType.Index             => "Index",
        AssetType.FrameworkJs       => "Framework JS",
        AssetType.BootManifest      => "Boot Manifest",
        AssetType.FrameworkDll      => "Framework DLL",
        AssetType.ApplicationDll    => "App DLL",
        AssetType.SatelliteAssembly => "Satellite",
        AssetType.WasmRuntime       => "WASM Runtime",
        AssetType.Css               => "CSS",
        AssetType.JavaScript        => "JavaScript",
        AssetType.Font              => "Font",
        AssetType.Image             => "Image",
        AssetType.Other             => "Other",
        _                           => t.ToString()
    };

    private static string CategoryLabel(PerformanceCategory c) => c switch
    {
        PerformanceCategory.Startup       => "Startup",
        PerformanceCategory.Assets        => "Assets",
        PerformanceCategory.ApiCalls      => "API Calls",
        PerformanceCategory.Caching       => "Caching",
        PerformanceCategory.Compression   => "Compression",
        PerformanceCategory.BlazorRuntime => "Blazor Runtime",
        PerformanceCategory.Network       => "Network",
        PerformanceCategory.Configuration => "Configuration",
        _                                 => c.ToString()
    };

    private static string TrimUrl(string url) =>
        url.Length > 80 ? "…" + url[^77..] : url;

    private static string TruncateCache(string? value) =>
        value is null ? "—" : value.Length > 30 ? value[..27] + "…" : value;

    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0)        return "0 B";
        if (bytes < 1_024)     return $"{bytes} B";
        if (bytes < 1_048_576) return $"{bytes / 1024} KB";
        return $"{bytes / 1_048_576.0:F1} MB";
    }
}
