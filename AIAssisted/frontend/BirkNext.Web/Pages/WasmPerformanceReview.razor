    .wpr-empty-findings { font-size: 0.875rem; color: #a6e3a1; padding: 0.75rem 0; }
    .wpr-rec-note { font-size: 0.82rem; opacity: 0.7; margin-top: 1.25rem; }
    .wpr-link-btn { background: none; border: none; color: var(--accent, #7c8cf8); cursor: pointer; font-size: 0.82rem; padding: 0; text-decoration: underline; }

    /* Recommendations */
    .wpr-rec-list { display: flex; flex-direction: column; gap: 0.75rem; list-style: none; margin: 0; padding: 0; }
    .wpr-rec-item { background: var(--surface-raised, #1e1e2e); border: 1px solid var(--border, #3a3a4a); border-radius: 7px; padding: 1rem 1.25rem; }
