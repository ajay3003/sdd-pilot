    /// <summary>Decision context in one place: evidence profile, the three inputs, environment → application → project, and what can run now.</summary>
    private RenderFragment ContextSummary() => __builder =>
    {
        var r = _readiness!;
        var setup = r.RuntimeSetup;
        string Step(string key, string fallback) => setup.FirstOrDefault(s => s.Key == key) is { } s ? (s.Met ? s.Detail : "Not configured") : fallback;
        var environment = setup.FirstOrDefault(s => s.Key == WorkflowPaths.EnvironmentStep) is { Met: true } env ? env.Detail : "Not configured";
        var project = setup.FirstOrDefault(s => s.Key == WorkflowPaths.ProjectStep) is { } ps ? (ps.Met ? ps.Label.Replace("Project evidence for ", "") + " · ready" : ps.Label.StartsWith("Project evidence for ") ? ps.Detail : "Not configured") : "Not configured";
        var primary = r.Capabilities.Where(c => c.IsActionable).Take(3).Select(c => c.DisplayName).ToList();
        <dl class="rw-workspace-details rw-context-summary" data-testid="rw-context-summary">
            <div class="rw-detail-item"><dt class="rw-detail-label">Workspace / import</dt><dd class="rw-detail-value" title="@r.ProjectName">@(string.IsNullOrWhiteSpace(r.ProjectName) ? r.WorkspaceName : r.ProjectName)</dd></div>
            <div class="rw-detail-item"><dt class="rw-detail-label">Evidence profile</dt><dd class="rw-detail-value" data-testid="rw-evidence-profile">@WorkflowPaths.Label(r.EvidenceProfile)</dd></div>
            <div class="rw-detail-item"><dt class="rw-detail-label">Source</dt><dd class="rw-detail-value" data-testid="rw-summary-source">@r.Inputs.Source.StatusLabel</dd></div>
            <div class="rw-detail-item"><dt class="rw-detail-label">Project documents</dt><dd class="rw-detail-value" data-testid="rw-summary-documents">@(DocumentsUnavailable ? "Unavailable" : r.Inputs.Documents.StatusLabel)</dd></div>
            <div class="rw-detail-item"><dt class="rw-detail-label">Target Environment</dt><dd class="rw-detail-value" data-testid="rw-summary-environment">@environment</dd></div>
            <div class="rw-detail-item"><dt class="rw-detail-label">Target Application</dt><dd class="rw-detail-value" data-testid="rw-summary-application">@Step(WorkflowPaths.TargetApplicationStep, "Not configured")</dd></div>
            <div class="rw-detail-item"><dt class="rw-detail-label">Project evidence</dt><dd class="rw-detail-value" data-testid="rw-summary-project">@project</dd></div>
            <div class="rw-detail-item"><dt class="rw-detail-label">Available reviews</dt><dd class="rw-detail-value" data-testid="rw-summary-available">@(primary.Count == 0 ? "None yet" : string.Join(", ", primary))</dd></div>
        </dl>
