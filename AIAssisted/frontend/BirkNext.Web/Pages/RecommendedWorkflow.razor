                    <summary>Show unavailable review types (@steps.Count)</summary>
                    <ul class="rw-cap-list">@foreach (var step in steps) { <li class="rw-cap is-notapplicable" data-step="@step.Key"><span class="rw-cap-name">@step.Title</span> <span class="rw-cap-status">Unavailable</span></li> }</ul>
