@page "/getting-started"
@inject NavigationManager Navigation

@* Recommended Workflow was retired on 2026-11-19. Its unique parts moved to Project Dashboard: review decisions (ReviewDecisionPanel) and the
   workspace actions Save, Save As, Manage Workspaces and Clear (WorkspaceActionsMenu). Project inputs and the next action were already on the
   Dashboard. Old links land on the Dashboard with their query kept; the history entry is replaced, so Back does not loop. *@

@code {
    protected override void OnInitialized()
    {
        var query = new Uri(Navigation.Uri).Query;
        Navigation.NavigateTo("dashboard" + query, replace: true);
    }
}
