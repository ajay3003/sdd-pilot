    private string SectionLead(ReviewSection section) => section switch
    {
        ReviewSection.Source => "Source Analysis owns source/code evidence. Source-backed reviews apply only where the analyzed snapshot provides their evidence; implementation evidence also needs the Artifact Pack bound to source.",
        ReviewSection.Runtime => _readiness?.Inputs.Target.Status == ProjectInputStatus.Ready
            ? "A Target Environment is configured: runtime reviews can execute or observe the deployed system according to their own prerequisites."
            : "A Target Environment is required only for reviews that execute or observe the deployed system. It is optional until a runtime review is needed.",
        ReviewSection.Change => "Optional change provenance. Not configured is neutral and never blocks source-backed reviews.",
        ReviewSection.QualityTesting => "Applicable quality and testing capabilities, based on current evidence. Available does not mean reviewed, passed or required.",
        _ => "Domain-specific reviews, shown only when they apply to this project. Not part of the core review path.",
    };

    /// <summary>The recommendation card carries the one primary action; the same step's own button is secondary.</summary>
    private string PrimaryUnlessRecommended(WorkflowStepViewModel step) =>
        _readiness?.NextRecommendedAction?.Key == step.Key ? "rw-cta rw-cta-secondary" : "rw-cta";

    private RenderFragment RenderAction(WorkflowStepViewModel step) => __builder =>
    {
        if (IsLoadWorkspaceStep(step))
        {
            if (_readiness?.ArtifactLoad == ArtifactLoadState.Done) return;
            <div class="rw-step-actions">
                @if (_readiness?.ArtifactLoad == ArtifactLoadState.Required)
                {
                    <a href="@step.Route" class="@PrimaryUnlessRecommended(step)" data-testid="rw-load-artifacts">@step.ActionLabel</a>
                }
                @foreach (var alternative in _readiness?.AlternativeActions ?? [])
                {
                    <a href="@alternative.Route" class="rw-step-link" data-testid="rw-alternative-action">@alternative.ActionLabel</a>
                }
            </div>
            return;
        }

        var review = IsReviewGate(step) ? ArtifactReviewPresentation.Of(step) : null;
        if (review is { CanDecide: false } || (review is null && step.Status == WorkflowStepStatus.Locked))
        {
            // Not applicable or blocked: the status line says why; no review or approval controls.
            return;
        }

        if (step.CanOpen)
        {
            <a href="@step.Route" class="@(step.IsCurrent ? PrimaryUnlessRecommended(step) : "rw-cta rw-cta-secondary")">@step.ActionLabel →</a>
        }

        if (review is not null && !string.IsNullOrWhiteSpace(step.ArtifactReferences))
        {
            @RenderDecision(step, review)
        }
    };

    /// <summary>
    /// A review decision, recorded on purpose: inside a disclosure that names the exact artifact revisions it applies to. Opening
    /// an explorer never records one.
    /// </summary>
    private RenderFragment RenderDecision(WorkflowStepViewModel step, ArtifactReviewStatus review) => __builder =>
    {
        var busy = _approvingStepId == step.Key;
        <details class="rw-decision" data-testid="rw-decision">
            <summary>Record review decision</summary>
            <p class="rw-decision-target" id="rw-decision-@step.Key" data-testid="rw-decision-target">Applies to @step.ArtifactReferences</p>
            <div class="rw-approval-buttons" role="group" aria-labelledby="rw-decision-@step.Key">
                @if (step.RequiresManualReview && review.State is not (ArtifactReviewState.Reviewed or ArtifactReviewState.Approved))
                {
                    <PrimaryButton Class="rw-review-button" Disabled="busy" OnClick="() => MarkReviewedAsync(step)">@(busy ? "Saving..." : "Mark reviewed")</PrimaryButton>
                }
                @if (review.State != ArtifactReviewState.NeedsChanges)
                {
                    @* A review with known gaps is a completed review decision, not a failure. *@
                    <SecondaryButton Class="rw-needs-changes-button" Disabled="busy" OnClick="() => RejectStepAsync(step)">@(busy ? "Saving..." : "Reviewed with gaps")</SecondaryButton>
                }
                @if (step.RequiresApproval && review.State != ArtifactReviewState.Approved)
                {
                    @* Only a step whose policy asks for approval offers it. *@
                    <SecondaryButton Class="rw-approve-button" Disabled="busy" OnClick="() => ApproveStepAsync(step)">@(busy ? "Saving..." : "Approve")</SecondaryButton>
                }
            </div>
        </details>
    };

    public void Dispose()
    {
        WorkflowReadiness.ReadinessChanged -= OnReadinessChanged;
    }

    private async Task SaveWorkspaceAsync()
    {
        if (_isSaving) return;
        _isSaving = true;

        try
        {
            var result = await WorkspacePersistence.SaveCurrentAsync();
            if (result != null)
            {
                CurrentWorkspace.Invalidate();
                await RefreshReadinessAsync();
                StateHasChanged();
                await CloseWorkspaceMenuAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving workspace");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SaveAsWorkspaceAsync()
    {
        var name = await GetWorkspaceNameFromUserAsync();
        if (string.IsNullOrWhiteSpace(name)) return;

        _isSaving = true;
        try
        {
            var result = await WorkspacePersistence.SaveAsAsync(name);
            if (result != null)
            {
                CurrentWorkspace.Invalidate();
                await RefreshReadinessAsync();
                StateHasChanged();
                await CloseWorkspaceMenuAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving workspace as {Name}", name);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ShowManageWorkspacesAsync()
    {
        _showWorkspaceManager = true;
        StateHasChanged();
        await CloseWorkspaceMenuAsync();
    }

    private async Task OnWorkspaceManagerCloseAsync()
    {
        _showWorkspaceManager = false;
        CurrentWorkspace.Invalidate();
        await RefreshReadinessAsync();
        StateHasChanged();
    }

    private async Task ClearWorkspaceAsync()
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Clear current workspace? You can resume it later from Manage Workspaces.");
        if (!confirmed) return;

        try
        {
            await WorkspaceRestore.ClearWorkspaceAsync();
            await RefreshReadinessAsync();
            StateHasChanged();
            await CloseWorkspaceMenuAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error clearing workspace");
        }
    }

    private async Task CloseWorkspaceMenuAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("closeDetailsElement", _workspaceMenuRef);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Error closing workspace menu");
        }
    }

    private async Task MarkReviewedAsync(WorkflowStepViewModel step)
    {
        if (_approvingStepId != null) return;
        _approvingStepId = step.Key;
        _approvalErrorMessage = null;

        try
        {
            await WorkflowApi.MarkStepReviewedAsync(GetWorkspaceId(), step.Key, Revisions());
            await RefreshReadinessAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error marking step {StepKey} as reviewed", step.Key);
            _approvalErrorMessage = $"Failed to mark reviewed: {ex.Message}";
        }
        finally
        {
            _approvingStepId = null;
            StateHasChanged();
        }
    }

    private async Task ApproveStepAsync(WorkflowStepViewModel step)
    {
        if (_approvingStepId != null) return;
        _approvingStepId = step.Key;
        _approvalErrorMessage = null;

        try
        {
            await WorkflowApi.ApproveStepAsync(GetWorkspaceId(), step.Key, Revisions());
            await RefreshReadinessAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error approving step {StepKey}", step.Key);
            _approvalErrorMessage = $"Failed to approve: {ex.Message}";
        }
        finally
        {
            _approvingStepId = null;
            StateHasChanged();
        }
    }

    private async Task RejectStepAsync(WorkflowStepViewModel step)
    {
        if (_approvingStepId != null) return;
        _approvingStepId = step.Key;
        _approvalErrorMessage = null;

        try
        {
            await WorkflowApi.RejectStepAsync(GetWorkspaceId(), step.Key, Revisions());
            await RefreshReadinessAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error rejecting step {StepKey}", step.Key);
            _approvalErrorMessage = $"Failed to reject: {ex.Message}";
        }
        finally
        {
            _approvingStepId = null;
            StateHasChanged();
        }
    }

    private Guid GetWorkspaceId() => _readiness?.WorkspaceId ?? Guid.Empty;

    /// <summary>The artifact revisions this page shows: a decision is recorded against exactly these.</summary>
    private IReadOnlyList<ArtifactRevisionRef> Revisions() => _readiness?.Workspace.ArtifactRevisions ?? [];

    private async Task<string?> GetWorkspaceNameFromUserAsync()
    {
        var name = await JSRuntime.InvokeAsync<string>("prompt", "Enter workspace name:");
        return string.IsNullOrWhiteSpace(name) ? null : name;
    }
}
