    /// <summary>Artifact Pack → Source: a first-class fact, not small print.</summary>
    private RenderFragment SourceBindingCard() => __builder =>
    {
        var binding = _readiness!.SourceBinding;
        <div class="rw-binding-card" data-testid="rw-binding-card" data-state="@binding">
            <p class="rw-binding-title"><strong>Artifact Pack → Source</strong></p>
            <dl class="rw-binding-facts">
                <div><dt>Artifact Pack</dt><dd>@(Workspace?.PackLabel ?? Workspace?.ModuleLabel ?? "—")</dd></div>
                <div><dt>Source</dt><dd>@_readiness.Inputs.Source.StatusLabel</dd></div>
                <div><dt>Binding</dt><dd data-testid="rw-binding-state">@(binding switch { SourceBindingState.Established => "Established", SourceBindingState.NotEstablished => "Not established", _ => "No source snapshot" })</dd></div>
            </dl>
            @if (binding == SourceBindingState.NotEstablished)
