@page "/getting-started"
@using BirkNext.Web.Components
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using Microsoft.AspNetCore.Components.Rendering
@implements IDisposable
@inject IWorkflowReadinessService WorkflowReadiness
@inject ICurrentWorkspaceProjection CurrentWorkspace
@inject IWorkspacePersistenceApiService WorkspacePersistence
@inject IWorkspaceSessionRestoreService WorkspaceRestore
@inject IWorkspaceAutoSaveService AutoSave
@inject IRecommendedWorkflowApiService WorkflowApi
@inject ILogger<RecommendedWorkflow> Logger
@inject IJSRuntime JSRuntime

<PageTitle>Recommended Workflow - QA Review Studio</PageTitle>

<div class="rw-page">

    <PageHeader Title="Recommended Workflow"
                Description="A live workspace-aware guide that recommends the next action from the current workflow readiness state." />

    @if (_readiness is null)
    {
        <p class="loading-state" role="status">Loading workspace…</p>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_approvalErrorMessage))
        {
            <div class="rw-error-alert" role="alert">
                <span class="rw-error-icon">!</span>
                <span class="rw-error-message">@_approvalErrorMessage</span>
                <button class="rw-error-close" @onclick="@(() => _approvalErrorMessage = null)">&times;</button>
            </div>
        }

        @if (_readiness.WorkspaceError)
        {
            <div class="rw-error-alert" role="alert" data-testid="rw-workspace-error">
                <span class="rw-error-icon">!</span>
                <span class="rw-error-message">Unable to load workspace @_readiness.ProjectName. @_readiness.Workspace.Error</span>
            </div>
        }

        <section class="rw-inputs" aria-labelledby="rw-inputs-heading" data-testid="rw-inputs">
            <div class="rw-inputs-header">
                <h2 id="rw-inputs-heading" class="rw-inputs-title">Project inputs</h2>
                <p class="rw-inputs-lead">Documents, source and a target environment each unlock different reviews. Start with any of them; none is required for every project.</p>
            </div>
            <div class="rw-input-grid" role="status" aria-live="polite">
                @foreach (var input in _readiness.Inputs.All)
                {
                    <article class="rw-input rw-input-@input.Kind.ToString().ToLowerInvariant() is-@input.Status.ToString().ToLowerInvariant()"
                             data-testid="rw-input" data-kind="@input.Kind" data-status="@input.Status" aria-labelledby="rw-input-@input.Kind-title">
                        <div class="rw-input-head">
                            <h3 class="rw-input-title" id="rw-input-@input.Kind-title">@input.Title</h3>
                            <span class="rw-input-requirement">@input.Requirement</span>
                        </div>
                        <p class="rw-input-status" data-testid="rw-input-status"><span class="rw-input-status-icon" aria-hidden="true">@InputIcon(input)</span>@input.StatusLabel</p>
                        <p class="rw-input-detail">@input.Detail</p>
                        @if (input.Kind == ProjectInputKind.Documents && _readiness.Workspace.WorkspaceLoaded)
                        {
                            <ul class="rw-input-facts" aria-label="Artifact roles">
                                @foreach (var role in _readiness.Workspace.Roles)
                                {
                                    <li class="rw-artifact-badge @(role.IsAvailable ? "is-detected" : "is-missing")" data-testid="rw-role-badge" data-role="@role.Role" data-availability="@role.Availability"
                                        title="@RoleTitle(role)"><span class="rw-badge-icon" aria-hidden="true">@RoleIcon(role)</span>@role.Label<span class="visually-hidden">: @(role.Availability switch { ArtifactRoleAvailability.Available => "available", ArtifactRoleAvailability.Unknown => "unknown", _ => "missing" })</span></li>
                                }
                            </ul>
                        }
                        else if (input.Facts.Count > 0)
                        {
                            <ul class="rw-input-facts">
                                @foreach (var fact in input.Facts) { <li class="rw-input-fact">@fact</li> }
                            </ul>
                        }
                        <a href="@input.Route" class="rw-input-action" data-testid="rw-input-action">@input.ActionLabel →</a>
                    </article>
                }
            </div>
        </section>

        <div class="rw-layout">
            <main class="rw-main" aria-label="Recommended workflow">
        @if (_readiness.NextRecommendedAction is not null)
        {
            <div class="rw-next-action" data-testid="rw-next-action">
                <div class="rw-next-action-header">
                    <span class="rw-next-action-icon">▶</span>
                    <div>
                        <div class="rw-next-action-label">Current Recommendation</div>
                        <div class="rw-next-action-title">@_readiness.NextRecommendedAction.Title</div>
                    </div>
                </div>
                <div class="rw-next-action-label">Why this is the next step</div>
                <p class="rw-next-action-desc">@_readiness.NextRecommendedAction.Description</p>
                @if (_readiness.RecommendationIsListedStep)
                {
                    <p class="rw-next-action-step" data-testid="rw-next-action-step">Step @_readiness.NextRecommendedAction.Number below.</p>
                }
                else
                {
                    <div class="rw-next-action-buttons">
                        @RenderQuickAction(_readiness.NextRecommendedAction)
                        @foreach (var alternative in _readiness.AlternativeActions)
                        {
                            <a href="@alternative.Route" class="rw-next-action-alt" data-testid="rw-alternative-action">@alternative.ActionLabel</a>
                        }
                    </div>
                }
            </div>
        }
        else if (_readiness.WorkspaceLoaded || _readiness.Inputs.AnyProvided)
        {
            <p class="rw-no-next-action" data-testid="rw-no-next-action">No open recommendation: the document review steps are approved and no further review applies to the current inputs.</p>
        }

        @if (_readiness.Steps.Count > 0)
        {
            <h2 class="rw-section-heading">Workflow steps</h2>
        }

        <div class="rw-phases">
            @foreach (var step in _readiness.Steps)
            {
                <div class="rw-phase @GetStepCardClass(step) @(step.IsCurrent ? "is-current" : "") @(step.Status == WorkflowStepStatus.NeedsAttention ? "is-invalidated" : "")" style="--rw-phase-color: @GetStepColor(step);"
                     data-testid="rw-step" data-step="@step.Key" data-state="@GetStepStateLabel(step)" aria-current="@(step.IsCurrent ? "step" : null)">
                    <div class="rw-phase-header">
                        <div class="rw-phase-num">
                            @if (step.Status == WorkflowStepStatus.NeedsAttention)
                            {
                                <span class="rw-phase-num-warning">!</span>
                            }
                            else
                            {
                                @(step.Status == WorkflowStepStatus.Approved ? "✓" : step.Status == WorkflowStepStatus.Locked ? "🔒" : step.Number.ToString())
                            }
                        </div>
                        <div class="rw-phase-titles">
                            <div class="rw-phase-label">Step @step.Number</div>
                            <div class="rw-phase-name">@step.Title</div>
                        </div>
                        <span class="badge rw-step-badge @GetStepBadgeClass(step)" data-testid="rw-step-state">@GetStepStateLabel(step)</span>
                    </div>
                    @if (step.Status == WorkflowStepStatus.NeedsAttention)
                    {
                        <div class="rw-invalidation-alert">
                            <span class="rw-invalidation-icon">!</span>
                            <div class="rw-invalidation-content">
                                <div class="rw-invalidation-title">Approval Invalidated</div>
                                <div class="rw-invalidation-reason">An artifact changed since this step was approved. Please review and re-approve.</div>
                            </div>
                        </div>
                    }
                    <div class="rw-phase-body">
                        <p class="rw-goal">@step.Description</p>
                        <div class="rw-phase-footer">
                            @RenderAction(step)
                        </div>
                    </div>
                </div>

                @if (step.Number < _readiness.Steps.Count)
                {
                    <div class="rw-phase-connector" aria-hidden="true">↓</div>
                }
            }
        </div>

        @if (_readiness.ApplicableReviews.Count > 0)
        {
            <section class="rw-reviews" aria-labelledby="rw-reviews-heading" data-testid="rw-applicable-reviews">
                <h2 id="rw-reviews-heading" class="rw-section-heading">Applicable reviews</h2>
                <p class="rw-reviews-lead">Reviews the current inputs make applicable, grouped as in the sidebar. Applicability is not a result: open a review to run it.</p>
                @foreach (var lane in _readiness.ApplicableReviews.GroupBy(r => r.Lane))
                {
                    <div class="rw-review-lane">
                        <h3 class="rw-review-lane-title">@lane.Key</h3>
                        <ul class="rw-review-list">
                            @foreach (var review in lane)
                            {
                                <li data-testid="rw-applicable-review" data-review="@review.ReviewId">
                                    <a href="@review.Route">@review.Label</a>
                                    @if (review.Status == BirkNext.Applicability.ApplicabilityStatus.PartiallyApplicable) { <span class="rw-review-partial">Partial</span> }
                                </li>
                            }
                        </ul>
                    </div>
                }
            </section>
        }

        @if (_readiness.CanRelease)
        {
            <div class="rw-release">
                <span class="rw-release-icon" aria-hidden="true">✓</span>
                <div class="rw-release-content">
                    <div class="rw-release-label">Release</div>
                    <p class="rw-release-desc">@_readiness.ReleaseReason</p>
                </div>
            </div>
        }

            </main>

            <aside class="rw-sidebar" aria-label="Workspace review dashboard">
                <div class="rw-sidebar-inner">
                    <div class="rw-workspace-actions">
                        <div class="rw-workspace-header">
                            <h2 class="rw-workspace-actions-header">Current workspace</h2>
                            <details class="rw-workspace-menu" @ref="_workspaceMenuRef">
                                <summary class="btn-secondary rw-workspace-menu-trigger">Workspace</summary>
                                <div class="rw-workspace-menu-list">
                                    <button type="button" @onclick="SaveWorkspaceAsync" disabled="@(_isSaving || !_readiness.WorkspaceLoaded)">
                                        @(_isSaving ? "Saving..." : "Save")
                                    </button>
                                    <button type="button" @onclick="SaveAsWorkspaceAsync" disabled="@(_isSaving || !_readiness.WorkspaceLoaded)">Save As</button>
                                    <button type="button" @onclick="@(() => ShowManageWorkspacesAsync())" disabled="@_isSaving">Manage Workspaces</button>
                                    <button type="button" class="is-danger" @onclick="ClearWorkspaceAsync" disabled="@(_isSaving || !_readiness.WorkspaceLoaded)">Clear Workspace</button>
                                </div>
                            </details>
                        </div>

                        <dl class="rw-workspace-details">
                            <div class="rw-detail-item">
                                <dt class="rw-detail-label">Workspace</dt>
                                <dd class="rw-detail-value" data-testid="rw-workspace-name" title="@_readiness.WorkspaceName">@_readiness.WorkspaceName</dd>
                            </div>
                            <div class="rw-detail-item">
                                <dt class="rw-detail-label">Project</dt>
                                <dd class="rw-detail-value" data-testid="rw-project" title="@ProjectValue">@ProjectValue</dd>
                            </div>
                            <div class="rw-detail-item">
                                <dt class="rw-detail-label">Artifact roles</dt>
                                <dd class="rw-detail-value" data-testid="rw-artifact-roles">@ArtifactRolesValue</dd>
                            </div>
                            <div class="rw-detail-item">
                                <dt class="rw-detail-label">Saved</dt>
                                <dd class="rw-detail-value" data-testid="rw-saved"><span class="@SaveStatusClass" data-testid="rw-save-status">@_readiness.Workspace.SaveStatusLabel</span>@(_readiness.Workspace.LastSavedAt is null ? "" : $" · {_readiness.LastSavedText}")</dd>
                            </div>
                        </dl>

                        @if (_readiness.Workspace.State == CurrentWorkspaceState.NoWorkspace)
                        {
                            <div class="rw-no-workspace" data-testid="rw-no-workspace">
                                <SecondaryButton OnClick="ShowManageWorkspacesAsync">Resume a saved workspace</SecondaryButton>
                            </div>
                        }
                    </div>

                    <div class="rw-summary metric-strip" role="status" aria-live="polite">
                        <MetricCard Value="@ManualApprovalValue" Label="Manual Review" Sublabel="@ManualApprovalSublabel" Variant="@ManualApprovalVariant" />
                        <div class="rw-metric" data-testid="rw-release-readiness-card">
                            <MetricCard Value="@ReleaseReadinessValue" Label="Release Readiness" Sublabel="@ReleaseReadinessSublabel" Variant="@ReleaseReadinessVariant" />
                        </div>
                    </div>
                </div>
            </aside>
        </div>

        <div class="rw-footer-note">
            For detailed reference documentation on any feature, see the <a href="user-guide" class="rw-inline-link">User Guide</a>.
        </div>
    }

</div>

@if (_showWorkspaceManager)
{
    <WorkspaceManager OnClose="OnWorkspaceManagerCloseAsync" />
}

@code {
    private WorkflowReadiness? _readiness;
    private bool _isSaving;
    private bool _showWorkspaceManager;
    private string? _approvingStepId;
    private string? _approvalErrorMessage;
    private ElementReference _workspaceMenuRef;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            WorkflowReadiness.ReadinessChanged += OnReadinessChanged;
            await AutoSave.StartMonitoringAsync();
            await RefreshReadinessAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing RecommendedWorkflow page");
            _approvalErrorMessage = $"Failed to load workflow: {ex.Message}";
        }
    }

    // Auto-save listens to artifact and project changes itself; a readiness change (including a save) never schedules one.
    private async void OnReadinessChanged()
    {
        await InvokeAsync(async () =>
        {
            await RefreshReadinessAsync();
            StateHasChanged();
        });
    }

    private async Task RefreshReadinessAsync()
    {
        _readiness = await WorkflowReadiness.GetReadinessAsync();
    }

    private IReadOnlyList<WorkflowStepViewModel> ManualReviewSteps =>
        _readiness?.Steps.Where(IsManualReviewStep).ToList() ?? [];

    private int ManualApprovedCount =>
        ManualReviewSteps.Count(step => step.ApprovalState == ApprovalState.Approved);

    private string ManualApprovalValue => ManualReviewSteps.Count == 0 ? "Not required" : $"{ManualApprovedCount} / {ManualReviewSteps.Count}";

    private string ManualApprovalSublabel => ManualReviewSteps.Count == 0 ? "No document review steps" : "Approved, incl. optional";

    /// <summary>Neutral until complete: pending approvals are not a warning, and the text carries the state.</summary>
    private string? ManualApprovalVariant =>
        ManualReviewSteps.Count > 0 && ManualApprovedCount == ManualReviewSteps.Count ? "success" : null;

    private CurrentWorkspaceSnapshot? Workspace => _readiness?.Workspace;

    private string ProjectValue => Workspace switch
    {
        { State: CurrentWorkspaceState.NoWorkspace } or null => "No project loaded",
        var ws => ws.ProjectDisplay,
    };

    private string ArtifactRolesValue => Workspace switch
    {
        { WorkspaceLoaded: true, AvailableRoleCount: > 0 } ws => ws.RoleSummary,
        { WorkspaceLoaded: true } => "None available",
        _ => "Not provided",
    };

    private static string InputIcon(ProjectInput input) => input.Status switch
    {
        ProjectInputStatus.Ready => "✓",
        ProjectInputStatus.Partial or ProjectInputStatus.NeedsAttention => "!",
        ProjectInputStatus.Unknown => "?",
        _ => "○",
    };

    /// <summary>Sidebar line for an input: its status plus the most telling fact (archive, environment and host).</summary>
    private static string InputSummary(ProjectInput input) =>
        input.Facts.Count == 0 ? input.StatusLabel : $"{input.StatusLabel} · {string.Join(" · ", input.Facts.Take(2))}";

    /// <summary>Not assessed (nothing reviewed yet, or nothing to review) is shown as a dash, never as 0%.</summary>
    private string ReleaseReadinessValue =>
        _readiness?.ReleaseReadinessPercent is { } percent ? $"{percent}%" : "—";

    private string ReleaseReadinessSublabel =>
        _readiness?.CanRelease == true ? "Release recommended"
        : _readiness is not { WorkspaceLoaded: true } ? "Not assessed"
        : _readiness.RequiredReviewCount == 0 ? "No required reviews"
        : _readiness.ReleaseReadinessPercent is null ? $"Not assessed · 0 of {_readiness.RequiredReviewCount} required approved"
        : $"{_readiness.ApprovedReviewCount} of {_readiness.RequiredReviewCount} required approved";

    private string SaveStatusClass => Workspace?.SaveStatus switch
    {
        "Saved" => "status-saved",
        "AutoSaved" => "status-auto-saved",
        "UnsavedChanges" => "status-unsaved",
        _ => "status-not-saved"
    };

    private static string RoleIcon(ArtifactRoleStatus role) => role.Availability switch
    {
        ArtifactRoleAvailability.Available => "✓",
        ArtifactRoleAvailability.Unknown => "?",
        _ => "○",
    };

    private static string RoleTitle(ArtifactRoleStatus role) => role.Availability switch
    {
        ArtifactRoleAvailability.Unknown => $"{role.Label}: availability unknown",
        ArtifactRoleAvailability.Missing => $"{role.Label}: missing",
        _ => $"{role.Label}: {role.ArtifactCount} artifact{(role.ArtifactCount == 1 ? "" : "s")}"
             + (role.Selection == ArtifactRoleSelection.SelectionRequired ? ", selection required" : ""),
    };

    private string? ReleaseReadinessVariant =>
        _readiness?.CanRelease == true ? "success" : null;

    private static bool IsManualReviewStep(WorkflowStepViewModel step) =>
        !IsLoadWorkspaceStep(step) && (step.RequiresManualReview || step.RequiresApproval);

    private static bool IsLoadWorkspaceStep(WorkflowStepViewModel step) =>
        step.Key.Equals("LoadSampleProject", StringComparison.OrdinalIgnoreCase)
        || step.Key.Equals(WorkflowReadinessService.LoadWorkspaceKey, StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// The step's state in words. Step 1 (artifact loading) is "Action required" or "Done" — never a review state. Review steps are
    /// Ready, In review (opened), Pending approval (marked reviewed by a person), Approved, Needs changes or Locked.
    /// </summary>
    private string GetStepStateLabel(WorkflowStepViewModel step)
    {
        if (IsLoadWorkspaceStep(step))
            return _readiness?.ArtifactLoad == ArtifactLoadState.Done ? "Done" : "Action required";

        if (step.ApprovalState == ApprovalState.NeedsChanges ||
            step.ApprovalState == ApprovalState.InvalidatedByArtifactChange ||
            step.Status == WorkflowStepStatus.NeedsAttention)
        {
            return "Needs changes";
        }

        return step.Status switch
        {
            WorkflowStepStatus.Locked => "Locked",
            WorkflowStepStatus.InProgress => "In review",
            WorkflowStepStatus.Reviewed when step.RequiresApproval => "Pending approval",
            WorkflowStepStatus.Reviewed => "Reviewed",
            WorkflowStepStatus.Approved => "Approved",
            _ => "Ready"
        };
    }

    private string GetStepBadgeClass(WorkflowStepViewModel step) => GetStepStateLabel(step) switch
    {
        "Approved" or "Done" => "rw-badge-approved",
        "Needs changes" => "rw-badge-needs-changes",
        "Action required" => "rw-badge-action",
        "In review" => "rw-badge-in-review",
        "Pending approval" or "Reviewed" => "rw-badge-pending",
        "Locked" => "rw-badge-locked",
        _ => "rw-badge-available"
    };

    private string GetStepCardClass(WorkflowStepViewModel step) => GetStepStateLabel(step) switch
    {
        "Approved" or "Done" => "is-approved",
        "Needs changes" => "is-attention",
        "Pending approval" or "Reviewed" => "is-reviewed",
        "Locked" => "is-locked-step",
        _ => ""
    };

    private string GetStepColor(WorkflowStepViewModel step) =>
        GetStepStateLabel(step) is "Approved" or "Done" ? "#15803d" : step.Color;

    private RenderFragment RenderQuickAction(WorkflowStepViewModel step) => builder =>
    {
        if (!step.CanOpen)
        {
            return;
        }

        builder.OpenElement(0, "a");
        builder.AddAttribute(1, "href", step.Route);
        builder.AddAttribute(2, "class", "rw-next-action-btn");
        builder.AddContent(3, $"{step.ActionLabel} ->");
        builder.CloseElement();
    };

    private RenderFragment RenderAction(WorkflowStepViewModel step) => __builder =>
    {
        if (IsLoadWorkspaceStep(step))
        {
            if (_readiness?.ArtifactLoad == ArtifactLoadState.Done) return;
            <div class="rw-step-actions">
                <a href="@step.Route" class="rw-cta" data-testid="rw-load-artifacts">@step.ActionLabel</a>
                @foreach (var alternative in _readiness?.AlternativeActions ?? [])
                {
                    <a href="@alternative.Route" class="rw-step-link" data-testid="rw-alternative-action">@alternative.ActionLabel</a>
                }
            </div>
            return;
        }

        if (step.Status == WorkflowStepStatus.Locked)
        {
            // A locked step says why, as text; it offers no review or approval controls.
            <p class="rw-step-locked-reason" data-testid="rw-step-locked-reason">@(string.IsNullOrWhiteSpace(step.DisabledReason) ? "Complete the previous step first" : step.DisabledReason)</p>
            return;
        }

        if (step.CanOpen)
        {
            <a href="@step.Route" class="@(step.IsCurrent ? "rw-cta" : "rw-cta rw-cta-secondary")">@step.ActionLabel →</a>
        }

        if (step.RequiresManualReview || step.RequiresApproval)
        {
            RenderApprovalButtons(__builder, step);
        }
    };

    private void RenderApprovalButtons(RenderTreeBuilder builder, WorkflowStepViewModel step)
    {
        builder.OpenElement(100, "div");
        builder.AddAttribute(101, "class", "rw-approval-buttons");

        if (step.RequiresManualReview && step.ReviewState != ReviewState.Reviewed)
        {
            builder.OpenComponent<SecondaryButton>(102);
            builder.AddAttribute(103, "Class", "rw-review-button");
            builder.AddAttribute(104, "Disabled", _approvingStepId == step.Key);
            builder.AddAttribute(105, "OnClick", EventCallback.Factory.Create(this, () => MarkReviewedAsync(step)));
            builder.AddAttribute(106, "ChildContent", (RenderFragment)(childBuilder =>
            {
                childBuilder.AddContent(107, _approvingStepId == step.Key ? "Marking..." : "Mark Reviewed");
            }));
            builder.CloseComponent();
        }

        if (step.RequiresApproval && step.ApprovalState != ApprovalState.Approved)
        {
            builder.OpenComponent<PrimaryButton>(108);
            builder.AddAttribute(109, "Class", "rw-approve-button");
            builder.AddAttribute(110, "Disabled", _approvingStepId == step.Key);
            builder.AddAttribute(111, "OnClick", EventCallback.Factory.Create(this, () => ApproveStepAsync(step)));
            builder.AddAttribute(112, "ChildContent", (RenderFragment)(childBuilder =>
            {
                childBuilder.AddContent(113, _approvingStepId == step.Key ? "Approving..." : "Approve");
            }));
            builder.CloseComponent();
        }

        if (step.ApprovalState == ApprovalState.Approved || step.ApprovalState == ApprovalState.Pending)
        {
            builder.OpenComponent<DangerButton>(114);
            builder.AddAttribute(115, "Class", "rw-needs-changes-button");
            builder.AddAttribute(116, "Disabled", _approvingStepId == step.Key);
            builder.AddAttribute(117, "OnClick", EventCallback.Factory.Create(this, () => RejectStepAsync(step)));
            builder.AddAttribute(118, "ChildContent", (RenderFragment)(childBuilder =>
            {
                childBuilder.AddContent(119, _approvingStepId == step.Key ? "Rejecting..." : "Needs Changes");
            }));
            builder.CloseComponent();
        }

        builder.CloseElement();
    }

    public void Dispose()
    {
        WorkflowReadiness.ReadinessChanged -= OnReadinessChanged;
    }

    private async Task SaveWorkspaceAsync()
    {
        if (_isSaving) return;
        _isSaving = true;

        try
        {
            var result = await WorkspacePersistence.SaveCurrentAsync();
            if (result != null)
            {
                CurrentWorkspace.Invalidate();
                await RefreshReadinessAsync();
                StateHasChanged();
                await CloseWorkspaceMenuAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving workspace");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SaveAsWorkspaceAsync()
    {
        var name = await GetWorkspaceNameFromUserAsync();
        if (string.IsNullOrWhiteSpace(name)) return;

        _isSaving = true;
        try
        {
            var result = await WorkspacePersistence.SaveAsAsync(name);
            if (result != null)
            {
                CurrentWorkspace.Invalidate();
                await RefreshReadinessAsync();
                StateHasChanged();
                await CloseWorkspaceMenuAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving workspace as {Name}", name);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ShowManageWorkspacesAsync()
    {
        _showWorkspaceManager = true;
        StateHasChanged();
        await CloseWorkspaceMenuAsync();
    }

    private async Task OnWorkspaceManagerCloseAsync()
    {
        _showWorkspaceManager = false;
        CurrentWorkspace.Invalidate();
        await RefreshReadinessAsync();
        StateHasChanged();
    }

    private async Task ClearWorkspaceAsync()
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Clear current workspace? You can resume it later from Manage Workspaces.");
        if (!confirmed) return;

        try
        {
            await WorkspaceRestore.ClearWorkspaceAsync();
            await RefreshReadinessAsync();
            StateHasChanged();
            await CloseWorkspaceMenuAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error clearing workspace");
        }
    }

    private async Task CloseWorkspaceMenuAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("closeDetailsElement", _workspaceMenuRef);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Error closing workspace menu");
        }
    }

    private async Task MarkReviewedAsync(WorkflowStepViewModel step)
    {
        if (_approvingStepId != null) return;
        _approvingStepId = step.Key;
        _approvalErrorMessage = null;

        try
        {
            await WorkflowApi.MarkStepReviewedAsync(GetWorkspaceId(), step.Key);
            await RefreshReadinessAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error marking step {StepKey} as reviewed", step.Key);
            _approvalErrorMessage = $"Failed to mark reviewed: {ex.Message}";
        }
        finally
        {
            _approvingStepId = null;
            StateHasChanged();
        }
    }

    private async Task ApproveStepAsync(WorkflowStepViewModel step)
    {
        if (_approvingStepId != null) return;
        _approvingStepId = step.Key;
        _approvalErrorMessage = null;

        try
        {
            await WorkflowApi.ApproveStepAsync(GetWorkspaceId(), step.Key);
            await RefreshReadinessAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error approving step {StepKey}", step.Key);
            _approvalErrorMessage = $"Failed to approve: {ex.Message}";
        }
        finally
        {
            _approvingStepId = null;
            StateHasChanged();
        }
    }

    private async Task RejectStepAsync(WorkflowStepViewModel step)
    {
        if (_approvingStepId != null) return;
        _approvingStepId = step.Key;
        _approvalErrorMessage = null;

        try
        {
            await WorkflowApi.RejectStepAsync(GetWorkspaceId(), step.Key);
            await RefreshReadinessAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error rejecting step {StepKey}", step.Key);
            _approvalErrorMessage = $"Failed to reject: {ex.Message}";
        }
        finally
        {
            _approvingStepId = null;
            StateHasChanged();
        }
    }

    private Guid GetWorkspaceId() => _readiness?.WorkspaceId ?? Guid.Empty;

    private async Task<string?> GetWorkspaceNameFromUserAsync()
    {
        var name = await JSRuntime.InvokeAsync<string>("prompt", "Enter workspace name:");
        return string.IsNullOrWhiteSpace(name) ? null : name;
    }
}
