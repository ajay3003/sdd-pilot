    /// <summary>Capabilities as a compact list: name, status (Available / Needs setup / Reviewed …) and requiredness, each as text.</summary>
    private RenderFragment CapabilityList(IReadOnlyList<ReviewCapability> items) => __builder =>
    {
        if (items.Count == 0) return;
        <ul class="rw-cap-list">
            @foreach (var c in items)
            {
                <li class="rw-cap is-@c.Readiness.ToString().ToLowerInvariant()" data-testid="rw-capability" data-review="@c.Id" data-readiness="@c.Readiness" data-applicability="@c.Applicability" data-requiredness="@c.Requiredness">
                    @if (c.Applicability == ReviewApplicabilityState.NotApplicable) { <span class="rw-cap-name">@c.DisplayName</span> }
                    else { <a class="rw-cap-name" href="@c.Route">@c.DisplayName</a> }
                    <span class="rw-cap-status" data-testid="rw-capability-status">@c.StatusLabel</span>
                    <span class="rw-cap-required">@c.RequirednessLabel</span>
                    @if (!string.IsNullOrWhiteSpace(c.Reason)) { <span class="rw-cap-reason">@c.Reason</span> }
                </li>
            }
        </ul>
