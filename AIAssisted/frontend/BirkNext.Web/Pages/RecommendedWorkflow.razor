@page "/getting-started"
@using BirkNext.Web.Components
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using Microsoft.AspNetCore.Components.Rendering
@implements IDisposable
@inject IWorkflowReadinessService WorkflowReadiness
@inject IWorkspacePersistenceApiService WorkspacePersistence
@inject IWorkspaceSessionRestoreService WorkspaceRestore
@inject IWorkspaceAutoSaveService AutoSave
@inject IRecommendedWorkflowApiService WorkflowApi
@inject ILogger<RecommendedWorkflow> Logger
@inject IJSRuntime JSRuntime

<PageTitle>Recommended Workflow - QA Review Studio</PageTitle>

<div class="rw-page">

    <PageHeader Title="Recommended Workflow"
                Description="A live workspace-aware guide that recommends the next action from the current workflow readiness state." />

    @if (_readiness is null)
    {
        <p class="loading-state">Loading workflow...</p>
    }
    else
    {
        <div class="rw-workspace-actions">
            <div class="rw-workspace-header">
                <div>
                    <div class="rw-workspace-actions-header">Current Workspace</div>
                    <div class="rw-workspace-title">@_readiness.WorkspaceName</div>
                </div>
                <details class="rw-workspace-menu">
                    <summary class="btn-secondary rw-workspace-menu-trigger">Workspace</summary>
                    <div class="rw-workspace-menu-list">
                        <button type="button" @onclick="SaveWorkspaceAsync" disabled="@(_isSaving || !_readiness.WorkspaceLoaded)">
                            @(_isSaving ? "Saving..." : "Save")
                        </button>
                        <button type="button" @onclick="SaveAsWorkspaceAsync" disabled="@(_isSaving || !_readiness.WorkspaceLoaded)">Save As</button>
                        <button type="button" @onclick="@(() => ShowManageWorkspacesAsync())" disabled="@_isSaving">Manage</button>
                        <button type="button" class="is-danger" @onclick="ClearWorkspaceAsync" disabled="@(_isSaving || !_readiness.WorkspaceLoaded)">Clear</button>
                    </div>
                </details>
            </div>

            @if (_readiness.WorkspaceLoaded)
            {
                <div class="rw-workspace-info">
                    <div class="rw-workspace-details">
                        <div class="rw-detail-item">
                            <span class="rw-detail-label">Workspace:</span>
                            <span class="rw-detail-value">@_readiness.WorkspaceName</span>
                        </div>
                        <div class="rw-detail-item">
                            <span class="rw-detail-label">Project:</span>
                            <span class="rw-detail-value">@_readiness.ProjectName</span>
                        </div>
                        <div class="rw-detail-item">
                            <span class="rw-detail-label">Artifacts:</span>
                            <span class="rw-detail-value">@_readiness.ArtifactStatus.ArtifactCount of 5</span>
                        </div>
                        <div class="rw-detail-item">
                            <span class="rw-detail-label">Status:</span>
                            <span class="rw-detail-value @_readiness.WorkspaceStatusClass">@_readiness.WorkspaceStatus</span>
                        </div>
                        <div class="rw-detail-item">
                            <span class="rw-detail-label">Last saved:</span>
                            <span class="rw-detail-value">@_readiness.LastSavedText</span>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="rw-no-workspace">
                    <p>No workspace loaded. Load a sample project or import artifacts to get started.</p>
                    <SecondaryButton OnClick="ShowManageWorkspacesAsync">Resume Workspace</SecondaryButton>
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(_approvalErrorMessage))
        {
            <div class="rw-error-alert" role="alert">
                <span class="rw-error-icon">!</span>
                <span class="rw-error-message">@_approvalErrorMessage</span>
                <button class="rw-error-close" @onclick="@(() => _approvalErrorMessage = null)">&times;</button>
            </div>
        }

        <div class="rw-summary metric-strip" role="status" aria-live="polite">
            <MetricCard Value="@AutomaticSetupValue" Label="Automatic Setup" Sublabel="@AutomaticSetupSublabel" Variant="@AutomaticSetupVariant" />
            <MetricCard Value="@ManualApprovalValue" Label="Manual Review" Sublabel="Approved" Variant="@ManualApprovalVariant" />
            <MetricCard Value="@($"{_readiness.OverallReadiness.OverallReadiness}%")" Label="Release Readiness" Sublabel="@ReleaseReadinessSublabel" Variant="@ReleaseReadinessVariant" />
        </div>

        <div class="rw-workspace-status" role="status" aria-live="polite">
            <div class="rw-status-header">
                <span class="rw-section-label">Automatic State</span>
                <span class="rw-artifact-count">Detection unlocks pages; it does not approve review work.</span>
            </div>
            <div class="rw-status-indicators">
                <span class="rw-artifact-badge @(_readiness.WorkspaceLoaded ? "is-detected" : "is-missing")">
                    <span class="rw-badge-icon">@(_readiness.WorkspaceLoaded ? "✓" : "-")</span>
                    Workspace
                </span>
                @foreach (var artifact in _readiness.Artifacts)
                {
                    <span class="rw-artifact-badge @(artifact.IsLoaded ? "is-detected" : "is-missing")">
                        <span class="rw-badge-icon">@(artifact.IsLoaded ? "✓" : "○")</span>
                        @artifact.Name
                    </span>
                }
            </div>
        </div>

        <div class="rw-manual-review-note">
            <div class="rw-section-label">Manual Review</div>
            <p>Constitution, plan, tasks, data model, specification, traceability, implementation review, and QA reviews require reviewer action before release readiness advances.</p>
        </div>

        @if (_readiness.NextRecommendedAction is not null)
        {
            <div class="rw-next-action">
                <div class="rw-next-action-header">
                    <span class="rw-next-action-icon">▶</span>
                    <div>
                        <div class="rw-next-action-label">Current Recommendation</div>
                        <div class="rw-next-action-title">@_readiness.NextRecommendedAction.Title</div>
                    </div>
                </div>
                <div class="rw-next-action-label">Why this is the next step</div>
                <p class="rw-next-action-desc">@_readiness.NextRecommendedAction.Description</p>
                @RenderQuickAction(_readiness.NextRecommendedAction)
            </div>
        }

        <div class="rw-phases">
            @foreach (var step in _readiness.Steps)
            {
                <div class="rw-phase @GetStepCardClass(step) @(step.IsCurrent ? "is-current" : "") @(step.IsFuture ? "is-disabled" : "") @(step.Status == WorkflowStepStatus.NeedsAttention ? "is-invalidated" : "")" style="--rw-phase-color: @GetStepColor(step);">
                    <div class="rw-phase-header">
                        <div class="rw-phase-num">
                            @if (step.Status == WorkflowStepStatus.NeedsAttention)
                            {
                                <span class="rw-phase-num-warning">!</span>
                            }
                            else
                            {
                                @(step.Status == WorkflowStepStatus.Approved ? "✓" : step.Number.ToString())
                            }
                        </div>
                        <div class="rw-phase-titles">
                            <div class="rw-phase-label">Step @step.Number</div>
                            <div class="rw-phase-name">@step.Title</div>
                        </div>
                        <span class="badge rw-step-badge @GetStepBadgeClass(step)">@GetStepStateLabel(step)</span>
                    </div>
                    @if (step.Status == WorkflowStepStatus.NeedsAttention)
                    {
                        <div class="rw-invalidation-alert">
                            <span class="rw-invalidation-icon">!</span>
                            <div class="rw-invalidation-content">
                                <div class="rw-invalidation-title">Approval Invalidated</div>
                                <div class="rw-invalidation-reason">An artifact changed since this step was approved. Please review and re-approve.</div>
                            </div>
                        </div>
                    }
                    <div class="rw-phase-body">
                        <p class="rw-goal">@step.Description</p>
                        <div class="rw-phase-footer">
                            @RenderAction(step, "rw-cta")
                        </div>
                    </div>
                </div>

                @if (step.Number < _readiness.Steps.Count)
                {
                    <div class="rw-phase-connector" aria-hidden="true">↓</div>
                }
            }
        </div>

        @if (_readiness.CanRelease)
        {
            <div class="rw-release">
                <span class="rw-release-icon" aria-hidden="true">✓</span>
                <div class="rw-release-content">
                    <div class="rw-release-label">Release</div>
                    <p class="rw-release-desc">@_readiness.ReleaseReason</p>
                </div>
            </div>
        }

        <div class="rw-footer-note">
            For detailed reference documentation on any feature, see the <a href="user-guide" class="rw-inline-link">User Guide</a>.
        </div>
    }

</div>

@if (_showWorkspaceManager)
{
    <WorkspaceManager OnClose="OnWorkspaceManagerCloseAsync" />
}

@code {
    private WorkflowReadiness? _readiness;
    private bool _isSaving;
    private bool _showWorkspaceManager;
    private string? _approvingStepId;
    private string? _approvalErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            WorkflowReadiness.ReadinessChanged += OnReadinessChanged;
            await AutoSave.StartMonitoringAsync();
            await RefreshReadinessAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing RecommendedWorkflow page");
            _approvalErrorMessage = $"Failed to load workflow: {ex.Message}";
        }
    }

    private async void OnReadinessChanged()
    {
        await InvokeAsync(async () =>
        {
            AutoSave.OnArtifactChanged();
            await RefreshReadinessAsync();
            StateHasChanged();
        });
    }

    private async Task RefreshReadinessAsync()
    {
        _readiness = await WorkflowReadiness.GetReadinessAsync();
    }

    private IReadOnlyList<WorkflowStepViewModel> ManualReviewSteps =>
        _readiness?.Steps.Where(IsManualReviewStep).ToList() ?? [];

    private int ManualApprovedCount =>
        ManualReviewSteps.Count(step => step.Status == WorkflowStepStatus.Approved);

    private string ManualApprovalValue => $"{ManualApprovedCount} / {ManualReviewSteps.Count}";

    private string ManualApprovalVariant =>
        ManualReviewSteps.Count > 0 && ManualApprovedCount == ManualReviewSteps.Count ? "success" : "warning";

    private string AutomaticSetupValue =>
        _readiness?.WorkspaceLoaded == true && _readiness.ArtifactStatus.ArtifactCount > 0 ? "Ready" : "Missing";

    private string AutomaticSetupSublabel =>
        _readiness?.WorkspaceLoaded == true
            ? $"Workspace, {_readiness.ArtifactStatus.ArtifactCount} / 5 artifacts"
            : "No workspace loaded";

    private string AutomaticSetupVariant =>
        _readiness?.WorkspaceLoaded == true && _readiness.ArtifactStatus.ArtifactCount > 0 ? "info" : "warning";

    private string ReleaseReadinessSublabel =>
        _readiness?.CanRelease == true ? "Release recommended" : "Manual approvals required";

    private string ReleaseReadinessVariant =>
        _readiness?.CanRelease == true ? "success" : "info";

    private static bool IsManualReviewStep(WorkflowStepViewModel step) =>
        !IsLoadWorkspaceStep(step) && (step.RequiresManualReview || step.RequiresApproval);

    private static bool IsLoadWorkspaceStep(WorkflowStepViewModel step) =>
        step.Key.Equals("LoadSampleProject", StringComparison.OrdinalIgnoreCase)
        || step.Key.Equals("LoadWorkspace", StringComparison.OrdinalIgnoreCase);

    private string GetStepStateLabel(WorkflowStepViewModel step)
    {
        if (IsLoadWorkspaceStep(step) && _readiness?.WorkspaceLoaded == true)
        {
            return "Reviewed";
        }

        if (step.ApprovalState == ApprovalState.NeedsChanges ||
            step.ApprovalState == ApprovalState.InvalidatedByArtifactChange ||
            step.Status == WorkflowStepStatus.NeedsAttention)
        {
            return "Needs Changes";
        }

        return step.Status switch
        {
            WorkflowStepStatus.Locked => "Locked",
            WorkflowStepStatus.Available => "Available",
            WorkflowStepStatus.InProgress => "In Review",
            WorkflowStepStatus.Reviewed when step.RequiresApproval => "Pending Approval",
            WorkflowStepStatus.Reviewed => "Reviewed",
            WorkflowStepStatus.Approved => "Approved",
            _ => "Available"
        };
    }

    private string GetStepBadgeClass(WorkflowStepViewModel step) => GetStepStateLabel(step) switch
    {
        "Approved" => "rw-badge-approved",
        "Needs Changes" => "rw-badge-needs-changes",
        "In Review" => "rw-badge-in-review",
        "Pending Approval" => "rw-badge-pending",
        "Reviewed" => "rw-badge-reviewed",
        "Locked" => "rw-badge-locked",
        _ => "rw-badge-available"
    };

    private string GetStepCardClass(WorkflowStepViewModel step) => GetStepStateLabel(step) switch
    {
        "Approved" => "is-approved",
        "Needs Changes" => "is-attention",
        "In Review" => "is-current",
        "Pending Approval" => "is-reviewed",
        "Reviewed" => "is-reviewed",
        "Locked" => "is-disabled",
        _ => ""
    };

    private string GetStepColor(WorkflowStepViewModel step) =>
        GetStepStateLabel(step) == "Approved" ? "#15803d" : step.Color;

    private RenderFragment RenderQuickAction(WorkflowStepViewModel step) => builder =>
    {
        if (!step.CanOpen)
        {
            return;
        }

        builder.OpenElement(0, "a");
        builder.AddAttribute(1, "href", step.Route);
        builder.AddAttribute(2, "class", "rw-next-action-btn");
        builder.AddContent(3, $"{step.ActionLabel} ->");
        builder.CloseElement();
    };

    private RenderFragment RenderAction(WorkflowStepViewModel step, string cssClass) => builder =>
    {
        if (IsLoadWorkspaceStep(step) && _readiness?.WorkspaceLoaded == true)
        {
            return;
        }

        if (step.CanOpen)
        {
            builder.OpenElement(0, "a");
            builder.AddAttribute(1, "href", step.Route);
            builder.AddAttribute(2, "class", cssClass);
            builder.AddContent(3, $"{step.ActionLabel} →");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(4, "button");
            builder.AddAttribute(5, "type", "button");
            builder.AddAttribute(6, "class", $"{cssClass} is-disabled");
            builder.AddAttribute(7, "disabled", true);
            builder.AddContent(8, step.DisabledReason);
            builder.CloseElement();
        }

        if (step.RequiresManualReview || step.RequiresApproval)
        {
            RenderApprovalButtons(builder, step);
        }
    };

    private void RenderApprovalButtons(RenderTreeBuilder builder, WorkflowStepViewModel step)
    {
        builder.OpenElement(100, "div");
        builder.AddAttribute(101, "class", "rw-approval-buttons");

        if (step.RequiresManualReview && step.ReviewState != ReviewState.Reviewed)
        {
            builder.OpenComponent<SecondaryButton>(102);
            builder.AddAttribute(103, "Class", "rw-review-button");
            builder.AddAttribute(104, "Disabled", _approvingStepId == step.Key);
            builder.AddAttribute(105, "OnClick", EventCallback.Factory.Create(this, () => MarkReviewedAsync(step)));
            builder.AddAttribute(106, "ChildContent", (RenderFragment)(childBuilder =>
            {
                childBuilder.AddContent(107, _approvingStepId == step.Key ? "Marking..." : "Mark Reviewed");
            }));
            builder.CloseComponent();
        }

        if (step.RequiresApproval && step.ApprovalState != ApprovalState.Approved)
        {
            builder.OpenComponent<PrimaryButton>(108);
            builder.AddAttribute(109, "Class", "rw-approve-button");
            builder.AddAttribute(110, "Disabled", _approvingStepId == step.Key);
            builder.AddAttribute(111, "OnClick", EventCallback.Factory.Create(this, () => ApproveStepAsync(step)));
            builder.AddAttribute(112, "ChildContent", (RenderFragment)(childBuilder =>
            {
                childBuilder.AddContent(113, _approvingStepId == step.Key ? "Approving..." : "Approve");
            }));
            builder.CloseComponent();
        }

        if (step.ApprovalState == ApprovalState.Approved || step.ApprovalState == ApprovalState.Pending)
        {
            builder.OpenComponent<DangerButton>(114);
            builder.AddAttribute(115, "Class", "rw-needs-changes-button");
            builder.AddAttribute(116, "Disabled", _approvingStepId == step.Key);
            builder.AddAttribute(117, "OnClick", EventCallback.Factory.Create(this, () => RejectStepAsync(step)));
            builder.AddAttribute(118, "ChildContent", (RenderFragment)(childBuilder =>
            {
                childBuilder.AddContent(119, _approvingStepId == step.Key ? "Rejecting..." : "Needs Changes");
            }));
            builder.CloseComponent();
        }

        builder.CloseElement();
    }

    public async void Dispose()
    {
        WorkflowReadiness.ReadinessChanged -= OnReadinessChanged;
        await AutoSave.StopMonitoringAsync();
    }

    private async Task SaveWorkspaceAsync()
    {
        if (_isSaving) return;
        _isSaving = true;

        try
        {
            var result = await WorkspacePersistence.SaveCurrentAsync();
            if (result != null)
            {
                await RefreshReadinessAsync();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving workspace");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SaveAsWorkspaceAsync()
    {
        var name = await GetWorkspaceNameFromUserAsync();
        if (string.IsNullOrWhiteSpace(name)) return;

        _isSaving = true;
        try
        {
            var result = await WorkspacePersistence.SaveAsAsync(name);
            if (result != null)
            {
                await RefreshReadinessAsync();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving workspace as {Name}", name);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private Task ShowManageWorkspacesAsync()
    {
        _showWorkspaceManager = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task OnWorkspaceManagerCloseAsync()
    {
        _showWorkspaceManager = false;
        await RefreshReadinessAsync();
        StateHasChanged();
    }

    private async Task ClearWorkspaceAsync()
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Clear current workspace? You can resume it later from Manage Workspaces.");
        if (!confirmed) return;

        try
        {
            await WorkspaceRestore.ClearWorkspaceAsync();
            await RefreshReadinessAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error clearing workspace");
        }
    }

    private async Task MarkReviewedAsync(WorkflowStepViewModel step)
    {
        if (_approvingStepId != null) return;
        _approvingStepId = step.Key;
        _approvalErrorMessage = null;

        try
        {
            await WorkflowApi.MarkStepReviewedAsync(GetWorkspaceId(), step.Key);
            await RefreshReadinessAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error marking step {StepKey} as reviewed", step.Key);
            _approvalErrorMessage = $"Failed to mark reviewed: {ex.Message}";
        }
        finally
        {
            _approvingStepId = null;
            StateHasChanged();
        }
    }

    private async Task ApproveStepAsync(WorkflowStepViewModel step)
    {
        if (_approvingStepId != null) return;
        _approvingStepId = step.Key;
        _approvalErrorMessage = null;

        try
        {
            await WorkflowApi.ApproveStepAsync(GetWorkspaceId(), step.Key);
            await RefreshReadinessAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error approving step {StepKey}", step.Key);
            _approvalErrorMessage = $"Failed to approve: {ex.Message}";
        }
        finally
        {
            _approvingStepId = null;
            StateHasChanged();
        }
    }

    private async Task RejectStepAsync(WorkflowStepViewModel step)
    {
        if (_approvingStepId != null) return;
        _approvingStepId = step.Key;
        _approvalErrorMessage = null;

        try
        {
            await WorkflowApi.RejectStepAsync(GetWorkspaceId(), step.Key);
            await RefreshReadinessAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error rejecting step {StepKey}", step.Key);
            _approvalErrorMessage = $"Failed to reject: {ex.Message}";
        }
        finally
        {
            _approvingStepId = null;
            StateHasChanged();
        }
    }

    private Guid GetWorkspaceId() => _readiness?.CurrentWorkspace?.WorkspaceId ?? Guid.Empty;

    private async Task<string?> GetWorkspaceNameFromUserAsync()
    {
        var name = await JSRuntime.InvokeAsync<string>("prompt", "Enter workspace name:");
        return string.IsNullOrWhiteSpace(name) ? null : name;
    }
}
