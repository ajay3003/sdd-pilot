@page "/getting-started"
@using BirkNext.Web.Components
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using Microsoft.AspNetCore.Components.Rendering
@implements IDisposable
@inject IWorkflowReadinessService WorkflowReadiness
@inject ICurrentWorkspaceProjection CurrentWorkspace
@inject IWorkspacePersistenceApiService WorkspacePersistence
@inject IWorkspaceSessionRestoreService WorkspaceRestore
@inject IWorkspaceAutoSaveService AutoSave
@inject IRecommendedWorkflowApiService WorkflowApi
@inject ILogger<RecommendedWorkflow> Logger
@inject IJSRuntime JSRuntime
@inject IServiceProvider ServiceProvider

<PageTitle>Recommended Workflow - QA Review Studio</PageTitle>

<div class="rw-page">

    <PageHeader Title="Recommended Workflow"
                Description="A workspace-aware guide that recommends the next useful review based on the inputs, evidence and review decisions currently available." />
    <ProjectContextStrip RequiresEnvironment="@(_path == WorkflowPathKind.Runtime)" ShowTargetApplication="true" ReviewPath="@WorkflowPaths.PathLabel(_path)"
                         AbsentEnvironmentText="@(_path == WorkflowPathKind.Runtime ? "Required for this path · not configured" : "Not configured · optional until a runtime review")" />

    @if (_readiness is null)
    {
        <p class="loading-state" role="status">Loading workspace…</p>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_approvalErrorMessage))
        {
            <div class="rw-error-alert" role="alert">
                <span class="rw-error-icon">!</span>
                <span class="rw-error-message">@_approvalErrorMessage</span>
                <button class="rw-error-close" @onclick="@(() => _approvalErrorMessage = null)">&times;</button>
            </div>
        }

        @if (_readiness.WorkspaceError)
        {
            <div class="rw-error-alert" role="alert" data-testid="rw-workspace-error">
                <span class="rw-error-icon">!</span>
                <span class="rw-error-message">Unable to load workspace @_readiness.ProjectName. @_readiness.Workspace.Error</span>
            </div>
        }

        <section class="rw-inputs" aria-labelledby="rw-inputs-heading" data-testid="rw-inputs">
            <div class="rw-inputs-header">
                <h2 id="rw-inputs-heading" class="rw-inputs-title">Project inputs</h2>
                <p class="rw-inputs-lead">BirkNext uses different evidence depending on the review. Documentation, source and runtime configuration are independent inputs; not every review requires all three. Project context is the only universal starting point.</p>
            </div>
            <div class="rw-input-grid" role="status" aria-live="polite">
                @foreach (var input in _readiness.Inputs.All)
                {
                    <article class="rw-input rw-input-@input.Kind.ToString().ToLowerInvariant() is-@input.Status.ToString().ToLowerInvariant()"
                             data-testid="rw-input" data-kind="@input.Kind" data-status="@input.Status" aria-labelledby="rw-input-@input.Kind-title">
                        <div class="rw-input-head">
                            <h3 class="rw-input-title" id="rw-input-@input.Kind-title">@input.Title</h3>
                            @{ var (applicability, applicabilityLabel) = WorkflowPaths.InputApplicability(input, _path); }
                            <span class="rw-input-requirement rw-appl-@applicability.ToString().ToLowerInvariant()" data-testid="rw-input-applicability" data-applicability="@applicability">@applicabilityLabel</span>
                        </div>
                        <p class="rw-input-status" data-testid="rw-input-status"><span class="rw-input-status-icon" aria-hidden="true">@InputIcon(input)</span>@input.StatusLabel</p>
                        <p class="rw-input-detail">@input.Detail</p>
                        @if (input.Status != ProjectInputStatus.Ready) { <p class="rw-input-purpose" data-testid="rw-input-purpose">@WorkflowPaths.InputPurpose(input.Kind)</p> }
                        @if (input.Kind == ProjectInputKind.Documents && _readiness.Workspace.WorkspaceLoaded && _readiness.Workspace.AvailableRoleCount > 0)
                        {
                            <ul class="rw-input-facts" aria-label="Artifact roles">
                                @foreach (var role in _readiness.Workspace.Roles)
                                {
                                    <li class="rw-artifact-badge @(role.IsAvailable ? "is-detected" : "is-missing")" data-testid="rw-role-badge" data-role="@role.Role" data-availability="@role.Availability"
                                        title="@RoleTitle(role)"><span class="rw-badge-icon" aria-hidden="true">@RoleIcon(role)</span>@role.Label<span class="visually-hidden">: @(role.Availability switch { ArtifactRoleAvailability.Available => "available", ArtifactRoleAvailability.Unknown => "unknown", _ => "missing" })</span></li>
                                }
                            </ul>
                            @if (_readiness.Workspace.DocumentSourceCount > 0)
                            {
                                @* One logical project, several packages: each role says which package provides it. *@
                                <ul class="rw-input-facts rw-role-sources" aria-label="Artifact role sources" data-testid="rw-role-sources">
                                    @foreach (var role in _readiness.Workspace.AvailableRoles.Where(r => r.SourceText is not null))
                                    {
                                        <li class="rw-input-fact" data-testid="rw-role-source" data-role="@role.Role">@role.Label · @role.SourceText</li>
                                    }
                                </ul>
                            }
                        }
                        else if (input.Facts.Count > 0)
                        {
                            <ul class="rw-input-facts">
                                @foreach (var fact in input.Facts) { <li class="rw-input-fact">@fact</li> }
                            </ul>
                        }
                        @if (input.Kind == ProjectInputKind.Source && input.Status == ProjectInputStatus.Ready)
                        {
                            @* Source snapshot analyzed ≠ Artifact Pack bound to source ≠ implementation evidence assessed. *@
                            <p class="rw-input-fact rw-source-binding" data-testid="rw-source-binding" data-state="@_readiness.SourceBinding">Artifact Pack source binding: @(_readiness.SourceBinding == SourceBindingState.Established ? "Established" : "Not established")</p>
                        }
                        <a href="@input.Route" class="rw-input-action" data-testid="rw-input-action">@input.ActionLabel →</a>
                    </article>
                }
            </div>
        </section>

        @* The project's package catalog (shared with Target Environment → Project): imported / missing recommended packages. *@
        <BirkNext.Web.Components.RecommendedPackagesCard />

        <div class="rw-layout">
            <main class="rw-main" aria-label="Recommended workflow">
        @if (ChosenPath is { } chosen)
        {
            @ChosenPathPanel(chosen)
        }
        else if (_readiness.RecommendsChoosingPath)
        {
            @PathChooser()
        }
        else if (_readiness.Recommendation is { } recommendation)
        {
            <div class="rw-next-action" data-testid="rw-next-action" data-reason="@recommendation.ReasonCode">
                <div class="rw-next-action-header">
                    <span class="rw-next-action-icon" aria-hidden="true">▶</span>
                    <div>
                        <div class="rw-next-action-label">Recommended next action</div>
                        <div class="rw-next-action-title" data-testid="rw-next-action-title">@_readiness.NextRecommendedAction!.Title</div>
                    </div>
                </div>
                <div class="rw-next-action-label">Why this is recommended</div>
                <p class="rw-next-action-desc" data-testid="rw-next-action-why">@_readiness.NextRecommendedAction.Description</p>
                <div class="rw-next-action-label">What this unlocks</div>
                <p class="rw-next-action-desc" data-testid="rw-next-action-unlocks">@recommendation.Unlocks</p>
                <div class="rw-next-action-buttons">
                    @RenderQuickAction(_readiness.NextRecommendedAction)
                    @foreach (var alternative in _readiness.AlternativeActions)
                    {
                        <a href="@alternative.Route" class="rw-next-action-alt" data-testid="rw-alternative-action">@alternative.ActionLabel</a>
                    }
                </div>
                @if (_readiness.OtherActions.Count > 0)
                {
                    <div class="rw-next-action-label">Other useful actions</div>
                    <ul class="rw-other-actions" data-testid="rw-other-actions">
                        @foreach (var other in _readiness.OtherActions)
                        {
                            <li><a href="@other.Route" data-testid="rw-other-action" data-review="@other.Id">@other.DisplayName</a> <span class="rw-cap-status">@other.StatusLabel</span></li>
                        }
                    </ul>
                }
            </div>
        }
        else if (_readiness.WorkspaceLoaded || _readiness.Inputs.AnyProvided)
        {
            <p class="rw-no-next-action" data-testid="rw-no-next-action">No open recommendation. Open any available review below, or the Dashboard for an overview.</p>
        }

        @if (_readiness.WorkspaceLoaded || _readiness.Inputs.AnyProvided) { @AvailableNow() @NeedsSetup() }

        @if (_readiness.Steps.Any(IsLoadWorkspaceStep) && !DocumentsUnavailable)
        {
            @* Project documents step once documents exist; without documents the compact Documentation reviews block below says so once. *@
            <div class="rw-phases" data-testid="rw-section-context">@foreach (var step in _readiness.Steps.Where(IsLoadWorkspaceStep)) { @StepCard(step, null) }</div>
        }

        @{ var documentSteps = _readiness.Steps.Where(s => s.StepType == "Explorer").ToList(); }
        @if (DocumentsUnavailable && (_readiness.WorkspaceLoaded || _readiness.Inputs.AnyProvided))
        {
            @DocumentationUnavailable(_readiness.Steps.Where(s => s.StepType is "Explorer" or "Analysis").ToList())
        }
        else if (documentSteps.Count > 0)
        {
            var applicable = documentSteps.Where(s => s.Status != WorkflowStepStatus.NotApplicable).ToList();
            var notApplicable = documentSteps.Where(s => s.Status == WorkflowStepStatus.NotApplicable).ToList();
            <section class="rw-reviews" aria-labelledby="rw-docs-heading" data-testid="rw-section-documentation">
                <h2 id="rw-docs-heading" class="rw-section-heading">Documentation reviews</h2>
                <p class="rw-reviews-lead" data-testid="rw-core-lead">Review authored intent, requirements, plans, tasks and data models. Only reviews whose documents are present in the current Artifact Pack are listed; open any of them independently. A review is recorded only when you record a decision.</p>
                <div class="rw-phases">
                    @for (var i = 0; i < applicable.Count; i++) { @StepCard(applicable[i], i + 1) }
                </div>
                @if (notApplicable.Count > 0)
                {
                    <details class="rw-na-group" data-testid="rw-docs-not-applicable">
                        <summary>Not available in this Artifact Pack (@notApplicable.Count)</summary>
                        <ul class="rw-cap-list">@foreach (var step in notApplicable) { <li class="rw-cap is-notapplicable" data-testid="rw-step-not-applicable" data-step="@step.Key"><span class="rw-cap-name">@step.Title</span> <span class="rw-cap-status">Not applicable</span> <span class="rw-cap-reason">@step.DisabledReason</span></li> }</ul>
                    </details>
                }
                @CapabilityList(_readiness.Capabilities.Where(c => c.Section == ReviewSection.Documentation && !c.IsCore).ToList())
            </section>
        }

        @{ var traceSteps = DocumentsUnavailable ? new List<WorkflowStepViewModel>() : _readiness.Steps.Where(s => s.StepType == "Analysis").ToList(); }
        @if (traceSteps.Count > 0)
        {
            <section class="rw-reviews" aria-labelledby="rw-trace-heading" data-testid="rw-section-traceability">
                <h2 id="rw-trace-heading" class="rw-section-heading">Traceability</h2>
                <p class="rw-reviews-lead">Requirements Traceability measures documented linkage across Constitution, Specification, Plan and Tasks — not implementation verification or test execution. Task Alignment Review reads Specification and Tasks and can run independently.</p>
                <div class="rw-phases">@foreach (var step in traceSteps) { @StepCard(step, null) }</div>
            </section>
        }

        @{ var otherSteps = _readiness.Steps.Where(s => !IsLoadWorkspaceStep(s) && s.StepType is not ("Explorer" or "Analysis")).ToList(); }
        @if (otherSteps.Count > 0)
        {
            <section class="rw-reviews" aria-labelledby="rw-other-heading" data-testid="rw-section-other">
                <h2 id="rw-other-heading" class="rw-section-heading">Other workflow steps</h2>
                <div class="rw-phases">@foreach (var step in otherSteps) { @StepCard(step, null) }</div>
            </section>
        }

        @if (_readiness.WorkspaceLoaded || _readiness.Inputs.AnyProvided)
        {
            @foreach (var branch in new[] { ReviewSection.Source, ReviewSection.Runtime, ReviewSection.Change, ReviewSection.QualityTesting, ReviewSection.Extensions })
            {
                var items = _readiness.Capabilities.Where(c => c.Section == branch && (branch != ReviewSection.Extensions || c.Applicability == ReviewApplicabilityState.Applicable)).ToList();
                if (items.Count == 0) continue;
                <section class="rw-reviews" aria-labelledby="rw-sec-@branch" data-testid="rw-section-@branch.ToString().ToLowerInvariant()">
                    <h2 id="rw-sec-@branch" class="rw-section-heading">@ReviewNavigator.SectionLabel(branch)</h2>
                    <p class="rw-reviews-lead">@SectionLead(branch)</p>
                    @if (branch == ReviewSection.Source) { @SourceBindingCard() }
                    @CapabilityList(items.Where(c => c.Applicability != ReviewApplicabilityState.NotApplicable).ToList())
                    @NotApplicableGroup(items.Where(c => c.Applicability == ReviewApplicabilityState.NotApplicable).ToList())
                </section>
            }
        }

        @* The Dashboard is an overview, not a review step: it never counts toward review decisions. *@
        <section class="rw-reviews" aria-labelledby="rw-overview-heading" data-testid="rw-review-overview">
            <h2 id="rw-overview-heading" class="rw-section-heading">Review overview</h2>
            <a href="dashboard" class="rw-input-action" data-testid="rw-open-dashboard">Open Dashboard →</a>
        </section>

            </main>

            <aside class="rw-sidebar" aria-label="Context summary">
                <div class="rw-sidebar-inner">
                    <div class="rw-workspace-actions">
                        <div class="rw-workspace-header">
                            <h2 class="rw-workspace-actions-header">Context summary</h2>
                            <details class="rw-workspace-menu" @ref="_workspaceMenuRef">
                                <summary class="btn-secondary rw-workspace-menu-trigger">Workspace</summary>
                                <div class="rw-workspace-menu-list">
                                    <button type="button" @onclick="SaveWorkspaceAsync" disabled="@(_isSaving || !_readiness.WorkspaceLoaded)">
                                        @(_isSaving ? "Saving..." : "Save")
                                    </button>
                                    <button type="button" @onclick="SaveAsWorkspaceAsync" disabled="@(_isSaving || !_readiness.WorkspaceLoaded)">Save As</button>
                                    <button type="button" @onclick="@(() => ShowManageWorkspacesAsync())" disabled="@_isSaving">Manage Workspaces</button>
                                    <button type="button" class="is-danger" @onclick="ClearWorkspaceAsync" disabled="@(_isSaving || !_readiness.WorkspaceLoaded)">Clear Workspace</button>
                                </div>
                            </details>
                        </div>

                        @ContextSummary()
                        <details class="rw-more-details" data-testid="rw-more-details">
                        <summary>More workspace details</summary>
                        <dl class="rw-workspace-details">
                            <div class="rw-detail-item">
                                <dt class="rw-detail-label">Workspace</dt>
                                <dd class="rw-detail-value" data-testid="rw-workspace-name" title="@_readiness.WorkspaceName">@_readiness.WorkspaceName</dd>
                            </div>
                            <div class="rw-detail-item">
                                <dt class="rw-detail-label">Project</dt>
                                <dd class="rw-detail-value" data-testid="rw-project" title="@ProjectValue">@ProjectValue</dd>
                            </div>
                            <div class="rw-detail-item">
                                <dt class="rw-detail-label">Selected module</dt>
                                <dd class="rw-detail-value" data-testid="rw-module">@(Workspace?.ModuleLabel ?? "—")</dd>
                            </div>
                            <div class="rw-detail-item">
                                <dt class="rw-detail-label">Selected Artifact Pack</dt>
                                <dd class="rw-detail-value" data-testid="rw-pack">@(Workspace?.PackLabel ?? "—")</dd>
                            </div>
                            <div class="rw-detail-item">
                                <dt class="rw-detail-label">Artifact roles</dt>
                                <dd class="rw-detail-value" data-testid="rw-artifact-roles">@ArtifactRolesValue</dd>
                            </div>
                            <div class="rw-detail-item">
                                <dt class="rw-detail-label">Saved</dt>
                                <dd class="rw-detail-value" data-testid="rw-saved"><span class="@SaveStatusClass" data-testid="rw-save-status">@_readiness.Workspace.SaveStatusLabel</span>@(_readiness.Workspace.LastSavedAt is null ? "" : $" · {_readiness.LastSavedText}")</dd>
                            </div>
                        </dl>
                        <dl class="rw-workspace-details" data-testid="rw-sidebar-inputs" aria-label="Inputs">
                            @foreach (var input in _readiness.Inputs.All)
                            {
                                <div class="rw-detail-item"><dt class="rw-detail-label">@input.Title</dt><dd class="rw-detail-value">@input.StatusLabel</dd></div>
                            }
                            <div class="rw-detail-item"><dt class="rw-detail-label">Source binding</dt><dd class="rw-detail-value" data-testid="rw-sidebar-binding">@(_readiness.SourceBinding switch { SourceBindingState.Established => "Established", SourceBindingState.NotEstablished => "Not established", _ => "No source snapshot" })</dd></div>
                        </dl>
                        </details>

                        @if (_readiness.Workspace.State == CurrentWorkspaceState.NoWorkspace)
                        {
                            <div class="rw-no-workspace" data-testid="rw-no-workspace">
                                <SecondaryButton OnClick="ShowManageWorkspacesAsync">Resume a saved workspace</SecondaryButton>
                            </div>
                        }
                    </div>

                    <div class="rw-summary metric-strip" role="status" aria-live="polite">
                        <div class="rw-metric" data-testid="rw-manual-review-card">
                            <MetricCard Value="@ManualApprovalValue" Label="Core manual reviews recorded" Sublabel="@ManualApprovalSublabel" Variant="@ManualApprovalVariant" />
                        </div>
                    </div>
                    <p class="rw-gates-lead" data-testid="rw-manual-review-note">Review decisions support governance and readiness; analyses and reviews can run without any recorded decision.</p>
                    <p class="rw-gates-lead" data-testid="rw-release-note">Release readiness: not assessed here — @WorkflowReadinessService.NoReleasePolicy</p>

                    @if (_readiness.ReviewGates.Count > 0)
                    {
                        <details class="rw-gates" data-testid="rw-review-gates">
                            <summary>Which review decisions are counted</summary>
                            <p class="rw-gates-lead">Required review steps that apply to this project. A step counts when a review decision — reviewed, reviewed with gaps or approved — is recorded on the artifact revision it reads now. Optional and not-applicable steps are listed but not counted; the Dashboard is never counted.</p>
                            <ul class="rw-gates-list">
                                @foreach (var gate in _readiness.ReviewGates)
                                {
                                    var gateReview = ArtifactReviewPresentation.Of(gate);
                                    var counted = !gateReview.Applies ? "not-counted" : gate.IsOptional ? "optional" : "required";
                                    <li class="rw-gate" data-testid="rw-review-gate" data-step="@gate.Key" data-counted="@counted">
                                        <span class="rw-gate-name">@gate.Title</span>
                                        <span class="rw-gate-scope">@(counted switch { "required" => "Required", "optional" => "Optional, not counted", _ => "Not applicable, not counted" })</span>
                                        <span class="rw-gate-state"><span aria-hidden="true">@gateReview.Icon </span>@gateReview.Label</span>
                                    </li>
                                }
                            </ul>
                        </details>
                    }
                </div>
            </aside>
        </div>

        <div class="rw-footer-note">
            For detailed reference documentation on any feature, see the <a href="user-guide" class="rw-inline-link">User Guide</a>.
        </div>
    }

</div>

@if (_showWorkspaceManager)
{
    <WorkspaceManager OnClose="OnWorkspaceManagerCloseAsync" />
}

@code {
    [SupplyParameterFromQuery(Name = "path")] public string? PathQuery { get; set; }
    [SupplyParameterFromQuery(Name = "execution")] public string? ExecutionQuery { get; set; }

    private WorkflowPathKind? _path;
    private bool _automated;
    private BirkNext.BrowserAuthentication.AutomatedBrowserExecutionReadiness? _unattended;
    private bool _focusRecommendation;
    private ElementReference _recommendationHeading;

    private WorkflowReadiness? _readiness;
    private bool _isSaving;
    private bool _showWorkspaceManager;
    private string? _approvingStepId;
    private string? _approvalErrorMessage;
    private ElementReference _workspaceMenuRef;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            WorkflowReadiness.ReadinessChanged += OnReadinessChanged;
            await AutoSave.StartMonitoringAsync();
            await RefreshReadinessAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing RecommendedWorkflow page");
            _approvalErrorMessage = $"Failed to load workflow: {ex.Message}";
        }
    }

    // Auto-save listens to artifact and project changes itself; a readiness change (including a save) never schedules one.
    private async void OnReadinessChanged()
    {
        await InvokeAsync(async () =>
        {
            await RefreshReadinessAsync();
            StateHasChanged();
        });
    }

    private async Task RefreshReadinessAsync()
    {
        _readiness = await WorkflowReadiness.GetReadinessAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        var path = WorkflowPaths.ParsePath(PathQuery);
        var automated = string.Equals(ExecutionQuery, "automated", StringComparison.OrdinalIgnoreCase);
        _focusRecommendation = _readiness is not null && path != _path;
        _path = path;
        _automated = automated;
        // Browser login readiness is read only when the user is about to run automated browser work on the runtime path. Reading it never
        // starts a login; static reviews and manual (attended) runs never ask for it.
        _unattended = _path == WorkflowPathKind.Runtime && _automated && ServiceProvider.GetService(typeof(IBrowserAuthenticationApiService)) is IBrowserAuthenticationApiService auth
            ? await auth.AutomatedExecutionAsync() : null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusRecommendation)
        {
            _focusRecommendation = false;
            try { await _recommendationHeading.FocusAsync(); } catch (InvalidOperationException) { }
        }
    }

    /// <summary>The path named in the address, adjusted for automated execution. Null when no path is chosen.</summary>
    private WorkflowPath? ChosenPath => _path is { } kind && _readiness?.PathOf(kind) is { } path ? WorkflowPaths.ForExecution(path, _automated, _unattended) : null;

    /// <summary>No supported project documents: document reviews collapse into one compact block.</summary>
    private bool DocumentsUnavailable => _readiness?.ArtifactLoad == ArtifactLoadState.Required;

    private static string PathHref(WorkflowPathKind kind) => $"getting-started?path={kind.ToString().ToLowerInvariant()}";

    /// <summary>The denominator: required review steps that apply (not N/A, not optional), from the step list itself.</summary>
    private IReadOnlyList<WorkflowStepViewModel> RequiredGates => _readiness?.RequiredReviewGates ?? [];

    /// <summary>Required gates with a review decision recorded on the artifact revisions they read now (reviewed, reviewed with gaps, approved).</summary>
    private int ManualApprovedCount => _readiness?.DecidedReviewCount ?? 0;

    private string ManualApprovalValue => RequiredGates.Count == 0 ? "—" : $"{ManualApprovedCount} / {RequiredGates.Count}";

    private string ManualApprovalSublabel
    {
        get
        {
            if (RequiredGates.Count == 0) return "No review steps apply";
            var optional = _readiness?.OptionalReviewGates.Count ?? 0;
            return $"{ManualApprovedCount} / {RequiredGates.Count} required review decisions recorded — {string.Join(", ", RequiredGates.Select(g => g.Title))}"
                   + (optional > 0 ? $" · {optional} optional not counted" : "");
        }
    }

    /// <summary>Neutral until complete: pending approvals are not a warning, and the text carries the state.</summary>
    private string? ManualApprovalVariant =>
        RequiredGates.Count > 0 && ManualApprovedCount == RequiredGates.Count ? "success" : null;

    private CurrentWorkspaceSnapshot? Workspace => _readiness?.Workspace;

    private string ProjectValue => Workspace switch
    {
        { State: CurrentWorkspaceState.NoWorkspace } or null => "No project loaded",
        var ws => ws.ProjectDisplay,
    };

    private string ArtifactRolesValue => Workspace switch
    {
        { WorkspaceLoaded: true, AvailableRoleCount: > 0 } ws => ws.RoleSummary,
        { WorkspaceLoaded: true, DocumentationUnresolved: true } => "Documentation source unresolved",
        { WorkspaceLoaded: true, Evidence.UnboundDocumentPackages.Count: > 0 } => "Available in another import (not bound)",
        { WorkspaceLoaded: true, Evidence: not null } => "No supported project documents found",
        { WorkspaceLoaded: true } => "None available",
        _ => "Not provided",
    };

    private static string InputIcon(ProjectInput input) => input.Status switch
    {
        ProjectInputStatus.Ready => "✓",
        ProjectInputStatus.Partial or ProjectInputStatus.NeedsAttention => "!",
        ProjectInputStatus.Unknown => "?",
        _ => "○",
    };

    /// <summary>Sidebar line for an input: its status plus the most telling fact (archive, environment and host).</summary>
    private static string InputSummary(ProjectInput input) =>
        input.Facts.Count == 0 ? input.StatusLabel : $"{input.StatusLabel} · {string.Join(" · ", input.Facts.Take(2))}";

    /// <summary>Not assessed (nothing reviewed yet, or nothing to review) is shown as a dash, never as 0%.</summary>
    private string ReleaseReadinessValue =>
        _readiness?.ReleaseReadinessPercent is { } percent ? $"{percent}%" : "—";

    private string ReleaseReadinessSublabel =>
        _readiness?.CanRelease == true ? "Release recommended"
        : _readiness is not { WorkspaceLoaded: true } ? "Not assessed"
        : _readiness.RequiredReviewCount == 0 ? "No required reviews"
        : _readiness.ReleaseReadinessPercent is null ? $"Not assessed · 0 of {_readiness.RequiredReviewCount} required approved"
        : $"{_readiness.ApprovedReviewCount} of {_readiness.RequiredReviewCount} required approved";

    private string SaveStatusClass => Workspace?.SaveStatus switch
    {
        "Saved" => "status-saved",
        "AutoSaved" => "status-auto-saved",
        "UnsavedChanges" => "status-unsaved",
        _ => "status-not-saved"
    };

    private static string RoleIcon(ArtifactRoleStatus role) => role.Availability switch
    {
        ArtifactRoleAvailability.Available => "✓",
        ArtifactRoleAvailability.Unknown => "?",
        _ => "○",
    };

    private static string RoleTitle(ArtifactRoleStatus role) => role.Availability switch
    {
        ArtifactRoleAvailability.Unknown => $"{role.Label}: availability unknown",
        ArtifactRoleAvailability.Missing => $"{role.Label}: missing",
        _ => $"{role.Label}: {role.ArtifactCount} artifact{(role.ArtifactCount == 1 ? "" : "s")}"
             + (role.PackRequired ? ", select an artifact pack" : role.Selection == ArtifactRoleSelection.SelectionRequired ? ", needs selection" : "") + (role.ModuleSummary is { } modules ? $" ({modules})" : "")
             + (role.PackApplicability is { } applicability ? $" — {applicability}" : "")
             + (role.SourceText is { } source ? $" · {source}" : ""),
    };

    private string? ReleaseReadinessVariant =>
        _readiness?.CanRelease == true ? "success" : null;

    private static bool IsReviewGate(WorkflowStepViewModel step) => WorkflowReadinessService.IsReviewGate(step);

    private static bool IsLoadWorkspaceStep(WorkflowStepViewModel step) =>
        step.Key.Equals("LoadSampleProject", StringComparison.OrdinalIgnoreCase)
        || step.Key.Equals(WorkflowReadinessService.LoadWorkspaceKey, StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// The step's state in words. Step 1 (artifact loading) is "Action required" or "Done" — never a review state. Review steps use
    /// the shared review reading (<see cref="ArtifactReviewPresentation"/>): Ready to review, In review, Reviewed, Approved,
    /// Needs changes, Review stale, Blocked or N/A. Availability is never shown as a completed review.
    /// </summary>
    private string GetStepStateLabel(WorkflowStepViewModel step)
    {
        if (IsLoadWorkspaceStep(step))
            return _readiness?.ArtifactLoad == ArtifactLoadState.Required ? "Action required" : "Imported";
        return IsReviewGate(step) ? ArtifactReviewPresentation.Of(step).Label : step.Status == WorkflowStepStatus.Locked ? "Blocked" : "Available";
    }

    private ArtifactReviewState? GateState(WorkflowStepViewModel step) =>
        IsReviewGate(step) ? ArtifactReviewPresentation.Of(step).State : null;

    private string GetStepBadgeClass(WorkflowStepViewModel step) => IsLoadWorkspaceStep(step)
        ? (GetStepStateLabel(step) == "Imported" ? "rw-badge-approved" : "rw-badge-action")
        : GateState(step) switch
        {
            ArtifactReviewState.Approved => "rw-badge-approved",
            ArtifactReviewState.NeedsChanges => "rw-badge-needs-changes",
            ArtifactReviewState.Stale => "rw-badge-stale",
            ArtifactReviewState.InReview => "rw-badge-in-review",
            ArtifactReviewState.Reviewed => "rw-badge-pending",
            ArtifactReviewState.Blocked or ArtifactReviewState.NotApplicable => "rw-badge-locked",
            _ => "rw-badge-available"
        };

    private string GetStepCardClass(WorkflowStepViewModel step) => IsLoadWorkspaceStep(step)
        ? (GetStepStateLabel(step) == "Imported" ? "is-approved" : "")
        : GateState(step) switch
        {
            ArtifactReviewState.Approved => "is-approved",
            ArtifactReviewState.NeedsChanges or ArtifactReviewState.Stale => "is-attention",
            ArtifactReviewState.Reviewed => "is-reviewed",
            ArtifactReviewState.Blocked => "is-locked-step",
            ArtifactReviewState.NotApplicable => "is-locked-step is-not-applicable",
            _ => ""
        };

    private string GetStepColor(WorkflowStepViewModel step) =>
        GetStepStateLabel(step) is "Approved" or "Imported" ? "#15803d" : step.Color;

    private RenderFragment RenderQuickAction(WorkflowStepViewModel step) => builder =>
    {
        if (!step.CanOpen)
        {
            return;
        }

        builder.OpenElement(0, "a");
        builder.AddAttribute(1, "href", step.Route);
        builder.AddAttribute(2, "class", "rw-next-action-btn");
        builder.AddContent(3, $"{step.ActionLabel} ->");
        builder.CloseElement();
    };

    /// <summary>A review card. <paramref name="order"/> is a small suggested-order marker inside one section — never a global step number.</summary>
    private RenderFragment StepCard(WorkflowStepViewModel step, int? order) => __builder =>
    {
        var review = IsReviewGate(step) ? ArtifactReviewPresentation.Of(step) : null;
        var capability = _readiness?.Capabilities.FirstOrDefault(c => c.Id == step.Key);
        <div class="rw-phase @GetStepCardClass(step) @(step.IsCurrent ? "is-current" : "")" style="--rw-phase-color: @GetStepColor(step);"
             data-testid="rw-step" data-step="@step.Key" data-state="@GetStepStateLabel(step)" data-review="@review?.State" aria-current="@(step.IsCurrent ? "step" : null)">
            <div class="rw-phase-header">
                <div class="rw-phase-num" aria-hidden="true">@(review?.Icon ?? (order?.ToString() ?? "•"))</div>
                <div class="rw-phase-titles">
                    @if (order is { } n) { <div class="rw-phase-label" data-testid="rw-step-order">Suggested @n</div> }
                    <div class="rw-phase-name">@step.Title</div>
                </div>
                <span class="badge rw-step-badge @GetStepBadgeClass(step)" data-testid="rw-step-state">@GetStepStateLabel(step)</span>
            </div>
            <div class="rw-phase-body">
                <p class="rw-goal">@step.Description</p>
                @if (review is not null)
                {
                    <p class="rw-step-status is-@review.State.ToString().ToLowerInvariant()" data-testid="rw-step-status"><span class="rw-step-status-icon" aria-hidden="true">@review.Icon</span>@review.Summary</p>
                }
                @if (capability?.Note is { } note) { <p class="rw-step-note" data-testid="rw-step-note">@note</p> }
                <div class="rw-phase-footer">@RenderAction(step)</div>
            </div>
        </div>
    };

    /// <summary>Several paths are open: one card per path, each with one primary action (its next step) and plain links to what it offers.</summary>
    private RenderFragment PathChooser() => __builder =>
    {
        var next = _readiness!.NextRecommendedAction!;
        <section class="rw-paths" aria-labelledby="rw-paths-heading" data-testid="rw-paths">
            <div class="rw-next-action-label">Recommended next step</div>
            <h2 id="rw-paths-heading" class="rw-paths-title" tabindex="-1" @ref="_recommendationHeading" data-testid="rw-next-action-title">@next.Title</h2>
            <p class="rw-paths-lead" data-testid="rw-next-action-why">@next.Description</p>
            <div class="rw-path-grid">
                @foreach (var path in _readiness.Paths)
                {
                    @PathCard(path)
                }
            </div>
        </section>
    };

    private RenderFragment PathCard(WorkflowPath path) => __builder =>
    {
        <article class="rw-path is-@path.State.ToString().ToLowerInvariant()" data-testid="rw-path" data-path="@path.Id" data-state="@path.State" aria-labelledby="rw-path-@path.Id-title">
            <h3 id="rw-path-@path.Id-title" class="rw-path-title">@path.Title</h3>
            <p class="rw-path-state" data-testid="rw-path-state"><span class="rw-path-state-mark" aria-hidden="true">@(path.State switch { WorkflowPathState.Ready => "✓", WorkflowPathState.NeedsSetup => "→", _ => "○" })</span>@path.StateLabel</p>
            <p class="rw-path-summary">@path.Summary</p>
            @if (path.Links.Count > 0)
            {
                <p class="rw-path-links" data-testid="rw-path-links"><span class="rw-path-links-label">Available:</span>
                    @for (var i = 0; i < path.Links.Count; i++) { var link = path.Links[i]; <a href="@link.Route">@link.Label</a>@(i < path.Links.Count - 1 ? ", " : "") }
                </p>
            }
            <a class="rw-path-primary" href="@path.PrimaryRoute" data-testid="rw-path-primary">@path.PrimaryLabel</a>
            @if (path.Kind is not WorkflowPathKind.ImportEvidence)
            {
                <a class="rw-path-plan" href="@PathHref(path.Kind)" data-testid="rw-path-plan">Plan this path<span class="visually-hidden">: @path.Title</span></a>
            }
        </article>
    };

    /// <summary>The chosen path: its next step as the recommendation, why, and (runtime) the setup checklist in order.</summary>
    private RenderFragment ChosenPathPanel(WorkflowPath path) => __builder =>
    {
        var step = WorkflowPaths.NextStepOf(path);
        var explained = ReviewNavigator.Explain(step, Workspace?.PackLabel ?? Workspace?.ModuleLabel ?? "the selected scope");
        <section class="rw-next-action rw-chosen-path" data-testid="rw-next-action" data-reason="@explained.ReasonCode" data-path="@path.Id" aria-labelledby="rw-chosen-heading">
            <div class="rw-next-action-label">Recommended next step · @path.Title</div>
            <h2 id="rw-chosen-heading" class="rw-next-action-title" tabindex="-1" @ref="_recommendationHeading" data-testid="rw-next-action-title">@step.Title</h2>
            <div class="rw-next-action-label">Why this is recommended</div>
            <p class="rw-next-action-desc" data-testid="rw-next-action-why">@(path.State == WorkflowPathState.Ready ? path.Reason : step.Description)</p>
            @if (path.Unlocks is { } unlocks)
            {
                <div class="rw-next-action-label">What this unlocks</div>
                <p class="rw-next-action-desc" data-testid="rw-next-action-unlocks">@unlocks</p>
            }
            @if (path.Setup.Count > 0)
            {
                <ol class="rw-setup" aria-label="Runtime setup" data-testid="rw-runtime-setup">
                    @foreach (var s in path.Setup)
                    {
                        <li class="@(s.Met ? "is-met" : "is-open")" data-testid="rw-setup-step" data-step="@s.Key" data-met="@s.Met.ToString().ToLowerInvariant()">
                            <span class="rw-setup-mark">@(s.Met ? "Done" : "To do")</span> <strong>@s.Label</strong> <span class="rw-setup-detail">— @s.Detail</span>
                        </li>
                    }
                </ol>
            }
            <div class="rw-next-action-buttons">
                <a href="@path.PrimaryRoute" class="rw-next-action-btn" data-testid="rw-next-action-primary">@path.PrimaryLabel -></a>
                <a href="getting-started" class="rw-next-action-alt" data-testid="rw-all-paths">Show all review paths</a>
            </div>
        </section>
    };

    /// <summary>Reviews that can run now with the evidence available — immediate value first.</summary>
    private RenderFragment AvailableNow() => __builder =>
    {
        var ready = _readiness!.Capabilities.Where(c => c.IsActionable).ToList();
        <section class="rw-now" aria-labelledby="rw-now-heading" data-testid="rw-available-now">
            <h2 id="rw-now-heading" class="rw-section-heading">Available now</h2>
            @if (ready.Count == 0) { <p class="rw-reviews-lead">No review can run yet with the current evidence.</p> }
            else
            {
                <ul class="rw-now-list">
                    @foreach (var c in ready)
                    {
                        <li data-testid="rw-available" data-review="@c.Id"><a href="@c.Route">@c.DisplayName</a> <span class="rw-cap-status">@c.StatusLabel</span></li>
                    }
                </ul>
            }
        </section>
    };

    /// <summary>What needs setup, grouped by what it blocks; optional setup is neutral and listed separately.</summary>
    private RenderFragment NeedsSetup() => __builder =>
    {
        var runtime = _readiness!.PathOf(WorkflowPathKind.Runtime);
        var runtimeBlocked = _readiness.Capabilities.Where(c => c.Section == ReviewSection.Runtime && c.Readiness == ReviewReadiness.NeedsSetup).ToList();
        var other = _readiness.Capabilities.Where(c => c.Section is not (ReviewSection.Runtime or ReviewSection.Documentation or ReviewSection.Traceability)
            && c.Applicability == ReviewApplicabilityState.Applicable && c.Readiness == ReviewReadiness.NeedsSetup).ToList();
        var targetOptional = _readiness.Inputs.Target.Status != ProjectInputStatus.Ready && _path != WorkflowPathKind.Runtime;
        if (!DocumentsUnavailable && runtimeBlocked.Count == 0 && other.Count == 0 && !targetOptional) return;
        <section class="rw-setup-needed" aria-labelledby="rw-setup-heading" data-testid="rw-needs-setup">
            <h2 id="rw-setup-heading" class="rw-section-heading">Needs setup</h2>
            <ul class="rw-now-list">
                @if (DocumentsUnavailable)
                {
                    <li data-testid="rw-setup-item" data-item="documents"><strong>Document reviews</strong> <span class="rw-cap-status">Need project documents</span> <a href="@ProjectInputPresentation.ProjectImportSourceRoute">Import project documents</a></li>
                }
                @if (runtimeBlocked.Count > 0 && runtime is not null)
                {
                    <li data-testid="rw-setup-item" data-item="runtime"><strong>Runtime reviews</strong> <span class="rw-cap-status">@(runtime.Setup.FirstOrDefault(s => !s.Met) is { Key: WorkflowPaths.EnvironmentStep } ? "Need a Target Environment" : "Need runtime setup")</span>
                        <span class="rw-cap-reason">@string.Join(", ", runtimeBlocked.Select(c => c.DisplayName))</span> <a href="@PathHref(WorkflowPathKind.Runtime)">Plan runtime setup</a></li>
                }
                @foreach (var c in other)
                {
                    <li data-testid="rw-setup-item" data-item="@c.Id"><strong>@c.DisplayName</strong> <span class="rw-cap-status">Needs @string.Join(", ", c.MissingPrerequisites)</span></li>
                }
            </ul>
            @if (targetOptional)
            {
                <p class="rw-optional" data-testid="rw-optional-target"><strong>Target Environment</strong> · Optional until a runtime review. <a href="@PathHref(WorkflowPathKind.Runtime)">Plan runtime setup</a></p>
            }
        </section>
    };

