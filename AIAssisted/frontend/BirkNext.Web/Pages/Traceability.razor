@page "/traceability"
@using BirkNext.Web.Components
@using BirkNext.Web.Services
@using BirkNext.Web.Models
@inject IWorkspaceSessionService Workspace
@inject IWorkspaceAutoSaveService AutoSave
@inject SddEvidenceGraphService Graph

<PageTitle>Requirements Traceability</PageTitle>
<main class="requirements-traceability">
    <PageHeader Title="Requirements Traceability" Description="One shared evidence graph for current requirements, acceptance criteria, plan, tasks, implementation references and test executions." />
    <SddTraceabilityMatrix />
    @if (OrphanTasks.Count > 0)
    {
        <section><h2>Unlinked tasks</h2><p>These task references are not linked from a current requirement.</p><ul>@foreach (var task in OrphanTasks) { <li>@task</li> }</ul></section>
    }
    @if (OrphanImplementation.Count > 0)
    {
        <section><h2>Unlinked implementation evidence</h2><p>These explicit source references do not match a current requirement ID.</p><ul>@foreach (var item in OrphanImplementation) { <li>@item.RequirementId · @item.Reference · @item.Currentness</li> }</ul></section>
    }
    @if (OrphanExecutions.Count > 0)
    {
        <section><h2>Unlinked test execution evidence</h2><p>Imported tests without a current requirement or acceptance-criterion link.</p><ul>@foreach (var item in OrphanExecutions) { <li>@item.TestId · @item.ExecutionState / @item.Result · @item.Currentness</li> }</ul></section>
    }
    <section><h2>Evidence limitations</h2><ul>
        <li>A CodeLink records an explicit relationship; it does not establish that the code behaves correctly.</li>
        <li>Source Analysis snapshots do not retain a complete file inventory, so CodeLink target validation is shown as not assessed.</li>
        <li>Discovered or designed tests are not execution results. Only imported execution records show execution state and result.</li>
        <li>Missing evidence is a traceability gap, not an automatic failure.</li>
    </ul></section>
</main>

@code {
    private IReadOnlyList<SddRequirementGraphRow> Rows => Graph.Build(Workspace);
    private HashSet<string> RequirementIds => Rows.Select(x => x.Requirement.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<string> OrphanTasks => Workspace.SddLifecycle.Links
        .Where(x => x.Relationship == "RequirementDecomposedInto" && x.Currentness == "Current" && !RequirementIds.Contains(x.FromId))
        .Select(x => x.ToId).Distinct(StringComparer.OrdinalIgnoreCase).ToArray();
    private IReadOnlyList<SddImplementationEvidence> OrphanImplementation => Workspace.SddLifecycle.ImplementationEvidence
        .Where(x => !RequirementIds.Contains(x.RequirementId)).ToArray();
    private IReadOnlyList<SddTestExecutionEvidence> OrphanExecutions => Workspace.SddLifecycle.TestExecutions
        .Where(x => x.Currentness == "Current" && x.RequirementReferences.All(id => !RequirementIds.Contains(id)) &&
            !Rows.SelectMany(r => r.Requirement.LinkedAcceptanceScenarios).Any(ac => x.AcceptanceCriterionReferences.Contains(ac.Id ?? ac.Title, StringComparer.OrdinalIgnoreCase)))
        .ToArray();

    protected override async Task OnInitializedAsync()
    {
        Graph.SynchronizeCurrentArtifacts(Workspace);
        await AutoSave.SaveNowAsync();
    }
}
<style>.requirements-traceability{max-width:1600px;margin:auto;padding:0 20px}.requirements-traceability section{margin:20px 0;padding:16px;border:1px solid #d8dee8;border-radius:8px;background:#fff}.requirements-traceability li{margin:.45rem 0}</style>
