@page "/traceability"
@using BirkNext.Web.Components
@using BirkNext.Web.Services
@using BirkNext.Web.Models
@inject IWorkspaceSessionService Workspace
@inject IWorkspaceAutoSaveService AutoSave
@inject SddEvidenceGraphService Graph
@inject BirkNext.Web.Services.Explorers.IArtifactExplorerContext ArtifactContext
@inject ICurrentWorkspaceProjection CurrentWorkspace

<PageTitle>Requirements Traceability</PageTitle>
<main class="requirements-traceability">
    <PageHeader Title="Requirements Traceability" Description="One shared evidence graph for current requirements, acceptance criteria, plan, tasks, implementation references and test executions." />
    @if (_snapshot is null) { <p role="status">Loading workspace artifacts…</p> }
    else if (_snapshot.State == CurrentWorkspaceState.Error) { <p role="alert">Unable to load workspace artifacts.</p> }
    else if (_selectionRequired.Count > 0) { <section role="status"><h2>Selection required</h2><p>Choose the artifact to use in its Explorer before viewing traceability.</p>@foreach (var role in _selectionRequired) { <p>@role.Label has multiple artifacts. <a href="/explorers">Choose artifact</a></p> }</section> }
    else if (!_snapshot.Has(WorkspaceArtifactType.Specification)) { <section role="status"><h2>Specification unavailable</h2><p>Add a Specification artifact to the current workspace to build requirements traceability.</p></section> }
    else
    {
    <SddTraceabilityMatrix />
    <SddRequirementTestEvidence Title="Test evidence dimensions" />
    @if (OrphanTasks.Count > 0)
    {
        <section><h2>Unlinked tasks</h2><p>These task references are not linked from a current requirement.</p><ul>@foreach (var task in OrphanTasks) { <li>@task</li> }</ul></section>
    }
    @if (OrphanImplementation.Count > 0)
    {
        <section><h2>Unlinked implementation evidence</h2><p>These explicit source references do not match a current requirement ID.</p><ul>@foreach (var item in OrphanImplementation) { <li>@item.RequirementId · @item.Reference · @item.Currentness</li> }</ul></section>
    }
    @if (OrphanExecutions.Count > 0)
    {
        <section><h2>Unlinked test execution evidence</h2><p>Imported tests whose explicit references do not match a current requirement or acceptance criterion.</p><ul>@foreach (var item in OrphanExecutions) { <li>@item.TestId · @item.ExecutionState / @item.Result · @item.Currentness@(item.RequirementReferences.Count + item.AcceptanceCriterionReferences.Count > 0 ? $" · references {string.Join(", ", item.RequirementReferences.Concat(item.AcceptanceCriterionReferences))}" : "")</li> }</ul></section>
    }
    @if (UnreferencedProviderExecutions > 0)
    {
        <section data-testid="trace-unreferenced-executions"><h2>Test results without requirement references</h2><p>@UnreferencedProviderExecutions imported result(s) come from tests that declare no explicit requirement or acceptance-criterion reference. They remain execution evidence; see <a href="/implementation-review#test-evidence">Test execution evidence</a>.</p></section>
    }
    <section><h2>Evidence limitations</h2><ul>
        <li>A CodeLink records an explicit relationship; it does not establish that the code behaves correctly.</li>
        <li>Source Analysis snapshots do not retain a complete file inventory, so CodeLink target validation is shown as not assessed.</li>
        <li>Discovered or designed tests are not execution results. Only imported execution records show execution state and result.</li>
        <li>A source test links to a requirement only through an explicit reference (trait or structured comment); informal mentions are candidates to confirm.</li>
        <li>Imported results whose source version is unknown are historical evidence, not verification of the current source.</li>
        <li>Missing evidence is a traceability gap, not an automatic failure.</li>
    </ul></section>
    }
</main>

@code {
    private IReadOnlyList<SddRequirementGraphRow> Rows => Graph.Build(Workspace);
    private CurrentWorkspaceSnapshot? _snapshot;
    private IReadOnlyList<ArtifactRoleStatus> _selectionRequired = [];
    private HashSet<string> RequirementIds => Rows.Select(x => x.Requirement.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<string> OrphanTasks => Workspace.SddLifecycle.Links
        .Where(x => x.Relationship == "RequirementDecomposedInto" && x.Currentness == "Current" && !RequirementIds.Contains(x.FromId))
        .Select(x => x.ToId).Distinct(StringComparer.OrdinalIgnoreCase).ToArray();
    private IReadOnlyList<SddImplementationEvidence> OrphanImplementation => Workspace.SddLifecycle.ImplementationEvidence
        .Where(x => !RequirementIds.Contains(x.RequirementId)).ToArray();
    // Provider imports (TRX) record every result row; rows without any explicit reference are counted, not listed as orphans one by one.
    private int UnreferencedProviderExecutions => Workspace.SddLifecycle.TestExecutions
        .Count(x => x.RunId is not null && x.Currentness == "Current" && x.RequirementReferences.Count + x.AcceptanceCriterionReferences.Count == 0);
    private IReadOnlyList<SddTestExecutionEvidence> OrphanExecutions => Workspace.SddLifecycle.TestExecutions
        .Where(x => !(x.RunId is not null && x.RequirementReferences.Count + x.AcceptanceCriterionReferences.Count == 0))
        .Where(x => x.Currentness == "Current" && x.RequirementReferences.All(id => !RequirementIds.Contains(id)) &&
            !Rows.SelectMany(r => r.Requirement.LinkedAcceptanceScenarios).Any(ac => x.AcceptanceCriterionReferences.Contains(ac.Id ?? ac.Title, StringComparer.OrdinalIgnoreCase)))
        .ToArray();

    protected override async Task OnInitializedAsync()
    {
        _snapshot = await CurrentWorkspace.GetAsync();
        var states = await Task.WhenAll(CurrentWorkspaceSnapshot.WorkflowRoles.Select(role => ArtifactContext.GetStateAsync(role)));
        _selectionRequired = states.Where(s => s.Status == BirkNext.Web.Services.Explorers.ExplorerArtifactStatus.SelectionRequired)
            .Select(s => _snapshot.Role(s.Role)).ToArray();
    }
}
<style>.requirements-traceability{max-width:1600px;margin:auto;padding:0 20px}.requirements-traceability section{margin:20px 0;padding:16px;border:1px solid #d8dee8;border-radius:8px;background:#fff}.requirements-traceability li{margin:.45rem 0}</style>
