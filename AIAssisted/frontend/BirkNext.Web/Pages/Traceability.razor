@page "/traceability"
@using BirkNext.Web.Components
@using BirkNext.Web.Models.Analysis
@using BirkNext.Web.Services

@inject IAnalysisPageModelService AnalysisPageModelService
@inject IWorkspaceSessionService Workspace

<PageTitle>Requirements Traceability</PageTitle>

<div class="traceability-page">
    <PageHeader Title="Requirements Traceability"
                Description="Track which requirements are covered by tests, tasks, and plan items. Identify orphaned tests and coverage gaps." />

    <!-- ── Readiness Panel ────────────────────────────────────────── -->
    @if (PageModel is not null)
    {
        <AnalysisReadinessPanel Model="PageModel" />
    }
    else if (IsLoading)
    {
        <div class="loading-state" role="status">Loading page configuration...</div>
    }
    else if (LoadError is not null)
    {
        <div class="notification notification-error" role="alert">@LoadError</div>
    }

    <!-- ── Analysis Content (only if ready) ────────────────────────── -->
    @if (PageModel?.Summary.CanRun == true)
    {
        <div class="traceability-content">
            @* Placeholder for existing Traceability UI *@
            @* To be filled with existing traceability matrix, coverage stats, etc. *@
            <p class="placeholder-text">Detailed Requirements Traceability will be displayed here.</p>
        </div>
    }
</div>

@code {
    private AnalysisPageModel? PageModel;
    private bool IsLoading = true;
    private string? LoadError;

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to workspace changes
        Workspace.ReviewContextRebuildNeeded += (s, e) => _ = RefreshPageModel();

        // Load initial model
        await RefreshPageModel();
    }

    private async Task RefreshPageModel()
    {
        try
        {
            IsLoading = true;
            LoadError = null;
            PageModel = await AnalysisPageModelService.GetRequirementsTraceabilityModelAsync();

            if (PageModel is null)
            {
                LoadError = "Failed to load page configuration";
            }
        }
        catch (Exception ex)
        {
            LoadError = $"Error loading configuration: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }
}

<style>
.traceability-page {
    padding: 0 20px;
}

.loading-state {
    text-align: center;
    color: #6b7280;
    padding: 40px 20px;
}

.placeholder-text {
    text-align: center;
    color: #9ca3af;
    padding: 20px;
    background-color: #f9fafb;
    border-radius: 6px;
}
</style>
