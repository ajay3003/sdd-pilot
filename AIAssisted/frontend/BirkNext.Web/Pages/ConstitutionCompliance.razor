@page "/constitution-compliance"
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using BirkNext.Web.Components
@inject IConstitutionAnalysisService ConstitutionService
@inject IPlanAnalysisService PlanService
@inject IConstitutionComplianceService ComplianceService
@inject IDashboardSnapshotService DashboardSnapshot

<PageTitle>Constitution Compliance</PageTitle>

<div class="cc-page">

    <PageHeader Title="Constitution Compliance Review"
                Description="Evaluate whether your Specification, Plan, and Tasks comply with the loaded Constitution. Surface violations, missing coverage, and actionable recommendations." />

    <!-- ── Artifact input panel ──────────────────────────────────────────── -->
    <div class="cc-input-panel">
        <div class="cc-input-panel-header">
            <span class="cc-input-panel-title">Load Artifacts</span>
            @if (_report is not null)
            {
                <button class="cc-input-panel-toggle" @onclick="() => _inputExpanded = !_inputExpanded">
                    @(_inputExpanded ? "▾ Collapse" : "▸ Expand")
                </button>
            }
        </div>

        @if (_inputExpanded)
        {
            <div class="cc-artifact-grid">

                <!-- Constitution (required) -->
                <div class="artifact-card @(!string.IsNullOrEmpty(_constitutionText) ? "is-loaded" : "is-required")">
                    <div class="artifact-card-header">
                        <span class="artifact-icon" aria-hidden="true">📜</span>
                        <span class="artifact-name">Constitution</span>
                        <span class="artifact-required-badge">Required</span>
                        <span class="artifact-status @(!string.IsNullOrEmpty(_constitutionText) ? "is-loaded" : "")">
                            @(!string.IsNullOrEmpty(_constitutionText) ? "Loaded" : "Empty")
                        </span>
                    </div>
                    <SpecificationImport
                        InputId="cc-const-import"
                        OnFileImported="t => { _constitutionText = t; }"
                        OnFileRemoved="() => { _constitutionText = string.Empty; }"
                        IsDisabled="false" />
                    <textarea
                        class="artifact-textarea"
                        placeholder="Or paste constitution.md content here…"
                        rows="4"
                        @bind="_constitutionText"></textarea>
                    @if (!string.IsNullOrEmpty(_constitutionText))
                    {
                        <div class="artifact-footer">
                            <span>@_constitutionText.Split('\n').Length lines</span>
                            <button class="artifact-clear" @onclick='() => _constitutionText = string.Empty'>Clear</button>
                        </div>
                    }
                </div>

                <!-- Specification -->
                <div class="artifact-card @(!string.IsNullOrEmpty(_specText) ? "is-loaded" : "")">
                    <div class="artifact-card-header">
                        <span class="artifact-icon" aria-hidden="true">📋</span>
                        <span class="artifact-name">Specification</span>
                        <span class="artifact-status @(!string.IsNullOrEmpty(_specText) ? "is-loaded" : "")">
                            @(!string.IsNullOrEmpty(_specText) ? "Loaded" : "Empty")
                        </span>
                    </div>
                    <SpecificationImport
                        InputId="cc-spec-import"
                        OnFileImported="t => { _specText = t; }"
                        OnFileRemoved="() => { _specText = string.Empty; }"
                        IsDisabled="false" />
                    <textarea
                        class="artifact-textarea"
                        placeholder="Or paste spec.md content here…"
                        rows="4"
                        @bind="_specText"></textarea>
                    @if (!string.IsNullOrEmpty(_specText))
                    {
                        <div class="artifact-footer">
                            <span>@_specText.Split('\n').Length lines</span>
                            <button class="artifact-clear" @onclick='() => _specText = string.Empty'>Clear</button>
                        </div>
                    }
                </div>

                <!-- Plan -->
                <div class="artifact-card @(!string.IsNullOrEmpty(_planText) ? "is-loaded" : "")">
                    <div class="artifact-card-header">
                        <span class="artifact-icon" aria-hidden="true">📐</span>
                        <span class="artifact-name">Plan</span>
                        <span class="artifact-status @(!string.IsNullOrEmpty(_planText) ? "is-loaded" : "")">
                            @(!string.IsNullOrEmpty(_planText) ? "Loaded" : "Empty")
                        </span>
                    </div>
                    <SpecificationImport
                        InputId="cc-plan-import"
                        OnFileImported="t => { _planText = t; }"
                        OnFileRemoved="() => { _planText = string.Empty; }"
                        IsDisabled="false" />
                    <textarea
                        class="artifact-textarea"
                        placeholder="Or paste plan.md content here…"
                        rows="4"
                        @bind="_planText"></textarea>
                    @if (!string.IsNullOrEmpty(_planText))
                    {
                        <div class="artifact-footer">
                            <span>@_planText.Split('\n').Length lines</span>
                            <button class="artifact-clear" @onclick='() => _planText = string.Empty'>Clear</button>
                        </div>
                    }
                </div>

                <!-- Tasks -->
                <div class="artifact-card @(!string.IsNullOrEmpty(_taskText) ? "is-loaded" : "")">
                    <div class="artifact-card-header">
                        <span class="artifact-icon" aria-hidden="true">✅</span>
                        <span class="artifact-name">Tasks</span>
                        <span class="artifact-status @(!string.IsNullOrEmpty(_taskText) ? "is-loaded" : "")">
                            @(!string.IsNullOrEmpty(_taskText) ? "Loaded" : "Empty")
                        </span>
                    </div>
                    <SpecificationImport
                        InputId="cc-task-import"
                        OnFileImported="t => { _taskText = t; }"
                        OnFileRemoved="() => { _taskText = string.Empty; }"
                        IsDisabled="false" />
                    <textarea
                        class="artifact-textarea"
                        placeholder="Or paste tasks.md content here…"
                        rows="4"
                        @bind="_taskText"></textarea>
                    @if (!string.IsNullOrEmpty(_taskText))
                    {
                        <div class="artifact-footer">
                            <span>@_taskText.Split('\n').Length lines</span>
                            <button class="artifact-clear" @onclick='() => _taskText = string.Empty'>Clear</button>
                        </div>
                    }
                </div>

            </div>

            <div class="cc-analyze-bar">
                <span class="cc-loaded-summary">
                    @if (string.IsNullOrWhiteSpace(_constitutionText))
                    { <span>Constitution required to run compliance review</span> }
                    else
                    { <span>Constitution loaded · @(AdditionalLoadedCount) additional artifact@(AdditionalLoadedCount != 1 ? "s" : "") loaded</span> }
                </span>
                <PrimaryButton OnClick="RunAnalysis" Disabled="@string.IsNullOrWhiteSpace(_constitutionText)">
                    Run Compliance Review
                </PrimaryButton>
            </div>
        }
    </div>

    <!-- ── Report ─────────────────────────────────────────────────────────── -->
    @if (_report is not null)
    {
        <!-- Compliance score + stat cards -->
        <div class="cc-score-row">
            @RenderScoreRing(_report.Health.CompliancePercentage)
            <div class="cc-score-meta">
                <div class="cc-score-meta-title">
                    @ScoreLabel(_report.Health.CompliancePercentage) Compliance
                </div>
                <div class="cc-score-meta-sub">
                    @_report.Health.CoveredRules of @_report.Health.TotalRules rules covered ·
                    @(_report.Health.ViolationCount > 0
                        ? $"{_report.Health.ViolationCount} violation{(_report.Health.ViolationCount != 1 ? "s" : "")}"
                        : "No violations")
                </div>
            </div>
        </div>

        <div class="cc-stat-grid">
            <button class='cc-stat-card is-compliant @(_statusFilter == ComplianceStatus.Compliant ? "is-active" : "")'
                    @onclick='() => SetStatusFilter(ComplianceStatus.Compliant)'>
                <div class="cc-stat-num">@_report.Coverage.CompliantItems</div>
                <div class="cc-stat-label">Compliant</div>
            </button>
            <button class='cc-stat-card is-partial @(_statusFilter == ComplianceStatus.Partial ? "is-active" : "")'
                    @onclick='() => SetStatusFilter(ComplianceStatus.Partial)'>
                <div class="cc-stat-num">@_report.Coverage.PartialItems</div>
                <div class="cc-stat-label">Partial</div>
            </button>
            <button class='cc-stat-card is-missing @(_statusFilter == ComplianceStatus.Missing ? "is-active" : "")'
                    @onclick='() => SetStatusFilter(ComplianceStatus.Missing)'>
                <div class="cc-stat-num">@_report.Coverage.MissingItems</div>
                <div class="cc-stat-label">Missing</div>
            </button>
            <button class='cc-stat-card is-violation @(_statusFilter == ComplianceStatus.Violation ? "is-active" : "")'
                    @onclick='() => SetStatusFilter(ComplianceStatus.Violation)'>
                <div class="cc-stat-num">@_report.Coverage.ViolationItems</div>
                <div class="cc-stat-label">Violations</div>
            </button>
        </div>

        <!-- Tab bar -->
        <div class="cc-tab-bar" role="tablist">
            <button class='cc-tab-btn @(_tab == "overview"   ? "is-active" : "")' role="tab" aria-selected="@(_tab == "overview")"   @onclick='() => SetTab("overview")'>Overview</button>
            <button class='cc-tab-btn @(_tab == "coverage"   ? "is-active" : "")' role="tab" aria-selected="@(_tab == "coverage")"   @onclick='() => SetTab("coverage")'>
                Rule Coverage @CoverageBadge
            </button>
            <button class='cc-tab-btn @(_tab == "violations" ? "is-active" : "")' role="tab" aria-selected="@(_tab == "violations")" @onclick='() => SetTab("violations")'>
                Violations @ViolationsBadge
            </button>
            <button class='cc-tab-btn @(_tab == "missing"    ? "is-active" : "")' role="tab" aria-selected="@(_tab == "missing")"    @onclick='() => SetTab("missing")'>
                Missing Coverage @MissingBadge
            </button>
            <button class='cc-tab-btn @(_tab == "recs"       ? "is-active" : "")' role="tab" aria-selected="@(_tab == "recs")"       @onclick='() => SetTab("recs")'>
                Recommendations @RecsBadge
            </button>
        </div>

        <!-- Search bar -->
        @if (_tab is "coverage" or "violations" or "missing" or "recs")
        {
            <div class="cc-search-bar">
                <input
                    type="search"
                    class="cc-search"
                    placeholder="@SearchPlaceholder"
                    value="@_search"
                    @oninput="e => _search = e.Value?.ToString() ?? string.Empty"
                    aria-label="Search" />
                @if (!string.IsNullOrWhiteSpace(_search))
                {
                    <span class="cc-search-clear" @onclick='() => _search = string.Empty' title="Clear">×</span>
                }
            </div>
        }

        <!-- Filters -->
        @if (_tab == "coverage")
        {
            <div class="cc-filter-strip" role="group" aria-label="Filter by status">
                <button class='cc-filter-chip @(_statusFilter is null ? "is-active" : "")' @onclick='() => SetStatusFilter(null)'>All</button>
                <button class='cc-filter-chip @(_statusFilter == ComplianceStatus.Compliant  ? "is-active" : "")' @onclick='() => SetStatusFilter(ComplianceStatus.Compliant)'>Compliant</button>
                <button class='cc-filter-chip @(_statusFilter == ComplianceStatus.Partial    ? "is-active" : "")' @onclick='() => SetStatusFilter(ComplianceStatus.Partial)'>Partial</button>
                <button class='cc-filter-chip @(_statusFilter == ComplianceStatus.Missing    ? "is-active" : "")' @onclick='() => SetStatusFilter(ComplianceStatus.Missing)'>Missing</button>
                <button class='cc-filter-chip @(_statusFilter == ComplianceStatus.Violation  ? "is-active" : "")' @onclick='() => SetStatusFilter(ComplianceStatus.Violation)'>Violation</button>
            </div>
            <div class="cc-filter-strip" role="group" aria-label="Filter by rule type">
                <button class='cc-filter-chip @(_typeFilter is null ? "is-active" : "")' @onclick='() => _typeFilter = null'>All Types</button>
                <button class='cc-filter-chip @(_typeFilter == ConstitutionRuleType.Principle  ? "is-active" : "")' @onclick='() => _typeFilter = ConstitutionRuleType.Principle'>Principles</button>
                <button class='cc-filter-chip @(_typeFilter == ConstitutionRuleType.Standard   ? "is-active" : "")' @onclick='() => _typeFilter = ConstitutionRuleType.Standard'>Standards</button>
                <button class='cc-filter-chip @(_typeFilter == ConstitutionRuleType.Guideline  ? "is-active" : "")' @onclick='() => _typeFilter = ConstitutionRuleType.Guideline'>Guidelines</button>
                <button class='cc-filter-chip @(_typeFilter == ConstitutionRuleType.Constraint ? "is-active" : "")' @onclick='() => _typeFilter = ConstitutionRuleType.Constraint'>Constraints</button>
            </div>
        }
        @if (_tab == "violations")
        {
            <div class="cc-filter-strip" role="group" aria-label="Filter violations by severity">
                <button class='cc-filter-chip @(_severityFilter is null ? "is-active" : "")' @onclick='() => _severityFilter = null'>All</button>
                <button class='cc-filter-chip @(_severityFilter == ViolationSeverity.Critical ? "is-active" : "")' @onclick='() => _severityFilter = ViolationSeverity.Critical'>Critical</button>
                <button class='cc-filter-chip @(_severityFilter == ViolationSeverity.High     ? "is-active" : "")' @onclick='() => _severityFilter = ViolationSeverity.High'>High</button>
                <button class='cc-filter-chip @(_severityFilter == ViolationSeverity.Medium   ? "is-active" : "")' @onclick='() => _severityFilter = ViolationSeverity.Medium'>Medium</button>
                <button class='cc-filter-chip @(_severityFilter == ViolationSeverity.Low      ? "is-active" : "")' @onclick='() => _severityFilter = ViolationSeverity.Low'>Low</button>
            </div>
        }

        <!-- Tab content -->
        <div class="cc-tab-body">

            @if (_tab == "overview")
            {
                <!-- ── Overview ──────────────────────────────────────────── -->
                <div>
                    <div class="cc-quick-stats">
                        <span class="cc-quick-stat"><span class="cc-quick-stat-value">@_report.Health.TotalRules</span> rules</span>
                        @if (_report.HasSpecification)
                        { <span class="cc-quick-stat"><span class="cc-quick-stat-value">Spec</span> loaded</span> }
                        @if (_report.HasPlan)
                        { <span class="cc-quick-stat"><span class="cc-quick-stat-value">Plan</span> loaded</span> }
                        @if (_report.HasTasks)
                        { <span class="cc-quick-stat"><span class="cc-quick-stat-value">Tasks</span> loaded</span> }
                        @if (_report.Gaps.Count > 0)
                        { <span class="cc-quick-stat"><span class="cc-quick-stat-value">@_report.Gaps.Count</span> gaps</span> }
                        @if (_report.Recommendations.Count > 0)
                        { <span class="cc-quick-stat"><span class="cc-quick-stat-value">@_report.Recommendations.Count</span> recommendations</span> }
                    </div>

                    <!-- Health indicators -->
                    @if (_report.Health.Indicators.Count > 0)
                    {
                        <div class="cc-health-indicators">
                            @foreach (var ind in _report.Health.Indicators)
                            {
                                <div class="cc-indicator cc-indicator-@ind.Level.ToString().ToLowerInvariant()">
                                    <span class="cc-indicator-icon" aria-hidden="true">@ind.Icon</span>
                                    <span>@ind.Message</span>
                                </div>
                            }
                        </div>
                    }

                    <!-- Top violations -->
                    @if (_report.Violations.Count > 0)
                    {
                        <SectionHeader Title="Top Violations" />
                        <div class="issue-cards">
                            @foreach (var v in _report.Violations.Take(3))
                            {
                                <IssueCard Severity="@v.Severity.ToString()"
                                           Component="@($"{v.RuleId} · {v.Artifact}")"
                                           Description="@v.RuleTitle"
                                           SuggestedFix="@v.Issue" />
                            }
                        </div>
                        @if (_report.Violations.Count > 3)
                        {
                            <button class="cc-filter-chip" style="margin-top:.5rem;" @onclick='() => SetTab("violations")'>
                                See all @_report.Violations.Count violations →
                            </button>
                        }
                    }

                    <!-- Top recommendations -->
                    @if (_report.Recommendations.Count > 0)
                    {
                        <SectionHeader Title="Top Recommendations" />
                        <div class="rec-cards">
                            @foreach (var r in _report.Recommendations.Take(5))
                            {
                                <RecommendationCard Title="@r.Text"
                                                    Description="@r.TargetArtifact.ToString()"
                                                    Priority="@r.Priority.ToString().ToLowerInvariant()" />
                            }
                        </div>
                        @if (_report.Recommendations.Count > 5)
                        {
                            <button class="cc-filter-chip" style="margin-top:.5rem;" @onclick='() => SetTab("recs")'>
                                See all @_report.Recommendations.Count recommendations →
                            </button>
                        }
                    }
                </div>
            }

            @if (_tab == "coverage")
            {
                <!-- ── Rule Coverage ──────────────────────────────────────── -->
                @if (!VisibleResults.Any())
                {
                    <EmptyState Icon="📭"
                                Title="@((!string.IsNullOrWhiteSpace(_search) || _statusFilter is not null || _typeFilter is not null) ? "No rules match the current filter." : "No constitution rules found.")" />
                }
                else
                {
                    <div class="cc-table-wrap">
                        <table class="cc-table" aria-label="Rule coverage">
                            <thead>
                                <tr>
                                    <th>Rule ID</th>
                                    <th>Rule Title</th>
                                    <th>Type</th>
                                    <th>Spec</th>
                                    <th>Plan</th>
                                    <th>Tasks</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var result in VisibleResults)
                                {
                                    <tr>
                                        <td><span class="cc-rule-id">@result.RuleId</span></td>
                                        <td>@result.RuleTitle</td>
                                        <td><span class="cc-rule-type-badge">@result.RuleType</span></td>
                                        <td>@CoverageDot(result.HasSpecCoverage, _report.HasSpecification)</td>
                                        <td>@CoverageDot(result.HasPlanCoverage, _report.HasPlan)</td>
                                        <td>@CoverageDot(result.HasTaskCoverage, _report.HasTasks)</td>
                                        <td>@StatusBadge(result.Status)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

            @if (_tab == "violations")
            {
                <!-- ── Violations ─────────────────────────────────────────── -->
                @if (!VisibleViolations.Any())
                {
                    <EmptyState Icon="✓"
                                Title="@((!string.IsNullOrWhiteSpace(_search) || _severityFilter is not null) ? "No violations match the current filter." : "No violations detected.")"
                                Description="@((!string.IsNullOrWhiteSpace(_search) || _severityFilter is not null) ? null : "All loaded artifacts comply with the constitution.")" />
                }
                else
                {
                    <div class="issue-cards">
                        @foreach (var v in VisibleViolations)
                        {
                            <IssueCard Severity="@v.Severity.ToString()"
                                       Component="@($"{v.RuleId} · {v.Artifact}")"
                                       Description="@(v.RuleTitle + " — " + v.Issue)"
                                       SuggestedFix="@(string.IsNullOrEmpty(v.Evidence) ? null : v.Evidence)" />
                        }
                    </div>
                }
            }

            @if (_tab == "missing")
            {
                <!-- ── Missing Coverage ───────────────────────────────────── -->
                @if (!VisibleGaps.Any())
                {
                    @if (!string.IsNullOrWhiteSpace(_search))
                    {
                        <EmptyState Title="@($"No gaps match \"{_search}\".")" />
                    }
                    else
                    {
                        <EmptyState Icon="✓" Title="No missing coverage detected." Description="All loaded artifacts are covered." />
                    }
                }
                else
                {
                    <div class="issue-cards">
                        @foreach (var gap in VisibleGaps)
                        {
                            <IssueCard Severity="@gap.Severity.ToString()"
                                       Component="@($"{gap.RuleId} · {gap.RuleType}")"
                                       Description="@gap.RuleTitle"
                                       SuggestedFix="@($"Missing in: {gap.MissingSummary}")" />
                        }
                    </div>
                }
            }

            @if (_tab == "recs")
            {
                <!-- ── Recommendations ────────────────────────────────────── -->
                @if (!VisibleRecommendations.Any())
                {
                    @if (!string.IsNullOrWhiteSpace(_search))
                    {
                        <EmptyState Title="@($"No recommendations match \"{_search}\".")" />
                    }
                    else
                    {
                        <EmptyState Icon="✓" Title="No recommendations." Description="All rules are covered across loaded artifacts." />
                    }
                }
                else
                {
                    <div class="rec-cards">
                        @foreach (var r in VisibleRecommendations)
                        {
                            <RecommendationCard Title="@r.Text"
                                                Description="@r.TargetArtifact.ToString()"
                                                Priority="@r.Priority.ToString().ToLowerInvariant()" />
                        }
                    </div>
                }
            }

        </div>
    }

</div>

@code {
    private string _constitutionText = string.Empty;
    private string _specText         = string.Empty;
    private string _planText         = string.Empty;
    private string _taskText         = string.Empty;

    private ConstitutionComplianceReport? _report;
    private string _tab    = "overview";
    private string _search = string.Empty;
    private bool _inputExpanded = true;

    private ComplianceStatus?        _statusFilter;
    private ConstitutionRuleType?    _typeFilter;
    private ViolationSeverity?       _severityFilter;

    private int AdditionalLoadedCount =>
        (string.IsNullOrWhiteSpace(_specText) ? 0 : 1) +
        (string.IsNullOrWhiteSpace(_planText) ? 0 : 1) +
        (string.IsNullOrWhiteSpace(_taskText) ? 0 : 1);

    // ── Computed filtered views ───────────────────────────────────────────

    private IEnumerable<ComplianceResult> VisibleResults
    {
        get
        {
            if (_report is null) return [];
            var q = ComplianceService.SearchResults(_report.Results, _search);
            q = ComplianceService.FilterResultsByStatus(q, _statusFilter);
            return ComplianceService.FilterResultsByRuleType(q, _typeFilter);
        }
    }

    private IEnumerable<ComplianceViolation> VisibleViolations
    {
        get
        {
            if (_report is null) return [];
            var q = ComplianceService.SearchViolations(_report.Violations, _search);
            return ComplianceService.FilterViolationsBySeverity(q, _severityFilter);
        }
    }

    private IEnumerable<ComplianceGap> VisibleGaps =>
        _report is null ? [] : ComplianceService.SearchGaps(_report.Gaps, _search);

    private IEnumerable<ComplianceRecommendation> VisibleRecommendations =>
        _report is null ? [] : ComplianceService.SearchRecommendations(_report.Recommendations, _search);

    // ── Tab badges ────────────────────────────────────────────────────────

    private string CoverageBadge    => _report?.Results.Count > 0 ? $"({_report.Results.Count})" : string.Empty;
    private string ViolationsBadge  => _report?.Violations.Count > 0 ? $"({_report.Violations.Count})" : string.Empty;
    private string MissingBadge     => _report?.Gaps.Count > 0 ? $"({_report.Gaps.Count})" : string.Empty;
    private string RecsBadge        => _report?.Recommendations.Count > 0 ? $"({_report.Recommendations.Count})" : string.Empty;

    private string SearchPlaceholder => _tab switch
    {
        "coverage"   => "Search by rule ID (PP-01), title, or type…",
        "violations" => "Search by rule, artifact, or issue…",
        "missing"    => "Search by rule ID, title, or artifact…",
        "recs"       => "Search recommendations…",
        _            => "Search…",
    };

    // ── Actions ───────────────────────────────────────────────────────────

    private void RunAnalysis()
    {
        ConstitutionDocument? constitution = null;
        SpecTree?             spec         = null;
        PlanDocument?         plan         = null;
        TaskTree?             tasks        = null;

        if (!string.IsNullOrWhiteSpace(_constitutionText))
            constitution = ConstitutionService.Parse(_constitutionText);
        if (!string.IsNullOrWhiteSpace(_specText))
            spec = SpecExplorerService.Parse(_specText);
        if (!string.IsNullOrWhiteSpace(_planText))
            plan = PlanService.Parse(_planText);
        if (!string.IsNullOrWhiteSpace(_taskText))
            tasks = TaskExplorerService.Parse(_taskText);

        _report          = ComplianceService.Analyze(constitution, spec, plan, tasks);
        DashboardSnapshot.Publish(_report);
        _tab             = "overview";
        _search          = string.Empty;
        _statusFilter    = null;
        _typeFilter      = null;
        _severityFilter  = null;
        _inputExpanded   = false;
    }

    private void SetTab(string tab)
    {
        _tab    = tab;
        _search = string.Empty;
    }

    private void SetStatusFilter(ComplianceStatus? status)
    {
        _statusFilter = _statusFilter == status ? null : status;
        if (_tab != "coverage") SetTab("coverage");
    }

    // ── Renderers ─────────────────────────────────────────────────────────

    private RenderFragment RenderScoreRing(double pct) => __builder =>
    {
        const int r  = 40;
        const int cx = 48;
        const int cy = 48;
        var circumference = 2 * Math.PI * r;
        var offset = circumference - (pct / 100.0 * circumference);
        var variant = pct >= 80 ? "is-good" : pct >= 50 ? "is-warning" : "is-error";

        __builder.OpenElement(0, "div");
        __builder.AddAttribute(1, "class", "cc-score-ring");

        var svgHtml = $"<svg viewBox=\"0 0 96 96\">" +
                      $"<circle class=\"cc-score-ring-bg\" cx=\"{cx}\" cy=\"{cy}\" r=\"{r}\" />" +
                      $"<circle class=\"cc-score-ring-fill {variant}\" cx=\"{cx}\" cy=\"{cy}\" r=\"{r}\"" +
                      $" stroke-dasharray=\"{circumference:0.00}\" stroke-dashoffset=\"{offset:0.00}\" />" +
                      $"</svg>";
        __builder.AddMarkupContent(2, svgHtml);

        __builder.OpenElement(3, "div");
        __builder.AddAttribute(4, "class", "cc-score-label");
        __builder.AddMarkupContent(5, $"{pct:0.#}%<small>Compliance</small>");
        __builder.CloseElement();

        __builder.CloseElement();
    };

    private static RenderFragment StatusBadge(ComplianceStatus status) => __builder =>
    {
        var (css, icon, label) = status switch
        {
            ComplianceStatus.Compliant => ("cc-status-compliant", "✓", "Compliant"),
            ComplianceStatus.Partial   => ("cc-status-partial",   "◑", "Partial"),
            ComplianceStatus.Missing   => ("cc-status-missing",   "○", "Missing"),
            ComplianceStatus.Violation => ("cc-status-violation", "✗", "Violation"),
            _                          => ("cc-status-unknown",   "?", "Unknown"),
        };
        __builder.OpenElement(0, "span");
        __builder.AddAttribute(1, "class", $"cc-status-badge {css}");
        __builder.AddContent(2, $"{icon} {label}");
        __builder.CloseElement();
    };

    private static RenderFragment SeverityBadge(ViolationSeverity sev) => __builder =>
    {
        var (css, label) = sev switch
        {
            ViolationSeverity.Critical => ("cc-sev-critical", "Critical"),
            ViolationSeverity.High     => ("cc-sev-high",     "High"),
            ViolationSeverity.Medium   => ("cc-sev-medium",   "Medium"),
            _                          => ("cc-sev-low",      "Low"),
        };
        __builder.OpenElement(0, "span");
        __builder.AddAttribute(1, "class", $"cc-severity-badge {css}");
        __builder.AddContent(2, label);
        __builder.CloseElement();
    };

    private static RenderFragment CoverageDot(bool covered, bool loaded) => __builder =>
    {
        if (!loaded)
        {
            __builder.OpenElement(0, "span");
            __builder.AddAttribute(1, "class", "cc-dot cc-dot-na");
            __builder.AddAttribute(2, "title", "Not loaded");
            __builder.CloseElement();
            return;
        }
        __builder.OpenElement(0, "span");
        __builder.AddAttribute(1, "class", covered ? "cc-dot cc-dot-yes" : "cc-dot cc-dot-no");
        __builder.AddAttribute(2, "title", covered ? "Covered" : "Not covered");
        __builder.CloseElement();
    };

    private static string ScoreLabel(double pct) =>
        pct >= 90 ? "Excellent" :
        pct >= 80 ? "Good" :
        pct >= 60 ? "Partial" :
        pct >= 30 ? "Low" : "Critical";
}
