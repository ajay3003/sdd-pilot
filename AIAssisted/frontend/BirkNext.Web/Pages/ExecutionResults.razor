                    @Metric("notassessed", "Not assessed", o.NotAssessedRuns.ToString(), o.BlockedRuns > 0 ? $"{o.BlockedRuns} blocked" : null)
                    @Metric("tests", "Tests executed", o.TestsExecuted.ToString(), "passed + failed")
