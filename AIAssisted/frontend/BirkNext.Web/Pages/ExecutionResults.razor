                @Metric("u-failed", "Failed", r.Failed.ToString(), null, r.Failed > 0 ? "bad" : null)
                @Metric("u-notassessed", "Not assessed", r.NotAssessed.ToString())
                @Metric("u-evidence", "Evidence", r.Evidence.ToString())
            </dl>
            <div class="xr-tabs" role="tablist" aria-label="Result details">
                @foreach (var (key, label) in DetailTabs(d))
                {
                    <a role="tab" href="@UnifiedDetailHref(key)" aria-selected="@(DetailTab == key ? "true" : "false")" class="xr-tab @(DetailTab == key ? "is-active" : "")" data-testid="@($"xr-dtab-{key}")">@label</a>
                }
            </div>
            <div role="tabpanel" class="xr-panel" data-testid="xr-dpanel" data-tab="@DetailTab">
                @if (DetailTab == "items")
                {
                    <ol class="xr-items" data-testid="xr-items">
                        @foreach (var item in d.Items)
                        {
                            <li data-testid="xr-item" data-outcome="@item.Outcome"><strong>@item.Name</strong> <span class="xr-pill xr-neutral">@item.Kind</span> <span class="xr-pill xr-@ItemTone(item.Outcome)">@item.Outcome</span>
                                @if (item.DurationMs is { } ms) { <span class="xr-muted"> · @Duration(ms)</span> }
                                @if (item.Detail is { Length: > 0 } det) { <span class="xr-subline">@det</span> }</li>
                        }
                    </ol>
                }
                else if (DetailTab == "timeline")
                {
                    <ol class="xr-tl" data-testid="xr-timeline">
                        @foreach (var t in d.Timeline)
                        {
                            <li data-testid="xr-tl-event" data-observed="@(t.At is null ? "false" : "true")" data-outcome="@t.Outcome">
                                <span class="xr-tl-time">@(t.At is { } at ? at.ToLocalTime().ToString("HH:mm:ss.fff") : "not observed")</span>
                                <span class="xr-tl-stage">@t.Stage</span><span>@t.Action</span><span class="xr-pill xr-@ItemTone(t.Outcome)">@t.Outcome</span>
                                <span class="xr-subline">@(t.EvidenceRef is { } er ? $"evidence {er} · " : "")correlation: @t.Correlation</span>
                            </li>
                        }
                    </ol>
                }
                else if (DetailTab == "trace")
                {
                    @if (d.Traceability.Count == 0) { <p class="xr-muted" data-testid="xr-trace-none">The owner recorded no references for this result.</p> }
                    else
                    {
                        <table class="xr-table" data-testid="xr-trace">
                            <caption class="visually-hidden">Recorded references of this result</caption>
                            <thead><tr><th scope="col">Kind</th><th scope="col">Reference</th><th scope="col">Relationship</th></tr></thead>
                            <tbody>@foreach (var t in d.Traceability) { <tr data-testid="xr-trace-row" data-kind="@t.Kind"><td>@t.Kind</td><td class="xr-mono">@if (t.Href is { } h) { <a href="@h">@t.Reference</a> } else { @t.Reference }</td><td>@t.Relationship</td></tr> }</tbody>
                        </table>
                    }
                }
                else if (DetailTab == "technical")
                {
                    <dl class="xr-facts" data-testid="xr-technical">
                        <div><dt>Owner</dt><dd>@r.OwnerLabel (@r.Source)</dd></div>
                        <div><dt>Owner reference</dt><dd class="xr-mono">@r.SourceRunId</dd></div>
                        @foreach (var m in d.Metrics) { <div data-testid="xr-technical-metric"><dt>@m.Label</dt><dd>@m.Value</dd></div> }
                    </dl>
                }
                else
                {
                    @if (d.Metrics.Count > 0)
                    {
                        <dl class="xr-facts" data-testid="xr-summary-metrics">@foreach (var m in d.Metrics.Take(6)) { <div><dt>@m.Label</dt><dd>@m.Value</dd></div> }</dl>
                    }
                    @if (d.Run.Capabilities.Contains(ExplorerCapability.Compare)) { @ComparePanel(d) }
                }
            </div>
            @if (d.Limitations.Count > 0)
            {
                <details class="xr-details" data-testid="xr-udetail-limitations" open="@(r.Outcome is not ExplorerOutcome.Passed)"><summary>Limitations (@d.Limitations.Count)</summary>
                    <ul class="xr-list">@foreach (var l in d.Limitations) { <li>@l</li> }</ul></details>
            }
        </section>
    };

    private RenderFragment ComparePanel(ExplorerRunDetail d) => __builder =>
    {
        <div class="xr-compare" data-testid="xr-ucompare">
            <h3 class="xr-h3">Compare with an earlier run</h3>
            @if (_compareCandidates is not { Count: > 0 } candidates) { <p class="xr-muted" data-testid="xr-ucompare-none">No other run of the same definition in this environment.</p> }
            else
            {
                <ul class="xr-chips" data-testid="xr-ucompare-candidates">
                    @foreach (var c in candidates) { <li><a class="xr-chip @(CompareQuery == c.SourceRunId ? "is-on" : "")" href="@DetailHref(d.Run, "summary", c.SourceRunId)" data-testid="xr-ucompare-pick">@Ago(c.StartedAt) · @OutcomeLabel(c.Outcome)</a></li> }
                </ul>
            }
            @if (_compareResult is { } cmp)
            {
                if (!cmp.Comparable) { <p class="xr-error" data-testid="xr-ucompare-refused">Not comparable: @string.Join(" ", cmp.Reasons)</p> }
                else
                {
                    <table class="xr-table" data-testid="xr-ucompare-table">
                        <caption class="visually-hidden">Changes from the earlier run to this one</caption>
                        <thead><tr><th scope="col">Test</th><th scope="col">Earlier</th><th scope="col">This run</th><th scope="col">Change</th><th scope="col">Detail</th></tr></thead>
                        <tbody>@foreach (var row in cmp.Rows) { <tr data-testid="xr-ucompare-row" data-change="@row.Change"><td>@row.Name</td><td>@(row.Baseline ?? "–")</td><td>@(row.Current ?? "–")</td><td>@row.Change</td><td>@(row.Detail ?? "")</td></tr> }</tbody>
                    </table>
                }
                foreach (var l in cmp.Limitations) { <p class="xr-muted">@l</p> }
            }
        </div>
    };

    private static IEnumerable<(string Key, string Label)> DetailTabs(ExplorerRunDetail d)
    {
        yield return ("summary", "Summary");
        if (d.Items.Count > 0) yield return ("items", d.ItemsLabel);
        if (d.Timeline.Count > 0) yield return ("timeline", "Timeline");
        if (d.Traceability.Count > 0) yield return ("trace", "Traceability");
        yield return ("technical", "Technical details");
    }

    private static string ItemTone(string outcome) => outcome switch
    {
        "Passed" or "Pass" or "Succeeded" or "Verified" or "Valid" or "ResponseReceived" => "ok",
        "Failed" or "Fail" or "Error" or "UnexpectedResult" or "TimedOut" or "UnknownOutcome" or "WrongCorrelation" or "IssueDetected" or "ConnectionFailed" => "bad",
        "Blocked" or "Partial" or "Warning" or "Inconclusive" or "NotObservable" => "warn",
        _ => "neutral",
    };

    private static string Cap(string s) => s.Length == 0 ? s : char.ToUpperInvariant(s[0]) + s[1..];
}
