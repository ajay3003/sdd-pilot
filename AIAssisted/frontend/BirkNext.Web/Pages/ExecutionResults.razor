        <span class="xr-pill xr-@OutcomeTone(o)" data-testid="@(testId ?? "xr-outcome")" data-outcome="@o"><span aria-hidden="true">@OutcomeGlyph(o)</span> @OutcomeLabel(o)</span>
    };

    private RenderFragment Metric(string key, string label, string value, string? note = null, string? tone = null) => __builder =>
    {
        <div class="xr-metric @(tone is null ? "" : $"xr-metric-{tone}")" data-testid="@($"xr-metric-{key}")"><dt>@label</dt><dd><span class="xr-metric-value">@value</span>@if (note is not null) { <span class="xr-metric-note">@note</span> }</dd></div>
    };

    private RenderFragment ProviderNotes(IReadOnlyList<ExplorerProviderStatus> providers, IReadOnlyList<string> limitations) => __builder =>
