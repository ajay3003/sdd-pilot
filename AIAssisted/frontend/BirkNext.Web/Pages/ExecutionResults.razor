@page "/execution-results"
@using System.Text.Json
@using System.Text.Json.Nodes
@using BirkNext.ExecutionEvidence
@using BirkNext.ExecutionExplorer
@inject IServiceProvider Services
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Test Execution &amp; Evidence</PageTitle>

@* Test Execution & Evidence: actual execution results across the BirkNext test modules (a read-only projection over their own stores), kept apart
   from static assessments. Four areas: Overview · Runs & Results · Evidence & Traceability · Storage & Retention. A REST/GraphQL run opens the
   call explorer (?run=, ?call=): what was actually sent and received, redacted before storage. Opening anything never executes, re-sends or
   changes a result; execution stays in the owning module. State lives in the URL. *@
<div class="xr" data-testid="xr-page" aria-busy="@(_loading ? "true" : "false")">
    <header class="xr-hero" data-testid="xr-header">
        <div class="xr-hero-text">
            <h1>Test Execution &amp; Evidence</h1>
            <p class="xr-muted">Actual execution results, verification outcomes and traceable evidence.</p>
        </div>
        @if (RunId is null && ExplorerSourceQuery is null)
        {
            <div class="xr-hero-actions">
                <a class="btn-secondary" href="@AreaHref("runs")" data-testid="xr-view-runs">View runs</a>
                <a class="btn-secondary" href="api-quality-review/contracts" data-testid="xr-open-tests">Open tests</a>
            </div>
        }
    </header>

    @if (_error is not null) { <p class="xr-error" role="alert" data-testid="xr-error">@_error</p> }
    @if (_message is not null) { <p class="xr-message" role="status" data-testid="xr-message">@_message</p> }

    @if (RunId is null && ExplorerSourceQuery is { } detailSource && ExplorerIdQuery is { Length: > 0 } detailId)
    {
        @UnifiedDetail(detailSource, detailId)
    }
    else if (RunId is null)
    {
        @if (Area != "storage")
        {
            <div class="xr-scope" role="group" aria-label="Scope" data-testid="xr-scope">
                <label>Project
                    <select class="form-control" data-testid="xr-scope-project" value="@(ProjectQuery ?? "")" @onchange='e => GoArea(project: e.Value?.ToString() ?? "")'>
                        <option value="">All projects in this workspace</option>
                        @foreach (var p in _overview?.Projects ?? []) { <option value="@p">@p</option> }
                    </select>
                </label>
                <label>Environment
                    <select class="form-control" data-testid="xr-scope-env" value="@(EnvQuery ?? "")" @onchange='e => GoArea(env: e.Value?.ToString() ?? "")'>
                        <option value="">All Target Environments</option>
                        @foreach (var env in _overview?.Environments ?? []) { <option value="@env">@env</option> }
                    </select>
                </label>
                <label>Time range
                    <select class="form-control" data-testid="xr-scope-range" value="@(RangeQuery ?? "")" @onchange='e => GoArea(range: e.Value?.ToString() ?? "")'>
                        <option value="">Any time</option><option value="1">Last 24 hours</option><option value="7">Last 7 days</option><option value="30">Last 30 days</option><option value="90">Last 90 days</option>
                    </select>
                </label>
                @if (!string.IsNullOrEmpty(ProjectQuery))
                {
                    <label class="xr-check xr-inline"><input type="checkbox" data-testid="xr-scope-unattributed" checked="@UnattributedQuery" @onchange="e => GoArea(unattributed: e.Value is true)" /> Include runs without a recorded project</label>
                }
                <p class="xr-muted xr-scope-note" data-testid="xr-scope-note">@ScopeNote</p>
            </div>
        }
        <nav class="xr-areas" aria-label="Test Execution & Evidence areas" data-testid="xr-areas">
            @foreach (var (key, label, hint) in Areas)
            {
                <a href="@AreaHref(key)" class="xr-area @(Area == key ? "is-active" : "")" aria-current="@(Area == key ? "page" : null)" data-testid="@($"xr-area-{key}")">
                    <span class="xr-area-label">@label</span><span class="xr-area-hint">@hint</span></a>
            }
        </nav>
        @if (Area == "runs") { @RunsArea() }
        else if (Area == "evidence") { @EvidenceArea() }
        else if (Area == "overview") { @OverviewArea() }
        else
        {
            <p class="xr-muted xr-area-intro" data-testid="xr-storage-intro">Low-frequency operations on stored REST/GraphQL execution evidence: storage, protection, export, deletion and retention. Stored size is the JSON evidence BirkNext measured; database tables are PostgreSQL's allocation (indexes, TOAST, free space) — not evidence.</p>
            @StorageView()
            <section class="xr-card" aria-labelledby="xr-runs-heading" data-testid="xr-runs">
                <h2 id="xr-runs-heading">Run history</h2>
                <div class="xr-filters" role="group" aria-label="Filter runs">
                    <label>Search <input type="search" class="form-control" data-testid="xr-run-search" value="@HistorySearch" @onchange="e => GoHistory(search: e.Value?.ToString() ?? string.Empty)" placeholder="Run name" /></label>
                    @Select("Outcome", "xr-run-filter-state", HistoryState, v => GoHistory(state: v), Enum.GetNames<ExecutionState>())
                    <label>From <input type="date" class="form-control" data-testid="xr-run-from" value="@HistoryFrom" @onchange="e => GoHistory(from: e.Value?.ToString() ?? string.Empty)" /></label>
                    <label>To <input type="date" class="form-control" data-testid="xr-run-to" value="@HistoryTo" @onchange="e => GoHistory(to: e.Value?.ToString() ?? string.Empty)" /></label>
                    <label class="xr-check"><input type="checkbox" data-testid="xr-run-protected" checked="@HistoryProtected" @onchange="e => GoHistory(protectedOnly: e.Value is true)" /> Protected only</label>
                </div>
                @if (_runs is null) { <p class="xr-muted">Loading…</p> }
                else if (_runs.Count == 0) { <p class="xr-muted" data-testid="xr-runs-empty">@(HasHistoryFilter ? "No run matches the filters." : "No runs yet. Runs are started from Contract Testing or a review (for example API Quality Review); their evidence appears here.")</p> }
                else
                {
                    <div class="xr-bulk" role="group" aria-label="Selected runs" data-testid="xr-bulk">
                        <span data-testid="xr-selected-count">@_selectedRuns.Count selected</span>
                        <button type="button" class="btn-secondary" data-testid="xr-export-selected" disabled="@(_selectedRuns.Count == 0 || _busy)" @onclick="ExportSelectedAsync">Export selected</button>
                        <button type="button" class="btn-secondary" data-testid="xr-delete-selected" disabled="@(_selectedRuns.Count == 0 || _busy)" @onclick="() => AskDelete(DeleteScope.Selected)">Delete selected…</button>
                        <button type="button" class="btn-secondary" data-testid="xr-delete-eligible" disabled="@(_busy)" @onclick="AskDeleteEligibleAsync">Delete all eligible runs of an environment…</button>
                    </div>
                    @DeleteConfirmation()
                    <div class="xr-scroll">
                        <table class="xr-table" data-testid="xr-runs-table">
                            <caption class="visually-hidden">Saved execution runs, newest first</caption>
                            <thead><tr><th scope="col"><input type="checkbox" aria-label="Select every listed run" data-testid="xr-select-all" checked="@(_runs.Count > 0 && _runs.All(r => _selectedRuns.Contains(r.RunId)))" @onchange="e => SelectAll(e.Value is true)" /></th>
                                <th scope="col">Run</th><th scope="col">Outcome</th><th scope="col">Calls</th><th scope="col">Attempts</th><th scope="col">Environment</th><th scope="col">Started</th><th scope="col">Protected</th></tr></thead>
                            <tbody>
                                @foreach (var r in _runs)
                                {
                                    <tr data-testid="xr-run-row" data-run="@r.RunId" data-state="@r.State" data-protected="@(r.Protected ? "true" : "false")">
                                        <td><input type="checkbox" aria-label="@($"Select {r.Name}")" data-testid="xr-run-select" checked="@_selectedRuns.Contains(r.RunId)" @onchange="e => Toggle(r.RunId, e.Value is true)" /></td>
                                        <th scope="row"><a href="@Href(run: r.RunId)" data-testid="xr-run-open">@r.Name</a></th>
                                        <td><span class="xr-pill xr-@Tone(r.State)">@Label(r.State)</span></td>
                                        <td>@r.Counts.Planned@(r.DatasetRows > 0 ? $" ({r.DatasetRows} rows)" : "")</td><td>@r.Counts.Attempts</td><td>@r.EnvironmentId</td><td>@r.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        <td><button type="button" class="btn-secondary xr-small" data-testid="xr-run-protect" aria-pressed="@(r.Protected ? "true" : "false")" disabled="@_busy" @onclick="() => ProtectAsync(r.RunId, !r.Protected)">@(r.Protected ? "Protected" : "Protect")</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }
    }
    else if (_detail is { } d)
    {
        var run = d.Run;
        <nav class="xr-crumbs" aria-label="Breadcrumb"><a href="@Href(clearRun: true)" data-testid="xr-back-runs">Runs &amp; Results</a> / @if (CallId is not null) { <a href="@Href(clearCall: true)" data-testid="xr-back-calls">@run.Name</a><span> / call</span> } else { <span>@run.Name</span> }</nav>
        <section class="xr-card" aria-labelledby="xr-run-heading" data-testid="xr-run" data-state="@run.State">
            <div class="xr-head">
                <h2 id="xr-run-heading">@run.Name <span class="xr-pill xr-@Tone(run.State)" data-testid="xr-run-state">@Label(run.State)</span>@if (run.Protected) { <span class="xr-pill xr-info" data-testid="xr-run-protected-pill">Protected</span> }</h2>
                <div class="xr-actions">
                    <a class="btn-secondary" href="@Api!.ExportUrl(run.RunId)" data-testid="xr-export" download>Export redacted evidence</a>
                    <button type="button" class="btn-secondary" data-testid="xr-verify" disabled="@_busy" @onclick="VerifyAsync">Verify stored evidence</button>
                    <button type="button" class="btn-secondary" data-testid="xr-protect" disabled="@_busy" @onclick="() => ProtectAsync(run.RunId, !run.Protected)">@(run.Protected ? "Remove protection" : "Protect")</button>
                    <button type="button" class="btn-secondary" data-testid="xr-delete-run" disabled="@(_busy || run.Protected)" title="@(run.Protected ? "Protected runs are not deleted; remove the protection first." : null)" @onclick="() => AskDelete(DeleteScope.Run)">Delete run…</button>
                </div>
            </div>
            @if (_scope == DeleteScope.Run) { @DeleteConfirmation() }
            @if (_integrity is { } integrity)
            {
                <p class="@(integrity.Intact ? "xr-message" : "xr-error")" role="status" data-testid="xr-integrity" data-intact="@(integrity.Intact ? "true" : "false")">
                    @(integrity.Intact ? $"Intact: {integrity.BodiesChecked} stored body(ies) match their recorded SHA-256" : $"{integrity.Mismatches.Count} stored body(ies) do not match their recorded SHA-256: {string.Join(" ", integrity.Mismatches)}")@(integrity.BodiesRemoved > 0 ? $"; {integrity.BodiesRemoved} removed by their owner" : "").
                </p>
            }
            <p class="xr-muted" data-testid="xr-run-meta">@run.EnvironmentId (@(run.EnvironmentType ?? "unclassified")) · @run.TargetOrigin · started @run.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")@(run.CompletedAt is { } done ? $" · {(done - run.StartedAt).TotalSeconds:0.0} s" : "") · authentication: @(run.AuthenticationMode ?? "None") · redaction @run.RedactionVersion</p>
            <p class="xr-muted" data-testid="xr-run-identity">
                @run.Definitions definition(s) · @(run.DatasetRows > 0 ? $"{run.DatasetRows} dataset row(s) · " : "")@(run.ChainRef is { } chain ? $"chain {chain} · " : "")@(run.ContractRefs.Count > 0 ? $"contracts {string.Join(", ", run.ContractRefs)} · " : "")@(run.StopOnFirstFailure ? "stops at the first failure · " : "")sessions: <span data-testid="xr-auth-sessions">@(run.AuthenticationSessions.Count == 0 ? "none" : string.Join(", ", run.AuthenticationSessions))</span>@(run.ReauthenticationWaitSeconds > 0 ? $" · waits up to {run.ReauthenticationWaitSeconds} s for a new sign-in" : "")
            </p>
            <dl class="xr-kpis" data-testid="xr-kpis">
                @Kpi("Logical calls", run.Counts.Planned, "planned")
                @Kpi("Attempts", run.Counts.Attempts, "attempts", run.WireTransmissions > run.Counts.Attempts ? $"{run.WireTransmissions} sent on the wire" : null)
                @Kpi("Passed", run.Counts.Passed, "passed")
                @Kpi("Failed", run.Counts.Failed, "failed")
                @Kpi("Errors", run.Counts.Errors + run.Counts.TimedOut, "errors")
                @Kpi("Blocked", run.Counts.Blocked, "blocked")
                @Kpi("Not assessed", run.Counts.NotAssessed + run.Counts.Skipped, "notassessed")
                @Kpi("Evidence complete", run.CallsWithCompleteEvidence, "evidence", $"of {run.Counts.Planned}")
            </dl>
        </section>

        @if (CallId is null) { @ManifestPanel(run) }

        @if (CallId is null)
        {
            <section class="xr-card" aria-labelledby="xr-calls-heading" data-testid="xr-calls">
                <h2 id="xr-calls-heading">Calls <span class="xr-muted" data-testid="xr-call-count">(@d.TotalCalls)</span></h2>
                <div class="xr-filters" role="group" aria-label="Filter calls">
                    <label>Search <input type="search" class="form-control" data-testid="xr-search" value="@Search" @onchange='e => Go(search: e.Value?.ToString() ?? "")' placeholder="Call name" /></label>
                    @Select("Status", "xr-filter-state", State, v => Go(state: v), Enum.GetNames<ExecutionState>())
                    @Select("Type", "xr-filter-protocol", Protocol, v => Go(protocol: v), Enum.GetNames<ExecutionProtocol>())
                    @Select("Method", "xr-filter-method", Method, v => Go(method: v), ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"])
                    @Select("Sort", "xr-sort", Sort, v => Go(sort: v), ["sequence", "duration", "status"], includeAll: false)
                </div>
                <table class="xr-table" data-testid="xr-calls-table">
                    <caption class="visually-hidden">Logical calls of the run</caption>
                    <thead><tr><th scope="col">#</th><th scope="col">Type</th><th scope="col">Call</th><th scope="col">Status</th><th scope="col">HTTP</th><th scope="col">Duration</th><th scope="col">Attempts</th><th scope="col">Auth</th><th scope="col">Row / step</th></tr></thead>
                    <tbody>
                        @foreach (var c in d.Calls)
                        {
                            var last = c.Attempts.LastOrDefault();
                            <tr data-testid="xr-call-row" data-seq="@c.Sequence" data-state="@c.State">
                                <td>@c.Sequence</td>
                                <td>@(c.Definition.Protocol == ExecutionProtocol.GraphQl ? $"GraphQL {(c.Definition.GraphQlQuery?.TrimStart().StartsWith("mutation") == true ? "mutation" : "query")}" : c.Definition.Method)</td>
                                <th scope="row"><a href="@Href(call: c.CallId)" data-testid="xr-call-open">@c.Definition.Name</a></th>
                                <td><span class="xr-pill xr-@Tone(c.State)" data-testid="xr-call-state">@Label(c.State)</span></td>
                                <td data-testid="xr-call-http">@(last?.Response?.StatusCode.ToString() ?? (last is null ? "not sent" : last.Transport.ToString()))</td>
                                <td>@(last?.Response is { } r ? $"{r.DurationMs} ms" : "—")</td>
                                <td data-testid="xr-call-attempts">@c.Attempts.Count</td>
                                <td data-testid="xr-call-auth">@AuthLabel(c.Authentication)</td>
                                <td class="xr-mono" data-testid="xr-call-row-ref">@(c.Definition.StepId is { } step ? $"step {step}" : c.Definition.DatasetRow?.Split('#').LastOrDefault() ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <nav class="xr-pager" aria-label="Pages" data-testid="xr-pager">
                    <button type="button" class="btn-secondary" disabled="@(Page <= 1)" data-testid="xr-prev" @onclick="() => Go(page: Page - 1)">Previous</button>
                    <span>Page @Page of @Math.Max(1, (int)Math.Ceiling(d.TotalCalls / (double)PageSize))</span>
                    <button type="button" class="btn-secondary" disabled="@(Page * PageSize >= d.TotalCalls)" data-testid="xr-next" @onclick="() => Go(page: Page + 1)">Next</button>
                </nav>
            </section>
        }
        else if (_call is { } call)
        {
            var last = call.Attempts.LastOrDefault();
            <section class="xr-card" aria-labelledby="xr-call-heading" data-testid="xr-call" data-state="@call.State">
                <h2 id="xr-call-heading">#@call.Sequence @call.Definition.Name <span class="xr-pill xr-@Tone(call.State)" data-testid="xr-call-detail-state">@Label(call.State)</span></h2>
                @if (call.Reason is { } reason) { <p class="xr-muted" data-testid="xr-call-reason">@reason</p> }
                <div class="xr-tabs" role="tablist" aria-label="Call evidence">
                    @foreach (var (key, label) in Tabs)
                    {
                        <button type="button" role="tab" id="@($"xr-tab-{key}")" aria-selected="@(Tab == key ? "true" : "false")" aria-controls="xr-tabpanel" tabindex="@(Tab == key ? "0" : "-1")"
                                class="xr-tab @(Tab == key ? "is-active" : "")" data-testid="@($"xr-tab-{key}")" @onclick="() => Go(tab: key)">@label</button>
                    }
                </div>
                <div id="xr-tabpanel" role="tabpanel" aria-labelledby="@($"xr-tab-{Tab}")" class="xr-panel" data-testid="xr-tabpanel" data-tab="@Tab">
                    @switch (Tab)
                    {
                        case "response":
                            if (last?.Response is { } resp) { @ResponseView(resp) }
                            else { <p data-testid="xr-no-response">@(last is null ? "Not sent: this call was blocked before any request." : $"No response was received ({last.Transport}). {last.Error}")</p> }
                            break;
                        case "assertions":
                            if (call.Assertions.Count == 0) { <p data-testid="xr-no-assertions">No assertions are configured, so this call is not assessed (never a pass by default).</p> }
                            else
                            {
                                <table class="xr-table" data-testid="xr-assertions">
                                    <caption class="visually-hidden">Assertion outcomes, failed first</caption>
                                    <thead><tr><th scope="col">Outcome</th><th scope="col">Check</th><th scope="col">Expected</th><th scope="col">Actual</th><th scope="col">Why</th></tr></thead>
                                    <tbody>
                                        @foreach (var a in call.Assertions.OrderBy(a => a.Outcome != AssertionOutcome.Failed))
                                        {
                                            <tr data-testid="xr-assertion" data-outcome="@a.Outcome"><td><span class="xr-pill xr-@(a.Outcome == AssertionOutcome.Passed ? "ok" : a.Outcome == AssertionOutcome.Failed ? "bad" : "neutral")">@a.Outcome</span></td>
                                                <td>@a.Kind @a.Operator @a.Target</td><td class="xr-mono">@a.Expected</td><td class="xr-mono">@(a.Actual ?? "—")</td><td>@a.Explanation</td></tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            break;
                        case "attempts":
                            <ol class="xr-timeline" data-testid="xr-attempts">
                                @foreach (var at in call.Attempts)
                                {
                                    <li data-testid="xr-attempt" data-transport="@at.Transport">
                                        <strong>Attempt @at.AttemptNumber</strong> · @at.Transport@(at.Response is { } r ? $" · HTTP {r.StatusCode} · {r.DurationMs} ms" : "")@(at.RetryReason is { } rr ? $" · {rr}" : "")@(at.Error is { } err ? $" · {err}" : "")
                                        <label class="xr-check"><input type="checkbox" data-testid="xr-compare-pick" checked="@_picked.Contains(at.AttemptNumber)" @onchange="() => Pick(at.AttemptNumber)" /> Compare</label>
                                    </li>
                                }
                            </ol>
                            @if (call.Attempts.Count == 0) { <p>Not sent: blocked before any request.</p> }
                            <button type="button" class="btn-secondary" data-testid="xr-compare" disabled="@(_picked.Count != 2)" @onclick="CompareAsync">Compare selected attempts</button>
                            @if (_comparison is { } cmp)
                            {
                                <ul class="xr-list" data-testid="xr-comparison">@if (cmp.Differences.Count == 0) { <li>No differences in the stored evidence.</li> } @foreach (var x in cmp.Differences) { <li>@x</li> }</ul>
                                <p class="xr-muted">Equal stored evidence does not prove equal domain state.</p>
                            }
                            break;
                        case "contract":
                            @if (call.ContractValidation.Count == 0) { <p class="xr-muted" data-testid="xr-contract-none">No contract check for this call (it is not linked to a contract operation, or checks are off).</p> }
                            @foreach (var report in call.ContractValidation)
                            {
                                <div class="xr-panel" data-testid="xr-contract-report" data-direction="@report.Direction" data-state="@report.State">
                                    <h3 class="xr-h3">@report.Direction · <span class="xr-pill @(report.State == ContractValidationState.Valid ? "xr-ok" : report.State == ContractValidationState.Invalid ? "xr-bad" : "xr-neutral")">@report.State</span></h3>
                                    <p class="xr-muted">@report.Summary</p>
                                    <p class="xr-muted xr-mono">@report.ContractRef@(report.SchemaRef is { } sr ? $" · {sr}" : "")</p>
                                    @if (report.Findings.Count > 0)
                                    {
                                        <table class="xr-table" data-testid="xr-contract-findings">
                                            <thead><tr><th scope="col">Tier</th><th scope="col">Where</th><th scope="col">Finding</th><th scope="col">Contract</th></tr></thead>
                                            <tbody>@foreach (var f in report.Findings) { <tr><td>@f.Tier</td><td class="xr-mono">@f.InstancePath</td><td>@f.Message</td><td class="xr-mono">@f.SchemaPath</td></tr> }</tbody>
                                        </table>
                                    }
                                    @if (report.Unsupported.Count > 0) { <p class="xr-muted" data-testid="xr-contract-unsupported">Not evaluated: @string.Join(", ", report.Unsupported)</p> }
                                </div>
                            }
                            break;
                        case "evidence":
                            <dl class="xr-facts" data-testid="xr-evidence">
                                <div><dt>Operation</dt><dd>@(call.Definition.OperationRef ?? "not linked to a contract operation")</dd></div>
                                <div><dt>Test data</dt><dd data-testid="xr-test-data">@(call.Definition.TestDataRefs.Count > 0 ? string.Join(", ", call.Definition.TestDataRefs) : "none")</dd></div>
                                <div><dt>Source snapshot</dt><dd>@(run.SourceSnapshotId?.ToString() ?? "not recorded")</dd></div>
                                <div><dt>Environment</dt><dd>@run.EnvironmentId · @run.TargetOrigin</dd></div>
                                <div><dt>Authentication</dt><dd data-testid="xr-auth">@(run.AuthenticationMode ?? "None")@(run.AuthenticationReference is { Length: > 0 } ar && ar != "none" ? $" · {ar}" : "")</dd></div>
                                <div><dt>Authentication outcome</dt><dd data-testid="xr-call-auth-outcome">@AuthLabel(call.Authentication)@(call.Attempts.Select(a => a.AuthenticationSession).OfType<string>().Distinct().ToList() is { Count: > 0 } sessions ? $" · {string.Join(", ", sessions)}" : "")</dd></div>
                                <div><dt>Dataset row</dt><dd data-testid="xr-dataset-row">@(call.Definition.DatasetRow ?? "not data-driven")</dd></div>
                                @if (call.Definition.StepId is { } stepId) { <div><dt>Chain step</dt><dd data-testid="xr-step">@stepId@(call.Definition.DependsOn.Count > 0 ? $" · depends on {string.Join(", ", call.Definition.DependsOn)}" : "")</dd></div> }
                                <div><dt>Test revision</dt><dd data-testid="xr-definition">@(call.Definition.DefinitionVersion ?? "—")</dd></div>
                                <div><dt>Capture policy</dt><dd>@run.CapturePolicy · @run.RedactionVersion</dd></div>
                                <div><dt>Response body hash</dt><dd class="xr-mono">@(last?.Response?.Body?.Sha256 ?? "—")</dd></div>
                                <div><dt>Capture</dt><dd data-testid="xr-capture">request @(last?.Request?.Body?.Completeness.ToString() ?? (last?.Request is null ? "not sent" : "no body")) · response @(last?.Response?.Body?.Completeness.ToString() ?? "none")</dd></div>
                                <div><dt>Timing</dt><dd>Client elapsed time only; DNS/connect/TLS/first byte: not captured</dd></div>
                            </dl>
                            @if (call.Definition.ResolvedValues.Count > 0)
                            {
                                <h3 class="xr-h3">Values used</h3>
                                <table class="xr-table xr-compact" data-testid="xr-resolved">
                                    <caption class="visually-hidden">Input values resolved for this call, with type and source</caption>
                                    <thead><tr><th scope="col">Name</th><th scope="col">Type</th><th scope="col">Source</th><th scope="col">Value (redacted preview)</th></tr></thead>
                                    <tbody>@foreach (var v in call.Definition.ResolvedValues) { <tr data-testid="xr-resolved-row"><td class="xr-mono">@v.Name</td><td>@v.Type</td><td>@v.Source</td><td class="xr-mono">@v.Preview</td></tr> }</tbody>
                                </table>
                            }
                            @if (call.Outputs.Count > 0)
                            {
                                <h3 class="xr-h3">Outputs for later steps</h3>
                                <table class="xr-table xr-compact" data-testid="xr-outputs">
                                    <caption class="visually-hidden">Outputs extracted from the response</caption>
                                    <thead><tr><th scope="col">Output</th><th scope="col">From</th><th scope="col">Type</th><th scope="col">Value or problem</th></tr></thead>
                                    <tbody>@foreach (var o in call.Outputs) { <tr data-testid="xr-output" data-found="@(o.Found ? "true" : "false")"><td class="xr-mono">@o.Name</td><td>@o.Source @o.Path</td><td>@o.Type</td><td class="xr-mono">@(o.Found ? o.Preview : o.Problem)</td></tr> }</tbody>
                                </table>
                            }
                            @if (call.Attempts.Any(a => a.Request?.Body?.Text is not null || a.Response?.Body?.Text is not null))
                            {
                                <p>
                                    <button type="button" class="btn-secondary" data-testid="xr-remove-bodies" disabled="@(_busy || run.Protected)" @onclick="RemoveBodiesAsync">@(_confirmBodies ? "Confirm: remove the stored bodies of this call" : "Remove stored bodies…")</button>
                                    <span class="xr-muted">Status, headers, sizes, hashes, assertions and outputs stay; the run's other calls are not changed.</span>
                                </p>
                            }
                            break;
                        default:
                            if (last?.Request is { } req) { @RequestView(req, call.Definition) }
                            else { <p data-testid="xr-not-sent">Not sent: this call was blocked before any request. @call.Reason</p> }
                            break;
                    }
                </div>
            </section>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "run")] public Guid? RunId { get; set; }
    [SupplyParameterFromQuery(Name = "call")] public Guid? CallId { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? TabQuery { get; set; }
    [SupplyParameterFromQuery(Name = "state")] public string? State { get; set; }
    [SupplyParameterFromQuery(Name = "protocol")] public string? Protocol { get; set; }
    [SupplyParameterFromQuery(Name = "method")] public string? Method { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? SortQuery { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? PageQuery { get; set; }

    private const int PageSize = 25;
    private static readonly (string Key, string Label)[] Tabs = [("request", "Request"), ("response", "Response"), ("assertions", "Assertions"), ("attempts", "Attempts"), ("contract", "Contract"), ("evidence", "Evidence")];
    private string Tab => Tabs.Any(t => t.Key == TabQuery) ? TabQuery! : "request";
    private string Sort => SortQuery is "duration" or "status" ? SortQuery : "sequence";
    private int Page => Math.Max(1, PageQuery ?? 1);
    private IExecutionEvidenceApiService? Api => Services.GetService(typeof(IExecutionEvidenceApiService)) as IExecutionEvidenceApiService;

    [SupplyParameterFromQuery(Name = "hq")] public string? HistorySearch { get; set; }
    [SupplyParameterFromQuery(Name = "hstate")] public string? HistoryState { get; set; }
    [SupplyParameterFromQuery(Name = "hfrom")] public string? HistoryFrom { get; set; }
    [SupplyParameterFromQuery(Name = "hto")] public string? HistoryTo { get; set; }
    [SupplyParameterFromQuery(Name = "hprot")] public bool HistoryProtected { get; set; }

    private enum DeleteScope { None, Selected, Eligible, Run }

    private bool _loading = true, _busy, _confirmBodies;
    private string? _error, _message, _typedConfirm, _eligibleEnvironment;
    private DeleteScope _scope;
    private readonly HashSet<Guid> _selectedRuns = [];
    private ExecutionStorageUsage? _usage;
    private ExecutionRetentionSettings? _retention;
    private ExecutionRetentionPreview? _retentionPreview, _eligible;
    private IReadOnlyList<ExecutionAuditEntry>? _audit;
    private ExecutionIntegrityReport? _integrity;
    private RetentionMode _retentionMode;
    private int? _retentionDays;
    private IReadOnlyList<ExecutionRunSummary>? _runs;
    private ExecutionRunDetail? _detail;
    private ExecutionManifest? _manifest;
    private ExecutionApplicability? _applicability;
    private ExecutionCallRecord? _call;
    private readonly HashSet<int> _picked = [];
    private AttemptComparison? _comparison;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true; _error = null; _comparison = null; _integrity = null; _confirmBodies = false;
        if (Api is not { } api) { _error = "Test Execution & Evidence is not available in this host."; _loading = false; return; }
        if (RunId is null && Area != "storage")
        {
            _detail = null; _call = null;
            await LoadExplorerAsync();
        }
        else if (RunId is not { } runId)
        {
            (_runs, _error) = await api.RunsAsync(new(HistorySearch, HistoryState, DateOnly.TryParse(HistoryFrom, out var f) ? f : null, DateOnly.TryParse(HistoryTo, out var t) ? t : null, HistoryProtected));
            _selectedRuns.RemoveWhere(id => _runs?.All(r => r.RunId != id) != false);
            _detail = null; _call = null;
            await LoadStorageAsync(api);
        }
        else
        {
            (_detail, _error) = await api.RunAsync(runId, (Page - 1) * PageSize, PageSize, State, Protocol, Method, Search, Sort);
            _call = null;
            (_manifest, _) = await api.ManifestAsync(runId);
            (_applicability, _) = await api.ApplicabilityAsync(runId);
            if (CallId is { } callId && _error is null)
            {
                (_call, _error) = await api.CallAsync(runId, callId);
                if (_picked.Any(n => _call?.Attempts.All(a => a.AttemptNumber != n) != false)) _picked.Clear();
            }
        }
        _loading = false;
    }

    private void Go(string? state = null, string? protocol = null, string? method = null, string? search = null, string? sort = null, int? page = null, string? tab = null)
    {
        var filterChanged = state is not null || protocol is not null || method is not null || search is not null || sort is not null;
        Nav.NavigateTo(Href(state: state ?? State, protocol: protocol ?? Protocol, method: method ?? Method, search: search ?? Search, sort: sort ?? SortQuery,
            page: filterChanged ? 1 : page ?? PageQuery, tab: tab ?? TabQuery, call: CallId));
    }

    private string Href(Guid? run = null, Guid? call = null, bool clearRun = false, bool clearCall = false, string? state = null, string? protocol = null, string? method = null,
        string? search = null, string? sort = null, int? page = null, string? tab = null)
    {
        if (clearRun) return "execution-results?area=runs";
        var q = new List<string> { $"run={run ?? RunId}" };
        // Filters stay in the URL, so "back to calls" restores them.
        void Add(string key, string? value) { if (!string.IsNullOrEmpty(value)) q.Add($"{key}={Uri.EscapeDataString(value)}"); }
        Add("state", state ?? State); Add("protocol", protocol ?? Protocol); Add("method", method ?? Method); Add("q", search ?? Search);
        Add("sort", sort ?? SortQuery); if ((page ?? PageQuery) is { } p and > 1) q.Add($"page={p}");
        if (!clearCall && (call ?? CallId) is { } c) { q.Add($"call={c}"); Add("tab", tab ?? (call is not null ? null : TabQuery)); }
        return "execution-results?" + string.Join('&', q);
    }

    private void Pick(int attempt) { if (!_picked.Remove(attempt)) _picked.Add(attempt); _comparison = null; }

    private bool HasHistoryFilter => !string.IsNullOrEmpty(HistorySearch) || !string.IsNullOrEmpty(HistoryState) || !string.IsNullOrEmpty(HistoryFrom) || !string.IsNullOrEmpty(HistoryTo) || HistoryProtected;

    private void GoHistory(string? search = null, string? state = null, string? from = null, string? to = null, bool? protectedOnly = null)
    {
        var q = new List<string> { "area=storage" };
        void Add(string key, string? value) { if (!string.IsNullOrEmpty(value)) q.Add($"{key}={Uri.EscapeDataString(value)}"); }
        Add("hq", search ?? HistorySearch); Add("hstate", state ?? HistoryState); Add("hfrom", from ?? HistoryFrom); Add("hto", to ?? HistoryTo);
        if (protectedOnly ?? HistoryProtected) q.Add("hprot=true");
        Nav.NavigateTo("execution-results?" + string.Join('&', q));
    }

    private async Task LoadStorageAsync(IExecutionEvidenceApiService api)
    {
        (_usage, var usageError) = await api.StorageAsync();
        (_retention, var retentionError) = await api.RetentionAsync();
        (_audit, _) = await api.AuditAsync();
        _error ??= usageError ?? retentionError;
        if (_retention is { } r) { _retentionMode = r.Mode; _retentionDays = r.Days; }
    }

    private void Toggle(Guid id, bool on) { if (on) _selectedRuns.Add(id); else _selectedRuns.Remove(id); }
    private void SelectAll(bool on) { if (on) foreach (var r in _runs ?? []) _selectedRuns.Add(r.RunId); else _selectedRuns.Clear(); }

    private static string AuthLabel(CallAuthenticationOutcome o) => o switch
    {
        CallAuthenticationOutcome.Authenticated => "Authenticated",
        CallAuthenticationOutcome.AnonymousByDesign => "Anonymous by design",
        CallAuthenticationOutcome.BlockedForAuthentication => "Blocked for authentication",
        CallAuthenticationOutcome.FailedAuthentication => "Failed authentication",
        CallAuthenticationOutcome.AuthorizationDenied => "Authorization denied",
        _ => "—",
    };

    private static string Bytes(long n) => n < 1024 ? $"{n} B" : n < 1024 * 1024 ? string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{n / 1024.0:0.0} KB")
        : string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{n / (1024.0 * 1024):0.0} MB");

    private async Task ProtectAsync(Guid runId, bool protect)
    {
        if (Api is not { } api) return;
        _busy = true; _message = null;
        _error = await api.ProtectAsync(runId, protect);
        _busy = false;
        if (_error is null)
        {
            _message = protect ? "Protected: the run is kept by bulk deletion and retention." : "Protection removed.";
            await OnParametersSetAsync();
        }
    }

    private async Task VerifyAsync()
    {
        if (Api is null || RunId is not { } run) return;
        _busy = true;
        (_integrity, _error) = await Api.IntegrityAsync(run);
        _busy = false;
    }

    private void AskDelete(DeleteScope scope) { _scope = scope; _typedConfirm = null; _message = null; }

    private async Task AskDeleteEligibleAsync()
    {
        if (Api is null) return;
        _eligibleEnvironment ??= _runs?.Select(r => r.EnvironmentId).FirstOrDefault();
        _scope = DeleteScope.Eligible; _typedConfirm = null; _message = null;
        await LoadEligibleAsync();
    }

    private async Task LoadEligibleAsync()
    {
        if (Api is null || string.IsNullOrEmpty(_eligibleEnvironment)) { _eligible = null; return; }
        (_eligible, _error) = await Api.DeletionPreviewAsync(_eligibleEnvironment);
    }

    private async Task SetEligibleEnvironmentAsync(string? environment) { _eligibleEnvironment = environment; _typedConfirm = null; await LoadEligibleAsync(); }

    private int ConfirmCount => _scope switch { DeleteScope.Selected => _selectedRuns.Count, DeleteScope.Eligible => _eligible?.Runs ?? 0, DeleteScope.Run => 1, _ => 0 };

    /// <summary>The number to type: what the person sees is what is deleted; a different number deletes nothing.</summary>
    private RenderFragment DeleteConfirmation() => __builder =>
    {
        if (_scope == DeleteScope.None) return;
        <div class="xr-confirm" role="group" aria-label="Confirm deletion" data-testid="xr-delete-confirm">
            @if (_scope == DeleteScope.Eligible)
            {
                <label>Environment
                    <select class="form-control" data-testid="xr-eligible-env" value="@_eligibleEnvironment" @onchange="e => SetEligibleEnvironmentAsync(e.Value?.ToString())">
                        @foreach (var env in (_runs ?? []).Select(r => r.EnvironmentId).Distinct().Order()) { <option value="@env">@env</option> }
                    </select>
                </label>
                @if (_eligible is { } p) { <p data-testid="xr-eligible-preview">@p.Runs finished, unprotected run(s) with @p.Calls call(s), @Bytes(p.Bytes) of stored evidence. Kept: @p.ProtectedKept protected, @p.RunningKept running.</p> }
            }
            else if (_scope == DeleteScope.Selected) { <p>Delete @_selectedRuns.Count selected run(s) and all their calls, attempts, bodies and assertions. Protected and running runs are skipped and listed.</p> }
            else { <p>Delete this run and all its calls, attempts, bodies and assertions. Other runs are not changed.</p> }
            <label>Type <strong>@ConfirmCount</strong> to confirm <input class="form-control xr-narrow" data-testid="xr-delete-typed" value="@_typedConfirm" @oninput="e => _typedConfirm = e.Value?.ToString()" /></label>
            <button type="button" class="btn-danger" data-testid="xr-delete-confirm-button" disabled="@(_busy || ConfirmCount == 0 || _typedConfirm != ConfirmCount.ToString(System.Globalization.CultureInfo.InvariantCulture))" @onclick="DeleteAsync">Delete</button>
            <button type="button" class="btn-secondary" data-testid="xr-delete-cancel" @onclick="() => _scope = DeleteScope.None">Cancel</button>
        </div>
    };

    private async Task DeleteAsync()
    {
        if (Api is not { } api) return;
        _busy = true; _error = null; _message = null;
        var request = _scope switch
        {
            DeleteScope.Eligible => new ExecutionDeletionRequest { EnvironmentId = _eligibleEnvironment, AllEligible = true, Confirm = ConfirmCount },
            DeleteScope.Run => new ExecutionDeletionRequest { RunIds = [RunId!.Value], Confirm = 1 },
            _ => new ExecutionDeletionRequest { RunIds = [.. _selectedRuns], Confirm = _selectedRuns.Count },
        };
        var (result, error) = await api.DeleteRunsAsync(request);
        _busy = false;
        if (result is null) { _error = error; return; }
        var scope = _scope;
        _scope = DeleteScope.None;
        _message = result.Message + (result.Skipped.Count > 0 ? " Not deleted: " + string.Join(" ", result.Skipped.Select(s => $"{_runs?.FirstOrDefault(r => r.RunId == s.RunId)?.Name ?? s.RunId.ToString()} — {s.Reason}")) : "");
        if (scope == DeleteScope.Run && result.Deleted == 1) { Nav.NavigateTo("execution-results?area=storage"); return; }
        _selectedRuns.Clear();
        await OnParametersSetAsync();
    }

    private async Task ExportSelectedAsync()
    {
        if (Api is not { } api) return;
        _busy = true; _error = null;
        var (zip, error) = await api.ExportAsync([.. _selectedRuns]);
        _busy = false;
        if (zip is null) { _error = error; return; }
        await JS.InvokeVoidAsync("downloadBase64File", $"execution-evidence-{_selectedRuns.Count}-runs.zip", Convert.ToBase64String(zip), "application/zip");
        _message = $"Exported {_selectedRuns.Count} run(s) from stored evidence; nothing was executed.";
    }

    private async Task RemoveBodiesAsync()
    {
        if (Api is null || RunId is not { } run || _call is not { } call) return;
        if (!_confirmBodies) { _confirmBodies = true; return; }
        _busy = true;
        var (removed, error) = await Api.RemoveBodiesAsync(run, call.CallId);
        _busy = false; _confirmBodies = false;
        if (error is not null) { _error = error; return; }
        _message = $"{removed} stored body(ies) removed; size and SHA-256 are kept.";
        (_call, _error) = await Api.CallAsync(run, call.CallId);
    }

    private void SetRetentionMode(string? value) => _retentionMode = Enum.TryParse<RetentionMode>(value, out var mode) ? mode : RetentionMode.Disabled;

    private async Task SaveRetentionAsync()
    {
        if (Api is not { } api) return;
        _busy = true; _message = null;
        (_retention, _error) = await api.SaveRetentionAsync(new(_retentionMode, _retentionMode == RetentionMode.Days ? _retentionDays : null));
        _busy = false; _retentionPreview = null;
        if (_error is null) { _message = _retentionMode == RetentionMode.Days ? $"Retention set to {_retentionDays} days. Nothing is deleted until you preview and apply it." : "Retention disabled."; await LoadStorageAsync(api); }
    }

    private async Task PreviewRetentionAsync()
    {
        if (Api is null) return;
        (_retentionPreview, _error) = await Api.RetentionPreviewAsync();
        _typedConfirm = null;
    }

    private async Task ApplyRetentionAsync()
    {
        if (Api is not { } api || _retentionPreview is not { } preview) return;
        _busy = true;
        var (result, error) = await api.ApplyRetentionAsync(preview.Runs);
        _busy = false; _retentionPreview = null; _typedConfirm = null;
        if (result is null) { _error = error; return; }
        _message = result.Message;
        await OnParametersSetAsync();
    }

    private RenderFragment StorageView() => __builder =>
    {
        <section class="xr-card" aria-labelledby="xr-storage-heading" data-testid="xr-storage">
            <h2 id="xr-storage-heading">Stored evidence</h2>
            @if (_usage is { } u)
            {
                <dl class="xr-kpis">
                    @Kpi("Runs", u.Runs, "runs")
                    @Kpi("Logical calls", u.LogicalCalls, "calls")
                    @Kpi("Attempts", u.Attempts, "attempts")
                    @KpiText("Stored (measured)", Bytes(u.StoredBytes), "stored")
                    @KpiText("Database tables", u.DatabaseTableBytes is { } t ? Bytes(t) : "Not available", "tables")
                    @Kpi("Protected runs", u.ProtectedRuns, "protected")
                    @Kpi("Retention candidates", u.RetentionCandidates, "candidates", u.RetentionCandidates > 0 ? Bytes(u.RetentionCandidateBytes) : null)
                </dl>
                <p class="xr-muted" data-testid="xr-storage-location">@u.Location @u.Note@(u.Oldest is { } o && u.Newest is { } n ? $" Oldest run {o.ToLocalTime():yyyy-MM-dd HH:mm}, newest {n.ToLocalTime():yyyy-MM-dd HH:mm}." : "")</p>
            }
            <details class="xr-details" data-testid="xr-retention">
                <summary>Retention</summary>
                <p class="xr-muted">Default: disabled — nothing is deleted automatically. With a period, older finished runs become candidates; you preview them and apply it yourself. Protected and running runs are always kept.</p>
                <div class="xr-filters">
                    <label>Retention
                        <select class="form-control" data-testid="xr-retention-mode" value="@_retentionMode" @onchange="e => SetRetentionMode(e.Value?.ToString())">
                            <option value="@RetentionMode.Disabled">Disabled</option><option value="@RetentionMode.Days">Keep for a number of days</option>
                        </select>
                    </label>
                    @if (_retentionMode == RetentionMode.Days)
                    {
                        <label>Days
                            <select class="form-control" data-testid="xr-retention-preset" value="@(_retentionDays is 7 or 30 or 90 ? _retentionDays.ToString() : "")" @onchange="e => _retentionDays = int.TryParse(e.Value?.ToString(), out var d) ? d : _retentionDays">
                                <option value="">Custom</option><option value="7">7</option><option value="30">30</option><option value="90">90</option>
                            </select>
                        </label>
                        <label>Custom days <input type="number" min="1" max="3650" class="form-control xr-narrow" data-testid="xr-retention-days" @bind="_retentionDays" /></label>
                    }
                    <button type="button" class="btn-secondary" data-testid="xr-retention-save" disabled="@_busy" @onclick="SaveRetentionAsync">Save retention</button>
                    <button type="button" class="btn-secondary" data-testid="xr-retention-preview" disabled="@(_busy || _retention?.Mode != RetentionMode.Days)" @onclick="PreviewRetentionAsync">Preview (dry run)</button>
                </div>
                @if (_retention is { UpdatedAt: { } at } saved) { <p class="xr-muted" data-testid="xr-retention-current">Saved: @(saved.Mode == RetentionMode.Days ? $"{saved.Days} days" : "disabled") · @at.ToLocalTime().ToString("yyyy-MM-dd HH:mm") by @saved.UpdatedBy</p> }
                @if (_retentionPreview is { } p)
                {
                    <div class="xr-confirm" data-testid="xr-retention-result">
                        <p>@p.Explanation</p>
                        <p data-testid="xr-retention-counts">@p.Runs run(s), @p.Calls call(s), @Bytes(p.Bytes) would be deleted. Kept: @p.ProtectedKept protected, @p.RunningKept running.</p>
                        @if (p.Runs > 0)
                        {
                            <label>Type <strong>@p.Runs</strong> to apply <input class="form-control xr-narrow" data-testid="xr-retention-typed" value="@_typedConfirm" @oninput="e => _typedConfirm = e.Value?.ToString()" /></label>
                            <button type="button" class="btn-danger" data-testid="xr-retention-apply" disabled="@(_busy || _typedConfirm != p.Runs.ToString(System.Globalization.CultureInfo.InvariantCulture))" @onclick="ApplyRetentionAsync">Apply retention</button>
                        }
                    </div>
                }
            </details>
            @if (_audit is { Count: > 0 } audit)
            {
                <details class="xr-details" data-testid="xr-audit">
                    <summary>Audit trail</summary>
                    <ul class="xr-list">@foreach (var a in audit) { <li data-testid="xr-audit-entry">@a.At.ToLocalTime().ToString("yyyy-MM-dd HH:mm") · @a.Action · @a.Scope · @a.Runs run(s), @a.Calls call(s), @Bytes(a.Bytes) · @a.Initiator</li> }</ul>
                </details>
            }
        </section>
    };

    private static RenderFragment KpiText(string label, string value, string key) => __builder =>
    {
        <div class="xr-kpi" data-testid="@($"xr-kpi-{key}")"><dt>@label</dt><dd><span class="xr-kpi-value">@value</span></dd></div>
    };

    private async Task CompareAsync()
    {
        if (Api is null || _call is null || RunId is not { } run || _picked.Count != 2) return;
        var pair = _picked.Order().ToArray();
        (_comparison, _error) = await Api.CompareAsync(run, _call.CallId, pair[0], run, _call.CallId, pair[1]);
    }

    private static string Label(ExecutionState s) => s switch { ExecutionState.NotAssessed => "Not assessed", ExecutionState.TimedOut => "Timed out", _ => s.ToString() };
    /// <summary>What the run executed against (its immutable manifest) and whether its unchanged result is still evidence for what is current.</summary>
    private RenderFragment ManifestPanel(ExecutionRunSummary run) => __builder =>
    {
        var a = _applicability;
        var (label, tone) = a?.Applicability switch
        {
            ResultApplicability.CurrentlyApplicable => ("Current definitions", "ok"),
            ResultApplicability.Historical => ("Historical result", "warn"),
            _ => ("Currency unknown", "neutral"),
        };
        <section class="xr-card" aria-labelledby="xr-manifest-heading" data-testid="xr-manifest" data-applicability="@(a?.Applicability.ToString() ?? "Unknown")">
            <h2 id="xr-manifest-heading">Executed against <span class="xr-pill xr-@tone" data-testid="xr-applicability">@label</span></h2>
            <p class="xr-muted" data-testid="xr-applicability-text">The @Label(run.State).ToLowerInvariant() result is unchanged. @(a?.Explanation ?? "No execution manifest was recorded for this run.")</p>
            @if (_manifest is { } m)
            {
                <table class="xr-table" data-testid="xr-manifest-table">
                    <caption class="visually-hidden">Definitions this run executed against</caption>
                    <thead><tr><th scope="col">Kind</th><th scope="col">Pinned reference</th><th scope="col">Stated by</th><th scope="col">Now</th></tr></thead>
                    <tbody>
                        @foreach (var dep in m.Dependencies)
                        {
                            var now = a?.Dependencies.FirstOrDefault(x => x.Pinned.Ref == dep.Ref);
                            <tr data-testid="xr-manifest-row" data-kind="@dep.Kind" data-state="@(now?.State.ToString() ?? "")">
                                <td>@DependencyKind(dep.Kind)</td>
                                <td><code>@dep.Ref</code>@if (dep.ContentFingerprint is { Length: >= 12 } fp) { <span class="xr-subline">sha256 @fp[..12]…</span> }@if (dep.Resolution == ManifestResolution.NotFound) { <span class="xr-subline">not found when the run started</span> }</td>
                                <td>@(dep.Origin == ManifestDependencyOrigin.OwnerResolved ? "BirkNext (materialised)" : "Caller (declared)")</td>
                                <td>@(now?.State switch { DependencyCurrencyState.Unchanged => "Unchanged", DependencyCurrencyState.Superseded => $"Superseded → {now.CurrentRef}", DependencyCurrencyState.Changed => "Changed", DependencyCurrencyState.Removed => "Removed", DependencyCurrencyState.NotVerifiable => "Not verifiable", _ => "–" })</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="xr-muted" data-testid="xr-manifest-build">BirkNext @m.Build.Version (@(m.Build.SourceCommit.Length > 12 ? m.Build.SourceCommit[..12] : m.Build.SourceCommit)) · dependency fingerprint <code>@(m.DependencyFingerprint.Length > 12 ? m.DependencyFingerprint[..12] : m.DependencyFingerprint)</code> · @m.SchemaVersion</p>
            }
        </section>
    };

    private static string DependencyKind(ManifestDependencyKind kind) => kind switch
    {
        ManifestDependencyKind.Contract => "Contract version",
        ManifestDependencyKind.ContractTest => "Test revision",
        ManifestDependencyKind.ContractChain => "Chain revision",
        ManifestDependencyKind.TestData => "Test Data version",
        ManifestDependencyKind.EndpointBinding => "Endpoint binding",
        ManifestDependencyKind.SourceSnapshot => "Source snapshot",
        ManifestDependencyKind.IntegrationSuite => "Integration suite revision",
        ManifestDependencyKind.CompositeContext => "Composite context revision",
        _ => kind.ToString(),
    };

    private static string Tone(ExecutionState s) => s switch
    {
        ExecutionState.Passed => "ok",
        ExecutionState.Failed or ExecutionState.Error or ExecutionState.TimedOut or ExecutionState.Interrupted => "bad",
        ExecutionState.Blocked or ExecutionState.Cancelled => "warn",
        ExecutionState.Running or ExecutionState.Planned or ExecutionState.Queued => "info",
        _ => "neutral",
    };

    private static RenderFragment Kpi(string label, int value, string key, string? note = null) => __builder =>
    {
        <div class="xr-kpi" data-testid="@($"xr-kpi-{key}")"><dt>@label</dt><dd><span class="xr-kpi-value">@value</span>@if (note is not null) { <span class="xr-kpi-note" data-testid="xr-kpi-note">@note</span> }</dd></div>
    };

    private RenderFragment Select(string label, string testId, string? value, Action<string> set, IEnumerable<string> options, bool includeAll = true) => __builder =>
    {
        <label>@label
            <select class="form-control" data-testid="@testId" value="@(value ?? (includeAll ? "" : "sequence"))" @onchange="e => set(e.Value?.ToString() ?? string.Empty)">
                @if (includeAll) { <option value="">All</option> }
                @foreach (var o in options) { <option value="@o">@o</option> }
            </select>
        </label>
    };

    private static RenderFragment Headers(List<CapturedHeader> headers, string testId) => __builder =>
    {
        <table class="xr-table xr-compact" data-testid="@testId"><caption class="visually-hidden">Headers</caption><tbody>
            @foreach (var h in headers) { <tr><th scope="row">@h.Name</th><td class="xr-mono">@h.Value@if (h.Redacted) { <span class="xr-redacted" data-testid="xr-redacted"> redacted</span> }</td></tr> }
        </tbody></table>
    };

    private static RenderFragment Body(CapturedBody? body, string testId) => __builder =>
    {
        if (body is null) { <p class="xr-muted">No body.</p> return; }
        <p class="xr-muted" data-testid="@($"{testId}-meta")" data-completeness="@body.Completeness">@body.ContentType · @body.ByteCount bytes · @body.Completeness@(body.RedactedFields > 0 ? $" · {body.RedactedFields} value(s) redacted" : "")@(body.Note is { } n ? $" · {n}" : "")</p>
        if (body.Text is { } text) { <pre class="xr-body" data-testid="@testId" tabindex="0">@Pretty(text, body.ContentType)</pre> }
    };

    /// <summary>JSON is indented for reading only; the stored evidence is unchanged. Everything else is shown as escaped text.</summary>
    private static string Pretty(string text, string? contentType)
    {
        if ((contentType ?? "").Contains("json", StringComparison.OrdinalIgnoreCase))
            try { return JsonNode.Parse(text)?.ToJsonString(new JsonSerializerOptions { WriteIndented = true }) ?? text; } catch (JsonException) { }
        return text;
    }

    private static RenderFragment RequestView(CapturedRequest req, ExecutionCallDefinition d) => __builder =>
    {
        <p class="xr-mono" data-testid="xr-request-line"><strong>@req.Method</strong> @req.Url</p>
        if (req.GraphQlOperationType is { } type) { <p data-testid="xr-request-graphql">GraphQL @type@(req.GraphQlOperationName is { } name ? $" {name}" : "")</p> }
        <h3 class="xr-h3">Headers sent</h3>
        @Headers(req.Headers, "xr-request-headers")
        <h3 class="xr-h3">Body sent</h3>
        @Body(req.Body, "xr-request-body")
        <p class="xr-muted">Captured at the transport boundary at @req.CapturedAt.ToLocalTime().ToString("HH:mm:ss.fff"), after redaction — not a preview.</p>
    };

    private static RenderFragment ResponseView(CapturedResponse resp) => __builder =>
    {
        <p data-testid="xr-response-status"><strong>HTTP @resp.StatusCode</strong> @resp.ReasonPhrase · @resp.DurationMs ms@(resp.InvalidJson ? " · invalid JSON" : "")</p>
        if (resp.GraphQlErrorCount is { } errors)
        {
            <div class="xr-gql" data-testid="xr-graphql">
                <p>GraphQL: data @(resp.GraphQlHasData == true ? "present" : "absent") · @errors error(s)@(errors > 0 && resp.GraphQlHasData == true ? " (partial result)" : "")</p>
                @if (errors > 0) { <ul class="xr-list" data-testid="xr-graphql-errors">@for (var i = 0; i < resp.GraphQlErrorMessages.Count; i++) { <li>@resp.GraphQlErrorMessages[i]@(i < resp.GraphQlErrorPaths.Count ? $" · path {resp.GraphQlErrorPaths[i]}" : "")</li> }</ul> }
                @if (resp.GraphQlErrorCodes.Count > 0) { <p>Codes: @string.Join(", ", resp.GraphQlErrorCodes)</p> }
            </div>
        }
        <h3 class="xr-h3">Headers received</h3>
        @Headers(resp.Headers, "xr-response-headers")
        <h3 class="xr-h3">Body received</h3>
        @Body(resp.Body, "xr-response-body")
    };
}

@code {
    // ── Test Execution & Evidence fragments (markup only; state and loading in ExecutionResults.razor.cs) ─────────────────────────────────────

    private RenderFragment OutcomeBadge(ExplorerOutcome o, string? testId = null) => __builder =>
