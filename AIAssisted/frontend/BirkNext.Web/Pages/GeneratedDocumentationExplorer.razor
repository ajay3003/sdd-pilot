@page "/generated-documentation-explorer"
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using Microsoft.AspNetCore.WebUtilities
@using Gde = BirkNext.Web.Services.GeneratedDocumentationExplorer
@inject IServiceProvider ServiceProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Generated Documentation Explorer — QA Review Studio</PageTitle>

@* Structured, read-only browsing of the generated (implementation-derived) documentation an import captured. Content is resolved by
   fingerprint from the existing generated-content store; nothing is copied, edited or persisted. Health and freshness belong to Generated
   Documentation Health, comparison to Documentation Drift, raw source to Source Analysis. *@
<div class="gde-page" data-testid="gde-page">
    <PageHeader Title="Generated Documentation Explorer" Description="@Intro" />
    <BirkNext.Web.Components.ProjectContextStrip RequiresEnvironment="false" />
    <p class="gde-boundary" data-testid="gde-boundary">Generated documentation is implementation-derived documentation. It is not source truth, runtime truth, an approved specification or implementation verification.</p>

    @if (_imports.Count == 0)
    {
        <section class="gde-empty" role="status" data-testid="gde-no-import">
            <p>No imported project has generated documentation. Generated documentation is detected when a project is imported with its source.</p>
            <p><a class="btn-secondary" href="project-import">Import Project</a></p>
        </section>
    }
    else
    {
        <div class="gde-selectors" data-testid="gde-selectors">
            <label class="gde-field">Project / import
                <select data-testid="gde-import" @onchange="ImportChanged">
                    @foreach (var i in _imports) { <option value="@i.ImportId" selected="@(i.ImportId == _importId)">@i.Label</option> }
                </select>
            </label>
            <label class="gde-field">Module
                <select data-testid="gde-module" @onchange="ModuleChanged">
                    @foreach (var m in Modules) { <option value="@m" selected="@(m == _module)">@m</option> }
                </select>
            </label>
        </div>

        @* Only documents the module actually has: absence of a document type is neutral, never "Missing". *@
        <section aria-labelledby="gde-docs-h" data-testid="gde-module-documents">
            <h2 id="gde-docs-h">@_module · generated documentation</h2>
            <ul class="gde-cards">
                @foreach (var d in ModuleDocuments)
                {
                    var doc = d;
                    @* One control per document: selecting the card opens it in Read (no separate Open button). *@
                    <li class="gde-card @(doc.Path == _selectedPath ? "is-selected" : "") @(doc.ContentAvailable ? "" : "is-unavailable")" data-testid="gde-document-card" data-role="@doc.Role"
                        data-state="@(doc.ContentAvailable ? "available" : "unavailable")" aria-current="@(doc.Path == _selectedPath ? "true" : null)">
                        <button type="button" class="gde-card-button" data-testid="gde-open" aria-pressed="@(doc.Path == _selectedPath ? "true" : "false")" @onclick="() => Select(doc.Path)">
                            <strong class="gde-card-title">@doc.RoleLabel</strong>
                            <span class="gde-muted gde-wrap gde-card-path"><code>@doc.Path</code></span>
                            <span class="gde-card-state gde-state-@(doc.ContentAvailable ? "available" : "unavailable")" data-testid="gde-card-state">@Gde.Availability(doc)</span>
                        </button>
                    </li>
                }
            </ul>
        </section>

        @if (_view is { } view)
        {
            var d = view.Document;
            <section class="gde-document" aria-labelledby="gde-doc-h" data-testid="gde-document">
                <h2 id="gde-doc-h" tabindex="-1">@d.Module · Generated @d.RoleLabel</h2>
                <dl class="gde-facts">
                    <div><dt>Source</dt><dd><code class="gde-wrap" data-testid="gde-source-path">@d.Path</code></dd></div>
                    <div><dt>Origin</dt><dd data-testid="gde-origin">@Gde.Origin</dd></div>
                    <div><dt>Generator</dt><dd data-testid="gde-generator">@(d.Document.Generator ?? "Generated documentation detected · generator not established")</dd></div>
                    <div><dt>Content</dt><dd data-testid="gde-parse-state">@view.StateLabel</dd></div>
                </dl>
                <p class="gde-actions">
                    @if (Gde.DriftConcernOf(d.Role) is { } concern && !d.RepositoryLevel)
                    {
                        <a class="btn-secondary btn-small" data-testid="gde-compare-drift" href="@($"documentation-drift?tab=compare&import={Uri.EscapeDataString(_importId)}&module={Uri.EscapeDataString(d.Module)}&concern={concern}")">Compare in Documentation Drift</a>
                    }
                    <a class="btn-link" data-testid="gde-open-health" href="@($"{NavigationCatalog.GeneratedDocumentationHealthRoute}?import={Uri.EscapeDataString(_importId)}{(d.Document.SourceSnapshotId is { } healthSnapshot ? $"&snapshot={healthSnapshot}" : "")}")">Open Generated Documentation Health</a>
                    @if (d.Document.SourceSnapshotId is { } snapshot)
                    {
                        <a class="btn-link" data-testid="gde-open-source" href="@($"source-analysis?snapshot={snapshot}")">Related Source Analysis snapshot</a>
                    }
                </p>
                <div class="gde-tabs gde-sticky" role="tablist" aria-label="Document views" data-testid="gde-tabs">
                    @foreach (var (tab, label) in Gde.ViewTabs)
                    {
                        var t = tab;
                        <button type="button" role="tab" class="@(_tab == t ? "is-current" : "")" aria-selected="@(_tab == t ? "true" : "false")" aria-controls="gde-tabpanel" data-testid="gde-tab" data-tab="@t" @onclick="() => SetTab(t)">@label</button>
                    }
                </div>
                <label class="gde-field gde-search">Search this document <input type="search" @bind="_search" @bind:event="oninput" data-testid="gde-search" /></label>
                @if (!string.IsNullOrWhiteSpace(_search))
                {
                    <ul class="gde-plain" data-testid="gde-search-results">@foreach (var (line, text) in Gde.Search(view.Content, _search)) { <li><span class="gde-muted">L@(line)</span> @text</li> }</ul>
                }
                <div id="gde-tabpanel" role="tabpanel" aria-label="@_tab">
                @if (view.State == GeneratedDocumentParseState.ContentUnavailable && _tab is "Read" or "Structure" or "Source")
                {
                    <p class="gde-note" role="status" data-testid="gde-content-unavailable"><strong>Detected — content unavailable.</strong> @Gde.ContentUnavailableText</p>
                }
                else
                {
                    @switch (_tab)
                    {
                        case "Read": @Read(view) break;
                        case "Structure": @Outline(view) break;
                        case "Source": @Source(view) break;
                        default: @Provenance(view) break;
                    }
                }
                </div>
            </section>
        }
    }
</div>

@code {
    private const string Intro = "Browse generated (implementation-derived) documentation by module, structured by document type. Read-only.";
    private static readonly DataModelAnalysisService Parser = new();
    private IReadOnlyList<DriftDocument> _catalog = [];
    private IReadOnlyList<DriftImport> _imports = [];
    private string _importId = "", _module = "", _selectedPath = "", _tab = "Read", _search = "", _outlineFilter = "";
    private IReadOnlyList<GeneratedReadSegment> _segments = [];
    private IReadOnlyList<GeneratedOutlineItem> _outline = [];
    private string? _pendingAnchor, _copyStatus;

    /// <summary>Copies the imported source exactly (read-only: nothing is changed).</summary>
    private async Task CopySourceAsync(string? content)
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", content ?? ""); _copyStatus = "Copied."; }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException) { _copyStatus = "Copy is not available in this browser."; }
    }
    private GeneratedDocumentView? _view;
    private BirkNext.SourceDomains.SourceContract? _contract;
    private bool _contractLoading, _focusDocument;

    private WorkspaceArtifactRepository? Repository => ServiceProvider.GetService(typeof(IWorkspaceArtifactRepository)) as WorkspaceArtifactRepository
        ?? ServiceProvider.GetService(typeof(WorkspaceArtifactRepository)) as WorkspaceArtifactRepository;

    private IReadOnlyList<GeneratedExplorerDocument> Documents => Gde.Documents(_catalog, _importId);
    private IReadOnlyList<string> Modules => Gde.Modules(Documents);
    private IReadOnlyList<GeneratedExplorerDocument> ModuleDocuments => Documents.Where(d => d.Module == _module).ToList();

    protected override void OnInitialized()
    {
        if (Repository?.SddLifecycle is not { } state) return;
        _catalog = DocumentationDrift.Catalog(state);
        var withDocs = _catalog.Where(d => d.Origin == DriftOrigin.Generated).Select(d => d.ProjectImportId).ToHashSet();
        _imports = DocumentationDrift.Imports(state).Where(i => withDocs.Contains(i.ImportId)).ToList();
        var query = QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        _importId = query.TryGetValue("import", out var import) && _imports.Any(i => i.ImportId == import.ToString()) ? import.ToString()
            : _imports.FirstOrDefault(i => i.ImportId == state.CurrentProjectImportId)?.ImportId ?? _imports.LastOrDefault()?.ImportId ?? "";
        _module = query.TryGetValue("module", out var module) && Modules.Contains(module.ToString()) ? module.ToString() : Modules.FirstOrDefault() ?? "";
        if (query.TryGetValue("document", out var document) && ModuleDocuments.Any(d => d.Path == document.ToString()))
        {
            Select(document.ToString(), updateUrl: false);
            // An explicit ?view= (read, outline/structure, source, provenance; the former overview opens Provenance) is honoured once, on arrival.
            if (query.TryGetValue("view", out var requested) && Gde.ViewFromQuery(requested.ToString()) is { } explicitView) _tab = explicitView;
        }
    }

    private void SetTab(string tab)
    {
        _tab = tab;
        SyncUrl();
    }

    /// <summary>The selected document and view in the URL (replace: refresh and shared links reopen it; no history entry per tab click).</summary>
    private void SyncUrl()
    {
        if (_selectedPath.Length == 0) return;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["import"] = _importId, ["module"] = _module, ["document"] = _selectedPath, ["view"] = _tab == "Read" ? null : Gde.ViewSlug(_tab),
        }), replace: true);
    }

    /// <summary>Outline → the heading in Read: switch to Read, then scroll to the heading once it is rendered.</summary>
    private void GoToHeading(string anchorId)
    {
        _tab = "Read";
        _pendingAnchor = anchorId;
        SyncUrl();
    }

    private void ImportChanged(ChangeEventArgs e) { _importId = e.Value?.ToString() ?? ""; _module = Modules.FirstOrDefault() ?? ""; _view = null; _selectedPath = ""; }
    private void ModuleChanged(ChangeEventArgs e) { _module = e.Value?.ToString() ?? ""; _view = null; _selectedPath = ""; }

    private void Select(string path) => Select(path, updateUrl: true);

    private void Select(string path, bool updateUrl)
    {
        if (Repository?.SddLifecycle is not { } state || ModuleDocuments.FirstOrDefault(d => d.Path == path) is not { } doc) return;
        // Opening a document reads it: Read is the default view (metadata lives under Provenance).
        _selectedPath = path; _tab = "Read"; _search = ""; _outlineFilter = ""; _contract = null; _pendingAnchor = null;
        var content = DocumentationDrift.Text(state, doc.Document);
        _view = Gde.View(doc, content, Parser);
        // Parsed once per selection, never per tab switch.
        _segments = DocumentationDrift.IsMarkdown(doc.Path) ? Gde.ReadSegments(content) : [];
        _outline = Gde.Outline(_segments);
        _focusDocument = true;
        if (updateUrl) SyncUrl();
        // OpenAPI / GraphQL: the backend's Source Analysis readers give the structure (stateless; no remote refs, no introspection).
        if (doc.Role is GeneratedDocumentRole.ApiContract or GeneratedDocumentRole.GraphQlSchema && content is not null && !DocumentationDrift.IsMarkdown(doc.Path)
            && ServiceProvider.GetService(typeof(IGeneratedDocumentationApiService)) is IGeneratedDocumentationApiService api)
            _ = LoadContractAsync(api, doc.Path, content);
    }

    private async Task LoadContractAsync(IGeneratedDocumentationApiService api, string path, string content)
    {
        _contractLoading = true;
        try { var contract = await api.StructureAsync(path, content); if (_selectedPath == path) _contract = contract; }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { _contract = null; }
        finally { _contractLoading = false; await InvokeAsync(StateHasChanged); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingAnchor is { } anchor)
        {
            _pendingAnchor = null;
            try { await JS.InvokeVoidAsync("birknextFocusElement", anchor); } catch (JSException) { }
            return;
        }
        if (!_focusDocument) return;
        _focusDocument = false;
        try { await JS.InvokeVoidAsync("birknextFocusElement", "gde-doc-h"); } catch (JSException) { }
    }

    /// <summary>
    /// Read: the document itself, in source order — Markdown rendered safely (raw HTML shown as text, no remote images, safe links) and every
    /// recognised diagram drawn from its own source. Non-Markdown artifacts (OpenAPI/GraphQL files) are read through their structure.
    /// </summary>
    private RenderFragment Read(GeneratedDocumentView v) => __builder =>
    {
        if (!DocumentationDrift.IsMarkdown(v.Document.Path))
        {
            <div data-testid="gde-read" data-format="structured">@Structure(v)</div>
            return;
        }
        <article class="gde-read markdown-content" data-testid="gde-read" data-format="markdown" aria-label="@($"{v.Document.RoleLabel} document")">
            @for (var i = 0; i < _segments.Count; i++)
            {
                var segment = _segments[i];
                if (segment.Diagram is { } diagram)
                {
                    <BirkNext.Web.Components.GeneratedDiagramView Source="@diagram" Heading="@HeadingBefore(i)" />
                }
                else
                {
                    @((MarkupString)Gde.RenderSegment(i, segment.Markdown!))
                }
            }
        </article>
        @if (v.State == GeneratedDocumentParseState.PartiallyParsed)
        {
            <p class="gde-muted gde-read-note" data-testid="gde-partial-read">All of this document is shown above. Some of it has no structured interpretation (see Outline); that is not an error in the document.</p>
        }
    };

    /// <summary>The nearest heading before a segment (the diagram's caption), from the outline already computed.</summary>
    private string HeadingBefore(int segment)
    {
        var prefix = $"gde-s";
        var before = _outline.LastOrDefault(o => int.TryParse(o.AnchorId[prefix.Length..o.AnchorId.IndexOf('-', prefix.Length)], out var s) && s < segment);
        return before?.Text ?? _view?.Document.RoleLabel ?? "Document";
    }

    /// <summary>Outline: the document's own headings (click to read that section), then the structured interpretation on request.</summary>
    private RenderFragment Outline(GeneratedDocumentView v) => __builder =>
    {
        var items = _outline.Where(o => _outlineFilter.Trim().Length == 0 || o.Text.Contains(_outlineFilter.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
        <nav class="gde-outline" aria-label="Document outline" data-testid="gde-outline">
            @if (_outline.Count > 0)
            {
                <label class="gde-field gde-outline-filter">Filter headings <input type="search" data-testid="gde-outline-filter" @bind="_outlineFilter" @bind:event="oninput" /></label>
                <p class="gde-muted" role="status" data-testid="gde-outline-count">@items.Count of @_outline.Count headings</p>
                <ol class="gde-outline-list">
                    @foreach (var item in items)
                    {
                        <li class="gde-outline-l@(Math.Min(item.Level, 4))"><button type="button" class="btn-link" data-testid="gde-outline-item" data-anchor="@item.AnchorId" @onclick="() => GoToHeading(item.AnchorId)">@item.Text</button></li>
                    }
                </ol>
            }
            else { <p class="gde-muted" data-testid="gde-outline-empty">This document has no headings to navigate.</p> }
        </nav>
        <details class="gde-structured" data-testid="gde-structured" open="@(!DocumentationDrift.IsMarkdown(v.Document.Path) || v.DataModel is not null || v.ChangeLog.Count > 0)">
            <summary>Structured interpretation (@v.StateLabel)</summary>
            @Structure(v)
        </details>
    };

    /// <summary>A fenced block: a recognised diagram as participants/steps or nodes/edges (source behind a disclosure); other code as code.</summary>
    private static RenderFragment CodeBlock(string block, string heading) => __builder =>
    {
        if (!GeneratedDiagrams.IsDiagram(block)) { <pre class="gde-code">@block</pre> return; }
        <BirkNext.Web.Components.GeneratedDiagramView Source="@block" Heading="@heading" InitialMode="steps" />
    };

    /// <summary>Document facts (formerly the Overview tab): technical metadata, shown with the provenance — never before the content.</summary>
    private RenderFragment DocumentFacts(GeneratedDocumentView v) => __builder =>
    {
        <dl class="gde-facts" data-testid="gde-overview">
            <div><dt>Title</dt><dd>@(v.Title ?? "Not stated")</dd></div>
            <div><dt>Document type</dt><dd>@v.Document.RoleLabel</dd></div>
            <div><dt>Module</dt><dd>@v.Document.Module</dd></div>
            <div><dt>Lines</dt><dd>@v.LineCount</dd></div>
            <div><dt>Size</dt><dd>@v.ByteSize bytes</dd></div>
            <div><dt>Headings</dt><dd data-testid="gde-heading-count">@v.HeadingCount</dd></div>
            <div><dt>Structured items</dt><dd data-testid="gde-structured-count">@v.StructuredItems</dd></div>
            <div><dt>Content captured</dt><dd>@(v.Document.ContentAvailable ? "Yes" : "No")</dd></div>
            <div><dt>Fingerprint</dt><dd><code>@Short(v.Document.Document.Fingerprint)</code></dd></div>
            <div><dt>Freshness</dt><dd>See Generated Documentation Health</dd></div>
        </dl>
        @if (v.State == GeneratedDocumentParseState.PartiallyParsed) { <p class="gde-note" data-testid="gde-partial">Structured coverage: Partial. @Gde.PartialCoverage</p> }
    };

    private RenderFragment Structure(GeneratedDocumentView v) => __builder =>
    {
        <div data-testid="gde-structure" data-role="@v.Document.Role">
        @if (v.DataModel is { } model)
        {
            <p class="gde-muted" data-testid="gde-dm-summary">@model.Entities.Count entities · @model.Entities.Sum(e => e.Columns.Count) fields · @model.Relationships.Count relationships · @model.Indexes.Count indexes · @model.Constraints.Count constraints</p>
            @foreach (var e in model.Entities)
            {
                <details class="gde-entity" data-testid="gde-entity" data-name="@e.Name"><summary><strong>@e.Name</strong> <span class="gde-muted">@e.Columns.Count fields</span></summary>
                    <table class="gde-table"><thead><tr><th>Field</th><th>Type</th><th>Nullable</th><th>Key</th></tr></thead><tbody>
                        @foreach (var c in e.Columns) { <tr><td>@c.Name</td><td>@(c.Type ?? "Not stated")</td><td>@(c.Nullable switch { true => "Yes", false => "No", _ => "Not stated" })</td><td>@(c.IsPrimaryKey ? "PK" : c.IsForeignKey ? "FK" : "—")</td></tr> }
                    </tbody></table>
                    @foreach (var r in model.Relationships.Where(r => r.Source.StartsWith(e.Name + ".", StringComparison.OrdinalIgnoreCase) || r.Source == e.Name)) { <p class="gde-muted">→ @r.Target (@r.RelationshipType)</p> }
                </details>
            }
            @if (model.NotStatedInGeneratedDocumentation.Count > 0) { <details><summary>Not stated in the generated documentation (@model.NotStatedInGeneratedDocumentation.Count)</summary><ul class="gde-plain">@foreach (var n in model.NotStatedInGeneratedDocumentation) { <li>@n</li> }</ul></details> }
        }
        else if (v.ChangeLog.Count > 0)
        {
            <p class="gde-muted" data-testid="gde-changelog-summary">@v.ChangeLog.Count release@(v.ChangeLog.Count == 1 ? "" : "s") · latest @v.ChangeLog[0].Version@(v.ChangeLog[0].Date is { } latestDate ? $" ({latestDate})" : "")</p>
            @for (var i = 0; i < v.ChangeLog.Count; i++)
            {
                var version = v.ChangeLog[i];
                <section class="gde-version" data-testid="gde-changelog-version">
                    <ReviewDisclosure Text="@($"{version.Version}{(version.Date is { } date ? $" · {date}" : "")} · {version.Groups.Sum(g => g.Entries.Count)} change(s)")" Expanded="@(i == 0)" Class="disclosure-inline">
                        @foreach (var (category, entries) in version.Groups) { <p><strong data-testid="gde-changelog-category">@category</strong></p><ul class="gde-plain">@foreach (var entry in entries) { <li>@entry</li> }</ul> }
                    </ReviewDisclosure>
                </section>
            }
        }
        else if (v.Document.Role is GeneratedDocumentRole.ApiContract or GeneratedDocumentRole.GraphQlSchema && !DocumentationDrift.IsMarkdown(v.Document.Path))
        {
            @ContractStructure(v)
        }
        else
        {
            @foreach (var s in v.Sections.Where(s => s.Level > 0))
            {
                <section class="gde-section gde-level-@Math.Min(s.Level, 4)" data-testid="gde-section" data-heading="@s.Heading">
                    <h3>@s.Heading <span class="gde-muted">L@(s.Line)</span></h3>
                    @if (s.OrderedSteps.Count > 0) { <ol data-testid="gde-steps">@foreach (var step in s.OrderedSteps) { <li>@step</li> }</ol> }
                    @if (s.Items.Count > 0) { <ul>@foreach (var item in s.Items) { <li>@item</li> }</ul> }
                    @foreach (var t in s.Tables)
                    {
                        <div class="gde-table-wrap" tabindex="0" role="region" aria-label="@s.Heading table"><table class="gde-table" data-testid="gde-table"><thead><tr>@foreach (var h in t.Header) { <th>@h</th> }</tr></thead>
                            <tbody>@foreach (var row in t.Rows) { <tr>@foreach (var cell in row) { <td>@cell</td> }</tr> }</tbody></table></div>
                    }
                    @foreach (var block in s.CodeBlocks) { @CodeBlock(block, s.Heading) }
                    @if (s.Prose.Count > 0) { <details><summary>Text (@s.Prose.Count)</summary>@foreach (var p in s.Prose) { <p>@p</p> }</details> }
                </section>
            }
        }
        @if (v.UnmappedLines > 0)
        {
            <details class="gde-unmapped" data-testid="gde-unmapped"><summary>Source content not structured (@v.UnmappedLines)</summary>
                <p class="gde-muted">Informational: content kept as text because it has no structured concept here. Not a defect; all content remains available in Source view.</p>
            </details>
        }
        </div>
    };

    /// <summary>Source: exactly what was imported/generated — raw, in its own format (never transformed into Markdown).</summary>
    private RenderFragment Source(GeneratedDocumentView v) => __builder =>
    {
        <div data-testid="gde-source">
            <div class="gde-source-bar">
                <p class="gde-muted" data-testid="gde-source-language">Raw @Gde.SourceLanguage(v.Document.Path) · @v.LineCount lines · @v.ByteSize bytes</p>
                <button type="button" class="btn-secondary btn-small" data-testid="gde-source-copy" @onclick="() => CopySourceAsync(v.Content)">Copy source</button>
                @if (_copyStatus is not null) { <span class="gde-muted" role="status" data-testid="gde-source-copied">@_copyStatus</span> }
            </div>
            @* The original text, unchanged, with line numbers beside it (the numbers are not part of the copied source). *@
            <div class="gde-code gde-raw" data-testid="gde-raw">
                <ol class="gde-lines" data-testid="gde-source-lines" aria-label="@($"{v.Document.RoleLabel} source with line numbers")">
                    @foreach (var line in Gde.SourceLines(v.Content)) { <li><code>@line</code></li> }
                </ol>
            </div>
            <p class="gde-muted">Read-only. Generated documentation is never edited here.</p>
        </div>
    };

    /// <summary>OpenAPI / GraphQL structure from the backend's Source Analysis readers: operations grouped by path or kind, types with their fields.</summary>
    private RenderFragment ContractStructure(GeneratedDocumentView v) => __builder =>
    {
        if (_contractLoading) { <InlineLoading Text="Reading the contract structure…" Class="gde-muted" /> return; }
        if (_contract is not { } c) { <p class="gde-note" role="status" data-testid="gde-contract-unparsed">The structure could not be read from this artifact. Its full content is in the Source tab.</p> return; }
        var graphQl = v.Document.Role == GeneratedDocumentRole.GraphQlSchema;
        <div data-testid="gde-contract" data-kind="@(graphQl ? "graphql" : "openapi")">
            <p class="gde-muted" data-testid="gde-contract-summary">@c.Name@(c.Version is { } version ? $" · {version}" : "") · @c.Operations.Count operation@(c.Operations.Count == 1 ? "" : "s") · @c.Types.Count type@(c.Types.Count == 1 ? "" : "s")@(c.ParseSupport == BirkNext.SourceDomains.DomainSupport.Partial ? " · partially parsed" : "")</p>
            @foreach (var group in c.Operations.GroupBy(o => graphQl ? o.Kind : o.Path ?? o.Name))
            {
                <section class="gde-section" data-testid="gde-contract-group">
                    <h3>@group.Key <span class="gde-muted">@group.Count()</span></h3>
                    <ul class="gde-plain">
                        @foreach (var op in group)
                        {
                            <li data-testid="gde-contract-operation"><strong>@op.Name</strong>@if (op.Summary is { } summary) { <span> — @summary</span> }
                                @if (op.OperationId is { } opId) { <span class="gde-muted"> · @opId</span> }
                                @if (op.Parameters.Count > 0) { <span class="gde-muted"> · parameters: @string.Join(", ", op.Parameters)</span> }
                                @if (op.RequestSchema is { } request) { <span class="gde-muted"> · request: @request</span> }
                                @if (op.ResponseCodes.Count > 0) { <span class="gde-muted"> · responses: @string.Join(", ", op.ResponseCodes)</span> }
                                @if (op.Security.Count > 0) { <span class="gde-muted"> · security: @string.Join(", ", op.Security)</span> }
                                @if (op.ResultType is { } result) { <span class="gde-muted"> · returns @result</span> }</li>
                        }
                    </ul>
                </section>
            }
            @if (c.Types.Count > 0)
            {
                <ReviewDisclosure Text="@($"Show {(graphQl ? "types" : "schemas")} ({c.Types.Count})")" CollapseText="Hide types" Class="disclosure-inline">
                    @foreach (var type in c.Types)
                    {
                        <details class="gde-entity" data-testid="gde-contract-type"><summary><strong>@type.Name</strong> <span class="gde-muted">@type.Kind · @type.Fields.Count field@(type.Fields.Count == 1 ? "" : "s")</span></summary>
                            <table class="gde-table"><thead><tr><th>Field</th><th>Type</th><th>Required</th></tr></thead><tbody>
                                @foreach (var f in type.Fields) { <tr><td>@f.Name</td><td>@f.Type</td><td>@(f.Required ? "Yes" : "No")</td></tr> }
                            </tbody></table>
                            @if (type.Values.Count > 0) { <p class="gde-muted">Values: @string.Join(", ", type.Values)</p> }
                        </details>
                    }
                </ReviewDisclosure>
            }
            @if (c.Limitations.Count > 0) { <p class="gde-muted" data-testid="gde-contract-limitations">@string.Join(" ", c.Limitations)</p> }
            <p class="gde-muted">Static, imported document only: no remote reference is resolved and no endpoint is called.</p>
        </div>
    };

    private RenderFragment Provenance(GeneratedDocumentView v) => __builder =>
    {
        var d = v.Document.Document;
        @DocumentFacts(v)
        <p data-testid="gde-provenance-summary">Generated by @(d.Generator ?? "an unidentified generator") from Source Analysis snapshot @(d.SourceSnapshotId is { } snap ? snap.ToString()[..8] : "(not known)")@(d.ImportedAt is { } importedAt ? $", imported {importedAt.ToLocalTime():g}" : "").</p>
        <dl class="gde-facts" data-testid="gde-provenance">
            <div><dt>Project / import</dt><dd>@(d.ProjectRevision ?? "—")</dd></div>
            <div><dt>Module</dt><dd>@v.Document.Module</dd></div>
            <div><dt>Generated-document set</dt><dd><code>@d.GeneratedSetId</code></dd></div>
            <div><dt>Relative path</dt><dd><code class="gde-wrap">@d.Path</code></dd></div>
            <div><dt>Generated kind</dt><dd>@d.TypeLabel.Replace("Generated · ", "")</dd></div>
            <div><dt>Generator</dt><dd>@(d.Generator ?? "Not established")</dd></div>
            <div><dt>Fingerprint</dt><dd><code data-testid="gde-fingerprint">@d.Fingerprint</code></dd></div>
            <div><dt>Content captured</dt><dd>@(v.Document.ContentAvailable ? "Yes" : "No")</dd></div>
            <div><dt>Source snapshot</dt><dd><code>@(d.SourceSnapshotId?.ToString() ?? "Not known")</code></dd></div>
            <div><dt>Imported at</dt><dd>@(d.ImportedAt?.ToLocalTime().ToString("g") ?? "—")</dd></div>
        </dl>
    };

    private static string Short(string fingerprint) => fingerprint.Length > 12 ? fingerprint[..12] : fingerprint;
}
