@page "/generated-documentation-explorer"
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using Microsoft.AspNetCore.WebUtilities
@using Gde = BirkNext.Web.Services.GeneratedDocumentationExplorer
@inject IServiceProvider ServiceProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Generated Documentation Explorer — QA Review Studio</PageTitle>

@* Structured, read-only browsing of the generated (implementation-derived) documentation an import captured. Content is resolved by
   fingerprint from the existing generated-content store; nothing is copied, edited or persisted. Health and freshness belong to Generated
   Documentation Health, comparison to Documentation Drift, raw source to Source Analysis. *@
<div class="gde-page" data-testid="gde-page">
    <PageHeader Title="Generated Documentation Explorer" Description="@Intro" />
    <BirkNext.Web.Components.ProjectContextStrip RequiresEnvironment="false" />
    <p class="gde-boundary" data-testid="gde-boundary">Generated documentation is implementation-derived documentation. It is not source truth, runtime truth, an approved specification or implementation verification.</p>

    @if (_imports.Count == 0)
    {
        <section class="gde-empty" role="status" data-testid="gde-no-import">
            <p>No imported project has generated documentation. Generated documentation is detected when a project is imported with its source.</p>
            <p><a class="btn-secondary" href="project-import">Import Project</a></p>
        </section>
    }
    else
    {
        <div class="gde-selectors" data-testid="gde-selectors">
            <label class="gde-field">Project / import
                <select data-testid="gde-import" @onchange="ImportChanged">
                    @foreach (var i in _imports) { <option value="@i.ImportId" selected="@(i.ImportId == _importId)">@i.Label</option> }
                </select>
            </label>
            <label class="gde-field">Module
                <select data-testid="gde-module" @onchange="ModuleChanged">
                    @foreach (var m in Modules) { <option value="@m" selected="@(m == _module)">@m</option> }
                </select>
            </label>
        </div>

        @* Only documents the module actually has: absence of a document type is neutral, never "Missing". A compact library: the document's own
           title first, its type and availability beside it, the path on demand. *@
        <section class="gde-library" aria-labelledby="gde-docs-h" data-testid="gde-module-documents">
            <div class="gde-library-head">
                <h2 id="gde-docs-h">@_module · @ModuleDocuments.Count generated document@(ModuleDocuments.Count == 1 ? "" : "s")</h2>
                <label class="gde-field gde-inline"><span class="visually-hidden">Find a document</span>
                    <input type="search" placeholder="Find a document" value="@_docSearch" @oninput="e => _docSearch = e.Value?.ToString() ?? string.Empty" data-testid="gde-doc-search" /></label>
                <label class="gde-field gde-inline"><span class="visually-hidden">Document type</span>
                    <select data-testid="gde-doc-type" @onchange="e => _docType = e.Value?.ToString() ?? string.Empty">
                        <option value="">All types</option>
                        @foreach (var role in ModuleDocuments.Select(d => d.Role).Distinct().OrderBy(r => r)) { <option value="@role" selected="@(_docType == role.ToString())">@Gde.RoleLabel(role)</option> }
                    </select></label>
            </div>
            <ul class="gde-doclist" role="list">
                @foreach (var d in LibraryDocuments)
                {
                    var doc = d;
                    var selected = doc.Path == _selectedPath;
                    @* One control per document: selecting it opens it in Read (no separate Open button). *@
                    <li class="gde-card @(selected ? "is-selected" : "") @(doc.ContentAvailable ? "" : "is-unavailable")" data-testid="gde-document-card" data-role="@doc.Role"
                        data-state="@(doc.ContentAvailable ? "available" : "unavailable")" aria-current="@(selected ? "true" : null)">
                        <button type="button" class="gde-card-button" data-testid="gde-open" aria-pressed="@(selected ? "true" : "false")" title="@doc.Path" @onclick="() => Select(doc.Path)">
                            <strong class="gde-card-title" data-testid="gde-card-title">@TitleOf(doc)</strong>
                            <span class="gde-pill">@doc.RoleLabel</span>
                            <span class="gde-card-state gde-state-@(doc.ContentAvailable ? "available" : "unavailable")" data-testid="gde-card-state">@Gde.Availability(doc)</span>
                            <span class="gde-muted gde-wrap gde-card-path"><code>@doc.Path</code></span>
                        </button>
                    </li>
                }
                @if (LibraryDocuments.Count == 0) { <li class="gde-muted" data-testid="gde-doc-none">No document matches.</li> }
            </ul>
        </section>

        @if (_view is { } view)
        {
            var d = view.Document;
            <section class="gde-document" aria-labelledby="gde-doc-h" data-testid="gde-document">
                @if (_back is { } back)
                {
                    <p class="gde-back"><button type="button" class="btn-link" data-testid="gde-search-back" @onclick="GoBack">← Back to @back.Title</button></p>
                }
                <h2 id="gde-doc-h" tabindex="-1">@TitleOf(d) <span class="gde-pill">Generated @d.RoleLabel</span></h2>
                <dl class="gde-facts">
                    <div><dt>Source</dt><dd><code class="gde-wrap" data-testid="gde-source-path">@d.Path</code></dd></div>
                    <div><dt>Origin</dt><dd data-testid="gde-origin">@Gde.Origin</dd></div>
                    <div><dt>Generator</dt><dd data-testid="gde-generator">@(d.Document.Generator ?? "Generated documentation detected · generator not established")</dd></div>
                    <div><dt>Content</dt><dd data-testid="gde-parse-state">@view.StateLabel</dd></div>
                </dl>
                <p class="gde-actions">
                    @if (Gde.DriftConcernOf(d.Role) is { } concern && !d.RepositoryLevel)
                    {
                        <a class="btn-secondary btn-small" data-testid="gde-compare-drift" href="@($"documentation-drift?tab=compare&import={Uri.EscapeDataString(_importId)}&module={Uri.EscapeDataString(d.Module)}&concern={concern}")">Compare in Documentation Drift</a>
                    }
                    <a class="btn-link" data-testid="gde-open-health" href="@($"{NavigationCatalog.GeneratedDocumentationHealthRoute}?import={Uri.EscapeDataString(_importId)}{(d.Document.SourceSnapshotId is { } healthSnapshot ? $"&snapshot={healthSnapshot}" : "")}")">Open Generated Documentation Health</a>
                    @if (d.Document.SourceSnapshotId is { } snapshot)
                    {
                        <a class="btn-link" data-testid="gde-open-source" href="@($"source-analysis?snapshot={snapshot}")">Related Source Analysis snapshot</a>
                    }
                </p>
                <div class="gde-toolbar gde-sticky" data-testid="gde-toolbar">
                    <div class="gde-tabs" role="tablist" aria-label="Document views" data-testid="gde-tabs">
                        @foreach (var (tab, label) in Gde.ViewTabs)
                        {
                            var t = tab;
                            <button type="button" role="tab" class="@(_tab == t ? "is-current" : "")" aria-selected="@(_tab == t ? "true" : "false")" aria-controls="gde-tabpanel" data-testid="gde-tab" data-tab="@t" @onclick="() => SetTab(t)">@label</button>
                        }
                    </div>
                    <div class="gde-find" role="search">
                        <label class="visually-hidden" for="gde-search-input">@(_searchAll ? "Search all documents of this import" : "Search this document")</label>
                        <input id="gde-search-input" type="search" placeholder="@(_searchAll ? "Search all documents of this import" : "Search this document")" value="@_searchInput" @oninput="SearchInput" @onkeydown="SearchKey" data-testid="gde-search" />
                        <button type="button" class="btn-secondary btn-small" data-testid="gde-search-scope" data-scope="@(_searchAll ? "import" : "document")" aria-pressed="@(_searchAll ? "true" : "false")" @onclick="ToggleSearchAll">@(_searchAll ? "Search this document only" : "Search all documents of this import")</button>
                        @if (!string.IsNullOrWhiteSpace(_search))
                        {
                            <span class="gde-muted" role="status" data-testid="gde-search-count">@(_hits == 0 ? "No match" : $"{_hitIndex + 1} of {_hits}")</span>
                            <button type="button" class="btn-secondary btn-small" aria-label="Previous match" disabled="@(_hits == 0)" data-testid="gde-search-prev" @onclick="() => StepHit(-1)">↑</button>
                            <button type="button" class="btn-secondary btn-small" aria-label="Next match" disabled="@(_hits == 0)" data-testid="gde-search-next" @onclick="() => StepHit(1)">↓</button>
                            <button type="button" class="btn-link" data-testid="gde-search-clear" @onclick="ClearSearch">Clear</button>
                        }
                    </div>
                    <div class="gde-tools">
                        <button type="button" class="btn-secondary btn-small" data-testid="gde-wide" aria-pressed="@(_wide ? "true" : "false")" @onclick="() => _wide = !_wide">@(_wide ? "Standard width" : "Wide reader")</button>
                        <button type="button" class="btn-secondary btn-small" data-testid="gde-copy-link" @onclick="CopyLinkAsync">Copy link</button>
                        @if (_linkStatus is not null) { <span class="gde-muted" role="status" data-testid="gde-link-status">@_linkStatus</span> }
                    </div>
                </div>
                @if (_searchAll) { @SearchAllResults() }
                @if (!string.IsNullOrWhiteSpace(_search) && _tab is not ("Read" or "Source"))
                {
                    <p class="gde-muted" data-testid="gde-search-where">Matches are highlighted in Read and Source.</p>
                }
                <div id="gde-tabpanel" role="tabpanel" aria-label="@_tab">
                @if (view.State == GeneratedDocumentParseState.ContentUnavailable && _tab is "Read" or "Structure" or "Source")
                {
                    <p class="gde-note" role="status" data-testid="gde-content-unavailable"><strong>Detected — content unavailable.</strong> @Gde.ContentUnavailableText</p>
                }
                else
                {
                    @switch (_tab)
                    {
                        case "Read": @Read(view) break;
                        case "Structure": @Outline(view) break;
                        case "Source": @Source(view) break;
                        default: @Provenance(view) break;
                    }
                }
                </div>
            </section>
        }
    }
</div>

@code {
    private const string Intro = "Browse generated (implementation-derived) documentation by module, structured by document type. Read-only.";
    private static readonly DataModelAnalysisService Parser = new();
    private IReadOnlyList<DriftDocument> _catalog = [];
    private IReadOnlyList<DriftImport> _imports = [];
    private string _importId = "", _module = "", _selectedPath = "", _tab = "Read", _search = "", _outlineFilter = "";
    private IReadOnlyList<GeneratedReadSegment> _segments = [];
    private IReadOnlyList<GeneratedOutlineItem> _outline = [];
    private string? _pendingAnchor, _copyStatus, _linkStatus, _section, _systemsNote;
    private string _docSearch = "", _docType = "", _searchInput = "";
    private bool _wide;
    private int _hits, _hitIndex, _searchGeneration;
    private readonly Dictionary<string, string?> _titles = [];
    private IReadOnlyList<string> _rendered = [];
    private string _renderedTerm = "\u0000";
    private IReadOnlyList<BirkNext.Scopes.SystemOverviewItem>? _systems;

    // Cross-document search: the selected import is the boundary; results are computed from the debounced term only and cached per import + term.
    private bool _searchAll, _resultsCollapsed;
    private string _allType = "";
    private readonly Dictionary<(string Import, string Term), GeneratedSearchResults> _allCache = [];
    /// <summary>The document a search result was opened from ("Back to …"); cleared when a document is chosen from the library.</summary>
    private sealed record BackTarget(string Module, string Path, string Tab, string? Section, string Title);
    private BackTarget? _back;

    // Contextual health: the existing Generated Documentation Health run per (import, source snapshot), read once when Provenance is shown.
    private readonly Dictionary<(string Import, Guid Snapshot), BirkNext.GeneratedDocumentation.GeneratedDocumentationDiagnosticRun?> _healthRuns = [];
    private readonly HashSet<(string Import, Guid Snapshot)> _healthLoading = [];

    private IReadOnlyList<GeneratedExplorerDocument> LibraryDocuments => ModuleDocuments
        .Where(d => _docType.Length == 0 || d.Role.ToString() == _docType)
        .Where(d => _docSearch.Trim().Length == 0 || TitleOf(d).Contains(_docSearch.Trim(), StringComparison.OrdinalIgnoreCase)
            || d.Path.Contains(_docSearch.Trim(), StringComparison.OrdinalIgnoreCase) || d.RoleLabel.Contains(_docSearch.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();

    /// <summary>The document's own first heading as its title (read once per document), else its type — never the file name.</summary>
    private string TitleOf(GeneratedExplorerDocument doc)
    {
        if (!_titles.TryGetValue(doc.Path, out var title))
        {
            title = Repository?.SddLifecycle is { } state && DocumentationDrift.IsMarkdown(doc.Path) ? GeneratedDocumentationReader.Title(DocumentationDrift.Text(state, doc.Document)) : null;
            _titles[doc.Path] = title;
        }
        return title ?? $"{doc.RoleLabel} ({doc.Module})";
    }

    /// <summary>Rendered Markdown per segment with the current search highlighted — rebuilt only when the (debounced) term changes.</summary>
    private string RenderedSegment(int i)
    {
        if (_renderedTerm != _search || _rendered.Count != _segments.Count)
        {
            var list = new List<string>(_segments.Count);
            var total = 0;
            for (var k = 0; k < _segments.Count; k++)
            {
                var html = _segments[k].Markdown is { } md ? Gde.RenderSegment(k, md) : "";
                list.Add(GeneratedDocumentationReader.Highlight(html, _search, total, out var count));
                total += count;
            }
            (_rendered, _renderedTerm, _hits) = (list, _search, total);
            if (_hitIndex >= _hits) _hitIndex = 0;
        }
        return _rendered[i];
    }

    /// <summary>Debounced search: the document is re-highlighted 250 ms after typing stops (no re-render per keystroke).</summary>
    private async Task SearchInput(ChangeEventArgs e)
    {
        _searchInput = e.Value?.ToString() ?? "";
        var generation = ++_searchGeneration;
        await Task.Delay(250);
        if (generation != _searchGeneration) return;
        if (_search == _searchInput) return; // the same term: keep the current match position
        _search = _searchInput;
        _hitIndex = 0;
        if (_segments.Count > 0) _ = RenderedSegment(0);
    }

    private void SearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") StepHit(e.ShiftKey ? -1 : 1);
        else if (e.Key == "Escape") ClearSearch();
    }

    private void StepHit(int direction)
    {
        if (_segments.Count > 0) _ = RenderedSegment(0);
        if (_hits == 0) return;
        _hitIndex = ((_hitIndex + direction) % _hits + _hits) % _hits;
        if (_tab != "Read") { _tab = "Read"; SyncUrl(); }
        _pendingAnchor = $"gde-hit-{_hitIndex}";
    }

    private void ClearSearch() { _search = _searchInput = ""; _hits = _hitIndex = 0; _searchGeneration++; }

    private async Task CopyLinkAsync()
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", Navigation.Uri); _linkStatus = "Link copied."; }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException) { _linkStatus = "Copy is not available; use the address bar."; }
    }

    /// <summary>The registered systems of the active Target Environment (one call; the page works without them).</summary>
    private async Task LoadSystemsAsync()
    {
        if (ServiceProvider.GetService(typeof(IScopeRegistryApiService)) is not IScopeRegistryApiService registry
            || ServiceProvider.GetService(typeof(IFrontendAnalysisContextFactory)) is not IFrontendAnalysisContextFactory factory)
        { _systemsNote = "The system registry is not available here."; return; }
        var scope = CorrelationPresentation.Scope((await factory.GetActiveContextAsync()).ActiveProfileOrNull?.Id);
        if (scope is null) { _systemsNote = "Choose an active Target Environment to link systems named in documents."; return; }
        var (overview, error) = await registry.SystemsAsync(scope);
        if (overview is null || overview.InterpretationId is null) { _systemsNote = error ?? "No analysed systems for the active Target Environment yet."; return; }
        _systems = overview.Systems;
        StateHasChanged();
    }

    /// <summary>Copies the imported source exactly (read-only: nothing is changed).</summary>
    private async Task CopySourceAsync(string? content)
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", content ?? ""); _copyStatus = "Copied."; }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException) { _copyStatus = "Copy is not available in this browser."; }
    }
    private GeneratedDocumentView? _view;
    private BirkNext.SourceDomains.SourceContract? _contract;
    private bool _contractLoading, _focusDocument;

    private WorkspaceArtifactRepository? Repository => ServiceProvider.GetService(typeof(IWorkspaceArtifactRepository)) as WorkspaceArtifactRepository
        ?? ServiceProvider.GetService(typeof(WorkspaceArtifactRepository)) as WorkspaceArtifactRepository;

    private IReadOnlyList<GeneratedExplorerDocument> Documents => Gde.Documents(_catalog, _importId);
    private IReadOnlyList<string> Modules => Gde.Modules(Documents);
    private IReadOnlyList<GeneratedExplorerDocument> ModuleDocuments => Documents.Where(d => d.Module == _module).ToList();

    protected override void OnInitialized()
    {
        if (Repository?.SddLifecycle is not { } state) return;
        _catalog = DocumentationDrift.Catalog(state);
        var withDocs = _catalog.Where(d => d.Origin == DriftOrigin.Generated).Select(d => d.ProjectImportId).ToHashSet();
        _imports = DocumentationDrift.Imports(state).Where(i => withDocs.Contains(i.ImportId)).ToList();
        var query = QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        _importId = query.TryGetValue("import", out var import) && _imports.Any(i => i.ImportId == import.ToString()) ? import.ToString()
            : _imports.FirstOrDefault(i => i.ImportId == state.CurrentProjectImportId)?.ImportId ?? _imports.LastOrDefault()?.ImportId ?? "";
        // Health links name the repository level "(repository)"; the Explorer calls it "Repository level".
        var requestedModule = query.TryGetValue("module", out var module) ? (module.ToString() == "(repository)" ? Gde.RepositoryLevel : module.ToString()) : "";
        _module = Modules.Contains(requestedModule) ? requestedModule : Modules.FirstOrDefault() ?? "";
        if (query.TryGetValue("document", out var document) && ModuleDocuments.Any(d => d.Path == document.ToString()))
        {
            Select(document.ToString(), updateUrl: false);
            // An explicit ?view= (read, outline/structure, source, provenance; the former overview opens Provenance) is honoured once, on arrival.
            if (query.TryGetValue("view", out var requested) && Gde.ViewFromQuery(requested.ToString()) is { } explicitView) { _tab = explicitView; EnsureHealth(); }
            // A deep link to a section opens Read at that heading (only an anchor the document really has).
            if (query.TryGetValue("section", out var section) && _outline.Any(o => o.AnchorId == section.ToString()))
            {
                (_tab, _section, _pendingAnchor, _focusDocument) = ("Read", section.ToString(), section.ToString(), false);
            }
        }
    }

    protected override Task OnInitializedAsync() => LoadSystemsAsync();

    private void SetTab(string tab)
    {
        _tab = tab;
        SyncUrl();
        EnsureHealth();
    }

    /// <summary>The selected document and view in the URL (replace: refresh and shared links reopen it; no history entry per tab click).</summary>
    private void SyncUrl()
    {
        if (_selectedPath.Length == 0) return;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["import"] = _importId, ["module"] = _module, ["document"] = _selectedPath, ["view"] = _tab == "Read" ? null : Gde.ViewSlug(_tab),
            ["section"] = _tab == "Read" ? _section : null,
        }), replace: true);
    }

    /// <summary>Outline → the heading in Read: switch to Read, then scroll to the heading once it is rendered.</summary>
    private void GoToHeading(string anchorId)
    {
        _tab = "Read";
        _pendingAnchor = anchorId;
        _section = anchorId;
        SyncUrl();
    }

    private void ImportChanged(ChangeEventArgs e) { _importId = e.Value?.ToString() ?? ""; _module = Modules.FirstOrDefault() ?? ""; _view = null; _selectedPath = ""; _back = null; _allType = ""; }
    private void ModuleChanged(ChangeEventArgs e) { _module = e.Value?.ToString() ?? ""; _view = null; _selectedPath = ""; _back = null; }

    /// <summary>A document chosen from the library: a fresh reading (the "Back to …" of a search jump no longer applies).</summary>
    private void Select(string path) { _back = null; Select(path, updateUrl: true); }

    private void ToggleSearchAll() { _searchAll = !_searchAll; _resultsCollapsed = false; }

    /// <summary>Every generated document of the selected import that contains the (debounced) term — computed once per import + term.</summary>
    private GeneratedSearchResults AllResults()
    {
        var key = (_importId, _search.Trim());
        if (_allCache.TryGetValue(key, out var cached)) return cached;
        if (_allCache.Count >= 16) _allCache.Clear();
        var state = Repository?.SddLifecycle;
        var documents = Documents.Where(d => d.ContentAvailable).Select(d => (d, state is null ? null : DocumentationDrift.Text(state, d.Document)));
        return _allCache[key] = GeneratedDocumentationExplorerContext.Search(documents, key.Item2);
    }

    /// <summary>Opens a cross-document result: its module, the document, the term highlighted and the first match focused; the current document is remembered.</summary>
    private void OpenResult(GeneratedExplorerDocument doc)
    {
        var term = _search;
        if (doc.Path != _selectedPath && _view is { } current)
            _back = new(current.Document.Module, _selectedPath, _tab, _section, TitleOf(current.Document));
        _module = doc.Module;
        Select(doc.Path, updateUrl: false);
        if (_view is null) return;
        _search = _searchInput = term;
        _hitIndex = 0;
        _searchGeneration++;
        _focusDocument = false;
        _resultsCollapsed = true;
        if (DocumentationDrift.IsMarkdown(doc.Path) && _segments.Count > 0) _ = RenderedSegment(0);
        if (DocumentationDrift.IsMarkdown(doc.Path) && _hits > 0) { _tab = "Read"; _pendingAnchor = "gde-hit-0"; }
        else { _tab = "Source"; _pendingAnchor = null; } // a match only in a diagram's source or a non-Markdown artifact is marked in Source
        SyncUrl();
    }

    /// <summary>Back to the document a search result was opened from, at the view (and section) it was read at.</summary>
    private void GoBack()
    {
        if (_back is not { } back) return;
        var term = _search;
        _back = null;
        _module = back.Module;
        Select(back.Path, updateUrl: false);
        if (_view is null) return;
        _search = _searchInput = term;
        _searchGeneration++;
        if (back.Tab == "Read" && back.Section is { } section && _outline.Any(o => o.AnchorId == section))
            (_tab, _section, _pendingAnchor, _focusDocument) = ("Read", section, section, false);
        else _tab = back.Tab;
        SyncUrl();
        EnsureHealth();
    }

    /// <summary>Reads the existing Generated Documentation Health run for the open document's source snapshot (once per import + snapshot).</summary>
    private void EnsureHealth()
    {
        if (_tab != "Provenance" || _view?.Document.Document.SourceSnapshotId is not { } snapshot) return;
        var key = (_importId, snapshot);
        if (_healthRuns.ContainsKey(key) || _healthLoading.Contains(key)) return;
        if (ServiceProvider.GetService(typeof(IGeneratedDocumentationApiService)) is not IGeneratedDocumentationApiService api) { _healthRuns[key] = null; return; }
        _ = LoadHealthAsync(api, key);
    }

    private async Task LoadHealthAsync(IGeneratedDocumentationApiService api, (string Import, Guid Snapshot) key)
    {
        _healthLoading.Add(key);
        try
        {
            _healthRuns[key] = await api.RunAsync(new BirkNext.GeneratedDocumentation.GeneratedDocumentationDiagnosticRequest { ProjectImportId = key.Import, SnapshotId = key.Snapshot });
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException or InvalidOperationException) { _healthRuns[key] = null; }
        finally { _healthLoading.Remove(key); await InvokeAsync(StateHasChanged); }
    }

    /// <summary>The health findings for an open document, or why health is not evaluated for it (never "healthy" by absence).</summary>
    private (GeneratedDocumentHealthFindings? Findings, string Reason, bool Loading) HealthOf(GeneratedExplorerDocument doc)
    {
        if (doc.Document.SourceSnapshotId is not { } snapshot) return (null, "Its source snapshot is not known.", false);
        if (_healthLoading.Contains((_importId, snapshot))) return (null, "", true);
        if (!_healthRuns.TryGetValue((_importId, snapshot), out var run) || run is null)
            return (null, "No Generated Documentation Health result is available for its source snapshot.", false);
        if (run.State != BirkNext.GeneratedDocumentation.GeneratedDocumentationRunState.Ready) return (null, run.StateMessage, false);
        return GeneratedDocumentationExplorerContext.For(run, doc.Module, doc.RepositoryLevel, doc.Path) is { } findings
            ? (findings, "", false)
            : (null, "The health run does not cover this document's module.", false);
    }

    private void Select(string path, bool updateUrl)
    {
        if (Repository?.SddLifecycle is not { } state || ModuleDocuments.FirstOrDefault(d => d.Path == path) is not { } doc) return;
        // Opening a document reads it: Read is the default view (metadata lives under Provenance).
        _selectedPath = path; _tab = "Read"; _search = _searchInput = ""; _hits = _hitIndex = 0; _outlineFilter = ""; _contract = null; _pendingAnchor = null; _section = null;
        _rendered = []; _renderedTerm = "\u0000";
        var content = DocumentationDrift.Text(state, doc.Document);
        _view = Gde.View(doc, content, Parser);
        // Parsed once per selection, never per tab switch.
        _segments = DocumentationDrift.IsMarkdown(doc.Path) ? Gde.ReadSegments(content) : [];
        _outline = Gde.Outline(_segments);
        _focusDocument = true;
        if (updateUrl) SyncUrl();
        // OpenAPI / GraphQL: the backend's Source Analysis readers give the structure (stateless; no remote refs, no introspection).
        if (doc.Role is GeneratedDocumentRole.ApiContract or GeneratedDocumentRole.GraphQlSchema && content is not null && !DocumentationDrift.IsMarkdown(doc.Path)
            && ServiceProvider.GetService(typeof(IGeneratedDocumentationApiService)) is IGeneratedDocumentationApiService api)
            _ = LoadContractAsync(api, doc.Path, content);
    }

    private async Task LoadContractAsync(IGeneratedDocumentationApiService api, string path, string content)
    {
        _contractLoading = true;
        try { var contract = await api.StructureAsync(path, content); if (_selectedPath == path) _contract = contract; }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { _contract = null; }
        finally { _contractLoading = false; await InvokeAsync(StateHasChanged); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingAnchor is { } anchor)
        {
            _pendingAnchor = null;
            try { await JS.InvokeVoidAsync("birknextFocusElement", anchor); } catch (JSException) { }
            return;
        }
        if (!_focusDocument) return;
        _focusDocument = false;
        try { await JS.InvokeVoidAsync("birknextFocusElement", "gde-doc-h"); } catch (JSException) { }
    }

    /// <summary>
    /// Read: the document itself, in source order — Markdown rendered safely (raw HTML shown as text, no remote images, safe links) and every
    /// recognised diagram drawn from its own source. Non-Markdown artifacts (OpenAPI/GraphQL files) are read through their structure.
    /// </summary>
    private RenderFragment Read(GeneratedDocumentView v) => __builder =>
    {
        if (!DocumentationDrift.IsMarkdown(v.Document.Path))
        {
            <div data-testid="gde-read" data-format="structured">@Structure(v)</div>
            return;
        }
        <article class="gde-read markdown-content @(_wide ? "is-wide" : "")" data-testid="gde-read" data-format="markdown" aria-label="@($"{v.Document.RoleLabel} document")">
            @for (var i = 0; i < _segments.Count; i++)
            {
                var segment = _segments[i];
                if (segment.Diagram is { } diagram)
                {
                    <BirkNext.Web.Components.GeneratedDiagramView Source="@diagram" Heading="@HeadingBefore(i)" />
                }
                else
                {
                    @((MarkupString)RenderedSegment(i))
                }
            }
        </article>
        @if (v.State == GeneratedDocumentParseState.PartiallyParsed)
        {
            <p class="gde-muted gde-read-note" data-testid="gde-partial-read">All of this document is shown above. Some of it has no structured interpretation (see Outline); that is not an error in the document.</p>
        }
    };

    /// <summary>The nearest heading before a segment (the diagram's caption), from the outline already computed.</summary>
    private string HeadingBefore(int segment)
    {
        var prefix = $"gde-s";
        var before = _outline.LastOrDefault(o => int.TryParse(o.AnchorId[prefix.Length..o.AnchorId.IndexOf('-', prefix.Length)], out var s) && s < segment);
        return before?.Text ?? _view?.Document.RoleLabel ?? "Document";
    }

    /// <summary>Outline: the document's own headings (click to read that section), then the structured interpretation on request.</summary>
    private RenderFragment Outline(GeneratedDocumentView v) => __builder =>
    {
        var items = _outline.Where(o => _outlineFilter.Trim().Length == 0 || o.Text.Contains(_outlineFilter.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
        <nav class="gde-outline" aria-label="Document outline" data-testid="gde-outline">
            @if (_outline.Count > 0)
            {
                <label class="gde-field gde-outline-filter">Filter headings <input type="search" data-testid="gde-outline-filter" @bind="_outlineFilter" @bind:event="oninput" /></label>
                <p class="gde-muted" role="status" data-testid="gde-outline-count">@items.Count of @_outline.Count headings</p>
                <ol class="gde-outline-list">
                    @foreach (var item in items)
                    {
                        <li class="gde-outline-l@(Math.Min(item.Level, 6)) @(item.AnchorId == _section ? "is-current" : "")"><button type="button" class="gde-link" data-testid="gde-outline-item" data-anchor="@item.AnchorId" aria-current="@(item.AnchorId == _section ? "location" : null)" @onclick="() => GoToHeading(item.AnchorId)">@item.Text</button></li>
                    }
                </ol>
            }
            else { <p class="gde-muted" data-testid="gde-outline-empty">This document has no headings to navigate.</p> }
        </nav>
        <details class="gde-structured" data-testid="gde-structured" open="@(!DocumentationDrift.IsMarkdown(v.Document.Path) || v.DataModel is not null || v.ChangeLog.Count > 0)">
            <summary>Structured interpretation (@v.StateLabel)</summary>
            @Structure(v)
        </details>
    };

    /// <summary>A fenced block: a recognised diagram as participants/steps or nodes/edges (source behind a disclosure); other code as code.</summary>
    private static RenderFragment CodeBlock(string block, string heading) => __builder =>
    {
        if (!GeneratedDiagrams.IsDiagram(block)) { <pre class="gde-code">@block</pre> return; }
        <BirkNext.Web.Components.GeneratedDiagramView Source="@block" Heading="@heading" InitialMode="steps" />
    };

    /// <summary>Document facts (formerly the Overview tab): technical metadata, shown with the provenance — never before the content.</summary>
    private RenderFragment DocumentFacts(GeneratedDocumentView v) => __builder =>
    {
        <dl class="gde-facts" data-testid="gde-overview">
            <div><dt>Title</dt><dd>@(v.Title ?? "Not stated")</dd></div>
            <div><dt>Document type</dt><dd>@v.Document.RoleLabel</dd></div>
            <div><dt>Module</dt><dd>@v.Document.Module</dd></div>
            <div><dt>Lines</dt><dd>@v.LineCount</dd></div>
            <div><dt>Size</dt><dd>@v.ByteSize bytes</dd></div>
            <div><dt>Headings</dt><dd data-testid="gde-heading-count">@v.HeadingCount</dd></div>
            <div><dt>Structured items</dt><dd data-testid="gde-structured-count">@v.StructuredItems</dd></div>
            <div><dt>Content captured</dt><dd>@(v.Document.ContentAvailable ? "Yes" : "No")</dd></div>
            <div><dt>Fingerprint</dt><dd><code>@Short(v.Document.Document.Fingerprint)</code></dd></div>
            <div><dt>Freshness</dt><dd>See Generated Documentation Health</dd></div>
        </dl>
        @if (v.State == GeneratedDocumentParseState.PartiallyParsed) { <p class="gde-note" data-testid="gde-partial">Structured coverage: Partial. @Gde.PartialCoverage</p> }
    };

    private RenderFragment Structure(GeneratedDocumentView v) => __builder =>
    {
        <div data-testid="gde-structure" data-role="@v.Document.Role">
        @if (v.DataModel is { } model)
        {
            <p class="gde-muted" data-testid="gde-dm-summary">@model.Entities.Count entities · @model.Entities.Sum(e => e.Columns.Count) fields · @model.Relationships.Count relationships · @model.Indexes.Count indexes · @model.Constraints.Count constraints</p>
            @foreach (var e in model.Entities)
            {
                <details class="gde-entity" data-testid="gde-entity" data-name="@e.Name"><summary><strong>@e.Name</strong> <span class="gde-muted">@e.Columns.Count fields</span></summary>
                    <table class="gde-table"><thead><tr><th>Field</th><th>Type</th><th>Nullable</th><th>Key</th></tr></thead><tbody>
                        @foreach (var c in e.Columns) { <tr><td>@c.Name</td><td>@(c.Type ?? "Not stated")</td><td>@(c.Nullable switch { true => "Yes", false => "No", _ => "Not stated" })</td><td>@(c.IsPrimaryKey ? "PK" : c.IsForeignKey ? "FK" : "—")</td></tr> }
                    </tbody></table>
                    @foreach (var r in model.Relationships.Where(r => r.Source.StartsWith(e.Name + ".", StringComparison.OrdinalIgnoreCase) || r.Source == e.Name)) { <p class="gde-muted">→ @r.Target (@r.RelationshipType)</p> }
                </details>
            }
            @if (model.NotStatedInGeneratedDocumentation.Count > 0) { <details><summary>Not stated in the generated documentation (@model.NotStatedInGeneratedDocumentation.Count)</summary><ul class="gde-plain">@foreach (var n in model.NotStatedInGeneratedDocumentation) { <li>@n</li> }</ul></details> }
        }
        else if (v.ChangeLog.Count > 0)
        {
            <p class="gde-muted" data-testid="gde-changelog-summary">@v.ChangeLog.Count release@(v.ChangeLog.Count == 1 ? "" : "s") · latest @v.ChangeLog[0].Version@(v.ChangeLog[0].Date is { } latestDate ? $" ({latestDate})" : "")</p>
            @for (var i = 0; i < v.ChangeLog.Count; i++)
            {
                var version = v.ChangeLog[i];
                <section class="gde-version" data-testid="gde-changelog-version">
                    <ReviewDisclosure Text="@($"{version.Version}{(version.Date is { } date ? $" · {date}" : "")} · {version.Groups.Sum(g => g.Entries.Count)} change(s)")" Expanded="@(i == 0)" Class="disclosure-inline">
                        @foreach (var (category, entries) in version.Groups) { <p><strong data-testid="gde-changelog-category">@category</strong></p><ul class="gde-plain">@foreach (var entry in entries) { <li>@entry</li> }</ul> }
                    </ReviewDisclosure>
                </section>
            }
        }
        else if (v.Document.Role is GeneratedDocumentRole.ApiContract or GeneratedDocumentRole.GraphQlSchema && !DocumentationDrift.IsMarkdown(v.Document.Path))
        {
            @ContractStructure(v)
        }
        else
        {
            @foreach (var s in v.Sections.Where(s => s.Level > 0))
            {
                <section class="gde-section gde-level-@Math.Min(s.Level, 4)" data-testid="gde-section" data-heading="@s.Heading">
                    <h3>@s.Heading <span class="gde-muted">L@(s.Line)</span></h3>
                    @if (s.OrderedSteps.Count > 0) { <ol data-testid="gde-steps">@foreach (var step in s.OrderedSteps) { <li>@step</li> }</ol> }
                    @if (s.Items.Count > 0) { <ul>@foreach (var item in s.Items) { <li>@item</li> }</ul> }
                    @foreach (var t in s.Tables)
                    {
                        <div class="gde-table-wrap" tabindex="0" role="region" aria-label="@s.Heading table"><table class="gde-table" data-testid="gde-table"><thead><tr>@foreach (var h in t.Header) { <th>@h</th> }</tr></thead>
                            <tbody>@foreach (var row in t.Rows) { <tr>@foreach (var cell in row) { <td>@cell</td> }</tr> }</tbody></table></div>
                    }
                    @foreach (var block in s.CodeBlocks) { @CodeBlock(block, s.Heading) }
                    @if (s.Prose.Count > 0) { <details><summary>Text (@s.Prose.Count)</summary>@foreach (var p in s.Prose) { <p>@p</p> }</details> }
                </section>
            }
        }
        @if (v.UnmappedLines > 0)
        {
            <details class="gde-unmapped" data-testid="gde-unmapped"><summary>Source content not structured (@v.UnmappedLines)</summary>
                <p class="gde-muted">Informational: content kept as text because it has no structured concept here. Not a defect; all content remains available in Source view.</p>
            </details>
        }
        </div>
    };

    /// <summary>Source: exactly what was imported/generated — raw, in its own format (never transformed into Markdown).</summary>
    private RenderFragment Source(GeneratedDocumentView v) => __builder =>
    {
        <div data-testid="gde-source">
            <div class="gde-source-bar">
                <p class="gde-muted" data-testid="gde-source-language">Raw @Gde.SourceLanguage(v.Document.Path) · @v.LineCount lines · @v.ByteSize bytes</p>
                <button type="button" class="btn-secondary btn-small" data-testid="gde-source-copy" @onclick="() => CopySourceAsync(v.Content)">Copy source</button>
                @if (_copyStatus is not null) { <span class="gde-muted" role="status" data-testid="gde-source-copied">@_copyStatus</span> }
            </div>
            @* The original text, unchanged, with line numbers beside it (the numbers are not part of the copied source). *@
            <div class="gde-code gde-raw" data-testid="gde-raw">
                <ol class="gde-lines" data-testid="gde-source-lines" aria-label="@($"{v.Document.RoleLabel} source with line numbers")">
                    @foreach (var line in Gde.SourceLines(v.Content))
                    {
                        var hit = _search.Trim().Length >= 2 && line.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase);
                        <li class="@(hit ? "is-hit" : null)" data-hit="@(hit ? "true" : null)"><code>@line</code></li>
                    }
                </ol>
            </div>
            <p class="gde-muted">Read-only. Generated documentation is never edited here.</p>
        </div>
    };

    /// <summary>OpenAPI / GraphQL structure from the backend's Source Analysis readers: operations grouped by path or kind, types with their fields.</summary>
    private RenderFragment ContractStructure(GeneratedDocumentView v) => __builder =>
    {
        if (_contractLoading) { <InlineLoading Text="Reading the contract structure…" Class="gde-muted" /> return; }
        if (_contract is not { } c) { <p class="gde-note" role="status" data-testid="gde-contract-unparsed">The structure could not be read from this artifact. Its full content is in the Source tab.</p> return; }
        var graphQl = v.Document.Role == GeneratedDocumentRole.GraphQlSchema;
        <div data-testid="gde-contract" data-kind="@(graphQl ? "graphql" : "openapi")">
            <p class="gde-muted" data-testid="gde-contract-summary">@c.Name@(c.Version is { } version ? $" · {version}" : "") · @c.Operations.Count operation@(c.Operations.Count == 1 ? "" : "s") · @c.Types.Count type@(c.Types.Count == 1 ? "" : "s")@(c.ParseSupport == BirkNext.SourceDomains.DomainSupport.Partial ? " · partially parsed" : "")</p>
            @foreach (var group in c.Operations.GroupBy(o => graphQl ? o.Kind : o.Path ?? o.Name))
            {
                <section class="gde-section" data-testid="gde-contract-group">
                    <h3>@group.Key <span class="gde-muted">@group.Count()</span></h3>
                    <ul class="gde-plain">
                        @foreach (var op in group)
                        {
                            <li data-testid="gde-contract-operation"><strong>@op.Name</strong>@if (op.Summary is { } summary) { <span> — @summary</span> }
                                @if (op.OperationId is { } opId) { <span class="gde-muted"> · @opId</span> }
                                @if (op.Parameters.Count > 0) { <span class="gde-muted"> · parameters: @string.Join(", ", op.Parameters)</span> }
                                @if (op.RequestSchema is { } request) { <span class="gde-muted"> · request: @request</span> }
                                @if (op.ResponseCodes.Count > 0) { <span class="gde-muted"> · responses: @string.Join(", ", op.ResponseCodes)</span> }
                                @if (op.Security.Count > 0) { <span class="gde-muted"> · security: @string.Join(", ", op.Security)</span> }
                                @if (op.ResultType is { } result) { <span class="gde-muted"> · returns @result</span> }</li>
                        }
                    </ul>
                </section>
            }
            @if (c.Types.Count > 0)
            {
                <ReviewDisclosure Text="@($"Show {(graphQl ? "types" : "schemas")} ({c.Types.Count})")" CollapseText="Hide types" Class="disclosure-inline">
                    @foreach (var type in c.Types)
                    {
                        <details class="gde-entity" data-testid="gde-contract-type"><summary><strong>@type.Name</strong> <span class="gde-muted">@type.Kind · @type.Fields.Count field@(type.Fields.Count == 1 ? "" : "s")</span></summary>
                            <table class="gde-table"><thead><tr><th>Field</th><th>Type</th><th>Required</th></tr></thead><tbody>
                                @foreach (var f in type.Fields) { <tr><td>@f.Name</td><td>@f.Type</td><td>@(f.Required ? "Yes" : "No")</td></tr> }
                            </tbody></table>
                            @if (type.Values.Count > 0) { <p class="gde-muted">Values: @string.Join(", ", type.Values)</p> }
                        </details>
                    }
                </ReviewDisclosure>
            }
            @if (c.Limitations.Count > 0) { <p class="gde-muted" data-testid="gde-contract-limitations">@string.Join(" ", c.Limitations)</p> }
            <p class="gde-muted">Static, imported document only: no remote reference is resolved and no endpoint is called.</p>
        </div>
    };

    private RenderFragment Provenance(GeneratedDocumentView v) => __builder =>
    {
        var d = v.Document.Document;
        <p class="gde-note" data-testid="gde-evidence-kind"><strong>Implementation-derived documentation</strong> (generated from source by @(d.Generator ?? "an unidentified generator")). Not an approved specification, not imported source documentation, not runtime-verified.@(v.State == GeneratedDocumentParseState.PartiallyParsed ? " Partially parsed: some content has no structured interpretation." : "")</p>
        @HealthSummary(v)
        @SystemsReferenced(v)
        @Revisions(v)
        <details class="gde-technical" data-testid="gde-technical"><summary>Technical details</summary>
        @DocumentFacts(v)
        <p data-testid="gde-provenance-summary">Generated by @(d.Generator ?? "an unidentified generator") from Source Analysis snapshot @(d.SourceSnapshotId is { } snap ? snap.ToString()[..8] : "(not known)")@(d.ImportedAt is { } importedAt ? $", imported {importedAt.ToLocalTime():g}" : "").</p>
        <dl class="gde-facts" data-testid="gde-provenance">
            <div><dt>Project / import</dt><dd>@(d.ProjectRevision ?? "—")</dd></div>
            <div><dt>Module</dt><dd>@v.Document.Module</dd></div>
            <div><dt>Generated-document set</dt><dd><code>@d.GeneratedSetId</code></dd></div>
            <div><dt>Relative path</dt><dd><code class="gde-wrap">@d.Path</code></dd></div>
            <div><dt>Generated kind</dt><dd>@d.TypeLabel.Replace("Generated · ", "")</dd></div>
            <div><dt>Generator</dt><dd>@(d.Generator ?? "Not established")</dd></div>
            <div><dt>Fingerprint</dt><dd><code data-testid="gde-fingerprint">@d.Fingerprint</code></dd></div>
            <div><dt>Content captured</dt><dd>@(v.Document.ContentAvailable ? "Yes" : "No")</dd></div>
            <div><dt>Source snapshot</dt><dd><code>@(d.SourceSnapshotId?.ToString() ?? "Not known")</code></dd></div>
            <div><dt>Imported at</dt><dd>@(d.ImportedAt?.ToLocalTime().ToString("g") ?? "—")</dd></div>
        </dl>
        </details>
    };

    /// <summary>
    /// Documentation health for THIS document, from the existing Generated Documentation Health run of its source snapshot: parse problems of this
    /// document, required documents missing in its module, and its module's consistency candidates (only those naming this document when they
    /// name one). Compact counts with the detail on request; without a run it says so — never "healthy".
    /// </summary>
    private RenderFragment HealthSummary(GeneratedDocumentView v) => __builder =>
    {
        var doc = v.Document;
        var snapshot = doc.Document.SourceSnapshotId;
        var href = $"{NavigationCatalog.GeneratedDocumentationHealthRoute}?import={Uri.EscapeDataString(_importId)}{(snapshot is { } s ? $"&snapshot={s}" : "")}";
        var (findings, reason, loading) = HealthOf(doc);
        <section class="gde-context gde-health" aria-labelledby="gde-health-h" data-testid="gde-health" data-state="@(loading ? "loading" : findings is null ? "not-evaluated" : "evaluated")">
            <h3 id="gde-health-h" class="gde-h3">Documentation health</h3>
            @if (loading)
            {
                <InlineLoading Text="Reading Generated Documentation Health…" Class="gde-muted" />
            }
            else if (findings is null)
            {
                <p class="gde-muted" data-testid="gde-health-not-evaluated">Health not evaluated for this document. @reason</p>
            }
            else
            {
                var f = findings;
                <p data-testid="gde-health-summary">@(f.Total == 0 ? "No finding of the health run concerns this document." : $"{f.Total} finding{(f.Total == 1 ? "" : "s")} concern this document or its module.") Freshness: @f.Freshness.</p>
                <ul class="gde-plain gde-health-counts" data-testid="gde-health-counts">
                    <li data-testid="gde-health-count" data-kind="parse">Parse problems in this document: <strong>@f.ParseErrors.Count</strong></li>
                    <li data-testid="gde-health-count" data-kind="missing">Required documents missing in module @doc.Module: <strong>@f.MissingExpected.Count</strong></li>
                    <li data-testid="gde-health-count" data-kind="source">Source consistency candidates: <strong>@f.SourceDiscrepancies.Count</strong></li>
                    <li data-testid="gde-health-count" data-kind="drift">Cross-artifact consistency candidates: <strong>@f.CrossArtifactDrift.Count</strong></li>
                </ul>
                @if (f.Total > 0)
                {
                    <details class="gde-health-detail" data-testid="gde-health-detail">
                        <summary>Show the findings (@f.Total)</summary>
                        @if (f.ParseErrors.Count > 0) { <p><strong>Parse problems</strong></p><ul class="gde-plain">@foreach (var e in f.ParseErrors) { <li data-testid="gde-health-parse">@e</li> }</ul> }
                        @if (f.MissingExpected.Count > 0) { <p><strong>Required documents missing in the module</strong></p><ul class="gde-plain">@foreach (var m in f.MissingExpected) { <li data-testid="gde-health-missing">@m</li> }</ul> }
                        @foreach (var (label, items) in new[] { ("Source consistency candidates", f.SourceDiscrepancies), ("Cross-artifact consistency candidates", f.CrossArtifactDrift) })
                        {
                            @if (items.Count > 0)
                            {
                                <p><strong>@label</strong></p>
                                <ul class="gde-plain">@foreach (var c in items) { <li data-testid="gde-health-candidate" data-id="@c.Id">@c.Family@(c.StructuredKey.Length > 0 ? $" · {c.StructuredKey}" : "")@(c.Explanation.Length > 0 ? $" — {c.Explanation}" : "")</li> }</ul>
                            }
                        }
                        <p class="gde-muted">Consistency candidates are review candidates, not defects; BirkNext does not decide which side is wrong.</p>
                    </details>
                }
                <p class="gde-muted" data-testid="gde-health-basis">From Generated Documentation Health of this source snapshot · module @f.Module.Module: @BirkNext.GeneratedDocumentation.GeneratedDocumentationText.Label(f.Module.Status).</p>
            }
            <p><a class="gde-link" data-testid="gde-health-open" href="@href">Open Generated Documentation Health for this snapshot</a></p>
        </section>
    };

    /// <summary>Cross-document results: grouped by document (title, type, count, a few matching lines), bounded, the selected import only.</summary>
    private RenderFragment SearchAllResults() => __builder =>
    {
        var term = _search.Trim();
        <section class="gde-search-all" aria-label="Search results in all documents of this import" data-testid="gde-search-results">
            @if (term.Length < GeneratedDocumentationExplorerContext.MinTermLength)
            {
                <p class="gde-muted" data-testid="gde-search-all-hint">Type at least @GeneratedDocumentationExplorerContext.MinTermLength characters to search every generated document of this import.</p>
            }
            else
            {
                var all = AllResults();
                var shown = all.Results.Where(r => _allType.Length == 0 || r.Document.Role.ToString() == _allType).ToList();
                var matches = shown.Sum(r => r.Matches);
                <div class="gde-search-all-head">
                    <p role="status" data-testid="gde-search-summary">@(shown.Count == 0 ? "No match in the generated documents of this import." : $"{matches} match{(matches == 1 ? "" : "es")} in {shown.Count} document{(shown.Count == 1 ? "" : "s")} of this import")@(all.Truncated ? $" · limited to the first {GeneratedDocumentationExplorerContext.MaxDocuments} documents" : "")</p>
                    @if (all.Results.Count > 0)
                    {
                        <label class="gde-field gde-inline"><span class="visually-hidden">Result document type</span>
                            <select data-testid="gde-search-all-type" @onchange="e => _allType = e.Value?.ToString() ?? string.Empty">
                                <option value="">All types</option>
                                @foreach (var role in all.Results.Select(r => r.Document.Role).Distinct().OrderBy(r => r)) { <option value="@role" selected="@(_allType == role.ToString())">@Gde.RoleLabel(role)</option> }
                            </select></label>
                        <button type="button" class="btn-link" data-testid="gde-search-results-toggle" aria-expanded="@(_resultsCollapsed ? "false" : "true")" @onclick="() => _resultsCollapsed = !_resultsCollapsed">@(_resultsCollapsed ? "Show results" : "Hide results")</button>
                    }
                </div>
                @if (!_resultsCollapsed && shown.Count > 0)
                {
                    <ol class="gde-plain gde-search-groups">
                        @foreach (var result in shown)
                        {
                            var doc = result.Document;
                            <li class="gde-search-group @(doc.Path == _selectedPath ? "is-current" : "")" data-testid="gde-search-result" data-path="@doc.Path" data-module="@doc.Module" data-role="@doc.Role">
                                <div class="gde-search-group-head">
                                    <button type="button" class="gde-link" data-testid="gde-search-result-open" title="@doc.Path" @onclick="() => OpenResult(doc)"><strong>@TitleOf(doc)</strong></button>
                                    <span class="gde-pill">@doc.RoleLabel</span>
                                    <span class="gde-muted">@doc.Module</span>
                                    <span class="gde-muted" data-testid="gde-search-result-count">@result.Matches match@(result.Matches == 1 ? "" : "es")</span>
                                </div>
                                <ul class="gde-plain gde-snippets">
                                    @foreach (var snippet in result.Snippets)
                                    {
                                        <li data-testid="gde-search-snippet" data-line="@snippet.Line"><span class="gde-muted">L@(snippet.Line)</span> @snippet.Before<mark>@snippet.Match</mark>@snippet.After</li>
                                    }
                                </ul>
                            </li>
                        }
                    </ol>
                }
            }
        </section>
    };

    /// <summary>Registered systems the document names exactly, linked to Systems &amp; Scopes; nothing when no registry or no active environment.</summary>
    private RenderFragment SystemsReferenced(GeneratedDocumentView v) => __builder =>
    {
        <section class="gde-context" aria-labelledby="gde-systems-h" data-testid="gde-systems">
            <h3 id="gde-systems-h" class="gde-h3">Systems named in this document</h3>
            @if (_systems is null) { <p class="gde-muted" data-testid="gde-systems-unavailable">@(_systemsNote ?? "Loading the registered systems…")</p> }
            else
            {
                var mentions = GeneratedDocumentationReader.SystemMentions(v.Content, _systems);
                @if (mentions.Count == 0) { <p class="gde-muted" data-testid="gde-systems-none">No registered system or service is named here by its exact name. Similar names are not linked.</p> }
                else
                {
                    <ul class="gde-chips">
                        @foreach (var (system, mention) in mentions)
                        {
                            <li><a class="gde-chip" data-testid="gde-system-link" data-key="@system.Key" href="@($"project-scopes?tab=connections&system={Uri.EscapeDataString(system.Key)}")">@system.Name</a>
                                @if (mention != system.Name) { <span class="gde-muted"> (named “@mention”)</span> }</li>
                        }
                    </ul>
                    <p class="gde-muted">Exact names of systems the shared registry holds for the active Target Environment. A name in a document is a reference, not a verified relationship.</p>
                }
            }
        </section>
    };

    /// <summary>The same document in other imports (Documentation Drift's own version list), with a heading/diagram comparison as a reading aid.</summary>
    private RenderFragment Revisions(GeneratedDocumentView v) => __builder =>
    {
        var versions = DocumentationDrift.Versions(_catalog, v.Document.Document);
        <section class="gde-context" aria-labelledby="gde-rev-h" data-testid="gde-revisions">
            <h3 id="gde-rev-h" class="gde-h3">Revisions</h3>
            @if (versions.Count <= 1) { <p class="gde-muted" data-testid="gde-revisions-none">No other import holds this document, so there is nothing to compare with yet.</p> }
            else
            {
                var index = versions.ToList().FindIndex(x => x.Id == v.Document.Document.Id);
                var previous = index > 0 ? versions[index - 1] : null;
                <ol class="gde-plain" data-testid="gde-revision-list">
                    @foreach (var r in versions)
                    {
                        <li data-current="@(r.Id == v.Document.Document.Id ? "true" : "false")">@(r.ProjectRevision ?? r.ProjectImportId) · @(r.ImportedAt?.ToLocalTime().ToString("g") ?? "date not known")@(r.Id == v.Document.Document.Id ? " · this one" : r.Fingerprint == v.Document.Document.Fingerprint ? " · same content" : " · different content")</li>
                    }
                </ol>
                @if (previous is not null && Repository?.SddLifecycle is { } state)
                {
                    var diff = GeneratedDocumentationReader.CompareOutline(DocumentationDrift.Text(state, previous), v.Content);
                    <div data-testid="gde-revision-diff">
                        @if (previous.Fingerprint == v.Document.Document.Fingerprint) { <p class="gde-muted">Same content as the previous import.</p> }
                        else
                        {
                            <p>Compared with the previous import: <strong>@diff.Added.Count</strong> heading@(diff.Added.Count == 1 ? "" : "s") added, <strong>@diff.Removed.Count</strong> removed, diagrams @(diff.DiagramsChanged ? $"changed ({diff.DiagramsBefore} → {diff.DiagramsAfter})" : "unchanged").</p>
                            @if (diff.Added.Count > 0) { <p class="gde-muted">Added: @string.Join(" · ", diff.Added.Take(12))</p> }
                            @if (diff.Removed.Count > 0) { <p class="gde-muted">Removed: @string.Join(" · ", diff.Removed.Take(12))</p> }
                            <p class="gde-muted">A reading aid from headings and diagram sources; wording changes inside sections are not listed. Documentation Drift owns the comparison.</p>
                        }
                    </div>
                }
            }
            @if (Gde.DriftConcernOf(v.Document.Role) is { } concern && !v.Document.RepositoryLevel)
            {
                <p><a class="gde-link" data-testid="gde-revisions-drift" href="@($"documentation-drift?tab=compare&import={Uri.EscapeDataString(_importId)}&module={Uri.EscapeDataString(v.Document.Module)}&concern={concern}")">Compare in Documentation Drift</a></p>
            }
        </section>
    };

    private static string Short(string fingerprint) => fingerprint.Length > 12 ? fingerprint[..12] : fingerprint;
}
