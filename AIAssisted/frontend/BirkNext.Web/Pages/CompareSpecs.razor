@page "/compare"
@using BirkNext.Web.Components

<PageTitle>Compare Specs</PageTitle>

<div class="compare-specs-shell">
    <section class="compare-specs-hero" aria-label="Compare specs workflow overview">
        <div>
            <p class="section-kicker">Delta Review Workflow</p>
            <h1>Compare Specs</h1>
            <p class="page-lead">Compare two specification versions and identify requirement, test, clarification, and traceability impact before updating QA coverage.</p>
        </div>
        <div class="compare-hero-benefits" aria-label="Delta detection coverage">
            <span>Added requirements</span>
            <span>Removed requirements</span>
            <span>Changed requirements</span>
            <span>New clarification risks</span>
            <span>Test coverage impact</span>
            <span>Traceability impact</span>
        </div>
    </section>

    <SpecComparisonPanel />
</div>
