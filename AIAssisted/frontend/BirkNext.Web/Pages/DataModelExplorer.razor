@page "/data-model-explorer"
@using BirkNext.Web.Components
@using BirkNext.Web.Models
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject BirkNext.Web.Services.IWorkspaceSessionService Workspace
@inject BirkNext.Web.Services.IReportExportService ExportService
@inject BirkNext.Web.Services.IDataModelAnalysisService DataModelService

<PageTitle>Data Model Explorer — QA Review Studio</PageTitle>

<div class="dme-page">

    <PageHeader Title="Data Model Explorer"
                Description="Review database entities, tables, relationships, constraints, indexes, and traceability from data-model.md." />

    @if (!string.IsNullOrWhiteSpace(_initialText))
    {
        <div style="display:flex;justify-content:flex-end;margin-bottom:.5rem">
            <button style="background:#1d4ed8;color:#fff;border:none;padding:.35rem .85rem;border-radius:5px;cursor:pointer;font-size:.78rem" @onclick="ExportHtml">Export HTML</button>
        </div>
    }

    <div class="dme-page-body">
        <DataModelExplorerPanel
            DataModelText="@_initialText"
            ParsedDataModel="@_parsedDataModel"
            SemanticModel="@_semanticModel"
            InitialView="@_initialView"
            OnTextChanged="OnPanelTextChanged" />
    </div>

</div>

@code {
    private string _initialText = string.Empty;
    private string? _initialView;
    private DataModelDocument? _parsedDataModel;
    private DataModelSemanticModel? _semanticModel;

    private const string StorageKey = "dme-standalone-datamodel";

    protected override void OnInitialized()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("view", out var view))
            _initialView = view;

        var cached = Workspace.Get(WorkspaceArtifactKind.DataModel);
        if (cached != null)
            _initialText = cached.Text;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!string.IsNullOrWhiteSpace(_initialText)) return;

        string? legacy = null;
        try { legacy = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey); } catch { }

        if (!string.IsNullOrWhiteSpace(legacy))
        {
            Workspace.Set(WorkspaceArtifactKind.DataModel, legacy);
            _initialText = legacy;
            BuildSemanticModel(legacy);
            StateHasChanged();
        }
    }

    private void BuildSemanticModel(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            _semanticModel = null;
            _parsedDataModel = null;
            return;
        }
        _parsedDataModel = DataModelService.Parse(text);
        _semanticModel = DataModelAnalysisService.BuildSemanticModel(_parsedDataModel);
    }

    private async Task ExportHtml()
    {
        if (_parsedDataModel is null) return;
        var html = ExportService.ExportDataModel(_parsedDataModel, Workspace.ProjectName);
        await JS.InvokeVoidAsync("downloadHtmlFile", $"data-model-{DateTime.UtcNow:yyyy-MM-dd}.html", html);
    }

    private async Task OnPanelTextChanged(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        BuildSemanticModel(text);
        Workspace.Set(WorkspaceArtifactKind.DataModel, text);
        try
        {
            if (string.IsNullOrWhiteSpace(Workspace.CurrentProject))
                await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, text);
            else
                await JS.InvokeVoidAsync("localStorage.removeItem", StorageKey);
        }
        catch { }
    }
}
