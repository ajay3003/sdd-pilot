@page "/data-model-explorer"
@using BirkNext.Web.Components
@using BirkNext.Web.Components.Explorers
@using BirkNext.Web.Models
@using BirkNext.Web.Services.Explorers
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject BirkNext.Web.Services.IWorkspaceSessionService Workspace
@inject BirkNext.Web.Services.IReportExportService ExportService
@inject BirkNext.Web.Services.IDataModelAnalysisService DataModelService
@inject IArtifactExplorerContext ExplorerContext

<PageTitle>Data Model Explorer — QA Review Studio</PageTitle>

<div class="dme-page">

    <PageHeader Title="Data Model Explorer"
                Description="@ArtifactExplorerRoles.Purpose(WorkspaceArtifactType.DataModel)" />

    <ArtifactExplorerHost @ref="_host" Role="WorkspaceArtifactType.DataModel" OnStateChanged="OnArtifactChanged">
        @if (_analysisError is not null)
        {
            <ExplorerAnalysisError Role="WorkspaceArtifactType.DataModel" Message="@_analysisError" />
        }
        else
        {
            <div class="dme-export-row">
                <button type="button" class="btn-primary" @onclick="ExportHtml">Export HTML</button>
            </div>
            <div class="dme-page-body">
                @if (_baseParsed is not null && _parsed is not null)
                {
                    @* A pack's own data model over the shared base of its module/project: both stay separate artifacts; the aggregate is derived. *@
                    <fieldset class="dme-layers" data-testid="dme-layers">
                        <legend>Data model layer</legend>
                        @foreach (var (key, label) in LayerOptions)
                        {
                            <label class="dme-layer-option">
                                <input type="radio" name="dme-layer" value="@key" checked="@(_layer == key)" data-testid="dme-layer-@key" @onchange="() => _layer = key" />
                                @label
                            </label>
                        }
                        <p class="dme-layer-note" data-testid="dme-layer-note">@LayerNote</p>
                    </fieldset>
                }
                <DataModelExplorerPanel
                    DataModelText="@(_layer == "base" ? _baseText : _text)"
                    ParsedDataModel="@ShownModel"
                    SemanticModel="@(_layer == "pack" ? _semanticModel : null)"
                    InitialView="@_initialView"
                    ArtifactPath="@ShownPath"
                    ArtifactRevision="@(_layer == "base" ? _baseRevision : _layer == "pack" ? _artifactRevision : null)"
                    OriginOverride="@(_layer == "aggregate" ? "Derived aggregate — shared base plus this pack's model; read-only, never an authored artifact" : null)"
                    EntityLayers="@(_layer == "aggregate" ? _aggregateOrigins : null)"
                    BaseArtifactPath="@_basePath"
                    PackArtifactPath="@_artifactPath"
                    OnTextChanged="ImportFromPanel" />
                <ReviewDisclosure Text="Source data model evidence" CollapseText="Hide source data model evidence" Hint="The persistence model Source Analysis extracted · compared with this document"
                                  TestId="dme-source-evidence" Class="disclosure-inline" @bind-Expanded="_sourceEvidenceExpanded">
                    @if (_sourceEvidenceExpanded) { <DataModelEvidencePanel DocumentedEntities="@(_parsed?.Entities.Select(e => e.Name).Where(n => !string.IsNullOrWhiteSpace(n)).ToList())" /> }
                </ReviewDisclosure>
            </div>
        }
    </ArtifactExplorerHost>

</div>

@code {
    private ArtifactExplorerHost? _host;
    private bool _sourceEvidenceExpanded;
    private string _text = string.Empty;
    private string? _initialView;
    private string? _analysisError;
    private DataModelDocument? _parsed;
    private DataModelSemanticModel? _semanticModel;

    protected override void OnInitialized()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("view", out var view))
            _initialView = view;
    }

    // The panel's own paste box goes through the repository like every other import.
    private Task ImportFromPanel(string text) => _host?.ImportPastedAsync(text) ?? Task.CompletedTask;

    private string? _artifactPath;
    private int? _artifactRevision;

    // ── Layers: pack model over a shared base data model ─────────────────────
    private string _layer = "pack";
    private string _baseText = string.Empty;
    private string? _basePath;
    private int? _baseRevision;
    private DataModelDocument? _baseParsed;
    private DataModelDocument? _aggregate;
    private IReadOnlyDictionary<string, BirkNext.Web.Services.DataModelLayerOrigin>? _aggregateOrigins;

    private static readonly (string Key, string Label)[] LayerOptions = [("pack", "Pack model"), ("base", "Shared base"), ("aggregate", "Derived aggregate")];

    private DataModelDocument? ShownModel => _layer switch { "base" => _baseParsed, "aggregate" => _aggregate, _ => _parsed };
    private string? ShownPath => _layer switch { "base" => _basePath, "aggregate" => $"{_basePath} + {_artifactPath}", _ => _artifactPath };

    private string LayerNote => _layer switch
    {
        "base" => $"The shared base data model ({_basePath}) that applies to every pack of the module.",
        "aggregate" => "Derived view: base structures plus this pack's own; a pack structure with the same name overrides the base one and is marked. Both documents stay separate.",
        _ => $"This pack's own data model ({_artifactPath}). A shared base data model also applies ({_basePath}).",
    };

    private async Task LoadSharedBaseAsync()
    {
        _baseParsed = null; _aggregate = null; _aggregateOrigins = null; _baseText = string.Empty; _basePath = null; _baseRevision = null;
        if (_parsed is null) { _layer = "pack"; return; }
        ArtifactExplorerState? shared;
        try { shared = await ExplorerContext.GetSharedBaseAsync(WorkspaceArtifactType.DataModel); }
        catch (Exception) { shared = null; }
        if (shared is not { Content: { Length: > 0 } baseText, Selected: { } baseArtifact }) { _layer = "pack"; return; }
        try
        {
            _baseParsed = DataModelService.Parse(baseText);
            (_aggregate, _aggregateOrigins) = BirkNext.Web.Services.DataModelLayers.Aggregate(_baseParsed, _parsed);
            _baseText = baseText;
            _basePath = baseArtifact.SourcePath ?? baseArtifact.FileName;
            _baseRevision = baseArtifact.Revision;
        }
        catch (Exception)
        {
            _baseParsed = null; _aggregate = null; _aggregateOrigins = null; _layer = "pack";
        }
    }

    private async Task OnArtifactChanged(ArtifactExplorerState state)
    {
        _artifactPath = state.Selected?.SourcePath ?? state.Selected?.FileName;
        _artifactRevision = state.Selected?.Revision;
        var text = state.Content ?? string.Empty;
        if (string.Equals(text, _text, StringComparison.Ordinal)) { await LoadSharedBaseAsync(); return; }
        _text = text;
        _parsed = null;
        _semanticModel = null;
        _analysisError = null;
        if (string.IsNullOrWhiteSpace(text)) { await LoadSharedBaseAsync(); return; }
        try
        {
            _parsed = DataModelService.Parse(text);
            _semanticModel = DataModelAnalysisService.BuildSemanticModel(_parsed);
        }
        catch (Exception ex)
        {
            _parsed = null;
            _semanticModel = null;
            _analysisError = ex.Message;
        }
        await LoadSharedBaseAsync();
    }

    private async Task ExportHtml()
    {
        if (_parsed is null) return;
        var html = ExportService.ExportDataModel(_parsed, Workspace.ProjectName);
        await JS.InvokeVoidAsync("downloadHtmlFile", $"data-model-{DateTime.UtcNow:yyyy-MM-dd}.html", html);
    }
}
