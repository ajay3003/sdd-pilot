        sb.AppendLine("<style>body{font-family:system-ui,sans-serif;margin:2rem;color:#1f2937}table{border-collapse:collapse;width:100%;margin:1rem 0}th,td{border:1px solid #d1d5db;padding:.5rem;text-align:left}th{background:#f3f4f6}.finding{border:1px solid #d1d5db;padding:.75rem;margin:.5rem 0}</style></head><body>");
        sb.AppendLine($"<h1>ReviewContext Validation</h1><p>Project: {E(report.ProjectName)}<br>Status: {E(report.OverallStatus)}<br>Generated: {E(report.GeneratedAt.ToString("u"))}</p>");
        sb.AppendLine("<h2>Canonical Metrics</h2><table><thead><tr><th>Name</th><th>Value</th><th>Source</th></tr></thead><tbody>");
        foreach (var metric in report.CanonicalMetrics)
            sb.AppendLine($"<tr><td>{E(metric.Name)}</td><td>{E(metric.Value)}</td><td>{E(metric.Source)}</td></tr>");
        sb.AppendLine("</tbody></table><h2>Source Comparisons</h2><table><thead><tr><th>Metric</th><th>ReviewContext</th><th>All Match</th></tr></thead><tbody>");
        foreach (var comparison in report.SourceComparisons)
            sb.AppendLine($"<tr><td>{E(comparison.Metric)}</td><td>{E(comparison.ReviewContextValue)}</td><td>{E(comparison.AllMatch)}</td></tr>");
        sb.AppendLine("</tbody></table><h2>Findings</h2>");
        foreach (var finding in report.Findings)
            sb.AppendLine($"<div class=\"finding\"><strong>{E(finding.Severity)} - {E(finding.MetricName)}</strong><br>{E(finding.Message)}<br><small>{E(finding.Source)}</small></div>");
        sb.AppendLine("</body></html>");
        return sb.ToString();
    }

    private async Task RunEnvironmentDiagnosticsAsync()
    {
        if (_envDiagRunning) return;
        _envDiagRunning = true;
        _envDiagMessage = null;
        _envDiagErrorDetails = null;
        _envDiagStackTrace = null;
        StateHasChanged();

        try
        {
            var (report, errorMessage, errorStack) = await AdminApi.GetEnvironmentDiagnosticsWithErrorDetailsAsync();

            if (report is not null)
            {
                _envDiagReport = report;
                _envDiagErrorDetails = null;
                _envDiagStackTrace = null;
                _envDiagMessage = $"Diagnostics complete: {_envDiagReport.OverallStatus} — {_envDiagReport.DatabaseChecks.Count} database, {_envDiagReport.BackendApiChecks.Count} backend, {_envDiagReport.WorkspaceChecks.Count} workspace checks run.";
            }
            else
            {
                // Diagnostics failed - show detailed error
                _envDiagReport = null;
                _envDiagErrorDetails = errorMessage ?? "Unknown error occurred";
                _envDiagStackTrace = errorStack;
                _envDiagMessage = "Diagnostics failed — see details below.";
            }
        }
        catch (Exception ex)
        {
            _envDiagReport = null;
            _envDiagErrorDetails = $"{ex.GetType().Name}: {ex.Message}";
            _envDiagStackTrace = ex.StackTrace ?? "No stack trace available";
            _envDiagMessage = "Diagnostics failed with exception.";
        }
        finally
        {
            _envDiagRunning = false;
            StateHasChanged();
        }
    }

