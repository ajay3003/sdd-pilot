    private static string BuildEnvironmentDiagnosticsHtml(EnvironmentDiagnosticsReportDto report)
    {
        static string E(object? value) => System.Net.WebUtility.HtmlEncode(value?.ToString() ?? "");
        static string StatusBadge(SystemSettingsStatus status) => status switch
        {
            SystemSettingsStatus.Pass => "<span style=\"background:#d1fae5;color:#065f46;padding:.25rem .5rem;border-radius:.25rem;font-weight:600;font-size:.85rem\">Pass</span>",
            SystemSettingsStatus.Warning => "<span style=\"background:#fef08a;color:#854d0e;padding:.25rem .5rem;border-radius:.25rem;font-weight:600;font-size:.85rem\">Warning</span>",
            SystemSettingsStatus.Fail => "<span style=\"background:#fee2e2;color:#991b1b;padding:.25rem .5rem;border-radius:.25rem;font-weight:600;font-size:.85rem\">Fail</span>",
            _ => "<span style=\"background:#f3f4f6;color:#6b7280;padding:.25rem .5rem;border-radius:.25rem;font-weight:600;font-size:.85rem\">Unavailable</span>"
        };

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("<!doctype html><html><head><meta charset=\"utf-8\"><title>Environment Diagnostics</title>");
        sb.AppendLine("<style>body{font-family:system-ui,sans-serif;margin:2rem;color:#1f2937}h2{border-top:2px solid #d1d5db;padding-top:1rem;margin-top:1.5rem}.check{display:flex;align-items:flex-start;gap:1rem;margin:.75rem 0;padding:.75rem;background:#f9fafb;border-radius:.5rem}.check-status{flex-shrink:0;font-weight:600;min-width:80px}.check-body{flex:1}.check-name{font-weight:600;margin-bottom:.25rem}.check-detail{font-size:.85rem;color:#6b7280;margin:0}.check-rec{font-size:.85rem;color:#6b7280;margin:.25rem 0 0;font-style:italic}</style></head><body>");
        sb.AppendLine($"<h1>Environment Diagnostics</h1>");
        sb.AppendLine($"<p>Environment: {E(report.Environment)}<br>Generated: {E(report.GeneratedAt.ToString("u"))}<br>Overall Status: {StatusBadge(report.OverallStatus)}</p>");

        if (report.DatabaseChecks.Count > 0)
        {
            sb.AppendLine("<h2>Database</h2>");
            foreach (var check in report.DatabaseChecks)
            {
                sb.AppendLine($"<div class=\"check\">");
                sb.AppendLine($"<div class=\"check-status\">{StatusBadge(check.Status)}</div>");
                sb.AppendLine($"<div class=\"check-body\">");
                sb.AppendLine($"<div class=\"check-name\">{E(check.Name)}</div>");
                if (!string.IsNullOrWhiteSpace(check.Details))
                    sb.AppendLine($"<p class=\"check-detail\">{E(check.Details)}</p>");
                if (!string.IsNullOrWhiteSpace(check.Recommendation))
                    sb.AppendLine($"<p class=\"check-rec\">→ {E(check.Recommendation)}</p>");
                sb.AppendLine("</div></div>");
            }
        }

        if (report.BackendApiChecks.Count > 0)
        {
            sb.AppendLine("<h2>Backend / API</h2>");
            foreach (var check in report.BackendApiChecks)
            {
                sb.AppendLine($"<div class=\"check\">");
                sb.AppendLine($"<div class=\"check-status\">{StatusBadge(check.Status)}</div>");
                sb.AppendLine($"<div class=\"check-body\">");
                sb.AppendLine($"<div class=\"check-name\">{E(check.Name)}</div>");
                if (!string.IsNullOrWhiteSpace(check.Details))
                    sb.AppendLine($"<p class=\"check-detail\">{E(check.Details)}</p>");
                sb.AppendLine("</div></div>");
            }
        }

        if (report.WorkspaceChecks.Count > 0)
        {
            sb.AppendLine("<h2>Workspace</h2>");
            foreach (var check in report.WorkspaceChecks)
            {
                sb.AppendLine($"<div class=\"check\">");
                sb.AppendLine($"<div class=\"check-status\">{StatusBadge(check.Status)}</div>");
                sb.AppendLine($"<div class=\"check-body\">");
                sb.AppendLine($"<div class=\"check-name\">{E(check.Name)}</div>");
                if (!string.IsNullOrWhiteSpace(check.Details))
                    sb.AppendLine($"<p class=\"check-detail\">{E(check.Details)}</p>");
                sb.AppendLine("</div></div>");
            }
        }

        if (report.ReviewContextChecks.Count > 0)
        {
            sb.AppendLine("<h2>ReviewContext</h2>");
            foreach (var check in report.ReviewContextChecks)
            {
                sb.AppendLine($"<div class=\"check\">");
                sb.AppendLine($"<div class=\"check-status\">{StatusBadge(check.Status)}</div>");
                sb.AppendLine($"<div class=\"check-body\">");
                sb.AppendLine($"<div class=\"check-name\">{E(check.Name)}</div>");
                if (!string.IsNullOrWhiteSpace(check.Details))
                    sb.AppendLine($"<p class=\"check-detail\">{E(check.Details)}</p>");
                sb.AppendLine("</div></div>");
            }
        }

        if (report.ExportChecks.Count > 0)
        {
            sb.AppendLine("<h2>Export</h2>");
            foreach (var check in report.ExportChecks)
            {
                sb.AppendLine($"<div class=\"check\">");
                sb.AppendLine($"<div class=\"check-status\">{StatusBadge(check.Status)}</div>");
                sb.AppendLine($"<div class=\"check-body\">");
                sb.AppendLine($"<div class=\"check-name\">{E(check.Name)}</div>");
                if (!string.IsNullOrWhiteSpace(check.Details))
                    sb.AppendLine($"<p class=\"check-detail\">{E(check.Details)}</p>");
                sb.AppendLine("</div></div>");
            }
        }

        sb.AppendLine("</body></html>");
        return sb.ToString();
    }

