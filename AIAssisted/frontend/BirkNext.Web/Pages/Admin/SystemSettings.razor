    private List<DocHealthFinding> RunDocumentationHealthChecks()
    {
        var findings = new List<DocHealthFinding>();

        // 1. Validate NavMenu links are known routes.
        foreach (var (label, href) in DocNavLinks)
        {
            var normalised = "/" + href.TrimStart('/');
            if (!KnownRoutes.Contains(normalised))
                findings.Add(new("Error", "Navigation Link", $"NavMenu item \"{label}\" links to \"{href}\" which is not a known route.", $"Route checked: {normalised}"));
            if (RemovedRoutes.Contains(href) || RemovedRoutes.Contains(normalised))
                findings.Add(new("Error", "Removed Route Reference", $"NavMenu item \"{label}\" links to a removed route: {href}"));
        }

        // 2. Validate documentation page links are known routes.
        foreach (var (page, href, ctx) in DocPageLinks)
        {
            var normalised = href.StartsWith('/') ? href : "/" + href;
            if (!KnownRoutes.Contains(normalised))
                findings.Add(new("Error", "Broken Documentation Link", $"{page} — \"{ctx}\" links to \"{href}\" which is not a known route.", $"Route checked: {normalised}"));
            if (RemovedRoutes.Contains(href) || RemovedRoutes.Contains(normalised))
                findings.Add(new("Error", "Removed Route Reference", $"{page} — \"{ctx}\" references a removed route: {href}"));
        }

        // 3. Menu synchronisation — check MenuItemRegistry hrefs are in KnownRoutes via DocNavLinks.
        var navLinkHrefSet = new HashSet<string>(DocNavLinks.Select(l => "/" + l.Href.TrimStart('/')), StringComparer.OrdinalIgnoreCase);
        foreach (var (menuLabel, _) in MenuItemRegistry)
        {
            // Find matching nav link by label
            var matchingNav = DocNavLinks.FirstOrDefault(l =>
                string.Equals(l.Label, menuLabel, StringComparison.OrdinalIgnoreCase));
            if (matchingNav == default)
                findings.Add(new("Warning", "Menu Mismatch", $"MenuItemRegistry entry \"{menuLabel}\" has no matching DocNavLinks entry. If this menu item exists in NavMenu, add it to DocNavLinks."));
        }

        // 4. Orphan documentation check — pages that exist but have no menu item.
        var menuLabels = new HashSet<string>(MenuItemRegistry.Select(m => m.Label), StringComparer.OrdinalIgnoreCase);
        // (No-op for now: pages without menu entries are internal/redirect pages — not an error.)

        return findings;
    }
