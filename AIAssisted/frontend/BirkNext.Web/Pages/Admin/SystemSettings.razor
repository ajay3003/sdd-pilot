    private async Task ResetWorkspaceDiagnosticsAsync()
    {
        if (!await ConfirmRuntimeActionAsync(
            "Reset Workspace",
            "This clears only browser/session workspace state. It does not delete saved workspaces or modify database schema. Continue?"))
            return;

        foreach (var kind in Enum.GetValues<WorkspaceArtifactKind>())
            Workspace.Clear(kind);

        Workspace.CurrentProject = null;
        _runtimeActionMessage = "Workspace session state reset. Saved workspaces and database schema were not modified.";
        await RefreshRuntimeDiagnosticsAsync();
    }

    private async Task ClearRuntimeSessionsAsync()
    {
        if (!await ConfirmRuntimeActionAsync(
            "Clear Runtime Sessions",
            "This clears browser runtime review results only. It does not delete saved workspaces or modify database schema. Continue?"))
            return;

        RuntimeReviews.ClearSecurityResult();
        RuntimeReviews.ClearPerformanceResult();
        _runtimeActionMessage = "Runtime sessions cleared. Saved workspaces and database schema were not modified.";
        await RefreshRuntimeDiagnosticsAsync();
    }

    private async Task ClearAnalysisSessionsAsync()
    {
        if (!await ConfirmRuntimeActionAsync(
            "Clear Analysis Sessions",
            "This clears in-memory analysis snapshots and extraction session state. It does not delete saved workspaces or modify database schema. Continue?"))
            return;

        AnalysisSessions.Clear();
        QualitySession.Clear();
        AdoApi.ClearCache();
        await ExtractionSession.ClearAsync();
        _extractionSnapshot = null;
        _runtimeActionMessage = "Analysis sessions cleared. Saved workspaces and database schema were not modified.";
        StateHasChanged();
    }

    private async Task ClearRuntimeCachesAsync()
    {
        if (!await ConfirmRuntimeActionAsync(
            "Clear Caches",
            "This clears supported browser/API caches. It does not delete saved workspaces or modify database schema. Continue?"))
            return;

        AdoApi.ClearCache();
        SecurityApi.ClearCache();
        PerformanceApi.ClearCache();
        await ExtractionSession.ClearAsync();
        _extractionSnapshot = null;
        _runtimeActionMessage = "Runtime caches cleared where supported. Saved workspaces and database schema were not modified.";
        StateHasChanged();
    }

