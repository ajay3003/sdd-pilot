@page "/admin/system-settings"
@using BirkNext.Web.Services
@using BirkNext.Web.Components
@using BirkNext.Web.Models
@using static BirkNext.Web.Services.AdminApiService
@inject AdminApiService AdminApi
@inject FeatureVisibilityService FeatureViz
@inject ImplementationTraceabilityApiService AdoApi
@inject ProjectDocumentApiService DocumentApi
@inject IJSRuntime JS
@inject IWorkspaceSessionService Workspace
@inject IWorkspaceArtifactStatusService ArtifactStatus
@inject RuntimeReviewSessionService RuntimeReviews
@inject QualityReviewSessionService QualitySession
@inject IDashboardSnapshotService AnalysisSessions
@inject IExtractionSessionService ExtractionSession
@inject IArtifactParserService MarkdownEngine
@inject IReviewContextValidator ReviewContextValidator
@inject WasmSecurityApiService SecurityApi
@inject IBlazorWasmPerformanceReviewService PerformanceApi
@inject Microsoft.AspNetCore.Components.WebAssembly.Hosting.IWebAssemblyHostEnvironment HostEnvironment

<PageTitle>System Settings — QA Review Studio</PageTitle>

<PageHeader Title="System Settings"
            Description="Manage feature visibility and platform configuration. Secrets are never shown.">
    @if (_settings is not null)
    {
        @if (_isEditMode)
        {
            <SecondaryButton OnClick="CancelEdit" Disabled="@_isSaving">Cancel</SecondaryButton>
            <PrimaryButton OnClick="SaveAsync" Disabled="@_isSaving" Class="btn-save">
                @(_isSaving ? "Saving…" : "Save Settings")
            </PrimaryButton>
        }
        else
        {
            <button class="btn-edit-settings"
                    @onclick="EnterEditMode"
                    disabled="@(_editableSettings is null)">
                <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708l-3-3zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207l6.5-6.5zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.499.499 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11l.178-.178z"/></svg>
                Edit Settings
            </button>
            <button class="btn-copy-diag @(_copiedDiag ? "btn-copy-diag-done" : "")"
                    @onclick="CopyDiagnosticsAsync"
                    disabled="@_copiedDiag">
                @if (_copiedDiag)
                {
                    <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 1 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0z"/></svg>
                    <span>Copied!</span>
                }
                else
                {
                    <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1z"/><path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3z"/></svg>
                    <span>Copy Diagnostics</span>
                }
            </button>
        }
    }
</PageHeader>

@if (_saveSuccess is not null)
{
    <div class="notification notification-success" role="status">@_saveSuccess</div>
}
@if (_saveError is not null)
{
    <div class="notification notification-error" role="alert">@_saveError</div>
}

@if (_isLoading)
{
    <p class="loading-state">Loading settings...</p>
}
else if (_loadError is not null)
{
    <div class="notification notification-error" role="alert">@_loadError</div>
}
else if (_settings is not null)
{
    <div class="ss-status-bar">
        <span class="ss-status-pill">
            <span class="ss-status-label">Environment</span>
            <span class="ss-status-value">@OrUnknown(_settings.Application.Environment)</span>
        </span>
        <span class="ss-status-pill">
            <span class="ss-status-label">Database</span>
            <span class="ss-status-value">@OrUnknown(_settings.Database.Mode)</span>
        </span>
        <span class="ss-status-pill">
            <span class="ss-status-label">Package</span>
            <span class="ss-status-value">@OrUnknown(_settings.Application.PackageMode)</span>
        </span>
        <span class="ss-status-pill">
            <span class="ss-status-label">Logging</span>
            <span class="ss-status-value">@OrUnknown(_settings.Logging.MinimumLevel)</span>
        </span>
        @if (_configHealthIssueCount > 0)
        {
            <span class="ss-status-pill ss-status-pill-warn">
                <span class="ss-status-label">Config Health</span>
                <span class="ss-status-value">@_configHealthIssueCount issue@(_configHealthIssueCount != 1 ? "s" : "")</span>
            </span>
        }
        else
        {
            <span class="ss-status-pill ss-status-pill-ok">
                <span class="ss-status-label">Config Health</span>
                <span class="ss-status-value">All clear</span>
            </span>
        }
    </div>

    <div class="ss-layout">

        @* ── Left Navigation ──────────────────────────────────────────────────────── *@
        <nav class="ss-nav" aria-label="Settings sections">
            <div class="ss-nav-search">
                <div class="ss-nav-search-wrap">
                    <svg class="ss-nav-search-icon" width="11" height="11" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.099zm-5.242 1.656a5.5 5.5 0 1 1 0-11 5.5 5.5 0 0 1 0 11z"/>
                    </svg>
                    <input type="search"
                           class="ss-nav-search-input"
                           placeholder="Find a section…"
                           aria-label="Search settings sections"
                           value="@_navSearch"
                           @oninput="e => _navSearch = e.Value?.ToString() ?? string.Empty" />
                </div>
            </div>

            <div class="ss-nav-group">
                <div class="ss-nav-group-label">Configuration</div>
                @NavItem("general",            "General")
                @NavItem("config-health",      "Configuration Health", _configHealthIssueCount)
                @NavItem("feature-visibility", "Feature Visibility")
                @NavItem("platform",           "Platform")
            </div>
            <div class="ss-nav-group">
                <div class="ss-nav-group-label">Analysis</div>
                @NavItem("target-environments", "Target Environments")
                @NavItem("ai",                 "AI")
            </div>
            <div class="ss-nav-group">
                <div class="ss-nav-group-label">Developer</div>
                @NavItem("environment-diagnostics", "Environment Diagnostics")
                @NavItem("diagnostics",        "System Diagnostics")
                @NavItem("doc-health",         "Documentation Health", _docHealthIssueCount)
                @if (IsDeveloperDiagnosticsVisible)
                {
                    @NavItem("review-context-validation", "ReviewContext Validation")
                }
                @NavItem("ui-migration",       "Runtime Diagnostics")
                @NavItem("maintenance",        "Maintenance")
            </div>
        </nav>

        @* ── Right Content ────────────────────────────────────────────────────────── *@
        <div class="ss-content">

            @if (_isEditMode)
            {
                <div class="ss-edit-banner" role="status">
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708l-3-3zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207l6.5-6.5zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.499.499 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11l.178-.178z"/></svg>
                    <span>Editing settings — navigate sections freely and save when done.</span>
                </div>
            }

            @* ══ General ══════════════════════════════════════════════════════════════ *@
            @if (_activeSection == "general")
            {
                <div class="settings-card settings-card-full-width">
                    <div class="settings-card-title">General</div>
                    <p class="settings-card-note">Runtime environment and application information. All values are read-only.</p>

                    <div class="ss-info-grid">
                        <MetricCard Value="@OrUnknown(_settings.Application.Environment)" Label="Environment" />
                        <MetricCard Value="@OrUnknown(_settings.Application.PackageMode)" Label="Package" />
                        <MetricCard Value="@OrUnknown(_settings.Database.Mode)" Label="Database" />
                        <MetricCard Value="@OrUnknown(_settings.Logging.MinimumLevel)" Label="Logging" />
                        <MetricCard Value="@SemVerCore(_settings.Application.Version)" Label="Version" />
                        <MetricCard Value="@(_settings.Frontend.StaticHostingMode ? "Blazor WASM" : "Server-side")" Label="Hosting" />
                    </div>

                    <div class="dev-diag-subgrid">

                        <div class="dev-diag-section">
                            <div class="dev-diag-section-title">Application</div>
                            <table class="settings-table">
                                <tr><td>Name</td><td>@OrUnknown(_settings.Application.ApplicationName)</td></tr>
                                <tr><td>Version</td><td>@OrUnknown(_settings.Application.Version)</td></tr>
                                @if (!string.IsNullOrWhiteSpace(_settings.Application.BuildNumber))
                                {
                                    <tr><td>Build</td><td>@_settings.Application.BuildNumber</td></tr>
                                }
                                @if (!string.IsNullOrWhiteSpace(_settings.Application.CommitSha))
                                {
                                    <tr><td>Commit</td><td><span class="mono-chip">@_settings.Application.CommitSha</span></td></tr>
                                }
                                <tr><td>Package Mode</td><td><span class="settings-badge">@OrUnknown(_settings.Application.PackageMode)</span></td></tr>
                                <tr>
                                    <td>Database</td>
                                    <td>
                                        <span class="settings-badge @(_settings.Database.Mode == "Local" ? "settings-badge-local" : (_settings.Database.Mode == "Shared" ? "settings-badge-shared" : ""))">
                                            @OrUnknown(_settings.Database.Mode)
                                        </span>
                                    </td>
                                </tr>
                                @if (_settings.Database.MigrationStatus is not null)
                                {
                                    <tr>
                                        <td>Migrations</td>
                                        <td>
                                            @if (_settings.Database.MigrationStatus == "Up to date")
                                            { <span class="settings-badge settings-badge-local">Up to date</span> }
                                            else
                                            { <span class="settings-badge">@_settings.Database.MigrationStatus</span> }
                                        </td>
                                    </tr>
                                }
                            </table>
                        </div>

                        <div class="dev-diag-section">
                            <div class="dev-diag-section-title">Endpoints</div>
                            <table class="settings-table">
                                <tr>
                                    <td>Frontend URL</td>
                                    <td>
                                        <div class="copyable-value">
                                            <span class="mono-chip">@OrUnknown(_settings.Frontend.FrontendBaseUrl)</span>
                                            @if (!string.IsNullOrWhiteSpace(_settings.Frontend.FrontendBaseUrl))
                                            {
                                                <button class="copy-btn" title="Copy to clipboard"
                                                        @onclick="() => CopyAsync(_settings.Frontend.FrontendBaseUrl)">
                                                    <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1z"/><path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3z"/></svg>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td>API Base URL</td>
                                    <td>
                                        <div class="copyable-value">
                                            <span class="mono-chip">@OrUnknown(_settings.Frontend.ApiBaseUrl)</span>
                                            @if (!string.IsNullOrWhiteSpace(_settings.Frontend.ApiBaseUrl))
                                            {
                                                <button class="copy-btn" title="Copy to clipboard"
                                                        @onclick="() => CopyAsync(_settings.Frontend.ApiBaseUrl)">
                                                    <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1z"/><path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3z"/></svg>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td>GraphQL</td>
                                    <td><span class="mono-chip">@OrUnknown(_settings.Frontend.GraphQlEndpoint)</span></td>
                                </tr>
                                <tr>
                                    <td>Backend URL</td>
                                    <td>
                                        <div class="copyable-value">
                                            <span class="mono-chip">@OrUnknown(_settings.Backend.BackendBaseUrl)</span>
                                            @if (!string.IsNullOrWhiteSpace(_settings.Backend.BackendBaseUrl))
                                            {
                                                <button class="copy-btn" title="Copy to clipboard"
                                                        @onclick="() => CopyAsync(_settings.Backend.BackendBaseUrl)">
                                                    <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1z"/><path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3z"/></svg>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                    </div>
                </div>
            }

            @* ══ Configuration Health ══════════════════════════════════════════════════ *@
            @if (_activeSection == "config-health")
            {
                <div class="settings-card settings-card-full-width">
                    <div class="settings-card-title">Configuration Health</div>
                    <p class="settings-card-note">System configuration checks and platform diagnostics. Identifies required vs optional configuration and their current status.</p>

                    @if (_configHealthReport is null)
                    {
                        @if (!_configHealthLoaded)
                        {
                            <p class="db-section-empty">Loading configuration health…</p>
                        }
                        else
                        {
                            <p class="db-section-empty">Unable to load configuration health. Please try again.</p>
                        }
                    }
                    else
                    {
                        <!-- Summary cards -->
                        <div class="ss-status-bar" style="margin-bottom:1.5rem">
                            <span class="ss-status-pill @(_configHealthReport.OverallStatus == SystemSettingsStatus.Pass ? "ss-status-pill-ok" : _configHealthReport.OverallStatus == SystemSettingsStatus.Fail ? "ss-status-pill-error" : "ss-status-pill-warn")">
                                <span class="ss-status-label">Overall Status</span>
                                <span class="ss-status-value">@_configHealthReport.OverallStatus</span>
                            </span>
                            <span class="ss-status-pill">
                                <span class="ss-status-label">Passed</span>
                                <span class="ss-status-value">@_configHealthReport.PassCount</span>
                            </span>
                            @if (_configHealthReport.WarningCount > 0)
                            {
                                <span class="ss-status-pill ss-status-pill-warn">
                                    <span class="ss-status-label">Warnings</span>
                                    <span class="ss-status-value">@_configHealthReport.WarningCount</span>
                                </span>
                            }
                            @if (_configHealthReport.FailCount > 0)
                            {
                                <span class="ss-status-pill ss-status-pill-error">
                                    <span class="ss-status-label">Failures</span>
                                    <span class="ss-status-value">@_configHealthReport.FailCount</span>
                                </span>
                            }
                            @if (_configHealthReport.UnavailableCount > 0)
                            {
                                <span class="ss-status-pill ss-status-pill-warn">
                                    <span class="ss-status-label">Unavailable</span>
                                    <span class="ss-status-value">@_configHealthReport.UnavailableCount</span>
                                </span>
                            }
                        </div>

                        <!-- Overall message -->
                        @if (_configHealthReport.OverallStatus == SystemSettingsStatus.Pass)
                        {
                            <p class="ss-health-all-good" role="status">
                                ✓ All required configuration checks passed.
                            </p>
                        }

                        <!-- Required checks -->
                        @if (_configHealthReport.RequiredChecks.Count > 0)
                        {
                            <div style="margin-top:1.5rem">
                                <div class="dev-diag-section-title" style="margin-bottom:0.75rem">Required Configuration</div>
                                <div class="ss-health-cards" role="list">
                                    @foreach (var check in _configHealthReport.RequiredChecks)
                                    {
                                        <div class="ss-health-card" role="listitem">
                                            <span class="ss-health-sev @GetConfigHealthStatusClass(check.Status)">@check.Status</span>
                                            <div class="ss-health-body">
                                                <div class="ss-health-component">@check.Name</div>
                                                <p class="ss-health-desc">@check.Message</p>
                                                @if (!string.IsNullOrWhiteSpace(check.Details))
                                                {
                                                    <p style="font-size:0.85rem;color:var(--clr-text-muted);margin:0.25rem 0 0">@check.Details</p>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Optional checks -->
                        @if (_configHealthReport.OptionalChecks.Count > 0)
                        {
                            <div style="margin-top:1.5rem">
                                <div class="dev-diag-section-title" style="margin-bottom:0.75rem">Optional Configuration</div>
                                <div class="ss-health-cards" role="list">
                                    @foreach (var check in _configHealthReport.OptionalChecks)
                                    {
                                        <div class="ss-health-card" role="listitem">
                                            <span class="ss-health-sev @GetConfigHealthStatusClass(check.Status)">@check.Status</span>
                                            <div class="ss-health-body">
                                                <div class="ss-health-component">@check.Name</div>
                                                <p class="ss-health-desc">@check.Message</p>
                                                @if (!string.IsNullOrWhiteSpace(check.Details))
                                                {
                                                    <p style="font-size:0.85rem;color:var(--clr-text-muted);margin:0.25rem 0 0">@check.Details</p>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            }

            @* ══ Feature Visibility ═══════════════════════════════════════════════════ *@
            @if (_activeSection == "feature-visibility")
            {
                <div class="settings-card settings-card-full-width">
                    <div class="settings-card-title">Feature &amp; Menu Visibility</div>
                    <p class="settings-card-note">
                        @if (_isEditMode)
                        {
                            <span>Toggle features on or off. Platform features are always enabled and cannot be changed. After saving, refresh the page to update the sidebar.</span>
                        }
                        else
                        {
                            <span>Controls which items appear in the left sidebar. Use <strong>Edit Settings</strong> to change, or edit <code>appsettings.Local.json</code> directly. Refresh the page after any change to update the sidebar.</span>
                        }
                    </p>

                    @if (_editableSettings is not null)
                    {
                        <!-- Platform Features — always on, shown as chips not toggles -->
                        <div class="fv-section fv-section-platform">
                            <div class="fv-section-header">
                                <span class="fv-section-label">Platform Features</span>
                                <span class="fv-section-hint">Always enabled</span>
                            </div>
                            <div class="fv-platform-chips">
                                @foreach (var entry in _editableSettings.FeatureVisibility.Platform)
                                {
                                    <div class="fv-platform-chip">
                                        <span class="fv-platform-chip-label">@entry.Label</span>
                                        <span class="fv-platform-chip-badge">Always On</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Feature count summary -->
                        <div class="fv-count-summary">
                            <div class="fv-count-chip">
                                <span class="fv-count-group">Review</span>
                                <span class="fv-count-on">@ReviewEnabled enabled</span>
                                <span class="fv-count-sep">/</span>
                                <span class="fv-count-off">@(ReviewTotal - ReviewEnabled) disabled</span>
                            </div>
                            <div class="fv-count-chip">
                                <span class="fv-count-group">Library</span>
                                <span class="fv-count-on">@LibraryEnabled enabled</span>
                                <span class="fv-count-sep">/</span>
                                <span class="fv-count-off">@(LibraryTotal - LibraryEnabled) disabled</span>
                            </div>
                            <div class="fv-count-chip">
                                <span class="fv-count-group">Analysis</span>
                                <span class="fv-count-on">@AnalysisEnabled enabled</span>
                                <span class="fv-count-sep">/</span>
                                <span class="fv-count-off">@(AnalysisTotal - AnalysisEnabled) disabled</span>
                            </div>
                            <div class="fv-count-chip">
                                <span class="fv-count-group">Quality</span>
                                <span class="fv-count-on">@QualityEnabled enabled</span>
                                <span class="fv-count-sep">/</span>
                                <span class="fv-count-off">@(QualityTotal - QualityEnabled) disabled</span>
                            </div>
                            <div class="fv-count-chip">
                                <span class="fv-count-group">AI Review</span>
                                <span class="fv-count-on">@AiEnabled enabled</span>
                                <span class="fv-count-sep">/</span>
                                <span class="fv-count-off">@(AiTotal - AiEnabled) disabled</span>
                            </div>
                        </div>

                        <!-- Grouped feature sections — aligned with sidebar navigation -->
                        <div class="fv-sections-grid">

                            <div class="fv-section">
                                <div class="fv-section-header">
                                    <span class="fv-section-label">Review</span>
                                </div>
                                @foreach (var entry in GetSectionEntries(ReviewSectionKeys))
                                {
                                    <FeatureRow Label="@entry.Label"
                                                Enabled="@(_isEditMode ? _editFv.GetValueOrDefault(entry.Key, entry.Value) : entry.Value)"
                                                IsLocked="false"
                                                IsEditMode="@_isEditMode"
                                                OnToggle="@(v => ToggleFeature(entry.Key, v))" />
                                }
                            </div>

                            <div class="fv-section">
                                <div class="fv-section-header">
                                    <span class="fv-section-label">Library</span>
                                </div>
                                @foreach (var entry in GetSectionEntries(LibrarySectionKeys))
                                {
                                    <FeatureRow Label="@entry.Label"
                                                Enabled="@(_isEditMode ? _editFv.GetValueOrDefault(entry.Key, entry.Value) : entry.Value)"
                                                IsLocked="false"
                                                IsEditMode="@_isEditMode"
                                                OnToggle="@(v => ToggleFeature(entry.Key, v))" />
                                }
                            </div>

                            <div class="fv-section">
                                <div class="fv-section-header">
                                    <span class="fv-section-label">Analysis</span>
                                </div>
                                @foreach (var entry in GetSectionEntries(AnalysisSectionKeys))
                                {
                                    <FeatureRow Label="@entry.Label"
                                                Enabled="@(_isEditMode ? _editFv.GetValueOrDefault(entry.Key, entry.Value) : entry.Value)"
                                                IsLocked="false"
                                                IsEditMode="@_isEditMode"
                                                OnToggle="@(v => ToggleFeature(entry.Key, v))" />
                                }
                            </div>

                            <div class="fv-section">
                                <div class="fv-section-header">
                                    <span class="fv-section-label">Quality</span>
                                </div>
                                @foreach (var entry in GetSectionEntries(QualitySectionKeys))
                                {
                                    <FeatureRow Label="@entry.Label"
                                                Enabled="@(_isEditMode ? _editFv.GetValueOrDefault(entry.Key, entry.Value) : entry.Value)"
                                                IsLocked="false"
                                                IsEditMode="@_isEditMode"
                                                OnToggle="@(v => ToggleFeature(entry.Key, v))" />
                                }
                            </div>

                            <div class="fv-section">
                                <div class="fv-section-header">
                                    <span class="fv-section-label">AI Review</span>
                                </div>
                                @foreach (var entry in GetSectionEntries(AiReviewKeys))
                                {
                                    <FeatureRow Label="@entry.Label"
                                                Enabled="@(_isEditMode ? _editFv.GetValueOrDefault(entry.Key, entry.Value) : entry.Value)"
                                                IsLocked="false"
                                                IsEditMode="@_isEditMode"
                                                OnToggle="@(v => ToggleFeature(entry.Key, v))" />
                                }
                            </div>

                            <div class="fv-section">
                                <div class="fv-section-header">
                                    <span class="fv-section-label">Advanced Features</span>
                                    <span class="fv-section-hint">Optional</span>
                                </div>
                                @foreach (var entry in GetSectionEntries(AdvancedOptionalKeys))
                                {
                                    <FeatureRow Label="@entry.Label"
                                                Enabled="@(_isEditMode ? _editFv.GetValueOrDefault(entry.Key, entry.Value) : entry.Value)"
                                                IsLocked="false"
                                                IsEditMode="@_isEditMode"
                                                OnToggle="@(v => ToggleFeature(entry.Key, v))" />
                                }
                            </div>

                            <div class="fv-section">
                                <div class="fv-section-header">
                                    <span class="fv-section-label">Admin</span>
                                </div>
                                <FeatureRow Label="Show Diagnostic Information"
                                            Enabled="@(_isEditMode ? _editShowDiagnostics : _editableSettings.Admin.ShowDiagnostics)"
                                            IsLocked="false"
                                            IsEditMode="@_isEditMode"
                                            OnToggle="@(v => _editShowDiagnostics = v)" />
                            </div>

                        </div>

                        <!-- Menu Synchronization -->
                        <div class="fv-section fv-section-sync">
                            <div class="fv-section-header">
                                <span class="fv-section-label">Menu Synchronization</span>
                                @if (UnflaggedList.Count > 0)
                                {
                                    <span class="fv-sync-warn-badge">@UnflaggedList.Count warning(s)</span>
                                }
                                else
                                {
                                    <span class="fv-section-hint">In sync</span>
                                }
                            </div>
                            <div class="fv-sync-stats">
                                <div class="fv-sync-stat">
                                    <span class="fv-sync-stat-value">@AllConfiguredCount</span>
                                    <span class="fv-sync-stat-label">Configured</span>
                                </div>
                                <div class="fv-sync-stat fv-sync-stat-on">
                                    <span class="fv-sync-stat-value">@AllVisibleCount</span>
                                    <span class="fv-sync-stat-label">Visible</span>
                                </div>
                                <div class="fv-sync-stat fv-sync-stat-off">
                                    <span class="fv-sync-stat-value">@AllHiddenCount</span>
                                    <span class="fv-sync-stat-label">Hidden</span>
                                </div>
                                <div class="fv-sync-stat fv-sync-stat-items">
                                    <span class="fv-sync-stat-value">@MenuItemRegistry.Length</span>
                                    <span class="fv-sync-stat-label">Menu Items</span>
                                </div>
                            </div>
                            @if (UnflaggedList.Count > 0)
                            {
                                <div class="fv-sync-warnings">
                                    <div class="fv-sync-warn-title">Menu items missing configuration:</div>
                                    @foreach (var item in UnflaggedList)
                                    {
                                        <div class="fv-sync-warn-row">
                                            <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" style="color:var(--clr-warning,#f59e0b);flex-shrink:0">
                                                <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                                            </svg>
                                            <span><strong>@item.Label</strong> — key <code>@item.Key</code> not found in feature configuration</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Retired Features — read-only -->
                        <div class="fv-section fv-section-retired">
                            <div class="fv-section-header">
                                <span class="fv-section-label">Retired Features</span>
                            </div>
                            <p class="fv-retired-note">Retired. Functionality merged into newer workflows.</p>
                            <div class="fv-retired-list">
                                <div class="fv-retired-row">
                                    <span class="fv-retired-label">Spec Comparison</span>
                                    <span class="fv-retired-badge">Retired</span>
                                </div>
                                <div class="fv-retired-row">
                                    <span class="fv-retired-label">Specification Deltas</span>
                                    <span class="fv-retired-badge">Retired</span>
                                </div>
                                <div class="fv-retired-row">
                                    <span class="fv-retired-label">Task Deltas</span>
                                    <span class="fv-retired-badge">Retired</span>
                                </div>
                            </div>
                        </div>
                    }
                    else if (_settings.FeatureVisibility is not null)
                    {
                        <p class="settings-card-note">Feature configuration not available. The feature list will appear after a successful backend connection.</p>
                    }
                </div>
            }

            @* ══ Platform ══════════════════════════════════════════════════════════════ *@
            @if (_activeSection == "platform")
            {
                <div class="settings-card settings-card-full-width">
                    <div class="settings-card-title">Azure DevOps Integration</div>
                    <p class="settings-card-note">
                        Read-only configuration for Implementation Traceability. PAT must be set via <code>ADO_PAT</code> environment variable or <code>appsettings.Local.json</code> — it is never displayed here.
                    </p>

                    <div class="dev-diag-subgrid">
                        <div class="dev-diag-section">
                            <div class="dev-diag-section-title">Configuration</div>
                            <table class="settings-table">
                                <tr>
                                    <td>Enabled</td>
                                    <td>
                                        <span class="settings-badge @(_settings.AzureDevOps.Enabled ? "settings-badge-local" : "")">
                                            @(_settings.AzureDevOps.Enabled ? "Yes" : "No")
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Connection Status</td>
                                    <td>
                                        <span class="settings-badge @(_settings.AzureDevOps.ActivelyUsed ? "settings-badge-local" : "settings-badge-shared")">
                                            @(_settings.AzureDevOps.ActivelyUsed ? "Azure DevOps" : "Using Demo Data")
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td>PAT Status</td>
                                    <td>
                                        <span class="settings-badge @(_settings.AzureDevOps.PatConfigured ? "settings-badge-local" : "settings-badge-shared")">
                                            @(_settings.AzureDevOps.PatConfigured ? "Configured" : "Missing")
                                        </span>
                                        @if (_settings.AzureDevOps.PatConfigured)
                                        {
                                            <span style="margin-left:0.5rem;font-size:0.78rem;color:var(--clr-text-muted)">via @_settings.AzureDevOps.PatSource</span>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <td>Organization URL</td>
                                    <td><span class="mono-chip">@(string.IsNullOrWhiteSpace(_settings.AzureDevOps.OrganizationUrl) ? "—" : _settings.AzureDevOps.OrganizationUrl)</span></td>
                                </tr>
                                <tr>
                                    <td>Project</td>
                                    <td><span class="mono-chip">@(string.IsNullOrWhiteSpace(_settings.AzureDevOps.Project) ? "—" : _settings.AzureDevOps.Project)</span></td>
                                </tr>
                                <tr>
                                    <td>Repository</td>
                                    <td><span class="mono-chip">@(string.IsNullOrWhiteSpace(_settings.AzureDevOps.RepositoryId) ? "—" : _settings.AzureDevOps.RepositoryId)</span></td>
                                </tr>
                                <tr>
                                    <td>Default Branch</td>
                                    <td><span class="mono-chip">@_settings.AzureDevOps.DefaultBranch</span></td>
                                </tr>
                            </table>
                        </div>

                        <div class="dev-diag-section">
                            <div class="dev-diag-section-title">Test Connection</div>
                            <p style="font-size:0.83rem;color:var(--clr-text-muted);margin:0 0 0.875rem">
                                Verifies PAT authentication, organization URL, project, and repository.
                            </p>

                            @if (!_settings.AzureDevOps.PatConfigured)
                            {
                                <p class="settings-card-note" style="margin-bottom:0.75rem">
                                    PAT is not configured. Set <code>ADO_PAT</code> or add <code>AzureDevOps:Pat</code> to <code>appsettings.Local.json</code> and restart the backend.
                                </p>
                            }

                            <SecondaryButton OnClick="TestAdoConnectionAsync"
                                             Disabled="@(!_settings.AzureDevOps.Enabled || _adoTestRunning)">
                                @(_adoTestRunning ? "Testing…" : "Test Connection")
                            </SecondaryButton>

                            @if (_adoTestResult is not null)
                            {
                                <div style="margin-top:1rem">
                                    <div class="notification @(_adoTestResult.OverallSuccess ? "notification-success" : "notification-error")" role="status">
                                        @if (_adoTestResult.OverallSuccess)
                                        { <span>Connection successful.</span> }
                                        else
                                        { <span>Connection failed: @_adoTestResult.ErrorMessage</span> }
                                    </div>
                                    @if (_adoTestResult.Checks.Count > 0)
                                    {
                                        <table class="settings-table" style="margin-top:0.625rem">
                                            @foreach (var check in _adoTestResult.Checks)
                                            {
                                                <tr>
                                                    <td>@check.Name</td>
                                                    <td>
                                                        <span class="settings-badge @(check.Success ? "settings-badge-local" : "settings-badge-shared")">
                                                            @(check.Success ? "OK" : "Failed")
                                                        </span>
                                                        @if (!string.IsNullOrWhiteSpace(check.Detail))
                                                        {
                                                            <span style="margin-left:0.5rem;font-size:0.78rem;color:var(--clr-text-muted)">@check.Detail</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </table>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            @* ══ Target Environments ══════════════════════════════════════════════════ *@
            @if (_activeSection == "target-environments")
            {
                <div class="settings-card settings-card-full-width">
                    <div class="settings-card-title">Target Environments</div>
                    <p class="settings-card-note">
                        Configure one or more target environments. Each environment defines the Frontend URL, REST API, GraphQL endpoint, API authentication, and request settings used by all runtime reviews. The active environment is the single source of truth for Frontend Quality Review and future API and end-to-end reviews.
                    </p>
                    <FrontendAnalysisSettings />
                </div>
            }

            @* ══ AI ═══════════════════════════════════════════════════════════════════ *@
            @if (_activeSection == "ai")
            {
                <div class="settings-card settings-card-full-width">
                    <div class="settings-card-title">AI</div>
                    <p class="settings-card-note">
                        AI provider configuration — model selection, temperature, token limits, prompt configuration — is managed through backend settings and is not currently exposed in System Settings.
                    </p>
                    <div class="ss-placeholder">
                        <div class="ss-placeholder-icon" aria-hidden="true">🤖</div>
                        <div class="ss-placeholder-text">AI settings not yet available here</div>
                        <div class="ss-placeholder-sub">AI features can be individually enabled or disabled in Feature Visibility.</div>
                        <SecondaryButton OnClick='() => SetSection("feature-visibility")'>Open Feature Visibility</SecondaryButton>
                    </div>
                </div>
            }

            @* ══ Diagnostics ══════════════════════════════════════════════════════════ *@
            @if (_activeSection == "diagnostics")
            {
                <div class="settings-card settings-card-full-width">
                    <div class="settings-card-title">Developer Diagnostics</div>
                    <p class="settings-card-note">Backend, frontend, database, and runtime configuration. Sensitive values are never shown — use Copy Diagnostics in the top-right to export a safe summary.</p>

                    <div class="dev-diag-body">
                        <div class="dev-diag-subgrid">

                            <!-- Application -->
                            <div class="dev-diag-section">
                                <div class="dev-diag-section-title">Application</div>
                                <table class="settings-table">
                                    <tr><td>Name</td><td>@OrUnknown(_settings.Application.ApplicationName)</td></tr>
                                    <tr><td>Environment</td><td>@OrUnknown(_settings.Application.Environment)</td></tr>
                                    <tr><td>Version</td><td>@OrUnknown(_settings.Application.Version)</td></tr>
                                    @if (!string.IsNullOrWhiteSpace(_settings.Application.BuildNumber))
                                    {
                                        <tr><td>Build</td><td>@_settings.Application.BuildNumber</td></tr>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(_settings.Application.CommitSha))
                                    {
                                        <tr><td>Commit</td><td><span class="mono-chip">@_settings.Application.CommitSha</span></td></tr>
                                    }
                                    <tr><td>Package Mode</td><td><span class="settings-badge">@OrUnknown(_settings.Application.PackageMode)</span></td></tr>
                                </table>
                            </div>

                            <!-- Frontend -->
                            <div class="dev-diag-section">
                                <div class="dev-diag-section-title">Frontend</div>
                                <table class="settings-table">
                                    <tr>
                                        <td>Frontend URL</td>
                                        <td>
                                            <div class="copyable-value">
                                                <span class="mono-chip">@OrUnknown(_settings.Frontend.FrontendBaseUrl)</span>
                                                @if (!string.IsNullOrWhiteSpace(_settings.Frontend.FrontendBaseUrl))
                                                {
                                                    <button class="copy-btn" title="Copy to clipboard"
                                                            @onclick="() => CopyAsync(_settings.Frontend.FrontendBaseUrl)">
                                                        <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1z"/><path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3z"/></svg>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>API Base URL</td>
                                        <td>
                                            <div class="copyable-value">
                                                <span class="mono-chip">@OrUnknown(_settings.Frontend.ApiBaseUrl)</span>
                                                @if (!string.IsNullOrWhiteSpace(_settings.Frontend.ApiBaseUrl))
                                                {
                                                    <button class="copy-btn" title="Copy to clipboard"
                                                            @onclick="() => CopyAsync(_settings.Frontend.ApiBaseUrl)">
                                                        <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1z"/><path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3z"/></svg>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>GraphQL</td>
                                        <td><span class="mono-chip">@OrUnknown(_settings.Frontend.GraphQlEndpoint)</span></td>
                                    </tr>
                                    <tr><td>Environment</td><td>@OrUnknown(_settings.Frontend.EnvironmentName)</td></tr>
                                    <tr><td>Hosting</td><td>@(_settings.Frontend.StaticHostingMode ? "Blazor WASM" : "Server-side")</td></tr>
                                </table>
                            </div>

                            <!-- Backend -->
                            <div class="dev-diag-section">
                                <div class="dev-diag-section-title">Backend</div>
                                <table class="settings-table">
                                    <tr>
                                        <td>Base URL</td>
                                        <td>
                                            <div class="copyable-value">
                                                <span class="mono-chip">@OrUnknown(_settings.Backend.BackendBaseUrl)</span>
                                                @if (!string.IsNullOrWhiteSpace(_settings.Backend.BackendBaseUrl))
                                                {
                                                    <button class="copy-btn" title="Copy to clipboard"
                                                            @onclick="() => CopyAsync(_settings.Backend.BackendBaseUrl)">
                                                        <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1z"/><path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3z"/></svg>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                    <tr><td>Environment</td><td>@OrUnknown(_settings.Backend.AspNetCoreEnvironment)</td></tr>
                                    <tr>
                                        <td>Listening URLs</td>
                                        <td>
                                            <div class="copyable-value">
                                                <span class="mono-chip">@OrUnknown(_settings.Backend.ListeningUrls)</span>
                                                @if (!string.IsNullOrWhiteSpace(_settings.Backend.ListeningUrls))
                                                {
                                                    <button class="copy-btn" title="Copy to clipboard"
                                                            @onclick="() => CopyAsync(_settings.Backend.ListeningUrls)">
                                                        <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1z"/><path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3z"/></svg>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>CORS Origins</td>
                                        <td><span class="mono-chip">@OrUnknown(_settings.Backend.CorsAllowedOrigins)</span></td>
                                    </tr>
                                </table>
                            </div>

                            <!-- Database -->
                            <div class="dev-diag-section">
                                <div class="dev-diag-section-title">Database</div>
                                <table class="settings-table">
                                    <tr>
                                        <td>Mode</td>
                                        <td>
                                            <span class="settings-badge @(_settings.Database.Mode == "Local" ? "settings-badge-local" : (_settings.Database.Mode == "Shared" ? "settings-badge-shared" : ""))">
                                                @OrUnknown(_settings.Database.Mode)
                                            </span>
                                        </td>
                                    </tr>
                                    <tr><td>Provider</td><td>@OrUnknown(_settings.Database.Provider)</td></tr>
                                    <tr><td>Host</td><td>@OrUnknown(_settings.Database.Host)</td></tr>
                                    <tr><td>Port</td><td>@(_settings.Database.Port > 0 ? _settings.Database.Port.ToString() : "—")</td></tr>
                                    <tr><td>Database</td><td>@OrUnknown(_settings.Database.DatabaseName)</td></tr>
                                    <tr><td>Username</td><td>@OrUnknown(_settings.Database.Username)</td></tr>
                                    <tr>
                                        <td>Migrations</td>
                                        <td>
                                            @if (_settings.Database.MigrationStatus == "Up to date")
                                            {
                                                <span class="settings-badge settings-badge-local">Up to date</span>
                                            }
                                            else
                                            {
                                                <span class="settings-badge">@OrUnknown(_settings.Database.MigrationStatus)</span>
                                            }
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <!-- Logging -->
                            <div class="dev-diag-section">
                                <div class="dev-diag-section-title">Logging</div>
                                <table class="settings-table">
                                    <tr><td>Provider</td><td>@OrUnknown(_settings.Logging.Provider)</td></tr>
                                    <tr>
                                        <td>Level</td>
                                        <td>
                                            @if (_isEditMode)
                                            {
                                                <select class="edit-select" @bind="_editLogLevel">
                                                    @foreach (var lvl in new[] { "Verbose", "Debug", "Information", "Warning", "Error", "Fatal" })
                                                    {
                                                        <option value="@lvl">@lvl</option>
                                                    }
                                                </select>
                                            }
                                            else
                                            {
                                                <span class="settings-badge">@OrUnknown(_settings.Logging.MinimumLevel)</span>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Sinks</td>
                                        <td>@((_settings.Logging.Sinks?.Count ?? 0) > 0 ? string.Join(", ", _settings.Logging.Sinks) : "—")</td>
                                    </tr>
                                    <tr>
                                        <td>Log Path</td>
                                        <td>
                                            <div class="copyable-value">
                                                <span class="mono-chip">@OrUnknown(_settings.Logging.LogPath)</span>
                                                @if (!string.IsNullOrWhiteSpace(_settings.Logging.LogPath))
                                                {
                                                    <button class="copy-btn" title="Copy to clipboard"
                                                            @onclick="() => CopyAsync(_settings.Logging.LogPath)">
                                                        <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1z"/><path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3z"/></svg>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                    <tr><td>Structured</td><td>@(_settings.Logging.StructuredLogging ? "Enabled" : "Disabled")</td></tr>
                                    @if (_isEditMode)
                                    {
                                        <tr>
                                            <td>Seq URL</td>
                                            <td><input class="edit-input" type="text" placeholder="http://localhost:5341" @bind="_editSeqUrl" @bind:event="oninput" /></td>
                                        </tr>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(_settings.Logging.SeqUrl))
                                    {
                                        <tr><td>Seq URL</td><td><span class="mono-chip">@_settings.Logging.SeqUrl</span></td></tr>
                                    }
                                </table>
                                @if (_settings.Logging.LogFiles?.Count > 0)
                                {
                                    <div style="font-size:0.68rem;font-weight:700;color:var(--clr-text-muted);text-transform:uppercase;letter-spacing:0.07em;margin-top:0.875rem;margin-bottom:0.5rem;padding-top:0.5rem;border-top:1px solid var(--clr-border-subtle)">Log Files</div>
                                    @if (!string.IsNullOrWhiteSpace(_settings.Logging.ResolvedLogsFolder))
                                    {
                                        <p style="font-size:0.79rem;color:var(--clr-text-placeholder);margin:0 0 0.5rem">
                                            <span class="mono-chip">@_settings.Logging.ResolvedLogsFolder</span>
                                            <button class="copy-btn" title="Copy folder path" @onclick="() => CopyAsync(_settings.Logging.ResolvedLogsFolder)">
                                                <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1z"/><path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3z"/></svg>
                                            </button>
                                        </p>
                                    }
                                    <table class="settings-table">
                                        @foreach (var lf in _settings.Logging.LogFiles)
                                        {
                                            <tr>
                                                <td>@lf.Label</td>
                                                <td>
                                                    <div class="copyable-value">
                                                        <span class="mono-chip" style="font-size:0.76rem">@lf.Path</span>
                                                        <button class="copy-btn" title="Copy path" @onclick="() => CopyAsync(lf.Path)">
                                                            <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1z"/><path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3z"/></svg>
                                                        </button>
                                                    </div>
                                                    @if (!lf.Exists)
                                                    {
                                                        <span style="font-size:0.76rem;color:var(--clr-text-placeholder);font-style:italic">Not created yet</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </table>
                                }
                                @if (_isEditMode)
                                {
                                    <p class="edit-field-note">Logging level and Seq URL changes require a backend restart to take effect.</p>
                                }
                            </div>

                            <!-- Container / Runtime -->
                            <div class="dev-diag-section">
                                <div class="dev-diag-section-title">Container / Runtime</div>
                                <table class="settings-table">
                                    <tr>
                                        <td>Compose Project</td>
                                        <td>
                                            <div class="copyable-value">
                                                <span class="mono-chip">@OrUnknown(_settings.Runtime.ComposeProjectName)</span>
                                                @if (!string.IsNullOrWhiteSpace(_settings.Runtime.ComposeProjectName))
                                                {
                                                    <button class="copy-btn" title="Copy to clipboard"
                                                            @onclick="() => CopyAsync(_settings.Runtime.ComposeProjectName)">
                                                        <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1z"/><path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3z"/></svg>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Expected Volume</td>
                                        <td>
                                            <div class="copyable-value">
                                                <span class="mono-chip">@OrUnknown(_settings.Runtime.ExpectedDatabaseVolume)</span>
                                                @if (!string.IsNullOrWhiteSpace(_settings.Runtime.ExpectedDatabaseVolume))
                                                {
                                                    <button class="copy-btn" title="Copy to clipboard"
                                                            @onclick="() => CopyAsync(_settings.Runtime.ExpectedDatabaseVolume)">
                                                        <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1z"/><path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3z"/></svg>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                    <tr><td>Package Mode</td><td><span class="settings-badge">@OrUnknown(_settings.Runtime.PackageMode)</span></td></tr>
                                    @if (!string.IsNullOrWhiteSpace(_settings.Runtime.LocalPackageRoot))
                                    {
                                        <tr>
                                            <td>Package Root</td>
                                            <td>
                                                <div class="copyable-value">
                                                    <span class="mono-chip">@_settings.Runtime.LocalPackageRoot</span>
                                                    <button class="copy-btn" title="Copy to clipboard"
                                                            @onclick="() => CopyAsync(_settings.Runtime.LocalPackageRoot!)">
                                                        <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1z"/><path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3z"/></svg>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                    <tr><td>Published</td><td>@(_settings.Runtime.RunningFromPublishedArtifact ? "Yes" : "No")</td></tr>
                                </table>
                            </div>

                            <!-- Project Documents -->
                            <div class="dev-diag-section">
                                <div class="dev-diag-section-title">Project Documents</div>
                                <table class="settings-table">
                                    @if (!_diagDocLoaded)
                                    {
                                        <tr><td colspan="3" style="color:var(--clr-text-muted)">Loading…</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var kind in new[] { "constitution", "plan", "tasks" })
                                        {
                                            var doc = _diagDocSummary.FirstOrDefault(d => string.Equals(d.DocumentKind, kind, StringComparison.OrdinalIgnoreCase));
                                            <tr>
                                                <td>@kind</td>
                                                <td>
                                                    @if (doc is not null)
                                                    {
                                                        <span class="settings-badge settings-badge-local">Stored</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="settings-badge">Empty</span>
                                                    }
                                                </td>
                                                <td>@(doc is not null ? $"{doc.ContentLengthChars:N0} chars" : "—")</td>
                                            </tr>
                                        }
                                    }
                                </table>
                            </div>

                        </div>
                    </div>
                </div>
            }

            @* ══ Documentation Health ═════════════════════════════════════════════════ *@
            @if (_activeSection == "doc-health")
            {
                <div class="settings-card settings-card-full-width">
                    <div class="settings-card-title">Documentation Health</div>
                    <p class="settings-card-note">Developer-only diagnostic. Validates navigation links, documentation cross-links, removed-page references, and menu synchronisation across the application's documentation pages.</p>

                    @if (!_docHealthComputed)
                    {
                        <div class="db-section-empty">Loading…</div>
                    }
                    else if (_docHealthFindings.Count == 0)
                    {
                        <p class="ss-health-all-good" role="status">
                            ✓ All documentation health checks passed. No issues detected.
                        </p>
                    }
                    else
                    {
                        <div class="ss-health-cards" role="list">
                            @foreach (var f in _docHealthFindings)
                            {
                                <div class="ss-health-card" role="listitem">
                                    <span class="ss-health-sev @(f.Severity == "Error" ? "ss-health-sev-error" : "ss-health-sev-warn")">@f.Severity</span>
                                    <div class="ss-health-body">
                                        <div class="ss-health-component">@f.Category</div>
                                        <p class="ss-health-desc">@f.Description</p>
                                        @if (!string.IsNullOrWhiteSpace(f.Detail))
                                        {
                                            <p class="settings-card-note" style="margin-top:0.25rem">@f.Detail</p>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <!-- Summary table -->
                    @if (_docHealthComputed)
                    {
                        <div class="fv-sync-stats" style="margin-top:1.5rem">
                            <div class="fv-sync-stat @(_docHealthFindings.Count == 0 ? "fv-sync-stat-on" : "fv-sync-stat-off")">
                                <span class="fv-sync-stat-value">@_docHealthFindings.Count</span>
                                <span class="fv-sync-stat-label">Issues</span>
                            </div>
                            <div class="fv-sync-stat">
                                <span class="fv-sync-stat-value">@DocNavLinks.Length</span>
                                <span class="fv-sync-stat-label">Nav Links Checked</span>
                            </div>
                            <div class="fv-sync-stat">
                                <span class="fv-sync-stat-value">@DocPageLinks.Length</span>
                                <span class="fv-sync-stat-label">Doc Page Links Checked</span>
                            </div>
                            <div class="fv-sync-stat">
                                <span class="fv-sync-stat-value">@KnownRoutes.Count</span>
                                <span class="fv-sync-stat-label">Known Routes</span>
                            </div>
                        </div>
                    }
                </div>
            }

            @* Runtime Diagnostics *@
            @if (_activeSection == "ui-migration")
            {
                <div class="settings-card settings-card-full-width">
                    <div class="settings-card-title">Runtime Diagnostics</div>
                    <p class="settings-card-note">Live runtime state for the current QA Review Studio session.</p>

                    @if (_runtimeActionMessage is not null)
                    {
                        <div class="notification notification-success" role="status">@_runtimeActionMessage</div>
                    }

                    <div class="runtime-summary-grid" aria-label="Runtime diagnostics summary">
                        @foreach (var metric in RuntimeSummaryRows)
                        {
                            <div class="runtime-summary-card">
                                <span class="runtime-summary-label">@metric.Label</span>
                                <strong class="runtime-summary-value">@metric.Value</strong>
                                <span class="ss-health-sev @StatusClass(metric.Status)">@metric.Status</span>
                                @if (!string.IsNullOrWhiteSpace(metric.Detail))
                                {
                                    <span class="runtime-summary-detail">@metric.Detail</span>
                                }
                            </div>
                        }
                    </div>

                    <div class="dev-diag-subgrid">
                        <div class="dev-diag-section">
                            <div class="dev-diag-section-title">Workspace</div>
                            <table class="dev-diag-table">
                                <tbody>
                                    @foreach (var row in WorkspaceDiagnosticRows)
                                    {
                                        <tr>
                                            <td>@row.Name</td>
                                            <td>
                                                <span class="ss-health-sev @StatusClass(row.Status)">@row.Status</span>
                                                <div class="runtime-row-value">@row.Value</div>
                                                <div class="runtime-row-reason">@row.Reason</div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="dev-diag-section">
                            <div class="dev-diag-section-title">Markdown Engine</div>
                            <table class="dev-diag-table">
                                <tbody>
                                    @foreach (var row in MarkdownEngineDiagnosticRows)
                                    {
                                        <tr>
                                            <td>@row.Name</td>
                                            <td>
                                                <span class="ss-health-sev @StatusClass(row.Status)">@row.Status</span>
                                                <div class="runtime-row-value">@row.Value</div>
                                                <div class="runtime-row-reason">@row.Reason</div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="dev-diag-section">
                            <div class="dev-diag-section-title">Runtime Services</div>
                            @foreach (var group in RuntimeServiceGroups)
                            {
                                <div class="runtime-service-group">
                                    <div class="runtime-service-group-title">@group.Label</div>
                                    @if (!group.Rows.Any())
                                    {
                                        <div class="runtime-empty-state">No services in this state.</div>
                                    }
                                    else
                                    {
                                        <table class="dev-diag-table">
                                            <tbody>
                                                @foreach (var service in group.Rows)
                                                {
                                                    <tr>
                                                        <td>@service.Name</td>
                                                        <td>
                                                            <span class="ss-health-sev @StatusClass(service.Status)">@service.Status</span>
                                                            <div class="runtime-row-reason">@service.Reason</div>
                                                            <div class="runtime-row-value">Last updated: @FormatTimestamp(service.LastUpdated)</div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                </div>
                            }
                        </div>

                        <div class="dev-diag-section">
                            <div class="dev-diag-section-title">Recommended Workflow</div>
                            <table class="dev-diag-table">
                                <tbody>
                                    @foreach (var check in WorkflowDiagnosticRows)
                                    {
                                        <tr>
                                            <td>@check.Name</td>
                                            <td>
                                                <span class="ss-health-sev @StatusClass(check.Status)">@check.Status</span>
                                                <div class="runtime-row-reason">@check.Reason</div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="dev-diag-section">
                            <div class="dev-diag-section-title">Application</div>
                            <table class="dev-diag-table">
                                <tbody>
                                    <tr><td>Build version</td><td>@OrUnavailable(_settings?.Application.Version)</td></tr>
                                    <tr><td>Build number</td><td>@OrUnavailable(_settings?.Application.BuildNumber)</td></tr>
                                    <tr><td>Environment</td><td>@OrUnavailable(_settings?.Application.Environment)</td></tr>
                                    <tr><td>Host environment</td><td>@OrUnavailable(HostEnvironment.Environment)</td></tr>
                                    <tr><td>Current project</td><td>@OrUnavailable(Workspace.CurrentProject)</td></tr>
                                    <tr><td>Feature flags</td><td>@FeatureFlagSummary</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="settings-card" style="margin-top:1.5rem;background:var(--surface-subtle,#f8f9fa)">
                        <div class="settings-card-title" style="font-size:0.95rem">Analysis Sessions</div>
                        <table class="dev-diag-table">
                            <thead>
                                <tr>
                                    <th>Session</th>
                                    <th>Status</th>
                                    <th>Reason</th>
                                    <th>Prerequisites</th>
                                    <th>Last run</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var session in AnalysisSessionRows)
                                {
                                    <tr>
                                        <td>@session.Name</td>
                                        <td><span class="ss-health-sev @StatusClass(session.Status)">@session.Status</span></td>
                                        <td>@session.Reason</td>
                                        <td>@session.Prerequisites</td>
                                        <td>@FormatTimestamp(session.LastRun)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="settings-card" style="margin-top:1.5rem;background:var(--surface-subtle,#f8f9fa)">
                        <div class="settings-card-title" style="font-size:0.95rem">Developer Actions</div>
                        <div class="runtime-action-grid">
                            <div class="runtime-action-card">
                                <strong>Reset Workspace</strong>
                                <span>Clears only browser/session workspace state. Does not delete saved workspaces or modify database schema.</span>
                                <DangerButton OnClick="ResetWorkspaceDiagnosticsAsync">Reset Workspace</DangerButton>
                            </div>
                            <div class="runtime-action-card">
                                <strong>Clear Runtime Sessions</strong>
                                <span>Clears browser runtime review results only. Does not delete saved workspaces or modify database schema.</span>
                                <DangerButton OnClick="ClearRuntimeSessionsAsync">Clear Runtime Sessions</DangerButton>
                            </div>
                            <div class="runtime-action-card">
                                <strong>Clear Analysis Sessions</strong>
                                <span>Clears in-memory analysis snapshots and extraction session state. Does not delete saved workspaces or modify database schema.</span>
                                <DangerButton OnClick="ClearAnalysisSessionsAsync">Clear Analysis Sessions</DangerButton>
                            </div>
                            <div class="runtime-action-card">
                                <strong>Clear Caches</strong>
                                <span>Clears supported browser/API caches. Does not delete saved workspaces or modify database schema.</span>
                                <DangerButton OnClick="ClearRuntimeCachesAsync">Clear Caches</DangerButton>
                            </div>
                            <div class="runtime-action-card runtime-action-card-export">
                                <strong>Export Diagnostics</strong>
                                <span>Copies current runtime state, status summary, warnings, failures, timestamp, and workspace details.</span>
                                <PrimaryButton OnClick="ExportRuntimeDiagnosticsAsync">Export Diagnostics</PrimaryButton>
                            </div>
                        </div>
                    </div>
                </div>
            }
            @* ══ Environment Diagnostics ══════════════════════════════════════════════ *@
            @if (_activeSection == "environment-diagnostics")
            {
                <div class="settings-card settings-card-full-width">
                    <div class="settings-card-title">Environment Diagnostics</div>
                    <p class="settings-card-note">Comprehensive system health check: database connectivity, migrations, required tables/columns, backend API status, workspace artifacts, and ReviewContext availability.</p>

                    @if (_envDiagMessage is not null)
                    {
                        <div class="notification notification-success" role="status">@_envDiagMessage</div>
                    }

                    <div class="settings-card" style="margin-bottom:1.5rem;background:var(--surface-subtle,#f8f9fa)">
                        <div class="settings-card-title" style="font-size:0.95rem">Run Diagnostics</div>
                        <div style="display:flex;flex-wrap:wrap;gap:.5rem">
                            <PrimaryButton OnClick="RunEnvironmentDiagnosticsAsync" Disabled="@_envDiagRunning">
                                @(_envDiagRunning ? "Running…" : "Run Diagnostics")
                            </PrimaryButton>
                            <SecondaryButton OnClick="ExportEnvironmentDiagnosticsJsonAsync" Disabled="@(_envDiagReport is null)">Export JSON</SecondaryButton>
                            <SecondaryButton OnClick="ExportEnvironmentDiagnosticsHtmlAsync" Disabled="@(_envDiagReport is null)">Export HTML</SecondaryButton>
                        </div>
                    </div>

                    @if (_envDiagErrorDetails is not null)
                    {
                        <div style="margin-bottom:1.5rem;padding:1rem;background:#fee2e2;border:1px solid #fecaca;border-radius:var(--radius-default)">
                            <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem">
                                <span style="font-weight:600;color:#991b1b">⚠️ Diagnostics Failed</span>
                            </div>
                            <div style="font-size:0.9rem;color:#7c2d12;font-family:monospace;white-space:pre-wrap;word-break:break-word;margin-bottom:0.75rem">@_envDiagErrorDetails</div>
                            @if (!string.IsNullOrWhiteSpace(_envDiagStackTrace))
                            {
                                <button class="btn-text" style="color:#991b1b;font-size:0.85rem;padding:0;margin-top:0.5rem"
                                        @onclick='() => _envDiagShowStackTrace = !_envDiagShowStackTrace'>
                                    @(_envDiagShowStackTrace ? "▼ Hide Stack Trace" : "▶ Show Stack Trace")
                                </button>
                                @if (_envDiagShowStackTrace)
                                {
                                    <div style="font-size:0.8rem;color:#7c2d12;font-family:monospace;white-space:pre-wrap;word-break:break-word;margin-top:0.5rem;padding:0.5rem;background:#fee2e2;border-radius:0.25rem;max-height:400px;overflow-y:auto">@_envDiagStackTrace</div>
                                }
                            }
                        </div>
                    }

                    @if (_envDiagReport is not null)
                    {
                        <div class="ss-status-bar" style="margin-bottom:1.5rem">
                            <span class="ss-status-pill ss-status-pill-ok">
                                <span class="ss-status-label">Overall Status</span>
                                <span class="ss-status-value">@GetDiagnosticStatusBadge(_envDiagReport.OverallStatus)</span>
                            </span>
                            <span class="ss-status-pill">
                                <span class="ss-status-label">Generated</span>
                                <span class="ss-status-value">@_envDiagReport.GeneratedAt:MMM dd, yyyy HH:mm:ss</span>
                            </span>
                            <span class="ss-status-pill">
                                <span class="ss-status-label">Environment</span>
                                <span class="ss-status-value">@_envDiagReport.Environment</span>
                            </span>
                        </div>

                        <div class="dev-diag-subgrid">
                            <!-- Database Checks -->
                            @if (_envDiagReport.DatabaseChecks.Count > 0)
                            {
                                <div class="dev-diag-section">
                                    <div class="dev-diag-section-title">Database</div>
                                    @foreach (var check in _envDiagReport.DatabaseChecks)
                                    {
                                        <div style="margin-bottom:0.75rem;padding:0.75rem;background:var(--surface-subtle);border-radius:var(--radius-default)">
                                            <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.25rem">
                                                <span style="font-weight:600;flex:1">@check.Name</span>
                                                <span class="ss-health-sev @GetCheckStatusClass(check.Status)">@check.Status</span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(check.Details))
                                            {
                                                <p style="font-size:0.85rem;color:var(--clr-text-muted);margin:0">@check.Details</p>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(check.Recommendation))
                                            {
                                                <p style="font-size:0.85rem;color:var(--clr-text-placeholder);margin:0.25rem 0 0">→ @check.Recommendation</p>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            <!-- Backend/API Checks -->
                            @if (_envDiagReport.BackendApiChecks.Count > 0)
                            {
                                <div class="dev-diag-section">
                                    <div class="dev-diag-section-title">Backend / API</div>
                                    @foreach (var check in _envDiagReport.BackendApiChecks)
                                    {
                                        <div style="margin-bottom:0.75rem;padding:0.75rem;background:var(--surface-subtle);border-radius:var(--radius-default)">
                                            <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.25rem">
                                                <span style="font-weight:600;flex:1">@check.Name</span>
                                                <span class="ss-health-sev @GetCheckStatusClass(check.Status)">@check.Status</span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(check.Details))
                                            {
                                                <p style="font-size:0.85rem;color:var(--clr-text-muted);margin:0">@check.Details</p>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            <!-- Workspace Checks -->
                            @if (_envDiagReport.WorkspaceChecks.Count > 0)
                            {
                                <div class="dev-diag-section">
                                    <div class="dev-diag-section-title">Workspace</div>
                                    @foreach (var check in _envDiagReport.WorkspaceChecks)
                                    {
                                        <div style="margin-bottom:0.75rem;padding:0.75rem;background:var(--surface-subtle);border-radius:var(--radius-default)">
                                            <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.25rem">
                                                <span style="font-weight:600;flex:1">@check.Name</span>
                                                <span class="ss-health-sev @GetCheckStatusClass(check.Status)">@check.Status</span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(check.Details))
                                            {
                                                <p style="font-size:0.85rem;color:var(--clr-text-muted);margin:0">@check.Details</p>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            <!-- ReviewContext Checks -->
                            @if (_envDiagReport.ReviewContextChecks.Count > 0)
                            {
                                <div class="dev-diag-section">
                                    <div class="dev-diag-section-title">ReviewContext</div>
                                    @foreach (var check in _envDiagReport.ReviewContextChecks)
                                    {
                                        <div style="margin-bottom:0.75rem;padding:0.75rem;background:var(--surface-subtle);border-radius:var(--radius-default)">
                                            <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.25rem">
                                                <span style="font-weight:600;flex:1">@check.Name</span>
                                                <span class="ss-health-sev @GetCheckStatusClass(check.Status)">@check.Status</span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(check.Details))
                                            {
                                                <p style="font-size:0.85rem;color:var(--clr-text-muted);margin:0">@check.Details</p>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            <!-- Export Checks -->
                            @if (_envDiagReport.ExportChecks.Count > 0)
                            {
                                <div class="dev-diag-section">
                                    <div class="dev-diag-section-title">Export</div>
                                    @foreach (var check in _envDiagReport.ExportChecks)
                                    {
                                        <div style="margin-bottom:0.75rem;padding:0.75rem;background:var(--surface-subtle);border-radius:var(--radius-default)">
                                            <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.25rem">
                                                <span style="font-weight:600;flex:1">@check.Name</span>
                                                <span class="ss-health-sev @GetCheckStatusClass(check.Status)">@check.Status</span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(check.Details))
                                            {
                                                <p style="font-size:0.85rem;color:var(--clr-text-muted);margin:0">@check.Details</p>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else if (!_envDiagRunning)
                    {
                        <div class="db-section-empty">Click "Run Diagnostics" to start the health check.</div>
                    }
                </div>
            }

            @* ══ Maintenance ══════════════════════════════════════════════════════════ *@
            @if (_activeSection == "review-context-validation" && IsDeveloperDiagnosticsVisible)
            {
                <div class="settings-card settings-card-full-width">
                    <div class="settings-card-title">ReviewContext Validation</div>
                    <p class="settings-card-note">Developer-only diagnostic for validating ReviewContext as the canonical source of truth against downstream review models.</p>

                    @if (_reviewContextValidationMessage is not null)
                    {
                        <div class="notification notification-success" role="status">@_reviewContextValidationMessage</div>
                    }

                    @if (WorkspaceArtifacts.Count == 0)
                    {
                        <div class="db-section-empty" role="status">
                            No workspace artifacts are loaded. Load constitution.md, spec.md, plan.md, or tasks.md from a workspace before running ReviewContext validation.
                        </div>
                    }

                    <div class="settings-card" style="margin-top:1rem;background:var(--surface-subtle,#f8f9fa)">
                        <div class="settings-card-title" style="font-size:0.95rem">Run Validation</div>
                        <div style="display:flex;flex-wrap:wrap;gap:.5rem">
                            <PrimaryButton OnClick="RunReviewContextValidationAsync">Run Validation</PrimaryButton>
                            <SecondaryButton OnClick="ExportReviewContextValidationJsonAsync" Disabled="@(_reviewContextReport is null)">Export JSON</SecondaryButton>
                            <SecondaryButton OnClick="ExportReviewContextValidationHtmlAsync" Disabled="@(_reviewContextReport is null)">Export HTML</SecondaryButton>
                        </div>
                    </div>

                    <div class="dev-diag-subgrid" style="margin-top:1.5rem">
                        <div class="dev-diag-section">
                            <div class="dev-diag-section-title">Loaded Artifacts</div>
                            <table class="dev-diag-table">
                                <thead>
                                    <tr>
                                        <th>Artifact</th>
                                        <th>Status</th>
                                        <th>Loaded</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in ReviewContextArtifactRows)
                                    {
                                        <tr>
                                            <td>@row.Label</td>
                                            <td><span class="ss-health-sev @(row.Loaded ? "ss-health-sev-ok" : "ss-health-sev-warn")">@(row.Loaded ? "Loaded" : "Missing")</span></td>
                                            <td>@FormatTimestamp(row.LoadedAt)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="dev-diag-section">
                            <div class="dev-diag-section-title">Canonical Metrics</div>
                            @if (_reviewContextReport?.CanonicalMetrics.Count > 0)
                            {
                                <table class="dev-diag-table">
                                    <tbody>
                                        @foreach (var metric in _reviewContextReport.CanonicalMetrics)
                                        {
                                            <tr><td>@metric.Name</td><td>@DisplayValue(metric.Value)</td></tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div class="db-section-empty">Run validation to populate canonical metrics.</div>
                            }
                        </div>

                        <div class="dev-diag-section">
                            <div class="dev-diag-section-title">Source Comparisons</div>
                            @if (_reviewContextReport?.SourceComparisons.Count > 0)
                            {
                                <table class="dev-diag-table">
                                    <thead>
                                        <tr>
                                            <th>Metric</th>
                                            <th>ReviewContext</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var comparison in _reviewContextReport.SourceComparisons)
                                        {
                                            <tr>
                                                <td>@comparison.Metric</td>
                                                <td>@DisplayValue(comparison.ReviewContextValue)</td>
                                                <td><span class="ss-health-sev @(comparison.AllMatch ? "ss-health-sev-ok" : "ss-health-sev-warn")">@(comparison.AllMatch ? "Match" : "Mismatch")</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div class="db-section-empty">No source comparisons available yet.</div>
                            }
                        </div>

                        <div class="dev-diag-section">
                            <div class="dev-diag-section-title">Findings</div>
                            @if (_reviewContextReport?.Findings.Count > 0)
                            {
                                <div class="ss-health-cards" role="list">
                                    @foreach (var finding in _reviewContextReport.Findings)
                                    {
                                        <div class="ss-health-card" role="listitem">
                                            <span class="ss-health-sev @ReviewContextSeverityClass(finding.Severity)">@finding.Severity</span>
                                            <div class="ss-health-body">
                                                <div class="ss-health-component">@finding.Source - @finding.MetricName</div>
                                                <p class="ss-health-desc">@finding.Message</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="db-section-empty">Run validation to populate findings.</div>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (_activeSection == "maintenance")
            {
                <div class="settings-card settings-card-full-width">
                    <div class="settings-card-title">Maintenance</div>

                    @if (_resetResultMessage is not null)
                    {
                        <div class="notification @(_resetSuccess ? "notification-success" : "notification-error")" role="alert">
                            @_resetResultMessage
                        </div>
                    }

                    <div class="danger-zone">
                        <div class="danger-zone-header">
                            <span class="danger-zone-label">Danger Zone</span>
                        </div>
                        <div class="danger-zone-action">
                            <div class="danger-zone-description">
                                <strong>Reset Local Database</strong>
                                <p>Deletes all imported artifacts, AI reviews, test scenarios, traceability links, traceability suggestions, implementation mappings, project documents, analysis results, and other application data stored in the local database. Also clears any active extraction session. The database server continues running and the application will recreate its schema when required. This operation cannot be undone.</p>
                                <p>This operation does not modify application binaries, source code, configuration files, or frontend analysis profiles.</p>
                                @if (!_settings.Maintenance.ResetAllowed && !string.IsNullOrWhiteSpace(_settings.Maintenance.ResetNotAllowedReason))
                                {
                                    <p class="danger-zone-reason">@_settings.Maintenance.ResetNotAllowedReason</p>
                                }
                            </div>
                            <button class="btn-danger-outline"
                                    disabled="@(!_settings.Maintenance.ResetAllowed || _isResetting || _isEditMode)"
                                    @onclick="OpenResetModal">
                                Reset Local Database
                            </button>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
}

@if (_showResetModal)
{
    <div class="modal-backdrop" @onclick="CancelReset" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <div class="modal-panel" @onclick:stopPropagation="true">
            <h2 id="modal-title" class="modal-title">Reset Local Database</h2>
            <div class="notification notification-warning">
                All local QA Review Studio data will be permanently deleted: imported artifacts, AI reviews, test scenarios, traceability links, implementation mappings, and analysis results.
                The database server will continue running. This action cannot be undone.
            </div>
            <p class="modal-body-text">Type <strong>RESET</strong> in the box below to confirm.</p>
            <input class="modal-confirm-input"
                   type="text"
                   placeholder="Type RESET here"
                   @bind="_resetConfirmText"
                   @bind:event="oninput"
                   disabled="@_isResetting"
                   autofocus />
            <div class="modal-actions">
                <SecondaryButton OnClick="CancelReset" Disabled="@_isResetting">Cancel</SecondaryButton>
                <DangerButton OnClick="ExecuteResetAsync"
                              Disabled="@(_resetConfirmText != "RESET" || _isResetting)">
                    @(_isResetting ? "Resetting..." : "Reset Database")
                </DangerButton>
            </div>
        </div>
    </div>
}

@code {
    private SystemSettingsDto?      _settings;
    private EditableSettingsDto?    _editableSettings;
    private bool                    _isLoading = true;
    private string?                 _loadError;

    // Edit mode
    private bool                    _isEditMode;
    private bool                    _isSaving;
    private string?                 _saveError;
    private string?                 _saveSuccess;
    private Dictionary<string, bool> _editFv = new();
    private string                  _editLogLevel = "Information";
    private string                  _editSeqUrl = "";
    private bool                    _editShowDiagnostics = true;

    // Reset modal
    private bool    _showResetModal;
    private string  _resetConfirmText = "";
    private bool    _isResetting;
    private string? _resetResultMessage;
    private bool    _resetSuccess;

    private bool _copiedDiag;

    // Project Documents diagnostics (lazy-loaded when diagnostics section is opened)
    private IReadOnlyList<DocumentSummaryDto> _diagDocSummary = [];
    private bool _diagDocLoaded;

    // Documentation Health
    private bool _docHealthComputed;
    private List<DocHealthFinding> _docHealthFindings = [];
    private int _docHealthIssueCount => _docHealthFindings.Count;

    // Runtime Diagnostics
    private ExtractionSessionSnapshot? _extractionSnapshot;
    private bool _runtimeDiagnosticsLoaded;
    private string? _runtimeActionMessage;

    // ReviewContext Validation
    private ReviewContextValidationReport? _reviewContextReport;
    private string? _reviewContextValidationMessage;

    // Configuration Health
    private ConfigurationHealthReport? _configHealthReport;
    private bool _configHealthLoaded;

    // Environment Diagnostics
    private EnvironmentDiagnosticsReportDto? _envDiagReport;
    private bool _envDiagRunning;
    private string? _envDiagMessage;
    private string? _envDiagErrorDetails;
    private string? _envDiagStackTrace;
    private bool _envDiagShowStackTrace;

    // Azure DevOps connection test
    private bool _adoTestRunning;
    private AzureDevOpsConnectionTestResultDto? _adoTestResult;

    // ── Section navigation ────────────────────────────────────────────────────

    private string _activeSection = "general";
    private string _navSearch     = "";

    private bool IsDeveloperDiagnosticsVisible =>
        string.Equals(HostEnvironment.Environment, "Development", StringComparison.OrdinalIgnoreCase);

    private int _configHealthIssueCount =>
        (UnflaggedList.Count > 0 ? 1 : 0) +
        (_settings?.AzureDevOps.Enabled == true && _settings?.AzureDevOps.PatConfigured == false ? 1 : 0) +
        (_settings?.Database.MigrationStatus is not null && _settings?.Database.MigrationStatus != "Up to date" ? 1 : 0);

    private void SetSection(string section) => _activeSection = section;

    private RenderFragment NavItem(string id, string label, int badge = 0) => __builder =>
    {
        if (!string.IsNullOrWhiteSpace(_navSearch) &&
            !label.Contains(_navSearch, StringComparison.OrdinalIgnoreCase)) return;
        <button class="ss-nav-item @(_activeSection == id ? "is-active" : "")"
                @onclick="() => SetSection(id)"
                aria-current="@(_activeSection == id ? "page" : null)">
            @label
            @if (badge > 0) { <span class="ss-nav-badge">@badge</span> }
        </button>
    };

    // ── Feature section key sets — aligned with sidebar navigation sections ───

    private static readonly HashSet<string> ReviewSectionKeys =
        new(StringComparer.OrdinalIgnoreCase)
        {
            "SpecificationReview", "ConstitutionExplorer", "DataModelExplorer", "PlanExplorer", "TaskExplorer"
        };

    private static readonly HashSet<string> LibrarySectionKeys =
        new(StringComparer.OrdinalIgnoreCase)
        {
            "QaArtifactLibrary", "SampleProjects", "CreateTestScenario"
        };

    private static readonly HashSet<string> AnalysisSectionKeys =
        new(StringComparer.OrdinalIgnoreCase)
        {
            "SpecDrift", "ImpactAnalysis", "ArtifactTraceability",
            "ImplementationReview", "ImplementationTraceability"
        };

    private static readonly HashSet<string> QualitySectionKeys =
        new(StringComparer.OrdinalIgnoreCase)
        {
            "QualityReview", "BlazorWasmSecurityReview", "BlazorWasmPerformanceReview"
        };

    private static readonly HashSet<string> AiReviewKeys =
        new(StringComparer.OrdinalIgnoreCase)
        {
            "AiChangeReview"
        };

    private static readonly HashSet<string> AdvancedOptionalKeys =
        new(StringComparer.OrdinalIgnoreCase)
        {
            "LegacyTraceabilityNavigationEnabled", "TraceabilityCoverage",
            "TraceabilitySuggestions", "CodeTraceability",
            "EnableArchitectureView", "EnableExtractionReview"
        };

    // All known menu items with their flag keys (used for Menu Synchronization check).
    // Platform items (locked, always-on) are included so the total count matches the sidebar.
    private static readonly (string Label, string Key)[] MenuItemRegistry =
    [
        // Getting Started (Platform — always on)
        ("Recommended Workflow",    "RecommendedWorkflow"),
        ("User Guide",              "UserGuide"),

        // Review
        ("Dashboard",               "Dashboard"),
        ("Specification Review",    "SpecificationReview"),
        ("Constitution Explorer",   "ConstitutionExplorer"),
        ("Data Model Explorer",     "DataModelExplorer"),
        ("Plan Explorer",           "PlanExplorer"),
        ("Task Explorer",           "TaskExplorer"),

        // Library
        ("QA Artifact Library",     "QaArtifactLibrary"),
        ("Sample Projects",         "SampleProjects"),
        ("Create Test Scenario",    "CreateTestScenario"),

        // Traceability (legacy — shown only when LegacyTraceabilityNavigationEnabled)
        ("Traceability & Coverage", "TraceabilityCoverage"),
        ("Traceability Suggestions","TraceabilitySuggestions"),
        ("Code Traceability",       "CodeTraceability"),

        // Analysis
        ("Spec Drift",              "SpecDrift"),
        ("Impact Analysis",         "ImpactAnalysis"),
        ("Requirements Traceability",   "ArtifactTraceability"),
        ("Implementation Review",   "ImplementationReview"),
        ("Implementation Traceability", "ImplementationTraceability"),

        // Quality
        ("Quality Review",          "QualityReview"),
        ("WASM Security Review",    "BlazorWasmSecurityReview"),
        ("WASM Performance Review", "BlazorWasmPerformanceReview"),

        // AI Review
        ("AI Change Review",        "AiChangeReview"),

        // Admin (Platform — always on)
        ("System Settings",         "AdminSystemSettings"),
    ];

    private IEnumerable<FeatureEntryDto> AllEditableFeatures =>
        _editableSettings?.FeatureVisibility.Core
            .Concat(_editableSettings.FeatureVisibility.Advanced) ?? [];

    private IEnumerable<FeatureEntryDto> GetSectionEntries(HashSet<string> keys) =>
        AllEditableFeatures.Where(e => keys.Contains(e.Key));

    private int EnabledCount(HashSet<string> keys) =>
        GetSectionEntries(keys).Count(e =>
            _isEditMode ? _editFv.GetValueOrDefault(e.Key, e.Value) : e.Value);

    private int TotalCount(HashSet<string> keys) =>
        GetSectionEntries(keys).Count();

    private IEnumerable<(string Label, string Key)> UnflaggedMenuItems =>
        MenuItemRegistry.Where(item =>
            !AllEditableFeatures.Any(e =>
                string.Equals(e.Key, item.Key, StringComparison.OrdinalIgnoreCase)) &&
            !(_editableSettings?.FeatureVisibility.Platform.Any(e =>
                string.Equals(e.Key, item.Key, StringComparison.OrdinalIgnoreCase)) ?? false));

    // Count summary properties for the template
    private int ReviewEnabled   => EnabledCount(ReviewSectionKeys);
    private int ReviewTotal     => TotalCount(ReviewSectionKeys);
    private int LibraryEnabled  => EnabledCount(LibrarySectionKeys);
    private int LibraryTotal    => TotalCount(LibrarySectionKeys);
    private int AnalysisEnabled => EnabledCount(AnalysisSectionKeys);
    private int AnalysisTotal   => TotalCount(AnalysisSectionKeys);
    private int QualityEnabled  => EnabledCount(QualitySectionKeys);
    private int QualityTotal    => TotalCount(QualitySectionKeys);
    private int AiEnabled       => EnabledCount(AiReviewKeys);
    private int AiTotal         => TotalCount(AiReviewKeys);

    // Menu synchronization summary properties
    private int AllConfiguredCount => AllEditableFeatures.Count();
    private int AllVisibleCount    => AllEditableFeatures.Count(e => e.Value);
    private int AllHiddenCount     => AllEditableFeatures.Count(e => !e.Value);
    private List<(string Label, string Key)> UnflaggedList => UnflaggedMenuItems.ToList();

    private IReadOnlyList<(WorkspaceArtifactKind Kind, string Label, WorkspaceArtifact Artifact)> WorkspaceArtifacts =>
        ArtifactStatus.GetStatus().Availability
            .Where(kvp => kvp.Value)
            .Select(kvp => (Kind: kvp.Key, Label: ArtifactLabel(kvp.Key), Artifact: Workspace.Get(kvp.Key)))
            .Where(item => item.Artifact is not null)
            .Select(item => (item.Kind, item.Label, item.Artifact!))
            .ToList();

    private const string StatusPass = "PASS";
    private const string StatusWarning = "WARNING";
    private const string StatusFail = "FAIL";
    private const string StatusNotAvailable = "NOT AVAILABLE";
    private const string StatusNotRun = "NOT RUN";

    private sealed record RuntimeSummaryRow(string Label, string Value, string Status, string Detail);
    private sealed record RuntimeDiagnosticRow(string Name, string Status, string Value, string Reason);
    private sealed record RuntimeServiceDiagnosticRow(string Name, string Status, string Reason, DateTimeOffset? LastUpdated);
    private sealed record AnalysisSessionDiagnosticRow(string Name, string Status, string Reason, string Prerequisites, DateTimeOffset? LastRun);

    private string ArtifactNamesText =>
        ArtifactStatus.GetStatus().ArtifactCount == 0
            ? "None loaded"
            : string.Join(", ", WorkspaceArtifacts.Select(item => item.Artifact.FileName ?? item.Label));

    private DateTime? LastWorkspaceLoad =>
        ArtifactStatus.GetStatus().ArtifactCount == 0
            ? null
            : WorkspaceArtifacts.Max(item => item.Artifact.LoadedAt);

    private IEnumerable<(string Label, bool Loaded, DateTime? LoadedAt)> ReviewContextArtifactRows =>
        Enum.GetValues<WorkspaceArtifactKind>()
            .Where(kind => kind != WorkspaceArtifactKind.Research)
            .Select(kind =>
            {
                var status = ArtifactStatus.GetStatus();
                var isLoaded = status.Availability.GetValueOrDefault(kind, false);
                var artifact = Workspace.Get(kind);
                return (ArtifactLabel(kind), isLoaded, artifact?.LoadedAt);
            });

    private string FeatureFlagSummary =>
        AllEditableFeatures.Any()
            ? $"{AllVisibleCount} enabled / {AllConfiguredCount} configured"
            : "Not available";

    private int RuntimeWarningCount =>
        RuntimeServiceRows.Count(row => row.Status == StatusWarning) +
        AnalysisSessionRows.Count(row => row.Status == StatusWarning);

    private int RuntimeFailureCount =>
        RuntimeServiceRows.Count(row => row.Status == StatusFail) +
        AnalysisSessionRows.Count(row => row.Status == StatusFail);

    private string OverallRuntimeStatus =>
        RuntimeFailureCount > 0 ? StatusFail :
        RuntimeWarningCount > 0 ? StatusWarning :
        StatusPass;

    private IReadOnlyList<RuntimeSummaryRow> RuntimeSummaryRows =>
    [
        new("Runtime status", OverallRuntimeStatus, OverallRuntimeStatus, RuntimeFailureCount > 0 ? "One or more runtime checks failed." : "No blocking runtime failures detected."),
        new("Workspace loaded", WorkspaceArtifacts.Count > 0 ? "Yes" : "No", WorkspaceArtifacts.Count > 0 ? StatusPass : StatusNotAvailable, WorkspaceArtifacts.Count > 0 ? OrUnavailable(Workspace.CurrentProject) : "No active browser/session workspace."),
        new("Artifacts loaded", WorkspaceArtifacts.Count.ToString(), WorkspaceArtifacts.Count > 0 ? StatusPass : StatusNotAvailable, ArtifactNamesText),
        new("Services ready", $"{RuntimeServiceRows.Count(row => row.Status == StatusPass)} / {RuntimeServiceRows.Count()}", RuntimeServiceRows.Any(row => row.Status == StatusFail) ? StatusFail : StatusPass, "Runtime services are grouped by severity below."),
        new("Sessions completed", CompletedAnalysisCount.ToString(), CompletedAnalysisCount > 0 ? StatusPass : StatusNotRun, CompletedAnalysisCount > 0 ? "At least one analysis has completed." : "No analysis session has completed in this browser session."),
        new("Warnings", RuntimeWarningCount.ToString(), RuntimeWarningCount > 0 ? StatusWarning : StatusPass, RuntimeWarningCount > 0 ? "Review warning rows below." : "No warnings reported."),
        new("Failures", RuntimeFailureCount.ToString(), RuntimeFailureCount > 0 ? StatusFail : StatusPass, RuntimeFailureCount > 0 ? "Failures block reliable diagnostics." : "No failures reported."),
    ];

    private IEnumerable<RuntimeDiagnosticRow> WorkspaceDiagnosticRows
    {
        get
        {
            var hasWorkspace = WorkspaceArtifacts.Count > 0;
            yield return new("Project", hasWorkspace ? StatusPass : StatusNotAvailable, OrUnavailable(Workspace.CurrentProject), hasWorkspace ? "Active project is available in browser/session state." : "No active workspace is loaded in this browser session.");
            yield return new("Workspace status", hasWorkspace ? StatusPass : StatusNotAvailable, hasWorkspace ? "Loaded" : "No workspace loaded", hasWorkspace ? "Workspace artifacts are available to frontend diagnostics." : "This is not a failure; load or resume a workspace to run workspace-specific checks.");
            yield return new("Loaded artifacts count", hasWorkspace ? StatusPass : StatusNotAvailable, WorkspaceArtifacts.Count.ToString(), hasWorkspace ? "Artifacts are available to the current session." : "No artifact set exists in the current runtime session.");
            yield return new("Artifact names", hasWorkspace ? StatusPass : StatusNotAvailable, ArtifactNamesText, hasWorkspace ? "Names are from the current browser/session artifact repository." : "No artifacts are loaded.");
            yield return new("Last loaded timestamp", LastWorkspaceLoad.HasValue ? StatusPass : StatusNotAvailable, FormatTimestamp(LastWorkspaceLoad), LastWorkspaceLoad.HasValue ? "Most recent artifact load in the current session." : "No artifact load timestamp is available.");
        }
    }

    private IEnumerable<RuntimeDiagnosticRow> MarkdownEngineDiagnosticRows
    {
        get
        {
            yield return new("Engine initialized", MarkdownEngine is not null ? StatusPass : StatusFail, MarkdownEngine is not null ? "Ready" : "Service missing", MarkdownEngine is not null ? "Markdown parser service is registered." : "Required markdown parser service is not available.");
            yield return new("Parsed documents", WorkspaceArtifacts.Count > 0 ? StatusPass : StatusNotAvailable, WorkspaceArtifacts.Count.ToString(), WorkspaceArtifacts.Count > 0 ? "Loaded artifacts can be parsed on demand." : "No workspace artifacts are loaded.");
            yield return new("Cache status", StatusNotAvailable, "Not exposed", "Cache status is not exposed by Markdown Engine.");
        }
    }

    private IEnumerable<RuntimeDiagnosticRow> WorkflowDiagnosticRows
    {
        get
        {
            yield return new("WorkflowReadinessService available", StatusPass, "Registered", "Recommended Workflow and Dashboard use WorkflowReadinessService for readiness state.");
            yield return new("Renderer connected", StatusPass, "RecommendedWorkflow.razor", "Renderer consumes workflow readiness instead of direct session lookups.");
            yield return new("Empty workspace reset works", WorkspaceArtifacts.Count == 0 ? StatusPass : StatusNotAvailable, WorkspaceArtifacts.Count == 0 ? "Verified by current empty state" : "Workspace loaded", WorkspaceArtifacts.Count == 0 ? "No workspace is loaded and no release state is available." : "Load-state reset cannot be observed while a workspace is active.");
            yield return new("Release state derived from readiness", StatusPass, "Derived", "Release is not persisted in runtime diagnostics.");
            yield return new("No stale release state", WorkspaceArtifacts.Count == 0 ? StatusPass : StatusNotAvailable, WorkspaceArtifacts.Count == 0 ? "No release state" : "Workspace active", WorkspaceArtifacts.Count == 0 ? "Empty workspace has no release recommendation." : "Release state depends on current workflow readiness.");
        }
    }

    private IEnumerable<AnalysisSessionDiagnosticRow> AnalysisSessionRows
    {
        get
        {
            yield return new("Requirements Traceability",
                AnalysisSessions.TraceabilityReport is null ? StatusNotRun : StatusPass,
                AnalysisSessions.TraceabilityReport is null ? "Analysis exists but has not been executed in this session." : "Traceability session completed.",
                "Requires loaded workspace and at least two artifacts",
                AnalysisSessions.TraceabilityRunAt);

            yield return new("Quality Review",
                NormalizeSessionStatus(QualitySession.Status),
                SessionReason(NormalizeSessionStatus(QualitySession.Status), "Quality review session completed."),
                "Requires ReviewContext",
                QualitySession.RunTimestamp ?? LastQualityReviewRun);

            yield return new("WASM Security Review",
                NormalizeRuntimeStatus(RuntimeReviews.SecurityReview.Status),
                SessionReason(NormalizeRuntimeStatus(RuntimeReviews.SecurityReview.Status), "Security review completed."),
                "Requires loaded workspace or target URL",
                RuntimeReviews.SecurityReview.RunTimestamp);

            yield return new("WASM Performance Review",
                NormalizeRuntimeStatus(RuntimeReviews.PerformanceReview.Status),
                SessionReason(NormalizeRuntimeStatus(RuntimeReviews.PerformanceReview.Status), "Performance review completed."),
                "Requires loaded workspace or target URL",
                RuntimeReviews.PerformanceReview.RunTimestamp);

            yield return new("Implementation Review",
                AdoApi.GetCached() is null ? StatusNotRun : StatusPass,
                AdoApi.GetCached() is null ? "Analysis exists but has not been executed in this session." : "Implementation review cache is available.",
                "Requires spec.md and tasks.md",
                null);

            yield return new("Impact Analysis",
                WorkspaceArtifacts.Count > 0 ? StatusNotRun : StatusNotAvailable,
                WorkspaceArtifacts.Count > 0 ? "Analysis exists but has not been executed in this session." : "Prerequisites missing because no workspace is loaded.",
                "Requires loaded workspace",
                null);

            yield return new("Spec Drift",
                Workspace.Get(WorkspaceArtifactKind.Specification) is not null ? StatusNotRun : StatusNotAvailable,
                Workspace.Get(WorkspaceArtifactKind.Specification) is not null ? "Analysis exists but has not been executed in this session." : "Prerequisites missing because spec.md is not loaded.",
                "Requires spec.md",
                null);
        }
    }

    private DateTimeOffset? LastQualityReviewRun =>
        new[]
        {
            AnalysisSessions.ComplianceRunAt,
            AnalysisSessions.AuditRunAt,
            AnalysisSessions.DeliveryRunAt,
            AnalysisSessions.ReadinessRunAt
        }.Where(value => value.HasValue).Max();

    private IEnumerable<RuntimeServiceDiagnosticRow> RuntimeServiceRows
    {
        get
        {
            yield return new("WorkspaceArtifactRepository", StatusPass, $"{WorkspaceArtifacts.Count} artifacts loaded in browser/session state.", LastWorkspaceLoad.HasValue ? new DateTimeOffset(LastWorkspaceLoad.Value) : null);
            yield return new("RuntimeReviewSessionService", StatusPass, $"{RuntimeReviewResultCount} runtime review result(s) available.", LatestRuntimeReviewTimestamp);
            yield return new("ExtractionSessionService", StatusPass, _extractionSnapshot is null ? "No active extraction session." : $"Extraction session restored from {FormatTimestamp(_extractionSnapshot.Timestamp)}.", _extractionSnapshot?.Timestamp);
            yield return new("Markdown Engine", MarkdownEngine is null ? StatusFail : StatusPass, MarkdownEngine is null ? "Markdown parser service is not registered." : "Markdown parser service is registered. Cache status is not exposed by Markdown Engine.", null);
            yield return new("Analysis Services", StatusPass, $"{CompletedAnalysisCount} completed analysis session(s).", LastQualityReviewRun);
        }
    }

    private IEnumerable<(string Label, IEnumerable<RuntimeServiceDiagnosticRow> Rows)> RuntimeServiceGroups
    {
        get
        {
            var rows = RuntimeServiceRows.ToList();
            yield return ("Ready", rows.Where(row => row.Status == StatusPass));
            yield return ("Warning", rows.Where(row => row.Status == StatusWarning));
            yield return ("Failed", rows.Where(row => row.Status == StatusFail));
            yield return ("Not Available", rows.Where(row => row.Status == StatusNotAvailable));
        }
    }

    private int RuntimeReviewResultCount =>
        (RuntimeReviews.SecurityReview.HasResult ? 1 : 0) +
        (RuntimeReviews.PerformanceReview.HasResult ? 1 : 0);

    private DateTimeOffset? LatestRuntimeReviewTimestamp =>
        new[] { RuntimeReviews.SecurityReview.RunTimestamp, RuntimeReviews.PerformanceReview.RunTimestamp }
            .Where(value => value.HasValue)
            .Max();

    private int CompletedAnalysisCount =>
        AnalysisSessionRows.Count(row => row.Status == StatusPass);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settingsTask  = AdminApi.GetSystemSettingsAsync();
            var editableTask  = AdminApi.GetEditableSettingsAsync();
            await Task.WhenAll(settingsTask, editableTask);

            _settings         = settingsTask.Result;
            _editableSettings = editableTask.Result;

            if (_settings is null)
                _loadError = "Could not load system settings. Make sure the backend is running.";

            InitEditState();
        }
        catch
        {
            _loadError = "Could not load system settings. Make sure the backend is running.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_activeSection == "config-health" && !_configHealthLoaded)
        {
            _configHealthLoaded = true;
            try
            {
                _configHealthReport = await AdminApi.GetConfigurationHealthAsync();
            }
            catch
            {
                _configHealthReport = null;
            }
            StateHasChanged();
        }

        if (_activeSection == "diagnostics" && !_diagDocLoaded)
        {
            _diagDocLoaded = true;
            _diagDocSummary = await DocumentApi.GetSummaryAsync();
            StateHasChanged();
        }

        if (_activeSection == "doc-health" && !_docHealthComputed)
        {
            _docHealthComputed = true;
            _docHealthFindings = RunDocumentationHealthChecks();
            StateHasChanged();
        }

        if (_activeSection == "ui-migration" && !_runtimeDiagnosticsLoaded)
        {
            _runtimeDiagnosticsLoaded = true;
            _extractionSnapshot = await ExtractionSession.LoadAsync();
            StateHasChanged();
        }
    }

    private void InitEditState()
    {
        if (_editableSettings is null) return;
        _editFv = _editableSettings.FeatureVisibility.Core
            .Concat(_editableSettings.FeatureVisibility.Advanced)
            .ToDictionary(e => e.Key, e => e.Value);
        _editLogLevel       = _editableSettings.Logging.MinimumLevel;
        _editSeqUrl         = _editableSettings.Logging.SeqUrl ?? "";
        _editShowDiagnostics = _editableSettings.Admin.ShowDiagnostics;
    }

    private void EnterEditMode()
    {
        if (_editableSettings is null) return;
        InitEditState();
        _saveError     = null;
        _isEditMode    = true;
        _activeSection = "feature-visibility";
    }

    private void CancelEdit()
    {
        _isEditMode = false;
        _saveError  = null;
    }

    private void ToggleFeature(string key, bool value)
    {
        if (_editFv.ContainsKey(key))
            _editFv[key] = value;
    }

    private async Task SaveAsync()
    {
        if (_editableSettings is null || _isSaving) return;

        _isSaving  = true;
        _saveError = null;
        StateHasChanged();

        var fvChanges = new Dictionary<string, bool>();
        foreach (var entry in _editableSettings.FeatureVisibility.Core
            .Concat(_editableSettings.FeatureVisibility.Advanced))
        {
            var newValue = _editFv.GetValueOrDefault(entry.Key, entry.Value);
            if (newValue != entry.Value)
                fvChanges[entry.Key] = newValue;
        }

        var logLevelChanged     = _editLogLevel != _editableSettings.Logging.MinimumLevel;
        var seqUrlChanged       = _editSeqUrl  != (_editableSettings.Logging.SeqUrl ?? "");
        var diagChanged         = _editShowDiagnostics != _editableSettings.Admin.ShowDiagnostics;

        if (fvChanges.Count == 0 && !logLevelChanged && !seqUrlChanged && !diagChanged)
        {
            _isEditMode = false;
            _isSaving   = false;
            return;
        }

        var request = new SaveSettingsRequest
        {
            FeatureVisibility = fvChanges.Count > 0 ? fvChanges : null,
            Logging = (logLevelChanged || seqUrlChanged) ? new SaveLoggingRequest
            {
                MinimumLevel = logLevelChanged ? _editLogLevel : null,
                SeqUrl       = seqUrlChanged   ? _editSeqUrl  : null
            } : null,
            Admin = diagChanged ? new SaveAdminRequest { ShowDiagnostics = _editShowDiagnostics } : null
        };

        try
        {
            var (success, message) = await AdminApi.SaveSettingsAsync(request);
            if (success)
            {
                await RefreshAfterSaveAsync();
                if (_settings?.FeatureVisibility is not null)
                    FeatureViz.ApplyLocalFlags(_settings.FeatureVisibility);

                _isEditMode  = false;
                _saveSuccess = message;
                StateHasChanged();
                await Task.Delay(6000);
                _saveSuccess = null;
            }
            else
            {
                _saveError = message;
            }
        }
        catch (Exception ex)
        {
            _saveError = $"Save failed: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task RefreshAfterSaveAsync()
    {
        var st = AdminApi.GetSystemSettingsAsync();
        var et = AdminApi.GetEditableSettingsAsync();
        await Task.WhenAll(st, et);

        if (st.Result is not null) _settings = st.Result;
        if (et.Result is not null)
        {
            _editableSettings = et.Result;
            InitEditState();
        }
    }

