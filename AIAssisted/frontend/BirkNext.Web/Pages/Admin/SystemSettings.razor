    private string BuildRuntimeDiagnosticsExport()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("QA Review Studio - Runtime Diagnostics");
        sb.AppendLine($"Export timestamp: {DateTimeOffset.Now:yyyy-MM-dd HH:mm:ss zzz}");
        sb.AppendLine($"Overall status: {OverallRuntimeStatus}");
        sb.AppendLine($"Current project: {OrUnavailable(Workspace.CurrentProject)}");
        sb.AppendLine($"Workspace artifacts: {WorkspaceArtifacts.Count}");
        sb.AppendLine($"Loaded artifact names: {ArtifactNamesText}");
        sb.AppendLine($"Last workspace load: {FormatTimestamp(LastWorkspaceLoad)}");
        sb.AppendLine($"Warnings: {RuntimeWarningCount}");
        sb.AppendLine($"Failures: {RuntimeFailureCount}");
        sb.AppendLine();
        sb.AppendLine("Summary");
        foreach (var metric in RuntimeSummaryRows)
            sb.AppendLine($"- {metric.Label}: {metric.Value} [{metric.Status}] {metric.Detail}");
        sb.AppendLine();
        sb.AppendLine("Workspace");
        foreach (var row in WorkspaceDiagnosticRows)
            sb.AppendLine($"- {row.Name}: {row.Value} [{row.Status}] {row.Reason}");
        sb.AppendLine();
        sb.AppendLine("Markdown Engine");
        foreach (var row in MarkdownEngineDiagnosticRows)
            sb.AppendLine($"- {row.Name}: {row.Value} [{row.Status}] {row.Reason}");
        sb.AppendLine();
        sb.AppendLine("Recommended Workflow");
        foreach (var row in WorkflowDiagnosticRows)
            sb.AppendLine($"- {row.Name}: {row.Value} [{row.Status}] {row.Reason}");
        sb.AppendLine();
        sb.AppendLine("Analysis Sessions");
        foreach (var session in AnalysisSessionRows)
            sb.AppendLine($"- {session.Name}: {session.Status}; {session.Reason}; prerequisites: {session.Prerequisites}; last run: {FormatTimestamp(session.LastRun)}");
        sb.AppendLine();
        sb.AppendLine("Runtime Services");
        foreach (var service in RuntimeServiceRows)
            sb.AppendLine($"- {service.Name}: {service.Status}; {service.Reason}; last updated: {FormatTimestamp(service.LastUpdated)}");
        return sb.ToString();
    }

    private Task RunReviewContextValidationAsync()
    {
        if (WorkspaceArtifacts.Count == 0)
        {
            _reviewContextReport = ReviewContextValidator.Validate(null, null, null, null, OrUnavailable(Workspace.CurrentProject));
            _reviewContextValidationMessage = "No workspace artifacts are loaded.";
            StateHasChanged();
            return Task.CompletedTask;
        }

        var parsed = MarkdownEngine.Parse(
            Workspace.Constitution?.Text,
            Workspace.Specification?.Text,
            Workspace.Plan?.Text,
            Workspace.Tasks?.Text);

        _reviewContextReport = ReviewContextValidator.Validate(
            parsed.Constitution,
            parsed.Spec,
            parsed.Plan,
            parsed.Tasks,
            OrUnavailable(Workspace.CurrentProject));

        _reviewContextValidationMessage = $"Validation complete: {_reviewContextReport.Summary}.";
        StateHasChanged();
        return Task.CompletedTask;
    }

