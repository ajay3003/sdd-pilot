    private static string SemVerCore(string? version)
    {
        if (string.IsNullOrWhiteSpace(version)) return "—";
        var idx = version.IndexOfAny(['+', '-']);
        return idx > 0 ? version[..idx] : version;
    }

    private async Task CopyAsync(string text)
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", text); }
        catch { }
    }

    private async Task CopyDiagnosticsAsync()
    {
        if (_settings is null) return;
        var s = _settings;
        var d = (string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("QA Review Studio — Diagnostics Summary");
        sb.AppendLine($"App:             {d(s.Application.ApplicationName)} v{d(s.Application.Version)}");
        sb.AppendLine($"Environment:     {d(s.Application.Environment)}");
        sb.AppendLine($"Package Mode:    {d(s.Application.PackageMode)}");
        if (!string.IsNullOrWhiteSpace(s.Application.CommitSha))
            sb.AppendLine($"Commit:          {s.Application.CommitSha}");
        sb.AppendLine();
        sb.AppendLine($"Backend URL:     {d(s.Backend.BackendBaseUrl)}");
        sb.AppendLine($"Frontend URL:    {d(s.Frontend.FrontendBaseUrl)}");
        sb.AppendLine($"GraphQL:         {d(s.Frontend.GraphQlEndpoint)}");
        sb.AppendLine();
        sb.AppendLine($"Database Mode:   {d(s.Database.Mode)}");
        sb.AppendLine($"Host:            {d(s.Database.Host)}:{(s.Database.Port > 0 ? s.Database.Port.ToString() : "—")}");
        sb.AppendLine($"Database Name:   {d(s.Database.DatabaseName)}");
        sb.AppendLine($"Username:        {d(s.Database.Username)}");
        sb.AppendLine($"Provider:        {d(s.Database.Provider)}");
        sb.AppendLine($"Migration:       {d(s.Database.MigrationStatus)}");
        sb.AppendLine();
        sb.AppendLine($"Compose Project: {d(s.Runtime.ComposeProjectName)}");
        sb.AppendLine($"Expected Volume: {d(s.Runtime.ExpectedDatabaseVolume)}");
        sb.AppendLine();
        sb.AppendLine($"Logging:         {d(s.Logging.Provider)} / {d(s.Logging.MinimumLevel)}");
        sb.AppendLine($"Log Path:        {d(s.Logging.LogPath)}");
        if (!string.IsNullOrWhiteSpace(s.Logging.ResolvedLogsFolder) && s.Logging.ResolvedLogsFolder != s.Logging.LogPath)
            sb.AppendLine($"Logs Folder:     {d(s.Logging.ResolvedLogsFolder)}");
        if (!string.IsNullOrWhiteSpace(s.Logging.SeqUrl))
            sb.AppendLine($"Seq URL:         {s.Logging.SeqUrl}");

        await CopyAsync(sb.ToString());
        _copiedDiag = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copiedDiag = false;
        StateHasChanged();
    }

    private void OpenResetModal()
    {
        _resetConfirmText   = "";
        _resetResultMessage = null;
        _showResetModal     = true;
    }

    private void CancelReset()
    {
        if (_isResetting) return;
        _showResetModal   = false;
        _resetConfirmText = "";
    }

    private async Task ExecuteResetAsync()
    {
        if (_resetConfirmText != "RESET" || _isResetting) return;
        _isResetting = true;
        try
        {
            var (success, message) = await AdminApi.ResetLocalDatabaseAsync();
            _resetSuccess       = success;
            _resetResultMessage = message;
            if (success)
            {
                await JS.InvokeVoidAsync("localStorage.removeItem", "ce-standalone-constitution");
                await JS.InvokeVoidAsync("localStorage.removeItem", "pe-standalone-plan");
                await JS.InvokeVoidAsync("localStorage.removeItem", "te-standalone-tasks");
                await JS.InvokeVoidAsync("localStorage.removeItem", "birknext:extraction:session");
            }
        }
        finally
        {
            _isResetting      = false;
            _showResetModal   = false;
            _resetConfirmText = "";
        }
    }

