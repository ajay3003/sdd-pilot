@using BirkNext.Web.Models

<div class="qr-qa-preview-list">
    @foreach (var finding in VisibleFindings)
    {
        <div class="qr-finding-card" data-severity="@QaSevString(finding.Severity).ToLowerInvariant()">
            <div class="qr-finding-header">
                <span class="qr-finding-severity" data-severity="@QaSevString(finding.Severity).ToLowerInvariant()">@QaSevString(finding.Severity)</span>
                <div class="qr-finding-title">@FormatTitle(finding)</div>
            </div>
            @if (!string.IsNullOrEmpty(FormatDescription(finding)))
            {
                <div class="qr-finding-description"><strong>Problem:</strong> @FormatDescription(finding)</div>
            }
            @if (!string.IsNullOrWhiteSpace(GetReference(finding)))
            {
                <div class="qr-finding-reference"><strong>Reference:</strong> @GetReference(finding)</div>
            }
        </div>
    }

    @if (Items.Count > PreviewLimit && !ShowAll)
    {
        <button class="qr-show-toggle"
                type="button"
                @onclick="async () => await OnShowAllChanged.InvokeAsync(true)"
                aria-label="@($"Show all {Items.Count} {ContextLabel}")">
            Show all @Items.Count
        </button>
    }
    else if (Items.Count > PreviewLimit && ShowAll)
    {
        <button class="qr-show-toggle"
                type="button"
                @onclick="async () => await OnShowAllChanged.InvokeAsync(false)"
                aria-label="@($"Show fewer {ContextLabel}")">
            Show less
        </button>
    }
</div>

@code {
    [Parameter]
    public List<QaFinding> Items { get; set; } = [];

    [Parameter]
    public int PreviewLimit { get; set; } = 5;

    [Parameter]
    public bool ShowAll { get; set; }

    [Parameter]
    public EventCallback<bool> OnShowAllChanged { get; set; }

    [Parameter]
    public string ContextLabel { get; set; } = "findings";

    [Parameter]
    public Dictionary<string, ConstitutionRulePresentationMetadata>? CanonicalMetadata { get; set; }

    private IEnumerable<QaFinding> VisibleFindings => ShowAll ? Items : Items.Take(PreviewLimit);

    private string? GetReference(QaFinding finding)
    {
        // For Constitution coverage findings, don't repeat the affected rule (it's now primary)
        // Show detector metadata instead
        var detector = GetDetectorMetadata(finding);
        if (!string.IsNullOrEmpty(detector))
            return detector;

        // The rule code is already part of the identity; retain only distinct traceability.
        return !string.IsNullOrWhiteSpace(finding.AffectedArtifact) &&
               !string.Equals(finding.RuleCode?.Trim(), finding.AffectedArtifact.Trim(), StringComparison.OrdinalIgnoreCase)
            ? finding.AffectedArtifact.Trim()
            : null;
    }

    private string QaSevString(QaSeverity sev) => sev.ToString();

    private string FormatFindingPresentation(QaFinding finding)
    {
        var title = FormatTitle(finding);
        var desc = FormatDescription(finding);
        var category = finding.Category.ToString();

        if (string.IsNullOrEmpty(desc))
            return title;

        return $"{title} · {category} · {desc}";
    }

    private string FormatTitle(QaFinding finding)
    {
        var ruleCode = finding.RuleCode?.Trim() ?? string.Empty;
        var rawTitle = finding.Title?.Trim() ?? string.Empty;

        // For Constitution coverage findings, use affected rule as primary identity
        if (IsConstitutionCoverageFinding(finding))
        {
            var affectedRule = finding.AffectedArtifact?.Trim();
            if (!string.IsNullOrEmpty(affectedRule))
            {
                var normalizedKey = affectedRule.ToUpperInvariant();
                if (CanonicalMetadata?.TryGetValue(normalizedKey, out var metadata) == true && !string.IsNullOrEmpty(metadata.RuleTitle))
                {
                    return $"{affectedRule} — {metadata.RuleTitle}";
                }
                return affectedRule;
            }
        }

        // Direct Constitution rule IDs can use the same canonical metadata as detector findings.
        if (finding.Category == QaCategory.Constitution &&
            !string.IsNullOrEmpty(ruleCode) &&
            CanonicalMetadata?.TryGetValue(ruleCode.ToUpperInvariant(), out var directMetadata) == true &&
            !string.IsNullOrWhiteSpace(directMetadata.RuleTitle))
        {
            return ComposeIdentity(ruleCode, directMetadata.RuleTitle);
        }

        // Default behavior for non-Constitution findings
        return ComposeIdentity(ruleCode, rawTitle);
    }

    private static string ComposeIdentity(string ruleCode, string title)
    {
        if (string.IsNullOrWhiteSpace(ruleCode)) return title.Trim();

        var code = ruleCode.Trim();
        var name = title.Trim();
        if (string.IsNullOrEmpty(name) || string.Equals(code, name, StringComparison.OrdinalIgnoreCase)) return code;

        foreach (var separator in new[] { "—", "–", "-" })
        {
            var prefix = $"{code} {separator}";
            if (name.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
            {
                var suffix = name[prefix.Length..].Trim();
                return string.IsNullOrEmpty(suffix) || string.Equals(code, suffix, StringComparison.OrdinalIgnoreCase)
                    ? code
                    : $"{code} — {suffix}";
            }
        }

        return $"{code} — {name}";
    }

    private bool IsConstitutionCoverageFinding(QaFinding finding)
    {
        return finding.Category == QaCategory.Constitution &&
               finding.RuleCode?.StartsWith("CONST-") == true &&
               !string.IsNullOrEmpty(finding.AffectedArtifact);
    }

    private string? GetDetectorMetadata(QaFinding finding)
    {
        // For Constitution coverage findings, show detector as secondary metadata
        if (IsConstitutionCoverageFinding(finding))
        {
            return finding.RuleCode?.Trim();
        }
        return null;
    }

    private string FormatDescription(QaFinding finding)
    {
        // For Constitution coverage findings, derive concise description
        if (finding.Category == QaCategory.Constitution && !string.IsNullOrEmpty(finding.Description))
        {
            if (finding.Description.Contains("not covered") || finding.Description.Contains("no coverage"))
            {
                var missing = new List<string>();
                if (finding.Description.Contains("Specification")) missing.Add("Specification");
                if (finding.Description.Contains("Plan")) missing.Add("Plan");
                if (finding.Description.Contains("Tasks")) missing.Add("Tasks");

                if (missing.Count > 0)
                {
                    string formatted = missing.Count switch
                    {
                        1 => missing[0],
                        2 => $"{missing[0]} and {missing[1]}",
                        _ => $"{string.Join(", ", missing.SkipLast(1))} and {missing.Last()}"
                    };
                    return $"Missing coverage in {formatted}.";
                }
            }
        }

        return finding.Description ?? "";
    }
}
