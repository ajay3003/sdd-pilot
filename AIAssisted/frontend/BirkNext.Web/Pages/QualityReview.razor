    private record RuleIdExtractionResult(string RuleId, string ActionText);

    private RuleIdExtractionResult ExtractRuleIdFromRecommendationText(string text)
    {
        if (string.IsNullOrEmpty(text))
            return new("", text);

        // Try to extract rule ID from common patterns:
        // "Add PP-02 requirements to the specification."
        // "Add PRINCIPLE-005 (V. Testing is Mandatory) implementation strategy to the plan."
        // "Constitution→Spec coverage low (0%)"

        // Pattern 1: RuleId in "Add RuleId ..." or similar
        var match = System.Text.RegularExpressions.Regex.Match(text, @"\b([A-Z]+-\d+|PRINCIPLE-\d+|PP-\d+)\b");
        if (match.Success)
        {
            var ruleId = match.Groups[1].Value;
            // Keep the action text as-is (it already contains the meaningful action)
            return new(ruleId, text);
        }

        return new("", text);
    }

