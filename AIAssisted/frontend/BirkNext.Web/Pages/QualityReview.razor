    private IReadOnlyDictionary<WorkspaceArtifactKind, string> BuildArtifactSnapshot()
    {
        var snapshot = new Dictionary<WorkspaceArtifactKind, string>();
        AddArtifact(snapshot, WorkspaceArtifactKind.Constitution, _constitutionText);
        AddArtifact(snapshot, WorkspaceArtifactKind.Specification, _specText);
        AddArtifact(snapshot, WorkspaceArtifactKind.Plan, _planText);
        AddArtifact(snapshot, WorkspaceArtifactKind.Tasks, _taskText);
        AddArtifact(snapshot, WorkspaceArtifactKind.DataModel, _dataModelText);
        return snapshot;
    }

    private static void AddArtifact(Dictionary<WorkspaceArtifactKind, string> snapshot, WorkspaceArtifactKind kind, string text)
    {
        if (!string.IsNullOrWhiteSpace(text))
            snapshot[kind] = text;
    }

    private bool IsSessionForCurrentProject()
    {
