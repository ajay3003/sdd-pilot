@page "/quality-review"
@using BirkNext.Web.Components
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@inject IQualityReviewService QrService
@inject IDashboardSnapshotService DashboardSnapshot
@inject IDeliveryReadinessAssessmentService DrService
@inject QualityReviewSessionService QualitySession
@inject IReportExportService ExportService
@inject ISampleProjectDocumentResolver DocumentResolver
@inject IJSRuntime JS

<PageTitle>Quality Review</PageTitle>

<div class="qr-page">

    @if (!string.IsNullOrWhiteSpace(_selectedProjectName))
    {
        <div style="padding: 8px 16px; background: #f5f5f5; border-bottom: 1px solid #e0e0e0; font-size: 0.875rem; color: #666;">
            Sample Project: <strong>@_selectedProjectName</strong>
        </div>
    }

    <PageHeader Title="Quality Review"
                Description="Run quality, compliance, and readiness reviews against the selected Sample Project. Choose review packs and generate a comprehensive report." />

    <!-- ── No project selected state ────────────────────────────────────── -->
    @if (string.IsNullOrWhiteSpace(_selectedProject))
    {
        <div style="padding: 64px 32px; text-align: center; color: #999;">
            <p style="font-size: 1.1rem; margin-bottom: 0.5rem;">No Sample Project selected.</p>
            <p style="font-size: 0.95rem;">Select a Sample Project from the sidebar to run a quality review.</p>
        </div>
    }
    else
    {
        <!-- ── Input panel ────────────────────────────────────────────────────── -->
        <div class="qr-input-panel">
            <div class="qr-input-panel-header">
                <span class="qr-input-panel-title"><span class="qr-step-badge">1</span> Sample Project Artifacts</span>
                @if (_report is not null)
                {
                    <button class="qr-input-panel-toggle" @onclick="() => _inputExpanded = !_inputExpanded">
                        @(_inputExpanded ? "▾ Collapse" : "▸ Expand")
                    </button>
                }
            </div>

        @if (_inputExpanded)
        {
            <!-- ── Artifact cards ───────────────────────────────────────── -->
            <div class="qr-artifact-grid">

                <div class="artifact-card @(!string.IsNullOrEmpty(_constitutionText) ? "is-loaded" : "")">
                    <div class="artifact-card-header">
                        <span class="artifact-icon" aria-hidden="true">📜</span>
                        <span class="artifact-name">Constitution</span>
                        <span class="artifact-status @(!string.IsNullOrEmpty(_constitutionText) ? "is-loaded" : "")">
                            @(!string.IsNullOrEmpty(_constitutionText) ? "Available" : "Missing")
                        </span>
                    </div>
                    <div style="padding: 8px 0; font-size: 0.85rem; color: #666;">constitution.md</div>
                    <div style="padding: 4px 0; font-size: 0.8rem; color: #999;">Source: Sample Project</div>
                    @if (!string.IsNullOrEmpty(_constitutionText))
                    {
                        <div class="artifact-footer">
                            <span>@_constitutionText.Split('\n').Length lines</span>
                        </div>
                    }
                </div>

                <div class="artifact-card @(!string.IsNullOrEmpty(_specText) ? "is-loaded" : "")">
                    <div class="artifact-card-header">
                        <span class="artifact-icon" aria-hidden="true">📋</span>
                        <span class="artifact-name">Specification</span>
                        <span class="artifact-status @(!string.IsNullOrEmpty(_specText) ? "is-loaded" : "")">
                            @(!string.IsNullOrEmpty(_specText) ? "Available" : "Missing")
                        </span>
                    </div>
                    <div style="padding: 8px 0; font-size: 0.85rem; color: #666;">spec.md</div>
                    <div style="padding: 4px 0; font-size: 0.8rem; color: #999;">Source: Sample Project</div>
                    @if (!string.IsNullOrEmpty(_specText))
                    {
                        <div class="artifact-footer">
                            <span>@_specText.Split('\n').Length lines</span>
                        </div>
                    }
                </div>

                <div class="artifact-card @(!string.IsNullOrEmpty(_planText) ? "is-loaded" : "")">
                    <div class="artifact-card-header">
                        <span class="artifact-icon" aria-hidden="true">📐</span>
                        <span class="artifact-name">Plan</span>
                        <span class="artifact-status @(!string.IsNullOrEmpty(_planText) ? "is-loaded" : "")">
                            @(!string.IsNullOrEmpty(_planText) ? "Available" : "Missing")
                        </span>
                    </div>
                    <div style="padding: 8px 0; font-size: 0.85rem; color: #666;">plan.md</div>
                    <div style="padding: 4px 0; font-size: 0.8rem; color: #999;">Source: Sample Project</div>
                    @if (!string.IsNullOrEmpty(_planText))
                    {
                        <div class="artifact-footer">
                            <span>@_planText.Split('\n').Length lines</span>
                        </div>
                    }
                </div>

                <div class="artifact-card @(!string.IsNullOrEmpty(_taskText) ? "is-loaded" : "")">
                    <div class="artifact-card-header">
                        <span class="artifact-icon" aria-hidden="true">✅</span>
                        <span class="artifact-name">Tasks</span>
                        <span class="artifact-status @(!string.IsNullOrEmpty(_taskText) ? "is-loaded" : "")">
                            @(!string.IsNullOrEmpty(_taskText) ? "Available" : "Missing")
                        </span>
                    </div>
                    <div style="padding: 8px 0; font-size: 0.85rem; color: #666;">tasks.md</div>
                    <div style="padding: 4px 0; font-size: 0.8rem; color: #999;">Source: Sample Project</div>
                    @if (!string.IsNullOrEmpty(_taskText))
                    {
                        <div class="artifact-footer">
                            <span>@_taskText.Split('\n').Length lines</span>
                        </div>
                    }
                </div>

                <div class="artifact-card @(!string.IsNullOrEmpty(_dataModelText) ? "is-loaded" : "")">
                    <div class="artifact-card-header">
                        <span class="artifact-icon" aria-hidden="true">🗄️</span>
                        <span class="artifact-name">Data Model</span>
                        <span class="artifact-status @(!string.IsNullOrEmpty(_dataModelText) ? "is-loaded" : "")">
                            @(!string.IsNullOrEmpty(_dataModelText) ? "Available" : "Missing")
                        </span>
                    </div>
                    <div style="padding: 8px 0; font-size: 0.85rem; color: #666;">data-model.md</div>
                    <div style="padding: 4px 0; font-size: 0.8rem; color: #999;">Source: Sample Project</div>
                    @if (!string.IsNullOrEmpty(_dataModelText))
                    {
                        <div class="artifact-footer">
                            <span>@_dataModelText.Split('\n').Length lines</span>
                        </div>
                    }
                </div>

            </div>

            <!-- ── Review pack selector ─────────────────────────────────── -->
            <div class="qr-packs-section">
                <div class="qr-packs-title"><span class="qr-step-badge">2</span> Review Packs</div>
                <div class="qr-shortcut-bar">
                    <button class="qr-shortcut-btn" @onclick="SelectAllPacks" title="Select all available packs">Select All</button>
                    <button class="qr-shortcut-btn" @onclick='() => SelectPackGroup("Quality")' title="Select all Quality packs">Quality</button>
                    <button class="qr-shortcut-btn" @onclick='() => SelectPackGroup("Governance")' title="Select all Governance packs">Governance</button>
                    <button class="qr-shortcut-btn" @onclick='() => SelectPackGroup("Standards")' title="Select all Standards packs">Standards</button>
                    <button class="qr-shortcut-btn" @onclick='() => SelectPackGroup("Readiness")' title="Select all Readiness packs">Readiness</button>
                    <button class="qr-shortcut-btn qr-shortcut-btn--clear" @onclick="() => _selectedPacks.Clear()" title="Clear all selections">Clear</button>
                </div>
                <div class="qr-packs-grid">
                    @foreach (var group in QrService.AvailablePacks
                        .GroupBy(p => p.PackGroup)
                        .OrderBy(g => _groupOrder.GetValueOrDefault(g.Key, 99)))
                    {
                        <div class="qr-pack-group">
                            <div class="qr-pack-group-title">@group.Key</div>
                            @foreach (var pack in group)
                            {
                                var isAvailable = IsPackAvailable(pack);
                                var requirementText = GetPackRequirementText(pack);
                                <label class="qr-pack-option @(!isAvailable ? "is-disabled" : "")">
                                    <input type="checkbox"
                                           checked="@(_selectedPacks.Contains(pack.PackId) && isAvailable)"
                                           disabled="@(!isAvailable)"
                                           @onchange="e => TogglePack(pack.PackId, (bool)e.Value!)" />
                                    <span class="qr-pack-label">
                                        <span class="qr-pack-name">@pack.PackName</span>
                                        <span class="qr-pack-desc">@pack.PackDescription</span>
                                        @if (!isAvailable && requirementText is not null)
                                        {
                                            <span class="qr-prereq-warn" title="@requirementText">⊘ @requirementText</span>
                                        }
                                        else if (isAvailable && PackPrerequisiteWarning(pack) is string warn)
                                        {
                                            <span class="qr-prereq-warn">⚠ @warn</span>
                                        }
                                    </span>
                                </label>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- ── Run bar ──────────────────────────────────────────────── -->
            <div class="qr-run-bar">
                <div class="qr-run-summary-section">
                    <span class="qr-run-title"><span class="qr-step-badge">3</span> Review Summary</span>
                    <span class="qr-run-details">@RunSummaryText</span>
                </div>
                <PrimaryButton OnClick="RunReview" Disabled="@CannotRun">
                    @if (_running) { <span>Running…</span> } else { <span>Run Quality Review</span> }
                </PrimaryButton>
            </div>
        }
    </div>

    <!-- ── Results ───────────────────────────────────────────────────────── -->
    @if (_report is not null)
    {
        <div style="display:flex;justify-content:flex-end;gap:.5rem;margin-bottom:0.25rem">
            <button style="background:#1d4ed8;color:#fff;border:none;padding:.35rem .85rem;border-radius:5px;cursor:pointer;font-size:.78rem" @onclick="ExportHtml">Export HTML</button>
            @if (_diagnosticSnapshot is not null)
            {
                <button style="background:#10b981;color:#fff;border:none;padding:.35rem .85rem;border-radius:5px;cursor:pointer;font-size:.78rem" @onclick="ExportJson">Export diagnostic JSON</button>
            }
        </div>

        <!-- ── Overall summary ────────────────────────────────────────── -->
        <section class="qr-review-summary" aria-labelledby="qr-summary-title">
            <div class="qr-summary-heading" id="qr-summary-title">Quality Review Summary</div>
            <div class="qr-readiness-summary">
                @if (DeliveryReadinessResult is { } delivery)
                {
                    <div class="qr-readiness-state">
                        <span class="qr-readiness-label">Release:</span>
                        <strong class="qr-readiness-value is-@DrStateChip(delivery.ReleaseDecision.State)">@DrStateLabel(delivery.ReleaseDecision.State)</strong>
                    </div>
                    <div class="qr-gate-issues">@delivery.Blockers.Count delivery gate issue@(delivery.Blockers.Count != 1 ? "s" : "")</div>
                }
                else
                {
                    <div class="qr-readiness-state">
                        <strong class="qr-readiness-value is-unassessed">Readiness not assessed</strong>
                    </div>
                }
            </div>
            <div class="qr-score-context">
                <div><span class="qr-score-context-label">Selected-pack average:</span> <strong>@_report.OverallScore.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%</strong></div>
                <div class="qr-score-interpretation">Score interpretation: @ScoreLabel(_report.OverallScore)</div>
                <div class="qr-findings-context">
                    @_report.TotalFindings finding@(_report.TotalFindings != 1 ? "s" : "") across
                    @_report.PackResults.Count(r => r.Error is null) completed pack@(_report.PackResults.Count(r => r.Error is null) != 1 ? "s" : "")
                </div>
            </div>
            <div class="qr-severity-summary" aria-label="Top finding severities">
                <div class="qr-severity-heading">Severity</div>
                <div class="qr-severity-signals">
                    <div class="qr-severity-signal is-critical"><strong>@_report.CriticalCount</strong> Critical</div>
                    <div class="qr-severity-signal is-high"><strong>@_report.HighCount</strong> High</div>
                </div>
            </div>
        </section>

        <!-- ── By review pack summary cards ───────────────────────────── -->
        @if (_report.PackResults.Count > 0)
        {
            <div class="qr-pack-cards-section">
                <div class="qr-pack-cards-title">By Review Pack</div>
                <div class="qr-pack-cards">
                    @foreach (var result in _report.PackResults)
                    {
                        var cardClass   = result.Error is not null ? "is-error" : ScoreVariant(result.Score);
                        var totalF      = result.Critical + result.High + result.Medium + result.Low;
                        var hSev        = result.Critical > 0 ? "Critical"
                                        : result.High > 0     ? "High"
                                        : result.Medium > 0   ? "Medium"
                                        : result.Low > 0      ? "Low" : "None";
                        var cardExpanded = _expanded.Contains(result.PackId);

                        <button class="qr-pack-card @cardClass"
                                @onclick="() => ExpandPackFromCard(result.PackId)"
                                type="button"
                                aria-label="Open @result.PackName details"
                                aria-expanded="@(cardExpanded ? "true" : "false")"
                                aria-controls="qr-pack-details-@result.PackId">
                            <div class="qr-pack-card-header">
                                <div class="qr-pack-card-name">@result.PackName</div>
                            </div>
                            @if (result.Error is not null)
                            {
                                <div class="qr-pack-card-error-state">Could not run</div>
                                <div class="qr-pack-card-error">@result.Error</div>
                                <div class="qr-pack-card-affordance">View details →</div>
                            }
                            else if (result.DeliveryReadiness is { } deliveryReadiness)
                            {
                                <div class="qr-pack-card-release-state">
                                    <span>Release:</span>
                                    <strong class="is-@DrStateChip(deliveryReadiness.ReleaseDecision.State)">@DrStateLabel(deliveryReadiness.ReleaseDecision.State).ToUpperInvariant()</strong>
                                </div>
                                <div class="qr-pack-card-gate-issues">
                                    @(deliveryReadiness.Blockers.Count == 0
                                        ? "No delivery gate issues"
                                        : $"{deliveryReadiness.Blockers.Count} delivery gate issue{(deliveryReadiness.Blockers.Count != 1 ? "s" : "")}")
                                </div>
                                <div class="qr-pack-card-score"><span>Readiness score</span> @result.Score.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%</div>
                                <div class="qr-pack-card-affordance">View gates →</div>
                            }
                            else
                            {
                                <div class="qr-pack-card-decision">
                                    @if (totalF == 0)
                                    {
                                        <span class="qr-pack-card-ok">No issues</span>
                                    }
                                    else
                                    {
                                        <span class="qr-pack-card-severity is-@hSev.ToLowerInvariant()">@hSev.ToUpperInvariant()</span>
                                    }
                                </div>
                                @if (totalF > 0)
                                {
                                    <div class="qr-pack-card-metadata">@totalF finding@(totalF != 1 ? "s" : "")</div>
                                }
                                <div class="qr-pack-card-score"><span>Pack score</span> @result.Score.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%</div>
                                <div class="qr-pack-card-affordance">View details →</div>
                            }
                        </button>
                    }
                </div>
            </div>
        }

        <!-- ── Top Issues ─────────────────────────────────────────────── -->
        @if (_topIssues.Count > 0)
        {
            <div class="qr-top-issues">
                <div class="qr-top-issues-title">@(_topIssueTotalCount > 5 ? "Top 5 Issues" : "Top Issues")</div>
                @foreach (var issue in _topIssues)
                {
                    var issueExpanded = _expanded.Contains(issue.PrimaryPackId);
                    <button class="qr-issue-card"
                            @onclick="() => ExpandPackFromCard(issue.PrimaryPackId)"
                            type="button"
                            aria-expanded="@(issueExpanded ? "true" : "false")"
                            aria-controls="qr-pack-details-@issue.PrimaryPackId">
                        <div class="qr-issue-severity" data-severity="@issue.Severity.ToLowerInvariant()">@issue.Severity.ToUpper()</div>
                        <div class="qr-issue-content">
                            <div class="qr-issue-title">@IssueIdentity(issue)</div>
                            @if (issue.MissingArtifacts.Count > 0)
                            {
                                <div class="qr-issue-problem"><strong>Missing coverage:</strong> @string.Join(" · ", issue.MissingArtifacts)</div>
                            }
                            else if (!string.IsNullOrWhiteSpace(issue.Description))
                            {
                                <div class="qr-issue-problem"><strong>Problem:</strong> @issue.Description</div>
                            }
                            @if (ShouldRenderFix(issue))
                            {
                                <div class="qr-issue-fix">Fix: @issue.Fix</div>
                            }
                            <div class="qr-issue-sources">
                                <strong>Sources:</strong> @string.Join(" · ", issue.SourcePacks)
                            </div>
                            <div class="qr-issue-affordance">View details →</div>
                        </div>
                    </button>
                }
            </div>
        }

        <!-- ── Per-pack expandable result sections ─────────────────────── -->
        <div class="qr-results">
            @foreach (var result in _report.PackResults)
            {
                var expanded = _expanded.Contains(result.PackId);
                <div class="qr-result-section" id="qr-pack-details-@result.PackId">
                    <button class="qr-result-header" @onclick="() => ToggleSection(result.PackId)">
                        <span class="qr-result-name">@result.PackName</span>
                        <span class="qr-result-meta">
                            @if (result.Error is null)
                            {
                                <span class="qr-result-score @ScoreVariant(result.Score)">@((int)Math.Round(result.Score))%</span>
                                @if (result.Critical + result.High + result.Medium + result.Low > 0)
                                {
                                    <span class="qr-result-findings">@(result.Critical + result.High + result.Medium + result.Low) finding@((result.Critical + result.High + result.Medium + result.Low) != 1 ? "s" : "")</span>
                                }
                                else
                                {
                                    <span class="qr-result-ok">✓ No issues</span>
                                }
                            }
                            else
                            {
                                <span class="qr-result-error-badge">Error</span>
                            }
                        </span>
                        <span class="qr-result-toggle" aria-hidden="true">@(expanded ? "▾" : "▸")</span>
                    </button>

                    @if (expanded)
                    {
                        <div class="qr-result-body">
                            @if (result.Error is not null)
                            {
                                <div class="qr-pack-error">@result.Error</div>
                            }
                            else if (result.QaAudit is not null)
                            {
                                @RenderQaSection(result.QaAudit)
                            }
                            else if (result.Compliance is not null)
                            {
                                @RenderComplianceSection(result.Compliance)
                            }
                            else if (result.Standards is not null)
                            {
                                @RenderStandardsSection(result.Standards)
                            }
                            else if (result.QaReadiness is not null)
                            {
                                @RenderQaReadinessSection(result.QaReadiness)
                            }
                            else if (result.DeliveryReadiness is not null)
                            {
                                @RenderDeliveryReadinessSection(result.DeliveryReadiness)
                            }
                            else if (result.DataModel is not null)
                            {
                                @RenderDataModelSection(result.DataModel)
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
        else if (!_inputExpanded)
        {
            <EmptyState Icon="📋" Title="No review run yet." Description="Expand the panel above to load artifacts and run a review." />
        }
    }

</div>

@code {
    private string _constitutionText = string.Empty;
    private string _specText         = string.Empty;
    private string _planText         = string.Empty;
    private string _taskText         = string.Empty;
    private string _dataModelText    = string.Empty;

    private string? _selectedProject;
    private string? _selectedProjectName;
    private string? _previousProject;

    private readonly HashSet<string> _selectedPacks = [];
    private readonly HashSet<string> _expanded      = [];

    private QualityReviewReport? _report;
    private QualityReviewDiagnosticExport? _diagnosticSnapshot;
    private List<TopIssueItem>   _topIssues = [];
    private int                  _topIssueTotalCount;
    private bool _running;
    private bool _inputExpanded = true;

    private static readonly Dictionary<string, int> _groupOrder = new()
    {
        ["Quality"] = 0, ["Governance"] = 1, ["Standards"] = 2, ["Readiness"] = 3,
    };

    // ── QA Auditor preview state ─────────────────────────────────────────────
    private readonly HashSet<string> _expandedQaAuditorGroups = [];
    private bool _showAllConstitutionFindings;
    private bool _dataModelShowAll;

    // ── QA Readiness detail state ─────────────────────────────────────────────
    private string? _qaExpandedCategory;
    private bool    _qaGapShowAll;
    private bool    _qaRecShowAll;

    // ── Delivery Readiness detail state ───────────────────────────────────────
    private string        _drTab                   = "overview";
    private bool          _drBlockerShowAll        = false;
    private GateSeverity? _drBlockerSeverityFilter;
    private string?       _drBlockerPhaseFilter;
    private string?       _drRecPhaseFilter;
    private string        _drRecSearch             = string.Empty;

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await QrService.InitializeAsync();

            // POLICY: Quality Review loads from selected Sample Project only
            var selected = DocumentResolver.GetSelectedProject();
            if (!string.IsNullOrWhiteSpace(selected))
            {
                await LoadFromSampleProject(selected);
                _previousProject = selected;
            }
            else
            {
                // No Sample Project selected
                _selectedProject = null;
                _selectedProjectName = null;
                ClearAllArtifacts();
            }

            // Check if there's a prior session with selected packs
            if (QualitySession.SelectedPackIds.Count > 0)
            {
                // Use the prior session's pack selections
                _selectedPacks.Clear();
                foreach (var packId in QualitySession.SelectedPackIds)
                {
                    var pack = QrService.AvailablePacks.FirstOrDefault(p => p.PackId == packId);
                    if (pack is not null && IsPackAvailable(pack))
                        _selectedPacks.Add(packId);
                }
            }
            else
            {
                // Apply default selections based on loaded artifacts
                ApplyDefaultPackSelections();
            }

            if (QualitySession.HasResult && IsSessionForCurrentProject())
                RestoreReport(QualitySession.Report!);
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error initializing QualityReview: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            // Detect project changes at runtime
            var currentProject = DocumentResolver.GetSelectedProject();
            if (currentProject != _previousProject)
            {
                _previousProject = currentProject;

                if (!string.IsNullOrWhiteSpace(currentProject))
                {
                    await LoadFromSampleProject(currentProject);
                    // Clear report when project changes
                    _report = null;
                    _diagnosticSnapshot = null;
                    _inputExpanded = true;
                }
                else
                {
                    // Project was deselected
                    _selectedProject = null;
                    _selectedProjectName = null;
                    ClearAllArtifacts();
                    _report = null;
                    _diagnosticSnapshot = null;
                    _inputExpanded = true;
                }
                StateHasChanged();
            }
        }
    }

    private async Task LoadFromSampleProject(string projectSlug)
    {
        // Load all five documents from Sample Project
        var constitution = await DocumentResolver.ResolveAsync(projectSlug, ExplorerDocumentType.Constitution);
        var specification = await DocumentResolver.ResolveAsync(projectSlug, ExplorerDocumentType.Specification);
        var plan = await DocumentResolver.ResolveAsync(projectSlug, ExplorerDocumentType.Plan);
        var tasks = await DocumentResolver.ResolveAsync(projectSlug, ExplorerDocumentType.Tasks);
        var dataModel = await DocumentResolver.ResolveAsync(projectSlug, ExplorerDocumentType.DataModel);

        _constitutionText = constitution.IsSuccess && !string.IsNullOrEmpty(constitution.Content) ? constitution.Content : string.Empty;
        _specText = specification.IsSuccess && !string.IsNullOrEmpty(specification.Content) ? specification.Content : string.Empty;
        _planText = plan.IsSuccess && !string.IsNullOrEmpty(plan.Content) ? plan.Content : string.Empty;
        _taskText = tasks.IsSuccess && !string.IsNullOrEmpty(tasks.Content) ? tasks.Content : string.Empty;
        _dataModelText = dataModel.IsSuccess && !string.IsNullOrEmpty(dataModel.Content) ? dataModel.Content : string.Empty;

        _selectedProject = projectSlug;
        await UpdateSelectedProjectName();
        ApplyDefaultPackSelections();
    }

    private async Task UpdateSelectedProjectName()
    {
        if (string.IsNullOrWhiteSpace(_selectedProject))
        {
            _selectedProjectName = null;
            return;
        }

        var projects = await DocumentResolver.GetAvailableProjectsAsync();
        var project = projects.FirstOrDefault(p => p.Slug == _selectedProject);
        _selectedProjectName = project?.Name ?? _selectedProject;
    }

    private void ClearAllArtifacts()
    {
        _constitutionText = string.Empty;
        _specText = string.Empty;
        _planText = string.Empty;
        _taskText = string.Empty;
        _dataModelText = string.Empty;
    }

    // ── Derived helpers ───────────────────────────────────────────────────────

    private bool AnyArtifactLoaded =>
        !string.IsNullOrWhiteSpace(_constitutionText) ||
        !string.IsNullOrWhiteSpace(_specText)         ||
        !string.IsNullOrWhiteSpace(_planText)         ||
        !string.IsNullOrWhiteSpace(_taskText)         ||
        !string.IsNullOrWhiteSpace(_dataModelText);

    private bool CannotRun => _running || _selectedPacks.Count == 0 || !AnyArtifactLoaded || string.IsNullOrWhiteSpace(_selectedProject);

    private DeliveryReadinessReport? DeliveryReadinessResult => _report?.PackResults
        .Select(r => r.DeliveryReadiness)
        .FirstOrDefault(r => r is not null);

    private string RunSummaryText
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_selectedProject)) return "Select a Sample Project to run a review";
            if (!AnyArtifactLoaded) return "Sample Project is missing required artifacts";
            if (_selectedPacks.Count == 0) return "Select at least one review pack";
            int loaded = new[] { _constitutionText, _specText, _planText, _taskText, _dataModelText }
                            .Count(t => !string.IsNullOrWhiteSpace(t));
            return $"{loaded} artifact{(loaded != 1 ? "s" : "")} available · {_selectedPacks.Count} pack{(_selectedPacks.Count != 1 ? "s" : "")} selected";
        }
    }

    private bool IsPackAvailable(QualityReviewPackDescriptor pack) =>
        pack.PackId switch
        {
            "qa-auditor" => HasSpec || HasPlan || HasTasks,
            "constitution-compliance" => HasConstitution,
            "data-model-quality" => HasDataModel,
            "wcag-2.2" => HasSpec, // TODO: Add FrontendTargetUrl support when available
            "owasp-asvs" => HasSpec, // TODO: Add API/Frontend target support when available
            "gdpr" => HasSpec || HasDataModel,
            "iso-25010" => HasSpec || HasPlan,
            "qa-readiness" => HasSpec || HasTasks,
            "delivery-readiness" => HasPlan || HasTasks,
            _ => true, // Default to available if pack ID not recognized
        };

    private string? GetPackRequirementText(QualityReviewPackDescriptor pack) =>
        pack.PackId switch
        {
            "qa-auditor" => "Requires specification, plan, or tasks",
            "constitution-compliance" => "Requires constitution.md",
            "data-model-quality" => "Requires data-model.md",
            "wcag-2.2" => "Requires specification",
            "owasp-asvs" => "Requires specification",
            "gdpr" => "Requires specification or data model",
            "iso-25010" => "Requires specification or plan",
            "qa-readiness" => "Requires specification or tasks",
            "delivery-readiness" => "Requires plan or tasks",
            _ => null,
        };

    private HashSet<string> GetDefaultSelectedPacks()
    {
        var defaultPacks = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var pack in QrService.AvailablePacks)
        {
            if (IsPackAvailable(pack))
                defaultPacks.Add(pack.PackId);
        }
        return defaultPacks;
    }

    private void ApplyDefaultPackSelections()
    {
        // Only auto-select if user hasn't manually customized selections
        // We determine this by checking if packs are still in their default state
        var availablePacks = GetDefaultSelectedPacks();

        // Remove selections for now-unavailable packs
        var unavailablePacks = _selectedPacks.Where(id => !availablePacks.Contains(id)).ToList();
        foreach (var id in unavailablePacks)
            _selectedPacks.Remove(id);

        // Add selections for newly-available packs if they were defaults
        foreach (var pack in QrService.AvailablePacks)
        {
            if (pack.IsDefault && IsPackAvailable(pack) && !_selectedPacks.Contains(pack.PackId))
                _selectedPacks.Add(pack.PackId);
        }
    }

    private string? PackPrerequisiteWarning(QualityReviewPackDescriptor pack) =>
        pack.PackId == "constitution-compliance" && string.IsNullOrWhiteSpace(_constitutionText)
            ? "Requires constitution"
        : pack.PackGroup == "Standards" && string.IsNullOrWhiteSpace(_specText)
            ? "Requires specification"
        : pack.PackId == "qa-readiness" && string.IsNullOrWhiteSpace(_specText)
            ? "Requires specification"
        : pack.PackId == "delivery-readiness" && !AnyArtifactLoaded
            ? "Requires artifacts"
        : pack.PackId == "data-model-quality" && string.IsNullOrWhiteSpace(_dataModelText)
            ? "Requires data-model.md"
        : null;

