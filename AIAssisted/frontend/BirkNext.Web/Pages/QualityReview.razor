    private async Task<QualityReviewDiagnosticExport> BuildDiagnosticExportAsync(QualityReviewReport report, IEnumerable<string> selectedPackIds)
    {
        var projects = await DocumentResolver.GetAvailableProjectsAsync();
        var projectName = projects.FirstOrDefault(p => p.Slug == _selectedProject)?.Name ?? _selectedProject ?? string.Empty;

        var artifacts = new List<ArtifactInputDiagnostic>
        {
            ArtifactInputDiagnostic.FromContent("Constitution", "constitution.md", _constitutionText),
            ArtifactInputDiagnostic.FromContent("Specification", "spec.md", _specText),
            ArtifactInputDiagnostic.FromContent("Plan", "plan.md", _planText),
            ArtifactInputDiagnostic.FromContent("Tasks", "tasks.md", _taskText),
            ArtifactInputDiagnostic.FromContent("DataModel", "data-model.md", _dataModelText),
        };

        var packs = report.PackResults.Select(r => PackDiagnostic.FromPackResult(r)).ToList();

        return new QualityReviewDiagnosticExport
        {
            SchemaVersion = 1,
            ProjectSlug = _selectedProject ?? string.Empty,
            ProjectDisplayName = projectName,
            RunAtUtc = report.RunAt.UtcDateTime,
            SelectedPackIds = selectedPackIds.ToList(),
            Artifacts = artifacts,
            Packs = packs,
            OverallScore = report.OverallScore,
            TotalFindings = report.TotalFindings,
            CriticalCount = report.CriticalCount,
            HighCount = report.HighCount,
            MediumCount = report.MediumCount,
            LowCount = report.LowCount,
        };
    }

    private async Task RunReview()
    {
        if (CannotRun) return;
        _running = true;
        try
        {
            var artifactSnapshot = BuildArtifactSnapshot();
            var selectedPackIds = _selectedPacks.ToArray();
            QualitySession.MarkRunning(selectedPackIds, _selectedProject ?? string.Empty, artifactSnapshot);

            _report = await QrService.RunAsync(
                string.IsNullOrWhiteSpace(_constitutionText) ? null : _constitutionText,
                string.IsNullOrWhiteSpace(_specText)         ? null : _specText,
                string.IsNullOrWhiteSpace(_planText)         ? null : _planText,
                string.IsNullOrWhiteSpace(_taskText)         ? null : _taskText,
                string.IsNullOrWhiteSpace(_dataModelText)    ? null : _dataModelText,
                selectedPackIds);

            QualitySession.SaveResult(_report, selectedPackIds, _selectedProject ?? string.Empty, artifactSnapshot);

            // Capture diagnostic snapshot from the exact run
            _diagnosticSnapshot = await BuildDiagnosticExportAsync(_report, selectedPackIds);

            // Publish pack results so Dashboard can consume the shared quality session.
            var complianceResult = _report.PackResults.FirstOrDefault(r => r.Compliance is not null);
            if (complianceResult?.Compliance is not null)
                DashboardSnapshot.Publish(complianceResult.Compliance);

            var auditResult = _report.PackResults.FirstOrDefault(r => r.QaAudit is not null);
            if (auditResult?.QaAudit is not null)
                DashboardSnapshot.Publish(auditResult.QaAudit);

            var qaResult = _report.PackResults.FirstOrDefault(r => r.QaReadiness is not null);
            if (qaResult?.QaReadiness is not null)
                DashboardSnapshot.Publish(qaResult.QaReadiness);

            var drResult = _report.PackResults.FirstOrDefault(r => r.DeliveryReadiness is not null);
            if (drResult?.DeliveryReadiness is not null)
                DashboardSnapshot.Publish(drResult.DeliveryReadiness);

            _topIssues     = GetTopIssues(5);
            _inputExpanded = false;
            _expanded.Clear();
            // Don't auto-expand packs - let user click to expand via pack cards
            // foreach (var r in _report.PackResults)
            //     _expanded.Add(r.PackId);

            // Reset all preview state.
            _expandedQaAuditorGroups.Clear();
            _showAllConstitutionFindings = false;
            _dataModelShowAll            = false;
            _qaGapShowAll                = false;
            _qaRecShowAll                = false;

            // Reset readiness detail state.
            _qaExpandedCategory      = null;
            _drTab                   = "overview";
            _drBlockerSeverityFilter = null;
            _drBlockerPhaseFilter    = null;
            _drRecPhaseFilter        = null;
            _drRecSearch             = string.Empty;
        }
        catch (Exception ex)
        {
            QualitySession.MarkFailed(_selectedPacks, _selectedProject ?? string.Empty, BuildArtifactSnapshot(), ex.Message);
            _diagnosticSnapshot = null;
            throw;
        }
        finally
        {
            _running = false;
        }
    }

