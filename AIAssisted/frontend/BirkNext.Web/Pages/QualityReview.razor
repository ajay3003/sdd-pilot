    // ── Compliance gap presentation ────────────────────────────────────────────

    private string FormatComplianceGapTitle(string ruleId, string? ruleTitle)
    {
        if (string.IsNullOrEmpty(ruleTitle) || ruleTitle == ruleId)
            return ruleId;
        return $"{ruleId} — {ruleTitle}";
    }

    private string FormattedComplianceGapType(ConstitutionRuleType ruleType) =>
        ruleType.ToString() switch
        {
            "Principle" => "Principle",
            "Standard" => "Standard",
            "Constraint" => "Constraint",
            _ => ruleType.ToString(),
        };

    private string FormatComplianceGapDescription(ComplianceGap gap)
    {
        var missing = new List<string>();
        if (gap.MissingInSpec) missing.Add("Specification");
        if (gap.MissingInPlan) missing.Add("Plan");
        if (gap.MissingInTasks) missing.Add("Tasks");

        if (missing.Count == 0)
            return "No coverage gaps identified.";

        var formatted = missing.Count switch
        {
            1 => missing[0],
            2 => $"{missing[0]} and {missing[1]}",
            _ => $"{string.Join(", ", missing.SkipLast(1))} and {missing.Last()}"
        };

        return $"Missing coverage in {formatted}.";
    }

    private string FormatComplianceGapFix(ComplianceGap gap)
    {
        var missing = new List<string>();
        if (gap.MissingInSpec) missing.Add("Specification");
        if (gap.MissingInPlan) missing.Add("Plan");
        if (gap.MissingInTasks) missing.Add("Tasks");

        if (missing.Count == 0)
            return "All artifacts have coverage.";

        var formatted = missing.Count switch
        {
            1 => missing[0],
            2 => $"{missing[0]} and {missing[1]}",
            _ => $"{string.Join(", ", missing.SkipLast(1))} and {missing.Last()}"
        };

        return $"Add coverage in {formatted}.";
    }

