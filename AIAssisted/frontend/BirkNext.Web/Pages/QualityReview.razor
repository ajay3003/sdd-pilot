                    {
                        <InfoRow Label="Summary" Value="@decision.Summary" />
                    }
                </KeyValueList>
            </ChildContent>
        </Card>
    };

    private RenderFragment DrOverviewTab(DeliveryReadinessReport r) => __builder =>
    {
        <div class="dr-overview-body">
            <div class="metric-strip">
                <MetricCard Value="@r.Health.OverallReadinessScore.ToString("0.#")" Label="Overall Score" Sublabel="/ 100"
                            Variant="@DrStateChip(r.DevelopmentDecision.State)" />
                <MetricCard Value="@r.Blockers.Count(b => b.Severity == GateSeverity.Critical).ToString()" Label="Critical Blockers"
                            Variant="@(r.Blockers.Any(b => b.Severity == GateSeverity.Critical) ? "danger" : null)" />
                <MetricCard Value="@r.Blockers.Count.ToString()" Label="Total Blockers"
                            Variant="@(r.Blockers.Count > 0 ? "warning" : null)" />
                <MetricCard Value="@r.Recommendations.Count.ToString()" Label="Recommendations" />
            </div>
            <div class="dr-check-columns">
                <Card Title="Loaded Artifacts">
                    <KeyValueList>
                        @DrArtifactRow("Constitution", r.HasConstitution)
                        @DrArtifactRow("Specification", r.HasSpecification)
                        @DrArtifactRow("Plan", r.HasPlan)
                        @DrArtifactRow("Tasks", r.HasTasks)
                    </KeyValueList>
                </Card>
            </div>
            @if (r.Blockers.Count > 0)
            {
                <div>
                    <SectionHeader Title="Critical Blockers" />
                    <div class="dr-blocker-cards">
                        @foreach (var b in (_drBlockerShowAll ? r.Blockers : r.Blockers.Take(3)))
                        {
                            @DrBlockerCard(b)
                        }
                    </div>
                    @if (r.Blockers.Count > 3)
                    {
                        var showAllLabel = _drBlockerShowAll ? "Show less" : $"Show all {r.Blockers.Count} blockers";
                        __builder.OpenElement(3000, "button");
                        __builder.AddAttribute(3001, "class", "qr-show-toggle");
                        __builder.AddAttribute(3002, "type", "button");
                        __builder.AddAttribute(3003, "aria-label", showAllLabel);
                        __builder.AddEventPreventDefaultAttribute(3004, "onclick", true);
                        __builder.AddAttribute(3005, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, () => _drBlockerShowAll = !_drBlockerShowAll));
                        __builder.AddContent(3006, showAllLabel);
                        __builder.CloseElement();
                    }
                </div>
            }
        </div>
    };

    private static RenderFragment DrArtifactRow(string name, bool loaded) => __builder =>
    {
        <InfoRow Label="@name">
            <StatusChip Status="@(loaded ? "healthy" : "neutral")" Label="@(loaded ? "Loaded" : "Not loaded")" />
        </InfoRow>
    };

    private RenderFragment DrGateScoreRow(string phase, ReadinessDecision decision) => __builder =>
    {
        var sz  = 36;
        var r2  = (sz - 10) / 2;
        var c   = 2 * Math.PI * r2;
        var off = c * (1.0 - Math.Min(100, Math.Max(0, decision.Score)) / 100.0);
        var svg = "<svg viewBox=\"0 0 36 36\" width=\"36\" height=\"36\">" +
                  "<circle class=\"dr-score-ring-bg\" cx=\"18\" cy=\"18\" r=\"" + r2 + "\" />" +
                  "<circle class=\"dr-score-ring-fill dr-ring-" + DrStateChip(decision.State) + "\" cx=\"18\" cy=\"18\" r=\"" + r2 + "\"" +
                  " stroke-dasharray=\"" + c.ToString("0.00") + "\" stroke-dashoffset=\"" + off.ToString("0.00") + "\" />" +
                  "<text x=\"50%\" y=\"50%\" dominant-baseline=\"middle\" text-anchor=\"middle\" font-size=\"9\" font-weight=\"700\" fill=\"currentColor\">" +
                  ((int)Math.Round(decision.Score)).ToString() + "</text></svg>";

        <div style="display:flex;align-items:center;gap:12px">
            <div style="width:36px;height:36px;flex-shrink:0">@((MarkupString)svg)</div>
            <div>
                <div style="font-size:var(--text-sm);font-weight:600">@phase</div>
                <StatusChip Status="@DrStateChip(decision.State)" Label="@DrStateLabel(decision.State)" />
            </div>
        </div>
    };

    private RenderFragment DrGateTab(DeliveryGate gate) => __builder =>
    {
        var sz  = 72;
        var r2  = (sz - 10) / 2;
        var c   = 2 * Math.PI * r2;
        var off = c * (1.0 - Math.Min(100, Math.Max(0, gate.Score)) / 100.0);
        var svg = "<svg viewBox=\"0 0 " + sz + " " + sz + "\" width=\"" + sz + "\" height=\"" + sz + "\">" +
                  "<circle class=\"dr-score-ring-bg\" cx=\"" + (sz/2) + "\" cy=\"" + (sz/2) + "\" r=\"" + r2 + "\" />" +
                  "<circle class=\"dr-score-ring-fill dr-ring-" + DrStateChip(gate.State) + "\" cx=\"" + (sz/2) + "\" cy=\"" + (sz/2) + "\" r=\"" + r2 + "\"" +
                  " stroke-dasharray=\"" + c.ToString("0.00") + "\" stroke-dashoffset=\"" + off.ToString("0.00") + "\" />" +
                  "<text x=\"50%\" y=\"50%\" dominant-baseline=\"middle\" text-anchor=\"middle\" font-size=\"18\" font-weight=\"700\" fill=\"currentColor\">" +
                  ((int)Math.Round(gate.Score)).ToString() + "</text></svg>";

        <div class="dr-gate-header">
            <div class="dr-gate-score-area">@((MarkupString)svg)</div>
            <div class="dr-gate-info">
                <h3>@gate.Phase Readiness Gate</h3>
                <StatusChip Status="@DrStateChip(gate.State)" Label="@($"{DrStateIcon(gate.State)} {DrStateLabel(gate.State)}")" />
                <div class="dr-gate-meta">
                    @gate.PassedChecks.Count passed · @gate.FailedChecks.Count failed
                    @if (gate.Blockers.Count > 0) { <span> · @gate.Blockers.Count blocker(s)</span> }
                </div>
            </div>
        </div>
        <div class="dr-check-columns">
            <div class="dr-check-section is-passed">
                <div class="dr-check-section-title">Passed Checks (@gate.PassedChecks.Count)</div>
                @if (gate.PassedChecks.Count == 0)
                { <div class="dr-hint-text">No checks passed yet.</div> }
                else
                {
                    <ul class="dr-check-list">
                        @foreach (var ch in gate.PassedChecks)
                        { <li class="dr-check-item is-passed"><span class="dr-check-item-icon">✓</span><span>@ch</span></li> }
                    </ul>
                }
            </div>
            <div class="dr-check-section is-failed">
                <div class="dr-check-section-title">Failed Checks (@gate.FailedChecks.Count)</div>
                @if (gate.FailedChecks.Count == 0)
                { <div class="dr-hint-text">All checks passed.</div> }
                else
                {
                    <ul class="dr-check-list">
                        @foreach (var ch in gate.FailedChecks)
                        { <li class="dr-check-item is-failed"><span class="dr-check-item-icon">✗</span><span>@ch</span></li> }
                    </ul>
                }
            </div>
        </div>
        @if (gate.Blockers.Count > 0)
        {
            <SectionHeader Title="Gate Blockers" />
            <div class="issue-cards">
                @foreach (var b in gate.Blockers)
                {
                    <IssueCard Severity="@DrSevCard(b.Severity)"
                               Component="@($"{b.Phase}{(b.RuleCode is not null ? $" [{b.RuleCode}]" : "")}")"
                               Description="@b.Title"
                               SuggestedFix="@(string.IsNullOrEmpty(b.Description) ? null : b.Description)" />
                }
            </div>
        }
    };

