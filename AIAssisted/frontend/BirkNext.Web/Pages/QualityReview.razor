    private record TopIssueItem(string LogicalId, string RuleCode, string Title, string Description, string Severity, int SortKey, List<string> SourcePacks, string PrimaryPackId, IReadOnlyList<string> MissingArtifacts, string? Fix = null);

    private record ConstitutionRuleMetadata(string RuleId, string RuleTitle, string RuleType, List<string> MissingArtifacts);

    private record TopIssueSource(string PackName, string PackId, string Title, string? Description, string? Fix);

    private static int SeveritySortKey(string sev) => sev.ToLowerInvariant() switch
    {
        "critical"          => 0,
        "high" or "error"   => 1,
        "medium" or "warning" => 2,
        _                   => 3,
    };

    private static string ViolSevToCard(ViolationSeverity sev) => sev switch
    {
        ViolationSeverity.Critical => "critical",
        ViolationSeverity.High     => "error",
        ViolationSeverity.Medium   => "warning",
        _                          => "info",
    };

    private List<TopIssueItem> GetTopIssues(int limit = 5)
    {
        if (_report is null) return [];

        // Build canonical Constitution metadata lookup from Compliance report
        var constitutionMetadata = BuildConstitutionMetadataLookup();

        // Collect all findings with their source packs and severity info
        var allIssues = new List<(string LogicalId, string RuleCode, string Title, string Description, string Severity, int SortKey, string PackName, string PackId)>();

        foreach (var r in _report.PackResults.Where(r => r.Error is null))
        {
            if (r.QaAudit is not null)
                foreach (var f in r.QaAudit.Findings)
                {
                    var sev = QaSevString(f.Severity);
                    // For Constitution coverage findings, use affected rule ID for deduplication
                    var logicalId = GetQaFindingLogicalId(f, constitutionMetadata);
                    var enrichedTitle = EnrichQaFindingTitle(f, constitutionMetadata);
                    allIssues.Add((logicalId, f.RuleCode ?? f.Title, enrichedTitle, f.Description, sev, SeveritySortKey(sev), r.PackName, r.PackId));
                }
            if (r.Compliance is not null)
            {
                foreach (var v in r.Compliance.Violations)
                {
                    var sev = ViolSevToCard(v.Severity);
                    var logicalId = GetComplianceLogicalId(v.RuleId);
                    allIssues.Add((logicalId, v.RuleId, v.RuleTitle, v.Issue, sev, SeveritySortKey(sev), r.PackName, r.PackId));
                }
                foreach (var g in r.Compliance.Gaps)
                {
                    var sev = ViolSevToCard(g.Severity);
                    var logicalId = GetComplianceLogicalId(g.RuleId);
                    var gapDesc = BuildGapDescription(g);
                    var fix = BuildGapFix(g);
                    // Store gap for potential fix enrichment during aggregation
                    allIssues.Add((logicalId, g.RuleId, g.RuleTitle, gapDesc, sev, SeveritySortKey(sev), r.PackName, r.PackId));
                }
            }
            if (r.Standards is not null)
                foreach (var s in r.Standards.Results.Where(s => s.Status == CheckStatus.Failed))
                {
                    var sev = StdSevString(s.Severity);
                    var logicalId = $"SEMANTIC:{s.Title}";
                    allIssues.Add((logicalId, s.Title, s.Title, s.Recommendation ?? "", sev, SeveritySortKey(sev), r.PackName, r.PackId));
                }
            if (r.QaReadiness is not null)
                foreach (var g in r.QaReadiness.Gaps)
                {
                    var sev = ViolSevToCard(g.Severity);
                    var logicalId = $"SEMANTIC:{g.Description}";
                    allIssues.Add((logicalId, g.Description, g.Description, "", sev, SeveritySortKey(sev), r.PackName, r.PackId));
                }
            if (r.DeliveryReadiness is not null)
                foreach (var b in r.DeliveryReadiness.Blockers)
                {
                    var sev = DrSevCard(b.Severity);
                    var logicalId = $"SEMANTIC:{b.Title}";
                    allIssues.Add((logicalId, b.Title, b.Title, b.Description ?? "", sev, SeveritySortKey(sev), r.PackName, r.PackId));
                }
        }

        // Group by logical ID and aggregate
        var grouped = allIssues.GroupBy(i => i.LogicalId, StringComparer.OrdinalIgnoreCase);
        var aggregated = new List<(string LogicalId, string RuleCode, string Title, string Description, string Severity, int SortKey, List<string> SourcePacks, string PrimaryPackId, IReadOnlyList<string> MissingArtifacts, string? Fix)>();

        foreach (var group in grouped)
        {
            var issues = group.ToList();

            // Keep highest severity
            var maxSortKey = issues.Min(i => i.SortKey);
            var maxSeverity = issues.First(i => i.SortKey == maxSortKey).Severity;

            // Canonical title (prefer Constitution Compliance title if available)
            var complianceIssue = issues.FirstOrDefault(i => i.PackName.Contains("Compliance", StringComparison.OrdinalIgnoreCase));
            var title = complianceIssue != default ? complianceIssue.Title : issues.First().Title;

            // Get unique source packs in stable order
            var sourcePacks = issues.Select(i => i.PackName).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(p => p).ToList();

            // Determine primary pack ID (prefer Constitution Compliance)
            var primaryPackId = DeterminePrimaryPackId(sourcePacks, issues);

            // Build actionable fix for Constitution coverage issues
            var fix = BuildAggregatedFix(group.Key, issues, constitutionMetadata);

            // Rule code - prefer non-detector codes for Constitution coverage
            var ruleCode = ExtractCanonicalRuleCode(issues);

            // Get description from first non-empty entry, but clear for Constitution coverage if we have a better fix
            var description = issues.FirstOrDefault(i => !string.IsNullOrEmpty(i.Description)).Description ?? "";
            if (group.Key.StartsWith("CONSTITUTION-COVERAGE:", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrEmpty(fix))
            {
                description = "";
            }

            var missingArtifacts = GetMissingArtifacts(group.Key, constitutionMetadata);
            aggregated.Add((group.Key, ruleCode, title, description, maxSeverity, maxSortKey, sourcePacks, primaryPackId, missingArtifacts, fix));
        }

        // Sort by severity then keep unique logical issues up to limit
        _topIssueTotalCount = aggregated.Count;
        var sorted = aggregated.OrderBy(a => a.SortKey).Take(limit).ToList();

        var result = sorted
            .Select(a => new TopIssueItem(a.LogicalId, a.RuleCode, a.Title, a.Description, a.Severity, a.SortKey, a.SourcePacks, a.PrimaryPackId, a.MissingArtifacts, a.Fix))
            .ToList();

        return result;
    }

    private string GetQaFindingLogicalId(QaFinding f, Dictionary<string, ConstitutionRuleMetadata> metadata)
    {
        // For Constitution coverage findings (CONST-00x), use affected rule as logical ID
        if (f.RuleCode?.StartsWith("CONST-") == true && !string.IsNullOrEmpty(f.AffectedArtifact))
        {
            var normalizedRuleId = f.AffectedArtifact.ToUpperInvariant().Trim();
            return $"CONSTITUTION-COVERAGE:{normalizedRuleId}";
        }

        // Handle synthetic test pattern: QA finding with RuleCode=PP-02 directly (matches Constitution rule format)
        if (!string.IsNullOrEmpty(f.RuleCode) && IsConstitutionRuleFormat(f.RuleCode) && f.Category == QaCategory.Constitution)
        {
            var normalizedRuleId = f.RuleCode.ToUpperInvariant().Trim();
            return $"CONSTITUTION-COVERAGE:{normalizedRuleId}";
        }

        // Default fallback
        return string.IsNullOrEmpty(f.RuleCode) ? $"SEMANTIC:{f.Title}" : f.RuleCode;
    }

    private bool IsConstitutionRuleFormat(string ruleCode)
    {
        // Check if RuleCode looks like a Constitution rule (PP-02, PRINCIPLE-001, etc.)
        return ruleCode.StartsWith("PP-") || ruleCode.StartsWith("PRINCIPLE-") ||
               ruleCode.StartsWith("STD-") || ruleCode.StartsWith("CON-");
    }

    private string GetComplianceLogicalId(string ruleId)
    {
        var normalizedRuleId = ruleId.ToUpperInvariant().Trim();
        return $"CONSTITUTION-COVERAGE:{normalizedRuleId}";
    }

    private string EnrichQaFindingTitle(QaFinding f, Dictionary<string, ConstitutionRuleMetadata> metadata)
    {
        // For Constitution coverage findings (CONST-001 pattern), include the affected rule and its title if available
        if (f.RuleCode?.StartsWith("CONST-") == true && !string.IsNullOrEmpty(f.AffectedArtifact))
        {
            var affectedRule = f.AffectedArtifact.Trim();
            var normalizedKey = affectedRule.ToUpperInvariant();

            if (metadata.TryGetValue(normalizedKey, out var ruleMetadata))
            {
                return $"{affectedRule} — {ruleMetadata.RuleTitle}";
            }
            return affectedRule;
        }

        // Handle synthetic test pattern: RuleCode=PP-02 directly
        if (!string.IsNullOrEmpty(f.RuleCode) && IsConstitutionRuleFormat(f.RuleCode) && f.Category == QaCategory.Constitution)
        {
            var normalizedKey = f.RuleCode.ToUpperInvariant();
            if (metadata.TryGetValue(normalizedKey, out var ruleMetadata))
            {
                return $"{f.RuleCode} — {ruleMetadata.RuleTitle}";
            }
        }

        return f.Title;
    }

    private Dictionary<string, ConstitutionRuleMetadata> BuildConstitutionMetadataLookup()
    {
        var lookup = new Dictionary<string, ConstitutionRuleMetadata>(StringComparer.OrdinalIgnoreCase);

        foreach (var r in _report?.PackResults ?? [])
        {
            if (r.Compliance?.Results != null)
            {
                foreach (var result in r.Compliance.Results)
                {
                    var key = result.RuleId.ToUpperInvariant();
                    if (!lookup.ContainsKey(key))
                    {
                        var missing = new List<string>();
                        if (!result.HasSpecCoverage) missing.Add("Specification");
                        if (!result.HasPlanCoverage) missing.Add("Plan");
                        if (!result.HasTaskCoverage) missing.Add("Tasks");

                        lookup[key] = new ConstitutionRuleMetadata(
                            result.RuleId,
                            result.RuleTitle,
                            result.RuleType.ToString(),
                            missing
                        );
                    }
                }
            }

            if (r.Compliance?.Gaps != null)
            {
                foreach (var gap in r.Compliance.Gaps)
                {
                    var key = gap.RuleId.ToUpperInvariant();
                    var missing = GetMissingArtifacts(gap);
                    if (!lookup.TryGetValue(key, out var existing))
                    {
                        lookup[key] = new ConstitutionRuleMetadata(gap.RuleId, gap.RuleTitle, gap.RuleType.ToString(), missing);
                    }
                    else if (missing.Count > 0)
                    {
                        lookup[key] = existing with { MissingArtifacts = missing };
                    }
                }
            }
        }
        return lookup;
    }

    private static List<string> GetMissingArtifacts(ComplianceGap gap)
    {
        var missing = new List<string>();
        if (gap.MissingInSpec) missing.Add("Specification");
        if (gap.MissingInPlan) missing.Add("Plan");
        if (gap.MissingInTasks) missing.Add("Tasks");
        return missing;
    }

    private static IReadOnlyList<string> GetMissingArtifacts(string logicalId, Dictionary<string, ConstitutionRuleMetadata> metadata)
    {
        const string prefix = "CONSTITUTION-COVERAGE:";
        if (!logicalId.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)) return [];

        var ruleId = logicalId[prefix.Length..];
        return metadata.TryGetValue(ruleId, out var ruleMetadata)
            ? ruleMetadata.MissingArtifacts
            : [];
    }

    private static string IssueIdentity(TopIssueItem issue)
    {
        var title = issue.Title.Trim();
        if (string.Equals(issue.RuleCode, title, StringComparison.OrdinalIgnoreCase)) return issue.RuleCode;

        var prefixedTitle = $"{issue.RuleCode} — ";
        if (title.StartsWith(prefixedTitle, StringComparison.OrdinalIgnoreCase))
            title = title[prefixedTitle.Length..].Trim();

        return string.IsNullOrWhiteSpace(title) ? issue.RuleCode : $"{issue.RuleCode} — {title}";
    }

    private static bool ShouldRenderFix(TopIssueItem issue) =>
        !string.IsNullOrWhiteSpace(issue.Fix) &&
        !string.Equals(NormalizeIssueText(issue.Fix), NormalizeIssueText(issue.Description), StringComparison.OrdinalIgnoreCase);

    private static string NormalizeIssueText(string? value) =>
        string.Concat((value ?? string.Empty).Where(char.IsLetterOrDigit));

    private string BuildGapFix(ComplianceGap g)
    {
        var missing = GetMissingArtifacts(g);

        if (missing.Count == 0) return "";

        return missing.Count switch
        {
            1 => $"Add coverage in {missing[0]}.",
            2 => $"Add coverage in {missing[0]} and {missing[1]}.",
            _ => $"Add coverage in {string.Join(", ", missing.SkipLast(1))} and {missing.Last()}."
        };
    }

    private string? BuildAggregatedFix(string logicalId, List<(string LogicalId, string RuleCode, string Title, string Description, string Severity, int SortKey, string PackName, string PackId)> issues, Dictionary<string, ConstitutionRuleMetadata> metadata)
    {
        // For Constitution coverage issues, build actionable fix
        if (logicalId.StartsWith("CONSTITUTION-COVERAGE:", StringComparison.OrdinalIgnoreCase))
        {
            var ruleId = logicalId.Substring("CONSTITUTION-COVERAGE:".Length);
            if (metadata.TryGetValue(ruleId, out var ruleMetadata) && ruleMetadata.MissingArtifacts.Count > 0)
            {
                var missing = ruleMetadata.MissingArtifacts;
                return missing.Count switch
                {
                    1 => $"Add coverage in {missing[0]}.",
                    2 => $"Add coverage in {missing[0]} and {missing[1]}.",
                    _ => $"Add coverage in {string.Join(", ", missing.SkipLast(1))} and {missing.Last()}."
                };
            }
        }

        // For other findings, use the first non-empty description as the fix
        var description = issues.FirstOrDefault(i => !string.IsNullOrEmpty(i.Description)).Description;
        return string.IsNullOrEmpty(description) ? null : description;
    }

    private string ExtractCanonicalRuleCode(List<(string LogicalId, string RuleCode, string Title, string Description, string Severity, int SortKey, string PackName, string PackId)> issues)
    {
        // For Constitution coverage, prefer the actual rule ID (PP-02) over detector ID (CONST-001)
        var complianceIssue = issues.FirstOrDefault(i => !i.RuleCode.StartsWith("CONST-"));
        if (!string.IsNullOrEmpty(complianceIssue.RuleCode))
            return complianceIssue.RuleCode;

        // Otherwise use first available rule code
        return issues.First().RuleCode;
    }

    private string DeterminePrimaryPackId(List<string> sourcePacks, List<(string LogicalId, string RuleCode, string Title, string Description, string Severity, int SortKey, string PackName, string PackId)> allIssues)
    {
        // Prefer Constitution Compliance for Constitution rules
        if (sourcePacks.Contains("Constitution Compliance", StringComparer.OrdinalIgnoreCase))
            return allIssues.First(i => i.PackName.Equals("Constitution Compliance", StringComparison.OrdinalIgnoreCase)).PackId;

        // Otherwise use first pack's ID
        return allIssues.First().PackId;
    }

    private static string BuildGapDescription(ComplianceGap g)
    {
        var missing = new List<string>();
        if (g.MissingInSpec) missing.Add("Specification");
        if (g.MissingInPlan) missing.Add("Plan");
        if (g.MissingInTasks) missing.Add("Tasks");
        return missing.Count > 0 ? $"Missing coverage in {string.Join(", ", missing)}." : "Coverage gap";
    }

