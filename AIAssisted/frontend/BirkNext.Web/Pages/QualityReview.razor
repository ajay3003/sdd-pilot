                __builder.AddAttribute(2001, "class", "qr-show-toggle");
                __builder.AddAttribute(2002, "type", "button");
                __builder.AddAttribute(2003, "aria-label", recAriaLabel);
                __builder.AddEventPreventDefaultAttribute(2004, "onclick", true);
                __builder.AddAttribute(2005, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, () => _qaRecShowAll = !_qaRecShowAll));
