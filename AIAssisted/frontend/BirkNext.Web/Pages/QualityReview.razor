@page "/quality-review"
@using BirkNext.Web.Components
@using BirkNext.Web.Models
@using BirkNext.Web.Models.QualityReview
@using BirkNext.Web.Services
@inject IQualityReviewPageModelService PageModelService
@inject IWorkspaceSessionService Workspace
@inject IReportExportService ExportService
@inject IJSRuntime JS

<PageTitle>Quality Review</PageTitle>

<div class="qr-page">
    <PageHeader Title="@(PageModel?.Title ?? "Quality Review")"
                Description="@(PageModel?.Description ?? "Run one or more deterministic quality, compliance, and readiness reviews in a single execution.")" />

    <!-- ── Readiness Panel ────────────────────────────────────────── -->
    @if (PageModel is not null)
    {
        <QualityReviewReadinessPanel Model="PageModel" />
    }
    else if (IsLoading)
    {
        <div class="qr-loading" role="status">Loading page configuration...</div>
    }
    else if (LoadError is not null)
    {
        <div class="qr-error" role="alert">@LoadError</div>
    }

    <!-- ── Artifact Upload Section ─────────────────────────────── -->
    <div class="qr-input-panel">
        <div class="qr-input-panel-header">
            <span class="qr-input-panel-title"><span class="qr-step-badge">1</span> Load Artifacts</span>
            <button class="qr-input-panel-toggle" @onclick="() => _inputExpanded = !_inputExpanded">
                @(_inputExpanded ? "▾ Collapse" : "▸ Expand")
            </button>
        </div>

        @if (_inputExpanded && PageModel is not null)
        {
            <div class="qr-artifact-grid">
                <!-- Specification Card -->
                <div class="artifact-card @(!string.IsNullOrEmpty(_specificationText) ? "is-loaded" : "")">
                    <div class="artifact-card-header">
                        <span class="artifact-icon" aria-hidden="true">📋</span>
                        <span class="artifact-name">Specification</span>
                        <span class="artifact-status @(!string.IsNullOrEmpty(_specificationText) ? "is-loaded" : "")">
                            @(!string.IsNullOrEmpty(_specificationText) ? "Loaded" : "Empty")
                        </span>
                    </div>
                    <SpecificationImport @ref="_specImport"
                        InputId="qr-spec-import"
                        OnFileImported="t => OnArtifactLoaded(t, WorkspaceArtifactKind.Specification)"
                        OnFileRemoved="() => OnArtifactRemoved(WorkspaceArtifactKind.Specification)"
                        IsDisabled="false" />
                    <textarea class="artifact-textarea" placeholder="Or paste spec.md here…"
                              rows="3" @bind:get="_specificationText"
                              @bind:set="async v => await OnArtifactTextChanged(v, WorkspaceArtifactKind.Specification)"
                              @bind:event="oninput"></textarea>
                    @if (!string.IsNullOrEmpty(_specificationText))
                    {
                        <div class="artifact-footer">
                            <span>@_specificationText.Split('\n').Length lines</span>
                            <button class="artifact-clear" @onclick='() => OnArtifactRemoved(WorkspaceArtifactKind.Specification)'>Clear</button>
                        </div>
                    }
                </div>

                <!-- Plan Card -->
                <div class="artifact-card @(!string.IsNullOrEmpty(_planText) ? "is-loaded" : "")">
                    <div class="artifact-card-header">
                        <span class="artifact-icon" aria-hidden="true">📐</span>
                        <span class="artifact-name">Plan</span>
                        <span class="artifact-status @(!string.IsNullOrEmpty(_planText) ? "is-loaded" : "")">
                            @(!string.IsNullOrEmpty(_planText) ? "Loaded" : "Empty")
                        </span>
                    </div>
                    <SpecificationImport @ref="_planImport"
                        InputId="qr-plan-import"
                        OnFileImported="t => OnArtifactLoaded(t, WorkspaceArtifactKind.Plan)"
                        OnFileRemoved="() => OnArtifactRemoved(WorkspaceArtifactKind.Plan)"
                        IsDisabled="false" />
                    <textarea class="artifact-textarea" placeholder="Or paste plan.md here…"
                              rows="3" @bind:get="_planText"
                              @bind:set="async v => await OnArtifactTextChanged(v, WorkspaceArtifactKind.Plan)"
                              @bind:event="oninput"></textarea>
                    @if (!string.IsNullOrEmpty(_planText))
                    {
                        <div class="artifact-footer">
                            <span>@_planText.Split('\n').Length lines</span>
                            <button class="artifact-clear" @onclick='() => OnArtifactRemoved(WorkspaceArtifactKind.Plan)'>Clear</button>
                        </div>
                    }
                </div>

                <!-- Constitution Card -->
                <div class="artifact-card @(!string.IsNullOrEmpty(_constitutionText) ? "is-loaded" : "")">
                    <div class="artifact-card-header">
                        <span class="artifact-icon" aria-hidden="true">📜</span>
                        <span class="artifact-name">Constitution</span>
                        <span class="artifact-status @(!string.IsNullOrEmpty(_constitutionText) ? "is-loaded" : "")">
                            @(!string.IsNullOrEmpty(_constitutionText) ? "Loaded" : "Empty")
                        </span>
                    </div>
                    <SpecificationImport @ref="_constitutionImport"
                        InputId="qr-constitution-import"
                        OnFileImported="t => OnArtifactLoaded(t, WorkspaceArtifactKind.Constitution)"
                        OnFileRemoved="() => OnArtifactRemoved(WorkspaceArtifactKind.Constitution)"
                        IsDisabled="false" />
                    <textarea class="artifact-textarea" placeholder="Or paste constitution.md here…"
                              rows="3" @bind:get="_constitutionText"
                              @bind:set="async v => await OnArtifactTextChanged(v, WorkspaceArtifactKind.Constitution)"
                              @bind:event="oninput"></textarea>
                    @if (!string.IsNullOrEmpty(_constitutionText))
                    {
                        <div class="artifact-footer">
                            <span>@_constitutionText.Split('\n').Length lines</span>
                            <button class="artifact-clear" @onclick='() => OnArtifactRemoved(WorkspaceArtifactKind.Constitution)'>Clear</button>
                        </div>
                    }
                </div>

                <!-- Data Model Card -->
                <div class="artifact-card @(!string.IsNullOrEmpty(_dataModelText) ? "is-loaded" : "")">
                    <div class="artifact-card-header">
                        <span class="artifact-icon" aria-hidden="true">🗄️</span>
                        <span class="artifact-name">Data Model</span>
                        <span class="artifact-status @(!string.IsNullOrEmpty(_dataModelText) ? "is-loaded" : "")">
                            @(!string.IsNullOrEmpty(_dataModelText) ? "Loaded" : "Empty")
                        </span>
                    </div>
                    <SpecificationImport @ref="_dataModelImport"
                        InputId="qr-datamodel-import"
                        OnFileImported="t => OnArtifactLoaded(t, WorkspaceArtifactKind.DataModel)"
                        OnFileRemoved="() => OnArtifactRemoved(WorkspaceArtifactKind.DataModel)"
                        IsDisabled="false" />
                    <textarea class="artifact-textarea" placeholder="Or paste data-model.md here…"
                              rows="3" @bind:get="_dataModelText"
                              @bind:set="async v => await OnArtifactTextChanged(v, WorkspaceArtifactKind.DataModel)"
                              @bind:event="oninput"></textarea>
                    @if (!string.IsNullOrEmpty(_dataModelText))
                    {
                        <div class="artifact-footer">
                            <span>@_dataModelText.Split('\n').Length lines</span>
                            <button class="artifact-clear" @onclick='() => OnArtifactRemoved(WorkspaceArtifactKind.DataModel)'>Clear</button>
                        </div>
                    }
                </div>

                <!-- Tasks Card -->
                <div class="artifact-card @(!string.IsNullOrEmpty(_tasksText) ? "is-loaded" : "")">
                    <div class="artifact-card-header">
                        <span class="artifact-icon" aria-hidden="true">✅</span>
                        <span class="artifact-name">Tasks</span>
                        <span class="artifact-status @(!string.IsNullOrEmpty(_tasksText) ? "is-loaded" : "")">
                            @(!string.IsNullOrEmpty(_tasksText) ? "Loaded" : "Empty")
                        </span>
                    </div>
                    <SpecificationImport @ref="_tasksImport"
                        InputId="qr-tasks-import"
                        OnFileImported="t => OnArtifactLoaded(t, WorkspaceArtifactKind.Tasks)"
                        OnFileRemoved="() => OnArtifactRemoved(WorkspaceArtifactKind.Tasks)"
                        IsDisabled="false" />
                    <textarea class="artifact-textarea" placeholder="Or paste tasks.md here…"
                              rows="3" @bind:get="_tasksText"
                              @bind:set="async v => await OnArtifactTextChanged(v, WorkspaceArtifactKind.Tasks)"
                              @bind:event="oninput"></textarea>
                    @if (!string.IsNullOrEmpty(_tasksText))
                    {
                        <div class="artifact-footer">
                            <span>@_tasksText.Split('\n').Length lines</span>
                            <button class="artifact-clear" @onclick='() => OnArtifactRemoved(WorkspaceArtifactKind.Tasks)'>Clear</button>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- ── Run Button ───────────────────────────────────────────── -->
    @if (PageModel is not null)
    {
        <div class="qr-actions">
            <button class="btn-primary" disabled="@(!PageModel.Summary.CanRun)" @onclick="RunAudit">
                @if (IsRunning)
                {
                    <span class="spinner" aria-hidden="true">⟳</span>
                }
                @(IsRunning ? "Running…" : "Run Quality Review")
            </button>
        </div>
    }
</div>

@code {
    private QualityReviewPageModel? PageModel;
    private bool IsLoading = true;
    private string? LoadError;
    private bool IsRunning;
    private bool _inputExpanded;

    // Artifact state - read from workspace on init
    private string _specificationText = string.Empty;
    private string _planText = string.Empty;
    private string _constitutionText = string.Empty;
    private string _dataModelText = string.Empty;
    private string _tasksText = string.Empty;

    private SpecificationImport? _specImport;
    private SpecificationImport? _planImport;
    private SpecificationImport? _constitutionImport;
    private SpecificationImport? _dataModelImport;
    private SpecificationImport? _tasksImport;

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to workspace changes
        Workspace.ReviewContextRebuildNeeded += (s, e) => _ = RefreshPageModel();

        // Load initial artifact state
        _specificationText = Workspace.Get(WorkspaceArtifactKind.Specification)?.Text ?? string.Empty;
        _planText = Workspace.Get(WorkspaceArtifactKind.Plan)?.Text ?? string.Empty;
        _constitutionText = Workspace.Get(WorkspaceArtifactKind.Constitution)?.Text ?? string.Empty;
        _dataModelText = Workspace.Get(WorkspaceArtifactKind.DataModel)?.Text ?? string.Empty;
        _tasksText = Workspace.Get(WorkspaceArtifactKind.Tasks)?.Text ?? string.Empty;

        // Load page model
        await RefreshPageModel();
    }

    private async Task RefreshPageModel()
    {
        try
        {
            IsLoading = true;
            LoadError = null;
            PageModel = await PageModelService.GetQualityReviewModelAsync();

            if (PageModel is null)
            {
                LoadError = "Failed to load page configuration";
            }
        }
        catch (Exception ex)
        {
            LoadError = $"Error loading configuration: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task OnArtifactLoaded(string text, WorkspaceArtifactKind kind)
    {
        // Write to workspace
        Workspace.Set(kind, text);

        // Update local state
        UpdateLocalState(kind, text);

        // Notify system of change
        Workspace.NotifyArtifactsChanged();

        // Refresh page model
        await RefreshPageModel();
    }

    private async Task OnArtifactRemoved(WorkspaceArtifactKind kind)
    {
        // Clear from workspace
        Workspace.Clear(kind);

        // Update local state
        UpdateLocalState(kind, string.Empty);

        // Reset import component
        ResetImportComponent(kind);

        // Notify system of change
        Workspace.NotifyArtifactsChanged();

        // Refresh page model
        await RefreshPageModel();
    }

    private async Task OnArtifactTextChanged(string text, WorkspaceArtifactKind kind)
    {
        // Update local state
        UpdateLocalState(kind, text);

        // Update workspace
        if (!string.IsNullOrEmpty(text))
        {
            Workspace.Set(kind, text);
        }
        else
        {
            Workspace.Clear(kind);
        }

        // Notify system of change
        Workspace.NotifyArtifactsChanged();

        // Refresh page model
        await RefreshPageModel();
    }

    private void UpdateLocalState(WorkspaceArtifactKind kind, string text)
    {
        switch (kind)
        {
            case WorkspaceArtifactKind.Specification:
                _specificationText = text;
                break;
            case WorkspaceArtifactKind.Plan:
                _planText = text;
                break;
            case WorkspaceArtifactKind.Constitution:
                _constitutionText = text;
                break;
            case WorkspaceArtifactKind.DataModel:
                _dataModelText = text;
                break;
            case WorkspaceArtifactKind.Tasks:
                _tasksText = text;
                break;
        }
    }

    private void ResetImportComponent(WorkspaceArtifactKind kind)
    {
        switch (kind)
        {
            case WorkspaceArtifactKind.Specification:
                _specImport?.Reset();
                break;
            case WorkspaceArtifactKind.Plan:
                _planImport?.Reset();
                break;
            case WorkspaceArtifactKind.Constitution:
                _constitutionImport?.Reset();
                break;
            case WorkspaceArtifactKind.DataModel:
                _dataModelImport?.Reset();
                break;
            case WorkspaceArtifactKind.Tasks:
                _tasksImport?.Reset();
                break;
        }
    }

    private async Task RunAudit()
    {
        if (PageModel?.Summary.CanRun != true)
            return;

        IsRunning = true;
        try
        {
            // Call the actual quality review service
            // (This would use IQualityReviewService to run the audit)
            // For now, this is a placeholder
            await Task.Delay(1000); // Simulate work
        }
        finally
        {
            IsRunning = false;
        }
    }

}
