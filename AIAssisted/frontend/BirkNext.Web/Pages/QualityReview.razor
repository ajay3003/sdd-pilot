    private RenderFragment RenderQaSection(QaAuditReport report) => __builder =>
    {
        if (report.Findings.Count == 0)
        {
            __builder.OpenComponent<EmptyState>(0);
            __builder.AddAttribute(1, "Icon", "✓");
            __builder.AddAttribute(2, "Title", "No findings detected.");
            __builder.CloseComponent();
            return;
        }

        // Build canonical Constitution metadata for enriching Constitution findings
        var constitutionMetadata = BuildConstitutionMetadataForPresentation();

        int seq = 0;
        foreach (var grp in report.Findings.GroupBy(f => f.Category).OrderBy(g => g.Key))
        {
            var groupKey = grp.Key.ToString();
            __builder.OpenElement(seq++, "div");
            __builder.AddAttribute(seq++, "class", "qr-cat-section");
            __builder.OpenElement(seq++, "div");
            __builder.AddAttribute(seq++, "class", "qr-cat-title");
            var count = grp.Count();
            var categoryLabel = $"{grp.Key} ({count})";
            __builder.AddContent(seq++, categoryLabel);
            __builder.CloseElement();

            var groupKeyCopy = groupKey;
            var isExpanded = _expandedQaAuditorGroups.Contains(groupKeyCopy);
            var findings = grp.OrderBy(f => f.Severity).ToList();

            __builder.OpenComponent<QaFindingPreviewList>(seq++);
            __builder.AddAttribute(seq++, "Items", findings);
            __builder.AddAttribute(seq++, "PreviewLimit", 5);
            __builder.AddAttribute(seq++, "ShowAll", isExpanded);
            __builder.AddAttribute(seq++, "OnShowAllChanged", EventCallback.Factory.Create<bool>(this, (val) => ToggleQaAuditorGroup(groupKeyCopy)));
            __builder.AddAttribute(seq++, "ContextLabel", $"{groupKey.ToLower()} findings");
            // Pass canonical Constitution metadata for Constitution findings
            if (grp.Key == QaCategory.Constitution && constitutionMetadata.Count > 0)
            {
                __builder.AddAttribute(seq++, "CanonicalMetadata", constitutionMetadata);
            }
            __builder.CloseComponent();

            __builder.CloseElement();
        }
    };

    private Dictionary<string, ConstitutionRulePresentationMetadata> BuildConstitutionMetadataForPresentation()
    {
        var lookup = new Dictionary<string, ConstitutionRulePresentationMetadata>(StringComparer.OrdinalIgnoreCase);

        foreach (var r in _report?.PackResults ?? [])
        {
            if (r.Compliance?.Results != null)
            {
                foreach (var result in r.Compliance.Results)
                {
                    var key = result.RuleId.ToUpperInvariant();
                    if (!lookup.ContainsKey(key))
                    {
                        lookup[key] = new ConstitutionRulePresentationMetadata(result.RuleTitle, result.RuleType.ToString());
                    }
                }
            }
        }
        return lookup;
    }

    private RenderFragment RenderComplianceSection(ConstitutionComplianceReport report) => __builder =>
    {
        if (report.Violations.Count == 0 && report.Gaps.Count == 0)
        {
            __builder.OpenComponent<EmptyState>(0);
            __builder.AddAttribute(1, "Icon", "✓");
            __builder.AddAttribute(2, "Title", "No violations or coverage gaps detected.");
            __builder.CloseComponent();
            return;
        }

        var allFindings = new List<object>();
        allFindings.AddRange(report.Violations.Cast<object>());
        allFindings.AddRange(report.Gaps.Cast<object>());
        var totalCount = allFindings.Count;
        var previewLimit = 5;
        var visibleCount = _showAllConstitutionFindings ? totalCount : previewLimit;

        int seq = 0;
        int renderedCount = 0;

        if (report.Violations.Count > 0)
        {
            __builder.OpenElement(seq++, "div");
            __builder.AddAttribute(seq++, "class", "qr-cat-title");
            __builder.AddContent(seq++, $"Violations ({report.Violations.Count})");
            __builder.CloseElement();
            foreach (var v in report.Violations)
            {
                if (renderedCount >= visibleCount) break;
                __builder.OpenComponent<IssueCard>(seq++);
                __builder.AddAttribute(seq++, "Severity", v.Severity.ToString());
                __builder.AddAttribute(seq++, "Component", $"{v.RuleId} · {v.Artifact}");
                __builder.AddAttribute(seq++, "Description", $"{v.RuleTitle} — {v.Issue}");
                __builder.CloseComponent();
                renderedCount++;
            }
        }

        if (report.Gaps.Count > 0 && renderedCount < visibleCount)
        {
            __builder.OpenElement(seq++, "div");
            __builder.AddAttribute(seq++, "class", "qr-cat-title");
            __builder.AddContent(seq++, $"Coverage Gaps ({report.Gaps.Count})");
            __builder.CloseElement();
            foreach (var gap in report.Gaps)
            {
                if (renderedCount >= visibleCount) break;
                __builder.OpenComponent<IssueCard>(seq++);
                __builder.AddAttribute(seq++, "Severity", gap.Severity.ToString());
                __builder.AddAttribute(seq++, "Component", FormatComplianceGapTitle(gap.RuleId, gap.RuleTitle));
                var fullDescription = FormattedComplianceGapType(gap.RuleType) + "\n" + FormatComplianceGapDescription(gap);
                __builder.AddAttribute(seq++, "Description", fullDescription);
                __builder.AddAttribute(seq++, "SuggestedFix", FormatComplianceGapFix(gap));
                __builder.CloseComponent();
                renderedCount++;
            }
        }

        if (totalCount > previewLimit)
        {
            __builder.OpenElement(seq++, "button");
            __builder.AddAttribute(seq++, "class", "qr-show-toggle");
            __builder.AddAttribute(seq++, "type", "button");
            __builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => _showAllConstitutionFindings = !_showAllConstitutionFindings));
            if (_showAllConstitutionFindings)
                __builder.AddAttribute(seq++, "aria-label", "Show fewer Constitution findings");
            else
                __builder.AddAttribute(seq++, "aria-label", $"Show all {totalCount} Constitution findings");
            __builder.AddContent(seq++, _showAllConstitutionFindings ? "Show less" : $"Show all {totalCount}");
            __builder.CloseElement();
        }
    };

