@page "/pipeline-review"
@using BirkNext.PipelineReview
@using BirkNext.SourceArchitecture
@using BirkNext.Web.Models
@using P = BirkNext.Web.Services.PipelineReviewPresentation
@using D = BirkNext.Web.Services.PipelineReviewDashboard
@using BirkNext.Web.Shared.Components.Common
@inject IPipelineReviewApiService Api
@inject IFrontendAnalysisContextFactory ContextFactory
@inject IReportExportService ExportService
@inject IJSRuntime JS

<PageTitle>Pipeline Review</PageTitle>

<div class="sd-workspace pr-page prv" data-testid="pr-page" aria-busy="@(_loaded ? "false" : "true")">
    <header class="prv-header">
        <div class="prv-header-text">
            <h1 class="pr-title">Pipeline Review</h1>
            <p class="prv-lead">Understand how changes move through build, test, validation and deployment — read from the pipeline definitions in Source Analysis.</p>
        </div>
        @if (_loaded)
        {
            var headerStatus = D.PageStatus(_result, Selected);
            <div class="prv-header-status">
                <span data-testid="pr-status">@Pill(headerStatus, "Pipeline Review")</span>
                @if (_result is { State: D.Reviewed } reviewed)
                {
                    @foreach (var provider in D.Providers(reviewed)) { <span class="prv-provider" data-testid="pr-provider"><span class="visually-hidden">Pipeline provider: </span>@provider</span> }
                }
            </div>
        }
    </header>

    @if (!_loaded)
    {
        <div class="prv-skeleton" role="status" aria-label="Loading Pipeline Review">
            <span></span><span></span><span></span>
        </div>
    }
    else if (_profile is null)
    {
        <div class="prv-empty" data-testid="pr-no-target">
            <span class="prv-empty-icon" aria-hidden="true">⌁</span>
            <div><h2>No Target Environment selected</h2><p>Select a Target Environment to review the pipelines of its Source Analysis snapshots.</p></div>
        </div>
    }
    else if (!_sources.SourceAnalysisEnabled)
    {
        <div class="prv-empty" data-testid="pr-source-disabled">
            <span class="prv-empty-icon" aria-hidden="true">⌁</span>
            <div><h2>Source Analysis is turned off</h2><p>Source Analysis is disabled in Feature Visibility, so pipeline source cannot be selected. Pipeline Review reads pipeline definitions from Source Analysis snapshots.</p></div>
        </div>
    }
    else if (_sources.Snapshots.Count == 0)
    {
        <div class="prv-empty" data-testid="pr-source-required">
            <span class="prv-empty-icon" aria-hidden="true">⌁</span>
            <div>
                <h2>Pipeline source required</h2>
                <p>Pipeline Review reads the pipeline definitions (YAML) in a Source Analysis snapshot. Analyze the repository that contains your pipelines first.</p>
                <p class="prv-actions"><a class="btn-primary" href="source-analysis" data-testid="pr-open-source-analysis">Open Source Analysis</a> <a class="btn-secondary" href="technology-coverage">Technology Coverage</a></p>
            </div>
        </div>
    }
    else
    {
        var source = Selected;
        var status = D.PageStatus(_result, source);
        <ul class="prv-bar" aria-label="Pipeline Review summary" data-testid="pr-summary-bar">
            <li><span class="prv-bar-label">Provider</span> <strong>@(_result is { State: D.Reviewed } rv && D.Providers(rv).Count > 0 ? string.Join(", ", D.Providers(rv)) : "—")</strong></li>
            <li><span class="prv-bar-label">CI/CD evidence</span> @if (source is not null) { @Pill(D.EvidenceStatus(source), null) }</li>
            <li><span class="prv-bar-label">Source Analysis</span> @Pill(D.SourceStatus(source?.Status), null)</li>
            <li><span class="prv-bar-label">Metadata</span> @Pill(D.MetadataStatus(_metadata, _result?.Metadata), null)</li>
        </ul>

        @if (_result is { State: D.NeedsRefresh } stale && source is not null)
        {
            <section class="prv-callout prv-callout-caution" data-testid="pr-state" data-state="@stale.State" aria-labelledby="pr-state-h">
                <span class="prv-callout-icon" aria-hidden="true">⚠</span>
                <div class="prv-callout-body">
                    <h2 id="pr-state-h">CI/CD evidence needs refresh</h2>
                    <p>This source snapshot was analyzed before the current CI/CD evidence model was available, so its pipelines cannot be reviewed yet. It is not a pipeline problem.</p>
                    <p class="prv-callout-meta" data-testid="pr-evidence-versions"><span>Current: <strong>@(source.CiCdAnalyzerVersion <= 0 ? "none" : $"v{source.CiCdAnalyzerVersion}")</strong></span><span>Required: <strong>v@(PipelineReviewText.RequiredCiCdVersion)</strong></span></p>
                    <p class="prv-actions">
                        <a class="btn-primary" href="source-analysis" data-testid="pr-reanalyze">Re-analyze in Source Analysis</a>
                        <span class="prv-hint">Analyze @D.SourceName(source) again to produce CI/CD evidence v@(PipelineReviewText.RequiredCiCdVersion); this page refreshes when you return.</span>
                    </p>
                </div>
            </section>
        }
        else if (status.Tone == CapabilityTone.Danger)
        {
            <section class="prv-callout prv-callout-danger" data-testid="pr-state" data-state="FailedAnalysis" aria-labelledby="pr-state-h">
                <span class="prv-callout-icon" aria-hidden="true">✕</span>
                <div class="prv-callout-body"><h2 id="pr-state-h">Pipeline analysis failed</h2><p>@(_result?.StateReason is { Length: > 0 } reason ? reason : "Source Analysis could not read the pipeline definitions in this snapshot.")</p>
                    <p class="prv-actions"><a class="btn-secondary" href="source-analysis">Open Source Analysis</a></p></div>
            </section>
        }
        else if (_result is { State: D.NoPipelines } none)
        {
            <section class="prv-callout prv-callout-neutral" data-testid="pr-state" data-state="@none.State" aria-labelledby="pr-state-h">
                <span class="prv-callout-icon" aria-hidden="true">⌁</span>
                <div class="prv-callout-body">
                    <h2 id="pr-state-h">@(status.Label == "Unsupported" ? "Pipeline detected, provider not supported" : "No pipeline definition detected")</h2>
                    <p>@none.StateReason</p>
                    <ul class="prv-causes"><li>No supported pipeline files in this snapshot (pipelines may live in another repository).</li><li>The pipeline technology is not supported — a tool limitation, not a quality failure.</li></ul>
                    <p class="prv-actions"><a class="btn-secondary" href="source-analysis">Open Source Analysis</a> <a class="btn-secondary" href="technology-coverage">Technology Coverage</a></p>
                </div>
            </section>
        }

        <div class="prv-context">
            <section class="prv-card prv-card-source" aria-labelledby="pr-source-h" data-testid="pr-source-card">
                <h2 id="pr-source-h" class="prv-card-title"><span class="prv-icon" aria-hidden="true">⧉</span>Source</h2>
                @if (source is not null)
                {
                    <p class="prv-source-name" data-testid="pr-source-name">@D.SourceName(source)</p>
                    <dl class="prv-facts">
                        <div><dt>Snapshot</dt><dd>@P.Utc(source.AnalyzedAt)</dd></div>
                        <div><dt>Source Analysis</dt><dd>@Pill(D.SourceStatus(source.Status), "Source Analysis")</dd></div>
                        <div><dt>CI/CD evidence</dt><dd>@Pill(D.EvidenceStatus(source), "CI/CD evidence")</dd></div>
                    </dl>
                }
                <div class="prv-source-actions" data-testid="pr-scope">
                    <label class="prv-select">Change snapshot
                        <select value="@_snapshotId" @onchange="SelectSnapshot" data-testid="pr-snapshot">
                            @foreach (var s in _sources.Snapshots.OrderByDescending(s => s.AnalyzedAt))
                            {
                                <option value="@s.Id">@D.OptionText(s, s.Id == NewestId)</option>
                            }
                        </select>
                    </label>
                    <a class="btn-secondary" href="source-analysis">Open Source Analysis</a>
                </div>
            </section>

            <section class="prv-card" aria-labelledby="pr-ready-h" data-testid="pr-readiness">
                <h2 id="pr-ready-h" class="prv-card-title"><span class="prv-icon" aria-hidden="true">✓</span>Readiness</h2>
                <ul class="prv-checklist">
                    @foreach (var item in D.Readiness(_result, source, _metadata))
                    {
                        <li data-testid="pr-readiness-item"><span class="prv-check-label">@item.Label</span>@Pill(item.Status, item.Label)@if (item.Detail is { } detail) { <span class="prv-check-detail">@detail</span> }</li>
                    }
                </ul>
                <p class="prv-overall">Overall @Pill(status, "Overall readiness")</p>
            </section>

            <section class="prv-card prv-card-enrich" aria-labelledby="pr-enrich-h" data-testid="pr-enrichment">
                <h2 id="pr-enrich-h" class="prv-card-title"><span class="prv-icon" aria-hidden="true">+</span>Optional enrichment</h2>
                <p class="prv-muted" id="pr-metadata-help">Azure DevOps metadata adds definition names, environments and their checks when configured. The source review works without it.</p>
                <label class="prv-toggle"><input type="checkbox" checked="@_metadata" @onchange="ToggleMetadata" data-testid="pr-metadata" aria-describedby="pr-metadata-help" /> Include Azure DevOps metadata <span class="prv-muted">(read-only)</span></label>
                <p class="prv-enrich-state">Status @Pill(D.MetadataStatus(_metadata, _result?.Metadata), "Azure DevOps metadata")</p>
            </section>
        </div>

        <ul class="prv-cards" aria-label="Pipeline summary" data-testid="pr-summary-cards">
            @foreach (var card in D.Cards(_result, source))
            {
                <li class="prv-tile prv-role-@card.Role" data-testid="pr-summary-card" data-key="@card.Key">
                    <span class="prv-tile-label">@card.Label</span>
                    <span class="prv-tile-value">@card.Value</span>
                    @if (card.Note is { } note) { <span class="prv-tile-note">@note</span> }
                </li>
            }
        </ul>

        @if (_error is not null) { <p class="sd-reason" role="alert" data-testid="pr-error">@_error</p> }
        @if (_result is { State: D.Reviewed } boundary) { <p class="sd-boundary" data-testid="pr-boundary">@boundary.Boundary</p> }

        <div class="prv-tabbar">
            <div class="prv-tabs" role="group" aria-label="Pipeline Review views">
                @foreach (var (key, label) in Tabs)
                {
                    <button class="prv-tab" aria-pressed="@(_tab == key ? "true" : "false")" @onclick="() => ShowTab(key)" data-testid="@($"pr-tab-{key}")">@label</button>
                }
            </div>
            @if (_result is { State: D.Reviewed })
            {
                <button class="btn-secondary" @onclick="Export" data-testid="pr-export">Export HTML</button>
            }
        </div>

        @if (_result is { State: D.Reviewed } r)
        {
            @switch (_tab)
            {
                case "flow": @RenderFlow(r) break;
                case "gaps": @RenderGaps(r) break;
                case "tests": @RenderTests(r) break;
                case "environments": @RenderEnvironments(r) break;
                case "dependencies": @RenderDependencies(r) break;
                case "changes": @RenderChanges(r) break;
                default: @RenderOverview(r) break;
            }
            <details class="pr-details" data-testid="pr-limitations">
                <summary>Limitations and what this review cannot see (@r.Limitations.Count)</summary>
                <ul class="sd-list">@foreach (var l in r.Limitations) { <li>@l</li> }</ul>
                <p class="sd-muted">@r.Metadata.Detail</p>
            </details>
        }
        else
        {
            <section class="prv-placeholder" data-testid="pr-placeholder" data-tab="@_tab" aria-labelledby="pr-placeholder-h">
                <h2 id="pr-placeholder-h">@Tabs.First(t => t.Key == _tab).Label</h2>
                <p>@Placeholder(_tab, _result?.State)</p>
            </section>
        }

        <ReviewDisclosure Text="Technical details" CollapseText="Hide technical details" TestId="pr-technical" Class="prv-technical">
            <dl class="prv-tech">
                @if (source is not null)
                {
                    <div><dt>Snapshot ID</dt><dd><code>@source.Id</code></dd></div>
                    <div><dt>Archive</dt><dd><code>@source.ArchiveName</code></dd></div>
                    <div><dt>Fingerprint</dt><dd><code>@source.Fingerprint</code></dd></div>
                    <div><dt>CI/CD domain status</dt><dd>@(source.CiCdStatus ?? "—")</dd></div>
                }
                <div><dt>Evidence model</dt><dd>@(source is null ? "—" : D.EvidenceLabel(source)) · v@(PipelineReviewText.RequiredCiCdVersion) required</dd></div>
                @if (_result is { } tr)
                {
                    <div><dt>Review state</dt><dd>@tr.State · rules v@(tr.RulesVersion)</dd></div>
                    <div><dt>Metadata</dt><dd>@tr.Metadata.State — @tr.Metadata.Detail</dd></div>
                    @foreach (var p in tr.Pipelines)
                    {
                        <div data-testid="pr-tech-pipeline"><dt>@(p.IsTemplate ? "Template" : "Pipeline file")</dt><dd><code>@p.File</code> · @BirkNext.SourceDomains.SourceDomainText.Label(p.Platform) · <code>@p.Id</code></dd></div>
                    }
                }
            </dl>
        </ReviewDisclosure>
    }
</div>

@code {
    private static readonly (string Key, string Label)[] Tabs =
        [("overview", "Overview"), ("flow", "Flow"), ("gaps", "Gaps"), ("tests", "Tests"), ("environments", "Environments"), ("dependencies", "Dependencies"), ("changes", "Changes")];

    private PipelineReviewSourceOption? Selected => _sources.Snapshots.FirstOrDefault(s => s.Id == _snapshotId);
    private Guid? NewestId => _sources.Snapshots.OrderByDescending(s => s.AnalyzedAt).Select(s => (Guid?)s.Id).FirstOrDefault();

    /// <summary>Status pill: decorative glyph + text; <paramref name="subject"/> prefixes the spoken text ("Pipeline Review status: Needs refresh").</summary>
    private static RenderFragment Pill(CapabilityStatus status, string? subject) => __builder =>
    {
        <span class="sd-pill @status.PillClass prv-pill" data-status="@status.Label">@if (subject is not null) {<span class="visually-hidden">@subject status: </span>}<span class="prv-glyph" aria-hidden="true">@status.Glyph</span> @status.Label</span>
    };

    /// <summary>What each view shows once evidence exists — never invented content.</summary>
    private static string Placeholder(string tab, string? state)
    {
        if (state == D.NoPipelines) return "No pipeline definition was detected in this snapshot, so there is nothing to show here.";
        if (state != D.NeedsRefresh) return "Select a snapshot with pipeline definitions to populate this view.";
        return tab switch
        {
            "flow" => "Refresh the CI/CD evidence in Source Analysis to build the pipeline flow.",
            "gaps" => "Refresh the CI/CD evidence to evaluate pipeline gaps.",
            "tests" => "Refresh the CI/CD evidence to inspect test gates.",
            "environments" => "Refresh the CI/CD evidence to see deployments and environment progression.",
            "dependencies" => "Refresh the CI/CD evidence to see pipeline relationships, templates and path coverage.",
            "changes" => "Refresh the CI/CD evidence to compare pipeline definitions between snapshots.",
            _ => "Refresh the CI/CD evidence in Source Analysis to populate the overview: provider, stages, gates, artifacts and environments.",
        };
    }

    private FrontendAnalysisProfile? _profile;
    private PipelineReviewSourceList _sources = new(true, [], null);
    private Guid? _snapshotId;
    private bool _metadata, _loaded;
    private PipelineReviewResult? _result;
    private string? _error;
    private string _tab = "overview";
    private readonly HashSet<string> _open = new(StringComparer.Ordinal);
    private PipelineFindingCategory? _category;
    private string _probePath = "";
    private PathProbeResult? _probe;
    private bool _probing;
    private Guid? _previousId;
    private PipelineReviewComparison? _comparison;
    private bool _comparing;

    protected override async Task OnInitializedAsync()
    {
        _profile = (await ContextFactory.GetActiveContextAsync()).ActiveProfile;
        if (_profile is not null)
        {
            _sources = await Api.SourcesAsync(_profile.Id);
            _snapshotId = _sources.DefaultSnapshotId ?? _sources.Snapshots.OrderByDescending(s => s.AnalyzedAt).Select(s => (Guid?)s.Id).FirstOrDefault();
            if (_snapshotId is not null) await Load();
        }
        _loaded = true;
    }

    private async Task Load()
    {
        if (_profile is null || _snapshotId is null) return;
        (_result, _error) = await Api.ReviewAsync(_profile.Id, _snapshotId, _metadata);
        _probe = null; _comparison = null; _open.Clear();
        _previousId = _sources.Snapshots.Where(s => s.Id != _snapshotId && s.AnalyzedAt <= (_sources.Snapshots.FirstOrDefault(x => x.Id == _snapshotId)?.AnalyzedAt ?? DateTimeOffset.MaxValue))
            .OrderByDescending(s => s.AnalyzedAt).Select(s => (Guid?)s.Id).FirstOrDefault();
    }

    private async Task SelectSnapshot(ChangeEventArgs e) { if (Guid.TryParse(e.Value?.ToString(), out var id)) { _snapshotId = id; await Load(); } }
    private async Task ToggleMetadata(ChangeEventArgs e) { _metadata = e.Value is true; await Load(); }
    private void ShowTab(string key) => _tab = key;
    private void Toggle(string key) { if (!_open.Remove(key)) _open.Add(key); }
    private bool Open(string key) => _open.Contains(key);

    private async Task Probe()
    {
        if (_profile is null || _snapshotId is null || string.IsNullOrWhiteSpace(_probePath)) return;
        _probing = true;
        try { _probe = await Api.ProbeAsync(_profile.Id, _snapshotId.Value, _probePath.Trim()); }
        finally { _probing = false; }
    }

    private async Task Compare()
    {
        if (_profile is null || _snapshotId is null || _previousId is null) return;
        _comparing = true;
        try { _comparison = await Api.CompareAsync(_profile.Id, _previousId.Value, _snapshotId.Value); }
        finally { _comparing = false; }
    }

    private async Task Export()
    {
        if (_result is null) return;
        await JS.InvokeVoidAsync("downloadHtmlFile", $"pipeline-review-{DateTime.UtcNow:yyyy-MM-dd}.html", ExportService.ExportPipelineReview(_result));
    }

    private string EnvName(PipelineReviewResult r, string deploymentId) => r.Deployments.FirstOrDefault(d => d.Id == deploymentId) is { } d ? Display(d) : deploymentId;
    private static string Display(DeploymentReview d) => d.EnvironmentKind is BirkNext.SourceDomains.SourceEnvironmentKind.Custom or BirkNext.SourceDomains.SourceEnvironmentKind.Default ? d.Environment
        : d.EnvironmentKind switch { BirkNext.SourceDomains.SourceEnvironmentKind.Development => "DEV", BirkNext.SourceDomains.SourceEnvironmentKind.Production => "PROD", BirkNext.SourceDomains.SourceEnvironmentKind.Staging => "STAGING", var k => k.ToString().ToUpperInvariant() };

    private RenderFragment Code(string text) => __builder =>
    {
        foreach (var (segment, code) in P.Segments(text))
        {
            if (code) { <code>@segment</code> } else { @segment }
        }
    };

    private RenderFragment EvidenceButton(string key, string about) => __builder =>
    {
        <button class="sd-link" aria-expanded="@(Open(key) ? "true" : "false")" @onclick="() => Toggle(key)" data-testid="pr-evidence-toggle">@(Open(key) ? "Hide evidence" : "View evidence")<span class="visually-hidden"> for @about</span></button>
    };

    private RenderFragment EvidenceTable(IEnumerable<PipelineEvidenceRef> evidence, string? detail = null) => __builder =>
    {
        <div class="sd-scroll pr-evidence" tabindex="0" role="region" aria-label="Evidence" data-testid="pr-evidence">
            @if (detail is not null) { <p class="sd-muted">@Code(detail)</p> }
            <table>
                <thead><tr><th scope="col">File</th><th scope="col">Stage / job / step</th><th scope="col">Condition</th><th scope="col">Template origin</th><th scope="col">Note</th></tr></thead>
                <tbody>
                    @foreach (var e in evidence)
                    {
                        <tr><td><code class="sd-path">@P.Location(e)</code></td><td>@string.Join(" / ", new[] { e.Stage, e.Job, e.Step }.Where(x => !string.IsNullOrEmpty(x)))</td>
                            <td>@(e.Condition is { } c ? (MarkupString)$"<code>{System.Net.WebUtility.HtmlEncode(c)}</code>" : (MarkupString)"—")</td><td>@(e.TemplateOrigin ?? "—")</td><td>@(e.Note ?? "")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    };

    private RenderFragment RenderFinding(PipelineReviewFinding f) => __builder =>
    {
        <article class="pr-finding" data-testid="pr-finding" data-category="@f.Category" data-severity="@f.Severity">
            <h4>@Code(f.Title)</h4>
            <p class="pr-pills"><span class="@P.SeverityCss(f.Severity)">Severity: @f.Severity</span> <span class="@P.StateCss(f.EvidenceState)">Evidence: @PipelineReviewText.Label(f.EvidenceState)</span> <span class="sd-pill sd-pill-muted">@PipelineReviewText.Label(f.Category)</span>@if (f.Environment is { } env) { <span class="sd-pill sd-pill-muted">@env</span> }</p>
            <p><strong>Why it matters:</strong> @f.WhyItMatters</p>
            <p class="sd-reason">@Code(f.Explanation)</p>
            <p><strong>Suggested review:</strong> @Code(f.SuggestedAction)</p>
            @if (f.Evidence.Count > 0)
            {
                @EvidenceButton($"f:{f.Id}", f.Title)
                @if (Open($"f:{f.Id}")) { @EvidenceTable(f.Evidence) }
            }
        </article>
    };

    private RenderFragment RenderOverview(PipelineReviewResult r) => __builder =>
    {
        var runnable = r.Pipelines.Where(p => !p.IsTemplate).ToList();
        <section class="sd-panel" aria-labelledby="pr-overview-h" data-testid="pr-overview">
            <h2 id="pr-overview-h">@P.Headline(r) <span class="sd-count" data-testid="pr-counts">@P.Counts(r)</span></h2>
            <dl class="sd-summary">
                <div><dt>Pipelines</dt><dd data-testid="pr-pipeline-count">@runnable.Count</dd></div>
                <div><dt>Templates</dt><dd>@r.Pipelines.Count(p => p.IsTemplate)</dd></div>
                <div><dt>Deployments</dt><dd>@r.Deployments.Count</dd></div>
                <div><dt>Environments</dt><dd>@r.Environments.Count</dd></div>
                <div><dt>Unresolved</dt><dd>@(r.UnresolvedTemplates.Count + r.Findings.Count(f => f.EvidenceState == ArchitectureEvidenceState.Unresolved))</dd></div>
            </dl>
            <div class="prv-overview-grid">
                <div>
                    <h3>Triggers</h3>
                    <ul class="prv-chips" data-testid="pr-triggers">
                        @foreach (var (p, t) in runnable.SelectMany(p => p.Triggers.Select(t => (p, t))))
                        {
                            <li class="prv-chip"><span class="prv-chip-kind">@(runnable.Count > 1 ? $"{p.Name}: " : "")@t.Kind</span> @Code(t.Text)</li>
                        }
                        @if (runnable.All(p => p.Triggers.Count == 0)) { <li class="prv-chip prv-chip-muted">No trigger detected (manual)</li> }
                    </ul>
                </div>
                <div>
                    <h3>Artifacts named in definitions</h3>
                    <ul class="prv-chips" data-testid="pr-artifacts">
                        @foreach (var a in runnable.SelectMany(p => p.Artifacts).Distinct(StringComparer.Ordinal)) { <li class="prv-chip prv-chip-artifact"><code>@a</code></li> }
                        @if (!runnable.Any(p => p.Artifacts.Count > 0)) { <li class="prv-chip prv-chip-muted">None detected</li> }
                    </ul>
                    <p class="sd-muted">Named in the definitions; whether they were published in a run needs run evidence.</p>
                </div>
            </div>
            @if (r.DeliveryPath.Count > 0)
            {
                <h3>Apparent delivery path</h3>
                <ol class="pr-path" aria-label="Apparent delivery path" data-testid="pr-path">
                    @foreach (var step in r.DeliveryPath)
                    {
                        <li class="@(step == "⋯" ? "pr-path-gap" : "")">@(step == "⋯" ? "no detected link" : step)</li>
                    }
                </ol>
                <p class="sd-muted">From evidence only. "No detected link" means no dependency, pipeline trigger or artifact relationship connects the two.</p>
            }
            <h3>Needs attention first</h3>
            @if (r.Findings.All(f => f.Severity == PipelineFindingSeverity.Info)) { <p class="sd-muted">No high, medium or low gap detected.</p> }
            <ul class="sd-list" data-testid="pr-top-findings">
                @foreach (var f in r.Findings.Where(f => f.Severity is PipelineFindingSeverity.High or PipelineFindingSeverity.Medium).Take(6))
                {
                    <li><span class="@P.SeverityCss(f.Severity)">@f.Severity</span> @Code(f.Title)</li>
                }
            </ul>
            @if (r.Findings.Count > 0) { <button class="sd-link" @onclick="@(() => ShowTab("gaps"))" data-testid="pr-all-gaps">See all @r.Findings.Count gaps</button> }
            <h3>Test gating by environment</h3>
            @if (r.Environments.Count == 0) { <p class="sd-muted" data-testid="pr-no-environments">No deployment to an environment was detected in these definitions, so no test gates a deployment. Tests still run as defined.</p> }
            <dl class="sd-facts" data-testid="pr-gating-summary">
                @foreach (var env in r.Environments)
                {
                    var deployments = r.Deployments.Where(d => env.Deployments.Contains(d.Id)).ToList();
                    var gating = deployments.SelectMany(d => d.Before).Where(g => g.State is GateState.Gates or GateState.Inherited && g.Category is not (ValidationCategory.Build or ValidationCategory.InfrastructurePlan)).Select(g => PipelineReviewText.Label(g.Category)).Distinct().ToList();
                    var post = deployments.SelectMany(d => d.After).Select(g => PipelineReviewText.Label(g.Category)).Distinct().ToList();
                    <div><dt>@env.Environment</dt><dd>@(gating.Count == 0 ? "No gating test detected" : string.Join(", ", gating))@(post.Count == 0 ? " · no post-deployment validation" : $" · after: {string.Join(", ", post)}")@(deployments.Any(d => d.Before.Any(g => g.State == GateState.Unknown)) ? " · partly not assessable" : "")</dd></div>
                }
            </dl>
        </section>
        <section class="sd-panel" aria-labelledby="pr-probe-h" data-testid="pr-probe">
            <h2 id="pr-probe-h">Will a change here be validated?</h2>
            <div class="sd-filterbar">
                <label>Repository path <input type="search" @bind="_probePath" @bind:event="oninput" placeholder="src/Shop.Common/Money.cs" data-testid="pr-probe-path" /></label>
                <button class="btn-primary" @onclick="Probe" disabled="@(_probing || string.IsNullOrWhiteSpace(_probePath))" data-testid="pr-probe-run">Check</button>
            </div>
            @if (_probe is { } probe)
            {
                <div class="sd-scroll" tabindex="0" role="region" aria-label="Pipelines started by a change" data-testid="pr-probe-result">
                    <table>
                        <caption class="visually-hidden">Pipelines and validations for a change to @probe.Path</caption>
                        <thead><tr><th scope="col">Pipeline</th><th scope="col">A change to <code>@probe.Path</code></th><th scope="col">Then, before each environment</th></tr></thead>
                        <tbody>
                            @foreach (var p in probe.Pipelines)
                            {
                                <tr data-testid="pr-probe-row" data-coverage="@p.Triggers"><th scope="row">@p.PipelineName</th><td>@P.Coverage(p.Triggers)<span class="sd-context">@Code(p.Basis)</span></td>
                                    <td>@if (p.Triggers == TriggerCoverage.No || p.Deployments.Count == 0) { <span class="sd-muted">—</span> }
                                        else { <ul class="sd-list">@foreach (var d in p.Deployments) { <li><strong>@d.Environment</strong>: @(d.Before.Where(g => g.State is GateState.Gates or GateState.Inherited && g.Category is not (ValidationCategory.Build or ValidationCategory.InfrastructurePlan)).Select(g => PipelineReviewText.Label(g.Category)).Distinct() is var list && list.Any() ? string.Join(", ", list) : "no gating test")</li> }</ul> }</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                <ul class="sd-list">@foreach (var n in probe.Notes) { <li>@n</li> }</ul>
            }
        </section>
    };

    private RenderFragment RenderFlow(PipelineReviewResult r) => __builder =>
    {
        <section class="sd-panel" aria-labelledby="pr-flow-h" data-testid="pr-flow">
            <h2 id="pr-flow-h">Delivery flow</h2>
            <p class="sd-muted">Generated from the pipeline definitions. Each statement shows how sure it is; open the evidence to see where it comes from.</p>
            <ol class="pr-story" data-testid="pr-story">
                @foreach (var s in r.Story)
                {
                    <li data-testid="pr-story-step" data-section="@s.Section">
                        <span class="sd-pill sd-pill-muted">@P.Section(s.Section)</span> @Code(s.Text)
                        <span class="@P.StateCss(s.State)">@PipelineReviewText.Label(s.State)</span>
                        @EvidenceButton($"s:{s.Number}", $"step {s.Number}")
                        @if (Open($"s:{s.Number}")) { @EvidenceTable(s.Evidence, s.Detail) }
                    </li>
                }
            </ol>
        </section>
        <section class="sd-panel" aria-labelledby="pr-map-h" data-testid="pr-map">
            <h2 id="pr-map-h">Flow map</h2>
            <p class="sd-muted">Stages in execution order per pipeline. The type comes from what the stage contains (deployments, tests by category, published artifacts) — not from its name; "Other" when nothing classifies it.</p>
            <ul class="prv-legend" aria-label="Stage types">
                @foreach (var t in Enum.GetValues<FlowNodeType>()) { <li class="prv-node-type prv-type-@t.ToString().ToLowerInvariant()">@D.TypeLabel(t)</li> }
            </ul>
            @foreach (var p in r.Pipelines.Where(p => !p.IsTemplate))
            {
                var stages = r.Nodes.Where(n => n.Kind == PipelineNodeKind.Stage && n.PipelineId == p.Id).ToList();
                <div role="group" aria-label="@($"Flow map for {p.Name}")" class="pr-map-group prv-map-group">
                    <h3>@p.Name <span class="sd-context">@p.Role · <code>@p.File</code></span></h3>
                    @if (stages.Count == 0)
                    {
                        var steps = D.Steps(r, p.Id);
                        <p class="sd-muted">Single job (no stages).@(steps.Count > 0 ? " Its validation steps in definition order:" : "")</p>
                        @if (steps.Count > 0)
                        {
                            <ol class="prv-flow" aria-label="@($"Validation steps of {p.Name} in definition order")" data-testid="pr-step-flow">
                                @foreach (var (step, index) in steps.Select((t, i) => (t, i)))
                                {
                                    var type = D.StepType(step.Categories);
                                    <li class="prv-node prv-type-@type.ToString().ToLowerInvariant()" data-testid="pr-flow-node" data-type="@type">
                                        <span class="prv-node-types"><span class="visually-hidden">Step @(index + 1) of @steps.Count, </span>@foreach (var cat in step.Categories) { <span class="prv-node-type">@PipelineReviewText.Label(cat)</span> }</span>
                                        <span class="prv-node-name">@step.Name</span>
                                        @if (step.Condition is { } c) { <span class="prv-node-meta" title="@c">runs when: @(D.ReadableCondition(c) ?? c)</span> }
                                        @if (step.ContinueOnError) { <span class="prv-node-meta">continues on error</span> }
                                    </li>
                                }
                            </ol>
                        }
                    }
                    <ol class="pr-map prv-flow" aria-label="@($"Stages of {p.Name} in execution order")">
                        @foreach (var (s, index) in stages.Select((s, i) => (s, i)))
                        {
                            var deps = r.Edges.Where(e => e.Kind == PipelineEdgeKind.DependsOn && e.ToId == s.Id).Select(e => r.Nodes.FirstOrDefault(n => n.Id == e.FromId)?.Label ?? e.FromId).ToList();
                            var deploys = r.Edges.Where(e => e.Kind == PipelineEdgeKind.DeploysTo && e.FromId == s.Id).Select(e => r.Nodes.FirstOrDefault(n => n.Id == e.ToId)?.Label).ToList();
                            var type = D.StageType(r, s);
                            var condition = s.Evidence?.Condition;
                            <li class="prv-node prv-type-@type.ToString().ToLowerInvariant()" data-testid="pr-flow-node" data-type="@type">
                                <span class="prv-node-type">@D.TypeLabel(type)<span class="visually-hidden"> stage, step @(index + 1) of @stages.Count:</span></span>
                                <span class="prv-node-name">@s.Label</span>
                                <span class="prv-node-meta">@(deps.Count == 0 ? "starts first / in parallel" : $"after {string.Join(", ", deps)}")</span>
                                @if (deploys.Count > 0) { <span class="prv-node-meta">deploys to @string.Join(", ", deploys)</span> }
                                @if (condition is not null) { <span class="prv-node-meta" title="@condition">runs when: @(D.ReadableCondition(condition) ?? condition)</span> }
                            </li>
                        }
                    </ol>
                </div>
            }
        </section>
    };

    private RenderFragment RenderGaps(PipelineReviewResult r) => __builder =>
    {
        <section class="sd-panel" aria-labelledby="pr-gaps-h" data-testid="pr-gaps">
            <h2 id="pr-gaps-h">Gaps <span class="sd-count">@r.Findings.Count</span></h2>
            <p class="sd-muted">Severity says how much a gap matters; evidence says how sure the reading is. These are review suggestions, not automatic fixes.</p>
            <div class="sd-filterbar">
                <label>Category
                    <select @onchange="e => _category = Enum.TryParse<PipelineFindingCategory>(e.Value?.ToString(), out var c) ? c : null" data-testid="pr-gap-category">
                        <option value="">All categories</option>
                        @foreach (var c in r.Findings.Select(f => f.Category).Distinct().Order()) { <option value="@c">@PipelineReviewText.Label(c)</option> }
                    </select>
                </label>
            </div>
            @foreach (var (severity, findings) in P.BySeverity(r.Findings, _category))
            {
                <h3 data-testid="@($"pr-gaps-{severity}")">@severity <span class="sd-count">@findings.Count</span></h3>
                @foreach (var f in findings) { @RenderFinding(f) }
            }
            @if (r.Findings.Count(f => f.EvidenceState == ArchitectureEvidenceState.Unresolved) is var unresolved && unresolved > 0)
            {
                <p class="sd-muted" data-testid="pr-gaps-unresolved">@unresolved finding(s) rest on unresolved relationships: they say what could not be established, not that a gap is confirmed.</p>
            }
        </section>
    };

    private RenderFragment RenderTests(PipelineReviewResult r) => __builder =>
    {
        var m = r.TestMatrix;
        <section class="sd-panel" aria-labelledby="pr-matrix-h" data-testid="pr-tests">
            <h2 id="pr-matrix-h">Test gating matrix</h2>
            <p class="sd-muted">A test step in a pipeline is not the same as a test that gates a deployment. ✓ gates · ✓* gates via promoted artifact · ✓? conditional · ~ may not block · → runs after · ? not assessable · – not detected.</p>
            <div class="sd-scroll" tabindex="0" role="region" aria-label="Test gating matrix">
                <table data-testid="pr-matrix">
                    <caption class="visually-hidden">Validations by environment</caption>
                    <thead><tr><th scope="col">Validation</th>@foreach (var c in m.Columns) { <th scope="col">@c</th> }</tr></thead>
                    <tbody>
                        @foreach (var row in m.Rows)
                        {
                            <tr data-testid="pr-matrix-row"><th scope="row">@PipelineReviewText.Label(row.Category)@if (row.Note is { } note) { <span class="sd-context">@note</span> }</th>
                                @foreach (var c in m.Columns)
                                {
                                    var (symbol, text) = P.Cell(row.Cells.GetValueOrDefault(c));
                                    <td data-state="@(row.Cells.GetValueOrDefault(c)?.ToString() ?? "None")"><span aria-hidden="true">@symbol</span> <span class="pr-cell-text">@text</span></td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <ul class="sd-list">@foreach (var n in m.Notes) { <li>@n</li> }</ul>
            <h2>Tests and checks in pipelines <span class="sd-count">@r.Tests.Count</span></h2>
            <p class="sd-muted" data-testid="pr-tests-defined">Status of every row: <span class="sd-pill sd-pill-muted">Defined</span> — the pipeline intends to run it. Whether it ran or passed needs run results (for example imported test evidence), which a definition cannot show.</p>
            <div class="sd-scroll" tabindex="0" role="region" aria-label="Tests in pipelines">
                <table data-testid="pr-test-table">
                    <thead><tr><th scope="col">Test</th><th scope="col">Pipeline / stage</th><th scope="col">When it runs</th><th scope="col">What it gates</th><th scope="col"><span class="visually-hidden">Evidence</span></th></tr></thead>
                    <tbody>
                        @foreach (var t in r.Tests)
                        {
                            var key = $"t:{t.Evidence.File}:{t.Evidence.Line}:{t.Category}";
                            <tr data-testid="pr-test-row"><th scope="row">@PipelineReviewText.Label(t.Category)<span class="sd-context">@t.Name · <code>@t.Tool</code>@(t.Targets.Count > 0 ? $" · {string.Join(", ", t.Targets)}" : "")</span></th>
                                <td>@t.PipelineName<span class="sd-context">@(t.Stage ?? t.Job)</span></td>
                                <td>@Code(t.WhenItRuns)@if (D.ReadableCondition(t.Condition) is { } readable) { <span class="sd-context" data-testid="pr-test-condition" title="@t.Condition">Runs when: @readable</span> }@if (t.ContinueOnError) { <span class="sd-pill sd-pill-partial">continueOnError</span> }</td>
                                <td>@(t.Gates.Count == 0 ? t.RunsAfter.Count > 0 ? $"Runs after {string.Join(", ", t.RunsAfter.Select(id => EnvName(r, id)).Distinct())}" : "Does not gate a deployment" : string.Join(", ", t.Gates.Select(id => EnvName(r, id)).Distinct()))</td>
                                <td>@EvidenceButton(key, t.Name)</td></tr>
                            @if (Open(key)) { <tr><td colspan="5">@EvidenceTable([t.Evidence])</td></tr> }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    };

    private RenderFragment RenderEnvironments(PipelineReviewResult r) => __builder =>
    {
        <section class="sd-panel" aria-labelledby="pr-env-h" data-testid="pr-environments">
            <h2 id="pr-env-h">Environment progression</h2>
            @if (r.Progression.Count == 0) { <p class="sd-muted">No dependency, pipeline trigger or promotion links environments to each other in source.</p> }
            <ul class="sd-list" data-testid="pr-progression">
                @foreach (var s in r.Progression) { <li>@s.From → @s.To <span class="@P.StateCss(s.State)">@PipelineReviewText.Label(s.State)</span> <span class="sd-context">@Code(s.Basis)</span></li> }
            </ul>
            @foreach (var env in r.Environments)
            {
                <h3>@env.Environment</h3>
                @foreach (var d in r.Deployments.Where(d => env.Deployments.Contains(d.Id)))
                {
                    <article class="pr-deployment" data-testid="pr-deployment">
                        <h4>@d.PipelineName · <code>@(d.Stage ?? d.Job)</code> <span class="sd-context">@string.Join(", ", d.DeploysWhat) to <code>@d.Environment</code> (@d.EnvironmentBasis)</span></h4>
                        <dl class="sd-facts">
                            <div><dt>How reached</dt><dd>@Code(d.HowReached)</dd></div>
                            <div><dt>Before deployment</dt><dd>@if (d.Before.Count == 0) { <span>No validation detected</span> } @foreach (var g in d.Before.DistinctBy(g => (g.Category, g.State))) { <span class="@P.GateCss(g.State)">@PipelineReviewText.Label(g.Category): @PipelineReviewText.Label(g.State)</span> }</dd></div>
                            <div><dt>After deployment</dt><dd>@(d.After.Count == 0 ? "No post-deployment validation detected" : string.Join(", ", d.After.Select(g => PipelineReviewText.Label(g.Category)).Distinct()))</dd></div>
                            <div><dt>Artifact</dt><dd>@foreach (var a in d.Artifacts) { <span>@Code($"`{a.Artifact}` from {a.Source}") <span class="@P.StateCss(a.State)">@PipelineReviewText.Label(a.State)</span> <span class="sd-context">@Code(a.Basis)</span></span> }</dd></div>
                            <div><dt>Approval</dt><dd>@Code(d.Approval)</dd></div>
                            <div><dt>Rollback</dt><dd>@Code(d.Rollback)</dd></div>
                            @if (d.Unresolved.Count > 0) { <div><dt>Unresolved</dt><dd><ul class="sd-list">@foreach (var u in d.Unresolved) { <li>@Code(u)</li> }</ul></dd></div> }
                        </dl>
                        @EvidenceButton($"d:{d.Id}", $"{d.PipelineName} {d.Environment}")
                        @if (Open($"d:{d.Id}")) { @EvidenceTable([d.Evidence, .. d.Before.Select(g => g.Evidence), .. d.After.Select(g => g.Evidence)]) }
                    </article>
                }
            }
        </section>
    };

    private RenderFragment RenderDependencies(PipelineReviewResult r) => __builder =>
    {
        string Name(string id) => r.Pipelines.FirstOrDefault(p => p.Id == id)?.Name ?? id;
        <section class="sd-panel" aria-labelledby="pr-dep-h" data-testid="pr-dependencies">
            <h2 id="pr-dep-h">Pipelines</h2>
            <div class="sd-scroll" tabindex="0" role="region" aria-label="Pipelines">
                <table data-testid="pr-pipelines">
                    <thead><tr><th scope="col">Pipeline</th><th scope="col">Role</th><th scope="col">Starts on</th><th scope="col">Environments</th></tr></thead>
                    <tbody>
                        @foreach (var p in r.Pipelines.OrderBy(p => p.IsTemplate))
                        {
                            <tr><th scope="row">@p.Name<span class="sd-context"><code>@p.File</code>@(p.DefinitionName is { } dn ? $" · Azure DevOps: {dn}" : "")</span></th><td>@p.Role</td>
                                <td>@if (p.IsTemplate) { <span>—</span> } else { <ul class="sd-list">@foreach (var t in p.Triggers) { <li>@Code(t.Text)</li> }</ul> }</td><td>@string.Join(", ", p.Environments)</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <h2>Relationships between pipelines</h2>
            <p class="sd-muted">Triggers, artifact consumption and "likely follows" are kept apart: consuming another pipeline's artifact does not mean that pipeline starts this one.</p>
            <div class="sd-scroll" tabindex="0" role="region" aria-label="Pipeline relationships">
                <table data-testid="pr-relationships">
                    <thead><tr><th scope="col">From</th><th scope="col">Relationship</th><th scope="col">To</th><th scope="col">Evidence</th></tr></thead>
                    <tbody>
                        @foreach (var d in r.Dependencies)
                        {
                            <tr data-testid="pr-relationship" data-kind="@d.Kind"><th scope="row">@Name(d.FromPipeline)</th><td>@PipelineReviewText.Label(d.Kind)<span class="sd-context">@Code(d.Basis)</span></td><td>@Name(d.ToPipeline)</td><td><span class="@P.StateCss(d.State)">@PipelineReviewText.Label(d.State)</span></td></tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (r.UnresolvedTemplates.Count > 0)
            {
                <h2>Templates not analyzed</h2>
                <ul class="sd-list" data-testid="pr-unresolved-templates">@foreach (var u in r.UnresolvedTemplates) { <li><code>@u.Template</code> (@u.Level in @Name(u.Pipeline)): @u.Reason</li> }</ul>
            }
            <h2>Source areas and the pipelines they start</h2>
            <div class="sd-scroll" tabindex="0" role="region" aria-label="Path coverage">
                <table data-testid="pr-coverage">
                    <thead><tr><th scope="col">Source area</th><th scope="col">Pipelines (does a change start it?)</th></tr></thead>
                    <tbody>
                        @foreach (var row in r.PathCoverage)
                        {
                            <tr data-testid="pr-coverage-row"><th scope="row">@row.Area<span class="sd-context">@row.AreaKind · <code>@row.Path</code></span></th>
                                <td>@if (row.Pipelines.Count == 0) { <span>@row.Basis</span> } else { <ul class="sd-list">@foreach (var c in row.Pipelines) { <li><strong>@Name(c.Pipeline)</strong>: @P.Coverage(c.Triggers)@(c.Validations.Count > 0 ? $" · tests: {string.Join(", ", c.Validations.Select(PipelineReviewText.Label))}" : "")<span class="sd-context">@Code(c.Basis)</span></li> }</ul> }</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    };

    private RenderFragment RenderChanges(PipelineReviewResult r) => __builder =>
    {
        <section class="sd-panel" aria-labelledby="pr-changes-h" data-testid="pr-changes">
            <h2 id="pr-changes-h">Pipeline changes</h2>
            <p class="sd-muted">@PipelineReviewText.ChangesBoundary</p>
            @if (_sources.Snapshots.Count < 2) { <p class="sd-empty">Only one Source Analysis snapshot exists for this Target Environment; analyze a newer or older archive to compare pipeline definitions.</p> }
            else
            {
                <div class="sd-filterbar">
                    <label>Compare with
                        <select value="@_previousId" @onchange="e => _previousId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null" data-testid="pr-compare-previous">
                            @foreach (var s in _sources.Snapshots.Where(s => s.Id != _snapshotId).OrderByDescending(s => s.AnalyzedAt)) { <option value="@s.Id">@s.ArchiveName · @P.Utc(s.AnalyzedAt)</option> }
                        </select>
                    </label>
                    <button class="btn-primary" @onclick="Compare" disabled="@(_comparing || _previousId is null)" data-testid="pr-compare">Compare</button>
                </div>
                @if (_comparison is { } c)
                {
                    @if (c.Changes.Count == 0) { <p class="sd-muted" data-testid="pr-no-changes">No pipeline definition change between the two snapshots.</p> }
                    else
                    {
                        <div class="sd-scroll" tabindex="0" role="region" aria-label="Pipeline changes">
                            <table data-testid="pr-change-table">
                                <thead><tr><th scope="col">Change</th><th scope="col">Pipeline</th><th scope="col">Detail</th><th scope="col">What it may mean</th></tr></thead>
                                <tbody>
                                    @foreach (var ch in c.Changes)
                                    {
                                        <tr data-testid="pr-change" data-kind="@ch.Kind"><th scope="row">@ch.Kind</th><td>@ch.Pipeline</td><td>@Code(ch.Detail)</td>
                                            <td>@if (ch.Severity is { } sev) { <span class="@P.SeverityCss(sev)">@sev</span> } @(ch.Interpretation ?? "")</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            }
        </section>
    };
}
