@page "/pipeline-review"
@using BirkNext.PipelineReview
@using BirkNext.SourceArchitecture
@using BirkNext.Web.Models
@using P = BirkNext.Web.Services.PipelineReviewPresentation
@using D = BirkNext.Web.Services.PipelineReviewDashboard
@using G = BirkNext.Web.Services.PipelineReviewGrouping
@using BirkNext.Web.Services
@using BirkNext.Web.Shared.Components.Common
@inject IPipelineReviewApiService Api
@inject IFrontendAnalysisContextFactory ContextFactory
@inject IReportExportService ExportService
@inject IJSRuntime JS

<PageTitle>Pipeline Review</PageTitle>

<div class="sd-workspace pr-page prv" data-testid="pr-page" aria-busy="@(_loaded ? "false" : "true")">
    <header class="prv-header">
        <div class="prv-header-text">
            <h1 class="pr-title">Pipeline Review</h1>
            <p class="prv-lead">Understand how changes move through build, test, validation and deployment — read from the pipeline definitions in Source Analysis.</p>
        </div>
        @if (_loaded)
        {
            var headerStatus = D.PageStatus(_result, Selected);
            <div class="prv-header-status">
                <span data-testid="pr-status">@Pill(headerStatus, "Pipeline Review")</span>
                @if (_result is { State: D.Reviewed } reviewed)
                {
                    @foreach (var provider in D.Providers(reviewed)) { <span class="prv-provider" data-testid="pr-provider"><span class="visually-hidden">Pipeline provider: </span>@provider</span> }
                }
            </div>
        }
    </header>

    @if (!_loaded)
    {
        <div class="prv-skeleton" role="status" aria-label="Loading Pipeline Review">
            <span></span><span></span><span></span>
        </div>
    }
    else if (!_sources.SourceAnalysisEnabled)
    {
        <div class="prv-empty" data-testid="pr-source-disabled">
            <span class="prv-empty-icon" aria-hidden="true">⌁</span>
            <div><h2>Source Analysis is turned off</h2><p>Source Analysis is disabled in Feature Visibility, so pipeline source cannot be selected. Pipeline Review reads pipeline definitions from Source Analysis snapshots.</p></div>
        </div>
    }
    else if (_sources.Snapshots.Count == 0)
    {
        <div class="prv-empty" data-testid="pr-source-required">
            <span class="prv-empty-icon" aria-hidden="true">⌁</span>
            <div>
                <h2>Pipeline source required</h2>
                <p>Pipeline Review reads the pipeline definitions (YAML) in a Source Analysis snapshot. Analyze the repository that contains your pipelines first.</p>
                <p class="prv-actions"><a class="btn-primary" href="source-analysis" data-testid="pr-open-source-analysis">Open Source Analysis</a> <a class="btn-secondary" href="technology-coverage">Technology Coverage</a></p>
            </div>
        </div>
    }
    else
    {
        var source = Selected;
        var status = D.PageStatus(_result, source);
        <section class="prv-evidence" aria-labelledby="pr-evidence-h" data-testid="pr-summary-bar">
            <h2 id="pr-evidence-h" class="prv-evidence-title">Pipeline Review@(source is not null ? $" — {D.SourceName(source)}" : "")</h2>
            <dl class="prv-evidence-facts">
                <div><dt>Provider</dt><dd data-testid="pr-provider-fact">@(_result is { State: D.Reviewed } rv && D.Providers(rv).Count > 0 ? string.Join(", ", D.Providers(rv)) : "—")</dd></div>
                <div><dt>Source snapshot</dt><dd>@if (source is null) { <span>—</span> } else { <span data-testid="pr-source-name">@D.SourceName(source)</span> <span class="prv-muted">· @P.Utc(source.AnalyzedAt)</span> }</dd></div>
                <div><dt>Review readiness</dt><dd data-testid="pr-review-readiness">@Pill(status, "Review readiness")</dd></div>
                <div><dt>Source coverage</dt><dd data-testid="pr-source-coverage">@Pill(D.SourceStatus(source?.Status), "Source Analysis coverage")</dd></div>
                <div><dt>Runtime metadata</dt><dd data-testid="pr-runtime-metadata">@Pill(D.MetadataStatus(_metadata, _result?.Metadata), "Azure DevOps runtime metadata")</dd></div>
            </dl>
            <p class="prv-muted" data-testid="pr-ready-meaning">Review ready means the source contains enough pipeline evidence to analyze the definitions. It does not mean the pipelines passed, deployments succeeded, or all gaps are resolved. Source coverage can be Partial at the same time.</p>
            <div class="prv-evidence-actions" data-testid="pr-scope">
                <label class="prv-select">Change source
                    <select value="@_snapshotId" @onchange="SelectSnapshot" data-testid="pr-snapshot">
                        @foreach (var s in _sources.Snapshots.OrderByDescending(s => s.AnalyzedAt))
                        {
                            <option value="@s.Id">@D.OptionText(s, s.Id == NewestId)</option>
                        }
                    </select>
                </label>
                <a class="btn-secondary" href="source-analysis">Open Source Analysis</a>
                <label class="prv-toggle"><input type="checkbox" checked="@_metadata" @onchange="ToggleMetadata" data-testid="pr-metadata" aria-describedby="pr-metadata-help" /> Add Azure DevOps metadata <span class="prv-muted">(optional, read-only)</span></label>
            </div>
            <p class="prv-muted" id="pr-metadata-help">Azure DevOps approvals, checks and run history are not part of this source-only review. Pipeline Review works without them; runtime metadata is enrichment, not a prerequisite.</p>
            <details class="prv-more" data-testid="pr-evidence-details">
                <summary>Source &amp; evidence details</summary>
                <ul class="prv-checklist" data-testid="pr-readiness">
                    @foreach (var item in D.Readiness(_result, source, _metadata))
                    {
                        <li data-testid="pr-readiness-item"><span class="prv-check-label">@item.Label</span>@Pill(item.Status, item.Label)@if (item.Detail is { } detail) { <span class="prv-check-detail">@detail</span> }</li>
                    }
                </ul>
                @if (source is not null) { <p class="prv-muted">CI/CD evidence: @Pill(D.EvidenceStatus(source), "CI/CD evidence") · @D.EvidenceLabel(source)</p> }
            </details>
        </section>

        @if (_result is { State: D.NeedsRefresh } stale && source is not null)
        {
            <section class="prv-callout prv-callout-caution" data-testid="pr-state" data-state="@stale.State" aria-labelledby="pr-state-h">
                <span class="prv-callout-icon" aria-hidden="true">⚠</span>
                <div class="prv-callout-body">
                    <h2 id="pr-state-h">CI/CD evidence needs refresh</h2>
                    <p>This source snapshot was analyzed before the current CI/CD evidence model was available, so its pipelines cannot be reviewed yet. It is not a pipeline problem.</p>
                    <p class="prv-callout-meta" data-testid="pr-evidence-versions"><span>Current: <strong>@(source.CiCdAnalyzerVersion <= 0 ? "none" : $"v{source.CiCdAnalyzerVersion}")</strong></span><span>Required: <strong>v@(PipelineReviewText.RequiredCiCdVersion)</strong></span></p>
                    <p class="prv-actions">
                        <a class="btn-primary" href="source-analysis" data-testid="pr-reanalyze">Re-analyze in Source Analysis</a>
                        <span class="prv-hint">Analyze @D.SourceName(source) again to produce CI/CD evidence v@(PipelineReviewText.RequiredCiCdVersion); this page refreshes when you return.</span>
                    </p>
                </div>
            </section>
        }
        else if (status.Tone == CapabilityTone.Danger)
        {
            <section class="prv-callout prv-callout-danger" data-testid="pr-state" data-state="FailedAnalysis" aria-labelledby="pr-state-h">
                <span class="prv-callout-icon" aria-hidden="true">✕</span>
                <div class="prv-callout-body"><h2 id="pr-state-h">Pipeline analysis failed</h2><p>@(_result?.StateReason is { Length: > 0 } reason ? reason : "Source Analysis could not read the pipeline definitions in this snapshot.")</p>
                    <p class="prv-actions"><a class="btn-secondary" href="source-analysis">Open Source Analysis</a></p></div>
            </section>
        }
        else if (_result is { State: D.NoPipelines } none)
        {
            <section class="prv-callout prv-callout-neutral" data-testid="pr-state" data-state="@none.State" aria-labelledby="pr-state-h">
                <span class="prv-callout-icon" aria-hidden="true">⌁</span>
                <div class="prv-callout-body">
                    <h2 id="pr-state-h">@(status.Label == "Unsupported" ? "Pipeline detected, provider not supported" : "No pipeline definition detected")</h2>
                    <p>@none.StateReason</p>
                    <ul class="prv-causes"><li>No supported pipeline files in this snapshot (pipelines may live in another repository).</li><li>The pipeline technology is not supported — a tool limitation, not a quality failure.</li></ul>
                    <p class="prv-actions"><a class="btn-secondary" href="source-analysis">Open Source Analysis</a> <a class="btn-secondary" href="technology-coverage">Technology Coverage</a></p>
                </div>
            </section>
        }

        @if (_error is not null) { <p class="sd-reason" role="alert" data-testid="pr-error">@_error</p> }
        @if (_result is { State: D.Reviewed })
        {
            <section class="prv-scope-banner" data-testid="pr-boundary" aria-label="Evidence scope">
                <p><strong>Source evidence only.</strong> This review shows intended pipeline behavior from YAML/source definitions. It does not prove that a pipeline ran, a stage succeeded, a deployment completed, an approval/check was satisfied or an artifact was published. Azure DevOps runtime metadata can enrich those facts.</p>
            </section>
        }

        <div class="prv-tabbar">
            <div class="prv-tabs" role="group" aria-label="Pipeline Review views">
                @foreach (var (key, label) in Tabs)
                {
                    <button class="prv-tab" aria-pressed="@(_tab == key ? "true" : "false")" @onclick="() => ShowTab(key)" data-testid="@($"pr-tab-{key}")">@label</button>
                }
            </div>
            @if (_result is { State: D.Reviewed })
            {
                <ExportMenu Options="ExportOptions" TestId="pr-export" />
            }
        </div>

        @if (_result is { State: D.Reviewed } r)
        {
            @switch (_tab)
            {
                case "flow": @RenderFlow(r) break;
                case "gaps": @RenderGaps(r) break;
                case "tests": @RenderTests(r) break;
                case "environments": @RenderEnvironments(r) break;
                case "dependencies": @RenderDependencies(r) break;
                case "changes": @RenderChanges(r) break;
                default: @RenderOverview(r) break;
            }
            <details class="pr-details" data-testid="pr-limitations">
                <summary>Limitations and what this review cannot see (@r.Limitations.Count)</summary>
                <ul class="sd-list" data-testid="pr-limitation-groups">
                    <li>Runtime execution not assessed</li>
                    <li>Azure DevOps approvals/checks @(r.Metadata.State == "Available" ? "included from metadata" : "not included")</li>
                    <li>Branch policies not visible in YAML</li>
                    <li>Artifact publication not verified</li>
                    <li>Deployment completion not verified</li>
                    <li>External post-deployment checks may exist</li>
                </ul>
                <details class="prv-more"><summary>Analyzer limitations (@r.Limitations.Count)</summary>
                    <ul class="sd-list">@foreach (var l in r.Limitations) { <li>@l</li> }</ul>
                </details>
                <p class="sd-muted">@r.Metadata.Detail</p>
            </details>
        }
        else
        {
            <section class="prv-placeholder" data-testid="pr-placeholder" data-tab="@_tab" aria-labelledby="pr-placeholder-h">
                <h2 id="pr-placeholder-h">@Tabs.First(t => t.Key == _tab).Label</h2>
                <p>@Placeholder(_tab, _result?.State)</p>
            </section>
        }

        <ReviewDisclosure Text="Technical details" CollapseText="Hide technical details" TestId="pr-technical" Class="prv-technical">
            <dl class="prv-tech">
                @if (source is not null)
                {
                    <div><dt>Snapshot ID</dt><dd><code>@source.Id</code></dd></div>
                    <div><dt>Archive</dt><dd><code>@source.ArchiveName</code></dd></div>
                    <div><dt>Fingerprint</dt><dd><code>@source.Fingerprint</code></dd></div>
                    <div><dt>CI/CD domain status</dt><dd>@(source.CiCdStatus ?? "—")</dd></div>
                }
                <div><dt>Evidence model</dt><dd>@(source is null ? "—" : D.EvidenceLabel(source)) · v@(PipelineReviewText.RequiredCiCdVersion) required</dd></div>
                @if (_result is { } tr)
                {
                    <div><dt>Review state</dt><dd>@tr.State · rules v@(tr.RulesVersion)</dd></div>
                    <div><dt>Metadata</dt><dd>@tr.Metadata.State — @tr.Metadata.Detail</dd></div>
                    <div><dt>Pipeline files</dt><dd data-testid="pr-tech-file-count">@tr.Pipelines.Count</dd></div>
                    <div><dt>Unresolved evidence</dt><dd>@(tr.UnresolvedTemplates.Count + tr.Findings.Count(f => f.EvidenceState == ArchitectureEvidenceState.Unresolved))</dd></div>
                }
            </dl>
            @if (_result is { } files)
            {
                <details class="prv-more" data-testid="pr-tech-files">
                    <summary>View pipeline files (@files.Pipelines.Count)</summary>
                    <label class="prv-select">Search files <input type="search" @bind="_fileSearch" @bind:event="oninput" data-testid="pr-tech-file-search" /></label>
                    <div class="sd-scroll" tabindex="0" role="region" aria-label="Pipeline files">
                        <table data-testid="pr-tech-file-table">
                            <thead><tr><th scope="col">File</th><th scope="col">Kind</th><th scope="col">Provider</th><th scope="col">Pipeline</th><th scope="col">Environments</th></tr></thead>
                            <tbody>
                                @foreach (var p in files.Pipelines.Where(p => _fileSearch.Trim() is not { Length: > 0 } term || p.File.Contains(term, StringComparison.OrdinalIgnoreCase) || p.Name.Contains(term, StringComparison.OrdinalIgnoreCase)))
                                {
                                    <tr data-testid="pr-tech-pipeline"><td><code class="sd-path">@p.File</code></td><td>@(p.IsTemplate ? "Template" : "Pipeline")</td><td>@BirkNext.SourceDomains.SourceDomainText.Label(p.Platform)</td><td>@p.Name</td><td>@string.Join(", ", p.Environments)</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            }
        </ReviewDisclosure>
    }
</div>

@code {
    private static readonly (string Key, string Label)[] Tabs =
        [("overview", "Overview"), ("flow", "Flow"), ("gaps", "Findings"), ("tests", "Tests"), ("environments", "Environments"), ("dependencies", "Dependencies"), ("changes", "Changes")];

    private PipelineReviewSourceOption? Selected => _sources.Snapshots.FirstOrDefault(s => s.Id == _snapshotId);
    private Guid? NewestId => _sources.Snapshots.OrderByDescending(s => s.AnalyzedAt).Select(s => (Guid?)s.Id).FirstOrDefault();

    /// <summary>Status pill: decorative glyph + text; <paramref name="subject"/> prefixes the spoken text ("Pipeline Review status: Needs refresh").</summary>
    private static RenderFragment Pill(CapabilityStatus status, string? subject) => __builder =>
    {
        <span class="sd-pill @status.PillClass prv-pill" data-status="@status.Label">@if (subject is not null) {<span class="visually-hidden">@subject status: </span>}<span class="prv-glyph" aria-hidden="true">@status.Glyph</span> @status.Label</span>
    };

    /// <summary>What each view shows once evidence exists — never invented content.</summary>
    private static string Placeholder(string tab, string? state)
    {
        if (state == D.NoPipelines) return "No pipeline definition was detected in this snapshot, so there is nothing to show here.";
        if (state != D.NeedsRefresh) return "Select a snapshot with pipeline definitions to populate this view.";
        return tab switch
        {
            "flow" => "Refresh the CI/CD evidence in Source Analysis to build the pipeline flow.",
            "gaps" => "Refresh the CI/CD evidence to evaluate pipeline gaps.",
            "tests" => "Refresh the CI/CD evidence to inspect test gates.",
            "environments" => "Refresh the CI/CD evidence to see deployments and environment progression.",
            "dependencies" => "Refresh the CI/CD evidence to see pipeline relationships, templates and path coverage.",
            "changes" => "Refresh the CI/CD evidence to compare pipeline definitions between snapshots.",
            _ => "Refresh the CI/CD evidence in Source Analysis to populate the overview: provider, stages, gates, artifacts and environments.",
        };
    }

    private FrontendAnalysisProfile? _profile;
    /// <summary>The runtime context sent with requests; blank without a Target Environment (source snapshots are not scoped by it).</summary>
    private string EnvironmentId => _profile?.Id ?? "";
    private PipelineReviewSourceList _sources = new(true, [], null);
    private Guid? _snapshotId;
    private bool _metadata, _loaded;
    private PipelineReviewResult? _result;
    private string? _error;
    private string _tab = "overview";
    private readonly HashSet<string> _open = new(StringComparer.Ordinal);
    private PipelineFindingCategory? _category;
    private string _probePath = "";
    private PathProbeResult? _probe;
    private bool _probing;
    private Guid? _previousId;
    private PipelineReviewComparison? _comparison;
    private bool _comparing;

    protected override async Task OnInitializedAsync()
    {
        // Pipelines are source evidence: they are reviewed from the current source snapshot with or without a Target Environment.
        _profile = (await ContextFactory.GetActiveContextAsync()).ActiveProfileOrNull;
        _sources = await Api.SourcesAsync(EnvironmentId);
        _snapshotId = _sources.DefaultSnapshotId ?? _sources.Snapshots.OrderByDescending(s => s.AnalyzedAt).Select(s => (Guid?)s.Id).FirstOrDefault();
        if (_snapshotId is not null) await Load();
        _loaded = true;
    }

    private async Task Load()
    {
        if (_snapshotId is null) return;
        (_result, _error) = await Api.ReviewAsync(EnvironmentId, _snapshotId, _metadata);
        _probe = null; _comparison = null; _open.Clear();
        _previousId = _sources.Snapshots.Where(s => s.Id != _snapshotId && s.AnalyzedAt <= (_sources.Snapshots.FirstOrDefault(x => x.Id == _snapshotId)?.AnalyzedAt ?? DateTimeOffset.MaxValue))
            .OrderByDescending(s => s.AnalyzedAt).Select(s => (Guid?)s.Id).FirstOrDefault();
    }

    private async Task SelectSnapshot(ChangeEventArgs e) { if (Guid.TryParse(e.Value?.ToString(), out var id)) { _snapshotId = id; await Load(); } }
    private async Task ToggleMetadata(ChangeEventArgs e) { _metadata = e.Value is true; await Load(); }
    private void ShowTab(string key)
    {
        _tab = key;
        if (key == "tests" && _result is { State: D.Reviewed } reviewed) ApplyTestDefault(reviewed);
    }
    private void Toggle(string key) { if (!_open.Remove(key)) _open.Add(key); }
    private bool Open(string key) => _open.Contains(key);

    private async Task Probe()
    {
        if (_snapshotId is null || string.IsNullOrWhiteSpace(_probePath)) return;
        _probing = true;
        try { _probe = await Api.ProbeAsync(EnvironmentId, _snapshotId.Value, _probePath.Trim()); }
        finally { _probing = false; }
    }

    private async Task Compare()
    {
        if (_snapshotId is null || _previousId is null) return;
        _comparing = true;
        try { _comparison = await Api.CompareAsync(EnvironmentId, _previousId.Value, _snapshotId.Value); }
        finally { _comparing = false; }
    }

    private IReadOnlyList<ExportMenu.Option> ExportOptions => [new("html", "HTML", Export)];

    private async Task Export()
    {
        if (_result is null) return;
        await JS.InvokeVoidAsync("downloadHtmlFile", $"pipeline-review-{DateTime.UtcNow:yyyy-MM-dd}.html", ExportService.ExportPipelineReview(_result));
    }

    private string EnvName(PipelineReviewResult r, string deploymentId) => r.Deployments.FirstOrDefault(d => d.Id == deploymentId) is { } d ? Display(d) : deploymentId;
    private static string Display(DeploymentReview d) => d.EnvironmentKind is BirkNext.SourceDomains.SourceEnvironmentKind.Custom or BirkNext.SourceDomains.SourceEnvironmentKind.Default ? d.Environment
        : d.EnvironmentKind switch { BirkNext.SourceDomains.SourceEnvironmentKind.Development => "DEV", BirkNext.SourceDomains.SourceEnvironmentKind.Production => "PROD", BirkNext.SourceDomains.SourceEnvironmentKind.Staging => "STAGING", var k => k.ToString().ToUpperInvariant() };

    private RenderFragment Code(string text) => __builder =>
    {
        foreach (var (segment, code) in P.Segments(text))
        {
            if (code) { <code>@segment</code> } else { @segment }
        }
    };

    private RenderFragment EvidenceButton(string key, string about) => __builder =>
    {
        <button class="sd-link" aria-expanded="@(Open(key) ? "true" : "false")" @onclick="() => Toggle(key)" data-testid="pr-evidence-toggle">@(Open(key) ? "Hide evidence" : "View evidence")<span class="visually-hidden"> for @about</span></button>
    };

    private RenderFragment EvidenceTable(IEnumerable<PipelineEvidenceRef> evidence, string? detail = null) => __builder =>
    {
        <div class="sd-scroll pr-evidence" tabindex="0" role="region" aria-label="Evidence" data-testid="pr-evidence">
            @if (detail is not null) { <p class="sd-muted">@Code(detail)</p> }
            <table>
                <thead><tr><th scope="col">File</th><th scope="col">Stage / job / step</th><th scope="col">Condition</th><th scope="col">Template origin</th><th scope="col">Note</th></tr></thead>
                <tbody>
                    @foreach (var e in evidence)
                    {
                        <tr><td><code class="sd-path">@P.Location(e)</code></td><td>@string.Join(" / ", new[] { e.Stage, e.Job, e.Step }.Where(x => !string.IsNullOrEmpty(x)))</td>
                            <td>@(e.Condition is { } c ? (MarkupString)$"<code>{System.Net.WebUtility.HtmlEncode(c)}</code>" : (MarkupString)"—")</td><td>@(e.TemplateOrigin ?? "—")</td><td>@(e.Note ?? "")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    };

    private RenderFragment RenderFinding(PipelineReviewFinding f) => __builder =>
    {
        <article class="pr-finding" data-testid="pr-finding" data-category="@f.Category" data-severity="@f.Severity">
            <h5>@Code(f.Title)</h5>
            <p class="pr-pills"><span class="@P.SeverityCss(f.Severity)">Severity: @f.Severity</span> <span class="@P.StateCss(f.EvidenceState)">Evidence: @PipelineReviewText.Label(f.EvidenceState)</span>@if (f.Environment is { } env) { <span class="sd-pill sd-pill-muted">@env</span> }@foreach (var p in f.Pipelines) { <span class="sd-pill sd-pill-muted">@PipelineName(p)</span> }</p>
            <p class="sd-reason">@Code(f.Explanation)</p>
            @if (f.Evidence.Count > 0)
            {
                @EvidenceButton($"f:{f.Id}", f.Title)
                @if (Open($"f:{f.Id}")) { @EvidenceTable(f.Evidence) }
            }
        </article>
    };

    private RenderFragment RenderGaps(PipelineReviewResult r) => __builder =>
    {
        var filtered = r.Findings.Where(MatchesGap).ToList();
        var allGroups = G.Group(r.Findings);
        <section class="sd-panel" aria-labelledby="pr-gaps-h" data-testid="pr-gaps">
            <h2 id="pr-gaps-h">Findings <span class="sd-count">@r.Findings.Count</span></h2>
            <p class="sd-muted" data-testid="pr-gaps-meaning">Findings are source-based review observations, not proof that a pipeline execution failed.</p>
            <ul class="prv-counts" data-testid="pr-gap-severity-summary">
                @foreach (var sev in new[] { PipelineFindingSeverity.High, PipelineFindingSeverity.Medium, PipelineFindingSeverity.Low })
                {
                    var count = r.Findings.Count(f => f.Severity == sev);
                    if (count > 0) { <li><span>@sev (@count)</span> <strong>@G.Group(r.Findings.Where(f => f.Severity == sev)).Count group@(G.Group(r.Findings.Where(f => f.Severity == sev)).Count == 1 ? "" : "s")</strong></li> }
                }
            </ul>
            <p class="sd-muted" data-testid="pr-gaps-grouping">@r.Findings.Count findings in @allGroups.Count groups. Findings from the same rule are grouped; why it matters and the suggested review are shown once per group. Severity says how much a gap matters; evidence says how sure the reading is. These are review suggestions, not automatic fixes.</p>
            <div class="sd-filterbar" data-testid="pr-gap-filters">
                <label>Severity
                    <select @bind="_gapSeverity" data-testid="pr-gap-severity"><option value="">All severities</option>@foreach (var s in r.Findings.Select(f => f.Severity).Distinct().Order()) { <option value="@s">@s</option> }</select>
                </label>
                <label>Category
                    <select @onchange="e => _category = Enum.TryParse<PipelineFindingCategory>(e.Value?.ToString(), out var c) ? c : null" data-testid="pr-gap-category">
                        <option value="">All categories</option>
                        @foreach (var c in r.Findings.Select(f => f.Category).Distinct().Order()) { <option value="@c">@PipelineReviewText.Label(c)</option> }
                    </select>
                </label>
                <label>Environment
                    <select @bind="_gapEnvironment" data-testid="pr-gap-environment"><option value="">All environments</option>@foreach (var e in r.Findings.Select(f => f.Environment).OfType<string>().Distinct().Order()) { <option value="@e">@e</option> }</select>
                </label>
                <label>Pipeline
                    <select @bind="_gapPipeline" data-testid="pr-gap-pipeline"><option value="">All pipelines</option>@foreach (var p in r.Findings.SelectMany(f => f.Pipelines).Distinct().OrderBy(PipelineName)) { <option value="@p">@PipelineName(p)</option> }</select>
                </label>
                <label>Search <input type="search" @bind="_gapSearch" @bind:event="oninput" data-testid="pr-gap-search" /></label>
            </div>
            @if (filtered.Count != r.Findings.Count) { <p class="sd-muted" role="status" data-testid="pr-gaps-filtered">Showing @filtered.Count of @r.Findings.Count findings.</p> }
            @foreach (var (severity, findings) in P.BySeverity(filtered, null))
            {
                <h3 data-testid="@($"pr-gaps-{severity}")">@severity <span class="sd-count">@findings.Count</span></h3>
                @foreach (var g in G.Group(findings))
                {
                    <details class="prv-gap-group" data-testid="pr-gap-group" data-category="@g.Category" data-severity="@g.Severity" data-count="@g.Findings.Count">
                        <summary>
                            <span class="prv-gap-title">@Code(g.Title)</span>
                            <span class="prv-gap-meta"><span class="@P.SeverityCss(g.Severity)">@g.Severity</span> <span class="sd-pill sd-pill-muted">@PipelineReviewText.Label(g.Category)</span>@if (g.Environment is { } env) { <span class="sd-pill sd-pill-muted">@env</span> }
                                <span class="prv-group-count">Affected: @g.Findings.Count</span></span>
                        </summary>
                        <div class="prv-gap-body">
                            <p><strong>Why it matters:</strong> @g.WhyItMatters</p>
                            @if (g.SuggestedAction is { } action) { <p><strong>Suggested review:</strong> @Code(action)</p> }
                            <h4>@(g.Findings.Count == 1 ? "Affected item" : $"{g.Findings.Count} affected items")</h4>
                            @foreach (var f in g.Findings)
                            {
                                @RenderFinding(f)
                                @if (g.SuggestedAction is null) { <p class="pr-finding-action"><strong>Suggested review:</strong> @Code(f.SuggestedAction)</p> }
                            }
                        </div>
                    </details>
                }
            }
            @if (r.Findings.Count(f => f.EvidenceState == ArchitectureEvidenceState.Unresolved) is var unresolved && unresolved > 0)
            {
                <p class="sd-muted" data-testid="pr-gaps-unresolved">@unresolved finding(s) rest on unresolved relationships: they say what could not be established, not that a gap is confirmed.</p>
            }
        </section>
    };

    private string _gapSeverity = "", _gapEnvironment = "", _gapPipeline = "", _gapSearch = "";
    private bool MatchesGap(PipelineReviewFinding f) =>
        (_category is null || f.Category == _category)
        && (_gapSeverity.Length == 0 || f.Severity.ToString() == _gapSeverity)
        && (_gapEnvironment.Length == 0 || f.Environment == _gapEnvironment)
        && (_gapPipeline.Length == 0 || f.Pipelines.Contains(_gapPipeline))
        && (_gapSearch.Trim() is not { Length: > 0 } term || f.Title.Contains(term, StringComparison.OrdinalIgnoreCase) || f.Explanation.Contains(term, StringComparison.OrdinalIgnoreCase)
            || f.Pipelines.Any(p => PipelineName(p).Contains(term, StringComparison.OrdinalIgnoreCase)));

    private string PipelineName(string id) => _result?.Pipelines.FirstOrDefault(p => p.Id == id)?.Name ?? id;

    private RenderFragment RenderOverview(PipelineReviewResult r) => __builder =>
    {
        var runnable = r.Pipelines.Where(p => !p.IsTemplate).ToList();
        var groups = G.Group(r.Findings.Where(f => f.Severity != PipelineFindingSeverity.Info));
        var artifacts = G.ArtifactSummary(r);
        var release = G.ReleasePath(r);
        <section class="sd-panel" aria-labelledby="pr-overview-h" data-testid="pr-overview">
            <h2 id="pr-overview-h" class="visually-hidden">Overview</h2>

            <section class="prv-release" aria-labelledby="pr-release-h" data-testid="pr-release-path">
                <h3 id="pr-release-h">Release path</h3>
                @if (release.Count == 0) { <p class="sd-muted" data-testid="pr-no-environments">No deployment to an environment was detected in these definitions, so no release path can be drawn. Tests still run as defined.</p> }
                <ol class="prv-release-steps" aria-label="Apparent release path, in order" data-testid="pr-path">
                    @foreach (var (step, index) in release.Select((s, i) => (s, i)))
                    {
                        var link = step.Label.Contains('→');
                        <li class="@(link ? "prv-release-link" : "prv-release-step")" data-testid="pr-release-step">
                            <span class="visually-hidden">Step @(index + 1) of @release.Count: </span><strong>@step.Label</strong>
                            <span class="prv-release-detail">@step.Detail</span>
                        </li>
                    }
                </ol>
                <p class="sd-muted" data-testid="pr-path-note">Source-derived from pipeline definitions — not deployment history; no runtime execution evidence. "No source relationship detected" does not prove that promotion never happens outside source.</p>
                @if (r.DeliveryPath.Count > 0)
                {
                    <details class="prv-more" data-testid="pr-pipeline-path"><summary>View pipeline-level path</summary>
                        <ol class="pr-path" aria-label="Apparent delivery path by pipeline" data-testid="pr-delivery-path">
                            @foreach (var step in r.DeliveryPath) { <li class="@(step == "⋯" ? "pr-path-gap" : "")">@(step == "⋯" ? "no detected link" : step)</li> }
                        </ol>
                    </details>
                }
            </section>

            <section class="prv-attention" aria-labelledby="pr-attention-h" data-testid="pr-attention">
                <h3 id="pr-attention-h">Top review findings <span class="sd-count" data-testid="pr-counts">@P.Counts(r)</span></h3>
                <p class="sd-muted">Source-based conditions that may need review — not pipeline failures. Severity is review importance, not proof of a runtime failure.</p>
                @if (groups.Count == 0) { <p class="sd-muted">No high, medium or low finding detected.</p> }
                <ul class="prv-groups" data-testid="pr-top-findings">
                    @foreach (var g in groups.Take(4))
                    {
                        <li data-testid="pr-top-group"><span class="@P.SeverityCss(g.Severity)">@g.Severity · @g.Findings.Count</span> @Code(g.Title)@if (g.Environment is { } env) { <span class="prv-group-count">· @env</span> }</li>
                    }
                </ul>
                @if (r.Findings.Count > 0) { <button class="sd-link" @onclick="@(() => ShowTab("gaps"))" data-testid="pr-all-gaps">View all @r.Findings.Count findings in @G.Group(r.Findings).Count groups</button> }
            </section>

            <section aria-labelledby="pr-validation-h" data-testid="pr-gating-summary">
                <h3 id="pr-validation-h">Validation by environment</h3>
                <ul class="prv-env-cards">
                    @foreach (var v in G.Validation(r))
                    {
                        <li class="prv-env-card" data-testid="pr-validation-card" data-environment="@v.Environment">
                            <h4>@v.Environment</h4>
                            <dl class="prv-counts">
                                <div><dt>Deployments</dt><dd>@v.Deployments</dd></div>
                                <div><dt>Test-gated</dt><dd>@v.TestGated</dd></div>
                                @if (v.MayNotBlock > 0) { <div><dt>Tests may not block</dt><dd>@v.MayNotBlock</dd></div> }
                                <div><dt>No gating detected</dt><dd>@v.NoGating</dd></div>
                                @if (v.NotAssessable > 0) { <div><dt>Not assessable</dt><dd>@v.NotAssessable</dd></div> }
                                <div><dt>Post-deployment validation</dt><dd>@(v.PostDeployment == 0 ? "0 detected" : $"{v.PostDeployment} detected")</dd></div>
                            </dl>
                        </li>
                    }
                </ul>
                @if (r.Environments.Count > 0) { <p class="sd-muted">Approval/check evidence: @(r.Metadata.State == "Available" ? "from Azure DevOps metadata (see Environments)" : "not included in this source-only review").</p> }
            </section>

            <dl class="sd-summary prv-kpis" data-testid="pr-summary-cards">
                <div data-testid="pr-summary-card" data-key="pipelines"><dt>Pipelines</dt><dd data-testid="pr-pipeline-count">@runnable.Count</dd></div>
                <div data-testid="pr-summary-card" data-key="deployments"><dt>Deployments</dt><dd>@r.Deployments.Count</dd></div>
                <div data-testid="pr-summary-card" data-key="tests"><dt>Tests/checks</dt><dd>@r.Tests.Count</dd></div>
                <div data-testid="pr-summary-card" data-key="environments"><dt>Environments</dt><dd>@r.Environments.Count</dd></div>
                <div data-testid="pr-summary-card" data-key="findings"><dt>Review findings</dt><dd>@r.Findings.Count</dd></div>
                <div data-testid="pr-summary-card" data-key="artifacts"><dt>Artifacts</dt><dd>@artifacts.Named</dd></div>
            </dl>

            <div class="prv-overview-grid">
                <div>
                    <h3>Artifacts</h3>
                    <dl class="prv-counts" data-testid="pr-artifact-summary">
                        <div><dt>Defined in pipeline source</dt><dd>@artifacts.Named</dd></div>
                        <div><dt>Deployment producer mapped</dt><dd>@artifacts.Resolved</dd></div>
                        <div><dt>Deployment producer unresolved</dt><dd>@artifacts.Unresolved</dd></div>
                        <div><dt>Actual publication</dt><dd>Not verified</dd></div>
                    </dl>
                    <details class="prv-more"><summary>View artifacts</summary>
                        <ul class="prv-chips" data-testid="pr-artifacts">
                            @foreach (var a in runnable.SelectMany(p => p.Artifacts).Distinct(StringComparer.Ordinal)) { <li class="prv-chip prv-chip-artifact"><code>@a</code></li> }
                            @if (!runnable.Any(p => p.Artifacts.Count > 0)) { <li class="prv-chip prv-chip-muted">None detected</li> }
                        </ul>
                        <p class="sd-muted">Defined in the pipeline source; whether they were published in a run needs run evidence.</p>
                    </details>
                </div>
                <div>
                    <h3>Triggers</h3>
                    <ul class="prv-counts" data-testid="pr-trigger-summary">
                        @foreach (var (label, count) in G.TriggerSummary(r)) { <li><span>@label</span> <strong>@count</strong></li> }
                    </ul>
                    <p class="sd-muted">Pipelines per start mode; a pipeline with several triggers counts in each.</p>
                    <details class="prv-more"><summary>View trigger details</summary>
                        <div class="sd-scroll" tabindex="0" role="region" aria-label="Trigger details">
                            <table data-testid="pr-triggers">
                                <thead><tr><th scope="col">Pipeline</th><th scope="col">Starts on</th><th scope="col">PR trigger</th><th scope="col">Path scope</th></tr></thead>
                                <tbody>
                                    @foreach (var p in runnable)
                                    {
                                        var reading = G.ReadTriggers(p);
                                        <tr data-testid="pr-trigger-row" data-pipeline="@p.Id"><th scope="row">@p.Name</th><td>@reading.Starts</td><td>@reading.PullRequest</td>
                                            <td>@reading.PathScope
                                                @if (reading.Paths.Count > 2)
                                                {
                                                    <details class="prv-more"><summary>View paths<span class="visually-hidden"> for @p.Name</span></summary><ul class="sd-list">@foreach (var path in reading.Paths) { <li><code class="sd-path">@path</code></li> }</ul></details>
                                                }
                                            </td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </details>
                </div>
            </div>
        </section>
        <section class="sd-panel" aria-labelledby="pr-probe-h" data-testid="pr-probe">
            <h2 id="pr-probe-h">Will a change to this path be validated?</h2>
            <div class="sd-filterbar">
                <label>Repository path <input type="search" @bind="_probePath" @bind:event="oninput" placeholder="src/Shop.Common/Money.cs" data-testid="pr-probe-path" /></label>
                <button class="btn-primary" @onclick="Probe" disabled="@(_probing || string.IsNullOrWhiteSpace(_probePath))" data-testid="pr-probe-run">Check</button>
            </div>
            @if (_probe is { } probe)
            {
                @if (probe.Pipelines.All(p => p.Triggers == TriggerCoverage.No))
                {
                    <p data-testid="pr-probe-none"><strong>No source-defined validation path found for this repository path.</strong> No matching pipeline trigger/path relationship was detected in the selected source definitions. This does not prove the change is never validated.</p>
                }
                <div class="sd-scroll" tabindex="0" role="region" aria-label="Pipelines started by a change" data-testid="pr-probe-result">
                    <table>
                        <caption class="visually-hidden">Pipelines and validations for a change to @probe.Path</caption>
                        <thead><tr><th scope="col">Pipeline</th><th scope="col">A change to <code>@probe.Path</code></th><th scope="col">Then, before each environment</th></tr></thead>
                        <tbody>
                            @foreach (var p in probe.Pipelines)
                            {
                                <tr data-testid="pr-probe-row" data-coverage="@p.Triggers"><th scope="row">@p.PipelineName</th><td>@P.Coverage(p.Triggers)<span class="sd-context">@Code(p.Basis)</span></td>
                                    <td>@if (p.Triggers == TriggerCoverage.No || p.Deployments.Count == 0) { <span class="sd-muted">—</span> }
                                        else { <ul class="sd-list">@foreach (var d in p.Deployments) { <li><strong>@d.Environment</strong>: @(d.Before.Where(g => g.State is GateState.Gates or GateState.Inherited && g.Category is not (ValidationCategory.Build or ValidationCategory.InfrastructurePlan)).Select(g => PipelineReviewText.Label(g.Category)).Distinct() is var list && list.Any() ? string.Join(", ", list) : "no gating test")</li> }</ul> }</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                <ul class="sd-list">@foreach (var n in probe.Notes) { <li>@n</li> }</ul>
                <p class="sd-muted">Matched from trigger and path definitions — not a claim that a run happened.</p>
            }
        </section>
    };

    private RenderFragment RenderFlow(PipelineReviewResult r) => __builder =>
    {
        var runnable = r.Pipelines.Where(p => !p.IsTemplate).ToList();
        var shown = runnable.Where(p => MatchesFlow(r, p)).ToList();
        <section class="sd-panel" aria-labelledby="pr-map-h" data-testid="pr-map">
            <h2 id="pr-map-h">Delivery flow by pipeline</h2>
            <p class="sd-muted">How a change moves through trigger → build → test → artifact → deploy, one pipeline at a time. Open a pipeline for its stages in execution order. Read from definitions: it shows intended behaviour, not runs.</p>
            <div class="sd-filterbar" data-testid="pr-flow-filters">
                <label>Search pipelines <input type="search" @bind="_flowSearch" @bind:event="oninput" data-testid="pr-flow-search" /></label>
                <label>Environment <select @bind="_flowEnvironment" data-testid="pr-flow-environment"><option value="">All</option>@foreach (var env in r.Environments) { <option value="@env.Environment">@env.Environment</option> }</select></label>
                <label>Trigger <select @bind="_flowTrigger" data-testid="pr-flow-trigger"><option value="">All</option>@foreach (var (label, _) in G.TriggerSummary(r)) { <option value="@label">@label</option> }</select></label>
            </div>
            <p class="sd-muted" role="status" data-testid="pr-flow-count">Showing @shown.Count of @runnable.Count pipelines.</p>
            <ul class="prv-legend" aria-label="Stage types">
                @foreach (var t in Enum.GetValues<FlowNodeType>()) { <li class="prv-node-type prv-type-@t.ToString().ToLowerInvariant()">@D.TypeLabel(t)</li> }
            </ul>
            @foreach (var p in shown)
            {
                var stages = r.Nodes.Where(n => n.Kind == PipelineNodeKind.Stage && n.PipelineId == p.Id).ToList();
                var tests = r.Tests.Count(t => t.Pipeline == p.Id);
                var gaps = r.Findings.Count(f => f.Pipelines.Contains(p.Id) && f.Severity is PipelineFindingSeverity.High or PipelineFindingSeverity.Medium);
                <details class="prv-pipeline" data-testid="pr-flow-pipeline" data-pipeline="@p.Id" open="@(_openPipeline == p.Id)" @ontoggle="e => OnPipelineToggle(p.Id)">
                    <summary>
                        <span class="prv-pipeline-name">@p.Name</span>
                        <span class="prv-pipeline-facts">
                            <span><span class="prv-fact-label">Trigger</span> @string.Join(", ", G.TriggerLabels(p))</span>
                            <span><span class="prv-fact-label">Stages / jobs</span> @p.Stages / @p.Jobs</span>
                            <span><span class="prv-fact-label">Tests</span> @tests</span>
                            <span><span class="prv-fact-label">Artifacts</span> @p.Artifacts.Count</span>
                            <span><span class="prv-fact-label">Deploys to</span> @(p.Environments.Count == 0 ? "—" : string.Join(", ", p.Environments))</span>
                            <span><span class="prv-fact-label">Gate</span> @G.PipelineGate(r, p.Id)</span>
                            @if (r.Deployments.Any(d => d.Pipeline == p.Id)) { <span><span class="prv-fact-label">Post-deploy validation</span> @(r.Deployments.Where(d => d.Pipeline == p.Id).Any(d => d.After.Count > 0) ? "Detected" : "None detected")</span> }
                            <span><span class="prv-fact-label">Status</span> @(gaps == 0 ? "No high/medium finding" : $"Needs review ({gaps})")</span>
                            <span class="prv-open-flow" aria-hidden="true">@(_openPipeline == p.Id ? "Close flow" : "Open flow")</span>
                        </span>
                    </summary>
                    <div role="group" aria-label="@($"Flow map for {p.Name}")" class="pr-map-group prv-map-group">
                        <p class="sd-context">@p.Role · <code>@p.File</code></p>
                        @if (stages.Count == 0)
                        {
                            var steps = D.Steps(r, p.Id);
                            <p class="sd-muted">Single job (no stages).@(steps.Count > 0 ? " Its validation steps in definition order:" : "")</p>
                            @if (steps.Count > 0)
                            {
                                <ol class="prv-flow" aria-label="@($"Validation steps of {p.Name} in definition order")" data-testid="pr-step-flow">
                                    @foreach (var (step, index) in steps.Select((t, i) => (t, i)))
                                    {
                                        var type = D.StepType(step.Categories);
                                        <li class="prv-node prv-type-@type.ToString().ToLowerInvariant()" data-testid="pr-flow-node" data-type="@type">
                                            <span class="prv-node-types"><span class="visually-hidden">Step @(index + 1) of @steps.Count, </span>@foreach (var cat in step.Categories) { <span class="prv-node-type">@PipelineReviewText.Label(cat)</span> }</span>
                                            <span class="prv-node-name">@step.Name</span>
                                            @if (step.Condition is { } c) { <span class="prv-node-meta" title="@c">runs when: @(D.ReadableCondition(c) ?? c)</span> }
                                            @if (step.ContinueOnError) { <span class="prv-node-meta">continues on error</span> }
                                        </li>
                                    }
                                </ol>
                            }
                        }
                        <ol class="pr-map prv-flow" aria-label="@($"Stages of {p.Name} in execution order")">
                            @foreach (var (s, index) in stages.Select((s, i) => (s, i)))
                            {
                                var deps = r.Edges.Where(e => e.Kind == PipelineEdgeKind.DependsOn && e.ToId == s.Id).Select(e => r.Nodes.FirstOrDefault(n => n.Id == e.FromId)?.Label ?? e.FromId).ToList();
                                var deploys = r.Edges.Where(e => e.Kind == PipelineEdgeKind.DeploysTo && e.FromId == s.Id).Select(e => r.Nodes.FirstOrDefault(n => n.Id == e.ToId)?.Label).ToList();
                                var type = D.StageType(r, s);
                                var condition = s.Evidence?.Condition;
                                <li class="prv-node prv-type-@type.ToString().ToLowerInvariant()" data-testid="pr-flow-node" data-type="@type">
                                    <span class="prv-node-type">@D.TypeLabel(type)<span class="visually-hidden"> stage, step @(index + 1) of @stages.Count:</span></span>
                                    <span class="prv-node-name">@s.Label</span>
                                    <span class="prv-node-meta">@(deps.Count == 0 ? "starts first / in parallel" : $"after {string.Join(", ", deps)}")</span>
                                    @if (deploys.Count > 0) { <span class="prv-node-meta">deploys to @string.Join(", ", deploys)</span> }
                                    @if (condition is not null) { <span class="prv-node-meta" title="@condition">runs when: @(D.ReadableCondition(condition) ?? condition)</span> }
                                </li>
                            }
                        </ol>
                        <details class="prv-more"><summary>Technical details<span class="visually-hidden"> for @p.Name</span></summary>
                            <ul class="sd-list">@foreach (var t in p.Triggers) { <li>@t.Kind: @Code(t.Text)</li> }</ul>
                        </details>
                    </div>
                </details>
            }
        </section>
        <section class="sd-panel" aria-labelledby="pr-flow-h" data-testid="pr-flow">
            <details class="prv-more" data-testid="pr-story-details">
                <summary><span id="pr-flow-h">Delivery story — every statement with its evidence (@r.Story.Count)</span></summary>
                <p class="sd-muted">Generated from the pipeline definitions. Each statement shows how sure it is; open the evidence to see where it comes from.</p>
                <ol class="pr-story" data-testid="pr-story">
                    @foreach (var s in r.Story)
                    {
                        <li data-testid="pr-story-step" data-section="@s.Section">
                            <span class="sd-pill sd-pill-muted">@P.Section(s.Section)</span> @Code(s.Text)
                            <span class="@P.StateCss(s.State)">@PipelineReviewText.Label(s.State)</span>
                            @EvidenceButton($"s:{s.Number}", $"step {s.Number}")
                            @if (Open($"s:{s.Number}")) { @EvidenceTable(s.Evidence, s.Detail) }
                        </li>
                    }
                </ol>
            </details>
        </section>
    };

    private string _flowSearch = "", _flowEnvironment = "", _flowTrigger = "";
    private string? _openPipeline;
    /// <summary>One expanded pipeline at a time: opening one closes the previously open one.</summary>
    private void OnPipelineToggle(string id) => _openPipeline = _openPipeline == id ? null : id;
    private bool MatchesFlow(PipelineReviewResult r, ReviewedPipeline p) =>
        (_flowSearch.Trim() is not { Length: > 0 } term || p.Name.Contains(term, StringComparison.OrdinalIgnoreCase) || p.File.Contains(term, StringComparison.OrdinalIgnoreCase)
            || r.Nodes.Any(n => n.PipelineId == p.Id && n.Label.Contains(term, StringComparison.OrdinalIgnoreCase)) || p.Artifacts.Any(a => a.Contains(term, StringComparison.OrdinalIgnoreCase)))
        && (_flowEnvironment.Length == 0 || p.Environments.Contains(_flowEnvironment, StringComparer.OrdinalIgnoreCase)
            || r.Deployments.Any(d => d.Pipeline == p.Id && r.Environments.Any(e => e.Environment == _flowEnvironment && e.Deployments.Contains(d.Id))))
        && (_flowTrigger.Length == 0 || G.TriggerLabels(p).Contains(_flowTrigger));

    private RenderFragment RenderTests(PipelineReviewResult r) => __builder =>
    {
        var m = r.TestMatrix;
        var gates = r.Tests.Select(t => (Test: t, Gate: G.Gate(t, r))).ToList();
        var shown = gates.Where(x => MatchesTest(r, x.Test, x.Gate)).OrderBy(x => G.Priority(x.Gate)).ThenBy(x => x.Test.PipelineName, StringComparer.Ordinal).ToList();
        <section class="sd-panel" aria-labelledby="pr-tests-summary-h" data-testid="pr-tests-summary">
            <h2 id="pr-tests-summary-h">Tests &amp; checks</h2>
            <ul class="prv-counts" data-testid="pr-tests-header">
                <li><span>Defined in pipeline source</span> <strong>@r.Tests.Count</strong></li>
                <li><span>Gate a deployment</span> <strong>@gates.Count(x => x.Gate == TestGateSummary.GatesDeployment)</strong></li>
                <li><span>Conditional or may not block</span> <strong>@gates.Count(x => x.Gate is TestGateSummary.Conditional or TestGateSummary.MayNotBlock)</strong></li>
                <li><span>Not associated with a deployment</span> <strong>@gates.Count(x => x.Gate == TestGateSummary.NotAssociated)</strong></li>
                <li><span>Runtime execution/results</span> <strong>Not assessed from source</strong></li>
            </ul>
            <p class="prv-key-point" data-testid="pr-tests-distinction"><strong>A test that exists is not a test that gates deployment.</strong> A test step in a pipeline only stops a deployment when the deployment depends on it and a failure is not tolerated. Whether a test actually ran or passed needs run results.</p>
            <ul class="prv-counts" data-testid="pr-gate-counts">
                @foreach (var gate in Enum.GetValues<TestGateSummary>())
                {
                    var count = gates.Count(x => x.Gate == gate);
                    if (count > 0) { <li data-gate="@gate"><span>@G.Label(gate)</span> <strong>@count</strong></li> }
                }
            </ul>
        </section>
        <section class="sd-panel" aria-labelledby="pr-matrix-h" data-testid="pr-tests">
            <h2 id="pr-matrix-h">Test gating matrix</h2>
            <p class="sd-muted">Validation by environment. Each cell states its gate in words.</p>
            <details class="prv-more" data-testid="pr-gating-help"><summary>How gating is determined</summary>
                <dl class="sd-facts">
                    <div><dt>Gates</dt><dd>A failure can block the path according to source dependencies and conditions.</dd></div>
                    <div><dt>Conditional</dt><dd>May gate, depending on a source condition.</dd></div>
                    <div><dt>Runs after</dt><dd>Validation occurs after deployment.</dd></div>
                    <div><dt>Not detected</dt><dd>No matching source-defined check was found.</dd></div>
                    <div><dt>Not assessable</dt><dd>The source definitions are insufficient.</dd></div>
                    <div><dt>PR</dt><dd>Whether a PR check blocks merging can depend on Azure DevOps branch policies, which are not visible in YAML-only analysis.</dd></div>
                </dl>
            </details>
            <div class="sd-scroll" tabindex="0" role="region" aria-label="Test gating matrix">
                <table data-testid="pr-matrix">
                    <caption class="visually-hidden">Validations by environment</caption>
                    <thead><tr><th scope="col">Validation</th>@foreach (var c in m.Columns) { <th scope="col">@c</th> }</tr></thead>
                    <tbody>
                        @foreach (var row in m.Rows)
                        {
                            <tr data-testid="pr-matrix-row"><th scope="row">@PipelineReviewText.Label(row.Category)@if (row.Note is { } note) { <span class="sd-context">@note</span> }</th>
                                @foreach (var c in m.Columns)
                                {
                                    var (symbol, text) = P.Cell(row.Cells.GetValueOrDefault(c));
                                    <td data-state="@(row.Cells.GetValueOrDefault(c)?.ToString() ?? "None")"><span aria-hidden="true">@symbol</span> <span class="pr-cell-text">@text</span></td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <ul class="sd-list">@foreach (var n in m.Notes) { <li>@n</li> }</ul>
            <h2>Tests and checks in pipelines</h2>
            <p class="sd-muted" data-testid="pr-tests-defined">Status of every row: <span class="sd-pill sd-pill-muted">Defined</span> — the pipeline intends to run it. Sorted with what may let a deployment through first.</p>
            <div class="sd-filterbar" data-testid="pr-test-filters">
                <label>Pipeline <select @bind="_testPipeline" data-testid="pr-test-pipeline"><option value="">All pipelines</option>@foreach (var p in r.Tests.Select(t => t.Pipeline).Distinct().OrderBy(PipelineName)) { <option value="@p">@PipelineName(p)</option> }</select></label>
                <label>Environment <select @bind="_testEnvironment" data-testid="pr-test-environment"><option value="">All environments</option>@foreach (var env in r.Environments) { <option value="@env.Environment">@env.Environment</option> }</select></label>
                <label>Gate state <select @bind="_testGate" data-testid="pr-test-gate"><option value="">All</option><option value="review">Needs review</option>@foreach (var gate in Enum.GetValues<TestGateSummary>()) { <option value="@gate">@G.Label(gate)</option> }</select></label>
                <label>Test type <select @bind="_testType" data-testid="pr-test-type"><option value="">All types</option>@foreach (var c in r.Tests.Select(t => t.Category).Distinct().Order()) { <option value="@c">@PipelineReviewText.Label(c)</option> }</select></label>
                <label>Search <input type="search" @bind="_testSearch" @bind:event="oninput" data-testid="pr-test-search" /></label>
            </div>
            <p class="sd-muted" role="status" data-testid="pr-test-count">Showing @shown.Count of @r.Tests.Count tests and checks.</p>
            <div class="sd-scroll" tabindex="0" role="region" aria-label="Tests in pipelines">
                <table data-testid="pr-test-table">
                    <thead><tr><th scope="col">Test / check</th><th scope="col">Pipeline / stage</th><th scope="col">Gate state</th><th scope="col">Environment</th><th scope="col">Evidence</th></tr></thead>
                    <tbody>
                        @foreach (var (t, gate) in shown)
                        {
                            var key = $"t:{t.Evidence.File}:{t.Evidence.Line}:{t.Category}";
                            <tr data-testid="pr-test-row" data-gate="@gate"><th scope="row">@PipelineReviewText.Label(t.Category)@if (t.Category is ValidationCategory.Security or ValidationCategory.DependencyScan) { <span class="prv-subtype" data-testid="pr-test-subtype"> · @t.Name</span> }<span class="sd-context">@t.Name · <code>@t.Tool</code>@(t.Targets.Count > 0 ? $" · {string.Join(", ", t.Targets)}" : "")</span>
                                    @if (t.Script is { } script)
                                    {
                                        <span class="sd-context" data-testid="pr-test-infra">Runs <code>@script</code> · @t.ScriptPurpose@(t.InfrastructureChecks.Count > 0 ? $" · checks: {string.Join(", ", t.InfrastructureChecks)}" : "") · @t.ScriptGate · not executed by analysis</span>
                                    }</th>
                                <td>@t.PipelineName<span class="sd-context">@(t.Stage ?? t.Job)</span></td>
                                <td><span class="sd-pill @(gate == TestGateSummary.GatesDeployment ? "sd-pill-complete" : gate is TestGateSummary.MayNotBlock or TestGateSummary.Conditional ? "sd-pill-partial" : "sd-pill-muted")">@G.Label(gate)</span>@if (t.ContinueOnError) { <span class="sd-pill sd-pill-partial">continueOnError</span> }</td>
                                <td>@(t.Gates.Count == 0 ? t.RunsAfter.Count > 0 ? $"Runs after {string.Join(", ", t.RunsAfter.Select(id => EnvName(r, id)).Distinct())}" : "Does not gate a deployment" : string.Join(", ", t.Gates.Select(id => EnvName(r, id)).Distinct()))</td>
                                <td>@EvidenceButton(key, t.Name)</td></tr>
                            @if (Open(key))
                            {
                                <tr><td colspan="5">
                                    <p class="sd-muted">When it runs: @Code(t.WhenItRuns)@if (D.ReadableCondition(t.Condition) is { } readable) { <span class="sd-context" data-testid="pr-test-condition" title="@t.Condition">Runs when: @readable</span> }</p>
                                    @EvidenceTable([t.Evidence])
                                </td></tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
        @if (r.DependencyAutomation.Count > 0)
        {
            <section class="sd-panel" aria-labelledby="pr-deps-h" data-testid="pr-dependency-automation">
                <h2 id="pr-deps-h">Dependency automation in pipelines</h2>
                <p class="sd-muted">Restore, dependency/security scans, SBOM generation, package publication and update automation as configured in source. Configured is not passed: results need run evidence.</p>
                <ul class="sd-list" data-testid="pr-dependency-summary">
                    @foreach (var g in r.DependencyAutomation.GroupBy(d => d.Kind))
                    {
                        <li data-testid="pr-dependency-kind" data-kind="@g.Key"><strong>@g.Key</strong> · @g.Count() step(s) in @g.Select(d => d.Pipeline).Distinct().Count() pipeline(s) ·
                            @string.Join(", ", g.GroupBy(d => d.State).Select(s => $"{s.Key} {s.Count()}"))<span class="sd-context">@g.First().Detail</span></li>
                    }
                </ul>
                <ReviewDisclosure Text="@($"View all {r.DependencyAutomation.Count} steps")" CollapseText="Hide steps" TestId="pr-dependency-steps" Class="disclosure-inline">
                    <div class="sd-scroll" tabindex="0" role="region" aria-label="Dependency automation steps">
                        <table>
                            <thead><tr><th scope="col">Capability</th><th scope="col">Pipeline / step</th><th scope="col">State</th><th scope="col">Detail</th></tr></thead>
                            <tbody>@foreach (var d in r.DependencyAutomation) { <tr data-testid="pr-dependency-item"><th scope="row">@d.Kind</th><td>@d.Pipeline<span class="sd-context">@(d.Stage is { } st ? $"{st} · " : "")@d.Step</span></td><td><span class="sd-pill sd-pill-muted">@d.State</span></td><td>@d.Detail</td></tr> }</tbody>
                        </table>
                    </div>
                </ReviewDisclosure>
            </section>
        }
    };

    private string _testPipeline = "", _testEnvironment = "", _testGate = "", _testType = "", _testSearch = "";
    private bool _testDefaultApplied;

    /// <summary>The test list opens on the review-worthy subset when there is one; All stays one choice away.</summary>
    private void ApplyTestDefault(PipelineReviewResult r)
    {
        if (_testDefaultApplied) return;
        _testDefaultApplied = true;
        if (r.Tests.Any(t => G.Gate(t, r) is TestGateSummary.MayNotBlock or TestGateSummary.Conditional or TestGateSummary.NotAssessable)) _testGate = "review";
    }
    private bool MatchesTest(PipelineReviewResult r, ReviewedTest t, TestGateSummary gate) =>
        (_testPipeline.Length == 0 || t.Pipeline == _testPipeline)
        && (_testGate.Length == 0 || gate.ToString() == _testGate || _testGate == "review" && gate is TestGateSummary.MayNotBlock or TestGateSummary.Conditional or TestGateSummary.NotAssessable)
        && (_testType.Length == 0 || t.Category.ToString() == _testType)
        && (_testEnvironment.Length == 0 || t.Gates.Concat(t.RunsAfter).Any(id => r.Environments.Any(e => e.Environment == _testEnvironment && e.Deployments.Contains(id))))
        && (_testSearch.Trim() is not { Length: > 0 } term || t.Name.Contains(term, StringComparison.OrdinalIgnoreCase) || t.PipelineName.Contains(term, StringComparison.OrdinalIgnoreCase)
            || (t.Stage ?? t.Job ?? "").Contains(term, StringComparison.OrdinalIgnoreCase) || t.Tool.Contains(term, StringComparison.OrdinalIgnoreCase));

    private RenderFragment RenderEnvironments(PipelineReviewResult r) => __builder =>
    {
        var summaries = G.Environments(r);
        var deployments = r.Deployments.Where(d => _envFilter.Length == 0 || r.Environments.Any(e => e.Environment == _envFilter && e.Deployments.Contains(d.Id)))
            .Where(d => _envStatus.Length == 0 || G.Gating(d).ToString() == _envStatus).ToList();
        <section class="sd-panel" aria-labelledby="pr-env-h" data-testid="pr-environments">
            <h2 id="pr-env-h">Environments</h2>
            <p class="sd-muted">How each environment is reached and what protects it, from the pipeline definitions.</p>
            @if (r.Metadata.State != "Available")
            {
                <p class="prv-scope-banner" data-testid="pr-approval-notice"><strong>Approval/check metadata not included.</strong> Azure DevOps environment approvals and checks live outside YAML and are not part of this source-only review.</p>
            }
            <ul class="prv-env-cards" data-testid="pr-env-summary">
                @foreach (var s in summaries)
                {
                    <li class="prv-env-card" data-testid="pr-env-card" data-environment="@s.Environment">
                        <h3>@s.Environment</h3>
                        <dl class="prv-counts">
                            <div><dt>Deployments</dt><dd>@s.Deployments</dd></div>
                            <div><dt>Gated by tests</dt><dd>@s.Gated</dd></div>
                            @if (s.MayNotBlock > 0) { <div><dt>Tests may not block</dt><dd>@s.MayNotBlock</dd></div> }
                            <div><dt>No gating test detected</dt><dd>@s.NoGatingTest</dd></div>
                            @if (s.NotAssessable > 0) { <div><dt>Not assessable</dt><dd>@s.NotAssessable</dd></div> }
                            <div><dt>With post-deployment validation</dt><dd>@s.WithPostValidation</dd></div>
                        </dl>
                    </li>
                }
            </ul>
            <h3>Environment progression</h3>
            @if (r.Progression.Count == 0) { <p class="sd-muted" data-testid="pr-no-progression"><strong>No source relationship detected between environments.</strong> No dependency, pipeline trigger, promoted artifact or other supported source relationship connects the environments in this snapshot. This does not prove promotion does not occur outside source.</p> }
            <ul class="sd-list" data-testid="pr-progression">
                @foreach (var s in r.Progression) { <li>@s.From → @s.To <span class="@P.StateCss(s.State)">@PipelineReviewText.Label(s.State)</span> <span class="sd-context">@Code(s.Basis)</span></li> }
            </ul>
            <h3>Deployments <span class="sd-count">@r.Deployments.Count</span></h3>
            <div class="sd-filterbar" data-testid="pr-env-filters">
                <label>Environment <select @bind="_envFilter" data-testid="pr-env-filter"><option value="">All environments</option>@foreach (var env in r.Environments) { <option value="@env.Environment">@env.Environment</option> }</select></label>
                <label>Status <select @bind="_envStatus" data-testid="pr-env-status"><option value="">All</option>@foreach (var g in Enum.GetValues<DeploymentGating>()) { <option value="@g">@G.Label(g)</option> }</select></label>
            </div>
            <div class="sd-scroll" tabindex="0" role="region" aria-label="Deployments">
                <table class="prv-deployments" data-testid="pr-deployment-table">
                    <thead><tr><th scope="col">Deployment</th><th scope="col">Environment</th><th scope="col">Validation before</th><th scope="col">Validation after</th><th scope="col">Artifact</th><th scope="col">Approval/check evidence</th><th scope="col">Rollback</th><th scope="col">Status</th></tr></thead>
                    @foreach (var d in deployments)
                    {
                        var env = r.Environments.FirstOrDefault(e => e.Deployments.Contains(d.Id))?.Environment ?? d.Environment;
                        var gating = G.Gating(d);
                        <tbody data-testid="pr-deployment" data-gating="@gating">
                            <tr>
                                <th scope="row">@d.PipelineName<span class="sd-context"><code>@(d.Stage ?? d.Job)</code> · @string.Join(", ", d.DeploysWhat)</span></th>
                                <td>@env</td>
                                <td>@(d.Before.Count == 0 ? "No validation detected" : G.Label(gating))</td>
                                <td>@(d.After.Count == 0 ? "None detected" : string.Join(", ", d.After.Select(g => PipelineReviewText.Label(g.Category)).Distinct()))</td>
                                <td>@(d.Artifacts.Count == 0 ? "—" : $"{d.Artifacts.Count} ({d.Artifacts.Count(a => a.State == ArchitectureEvidenceState.Unresolved)} unresolved)")</td>
                                <td>@(G.ApprovalLabel(d.Approval) is var approval && approval == "Runtime metadata required" ? "Not included" : approval)</td>
                                <td>@(G.RollbackLabel(d.Rollback) is var rollback && rollback == "Not detected in source" ? "Rollback not detected in source" : rollback)</td>
                                <td><span class="sd-pill @(gating == DeploymentGating.Gated ? "sd-pill-complete" : gating == DeploymentGating.NotAssessable ? "sd-pill-muted" : "sd-pill-partial")">@G.Label(gating)</span></td>
                            </tr>
                            <tr class="prv-deployment-details">
                                <td colspan="8">
                                    <details><summary>Details<span class="visually-hidden"> for @d.PipelineName @env</span></summary>
                                        <dl class="sd-facts">
                                            <div><dt>Deploys</dt><dd>@string.Join(", ", d.DeploysWhat) to <code>@d.Environment</code> (@d.EnvironmentBasis)</dd></div>
                                            <div><dt>How reached</dt><dd>@Code(d.HowReached)</dd></div>
                                            <div><dt>Before deployment</dt><dd>@if (d.Before.Count == 0) { <span>No validation detected</span> } @foreach (var g in d.Before.DistinctBy(g => (g.Category, g.State))) { <span class="@P.GateCss(g.State)">@PipelineReviewText.Label(g.Category): @PipelineReviewText.Label(g.State)</span> }</dd></div>
                                            <div><dt>After deployment</dt><dd>@(d.After.Count == 0 ? "No post-deployment validation detected" : string.Join(", ", d.After.Select(g => PipelineReviewText.Label(g.Category)).Distinct()))</dd></div>
                                            <div><dt>Artifact</dt><dd>@foreach (var a in d.Artifacts) { <span>@Code($"`{a.Artifact}` from {a.Source}") <span class="@P.StateCss(a.State)">@PipelineReviewText.Label(a.State)</span> <span class="sd-context">@Code(a.Basis)</span></span> }</dd></div>
                                            <div><dt>Approval</dt><dd>@Code(d.Approval)</dd></div>
                                            <div><dt>Rollback</dt><dd>@Code(d.Rollback)</dd></div>
                                            @if (d.Unresolved.Count > 0) { <div><dt>Unresolved</dt><dd><ul class="sd-list">@foreach (var u in d.Unresolved) { <li>@Code(u)</li> }</ul></dd></div> }
                                        </dl>
                                        @EvidenceButton($"d:{d.Id}", $"{d.PipelineName} {d.Environment}")
                                        @if (Open($"d:{d.Id}")) { @EvidenceTable([d.Evidence, .. d.Before.Select(g => g.Evidence), .. d.After.Select(g => g.Evidence)]) }
                                    </details>
                                </td>
                            </tr>
                        </tbody>
                    }
                </table>
            </div>
        </section>
    };

    private string _envFilter = "", _envStatus = "";

    private RenderFragment RenderDependencies(PipelineReviewResult r) => __builder =>
    {
        string Name(string id) => r.Pipelines.FirstOrDefault(p => p.Id == id)?.Name ?? id;
        var relationships = r.Dependencies.Where(d => (_depKind.Length == 0 || d.Kind.ToString() == _depKind)
            && (_depPipeline.Length == 0 || d.FromPipeline == _depPipeline || d.ToPipeline == _depPipeline)).ToList();
        <section class="sd-panel" aria-labelledby="pr-dep-h" data-testid="pr-dependencies">
            <h2 id="pr-dep-h">Pipelines</h2>
            <p class="sd-muted">How each pipeline starts. "Manual" means no push, pull-request, schedule or pipeline trigger is active. Exact trigger syntax is under each pipeline's details.</p>
            <div class="sd-scroll" tabindex="0" role="region" aria-label="Pipelines">
                <table data-testid="pr-pipelines">
                    <thead><tr><th scope="col">Pipeline</th><th scope="col">Role</th><th scope="col">Starts on</th><th scope="col">Environments</th></tr></thead>
                    <tbody>
                        @foreach (var p in r.Pipelines.OrderBy(p => p.IsTemplate))
                        {
                            <tr data-testid="pr-pipeline-row"><th scope="row">@p.Name<span class="sd-context">@(p.DefinitionName is { } dn ? $"Azure DevOps: {dn}" : "")</span></th><td>@p.Role</td>
                                <td>@if (p.IsTemplate) { <span>—</span> }
                                    else
                                    {
                                        <ul class="prv-trigger-labels">@foreach (var label in G.TriggerLabels(p)) { <li class="sd-pill sd-pill-muted">@label</li> }</ul>
                                        <details class="prv-more"><summary>Trigger details<span class="visually-hidden"> for @p.Name</span></summary>
                                            <ul class="sd-list">@foreach (var t in p.Triggers) { <li>@Code(t.Text)</li> }</ul>
                                            <p class="sd-context"><code>@p.File</code></p>
                                        </details>
                                    }</td>
                                <td>@string.Join(", ", p.Environments)</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
        <section class="sd-panel" aria-labelledby="pr-rel-h" data-testid="pr-relationship-section">
            <h2 id="pr-rel-h">Relationships between pipelines <span class="sd-count">@r.Dependencies.Count</span></h2>
            <p class="sd-muted">Triggers, artifact consumption, template inclusion and "likely follows" are kept apart: consuming another pipeline's artifact does not mean that pipeline starts this one.</p>
            <div class="sd-filterbar" data-testid="pr-dep-filters">
                <label>Relationship <select @bind="_depKind" data-testid="pr-dep-kind"><option value="">All relationships</option>@foreach (var k in r.Dependencies.Select(d => d.Kind).Distinct().Order()) { <option value="@k">@PipelineReviewText.Label(k)</option> }</select></label>
                <label>Pipeline <select @bind="_depPipeline" data-testid="pr-dep-pipeline"><option value="">All pipelines</option>@foreach (var id in r.Dependencies.SelectMany(d => new[] { d.FromPipeline, d.ToPipeline }).Distinct().OrderBy(Name)) { <option value="@id">@Name(id)</option> }</select></label>
            </div>
            <div class="sd-scroll" tabindex="0" role="region" aria-label="Pipeline relationships">
                <table data-testid="pr-relationships">
                    <thead><tr><th scope="col">From</th><th scope="col">Relationship</th><th scope="col">To</th><th scope="col">Evidence</th></tr></thead>
                    <tbody>
                        @foreach (var d in relationships)
                        {
                            <tr data-testid="pr-relationship" data-kind="@d.Kind"><th scope="row">@Name(d.FromPipeline)</th><td>@PipelineReviewText.Label(d.Kind)<span class="sd-context">@Code(d.Basis)</span></td><td>@Name(d.ToPipeline)</td><td><span class="@P.StateCss(d.State)">@PipelineReviewText.Label(d.State)</span></td></tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (r.UnresolvedTemplates.Count > 0)
            {
                <h3>Templates not analyzed</h3>
                <ul class="sd-list" data-testid="pr-unresolved-templates">@foreach (var u in r.UnresolvedTemplates) { <li><code>@u.Template</code> (@u.Level in @Name(u.Pipeline)): @u.Reason</li> }</ul>
            }
        </section>
        <section class="sd-panel" aria-labelledby="pr-cov-h">
            <details class="prv-more" data-testid="pr-coverage-details">
                <summary><span id="pr-cov-h">Source areas and the pipelines they start (@r.PathCoverage.Count)</span></summary>
                <div class="sd-scroll" tabindex="0" role="region" aria-label="Path coverage">
                    <table data-testid="pr-coverage">
                        <thead><tr><th scope="col">Source area</th><th scope="col">Pipelines (does a change start it?)</th></tr></thead>
                        <tbody>
                            @foreach (var row in r.PathCoverage)
                            {
                                <tr data-testid="pr-coverage-row"><th scope="row">@row.Area<span class="sd-context">@row.AreaKind · <code>@row.Path</code></span></th>
                                    <td>@if (row.Pipelines.Count == 0) { <span>@row.Basis</span> } else { <ul class="sd-list">@foreach (var c in row.Pipelines) { <li><strong>@Name(c.Pipeline)</strong>: @P.Coverage(c.Triggers)@(c.Validations.Count > 0 ? $" · tests: {string.Join(", ", c.Validations.Select(PipelineReviewText.Label))}" : "")<span class="sd-context">@Code(c.Basis)</span></li> }</ul> }</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </details>
        </section>
    };

    private string _depKind = "", _depPipeline = "";
    private string _fileSearch = "";

    private RenderFragment RenderChanges(PipelineReviewResult r) => __builder =>
    {
        <section class="sd-panel" aria-labelledby="pr-changes-h" data-testid="pr-changes">
            <h2 id="pr-changes-h">Pipeline changes</h2>
            <p class="sd-muted" data-testid="pr-changes-purpose">Pipeline changes compares two immutable Source Analysis snapshots. It detects source-definition changes in pipelines, triggers, tests/checks, gating, deployments, artifacts and templates. It does not compare runtime execution outcomes, deployment success/failure or Azure DevOps approval history.</p>
            @if (_sources.Snapshots.Count < 2) { <p class="sd-empty" data-testid="pr-compare-empty">Select another Source Analysis snapshot to compare pipeline definitions. Only one Source Analysis snapshot exists for this Target Environment; analyze a newer or older archive in Source Analysis first.</p> }
            else
            {
                <div class="sd-filterbar">
                    <span class="prv-current" data-testid="pr-compare-current">Current: <strong>@(Selected is { } current ? D.SourceName(current) : "—")</strong></span>
                    <label>Compare with
                        <select value="@(_previousId?.ToString() ?? "")" @onchange="e => _previousId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null" data-testid="pr-compare-previous">
                            @* Without an earlier snapshot nothing is preselected: show that, instead of an option that looks selected but is not. *@
                            @if (_previousId is null) { <option value="">Choose a snapshot</option> }
                            @foreach (var s in _sources.Snapshots.Where(s => s.Id != _snapshotId).OrderByDescending(s => s.AnalyzedAt)) { <option value="@s.Id">@s.ArchiveName · @P.Utc(s.AnalyzedAt)</option> }
                        </select>
                    </label>
                    <button class="btn-primary" @onclick="Compare" disabled="@(_comparing || _previousId is null)" data-testid="pr-compare">Compare</button>
                </div>
                @if (_previousId is { } previous && _sources.Snapshots.FirstOrDefault(s => s.Id == previous) is { } other && Selected is { } currentSource && D.SourceName(other) != D.SourceName(currentSource))
                {
                    <p class="prv-scope-banner" data-testid="pr-compare-unrelated">The selected snapshot is from a different source (@D.SourceName(other)); the comparison may mostly show added and removed pipelines rather than meaningful changes.</p>
                }
                @if (_comparison is null) { <p class="sd-muted" data-testid="pr-compare-hint">Choose the snapshot to compare with, then Compare. Changes are grouped by kind: pipelines, triggers, tests and gates, deployments, artifacts and templates.</p> }
                @if (_comparison is { } c)
                {
                    @if (c.Changes.Count == 0) { <p class="sd-muted" data-testid="pr-no-changes">No pipeline definition change between the two snapshots.</p> }
                    else
                    {
                        <ul class="prv-counts" data-testid="pr-change-summary">
                            @foreach (var group in G.ChangeGroups.Where(g => c.Changes.Any(ch => G.ChangeGroup(ch.Kind) == g)))
                            {
                                var inGroup = c.Changes.Where(ch => G.ChangeGroup(ch.Kind) == group).ToList();
                                <li data-group="@group"><span>@group</span> <strong>@string.Join(" · ", inGroup.GroupBy(ch => G.ChangeAction(ch.Kind)).Select(a => $"{a.Count()} {a.Key.ToLowerInvariant()}"))</strong></li>
                            }
                        </ul>
                        <div class="sd-scroll" tabindex="0" role="region" aria-label="Pipeline changes">
                            <table data-testid="pr-change-table">
                                <thead><tr><th scope="col">Change</th><th scope="col">Pipeline</th><th scope="col">Detail</th><th scope="col">What it may mean</th></tr></thead>
                                <tbody>
                                    @foreach (var ch in c.Changes.OrderBy(ch => G.ChangeGroups.ToList().IndexOf(G.ChangeGroup(ch.Kind))).ThenBy(ch => ch.Severity ?? PipelineFindingSeverity.Info))
                                    {
                                        <tr data-testid="pr-change" data-kind="@ch.Kind"><th scope="row">@G.ChangeKind(ch.Kind)</th><td>@ch.Pipeline</td><td>@Code(ch.Detail)</td>
                                            <td>@if (ch.Severity is { } sev) { <span class="@P.SeverityCss(sev)">@sev</span> } @(ch.Interpretation ?? "")</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            }
        </section>
    };
}
