@page "/implementation-review"
@using System.Security.Cryptography
@using System.Text
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@inject IReviewContextProvider ContextProvider
@inject IWorkspaceSessionService Artifacts
@inject IWorkspaceAutoSaveService AutoSave
@inject ISddEvidenceApiService SddEvidenceApi
@inject SddEvidenceGraphService EvidenceGraph

<PageTitle>Implementation Evidence Review</PageTitle>
<main class="sdd-review">
    <PageHeader Title="Implementation Evidence Review"
                Description="Trace current documented requirements to plan, tasks, source evidence and tests. This review uses shared workspace evidence; it does not inspect pasted code or claim runtime verification." />

    <section class="summary" aria-label="Review summary">
        <div><strong>@Requirements.Count</strong><span>documented requirements</span></div>
        <div><strong>@PlanLinkedCount</strong><span>with plan links</span></div>
        <div><strong>@TaskLinkedCount</strong><span>with task links</span></div>
        <div><strong>@Artifacts.SddLifecycle.ImplementationEvidence.Count</strong><span>registered implementation evidence</span></div>
        <div><strong>@Artifacts.SddLifecycle.TestEvidence.Count</strong><span>registered test evidence</span></div>
    </section>
    <section aria-label="Lifecycle projection">
        <h2>Evidence projection</h2>
        <label for="implementation-projection">View</label>
        <select id="implementation-projection" @bind="_projectionMode">
            <option value="ActiveWorkspace">Active workspace</option>
            <option value="AuthoritativeBaseline">Authoritative baseline</option>
            <option value="HistoricalBaseline">Historical baseline</option>
        </select>
        @if (_projectionMode == nameof(LifecycleProjectionMode.HistoricalBaseline))
        {
            <label for="implementation-baseline">Baseline revision set</label>
            <select id="implementation-baseline" @bind="_historicalBaselineId"><option value="">Select a baseline</option>@foreach (var item in Artifacts.SddLifecycle.Baselines) { <option value="@item.BaselineId">@item.Label · @item.CreatedAt.ToLocalTime().ToString("g") · @item.Status</option> }</select>
        }
        <p role="status">View: @Projection.Metadata.Mode@(Projection.Metadata.BaselineId is { } baselineId ? $" — {Artifacts.SddLifecycle.Baselines.FirstOrDefault(x => x.BaselineId == baselineId)?.Label ?? "baseline"}" : "")</p>
        @foreach (var limitation in Projection.Metadata.Limitations) { <p class="note">@limitation</p> }
    </section>

    @if (!Artifacts.Has(WorkspaceArtifactType.Specification))
    {
        <p class="notice">Specification evidence is not available. Source and other reviews remain independent of SDD.</p>
    }
    @if (HasFailedSource)
    {
        <p class="notice">Source Analysis is unsupported for this evidence: the selected analysis failed. Implementation is not assessed.</p>
    }
    else if (!HasSource)
    {
        <p class="notice">Source Analysis linkage: Not available to this review. Documented requirements remain documented; implementation is not assessed.</p>
    }

    <section>
        <h2>Requirements and evidence</h2>
        @if (Requirements.Count == 0)
        {
            <p>No current requirements were extracted from the selected specification.</p>
        }
        else
        {
            <div class="table-wrap"><table>
                <thead><tr><th>Requirement</th><th>Plan</th><th>Tasks</th><th>Implementation evidence</th><th>Test evidence</th><th>Assessment</th></tr></thead>
                <tbody>
                @foreach (var requirement in Requirements)
                {
                    var graphRow = GraphRows.FirstOrDefault(x => x.Requirement.Id.Equals(requirement.Id, StringComparison.OrdinalIgnoreCase));
                    var implementation = graphRow?.Implementation.ToList() ?? [];
                    var tests = graphRow?.DesignedTests.ToList() ?? [];
                    var executions = graphRow?.Executions ?? [];
                    <tr>
                        <th scope="row"><strong>@requirement.Id</strong><span>@requirement.Text</span></th>
                        <td>@PlanLinks(requirement.Id)</td>
                        <td>@TaskLinks(requirement.Id)</td>
                        <td>@(implementation.Count == 0 ? "No implementation evidence" : string.Join(", ", implementation.Select(x => $"{x.EvidenceType} ({x.Confidence}; {x.Currentness})")))</td>
                        <td>@(tests.Count == 0 ? "No test design" : string.Join(", ", tests.Select(x => $"{x.State} ({x.Currentness})")))<br />@(executions.Count == 0 ? "Not executed" : string.Join(", ", executions.Select(x => $"{x.ExecutionState}/{x.Result} ({x.Currentness})")))</td>
                        <td>@Assessment(implementation)</td>
                    </tr>
                }
                </tbody>
            </table></div>
        }
        <p class="note">Plan/task links are derived from current parsed documents. A task marked complete, a test that exists, or a source file name is not implementation or pass evidence.</p>
    </section>

    <section>
        <h2>Clarifications</h2>
        @if (Clarifications.Count == 0) { <p>No clarification questions were extracted.</p> }
        @foreach (var item in Clarifications)
        {
            var key = QuestionKey(item);
            var state = Artifacts.SddLifecycle.Questions.FirstOrDefault(x => x.Id == key);
            <article class="question">
                <h3>@(item.Id ?? key): @item.Question</h3>
                @if (!string.IsNullOrWhiteSpace(item.Answer)) { <p>Documented answer: @item.Answer</p> }
                <p>Status: <strong>@(state?.Status ?? "Open — explicit resolution not recorded")</strong></p>
                @if (state?.Status != "Resolved")
                {
                    <label for="resolution-@key">Resolution</label>
                    <input id="resolution-@key" @bind="_resolutions[key]" />
                    <label for="resolution-ref-@key">Authoritative decision/reference</label>
                    <input id="resolution-ref-@key" @bind="_resolutionRefs[key]" />
                    <button @onclick="() => ResolveQuestionAsync(item)">Record explicit resolution</button>
                }
                else { <p>Resolution: @state.Resolution <span>(@state.ResolutionReference)</span></p> }
            </article>
        }
    </section>

    <section>
        <h2>Artifact authority and history</h2>
        <p>Revision order records content changes. It does not select authority. Set a baseline explicitly; a newer draft remains non-authoritative.</p>
        <label for="baseline-label">Baseline label</label><input id="baseline-label" @bind="_baselineLabel" placeholder="Release 1" />
        <button @onclick="CaptureBaselineAsync" disabled="@(!Artifacts.SddLifecycle.Revisions.Any(x => x.Authority == "Baseline"))">Capture selected baseline revisions</button>
        @foreach (var baseline in Artifacts.SddLifecycle.Baselines.OrderByDescending(x => x.CreatedAt))
        { <p>@baseline.Label · @baseline.Status · @baseline.ArtifactRevisionIds.Count artifact revision(s) · @baseline.CreatedAt.ToLocalTime().ToString("g")</p> }
        @foreach (var group in Artifacts.SddLifecycle.Revisions.GroupBy(x => x.Role).OrderBy(x => x.Key))
        {
            <h3>@group.Key</h3>
            <div class="table-wrap"><table><thead><tr><th>Revision</th><th>Authority</th><th>Selection</th><th>Fingerprint</th><th>Captured</th><th>Action</th></tr></thead><tbody>
            @foreach (var revision in group.OrderByDescending(x => x.Revision))
            {
                <tr><td>@revision.Revision</td><td>
                    <select aria-label="Authority for @group.Key revision @revision.Revision" value="@revision.Authority" @onchange="e => SetAuthorityAsync(revision.RevisionId, e.Value?.ToString())">
                        @foreach (var value in AuthorityValues) { <option value="@value" disabled="@(revision.IsCurrentSelection && value == "Superseded")">@value</option> }
                    </select>
                </td><td>@(revision.IsCurrentSelection ? "Current selection" : "Historical")</td><td><code>@revision.Fingerprint[..Math.Min(12, revision.Fingerprint.Length)]</code></td><td>@revision.CapturedAt.ToLocalTime().ToString("g")</td><td>
                    @if (!revision.IsCurrentSelection && group.Any(x => x.IsCurrentSelection))
                    { <button class="secondary" @onclick="() => SupersedeAsync(revision, group.First(x => x.IsCurrentSelection))">Mark superseded by current selection</button> }
                </td></tr>
            }
            </tbody></table></div>
        }
    </section>

    <section>
        <h2>Change and traceability history</h2>
        @if (Artifacts.SddLifecycle.RequirementChanges.Count == 0) { <p>No requirement changes recorded yet. Record a review to compare the current requirement revision with its previous observed revision.</p> }
        @foreach (var change in Artifacts.SddLifecycle.RequirementChanges.OrderByDescending(x => x.DetectedAt))
        { <p><strong>@change.RequirementId — @change.Change</strong> @change.ChangeDetail <span>(@change.DetectedAt.ToLocalTime().ToString("g"))</span></p> }
        @foreach (var link in Artifacts.SddLifecycle.Links.OrderBy(x => x.Currentness).ThenBy(x => x.FromId))
        {
            <p><strong>@link.Currentness:</strong> @link.FromId → @link.ToId (@link.Relationship, @link.Confidence, @link.Provenance) @link.Reason
                @if (link.Currentness == "PotentiallyStale") { <button class="secondary" @onclick="() => ReconfirmLinkAsync(link.Id)">Reconfirm from current evidence</button> }
            </p>
        }
    </section>

    <section>
        <h2>Review history</h2>
        <button @onclick="RecordReviewAsync">Record deterministic review</button>
        @if (Artifacts.SddLifecycle.ReviewRuns.Count == 0) { <p>No review run recorded.</p> }
        @foreach (var run in Artifacts.SddLifecycle.ReviewRuns.OrderByDescending(x => x.RanAt))
        {
                var baselineStatus = run.BaselineId is { } id ? Artifacts.SddLifecycle.Baselines.FirstOrDefault(x => x.BaselineId == id)?.Status : null;
                var stale = run.ProjectionMode == nameof(LifecycleProjectionMode.ActiveWorkspace)
                    ? run.SpecificationFingerprint != Fingerprint(Artifacts.Get(WorkspaceArtifactType.Specification)?.Text) || run.PlanFingerprint != Fingerprint(Artifacts.Get(WorkspaceArtifactType.Plan)?.Text) || run.TasksFingerprint != Fingerprint(Artifacts.Get(WorkspaceArtifactType.Tasks)?.Text)
                    : run.BaselineId is not null && baselineStatus is null || run.ProjectionMode == nameof(LifecycleProjectionMode.AuthoritativeBaseline) && run.BaselineId is null && !run.ArtifactRevisionIds.SequenceEqual(Projection.Metadata.ArtifactRevisionIds);
                var historical = run.Currentness == "Historical" || baselineStatus == "Historical";
            <p>@run.RanAt.ToLocalTime().ToString("g") — @(historical ? "Historical baseline review" : stale ? "Potentially stale / unavailable projection" : run.Currentness) · @run.ProjectionMode@(run.BaselineId is null ? "" : $" ({run.BaselineId})") — @run.RequirementsWithPlanEvidence/@run.RequirementCount plan-linked; @run.RequirementsWithTaskEvidence/@run.RequirementCount task-linked; source: @run.SourceSnapshotReference</p>
        }
    </section>

    <section class="source-import">
        <h2>Source Analysis and CodeLinks</h2>
        <p>Source Analysis owns source parsing. A resolved target means the referenced location can still be found; it does not verify behavior or correctness.</p>
        <label for="sdd-source-environment">Source Analysis environment ID</label>
        <input id="sdd-source-environment" @bind="_sourceEnvironment" />
        <button @onclick="LoadSourceSnapshotsAsync" disabled="@string.IsNullOrWhiteSpace(_sourceEnvironment)">Load Source Analysis snapshots</button>
        @if (!string.IsNullOrWhiteSpace(_sourceMessage)) { <p role="status">@_sourceMessage</p> }
        @foreach (var source in Artifacts.SddLifecycle.SourceSnapshots.OrderByDescending(x => x.AnalyzedAt))
        { <p>Source Analysis @source.AnalysisStatus · analyzer @source.AnalyzerVersion · @source.SnapshotId · @source.Fingerprint · @source.Currentness @if (source.Limitations.Count > 0) { <span> — limitations: @string.Join("; ", source.Limitations)</span> }</p> }
        @if (_sourceSnapshots.Count > 0)
        {
            <label for="sdd-source-snapshot">Snapshot</label>
            <select id="sdd-source-snapshot" @bind="_selectedSourceSnapshotId">
                <option value="">Select a snapshot</option>
                @foreach (var snapshot in _sourceSnapshots)
                { <option value="@snapshot.Id">@snapshot.Archive.FileName · @snapshot.AnalyzedAt.ToLocalTime().ToString("g") · @snapshot.Status · @Short(snapshot.Archive.Sha256)</option> }
            </select>
            <button @onclick="BindSourceEvidenceAsync" disabled="@(!_selectedSourceSnapshotId.HasValue || string.IsNullOrWhiteSpace(Artifacts.ProjectName))">Bind explicit CodeLinks</button>
        }
        @foreach (var evidence in Artifacts.SddLifecycle.ImplementationEvidence.Where(x => x.ProviderId == "CodeTraceability"))
        {
            <details><summary>@evidence.RequirementId · @evidence.FilePath · @evidence.Confidence · @evidence.Currentness</summary>
                <p>Snapshot @evidence.SourceSnapshotId · @evidence.SourceFingerprint · analyzer/provider version @evidence.ProviderVersion</p><p>@evidence.Provenance · target validation: @evidence.TargetValidation</p><p>@evidence.CurrentnessReason</p>
                @foreach (var resolution in evidence.TargetResolutions) { <p>Target @resolution.State · @resolution.OldSnapshotId → @resolution.NewSnapshotId · matched @resolution.MatchedPath · content changed: @(resolution.ContentChanged?.ToString() ?? "not assessed") · @resolution.Reason</p> }
            </details>
        }
    </section>

    <section class="test-import">
        <h2>Executed test evidence</h2>
        <p>Import structured provider results. Designed scenarios remain separate. Execution state and test result are independent.</p>
        <label for="test-result-import">Test result JSON (array)</label>
        <textarea id="test-result-import" rows="8" @bind="_testResultJson" placeholder='[{"testId":"TEST-1","requirementReferences":["REQ-1"],"acceptanceCriterionReferences":["AC-1"],"executionState":"Completed","result":"Passed","providerId":"JUnitImport","resultSource":"test-results.xml"}]'></textarea>
        <button @onclick="ImportTestResultsAsync">Import test results</button>
        @if (!string.IsNullOrWhiteSpace(_testImportMessage)) { <p role="status">@_testImportMessage</p> }
        @foreach (var execution in Artifacts.SddLifecycle.TestExecutions.OrderByDescending(x => x.ExecutedAt))
        { <p>@execution.TestId · @execution.ExecutionState / @execution.Result · @execution.ProviderId · @execution.Currentness · @execution.ExecutedAt</p> }
    </section>
</main>

@code {
    private static readonly string[] AuthorityValues = ["Unknown", "Draft", "Candidate", "Baseline", "Approved", "Superseded", "RejectedAlternative", "Historical"];
    private readonly Dictionary<string, string> _resolutions = new();
    private readonly Dictionary<string, string> _resolutionRefs = new();
    private string _sourceEnvironment = "";
    private string _projectionMode = nameof(LifecycleProjectionMode.AuthoritativeBaseline);
    private string _historicalBaselineId = "";
    private string _baselineLabel = "";
    private string? _sourceMessage;
    private Guid? _selectedSourceSnapshotId;
    private IReadOnlyList<BirkNext.Integrations.IqrSourceSnapshot> _sourceSnapshots = [];
    private string _testResultJson = "";
    private string? _testImportMessage;
    private ReviewContext? Context => ContextProvider.GetCurrent();
    private LifecycleProjectionMode ProjectionMode => Enum.TryParse<LifecycleProjectionMode>(_projectionMode, out var parsed) ? parsed : LifecycleProjectionMode.ActiveWorkspace;
    private Guid? HistoricalBaselineId => Guid.TryParse(_historicalBaselineId, out var parsed) ? parsed : null;
    private SddLifecycleProjection Projection => EvidenceGraph.Project(Artifacts, ProjectionMode, HistoricalBaselineId);
    private List<SddRequirementGraphRow> GraphRows => Projection.Rows.ToList();
    private List<SemanticRequirement> Requirements => GraphRows.Select(x => x.Requirement).ToList();
    private List<SemanticClarification> Clarifications => Context?.GetClarifications().ToList() ?? [];
    private bool HasSource => Artifacts.SddLifecycle.SourceSnapshots.Any(x => x.Currentness == "Current" && x.AnalysisStatus is "Ready" or "Partial");
    private bool HasFailedSource => Artifacts.SddLifecycle.SourceSnapshots.Any(x => x.Currentness == "Current" && x.AnalysisStatus == "Failed");
    private int PlanLinkedCount => Requirements.Count(x => PlanLinks(x.Id) > 0);
    private int TaskLinkedCount => Requirements.Count(x => TaskLinks(x.Id) > 0);
    private int PlanLinks(string id) => GraphRows.FirstOrDefault(x => x.Requirement.Id.Equals(id, StringComparison.OrdinalIgnoreCase))?.PlanReferences.Count ?? 0;
    private int TaskLinks(string id) => GraphRows.FirstOrDefault(x => x.Requirement.Id.Equals(id, StringComparison.OrdinalIgnoreCase))?.TaskReferences.Count ?? 0;

    protected override void OnInitialized() => Artifacts.ReviewContextRebuildNeeded += OnContextChanged;
    protected override async Task OnInitializedAsync()
    {
        if (ProjectionMode == LifecycleProjectionMode.ActiveWorkspace) EvidenceGraph.SynchronizeCurrentArtifacts(Artifacts);
        await AutoSave.SaveNowAsync();
    }
    private void OnContextChanged(object? sender, EventArgs args) => _ = InvokeAsync(StateHasChanged);

    private string Assessment(List<SddImplementationEvidence> evidence)
    {
        if (!Artifacts.Has(WorkspaceArtifactType.Specification)) return "Requirements not available";
        if (HasFailedSource && evidence.Count == 0) return "SourceUnsupported — Source Analysis failed; implementation not assessed";
        if (!HasSource && evidence.Count == 0) return "NoSourceAvailable — implementation not assessed";
        if (Artifacts.SddLifecycle.SourceSnapshots.Any(x => x.Currentness == "Current" && x.AnalysisStatus == "Partial") && evidence.Count == 0) return "Partial source analysis — requirement implementation not assessed";
        if (evidence.Count == 0) return "No implementation evidence registered";
        return evidence.Any(x => x.Confidence is "Confirmed" or "StronglySupported") ? "Implementation evidence found" : "Inferred evidence only";
    }

    private string QuestionKey(SemanticClarification item) => string.IsNullOrWhiteSpace(item.Id)
        ? "Q-" + Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(item.Question)))[..12]
        : item.Id!;

    private async Task ResolveQuestionAsync(SemanticClarification item)
    {
        var id = QuestionKey(item);
        if (string.IsNullOrWhiteSpace(_resolutions.GetValueOrDefault(id)) || string.IsNullOrWhiteSpace(_resolutionRefs.GetValueOrDefault(id))) return;
        SddLifecycleReviewService.ResolveQuestion(Artifacts.SddLifecycle, id, item.Question, _resolutions[id], _resolutionRefs[id], item.AffectedElements);
        await AutoSave.SaveNowAsync();
    }

    private async Task SetAuthorityAsync(Guid id, string? authority)
    {
        if (string.IsNullOrWhiteSpace(authority)) return;
        Artifacts.SetArtifactAuthority(id, authority);
        await AutoSave.SaveNowAsync();
    }

    private async Task SupersedeAsync(SddArtifactRevision oldRevision, SddArtifactRevision current)
    {
        oldRevision.Authority = "Superseded";
        oldRevision.IsCurrentSelection = false;
        oldRevision.SupersededByRevisionId = current.RevisionId;
        current.SupersedesRevisionId = oldRevision.RevisionId;
        await AutoSave.SaveNowAsync();
    }

    private async Task ReconfirmLinkAsync(Guid linkId)
    {
        var link = Artifacts.SddLifecycle.Links.FirstOrDefault(x => x.Id == linkId);
        if (link is null) return;
        link.Currentness = "Current";
        link.LastValidatedAt = DateTimeOffset.UtcNow;
        link.Reason = "Explicitly reconfirmed from current evidence.";
        await AutoSave.SaveNowAsync();
    }

    private async Task RecordReviewAsync()
    {
        var requirements = Requirements;
        if (ProjectionMode == LifecycleProjectionMode.ActiveWorkspace) EvidenceGraph.SynchronizeCurrentArtifacts(Artifacts);
        if (ProjectionMode == LifecycleProjectionMode.ActiveWorkspace)
            SddLifecycleReviewService.ReconcileRequirements(Artifacts.SddLifecycle, requirements,
                Projection.Metadata.ArtifactRevisionIds.FirstOrDefault(id => Artifacts.SddLifecycle.Revisions.Any(x => x.RevisionId == id && x.Role == "Specification")) is var specificationId && specificationId != Guid.Empty ? specificationId : null);
        var run = new SddReviewRun
        {
            SpecificationFingerprint = Projection.Metadata.ArtifactRevisionIds.Select(id => Artifacts.SddLifecycle.Revisions.FirstOrDefault(x => x.RevisionId == id)).FirstOrDefault(x => x?.Role == "Specification")?.Fingerprint ?? "",
            PlanFingerprint = Projection.Metadata.ArtifactRevisionIds.Select(id => Artifacts.SddLifecycle.Revisions.FirstOrDefault(x => x.RevisionId == id)).FirstOrDefault(x => x?.Role == "Plan")?.Fingerprint ?? "",
            TasksFingerprint = Projection.Metadata.ArtifactRevisionIds.Select(id => Artifacts.SddLifecycle.Revisions.FirstOrDefault(x => x.RevisionId == id)).FirstOrDefault(x => x?.Role == "Tasks")?.Fingerprint ?? "",
            RequirementCount = requirements.Count,
            RequirementsWithPlanEvidence = requirements.Count(x => PlanLinks(x.Id) > 0),
            RequirementsWithTaskEvidence = requirements.Count(x => TaskLinks(x.Id) > 0),
            SourceSnapshotReference = Artifacts.SddLifecycle.SourceSnapshots.FirstOrDefault(x => x.Currentness == "Current")?.SnapshotId ?? "Not available",
            SourceFingerprint = Artifacts.SddLifecycle.SourceSnapshots.FirstOrDefault(x => x.Currentness == "Current")?.Fingerprint ?? "",
            LifecycleEvidenceFingerprint = EvidenceGraph.Fingerprint(Artifacts, ProjectionMode, HistoricalBaselineId),
            TestEvidenceFingerprint = Fingerprint(System.Text.Json.JsonSerializer.Serialize(GraphRows.Select(x => new { x.Requirement.Id, x.Executions }))),
            ReviewVersion = 3,
            ProjectionMode = Projection.Metadata.Mode.ToString(), BaselineId = Projection.Metadata.BaselineId,
            ArtifactRevisionIds = Projection.Metadata.ArtifactRevisionIds.ToList(), ArtifactFingerprints = Projection.Metadata.ArtifactFingerprints.ToList(),
            Currentness = "Current"
        };
        Artifacts.SddLifecycle.ReviewRuns.Add(run);
        foreach (var previous in Artifacts.SddLifecycle.ReviewRuns.Where(x => x.Id != run.Id && x.Currentness == "Current")) previous.Currentness = "Historical";
        await AutoSave.SaveNowAsync();
    }

    private async Task CaptureBaselineAsync()
    {
        try
        {
            var baseline = Artifacts is WorkspaceArtifactRepository repository
                ? repository.CaptureBaseline(_baselineLabel)
                : throw new InvalidOperationException("Baseline capture is unavailable for this workspace provider.");
            _projectionMode = nameof(LifecycleProjectionMode.AuthoritativeBaseline);
            _sourceMessage = $"Captured baseline {baseline.Label} with {baseline.ArtifactRevisionIds.Count} artifact revision(s).";
            await AutoSave.SaveNowAsync();
        }
        catch (InvalidOperationException ex) { _sourceMessage = ex.Message; }
    }

    private async Task LoadSourceSnapshotsAsync()
    {
        try
        {
            _sourceSnapshots = await SddEvidenceApi.SourceSnapshotsAsync(_sourceEnvironment);
            _sourceMessage = _sourceSnapshots.Count == 0 ? "No Source Analysis snapshots are available for this environment." : $"Loaded {_sourceSnapshots.Count} metadata snapshot(s); no source was uploaded or reparsed.";
        }
        catch (Exception ex) { _sourceMessage = $"Source Analysis is unavailable: {ex.Message}"; }
    }

    private async Task BindSourceEvidenceAsync()
    {
        var snapshot = _sourceSnapshots.FirstOrDefault(x => x.Id == _selectedSourceSnapshotId);
        if (snapshot is null) { _sourceMessage = "Select a valid snapshot."; return; }
        if (snapshot.Status == BirkNext.Integrations.SourceAnalysisStatus.Failed)
        {
            SddEvidenceGraphService.RecordSourceSnapshot(Artifacts.SddLifecycle, snapshot, _sourceEnvironment);
            _sourceMessage = "This source analysis failed; its metadata is retained, but no implementation evidence was added.";
            await AutoSave.SaveNowAsync();
            return;
        }
        if (string.IsNullOrWhiteSpace(Artifacts.ProjectName)) { _sourceMessage = "A workspace project identifier is required to read persisted CodeLinks."; return; }
        try
        {
            var links = await SddEvidenceApi.CodeLinksAsync(Artifacts.ProjectName);
            SddEvidenceGraphService.RecordSourceSnapshot(Artifacts.SddLifecycle, snapshot, _sourceEnvironment);
            var added = SddEvidenceGraphService.BindCodeLinks(Artifacts.SddLifecycle, snapshot, links, Requirements.Select(x => x.Id));
            SddEvidenceGraphService.SourceSnapshotChanged(Artifacts.SddLifecycle, snapshot, _sourceEnvironment);
            _sourceMessage = snapshot.Status == BirkNext.Integrations.SourceAnalysisStatus.Partial
                ? $"Bound {added} explicit CodeLink(s) from a partial analysis. Analyzer limitations are retained; target resolution is separate from implementation correctness."
                : $"Bound {added} explicit CodeLink(s); deterministic file-target resolution is separate from implementation correctness.";
            await AutoSave.SaveNowAsync();
        }
        catch (Exception ex) { _sourceMessage = $"Could not read CodeLinks: {ex.Message}"; }
    }

    private async Task ImportTestResultsAsync()
    {
        try
        {
            var records = System.Text.Json.JsonSerializer.Deserialize<List<SddTestExecutionImportRecord>>(_testResultJson,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? [];
            var added = SddEvidenceGraphService.ImportExecutions(Artifacts.SddLifecycle, records);
            _testImportMessage = $"Imported {added} new execution record(s); duplicate provider IDs/report fingerprints were ignored.";
            await AutoSave.SaveNowAsync();
        }
        catch (Exception ex) { _testImportMessage = $"Test result import rejected: {ex.Message}"; }
    }

    private static string Short(string value) => string.IsNullOrWhiteSpace(value) ? "fingerprint unavailable" : value[..Math.Min(12, value.Length)];

    private static string Fingerprint(string? value) => string.IsNullOrEmpty(value)
        ? ""
        : Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(value)));
}

<style>
.sdd-review{padding:0 20px;max-width:1440px;margin:auto}.sdd-review section{margin:28px 0}.summary{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:12px}.summary div,.question,.notice{padding:14px;border:1px solid #d8dee8;border-radius:8px;background:#fff}.summary strong,.summary span{display:block}.summary strong{font-size:1.4rem}.summary span,.note{color:#586174}.notice{background:#fff8e7}.table-wrap{overflow-x:auto}table{border-collapse:collapse;width:100%;min-width:820px}th,td{text-align:left;padding:10px;border-bottom:1px solid #e1e5eb;vertical-align:top}tbody th span{display:block;font-weight:400;max-width:480px}.question{margin:12px 0}.question label,.question input,.source-import label,.source-import input,.source-import select,.test-import label,.test-import textarea{display:block}.question input,.source-import input,.source-import select,.test-import textarea{width:min(100%,720px);margin:4px 0 10px;padding:8px}.source-import button,.test-import button{margin:8px 8px 8px 0}.secondary{font-size:.85rem}
</style>
