@using BirkNext.IntegrationSuites
@using BirkNext.ContractTesting

@* The detail views of one generated suite (single-snapshot or composite): readiness dimensions, flow, configuration, Test Data, tests, XML, Kode 6/7,
   review and flat test execution. Shows what the backend stored; never computes a pass. *@
@switch (Tab)
{
    case "Readiness":
        <section class="its-card" data-testid="its-readiness" aria-label="Readiness">
            <ul class="its-dimensions">@foreach (var d in Suite.Readiness)
            {
                <li data-testid="its-dimension" data-state="@d.State"><span class="its-dim-name">@d.Name</span><span class="its-badge" data-state="@d.State">@Label(d.State)</span><span class="its-dim-detail">@d.Detail</span></li>
            }</ul>
            <h3>Source snapshot@(Suite.Composite is { } composite ? $"s ({composite.Sources.Count})" : "")</h3>
            @if (Suite.Composite is { } comp)
            {
                <ul class="its-list" data-testid="its-sources-list">@foreach (var s in comp.Sources) { <li>@s.ProjectKey · @s.ArchiveFileName · <code>@Short(s.ArchiveSha256)</code> · @string.Join(", ", s.Stages) · @s.Approval</li> }</ul>
            }
            else
            {
                <dl class="its-facts">
                    <div><dt>Archive</dt><dd>@Suite.Snapshot.ArchiveFileName</dd></div>
                    <div><dt>SHA-256</dt><dd><code>@Short(Suite.Snapshot.ArchiveSha256)</code></dd></div>
                    <div><dt>Evidence domains</dt><dd>@string.Join(", ", Suite.Snapshot.EvidenceDomains)</dd></div>
                    <div><dt>Modules</dt><dd>@string.Join(", ", Suite.Snapshot.Modules)</dd></div>
                </dl>
                @if (Suite.Snapshot.MissingSourceAreas.Count > 0)
                {
                    <ul class="its-list" data-testid="its-missing-areas">@foreach (var m in Suite.Snapshot.MissingSourceAreas) { <li>@m</li> }</ul>
                }
            }
            @if (Suite.Limitations.Count > 0)
            {
                <h3>Limitations</h3>
                <ul class="its-list">@foreach (var l in Suite.Limitations) { <li>@l</li> }</ul>
            }
        </section>
        break;
    case "Flow":
        <section class="its-card" data-testid="its-flow" aria-label="Integration flow">
            <ol class="its-stages">@foreach (var st in Suite.Stages.OrderBy(s => s.Order))
            {
                <li data-testid="its-stage" data-stage="@st.StageId" data-coverage="@st.Coverage">
                    <div class="its-stage-head"><strong>@st.Label</strong> <span class="its-muted">@st.Component</span>
                        <span class="its-badge" data-state="@st.Readiness">@Coverage(st.Coverage)</span> <span class="its-badge">@Triage(st.Triage)</span></div>
                    <div class="its-muted">@st.ExecutorObserver</div>
                    @if (st.Blockers.Count > 0) { <ul class="its-list">@foreach (var b in st.Blockers) { <li>@b</li> }</ul> }
                </li>
            }</ol>
            @if (Suite.Topology.Count > 0)
            {
                <h3>Topology mapping</h3>
                <div class="its-scroll" tabindex="0" role="region" aria-label="Topology mapping">
                    <table class="its-table" data-testid="its-topology">
                        <thead><tr><th scope="col">From</th><th scope="col">To</th><th scope="col">Relationship</th><th scope="col">Mapping</th><th scope="col">Confidence</th></tr></thead>
                        <tbody>@foreach (var m in Suite.Topology) { <tr><td>@m.From</td><td>@m.To</td><td>@m.Relationship</td><td>@m.Class@(m.RequiresReview ? " · review" : "")</td><td>@m.Confidence</td></tr> }</tbody>
                    </table>
                </div>
            }
        </section>
        break;
    case "Configuration":
        <section class="its-card" data-testid="its-configuration" aria-label="Configuration">
            @if (Suite.Configuration.Count == 0) { <p class="its-note">No configuration values were found in the source.</p> }
            else
            {
                <div class="its-scroll" tabindex="0" role="region" aria-label="Configuration values">
                    <table class="its-table">
                        <thead><tr><th scope="col">Field</th><th scope="col">Value</th><th scope="col">Origin</th><th scope="col">Binding</th><th scope="col">Evidence</th></tr></thead>
                        <tbody>@foreach (var c in Suite.Configuration)
                        {
                            <tr data-testid="its-config" data-origin="@c.Origin"><th scope="row">@c.Field</th><td>@(c.Value ?? "unresolved")</td><td>@c.Origin@(c.NeedsReview ? " · review" : "")</td><td>@c.Binding</td>
                                <td>@string.Join(", ", c.Evidence.Take(2).Select(Ref))</td></tr>
                        }</tbody>
                    </table>
                </div>
            }
        </section>
        break;
    case "Test data":
        <section class="its-card" data-testid="its-test-data" aria-label="Test data">
            <p class="its-note">Generated values are synthetic drafts in Test Data (never approved automatically). Identity fields are never synthesised.</p>
            <ul class="its-items">@foreach (var d in Suite.TestData)
            {
                <li data-testid="its-data-item" data-state="@d.State"><strong>@d.Role</strong> <span class="its-badge">@d.State</span> @(d.Asset is { } a ? $"· {a}" : "")
                    <div class="its-muted">@d.Purpose</div>
                    @if (d.Prerequisite is { } pre) { <div class="its-prereq" data-testid="its-data-prereq">@pre</div> }
                    @if (d.Values.Count > 0) { <div class="its-muted">@string.Join(" · ", d.Values.Take(8).Select(v => $"{v.Name} = {v.Value} ({v.Constraint})"))</div> }
                </li>
            }</ul>
        </section>
        break;
    case "Tests":
        <section class="its-card" data-testid="its-tests" aria-label="Tests">
            <div class="its-scroll" tabindex="0" role="region" aria-label="Contract tests">
                <table class="its-table">
                    <thead><tr><th scope="col">Operation</th><th scope="col">Kind</th><th scope="col">Contract</th><th scope="col">Readiness</th><th scope="col">Triage</th><th scope="col">Run</th></tr></thead>
                    <tbody>@foreach (var t in Suite.Tests)
                    {
                        <tr data-testid="its-test" data-triage="@t.Triage"><th scope="row">@t.Operation</th><td>@t.Kind@(t.Variant is { } v ? $" · {v}" : "")@(t.Mutating ? " · mutating" : "")</td>
                            <td><a href="@($"/api-quality-review/contracts?test={t.TestId:D}")">@t.ContractRef</a></td>
                            <td><span>@t.Readiness</span>@if (t.ReadinessGaps.Count > 0) { <div class="its-muted">@string.Join("; ", t.ReadinessGaps.Take(3))</div> }</td>
                            <td>@Triage(t.Triage)</td>
                            <td><input type="checkbox" aria-label="@($"Select {t.Operation} {t.Kind}")" checked="@Selected.Contains(t.TestId)" disabled="@(t.Triage != SuiteTriage.CanRunNow)"
                                       @onchange="e => OnToggle.InvokeAsync((t.TestId, e.Value is true))" data-testid="its-select" /></td></tr>
                    }</tbody>
                </table>
            </div>
            @if (Suite.Unsupported.Count > 0)
            {
                <h3>Not supported</h3>
                <ul class="its-list">@foreach (var u in Suite.Unsupported) { <li>@u.Operation (@u.ContractRef): @u.Reason</li> }</ul>
            }
        </section>
        break;
    case "XML":
        <section class="its-card" data-testid="its-xml" aria-label="XML schemas">
            @if (Suite.XmlSchemas.Count == 0) { <p class="its-note">No XML schema in the scope's modules.</p> }
            else
            {
                <p class="its-note">Minimum-valid XML fixtures are generated in Schema Studio from the exact snapshot (dependency closure resolved there).</p>
                <ul class="its-items">@foreach (var x in Suite.XmlSchemas)
                {
                    <li data-testid="its-xsd" data-resolved="@(x.DependenciesResolved ? "true" : "false")"><strong>@x.File</strong> <span class="its-badge">@x.State</span>
                        <div class="its-muted">@(x.TargetNamespace ?? "no target namespace") · roots: @string.Join(", ", x.RootElements)</div>
                        @if (x.Unresolved.Count > 0) { <div class="its-prereq">Unresolved: @string.Join(", ", x.Unresolved)</div> }
                        <a href="@($"/schema-studio?snapshot={Suite.Snapshot.SnapshotId:D}&contract={Uri.EscapeDataString(x.File)}")">Open in Schema Studio</a>
                    </li>
                }</ul>
            }
        </section>
        break;
    case "Kode 6/7":
        <section class="its-card" data-testid="its-security" aria-label="Kode 6/7 security scenarios">
            <p class="its-note">Reuses the existing M01 graded-access review (Kode 6/7); BirkNext does not build a second Kode 6/7 module. Synthetic persons only.</p>
            @foreach (var group in TriageOrder)
            {
                var rows = Suite.Security.Where(s => s.Triage == group).ToList();
                if (rows.Count == 0) continue;
                <h3 data-testid="@($"its-sec-group-{group}")">@Triage(group) (@rows.Count)</h3>
                <ul class="its-items">@foreach (var s in rows)
                {
                    <li data-testid="its-sec" data-id="@s.ScenarioId" data-triage="@s.Triage"><strong>@s.ScenarioId</strong> @s.Title <span class="its-badge">@Label(s.Readiness)</span>
                        @if (s.Reuses is { } reuse) { <div class="its-muted">Reuses @reuse@(s.ExistingState is { } es ? $" · {es}" : "")</div> }
                        @if (s.OpenQuestion is { } q) { <div class="its-prereq" data-testid="its-sec-question">@q</div> }
                        @if (s.Prerequisites.Count > 0) { <ul class="its-list">@foreach (var pr in s.Prerequisites) { <li>@pr</li> }</ul> }
                    </li>
                }</ul>
            }
            <a href="/security-classification-review">Open M01 – Gradert tilgang (Kode 6/7)</a>
        </section>
        break;
    case "Review":
        <section class="its-card" data-testid="its-review" aria-label="Review">
            @if (Suite.Review.Count == 0) { <p class="its-note">Nothing needs review.</p> }
            <ul class="its-items">@foreach (var r in Suite.Review)
            {
                <li data-testid="its-review-item" data-key="@r.Key"><strong>@r.Area</strong> · @r.Question
                    <div class="its-muted">@r.Why</div>
                    @if (r.Decision is { } dec) { <div data-testid="its-review-decision">@dec by @r.DecidedBy @(r.DecidedAt is { } at ? Utc(at) : "")</div> }
                    else
                    {
                        <div class="its-actions">
                            @foreach (var choice in new[] { "Acceptable", "IssueFound", "NeedsEvidence", "NotApplicable" })
                            {
                                <button type="button" class="btn btn-secondary btn-sm" disabled="@Busy" @onclick="() => OnReview.InvokeAsync((r.Key, choice))" data-testid="@($"its-review-{choice}")">@choice</button>
                            }
                        </div>
                    }
                </li>
            }</ul>
        </section>
        break;
    case "Execution":
        <section class="its-card" data-testid="its-execution" aria-label="Execution">
            @if (Suite.Composite is not null)
            {
                <p class="its-note">A composite suite runs as one correlated transaction from Execute &amp; Evidence; single tests can still run here.</p>
            }
            @if (Environment is null)
            {
                <p class="its-note" data-testid="its-no-environment">No active Target Environment with a target URL. Choose one in <a href="@($"/{NavigationCatalog.TargetEnvironmentsRoute}")">Target Environments</a> before running.</p>
            }
            else
            {
                <p class="its-note">Target: <strong>@EnvironmentName</strong> (@Environment.EnvironmentType) · @Environment.TargetUrl</p>
                <p class="its-note">@Selected.Count test(s) selected on the Tests tab. Only tests that can run now are selectable; nothing else is sent.</p>
                <label class="its-check"><input type="checkbox" @bind="_confirmMutating" data-testid="its-confirm-mutating" /> I confirm mutating calls in this environment</label>
                <label class="its-check"><input type="checkbox" @bind="_authorized" data-testid="its-authorize" /> I authorise this run against the target above</label>
                <button type="button" class="btn btn-primary" disabled="@(Busy || !_authorized || Selected.Count == 0)" @onclick="RunAsync" data-testid="its-run">Run selected tests</button>
            }
            @if (Suite.Runs.Count > 0)
            {
                <h3>Runs</h3>
                <ul class="its-items">@foreach (var run in Suite.Runs)
                {
                    <li data-testid="its-run-link"><a href="@($"/execution-results?run={run.RunId:D}")">@Utc(run.StartedAt)</a> · @run.Kind · @run.State · @run.Initiator</li>
                }</ul>
            }
        </section>
        break;
}

@code {
    private static readonly SuiteTriage[] TriageOrder = [SuiteTriage.CanRunNow, SuiteTriage.WaitingForPrerequisite, SuiteTriage.NeedsDomainDecision, SuiteTriage.NotSupported];
    [Parameter, EditorRequired] public IntegrationSuite Suite { get; set; } = default!;
    [Parameter] public string Tab { get; set; } = "Readiness";
    [Parameter] public bool Busy { get; set; }
    [Parameter] public ContractTestEnvironment? Environment { get; set; }
    [Parameter] public string? EnvironmentName { get; set; }
    [Parameter] public HashSet<Guid> Selected { get; set; } = [];
    [Parameter] public EventCallback<(string Key, string Decision)> OnReview { get; set; }
    [Parameter] public EventCallback<bool> OnExecute { get; set; }
    [Parameter] public EventCallback<(Guid Id, bool On)> OnToggle { get; set; }
    private bool _authorized, _confirmMutating;

    private async Task RunAsync()
    {
        if (!_authorized) return;
        var confirm = _confirmMutating;
        _authorized = false; // authorisation is per run
        await OnExecute.InvokeAsync(confirm);
    }

    internal static string Label(SuiteStatus s) => s switch
    {
        SuiteStatus.ReadyToExecute => "Ready to execute", SuiteStatus.PartiallyExecutable => "Partially executable", SuiteStatus.NeedsReview => "Needs review", _ => s.ToString(),
    };
    internal static string Label(SuiteItemReadiness r) => r switch
    {
        SuiteItemReadiness.NeedsReview => "Needs review", SuiteItemReadiness.PartiallyExecutable => "Partially executable", SuiteItemReadiness.NotSupported => "Not supported",
        SuiteItemReadiness.NotAssessed => "Not assessed", _ => r.ToString(),
    };
    internal static string Triage(SuiteTriage t) => t switch
    {
        SuiteTriage.CanRunNow => "Can run now", SuiteTriage.WaitingForPrerequisite => "Waiting for prerequisite", SuiteTriage.NeedsDomainDecision => "Needs domain decision", _ => "Not supported",
    };
    private static string Coverage(SuiteStageCoverage c) => c switch { SuiteStageCoverage.ExecutableAndObservable => "Executable + observable", _ => c.ToString() };
    private static string Ref(SuiteSourceRef r) => r.Line is { } l ? $"{r.Path}:{l}" : r.Path;
    internal static string Short(string sha) => sha.Length >= 16 ? sha[..16] + "…" : sha;
    internal static string Utc(DateTimeOffset t) => t.UtcDateTime.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture) + " UTC";
}
