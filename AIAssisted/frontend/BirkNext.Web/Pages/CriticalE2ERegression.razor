@page "/critical-e2e-regression"
@using BirkNext.CriticalE2E
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using BirkNext.Web.Shared.Components.Common
@inject ICriticalE2EApiService Api
@inject IFrontendAnalysisContextFactory ContextFactory
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Critical E2E Regression</PageTitle>

<div class="e2e-page">
    <PageHeader Title="Critical E2E Regression"
                Description="Run critical user journeys as attended browser automation against the build being shipped." />

    @if (_error is { } error)
    {
        <p class="e2e-error" role="alert" data-testid="e2e-error">@error</p>
    }
    @if (_overview is not { } overview)
    {
        @if (_error is null) { <p class="e2e-loading" data-testid="e2e-loading">Loading…</p> }
    }
    else
    {
        var headline = CriticalE2EPresentation.Headline(overview);
        var readiness = CriticalE2EPresentation.Readiness(overview);
        var actions = CriticalE2EPresentation.Actions(overview);
        var rows = CriticalE2EPresentation.Rows(overview, _showDiagnostic);
        var criticalCount = CriticalE2EPresentation.Count(overview, CriticalE2EFlowKind.Critical);
        var diagnosticCount = CriticalE2EPresentation.Count(overview, CriticalE2EFlowKind.Diagnostic);
        var historyFlow = overview.Flows.FirstOrDefault(f => f.FlowId == _historyFlowId);
        var history = CriticalE2EPresentation.History(overview, _buildId, _showDiagnosticRuns, _showArchivedRuns, historyFlow?.FlowId);
        var counts = CriticalE2EPresentation.HistoryCounts(overview, _buildId, _showDiagnosticRuns, _showArchivedRuns, historyFlow?.FlowId);
        var smokeRuns = CriticalE2EPresentation.History(overview, _buildId, true, true).Count(h => h.Kind == CriticalE2EHistoryKind.Smoke);
        var archivedRuns = CriticalE2EPresentation.History(overview, _buildId, true, true).Count(h => h.Archived);

        @* ── Where, what build, how much is covered, can a browser flow run. One fact per card: quiet label, large value,
               at most one short line under it. ── *@
        <section class="e2e-summary" data-testid="e2e-summary" aria-label="Regression summary">
            <div class="e2e-card"><span class="e2e-card-label">Target</span><strong class="e2e-card-value" data-testid="e2e-environment">@overview.EnvironmentName</strong></div>
            <div class="e2e-card">
                <span class="e2e-card-label">Build</span>
                <strong class="e2e-card-value" data-testid="e2e-build">@CriticalE2EPresentation.BuildLabel(_buildId)</strong>
                <span class="e2e-card-help" data-testid="e2e-build-help">@CriticalE2EPresentation.BuildHelp(_buildId)</span>
            </div>
            <div class="e2e-card">
                <span class="e2e-card-label">Required flow coverage</span>
                <strong class="e2e-card-value" data-testid="e2e-coverage">@CriticalE2EPresentation.Coverage(overview.Release)</strong>
            </div>
            <div class="e2e-card">
                <span class="e2e-card-label">Attended browser</span>
                <strong class="e2e-card-value e2e-tone-@readiness.Tone.ToString().ToLowerInvariant()" data-testid="e2e-attended-state">@readiness.Label</strong>
                @if (readiness.CardDetail is { Length: > 0 } cardDetail)
                {
                    <span class="e2e-card-help" data-testid="e2e-attended-detail">@cardDetail</span>
                }
            </div>
        </section>

        @* The release headline belongs to critical flows. With none, the flow list's empty state says so once. *@
        @if (criticalCount > 0)
        {
            <section class="e2e-headline e2e-tone-@headline.Tone.ToString().ToLowerInvariant()" data-testid="e2e-verdict" aria-label="Release regression">
                <h2 data-testid="e2e-verdict-label">@headline.Label</h2>
                <p data-testid="e2e-verdict-detail">@headline.Detail</p>
            </section>
        }

        @* ── Attended readiness: one compact strip that says WHY the card above reads as it does. Consumed from the
               overview's one Companion snapshot; setup lives with the Target Environment. ── *@
        <section class="e2e-readiness e2e-readiness-@readiness.Tone.ToString().ToLowerInvariant()" data-testid="e2e-readiness" aria-labelledby="e2e-readiness-heading">
            <div class="e2e-readiness-main">
                <h2 id="e2e-readiness-heading" class="e2e-readiness-title">
                    <span class="e2e-readiness-glyph" aria-hidden="true">@(readiness.Tone == CriticalE2ETone.Good ? "✓" : readiness.Tone == CriticalE2ETone.Neutral ? "○" : "!")</span>
                    @readiness.Headline
                    @* The short state as a stable hook; the headline already says it, so assistive tech is not told twice. *@
                    <span class="e2e-visually-hidden" aria-hidden="true" data-testid="e2e-readiness-state">@readiness.Label</span>
                </h2>
                @if (readiness.Reason is { Length: > 0 } reason)
                {
                    <p class="e2e-readiness-reason" role="status" data-testid="e2e-readiness-reason">@reason</p>
                }
                <dl class="e2e-facts">
                    <div><dt>Browser Companion</dt><dd data-testid="e2e-readiness-companion">@readiness.Companion</dd></div>
                    <div><dt>Approved page</dt><dd data-testid="e2e-readiness-page">@readiness.Page</dd></div>
                    <div><dt>Element picking</dt><dd data-testid="e2e-readiness-picking">@readiness.ElementPicking</dd></div>
                </dl>
            </div>
            <div class="e2e-readiness-actions">
                @if (readiness.Tone != CriticalE2ETone.Good)
                {
                    <a class="e2e-cta" href="@CriticalE2EPresentation.BrowserCompanionSetupHref(_profileId)" data-testid="e2e-companion-setup">Open Browser Companion setup</a>
                }
                <button type="button" class="btn-secondary btn-small" data-testid="e2e-readiness-refresh" @onclick="RefreshAsync">Check again</button>
            </div>
        </section>

        @* ── The flows are the page. Smoke / diagnostic flows are hidden unless the reader asks for them. With no flow
               to show, the empty state owns the one Add action and the smoke switch; otherwise the header does. ── *@
        var showEmpty = rows.Count == 0;
        <section class="e2e-flows" data-testid="e2e-flows" aria-labelledby="e2e-flows-heading">
            <div class="e2e-section-head e2e-flows-head">
                <h2 id="e2e-flows-heading">Critical flows</h2>
                <div class="e2e-section-actions">
                    @foreach (var action in actions)
                    {
                        var reasonId = $"e2e-run-reason-{Slug(action.Mode)}";
                        <button type="button" class="btn-secondary" data-testid="e2e-run-@Slug(action.Mode)"
                                disabled="@(!action.Enabled || _running is not null)" aria-describedby="@(action.Enabled ? null : reasonId)"
                                @onclick="() => RunAsync(action.Mode)">
                            @(_running == action.Mode.ToString() ? "Running…" : $"{action.Label} ({action.FlowCount})")
                        </button>
                        @if (!action.Enabled && action.Reason is { Length: > 0 } actionReason)
                        {
                            <span class="e2e-run-reason" id="@reasonId" data-testid="@reasonId">@actionReason</span>
                        }
                    }
                    @if (_running is not null)
                    {
                        <button type="button" class="btn-secondary" data-testid="e2e-cancel" @onclick="Cancel">Stop</button>
                    }
                    @if (!showEmpty)
                    {
                        <button type="button" class="btn-primary" data-testid="e2e-add-flow" @ref="_addButton" @onclick="AddFlow">Add critical flow</button>
                    }
                </div>
            </div>
            @if (!showEmpty && diagnosticCount > 0)
            {
                <div class="e2e-flows-subhead">
                    <label class="e2e-toggle" data-testid="e2e-show-diagnostic-label">
                        <input type="checkbox" data-testid="e2e-show-diagnostic" @bind="_showDiagnostic" /> Show smoke / diagnostic flows
                    </label>
                    @if (!_showDiagnostic)
                    {
                        <span class="e2e-toggle-count" data-testid="e2e-hidden-diagnostic">@diagnosticCount smoke/diagnostic @(diagnosticCount == 1 ? "flow is" : "flows are") hidden.</span>
                    }
                </div>
            }

            @if (showEmpty)
            {
                <div class="e2e-empty" data-testid="e2e-no-flows">
                    <h3 class="e2e-empty-title">@(overview.Flows.Count == 0 ? "No critical flows yet" : "No release-critical flows yet")</h3>
                    <p class="e2e-empty-text">Create your first attended user journey for this target.</p>
                    <button type="button" class="btn-primary" data-testid="e2e-add-flow" @ref="_addButton" @onclick="AddFlow">Add critical flow</button>
                    @if (diagnosticCount > 0)
                    {
                        <div class="e2e-empty-foot">
                            <span data-testid="e2e-hidden-diagnostic">@diagnosticCount smoke/diagnostic @(diagnosticCount == 1 ? "flow is" : "flows are") hidden.</span>
                            <label class="e2e-toggle" data-testid="e2e-show-diagnostic-label">
                                <input type="checkbox" data-testid="e2e-show-diagnostic" @bind="_showDiagnostic" /> Show smoke / diagnostic flows
                            </label>
                        </div>
                    }
                </div>
            }
            else
            {
                @if (criticalCount == 0)
                {
                    <p class="e2e-muted" data-testid="e2e-no-critical-note">No release-critical flows yet. Showing smoke / diagnostic flows only; they never count toward release coverage.</p>
                }
                <div class="e2e-tablewrap">
                    <table class="e2e-table" data-testid="e2e-flow-table">
                        <thead>
                            <tr><th scope="col">Module</th><th scope="col">Critical flow</th><th scope="col">Steps</th><th scope="col">Execution</th><th scope="col">Required</th><th scope="col">Last run</th><th scope="col">Result</th><th scope="col"><span class="e2e-visually-hidden">Actions</span></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var row in rows)
                            {
                                var blockedId = $"e2e-run-blocked-{row.FlowId}";
                                var diagnostic = row.Kind == CriticalE2EFlowKind.Diagnostic;
                                <tr class="@(diagnostic ? "e2e-row-diagnostic" : null)" data-testid="e2e-flow-@row.FlowId" data-kind="@row.Kind">
                                    <td data-label="Module">@row.Module</td>
                                    <th scope="row" data-label="Critical flow">
                                        @if (diagnostic) { <span class="e2e-badge e2e-badge-smoke" data-testid="e2e-kind-@row.FlowId">Smoke</span> }
                                        <span class="e2e-flow-name">@row.Name</span>
                                        @if (!row.Enabled) { <span class="e2e-badge e2e-badge-muted" data-testid="e2e-enabled-@row.FlowId">Disabled</span> }
                                        @if (row.ConfigurationProblem is { Length: > 0 } problem) { <span class="e2e-row-detail e2e-tone-warning" data-testid="e2e-problem-@row.FlowId">Needs attention: @problem</span> }
                                    </th>
                                    <td data-label="Steps">@row.Steps</td>
                                    <td data-label="Execution">@row.Execution</td>
                                    <td data-label="Required" data-testid="e2e-required-@row.FlowId">@(diagnostic ? "No" : row.RequiredForRelease ? "Required" : "Optional")</td>
                                    <td data-label="Last run">@(row.LastRunAt is { } at ? at.ToLocalTime().ToString("d MMM HH:mm", System.Globalization.CultureInfo.InvariantCulture) : "—")</td>
                                    <td data-label="Result">
                                        <span class="e2e-pill e2e-tone-@row.ResultTone.ToString().ToLowerInvariant()" data-testid="e2e-status-@row.FlowId">@row.Result</span>
                                        @if (row.ResultDetail is { Length: > 0 } detail) { <span class="e2e-row-detail">@detail</span> }
                                    </td>
                                    <td class="e2e-row-actions">
                                        <button type="button" class="btn-secondary btn-small" data-testid="e2e-run-flow-@row.FlowId"
                                                disabled="@(!row.Runnable || _running is not null)" aria-describedby="@(row.Runnable ? null : blockedId)"
                                                @onclick="() => RunFlowAsync(row.FlowId)">@(_running == row.FlowId ? "Running…" : "Run")</button>
                                        <button type="button" class="btn-secondary btn-small" data-testid="e2e-edit-@row.FlowId" @onclick="() => Edit(row.FlowId)">Edit</button>
                                        @if (!row.Runnable && row.RunBlockedReason is { Length: > 0 } why)
                                        {
                                            <span class="e2e-visually-hidden" id="@blockedId">Cannot run: @why</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        @if (_editing is { } editing)
        {
            <CriticalE2EFlowEditor Flow="editing" EnvironmentId="@_environmentId" ProfileId="@_profileId"
                                   EnvironmentType="@_environmentType" ElementPick="@_overview?.ElementPick" OnCheckElementPick="RefreshAsync"
                                   SetupHref="@CriticalE2EPresentation.BrowserCompanionSetupHref(_profileId)"
                                   OnSave="SaveFlowAsync" OnCancel="CancelEdit" />
        }

        @if (_lastRun is { } run)
        {
            @* ── The run that just finished: outcome first, the step that decided it next, every step after that. ── *@
            <section class="e2e-result e2e-tone-@ResultTone(run.Status)" data-testid="e2e-last-run" aria-labelledby="e2e-last-run-heading" role="status">
                <div class="e2e-section-head">
                    <h2 id="e2e-last-run-heading">@run.FlowName</h2>
                    <span class="e2e-pill e2e-tone-@ResultTone(run.Status)" data-testid="e2e-last-run-status">@CriticalE2EPresentation.StatusLabel(run.Status)</span>
                </div>
                <p class="e2e-muted" data-testid="e2e-last-run-counts">@CriticalE2EPresentation.StepCounts(run) · @CriticalE2EPresentation.Duration(run.DurationMs) · @overview.EnvironmentName · build @CriticalE2EPresentation.BuildLabel(run.BuildId)</p>
                @if (CriticalE2EPresentation.FirstProblem(run) is { Length: > 0 } problem && run.Status != CriticalE2EStatus.Passed)
                {
                    <p class="e2e-result-problem" data-testid="e2e-last-run-problem">@problem</p>
                }
                <ol class="e2e-step-results" data-testid="e2e-last-run-steps">
                    @foreach (var step in run.StepResults)
                    {
                        <li class="e2e-step-result e2e-step-@step.Status.ToString().ToLowerInvariant()">
                            <span class="e2e-step-glyph" aria-hidden="true">@CriticalE2EPresentation.StepGlyph(step.Status)</span>
                            <span class="e2e-step-desc">@step.Description</span>
                            <span class="e2e-visually-hidden">@CriticalE2EPresentation.StatusLabel(step.Status)</span>
                            @if (step.SanitizedError is { Length: > 0 } stepError) { <span class="e2e-row-detail">@stepError</span> }
                        </li>
                    }
                </ol>
            </section>
        }

        @* ── Secondary: coverage detail, history, build. One collapsed disclosure each; their state is their own. ── *@
        <section class="e2e-secondary" aria-label="Details">
            <ReviewDisclosure Text="Module coverage" CollapseText="Hide module coverage" Hint="@CriticalE2EPresentation.Coverage(overview.Release)" TestId="e2e-modules" Class="e2e-disclosure">
                @if (overview.Modules.Count == 0)
                {
                    <p class="e2e-muted" data-testid="e2e-no-modules">No delivery modules yet. Modules come from critical flows; smoke/diagnostic flows never add one.</p>
                }
                else
                {
                    <table class="e2e-table e2e-table-compact" data-testid="e2e-module-table">
                        <thead><tr><th scope="col">Module</th><th scope="col">Required flow</th><th scope="col">Latest result</th></tr></thead>
                        <tbody>
                            @foreach (var module in overview.Modules)
                            {
                                var required = module.Flows.Where(f => f.RequiredForRelease && f.Enabled).ToList();
                                <tr data-testid="e2e-module-@module.Module">
                                    <td>@module.Module</td>
                                    <td>@(required.Count > 0 ? string.Join(", ", required.Select(f => f.Name)) : "None configured")</td>
                                    <td>@(required.Count > 0 ? string.Join(", ", required.Select(f => CriticalE2EPresentation.StatusLabel(f.LastStatus))) : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                @if (CriticalE2EPresentation.PipelineNote(overview) is { Length: > 0 } note)
                {
                    <p class="e2e-muted" data-testid="e2e-pipeline-note">@note</p>
                }
            </ReviewDisclosure>

            @if (overview.History.Count > 0)
            {
                <ReviewDisclosure Text="Run history" CollapseText="Hide run history" Hint="@CriticalE2EPresentation.HistoryHint(counts)" TestId="e2e-history" Class="e2e-disclosure">
                    @* Managing history is per flow, and lives here rather than next to Run: it changes what is listed, never what ran. *@
                    <div class="e2e-history-tools" data-testid="e2e-history-tools">
                        <label class="e2e-history-flow">
                            <span>Manage history for</span>
                            <select data-testid="e2e-history-flow" @bind="_historyFlowId">
                                <option value="">All flows</option>
                                @foreach (var f in overview.Flows.OrderBy(f => f.Kind).ThenBy(f => f.Module).ThenBy(f => f.Name))
                                {
                                    <option value="@f.FlowId">@f.Module · @f.Name@(f.Kind == CriticalE2EFlowKind.Diagnostic ? " (smoke)" : "")</option>
                                }
                            </select>
                        </label>
                        <div class="e2e-history-actions">
                            <button type="button" class="btn-primary btn-small" data-testid="e2e-archive-open" @ref="_archiveTrigger"
                                    disabled="@(historyFlow is null || _historyBusy)" aria-describedby="e2e-history-explain"
                                    @onclick="() => OpenHistoryDialogAsync(HistoryDialog.Archive)">Archive old runs…</button>
                            <button type="button" class="btn-small e2e-btn-destructive" data-testid="e2e-clear-open" @ref="_clearTrigger"
                                    disabled="@(historyFlow is null || _historyBusy)" aria-describedby="e2e-history-explain"
                                    @onclick="() => OpenHistoryDialogAsync(HistoryDialog.Clear)"><span aria-hidden="true">⚠</span> Clear test history…</button>
                        </div>
                    </div>
                    <p class="e2e-muted e2e-history-explain" id="e2e-history-explain" data-testid="e2e-history-explain">
                        @(historyFlow is null ? "Choose a flow to archive or clear its history. " : "")@CriticalE2EPresentation.ArchiveExplanation @CriticalE2EPresentation.ClearExplanation
                    </p>
                    <div class="e2e-history-filters">
                        @if (smokeRuns > 0)
                        {
                            <label class="e2e-toggle" data-testid="e2e-show-diagnostic-runs-label">
                                <input type="checkbox" data-testid="e2e-show-diagnostic-runs" @bind="_showDiagnosticRuns" /> Show smoke / diagnostic runs
                            </label>
                        }
                        @if (archivedRuns > 0 || overview.ArchivedRunCount > 0)
                        {
                            <label class="e2e-toggle" data-testid="e2e-show-archived-runs-label">
                                <input type="checkbox" data-testid="e2e-show-archived-runs" @bind="_showArchivedRuns" /> Show archived runs
                            </label>
                        }
                        <span class="e2e-toggle-count" data-testid="e2e-history-counts">@CriticalE2EPresentation.HistoryHint(counts)</span>
                    </div>
                    <p class="e2e-history-status" role="status" tabindex="-1" data-testid="e2e-history-status" @ref="_historyStatusElement">@_historyStatus</p>
                    @if (_dialog == HistoryDialog.None && _historyError is { Length: > 0 } historyError)
                    {
                        <p class="e2e-error" role="alert" data-testid="e2e-history-error">@historyError</p>
                    }
                    @if (history.Count == 0)
                    {
                        <p class="e2e-muted" data-testid="e2e-history-empty">No runs to show. @CriticalE2EPresentation.HistoryHint(counts).</p>
                    }
                    else
                    {
                        <div class="e2e-tablewrap">
                            <table class="e2e-table e2e-table-compact" data-testid="e2e-history-table">
                                <thead><tr><th scope="col">Flow</th><th scope="col">Type</th><th scope="col">Module</th><th scope="col">Build</th><th scope="col">Started</th><th scope="col">Result</th><th scope="col">Steps</th><th scope="col">Duration</th><th scope="col"><span class="e2e-visually-hidden">Actions</span></th></tr></thead>
                                <tbody>
                                    @foreach (var h in history)
                                    {
                                        var past = h.Run;
                                        var rowClass = string.Join(' ', new[] { h.Kind == CriticalE2EHistoryKind.Smoke ? "e2e-row-diagnostic" : null, h.Archived ? "e2e-row-archived" : null }.Where(c => c is not null));
                                        <tr class="@(rowClass.Length > 0 ? rowClass : null)" data-testid="e2e-run-@past.RunId" data-kind="@h.Kind" data-evidence="@(h.ReleaseEvidence ? "true" : "false")" data-archived="@(h.Archived ? "true" : "false")">
                                            <td data-label="Flow"><span class="e2e-flow-name">@past.FlowName</span>
                                                @if (h.Problem is { Length: > 0 } why) { <span class="e2e-row-detail e2e-clamp" title="@why" data-testid="e2e-run-problem-@past.RunId">@why</span> }
                                            </td>
                                            <td data-label="Type"><span class="e2e-badge @(h.Kind == CriticalE2EHistoryKind.Smoke ? "e2e-badge-smoke" : "")" data-testid="e2e-run-kind-@past.RunId">@CriticalE2EPresentation.KindLabel(h.Kind)</span></td>
                                            <td data-label="Module">@past.Module</td>
                                            <td data-label="Build" data-testid="e2e-run-build-@past.RunId">@CriticalE2EPresentation.BuildLabel(past.BuildId)
                                                @if (!h.ReleaseEvidence) { <span class="e2e-row-detail" data-testid="e2e-run-not-evidence-@past.RunId">Not release evidence</span> }
                                            </td>
                                            <td data-label="Started">@past.StartedAt.ToLocalTime().ToString("d MMM HH:mm", System.Globalization.CultureInfo.InvariantCulture)</td>
                                            <td data-label="Result" data-testid="e2e-run-result-@past.RunId">
                                                @* Archived is shown beside the recorded result, never instead of it. *@
                                                @if (h.Archived) { <span class="e2e-badge e2e-badge-archived" data-testid="e2e-run-archived-@past.RunId" title="@past.ArchiveReason">Archived ·</span>@(" ") }
                                                <span class="e2e-pill e2e-tone-@ResultTone(past.Status)">@CriticalE2EPresentation.StatusLabel(past.Status)</span>
                                            </td>
                                            <td data-label="Steps">@past.PassedSteps / @past.TotalSteps</td>
                                            <td data-label="Duration">@CriticalE2EPresentation.Duration(past.DurationMs)</td>
                                            <td class="e2e-row-actions">
                                                @if (h.Archived)
                                                {
                                                    <button type="button" class="btn-secondary btn-small" data-testid="e2e-restore-@past.RunId" disabled="@_historyBusy"
                                                            aria-label="@($"Restore run of {past.FlowName} from {past.StartedAt.ToLocalTime().ToString("d MMM HH:mm", System.Globalization.CultureInfo.InvariantCulture)}")"
                                                            @onclick="() => RestoreAsync(past.RunId)">Restore</button>
                                                }
                                                else if (h.Archivable)
                                                {
                                                    <button type="button" class="btn-secondary btn-small" data-testid="e2e-archive-run-@past.RunId" disabled="@_historyBusy"
                                                            aria-label="@($"Archive run of {past.FlowName} from {past.StartedAt.ToLocalTime().ToString("d MMM HH:mm", System.Globalization.CultureInfo.InvariantCulture)}")"
                                                            @onclick="() => ArchiveOneAsync(past.FlowId, past.RunId)">Archive</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </ReviewDisclosure>
            }

            <ReviewDisclosure Text="Build details" CollapseText="Hide build details" Hint="@CriticalE2EPresentation.BuildLabel(_buildId)" TestId="e2e-build-details" Class="e2e-disclosure">
                <div class="e2e-build-form">
                    <label>Build id <input data-testid="e2e-build-input" @bind="_buildId" @bind:event="oninput" /></label>
                    <label>Release id <input data-testid="e2e-release-input" @bind="_releaseId" @bind:event="oninput" /></label>
                    <label>Commit <input data-testid="e2e-commit-input" @bind="_commitSha" @bind:event="oninput" /></label>
                    <button type="button" class="btn-secondary" data-testid="e2e-apply-build" @onclick="RefreshAsync">Apply</button>
                </div>
            </ReviewDisclosure>
        </section>

        @if (_dialog != HistoryDialog.None && _preview is { } preview)
        {
            var titleId = "e2e-history-dialog-title";
            var descId = "e2e-history-dialog-desc";
            <dialog @ref="_dialogElement" class="e2e-dialog @(_dialog == HistoryDialog.Clear ? "e2e-dialog-destructive" : null)" data-testid="e2e-@(_dialog == HistoryDialog.Clear ? "clear" : "archive")-dialog"
                    aria-labelledby="@titleId" aria-describedby="@descId">
                @if (_dialog == HistoryDialog.Archive)
                {
                    var candidates = _archiveSelection == CriticalE2EArchiveSelection.NotOnCurrentBuild ? preview.ArchiveCandidatesNotOnCurrentBuild ?? 0 : preview.ArchiveCandidates;
                    <h2 id="@titleId" class="e2e-dialog-title">Archive old runs — @preview.FlowName</h2>
                    <p id="@descId" class="e2e-dialog-text">@CriticalE2EPresentation.ArchiveExplanation</p>
                    <fieldset class="e2e-dialog-options">
                        <legend>Which runs</legend>
                        <label class="e2e-toggle">
                            <input type="radio" name="e2e-archive-selection" data-testid="e2e-archive-all-except-latest" checked="@(_archiveSelection == CriticalE2EArchiveSelection.AllExceptLatest)"
                                   @onchange="() => _archiveSelection = CriticalE2EArchiveSelection.AllExceptLatest" />
                            All runs except the latest (@CriticalE2EPresentation.RunCount(preview.ArchiveCandidates))
                        </label>
                        @if (preview.ArchiveCandidatesNotOnCurrentBuild is { } notOnBuild)
                        {
                            <label class="e2e-toggle">
                                <input type="radio" name="e2e-archive-selection" data-testid="e2e-archive-not-on-build" checked="@(_archiveSelection == CriticalE2EArchiveSelection.NotOnCurrentBuild)"
                                       @onchange="() => _archiveSelection = CriticalE2EArchiveSelection.NotOnCurrentBuild" />
                                Runs not on build @CriticalE2EPresentation.BuildLabel(_buildId) (@CriticalE2EPresentation.RunCount(notOnBuild))
                            </label>
                        }
                    </fieldset>
                    <ul class="e2e-dialog-kept" data-testid="e2e-archive-kept">
                        <li>The latest run is kept.</li>
                        @if (preview.CurrentEvidenceRunId is not null)
                        {
                            <li>The current release evidence for build @CriticalE2EPresentation.BuildLabel(_buildId) is kept.</li>
                        }
                        <li>@CriticalE2EPresentation.RunCount(preview.ArchivedRuns) already archived.</li>
                    </ul>
                    @if (_historyError is { Length: > 0 } dialogError)
                    {
                        <p class="e2e-error" role="alert" data-testid="e2e-dialog-error">@dialogError</p>
                    }
                    <div class="e2e-dialog-actions">
                        <button type="button" class="btn-secondary" data-testid="e2e-dialog-cancel" @onclick="CloseHistoryDialogAsync">Cancel</button>
                        <button type="button" class="btn-primary" data-testid="e2e-archive-confirm" disabled="@(candidates == 0 || _historyBusy)" @onclick="ArchiveAsync">
                            @(candidates == 0 ? "Nothing to archive" : $"Archive {CriticalE2EPresentation.RunCount(candidates)}")
                        </button>
                    </div>
                }
                else
                {
                    var blocked = CriticalE2EPresentation.ClearBlocked(preview, _clearIncludeArchived);
                    var clearCount = CriticalE2EPresentation.ClearCount(preview, _clearIncludeArchived);
                    <h2 id="@titleId" class="e2e-dialog-title"><span aria-hidden="true">⚠</span> Clear test history — @preview.FlowName</h2>
                    <p id="@descId" class="e2e-dialog-text">
                        @(blocked ? "This flow has build-linked release evidence, so its history cannot be cleared." : $"This permanently deletes {CriticalE2EPresentation.RunCount(clearCount)} of this flow. It cannot be undone. The flow definition is kept.")
                    </p>
                    <dl class="e2e-dialog-facts" data-testid="e2e-clear-facts">
                        <div><dt>Flow</dt><dd>@preview.FlowName</dd></div>
                        <div><dt>Module</dt><dd>@preview.Module</dd></div>
                        <div><dt>Active runs</dt><dd data-testid="e2e-clear-active">@preview.ActiveRuns</dd></div>
                        <div><dt>Archived runs</dt><dd data-testid="e2e-clear-archived">@preview.ArchivedRuns</dd></div>
                        <div><dt>Build-linked runs</dt><dd data-testid="e2e-clear-build-linked">@preview.BuildLinkedRuns</dd></div>
                        <div><dt>Release evidence runs</dt><dd data-testid="e2e-clear-evidence">@preview.ReleaseEvidenceRuns</dd></div>
                    </dl>
                    <label class="e2e-toggle">
                        <input type="checkbox" data-testid="e2e-clear-include-archived" @bind="_clearIncludeArchived" /> Include archived runs
                    </label>
                    @if (blocked)
                    {
                        <p class="e2e-dialog-blocked" role="alert" data-testid="e2e-clear-blocked">Release evidence is protected. Archive old runs instead: that hides them and keeps the evidence.</p>
                    }
                    else
                    {
                        <label class="e2e-dialog-field">
                            <span>Type <strong>@CriticalE2EHistoryPolicy.ClearConfirmation</strong> to confirm</span>
                            <input data-testid="e2e-clear-confirmation" autocomplete="off" spellcheck="false" aria-describedby="@descId"
                                   @bind="_clearTyped" @bind:event="oninput" />
                        </label>
                    }
                    @if (_historyError is { Length: > 0 } dialogError)
                    {
                        <p class="e2e-error" role="alert" data-testid="e2e-dialog-error">@dialogError</p>
                    }
                    <div class="e2e-dialog-actions">
                        <button type="button" class="btn-secondary" data-testid="e2e-dialog-cancel" @onclick="CloseHistoryDialogAsync">Cancel</button>
                        @if (blocked)
                        {
                            <button type="button" class="btn-primary" data-testid="e2e-clear-archive-instead" @onclick="() => SwitchHistoryDialogAsync(HistoryDialog.Archive)">Archive old runs instead</button>
                        }
                        else
                        {
                            <button type="button" class="e2e-btn-destructive" data-testid="e2e-clear-confirm"
                                    disabled="@(!CriticalE2EPresentation.ClearConfirmed(_clearTyped) || clearCount == 0 || _historyBusy)" @onclick="ClearAsync">
                                Permanently clear @CriticalE2EPresentation.RunCount(clearCount)
                            </button>
                        }
                    </div>
                }
            </dialog>
        }
    }
</div>

@code {
    private CriticalE2EOverview? _overview;
    private CriticalE2EFlowDefinition? _editing;
    private CriticalE2ERunResult? _lastRun;
    // UI-local view state: a fresh page load starts with smoke/diagnostic flows and runs hidden; re-renders keep what the
    // reader chose. Deliberately not persisted anywhere.
    private bool _showDiagnostic;
    private bool _showDiagnosticRuns;
    private bool _showArchivedRuns;
    // Run history management: one flow at a time, through one dialog at a time.
    private enum HistoryDialog { None, Archive, Clear }
    private string _historyFlowId = "";
    private HistoryDialog _dialog;
    private bool _dialogOpenPending;
    private CriticalE2EHistoryPreview? _preview;
    private CriticalE2EArchiveSelection _archiveSelection;
    private bool _clearIncludeArchived = true;
    private string _clearTyped = "";
    private bool _historyBusy;
    private string? _historyStatus;
    private string? _historyError;
    private ElementReference _dialogElement, _archiveTrigger, _clearTrigger, _historyStatusElement;
    // Where focus goes after the next render: the control that opened a closed dialog, or the status line after a row
    // action removed the button that was pressed. Focusing before the render would hit a disabled or removed element.
    private ElementReference? _focusAfterRender;
    private IJSObjectReference? _dialogModule;
    private DotNetObjectReference<CriticalE2ERegression>? _self;
    private ElementReference _addButton;
    private bool _focusAdd;
    private string? _error;
    private string? _running;
    private CancellationTokenSource? _run;
    private string _profileId = "";
    private string _environmentId = "";
    private string _environmentName = "";
    private string? _environmentType;
    private string _buildId = "";
    private string _releaseId = "";
    private string _commitSha = "";

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    // Modules are not echoed back: the ones shown are derived from critical flows, and sending them back used to make
    // every label ever seen — a smoke module included — a permanent delivery module.
    private CriticalE2EOverviewRequest Request() => new()
    {
        ProfileId = _profileId, EnvironmentId = _environmentId, EnvironmentName = _environmentName,
        EnvironmentType = _environmentType, BuildId = Trim(_buildId), ReleaseId = Trim(_releaseId), CommitSha = Trim(_commitSha),
    };

    private static string? Trim(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private async Task RefreshAsync()
    {
        try
        {
            var context = await ContextFactory.GetActiveContextAsync();
            _profileId = context.ActiveProfile.Id;
            _environmentId = context.ActiveProfile.Id;
            _environmentName = context.ActiveProfile.Name;
            _environmentType = context.ActiveProfile.EnvironmentType.ToString();
            var request = Request() with
            {
                AuthenticationMethod = ReviewAuthenticationIdentity.ForContext(context).Method.ToString(),
                ContextFingerprint = ReviewAuthenticationIdentity.ForContext(context).ContextFingerprint,
            };
            _overview = await Api.OverviewAsync(request);
            _definitions = await Api.FlowsAsync(_environmentId);
            _error = null;
        }
        catch
        {
            _error = "Critical E2E is unavailable: the local BirkNext backend is not reachable.";
        }
    }

    private Task RunAsync(CriticalE2EExecutionMode mode) => StartAsync(mode.ToString(), new CriticalE2ERunFlowRequest { Context = Request(), Mode = mode });

    private Task RunFlowAsync(string flowId) => StartAsync(flowId, new CriticalE2ERunFlowRequest { Context = Request(), FlowId = flowId });

    private async Task StartAsync(string token, CriticalE2ERunFlowRequest request)
    {
        if (_running is not null) return;
        _running = token;
        _run = new CancellationTokenSource();
        try
        {
            var batch = await Api.RunAsync(request, _run.Token);
            _overview = batch.Overview;
            _lastRun = batch.Runs.LastOrDefault();
        }
        catch (OperationCanceledException) { await RefreshAsync(); }
        catch { _error = "The run could not be completed."; }
        finally
        {
            _running = null;
            _run?.Dispose();
            _run = null;
        }
    }

    private void Cancel() => _run?.Cancel();

    private void AddFlow() => _editing = new CriticalE2EFlowDefinition
    {
        ProfileId = _profileId, EnvironmentId = _environmentId, Mode = CriticalE2EExecutionMode.CompanionBrowser,
        Kind = CriticalE2EFlowKind.Critical,
        AuthenticationRequirement = CriticalE2EAuthenticationRequirement.ManualBrowserLogin,
        TestDataPolicy = $"Synthetic data only, prefixed {CriticalE2ECorrelation.TestDataPrefix}",
    };

    // The overview carries summaries, which are for reading. Editing needs the definition itself.
    private void Edit(string flowId) => _editing = _definitions.FirstOrDefault(f => f.Id == flowId);
    private List<CriticalE2EFlowDefinition> _definitions = [];

    private async Task SaveFlowAsync(CriticalE2EFlowDefinition flow)
    {
        try
        {
            await Api.SaveFlowAsync(flow);
            _editing = null;
            _focusAdd = true;
            await RefreshAsync();
        }
        catch { _error = "The flow could not be saved."; }
    }

    private void CancelEdit()
    {
        _editing = null;
        _focusAdd = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_dialogOpenPending && _dialog != HistoryDialog.None)
        {
            _dialogOpenPending = false;
            await DialogJsAsync("open", _dialogElement, _self ??= DotNetObjectReference.Create(this));
        }
        if (_focusAfterRender is { } target)
        {
            _focusAfterRender = null;
            try { await target.FocusAsync(); } catch (Exception ex) when (ex is JSException or InvalidOperationException) { }
        }
        // Closing the editor returns focus to the action that opened it.
        if (!_focusAdd) return;
        _focusAdd = false;
        try { await _addButton.FocusAsync(); } catch (InvalidOperationException) { }
    }

    // ── Run history: archive, restore, clear. None of these runs a flow or touches the Browser Companion. ──────

    private CriticalE2EOverviewRequest HistoryContext() => Request();

    /// <summary>The dialog opens with its counts already known, so what it says (and where focus starts) never changes under the reader.</summary>
    private async Task OpenHistoryDialogAsync(HistoryDialog dialog)
    {
        if (string.IsNullOrWhiteSpace(_historyFlowId) || _historyBusy) return;
        _historyBusy = true;
        _historyError = null;
        try
        {
            _preview = await Api.HistoryPreviewAsync(new CriticalE2EHistoryPreviewRequest { Context = HistoryContext(), FlowId = _historyFlowId });
            _dialog = dialog;
            _dialogOpenPending = true;
            _clearTyped = "";
            _clearIncludeArchived = true;
            _archiveSelection = CriticalE2EArchiveSelection.AllExceptLatest;
        }
        catch { _historyError = "This flow's history could not be checked. Nothing was changed."; }
        finally { _historyBusy = false; }
    }

    private async Task SwitchHistoryDialogAsync(HistoryDialog dialog)
    {
        // Same modal, other action: the preview already covers both.
        _dialog = dialog;
        _historyError = null;
        await Task.CompletedTask;
    }

    /// <summary>Esc in the browser. The dialog stays open until .NET closes it, so focus returns the same way every time.</summary>
    [JSInvokable]
    public async Task CancelHistoryDialog()
    {
        await CloseHistoryDialogAsync();
        StateHasChanged();
    }

    private async Task CloseHistoryDialogAsync()
    {
        _focusAfterRender = _dialog == HistoryDialog.Clear ? _clearTrigger : _archiveTrigger;
        await DialogJsAsync("close", _dialogElement);
        _dialog = HistoryDialog.None;
        _preview = null;
        _clearTyped = "";
    }

    private async Task DialogJsAsync(string method, params object[] args)
    {
        try
        {
            _dialogModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/historyDialog.js");
            await _dialogModule.InvokeVoidAsync(method, args);
        }
        // Prerender, tests, a torn-down circuit: the dialog still renders and its buttons still work, only focus handling is lost.
        catch (Exception ex) when (ex is JSException or InvalidOperationException or JSDisconnectedException or TaskCanceledException) { }
    }

    private async Task ArchiveAsync()
    {
        if (_preview is not { } preview) return;
        await HistoryActionAsync(() => Api.ArchiveRunsAsync(new CriticalE2EArchiveRequest { Context = HistoryContext(), FlowId = preview.FlowId, Selection = _archiveSelection }), closeDialog: true);
    }

    private Task ArchiveOneAsync(string flowId, string runId) =>
        HistoryActionAsync(() => Api.ArchiveRunsAsync(new CriticalE2EArchiveRequest
        {
            Context = HistoryContext(), FlowId = flowId, Selection = CriticalE2EArchiveSelection.Selected, RunIds = [runId],
        }), closeDialog: false);

    private Task RestoreAsync(string runId) =>
        HistoryActionAsync(() => Api.RestoreRunsAsync(new CriticalE2ERestoreRequest { Context = HistoryContext(), RunIds = [runId] }), closeDialog: false);

    private async Task ClearAsync()
    {
        if (_preview is not { } preview || !CriticalE2EPresentation.ClearConfirmed(_clearTyped)) return;
        await HistoryActionAsync(() => Api.ClearHistoryAsync(new CriticalE2EClearRequest
        {
            Context = HistoryContext(), FlowId = preview.FlowId, IncludeArchived = _clearIncludeArchived, Confirmation = _clearTyped.Trim(),
        }), closeDialog: true);
    }

    private async Task HistoryActionAsync(Func<Task<CriticalE2EHistoryActionResult>> action, bool closeDialog)
    {
        if (_historyBusy) return;
        _historyBusy = true;
        _historyError = null;
        try
        {
            var result = await action();
            _overview = result.Overview;
            if (result.Blocked)
            {
                // The backend refused: say why where the reader is looking, and change nothing.
                _historyError = result.Message;
                return;
            }
            _historyStatus = result.Message + (result.Skipped.Count > 0 ? $" Kept: {string.Join("; ", result.Skipped)}." : "");
            if (closeDialog) await CloseHistoryDialogAsync();
            else _focusAfterRender = _historyStatusElement;
        }
        catch { _historyError = "The run history could not be changed. Nothing was changed."; }
        finally { _historyBusy = false; }
    }

    private static string ResultTone(CriticalE2EStatus status) => status switch
    {
        CriticalE2EStatus.Passed => "good",
        CriticalE2EStatus.Failed => "bad",
        CriticalE2EStatus.Blocked => "warning",
        _ => "neutral",
    };

    private static string Slug(CriticalE2EExecutionMode mode) =>
        mode == CriticalE2EExecutionMode.CompanionBrowser ? "browser" : "integration";

    public async ValueTask DisposeAsync()
    {
        _run?.Cancel();
        _run?.Dispose();
        _self?.Dispose();
        if (_dialogModule is not null)
        {
            try { await _dialogModule.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
    }
}
