@page "/manual-testing/run"
@attribute [BirkNext.Web.Services.ReviewContextNotRead]
@using BirkNext.TestPlanning
@using BirkNext.Web.Services
@using M = BirkNext.Web.Services.ManualTestingPresentation
@using MR = BirkNext.Web.Services.ManualRunPresentation
@using R = BirkNext.TestPlanning.ManualRunRules
@implements IDisposable
@inject IServiceProvider ServiceProvider
@inject NavigationManager Nav
@inject IJSRuntime JS

@* Execute & document: run a SAVED test case step by step and record what happened. A run pins the case's steps and expected results when it
   starts, so later edits never rewrite it. Every outcome is the tester's decision (nothing is generated); evidence is a reference (a link or a
   note), never an uploaded file; a defect is a local observation that may name an existing work item. Nothing is sent to Azure DevOps. *@
<PageTitle>Gjennomfør og dokumenter — Manuell testing</PageTitle>

<NavigationLock ConfirmExternalNavigation="@_dirty" OnBeforeInternalNavigation="ConfirmLeaveAsync" />

<div class="mt" data-testid="mte" aria-busy="@(_loading || _busy ? "true" : "false")">
    <BirkNext.Web.Components.TestingWorkspaceHeader Workspace="Manuell testing" HomeRoute="@M.HomeRoute" Stages="M.Stages" Current="execute" Title="Gjennomfør og dokumenter"
        ProjectName="@_ws?.ProjectName" Context="@_ws?.SnapshotBasis"
        Lead="Hva skjedde under testingen? Kjør et lagret testtilfelle steg for steg: registrer Bestått, Feilet, Blokkert eller Ikke kjørt sammen med det du faktisk så, legg til dokumentasjon og feil, og ta vare på kjøringshistorikken." />

    @if (!_loading && !_enabled)
    {
        <p class="mt-alert" role="status" data-testid="mte-off">Testgjennomføring i BirkNext er slått av. Testene gjennomføres i Azure DevOps Test Plans. En administrator kan slå det på i Systeminnstillinger. Tidligere kjøringer kan fortsatt leses.</p>
    }
    @if (_message is not null)
    {
        <p class="@(_messageBad ? "mt-alert" : "mt-muted")" role="@(_messageBad ? "alert" : "status")" data-testid="mte-message">@_message</p>
    }

    @if (_loading)
    {
        <p class="mt-muted" role="status" data-testid="mte-loading">Laster…</p>
    }
    else if (_ws?.ProjectKey is null)
    {
        <p class="mt-muted" data-testid="mte-no-project">Ingen prosjekt er valgt. <a href="project-import">Importer eller velg et prosjekt</a> først.</p>
    }
    else if (_run is not null)
    {
        @Runner(_run)
    }
    else if (_startCase is not null && _startPlan is not null)
    {
        @StartPanel(_startPlan, _startCase)
    }
    else
    {
        @Overview()
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "run")] public string? RunQuery { get; set; }
    [SupplyParameterFromQuery(Name = "draft")] public string? DraftQuery { get; set; }
    [SupplyParameterFromQuery(Name = "case")] public string? CaseQuery { get; set; }

    private IManualTestRunsApiService? _runs;
    private ITestPlanSuggestionsApiService? _plans;
    private ManualTestingWorkspace.Snapshot? _ws;
    private ICurrentWorkspaceProjection? _projection;
    private bool _loading = true;
    private bool _busy;
    private string? _message;
    private bool _messageBad;

    // Overview: the project's saved cases (by plan) and the run history.
    private readonly List<TestPlanDraft> _drafts = [];
    // Start: one saved case.
    private TestPlanDraft? _startPlan;
    private TestCaseDraft? _startCase;
    private string _environment = "";
    // Runner: the stored run and the working copy of what the tester changed.
    private ManualTestRun? _run;
    private Dictionary<int, (ManualStepOutcome? Outcome, string? Actual)> _steps = [];
    private string _notes = "";
    private string _runEnvironment = "";
    private List<ManualRunEvidence> _evidence = [];
    private List<ManualRunDefect> _defects = [];
    private bool _dirty;
    private string _abandonReason = "";
    // New evidence / defect forms.
    private ManualEvidenceKind _evKind = ManualEvidenceKind.Link;
    private string _evLabel = "", _evReference = "";
    private int? _evStep;
    private ManualRunDefect _newDefect = new();

    private (string?, string?, string?)? _loaded;

    private IDisposable? _unsaved;

    protected override void OnInitialized()
    {
        // A project switch asks before discarding an unsaved run (the same protection as leaving the page).
        _unsaved = (ServiceProvider.GetService(typeof(BirkNext.Web.Services.ProjectImport.UnsavedWorkGuard)) as BirkNext.Web.Services.ProjectImport.UnsavedWorkGuard)?.Register(() => _dirty ? "Denne kjøringen har resultater som ikke er lagret." : null);
        _runs = ServiceProvider.GetService(typeof(IManualTestRunsApiService)) as IManualTestRunsApiService;
        _plans = ServiceProvider.GetService(typeof(ITestPlanSuggestionsApiService)) as ITestPlanSuggestionsApiService;
        _projection = ServiceProvider.GetService(typeof(ICurrentWorkspaceProjection)) as ICurrentWorkspaceProjection;
        if (_projection is not null) _projection.Changed += OnProjectChanged;
    }

    /// <summary>First load, and Back / Forward or in-page links that change ?run / ?draft / ?case: load what the address names.</summary>
    protected override async Task OnParametersSetAsync()
    {
        var query = (RunQuery, DraftQuery, CaseQuery);
        if (_loaded == query) return;
        _loaded = query;
        await LoadAsync();
    }

    public void Dispose()
    {
        _unsaved?.Dispose();
        if (_projection is not null) _projection.Changed -= OnProjectChanged;
    }

    private void OnProjectChanged() => _ = InvokeAsync(async () => { _run = null; _startCase = null; _dirty = false; await LoadAsync(); StateHasChanged(); });

    /// <summary>The project's runs (read through the run API; never on the shared workspace snapshot).</summary>
    private List<ManualRunSummary> _runList = [];
    /// <summary>Whether testers can record runs in BirkNext (System settings; off by default). Off: history stays readable, nothing can be recorded.</summary>
    private bool _enabled;

    private async Task LoadAsync()
    {
        _loading = true;
        string? Q(string name) => name switch { "run" => RunQuery, "draft" => DraftQuery, "case" => CaseQuery, _ => null };
        try
        {
            _ws = await new ManualTestingWorkspace(ServiceProvider).LoadAsync(discovery: false, requirements: false);
            _run = null; _startCase = null; _startPlan = null; _drafts.Clear();
            _enabled = _runs is not null && await _runs.AvailabilityAsync();
            if (_ws.ProjectKey is not { } key || _runs is null || _plans is null) return;
            var (listed, listError) = await _runs.ListAsync(key);
            _runList = listed ?? [];
            if (listError is not null) Fail(listError);
            if (Guid.TryParse(Q("run"), out var runId))
            {
                var (run, error) = await _runs.GetAsync(key, runId);
                if (run is null) Fail(error ?? "Kjøringen kunne ikke åpnes.");
                else Use(run);
                return;
            }
            if (Guid.TryParse(Q("draft"), out var draftId) && Q("case") is { Length: > 0 } caseId)
            {
                var (plan, error) = await _plans.DraftAsync(draftId);
                if (plan is null || plan.ProjectKey != key) { Fail(plan is null ? error ?? "Planen kunne ikke åpnes." : "Den planen tilhører et annet prosjekt og vises ikke her."); }
                else if (plan.Cases.FirstOrDefault(c => c.Source.ScenarioId == caseId) is not { } c) Fail("Det testtilfellet finnes ikke lenger i planen.");
                else { _startPlan = plan; _startCase = c; _environment = _runList.Where(r => r.Environment is not null).Select(r => r.Environment!).FirstOrDefault() ?? ""; return; }
            }
            foreach (var summary in _ws.Plans?.Drafts ?? [])
                if ((await _plans.DraftAsync(summary.Id)).Draft is { } d && d.ProjectKey == key) _drafts.Add(d);
            await LoadHistoryAsync(key, reset: true);
            await LoadDefectsAsync(key);
        }
        finally { _loading = false; }
    }

    // Run history is paged by the server (newest first, exact total) so a long history is never shown as if it were complete.
    private const int HistoryPageSize = 50;
    private ManualRunPage? _history;
    private readonly List<ManualRunSummary> _historyRows = [];
    private bool _historyBusy, _reportBusy;
    private string? _reportError;

    /// <summary>All runs of the project (every page of the history, not only the rows shown) as a CSV report.</summary>
    private async Task DownloadRunResultsAsync()
    {
        if (_ws?.ProjectKey is not { } key || _runs is null || _reportBusy) return;
        _reportBusy = true; _reportError = null;
        try
        {
            var all = new List<ManualRunSummary>();
            for (var guard = 0; guard < 100; guard++)
            {
                var (page, error) = await _runs.PageAsync(key, all.Count, 200);
                if (page is null) { if (all.Count == 0) { all.AddRange(_runList); } else _reportError = error ?? "Ikke alle kjøringer kunne leses, så rapporten ble ikke lastet ned."; break; }
                all.AddRange(page.Runs.Where(r => all.All(x => x.Id != r.Id)));
                if (page.Runs.Count == 0 || all.Count >= page.Total) break;
            }
            if (_reportError is not null) return;
            var plans = _drafts.GroupBy(d => d.Id).ToDictionary(g => g.Key, g => g.First().PlanName);
            await JS.InvokeVoidAsync("downloadTextFile", $"manual-test-results-{DateTime.Now:yyyy-MM-dd}.csv", MR.RunResultsCsv(all, plans), "text/csv;charset=utf-8");
        }
        finally { _reportBusy = false; }
    }

    private async Task LoadHistoryAsync(string key, bool reset)
    {
        if (_runs is null) return;
        if (reset) { _history = null; _historyRows.Clear(); }
        var (page, _) = await _runs.PageAsync(key, _historyRows.Count, HistoryPageSize);
        if (page is null) return; // the unpaged list (_runList) stays the fallback
        _history = page;
        _historyRows.AddRange(page.Runs.Where(r => _historyRows.All(x => x.Id != r.Id)));
    }

    private async Task MoreHistoryAsync()
    {
        if (_ws?.ProjectKey is not { } key || _historyBusy) return;
        _historyBusy = true;
        try { await LoadHistoryAsync(key, reset: false); }
        finally { _historyBusy = false; }
    }

    private void Fail(string text) { _message = text; _messageBad = true; }
    private void Info(string text) { _message = text; _messageBad = false; }

    private void Use(ManualTestRun run)
    {
        _run = run;
        _steps = run.Steps.ToDictionary(s => s.Number, s => (s.Outcome, s.Actual));
        _notes = run.Notes ?? "";
        _runEnvironment = run.Environment ?? "";
        _evidence = [.. run.Evidence];
        _defects = [.. run.Defects];
        _dirty = false;
        _withdrawing = null;
        _ = InvokeAsync(async () => { await LoadFilesAsync(); StateHasChanged(); }); // scan state and withdrawal of attached files
    }

    /// <summary>Unsaved results are never lost silently: leaving asks first (Save progress keeps them).</summary>
    private async Task ConfirmLeaveAsync(Microsoft.AspNetCore.Components.Routing.LocationChangingContext context)
    {
        if (!_dirty) return;
        bool leave;
        try { leave = await JS.InvokeAsync<bool>("confirm", "Denne kjøringen har resultater som ikke er lagret. Vil du forlate siden uten å lagre dem?"); }
        catch (JSException) { leave = false; }
        if (!leave) context.PreventNavigation();
    }

    // ── Overview ─────────────────────────────────────────────────────────────────────────────────────────────

    private RenderFragment Overview() => __builder =>
    {
        var byCase = _runList.GroupBy(r => r.CaseKey).ToDictionary(g => g.Key, g => g.ToList());
        <section class="mt-card" aria-labelledby="mte-cases-title" data-testid="mte-cases">
            <h2 id="mte-cases-title" class="mt-h">Velg et lagret testtilfelle du vil kjøre</h2>
            @if (_drafts.Count == 0 || _drafts.All(d => d.Cases.Count == 0))
            {
                <p class="mt-muted" data-testid="mte-cases-none">Ingen lagrede testtilfeller ennå. Klargjør et testtilfelle i <a href="@($"{M.PlanRoute}?area=choose")">Planlegg og klargjør</a>.</p>
            }
            @foreach (var d in _drafts.Where(d => d.Cases.Count > 0))
            {
                <h3 class="mt-h">@d.PlanName</h3>
                <ul class="mt-list">
                    @foreach (var c in d.Cases)
                    {
                        var key = $"{d.Id:N}/{c.Source.ScenarioId}";
                        var runs = byCase.GetValueOrDefault(key) ?? [];
                        var open = runs.FirstOrDefault(r => r.State == ManualRunState.InProgress);
                        var last = runs.Where(r => r.State == ManualRunState.Completed).OrderByDescending(r => r.CompletedAt).FirstOrDefault();
                        var runnable = c.Review is not (TestCaseReviewState.Excluded or TestCaseReviewState.Superseded) && c.EffectiveSteps.Count > 0;
                        <li data-testid="mte-case" data-case="@c.Source.ScenarioId">
                            <strong>@c.EffectiveTitle</strong>
                            <span class="mt-chip mt-tone-muted">@P(c.Review)</span>
                            @if (last is not null)
                            {
                                <span class="mt-chip mt-tone-@MR.RunTone(last.State, last.Outcome)" data-testid="mte-case-last">Siste kjøring: @MR.RunLabel(last.State, last.Outcome)</span>
                                @* The last run executed an earlier version of this case (its content changed since): run it again to test what is saved now. *@
                                @if (last.CaseFingerprint != R.CaseFingerprint(c)) { <span class="mt-chip mt-tone-warn" data-testid="mte-case-stale">Testtilfellet er endret siden — kjør på nytt</span> }
                            }
                            @if (open is not null) { <a href="@($"{MR.ExecuteRoute}?run={open.Id}")" data-testid="mte-resume">Fortsett kjøringen</a> }
                            else if (runnable) { <a href="@($"{MR.ExecuteRoute}?draft={d.Id}&case={Uri.EscapeDataString(c.Source.ScenarioId)}")" data-testid="mte-run">Kjør</a> }
                            else { <span class="mt-muted">@(c.EffectiveSteps.Count == 0 ? "Legg til steg før du kjører." : "Utelatt — kjøres ikke.")</span> }
                        </li>
                    }
                </ul>
            }
        </section>
        @History(_history is null ? _runList : _historyRows)
        @DefectList()
    };

    private RenderFragment History(IReadOnlyList<ManualRunSummary> runs) => __builder =>
    {
        <section class="mt-card" aria-labelledby="mte-history-title" data-testid="mte-history">
            <h2 id="mte-history-title" class="mt-h">Kjøringshistorikk</h2>
            @if (runs.Count > 0)
            {
                <p><button type="button" class="btn btn-secondary btn-sm" data-testid="mte-history-download" disabled="@_reportBusy" @onclick="DownloadRunResultsAsync">Last ned kjøringsresultater (CSV)</button>
                    <span class="mt-muted">Alle kjøringer i dette prosjektet, til Excel eller en rapport. Bare resultater — klargjorte testtilfeller som aldri er kjørt, er ikke med.</span></p>
                @if (_reportError is not null) { <p class="mt-alert" role="alert" data-testid="mte-history-download-error">@_reportError</p> }
            }
            @if (_history is { Total: > 0 } paging)
            {
                <p class="mt-muted" data-testid="mte-history-count" aria-live="polite">Viser @runs.Count av @paging.Total @(paging.Total == 1 ? "kjøring" : "kjøringer"), nyeste først.</p>
            }
            @if (runs.Count == 0)
            {
                <p class="mt-muted" data-testid="mte-history-none">Ingen kjøringer registrert ennå.</p>
            }
            else
            {
                <table class="mte-table mte-history-table">
                    <colgroup><col class="mte-c-case" /><col class="mte-c-result" /><col class="mte-c-when" /><col class="mte-c-tester" /><col class="mte-c-steps" /><col class="mte-c-defects" /></colgroup>
                    <thead><tr><th scope="col">Testtilfelle</th><th scope="col">Resultat</th><th scope="col">Tidspunkt</th><th scope="col">Tester · miljø</th><th scope="col">Steg</th><th scope="col">Feil · dokumentasjon</th></tr></thead>
                    <tbody>
                        @foreach (var r in runs.OrderByDescending(x => x.StartedAt))
                        {
                            <tr data-testid="mte-history-row" data-run="@r.Id" data-state="@r.State" data-outcome="@r.Outcome">
                                <td data-label="Testtilfelle"><a href="@($"{MR.ExecuteRoute}?run={r.Id}")">@r.Title</a> <span class="mt-muted">planrevisjon @r.PlanRevision</span></td>
                                <td data-label="Resultat"><span class="mt-chip mt-tone-@MR.RunTone(r.State, r.Outcome)">@MR.RunLabel(r.State, r.Outcome)</span></td>
                                <td data-label="Tidspunkt">@((r.CompletedAt ?? r.StartedAt).ToLocalTime().ToString("yyyy-MM-dd HH:mm"))</td>
                                <td data-label="Tester · miljø">@r.Tester@(r.Environment is { } env ? $" · {env}" : "")</td>
                                <td data-label="Steg" title="@($"{r.Passed} bestått · {r.Failed} feilet · {r.Blocked} blokkert · {r.NotRun} ikke kjørt · {r.Undecided} ikke avgjort")">@MR.StepCounts(r)</td>
                                <td data-label="Feil · dokumentasjon">@r.Defects feil (@r.OpenDefects @(r.OpenDefects == 1 ? "åpen" : "åpne")) · @r.Evidence @(r.Evidence == 1 ? "referanse" : "referanser")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (_history is { } more && runs.Count < more.Total)
                {
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="MoreHistoryAsync" disabled="@_historyBusy" data-testid="mte-history-more">Vis eldre kjøringer</button>
                }
            }
        </section>
    };

    private static string P(TestCaseReviewState state) => state switch
    {
        TestCaseReviewState.Accepted => "Godkjent", TestCaseReviewState.NeedsClarification => "Trenger avklaring", TestCaseReviewState.Excluded => "Utelatt",
        TestCaseReviewState.Superseded => "Erstattet", TestCaseReviewState.UnderReview => "Klar for gjennomgang", _ => "Klargjort",
    };

    // ── Start ────────────────────────────────────────────────────────────────────────────────────────────────

    private RenderFragment StartPanel(TestPlanDraft plan, TestCaseDraft c) => __builder =>
    {
        var open = _runList.FirstOrDefault(r => r.CaseKey == $"{plan.Id:N}/{c.Source.ScenarioId}" && r.State == ManualRunState.InProgress);
        <section class="mt-card" aria-labelledby="mte-start-title" data-testid="mte-start">
            <h2 id="mte-start-title" class="mt-h">@c.EffectiveTitle</h2>
            <p class="mt-muted">@plan.PlanName · planrevisjon @plan.Revision · @c.EffectiveSteps.Count steg</p>
            @if (c.Edits.BlockedBy is { Length: > 0 } blockedBy)
            {
                <p class="mt-alert" role="status" data-testid="mte-start-blocked">Dette testtilfellet er merket som blokkert av: @blockedBy. Du kan likevel starte en kjøring og registrere Blokkert for stegene som ikke kan gjennomføres.</p>
            }
            @* Before you start: everything the tester needs to prepare, from the saved case (nothing to look up elsewhere). *@
            <dl class="mte-before" data-testid="mte-start-before">
                @if (c.EffectivePreconditions is { Length: > 0 } pre) { <div><dt>Forutsetninger</dt><dd>@pre</dd></div> }
                @if (c.EffectiveEnvironment is { Length: > 0 } needs) { <div data-testid="mte-start-env-needed"><dt>Miljø som trengs</dt><dd>@needs</dd></div> }
                @if (c.TestData.Count > 0) { <div data-testid="mte-start-test-data"><dt>Testdata</dt><dd>@string.Join(", ", c.TestData.Select(d => string.IsNullOrWhiteSpace(d.Alias) ? d.AssetId : d.Alias))</dd></div> }
            </dl>
            <ol>@foreach (var s in c.EffectiveSteps) { <li>@s</li> }</ol>
            @if (open is not null)
            {
                <p data-testid="mte-start-open">En kjøring av dette testtilfellet pågår allerede (startet @open.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")).</p>
                <a class="btn btn-primary" href="@($"{MR.ExecuteRoute}?run={open.Id}")" data-testid="mte-start-resume">Fortsett kjøringen</a>
            }
            else
            {
                var suggested = SuggestedEnvironment(plan, c);
                <label class="mte-field"><span>Hvor tester du? (valgfritt)</span>
                    <input value="@(_environmentTouched ? _environment : suggested ?? "")" @oninput="e => { _environment = e.Value?.ToString() ?? string.Empty; _environmentTouched = true; }" placeholder="For eksempel QA eller Testmiljø 2" maxlength="200" data-testid="mte-start-env" /></label>
                @if (!_environmentTouched && suggested is not null) { <p class="mt-muted" data-testid="mte-start-env-suggested">Fylt ut fra siste kjøring@(LastRunOf(plan, c) is not null ? " av dette testtilfellet" : " i dette prosjektet"). Endre det hvis du tester et annet sted.</p> }
                <p class="mt-muted">Kjøringen bruker testtilfellet nøyaktig slik det er lagret nå. Endrer du testtilfellet senere, påvirker det ikke denne kjøringen.</p>
                <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="() => StartAsync(plan, c)" data-testid="mte-start-run">Start testkjøring</button>
            }
            <a class="btn btn-secondary" href="@MR.ExecuteRoute">Tilbake til alle testtilfeller</a>
        </section>
    };

    private bool _environmentTouched;

    private ManualRunSummary? LastRunOf(TestPlanDraft plan, TestCaseDraft c) =>
        _runList.Where(r => r.CaseKey == $"{plan.Id:N}/{c.Source.ScenarioId}" && !string.IsNullOrWhiteSpace(r.Environment)).OrderByDescending(r => r.StartedAt).FirstOrDefault();

    /// <summary>Where the tester last tested this case (else anything in this project) — so the same environment is not typed again for every run.</summary>
    private string? SuggestedEnvironment(TestPlanDraft plan, TestCaseDraft c) =>
        (LastRunOf(plan, c) ?? _runList.Where(r => !string.IsNullOrWhiteSpace(r.Environment)).OrderByDescending(r => r.StartedAt).FirstOrDefault())?.Environment;

    private async Task StartAsync(TestPlanDraft plan, TestCaseDraft c)
    {
        _busy = true;
        Info("Starter testkjøringen…");
        var environment = _environmentTouched ? _environment : SuggestedEnvironment(plan, c) ?? "";
        var (run, error) = await _runs!.StartAsync(new StartManualRunRequest(_ws!.ProjectKey!, plan.Id, c.Source.ScenarioId, string.IsNullOrWhiteSpace(environment) ? null : environment.Trim()));
        _busy = false;
        if (run is null) { Fail(error ?? "Kjøringen kunne ikke startes."); return; }
        Info("Testkjøringen er startet. Registrer et resultat for hvert steg, og fullfør deretter kjøringen.");
        Nav.NavigateTo($"{MR.ExecuteRoute}?run={run.Id}");
    }

    // ── Runner ───────────────────────────────────────────────────────────────────────────────────────────────

    private ManualRunOutcome Preview => R.Rollup([.. _run!.Steps.Select(s => s with { Outcome = _steps.GetValueOrDefault(s.Number).Outcome })]);

    private RenderFragment Runner(ManualTestRun run) => __builder =>
    {
        var editable = run.State == ManualRunState.InProgress;
        var undecided = run.Steps.Count(s => _steps.GetValueOrDefault(s.Number).Outcome is null);
        <section class="mt-card" aria-labelledby="mte-run-title" data-testid="mte-runner" data-state="@run.State" data-outcome="@run.Outcome">
            <h2 id="mte-run-title" class="mt-h">@run.Title</h2>
            <p class="mt-muted" data-testid="mte-run-meta">@run.PlanName · planrevisjon @run.PlanRevision (låst da kjøringen startet) · startet @run.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") av @run.Tester</p>
            <p>
                <span class="mt-chip mt-tone-@MR.RunTone(run.State, run.Outcome)" data-testid="mte-run-state">@MR.RunLabel(run.State, run.Outcome)</span>
                @if (editable) { <span class="mt-muted" data-testid="mte-preview">Hvis du fullfører nå: @MR.OutcomeLabel(Preview)@(undecided > 0 ? $" — {undecided} steg uten resultat" : "")</span> }
                @if (_dirty) { <span class="mt-chip mt-tone-warn" data-testid="mte-unsaved">Endringer er ikke lagret</span> }
            </p>
            @if (run.State == ManualRunState.Abandoned) { <p data-testid="mte-abandoned">Avbrutt: @run.AbandonReason. En avbrutt kjøring blir liggende i historikken, men teller aldri som en gjennomføring.</p> }
            @if (run.Preconditions is { Length: > 0 } pre) { <p><strong>Forutsetninger:</strong> <span style="white-space: pre-wrap">@pre</span></p> }
            @if (run.RetestOf is { } retestOf) { <p class="mt-muted" data-testid="mte-retest-of">Ny test etter en tidligere feilet eller blokkert kjøring — <a href="@($"{MR.ExecuteRoute}?run={retestOf}")">åpne den kjøringen</a>.</p> }
            @if (run.Origin is { } origin)
            {
                @* Specification → scenario → case → this run, pinned when the run started. *@
                <p class="mt-muted" data-testid="mte-run-origin">@(origin.SpecificationFile is { } specFile
                    ? $"Klargjort fra {specFile}{(origin.SpecificationScenarioId is { } sc ? $", akseptansescenario {sc}" : "")}."
                    : origin.SourceKind == ScenarioSourceKind.Manual ? "Skrevet for hånd i Planlegg og klargjør (ingen spesifikasjon som kilde)." : "Klargjort fra et funnet scenario (ingen spesifikasjonsfil).")</p>
                @if (origin.Requirements.Count > 0)
                {
                    <p class="mt-muted" data-testid="mte-run-requirements">Krav: @string.Join(", ", origin.Requirements.Select(q => $"{q.RequirementId} ({(q.Basis == "Manual link" ? $"koblet av {q.LinkedBy ?? "en tester"}" : "fra spesifikasjonen")}{(q.SpecificationFile is { } f && f != origin.SpecificationFile ? $", {f}" : "")})"))</p>
                }
            }
            else if (run.RequirementIds.Count > 0) { <p class="mt-muted">Krav: @string.Join(", ", run.RequirementIds)</p> }
            @if (run.TestData.Count > 0) { <p class="mt-muted">Testdata: @string.Join(", ", run.TestData)</p> }
            @if (editable)
            {
                <label class="mte-field"><span>Hvor tester du?</span>
                    <input value="@_runEnvironment" @oninput="e => { _runEnvironment = e.Value?.ToString() ?? string.Empty; _dirty = true; }" maxlength="200" data-testid="mte-env" /></label>
            }
            else if (run.Environment is { } env) { <p class="mt-muted">Miljø: @env</p> }
        </section>

        @foreach (var s in run.Steps)
        {
            var current = _steps.GetValueOrDefault(s.Number);
            var n = s.Number;
            <section class="mte-step" aria-labelledby="@($"mte-step-title-{n}")" data-testid="mte-step" data-step="@n" data-outcome="@(current.Outcome?.ToString() ?? "none")">
                <div class="mte-step-head"><h3 id="@($"mte-step-title-{n}")">Steg @n</h3>
                    <span class="mt-chip @(current.Outcome switch { ManualStepOutcome.Pass => "mt-tone-ok", ManualStepOutcome.Fail => "mt-tone-bad", null => "mt-tone-muted", _ => "mt-tone-warn" })">@MR.StepLabel(current.Outcome)</span></div>
                <dl class="mte-dl"><dt>Handling</dt><dd>@s.Action</dd><dt>Forventet resultat</dt><dd>@(s.Expected ?? "Ikke oppgitt — avklar før du vurderer")</dd></dl>
                @if (editable)
                {
                    <fieldset class="mte-outcomes">
                        <legend>Resultat for steg @n</legend>
                        @foreach (var o in Enum.GetValues<ManualStepOutcome>())
                        {
                            <label><input type="radio" name="@($"mte-outcome-{n}")" value="@o" checked="@(current.Outcome == o)" @onchange="() => SetOutcome(n, o)" data-testid="@($"mte-outcome-{n}-{o}")" /> @MR.StepLabel(o)</label>
                        }
                    </fieldset>
                    <label class="mte-field"><span>Faktisk resultat</span>
                        <textarea rows="2" @oninput="e => SetActual(n, e.Value?.ToString())" data-testid="@($"mte-actual-{n}")" placeholder="Det du så">@current.Actual</textarea></label>
                    @if (current.Outcome is ManualStepOutcome.Fail or ManualStepOutcome.Blocked)
                    {
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => DefectFor(s)" data-testid="@($"mte-defect-for-{n}")">Registrer en feil for steg @n</button>
                    }
                }
                else if (current.Actual is { Length: > 0 } actual) { <dl class="mte-dl"><dt>Faktisk resultat</dt><dd>@actual</dd></dl> }
            </section>
        }

        @Evidence(run, editable)
        @Defects(run, editable)

        <section class="mt-card" aria-labelledby="mte-notes-title">
            <h2 id="mte-notes-title" class="mt-h">Notater</h2>
            @if (editable)
            {
                <textarea class="mte-field" rows="3" style="width:100%" @oninput="e => { _notes = e.Value?.ToString() ?? string.Empty; _dirty = true; }" data-testid="mte-notes" aria-labelledby="mte-notes-title">@_notes</textarea>
            }
            else { <p>@(run.Notes ?? "Ingen notater.")</p> }
        </section>

        @if (editable)
        {
            <div class="mte-bar" data-testid="mte-actions">
                <button type="button" class="btn btn-primary" disabled="@(_busy || !_dirty)" @onclick="SaveAsync" data-testid="mte-save">Lagre fremdrift</button>
                <button type="button" class="btn btn-secondary" disabled="@(_busy || undecided > 0)" @onclick="CompleteAsync" data-testid="mte-complete">Fullfør kjøringen</button>
                @if (undecided > 0) { <span class="mt-muted" data-testid="mte-complete-why">Registrer et resultat for hvert steg for å fullføre kjøringen (@undecided gjenstår).</span> }
            </div>
            <details class="mt-card">
                <summary>Avbryt kjøringen uten resultat</summary>
                <label class="mte-field"><span>Hvorfor avbrytes kjøringen?</span><input value="@_abandonReason" @oninput="e => _abandonReason = e.Value?.ToString() ?? string.Empty" data-testid="mte-abandon-reason" /></label>
                <button type="button" class="btn btn-secondary btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_abandonReason))" @onclick="AbandonAsync" data-testid="mte-abandon">Avbryt kjøringen</button>
            </details>
        }
        <p><a href="@MR.ExecuteRoute" data-testid="mte-back">Alle testtilfeller og kjøringshistorikk</a> · <a href="@($"{M.PlanRoute}?draft={run.DraftId}&area=prepare&case={Uri.EscapeDataString(run.CaseId)}")" data-testid="mte-open-case">Åpne testtilfellet</a></p>
    };

    private RenderFragment Evidence(ManualTestRun run, bool editable) => __builder =>
    {
        <section class="mt-card" aria-labelledby="mte-ev-title" data-testid="mte-evidence">
            <h2 id="mte-ev-title" class="mt-h">Dokumentasjon</h2>
            <p class="mt-muted">Legg ved et skjermbilde, en PDF eller en logg (opptil 10 MB), eller legg til en lenke eller et notat om hvor dokumentasjonen ligger.@(run.State == ManualRunState.Completed ? " Filer du legger ved nå, lagres som oppfølgingsdokumentasjon ved siden av det som ble registrert under kjøringen." : "")</p>
            @if (_evidence.Count == 0) { <p class="mt-muted" data-testid="mte-evidence-none">Ingen dokumentasjon ennå.</p> }
            <ul class="mte-items">
                @foreach (var e in _evidence.ToList())
                {
                    <li data-testid="mte-evidence-item" data-kind="@e.Kind">
                        <strong>@e.Label</strong>
                        @if (e.Kind == ManualEvidenceKind.Attachment)
                        {
                            <span>@e.FileName</span>
                            var info = FileInfoOf(e);
                            @if (info?.WithdrawnAt is { } withdrawnAt)
                            {
                                <span class="mt-chip mt-tone-muted" data-testid="mte-attachment-withdrawn" title="SHA-256 @info.Sha256">trukket tilbake @withdrawnAt.ToLocalTime().ToString("yyyy-MM-dd") av @info.WithdrawnBy: @info.WithdrawReason</span>
                            }
                            else
                            {
                                <button type="button" class="btn btn-secondary btn-sm" data-testid="mte-attachment-download" aria-label="@($"Last ned {e.FileName}")" @onclick="() => DownloadAttachmentAsync(e)">Last ned</button>
                                @if (info is not null)
                                {
                                    <span class="mt-chip @(info.ScanStatus == "clean" ? "mt-tone-ok" : "mt-tone-muted")" data-testid="mte-attachment-scan" data-scan="@info.ScanStatus"
                                          title="@(info.ScanStatus == "clean" ? "Skannet for skadevare: ren" : "BirkNext har ingen skadevareskanner her: filen er bare kontrollert for filtype og innhold. Åpne den med vanlig forsiktighet.")">@(info.ScanStatus == "clean" ? "skadevareskanning: ren" : "ikke skannet for skadevare")</span>
                                    @if (_withdrawing == e.Reference)
                                    {
                                        <label class="mte-field"><span>Hvorfor trekkes filen tilbake?</span><input value="@_withdrawReason" @oninput="x => _withdrawReason = x.Value?.ToString() ?? string.Empty" maxlength="500" data-testid="mte-attachment-withdraw-reason" /></label>
                                        <button type="button" class="btn btn-danger btn-sm" disabled="@string.IsNullOrWhiteSpace(_withdrawReason)" @onclick="() => WithdrawAsync(e)" data-testid="mte-attachment-withdraw-confirm">Trekk tilbake filen</button>
                                        <button type="button" class="btn btn-link btn-sm" @onclick="() => { _withdrawing = null; _withdrawReason = string.Empty; }">Avbryt</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-link btn-sm" @onclick="() => { _withdrawing = e.Reference; _withdrawReason = string.Empty; }" data-testid="mte-attachment-withdraw"
                                                aria-label="@($"Trekk tilbake {e.FileName}")">Trekk tilbake</button>
                                    }
                                }
                            }
                            @if (e.AddedAfterCompletion) { <span class="mt-chip mt-tone-muted" data-testid="mte-attachment-followup">lagt til etter fullføring</span> }
                        }
                        else if (e.Kind == ManualEvidenceKind.Link && Uri.TryCreate(e.Reference, UriKind.Absolute, out var u) && (u.Scheme == "https" || u.Scheme == "http"))
                        { <a href="@e.Reference" target="_blank" rel="noopener noreferrer">@e.Reference</a> }
                        else { <span>@e.Reference</span> }
                        <span class="mt-muted">@(e.Kind switch { ManualEvidenceKind.Link => "lenke", ManualEvidenceKind.Attachment => $"fil · {MR.FileSize(e.Size)}", _ => "notat" })@(e.Step is { } st ? $" · steg {st}" : " · hele kjøringen")@(e.AddedBy.Length > 0 ? $" · {e.AddedBy}" : " · ikke lagret ennå")</span>
                        @if (editable) { <button type="button" class="btn btn-secondary btn-sm" aria-label="@($"Fjern dokumentasjonen {e.Label}")" @onclick="() => { _evidence.Remove(e); _dirty = true; }">Fjern</button> }
                    </li>
                }
            </ul>
            @if (editable)
            {
                <div class="mte-row">
                    <label class="mte-field"><span>Type</span>
                        <select @onchange="e => _evKind = Enum.TryParse<ManualEvidenceKind>(e.Value?.ToString(), out var k) ? k : ManualEvidenceKind.Link" data-testid="mte-ev-kind">
                            <option value="Link" selected="@(_evKind == ManualEvidenceKind.Link)">Lenke (https://…)</option>
                            <option value="Note" selected="@(_evKind == ManualEvidenceKind.Note)">Notat (hvor den ligger)</option>
                        </select></label>
                    <label class="mte-field"><span>Navn</span><input value="@_evLabel" @oninput="e => _evLabel = e.Value?.ToString() ?? string.Empty" maxlength="200" data-testid="mte-ev-label" /></label>
                    <label class="mte-field"><span>@(_evKind == ManualEvidenceKind.Link ? "Adresse" : "Hvor den ligger")</span><input value="@_evReference" @oninput="e => _evReference = e.Value?.ToString() ?? string.Empty" maxlength="1000" data-testid="mte-ev-reference" /></label>
                    <label class="mte-field"><span>Gjelder</span>
                        <select @onchange="e => _evStep = int.TryParse(e.Value?.ToString(), out var v) ? v : null" data-testid="mte-ev-step">
                            <option value="" selected="@(_evStep is null)">Hele kjøringen</option>
                            @foreach (var s in run.Steps) { <option value="@s.Number" selected="@(_evStep == s.Number)">Steg @s.Number</option> }
                        </select></label>
                </div>
                @if (_evKind == ManualEvidenceKind.Link && _evReference.Length > 0 && !LinkOk(_evReference)) { <p class="mt-muted" data-testid="mte-ev-invalid">En lenke må være en fullstendig http- eller https-adresse.</p> }
                <button type="button" class="btn btn-secondary btn-sm" disabled="@(string.IsNullOrWhiteSpace(_evLabel) || string.IsNullOrWhiteSpace(_evReference) || (_evKind == ManualEvidenceKind.Link && !LinkOk(_evReference)))"
                        @onclick="AddEvidence" data-testid="mte-ev-add">Legg til lenke eller notat</button>
            }
            @if (run.State != ManualRunState.Abandoned)
            {
                <div class="mte-row" data-testid="mte-attach-row">
                    <label class="mte-field"><span>Legg ved en fil</span>
                        <InputFile OnChange="AttachAsync" accept=".png,.jpg,.jpeg,.gif,.webp,.pdf,.txt,.log,.csv,.json,.xml,.har" disabled="@_attaching" data-testid="mte-attach" /></label>
                    <label class="mte-field"><span>Navn (valgfritt)</span><input value="@_attLabel" @oninput="e => _attLabel = e.Value?.ToString() ?? string.Empty" maxlength="200" data-testid="mte-attach-label" /></label>
                    <label class="mte-field"><span>Gjelder</span>
                        <select @onchange="e => _attStep = int.TryParse(e.Value?.ToString(), out var v) ? v : null" data-testid="mte-attach-step">
                            <option value="" selected="@(_attStep is null)">Hele kjøringen</option>
                            @foreach (var st in run.Steps) { <option value="@st.Number" selected="@(_attStep == st.Number)">Steg @st.Number</option> }
                        </select></label>
                </div>
                @if (_attaching) { <p class="mt-muted" role="status" data-testid="mte-attaching">Legger ved…</p> }
                @if (_attachError is not null) { <p class="mt-alert" role="alert" data-testid="mte-attach-error">@_attachError</p> }
            }
        </section>
    };

    private RenderFragment Defects(ManualTestRun run, bool editable) => __builder =>
    {
        <section class="mt-card" aria-labelledby="mte-df-title" data-testid="mte-defects">
            <h2 id="mte-df-title" class="mt-h">Feil</h2>
            <p class="mt-muted">Feil registreres her som lokale observasjoner. Vil du følge opp en feil i Azure DevOps, registrerer du den der og legger til nummeret eller lenken som ekstern referanse. BirkNext oppretter eller endrer aldri arbeidselementer.</p>
            @if (_defects.Count == 0) { <p class="mt-muted" data-testid="mte-defects-none">Ingen feil registrert.</p> }
            <ul class="mte-items">
                @foreach (var d in _defects.ToList())
                {
                    <li data-testid="mte-defect" data-status="@d.Status">
                        <strong>@d.Title</strong>
                        <span class="mt-chip mt-tone-@MR.DefectStatusTone(d.Status)" data-testid="mte-defect-status">@MR.DefectStatusLabel(d.Status)</span>
                        @if (d.Severity is { } sev) { <span class="mt-chip mt-tone-warn">@sev</span> }
                        <span class="mt-muted">@(d.Step is { } st ? $"steg {st}" : "hele kjøringen")@(d.ExternalReference is { } ext ? $" · ekstern: {ext}" : " · lokal observasjon")@(d.RecordedBy.Length > 0 ? $" · {d.RecordedBy}" : " · ikke lagret ennå")</span>
                        @if (d.Actual is { Length: > 0 } a) { <span class="mt-muted">Faktisk resultat: @a</span> }
                        @if (d.History is { Count: > 0 } history)
                        {
                            <ol class="mte-defect-history" data-testid="mte-defect-history">
                                @foreach (var h in history)
                                {
                                    <li>@h.At.ToLocalTime().ToString("yyyy-MM-dd HH:mm") · @h.By: @MR.DefectStatusLabel(h.From) → @MR.DefectStatusLabel(h.To)@(h.Note is { Length: > 0 } note ? $" — {note}" : "")@(h.ExternalReference is { } x ? $" · arbeidselement {x}" : "")@if (h.RetestRunId is { } rr) { <text> · </text><a href="@($"{MR.ExecuteRoute}?run={rr}")">ny testkjøring</a> }</li>
                                }
                            </ol>
                        }
                        @if (editable)
                        {
                            <label class="mte-field mte-inline"><span class="visually-hidden">Status for @d.Title</span>
                                <select @onchange="e => SetDefectStatus(d, e.Value?.ToString())" data-testid="mte-defect-status-select">
                                    @foreach (var ds in new[] { ManualDefectStatus.Open, ManualDefectStatus.ReadyForRetest, ManualDefectStatus.Closed })
                                    { <option value="@ds" selected="@(d.Status == ds)">@MR.DefectStatusLabel(ds)</option> }
                                </select></label>
                            <button type="button" class="btn btn-secondary btn-sm" aria-label="@($"Fjern feilen {d.Title}")" @onclick="() => { _defects.Remove(d); _dirty = true; }">Fjern</button>
                        }
                        else if (_followUp?.DefectId == d.Id)
                        {
                            @* Follow-up after the run: only the defect changes; the run's results and evidence stay as recorded. *@
                            <div class="mte-row" data-testid="mte-followup">
                                <label class="mte-field"><span>Ny status</span>
                                    <select @onchange="e => _followUp = _followUp with { Status = Enum.TryParse<ManualDefectStatus>(e.Value?.ToString(), out var v) ? v : _followUp.Status }" data-testid="mte-followup-status">
                                        @foreach (var fs in new[] { ManualDefectStatus.Open, ManualDefectStatus.ReadyForRetest, ManualDefectStatus.Closed })
                                        { <option value="@fs" selected="@(_followUp.Status == fs)">@MR.DefectStatusLabel(fs)</option> }
                                    </select></label>
                                <label class="mte-field"><span>Notat</span><input value="@_followUp.Note" @oninput="e => _followUp = _followUp with { Note = e.Value?.ToString() }" maxlength="2000" data-testid="mte-followup-note" /></label>
                                <label class="mte-field"><span>Arbeidselement (valgfritt)</span><input value="@_followUp.ExternalReference" @oninput="e => _followUp = _followUp with { ExternalReference = e.Value?.ToString() }" placeholder="Nummer eller https-lenke" maxlength="1000" data-testid="mte-followup-external" /></label>
                                <label class="mte-field"><span>Bekreftet av ny testkjøring (valgfritt)</span>
                                    <select @onchange="e => _followUp = _followUp with { RetestRunId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null }" data-testid="mte-followup-retest">
                                        <option value="" selected="@(_followUp.RetestRunId is null)">Ingen ny testkjøring</option>
                                        @foreach (var r in RetestCandidates(run)) { <option value="@r.Id" selected="@(_followUp.RetestRunId == r.Id)">@MR.RunLabel(r.State, r.Outcome) · @r.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") · @r.Tester</option> }
                                    </select></label>
                            </div>
                            <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick="() => SaveFollowUpAsync(run)" data-testid="mte-followup-save">Lagre oppfølging</button>
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _followUp = null" data-testid="mte-followup-cancel">Avbryt</button>
                        }
                        else if (run.State != ManualRunState.InProgress)
                        {
                            <button type="button" class="btn btn-secondary btn-sm" data-testid="mte-defect-followup" @onclick="() => _followUp = new FollowUp(d.Id, d.Status, null, d.ExternalReference, null)">Følg opp</button>
                        }
                    </li>
                }
            </ul>
            @if (editable)
            {
                <div class="mte-row">
                    <label class="mte-field"><span>Tittel</span><input value="@_newDefect.Title" @oninput="e => _newDefect = _newDefect with { Title = e.Value?.ToString() ?? string.Empty }" maxlength="300" data-testid="mte-df-title" /></label>
                    <label class="mte-field"><span>Alvorlighet</span>
                        <select @onchange="e => _newDefect = _newDefect with { Severity = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString() }" data-testid="mte-df-severity">
                            <option value="" selected="@(_newDefect.Severity is null)">Ikke vurdert</option>
                            @foreach (var s in R.Severities) { <option value="@s" selected="@(_newDefect.Severity == s)">@s</option> }
                        </select></label>
                    <label class="mte-field"><span>Steg</span>
                        <select @onchange="e => _newDefect = _newDefect with { Step = int.TryParse(e.Value?.ToString(), out var v) ? v : null }" data-testid="mte-df-step">
                            <option value="" selected="@(_newDefect.Step is null)">Hele kjøringen</option>
                            @foreach (var s in run.Steps) { <option value="@s.Number" selected="@(_newDefect.Step == s.Number)">Steg @s.Number</option> }
                        </select></label>
                    <label class="mte-field"><span>Ekstern referanse (valgfritt)</span><input value="@_newDefect.ExternalReference" @oninput="e => _newDefect = _newDefect with { ExternalReference = e.Value?.ToString() }" placeholder="Nummer på arbeidselement eller https-lenke" maxlength="1000" data-testid="mte-df-external" /></label>
                </div>
                <div class="mte-row">
                    <label class="mte-field"><span>Forventet resultat</span><textarea rows="2" @oninput="e => _newDefect = _newDefect with { Expected = e.Value?.ToString() }" data-testid="mte-df-expected">@_newDefect.Expected</textarea></label>
                    <label class="mte-field"><span>Faktisk resultat</span><textarea rows="2" @oninput="e => _newDefect = _newDefect with { Actual = e.Value?.ToString() }" data-testid="mte-df-actual">@_newDefect.Actual</textarea></label>
                    <label class="mte-field"><span>Slik gjenskaper du feilen</span><textarea rows="2" @oninput="e => _newDefect = _newDefect with { Reproduction = e.Value?.ToString() }" data-testid="mte-df-repro">@_newDefect.Reproduction</textarea></label>
                </div>
                <button type="button" class="btn btn-secondary btn-sm" disabled="@string.IsNullOrWhiteSpace(_newDefect.Title)" @onclick="AddDefect" data-testid="mte-df-add">Legg til feil</button>
            }
        </section>
    };

    private static bool LinkOk(string value) => Uri.TryCreate(value.Trim(), UriKind.Absolute, out var u) && (u.Scheme == "https" || u.Scheme == "http") && u.Host.Length > 0;

    private void SetOutcome(int n, ManualStepOutcome o) { _steps[n] = (o, _steps.GetValueOrDefault(n).Actual); _dirty = true; }
    private void SetActual(int n, string? actual) { _steps[n] = (_steps.GetValueOrDefault(n).Outcome, actual); _dirty = true; }

    private void AddEvidence()
    {
        _evidence.Add(new ManualRunEvidence { Kind = _evKind, Label = _evLabel.Trim(), Reference = _evReference.Trim(), Step = _evStep });
        _evLabel = ""; _evReference = ""; _evStep = null; _dirty = true;
    }

    private void DefectFor(ManualRunStep s)
    {
        _newDefect = new ManualRunDefect { Step = s.Number, Expected = s.Expected, Actual = _steps.GetValueOrDefault(s.Number).Actual, Title = _newDefect.Title };
    }

    private void AddDefect()
    {
        _defects.Add(_newDefect with { Title = _newDefect.Title.Trim(), Status = ManualDefectStatus.Open });
        _newDefect = new(); _dirty = true;
    }

    private void SetDefectStatus(ManualRunDefect d, string? value)
    {
        var i = _defects.IndexOf(d);
        if (i >= 0 && Enum.TryParse<ManualDefectStatus>(value, out var status)) { _defects[i] = d with { Status = status }; _dirty = true; }
    }

    // ── Follow-up after a run (defects) and attachments ─────────────────────────────────────────────────────────────

    private sealed record FollowUp(string DefectId, ManualDefectStatus Status, string? Note, string? ExternalReference, Guid? RetestRunId);
    private FollowUp? _followUp;
    private string _attLabel = "";
    private int? _attStep;
    private bool _attaching;
    private string? _attachError;

    /// <summary>Completed runs of the same case started after this one — the runs that can verify a fix.</summary>
    private IEnumerable<ManualRunSummary> RetestCandidates(ManualTestRun run) =>
        _runList.Where(r => r.CaseKey == run.CaseKey && r.Id != run.Id && r.State == ManualRunState.Completed && r.StartedAt >= run.StartedAt).OrderByDescending(r => r.StartedAt);

    private async Task SaveFollowUpAsync(ManualTestRun run)
    {
        if (_followUp is not { } f || _runs is null || _ws?.ProjectKey is not { } key) return;
        _busy = true;
        try
        {
            var (updated, error) = await _runs.UpdateDefectAsync(key, run.Id, f.DefectId,
                new UpdateManualDefectRequest(run.Revision, f.Status, f.Note, string.IsNullOrWhiteSpace(f.ExternalReference) ? null : f.ExternalReference.Trim(), f.RetestRunId));
            if (updated is null) { Fail(error ?? "Feilen kunne ikke oppdateres."); return; }
            Use(updated); _followUp = null;
            Info("Feilen er oppdatert. Resultatene og dokumentasjonen i kjøringen er ikke endret.");
            await LoadDefectsAsync(key);
        }
        finally { _busy = false; }
    }

    private async Task AttachAsync(InputFileChangeEventArgs args)
    {
        if (_run is not { } run || _runs is null || _ws?.ProjectKey is not { } key) return;
        _attachError = null;
        var file = args.File;
        const long max = 10 * 1024 * 1024;
        if (file.Size > max) { _attachError = $"«{file.Name}» er større enn 10 MB og ble ikke lagt ved."; return; }
        _attaching = true;
        try
        {
            byte[] bytes;
            using (var buffer = new MemoryStream())
            {
                await using var stream = file.OpenReadStream(max);
                await stream.CopyToAsync(buffer);
                bytes = buffer.ToArray();
            }
            var (updated, error) = await _runs.AttachAsync(key, run.Id, run.Revision, _attStep, string.IsNullOrWhiteSpace(_attLabel) ? null : _attLabel.Trim(), file.Name, bytes);
            if (updated is null) { _attachError = error ?? "Filen kunne ikke legges ved."; return; }
            if (run.State == ManualRunState.InProgress)
            {
                // Keep this tab's unsaved results: take the new revision and add the stored file to the evidence list being edited.
                var added = updated.Evidence.Where(e => _evidence.All(x => x.Id != e.Id) && run.Evidence.All(x => x.Id != e.Id)).ToList();
                _run = updated with { Steps = run.Steps };
                _evidence.AddRange(added);
                await LoadFilesAsync();
            }
            else Use(updated);
            _attLabel = ""; _attStep = null;
            Info($"«{file.Name}» er lagt ved.");
        }
        catch (IOException) { _attachError = $"«{file.Name}» kunne ikke leses."; }
        finally { _attaching = false; }
    }

    // ── Attached files: scan state and withdrawal ───────────────────────────────────────────────────────────────────
    private Dictionary<string, ManualRunAttachmentInfo> _files = [];
    private string? _withdrawing;
    private string _withdrawReason = string.Empty;

    private ManualRunAttachmentInfo? FileInfoOf(ManualRunEvidence e) => _files.GetValueOrDefault(e.Reference);

    private async Task LoadFilesAsync()
    {
        _files = [];
        if (_run is not { } run || _runs is null || _ws?.ProjectKey is not { } key || run.Evidence.All(x => x.Kind != ManualEvidenceKind.Attachment)) return;
        var (files, _) = await _runs.AttachmentsAsync(key, run.Id);
        _files = (files ?? []).ToDictionary(f => f.Id.ToString("N"), StringComparer.Ordinal);
    }

    private async Task WithdrawAsync(ManualRunEvidence e)
    {
        if (_run is not { } run || _runs is null || _ws?.ProjectKey is not { } key || string.IsNullOrWhiteSpace(_withdrawReason)) return;
        var (file, error) = await _runs.WithdrawAttachmentAsync(key, run.Id, e.Reference, _withdrawReason.Trim());
        if (file is null) { Fail(error ?? "Filen ble ikke trukket tilbake."); return; }
        _files[e.Reference] = file; _withdrawing = null; _withdrawReason = string.Empty;
    }

    private async Task DownloadAttachmentAsync(ManualRunEvidence e)
    {
        if (_run is not { } run || _runs is null || _ws?.ProjectKey is not { } key) return;
        var (bytes, error) = await _runs.AttachmentAsync(key, run.Id, e.Reference);
        if (bytes is null) { Fail(error ?? "Vedlegget kunne ikke lastes ned."); return; }
        await JS.InvokeVoidAsync("downloadBase64File", e.FileName ?? "attachment", Convert.ToBase64String(bytes), e.ContentType ?? "application/octet-stream");
    }

    // ── Project defect list ─────────────────────────────────────────────────────────────────────────────────────────

    private List<ManualDefectListItem>? _defectList;
    private string? _defectListError;
    private bool _defectsAll;

    private async Task LoadDefectsAsync(string key)
    {
        if (_runs is null) return;
        var (list, error) = await _runs.DefectsAsync(key);
        (_defectList, _defectListError) = (list, list is null ? error : null);
    }

    private async Task DownloadDefectsAsync()
    {
        if (_defectList is not { Count: > 0 } list) return;
        await JS.InvokeVoidAsync("downloadTextFile", $"manual-test-defects-{DateTime.Now:yyyy-MM-dd}.csv", MR.DefectsCsv(list), "text/csv;charset=utf-8");
    }

    private RenderFragment DefectList() => __builder =>
    {
        if (_defectList is null && _defectListError is null) return;
        var shown = (_defectList ?? []).Where(i => _defectsAll || i.Defect.Status != ManualDefectStatus.Closed).ToList();
        <section class="mt-card" aria-labelledby="mte-dl-title" data-testid="mte-defect-list">
            <h2 id="mte-dl-title" class="mt-h">Feil</h2>
            @if (_defectListError is not null) { <p class="mt-alert" role="alert">@_defectListError</p> }
            else
            {
                <p class="mt-muted" data-testid="mte-defect-list-count">@((_defectList ?? []).Count(i => i.Defect.Status != ManualDefectStatus.Closed)) ikke lukket · @((_defectList ?? []).Count) totalt i alle kjøringer i dette prosjektet.
                    <label class="mte-inline"><input type="checkbox" checked="@_defectsAll" @onchange="e => _defectsAll = e.Value is true" data-testid="mte-defect-list-all" /> Vis også lukkede feil</label>
                    @if ((_defectList ?? []).Count > 0) { <button type="button" class="btn btn-secondary btn-sm" @onclick="DownloadDefectsAsync" data-testid="mte-defect-list-download">Last ned feil (CSV)</button> }</p>
                @if (shown.Count == 0) { <p class="mt-muted" data-testid="mte-defect-list-none">@(_defectsAll ? "Ingen feil er registrert." : "Ingen åpne feil.")</p> }
                <ul class="mte-items">
                    @foreach (var i in shown)
                    {
                        <li data-testid="mte-defect-list-item" data-status="@i.Defect.Status">
                            <strong>@i.Defect.Title</strong>
                            <span class="mt-chip mt-tone-@MR.DefectStatusTone(i.Defect.Status)">@MR.DefectStatusLabel(i.Defect.Status)</span>
                            @if (i.Defect.Severity is { } sev) { <span class="mt-chip mt-tone-warn">@sev</span> }
                            <span class="mt-muted">@i.RunTitle · @MR.RunLabel(i.RunState, i.RunOutcome) · @i.RunStartedAt.ToLocalTime().ToString("yyyy-MM-dd") · @i.Tester@(i.Defect.ExternalReference is { } x ? $" · arbeidselement {x}" : "")</span>
                            <a href="@($"{MR.ExecuteRoute}?run={i.RunId}")" data-testid="mte-defect-list-open">Åpne kjøringen</a>
                        </li>
                    }
                </ul>
            }
        </section>
    };

    private SaveManualRunRequest Request() => new()
    {
        BaseRevision = _run!.Revision, Notes = _notes, Environment = _runEnvironment,
        Steps = [.. _run.Steps.Select(s => new ManualStepInput(s.Number, _steps.GetValueOrDefault(s.Number).Outcome, _steps.GetValueOrDefault(s.Number).Actual))],
        Evidence = [.. _evidence], Defects = [.. _defects],
    };

    private async Task<bool> SaveAsync()
    {
        if (_run is null) return false;
        _busy = true;
        var (run, error) = await _runs!.SaveAsync(_ws!.ProjectKey!, _run.Id, Request());
        _busy = false;
        if (run is null) { Fail(error ?? "Resultatene dine kunne ikke lagres. De ligger fortsatt på denne siden. Prøv igjen."); return false; }
        Use(run);
        Info($"Fremdriften er lagret ({DateTime.Now:HH:mm}). Du kan forlate siden og fortsette kjøringen senere.");
        return true;
    }

    private async Task CompleteAsync()
    {
        if (_run is null) return;
        if (_dirty && !await SaveAsync()) return;
        _busy = true;
        var (run, error) = await _runs!.CompleteAsync(_ws!.ProjectKey!, _run.Id, _run.Revision);
        _busy = false;
        if (run is null) { Fail(error ?? "Kjøringen kunne ikke fullføres."); return; }
        Use(run);
        Info($"Kjøringen er fullført: {MR.OutcomeLabel(run.Outcome)}. Den lagres i kjøringshistorikken og kan ikke endres.");
        _ws = await new ManualTestingWorkspace(ServiceProvider).LoadAsync(discovery: false, requirements: false);
    }

    private async Task AbandonAsync()
    {
        if (_run is null) return;
        if (_dirty && !await SaveAsync()) return;
        _busy = true;
        var (run, error) = await _runs!.AbandonAsync(_ws!.ProjectKey!, _run.Id, _run.Revision, _abandonReason.Trim());
        _busy = false;
        if (run is null) { Fail(error ?? "Kjøringen kunne ikke avbrytes."); return; }
        Use(run);
        Info("Kjøringen er avbrutt. Den blir liggende i historikken og teller aldri som en gjennomføring.");
    }
}
