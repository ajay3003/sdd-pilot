@page "/artifact-traceability"
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using BirkNext.Web.Components
@inject IConstitutionAnalysisService ConstitutionService
@inject IPlanAnalysisService PlanService
@inject IArtifactTraceabilityService TraceabilityService
@inject IDashboardSnapshotService DashboardSnapshot
@inject BirkNext.Web.Services.Explorers.IArtifactExplorerContext ArtifactContext
@inject IReportExportService ExportService
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Requirements Traceability</PageTitle>

<div class="at-page">

    <PageHeader Title="Requirements Traceability"
                Description="Document-reference coverage across authored Constitution rules, Specification requirements, Plan references, and Task requirement references. Plan-to-Task links are not assessed because the current artifacts do not share stable Task IDs; lifecycle evidence is shown in the shared SDD graph." />

    <p class="at-neutral-note">This report counts document-level links and derived phase-heading alignment. It does not represent implementation verification or test execution. <a href="/traceability">Open the shared SDD evidence graph</a>.</p>

    @if (_inputs is null)
    {
        <p role="status" class="at-workspace-loading">Loading current workspace artifacts…</p>
    }
    else
    {
        <dl class="at-workspace-context" data-testid="at-workspace-context">
            <div><dt>Current project</dt><dd>@(_inputs.ProjectDisplay ?? "None (manual workspace)")</dd></div>
            <div><dt>Artifact source</dt><dd>@_inputs.SourceLabel</dd></div>
        </dl>

        @if (_analysisError is not null)
        {
            <div class="notification notification-error" role="alert" data-testid="artifact-traceability-error">
                <strong>Traceability analysis could not be completed.</strong>
                <span>@_analysisError.Message</span>
                @if (ShowDiagnosticDetails)
                {
                    <details>
                        <summary>Diagnostic details</summary>
                        <pre>@_analysisError</pre>
                    </details>
                }
            </div>
        }

        @if (_inputs.Status == BirkNext.Web.Services.Explorers.TraceabilityInputStatus.NoDocuments)
        {
            <section class="at-state" role="status" data-testid="at-no-documents">
                <h2>No document artifacts are available for traceability</h2>
                <p>The current workspace has no Constitution, Specification, Plan or Task artifact. Traceability is not assessed, and no coverage figure is shown.</p>
                <p><a href="project-import">Import Project</a>, <a href="sample-projects">choose a Sample Project</a> or import a document in an explorer.</p>
            </section>
        }
        else
        {
            <section class="at-input-panel" aria-labelledby="at-inputs-title">
                <div class="at-input-panel-header">
                    <h2 class="at-input-panel-title" id="at-inputs-title">Artifacts</h2>
                    @if (_report is not null)
                    {
                        <button class="at-input-panel-toggle" aria-expanded="@(_inputExpanded ? "true" : "false")" @onclick="ToggleInputPanel">
                            @(_inputExpanded ? "▾ Collapse" : "▸ Expand")
                        </button>
                    }
                </div>

                @if (_inputs.Status == BirkNext.Web.Services.Explorers.TraceabilityInputStatus.SelectionRequired)
                {
                    <p role="status" class="at-selection-note" data-testid="at-selection-required">
                        Several artifacts are available for @string.Join(", ", _inputs.SelectionRequired.Select(r => r.Label)).
                        Choose one in its Explorer; Requirements Traceability never picks one for you.
                    </p>
                }

                @if (_inputExpanded || _inputs.Status != BirkNext.Web.Services.Explorers.TraceabilityInputStatus.Ready)
                {
                    <div class="at-artifact-grid">
                        @foreach (var role in _inputs.Roles)
                        {
                            <div class="artifact-card @(role.IsLoaded ? "is-loaded" : "")" data-testid="at-role-@role.Role.ToString().ToLowerInvariant()">
                                <div class="artifact-card-header">
                                    <span class="artifact-icon" aria-hidden="true">@BirkNext.Web.Services.Explorers.ArtifactExplorerRoles.Icon(role.Role)</span>
                                    <span class="artifact-name">@role.Label</span>
                                    <span class="artifact-status @(role.IsLoaded ? "is-loaded" : "")">@role.StatusLabel</span>
                                </div>
                                <div class="at-artifact-detail">
                                    @if (role.State.Selected is { } selected)
                                    {
                                        <div class="at-artifact-file">@selected.FileName</div>
                                        <div class="at-artifact-source">Source: @role.SourceLabel</div>
                                    }
                                    else if (role.NeedsSelection)
                                    {
                                        <div class="at-artifact-file">@role.State.Artifacts.Count candidates</div>
                                        <a class="at-artifact-action" href="@role.ExplorerRoute">Open @role.Label Explorer</a>
                                    }
                                    else
                                    {
                                        <div class="at-artifact-file">@(role.State.Error ?? "No artifact in the current workspace")</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div class="at-analyze-bar">
                        <span class="at-loaded-summary">
                            @_inputs.LoadedCount artifact@(_inputs.LoadedCount != 1 ? "s" : "") selected
                            @if (_inputs.Status == BirkNext.Web.Services.Explorers.TraceabilityInputStatus.Insufficient)
                            { <span> — at least 2 are needed to assess links</span> }
                        </span>
                        <PrimaryButton OnClick="RunAnalysis" Disabled="@(_inputs.Status != BirkNext.Web.Services.Explorers.TraceabilityInputStatus.Ready)">
                            Analyze Traceability
                        </PrimaryButton>
                    </div>
                }
            </section>
        }
    }

    <!-- ── Report view ────────────────────────────────────────────────────── -->
    @if (_report is not null && _inputs?.Status == BirkNext.Web.Services.Explorers.TraceabilityInputStatus.Ready)
    {
        <div style="display:flex;justify-content:flex-end;margin-bottom:.5rem">
            <button style="background:#1d4ed8;color:#fff;border:none;padding:.35rem .85rem;border-radius:5px;cursor:pointer;font-size:.78rem" @onclick="ExportHtml">Export HTML</button>
        </div>

        <!-- Health summary bar -->
        <div class="at-health-bar">
            <MetricCard Value="@CoverageValue(_report.ConstitutionCoverage)" Label="@CoverageLabel("Authored Constitution to Spec", _report.ConstitutionCoverage, _report.HasConstitution && _report.HasSpecification)" Variant="@CoverageVariant(_report.ConstitutionCoverage)" />
            <MetricCard Value="@CoverageValue(_report.SpecificationCoverage)" Label="@CoverageLabel("Requirement to Plan", _report.SpecificationCoverage, _report.HasSpecification && _report.HasPlan)" Variant="@CoverageVariant(_report.SpecificationCoverage)" />
            <MetricCard Value="@CoverageValue(_report.PlanCoverage)" Label="Plan to Tasks · Not assessed" Variant="@CoverageVariant(_report.PlanCoverage)" />
            <MetricCard Value="@CoverageValue(_report.TaskCoverage)" Label="@CoverageLabel("Tasks with Requirement/SC links", _report.TaskCoverage, _report.HasTasks && _report.HasSpecification)" Variant="@CoverageVariant(_report.TaskCoverage)" />
            @if (_report.Health.GapCount > 0)
            {
                <MetricCard Value="@_report.Health.GapCount.ToString()" Label="Gaps" Variant="warning" />
            }
        </div>

        <!-- Tab bar -->
        <div class="at-tab-bar" role="tablist">
            <button class='at-tab-btn @(_tab == "overview"     ? "is-active" : "")' role="tab" aria-selected="@(_tab == "overview")"     @onclick='() => SetTab("overview")'>Overview</button>
            <button class='at-tab-btn @(_tab == "const-spec"   ? "is-active" : "")' role="tab" aria-selected="@(_tab == "const-spec")"   @onclick='() => SetTab("const-spec")'>
                Constitution → Spec @ConstitutionSpecBadge
            </button>
            <button class='at-tab-btn @(_tab == "spec-plan"    ? "is-active" : "")' role="tab" aria-selected="@(_tab == "spec-plan")"    @onclick='() => SetTab("spec-plan")'>
                Spec → Plan @SpecPlanBadge
            </button>
            <button class='at-tab-btn @(_tab == "plan-task"    ? "is-active" : "")' role="tab" aria-selected="@(_tab == "plan-task")"    @onclick='() => SetTab("plan-task")'>
                Plan → Tasks @PlanTaskBadge
            </button>
            <button class='at-tab-btn @(_tab == "gaps"         ? "is-active" : "")' role="tab" aria-selected="@(_tab == "gaps")"         @onclick='() => SetTab("gaps")'>
                Gaps @GapsBadge
            </button>
            <button class='at-tab-btn @(_tab == "matrix"       ? "is-active" : "")' role="tab" aria-selected="@(_tab == "matrix")"       @onclick='() => SetTab("matrix")'>
                Matrix @MatrixBadge
            </button>
        </div>

        <!-- Search bar (tabs that support search) -->
        @if (_tab is "const-spec" or "spec-plan" or "plan-task" or "gaps" or "matrix")
        {
            <div class="at-search-bar">
                <input
                    type="search"
                    class="at-search"
                    placeholder="@SearchPlaceholder"
                    value="@_search"
                    @oninput="e => _search = e.Value?.ToString() ?? string.Empty"
                    aria-label="Search" />
                @if (!string.IsNullOrWhiteSpace(_search))
                {
                    <span class="at-search-clear" @onclick='() => _search = string.Empty' title="Clear">×</span>
                }
            </div>
        }

        <!-- Status filter (chain tabs + matrix + gaps) -->
        @if (_tab is "const-spec" or "spec-plan" or "plan-task" or "matrix")
        {
            <div class="at-filter-strip" role="group" aria-label="Filter by status">
                <button class='at-filter-chip @(_statusFilter is null ? "is-active" : "")' @onclick='() => _statusFilter = null'>All</button>
                <button class='at-filter-chip @(_statusFilter == TraceabilityStatus.Covered ? "is-active" : "")' @onclick='() => _statusFilter = TraceabilityStatus.Covered'>Covered</button>
                <button class='at-filter-chip @(_statusFilter == TraceabilityStatus.Partial ? "is-active" : "")' @onclick='() => _statusFilter = TraceabilityStatus.Partial'>Partial</button>
                <button class='at-filter-chip @(_statusFilter == TraceabilityStatus.Missing ? "is-active" : "")' @onclick='() => _statusFilter = TraceabilityStatus.Missing'>Missing</button>
            </div>
        }
        @if (_tab == "gaps")
        {
            <div class="at-filter-strip" role="group" aria-label="Filter gaps by artifact">
                <button class='at-filter-chip @(_gapArtifactFilter is null ? "is-active" : "")' @onclick='() => _gapArtifactFilter = null'>All Artifacts</button>
                <button class='at-filter-chip @(_gapArtifactFilter == ArtifactType.Constitution ? "is-active" : "")' @onclick='() => _gapArtifactFilter = ArtifactType.Constitution'>Constitution</button>
                <button class='at-filter-chip @(_gapArtifactFilter == ArtifactType.Specification ? "is-active" : "")' @onclick='() => _gapArtifactFilter = ArtifactType.Specification'>Specification</button>
                <button class='at-filter-chip @(_gapArtifactFilter == ArtifactType.Plan ? "is-active" : "")' @onclick='() => _gapArtifactFilter = ArtifactType.Plan'>Plan</button>
                <button class='at-filter-chip @(_gapArtifactFilter == ArtifactType.Task ? "is-active" : "")' @onclick='() => _gapArtifactFilter = ArtifactType.Task'>Task</button>
            </div>
        }

        <!-- Tab content -->
        <div class="at-tab-body">

            @if (_tab == "overview")
            {
                <!-- ── Overview ──────────────────────────────────────────── -->
                <div>
                    <!-- Quick stats -->
                    <div class="at-quick-stats">
                        @if (_report.Health.TotalRules > 0)
                        {
                            <span class="at-quick-stat"><span class="at-quick-stat-value">@_report.Health.TotalRules</span> rules</span>
                        }
                        @if (_report.Health.TotalRequirements > 0)
                        {
                            <span class="at-quick-stat"><span class="at-quick-stat-value">@_report.Health.TotalRequirements</span> requirements</span>
                        }
                        @if (_report.Health.TotalPlanItems > 0)
                        {
                            <span class="at-quick-stat"><span class="at-quick-stat-value">@_report.Health.TotalPlanItems</span> plan items</span>
                        }
                        @if (_report.Health.TotalTasks > 0)
                        {
                            <span class="at-quick-stat"><span class="at-quick-stat-value">@_report.Health.TotalTasks</span> tasks</span>
                        }
                        @if (_report.Health.GapCount > 0)
                        {
                            <span class="at-quick-stat"><span class="at-quick-stat-value">@_report.Health.GapCount</span> gaps</span>
                        }
                    </div>

                    <!-- Coverage sections -->
                    @if (_report.HasConstitution && _report.HasSpecification)
                    {
                        @RenderCoverageSection("Constitution → Specification (authored rules)", _report.ConstitutionCoverage, "const-spec")
                        @if (_report.ReferenceOnlyConstitutionEntries > 0)
                        {
                            <p class="at-neutral-note">@_report.ReferenceOnlyConstitutionEntries reference-only catalog entries are excluded from authored-rule coverage.</p>
                        }
                    }
                    @if (_report.HasSpecification && _report.HasPlan)
                    {
                        @RenderCoverageSection("Specification → Plan", _report.SpecificationCoverage, "spec-plan")
                    }
                    @if (_report.HasPlan && _report.HasTasks)
                    {
                        @RenderCoverageSection("Plan → Tasks", _report.PlanCoverage, "plan-task")
                        <p class="at-neutral-note">Not assessed: Plan phase entries contain action descriptions, not stable Task IDs. The current model cannot establish direct Plan→Task links; task-to-Requirement/Success Criterion references are shown separately.</p>
                    }
                    @if (_report.HasTasks && _report.HasSpecification)
                    {
                        @RenderCoverageSection("Tasks → Requirement / Success Criterion references", _report.TaskCoverage, "plan-task")
                    }

                    <!-- Health indicators -->
                    @if (_report.Health.Indicators.Count > 0)
                    {
                        <div class="at-health-indicators">
                            @foreach (var ind in _report.Health.Indicators)
                            {
                                <div class="at-indicator at-indicator-@ind.Level.ToString().ToLowerInvariant()">
                                    <span class="at-indicator-icon" aria-hidden="true">@ind.Icon</span>
                                    <span>@ind.Message</span>
                                </div>
                            }
                        </div>
                    }

                    <!-- Nav cards -->
                    <div class="at-nav-cards">
                        @if (_report.ConstitutionToSpec.Count > 0)
                        {
                            <button class="at-nav-card" @onclick='() => SetTab("const-spec")'>
                                <div class="at-nav-card-count">@_report.ConstitutionToSpec.Count</div>
                                <div class="at-nav-card-label">Constitution → Spec Rules</div>
                                <div class="at-nav-card-arrow">→</div>
                            </button>
                        }
                        @if (_report.SpecToPlan.Count > 0)
                        {
                            <button class="at-nav-card" @onclick='() => SetTab("spec-plan")'>
                                <div class="at-nav-card-count">@_report.SpecToPlan.Count</div>
                                <div class="at-nav-card-label">Spec → Plan Requirements</div>
                                <div class="at-nav-card-arrow">→</div>
                            </button>
                        }
                        @if (_report.PlanToTask.Count > 0)
                        {
                            <button class="at-nav-card" @onclick='() => SetTab("plan-task")'>
                                <div class="at-nav-card-count">@_report.PlanToTask.Count</div>
                                <div class="at-nav-card-label">Plan → Task Items</div>
                                <div class="at-nav-card-arrow">→</div>
                            </button>
                        }
                        @if (_report.Gaps.Count > 0)
                        {
                            <button class="at-nav-card" @onclick='() => SetTab("gaps")'>
                                <div class="at-nav-card-count">@_report.Gaps.Count</div>
                                <div class="at-nav-card-label">Traceability Gaps</div>
                                <div class="at-nav-card-arrow">→</div>
                            </button>
                        }
                        @if (_report.Matrix.Count > 0)
                        {
                            <button class="at-nav-card" @onclick='() => SetTab("matrix")'>
                                <div class="at-nav-card-count">@_report.Matrix.Count</div>
                                <div class="at-nav-card-label">Matrix Rows</div>
                                <div class="at-nav-card-arrow">→</div>
                            </button>
                        }
                    </div>
                </div>
            }

            @if (_tab == "const-spec")
            {
                <!-- ── Constitution → Spec ────────────────────────────────── -->
                @if (!_report.HasConstitution || !_report.HasSpecification)
                {
                    <EmptyState Icon="📭"
                                Title="@(!_report.HasConstitution ? "No Constitution loaded." : "No Specification loaded.")"
                                Description="Constitution → Spec analysis unavailable. Load the missing document above." />
                }
                else if (!VisibleConstToSpec.Any())
                {
                    <EmptyState Title="@((!string.IsNullOrWhiteSpace(_search) || _statusFilter is not null) ? "No rules match the current filter." : "No constitution rules found.")" />
                }
                else
                {
                    <div class="at-chain-table-wrap">
                        <table class="at-chain-table" aria-label="Constitution to Specification coverage">
                            <thead>
                                <tr>
                                    <th>Rule ID</th>
                                    <th>Rule Title</th>
                                    <th>Type</th>
                                    <th>Referenced Requirements</th>
                                    <th>Coverage</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in VisibleConstToSpec)
                                {
                                    <tr>
                                        <td><span class="at-rule-id">@entry.ItemId</span></td>
                                        <td>@entry.ItemTitle</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(entry.ItemSubType))
                                            { <span class="at-rule-type-badge">@entry.ItemSubType</span> }
                                        </td>
                                        <td>
                                            @if (entry.Links.Count > 0)
                                            {
                                                <div class="at-link-chips">
                                                    @foreach (var link in entry.Links.Take(5))
                                                    { <span class="at-link-chip">@link.TargetId</span> }
                                                    @if (entry.Links.Count > 5)
                                                    { <span class="at-link-chip">+@(entry.Links.Count - 5) more</span> }
                                                </div>
                                            }
                                            else
                                            { <span class="at-matrix-blank">—</span> }
                                        </td>
                                        <td>@StatusBadge(entry.Status)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

            @if (_tab == "spec-plan")
            {
                <!-- ── Spec → Plan ────────────────────────────────────────── -->
                @if (!_report.HasSpecification || !_report.HasPlan)
                {
                    <EmptyState Icon="📭"
                                Title="@(!_report.HasSpecification ? "No Specification loaded." : "No Plan loaded.")"
                                Description="Spec → Plan analysis unavailable. Load the missing document above." />
                }
                else if (!VisibleSpecToPlan.Any())
                {
                    <EmptyState Title="@((!string.IsNullOrWhiteSpace(_search) || _statusFilter is not null) ? "No requirements match the current filter." : "No requirements with FR-### identifiers found in the specification.")" />
                }
                else
                {
                    <div class="at-chain-table-wrap">
                        <table class="at-chain-table" aria-label="Specification to Plan coverage">
                            <thead>
                                <tr>
                                    <th>Requirement</th>
                                    <th>Title</th>
                                    <th>Type</th>
                                    <th>Plan Coverage</th>
                                    <th>Coverage</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in VisibleSpecToPlan)
                                {
                                    <tr>
                                        <td><span class="at-rule-id">@entry.ItemId</span></td>
                                        <td>@entry.ItemTitle</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(entry.ItemSubType))
                                            { <span class="at-rule-type-badge">@entry.ItemSubType</span> }
                                        </td>
                                        <td>
                                            @if (entry.Links.Count > 0)
                                            { <span class="at-link-chip">Referenced in plan</span> }
                                            else
                                            { <span class="at-matrix-blank">—</span> }
                                        </td>
                                        <td>@StatusBadge(entry.Status)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

            @if (_tab == "plan-task")
            {
                <!-- ── Plan → Tasks ───────────────────────────────────────── -->
                @if (!_report.HasPlan)
                {
                    <EmptyState Icon="📭" Title="No Plan loaded." Description="Plan → Tasks analysis unavailable. Load a plan document above." />
                }
                else if (!_report.HasTasks && _report.PlanToTask.Count == 0)
                {
                    <EmptyState Icon="📭" Title="Plan → Tasks is not assessed." Description="The current Plan and Tasks models do not provide a stable direct relation. Task-to-Requirement and Task-to-Success-Criterion references are reported separately." />
                }
                else if (_report.PlanToTask.Count == 0)
                {
                    <EmptyState Icon="ℹ️" Title="Plan → Tasks is not assessed." Description="Plan phases contain descriptive action text, not stable Task IDs. Task-to-Requirement and Task-to-Success-Criterion references are reported separately." />
                }
                else
                {
                    @if (!VisiblePlanToTask.Any() && !string.IsNullOrWhiteSpace(_search))
                    {
                        <div class="at-empty-tab"><span>No plan items match "<strong>@_search</strong>".</span></div>
                    }
                    else
                    {
                        <div class="at-chain-table-wrap">
                            <table class="at-chain-table" aria-label="Plan to Tasks coverage">
                                <thead>
                                    <tr>
                                        <th>Plan phase</th>
                                        <th>Phase group</th>
                                        <th>Tasks in matching Task phase</th>
                                        <th>Coverage</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var entry in VisiblePlanToTask)
                                    {
                                        <tr>
                                            <td><span class="at-rule-id">@entry.ItemId</span></td>
                                            <td>@entry.ItemTitle</td>
                                            <td>
                                                @if (entry.Links.Count > 0)
                                                {
                                                    <div class="at-link-chips">
                                                        @foreach (var link in entry.Links.Take(4))
                                                        { <span class="at-link-chip">@link.TargetId</span> }
                                                        @if (entry.Links.Count > 4)
                                                        { <span class="at-link-chip">+@(entry.Links.Count - 4) more</span> }
                                                    </div>
                                                }
                                                else
                                                { <span class="at-matrix-blank">—</span> }
                                            </td>
                                            <td>@StatusBadge(entry.Status)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Orphan tasks section -->
                        @if (_report.Gaps.Any(g => g.GapIn == ArtifactType.Task && g.Status == TraceabilityStatus.Orphaned))
                        {
                            <div class="at-gaps-section" style="margin-top:1.5rem;">
                                <SectionHeader Title="Tasks without Requirement/SC references" />
                                <div class="issue-cards">
                                    @foreach (var gap in _report.Gaps.Where(g => g.GapIn == ArtifactType.Task && g.Status == TraceabilityStatus.Orphaned))
                                    {
                                        <IssueCard Severity="Medium"
                                                   Component="@gap.ItemId"
                                                   Description="@(string.IsNullOrEmpty(gap.ItemTitle) ? gap.Description : (string.IsNullOrEmpty(gap.Description) ? gap.ItemTitle : $"{gap.ItemTitle} — {gap.Description}"))" />
                                    }
                                </div>
                            </div>
                        }
                    }
                }
            }

            @if (_tab == "gaps")
            {
                <!-- ── Gaps ───────────────────────────────────────────────── -->
                @if (!VisibleGaps.Any())
                {
                    @if (_gapArtifactFilter is not null || !string.IsNullOrWhiteSpace(_search))
                    {
                        <EmptyState Title="No gaps match the current filter." />
                    }
                    else
                    {
                        <EmptyState Icon="✓" Title="No traceability gaps detected." Description="All analyzed artifacts are covered." />
                    }
                }
                else
                {
                    @foreach (var artifactGroup in VisibleGaps
                        .GroupBy(g => g.GapIn)
                        .OrderBy(g => (int)g.Key))
                    {
                        <div class="at-gaps-section">
                            <SectionHeader Title="@(ArtifactLabel(artifactGroup.Key) + " Gaps")" />
                            <div class="issue-cards">
                                @foreach (var gap in artifactGroup.OrderBy(g => g.Severity))
                                {
                                    <IssueCard Severity="@gap.Severity.ToString()"
                                               Component="@gap.ItemId"
                                               Description="@(string.IsNullOrEmpty(gap.ItemTitle) ? gap.Description : (string.IsNullOrEmpty(gap.Description) ? gap.ItemTitle : $"{gap.ItemTitle} — {gap.Description}"))" />
                                }
                            </div>
                        </div>
                    }
                }
            }

            @if (_tab == "matrix")
            {
                <!-- ── Traceability Matrix ────────────────────────────────── -->
                @if (_report.Matrix.Count == 0 && !_report.HasConstitution)
                {
                    <EmptyState Icon="📭" Title="No Constitution loaded."
                                Description="The traceability matrix requires a constitution as the starting point." />
                }
                else if (!VisibleMatrix.Any())
                {
                    <EmptyState Title="@((!string.IsNullOrWhiteSpace(_search) || _statusFilter is not null) ? "No matrix rows match the current filter." : "No traceability matrix rows generated. Load at least a constitution to start.")" />
                }
                else
                {
                    <div class="at-matrix-table-wrap">
                        <table class="at-matrix-table" aria-label="Full traceability matrix">
                            <thead>
                                <tr>
                                    <th>Constitution</th>
                                    <th>Specification</th>
                                    <th>Plan</th>
                                    <th>Task</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in VisibleMatrix.Take(500))
                                {
                                    <tr>
                                        <td>
                                            <span class="at-rule-id">@row.ConstitutionRuleId</span>
                                            @if (!string.IsNullOrEmpty(row.ConstitutionRuleTitle))
                                            { <span style="margin-left:.4rem;font-size:.78rem;color:var(--clr-text-muted);">@row.ConstitutionRuleTitle</span> }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(row.SpecRequirementId))
                                            { <span class="at-rule-id">@row.SpecRequirementId</span>
                                              @if (!string.IsNullOrEmpty(row.SpecRequirementTitle))
                                              { <span style="margin-left:.4rem;font-size:.78rem;color:var(--clr-text-muted);">@row.SpecRequirementTitle</span> } }
                                            else
                                            { <span class="at-matrix-blank">—</span> }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(row.PlanItemId))
                                            { <span class="at-rule-id">@row.PlanItemId</span>
                                              @if (!string.IsNullOrEmpty(row.PlanItemTitle))
                                              { <span style="margin-left:.4rem;font-size:.78rem;color:var(--clr-text-muted);">@row.PlanItemTitle</span> } }
                                            else
                                            { <span class="at-matrix-blank">—</span> }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(row.TaskId))
                                            { <span class="at-rule-id">@row.TaskId</span>
                                              @if (!string.IsNullOrEmpty(row.TaskTitle))
                                              { <span style="margin-left:.4rem;font-size:.78rem;color:var(--clr-text-muted);">@row.TaskTitle</span> } }
                                            else
                                            { <span class="at-matrix-blank">—</span> }
                                        </td>
                                        <td>@StatusBadge(row.Status)</td>
                                    </tr>
                                }
                                @if (VisibleMatrix.Count() > 500)
                                {
                                    <tr>
                                        <td colspan="5" style="text-align:center;color:var(--clr-text-muted);font-size:.8rem;padding:.75rem;">
                                            Showing 500 of @VisibleMatrix.Count() rows. Use search or filters to narrow down.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

        </div>
    }

</div>

@code {
    private BirkNext.Web.Services.Explorers.TraceabilityInputs? _inputs;
    /// <summary>The inputs the current report was built from (scope + selected artifact ids + content fingerprints).</summary>
    private string? _reportKey;

    private ArtifactTraceabilityReport? _report;
    private string _tab    = "overview";
    private string _search = string.Empty;
    private bool _inputExpanded = true;
    private Exception? _analysisError;

    private TraceabilityStatus? _statusFilter;
    private ArtifactType? _gapArtifactFilter;

    // ── Computed filtered views ───────────────────────────────────────────

    private IEnumerable<ChainCoverage> VisibleConstToSpec =>
        _report is null ? [] :
        TraceabilityService.FilterChainByStatus(
            TraceabilityService.SearchChain(_report.ConstitutionToSpec, _search),
            _statusFilter);

    private IEnumerable<ChainCoverage> VisibleSpecToPlan =>
        _report is null ? [] :
        TraceabilityService.FilterChainByStatus(
            TraceabilityService.SearchChain(_report.SpecToPlan, _search),
            _statusFilter);

    private IEnumerable<ChainCoverage> VisiblePlanToTask =>
        _report is null ? [] :
        TraceabilityService.FilterChainByStatus(
            TraceabilityService.SearchChain(_report.PlanToTask, _search),
            _statusFilter);

    private IEnumerable<TraceabilityGap> VisibleGaps =>
        _report is null ? [] :
        TraceabilityService.SearchGaps(
            TraceabilityService.FilterGapsByArtifact(_report.Gaps, _gapArtifactFilter),
            _search);

    private IEnumerable<TraceabilityMatrixRow> VisibleMatrix =>
        _report is null ? [] :
        TraceabilityService.FilterMatrixByStatus(
            TraceabilityService.SearchMatrix(_report.Matrix, _search),
            _statusFilter);

    // ── Tab badges ────────────────────────────────────────────────────────

    private string ConstitutionSpecBadge =>
        _report?.ConstitutionToSpec.Count > 0 ? $"({_report.ConstitutionToSpec.Count})" : string.Empty;
    private string SpecPlanBadge =>
        _report?.SpecToPlan.Count > 0 ? $"({_report.SpecToPlan.Count})" : string.Empty;
    private string PlanTaskBadge =>
        _report?.PlanToTask.Count > 0 ? $"({_report.PlanToTask.Count})" : string.Empty;
    private string GapsBadge =>
        _report?.Gaps.Count > 0 ? $"({_report.Gaps.Count})" : string.Empty;
    private string MatrixBadge =>
        _report?.Matrix.Count > 0 ? $"({_report.Matrix.Count})" : string.Empty;

    private static string CoverageValue(TraceabilityCoverageStats stats) =>
        stats.HasApplicablePopulation ? $"{stats.CoveragePercentage:0.#}%" : "—";

    private static string CoverageVariant(TraceabilityCoverageStats stats) =>
        !stats.HasApplicablePopulation ? "" :
        stats.CoveragePercentage >= 80 ? "success" :
        stats.CoveragePercentage >= 50 ? "warning" :
        stats.CoveragePercentage > 0 ? "danger" : "danger";

    private static string CoverageLabel(string label, TraceabilityCoverageStats stats, bool artifactsAvailable) =>
        stats.HasApplicablePopulation ? label : $"{label} · {(artifactsAvailable ? "No applicable items" : "Not assessed")}";

    private string SearchPlaceholder => _tab switch
    {
        "const-spec" => "Search by rule ID (PP-01), title, or status…",
        "spec-plan"  => "Search by requirement ID (FR-001) or title…",
        "plan-task"  => "Search by plan item or task ID…",
        "gaps"       => "Search gaps by ID, title, or description…",
        "matrix"     => "Search matrix by rule, requirement, plan item, or task…",
        _            => "Search…",
    };

    private static bool ShowDiagnosticDetails
    {
        get
        {
#if DEBUG
            return true;
#else
            return false;
#endif
        }
    }

    // ── Lifecycle ─────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        ArtifactContext.Changed += OnArtifactContextChanged;
        await LoadCurrentWorkspaceAsync();
    }

    /// <summary>
    /// Reads the current workspace's documents by role, as the explorers do. A report is kept only while it was built from the same
    /// scope and the same selected artifact revisions; any change (another project, another selection, edited content) rebuilds it,
    /// and inputs that cannot be analysed clear it.
    /// </summary>
    private async Task LoadCurrentWorkspaceAsync()
    {
        try
        {
            _inputs = await BirkNext.Web.Services.Explorers.TraceabilityInputs.ResolveAsync(ArtifactContext);
        }
        catch (Exception ex)
        {
            _analysisError = ex;
            _report = null;
            _reportKey = null;
            return;
        }

        if (_inputs.Status != BirkNext.Web.Services.Explorers.TraceabilityInputStatus.Ready)
        {
            _report = null;
            _reportKey = null;
            _inputExpanded = true;
            return;
        }
        if (_reportKey != _inputs.Key) RunAnalysis();
    }

    private void OnArtifactContextChanged(object? sender, EventArgs e) => _ = InvokeAsync(async () =>
    {
        await LoadCurrentWorkspaceAsync();
        StateHasChanged();
    });

    public void Dispose() => ArtifactContext.Changed -= OnArtifactContextChanged;

    // ── Actions ───────────────────────────────────────────────────────────

    private void RunAnalysis()
    {
        try
        {
            _analysisError = null;

            if (_inputs?.Status != BirkNext.Web.Services.Explorers.TraceabilityInputStatus.Ready) return;
            var constitutionText = _inputs.Role(WorkspaceArtifactType.Constitution).Content;
            var specText = _inputs.Role(WorkspaceArtifactType.Specification).Content;
            var planText = _inputs.Role(WorkspaceArtifactType.Plan).Content;
            var taskText = _inputs.Role(WorkspaceArtifactType.Tasks).Content;

            ConstitutionDocument? constitution = null;
            SpecTree?             spec         = null;
            PlanDocument?         plan         = null;
            TaskTree?             tasks        = null;

            if (!string.IsNullOrWhiteSpace(constitutionText))
                constitution = ConstitutionService.Parse(constitutionText);
            if (!string.IsNullOrWhiteSpace(specText))
                spec = SpecExplorerService.Parse(specText);
            if (!string.IsNullOrWhiteSpace(planText))
                plan = PlanService.Parse(planText);
            if (!string.IsNullOrWhiteSpace(taskText))
                tasks = TaskExplorerService.Parse(taskText);

            // Build semantic models and ReviewContext
            var constitutionSemanticModel = constitution is not null
                ? ConstitutionAnalysisService.BuildSemanticModel(constitution)
                : new ConstitutionSemanticModel();
            var specSemanticModel = spec is not null
                ? SpecExplorerService.BuildSemanticModel(spec, specText)
                : new SpecificationSemanticModel();
            var planSemanticModel = plan is not null
                ? PlanAnalysisService.BuildSemanticModel(plan)
                : new PlanSemanticModel();
            var taskSemanticModel = tasks is not null
                ? TaskExplorerService.BuildSemanticModel(tasks)
                : new TaskSemanticModel();
            var dataModelSemanticModel = new DataModelSemanticModel();

            var reviewContext = ReviewContextFactory.Create(
                constitutionSemanticModel,
                specSemanticModel,
                planSemanticModel,
                taskSemanticModel,
                dataModelSemanticModel);

            _report = NormalizeReport(TraceabilityService.Analyze(constitution, spec, plan, tasks, reviewContext));
            _reportKey = _inputs.Key;
            DashboardSnapshot.Publish(_report);
            _tab            = "overview";
            _search         = string.Empty;
            _statusFilter   = null;
            _gapArtifactFilter = null;
            _inputExpanded  = false;
        }
        catch (Exception ex)
        {
            _analysisError = ex;
            _report = null;
            _reportKey = null;
            _inputExpanded = true;
        }
    }

    private static ArtifactTraceabilityReport NormalizeReport(ArtifactTraceabilityReport report) => new()
    {
        ConstitutionCoverage = report.ConstitutionCoverage ?? new TraceabilityCoverageStats(),
        SpecificationCoverage = report.SpecificationCoverage ?? new TraceabilityCoverageStats(),
        PlanCoverage = report.PlanCoverage ?? new TraceabilityCoverageStats(),
        TaskCoverage = report.TaskCoverage ?? new TraceabilityCoverageStats(),
        ConstitutionToSpec = report.ConstitutionToSpec ?? [],
        SpecToPlan = report.SpecToPlan ?? [],
        PlanToTask = report.PlanToTask ?? [],
        Gaps = report.Gaps ?? [],
        Matrix = report.Matrix ?? [],
        Health = new TraceabilityHealth
        {
            TotalRules = report.Health?.TotalRules ?? 0,
            TotalRequirements = report.Health?.TotalRequirements ?? 0,
            TotalPlanItems = report.Health?.TotalPlanItems ?? 0,
            TotalTasks = report.Health?.TotalTasks ?? 0,
            CoveredCount = report.Health?.CoveredCount ?? 0,
            PartialCount = report.Health?.PartialCount ?? 0,
            MissingCount = report.Health?.MissingCount ?? 0,
            OrphanCount = report.Health?.OrphanCount ?? 0,
            CoveragePercentage = report.Health?.CoveragePercentage ?? 0,
            CoverageDenominator = report.Health?.CoverageDenominator ?? 0,
            GapCount = report.Health?.GapCount ?? 0,
            Indicators = report.Health?.Indicators ?? [],
        },
        HasConstitution = report.HasConstitution,
        HasSpecification = report.HasSpecification,
        HasPlan = report.HasPlan,
        HasTasks = report.HasTasks,
        ReferenceOnlyConstitutionEntries = report.ReferenceOnlyConstitutionEntries,
    };

    private void SetTab(string tab)
    {
        _tab    = tab;
        _search = string.Empty;
        _statusFilter = null;
    }

    private void ToggleInputPanel() => _inputExpanded = !_inputExpanded;

    private async Task ExportHtml()
    {
        if (_report is null) return;
        var html = ExportService.ExportArtifactTraceability(_report, _inputs?.ProjectDisplay ?? string.Empty);
        await JS.InvokeVoidAsync("downloadHtmlFile", $"artifact-traceability-{DateTime.UtcNow:yyyy-MM-dd}.html", html);
    }

    // ── Renderers ─────────────────────────────────────────────────────────

    private RenderFragment RenderCoverageSection(string title, TraceabilityCoverageStats stats, string navTab) => __builder =>
    {
        __builder.OpenElement(0, "div");
        __builder.AddAttribute(1, "class", "at-coverage-section");

        __builder.OpenElement(2, "div");
        __builder.AddAttribute(3, "class", "at-coverage-section-title");
        __builder.AddContent(4, title);
        __builder.CloseElement();

        if (!stats.HasApplicablePopulation)
        {
            __builder.OpenElement(5, "p");
            __builder.AddAttribute(6, "class", "at-neutral-note");
            __builder.AddContent(7, "No applicable items were assessed for this transition.");
            __builder.CloseElement();
            __builder.CloseElement();
            return;
        }

        __builder.OpenElement(8, "div");
        __builder.AddAttribute(9, "class", "at-coverage-stat-grid");

        void AddCard(string label, int count, string variant)
        {
            __builder.OpenElement(30, "div");
            __builder.AddAttribute(31, "class", $"at-coverage-stat-card is-{variant}");
            __builder.OpenElement(32, "div");
            __builder.AddAttribute(33, "class", "at-coverage-stat-num");
            __builder.AddContent(34, count.ToString());
            __builder.CloseElement();
            __builder.OpenElement(35, "div");
            __builder.AddAttribute(36, "class", "at-coverage-stat-label");
            __builder.AddContent(37, label);
            __builder.CloseElement();
            __builder.CloseElement();
        }

        AddCard("Covered",  stats.CoveredItems,  "covered");
        AddCard("Partial",  stats.PartialItems,  "partial");
        AddCard("Missing",  stats.MissingItems,  "missing");
        AddCard("Orphaned", stats.OrphanedItems, "orphaned");

        __builder.CloseElement();

        // Coverage bar
        var pct         = stats.CoveragePercentage;
        var barVariant  = pct >= 80 ? string.Empty : pct >= 50 ? "is-warning" : "is-error";
        __builder.OpenElement(40, "div");
        __builder.AddAttribute(41, "class", "at-coverage-bar-wrap");

        __builder.OpenElement(42, "div");
        __builder.AddAttribute(43, "class", "at-coverage-bar");
        __builder.OpenElement(44, "div");
        __builder.AddAttribute(45, "class", $"at-coverage-bar-fill {barVariant}");
        __builder.AddAttribute(46, "style", $"width:{pct}%");
        __builder.CloseElement();
        __builder.CloseElement();

        __builder.OpenElement(47, "span");
        __builder.AddAttribute(48, "class", "at-coverage-pct");
        __builder.AddContent(49, $"{pct:0.#}% ({stats.CoveredItems + stats.PartialItems} of {stats.TotalItems})");
        __builder.CloseElement();

        __builder.CloseElement(); // bar-wrap
        __builder.CloseElement(); // section
    };

    private static RenderFragment StatusBadge(TraceabilityStatus status) => __builder =>
    {
        var (css, icon, label) = status switch
        {
            TraceabilityStatus.Covered  => ("at-status-covered",  "✓", "Covered"),
            TraceabilityStatus.Partial  => ("at-status-partial",  "⚡", "Partial"),
            TraceabilityStatus.Missing  => ("at-status-missing",  "✗", "Missing"),
            TraceabilityStatus.Orphaned => ("at-status-orphaned", "○", "Orphaned"),
            _                           => ("at-status-orphaned", "?", status.ToString()),
        };
        __builder.OpenElement(0, "span");
        __builder.AddAttribute(1, "class", $"at-status-badge {css}");
        __builder.AddContent(2, $"{icon} {label}");
        __builder.CloseElement();
    };

    private static string HealthStatLevel(double pct) =>
        pct >= 80 ? "is-good" : pct >= 50 ? "is-warning" : pct > 0 ? "is-error" : string.Empty;

    private static string ArtifactLabel(ArtifactType type) => type switch
    {
        ArtifactType.Constitution  => "Constitution",
        ArtifactType.Specification => "Specification",
        ArtifactType.Plan          => "Plan",
        ArtifactType.Task          => "Task",
        _                          => type.ToString(),
    };
}
