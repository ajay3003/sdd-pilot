@using BirkNext.SourceBaselines
@using BirkNext.Web.Services
@inject IServiceProvider Services

@* The shared source context, in one line, on every page whose results depend on it: which version of a multi-version source is analysed, or that
   none is chosen yet (BASELINE_NOT_SELECTED: the source is left out of this page's analysis until a person chooses; import order never decides).
   Renders nothing when every source has a single version. *@
@if (_context is { } c && (_unresolved.Count > 0 || _selected.Count > 0))
{
    <aside class="scn @(_unresolved.Count > 0 ? "scn-warn" : "scn-info")" role="note" data-testid="source-context-notice" data-context="@c.ContextFingerprint"
           data-state="@(_unresolved.Count > 0 ? "needs-baseline" : "baseline")">
        @if (_unresolved.Count > 0)
        {
            <span class="scn-text" data-testid="source-context-notice-code" data-code="@(_unresolved.Any(s => s.State == SourceBaselineState.NotSelected) ? "BASELINE_NOT_SELECTED" : "BASELINE_UNAVAILABLE")"><strong>Select the @Names(_unresolved) source baseline.</strong> Multiple alternative source snapshots are available and none is selected@(Purpose is { Length: > 0 } p ? $"; {p} leaves {(_unresolved.Count == 1 ? "it" : "them")} out until you choose" : ", so they are left out of analysis until you choose")
                — no implementation-specific quality, execution-readiness or release-readiness conclusion is drawn from them. BirkNext never picks a branch from import order.</span>
        }
        else
        {
            <span class="scn-text">Analysing @string.Join("; ", _selected.Select(s => $"{s.DisplayName} with {s.Snapshots.FirstOrDefault(v => v.IsBaseline)?.ArchiveName} (analysis baseline, {s.SnapshotCount} versions)")). Not a deployment claim.</span>
        }
        <a class="scn-link" href="sources#scp-title" data-testid="source-context-notice-link">@(_unresolved.Count > 0 ? "Choose in Source versions" : "Change")</a>
    </aside>
}

@code {
    /// <summary>What the page does with the source ("Integration Topology"), used in the sentence; optional.</summary>
    [Parameter] public string? Purpose { get; set; }

    private SourceContextView? _context;
    private List<LogicalSourceView> _unresolved = [], _selected = [];

    protected override async Task OnInitializedAsync()
    {
        if (Services.GetService(typeof(SourceContextApiService)) is not SourceContextApiService api) return;
        (_context, _) = await api.GetAsync();
        _unresolved = [.. (_context?.Sources ?? []).Where(s => s.State is SourceBaselineState.NotSelected or SourceBaselineState.SelectedUnavailable)];
        _selected = [.. (_context?.Sources ?? []).Where(s => s.State == SourceBaselineState.Selected && s.SnapshotCount > 1)];
    }

    private static string Names(IReadOnlyList<LogicalSourceView> sources) => string.Join(", ", sources.Select(s => s.DisplayName));
}
