@using BirkNext.BrowserCompanion
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@implements IDisposable
@inject IServiceProvider Services

<section class="bcp @(Setup ? "bcp-setup" : "")" data-testid="browser-companion-panel" aria-label="Browser Companion">
    @* Setup mode is reached through a disclosure that already names it, and the host surface already states the
       session. A second heading and a second Connected badge here is the duplication this mode exists to remove;
       what replaces it is the pairing/connection pair, which is what setup is actually about. *@
    @if (Setup)
    {
        <dl class="bcp-grid bcp-setupstate" data-testid="browser-companion-setup-state">
            <div><dt>Pairing</dt><dd data-testid="browser-companion-pairing">@BrowserCompanionSituations.PairingLabel(Situation)</dd></div>
            <div><dt>Connection</dt><dd data-testid="browser-companion-connection-state">@BrowserCompanionSituations.ConnectionLabel(Situation)</dd></div>
        </dl>
    }
    else
    {
        <div class="bcp-head">
            <div>
                <h4 class="bcp-title">Browser Companion</h4>
                <p class="bcp-sub">Browser evidence from approved application pages in your managed Edge session.</p>
            </div>
            <span class="bcp-state bcp-state-@StateClass" data-testid="browser-companion-state">@StateLabel</span>
        </div>
    }

    @* Compact mode: the host surface already shows target, current page, evidence counts, origins and the last
       evidence timestamp, so the card drops the duplicated read-outs and stays connection/action oriented. *@
    @if (!Compact)
    {
        <dl class="bcp-grid">
            <div><dt>Target</dt><dd data-testid="browser-companion-target">@(Profile?.Name ?? "—")</dd></div>
            <div><dt>Current page</dt><dd class="bcp-mono" data-testid="browser-companion-current-page">@CurrentPage</dd></div>
            <div><dt>Pages with evidence</dt><dd data-testid="browser-companion-pages">@Evidence.Count</dd></div>
            <div><dt>DOM quality</dt><dd data-testid="browser-companion-dom">@(Evidence.Any(p => p.Dom is not null) ? "Available" : "Unavailable")</dd></div>
            <div><dt>Performance</dt><dd data-testid="browser-companion-performance">@(Evidence.Any(p => p.Performance is not null) ? "Evidence available" : "Unavailable")</dd></div>
            <div><dt>Accessibility</dt><dd data-testid="browser-companion-accessibility">@(Evidence.Any(p => p.Accessibility is not null) ? "Evidence available" : "Unavailable")</dd></div>
            <div><dt>Approved origins</dt><dd class="bcp-mono" data-testid="browser-companion-origins">@(ApprovedOrigins.Count == 0 ? "—" : string.Join(", ", ApprovedOrigins))</dd></div>
            <div><dt>Last browser evidence</dt><dd data-testid="browser-companion-last-evidence">@(Evidence.Select(p => (DateTimeOffset?)p.CapturedAt).Max()?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "None")</dd></div>
        </dl>
    }
    @* Compact mode: the state badge above already names the session state, so the sentence form of the same state is
       dropped and replaced by what to do about it. The full message stays where the card is the only status surface. *@
    @if (Compact)
    {
        @* A paired session that is silent needs a reload, and a sentence in the body text was easy to miss.
           It sits above Details so the next step is read before the technical state. Info, not warning: the
           state is expected and recoverable. *@
        @if (BrowserDiscoveryStates.ShowsGuidance(DiscoveryState))
        {
            <InlineCallout Title="@BrowserDiscoveryStates.GuidanceTitle"
                           Text="@BrowserDiscoveryStates.GuidanceText"
                           TestId="browser-companion-guidance" Glyph="↻" />
        }
        else
        {
            <p class="bcp-note" data-testid="browser-companion-connection">@CompactActionMessage</p>
        }
        <details class="bcp-details" data-testid="browser-companion-details">
            <summary>Details</summary>
            @* No Session row: the badge beside the title already states it, and repeating it inside the same card
               is the duplication this pass removes. *@
            <dl class="bcp-grid">
                <div><dt>Approved origins</dt><dd class="bcp-mono" data-testid="browser-companion-origins">@(ApprovedOrigins.Count == 0 ? "None" : string.Join(", ", ApprovedOrigins))</dd></div>
                <div><dt>Current page</dt><dd class="bcp-mono" data-testid="browser-companion-current-page">@CurrentPage</dd></div>
                <div><dt>Last evidence</dt><dd data-testid="browser-companion-last-evidence">@(Evidence.Select(p => (DateTimeOffset?)p.CapturedAt).Max()?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "None")</dd></div>
            </dl>
        </details>
    }
    else
    {
        <p class="bcp-note" data-testid="browser-companion-connection">@ConnectionMessage</p>
    }

    @if (Status.State == BrowserCompanionState.PairingPending)
    {
        <div class="bcp-pairing" role="status" data-testid="browser-companion-pairing">
            <p>Enter this code in the <strong>BirkNext Browser Companion</strong> extension (toolbar icon → Pair) within @Remaining:</p>
            <code class="bcp-code" data-testid="browser-companion-code">@Status.PairingCode</code>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Status.Message) && Status.State != BrowserCompanionState.PairingPending)
    {
        <p class="bcp-note" data-testid="browser-companion-message">@Status.Message</p>
    }
    @if (Runtime?.BackendUnavailable == true)
    {
        <p class="bcp-warn" role="alert" data-testid="browser-companion-backend">The local BirkNext backend is not reachable; companion status cannot be read.</p>
    }
    @if (Runtime?.LastError is { Length: > 0 } error)
    {
        <p class="bcp-warn" role="alert" data-testid="browser-companion-error">@error</p>
    }

    <div class="bcp-actions">
        @if (Profile is not null && Runtime is not null)
        {
            @if (Status.State is BrowserCompanionState.NotPaired or BrowserCompanionState.Expired or BrowserCompanionState.PairingPending)
            {
                @* Suppressed when the host already offers the one Pair action: two controls with near-identical
                   accessible names for one problem is the duplication this card is not allowed to create. *@
                @if (ShowPairAction)
                {
                    <PrimaryButton Class="fa-btn-sm" data-testid="browser-companion-pair" Disabled="@(Runtime.Busy || ApprovedOrigins.Count == 0)" OnClick="Pair">
                        @(Status.State == BrowserCompanionState.PairingPending ? "New pairing code" : "Pair browser companion")
                    </PrimaryButton>
                }
            }
            else
            {
                <SecondaryButton Class="fa-btn-sm" data-testid="browser-companion-unpair" Disabled="@Runtime.Busy" OnClick="Unpair">Unpair</SecondaryButton>
                <SecondaryButton Class="fa-btn-sm" data-testid="browser-companion-repair" Disabled="@Runtime.Busy" OnClick="Pair">Pair again</SecondaryButton>
            }
        }
    </div>
    @* Not a runtime evidence workflow: loading an unpacked extension is something a developer does once. It sits one
       disclosure further in than the pairing controls so it never competes with them. *@
    <details class="bcp-install" data-testid="browser-companion-install">
        <summary>Developer extension setup</summary>
        <p class="bcp-note">Install the BirkNext Browser Companion extension (DEV).</p>
        <ol>
            <li>In Edge open <code>edge://extensions</code>, enable <em>Developer mode</em>.</li>
            <li>Choose <em>Load unpacked</em> and select <code>AIAssisted/browser-companion</code> from the BirkNext repository.</li>
            <li>Click the extension icon, enter the pairing code shown above.</li>
            <li>Sign in to the target application as usual and navigate its pages; evidence appears in Browser Discovery.</li>
        </ol>
        <p>If managed Edge policy blocks unpacked extensions, the state stays "Not paired" and the extension page shows the policy message; BirkNext never falls back to token injection or CDP.</p>
    </details>
</section>

@code {
    [Parameter] public FrontendAnalysisProfile? Profile { get; set; }
    [Parameter] public BrowserCompanionRuntime? Runtime { get; set; }
    [Parameter] public bool ProxyRunning { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    /// <summary>
    /// Hide the read-out grid because the host surface already shows the same target, current page, evidence counts,
    /// approved origins and last-evidence timestamp. Connection state, messages and the pairing actions always remain.
    /// </summary>
    [Parameter] public bool Compact { get; set; }

    /// <summary>
    /// Render as a setup/control surface rather than a status card: pairing and connection as two rows, the recovery
    /// actions, and the developer install. The host owns the heading and the session read-out, so neither is repeated.
    /// </summary>
    [Parameter] public bool Setup { get; set; }

    private BrowserCompanionSituation Situation => BrowserCompanionSituations.Of(Status);

    /// <summary>
    /// Whether this card offers its own Pair control. A host that already shows one — Browser Discovery's empty
    /// state — passes false, so exactly one Pair action is ever on screen. Unpair and Pair again are unaffected:
    /// they act on an existing session and have no counterpart elsewhere.
    /// </summary>
    [Parameter] public bool ShowPairAction { get; set; } = true;

    private BrowserCompanionStatus Status => Runtime?.For(Profile?.Id) ?? new();
    private IReadOnlyList<string> ApprovedOrigins => Status.ApprovedOrigins.Count > 0 ? Status.ApprovedOrigins : BrowserCompanionScope.ApprovedOrigins(Profile);
    /// <summary>
    /// The live page, and only the live page. "Connected" says the extension is talking to BirkNext; it never implies
    /// an application page is open, so this reads None rather than borrowing the newest evidence route.
    /// </summary>
    private string CurrentPage => Status.State == BrowserCompanionState.Connected
        ? BrowserDiscoveryLive.CurrentPageLabel(Status.EffectiveLive)
        : "—";
    private IReadOnlyList<BrowserPageEvidence> Evidence =>
        (Services.GetService(typeof(IEndpointDiscoveryService)) as IEndpointDiscoveryService)?.GetSnapshot(Profile?.Id ?? "").Pages
            .Where(p => p.BrowserEvidence is not null).Select(p => p.BrowserEvidence!).ToList() ?? Status.Pages;
    /// <summary>
    /// Compact mode says what to DO, because the badge beside the title already says what the state IS. It never
    /// restates "Browser Companion is not paired" next to a badge that already reads "Not connected".
    /// </summary>
    /// <summary>
    /// The same derivation Browser Discovery uses, so the card and the page it sits on cannot describe one situation
    /// two different ways. Evidence comes from the merged discovery snapshot, not from the session.
    /// </summary>
    private BrowserDiscoveryState DiscoveryState =>
        BrowserDiscoveryStates.Of(Status.State, Evidence.Count > 0, BrowserDiscoveryStates.OnApprovedPage(Status));

    private string CompactActionMessage => DiscoveryState switch
    {
        // "Collecting" is a claim about reporting, so it waits for evidence that reporting actually happened. Knowing
        // which page is open proves the companion is alive, never that anything was observed on it.
        BrowserDiscoveryState.EvidenceAvailable when Status.State == BrowserCompanionState.Connected =>
            "Collecting browser evidence from approved application pages in your managed Edge session.",
        BrowserDiscoveryState.ConnectedOnApprovedPageWithoutEvidence =>
            "Connected to an approved application page. Waiting for browser evidence.",
        BrowserDiscoveryState.ConnectedWithoutEvidence =>
            "Connected. Open an approved application page in your managed Edge session to start collecting browser evidence.",
        _ => LegacyActionMessage,
    };

    private string LegacyActionMessage => Status.State switch
    {
        BrowserCompanionState.Connected => "Collecting browser evidence from approved application pages in your managed Edge session.",
        BrowserCompanionState.Disconnected => "Open the application in your managed Edge to resume reporting.",
        BrowserCompanionState.PairingPending => "Enter the pairing code in Browser Companion to finish pairing.",
        BrowserCompanionState.Expired => "Pair again to resume collecting browser evidence.",
        _ => "Pair the managed Edge browser to collect evidence from approved application pages.",
    };

    private string ConnectionMessage => Status.State switch
    {
        BrowserCompanionState.Connected => "Browser Companion is connected.",
        // The technical state only. The next step is the callout's job, so this no longer repeats it.
        BrowserCompanionState.Disconnected => "Paired, but no approved application page is currently reporting.",
        BrowserCompanionState.PairingPending => "Enter the pairing code in Browser Companion to finish pairing.",
        BrowserCompanionState.Expired => "Browser Companion pairing has expired.",
        _ => "Browser Companion is not paired."
    };
    private string StateLabel => Status.State switch
    {
        BrowserCompanionState.Connected => "Connected",
        BrowserCompanionState.Disconnected => "Paired · not reporting",
        BrowserCompanionState.PairingPending => "Pairing…",
        BrowserCompanionState.Expired => "Session expired",
        _ => "Not connected",
    };
    private string StateClass => Status.State switch
    {
        BrowserCompanionState.Connected => "ok",
        BrowserCompanionState.PairingPending => "pending",
        BrowserCompanionState.Disconnected => "warn",
        _ => "off",
    };
    private string Remaining => Status.PairingExpiresAt is { } exp ? $"{Math.Max(0, (int)(exp - DateTimeOffset.UtcNow).TotalSeconds)} s" : "3 min";

    private BrowserCompanionRuntime? _subscribed;

    protected override async Task OnParametersSetAsync()
    {
        if (!ReferenceEquals(_subscribed, Runtime))
        {
            if (_subscribed is not null) _subscribed.Changed -= OnRuntimeChanged;
            _subscribed = Runtime;
            if (_subscribed is not null) _subscribed.Changed += OnRuntimeChanged;
        }
        if (Runtime is not null && Profile is not null) await Runtime.FollowAsync(Profile);
    }

    private async Task Pair() { if (Runtime is not null && Profile is not null) await Runtime.StartPairingAsync(Profile); }
    private async Task Unpair() { if (Runtime is not null) await Runtime.UnpairAsync(); }
    private void OnRuntimeChanged() => _ = InvokeAsync(async () => { StateHasChanged(); if (Changed.HasDelegate) await Changed.InvokeAsync(); });

    public void Dispose() { if (_subscribed is not null) _subscribed.Changed -= OnRuntimeChanged; }
}
