@using BirkNext.SourceBaselines
@using BirkNext.Web.Services
@implements IDisposable
@inject IServiceProvider Services

@* Your next steps for the selected workspace view: at most three actions from the shared capabilities (same ids and routes as everywhere),
   honest counts and the risks every view keeps. A presentation of shared facts only; switching the view re-renders it without reloading
   anything and records nothing. Renders nothing in All Modules, where the full page already shows everything. *@
@if (_focus is { } f && !f.View.IsAllModules)
{
    <section class="wfp @(Compact ? "wfp-compact" : null)" aria-labelledby="wfp-title-@_id" data-testid="workspace-focus" data-view="@f.View.View">
        <div class="wfp-head">
            <h2 id="wfp-title-@_id" class="wfp-title">Your next steps <span class="wfp-view">· @f.View.Label</span></h2>
            <ul class="wfp-counts" aria-label="Status of the steps in this view">
                <li data-testid="wfp-ready"><strong>@f.ReadyNow</strong> ready now</li>
                <li data-testid="wfp-blocked"><strong>@f.Blocked</strong> blocked</li>
                <li data-testid="wfp-done"><strong>@f.Completed</strong> done</li>
            </ul>
        </div>
        @if (f.Risks.Count > 0)
        {
            <ul class="wfp-risks" data-testid="wfp-risks">
                @foreach (var risk in f.Risks)
                {
                    <li class="wfp-risk" data-testid="wfp-risk" data-code="@risk.Code">
                        <span class="wfp-risk-label">Important</span>
                        <span>@risk.Text</span>
                        <a href="@risk.Route" class="wfp-link">@risk.ActionLabel</a>
                    </li>
                }
            </ul>
        }
        @if (f.Primary.Count == 0)
        {
            <p class="wfp-empty" data-testid="wfp-empty">@(f.Relevant == 0 ? "None of this view's modules has a step to take with the current evidence." : "Every step in this view is done for the current evidence.")</p>
        }
        else
        {
            <ol class="wfp-actions">
                @foreach (var action in f.Primary)
                {
                    <li class="wfp-action wfp-@action.State.ToString().ToLowerInvariant()" data-testid="wfp-action" data-id="@action.Id" data-state="@action.State">
                        <div class="wfp-action-main">
                            <span class="wfp-action-title">@action.Title</span>
                            <span class="wfp-state">@action.StateLabel</span>
                        </div>
                        @if (!Compact) { <p class="wfp-why">@(action.Blocker ?? action.Why)</p> }
                        <a href="@action.Route" class="wfp-link" data-testid="wfp-open">@(action.State == FocusActionState.Blocked ? "See what is needed" : $"Open {action.Title}")</a>
                    </li>
                }
            </ol>
        }
        @if (f.View.View == WorkspaceView.ManualTesting && _plan is { } plan && (plan.Facts.Count > 0 || plan.Actions.Count > 0))
        {
            @* Test Plan proposals (persisted drafts and snapshots only): the same facts on Dashboard and Recommended Workflow. *@
            <div class="wfp-plan" data-testid="wfp-test-plan">
                <h3 class="wfp-subtitle">Test Plan proposals</h3>
                <ul class="wfp-counts" aria-label="Test Plan proposal facts">
                    @foreach (var fact in plan.Facts) { <li data-testid="wfp-plan-fact" data-id="@fact.Id"><strong>@fact.Count</strong> @fact.Label.ToLowerInvariant()</li> }
                    @if (plan.Latest is { } latest) { <li data-testid="wfp-plan-latest">latest snapshot #@latest.Sequence@(latest.DeliveryLabel is { } dl ? $" · {dl}" : "")</li> }
                </ul>
                <ol class="wfp-actions">
                    @foreach (var action in plan.Actions.Take(Compact ? 2 : 6))
                    {
                        <li class="wfp-action wfp-@action.State.ToString().ToLowerInvariant()" data-testid="wfp-plan-action" data-id="@action.Id">
                            <div class="wfp-action-main"><span class="wfp-action-title">@action.Title</span><span class="wfp-state">@action.StateLabel</span></div>
                            @if (!Compact) { <p class="wfp-why">@action.Why</p> }
                            <a href="@action.Route" class="wfp-link">Open @action.Title</a>
                        </li>
                    }
                </ol>
            </div>
        }
        @if (Compact) { <a href="getting-started" class="wfp-link wfp-more" data-testid="wfp-more">All next steps in Recommended Workflow</a> }
    </section>
}

@code {
    /// <summary>The capabilities the page already loaded (Recommended Workflow / Dashboard share them).</summary>
    [Parameter, EditorRequired] public IReadOnlyList<ReviewCapability> Capabilities { get; set; } = [];
    /// <summary>Dashboard preview: titles and states only, with a link to Recommended Workflow.</summary>
    [Parameter] public bool Compact { get; set; }

    private readonly string _id = Guid.NewGuid().ToString("N")[..8];
    private NavigationSectionState? _navigation;
    private SourceContextView? _context;
    private WorkspaceFocusView? _focus;
    private TestPlanSuggestionsPresentation.PlanFocus? _plan;
    private bool _planLoaded;

    protected override async Task OnInitializedAsync()
    {
        _navigation = Services.GetService(typeof(NavigationSectionState)) as NavigationSectionState;
        if (_navigation is not null) _navigation.Changed += OnNavigationChanged;
        if (Services.GetService(typeof(SourceContextApiService)) is SourceContextApiService api) (_context, _) = await api.GetAsync();
        Recompute();
        await LoadPlanAsync();
    }

    /// <summary>Test Plan proposals are read once, and only while the Manual Testing view is selected (one call; nothing per card).</summary>
    private async Task LoadPlanAsync()
    {
        if (_planLoaded || _focus?.View.View != WorkspaceView.ManualTesting) return;
        _planLoaded = true;
        if (Services.GetService(typeof(ITestPlanSuggestionsApiService)) is not ITestPlanSuggestionsApiService plans) return;
        var (workspace, _) = await plans.SummaryAsync(null);
        // MT-7: the same reviewed requirement coverage facts as Requirements Traceability (one read; unknown adds nothing).
        BirkNext.TestPlanning.RequirementCoverageView? coverage = null;
        if (Services.GetService(typeof(IFrontendAnalysisContextFactory)) is IFrontendAnalysisContextFactory contexts)
        {
            string? scope = null;
            try { scope = (await contexts.GetActiveContextAsync()).ActiveProfileOrNull?.Id; } catch (InvalidOperationException) { }
            if (!string.IsNullOrWhiteSpace(scope)) (coverage, _) = await plans.RequirementCoverageAsync(scope, rows: false);
        }
        _plan = TestPlanSuggestionsPresentation.Focus(workspace, coverage);
    }

    protected override void OnParametersSet() => Recompute();

    private void Recompute() => _focus = WorkspaceFocus.Of(_navigation?.View ?? WorkspaceView.AllModules, Capabilities, _context);

    private void OnNavigationChanged() => InvokeAsync(async () => { Recompute(); await LoadPlanAsync(); StateHasChanged(); });

    public void Dispose() { if (_navigation is not null) _navigation.Changed -= OnNavigationChanged; }
}
