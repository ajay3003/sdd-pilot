@using BirkNext.DatabaseArchitecture
@using System.Text.Json
@using System.Net
@using BirkNext.Web.Services
@using BirkNext.Web.Components.SourceDomains
@implements IAsyncDisposable
@inject IJSRuntime JS

<section class="database-workspace" aria-labelledby="db-heading" data-testid="database-workspace">
    <div class="sa-section-head">
        <h2 id="db-heading">Data <SourceStatusBadge Dimension="SourceStatusDimension.Completeness" Label="@StatusLabel(Snapshot.Status)" TestId="db-status" /></h2>
        <div class="sa-section-actions" data-testid="db-actions">
            <ExportMenu TestId="db-export-menu" Options="ExportOptions" />
        </div>
    </div>
    @if (StatusReason is { } statusReason) { <p class="sa-status-reason" data-testid="db-status-reason">@statusReason</p> }
    <p class="sa-scope-note" role="note" data-testid="db-limitation">@SourceBoundary.Database</p>
    <SourceViewNav Label="Data views" Views="Tabs" @bind-Current="_tab" Prefix="db-tab" TestId="db-views" />
    @if (_tab == "Overview")
    {
        var tables = AllTables;
        var relationshipStates = DatabaseEvidenceSummary.RelationshipStates(Snapshot);
        var unresolvedGroups = DatabaseEvidenceSummary.UnresolvedGroups(Snapshot);
        var physicalKnown = Snapshot.Databases.Any(d => d.PhysicalName is not null);
        @if (!Assessed) { <p class="db-muted" data-testid="db-not-assessed">Not detected: no supported database declaration was found in this source snapshot, so these counts are not assessed (not zero).</p> }
        <dl class="db-summary" data-testid="db-overview">
            <div><dt>Database candidates</dt><dd>@M(Snapshot.Databases.Count)</dd></div>
            <div><dt>Schemas</dt><dd>@M(Snapshot.Databases.Sum(d => d.Schemas.Count))</dd></div>
            <div><dt>Tables / entities</dt><dd>@M(tables.Count)</dd></div>
            <div><dt>Relationships</dt><dd>@M(AllRelationships.Count)</dd></div>
            <div><dt>Indexes</dt><dd>@M(tables.Sum(t => t.Indexes.Count))</dd></div>
            <div><dt>Unresolved</dt><dd>@M(Snapshot.UnresolvedEvidence.Count)</dd></div>
            <div><dt>Conflicts</dt><dd>@M(Snapshot.Conflicts.Count)</dd></div>
        </dl>
        <div class="db-actions">
            <button type="button" class="btn-primary" data-testid="db-open-diagram" @onclick='() => _tab = "Diagram"'>Open diagram</button>
            <button type="button" class="btn-secondary" data-testid="db-view-tables" @onclick='() => _tab = "Tables"'>View tables</button>
            <button type="button" class="btn-secondary" data-testid="db-view-relationships" @onclick='() => _tab = "Relationships"'>View relationships</button>
        </div>
        @if (!physicalKnown && Snapshot.Databases.Count > 0)
        {
            <p class="db-muted" data-testid="db-physical-note">Physical database: <span data-testid="db-physical-unknown">Unknown</span>. Source Analysis could not establish the deployed physical database identity from this source. This is not an error.</p>
        }
        <section class="db-panel" aria-labelledby="db-candidates-heading" data-testid="db-candidates">
            <h3 id="db-candidates-heading">Database candidates <span class="db-count">@Snapshot.Databases.Count</span></h3>
            <div class="db-scroll" tabindex="0" role="region" aria-label="Database candidates">
                <table><thead><tr><th scope="col">Candidate</th><th scope="col">Provider</th><th scope="col">Evidence</th><th scope="col">Project / source</th>@if (physicalKnown) { <th scope="col">Physical database</th> }</tr></thead><tbody>
                    @foreach (var db in Snapshot.Databases)
                    {
                        <tr data-testid="db-candidate-row"><th scope="row">@db.LogicalName</th><td>@(db.Provider ?? "Unknown")</td>
                            <td><span class="db-pill">@DatabaseEvidenceSummary.StateLabel(db.EvidenceState)</span></td><td title="@db.SourceProject">@SourceAnalysisReview.FileName(db.SourceProject)</td>
                            @if (physicalKnown) { <td>@(db.PhysicalName ?? "Unknown")</td> }</tr>
                    }
                </tbody></table>
            </div>
        </section>
        <section class="db-panel" aria-labelledby="db-unresolved-heading" data-testid="db-unresolved">
            <h3 id="db-unresolved-heading"><span data-testid="db-unresolved-count">@Snapshot.UnresolvedEvidence.Count</span> @(Snapshot.UnresolvedEvidence.Count == 1 ? "declaration" : "declarations") unresolved</h3>
            @if (unresolvedGroups.Count == 0) { <p class="db-muted">Every database declaration in this source was interpreted.</p> }
            else
            {
                <ul class="db-causes" data-testid="db-unresolved-groups">@foreach (var g in unresolvedGroups.Take(8)) { <li>@g.Label <span class="db-muted">· @g.Count</span></li> }@if (unresolvedGroups.Count > 8) { <li>@(unresolvedGroups.Count - 8) other type(s) <span class="db-muted">· @unresolvedGroups.Skip(8).Sum(g => g.Count)</span></li> }</ul>
                <p class="db-muted">Source declarations the analysis could not interpret with certainty — limitations of source analysis, not database defects.</p>
                <ReviewDisclosure Text="@($"Review unresolved evidence ({Snapshot.UnresolvedEvidence.Count})")" CollapseText="Hide unresolved evidence" TestId="db-unresolved-detail" Class="disclosure-small" @bind-Expanded="_showUnresolved">
                    @if (_showUnresolved)
                    {
                        <div class="db-controls">
                            <label>Search <input type="search" data-testid="db-unresolved-search" @bind="_unresolvedSearch" @bind:event="oninput" /></label>
                            <label>Type <select data-testid="db-unresolved-type" @bind="_unresolvedType"><option value="">All</option>@foreach (var g in unresolvedGroups) { <option value="@g.Label">@g.Label</option> }</select></label>
                            <label>Project <select data-testid="db-unresolved-project" @bind="_unresolvedProject"><option value="">All</option>@foreach (var project in Snapshot.UnresolvedEvidence.Select(e => e.Project).Distinct().Order(StringComparer.Ordinal)) { <option value="@project">@project</option> }</select></label>
                        </div>
                        <p class="db-muted" role="status" data-testid="db-unresolved-shown">@UnresolvedRows.Count of @Snapshot.UnresolvedEvidence.Count shown</p>
                        <div class="db-scroll" tabindex="0" role="region" aria-label="Unresolved database evidence">
                            <table data-testid="db-unresolved-table"><thead><tr><th scope="col">Type</th><th scope="col">Explanation</th><th scope="col">Project</th><th scope="col">Source</th><th scope="col">Extractor</th></tr></thead><tbody>
                                @foreach (var e in UnresolvedRows) { <tr data-testid="db-unresolved-row"><td>@e.Type</td><td>@e.Explanation</td><td>@e.Project</td><td class="db-path" title="@($"{e.Path}:{e.Line}")">@SourceAnalysisReview.FileName(e.Path):@e.Line</td><td>@e.Extractor</td></tr> }
                            </tbody></table>
                        </div>
                    }
                </ReviewDisclosure>
            }
        </section>
        <ReviewDisclosure Text="View evidence breakdown" CollapseText="Hide evidence breakdown" TestId="db-evidence-breakdown" Class="disclosure-small">
            <div class="db-panels">
                <section class="db-panel" aria-labelledby="db-rel-evidence-heading" data-testid="db-rel-evidence">
                    <h3 id="db-rel-evidence-heading">Relationship evidence</h3>
                    <p class="db-muted">@AllRelationships.Count relationships. Each has exactly one evidence state, so these add up to @AllRelationships.Count.</p>
                    <dl class="db-mini" data-testid="db-rel-states">@foreach (var (state, count) in relationshipStates) { <div data-state="@state"><dt>@DatabaseEvidenceSummary.StateLabel(state)</dt><dd>@count</dd></div> }</dl>
                </section>
                <section class="db-panel" aria-labelledby="db-tech-heading" data-testid="db-technologies">
                    <h3 id="db-tech-heading">Technologies</h3>
                    @if (Snapshot.TechnologiesDetected.Count == 0) { <p class="db-muted">None detected in source.</p> }
                    else { <ul class="db-chips">@foreach (var t in Snapshot.TechnologiesDetected) { <li>@t</li> }</ul> }
                    <p class="db-muted">As declared in source — the deployed database product is not verified.</p>
                </section>
            </div>
        </ReviewDisclosure>
        <div class="sa-disclosures" data-testid="db-limitations">
            <ReviewDisclosure Text="@($"Analyzer details ({Snapshot.Diagnostics.Count} limitations)")" CollapseText="Hide analyzer details" TestId="db-limitations-detail" Class="disclosure-small">
                <p class="db-muted">Source <code title="@Snapshot.SourceFingerprint" data-testid="db-fingerprint">@SourceBoundary.ShortFingerprint(Snapshot.SourceFingerprint)</code> · analyzer v@(Snapshot.AnalyzerVersion) · extracted @Snapshot.ExtractedAt.ToString("u")</p>
                <p class="db-muted" data-testid="db-limitation-full">@DatabaseArchitectureSnapshot.SourceLimitation</p>
                <p class="db-muted">General notes and limits of the source extraction (for example physical database identity and migration ordering):</p>
                <ul class="db-list">@foreach (var diagnostic in Snapshot.Diagnostics) { <li>@diagnostic</li> }</ul>
            </ReviewDisclosure>
        </div>
    }
    else if (_tab == "Changes")
    {
        <h3>Schema changes</h3>
        <p class="db-muted" data-testid="db-change-label">This compares source declarations. Migration deployment and live database changes are not assessed. @SourceBoundary.ChangesNotDrift</p>
        @if (Previous is null)
        {
            <p class="sa-empty-line" data-testid="db-no-previous">No earlier data analysis of this source is available for comparison. @if (ChooseSnapshot.HasDelegate) { <button type="button" class="db-link" data-testid="db-choose-snapshot" @onclick="() => ChooseSnapshot.InvokeAsync()">Choose another snapshot</button> }</p>
        }
        else
        {
            var changes = DatabaseSchemaComparison.Compare(Previous, Snapshot);
            <p class="db-muted">Previous: <code>@SourceBoundary.ShortFingerprint(Previous.SourceFingerprint)</code> · Current: <code>@SourceBoundary.ShortFingerprint(Snapshot.SourceFingerprint)</code></p>
            @if (Previous.AnalyzerVersion != Snapshot.AnalyzerVersion) { <p class="db-muted">Analyzer versions differ. Changes may reflect extraction coverage rather than changed source declarations.</p> }
            @if (changes.Count == 0) { <p class="sa-empty-line" data-testid="db-no-changes">No schema change between these snapshots.</p> }
            else
            {
                <dl class="sa-change-summary" data-testid="db-change-summary">@foreach (var g in SourceAnalysisReview.DatabaseChanges(changes)) { <div data-testid="db-change-group" data-area="@g.Label"><dt>@g.Label</dt><dd>@SourceAnalysisReview.ChangeText(g)</dd></div> }</dl>
                <ReviewDisclosure Text="@($"View detailed changes ({changes.Count})")" CollapseText="Hide detailed changes" TestId="db-change-details" Class="disclosure-small">
                    <ul class="db-list" data-testid="db-changes">@foreach (var change in changes) { <li>@change.Kind · @change.Object · @change.Detail</li> }</ul>
                </ReviewDisclosure>
            }
        }
    }
    else
    {
        var moreFilters = new[] { _project != "", _confirmed, !_inferred, _hideIsolated }.Count(x => x);
        <div class="db-toolbar-core" data-testid="db-filters">
            <label class="db-search"><span class="visually-hidden">Search table, entity or column</span><input type="search" @bind="_search" @bind:event="oninput" placeholder="Search" aria-label="Search table, entity or column" /></label>
            <label>Database <select @bind="_database"><option value="">All</option>@foreach (var db in Snapshot.Databases) { <option value="@db.Id">@db.LogicalName</option> }</select></label>
            <label>Schema <select @bind="_schema"><option value="">All</option>@foreach (var schema in AllTables.Select(t => t.SchemaName ?? "Unknown").Distinct()) { <option>@schema</option> }</select></label>
            @if (_tab == "Diagram") { <button type="button" class="btn-secondary" data-testid="db-fit" @onclick="Fit">Fit to screen</button> }
            <ReviewDisclosure Text="@(moreFilters > 0 ? $"More filters ({moreFilters})" : "More filters")" TestId="db-more-filters" Class="disclosure-small arch-menu">
                <div class="arch-menu-body">
                    <label>Project <select @bind="_project"><option value="">All</option>@foreach (var project in AllTables.Select(t => t.SourceProject).Distinct()) { <option value="@project">@SourceAnalysisReview.FileName(project)</option> }</select></label>
                    <label><input type="checkbox" @bind="_confirmed" /> Confirmed only</label>
                    <label><input type="checkbox" @bind="_inferred" /> Include inferred</label>
                    <label><input type="checkbox" @bind="_hideIsolated" /> Hide isolated tables</label>
                    @if (moreFilters > 0 || _search != "" || _database != "" || _schema != "") { <button type="button" class="db-link" data-testid="db-clear-filters" @onclick="ClearFilters">Clear filters</button> }
                </div>
            </ReviewDisclosure>
            @if (_tab == "Diagram")
            {
                <ReviewDisclosure Text="View options" TestId="db-view-options" Class="disclosure-small arch-menu">
                    <div class="arch-menu-body" data-testid="db-toolbar">
                        <button type="button" class="btn-secondary" @onclick="Reset">Reset layout</button>
                        <button type="button" class="btn-secondary" @onclick="Save">Save layout</button>
                        <button type="button" class="btn-secondary" @onclick="ExportSvg">Export SVG</button>
                        <label><input type="checkbox" @bind="_edges" /> Relationships</label>
                        <label><input type="checkbox" @bind="_pkOnly" /> PK/FK only</label>
                        <label><input type="checkbox" @bind="_allColumns" /> All columns</label>
                        <label><input type="checkbox" @bind="_legend" /> Show legend</label>
                    </div>
                </ReviewDisclosure>
            }
            @if (_related is not null) { <button type="button" class="btn-secondary" data-testid="db-clear-related" @onclick="ClearRelated">Clear related focus</button> }
        </div>
        <div class="db-content">
            <div class="db-main">
                @if (_tab == "Diagram")
                {
                    @if (Selected is not null)
                    {
                        <div class="db-selection-actions" role="group" aria-label="Selected table" data-testid="db-selection-actions">
                            <button type="button" class="btn-secondary" @onclick="Focus">Focus selected table</button>
                            <button type="button" class="btn-secondary" @onclick="ExpandSelected">Expand/collapse selected table</button>
                        </div>
                    }
                    @if (_legend)
                    {
                        <p class="db-legend" data-testid="db-legend"><span><span class="db-line" aria-hidden="true"></span>Confirmed</span><span><span class="db-line db-line-dashed" aria-hidden="true"></span>Inferred</span><span><span class="db-line db-line-dotted" aria-hidden="true"></span>Observed from migration/DDL or unresolved</span><span class="db-muted">Labels show the evidence state · drag tables, pan blank space, scroll to zoom · Tab to a table and press Enter.</span></p>
                    }
                    <div class="db-canvas" @ref="_canvas" tabindex="0" aria-label="Database diagram. Tables and Relationships list the same information."></div>
                    <p role="status" class="db-muted">@_message</p>
                }
                else if (_tab == "Tables")
                {
                    <button type="button" class="db-link" @onclick="() => _descending = !_descending">Sort table @(_descending ? "descending" : "ascending")</button>
                    <div class="db-scroll" tabindex="0" role="region" aria-label="Tables and entities"><table data-testid="db-tables"><thead><tr><th scope="col">Table / entity</th><th scope="col">Database / schema</th><th scope="col">Columns</th><th scope="col">PK</th><th scope="col">FK</th><th scope="col">Indexes</th><th scope="col">Evidence</th><th scope="col"><span class="visually-hidden">Evidence details</span></th></tr></thead><tbody>
                        @foreach (var table in VisibleTables.OrderBy(t => _descending ? "" : t.LogicalName).ThenByDescending(t => _descending ? t.LogicalName : ""))
                        {
                            var open = _openRows.Contains("t:" + table.Id);
                            <tr data-testid="db-table-row" data-table="@table.Id">
                                <td><button type="button" class="db-name" @onclick="() => SelectTable(table.Id)">@table.LogicalName</button>@if (table.EntityTypeName is { } entity && entity != table.LogicalName) { <span class="db-context">@entity</span> }</td>
                                <td>@Database(table)?.LogicalName · @(table.SchemaName ?? "Unknown")</td>
                                <td>@table.Columns.Count</td><td>@string.Join(", ", table.PrimaryKey?.Columns ?? [])</td><td>@table.ForeignKeys.Count</td><td>@table.Indexes.Count</td>
                                <td><span class="db-pill">@DatabaseEvidenceSummary.StateLabel(table.EvidenceState)</span></td>
                                <td><button type="button" class="db-link" aria-expanded="@(open ? "true" : "false")" data-testid="db-table-evidence-toggle" @onclick='() => Toggle("t:" + table.Id)'>@(open ? "Hide evidence" : "View evidence")<span class="visually-hidden"> for @table.LogicalName</span></button></td>
                            </tr>
                            @if (open) { <tr class="db-detail-row" data-testid="db-table-evidence"><td colspan="8"><p class="db-muted">@table.Confidence · Project <span class="db-path">@table.SourceProject</span></p>@EvidenceList(table.Evidence)</td></tr> }
                        }
                    </tbody></table></div>
                }
                else
                {
                    <div class="db-scroll" tabindex="0" role="region" aria-label="Relationships"><table data-testid="db-relationships"><thead><tr><th scope="col">From</th><th scope="col">From column(s)</th><th scope="col">To</th><th scope="col">To column(s)</th><th scope="col">Cardinality</th><th scope="col">Evidence</th><th scope="col"><span class="visually-hidden">Evidence details</span></th></tr></thead><tbody>
                    @foreach (var relationship in VisibleRelationships)
                    {
                        var key = "r:" + relationship.Id + ":" + relationship.FromTable + ":" + relationship.ToTable + ":" + string.Join(",", relationship.FromColumns);
                        var open = _openRows.Contains(key);
                        <tr data-testid="db-relationship-row"><td><button type="button" class="db-name" @onclick="() => SelectTable(relationship.FromTable)">@TableName(relationship.FromTable)</button></td><td>@string.Join(", ", relationship.FromColumns)</td><td>@TableName(relationship.ToTable)</td><td>@string.Join(", ", relationship.ToColumns)</td><td>@relationship.Cardinality</td>
                            <td><span class="db-pill">@DatabaseEvidenceSummary.StateLabel(relationship.EvidenceState)</span></td>
                            <td><button type="button" class="db-link" aria-expanded="@(open ? "true" : "false")" data-testid="db-relationship-evidence-toggle" @onclick="() => Toggle(key)">@(open ? "Hide evidence" : $"View evidence ({relationship.Evidence.Count})")<span class="visually-hidden"> for @TableName(relationship.FromTable) to @TableName(relationship.ToTable)</span></button></td></tr>
                        @if (open) { <tr class="db-detail-row" data-testid="db-relationship-evidence"><td colspan="7"><p class="db-muted">@relationship.Confidence · Delete behavior: @(relationship.DeleteBehavior ?? "Unknown")@(relationship.IsRequired is { } required ? $" · Required: {required}" : "")@(relationship.Name is { } name ? $" · {name}" : "")</p>@EvidenceList(relationship.Evidence)</td></tr> }
                    }
                    </tbody></table></div>
                }
            </div>
            @if (Selected is { } selected)
            {
                var db = Database(selected);
                <aside class="db-details" aria-label="Table details" data-testid="db-table-detail"><button type="button" @onclick="() => _selected = null">Close details</button><h3>@selected.LogicalName</h3>
                    <dl class="db-facts">
                        <div><dt>Database candidate</dt><dd>@(db?.LogicalName ?? "Unknown")</dd></div>
                        <div><dt>Schema</dt><dd>@(selected.SchemaName ?? "Unknown")</dd></div>
                        <div><dt>Physical table</dt><dd>@(selected.PhysicalName ?? "Unconfirmed")</dd></div>
                        <div><dt>Entity</dt><dd>@selected.EntityTypeName</dd></div>
                        <div><dt>Evidence</dt><dd>@DatabaseEvidenceSummary.StateLabel(selected.EvidenceState) · @selected.Confidence</dd></div>
                        <div><dt>Project</dt><dd class="db-path" title="@selected.SourceProject">@selected.SourceProject</dd></div>
                        <div><dt>DbContext / provider</dt><dd>@db?.DbContext · @(db?.Provider ?? "Unknown")</dd></div>
                        <div><dt>Connection reference</dt><dd>@(db?.ConnectionReference ?? "Unknown") <span class="db-muted">(name only)</span></dd></div>
                    </dl>
                    <div class="db-actions"><label>Related depth <select @bind="_depth"><option value="1">Direct</option><option value="2">2 levels</option><option value="999">All reachable</option></select></label><button type="button" @onclick="ShowRelated">Show related</button><button type="button" @onclick="OpenDiagram">Open diagram</button></div>
                    <h4>Columns (@selected.Columns.Count)</h4>@foreach (var column in selected.Columns) { <details><summary>@(column.IsPrimaryKey ? "PK " : "")@(column.IsForeignKey ? "FK " : "")@column.Name · @DatabaseEvidenceSummary.StateLabel(column.EvidenceState)</summary><p>Property: @column.PropertyName<br />@column.ClrType @column.StoreType</p>@if (column.Nullable is not null) { <p>Nullable: @column.Nullable · @string.Join(" / ", column.Assertions.Where(a => a.Fact == "Nullable").Select(a => a.Evidence.State).Distinct())</p> }@if (column.MaxLength is not null) { <p>Max length: @column.MaxLength</p> }@if (column.Precision is not null) { <p>Precision: @column.Precision · Scale: @column.Scale</p> }@if (column.IsIdentity is not null) { <p>Identity: @column.IsIdentity</p> }@if (column.IsGeneratedOnAdd is not null) { <p>Generated on add: @column.IsGeneratedOnAdd</p> }@if (column.IsComputed is not null) { <p>Computed: @column.IsComputed</p> }@EvidenceList(column.Evidence)</details> }
                    <h4>Primary key</h4><p>@string.Join(", ", selected.PrimaryKey?.Columns ?? [])</p>
                    <h4>Incoming / outgoing relationships</h4>@foreach (var r in AllRelationships.Where(r => r.FromTable == selected.Id || r.ToTable == selected.Id)) { <details><summary>@TableName(r.FromTable) → @TableName(r.ToTable) · @r.Cardinality · @DatabaseEvidenceSummary.StateLabel(r.EvidenceState)</summary><p>@string.Join(", ", r.FromColumns) → @string.Join(", ", r.ToColumns)<br />Delete behavior: @(r.DeleteBehavior ?? "Unknown")</p>@EvidenceList(r.Evidence)</details> }
                    <h4>Indexes (@selected.Indexes.Count)</h4>@foreach (var ix in selected.Indexes) { <details><summary>@ix.Name · @string.Join(", ", ix.Columns) · Unique: @ix.Unique</summary>@EvidenceList(ix.Evidence)</details> }
                    @if (selected.Constraints.Count > 0) { <h4>Constraints</h4>@foreach (var constraint in selected.Constraints) { <details><summary>@constraint.Name · @constraint.Type · @string.Join(", ", constraint.Columns)</summary>@EvidenceList(constraint.Evidence)</details> } }
                    <details><summary>Source evidence (@selected.Evidence.Count)</summary>@EvidenceList(selected.Evidence)</details>
                    @{ var conflicts = Snapshot.Conflicts.Where(c => c.TableId == selected.Id).ToList(); }
                    @if (conflicts.Count > 0) { <h4>Conflicts</h4>@foreach (var conflict in conflicts) { <p>Conflict: @conflict.Column @conflict.Fact · @conflict.First vs @conflict.Second</p>@EvidenceList(conflict.Evidence) } }
                    @{ var unresolved = Snapshot.UnresolvedEvidence.Where(e => selected.Evidence.Any(x => x.Project == e.Project)).ToList(); }
                    <details><summary>Unresolved items in this project (@unresolved.Count)</summary>@EvidenceList(unresolved)</details>
                </aside>
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public DatabaseArchitectureSnapshot Snapshot { get; set; } = new();
    [Parameter] public DatabaseArchitectureSnapshot? Previous { get; set; }
    /// <summary>Opens the diagram on one database (drilldown from Source Analysis → Architecture). Null leaves the view as the user set it.</summary>
    [Parameter] public string? FocusDatabaseId { get; set; }
    /// <summary>The view to open first (e.g. "Diagram" from the Source Analysis landing page). Presentation only.</summary>
    [Parameter] public string? InitialTab { get; set; }
    /// <summary>Moves focus to the page's source snapshot selector (Changes empty state).</summary>
    [Parameter] public EventCallback ChooseSnapshot { get; set; }
    private static readonly string[] Tabs = ["Overview", "Diagram", "Tables", "Relationships", "Changes"];
    private static string StatusLabel(DatabaseAnalysisStatus status) => status switch
    {
        DatabaseAnalysisStatus.NeedsReview => "Needs review",
        DatabaseAnalysisStatus.Unsupported => "Not detected",
        _ => status.ToString(),
    };
    /// <summary>The primary reason for a non-complete status, from the actual data.</summary>
    private string? StatusReason => Snapshot.Status switch
    {
        DatabaseAnalysisStatus.Complete => null,
        DatabaseAnalysisStatus.Unsupported => "No supported database declaration was found in this source.",
        _ when Snapshot.Conflicts.Count > 0 => SourceAnalysisReview.Plural(Snapshot.Conflicts.Count, "conflicting declaration", "conflicting declarations"),
        _ when Snapshot.UnresolvedEvidence.Count > 0 => SourceAnalysisReview.Plural(Snapshot.UnresolvedEvidence.Count, "unresolved declaration", "unresolved declarations"),
        _ => "Some declarations could not be interpreted",
    };
    /// <summary>One export pattern: HTML and JSON everywhere, SVG only on the diagram.</summary>
    private IReadOnlyList<ExportMenu.Option> ExportOptions =>
    [
        new("html", "HTML", ExportHtml), new("json", "JSON", ExportJson),
        .. _tab == "Diagram" ? [new ExportMenu.Option("svg", "SVG", ExportSvg)] : Array.Empty<ExportMenu.Option>(),
    ];
    private bool _legend;
    private void ClearFilters() { _search = ""; _database = ""; _schema = ""; _project = ""; _confirmed = false; _inferred = true; _hideIsolated = false; }
    // Unsupported means not assessed: counts show "Not assessed", never a zero that reads as "none found".
    private bool Assessed => Snapshot.Status != DatabaseAnalysisStatus.Unsupported;
    private string M(int value) => Assessed ? value.ToString() : "Not assessed";
    private bool _showUnresolved;
    private string _unresolvedSearch = "", _unresolvedType = "", _unresolvedProject = "";
    private List<DatabaseEvidence> UnresolvedRows => Snapshot.UnresolvedEvidence.Where(e => (_unresolvedType == "" || e.Type == _unresolvedType) && (_unresolvedProject == "" || e.Project == _unresolvedProject)
        && (_unresolvedSearch == "" || $"{e.Type} {e.Explanation} {e.Path} {e.Symbol} {e.Extractor}".Contains(_unresolvedSearch, StringComparison.OrdinalIgnoreCase))).ToList();
    // Expanded evidence rows (Tables / Relationships); collapsed rows render no evidence DOM.
    private readonly HashSet<string> _openRows = [];
    private void Toggle(string key) { if (!_openRows.Add(key)) _openRows.Remove(key); }
    protected override void OnInitialized() { if (InitialTab is "Overview" or "Diagram" or "Tables" or "Relationships" or "Changes") _tab = InitialTab; }
    private string? _focused;
    protected override void OnParametersSet()
    {
        if (FocusDatabaseId is null || FocusDatabaseId == _focused) return;
        _focused = FocusDatabaseId;
        if (Snapshot.Databases.Any(d => d.Id == FocusDatabaseId)) { _database = FocusDatabaseId; _tab = "Diagram"; }
    }
    private string _tab = "Overview", _search = "", _database = "", _schema = "", _project = "", _message = "";
    private string? _selected; private bool _confirmed, _hideIsolated, _pkOnly, _allColumns, _descending; private bool _inferred = true, _edges = true; private int _depth = 1;
    private HashSet<string>? _related; private ElementReference _canvas; private IJSObjectReference? _module; private DotNetObjectReference<DatabaseWorkspace>? _reference; private string? _renderKey;
    private HashSet<string> _expanded = [];
    private void ExpandSelected() { if (_selected is null) return; if (!_expanded.Add(_selected)) _expanded.Remove(_selected); }
    private List<TableModel> AllTables => Snapshot.Databases.SelectMany(d => d.Schemas.SelectMany(s => s.Tables)).ToList();
    private List<RelationshipModel> AllRelationships => AllTables.SelectMany(t => t.Relationships).ToList();
    private TableModel? Selected => AllTables.FirstOrDefault(t => t.Id == _selected);
    private DatabaseModel? Database(TableModel table) => Snapshot.Databases.FirstOrDefault(d => d.Schemas.Any(s => s.Tables.Contains(table)));
    private string TableName(string id) => AllTables.FirstOrDefault(t => t.Id == id)?.LogicalName ?? "Unresolved target";
    private bool State(DatabaseFact item) => (!_confirmed || item.EvidenceState == DatabaseEvidenceState.Confirmed) && (_inferred || item.EvidenceState != DatabaseEvidenceState.Inferred);
    private List<TableModel> VisibleTables => AllTables.Where(t => (_database == "" || Database(t)?.Id == _database) && (_schema == "" || (t.SchemaName ?? "Unknown") == _schema) && (_project == "" || t.SourceProject == _project) && State(t) && (_related is null || _related.Contains(t.Id)) && (!_hideIsolated || AllRelationships.Any(r => State(r) && (r.FromTable == t.Id || r.ToTable == t.Id))) && (_search == "" || new[] { t.LogicalName, t.EntityTypeName ?? "" }.Concat(t.Columns.Select(c => c.Name)).Any(n => n.Contains(_search, StringComparison.OrdinalIgnoreCase)))).ToList();
    private List<RelationshipModel> VisibleRelationships { get { var ids = VisibleTables.Select(t => t.Id).ToHashSet(); return AllRelationships.Where(r => State(r) && ids.Contains(r.FromTable) && ids.Contains(r.ToTable)).ToList(); } }
    private RenderFragment EvidenceList(List<DatabaseEvidence> evidence) => builder => { var i = 0; foreach (var e in evidence) { builder.OpenElement(i++, "p"); builder.AddContent(i++, $"{e.State} · {e.Type} · {e.Explanation} · {e.Project} · {e.Path}:{e.Line}–{e.EndLine} · {e.Extractor}"); builder.CloseElement(); } };
    [JSInvokable] public Task SelectTable(string id) { _selected = id; StateHasChanged(); return Task.CompletedTask; }
    private void OpenDiagram() => _tab = "Diagram";
    private void ClearRelated() => _related = null;
    private void ShowRelated() { if (_selected is null) return; _related = [_selected]; var frontier = new HashSet<string>(_related); for (var level = 0; level < _depth && frontier.Count > 0; level++) { var next = AllRelationships.Where(State).Where(r => frontier.Contains(r.FromTable) || frontier.Contains(r.ToTable)).SelectMany(r => new[] { r.FromTable, r.ToTable }).Where(id => !_related.Contains(id)).ToHashSet(); _related.UnionWith(next); frontier = next; } _search = ""; _tab = "Diagram"; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_tab != "Diagram") { _renderKey = null; return; }
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/databaseDiagram.js"); _reference ??= DotNetObjectReference.Create(this);
        var nodes = VisibleTables.Select(t => new { id = t.Id, name = t.LogicalName, state = Snapshot.Conflicts.Any(c => c.TableId == t.Id) ? "Conflict · " + t.EvidenceState : t.EvidenceState.ToString(), columns = (_pkOnly ? t.Columns.Where(c => c.IsPrimaryKey || c.IsForeignKey) : _allColumns || _expanded.Contains(t.Id) ? t.Columns : t.Columns.Where(c => c.IsPrimaryKey || c.IsForeignKey).Concat(t.Columns.Where(c => !c.IsPrimaryKey && !c.IsForeignKey).Take(3))).Select(c => (c.IsPrimaryKey ? "PK " : c.IsForeignKey ? "FK " : "") + c.Name).ToArray() }).ToArray();
        var edges = _edges ? VisibleRelationships.Select(r => new { from = r.FromTable, to = r.ToTable, label = r.Cardinality + " · " + r.EvidenceState, state = r.EvidenceState.ToString() }).ToArray() : [];
        var key = JsonSerializer.Serialize(new { nodes, edges, Snapshot.SourceSnapshotId, _database }); if (_renderKey == key) return; _renderKey = key;
        _message = await _module.InvokeAsync<string>("render", _canvas, nodes, edges, $"database-layout:v1:{Snapshot.SourceSnapshotId}:{Snapshot.SourceFingerprint}:{_database}:default", _reference);
        StateHasChanged();
    }
    private async Task Fit() { if (_module is not null) await _module.InvokeVoidAsync("fit", _canvas); }
    private async Task Focus() { if (_module is not null && _selected is not null) await _module.InvokeVoidAsync("focus", _canvas, _selected); }
    private async Task Reset() { if (_module is not null) await _module.InvokeVoidAsync("reset", _canvas); }
    private async Task Save() { if (_module is not null) _message = await _module.InvokeAsync<string>("save", _canvas); }
    private async Task ExportSvg() { if (_module is not null) await _module.InvokeVoidAsync("exportSvg", _canvas); }
    private async Task ExportJson() => await JS.InvokeVoidAsync("downloadJsonFile", "source-database-model.json", JsonSerializer.Serialize(Snapshot, new JsonSerializerOptions { WriteIndented = true }));
    private async Task ExportHtml()
    {
        string E(string? value) => WebUtility.HtmlEncode(value);
        var html = "<!doctype html><html lang=\"en\"><meta charset=\"utf-8\"><title>Source database architecture</title><h1>Source database architecture</h1><p>" + E(DatabaseArchitectureSnapshot.SourceLimitation) + "</p><p>Source: " + E(Snapshot.SourceFingerprint) + "</p>";
        html += "<p>Database candidates: " + Snapshot.Databases.Count + " · Tables/entities: " + AllTables.Count + " · Relationships: " + AllRelationships.Count + " · Status: " + E(Snapshot.Status.ToString()) + "</p>"; foreach (var table in AllTables) { html += "<h2>" + E(table.LogicalName) + "</h2><p>" + E(table.EvidenceState.ToString()) + " · " + E(table.Confidence) + "</p><ul>"; foreach (var column in table.Columns) html += "<li>" + E(column.Name) + " · " + E(column.StoreType ?? column.ClrType) + " · " + E(column.EvidenceState.ToString()) + "</li>"; html += "</ul>"; foreach (var r in table.Relationships) html += "<p>" + E(TableName(r.FromTable)) + " → " + E(TableName(r.ToTable)) + " · " + E(r.Cardinality) + " · " + E(r.EvidenceState.ToString()) + "</p>"; foreach (var e in table.Evidence.Concat(table.Columns.SelectMany(c => c.Evidence)).Concat(table.Relationships.SelectMany(r => r.Evidence)).Distinct()) html += "<p>" + E(e.Type + " · " + e.Path + ":" + e.Line + " · " + e.Explanation) + "</p>"; }
        foreach (var diagnostic in Snapshot.Diagnostics) html += "<p>" + E(diagnostic) + "</p>"; html += "</html>"; await JS.InvokeVoidAsync("downloadHtmlFile", "source-database-report.html", html);
    }
    public async ValueTask DisposeAsync() { if (_module is not null) { try { await _module.InvokeVoidAsync("dispose", _canvas); await _module.DisposeAsync(); } catch (JSDisconnectedException) { } } _reference?.Dispose(); }
}
