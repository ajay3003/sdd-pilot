@using BirkNext.DatabaseArchitecture
@using System.Text.Json
@using System.Net
@implements IAsyncDisposable
@inject IJSRuntime JS

<section class="database-workspace" aria-label="Source Analysis Database" data-testid="database-workspace">
    <h2>Database · @Snapshot.Status</h2>
    <p>@DatabaseArchitectureSnapshot.SourceLimitation</p>
    <p>Source fingerprint: <code>@Snapshot.SourceFingerprint</code></p>
    <nav class="db-controls" aria-label="Database views">
        @foreach (var tab in new[] { "Overview", "Diagram", "Tables", "Relationships", "Changes" }) { <button type="button" aria-pressed="@(_tab == tab)" @onclick="() => _tab = tab">@tab</button> }
        <button @onclick="ExportHtml">Export HTML</button><button @onclick="ExportJson">Export JSON</button>
    </nav>
    @if (_tab == "Overview")
    {
        <dl class="db-summary"><dt>Database candidates</dt><dd>@Snapshot.Databases.Count</dd><dt>Schemas (including unknown groups)</dt><dd>@Snapshot.Databases.Sum(d => d.Schemas.Count)</dd><dt>Tables / persistence candidates</dt><dd>@AllTables.Count</dd><dt>Columns</dt><dd>@AllTables.Sum(t => t.Columns.Count)</dd><dt>Relationships</dt><dd>@AllRelationships.Count</dd><dt>Confirmed relationships</dt><dd>@AllRelationships.Count(r => r.EvidenceState == DatabaseEvidenceState.Confirmed)</dd><dt>Inferred relationships</dt><dd>@AllRelationships.Count(r => r.EvidenceState == DatabaseEvidenceState.Inferred)</dd><dt>Indexes</dt><dd>@AllTables.Sum(t => t.Indexes.Count)</dd><dt>Unresolved</dt><dd>@Snapshot.UnresolvedEvidence.Count</dd><dt>Conflicts</dt><dd>@Snapshot.Conflicts.Count</dd><dt>Technologies</dt><dd>@string.Join(", ", Snapshot.TechnologiesDetected)</dd></dl>
        @foreach (var db in Snapshot.Databases) { <p><strong>@db.LogicalName</strong> · @db.Provider · @db.EvidenceState<br />Physical database: @(db.PhysicalName ?? "Unknown") · @db.SourceProject</p> }
        <details><summary>Limitations and diagnostics</summary><ul>@foreach (var diagnostic in Snapshot.Diagnostics) { <li>@diagnostic</li> }</ul></details>
    }
    else if (_tab == "Changes")
    {
        <h3>Source schema change</h3><p>Comparison reflects source declarations; migration deployment and runtime database changes are not assessed.</p>
        @if (Previous is null) { <p>A previous database analysis snapshot is required.</p> }
        else { <p>Previous: @Previous.SourceFingerprint<br />Current: @Snapshot.SourceFingerprint</p>@if (Previous.AnalyzerVersion != Snapshot.AnalyzerVersion) { <p>Analyzer versions differ. Changes may reflect extraction coverage rather than changed source declarations.</p> }<ul>@foreach (var change in DatabaseSchemaComparison.Compare(Previous, Snapshot)) { <li>@change.Kind · @change.Object · @change.Detail</li> }</ul> }
    }
    else
    {
        <div class="db-controls">
            <label>Search table, entity or column <input type="search" @bind="_search" @bind:event="oninput" /></label>
            <label>Database <select @bind="_database"><option value="">All</option>@foreach (var db in Snapshot.Databases) { <option value="@db.Id">@db.LogicalName</option> }</select></label>
            <label>Schema <select @bind="_schema"><option value="">All</option>@foreach (var schema in AllTables.Select(t => t.SchemaName ?? "Unknown").Distinct()) { <option>@schema</option> }</select></label>
            <label>Project <select @bind="_project"><option value="">All</option>@foreach (var project in AllTables.Select(t => t.SourceProject).Distinct()) { <option>@project</option> }</select></label>
            <label><input type="checkbox" @bind="_confirmed" /> Confirmed only</label>
            <label><input type="checkbox" @bind="_inferred" /> Include inferred</label>
            <label><input type="checkbox" @bind="_hideIsolated" /> Hide isolated tables</label>
            <button @onclick="ClearRelated">Clear related focus</button>
        </div>
        <div class="db-content">
            <div class="db-main">
                @if (_tab == "Diagram")
                {
                    <div class="db-controls"><button @onclick="Fit">Fit to screen</button><button @onclick="Focus" disabled="@(Selected is null)">Focus selected table</button><button @onclick="ExpandSelected" disabled="@(Selected is null)">Expand/collapse selected table</button><button @onclick="Reset">Reset layout</button><button @onclick="Save">Save layout</button><button @onclick="ExportSvg">Export SVG</button><label><input type="checkbox" @bind="_pkOnly" /> PK/FK only</label><label><input type="checkbox" @bind="_allColumns" /> All columns</label><label><input type="checkbox" @bind="_edges" /> Relationships</label></div>
                    <p>Solid: confirmed · Dashed: inferred · Dotted: migration/DDL · Labels show evidence state. Drag tables; pan blank space; scroll to zoom.</p>
                    <div class="db-canvas" @ref="_canvas" tabindex="0" aria-label="Database diagram. Use Tables and Relationships for keyboard access."></div>
                    <p role="status">@_message</p>
                }
                else if (_tab == "Tables")
                {
                    <button @onclick="() => _descending = !_descending">Sort table @(_descending ? "descending" : "ascending")</button>
                    <div class="db-scroll"><table><thead><tr><th>Database</th><th>Schema</th><th>Table / entity</th><th>Columns</th><th>PK</th><th>FKs</th><th>Indexes</th><th>Evidence / confidence</th><th>Source project</th></tr></thead><tbody>
                        @foreach (var table in VisibleTables.OrderBy(t => _descending ? "" : t.LogicalName).ThenByDescending(t => _descending ? t.LogicalName : "")) { <tr><td>@Database(table)?.LogicalName</td><td>@(table.SchemaName ?? "Unknown")</td><td><button @onclick="() => SelectTable(table.Id)">@table.LogicalName</button><br />@table.EntityTypeName</td><td>@table.Columns.Count</td><td>@string.Join(", ", table.PrimaryKey?.Columns ?? [])</td><td>@table.ForeignKeys.Count</td><td>@table.Indexes.Count</td><td>@table.EvidenceState · @table.Confidence</td><td>@table.SourceProject</td></tr> }
                    </tbody></table></div>
                }
                else
                {
                    <div class="db-scroll"><table><thead><tr><th>From</th><th>Columns</th><th>To</th><th>Columns</th><th>Cardinality</th><th>Evidence / confidence</th><th>Source</th></tr></thead><tbody>
                    @foreach (var relationship in VisibleRelationships) { <tr><td><button @onclick="() => SelectTable(relationship.FromTable)">@TableName(relationship.FromTable)</button></td><td>@string.Join(", ", relationship.FromColumns)</td><td>@TableName(relationship.ToTable)</td><td>@string.Join(", ", relationship.ToColumns)</td><td>@relationship.Cardinality</td><td>@relationship.EvidenceState · @relationship.Confidence</td><td>@foreach (var evidence in relationship.Evidence) { <p>@evidence.Type · @evidence.Path:@evidence.Line</p> }</td></tr> }
                    </tbody></table></div>
                }
            </div>
            @if (Selected is { } selected)
            {
                <aside class="db-details" aria-label="Table details"><button @onclick="() => _selected = null">Close details</button><h3>@selected.LogicalName</h3>
                    <p>Physical table: @(selected.PhysicalName ?? "Unconfirmed")<br />Schema: @(selected.SchemaName ?? "Unknown")<br />Entity: @selected.EntityTypeName<br />Project: @selected.SourceProject<br />DbContext: @Database(selected)?.DbContext<br />Provider: @(Database(selected)?.Provider ?? "Unknown")<br />Connection reference: @(Database(selected)?.ConnectionReference ?? "Unknown")<br />@selected.EvidenceState · @selected.Confidence</p>
                    <label>Related depth <select @bind="_depth"><option value="1">Direct</option><option value="2">2 levels</option><option value="999">All reachable</option></select></label><button @onclick="ShowRelated">Show related</button><button @onclick="OpenDiagram">Open diagram</button>
                    <h4>Columns</h4>@foreach (var column in selected.Columns) { <details><summary>@(column.IsPrimaryKey ? "PK " : "")@(column.IsForeignKey ? "FK " : "")@column.Name · @column.EvidenceState</summary><p>Property: @column.PropertyName<br />@column.ClrType @column.StoreType</p>@if (column.Nullable is not null) { <p>Nullable: @column.Nullable · @string.Join(" / ", column.Assertions.Where(a => a.Fact == "Nullable").Select(a => a.Evidence.State).Distinct())</p> }@if (column.MaxLength is not null) { <p>Max length: @column.MaxLength</p> }@if (column.Precision is not null) { <p>Precision: @column.Precision · Scale: @column.Scale</p> }@if (column.IsIdentity is not null) { <p>Identity: @column.IsIdentity</p> }@if (column.IsGeneratedOnAdd is not null) { <p>Generated on add: @column.IsGeneratedOnAdd</p> }@if (column.IsComputed is not null) { <p>Computed: @column.IsComputed</p> }@EvidenceList(column.Evidence)</details> }
                    <h4>Primary key</h4><p>@string.Join(", ", selected.PrimaryKey?.Columns ?? [])</p>
                    <h4>Incoming / outgoing relationships</h4>@foreach (var r in AllRelationships.Where(r => r.FromTable == selected.Id || r.ToTable == selected.Id)) { <details><summary>@TableName(r.FromTable) → @TableName(r.ToTable) · @r.Cardinality · @r.EvidenceState</summary><p>@string.Join(", ", r.FromColumns) → @string.Join(", ", r.ToColumns)<br />Delete behavior: @(r.DeleteBehavior ?? "Unknown")</p>@EvidenceList(r.Evidence)</details> }
                    <h4>Indexes</h4>@foreach (var ix in selected.Indexes) { <p>@ix.Name · @string.Join(", ", ix.Columns) · Unique: @ix.Unique</p>@EvidenceList(ix.Evidence) }
                    <h4>Constraints</h4>@foreach (var constraint in selected.Constraints) { <p>@constraint.Name · @constraint.Type · @string.Join(", ", constraint.Columns)</p>@EvidenceList(constraint.Evidence) }
                    <h4>Source evidence</h4>@EvidenceList(selected.Evidence)
                    <h4>Conflicts</h4>@foreach (var conflict in Snapshot.Conflicts.Where(c => c.TableId == selected.Id)) { <p>Conflict: @conflict.Column @conflict.Fact · @conflict.First vs @conflict.Second</p>@EvidenceList(conflict.Evidence) }
                    <h4>Unresolved items</h4>@EvidenceList(Snapshot.UnresolvedEvidence.Where(e => selected.Evidence.Any(x => x.Project == e.Project)).ToList())
                </aside>
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public DatabaseArchitectureSnapshot Snapshot { get; set; } = new();
    [Parameter] public DatabaseArchitectureSnapshot? Previous { get; set; }
    /// <summary>Opens the diagram on one database (drilldown from Source Analysis → Architecture). Null leaves the view as the user set it.</summary>
    [Parameter] public string? FocusDatabaseId { get; set; }
    /// <summary>The view to open first (e.g. "Diagram" from the Source Analysis landing page). Presentation only.</summary>
    [Parameter] public string? InitialTab { get; set; }
    protected override void OnInitialized() { if (InitialTab is "Overview" or "Diagram" or "Tables" or "Relationships" or "Changes") _tab = InitialTab; }
    private string? _focused;
    protected override void OnParametersSet()
    {
        if (FocusDatabaseId is null || FocusDatabaseId == _focused) return;
        _focused = FocusDatabaseId;
        if (Snapshot.Databases.Any(d => d.Id == FocusDatabaseId)) { _database = FocusDatabaseId; _tab = "Diagram"; }
    }
    private string _tab = "Overview", _search = "", _database = "", _schema = "", _project = "", _message = "";
    private string? _selected; private bool _confirmed, _hideIsolated, _pkOnly, _allColumns, _descending; private bool _inferred = true, _edges = true; private int _depth = 1;
    private HashSet<string>? _related; private ElementReference _canvas; private IJSObjectReference? _module; private DotNetObjectReference<DatabaseWorkspace>? _reference; private string? _renderKey;
    private HashSet<string> _expanded = [];
    private void ExpandSelected() { if (_selected is null) return; if (!_expanded.Add(_selected)) _expanded.Remove(_selected); }
    private List<TableModel> AllTables => Snapshot.Databases.SelectMany(d => d.Schemas.SelectMany(s => s.Tables)).ToList();
    private List<RelationshipModel> AllRelationships => AllTables.SelectMany(t => t.Relationships).ToList();
    private TableModel? Selected => AllTables.FirstOrDefault(t => t.Id == _selected);
    private DatabaseModel? Database(TableModel table) => Snapshot.Databases.FirstOrDefault(d => d.Schemas.Any(s => s.Tables.Contains(table)));
    private string TableName(string id) => AllTables.FirstOrDefault(t => t.Id == id)?.LogicalName ?? "Unresolved target";
    private bool State(DatabaseFact item) => (!_confirmed || item.EvidenceState == DatabaseEvidenceState.Confirmed) && (_inferred || item.EvidenceState != DatabaseEvidenceState.Inferred);
    private List<TableModel> VisibleTables => AllTables.Where(t => (_database == "" || Database(t)?.Id == _database) && (_schema == "" || (t.SchemaName ?? "Unknown") == _schema) && (_project == "" || t.SourceProject == _project) && State(t) && (_related is null || _related.Contains(t.Id)) && (!_hideIsolated || AllRelationships.Any(r => State(r) && (r.FromTable == t.Id || r.ToTable == t.Id))) && (_search == "" || new[] { t.LogicalName, t.EntityTypeName ?? "" }.Concat(t.Columns.Select(c => c.Name)).Any(n => n.Contains(_search, StringComparison.OrdinalIgnoreCase)))).ToList();
    private List<RelationshipModel> VisibleRelationships { get { var ids = VisibleTables.Select(t => t.Id).ToHashSet(); return AllRelationships.Where(r => State(r) && ids.Contains(r.FromTable) && ids.Contains(r.ToTable)).ToList(); } }
    private RenderFragment EvidenceList(List<DatabaseEvidence> evidence) => builder => { var i = 0; foreach (var e in evidence) { builder.OpenElement(i++, "p"); builder.AddContent(i++, $"{e.State} · {e.Type} · {e.Explanation} · {e.Project} · {e.Path}:{e.Line}–{e.EndLine} · {e.Extractor}"); builder.CloseElement(); } };
    [JSInvokable] public Task SelectTable(string id) { _selected = id; StateHasChanged(); return Task.CompletedTask; }
    private void OpenDiagram() => _tab = "Diagram";
    private void ClearRelated() => _related = null;
    private void ShowRelated() { if (_selected is null) return; _related = [_selected]; var frontier = new HashSet<string>(_related); for (var level = 0; level < _depth && frontier.Count > 0; level++) { var next = AllRelationships.Where(State).Where(r => frontier.Contains(r.FromTable) || frontier.Contains(r.ToTable)).SelectMany(r => new[] { r.FromTable, r.ToTable }).Where(id => !_related.Contains(id)).ToHashSet(); _related.UnionWith(next); frontier = next; } _search = ""; _tab = "Diagram"; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_tab != "Diagram") { _renderKey = null; return; }
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/databaseDiagram.js"); _reference ??= DotNetObjectReference.Create(this);
        var nodes = VisibleTables.Select(t => new { id = t.Id, name = t.LogicalName, state = Snapshot.Conflicts.Any(c => c.TableId == t.Id) ? "Conflict · " + t.EvidenceState : t.EvidenceState.ToString(), columns = (_pkOnly ? t.Columns.Where(c => c.IsPrimaryKey || c.IsForeignKey) : _allColumns || _expanded.Contains(t.Id) ? t.Columns : t.Columns.Where(c => c.IsPrimaryKey || c.IsForeignKey).Concat(t.Columns.Where(c => !c.IsPrimaryKey && !c.IsForeignKey).Take(3))).Select(c => (c.IsPrimaryKey ? "PK " : c.IsForeignKey ? "FK " : "") + c.Name).ToArray() }).ToArray();
        var edges = _edges ? VisibleRelationships.Select(r => new { from = r.FromTable, to = r.ToTable, label = r.Cardinality + " · " + r.EvidenceState, state = r.EvidenceState.ToString() }).ToArray() : [];
        var key = JsonSerializer.Serialize(new { nodes, edges, Snapshot.SourceSnapshotId, _database }); if (_renderKey == key) return; _renderKey = key;
        _message = await _module.InvokeAsync<string>("render", _canvas, nodes, edges, $"database-layout:v1:{Snapshot.SourceSnapshotId}:{Snapshot.SourceFingerprint}:{_database}:default", _reference);
        StateHasChanged();
    }
    private async Task Fit() { if (_module is not null) await _module.InvokeVoidAsync("fit", _canvas); }
    private async Task Focus() { if (_module is not null && _selected is not null) await _module.InvokeVoidAsync("focus", _canvas, _selected); }
    private async Task Reset() { if (_module is not null) await _module.InvokeVoidAsync("reset", _canvas); }
    private async Task Save() { if (_module is not null) _message = await _module.InvokeAsync<string>("save", _canvas); }
    private async Task ExportSvg() { if (_module is not null) await _module.InvokeVoidAsync("exportSvg", _canvas); }
    private async Task ExportJson() => await JS.InvokeVoidAsync("downloadJsonFile", "source-database-model.json", JsonSerializer.Serialize(Snapshot, new JsonSerializerOptions { WriteIndented = true }));
    private async Task ExportHtml()
    {
        string E(string? value) => WebUtility.HtmlEncode(value);
        var html = "<!doctype html><html lang=\"en\"><meta charset=\"utf-8\"><title>Source database architecture</title><h1>Source database architecture</h1><p>" + E(DatabaseArchitectureSnapshot.SourceLimitation) + "</p><p>Source: " + E(Snapshot.SourceFingerprint) + "</p>";
        html += "<p>Database candidates: " + Snapshot.Databases.Count + " · Tables/entities: " + AllTables.Count + " · Relationships: " + AllRelationships.Count + " · Status: " + E(Snapshot.Status.ToString()) + "</p>"; foreach (var table in AllTables) { html += "<h2>" + E(table.LogicalName) + "</h2><p>" + E(table.EvidenceState.ToString()) + " · " + E(table.Confidence) + "</p><ul>"; foreach (var column in table.Columns) html += "<li>" + E(column.Name) + " · " + E(column.StoreType ?? column.ClrType) + " · " + E(column.EvidenceState.ToString()) + "</li>"; html += "</ul>"; foreach (var r in table.Relationships) html += "<p>" + E(TableName(r.FromTable)) + " → " + E(TableName(r.ToTable)) + " · " + E(r.Cardinality) + " · " + E(r.EvidenceState.ToString()) + "</p>"; foreach (var e in table.Evidence.Concat(table.Columns.SelectMany(c => c.Evidence)).Concat(table.Relationships.SelectMany(r => r.Evidence)).Distinct()) html += "<p>" + E(e.Type + " · " + e.Path + ":" + e.Line + " · " + e.Explanation) + "</p>"; }
        foreach (var diagnostic in Snapshot.Diagnostics) html += "<p>" + E(diagnostic) + "</p>"; html += "</html>"; await JS.InvokeVoidAsync("downloadHtmlFile", "source-database-report.html", html);
    }
    public async ValueTask DisposeAsync() { if (_module is not null) { try { await _module.InvokeVoidAsync("dispose", _canvas); await _module.DisposeAsync(); } catch (JSDisconnectedException) { } } _reference?.Dispose(); }
}
