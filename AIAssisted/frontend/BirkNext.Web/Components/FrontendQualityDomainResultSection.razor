@using BirkNext.Web.Models

@* One review domain's RESULT, as a compact card. The summary is always visible — collapsing it would hide the result —
   while the source findings behind it open on request. Every domain used to expand its full finding list by default,
   which put thirty performance cards between the reader and everything below them.

   A domain with no evidence says so; it never reports zero findings, because nothing established that number. *@
<section class="fqr-section fqr-domain-result" aria-labelledby="@_headingId"
         data-testid="fqr-domain-result" data-category="@Result.Category" data-state="@Result.State"
         data-derived="@Result.Derived.ToString().ToLowerInvariant()">
    <div class="fqr-domain-result-head">
        <h2 id="@_headingId">@Result.Title</h2>
        @* "Derived" for a domain that draws conclusions from other domains' evidence rather than observing the target. *@
        <span class="fqr-pill fqr-pill-@(Result.Derived ? "muted" : FrontendQualityDomainResultStates.Tone(Result.State))"
              data-testid="fqr-domain-result-state">@Result.StateLabel</span>
        @* A requirement no engine can discharge, stated beside the result rather than folded into it. *@
        @if (Result.ManualAssessmentRequired)
        {
            <span class="fqr-pill fqr-pill-info" data-testid="fqr-domain-result-manual">Manual assessment required</span>
        }
        @* Counts only ever appear when a review actually ran for this domain — and say which kind they are. *@
        @if (Result.CountLabel is { Length: > 0 } counts)
        {
            <span class="fqr-domain-result-count" data-testid="fqr-domain-result-count">@counts</span>
        }
    </div>

    @if (Scope is { Length: > 0 } scope)
    {
        <p class="fqr-domain-result-scope" data-testid="fqr-domain-result-scope">@scope</p>
    }

    <p class="fqr-domain-result-summary" data-testid="fqr-domain-result-summary">@Result.Summary</p>

    @* Standards can hold source findings and no logical issue of its own: say where they went instead of leaving "0". *@
    @if (Result.ContributionNote is { Length: > 0 } contribution)
    {
        <p class="fqr-domain-result-contribution" data-testid="fqr-domain-result-contribution">@contribution</p>
    }

    @if (Result.Limitation is { Length: > 0 } limitation)
    {
        <p class="fqr-domain-result-limitation" data-testid="fqr-domain-result-limitation">@limitation</p>
    }

    @Notice

    @if (ChildContent is not null)
    {
        @if (DetailsText is { Length: > 0 } detailsText)
        {
            <ReviewDisclosure Text="@detailsText" CollapseText="@($"Hide {detailsText[(detailsText.IndexOf(' ') + 1)..]}")"
                              TestId="@($"fqr-domain-details-{Result.Category}")" Class="disclosure-inline">
                @ChildContent
            </ReviewDisclosure>
        }
        else
        {
            @ChildContent
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public FrontendQualityDomainResult Result { get; set; } = default!;
    /// <summary>Short scope fact, such as the accessibility profile this result was produced under.</summary>
    [Parameter] public string? Scope { get; set; }
    /// <summary>Rendered above the detail, for statements about the result itself (such as a changed profile).</summary>
    [Parameter] public RenderFragment? Notice { get; set; }
    /// <summary>Disclosure label, e.g. "View 30 source findings". Omit to render the detail inline.</summary>
    [Parameter] public string? DetailsText { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string _headingId = "";

    protected override void OnParametersSet() => _headingId = $"fqr-domain-{Result.Category}-heading";
}
