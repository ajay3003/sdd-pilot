@using BirkNext.DeliveryReporting
@using BirkNext.Web.Services
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using W = BirkNext.Web.Services.DeliveryWorkItems
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IServiceProvider Services

@* Work-item workspace (Azure DevOps-inspired, BirkNext-styled): a master/detail split over ONE canonical model built from the frozen report —
   Module → Feature → User Story → explicitly linked Tasks, with Phase as an independent dimension. Hierarchy, List, Board and Phases are views of
   the same items; the selection stays in the detail panel while navigating and is deep-linkable (?item=). Nothing is inferred: no task is linked to
   a story without an explicit [USn], unresolved references stay visible, and features without tasks.md say so instead of showing 0/0. *@
<section class="dws" aria-label="Work items" data-testid="dlr-workspace" data-mode="@Options.Mode">
    <div class="dws-toolbar" data-testid="dws-toolbar">
        <div class="dws-views" role="radiogroup" aria-label="View" data-testid="dws-views">
            @foreach (var (key, label) in Options.Views)
            {
                <label class="dws-view @(_view == key ? "is-active" : "")"><input type="radio" name="dws-view" value="@key" checked="@(_view == key)" @onchange="() => Change(() => _view = key)" data-testid="dws-view-@key" /> @label</label>
            }
        </div>
        <label class="dws-search"><span class="visually-hidden">Search by ID or title</span>
            <input type="search" placeholder="Search by ID or title" value="@_search" @oninput="e => Change(() => _search = e.Value?.ToString() ?? string.Empty)" data-testid="dws-search" /></label>
        <label><span class="visually-hidden">Module</span>
            <select value="@_module" @onchange="e => Change(() => _module = e.Value?.ToString() ?? string.Empty)" data-testid="dws-module-filter">
                <option value="">All modules</option>
                @foreach (var m in Modules) { <option value="@m">@m</option> }
            </select></label>
        <label><span class="visually-hidden">Type</span>
            <select value="@_type" @onchange="e => Change(() => _type = e.Value?.ToString() ?? string.Empty)" data-testid="dws-type">
                <option value="">All types</option><option value="Feature">Features</option><option value="Story">User stories / scenarios</option><option value="Group">Groups</option><option value="Task">Tasks</option>
            </select></label>
        @if (Options.ShowChanges)
        {
            <label><span class="visually-hidden">Change</span>
                <select value="@_change" @onchange="e => Change(() => _change = e.Value?.ToString() ?? string.Empty)" data-testid="dws-change">
                    <option value="">Any change</option><option value="changed">Changed this period</option><option value="unchanged">Unchanged</option>
                </select></label>
        }
        <label class="dws-check"><input type="checkbox" checked="@_attentionOnly" @onchange="e => Change(() => _attentionOnly = e.Value is true)" data-testid="dws-attention" /> Needs review</label>
    </div>
    @foreach (var note in _dropped) { <p class="dws-status dws-notice" role="status" data-testid="dws-dropped-filter">@note</p> }

    <p class="dws-status" role="status" data-testid="dws-count">
        <span>@_items.Count(Matches) of @_items.Count work items@(Options.ShowChanges ? " (baseline and current)" : " in the current snapshot")</span>
        @if (Filtering)
        {
            @foreach (var (label, clear) in Chips())
            {
                <button type="button" class="dws-filter-chip" @onclick="clear" aria-label="@($"Remove filter {label}")" data-testid="dws-chip">@label <span aria-hidden="true">×</span></button>
            }
            <button type="button" class="btn-link" @onclick="ClearFilters" data-testid="dws-clear">Clear all</button>
        }
    </p>

    <details class="dws-legend" data-testid="dws-legend">
        <summary>Work item types &amp; relationships</summary>
        <dl class="dws-legend-list">
            @foreach (var (name, meaning) in W.Legend) { <div><dt><span class="dws-badge">@name</span></dt><dd>@meaning</dd></div> }
        </dl>
    </details>

    <div class="dws-split @(_view is "list" or "features" ? "is-wide" : "")">
        <div class="dws-master" data-testid="dws-master" data-view="@_view" @ref="_master">
            @switch (_view)
            {
                case "features": @FeaturesView() break;
                case "list": @ListView() break;
                case "board": @BoardView() break;
                case "phases": @PhasesView() break;
                default: @HierarchyView() break;
            }
        </div>
        <div class="dws-detail" aria-live="polite" data-testid="dws-detail">
            @if (Selected is { } item) { @Detail(item) }
            else { <p class="dws-empty" data-testid="dws-detail-empty">Select a feature, user story or task to see its details, relationships and source evidence.</p> }
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public WeeklyDeliveryReport Report { get; set; } = default!;
    /// <summary>Deep-linked selection (?item=).</summary>
    [Parameter] public string? SelectedId { get; set; }
    [Parameter] public EventCallback<string?> OnSelect { get; set; }
    /// <summary>Current state (Delivery Overview) or comparison (Delivery Reports → Stories); comparison is the default for existing callers.</summary>
    [Parameter] public DeliveryExplorerOptions Options { get; set; } = DeliveryExplorerOptions.Comparison;
    /// <summary>The delivery project: enables the link to the same canonical item on the other Delivery page.</summary>
    [Parameter] public Guid? ProjectId { get; set; }

    /// <summary>Open the feature in the feature drill-down (Delivery Overview's ?feature=); the feature detail offers it when set.</summary>
    [Parameter] public EventCallback<string> OnOpenFeature { get; set; }

    /// <summary>Fixed row height of the List and Features tables (CSS .dws-row-fixed): the virtualized list and keyboard scrolling rely on it.</summary>
    private const float RowHeight = 40;
    private string _view = "hierarchy", _search = "", _module = "", _type = "", _change = "", _sort = "id";
    private bool _attentionOnly, _sortDesc;
    private string? _selected, _active, _lastSelectedParam, _stateKey;
    private IReadOnlyList<string> _dropped = [];
    private readonly HashSet<string> _expanded = new(StringComparer.Ordinal);
    private IReadOnlyList<DeliveryWorkItem> _items = [];
    private List<DeliveryWorkItem> _keyRows = [];
    private WeeklyDeliveryReport? _built;
    private DeliveryExplorerOptions? _builtFor;
    private ElementReference _master;
    private bool _restoreScroll, _scrollActive, _listening;
    private string _path = "";
    private ExplorerViewStateStore? Store => Services.GetService(typeof(ExplorerViewStateStore)) as ExplorerViewStateStore;
    /// <summary>State is remembered per mode, project and report: another report's filters never apply to this one.</summary>
    private string StateKey => $"dws|{Options.Mode}|{ProjectId}|{Report.ReportId}";

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_built, Report) || _builtFor != Options) { _items = [.. W.Build(Report).Where(Options.Includes)]; (_built, _builtFor) = (Report, Options); }
        if (_stateKey != StateKey)
        {
            _stateKey = StateKey;
            RestoreState();
        }
        if (SelectedId != _lastSelectedParam)
        {
            _lastSelectedParam = SelectedId;
            if (SelectedId is not null && _items.Any(i => i.Id == SelectedId)) { _selected = _active = SelectedId; ExpandTo(SelectedId); _scrollActive = true; }
            else if (SelectedId is null) _selected = null;
        }
        if (!_listening) { Nav.LocationChanged += OnLocationChanged; _listening = true; }
    }

    /// <summary>
    /// The explorer's state comes from the URL (wi-* keys). Without any in the URL (a plain link, another tab of the page) the state this explorer
    /// last had in this session for the same project, report and mode is restored — and written back to the URL, so the address shows what is
    /// applied. What does not fit this report is dropped with a note.
    /// </summary>
    private void RestoreState()
    {
        _path = new Uri(Nav.Uri).AbsolutePath;
        var query = DeliveryExplorerState.Parse(Nav.Uri);
        var saved = DeliveryExplorerState.HasAny(query) || SelectedId is not null ? null : Store?.Get(StateKey);
        Apply(DeliveryExplorerState.FromQuery(saved ?? query));
        if (saved is not null)
        {
            var restore = new Dictionary<string, object?>(DeliveryExplorerState.ToQuery(Current(), Options.DefaultView));
            if (saved.GetValueOrDefault("item") is { } item && _items.Any(i => i.Id == item)) restore["item"] = item;
            Nav.NavigateTo(Nav.GetUriWithQueryParameters(restore), replace: true);
            _restoreScroll = true;
        }
        // A deep link to a work item below feature level opens where it can be seen (the Features view lists features only).
        if (_view == "features" && !query.ContainsKey("wi-view") && SelectedId is { } selected && !selected.StartsWith("f:", StringComparison.Ordinal)) { _view = "hierarchy"; Commit(); }
    }

    private DeliveryExplorerFilter Current() => new(_view, _search, _module, _type, _change, _attentionOnly, _sort, _sortDesc);

    private void Apply(DeliveryExplorerFilter requested)
    {
        var (f, dropped) = DeliveryExplorerState.Validate(requested, Options, Modules.ToList());
        (_view, _search, _module, _type, _change, _attentionOnly, _sort, _sortDesc) = (f.View, f.Search, f.Module, f.Type, f.Change, f.Review, f.Sort, f.Descending);
        _dropped = dropped;
    }

    /// <summary>Every filter, view and sort change: applied, written to the URL (replacing the entry — Back returns to the previous selection, not to
    /// every keystroke) and remembered for this session.</summary>
    private void Change(Action change)
    {
        change();
        _dropped = [];
        Commit();
    }

    private void Commit()
    {
        var query = DeliveryExplorerState.ToQuery(Current(), Options.DefaultView);
        var target = Nav.GetUriWithQueryParameters(query);
        if (target != Nav.Uri) Nav.NavigateTo(target, replace: true);
        Remember();
    }

    private void Remember() => Store?.Set(StateKey, new Dictionary<string, object?>(DeliveryExplorerState.ToQuery(Current(), Options.DefaultView)) { ["item"] = _selected });

    /// <summary>Back / Forward: the URL is the state — re-read it when it changes from outside.</summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Another page: this explorer is about to go away and keeps its remembered state.
        if (!Uri.TryCreate(e.Location, UriKind.Absolute, out var location) || location.AbsolutePath != _path) return;
        var query = DeliveryExplorerState.Parse(e.Location);
        var wanted = DeliveryExplorerState.Validate(DeliveryExplorerState.FromQuery(query), Options, Modules.ToList()).Filter;
        if (wanted == Current()) return;
        _ = InvokeAsync(() => { Apply(wanted); StateHasChanged(); });
    }

    public void Dispose() { if (_listening) Nav.LocationChanged -= OnLocationChanged; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender) await JS.InvokeVoidAsync("birknextExplorer.stickyOffset");
            await JS.InvokeVoidAsync("birknextExplorer.track", _master, $"{StateKey}|{_view}");
            if (firstRender || _restoreScroll)
            {
                _restoreScroll = false;
                // A remembered scroll position wins over bringing the (restored) selection into view: the person returns to where they were.
                if (await JS.InvokeAsync<bool>("birknextExplorer.restore", _master, $"{StateKey}|{_view}")) _scrollActive = false;
                else if (_selected is not null) await JS.InvokeVoidAsync("birknextExplorer.selectedIntoView", _master, "[aria-current=true], tr.is-selected");
            }
            if (_scrollActive)
            {
                _scrollActive = false;
                var index = _keyRows.FindIndex(i => i.Id == _active);
                if (index >= 0) await JS.InvokeVoidAsync("birknextExplorer.rowIntoView", _master, index, RowHeight);
            }
        }
        // Scroll memory is a convenience: without the script (prerendering, tests) the explorer works the same.
        catch (Exception) { /* any interop failure (no script, prerendering, tests) leaves the explorer working */ }
    }

    private DeliveryWorkItem? Selected => _items.FirstOrDefault(i => i.Id == _selected);
    private IEnumerable<string> Modules => _items.Where(i => i.Type == DeliveryWorkItemType.Feature).Select(i => i.Module).Distinct().Order(StringComparer.Ordinal);

    private bool Matches(DeliveryWorkItem i) =>
        (_module.Length == 0 || i.Module == _module)
        && (_type.Length == 0 || i.Type.ToString() == _type)
        && (_change.Length == 0 || (_change == "changed") == IsChanged(i))
        && (!_attentionOnly || Options.Attention(i))
        && (_search.Trim().Length == 0 || i.SourceId.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase) || i.Title.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase));

    private static bool IsChanged(DeliveryWorkItem i) => i.Type switch
    {
        DeliveryWorkItemType.Feature => i.Feature.Changed,
        DeliveryWorkItemType.Story => i.Story!.Change != DeliveryItemChange.Unchanged,
        DeliveryWorkItemType.Group => false,
        _ => i.Task!.Change != DeliveryTaskChange.Unchanged,
    };

    private bool Filtering => _search.Trim().Length > 0 || _module.Length > 0 || _type.Length > 0 || _change.Length > 0 || _attentionOnly;

    /// <summary>Active filters as removable chips (labels, never ids).</summary>
    private IEnumerable<(string Label, Action Clear)> Chips()
    {
        if (_search.Trim().Length > 0) yield return ($"Search: {_search.Trim()}", () => _search = "");
        if (_module.Length > 0) yield return ($"Module: {_module}", () => _module = "");
        if (_type.Length > 0) yield return ($"Type: {_type}", () => _type = "");
        if (_change.Length > 0) yield return (_change == "changed" ? "Changed this period" : "Unchanged", () => _change = "");
        if (_attentionOnly) yield return ("Needs review", () => _attentionOnly = false);
    }

    private void ClearFilters() => Change(() => (_search, _module, _type, _change, _attentionOnly) = ("", "", "", "", false));

    private async Task Select(string id)
    {
        _selected = _active = id;
        ExpandTo(id);
        Remember();
        await OnSelect.InvokeAsync(id);
    }

    /// <summary>
    /// Keyboard in the List and Features grids: Up/Down move the active row, Home/End and PageUp/PageDown jump; Enter or Space select it (opens its
    /// details). The active row is kept in view even when the virtualized list has not rendered it yet.
    /// </summary>
    private async Task OnGridKey(KeyboardEventArgs e)
    {
        if (_keyRows.Count == 0) return;
        var index = _keyRows.FindIndex(i => i.Id == (_active ?? _selected));
        var next = e.Key switch
        {
            "ArrowDown" => Math.Min(_keyRows.Count - 1, index + 1),
            "ArrowUp" => Math.Max(0, index < 0 ? 0 : index - 1),
            "Home" => 0,
            "End" => _keyRows.Count - 1,
            "PageDown" => Math.Min(_keyRows.Count - 1, Math.Max(0, index) + 10),
            "PageUp" => Math.Max(0, index - 10),
            _ => -1,
        };
        if (next >= 0) { _active = _keyRows[next].Id; _scrollActive = true; return; }
        if (e.Key is "Enter" or " " && index >= 0) await Select(_keyRows[index].Id);
    }

    private async Task OnGridFocus()
    {
        if (_active is null && _keyRows.Count > 0) _active = _selected is not null && _keyRows.Any(i => i.Id == _selected) ? _selected : _keyRows[0].Id;
        try { await JS.InvokeVoidAsync("birknextExplorer.gridKeys", _master); }
        catch (Exception) { }
    }

    private static string RowDomId(string id) => "dws-row-" + string.Concat(id.Select(c => char.IsLetterOrDigit(c) || c is '-' or '_' ? c : '_'));

    private void ExpandTo(string id)
    {
        var item = _items.FirstOrDefault(i => i.Id == id);
        while (item is not null)
        {
            _expanded.Add(item.Id);
            if (item.Type == DeliveryWorkItemType.Feature) _expanded.Add($"m:{item.Module}");
            item = item.ParentId is { } p ? _items.FirstOrDefault(i => i.Id == p) : null;
        }
    }

    private void Toggle(string id) { if (!_expanded.Add(id)) _expanded.Remove(id); }
    private bool Open(string id) => Filtering || _expanded.Contains(id);

    private static string Icon(DeliveryWorkItemType type) => type switch { DeliveryWorkItemType.Feature => "◆", DeliveryWorkItemType.Story => "▣", DeliveryWorkItemType.Group => "▤", _ => "☐" };
    private static string TypeLabel(DeliveryWorkItemType type) => type switch { DeliveryWorkItemType.Feature => "Feature", DeliveryWorkItemType.Story => "User story", DeliveryWorkItemType.Group => "Group", _ => "Task" };
    private static string TypeLabel(DeliveryWorkItem i) => i.Type switch
    {
        DeliveryWorkItemType.Story when i.Story?.Kind == "Scenario" => "Scenario",
        DeliveryWorkItemType.Group => W.RelationshipLabel(i.Group!.Kind),
        _ => TypeLabel(i.Type),
    };

    /// <summary>A relationship badge with its explanation and provenance as the tooltip and accessible description — never an unexplained abbreviation.</summary>
    private RenderFragment Badge(DeliveryWorkItem i) => __builder =>
    {
        if (i.Group is { } g)
        {
            var tip = $"{g.Explanation} Source: {g.Provenance}. Mapping: {W.ConfidenceLabel(g.Confidence)}.";
            <span class="dws-badge dws-badge-@(g.NeedsReview ? "review" : g.Kind == DeliveryTaskRelationship.SharedFoundational ? "shared" : "derived")" title="@tip" data-testid="dws-badge" data-kind="@g.Kind">@W.RelationshipLabel(g.Kind)<span class="visually-hidden"> — @tip</span></span>
        }
        else if (i.Story is { Removed: true }) { <span class="dws-badge dws-badge-review" title="The specification marks this story removed." data-testid="dws-badge" data-kind="RemovedStory">Removed story</span> }
        else if (i.Story?.Kind == "Scenario") { <span class="dws-badge dws-badge-derived" title="The specification is written as scenarios instead of user stories." data-testid="dws-badge" data-kind="Scenario">Scenario</span> }
    };

    private RenderFragment Row(DeliveryWorkItem i, int level, bool expandable, string? expandId = null) => __builder =>
    {
        var key = expandId ?? i.Id;
        <li class="dws-row dws-level-@level @(_selected == i.Id ? "is-selected" : "") @(i.Feature.RemovedFeature ? "is-removed" : "")" data-testid="dws-row" data-id="@i.Id" data-type="@i.Type">
            @if (expandable) { <button type="button" class="dws-toggle" aria-expanded="@(Open(key) ? "true" : "false")" @onclick="() => Toggle(key)" data-testid="dws-toggle"><span aria-hidden="true">@(Open(key) ? "▾" : "▸")</span><span class="visually-hidden">Expand @i.SourceId</span></button> }
            else { <span class="dws-toggle-spacer" aria-hidden="true"></span> }
            <button type="button" class="dws-item" aria-current="@(_selected == i.Id ? "true" : null)" @onclick="() => Select(i.Id)" data-testid="dws-item">
                <span class="dws-icon dws-icon-@i.Type.ToString().ToLowerInvariant()" aria-hidden="true">@Icon(i.Type)</span>
                <span class="dws-id">@i.SourceId</span> <span class="dws-title">@i.Title</span>
            </button>
            @Badge(i)
            <span class="dws-meta">@i.Progress</span>
            @if (Options.ShowChanges && IsChanged(i)) { <span class="dws-chip dws-chip-change" data-testid="dws-change-chip">@i.Change</span> }
            @if (Options.Attention(i)) { <span class="dws-chip dws-chip-attention" title="Needs review" data-testid="dws-review-chip">Review</span> }
        </li>
    };

    // ── Hierarchy: Module → Feature → User Story → explicitly linked Tasks; unassigned tasks stay under their feature ─────────────────
    private RenderFragment HierarchyView() => __builder =>
    {
        var features = _items.Where(i => i.Type == DeliveryWorkItemType.Feature).ToList();
        var visible = _items.Where(Matches).ToList();
        var shownFeatures = features.Where(f => !Filtering || visible.Any(v => v.FeatureKey == f.FeatureKey)).ToList();
        if (shownFeatures.Count == 0) { <p class="dws-empty" data-testid="dws-none">No work items match these filters.</p> return; }
        <ul class="dws-tree" role="tree" data-testid="dws-tree">
            @foreach (var module in shownFeatures.GroupBy(f => f.Module))
            {
                var mid = $"m:{module.Key}";
                <li class="dws-module" data-testid="dws-module" data-module="@module.Key">
                    <button type="button" class="dws-toggle" aria-expanded="@(Open(mid) ? "true" : "false")" @onclick="() => Toggle(mid)" data-testid="dws-module-toggle"><span aria-hidden="true">@(Open(mid) ? "▾" : "▸")</span> <strong>@module.Key</strong> <span class="dws-meta">@module.Count() feature@(module.Count() == 1 ? "" : "s")</span></button>
                    @if (Open(mid))
                    {
                        <ul>
                            @foreach (var f in module)
                            {
                                var stories = _items.Where(i => i.Type == DeliveryWorkItemType.Story && i.FeatureKey == f.FeatureKey && (!Filtering || visible.Contains(i) || visible.Any(v => v.ParentId == i.Id))).ToList();
                                var groups = _items.Where(i => i.Type == DeliveryWorkItemType.Group && i.FeatureKey == f.FeatureKey && (!Filtering || visible.Contains(i) || visible.Any(v => v.ParentId == i.Id))).ToList();
                                // Older reports (before v4) have no groups: their tasks without a story stay under the feature, as they were frozen.
                                var unassigned = f.Feature.Hierarchy?.Groups.Count > 0 ? [] : _items.Where(i => i.Type == DeliveryWorkItemType.Task && i.FeatureKey == f.FeatureKey && i.StoryKey is null && (!Filtering || visible.Contains(i))).ToList();
                                @Row(f, 1, stories.Count + groups.Count + unassigned.Count > 0)
                                @if (Open(f.Id))
                                {
                                    <ul>
                                        @foreach (var s in stories)
                                        {
                                            var tasks = _items.Where(i => i.Type == DeliveryWorkItemType.Task && i.ParentId == s.Id && (!Filtering || visible.Contains(i))).ToList();
                                            @Row(s, 2, tasks.Count > 0)
                                            @if (Open(s.Id)) { <ul>@foreach (var t in tasks) { @Row(t, 3, false) }</ul> }
                                        }
                                        @foreach (var g in groups)
                                        {
                                            var tasks = _items.Where(i => i.Type == DeliveryWorkItemType.Task && i.ParentId == g.Id && (!Filtering || visible.Contains(i))).ToList();
                                            @Row(g, 2, tasks.Count > 0)
                                            @if (Open(g.Id)) { <ul>@foreach (var t in tasks) { @Row(t, 3, false) }</ul> }
                                        }
                                        @if (unassigned.Count > 0)
                                        {
                                            var uid = $"u:{f.FeatureKey}";
                                            <li class="dws-row dws-level-2 dws-unassigned" data-testid="dws-unassigned" data-feature="@f.FeatureKey">
                                                <button type="button" class="dws-toggle" aria-expanded="@(Open(uid) ? "true" : "false")" @onclick="() => Toggle(uid)"><span aria-hidden="true">@(Open(uid) ? "▾" : "▸")</span></button>
                                                <span class="dws-title">Tasks without a user story (@unassigned.Count)</span>
                                            </li>
                                            @if (Open(uid)) { <ul>@foreach (var t in unassigned) { @Row(t, 3, false) }</ul> }
                                        }
                                    </ul>
                                }
                            }
                        </ul>
                    }
                </li>
            }
        </ul>
    };

    // ── List: one sortable table over every matching item ───────────────────────────────────────────────────────────────────────
    private void SortBy(string column) => Change(() => { if (_sort == column) _sortDesc = !_sortDesc; else { _sort = column; _sortDesc = false; } });

    private IEnumerable<(string Key, string Label)> ListColumns => new[] { ("id", "ID"), ("type", "Type"), ("title", "Title"), ("parent", "Parent"), ("module", "Module"), ("phase", "Phase"), ("progress", "Progress") }
        .Concat(Options.ShowChanges ? [("change", "Period change")] : []).Append(("attention", "Review"));

    private string PhaseTitle(DeliveryWorkItem i) => i.PhaseKey is { } pk && i.Feature.Hierarchy?.Phases.FirstOrDefault(p => p.Key == pk) is { } ph ? ph.Title : "—";

    /// <summary>Stable sort: the chosen column (ascending or descending), then the canonical order (feature, type, id), then the id — equal keys
    /// never swap places between renders.</summary>
    private List<DeliveryWorkItem> Sorted(IEnumerable<DeliveryWorkItem> rows)
    {
        Func<DeliveryWorkItem, string> key = _sort switch
        {
            "type" => i => ((int)i.Type).ToString("D2"),
            "title" => i => i.Title,
            "phase" => PhaseTitle,
            "change" => i => i.Change,
            "module" => i => i.Module,
            "parent" => i => i.ParentId ?? "",
            "progress" => i => i.Progress,
            "attention" => i => Options.Attention(i) ? "0" : "1",
            _ => i => "",
        };
        var ordered = _sortDesc ? rows.OrderByDescending(key, StringComparer.OrdinalIgnoreCase) : rows.OrderBy(key, StringComparer.OrdinalIgnoreCase);
        var canonical = _sort == "id" && _sortDesc
            ? ordered.ThenByDescending(i => i.FeatureKey, StringComparer.Ordinal).ThenByDescending(i => i.Type).ThenByDescending(i => i.SourceId, StringComparer.Ordinal)
            : ordered.ThenBy(i => i.FeatureKey, StringComparer.Ordinal).ThenBy(i => i.Type).ThenBy(i => i.SourceId, StringComparer.Ordinal);
        return [.. canonical.ThenBy(i => i.Id, StringComparer.Ordinal)];
    }

    /// <summary>The List: every matching item, virtualized (only the rows in view are rendered), fixed row height, full titles in the details panel.</summary>
    private RenderFragment ListView() => __builder =>
    {
        var list = Sorted(_items.Where(Matches));
        _keyRows = list;
        if (list.Count == 0) { <p class="dws-empty" data-testid="dws-none">No work items match these filters.</p> return; }
        var activeIndex = list.FindIndex(i => i.Id == _active);
        <p class="visually-hidden" data-testid="dws-list-keys">Use the arrow keys to move through the work items and Enter to open one.</p>
        <div class="dws-tablewrap"><table class="dlr-table dws-table dws-row-fixed" data-testid="dws-list" role="grid" aria-rowcount="@(list.Count + 1)" tabindex="0"
                aria-label="Work items" aria-activedescendant="@(activeIndex >= 0 ? RowDomId(list[activeIndex].Id) : null)" @onkeydown="OnGridKey" @onfocus="OnGridFocus">
            <colgroup><col class="dws-c-id" /><col class="dws-c-type" /><col class="dws-c-title" /><col class="dws-c-parent" /><col class="dws-c-module" /><col class="dws-c-phase" /><col class="dws-c-progress" />@if (Options.ShowChanges) { <col class="dws-c-change" /> }<col class="dws-c-review" /></colgroup>
            <thead><tr>
                @foreach (var (key, label) in ListColumns)
                {
                    <th scope="col" aria-sort="@(_sort == key ? (_sortDesc ? "descending" : "ascending") : "none")"><button type="button" class="btn-link" @onclick="() => SortBy(key)" data-testid="dws-sort-@key">@label</button></th>
                }
            </tr></thead>
            <tbody>
                <Virtualize Items="list" ItemSize="RowHeight" OverscanCount="15" SpacerElement="tr" Context="i">
                    @{ var parent = i.ParentId is { } pid ? _items.FirstOrDefault(x => x.Id == pid) : null; }
                    <tr class="@(_selected == i.Id ? "is-selected" : "") @(_active == i.Id ? "is-active" : "")" id="@RowDomId(i.Id)" data-testid="dws-list-row" data-id="@i.Id"
                        aria-selected="@(_selected == i.Id ? "true" : "false")" @onclick="() => Select(i.Id)">
                        <td><button type="button" class="btn-link" tabindex="-1" @onclick="() => Select(i.Id)" @onclick:stopPropagation="true">@(i.SourceId.Length > 0 ? i.SourceId : TypeLabel(i))</button></td>
                        <td>@TypeLabel(i)</td>
                        <td class="dws-cell-title" title="@i.Title"><button type="button" class="dws-title-button" tabindex="-1" @onclick="() => Select(i.Id)" @onclick:stopPropagation="true" data-testid="dws-list-title">@i.Title</button></td>
                        <td class="dws-cell-title" title="@(parent?.Title)">@(parent is null ? "—" : parent.SourceId.Length > 0 ? parent.SourceId : parent.Title)</td>
                        <td class="dws-cell-title">@i.Module</td><td class="dws-cell-title" title="@PhaseTitle(i)">@PhaseTitle(i)</td><td class="dws-cell-title">@i.Progress</td>
                        @if (Options.ShowChanges) { <td class="dws-cell-title">@i.Change</td> }
                        <td>@(Options.Attention(i) ? "Needs review" : "—")</td>
                    </tr>
                </Virtualize>
            </tbody>
        </table></div>
        <p class="dws-meta" data-testid="dws-list-total">@list.Count work item@(list.Count == 1 ? "" : "s") · rendered as you scroll</p>
    };

    /// <summary>
    /// Features (Delivery Overview): the backlog of the current snapshot — one row per feature with its backlog status, task checklist, requirement
    /// model and attention, in priority order (blocked, needs review, new, changed, in progress, the rest). Same selection and details as every view.
    /// </summary>
    private RenderFragment FeaturesView() => __builder =>
    {
        var backlog = Options.Backlog ?? new Dictionary<string, DeliveryFeatureGridRow>();
        var features = _items.Where(i => i.Type == DeliveryWorkItemType.Feature && (Matches(i) || Filtering && _items.Any(x => x.FeatureKey == i.FeatureKey && Matches(x))))
            .OrderBy(i => backlog.TryGetValue(i.FeatureKey, out var b) ? b.Priority : 9).ThenBy(i => i.Module, StringComparer.OrdinalIgnoreCase)
            .ThenBy(i => i.Title, StringComparer.OrdinalIgnoreCase).ThenBy(i => i.Id, StringComparer.Ordinal).ToList();
        _keyRows = features;
        if (features.Count == 0) { <p class="dws-empty" data-testid="dws-none">No feature matches these filters.</p> return; }
        var activeIndex = features.FindIndex(i => i.Id == _active);
        <div class="dws-tablewrap"><table class="dlr-table dws-table dws-features dws-row-fixed" data-testid="dws-features" role="grid" tabindex="0" aria-label="Features"
                aria-activedescendant="@(activeIndex >= 0 ? RowDomId(features[activeIndex].Id) : null)" @onkeydown="OnGridKey" @onfocus="OnGridFocus">
            <colgroup><col class="dws-c-feature" /><col class="dws-c-module" /><col class="dws-c-status" /><col class="dws-c-checklist" /><col class="dws-c-model" /><col class="dws-c-review" /></colgroup>
            <thead><tr><th scope="col">Feature</th><th scope="col">Module</th><th scope="col">Backlog status</th><th scope="col" title="Task checklist only">Checklist</th><th scope="col">Requirement model</th><th scope="col">Attention</th></tr></thead>
            <tbody>
                @foreach (var f in features)
                {
                    backlog.TryGetValue(f.FeatureKey, out var b);
                    <tr class="@(_selected == f.Id ? "is-selected" : "") @(_active == f.Id ? "is-active" : "")" id="@RowDomId(f.Id)" data-testid="dws-feature-row" data-id="@f.Id"
                        data-status="@(b?.Item.Status.ToString() ?? "")" aria-selected="@(_selected == f.Id ? "true" : "false")" @onclick="() => Select(f.Id)">
                        <td class="dws-cell-title" title="@f.Title"><button type="button" class="dws-title-button" tabindex="-1" @onclick="() => Select(f.Id)" @onclick:stopPropagation="true" data-testid="dws-feature-open"><strong>@f.Title</strong> <span class="dws-meta">@f.SourceId</span></button>
                            @if (Options.Why?.GetValueOrDefault(f.FeatureKey) is { Length: > 0 } why) { <span class="dws-meta dws-feature-why" data-testid="dws-feature-why" title="@why">Why included: @why</span> }</td>
                        <td class="dws-cell-title">@(f.Module.Length == 0 ? "Project" : f.Module)</td>
                        <td class="dws-cell-title" data-testid="dws-feature-status" title="@b?.Item.StatusDetail">@(b is null ? "—" : DeliveryBacklog.Label(b.Item.Status))</td>
                        <td class="dws-cell-title" data-testid="dws-feature-checklist" title="Task checklist only — not verified implementation">@(b is null ? f.Progress : b.Item.TasksTotal == 0 ? "No tasks" : $"{b.Item.TasksCompleted}/{b.Item.TasksTotal} · {100 * b.Item.TasksCompleted / b.Item.TasksTotal}%")</td>
                        <td class="dws-cell-title" title="@b?.RequirementModel">@(b?.RequirementModel ?? "—")</td>
                        <td class="dws-cell-title" data-testid="dws-feature-attention">@(b is { Item.Attention: > 0 } a ? $"{a.Item.Attention} issue{(a.Item.Attention == 1 ? "" : "s")}" : "—")</td>
                    </tr>
                }
            </tbody>
        </table></div>
        <p class="dws-meta" data-testid="dws-features-note">Backlog status comes from task checkboxes and explicit status lines only — checklist progress is not verified implementation or QA completion.</p>
    };

    // ── Board: evidence-based change groups, features only ─────────────────────────────────────────────────────────────────────
    private RenderFragment BoardView() => __builder =>
    {
        var features = _items.Where(i => i.Type == DeliveryWorkItemType.Feature && Matches(i)).ToList();
        <p class="dws-meta" data-testid="dws-board-note">Change categories derived from the two snapshots — not workflow statuses. Nothing here means Development, Test or Done.</p>
        <div class="dws-board" data-testid="dws-board">
            @foreach (var column in Enum.GetValues<DeliveryBoardColumn>())
            {
                var cards = features.Where(f => W.Column(f.Feature) == column).ToList();
                <section class="dws-column" data-testid="dws-column" data-column="@column" aria-label="@W.ColumnLabel(column)">
                    <h3 class="dws-column-title">@W.ColumnLabel(column) <span class="dws-count">@cards.Count</span></h3>
                    @foreach (var f in cards)
                    {
                        <button type="button" class="dws-card @(_selected == f.Id ? "is-selected" : "")" @onclick="() => Select(f.Id)" data-testid="dws-card" data-id="@f.Id">
                            <span class="dws-id">@f.SourceId</span><span class="dws-title">@f.Title</span><span class="dws-meta">@f.Module · @f.Progress</span>
                        </button>
                    }
                </section>
            }
        </div>
    };

    // ── Phases: source-defined phases per feature; tasks without a phase stay visible ───────────────────────────────────────────
    private RenderFragment PhasesView() => __builder =>
    {
        var features = _items.Where(i => i.Type == DeliveryWorkItemType.Feature && (_module.Length == 0 || i.Module == _module)
            && (_search.Trim().Length == 0 || _items.Any(x => x.FeatureKey == i.FeatureKey && Matches(x)))).ToList();
        if (features.Count == 0) { <p class="dws-empty" data-testid="dws-none">No work items match these filters.</p> return; }
        <div data-testid="dws-phases">
            @foreach (var f in features)
            {
                var h = f.Feature.Hierarchy;
                <section class="dws-phase-feature" data-testid="dws-phase-feature" data-feature="@f.FeatureKey">
                    <h3 class="dws-column-title"><button type="button" class="btn-link" @onclick="() => Select(f.Id)">@f.SourceId</button> @f.Title</h3>
                    @if (h is null || !h.HasTaskList) { <p class="dws-meta" data-testid="dws-phase-none">No task list found — no phases.</p> }
                    else if (h.Phases.Count == 0) { <p class="dws-meta" data-testid="dws-phase-none">No "Phase N" headings in tasks.md — phases are never synthesized from task order.</p> }
                    else
                    {
                        <ol class="dws-phase-list">
                            @foreach (var p in h.Phases.OrderBy(p => p.Position))
                            {
                                var pid = $"p:{f.FeatureKey}|{p.Key}";
                                var tasks = _items.Where(i => i.Type == DeliveryWorkItemType.Task && i.FeatureKey == f.FeatureKey && i.PhaseKey == p.Key && Matches(i)).ToList();
                                <li data-testid="dws-phase" data-phase="@p.Key">
                                    <button type="button" class="dws-toggle" aria-expanded="@(Open(pid) ? "true" : "false")" @onclick="() => Toggle(pid)"><span aria-hidden="true">@(Open(pid) ? "▾" : "▸")</span></button>
                                    <strong>@p.Title</strong> <span class="dws-meta">@(p.TaskTotal == 0 ? "no tasks" : $"{p.TaskCompleted}/{p.TaskTotal} tasks checked")@(p.StoryKeys.Count > 0 ? $" · {string.Join(", ", p.StoryKeys)}" : "")</span>
                                    @if (Open(pid)) { <ul>@foreach (var t in tasks) { @Row(t, 3, false) }</ul> }
                                </li>
                            }
                        </ol>
                        var unphased = _items.Where(i => i.Type == DeliveryWorkItemType.Task && i.FeatureKey == f.FeatureKey && i.PhaseKey is null && Matches(i)).ToList();
                        @if (unphased.Count > 0) { <p class="dws-meta" data-testid="dws-unphased">@unphased.Count task@(unphased.Count == 1 ? "" : "s") without a phase (e.g. Polish, Notes) — kept with the feature.</p> }
                    }
                </section>
            }
        </div>
    };

    // ── Detail: persistent header, relationships, type-specific body, source evidence ─────────────────────────────────────────────
    private RenderFragment Detail(DeliveryWorkItem i) => __builder =>
    {
        var parent = i.ParentId is { } pid ? _items.FirstOrDefault(x => x.Id == pid) : null;
        var children = _items.Where(x => x.ParentId == i.Id).ToList();
        var h = i.Feature.Hierarchy;
        <article class="dws-detail-card" data-testid="dws-detail-card" data-type="@i.Type" data-id="@i.Id">
            <header class="dws-detail-head">
                <p class="dws-kicker" data-testid="dws-detail-type">@TypeLabel(i).ToUpperInvariant() · @i.SourceId</p>
                <h2 class="dws-detail-title" data-testid="dws-detail-title">@i.Title</h2>
                @if (ProjectId is { } project && (Options.ShowChanges || !W.IsRemoved(i)))
                {
                    <a class="dws-cross" href="@DeliveryExplorerOptions.CrossPageHref(Options.Mode, project, Report.ReportId, i.Id)" data-testid="dws-cross-page">@Options.CrossPageLabel</a>
                }
                @if (i.Type == DeliveryWorkItemType.Feature && OnOpenFeature.HasDelegate)
                {
                    <button type="button" class="btn-link dws-cross" data-testid="dws-open-feature" @onclick="() => OnOpenFeature.InvokeAsync(i.FeatureKey)">Open the feature explorer</button>
                }
                <dl class="dws-facts">
                    <div><dt>Module</dt><dd>@i.Module</dd></div>
                    @if (parent is not null) { <div><dt>Parent</dt><dd data-testid="dws-detail-parent"><button type="button" class="btn-link" @onclick="() => Select(parent.Id)">@parent.SourceId · @parent.Title</button></dd></div> }
                    @if (i.Story?.Priority is { } priority) { <div><dt>Priority</dt><dd data-testid="dws-detail-priority">@priority</dd></div> }
                    @if (i.Type == DeliveryWorkItemType.Feature) { <div><dt>Status</dt><dd data-testid="dws-detail-status">@W.StatusProvenance(i.Feature.RemovedFeature ? i.Feature.BaselineStatus : i.Feature.CurrentStatus)</dd></div> }
                    @if (i.Type == DeliveryWorkItemType.Feature && Options.Backlog?.GetValueOrDefault(i.FeatureKey) is { } backlog)
                    {
                        <div><dt>Backlog status</dt><dd data-testid="dws-detail-backlog">@DeliveryBacklog.Label(backlog.Item.Status) <span class="dws-meta">— @backlog.Item.StatusDetail</span></dd></div>
                        <div><dt>Requirement model</dt><dd data-testid="dws-detail-model">@backlog.RequirementModel</dd></div>
                    }
                    @if (i.Type == DeliveryWorkItemType.Feature && Options.Why?.GetValueOrDefault(i.FeatureKey) is { Length: > 0 } why) { <div><dt>Why included</dt><dd data-testid="dws-detail-why">@why</dd></div> }
                    @if (Options.ShowChanges) { <div><dt>Change</dt><dd data-testid="dws-detail-change">@i.Change</dd></div> }
                    @if (Options.Attention(i)) { <div><dt>Review</dt><dd data-testid="dws-detail-review">Needs review</dd></div> }
                    @if (PhaseTitle(i) is { } phase && phase != "—") { <div><dt>Phase</dt><dd>@phase</dd></div> }
                </dl>
            </header>
            <section class="dws-rel" aria-label="Relationships" data-testid="dws-relationships">
                <h3 class="dws-h">Parent · Children · Related</h3>
                <p><strong>Parent:</strong> @(parent is null ? (i.Type == DeliveryWorkItemType.Feature ? $"Module {i.Module}" : "—") : $"{parent.SourceId} · {parent.Title}")</p>
                <p data-testid="dws-children"><strong>Children:</strong> @(children.Count == 0 ? "none" : "")
                    @foreach (var c in children.Take(30)) { <button type="button" class="btn-link dws-rel-link" @onclick="() => Select(c.Id)">@c.SourceId</button> }
                    @if (children.Count > 30) { <span class="dws-meta">+@(children.Count - 30) more</span> }</p>
                @if (i.Task?.UnresolvedStoryReference is { } broken) { <p class="dlr-warning" data-testid="dws-broken-link"><strong>Parent story unresolved:</strong> the task references [@broken], which is not a user story in this specification.</p> }
            </section>
            @switch (i.Type)
            {
                case DeliveryWorkItemType.Feature: @FeatureBody(i, h) break;
                case DeliveryWorkItemType.Story: @StoryBody(i, h) break;
                case DeliveryWorkItemType.Group: @GroupBody(i) break;
                default: @TaskBody(i, h) break;
            }
        </article>
    };

    private RenderFragment FeatureBody(DeliveryWorkItem i, DeliveryFeatureHierarchy? h) => __builder =>
    {
        var f = i.Feature;
        var unassigned = h?.Tasks.Count(t => t.UserStoryKey is null && t.Change != DeliveryTaskChange.Removed) ?? 0;
        var grouped = h is { Groups.Count: > 0 };
        <dl class="dws-facts" data-testid="dws-feature-summary">
            <div><dt>Task progress</dt><dd data-testid="dws-feature-progress">@DeliveryReportStories.TaskProgress(f.RemovedFeature ? f.BaselineTaskCompleted : f.CurrentTaskCompleted, f.RemovedFeature ? f.BaselineTaskTotal : f.CurrentTaskTotal, h?.HasTaskList ?? f.Evidence.TasksPath is not null)</dd></div>
            @if (h is { Captured: true })
            {
                @if (h.RequirementModel is { } model) { <div><dt>Requirement model</dt><dd data-testid="dws-feature-model">@model</dd></div> }
                <div><dt>@(h.Stories.Any(s => s.Kind == "Scenario") ? "Scenarios" : "User stories")</dt><dd>@h.Stories.Count(s => !s.Removed)@(h.Stories.Any(s => s.Removed) ? $" (+{h.Stories.Count(s => s.Removed)} removed)" : "")</dd></div>
                <div><dt>Acceptance criteria</dt><dd>@(h.Stories.Sum(s => s.Criteria.Count) + h.FeatureCriteria.Count)</dd></div>
                <div><dt>Functional requirements</dt><dd>@h.FunctionalRequirements.Count</dd></div>
                <div><dt>Phases</dt><dd>@(h.Phases.Count == 0 ? "none in source" : string.Join(", ", h.Phases.Select(p => p.Title)))</dd></div>
                @if (grouped)
                {
                    <div><dt>Task groups</dt><dd data-testid="dws-feature-groups">@string.Join(" · ", h.Groups.GroupBy(g => g.Kind).Select(k => $"{W.RelationshipLabel(k.Key)} {k.Sum(g => g.TaskTotal)}"))</dd></div>
                }
                else
                {
                    <div><dt>Tasks without a user story</dt><dd data-testid="dws-feature-unassigned">@unassigned</dd></div>
                }
            }
            @if (Options.ShowChanges && f.TasksCompletedThisPeriod > 0) { <div><dt>Completed this period</dt><dd>@f.TasksCompletedThisPeriod matched task(s) [ ] → [x]</dd></div> }
        </dl>
        @if (f.RemovedFeature) { <p class="dlr-warning" data-testid="dws-removed">@(f.RemovalUnconfirmed ? "Missing from a current snapshot that was not read completely — review before treating it as removed." : "Removed from the current scope — shown from the baseline only. A removal is a scope change to confirm, not a defect.")</p> }
        @if (Options.ShowChanges && f.Reasons.Count > 0) { <h3 class="dws-h">Changes this period</h3><ul class="dlr-list" data-testid="dws-feature-changes">@foreach (var r in f.Reasons) { <li>@r</li> }</ul> }
        @if (f.Attention.Count > 0 || (h?.Tasks.Any(t => t.UnresolvedStoryReference is not null) ?? false))
        {
            <h3 class="dws-h">Traceability and review</h3>
            <ul class="dlr-list" data-testid="dws-feature-warnings">
                @foreach (var a in f.Attention) { <li>@a</li> }
                @foreach (var raw in h?.Tasks.Where(t => t.UnresolvedStoryReference is not null).Select(t => t.UnresolvedStoryReference!).Distinct() ?? []) { <li>Tasks reference [@raw], which is not a user story in the specification (kept unassigned).</li> }
            </ul>
        }
        @if (h is { FunctionalRequirements.Count: > 0 })
        {
            <details class="dws-section" data-testid="dws-requirements"><summary>Functional requirements (@h.FunctionalRequirements.Count) — feature-level, not acceptance criteria</summary>
                <ul class="dlr-list">@foreach (var r in h.FunctionalRequirements) { <li><strong>@r.Key</strong> @r.Text @if (r.Change != DeliveryItemChange.Unchanged) { <span class="dws-chip dws-chip-change">@DeliveryReportingText.Change(r.Change)</span> }</li> }</ul>
            </details>
        }
        @Evidence(f.Evidence.SpecPath, f.Evidence.TasksPath, f.Evidence.PlanPath, null)
    };

    private RenderFragment StoryBody(DeliveryWorkItem i, DeliveryFeatureHierarchy? h) => __builder =>
    {
        var s = i.Story!;
        var tasks = _items.Where(x => x.Type == DeliveryWorkItemType.Task && x.ParentId == i.Id).ToList();
        @if (s.Description is { Length: > 0 } description) { <p data-testid="dws-story-description">@description</p> }
        <h3 class="dws-h">Acceptance criteria (@s.Criteria.Count)</h3>
        @if (s.Criteria.Count == 0) { <p class="dws-meta">No acceptance scenarios under this story in the specification.</p> }
        else
        {
            <ol class="dlr-list" data-testid="dws-story-criteria">
                @foreach (var c in s.Criteria)
                {
                    <li data-testid="dws-criterion" data-change="@c.Change">@c.Text @if (Options.ShowChanges && c.Change != DeliveryItemChange.Unchanged) { <span class="dws-chip dws-chip-change">@DeliveryReportingText.Change(c.Change)</span> }
                        @if (Options.ShowChanges && c.BaselineText is { } before) { <br /><span class="dws-meta">Baseline: @before</span> }</li>
                }
            </ol>
        }
        <h3 class="dws-h">Linked tasks (@tasks.Count)</h3>
        @if (tasks.Count == 0) { <p class="dws-meta" data-testid="dws-story-no-tasks">No task line references [@s.Key] — no task is linked by guessing.</p> }
        else
        {
            <ul class="dlr-list" data-testid="dws-story-tasks">
                @foreach (var t in tasks)
                {
                    <li><button type="button" class="btn-link" @onclick="() => Select(t.Id)">@t.SourceId</button> @t.Title <span class="dws-meta">@States(t.Task!)</span></li>
                }
            </ul>
        }
        @if (s.PhaseKeys.Count > 0 && h is not null) { <p><strong>Phases:</strong> @string.Join(", ", h.Phases.Where(p => s.PhaseKeys.Contains(p.Key)).Select(p => p.Title))</p> }
        @Evidence(i.Feature.Evidence.SpecPath, null, null, s.SourceLine > 0 ? $"line {s.SourceLine}" : null)
    };

    private RenderFragment GroupBody(DeliveryWorkItem i) => __builder =>
    {
        var g = i.Group!;
        var tasks = _items.Where(x => x.Type == DeliveryWorkItemType.Task && x.ParentId == i.Id).ToList();
        <p data-testid="dws-group-explanation">@g.Explanation</p>
        <dl class="dws-facts" data-testid="dws-group-facts">
            <div><dt>Source</dt><dd>@g.Provenance</dd></div>
            <div><dt>Mapping</dt><dd data-testid="dws-group-confidence">@W.ConfidenceLabel(g.Confidence)</dd></div>
            @if (g.LinkedKey is { } linked) { <div><dt>Linked to</dt><dd data-testid="dws-group-linked">@linked</dd></div> }
            <div><dt>Tasks</dt><dd>@g.TaskCompleted of @g.TaskTotal checked (task checklist only)</dd></div>
            @if (g.NeedsReview) { <div><dt>Review</dt><dd class="dlr-warning" data-testid="dws-group-review">Needs review — the reference cannot be resolved to a defined story.</dd></div> }
        </dl>
        <h3 class="dws-h">Tasks (@tasks.Count)</h3>
        <ul class="dlr-list" data-testid="dws-group-tasks">@foreach (var t in tasks) { <li><button type="button" class="btn-link" @onclick="() => Select(t.Id)">@t.SourceId</button> @t.Title <span class="dws-meta">@States(t.Task!)</span></li> }</ul>
        @Evidence(null, i.Feature.Evidence.TasksPath, null, null)
    };

    private static string TaskStates(DeliveryTaskRow t) =>
        $"{(t.BaselineCompleted is { } was ? (was ? "[x]" : "[ ]") + " → " : "")}{(t.Change == DeliveryTaskChange.Removed ? "removed" : t.Completed ? "[x]" : "[ ]")} · {DeliveryReportingText.TaskChange(t.Change)}";

    /// <summary>Checklist state in current state; baseline → current and the change classification in comparison.</summary>
    private string States(DeliveryTaskRow t) => Options.ShowChanges ? TaskStates(t) : t.Completed ? "[x] checked in source" : "[ ] open in source";

    private RenderFragment TaskBody(DeliveryWorkItem i, DeliveryFeatureHierarchy? h) => __builder =>
    {
        var t = i.Task!;
        <dl class="dws-facts" data-testid="dws-task-facts">
            <div><dt>Checklist</dt><dd data-testid="dws-task-state">@States(t)</dd></div>
            @if (t.Relationship is { } relationship)
            {
                <div><dt>Relationship</dt><dd data-testid="dws-task-relationship" data-kind="@relationship">@W.RelationshipLabel(relationship)@(t.MappingConfidence is { } c ? $" · {W.ConfidenceLabel(c)}" : "")</dd></div>
                @if (t.RelationshipNote is { } note) { <div><dt>Why</dt><dd data-testid="dws-task-relationship-note">@note</dd></div> }
            }
            else
            {
                <div><dt>User story</dt><dd data-testid="dws-task-story">@(t.UserStoryKey ?? (t.UnresolvedStoryReference is { } raw ? $"Parent story unresolved ([{raw}])" : "Not assigned"))</dd></div>
            }
            <div><dt>Parallel</dt><dd>@(t.Parallel ? "Yes — marked [P]" : "No")</dd></div>
        </dl>
        <h3 class="dws-h">Why it is here</h3>
        <ul class="dlr-list" data-testid="dws-task-explanation">@foreach (var line in W.TaskExplanation(i, h?.Phases ?? [])) { <li>@line</li> }</ul>
        @Evidence(null, t.SourcePath ?? i.Feature.Evidence.TasksPath, null, null)
    };

    private RenderFragment Evidence(string? spec, string? tasks, string? plan, string? location) => __builder =>
    {
        <details class="dws-section" data-testid="dws-evidence"><summary>Source evidence</summary>
            <dl class="dws-facts">
                <div><dt>Snapshot</dt><dd data-testid="dws-evidence-snapshot">@Report.Current.SourceFileName (current)@(Options.ShowChanges ? $" · {Report.Baseline.SourceFileName} (baseline)" : "")</dd></div>
                @if (spec is not null) { <div><dt>Specification</dt><dd><code>@spec</code>@(location is null ? "" : $" · {location}")</dd></div> }
                @if (tasks is not null) { <div><dt>Tasks</dt><dd><code>@tasks</code></dd></div> }
                @if (plan is not null) { <div><dt>Plan</dt><dd><code>@plan</code></dd></div> }
                @if (spec is null && tasks is null && plan is null) { <div><dt>Files</dt><dd>No source file recorded for this item.</dd></div> }
            </dl>
        </details>
    };
}
