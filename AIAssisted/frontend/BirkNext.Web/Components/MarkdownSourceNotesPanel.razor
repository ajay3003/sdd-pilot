@using BirkNext.Web.Models
@using BirkNext.Web.Services

@* Source content not structured: the authored blocks an Explorer did not map to a structured field. Shared by every Explorer.
   The normal view is a compact summary; potential mapping gaps (Explorer-aware, never already-structured facts) are listed first;
   informational, change/history and reference content is grouped and collapsed; structural scaffolding appears only in the
   technical raw source, which is last and collapsed. Presentation only: nothing here is promoted into the structured model. *@
@if (Blocks is { Count: > 0 } && _content is { } content)
{
    var gaps = content.Gaps;
    <section class="markdown-source-notes" aria-label="Source content not structured" data-testid="markdown-source-notes">
        <div class="msn-summary" data-testid="markdown-source-notes-summary">
            <h3 class="msn-title">Source content not structured · @content.Total block@(content.Total == 1 ? "" : "s")</h3>
            <p class="msn-lead">These blocks were preserved from the source document but were not deterministically mapped to structured Explorer fields.</p>
            <p class="msn-verdict" role="status" data-testid="markdown-source-notes-verdict">
                @if (gaps.Count > 0)
                {
                    <span>Most source content was preserved for context and auditability. Only potential mapping gaps require review: <strong>@gaps.Count potential mapping gap@(gaps.Count == 1 ? "" : "s")</strong> may contain structured information not represented above.</span>
                }
                else
                {
                    <span>No likely mapping gaps detected in the preserved source content. Preserved source content is not automatically a parsing problem.</span>
                }
            </p>
            <ul class="msn-counts" aria-label="Source content by category" data-testid="markdown-source-notes-counts">
                @foreach (var (category, count) in content.Counts)
                {
                    <li class="msn-count msn-count-@Css(category)" data-category="@category">@UnmappedSourceContent.PluralLabel(category, count) <strong>@count</strong></li>
                }
            </ul>
            <p class="markdown-source-notes-scope" data-testid="markdown-source-notes-scope">Not structured is not ignored: Document Quality Review reads the full text of the document.</p>
        </div>

        @if (gaps.Count > 0)
        {
            <section class="msn-gaps" aria-label="Potential mapping gaps" data-testid="markdown-source-notes-gaps">
                <h4 class="msn-h4">Potential mapping gaps</h4>
                <p class="msn-muted">Review observations: the source appears relevant to this Explorer but was not mapped. Nothing is added to the structured view, and none of them is approved.</p>
                <ul class="msn-gap-list">
                @foreach (var gap in _allGaps ? gaps : gaps.Take(GapPreview))
                {
                    <li class="msn-gap" data-testid="markdown-source-gap" data-source-block-id="@gap.Block.BlockId" data-potential-kind="@gap.PotentialKind">
                        <p class="msn-gap-kind"><span class="msn-tag">Potential mapping gap</span> · @gap.PotentialKind <span class="msn-muted">· Source: @Lines(gap.Block.StartLine, gap.Block.EndLine)@(gap.Section is { } s ? $" · under “{s}”" : "")</span></p>
                        <p class="msn-gap-text">@UnmappedSourceContent.Readable(gap.Block.Text)</p>
                        <p class="msn-muted msn-gap-reason">Reason: @gap.Reason</p>
                        @SourceToggle(gap.Block.BlockId, [gap], "Show source for this potential mapping gap")
                    </li>
                }
                </ul>
                @if (gaps.Count > GapPreview)
                {
                    <button type="button" class="btn-secondary btn-small" data-testid="markdown-source-gaps-all" aria-expanded="@(_allGaps ? "true" : "false")"
                            @onclick="() => _allGaps = !_allGaps">@(_allGaps ? "Show fewer" : $"Show all {gaps.Count} potential mapping gaps")</button>
                }
            </section>
        }

        @foreach (var category in GroupedCategories)
        {
            var groups = content.GroupsOf(category);
            if (groups.Count == 0) continue;
            var open = _openCategories.Contains(category);
            var id = $"{_id}-{Css(category)}";
            <section class="msn-category" data-testid="markdown-source-category-@Css(category)">
                <button type="button" class="btn-secondary btn-small msn-category-toggle" aria-expanded="@(open ? "true" : "false")" aria-controls="@id"
                        data-testid="markdown-source-category-toggle-@Css(category)" @onclick="() => Toggle(_openCategories, category)">
                    @(open ? "Hide" : "Show") @CategoryHeading(category) (@content.Count(category))
                </button>
                @if (open)
                {
                    <div id="@id">
                        @foreach (var group in groups)
                        {
                            <article class="msn-group" data-testid="markdown-source-group" data-source-block-ids="@string.Join(' ', group.Blocks.Select(b => b.Block.BlockId))">
                                <p class="msn-group-title">@group.Title</p>
                                <p class="msn-group-preview">@group.Preview</p>
                                <p class="msn-muted">@group.Blocks.Count source block@(group.Blocks.Count == 1 ? "" : "s") · @Lines(group.StartLine, group.EndLine)</p>
                                @SourceToggle(group.Id, group.Blocks, $"Show source for {group.Title}")
                            </article>
                        }
                    </div>
                }
            </section>
        }

        <section class="msn-raw" data-testid="markdown-source-notes-raw">
            <button type="button" class="btn-secondary btn-small" aria-expanded="@(_rawOpen ? "true" : "false")" aria-controls="@_id"
                    data-testid="markdown-source-notes-toggle" @onclick="() => _rawOpen = !_rawOpen">@(_rawOpen ? "Hide" : "Show") technical raw source (@content.Total block@(content.Total == 1 ? "" : "s"))</button>
            @if (_rawOpen)
            {
                <div id="@_id" data-testid="markdown-source-notes-detail">
                    <p class="msn-muted">Raw source: every preserved block verbatim and in order. The gutter shows each block's source line range; hover or focus a row for its parser block type and presentation category.</p>
                    <ol class="msn-reader" data-testid="markdown-source-reader" aria-label="Technical raw source">
                    @foreach (var block in content.Blocks.Take(_rawShown))
                    {
                        var meta = $"Lines {block.Block.StartLine}–{block.Block.EndLine} · {block.Block.BlockType} · {UnmappedSourceContent.Label(block.Category)}";
                        <li class="markdown-source-note msn-line msn-line-@Css(block.Category)" data-source-block-id="@block.Block.BlockId" data-source-start-line="@block.Block.StartLine"
                            data-source-end-line="@block.Block.EndLine" data-block-type="@block.Block.BlockType" data-category="@block.Category" title="@meta">
                            <span class="msn-gutter" aria-hidden="true">@(block.Block.StartLine == block.Block.EndLine ? $"{block.Block.StartLine}" : $"{block.Block.StartLine}–{block.Block.EndLine}")</span>
                            <span class="visually-hidden">@meta: </span><pre class="msn-line-text">@block.Block.Text</pre>
                        </li>
                    }
                    </ol>
                    @if (content.Blocks.Count > _rawShown)
                    {
                        <button type="button" class="btn-secondary btn-small" data-testid="markdown-source-reader-more" @onclick="() => _rawShown += RawChunk">
                            Show next @Math.Min(RawChunk, content.Blocks.Count - _rawShown) blocks (@(content.Blocks.Count - _rawShown) of @content.Blocks.Count not shown yet)</button>
                    }
                </div>
            }
        </section>
    </section>
}

@code {
    [Parameter] public IReadOnlyList<MarkdownSourceNote>? Blocks { get; set; }
    /// <summary>The Explorer and its structured model; without it only the generic (non-gap) categories apply.</summary>
    [Parameter] public UnmappedSourceContext? Context { get; set; }
    /// <summary>The source document (path or name) shown with "Show source", when the Explorer knows it.</summary>
    [Parameter] public string? SourceName { get; set; }
    /// <summary>Kept for callers that already pass it: everything technical renders on request.</summary>
    [Parameter] public bool Lazy { get; set; }
    /// <summary>Kept for callers that already pass it (former technical heading).</summary>
    [Parameter] public string? Summary { get; set; }

    private static readonly SourceContentCategory[] GroupedCategories =
        [SourceContentCategory.Informational, SourceContentCategory.ChangeHistory, SourceContentCategory.Reference];

    private UnmappedSourceContent? _content;
    private IReadOnlyList<MarkdownSourceNote>? _classifiedBlocks;
    private object? _classifiedModel;
    private bool _rawOpen;
    // Large documents (hundreds of blocks): rows render in chunks on request — never dropped, always counted.
    private const int RawChunk = 200;
    private int _rawShown = RawChunk;
    private const int GapPreview = 6;
    private bool _allGaps;
    private readonly HashSet<SourceContentCategory> _openCategories = [];
    private readonly HashSet<string> _openSources = new(StringComparer.Ordinal);
    private readonly string _id = "msn-" + Guid.NewGuid().ToString("N")[..8];

    protected override void OnParametersSet()
    {
        // Classify once per document/model: the classification is deterministic and the inputs are immutable parse results.
        if (ReferenceEquals(Blocks, _classifiedBlocks) && ReferenceEquals(Context?.Model, _classifiedModel) && _content is not null) return;
        _classifiedBlocks = Blocks;
        _classifiedModel = Context?.Model;
        _content = UnmappedSourceContent.Classify(Blocks, Context ?? new UnmappedSourceContext(SourceContentExplorer.None, null));
    }

    private RenderFragment SourceToggle(string key, IReadOnlyList<ClassifiedSourceBlock> blocks, string accessibleLabel) => __builder =>
    {
        var open = _openSources.Contains(key);
        var id = $"{_id}-src-{key.GetHashCode():x}";
        <button type="button" class="btn-link msn-source-toggle" aria-expanded="@(open ? "true" : "false")" aria-controls="@id" aria-label="@accessibleLabel"
                data-testid="markdown-source-show" @onclick="() => Toggle(_openSources, key)">@(open ? "Hide source" : "Show source")</button>
        if (open)
        {
            <div id="@id" class="msn-source" data-testid="markdown-source-exact">
                @if (SourceName is { Length: > 0 } source) { <p class="msn-muted">Document: <span class="msn-wrap">@source</span></p> }
                @foreach (var block in blocks)
                {
                    <p class="msn-muted">@Lines(block.Block.StartLine, block.Block.EndLine) · @block.Block.BlockType@(block.Section is { } s ? $" · under “{s}”" : "")</p>
                    <pre>@block.Block.Text</pre>
                }
            </div>
        }
    };

    private static void Toggle<T>(HashSet<T> set, T key) { if (!set.Remove(key)) set.Add(key); }

    private static string Lines(int start, int end) => start == end ? $"line {start}" : $"lines {start}–{end}";

    private static string CategoryHeading(SourceContentCategory category) => category switch
    {
        SourceContentCategory.Informational => "informational content",
        SourceContentCategory.ChangeHistory => "change / history",
        _ => "references",
    };

    private static string Css(SourceContentCategory category) => category switch
    {
        SourceContentCategory.PotentialMappingGap => "gap",
        SourceContentCategory.Informational => "informational",
        SourceContentCategory.ChangeHistory => "history",
        SourceContentCategory.Reference => "reference",
        _ => "structural",
    };
}
