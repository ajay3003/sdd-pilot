@using BirkNext.Web.Models

@* Authored text an explorer did not map to a structured field. The verbatim blocks are kept, but they are technical detail: the normal view says
   only how many there are, and line ranges and parser block types render on request ("Review source notes"). Shared by every explorer. *@
@if (Blocks is { Count: > 0 })
{
    <section class="markdown-source-notes" aria-label="Unmapped source content" data-testid="markdown-source-notes">
        <p class="markdown-source-notes-summary" data-testid="markdown-source-notes-summary">
            <span class="markdown-source-notes-label">Structured extraction diagnostics · technical details</span>
            @Blocks.Count source block@(Blocks.Count == 1 ? " was" : "s were") not mapped to structured fields and @(Blocks.Count == 1 ? "is" : "are") kept as raw source notes.
            <span class="markdown-source-notes-scope" data-testid="markdown-source-notes-scope">Unmapped is not ignored: Document Quality Review reads the full text of the document.</span>
            <button type="button" class="btn-secondary btn-small" aria-expanded="@(_open ? "true" : "false")" aria-controls="@_id"
                    data-testid="markdown-source-notes-toggle" @onclick="() => _open = !_open">@(_open ? "Hide raw source notes" : "View raw source notes")</button>
        </p>
        @if (_open)
        {
            <div id="@_id" data-testid="markdown-source-notes-detail">
                <p>@(Summary ?? "Technical details · unmapped source content"): these authored blocks are kept verbatim because they were not mapped to a structured field.</p>
                @foreach (var block in Blocks)
                {
                    <article class="markdown-source-note" data-source-block-id="@block.BlockId" data-source-start-line="@block.StartLine" data-source-end-line="@block.EndLine">
                        <h4>Lines @block.StartLine–@block.EndLine · @block.BlockType</h4>
                        <pre>@block.Text</pre>
                    </article>
                }
            </div>
        }
    </section>
}

@code {
    [Parameter] public IReadOnlyList<MarkdownSourceNote>? Blocks { get; set; }
    /// <summary>Kept for callers that already pass it: technical content always renders on request now.</summary>
    [Parameter] public bool Lazy { get; set; }
    /// <summary>Heading of the technical detail when opened.</summary>
    [Parameter] public string? Summary { get; set; }
    private bool _open;
    private readonly string _id = "msn-" + Guid.NewGuid().ToString("N")[..8];
}
