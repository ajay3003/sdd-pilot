@using BirkNext.Web.Models

@* The Target Environment's separate state dimensions, never one badge: environment state (active or not), configuration (a target is set),
   target reachability (as the Target Application check established it) and runtime evidence (an authenticated context observed now). There is no global
   "verified" state: a manual sign-in check is an authentication fact on the Authentication tab. Whether active execution is allowed is not
   environment health: the backend's trusted-environment gate is shown only where something can execute (journey runs, active tests). *@
<dl class="tes" aria-label="Target Environment state" data-testid="te-state">
    <div data-dimension="environment"><dt>Environment state</dt><dd><span class="tes-pill tes-@(IsActive ? "ok" : "muted")" data-testid="te-state-environment">@(IsActive ? "Active" : "Not active")</span></dd></div>
    <div data-dimension="configuration"><dt>Configuration</dt><dd><span class="tes-pill tes-@(Configured ? "ok" : "attention")" data-testid="te-state-configuration">@(Configured ? "Configured" : "Not configured")</span></dd></div>
    <div data-dimension="detection"><dt>Target reachability</dt><dd><span class="tes-pill tes-@DetectionTone" data-testid="te-state-detection">@Detection</span></dd></div>
    <div data-dimension="runtime"><dt>Runtime evidence</dt><dd><span class="tes-pill tes-@(RuntimeObserved ? "ok" : "muted")" data-testid="te-state-runtime">@(RuntimeObserved ? "Observed" : "Not verified")</span></dd></div>
</dl>

@code {
    [Parameter, EditorRequired] public FrontendAnalysisProfile Profile { get; set; } = default!;
    [Parameter] public bool IsActive { get; set; }
    /// <summary>Reachability as detection established it ("Reachable", "Unreachable", "Unknown", "Not checked" …).</summary>
    [Parameter] public string Detection { get; set; } = "Not checked";
    /// <summary>Whether an authenticated runtime context (API or browser) is available now. Detection never sets it.</summary>
    [Parameter] public bool RuntimeObserved { get; set; }

    private bool Configured => !string.IsNullOrWhiteSpace(Profile.TargetUrl);
    private string DetectionTone => Detection.StartsWith("Reachable", StringComparison.Ordinal) ? "ok"
        : Detection.StartsWith("Unreachable", StringComparison.Ordinal) || Detection == "Needs re-check" ? "attention" : "muted";
}
