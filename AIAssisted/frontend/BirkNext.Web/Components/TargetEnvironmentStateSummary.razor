@using BirkNext.Web.Models
@using BirkNext.Web.Services
@inject IServiceProvider Services

@* The Target Environment's separate state dimensions, never one badge: environment state (active or not), configuration (a target is set),
   verification (manual sign-in verification) and execution trust (the backend's trusted-environment configuration — never a browser
   setting). Evidence and runtime state are per integration and live under Integrations. *@
<dl class="tes" aria-label="Target Environment state" data-testid="te-state">
    <div data-dimension="environment"><dt>Environment state</dt><dd><span class="tes-pill tes-@(IsActive ? "ok" : "muted")" data-testid="te-state-environment">@(IsActive ? "Active" : "Not active")</span></dd></div>
    <div data-dimension="configuration"><dt>Configuration</dt><dd><span class="tes-pill tes-@(Configured ? "ok" : "attention")" data-testid="te-state-configuration">@(Configured ? "Configured" : "Not configured")</span></dd></div>
    <div data-dimension="verification"><dt>Verification</dt><dd><span class="tes-pill tes-@VerificationTone" data-testid="te-state-verification">@Verification</span></dd></div>
    <div data-dimension="trust"><dt>Execution trust</dt><dd><span class="tes-pill tes-@(_trusted == true ? "ok" : _trusted == false ? "attention" : "muted")" data-testid="te-state-trust" title="@_trustDetail">@(_trusted switch { true => "Trusted", false => "Not trusted", _ => "Not known" })</span></dd></div>
</dl>

@code {
    [Parameter, EditorRequired] public FrontendAnalysisProfile Profile { get; set; } = default!;
    [Parameter] public bool IsActive { get; set; }
    /// <summary>Whether this environment requires manual sign-in verification at all.</summary>
    [Parameter] public bool ManualVerificationRequired { get; set; }
    [Parameter] public bool ManualVerificationPassed { get; set; }

    private bool Configured => !string.IsNullOrWhiteSpace(Profile.TargetUrl);
    private string Verification => ManualVerificationPassed ? "Verified" : ManualVerificationRequired ? "Manual verification required" : "Not verified";
    private string VerificationTone => ManualVerificationPassed ? "ok" : ManualVerificationRequired ? "attention" : "muted";

    private bool? _trusted;
    private string? _trustDetail, _loadedFor;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == Profile.Id) return;
        _loadedFor = Profile.Id;
        _trusted = null;
        _trustDetail = "The trusted-environment state comes from the backend configuration.";
        if (Services.GetService<IIntegrationJourneysApiService>() is not { } journeys || string.IsNullOrWhiteSpace(Profile.Id)) return;
        try
        {
            if (journeys.PacksAsync(Profile.Id) is not { } read) return;
            if ((await read)?.Value?.FirstOrDefault() is { } pack) { _trusted = pack.EnvironmentTrusted; _trustDetail = pack.EnvironmentDetail; }
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { }
    }
}
