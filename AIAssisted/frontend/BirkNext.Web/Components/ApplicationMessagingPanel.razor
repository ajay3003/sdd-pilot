@using BirkNext.Integrations
@using BirkNext.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IIntegrationCatalogApiService Api

@* Application messaging (Wolverine) evidence beside — never inside — transport evidence. Source archives are analyzed read-only by the
   backend; only facts with file:line provenance are kept. Configured is never shown as executed: runtime processing stays Not assessed
   here, because handler telemetry is read only during an Integration Quality Review run. Bindings are explicit and saved immediately. *@
<section class="am" aria-labelledby="am-heading" data-testid="am">
    <h3 id="am-heading">Application messaging</h3>
    <p class="am-muted">Wolverine evidence from analyzed application source. Event Hub and Service Bus transport evidence is separate. Source shows what is configured — not that a handler ran.</p>
    <div class="am-upload">
        <label class="am-file-button">
            <InputFile class="am-file-input" multiple accept=".zip" OnChange="AnalyzeAsync" disabled="@_busy" aria-label="Analyze application source archives (.zip)" data-testid="am-upload" />
            <span aria-hidden="true">@(Evidence is null ? "Analyze source archives" : "Re-analyze source archives")</span>
        </label>
        <span class="am-muted">Up to 4 .zip files, 50 MB each. Read in memory; source code and configuration values are never stored.</span>
    </div>
    <p class="am-status" role="status" aria-live="polite" data-testid="am-status">@_status</p>
    @if (_error is { } error) { <p class="am-error" role="alert" data-testid="am-error">@error</p> }

    @if (Evidence is null)
    {
        <p class="am-muted" data-testid="am-empty">No application source analyzed. Wolverine configuration and runtime processing are Not assessed.</p>
    }
    else
    {
        var listed = ApplicationMessagingPresentation.Listed(Evidence);
        var notDetected = ApplicationMessagingPresentation.NotDetected(Evidence);
        <p class="am-muted" data-testid="am-provenance">Analyzed @Evidence.AnalyzedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC · @string.Join(", ", Evidence.Archives.Select(a => $"{a.FileName} (sha256 {a.Sha256[..Math.Min(12, a.Sha256.Length)]}, {a.FilesAnalyzed} files)"))</p>
        @if (listed.Count == 0) { <p class="am-muted" data-testid="am-none">Wolverine is not detected in any analyzed application.</p> }
        <ul class="am-apps">
            @foreach (var app in listed)
            {
                var headingId = $"am-app-{Slug(app.ApplicationId)}";
                <li class="am-app" data-testid="am-app" data-application="@app.ApplicationId" aria-labelledby="@headingId">
                    <div class="am-app-head"><strong id="@headingId">@app.ApplicationId</strong>@if (app.ServiceName is { } service) { <span class="am-muted">· @service</span> }</div>
                    <dl class="am-states">
                        <div><dt>Wolverine</dt><dd><span class="am-badge am-badge-@ApplicationMessagingPresentation.Tone(app.Detection)" data-testid="am-detection">@ApplicationMessagingLabels.Detection(app.Detection)</span></dd></div>
                        @if (app.Detection != MessagingDetection.NotDetected)
                        {
                            <div><dt>Handler mapping</dt><dd><span class="am-badge am-badge-@ApplicationMessagingPresentation.Tone(app.HandlerMapping)" data-testid="am-mapping">@ApplicationMessagingLabels.Fact(app.HandlerMapping)</span></dd></div>
                            <div><dt>Retry policy</dt><dd><span class="am-badge am-badge-@ApplicationMessagingPresentation.Tone(app.RetryPolicy)" data-testid="am-retry">@ApplicationMessagingLabels.Fact(app.RetryPolicy)</span></dd></div>
                            <div><dt>Runtime processing</dt><dd><span class="am-badge am-badge-muted" data-testid="am-runtime">Not assessed</span></dd></div>
                        }
                    </dl>
                    <label class="am-bind">Integrations consumer
                        <select class="form-control" data-testid="am-binding" value="@(app.BoundConsumer ?? "")" disabled="@_busy" @onchange="e => BindAsync(app, e.Value?.ToString())">
                            <option value="">Not bound</option>
                            @foreach (var consumer in ApplicationMessagingPresentation.Consumers(Catalog)) { <option value="@consumer">@consumer</option> }
                        </select>
                    </label>
                    <ReviewDisclosure Text="View Wolverine evidence" CollapseText="Hide Wolverine evidence" TestId="@($"am-evidence-{Slug(app.ApplicationId)}")" Class="disclosure-inline">
                        <p data-testid="am-meaning"><strong>What this means:</strong> @ApplicationMessagingPresentation.Meaning(app) @app.DetectionReason</p>
                        <h4>Configuration evidence</h4>
                        <ul class="am-facts" data-testid="am-facts">
                            @foreach (var fact in app.Facts)
                            {
                                <li><strong>@fact.Label</strong> <span class="am-badge am-badge-@ApplicationMessagingPresentation.Tone(fact.State)">@ApplicationMessagingLabels.Fact(fact.State)</span> @fact.Detail <span class="am-muted am-mono">@ApplicationMessagingPresentation.Locations(fact)</span></li>
                            }
                        </ul>
                        @if (app.Routes.Count > 0)
                        {
                            <h4>Routes</h4>
                            <ul class="am-facts" data-testid="am-routes">
                                @foreach (var route in app.Routes)
                                {
                                    <li><strong>@route.Direction</strong> @ApplicationMessagingPresentation.Route(route)
                                        @if (route.Direction == MessagingRouteDirection.Listen) { <span class="am-badge am-badge-@ApplicationMessagingPresentation.Tone(route.HandlerMapping)">Handler mapping @ApplicationMessagingLabels.Fact(route.HandlerMapping).ToLowerInvariant()</span> }
                                        @if (route.Condition is { } condition) { <span class="am-muted"> · @condition</span> }
                                        @if (route.Senders.Count > 0) { <span class="am-muted"> · sent by @string.Join(", ", route.Senders)</span> }
                                        @if (route.FailurePath.Count > 0) { <span class="am-muted"> · on failure: @string.Join("; ", route.FailurePath)</span> }
                                        @if (route.MappingReason is { } why && route.HandlerMapping != MessagingFactState.Available) { <span class="am-muted"> · @why.Trim()</span> }
                                    </li>
                                }
                            </ul>
                        }
                        <h4>Runtime evidence</h4>
                        <ul class="am-facts" data-testid="am-runtime-evidence">
                            <li><strong>Handler execution</strong> <span class="am-badge am-badge-muted">Not assessed</span> Handler telemetry is read only during an Integration Quality Review run, and only when the application is bound and Azure runtime evidence is configured.</li>
                            <li><strong>Retry activity</strong> <span class="am-badge am-badge-muted">Not assessed</span> No Wolverine retry telemetry is exported by the analyzed source.</li>
                            <li><strong>Processing duration</strong> <span class="am-badge am-badge-muted">Not assessed</span> No measured handler duration; configuration is never performance evidence.</li>
                        </ul>
                        @if (app.Limitations.Count > 0)
                        {
                            <h4>Limitations</h4>
                            <ul class="am-facts">@foreach (var limitation in app.Limitations.Distinct()) { <li>@limitation</li> }</ul>
                        }
                    </ReviewDisclosure>
                </li>
            }
        </ul>
        @if (notDetected.Count > 0) { <p class="am-muted" data-testid="am-not-detected">Wolverine not detected: @string.Join(", ", notDetected).</p> }
        @if (Evidence.Limitations.Count > 0)
        {
            <ul class="am-facts am-muted" data-testid="am-set-limitations">@foreach (var limitation in Evidence.Limitations) { <li>@limitation</li> }</ul>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public string EnvironmentId { get; set; } = "";
    [Parameter, EditorRequired] public IntegrationCatalog Catalog { get; set; } = new();
    [Parameter] public ApplicationMessagingEvidenceSet? Evidence { get; set; }
    [Parameter] public EventCallback<ApplicationMessagingEvidenceSet?> EvidenceChanged { get; set; }

    private const long MaxArchiveBytes = 50L * 1024 * 1024;
    private bool _busy;
    private string _status = "";
    private string? _error;

    private async Task AnalyzeAsync(InputFileChangeEventArgs args)
    {
        _error = null;
        var files = args.GetMultipleFiles(4);
        if (files.Any(f => f.Size > MaxArchiveBytes)) { _error = "An archive is larger than the 50 MB limit; nothing was analyzed."; return; }
        _busy = true;
        _status = "Analyzing source archives…";
        var streams = new List<(string, Stream)>();
        try
        {
            foreach (var file in files)
            {
                var buffer = new MemoryStream();
                await using (var upload = file.OpenReadStream(MaxArchiveBytes)) await upload.CopyToAsync(buffer);
                buffer.Position = 0;
                streams.Add((file.Name, buffer));
            }
            var (set, error) = await Api.AnalyzeApplicationMessagingAsync(EnvironmentId, streams);
            if (error is not null) { _error = $"Not analyzed: {error}"; _status = ""; return; }
            _status = $"Saved. Analyzed {set!.Archives.Sum(a => a.FilesAnalyzed)} files; {ApplicationMessagingPresentation.Listed(set).Count} application(s) with Wolverine evidence.";
            await EvidenceChanged.InvokeAsync(set);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or IOException or System.Text.Json.JsonException)
        {
            _error = "The source archives could not be analyzed: the BirkNext backend did not answer. Nothing was stored.";
            _status = "";
        }
        finally
        {
            foreach (var (_, stream) in streams) await stream.DisposeAsync();
            _busy = false;
        }
    }

    private async Task BindAsync(ApplicationMessagingEvidence app, string? consumer)
    {
        _error = null;
        _busy = true;
        _status = "Saving…";
        try
        {
            var set = await Api.BindApplicationMessagingAsync(EnvironmentId, app.ApplicationId, string.IsNullOrWhiteSpace(consumer) ? null : consumer);
            _status = string.IsNullOrWhiteSpace(consumer) ? $"Saved. {app.ApplicationId} is not bound to a consumer." : $"Saved. {app.ApplicationId} is bound to {consumer}.";
            await EvidenceChanged.InvokeAsync(set);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _error = "Save failed: the binding was not stored.";
            _status = "";
        }
        finally { _busy = false; }
    }

    private static string Slug(string value) => new string(value.Select(c => char.IsLetterOrDigit(c) ? char.ToLowerInvariant(c) : '-').ToArray());
}
