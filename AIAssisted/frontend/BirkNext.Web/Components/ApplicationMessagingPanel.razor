@using BirkNext.Integrations
@using BirkNext.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IIntegrationCatalogApiService Api

<section class="am" aria-labelledby="am-heading" data-testid="am">
    <div class="am-title">
        <h3 id="am-heading">Application messaging</h3>
        <label class="am-file-button">
            <InputFile id="@ServiceBusPlatformPanel.MessagingUploadId" class="am-file-input" multiple accept=".zip" OnChange="AnalyzeAsync" disabled="@_busy" aria-label="Analyze application messaging source archives (.zip)" data-testid="am-upload" />
            <span aria-hidden="true">@(Evidence is null ? "Analyze messaging source" : "Re-analyze messaging source")</span>
        </label>
    </div>
    <dl class="am-overview" data-testid="am-overview">
        @foreach (var row in ApplicationMessagingPresentation.Overview(Evidence))
        {
            <div data-testid="@($"am-overview-{row.Key}")"><dt>@row.Label</dt><dd><span class="am-badge am-badge-@row.Tone" title="@row.Detail">@row.Status</span>
                @if (row.Key == "wolverine" && Evidence is not null)
                {
                    <span class="am-muted">@Evidence.Applications.Count(a => a.Detection == MessagingDetection.Confirmed) detected / @Evidence.Applications.Count(a => a.Detection == MessagingDetection.Likely) likely</span>
                }
            </dd></div>
        }
        <div><dt>Applications analyzed</dt><dd data-testid="am-count">@(Evidence?.Applications.Count.ToString() ?? "Not assessed")</dd></div>
        <div><dt>Handler evidence</dt><dd>@(Evidence is null ? "Not assessed" : $"{Evidence.Applications.Count(a => a.Handlers.Count > 0 || a.Routes.Count > 0)} applications with handler/route evidence")</dd></div>
    </dl>
    <p class="am-note" role="note" data-testid="am-note">Event Hub and Service Bus transport evidence is separate. Source shows what is configured — not that a handler ran.</p>
    <ReviewDisclosure Text="Analysis details" TestId="am-analysis">
        <p class="am-muted">Wolverine messaging only. Up to 4 .zip files, 50 MB each. Read in memory; source code and configuration values are never stored.</p>
        @foreach (var row in ApplicationMessagingPresentation.Overview(Evidence)) { <p class="am-muted">@row.Label: @row.Detail</p> }
        @if (Evidence is not null)
        {
            <p class="am-muted" data-testid="am-provenance">Analyzed @Evidence.AnalyzedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC · @Evidence.Archives.Count archive(s) · @Evidence.Archives.Sum(a => a.FilesAnalyzed) files</p>
            <ul class="am-facts">@foreach (var archive in Evidence.Archives) { <li class="am-mono">@archive.FileName · sha256 @archive.Sha256 · @archive.FilesAnalyzed files</li> }</ul>
            <ul class="am-facts am-muted" data-testid="am-set-limitations">@foreach (var limitation in Evidence.Limitations) { <li>@limitation</li> }</ul>
        }
    </ReviewDisclosure>
    <p class="am-status" role="status" aria-live="polite" data-testid="am-status">@_status</p>
    @if (_error is { } error) { <p class="am-error" role="alert" data-testid="am-error">@error</p> }
    @if (Evidence is null)
    {
        <p class="am-muted" data-testid="am-empty">No application source analyzed yet.</p>
    }
    else
    {
        <div class="am-search">
            <label>Search applications <input type="search" class="form-control" data-testid="am-search" @bind="_search" @bind:event="oninput" /></label>
            <span class="am-muted" data-testid="am-shown">@Evidence.Applications.Count analyzed · @Applications.Count shown</span>
        </div>
        <div class="am-master">
            <table class="am-table" aria-label="Analyzed applications">
                <thead><tr><th scope="col">Application</th><th scope="col">Wolverine</th><th scope="col">Handler evidence</th><th scope="col">IQR link</th><th scope="col">Runtime</th></tr></thead>
                <tbody>
                    @foreach (var app in Applications)
                    {
                        <tr @key="app.ApplicationId" class="@(_selected == app.ApplicationId ? "am-selected" : "")" data-testid="am-app" data-application="@app.ApplicationId" @onclick="() => Select(app)">
                            <th scope="row"><button type="button" class="am-select" aria-pressed="@(_selected == app.ApplicationId ? "true" : "false")" aria-controls="am-selected-detail" @onclick="() => Select(app)">@app.ApplicationId<span class="am-mobile">View details</span></button></th>
                            <td data-label="Wolverine"><span class="am-badge am-badge-@ApplicationMessagingPresentation.Tone(app.Detection)" data-testid="am-detection">@ApplicationMessagingPresentation.Detection(app.Detection)</span></td>
                            <td data-label="Handler evidence"><span class="am-badge am-badge-@ApplicationMessagingPresentation.Tone(app.HandlerMapping)" data-testid="am-mapping">@ApplicationMessagingPresentation.HandlerState(app.HandlerMapping)</span></td>
                            <td data-label="IQR link">@(app.BoundConsumer is null ? "Not linked" : "Linked")</td>
                            <td data-label="Runtime" data-testid="am-runtime">Not assessed</td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (Applications.Count == 0) { <p class="am-muted">No applications match the search.</p> }
        </div>
        <div id="am-selected-detail">
        @if (Selected is { } selected)
        {
            <section class="am-detail" data-testid="am-detail" aria-labelledby="am-detail-heading" @key="selected.ApplicationId">
                <div class="am-title"><h4 id="am-detail-heading">@selected.ApplicationId</h4><button type="button" class="btn-secondary" @onclick="() => _selected = null">Collapse details</button></div>
                <dl class="am-states">
                    <div><dt>Wolverine usage</dt><dd>@ApplicationMessagingPresentation.Detection(selected.Detection)</dd></div>
                    <div><dt>Handler evidence</dt><dd>@ApplicationMessagingPresentation.HandlerState(selected.HandlerMapping)</dd></div>
                    <div><dt>IQR integration link</dt><dd>@(selected.BoundConsumer ?? "Not linked")</dd></div>
                    <div><dt>Runtime processing</dt><dd>Not assessed</dd></div>
                </dl>
                <label class="am-bind">IQR integration link
                    <select class="form-control" data-testid="am-binding" value="@(selected.BoundConsumer ?? "")" disabled="@_busy" @onchange="e => BindAsync(selected, e.Value?.ToString())">
                        <option value="">Not linked</option>
                        @foreach (var consumer in ApplicationMessagingPresentation.Consumers(Catalog)) { <option value="@consumer">@consumer</option> }
                    </select>
                </label>
                <div class="am-title">
                    @foreach (var platform in Catalog.Platforms.Where(p => p.Kind is IntegrationKind.ServiceBus or IntegrationKind.EventHub))
                    {
                        <a href="@($"#ip-platform-{Slug(platform.Id)}")">Open @platform.Name transport evidence</a>
                    }
                </div>
                <ApplicationMessagingDetail Application="selected" Catalog="Catalog" />
            </section>
        }
        else { <p class="am-muted">Select an application to inspect messaging evidence.</p> }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public string EnvironmentId { get; set; } = "";
    [Parameter, EditorRequired] public IntegrationCatalog Catalog { get; set; } = new();
    [Parameter] public ApplicationMessagingEvidenceSet? Evidence { get; set; }
    [Parameter] public EventCallback<ApplicationMessagingEvidenceSet?> EvidenceChanged { get; set; }

    private const long MaxArchiveBytes = 50L * 1024 * 1024;
    private bool _busy;
    private string _status = "";
    private string? _error;
    private string _search = "";
    private string? _selected;
    private ApplicationMessagingEvidenceSet? _previous;
    private IReadOnlyList<ApplicationMessagingEvidence> Applications => Evidence?.Applications
        .Where(a => a.ApplicationId.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .OrderBy(a => a.ApplicationId, StringComparer.OrdinalIgnoreCase).ToList() ?? [];
    private ApplicationMessagingEvidence? Selected => Applications.FirstOrDefault(a => a.ApplicationId == _selected);

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_previous, Evidence)) return;
        _previous = Evidence;
        if (Evidence?.Applications.Any(a => a.ApplicationId == _selected) != true)
            _selected = Evidence?.Applications.OrderBy(a => a.ApplicationId, StringComparer.OrdinalIgnoreCase).FirstOrDefault()?.ApplicationId;
    }

    private void Select(ApplicationMessagingEvidence app) => _selected = app.ApplicationId;

    private async Task AnalyzeAsync(InputFileChangeEventArgs args)
    {
        _error = null;
        var files = args.GetMultipleFiles(4);
        if (files.Any(f => f.Size > MaxArchiveBytes)) { _error = "An archive is larger than the 50 MB limit; nothing was analyzed."; return; }
        _busy = true;
        _status = "Analyzing messaging source…";
        var streams = new List<(string, Stream)>();
        try
        {
            foreach (var file in files)
            {
                var buffer = new MemoryStream();
                await using (var upload = file.OpenReadStream(MaxArchiveBytes)) await upload.CopyToAsync(buffer);
                buffer.Position = 0;
                streams.Add((file.Name, buffer));
            }
            var (set, error) = await Api.AnalyzeApplicationMessagingAsync(EnvironmentId, streams);
            if (error is not null) { _error = $"Not analyzed: {error}"; _status = ""; return; }
            _status = $"Saved. Analyzed {set!.Archives.Sum(a => a.FilesAnalyzed)} files; {ApplicationMessagingPresentation.Listed(set).Count} application(s) with Wolverine evidence.";
            await EvidenceChanged.InvokeAsync(set);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or IOException or System.Text.Json.JsonException)
        {
            _error = "The source archives could not be analyzed: the BirkNext backend did not answer. Nothing was stored.";
            _status = "";
        }
        finally
        {
            foreach (var (_, stream) in streams) await stream.DisposeAsync();
            _busy = false;
        }
    }

    private async Task BindAsync(ApplicationMessagingEvidence app, string? consumer)
    {
        _error = null;
        _busy = true;
        _status = "Saving…";
        try
        {
            var set = await Api.BindApplicationMessagingAsync(EnvironmentId, app.ApplicationId, string.IsNullOrWhiteSpace(consumer) ? null : consumer);
            _status = string.IsNullOrWhiteSpace(consumer) ? $"Saved. {app.ApplicationId} is not linked to an IQR integration consumer." : $"Saved. {app.ApplicationId} is linked to {consumer}.";
            await EvidenceChanged.InvokeAsync(set);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _error = "Save failed: the IQR integration link was not stored.";
            _status = "";
        }
        finally { _busy = false; }
    }

    private static string Slug(string value) => new string(value.Select(c => char.IsLetterOrDigit(c) ? char.ToLowerInvariant(c) : '-').ToArray());
}
