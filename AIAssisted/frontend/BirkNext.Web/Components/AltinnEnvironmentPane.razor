@using BirkNext.Integrations
@using BirkNext.Web.Services
@inject IServiceProvider Services
@inject IJSRuntime JS

@* Target Environment → Connected Systems → Altinn: the one place the Altinn environment is configured, rendered in the shared compact
   provider shell (summary → things to fix → detected settings → sections → advanced details). Altinn supplies its own cards, the manual vs
   automated readiness, owner-grouped things to fix, and provider sections (application, browser vs unattended authentication, execution
   safety, test identities, report contract, runtime). A suggestion (test pack default or reference) is "Not applied" until a person applies
   it: suggested != configured. Detect is discovery only. Browser login evidence never fills BirkNext's unattended client. A secret is
   entered once (POST), held in backend memory for the session and never shown, stored in the browser or returned. Test identities are
   managed in Test Data. *@
<ProviderDetailShell @ref="_shell" Prefix="ae" Label="@Title" Busy="_busy" Cards="Cards" FixGroups="FixGroups" OnFix="FixAsync"
                     Proposals="Proposals" Selected="_selected" OnToggle="Toggle" OnApply="ApplySelectedAsync" DetectionLine="@DetectionLine"
                     Notes="Notes" Sections="Sections" InitiallyOpen="InitiallyOpen" Placeholder="Placeholder" Advanced="Advanced">
    <HeaderActions>
        <button type="button" class="btn btn-primary btn-sm" data-testid="ae-detect" disabled="@_busy" @onclick="DetectAsync">Detect Altinn settings</button>
        <button type="button" class="btn btn-secondary btn-sm" data-testid="ae-review-evidence" @onclick="() => _shell?.OpenAdvanced()">Review evidence</button>
        <button type="button" class="btn btn-secondary btn-sm" data-testid="ae-clear-session" disabled="@_busy" @onclick="ClearSessionAsync">Clear session values</button>
    </HeaderActions>
    <Banner>
        @if (_error is { } error) { <p class="ae-banner ae-banner-error" role="alert" data-testid="ae-error">@error</p> }
        @if (_notice is { } notice) { <p class="ae-banner" role="status" data-testid="ae-notice">@notice</p> }
    </Banner>
    <Readiness>
        @if (_view is { } view)
        {
            <div class="ae-readiness" data-testid="ae-readiness">
                @* Capability-specific readiness: each surface counts only its own blockers and review items. Manual testing can be Ready while automated
                   execution is optional/unconfigured and end-to-end verification needs review — an intended state, not a broken page. *@
                @{ var manual = AltinnEnvironmentPresentation.ManualTesting(view); }
                <div class="ae-readiness-card" data-testid="ae-readiness-manual" data-blockers="@manual.Blockers">
                    <span class="ae-readiness-label">Manual testing</span>
                    <span class="ae-pill ae-pill-@manual.Tone"><span class="visually-hidden">Manual testing status: </span>@manual.Status</span>
                    <span class="ae-muted" data-testid="ae-readiness-manual-line">@manual.Reason</span>
                    @if (view.ManualReadiness.State == AltinnReadinessState.Ready && view.ManualReadiness.Reason.Length > 0)
                    {
                        <details class="ae-readiness-details" data-testid="ae-readiness-manual-details"><summary>Show details</summary><p class="ae-muted">@view.ManualReadiness.Reason</p></details>
                    }
                </div>
                @foreach (var capability in new[] { AltinnCapability.AutomatedExecution, AltinnCapability.EndToEndVerification })
                {
                    if (AltinnEnvironmentPresentation.Capability(view, capability) is not { } item) continue;
                    var testId = capability == AltinnCapability.AutomatedExecution ? "ae-readiness-automated" : "ae-readiness-e2e";
                    <div class="ae-readiness-card" data-testid="@testId" data-status="@item.Status" data-blockers="@item.Blockers" data-reviews="@item.ReviewItems">
                        <span class="ae-readiness-label">@(capability == AltinnCapability.AutomatedExecution ? "Automated BirkNext execution" : item.Label)</span>
                        <span class="ae-pill ae-pill-@AltinnEnvironmentPresentation.Tone(item.Status)"><span class="visually-hidden">@item.Label status: </span>@item.StatusLabel</span>
                        <span class="ae-muted" data-testid="@($"{testId}-counts")">@(item.Required ? AltinnEnvironmentPresentation.Counts(item) : "Not required for manual testing")</span>
                        <span class="ae-muted">@item.Reason</span>
                        @if (item.Blockers > 0 && FixGroups.Count > 0)
                        {
                            @* The blockers are the Needs attention cards (owner + action), not a raw list; the full list stays in Advanced details. *@
                            <button type="button" class="ae-link" data-testid="@(capability == AltinnCapability.AutomatedExecution ? "ae-blockers-toggle" : "ae-e2e-blockers-toggle")" @onclick="ViewBlockersAsync">View blockers</button>
                        }
                    </div>
                }
            </div>
            @if (view.Detected)
            {
                @* Detect Altinn settings is the one discovery orchestrator: what it found, grouped, with state and source. Applying stays explicit below. *@
                <section class="ae-detected-groups" data-testid="ae-detected-groups" aria-label="Detected Altinn settings">
                    <h5 class="ae-h5">Detected Altinn settings</h5>
                    @foreach (var group in AltinnEnvironmentPresentation.DetectedGroups(view))
                    {
                        <div class="ae-detected-group" data-testid="ae-detected-group" data-group="@group.Title">
                            <strong>@group.Title</strong>
                            <ul class="ae-list">
                                @foreach (var line in group.Lines)
                                {
                                    <li data-testid="ae-detected-line" data-found="@(line.Found ? "true" : "false")"><span aria-hidden="true">@(line.Found ? "✓" : "○")</span><span class="visually-hidden">@(line.Found ? "Found:" : "Not found:")</span> @line.Text</li>
                                }
                            </ul>
                        </div>
                    }
                </section>
            }
        }
    </Readiness>
</ProviderDetailShell>

@code {
    private ProviderDetailShell? _shell;

    private string Title => $"Altinn{(_view is null ? "" : $" · {EnvironmentLabel}")}";

    private RenderFragment? Placeholder => _view is null ? Loading : null;

    private RenderFragment Loading => __builder =>
    {
        <p class="ae-muted" role="status" data-testid="ae-loading">@(_error is null ? "Loading the Altinn setup…" : "The Altinn setup is not available.")</p>
    };

    private RenderFragment BrowserNote => __builder =>
    {
        <p class="ae-muted ae-note-line" data-testid="ae-browser-note">Browser authentication evidence never configures BirkNext unattended execution.</p>
    };

    private RenderFragment ContractBody => __builder =>
    {
        @if (_view is { ContractDimensions.Count: > 0 } dimensionsView)
        {
            <table class="ae-table" data-testid="ae-contract-dimensions">
                <caption class="visually-hidden">Report contract evidence per dimension</caption>
                <thead><tr><th scope="col">Dimension</th><th scope="col">Status</th><th scope="col">Affects when missing</th></tr></thead>
                <tbody>
                    @foreach (var dimension in dimensionsView.ContractDimensions)
                    {
                        <tr data-testid="ae-contract-dimension" data-key="@dimension.Key"><th scope="row">@dimension.Label</th><td>@dimension.Status</td><td>@(dimension.Present ? "—" : dimension.Affects)</td></tr>
                    }
                </tbody>
            </table>
            <p class="ae-muted">Manual preparation and submission do not need these. Missing process or form evidence only blocks activities that use the exact contract (automated execution).</p>
        }
        @if (_view is { } view && view.Contract.Reason.Length > 0)
        {
            <details class="ae-contract-details" data-testid="ae-contract-details"><summary>Show details</summary><p class="ae-muted">@view.Contract.Reason</p></details>
        }
        <AltinnTestSetupPanel EnvironmentId="@EnvironmentId" />
    };

    /// <summary>"5 settings missing" (the list is in the section body) or "Complete".</summary>
    private static string AutomatedSummary(AltinnEnvironmentView view) =>
        AltinnEnvironmentPresentation.AutomatedSettingsLine(view) is var line && line.Contains(':') ? line[..line.IndexOf(':')] : line;

    /// <summary>"View blockers": move to the Needs attention cards (their headings are focusable), not a raw expanded list.</summary>
    private async Task ViewBlockersAsync()
    {
        try { await JS.InvokeVoidAsync("birknextFocusElement", "ae-fix-title"); } catch (Microsoft.JSInterop.JSException) { } catch (InvalidOperationException) { }
    }

    private IReadOnlyList<ShellCard> Cards => _view is not { } view ? [] :
        [.. view.Summary.Where(item => item.Key != "authentication").Select(item => AltinnAccessPresentation.ReporterCard(item, view, _browserAuth)).Select(item =>
            item.Key == "automated" && AltinnEnvironmentPresentation.Capability(view, AltinnCapability.AutomatedExecution) is { } automated
                ? new ShellCard(item.Key, "Automated execution", automated.StatusLabel, AltinnEnvironmentPresentation.Tone(automated.Status), automated.Required ? AltinnEnvironmentPresentation.Counts(automated) : "")
                : new ShellCard(item.Key, item.Key == "app" ? "Application" : item.Label, AltinnEnvironmentPresentation.ReadinessLabel(item), AltinnEnvironmentPresentation.Tone(item),
                    item.Key is "reporter-access" or "integration-auth" ? item.Reason : AltinnEnvironmentPresentation.CardReason(item, view)))];

    private IReadOnlyList<ShellFixGroup> FixGroups => _view is not { } view ? [] : [.. AltinnEnvironmentPresentation.ThingsToFix(view).Select(AltinnEnvironmentPresentation.ToShell)];

    private IReadOnlyList<ShellProposal> Proposals => _view is not { } view ? [] :
        [.. AltinnEnvironmentPresentation.Proposals(view).Select(field => new ShellProposal(field.Key, field.Label, AltinnEnvironmentPresentation.Display(field.Proposal!),
            AltinnEnvironmentPresentation.StateLabel(field.Proposal!.State), field.Proposal.SourceLabel,
            field.State == AltinnSettingState.Conflict ? AltinnEnvironmentPresentation.Display(field) : null, field.State == AltinnSettingState.Conflict))];

    private string? DetectionLine => _view is { Detected: true } view ? AltinnEnvironmentPresentation.DetectionLine(view.Detection) : null;
    private IReadOnlyList<string> Notes => _view is { Detected: true } view ? view.Notes : [];
    private IReadOnlyList<string> InitiallyOpen => OpenContract ? ["contract"] : [];

    private IReadOnlyList<ShellSection> Sections => _view is not { } view ? [] :
    [
        new("application", "Application", AltinnEnvironmentPresentation.ApplicationLine(view))
        {
            Status = AltinnEnvironmentPresentation.ApplicationStatus(view).Label, Tone = AltinnEnvironmentPresentation.ApplicationStatus(view).Tone, Body = Table("Application"),
        },
        new("access", "Access & authentication", AltinnAccessPresentation.Line(view, _browserAuth))
        {
            Status = AltinnEnvironmentPresentation.AccessStatus(view).Label, Tone = AltinnEnvironmentPresentation.AccessStatus(view).Tone, ToggleLabel = "Review access", Body = AccessBody,
        },
        new("browser", "Reporter access · browser login", AltinnEnvironmentPresentation.BrowserStatus(view, _browserAuth).Summary)
        {
            Status = AltinnEnvironmentPresentation.BrowserStatus(view, _browserAuth).Status, Tone = AltinnEnvironmentPresentation.BrowserStatus(view, _browserAuth).Tone,
            ToggleLabel = "View evidence", Body = BrowserBody, Always = BrowserNote,
        },
        // BirkNext's own unattended client: an advanced, collapsed section for manual testers until automated execution is requested.
        new("automated", view.AutomationRequested ? "Automated BirkNext execution" : "Advanced — Automated BirkNext execution", AutomatedSummary(view))
        {
            Status = AltinnEnvironmentPresentation.Capability(view, AltinnCapability.AutomatedExecution)?.StatusLabel ?? AuthenticationLabel,
            Tone = AltinnEnvironmentPresentation.Capability(view, AltinnCapability.AutomatedExecution) is { } automated ? AltinnEnvironmentPresentation.Tone(automated.Status) : AltinnEnvironmentPresentation.Tone(AuthenticationState),
            ToggleLabel = view.AutomationRequested ? "Configure" : "Configure / edit unattended client", Body = AutomatedBody, Always = SecretRow,
        },
        new("safety", "Execution safety", $"{AltinnEnvironmentPresentation.SafetyLine(view)} · Required for automated execution only")
        {
            Status = AltinnEnvironmentPresentation.SafetyState(view) == AltinnReadinessState.Ready ? "Ready" : view.AutomationRequested ? "Blocked" : "Not configured · automation only",
            Tone = AltinnEnvironmentPresentation.SafetyState(view) == AltinnReadinessState.Ready ? "ok" : view.AutomationRequested ? "bad" : "muted", Body = Table("Execution safety"),
        },
        new("identities", "Test identities", $"Reporter: {AltinnEnvironmentPresentation.IdentityLine(view, "reporter")} · Child: {AltinnEnvironmentPresentation.IdentityLine(view, "child")}")
        {
            Status = view.Summary.FirstOrDefault(item => item.Key == "identities") is { } identities ? AltinnEnvironmentPresentation.ReadinessLabel(identities) : null,
            Tone = AltinnEnvironmentPresentation.Tone(view.Summary.FirstOrDefault(item => item.Key == "identities")?.State ?? AltinnReadinessState.NotAssessed),
            LinkLabel = "Manage test identities", LinkHref = AltinnEnvironmentPresentation.TestDataHref, LinkTestId = "ae-manage-identities",
        },
        new("contract", "Report contract", AltinnEnvironmentPresentation.ContractLine(view))
        {
            Status = ContractLabel, Tone = view.Contract.State == AltinnReadinessState.Ready ? "ok" : view.Contract.State == AltinnReadinessState.Blocked ? "warn" : "warn", ToggleLabel = "Review contract",
            Body = ContractBody,
        },
        new("runtime", "Runtime", AltinnEnvironmentPresentation.RuntimeLine(view))
        {
            Status = AltinnEnvironmentPresentation.Capability(view, AltinnCapability.RuntimeVerification)?.StatusLabel ?? "Not verified",
            Tone = AltinnEnvironmentPresentation.Capability(view, AltinnCapability.RuntimeVerification) is { } runtime ? AltinnEnvironmentPresentation.Tone(runtime.Status) : "muted",
            ToggleLabel = "Record observation", Body = ObservationBody,
        },
    ];

    private RenderFragment Table(string group, bool evidence = false) => __builder =>
    {
        <ProviderFieldTable Prefix="ae" Group="@group" Evidence="evidence" Fields="@(_view!.Fields.Where(field => field.Group == group).ToList())" />
    };

    /// <summary>Per-hop authentication: requirement, provider, configuration and runtime kept apart for each interaction.</summary>
    private RenderFragment AccessBody => __builder =>
    {
        if (_view is not { } view) return;
        <ul class="ae-hops" data-testid="ae-hops" aria-label="Access and authentication per interaction">
            @foreach (var hop in view.Interactions)
            {
                <li class="ae-hop" data-testid="ae-hop" data-key="@hop.Key" data-requirement="@hop.Requirement.Requirement" data-conflict="@(hop.Requirement.Conflict ? "true" : "false")">
                    <h6 class="ae-h5" id="@($"ae-hop-{hop.Key}")">@hop.Title · @hop.From → @hop.To</h6>
                    <dl class="ae-hop-facts" aria-labelledby="@($"ae-hop-{hop.Key}")">
                        <div><dt>Requirement</dt><dd data-testid="ae-hop-requirement">@AltinnAccessPresentation.RequirementText(hop)</dd></div>
                        @if (hop.Provider is { } provider) { <div><dt>Provider</dt><dd data-testid="ae-hop-provider">@provider</dd></div> }
                        <div><dt>Configuration</dt><dd data-testid="ae-hop-configuration">@hop.Configuration</dd></div>
                        <div><dt>Runtime</dt><dd data-testid="ae-hop-runtime">@(hop.Key == AltinnHops.ReporterApp ? AltinnAccessPresentation.ReporterRuntime(hop, _browserAuth) : hop.Runtime)</dd></div>
                        @if (hop.Key == AltinnHops.ReporterApp && _browserAuth.ObservedLevel != BrowserAuthEvidenceLevel.Unknown)
                        {
                            <div><dt>Login flow</dt><dd data-testid="ae-hop-login-flow">@(_browserAuth.Reached(BrowserAuthEvidenceLevel.LoginFlowObserved) ? "Observed" : "Not observed")</dd></div>
                            <div><dt>Authenticated return</dt><dd data-testid="ae-hop-return">@(_browserAuth.Reached(BrowserAuthEvidenceLevel.AuthenticatedReturnObserved) ? "Observed" : "Not observed")</dd></div>
                            <div><dt>Session</dt><dd data-testid="ae-hop-session">@(_browserAuth.ObservedLevel == BrowserAuthEvidenceLevel.LoggedOut ? "Lost / logged out" : _browserAuth.Reached(BrowserAuthEvidenceLevel.AuthenticatedSessionObserved) ? "Observed" : "Not observed")</dd></div>
                            <div><dt>Source</dt><dd data-testid="ae-hop-source">@BrowserAuthEvidenceResult.Source</dd></div>
                        }
                        <div><dt>Needed for</dt><dd>@hop.RequiredFor</dd></div>
                    </dl>
                    <p class="ae-muted">@hop.Purpose</p>
                    @switch (hop.ActionTarget)
                    {
                        case "browser-discovery":
                            <a class="ae-link" data-testid="ae-hop-view-browser" href="@AltinnAccessPresentation.BrowserDiscoveryHref(EnvironmentId)">View browser evidence<span class="visually-hidden"> for reporter access</span></a>
                            break;
                        case "integration-catalog":
                            <a class="ae-link" data-testid="ae-hop-review-integration" href="@AltinnAccessPresentation.IntegrationCatalogHref(EnvironmentId)">Review integration authentication<span class="visually-hidden"> for @hop.From to @hop.To</span></a>
                            break;
                        case "automated":
                            <button type="button" class="ae-link" data-testid="ae-hop-configure-execution" @onclick="OpenExecutionCredentials">Configure execution credentials</button>
                            break;
                    }
                </li>
            }
        </ul>
    };

    private RenderFragment BrowserBody => __builder =>
    {
        @Table("Browser authentication")
        @if (_browserAuth.Usable)
        {
            @* Browser Discovery already recorded this app's login: reuse it (discover once, record once), no second manual record. *@
            <p class="ae-muted" data-testid="ae-browser-evidence-used">Browser Discovery shows this app's login (@BrowserAuthEvidence.Label(_browserAuth)); no manual recording is needed.
                <a class="ae-link" data-testid="ae-browser-view-evidence" href="@AltinnAccessPresentation.BrowserDiscoveryHref(EnvironmentId)">View browser evidence</a></p>
        }
        else
        {
        <button type="button" class="btn btn-secondary btn-sm" data-testid="ae-browser-record" aria-expanded="@Expanded(_browserForm)" aria-controls="ae-browser-form" @onclick="() => _browserForm = !_browserForm">@(_browserForm ? "Hide browser login observation" : "Record browser login observation")</button>
        }
        @if (_browserForm && !_browserAuth.Usable)
        {
            <div id="ae-browser-form" class="ae-form" data-testid="ae-browser-form">
                <span class="ae-muted">Authorization request parameters only. A code, state, nonce, request_uri or token is refused.</span>
                <label>Issuer <input class="form-control" @bind="_bIssuer" autocomplete="off" placeholder="https://test.idporten.no" /></label>
                <label>Authentication level <input class="form-control" @bind="_bAcr" autocomplete="off" placeholder="idporten-loa-substantial" /></label>
                <label>Observed browser client ID <input class="form-control" @bind="_bClient" autocomplete="off" /></label>
                <label>Observed browser redirect URI <input class="form-control" @bind="_bRedirect" data-testid="ae-browser-redirect" autocomplete="off" placeholder="https://af.tt02.altinn.no/api/cb" /></label>
                <label>Observed browser scopes (space separated) <input class="form-control" @bind="_bScopes" autocomplete="off" /></label>
                <label>PKCE method <input class="form-control" @bind="_bPkce" autocomplete="off" placeholder="S256" /></label>
                <button type="button" class="btn btn-secondary btn-sm" data-testid="ae-record-browser" disabled="@_busy" @onclick="RecordBrowserAsync">Record observation</button>
            </div>
        }
    };

    private RenderFragment SecretRow => __builder =>
    {
        <div class="ae-secret-row" data-testid="ae-secret-row">
            <span>Client secret: <strong data-testid="ae-secret-state">@SecretLabel</strong></span>
            @if (!_secretOpen)
            {
                <button type="button" class="btn btn-secondary btn-sm" data-testid="ae-secret-reveal" aria-expanded="false" aria-controls="ae-secret-form" @onclick="() => _secretOpen = true">Add secret for this session</button>
            }
        </div>
        @if (_secretOpen)
        {
            <div id="ae-secret-form" class="ae-form ae-secret" data-testid="ae-secret-form">
                <label>Client secret for this session
                    <input type="password" class="form-control" @bind="_secret" data-testid="ae-secret" autocomplete="new-password" aria-describedby="ae-secret-help" />
                </label>
                <span id="ae-secret-help" class="ae-muted">Held in backend memory until the backend restarts or the session expires. Never stored, logged, exported or shown.</span>
                <div class="ae-actions">
                    <button type="button" class="btn btn-primary btn-sm" data-testid="ae-add-secret" disabled="@(_busy || string.IsNullOrEmpty(_secret))" @onclick="AddSecretAsync">Add session secret</button>
                    <button type="button" class="btn btn-secondary btn-sm" data-testid="ae-secret-cancel" @onclick="CancelSecret">Cancel</button>
                </div>
            </div>
        }
    };

    private RenderFragment AutomatedBody => __builder =>
    {
        @Table("Automated execution")
        <button type="button" class="btn btn-secondary btn-sm" data-testid="ae-edit-client" aria-expanded="@Expanded(_clientForm)" aria-controls="ae-client-form" @onclick="() => _clientForm = !_clientForm">@(_clientForm ? "Hide unattended client" : "Edit unattended client")</button>
        @if (_clientForm)
        {
            <div id="ae-client-form" class="ae-form" data-testid="ae-client-form">
                <span class="ae-muted">BirkNext's own registered ID-porten TEST client. Never the browser login client above.</span>
                <label>Client ID <input class="form-control" @bind="_clientId" data-testid="ae-client-id" autocomplete="off" /></label>
                <label>Registered redirect URI <input class="form-control" @bind="_redirectUri" data-testid="ae-redirect" autocomplete="off" placeholder="https://…" /></label>
                <label>Scopes (space separated) <input class="form-control" @bind="_scopes" data-testid="ae-scopes" autocomplete="off" /></label>
                <label class="ae-check"><input type="checkbox" @bind="_enabled" data-testid="ae-enabled" /> Automated execution enabled for this environment</label>
                <button type="button" class="btn btn-primary btn-sm" data-testid="ae-save-client" disabled="@_busy" @onclick="SaveClientAsync">Save</button>
            </div>
        }
    };

    private RenderFragment ObservationBody => __builder =>
    {
        @if (_view is { RuntimeStages.Count: > 0 } runtimeView)
        {
            <ul class="ae-list" data-testid="ae-runtime-stages" aria-label="Runtime stages">
                @foreach (var stage in runtimeView.RuntimeStages)
                {
                    <li data-testid="ae-runtime-stage" data-key="@stage.Key" data-observed="@(stage.Observed ? "true" : "false")"><strong>@stage.Label</strong>: @stage.Status <span class="ae-muted">· @stage.Detail</span></li>
                }
            </ul>
        }
        <div id="ae-observe-form" class="ae-form ae-inline" data-testid="ae-observe-form">
            <span class="ae-muted">Observations are evidence: they never prove BirkNext's unattended client, its secret, or MU/MM/downstream receipt.</span>
            <label>Observation
                <select class="form-select" @bind="_observationKind" data-testid="ae-observation-kind">
                    @foreach (var kind in Enum.GetValues<AltinnRuntimeObservationKind>()) { <option value="@kind">@AltinnEnvironmentPresentation.ObservationLabel(kind)</option> }
                </select>
            </label>
            <label class="ae-check"><input type="checkbox" @bind="_observationSucceeded" /> Succeeded</label>
            <label>Note <input class="form-control" @bind="_observationNote" maxlength="500" /></label>
            <button type="button" class="btn btn-primary btn-sm" data-testid="ae-record-observation" disabled="@_busy" @onclick="RecordObservationAsync">Record observation</button>
        </div>
    };

    private RenderFragment Advanced => __builder =>
    {
        if (_view is not { } view) return;
        <p class="ae-muted" data-testid="ae-advanced-counts">@AltinnEnvironmentPresentation.DetectionLine(view.Detection)</p>
        @foreach (var (group, label) in AltinnEnvironmentPresentation.Groups)
        {
            if (!view.Fields.Any(field => field.Group == group)) continue;
            <h6 class="ae-h5">@label</h6>
            @Table(group, evidence: true)
        }
        @if (view.Saved.RuntimeObservations.Count > 0)
        {
            <h6 class="ae-h5">Runtime observations</h6>
            <ul class="ae-list" data-testid="ae-observations">
                @foreach (var observation in view.Saved.RuntimeObservations)
                {
                    <li>@AltinnEnvironmentPresentation.ObservationLabel(observation.Kind): @(observation.Succeeded ? "Observed successful" : "Observed failing") · @observation.EvidenceSource · @observation.ObservedAt.ToString("yyyy-MM-dd")@(string.IsNullOrEmpty(observation.Note) ? "" : $" · {observation.Note}")</li>
                }
            </ul>
        }
        @if (view.Issues.Count > 0)
        {
            @* The same issues that feed the cards, the capability counts and Needs attention — one model, never a second list. *@
            <h6 class="ae-h5">Requirements by capability</h6>
            <table class="ae-table" data-testid="ae-issue-table">
                <caption class="visually-hidden">Unresolved Altinn requirements and the capabilities they affect</caption>
                <thead><tr><th scope="col">Requirement</th><th scope="col">Status</th><th scope="col">Blocks</th><th scope="col">Review for</th><th scope="col">Owner</th></tr></thead>
                <tbody>
                    @foreach (var issue in view.Issues)
                    {
                        <tr data-testid="ae-issue" data-key="@issue.Key" data-kind="@issue.Kind">
                            <th scope="row">@issue.Label</th><td>@issue.Status</td>
                            <td>@(issue.Blocks.Count == 0 ? "—" : string.Join(", ", issue.Blocks.Select(AltinnEnvironmentPresentation.CapabilityLabel)))</td>
                            <td>@(issue.Reviews.Count == 0 ? "—" : string.Join(", ", issue.Reviews.Select(AltinnEnvironmentPresentation.CapabilityLabel)))</td>
                            <td>@issue.Owner</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    };

    private static string Expanded(bool open) => open ? "true" : "false";

    private bool _blockers, _browserForm, _clientForm, _secretOpen;

    private AltinnReadinessState AuthenticationState => _view?.Summary.FirstOrDefault(item => item.Key == "authentication")?.State ?? AltinnReadinessState.NotAssessed;
    private string AuthenticationLabel => _view?.Summary.FirstOrDefault(item => item.Key == "authentication") is { } item ? AltinnEnvironmentPresentation.ReadinessLabel(item) : "Not assessed";
    private string SecretLabel => _view?.Fields.FirstOrDefault(field => field.Key == "client-secret") is { } secret ? AltinnEnvironmentPresentation.StateLabel(secret.State) : "Missing";
    /// <summary>Incomplete contract evidence is a review item (it blocks only activities that need the exact contract), never a global blocker.</summary>
    private string ContractLabel => _view?.Contract.State switch
    {
        AltinnReadinessState.Ready => "Ready",
        AltinnReadinessState.Partial => "Review required",
        AltinnReadinessState.Blocked => "Missing · Review required",
        _ => "Not verified",
    };

    private void CancelSecret() { _secret = null; _secretOpen = false; }

    /// <summary>A "things to fix" action: run Detect, apply exactly the listed suggestions, or open the section that resolves the group.</summary>
    private async Task FixAsync(ShellFixGroup group)
    {
        if (!Enum.TryParse<AltinnEnvironmentPresentation.FixAction>(group.Action, out var kind)) return;
        switch (kind)
        {
            case AltinnEnvironmentPresentation.FixAction.Detect: await DetectAsync(); break;
            case AltinnEnvironmentPresentation.FixAction.ApplySuggested: await ApplyAsync(group.ApplyKeys); break;
            case AltinnEnvironmentPresentation.FixAction.Application: _shell?.OpenSection("application"); break;
            case AltinnEnvironmentPresentation.FixAction.Automated: _clientForm = true; _shell?.OpenSection("automated"); break;
            case AltinnEnvironmentPresentation.FixAction.Safety: _shell?.OpenSection("safety"); break;
            case AltinnEnvironmentPresentation.FixAction.Contract: _shell?.OpenSection("contract"); break;
            case AltinnEnvironmentPresentation.FixAction.Access: _shell?.OpenSection("access"); break;
            case AltinnEnvironmentPresentation.FixAction.Runtime: _shell?.OpenSection("runtime"); break;
        }
    }

    [Parameter, EditorRequired] public string EnvironmentId { get; set; } = "";
    /// <summary>Open the contract evidence directly (a consumer's "Review contract" link).</summary>
    [Parameter] public bool OpenContract { get; set; }

    // Resolved optionally: a host without the Altinn API (e.g. a reduced test host) shows "not available" instead of failing the page.
    private IAltinnEnvironmentApiService Api => (Services.GetService(typeof(IAltinnEnvironmentApiService)) as IAltinnEnvironmentApiService)!;
    private AltinnEnvironmentView? _view;
    private string? _error;
    private string? _notice;
    private bool _busy;
    private readonly HashSet<string> _selected = new(StringComparer.Ordinal);
    private string? _loadedFor;
    private string? _clientId, _redirectUri, _scopes, _secret, _observationNote;
    private bool _enabled, _observationSucceeded = true;
    private AltinnRuntimeObservationKind _observationKind = AltinnRuntimeObservationKind.Submission;
    private string? _bIssuer, _bAcr, _bClient, _bRedirect, _bScopes, _bPkce;

    private Task RecordBrowserAsync() => Run(async () =>
        Show(await Api.RecordBrowserObservationAsync(EnvironmentId, new AltinnBrowserObservationRequest(_bIssuer, null, _bAcr, _bClient, _bRedirect,
            [.. (_bScopes ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)], _bPkce, "Browser login (recorded in BirkNext)")),
            "Browser login observation recorded as evidence. The unattended client is unchanged."));

    private string EnvironmentLabel => _view?.Fields.FirstOrDefault(field => field.Key == "environment")?.Value switch { { } value when value.StartsWith("Test", StringComparison.Ordinal) => "TT02", { } value => value, _ => "environment not set" };

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == EnvironmentId) return;
        _loadedFor = EnvironmentId;
        _view = null; _error = null; _notice = null; _selected.Clear();
        if (Api is null) { _error = "Altinn setup is not available in this host."; return; }
        Show(await Api.GetAsync(EnvironmentId));
        await LoadBrowserEvidenceAsync();
    }

    private BrowserAuthEvidenceResult _browserAuth = BrowserAuthEvidenceResult.None;

    private void OpenExecutionCredentials() { _clientForm = true; _shell?.OpenSection("automated"); }

    /// <summary>Browser Discovery owns the observations; the reporter hop only reads the exact app's login evidence from them.</summary>
    private async Task LoadBrowserEvidenceAsync()
    {
        _browserAuth = BrowserAuthEvidenceResult.None;
        if (_view is not { } view || Services.GetService(typeof(IEndpointDiscoveryService)) is not IEndpointDiscoveryService discovery) return;
        try
        {
            if (Services.GetService(typeof(Microsoft.JSInterop.IJSRuntime)) is Microsoft.JSInterop.IJSRuntime js) await discovery.LoadAsync(js);
            _browserAuth = AltinnAccessPresentation.Evidence(view, discovery.GetSnapshot(EnvironmentId), DateTimeOffset.UtcNow);
        }
        catch (Exception ex) when (ex is Microsoft.JSInterop.JSException or InvalidOperationException) { _browserAuth = BrowserAuthEvidenceResult.None; }
    }

    private void Show(ActiveEventApiResult<AltinnEnvironmentView> result, string? notice = null)
    {
        if (result.Value is { } view)
        {
            _view = view; _error = null; _notice = notice;
            _clientId = view.Saved.Unattended.ClientId; _redirectUri = view.Saved.Unattended.RedirectUri;
            _scopes = string.Join(" ", view.Saved.Unattended.Scopes); _enabled = view.Saved.Unattended.Enabled ?? false;
            _selected.IntersectWith(AltinnEnvironmentPresentation.Proposals(view).Select(field => field.Key));
        }
        else _error = result.Error;
    }

    private void Toggle((string Key, bool On) change) { if (change.On) _selected.Add(change.Key); else _selected.Remove(change.Key); }

    private async Task Run(Func<Task> action)
    {
        _busy = true;
        try { await action(); }
        finally { _busy = false; }
    }

    private Task DetectAsync() => Run(async () =>
    {
        var result = await Api.DetectAsync(EnvironmentId);
        var proposed = result.Value is { } detected && AltinnEnvironmentPresentation.Proposals(detected).Count > 0;
        Show(result, result.Value is null ? null : proposed ? "Detection finished. Nothing was saved: review and apply selected values." : "Detection finished. No new values found.");
        if (result.Value is { } view) foreach (var field in AltinnEnvironmentPresentation.Proposals(view).Where(field => field.State != AltinnSettingState.Conflict)) _selected.Add(field.Key);
    });

    private Task ApplySelectedAsync() => ApplyAsync([.. _selected]);

    /// <summary>Saves exactly the named proposals (selected ones, or the suggestions a "things to fix" group lists) — never anything else.</summary>
    private Task ApplyAsync(IReadOnlyCollection<string> keys) => Run(async () =>
    {
        if (_view is null) return;
        // A conflicting detected value never overwrites the configured one through Apply.
        var chosen = AltinnEnvironmentPresentation.Proposals(_view).Where(field => keys.Contains(field.Key) && field.State != AltinnSettingState.Conflict)
            .Select(field => (field.Key, field.Proposal!.Value!)).ToList();
        if (chosen.Count == 0) return;
        var result = await Api.SaveAsync(EnvironmentId, AltinnEnvironmentPresentation.Apply(chosen));
        Show(result, result.Value is null ? null : $"Applied {chosen.Count} setting{(chosen.Count == 1 ? "" : "s")} to this Target Environment.");
        if (result.Value is not null) _selected.ExceptWith(chosen.Select(item => item.Key));
    });

    private Task SaveClientAsync() => Run(async () =>
    {
        var update = new AltinnEnvironmentSettingsUpdate
        {
            ClientId = _clientId ?? "", RedirectUri = _redirectUri ?? "", Enabled = _enabled,
            Scopes = [.. (_scopes ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)],
        };
        Show(await Api.SaveAsync(EnvironmentId, update), "Unattended client saved.");
    });

    private Task AddSecretAsync() => Run(async () =>
    {
        var secret = _secret ?? "";
        _secret = null; // never kept in the component after sending
        var result = await Api.AddSessionSecretAsync(EnvironmentId, secret);
        if (result.Error is { } error) { _error = error; return; }
        _secretOpen = false;
        Show(await Api.GetAsync(EnvironmentId), "Secret available for this session.");
    });

    private Task ClearSessionAsync() => Run(async () =>
    {
        var result = await Api.ClearSessionAsync(EnvironmentId);
        if (result.Error is { } error) { _error = error; return; }
        Show(await Api.GetAsync(EnvironmentId), "Session values cleared for this environment.");
    });

    private Task RecordObservationAsync() => Run(async () =>
    {
        var result = await Api.RecordObservationAsync(EnvironmentId, new AltinnRuntimeObservationRequest(_observationKind, _observationSucceeded, _observationNote));
        Show(result, "Runtime observation recorded.");
        if (result.Value is not null) { _shell?.CloseSection("runtime"); _observationNote = null; }
    });
}
