    private void SetSearch(string query)
    {
        _searchQuery = query;
        _activeFilter = null;
        RefreshFlatCache();
    }

    private void NavigateToTask(string taskId)
    {
        if (_tree is null) return;
        var ancestors = new List<string>();
        var found = FindTaskInTree(_tree.Roots, taskId, ancestors);
        if (found is null) return;
        foreach (var id in ancestors) _expandedIds.Add(id);
        _selectedNodeId = found.Id;
        RefreshFlatCache();
    }

    private static TaskNode? FindTaskInTree(IEnumerable<TaskNode> nodes, string taskId, List<string> ancestors)
    {
        foreach (var node in nodes)
        {
            if (node.NodeType == TaskNodeType.Task &&
                string.Equals(node.TaskId, taskId, StringComparison.OrdinalIgnoreCase))
                return node;
            ancestors.Add(node.Id);
            var found = FindTaskInTree(node.Children, taskId, ancestors);
            if (found is not null) return found;
            ancestors.RemoveAt(ancestors.Count - 1);
        }
        return null;
    }
