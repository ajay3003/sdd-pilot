    private void SetSearch(string query)
    {
        _searchQuery = query;
        _activeFilter = null;
        RefreshFlatCache();
    }

    private void NavigateToTask(string taskId)
    {
        if (_tree is null) return;
        var ancestors = new List<string>();
        var found = FindTaskInTree(_tree.Roots, taskId, ancestors);
        if (found is null) return;
        foreach (var id in ancestors) _expandedIds.Add(id);
        _selectedNodeId = found.Id;
        RefreshFlatCache();
    }

    private static TaskNode? FindTaskInTree(IEnumerable<TaskNode> nodes, string taskId, List<string> ancestors)
    {
        foreach (var node in nodes)
        {
            if (node.NodeType == TaskNodeType.Task &&
                string.Equals(node.TaskId, taskId, StringComparison.OrdinalIgnoreCase))
                return node;
            ancestors.Add(node.Id);
            var found = FindTaskInTree(node.Children, taskId, ancestors);
            if (found is not null) return found;
            ancestors.RemoveAt(ancestors.Count - 1);
        }
        return null;
    }

    // Presentation-level filtering: hide Format/documentation-only TaskGroup nodes
    private bool IsDocumentationOnlyNode(TaskNode node)
    {
        // Map View filtering: hide root-level documentation sections that are not phases
        // Root-level = HeadingLevel == 2 (level 2 headings are top-level structure)
        // Documentation sections: "Dependencies & Execution Order", "Parallel Execution Examples", etc.
        // Phase sections: contain "Phase" in title

        if (node.HeadingLevel != 2 || node.NodeType != TaskNodeType.TaskGroup)
            return false;

        var title = node.Title?.Trim() ?? "";

        // Keep phase sections
        if (title.Contains("Phase", StringComparison.OrdinalIgnoreCase))
            return false;

        // Hide other root-level TaskGroups (documentation sections)
        // These typically include: Dependencies & Execution Order, Parallel Execution Examples, etc.
        return true;
    }

    private static bool IsFormatGuidanceNode(TaskNode node)
    {
        // Only hide TaskGroup nodes that look like documentation
        if (node.NodeType != TaskNodeType.TaskGroup)
            return false;

        // Check if title indicates this is format/schema documentation
        var title = node.Title?.Trim() ?? "";
        if (!title.Contains("Format", StringComparison.OrdinalIgnoreCase) &&
            !title.Contains("Schema", StringComparison.OrdinalIgnoreCase))
            return false;

        // Only hide if there are no actual Task descendants (pure documentation)
        var hasTaskDescendants = HasTaskDescendants(node);
        return !hasTaskDescendants;
    }

    private static bool HasTaskDescendants(TaskNode node)
    {
        foreach (var child in node.Children)
        {
            if (child.NodeType == TaskNodeType.Task)
                return true;
            if (HasTaskDescendants(child))
                return true;
        }
        return false;
    }
