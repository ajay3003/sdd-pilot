    private List<List<string>> BuildDependencyChains(List<(string Source, string Target)> deps)
    {
        // Build chains with explicit segmentation for convergence patterns
        var chains = new List<List<string>>();
        var processed = new HashSet<string>();
        var depsBySource = deps.GroupBy(d => d.Source).ToDictionary(g => g.Key, g => g.ToList());
        var depsByTarget = deps.GroupBy(d => d.Target).ToDictionary(g => g.Key, g => g.ToList());

        foreach (var (source, target) in deps)
        {
            if (processed.Contains($"{source}→{target}")) continue;

            var chain = new List<string>();
            var current = source;

            // Find the true start (first node with no predecessors)
            while (depsByTarget.ContainsKey(current))
            {
                var preds = depsByTarget[current];
                if (preds.Count > 1) break;  // Convergence point
                var pred = preds[0].Source;
                if (processed.Contains($"{pred}→{current}")) break;
                current = pred;
            }

            // Build chain forward
            chain.Add(current);

            while (depsBySource.ContainsKey(current))
            {
                var outgoing = depsBySource[current];
                if (outgoing.Count == 0) break;

                var nextTarget = outgoing[0].Target;
                processed.Add($"{current}→{nextTarget}");

                // Get all predecessors to this target
                if (depsByTarget.ContainsKey(nextTarget))
                {
                    var allPreds = depsByTarget[nextTarget]
                        .Select(d => d.Source)
                        .Distinct()
                        .OrderBy(s => s)
                        .ToList();

                    // Add any predecessors we haven't added yet
                    foreach (var pred in allPreds)
                    {
                        if (!chain.Contains(pred))
                        {
                            chain.Add(pred);
                        }
                        processed.Add($"{pred}→{nextTarget}");
                    }
                }

                chain.Add(nextTarget);
                current = nextTarget;
            }

            // Only add non-empty unique chains
            if (chain.Count > 0)
            {
                var key = string.Join("→", chain.Distinct());
                chains = chains
                    .Where(c => string.Join("→", c.Distinct()) != key)
                    .ToList();
                chains.Add(chain);
            }
        }

        return chains;
    }

    private void RenderDependencyChain(RenderTreeBuilder builder, List<string> chain, List<(string Source, string Target)> deps)
    {
        builder.OpenElement(10, "div");
        builder.AddAttribute(11, "class", "te-dep-chain");

        if (chain.Count == 0)
        {
            builder.CloseElement();
            return;
        }

        // Build a map of which nodes point to which targets
        var depsBySource = deps.GroupBy(d => d.Source).ToDictionary(g => g.Key, g => g.ToList());
        var depsByTarget = deps.GroupBy(d => d.Target).ToDictionary(g => g.Key, g => g.ToList());

        // Render chain by identifying groupings based on convergence patterns
        var rendered = new HashSet<string>();
        var i = 0;
        var elementIndex = 0;

        while (i < chain.Count)
        {
            if (rendered.Contains(chain[i]))
            {
                i++;
                continue;
            }

            // Find all nodes that are predecessors to the same target
            var currentTask = chain[i];
            var group = new List<string> { currentTask };
            rendered.Add(currentTask);

            // If this node has outgoing edges, look ahead to find other predecessors to the same target
            if (depsBySource.ContainsKey(currentTask))
            {
                var target = depsBySource[currentTask][0].Target;

                // Find all predecessors to this target
                if (depsByTarget.ContainsKey(target))
                {
                    var allPredecessors = depsByTarget[target]
                        .Select(d => d.Source)
                        .OrderBy(s => s)
                        .ToList();

                    // Add other predecessors that appear in the chain and haven't been rendered
                    foreach (var pred in allPredecessors)
                    {
                        if (pred != currentTask && chain.Contains(pred) && !rendered.Contains(pred))
                        {
                            group.Add(pred);
                            rendered.Add(pred);
                        }
                    }
                }
            }

            // Sort group deterministically for display
            group.Sort();

            // Render the group
            for (var k = 0; k < group.Count; k++)
            {
                builder.OpenElement(20 + elementIndex, "span");
                builder.AddAttribute(21 + elementIndex, "class", "te-dep-task-id");
                builder.AddContent(22 + elementIndex, group[k]);
                builder.CloseElement();
                elementIndex++;

                if (k < group.Count - 1)
                {
                    builder.OpenElement(23 + elementIndex, "span");
                    builder.AddAttribute(24 + elementIndex, "class", "te-dep-separator");
                    builder.AddContent(25 + elementIndex, " + ");
                    builder.CloseElement();
                    elementIndex++;
                }
            }

            // Add arrow if not at end
            if (i < chain.Count - 1 && rendered.Count < chain.Count)
            {
                builder.OpenElement(100 + elementIndex, "span");
                builder.AddAttribute(101 + elementIndex, "class", "te-dep-arrow");
                builder.AddContent(102 + elementIndex, " → ");
                builder.CloseElement();
                elementIndex++;
            }

            // Move to next unrendered task in chain
            i++;
        }

        builder.CloseElement();
    }

