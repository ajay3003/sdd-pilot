@using BirkNext.Web.GraphQL
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using Microsoft.AspNetCore.Components.Rendering

<div class="te-panel">

    @if (_tree is null)
    {
        <!-- ── Empty / input state ───────────────────────────────────────── -->
        <div class="te-empty-state">
            <div class="te-empty-icon" aria-hidden="true">🗂</div>
            <h3 class="te-empty-title">Task Explorer</h3>
            <p class="te-empty-desc">Turn a Task artifact into a navigable hierarchy of phases, user stories, task groups, and tables. Paste, import, or drag a task document; any file name works.</p>

            <div class="te-input-area">
                <div class="te-input-header">
                    <span class="te-input-label">Task document</span>
                </div>
                <SpecificationImport
                    @ref="_importRef"
                    InputId="te-file-input"
                    OnFileImported="OnFileImported"
                    OnFileRemoved="OnFileRemoved"
                    IsDisabled="false" />
                <textarea
                    class="te-textarea"
                    aria-label="Task content"
                    placeholder="Or paste task content here..."
                    rows="12"
                    @bind="_localTasksText"></textarea>
                @if (!string.IsNullOrWhiteSpace(_localTasksText))
                {
                    var lineCount = CountLines(_localTasksText);
                    <div class="te-input-footer">
                        <span class="te-input-stat">@lineCount lines · @_localTasksText.Length chars</span>
                        <button class="te-clear-btn" @onclick="ClearInput">Clear</button>
                    </div>
                }
            </div>

            <button
                class="te-build-btn"
                disabled="@(!CanBuild)"
                @onclick="BuildTreeAsync">
                Build Task Explorer
            </button>
        </div>
    }
    else
    {
        <!-- ── Explorer state ────────────────────────────────────────────── -->

        <!-- Simplified Header with Compact Summary and Tabs -->
        <div class="te-header">
            <div class="te-header-left">
                <span class="te-header-title">Task Explorer</span>
            </div>
            <div class="te-header-right">
                <div class="te-view-toggle" role="group" aria-label="View mode">
                    <button type="button" class='te-view-btn @(!_isMapView && !_isImpactView && !_isChangesView && !_isDependenciesView && !_isParallelView ? "is-active" : "")' aria-pressed="@((!_isMapView && !_isImpactView && !_isChangesView && !_isDependenciesView && !_isParallelView) ? "true" : "false")" @onclick='ShowTreeView'>
                        Tree
                    </button>
                    <button type="button" class='te-view-btn @(_isMapView ? "is-active" : "")' aria-pressed="@((_isMapView) ? "true" : "false")" @onclick='ShowMapView'>
                        Map
                    </button>
                    <button type="button" class='te-view-btn @(_isImpactView ? "is-active" : "")' aria-pressed="@((_isImpactView) ? "true" : "false")" @onclick='ShowImpactView'>
                        Impact
                    </button>
                    <button type="button" class='te-view-btn @(_isDependenciesView ? "is-active" : "")' aria-pressed="@((_isDependenciesView) ? "true" : "false")" @onclick='ShowDependenciesView'>
                        Dependencies
                    </button>
                    <button type="button" class='te-view-btn @(_isParallelView ? "is-active" : "")' aria-pressed="@((_isParallelView) ? "true" : "false")" @onclick='ShowParallelView'>
                        Parallelizable
                    </button>
                    <button type="button" class='te-view-btn @(_isChangesView ? "is-active" : "")' aria-pressed="@(_isChangesView ? "true" : "false")" @onclick='ShowChangesView' data-testid="te-changes-tab-btn">
                        Changes
                    </button>
                </div>
            </div>
        </div>

        @if (_health.TotalTasks > 0)
        {
            @RenderSummary()
        }

        <!-- Tab-Specific Controls (shown only for Tree view) -->
        @if (!_isMapView && !_isImpactView && !_isChangesView && !_isDependenciesView && !_isParallelView)
        {
            <div class="te-tab-controls">
                <div class="te-search-wrap">
                    <input type="search"
                           class="te-search"
                           placeholder="Search tasks, IDs, phases..."
                           value="@_searchQuery"
                           @oninput="HandleSearchInput"
                           aria-label="Search Task Explorer" />
                    @if (!string.IsNullOrWhiteSpace(_searchQuery))
                    {
                        var matchCount = _flatCache.Count(r => r.IsMatch);
                        <span class="te-search-count">@matchCount match@(matchCount != 1 ? "es" : "")</span>
                    }
                </div>
                <button class="te-ctrl-btn" @onclick="ExpandAll">Expand All</button>
                <button class="te-ctrl-btn" @onclick="CollapseAll">Collapse All</button>

                <!-- Filter Groups for Tree -->
                <div class="te-filter-groups">
                    <div class="te-filter-group" data-testid="te-filters-status">
                        <div class="te-filter-group-label">Task status</div>
                        <div class="te-filter-row">
                            @Chip(null, "All", "All tasks")
                            @Chip("Completed", "✓ Marked done", "Tasks marked done ([x]) in the Task artifact. Not implementation or test evidence.")
                            @Chip("Open", "○ Open", "Tasks not marked done in the Task artifact")
                        </div>
                    </div>

                    <div class="te-filter-group" data-testid="te-filters-traceability">
                        <div class="te-filter-group-label">Traceability</div>
                        <div class="te-filter-row">
                            @Chip("OnlyUserStories", "User stories", "User-story groups and tasks tagged with a user story (US1, …)")
                            @Chip("HasFrLinks", "Requirements (FR)", "Tasks that reference an FR ID or match a specification requirement")
                            @Chip("HasScLinks", "Success criteria (SC)", "Tasks that reference an SC ID or match a success criterion")
                            @Chip("HasTableLinks", "Table rows", "Tasks listed in a traceability table row of the Task artifact")
                            @Chip("HasLinks", $"With traceability links ({_health.LinkedTasks})", "Tasks with at least one FR, SC, user-story, matched-requirement or table-row link. Topics and evidence are not links.")
                            @if (_health.UnlinkedTasks > 0)
                            {
                                @Chip("NoLinks", $"No traceability links ({_health.UnlinkedTasks})", "Tasks with no FR, SC, user-story, matched-requirement or table-row link of any kind", "te-fc-review")
                            }
                        </div>
                    </div>

                    <div class="te-filter-group" data-testid="te-filters-implementation">
                        <div class="te-filter-group-label">Implementation evidence</div>
                        <div class="te-filter-row">
                            @if (Evidence.ImplementationAssessed)
                            {
                                @Chip("ImplCurrent", "Current evidence", "A linked requirement has current implementation evidence (Implementation Evidence Review)")
                                @Chip("ImplStale", "Stale evidence", "Only potentially stale or historical implementation evidence for the linked requirements")
                                @Chip("ImplNone", "No evidence", "Linked requirements were assessed and have no implementation evidence", "te-fc-review")
                            }
                            else
                            {
                                <span class="te-filter-na" data-testid="te-implementation-not-assessed">Not assessed</span>
                            }
                        </div>
                    </div>

                    <div class="te-filter-group" data-testid="te-filters-tests">
                        <div class="te-filter-group-label">Test evidence</div>
                        <div class="te-filter-row">
                            @if (Evidence.TestsAssessed)
                            {
                                @Chip("TestsDesigned", "Designed tests", "A linked requirement has designed tests")
                                @Chip("TestsExecuted", "Executed", "A linked requirement has current test executions")
                                @Chip("TestsFailed", "Failing", "A current execution for a linked requirement failed", "te-fc-review")
                            }
                            else
                            {
                                <span class="te-filter-na" data-testid="te-tests-not-assessed">Not assessed</span>
                            }
                        </div>
                    </div>

                    <div class="te-filter-group" data-testid="te-filters-topics">
                        <div class="te-filter-group-label">Task topics &amp; planning</div>
                        <div class="te-filter-row">
                            @if (_health.ParallelTasks > 0)
                            {
                                @Chip("Parallel", $"Parallelizable ({_health.ParallelTasks})", "Tasks the Task artifact marks as parallelizable: they can run in parallel with other tasks. Planning, not progress.")
                            }
                            @if (_health.TestingTasks > 0)
                            {
                                @Chip("TestingTasks", "Testing work", "Tasks whose text describes testing work (test, xUnit, integration test, …). Not test results.", "te-fc-testing")
                            }
                            @if (_health.SecurityTasks > 0)
                            {
                                @Chip("SecurityTasks", "Security work", "Tasks whose text describes security work (authorization, access control, …). Not a security check.", "te-fc-security")
                            }
                            @if (HasEnrichmentData)
                            {
                                @Chip("HighRisk", "High alignment risk", "Tasks the task-to-spec alignment review rated high risk", "te-fc-risk")
                            }
                            @if (_health.UnresolvedTableRefs > 0)
                            {
                                @Chip("Unresolved", $"⚠ Unresolved table refs ({_health.UnresolvedTableRefs})", "Table rows that name a task ID the Task artifact does not contain", "te-fc-unresolved")
                            }
                        </div>
                    </div>

                    @if (_activeFilter is not null)
                    {
                        <div class="te-filter-status" role="status" data-testid="te-filter-status">
                            Showing @FilteredTaskCount of @_health.TotalTasks tasks
                            <button type="button" class="te-ctrl-btn" @onclick="() => SetFilter(null)">Clear filter</button>
                        </div>
                    }

                </div>
            </div>
        }

        <!-- Main layout: tree/map + details panel -->
        <div class="te-main @(ShouldShowTaskDetails ? "has-details" : "")">

            @if (_isChangesView)
            {
                <div class="te-changes-view" data-testid="te-changes-view" aria-label="Changes">
                    <div class="te-changes-header">
                        <div>
                            <div class="te-section-kicker">Changes</div>
                            <h3>Compare task versions</h3>
                            <p class="te-changes-subtext">Compare the current Task artifact with a previous version.</p>
                        </div>
                    </div>
                    <TaskChangesPanel CurrentTasksText="@(_lastBuiltText)" />
                </div>
            }
            else if (_isDependenciesView)
            {
                <div class="te-dependencies-view" data-testid="te-dependencies-view" aria-label="Dependencies">
                    <div class="te-dependencies-header">
                        <div>
                            <div class="te-section-kicker">Dependencies</div>
                            <h3>Phase and execution dependencies</h3>
                        </div>
                    </div>

                    @if (_tree is null)
                    {
                        <div class="te-dependencies-view-content">
                            <div class="te-empty-message">No execution structure available.</div>
                        </div>
                    }
                    else if (_tree.ExplicitDependencies.Count == 0)
                    {
                        <div class="te-dependencies-view-content">
                            <div class="te-empty-message">No explicit task dependencies found.</div>
                        </div>
                    }
                    else
                    {
                        var allNodes = AllNodes(_tree.Roots);
                        var taskMap = allNodes
                            .Where(n => n.NodeType == TaskNodeType.Task && !string.IsNullOrEmpty(n.TaskId))
                            .ToDictionary(n => n.TaskId!, StringComparer.OrdinalIgnoreCase);

                        var blockedByMap = new Dictionary<string, List<string>>(StringComparer.OrdinalIgnoreCase);
                        var blocksMap = new Dictionary<string, List<string>>(StringComparer.OrdinalIgnoreCase);

                        foreach (var dep in _tree.ExplicitDependencies)
                        {
                            // dep.SourceTaskId blocks dep.DependsOnTaskId
                            if (!blocksMap.ContainsKey(dep.SourceTaskId))
                                blocksMap[dep.SourceTaskId] = new();
                            blocksMap[dep.SourceTaskId].Add(dep.DependsOnTaskId);

                            // dep.DependsOnTaskId is blocked by dep.SourceTaskId
                            if (!blockedByMap.ContainsKey(dep.DependsOnTaskId))
                                blockedByMap[dep.DependsOnTaskId] = new();
                            blockedByMap[dep.DependsOnTaskId].Add(dep.SourceTaskId);
                        }

                        var taskInDeps = new HashSet<string>(blockedByMap.Keys.Union(blocksMap.Keys), StringComparer.OrdinalIgnoreCase);

                        var tasksByStory = new Dictionary<string, List<string>>(StringComparer.OrdinalIgnoreCase);
                        var storyLabels = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
                        foreach (var taskId in taskInDeps.OrderBy(t => t))
                        {
                            var storyKey = "General";
                            if (taskMap.TryGetValue(taskId, out var task) && !string.IsNullOrEmpty(task.UserStoryTag))
                            {
                                storyKey = task.UserStoryTag;
                                storyLabels[storyKey] = UserStoryDisplay(task) ?? storyKey;
                            }

                            if (!tasksByStory.ContainsKey(storyKey))
                                tasksByStory[storyKey] = new();
                            tasksByStory[storyKey].Add(taskId);
                        }

                        <div class="te-dependencies-view-content">
                            <div class="te-dep-summary">@_tree.ExplicitDependencies.Count explicit dependencies across @tasksByStory.Count user stories</div>

                            @foreach (var story in tasksByStory.Keys.OrderBy(k => k))
                            {
                                var depCount = tasksByStory[story].Sum(t => (blockedByMap.ContainsKey(t) ? blockedByMap[t].Count : 0) + (blocksMap.ContainsKey(t) ? blocksMap[t].Count : 0));
                                var storyLabel = storyLabels.TryGetValue(story, out var label) ? label : story;

                                <div class="te-dep-story-card">
                                    <div class="te-dep-story-header">
                                        <h4 class="te-dep-story-name">@storyLabel</h4>
                                        <span class="te-dep-story-count">@depCount dependencies</span>
                                    </div>

                                    @foreach (var taskId in tasksByStory[story].OrderBy(t => t))
                                    {
                                        var hasBlockedBy = blockedByMap.ContainsKey(taskId) && blockedByMap[taskId].Count > 0;
                                        var hasBlocks = blocksMap.ContainsKey(taskId) && blocksMap[taskId].Count > 0;
                                        var blockedByList = hasBlockedBy ? blockedByMap[taskId].OrderBy(t => t).ToList() : new List<string>();
                                        var blocksList = hasBlocks ? blocksMap[taskId].OrderBy(t => t).ToList() : new List<string>();

                                        <div class="te-dep-task-row">
                                            <div class="te-dep-task-header">
                                                <span class="te-dep-task-id-badge">@taskId</span>
                                                @if (taskMap.TryGetValue(taskId, out var task) && !string.IsNullOrEmpty(task.ShortTitle))
                                                {
                                                    <span class="te-dep-task-title">@task.ShortTitle</span>
                                                }
                                            </div>

                                            @if (hasBlockedBy)
                                            {
                                                <div class="te-dep-relationship">
                                                    <span class="te-dep-label">Blocked by</span>
                                                    <div class="te-dep-related-badges">
                                                        @foreach (var relatedTask in blockedByList)
                                                        {
                                                            <span class="te-dep-related-badge">@relatedTask</span>
                                                        }
                                                    </div>
                                                </div>
                                            }

                                            @if (hasBlocks)
                                            {
                                                <div class="te-dep-relationship">
                                                    <span class="te-dep-label">Blocks</span>
                                                    <div class="te-dep-related-badges">
                                                        @foreach (var relatedTask in blocksList)
                                                        {
                                                            <span class="te-dep-related-badge">@relatedTask</span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else if (_isParallelView)
            {
                <div class="te-parallel-view" @ref="_parallelContainer" data-testid="te-parallel-view" role="region" tabindex="0" aria-label="Parallelizable tasks">
                    <div class="te-parallel-header">
                        <div>
                            <div class="te-section-kicker">Parallelizable work</div>
                            <h3>Tasks that can run in parallel</h3>
                        </div>
                    </div>

                    @if (_tree is null)
                    {
                        <div class="te-parallel-list">
                            <div class="te-empty-message">No execution structure available.</div>
                        </div>
                    }
                    else
                    {
                        var parallelTasks = TaskExplorerService.ParallelizableTasks(_tree.Roots).OrderBy(n => n.PhaseTitle).ThenBy(n => n.TaskId).ToList();

                        <div class="te-parallel-list">
                            @if (parallelTasks.Count == 0)
                            {
                                <div class="te-empty-message">No parallelizable tasks found.</div>
                            }
                            else
                            {
                                var groups = parallelTasks.GroupBy(t => t.PhaseTitle ?? "Unphased").OrderBy(g => g.Key).ToList();

                                <div class="te-parallel-summary" data-testid="te-parallel-summary">@parallelTasks.Count parallelizable task@(parallelTasks.Count == 1 ? "" : "s") across @groups.Count phase@(groups.Count == 1 ? "" : "s")</div>

                                @foreach (var group in groups)
                                {
                                    var groupCount = group.Count();

                                    <div class="te-parallel-group">
                                        <div class="te-parallel-group-header">
                                            <h4 class="te-parallel-group-title">@group.Key</h4>
                                            <span class="te-parallel-group-count">@groupCount parallelizable task@(groupCount == 1 ? "" : "s")</span>
                                        </div>

                                        @foreach (var task in group)
                                        {
                                            <div class="te-parallel-task">
                                                <span class="te-ptask-id">@(task.TaskId ?? "?")</span>

                                                <div class="te-ptask-content">
                                                    <div class="te-ptask-primary">@(task.ShortTitle ?? task.Title)</div>
                                                    @if (!string.IsNullOrEmpty(task.Title) && task.Title != (task.ShortTitle ?? task.Title))
                                                    {
                                                        <div class="te-ptask-secondary">@task.Title</div>
                                                    }
                                                </div>

                                                @if (!string.IsNullOrEmpty(task.UserStoryTag))
                                                {
                                                    <span class="te-ptask-tag" title="@GetUserStoryTitle(task)">@UserStoryDisplay(task)</span>
                                                }

                                                @if (task.IsCompleted)
                                                {
                                                    <span class="te-ptask-status">✓</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            }
            else if (_isImpactView && _coverage is not null)
            {
                <div class="te-impact-view" data-testid="te-impact-view" aria-label="Implementation Impact">
                    <div class="te-impact-header">
                        <div>
                            <div class="te-section-kicker">Impact</div>
                            <h3>Requirement coverage and implementation gaps</h3>
                        </div>
                        <span>Task completion tracks the Task artifact status. Requirement implementation coverage measures requirement-to-task linkage.</span>
                    </div>

                    <!-- Requirement Implementation Coverage and Delivery Risk Analysis -->
                    <div class="te-implementation-grid" data-testid="te-implementation-coverage" aria-label="Requirement Implementation Coverage">
                        <div class="te-implementation-card te-implementation-card-primary">
                            <div class="te-section-kicker">Requirement Implementation Coverage</div>
                            <div class="te-implementation-percent">@_coverage.ImplementationPercent%</div>
                            <div class="te-implementation-card-label">Are requirements covered by implementation tasks?</div>
                            <span class="te-coverage-pill @CoverageStatusClass(_coverage.OverallStatus)">@_coverage.OverallStatus</span>
                        </div>
                        @foreach (var metric in _coverage.Metrics)
                        {
                            <div class="te-implementation-card">
                                <div class="te-implementation-value">@metric.Linked / @metric.Total</div>
                                <div class="te-implementation-card-label">@metric.Label linked</div>
                                <span class="te-coverage-pill @CoverageStatusClass(metric.Status)">@metric.Status</span>
                            </div>
                        }
                    </div>

                    <!-- Implementation Gaps Section -->
                    <div class="te-gaps-section" data-testid="te-implementation-gaps">
                        <h3>Implementation Gaps</h3>
                        @if (_coverage.MissingRequirements.Count > 0)
                        {
                            <div class="te-gap-item">
                                <strong>@_coverage.MissingRequirements.Count</strong> Requirement@(_coverage.MissingRequirements.Count != 1 ? "s" : "") without implementation
                            </div>
                            @foreach (var req in _coverage.MissingRequirements)
                            {
                                <div class="te-gap-item">
                                    <span class="te-gap-id">@req</span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="te-gap-item">✓ All requirements have implementation tasks</div>
                        }
                    </div>

                    <!-- Zero-Gap Success Statuses -->
                    @if (_coverage.MissingSuccessCriteria.Count == 0 || _coverage.MissingUserStories.Count == 0 || _coverage.SecurityGapLabels.Count == 0 || _coverage.TestingGapLabels.Count == 0)
                    {
                        <div class="te-zero-gaps">
                            @if (_coverage.MissingSuccessCriteria.Count == 0)
                            {
                                <div class="te-zero-gap-item">✓ Success Criteria — no gaps</div>
                            }
                            @if (_coverage.MissingUserStories.Count == 0)
                            {
                                <div class="te-zero-gap-item">✓ User Stories — no gaps</div>
                            }
                            @if (_coverage.SecurityGapLabels.Count == 0)
                            {
                                <div class="te-zero-gap-item">✓ Security — no gaps</div>
                            }
                            @if (_coverage.TestingGapLabels.Count == 0)
                            {
                                <div class="te-zero-gap-item">✓ Testing — no gaps</div>
                            }
                        </div>
                    }

                    <!-- Phase Progress -->
                    @if (_tree is not null && TaskExplorerService.PhaseNodes(_tree.Roots).Count > 0)
                    {
                        <div class="te-phase-dashboard">
                            <div class="te-phase-dashboard-header">Phase progress <span class="te-phase-dashboard-sub">tasks marked done in Task artifact</span></div>
                            <div class="te-phase-cards">
                                @foreach (var phase in TaskExplorerService.PhaseNodes(_tree.Roots))
                                {
                                    var phasePct = phase.TaskCount == 0 ? 0 : (int)Math.Round((double)phase.CompletedCount / phase.TaskCount * 100);
                                    var phaseStatus = PhaseMarkedDoneLabel(phase.CompletedCount, phase.TaskCount);
                                    var phaseStatusClass = phase.TaskCount == 0 || phase.CompletedCount == 0 ? "not-started" : (phasePct == 100 ? "complete" : "in-progress");
                                    var phaseProgressText = $"{phase.Title}: {phase.CompletedCount} of {phase.TaskCount} task{(phase.TaskCount == 1 ? "" : "s")} marked done in Task artifact";
                                    <div class="te-phase-card">
                                        <div class="te-phase-card-header">
                                            <div class="te-phase-name">@phase.Title</div>
                                            <span class="te-phase-status te-phase-status-@phaseStatusClass">@phaseStatus</span>
                                        </div>
                                        <div class="te-phase-counts">@phase.CompletedCount / @phase.TaskCount marked done</div>
                                        <div class="te-phase-bar" role="progressbar" aria-valuemin="0" aria-valuemax="@phase.TaskCount" aria-valuenow="@phase.CompletedCount" aria-label="@phaseProgressText" data-testid="te-phase-progress">
                                            <div class="te-phase-bar-fill" style="width:@(phasePct)%"></div>
                                        </div>
                                        <div class="te-phase-pct">@(phasePct)%</div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="te-link-visualization">
                        <div class="te-section-kicker">Link Visualization</div>
                        <div class="te-link-visualization-subtitle">How task implementation connects back to specification artifacts.</div>
                        <div class="te-link-paths" aria-label="Traceability relationship paths">
                            <div class="te-link-path">
                                <span class="te-link-node">User Story</span>
                                <span class="te-link-arrow">→</span>
                                <span class="te-link-node">Requirements</span>
                                <span class="te-link-arrow">→</span>
                                <span class="te-link-node">Success Criteria</span>
                                <span class="te-link-arrow">→</span>
                                <span class="te-link-node">Tasks</span>
                            </div>
                            <div class="te-link-path">
                                <span class="te-link-node">Requirement</span>
                                <span class="te-link-arrow">→</span>
                                <span class="te-link-node">Tasks</span>
                            </div>
                            <div class="te-link-path">
                                <span class="te-link-node">Success Criterion</span>
                                <span class="te-link-arrow">→</span>
                                <span class="te-link-node">Tasks</span>
                            </div>
                            <div class="te-link-path">
                                <span class="te-link-node">Task</span>
                                <span class="te-link-arrow">→</span>
                                <span class="te-link-node">Linked Spec Artifacts</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (_isMapView)
            {
                var rootNode = _tree?.Roots.FirstOrDefault();
                var phases = _tree is null ? new List<TaskNode>() : TaskExplorerService.PhaseNodes(_tree.Roots).ToList();
                var allTasks = _tree is null ? new List<TaskNode>() : phases
                    .SelectMany(p => AllNodes(p.Children))
                    .Where(n => n.NodeType == TaskNodeType.Task)
                    .ToList();
                // Roving tab stop: one Map task is in the tab order — the selected one, otherwise the first in reading order.
                var mapOrder = MapTaskOrder(phases);
                var mapTabStopId = mapOrder.Any(t => t.Id == _selectedNodeId) ? _selectedNodeId : mapOrder.FirstOrDefault()?.Id;

                @if (_tree is null)
                {
                    <div class="te-map" @ref="_mapContainer" role="region" tabindex="0" aria-label="Execution map">
                        <div>No execution structure available.</div>
                    </div>
                }
                else
                {
                    <div class="te-map" @ref="_mapContainer" role="region" tabindex="0" aria-label="Execution map: tasks by phase" aria-describedby="te-map-keys" data-testid="te-map">
                        <span id="te-map-keys" class="visually-hidden" data-testid="te-map-keys">Tasks are one tab stop. Use the Up and Down arrow keys to move between tasks, Page Up and Page Down or Left and Right to move to the previous or next phase, Home and End for the first and last task, and Enter or Space to select.</span>
                        <div class="te-map-header pe-section-block">
                            @if (rootNode is not null && rootNode.NodeType == TaskNodeType.TaskGroup)
                            {
                                <div class="te-map-document-title">@rootNode.Title</div>
                            }

                            <div class="te-map-kicker pe-section-kicker">Execution Map</div>

                            <div class="te-map-header-row">
                                <h3 class="te-map-title">Implementation structure by phase</h3>
                                <div class="te-map-summary ce-map-child-count">@phases.Count phases · @allTasks.Count tasks</div>
                            </div>
                        </div>

                        @if (phases.Count == 0)
                        {
                            <div class="te-no-results">No execution phases found.</div>
                        }
                        else
                        {
                            @foreach (var (phase, phaseIndex) in phases.Select((p, i) => (p, i)))
                            {
                                var phaseTasks = AllNodes(phase.Children).Where(n => n.NodeType == TaskNodeType.Task).ToList();
                                var taskGroups = phase.Children.Where(IsExecutionGroup).ToList();
                                var directTasks = phase.Children.Where(n => n.NodeType == TaskNodeType.Task).ToList();

                                <div class="te-map-phase-card pe-section-block">
                                    <!-- Phase header -->
                                    <div class="te-map-phase-header">
                                        <h3 class="te-map-phase-title">@phase.Title</h3>
                                        <div class="te-map-phase-count">@phaseTasks.Count task@(phaseTasks.Count != 1 ? "s" : "")</div>
                                    </div>

                                    <!-- Task groups -->
                                    @foreach (var group in taskGroups)
                                    {
                                        var groupTasks = AllNodes(group.Children).Where(n => n.NodeType == TaskNodeType.Task).ToList();

                                        <div class="te-map-group">
                                            <div class="te-map-group-header">
                                                <span class="te-map-group-title">@group.Title</span>
                                                <span class="te-map-group-count">@groupTasks.Count task@(groupTasks.Count != 1 ? "s" : "")</span>
                                            </div>

                                            <ul class="te-map-task-list" aria-label="@group.Title">
                                                @foreach (var task in groupTasks)
                                                {
                                                    @MapTaskItem(task, phaseIndex, mapTabStopId)
                                                }
                                            </ul>
                                        </div>
                                    }

                                    <!-- Direct task children -->
                                    @if (directTasks.Count > 0)
                                    {
                                        <ul class="te-map-task-list te-map-task-list-direct" aria-label="@phase.Title">
                                            @foreach (var task in directTasks)
                                            {
                                                @MapTaskItem(task, phaseIndex, mapTabStopId)
                                            }
                                        </ul>
                                    }
                                </div>
                            }
                        }
                    </div>
                }
            }
            else
            {
            <div class="te-tree" role="tree">
                @if (_flatCache.Count == 0)
                {
                    <div class="te-no-results">
                        @if (!string.IsNullOrWhiteSpace(_searchQuery) || _activeFilter is not null)
                        {
                            <span>No tasks match the current search or filter.</span>
                        }
                        else if (_tree.Roots.Count == 0)
                        {
                            <span>No tasks detected. Task Explorer expects headings and task IDs such as T001, T002 in the Task artifact.</span>
                        }
                        else
                        {
                            <span>No results.</span>
                        }
                    </div>
                }
                else
                {
                    @for (var i = 0; i < _flatCache.Count; i++)
                    {
                        var (node, depth, isMatch) = _flatCache[i];

                        // Hide Format/documentation-only TaskGroup nodes (presentation-level filtering)
                        if (IsFormatGuidanceNode(node))
                        {
                            continue;
                        }

                        var hasChildren = node.Children.Count > 0;
                        var isExpanded = _expandedIds.Contains(node.Id);
                        var isSelected = _selectedNodeId == node.Id;
                        var isHeading = node.HeadingLevel > 0;
                        var isPhase = node.NodeType == TaskNodeType.Phase;

                        <div class="te-row @(isSelected ? "is-selected" : "") @TreeFilterMatchClass(isMatch) @(isHeading || node.NodeType == TaskNodeType.TableSection ? "is-heading" : "is-item")"
                             style="--te-depth: @depth"
                             role="treeitem"
                             aria-selected="@isSelected.ToString().ToLower()"
                             @onclick="() => HandleNodeClick(node)">

                            <span class="te-expand-cell">
                                @if (hasChildren)
                                {
                                    <button class="te-expand-btn"
                                            aria-label="@(isExpanded ? "Collapse" : "Expand")"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => ToggleExpand(node.Id)">
                                        @(isExpanded ? "▼" : "▶")
                                    </button>
                                }
                                else
                                {
                                    <span class="te-expand-leaf">•</span>
                                }
                            </span>

                            <span class="te-node-icon" aria-hidden="true">@GetIcon(node.NodeType)</span>

                            @if (node.NodeType == TaskNodeType.Task)
                            {
                                <span class="te-task-check @(node.IsCompleted ? "is-done" : "")" role="img" data-testid="te-task-check"
                                      aria-label="@(node.IsCompleted ? "Marked done in Task artifact" : "Open in Task artifact")"
                                      title="@(node.IsCompleted ? "Marked done in Task artifact" : "Open in Task artifact")">@(node.IsCompleted ? "✓" : "○")</span>
                            }

                            @* The tree shows a task's text wrapped and selectable; very long tasks show a preview that says so, and the
                               details panel always has the whole text. The short title is for the compact map views. *@
                            <span class="te-node-title @(node.NodeType == TaskNodeType.Task && node.IsCompleted ? "is-done" : "")">
                                @if (node.NodeType == TaskNodeType.Task && node.Title.Length > TreeTitlePreviewChars)
                                {
                                    @TreePreview(node.Title)<span class="te-node-more" data-testid="te-node-preview">… <span class="visually-hidden">(preview; </span>full text in details<span class="visually-hidden">)</span></span>
                                }
                                else
                                {
                                    @(node.NodeType == TaskNodeType.Task ? node.Title : node.ShortTitle ?? node.Title)
                                }
                                @if (node.TaskId is not null && node.NodeType == TaskNodeType.Task)
                                {
                                    <span class="te-task-id">@node.TaskId</span>
                                }
                            </span>

                            @if (!isExpanded && hasChildren && node.TotalDescendants > 0)
                            {
                                <span class="te-child-count">(@node.TotalDescendants)</span>
                            }

                            <!-- Task chips -->
                            @if (node.NodeType == TaskNodeType.Task)
                            {
                                <span class="te-chips">
                                    @if (node.UserStoryTag is not null)
                                    {
                                        <span class="te-chip te-chip-us" title="@GetUserStoryTitle(node)">@UserStoryDisplay(node)</span>
                                    }
                                    @if (node.IsParallel)
                                    {
                                        <span class="te-chip te-chip-parallel" data-testid="te-parallel-chip" title="The Task artifact marks this task as parallelizable: it can run in parallel with other tasks. Planning, not progress.">Parallelizable</span>
                                    }
                                    @if (node.Status.HasValue)
                                    {
                                        <span class="te-chip te-chip-status te-chip-status-@StatusKey(node.Status.Value)">@StatusLabel(node.Status.Value)</span>
                                    }
                                    @if (node.Risk == AlignmentRisk.High)
                                    {
                                        <span class="te-chip te-chip-risk">High Risk</span>
                                    }
                                    @if (node.IsRegressionCandidate)
                                    {
                                        <span class="te-chip te-chip-reg">Regression</span>
                                    }
                                </span>
                            }

                            <!-- Heading task count -->
                            @if (isHeading && node.TaskCount > 0)
                            {
                                <span class="te-meta-chips">
                                    <span class="te-meta-chip" data-testid="te-group-done" title="@node.CompletedCount of @node.TaskCount tasks marked done in the Task artifact">@node.CompletedCount / @node.TaskCount done<span class="visually-hidden"> in the Task artifact</span></span>
                                </span>
                            }

                            <!-- FR/SC/table ref chips on task rows -->
                            @{
                                var tableRelationships = node.NodeType == TaskNodeType.Task
                                    ? GetTableRelationships(node.TaskId)
                                    : new List<TableRelationship>();
                            }

                            @if (node.NodeType == TaskNodeType.Task && (node.ReferencedFrIds.Count > 0 || node.ReferencedScIds.Count > 0 || tableRelationships.Count > 0))
                            {
                                <span class="te-ref-chips">
                                    @foreach (var fr in node.ReferencedFrIds.Take(2))
                                    {
                                        var frCapture = fr;
                                        <button class="te-ref-chip te-ref-fr" @onclick:stopPropagation="true" @onclick='() => SetSearch(frCapture)' title="Functional Requirement @frCapture">@frCapture</button>
                                    }
                                    @foreach (var sc in node.ReferencedScIds.Take(2))
                                    {
                                        var scCapture = sc;
                                        <button class="te-ref-chip te-ref-sc" @onclick:stopPropagation="true" @onclick='() => SetSearch(scCapture)' title="Success Criterion @scCapture">@scCapture</button>
                                    }
                                    @foreach (var rel in tableRelationships.Take(2))
                                    {
                                        <span class="te-ref-chip te-ref-table" title="Linked table row: @rel.RowTitle">TABLE · @rel.RowTitle</span>
                                    }
                                    @{ var refOverflow = node.ReferencedFrIds.Count + node.ReferencedScIds.Count + tableRelationships.Count - 6; }
                                    @if (refOverflow > 0)
                                    {
                                        <span class="te-ref-chip te-ref-more">+@refOverflow</span>
                                    }
                                </span>
                            }

                            @if (node.NodeType == TaskNodeType.Task)
                            {
                                @RenderEvidenceChips(node)
                            }

                            @if (node.NodeType == TaskNodeType.TableSection && node.TableKind != TaskTableType.Generic)
                            {
                                <span class="te-table-kind-badge te-tkind-@TableKindName(node.TableKind)">@TableKindLabel(node.TableKind)</span>
                            }

                            @if (node.NodeType == TaskNodeType.TableTaskRef && node.IsUnresolved)
                            {
                                <span class="te-unresolved-badge">unresolved</span>
                            }

                            <!-- TableRow linked task preview -->
                            @if (node.NodeType == TaskNodeType.TableRow && node.LinkedTaskIds.Count > 0)
                            {
                                <span class="te-table-link-count">@node.LinkedTaskIds.Count task ref@(node.LinkedTaskIds.Count != 1 ? "s" : "")</span>
                            }
                        </div>

                        <!-- Phase metadata rendering -->
                        @if (isPhase && isExpanded)
                        {
                            @if (!string.IsNullOrEmpty(node.PhasePurpose))
                            {
                                <div class="te-metadata-section" style="padding-left: @((depth + 1) * 16 + 6)px">
                                    <div class="te-metadata-label">Purpose</div>
                                    <MarkdownContent Content="@node.PhasePurpose" CssClass="te-metadata-content" />
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(node.PhaseGoal))
                            {
                                <div class="te-metadata-section" style="padding-left: @((depth + 1) * 16 + 6)px">
                                    <div class="te-metadata-label">Goal</div>
                                    <MarkdownContent Content="@node.PhaseGoal" CssClass="te-metadata-content" />
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(node.PhaseIndependentTest))
                            {
                                <div class="te-metadata-section" style="padding-left: @((depth + 1) * 16 + 6)px">
                                    <div class="te-metadata-label">Independent Test</div>
                                    <MarkdownContent Content="@node.PhaseIndependentTest" CssClass="te-metadata-content" />
                                </div>
                            }
                        }

                        <!-- Render Checkpoint when transitioning out of phase children -->
                        @if (isPhase && isExpanded)
                        {
                            var isLastChild = i + 1 >= _flatCache.Count;
                            var nextIsNotChild = !isLastChild && _flatCache[i + 1].Depth <= depth;

                            if ((isLastChild || nextIsNotChild) && !string.IsNullOrEmpty(node.PhaseCheckpoint))
                            {
                                <div class="te-metadata-section" style="padding-left: @((depth + 1) * 16 + 6)px">
                                    <div class="te-metadata-label">Checkpoint</div>
                                    <MarkdownContent Content="@node.PhaseCheckpoint" CssClass="te-metadata-content" />
                                </div>
                            }
                        }
                    }
                }
            </div>
            }

            <!-- ── Details Panel ──────────────────────────────────────────── -->
            @if (ShouldShowTaskDetails)
            {
                var selected = SelectedNode;
                @if (selected is not null)
                {
                    <div class="te-details">
                        <div class="te-details-header">
                            <span class="te-details-type">@NodeTypeLabel(selected.NodeType)</span>
                            <button class="te-details-close" @onclick='() => _selectedNodeId = null' aria-label="Close details">×</button>
                        </div>

                        @if (selected.TaskId is not null)
                        {
                            <div class="te-details-task-id">@selected.TaskId</div>
                        }

                        @{
                            // The full task text, once: wrapped and selectable, clamped with Show more only when it is long.
                            var detailTitle = selected.NodeType == TaskNodeType.Task ? selected.Title : selected.ShortTitle ?? selected.Title;
                            var titleIsLong = detailTitle.Length > DetailTitleClampChars;
                            var titleExpanded = _expandedTitleNodeId == selected.Id;
                        }
                        <h3 class="te-details-title @(titleIsLong && !titleExpanded ? "is-clamped" : "")" id="te-details-title" data-testid="te-details-title">@detailTitle</h3>
                        @if (titleIsLong)
                        {
                            <button type="button" class="te-details-more" data-testid="te-details-title-toggle" aria-controls="te-details-title"
                                    aria-expanded="@(titleExpanded ? "true" : "false")" @onclick="() => _expandedTitleNodeId = titleExpanded ? null : selected.Id">@(titleExpanded ? "Show less" : "Show more")</button>
                        }

                        @if (selected.NodeType == TaskNodeType.Task)
                        {
                            @if (!string.IsNullOrEmpty(selected.PhaseTitle) || !string.IsNullOrEmpty(selected.UserStoryTitle))
                            {
                                <div class="te-details-section">
                                    <div class="te-details-label">Context</div>
                                    @if (!string.IsNullOrEmpty(selected.PhaseTitle))
                                    {
                                        <div><span class="te-det-chip">🗂 @selected.PhaseTitle</span></div>
                                    }
                                    @if (!string.IsNullOrEmpty(selected.UserStoryTitle))
                                    {
                                        <div><span class="te-det-chip te-chip-us" title="@GetUserStoryTitle(selected)">👤 @UserStoryContextDisplay(selected)</span></div>
                                    }
                                </div>
                            }

                            @* Status is the Task artifact's own state only; topics and evidence have their own sections. *@
                            <div class="te-details-section" data-testid="te-detail-status">
                                <div class="te-details-label">Status</div>
                                <div class="te-details-status-row">
                                    <span class="te-completion-badge @(selected.IsCompleted ? "is-done" : "is-open")">
                                        @(selected.IsCompleted ? "✓ Marked done in Task artifact" : "○ Open in Task artifact")
                                    </span>
                                </div>
                            </div>

                            var topics = TaskTopics(selected);
                            <div class="te-details-section" data-testid="te-detail-topics">
                                <div class="te-details-label">Task topics</div>
                                @if (topics.Count == 0)
                                {
                                    <p class="te-detail-empty">No topics detected in the task text.</p>
                                }
                                else
                                {
                                    <div class="te-details-status-row">
                                        @foreach (var topic in topics)
                                        {
                                            <span class="te-chip @topic.CssClass" title="@topic.Title">@topic.Label</span>
                                        }
                                    </div>
                                    <p class="te-detail-note">From the Task artifact's wording and markers. Topics are not traceability links or evidence.</p>
                                }
                            </div>

                            var taskEvidence = Evidence.For(selected);
                            var tableRows = GetTableRelationships(selected.TaskId);
                            var hasNoLinks = TaskExplorerService.HasNoTraceabilityLinks(selected, _tableLinkedTaskIds);
                            <div class="te-details-section te-task-details-card" data-testid="te-task-details">
                                <section class="te-detail-group" data-testid="te-detail-traceability" aria-labelledby="te-detail-traceability-h">
                                    <h4 class="te-detail-group-title" id="te-detail-traceability-h">Traceability</h4>
                                    @if (hasNoLinks)
                                    {
                                        <p class="te-detail-empty" data-testid="te-detail-no-links">No traceability links: the task references no requirement, success criterion or user story, matches no specification item and is in no traceability-table row.</p>
                                    }
                                    else
                                    {
                                        <dl class="te-detail-grid">
                                            <div>
                                                <dt>User story</dt>
                                                <dd>@DisplayOrEmpty(UserStoryDisplay(selected))</dd>
                                            </div>
                                            <div>
                                                <dt>Requirements (FR)</dt>
                                                <dd>@DisplayListOrEmpty(selected.ReferencedFrIds)</dd>
                                            </div>
                                            <div>
                                                <dt>Success criteria (SC)</dt>
                                                <dd>@DisplayListOrEmpty(selected.ReferencedScIds)</dd>
                                            </div>
                                            @if (selected.SpecMatches.Count > 0)
                                            {
                                                <div>
                                                    <dt>Matched specification items</dt>
                                                    <dd>@selected.SpecMatches.Count matched (listed below)</dd>
                                                </div>
                                            }
                                            @if (tableRows.Count > 0)
                                            {
                                                <div>
                                                    <dt>Traceability-table rows</dt>
                                                    <dd>@string.Join(", ", tableRows.Select(r => r.RowTitle))</dd>
                                                </div>
                                            }
                                            <div>
                                                <dt>Coverage impact</dt>
                                                <dd>@CoverageImpactLabel(selected)</dd>
                                            </div>
                                        </dl>
                                    }
                                    <button class="te-traceability-link" @onclick='() => OpenInTraceability(selected)'>Open in Traceability</button>
                                </section>

                                <section class="te-detail-group" data-testid="te-detail-test-assets" aria-labelledby="te-detail-tests-h">
                                    <h4 class="te-detail-group-title" id="te-detail-tests-h">Test assets</h4>
                                    <p class="@(taskEvidence.Tests.Any ? "te-detail-value" : "te-detail-empty")" data-testid="te-detail-tests">@TestText(taskEvidence)</p>
                                    @if (!taskEvidence.TestsAssessed)
                                    {
                                        <a class="te-detail-cta" href="implementation-review" data-testid="te-detail-tests-cta">Import test results in Implementation Evidence Review</a>
                                    }
                                </section>

                                <section class="te-detail-group" data-testid="te-detail-implementation-group" aria-labelledby="te-detail-impl-h">
                                    <h4 class="te-detail-group-title" id="te-detail-impl-h">Implementation</h4>
                                    <p class="@(taskEvidence.Implementation is ImplementationEvidenceState.NotAssessed or ImplementationEvidenceState.NoLinkedRequirement ? "te-detail-empty" : "te-detail-value")" data-testid="te-detail-implementation">@ImplementationText(taskEvidence)</p>
                                    @if (!Evidence.ImplementationAssessed)
                                    {
                                        <a class="te-detail-cta" href="implementation-review" data-testid="te-detail-implementation-cta">Open Implementation Evidence Review</a>
                                    }
                                </section>
                            </div>

                            @if (!string.IsNullOrEmpty(selected.RawText))
                            {
                                <details class="te-details-section te-details-raw-wrap" data-testid="te-detail-raw">
                                    <summary class="te-details-label">Line in Task artifact</summary>
                                    <div class="te-details-raw">@selected.RawText</div>
                                </details>
                            }

                            @if (selected.Status.HasValue)
                            {
                                <div class="te-details-section">
                                    <div class="te-details-label">Spec Alignment</div>
                                    <span class="te-status-badge te-status-@StatusKey(selected.Status.Value)">@StatusLabel(selected.Status.Value)</span>
                                </div>
                            }

                            @if (selected.Risk.HasValue)
                            {
                                <div class="te-details-section">
                                    <div class="te-details-label">Risk Level</div>
                                    <span class="te-risk-badge te-risk-@selected.Risk.Value.ToString().ToLower()">@selected.Risk.Value</span>
                                    @if (selected.IsRegressionCandidate)
                                    {
                                        <span class="te-chip te-chip-reg" style="margin-left:0.4rem">Regression Candidate</span>
                                    }
                                </div>
                            }

                            @if (selected.SpecMatches.Count > 0)
                            {
                                <div class="te-details-section">
                                    <div class="te-details-label">Matched Spec Items (@selected.SpecMatches.Count)</div>
                                    <ul class="te-details-list">
                                        @foreach (var m in selected.SpecMatches.Take(6))
                                        {
                                            <li>
                                                <span class="te-match-type te-match-@m.MatchType.ToString().ToLower()">@m.MatchType</span>
                                                @m.ItemId @m.Title
                                            </li>
                                        }
                                        @if (selected.SpecMatches.Count > 6)
                                        {
                                            <li class="te-list-more">+@(selected.SpecMatches.Count - 6) more</li>
                                        }
                                    </ul>
                                </div>
                            }

                            @if (selected.AffectedAreas.Count > 0)
                            {
                                <div class="te-details-section">
                                    <div class="te-details-label">Affected Areas</div>
                                    <div class="te-area-chips">
                                        @foreach (var area in selected.AffectedAreas)
                                        {
                                            <span class="te-area-chip">@area</span>
                                        }
                                    </div>
                                </div>
                            }

                            @if (selected.ReferencedFrIds.Count > 0 || selected.ReferencedScIds.Count > 0)
                            {
                                <div class="te-details-section">
                                    <div class="te-details-label">Inline References</div>
                                    <div class="te-ref-chips">
                                        @foreach (var fr in selected.ReferencedFrIds)
                                        {
                                            var frCap = fr;
                                            <button class="te-ref-chip te-ref-fr" @onclick='() => SetSearch(frCap)' title="Functional Requirement @frCap">@frCap</button>
                                        }
                                        @foreach (var sc in selected.ReferencedScIds)
                                        {
                                            var scCap = sc;
                                            <button class="te-ref-chip te-ref-sc" @onclick='() => SetSearch(scCap)' title="Success Criterion @scCap">@scCap</button>
                                        }
                                    </div>
                                </div>
                            }

                            @if (selected.RelatedFiles.Count > 0)
                            {
                                <div class="te-details-section">
                                    <div class="te-details-label">Related Files</div>
                                    <ul class="te-details-list te-file-list">
                                        @foreach (var f in selected.RelatedFiles)
                                        {
                                            <li class="te-file-path"><code>@f</code></li>
                                        }
                                    </ul>
                                </div>
                            }

                            var tableRels = GetTableRelationships(selected.TaskId);
                            @if (tableRels.Count > 0)
                            {
                                <div class="te-details-section">
                                    <div class="te-details-label">Table Relationships</div>
                                    <ul class="te-details-list">
                                        @foreach (var rel in tableRels)
                                        {
                                            <li>
                                                <span class="te-table-rel-source">@rel.TableTitle</span>
                                                <span class="te-table-rel-row">→ @rel.RowTitle</span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        }

                        @if (selected.NodeType == TaskNodeType.TableSection)
                        {
                            <div class="te-details-section">
                                <div class="te-details-label">Table Type</div>
                                <span class="te-table-kind-badge te-tkind-@TableKindName(selected.TableKind)">@TableKindLabel(selected.TableKind)</span>
                            </div>
                            @if (selected.TableHeaders.Count > 0)
                            {
                                <div class="te-details-section">
                                    <div class="te-details-label">Columns (@selected.TableHeaders.Count)</div>
                                    <div class="te-details-col-list">
                                        @foreach (var h in selected.TableHeaders)
                                        {
                                            <span class="te-col-chip">@h</span>
                                        }
                                    </div>
                                </div>
                            }
                            var tsRows = selected.Children.Where(c => c.NodeType == TaskNodeType.TableRow).ToList();
                            var tsLinkedIds = tsRows.SelectMany(r => r.LinkedTaskIds).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
                            var tsScRefs = tsRows.SelectMany(r => r.ReferencedScIds).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
                            var tsFrRefs = tsRows.SelectMany(r => r.ReferencedFrIds).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
                            @if (tsRows.Count > 0)
                            {
                                <div class="te-details-section">
                                    <div class="te-details-label">Rows (@tsRows.Count)</div>
                                    <ul class="te-details-list">
                                        @foreach (var row in tsRows.Take(8))
                                        {
                                            <li>@row.Title</li>
                                        }
                                        @if (tsRows.Count > 8)
                                        {
                                            <li class="te-list-more">+@(tsRows.Count - 8) more</li>
                                        }
                                    </ul>
                                </div>
                            }
                            @if (tsLinkedIds.Count > 0)
                            {
                                <div class="te-details-section">
                                    <div class="te-details-label">Linked Tasks (@tsLinkedIds.Count)</div>
                                    <div class="te-ref-chips">
                                        @foreach (var tid in tsLinkedIds.Take(10))
                                        {
                                            var tidCap = tid;
                                            <button class="te-ref-chip te-ref-task" @onclick='() => NavigateToTask(tidCap)' title="Go to @tid">@tid</button>
                                        }
                                        @if (tsLinkedIds.Count > 10)
                                        {
                                            <span class="te-ref-chip te-ref-more">+@(tsLinkedIds.Count - 10)</span>
                                        }
                                    </div>
                                </div>
                            }
                            @if (tsScRefs.Count > 0)
                            {
                                <div class="te-details-section">
                                    <div class="te-details-label">SC References</div>
                                    <div class="te-ref-chips">
                                        @foreach (var sc in tsScRefs)
                                        {
                                            <span class="te-ref-chip te-ref-sc" title="Success Criterion @sc">@sc</span>
                                        }
                                    </div>
                                </div>
                            }
                            @if (tsFrRefs.Count > 0)
                            {
                                <div class="te-details-section">
                                    <div class="te-details-label">FR References</div>
                                    <div class="te-ref-chips">
                                        @foreach (var fr in tsFrRefs)
                                        {
                                            <span class="te-ref-chip te-ref-fr" title="Functional Requirement @fr">@fr</span>
                                        }
                                    </div>
                                </div>
                            }
                        }

                        @if (selected.NodeType == TaskNodeType.TableRow)
                        {
                            @if (selected.LinkedTaskIds.Count > 0)
                            {
                                <div class="te-details-section">
                                    <div class="te-details-label">Linked Tasks</div>
                                    <div class="te-ref-chips">
                                        @foreach (var tid in selected.LinkedTaskIds)
                                        {
                                            var isUnres = IsTaskRefUnresolved(selected, tid);
                                            var tidCap = tid;
                                            <button class="te-ref-chip @(isUnres ? "te-ref-unresolved" : "te-ref-task")" @onclick='() => NavigateToTask(tidCap)' title="Go to @tid">@tid@(isUnres ? " ?" : "")</button>
                                        }
                                    </div>
                                </div>
                            }
                            @if (selected.ReferencedFrIds.Count > 0)
                            {
                                <div class="te-details-section">
                                    <div class="te-details-label">FR References</div>
                                    <div class="te-ref-chips">
                                        @foreach (var fr in selected.ReferencedFrIds)
                                        {
                                            <span class="te-ref-chip te-ref-fr" title="Functional Requirement @fr">@fr</span>
                                        }
                                    </div>
                                </div>
                            }
                            @if (selected.ReferencedScIds.Count > 0)
                            {
                                <div class="te-details-section">
                                    <div class="te-details-label">SC References</div>
                                    <div class="te-ref-chips">
                                        @foreach (var sc in selected.ReferencedScIds)
                                        {
                                            <span class="te-ref-chip te-ref-sc" title="Success Criterion @sc">@sc</span>
                                        }
                                    </div>
                                </div>
                            }
                            @if (selected.CellValues.Count > 0)
                            {
                                var parentSection = FindParentTableSection(_tree.Roots, selected.Id);
                                <div class="te-details-section">
                                    <div class="te-details-label">All Columns</div>
                                    <ul class="te-details-list">
                                        @for (int ci = 0; ci < selected.CellValues.Count; ci++)
                                        {
                                            var colName = parentSection is not null && ci < parentSection.TableHeaders.Count
                                                ? parentSection.TableHeaders[ci] + ": "
                                                : "";
                                            <li><span class="te-col-name">@colName</span>@selected.CellValues[ci]</li>
                                        }
                                    </ul>
                                </div>
                            }
                        }

                        @if (selected.HeadingLevel > 0 && selected.TotalDescendants > 0)
                        {
                            <div class="te-details-section">
                                <div class="te-details-label">Contents</div>
                                <div class="te-details-counts">
                                    @if (selected.TaskCount > 0)
                                    {
                                        <span class="te-det-chip">@selected.TaskCount tasks</span>
                                    }
                                    @if (selected.CompletedCount > 0)
                                    {
                                        <span class="te-det-chip te-mc-done">@selected.CompletedCount marked done</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    }
</div>

@inject IJSRuntime JS

@code {
    [Parameter] public string TasksText { get; set; } = string.Empty;
    [Parameter] public TaskTree? ParsedTasks { get; set; }
    [Parameter] public TaskSemanticModel? SemanticModel { get; set; }
    [Parameter] public AlignmentReport? Report { get; set; }
    [Parameter] public EventCallback<string> OnTextChanged { get; set; }
    [Parameter] public string? InitialView { get; set; }
    /// <summary>Implementation and test evidence from the SDD lifecycle graph, per linked requirement. Not assessed by default.</summary>
    [Parameter] public TaskEvidenceIndex Evidence { get; set; } = TaskEvidenceIndex.NotAssessed;

    private IReadOnlyList<TaskNode> AllTasks => _tree is null ? [] : AllNodes(_tree.Roots).Where(n => n.NodeType == TaskNodeType.Task).ToList();

    private int FilteredTaskCount => _activeFilter is null ? _health.TotalTasks
        : AllTasks.Count(t => TaskExplorerService.MatchesFilter(t, _activeFilter, _tableLinkedTaskIds, Evidence));

    /// <summary>
    /// The Map's tasks in reading order (per phase: grouped tasks first, then the phase's direct tasks), which is the order
    /// the arrow keys walk and the order the roving tab stop falls back to.
    /// </summary>
    internal static List<TaskNode> MapTaskOrder(IEnumerable<TaskNode> phases) => phases
        .SelectMany(phase => phase.Children.Where(IsExecutionGroup)
            .SelectMany(group => AllNodes(group.Children).Where(n => n.NodeType == TaskNodeType.Task))
            .Concat(phase.Children.Where(n => n.NodeType == TaskNodeType.Task)))
        .ToList();

    /// <summary>
    /// One Map task: a list item holding a button (keyboard-reachable, announced as current when selected). The Map is a
    /// set of lists under phase headings, not an ARIA tree; the hierarchical Tree view owns the tree pattern.
    /// </summary>
    private RenderFragment MapTaskItem(TaskNode task, int phaseIndex, string? tabStopId) => __builder =>
    {
        var isSelected = _selectedNodeId == task.Id;
        <li class="te-map-task-item">
            <button type="button" class="te-map-task @(isSelected ? "is-selected" : "")" aria-current="@(isSelected ? "true" : null)"
                    tabindex="@(task.Id == tabStopId ? "0" : "-1")" data-map-phase="@phaseIndex"
                    title="@task.Title" data-task-id="@task.TaskId" @onclick="@(() => HandleNodeClick(task))">
                <span class="te-map-task-id">@(task.TaskId ?? "")</span>
                <span class="te-map-task-content">
                    <span class="te-map-task-title">@(task.ShortTitle ?? task.Title)</span>
                </span>
                <span class="te-map-task-chips">
                    @if (task.UserStoryTag is not null)
                    {
                        <span class="te-chip te-chip-us" title="@GetUserStoryTitle(task)">@UserStoryDisplay(task)</span>
                    }
                    @if (task.IsCompleted)
                    {
                        <span class="te-map-status-badge" title="Marked done in Task artifact">Marked done</span>
                    }
                    @if (task.IsParallel)
                    {
                        <span class="te-map-parallel-badge">Parallelizable</span>
                    }
                </span>
            </button>
        </li>
    };

    private RenderFragment Chip(string? key, string label, string title, string extraClass = "") => __builder =>
    {
        var active = _activeFilter == key;
        <button type="button" class="te-filter-chip @extraClass @(active ? "is-active" : "")" aria-pressed="@(active ? "true" : "false")"
                title="@title" data-filter="@(key ?? "All")" @onclick="() => SetFilter(key)">@label</button>
    };

    /// <summary>
    /// Task artifact · status · planning · traceability · implementation evidence · test evidence: separate facts, never one
    /// score. Implementation and test evidence say "Not assessed" when nothing was looked at.
    /// </summary>
    private RenderFragment RenderSummary() => __builder =>
    {
        var tasks = AllTasks;
        var total = _health.TotalTasks;
        var done = _health.CompletedTasks;
        var percent = total > 0 ? (int)Math.Round((double)done / total * 100) : 0;
        var evidence = tasks.Select(Evidence.For).ToList();
        <dl class="te-summary" data-testid="te-summary">
            <div class="te-summary-item" data-testid="te-summary-artifact">
                <dt>Task artifact</dt>
                <dd>@total task@(total == 1 ? "" : "s") · @_health.TotalPhases phase@(_health.TotalPhases == 1 ? "" : "s")</dd>
            </div>
            <div class="te-summary-item" data-testid="te-summary-status">
                <dt>Marked done in Task artifact</dt>
                <dd>@done / @total <span class="te-summary-sub">(@percent%)</span></dd>
            </div>
            <div class="te-summary-item" data-testid="te-summary-planning">
                <dt>Planning</dt>
                <dd>@_health.ParallelTasks parallelizable task@(_health.ParallelTasks == 1 ? "" : "s")</dd>
            </div>
            <div class="te-summary-item" data-testid="te-summary-traceability">
                <dt>Traceability</dt>
                <dd>@_health.LinkedTasks with traceability links · @_health.UnlinkedTasks with no traceability links</dd>
            </div>
            <div class="te-summary-item" data-testid="te-summary-implementation">
                <dt>Implementation evidence</dt>
                @if (!Evidence.ImplementationAssessed)
                {
                    <dd>Not assessed <span class="te-summary-sub">· no current Source Analysis or implementation evidence</span> <a class="te-summary-link" href="implementation-review">Implementation Evidence Review</a></dd>
                }
                else
                {
                    <dd>@evidence.Count(e => e.Implementation == ImplementationEvidenceState.Current) current · @evidence.Count(e => e.Implementation is ImplementationEvidenceState.Stale or ImplementationEvidenceState.Historical) stale · @evidence.Count(e => e.Implementation == ImplementationEvidenceState.None) none<span class="te-summary-sub"> · via linked requirements</span></dd>
                }
            </div>
            <div class="te-summary-item" data-testid="te-summary-tests">
                <dt>Test evidence</dt>
                @if (!Evidence.TestsAssessed)
                {
                    <dd>Not assessed <span class="te-summary-sub">· no designed tests or test executions recorded</span> <a class="te-summary-link" href="implementation-review">Import test results in Implementation Evidence Review</a></dd>
                }
                else
                {
                    <dd>@evidence.Count(e => e.Tests.Designed > 0) designed · @evidence.Count(e => e.Tests.Executed > 0) executed · @evidence.Count(e => e.Tests.Executed > 0 && e.Tests.Failed == 0 && e.Tests.Passed > 0) passed · @evidence.Count(e => e.Tests.Failed > 0) failing<span class="te-summary-sub"> · tasks, via linked requirements</span></dd>
                }
            </div>
        </dl>
    };

    /// <summary>Evidence badges on a task row: shown only when the evidence was assessed, never derived from the checkbox.</summary>
    private RenderFragment RenderEvidenceChips(TaskNode node) => __builder =>
    {
        var evidence = Evidence.For(node);
        if (evidence.Implementation is ImplementationEvidenceState.NoLinkedRequirement or ImplementationEvidenceState.NotAssessed && !evidence.Tests.Any) return;
        <span class="te-ev-chips">
            @if (evidence.Implementation is not (ImplementationEvidenceState.NoLinkedRequirement or ImplementationEvidenceState.NotAssessed))
            {
                <span class="te-ev-chip is-@evidence.Implementation.ToString().ToLowerInvariant()" data-testid="te-impl-chip" title="@ImplementationText(evidence)">
                    <span aria-hidden="true">&lt;/&gt; </span><span class="visually-hidden">Implementation evidence: </span>@(evidence.Implementation switch { ImplementationEvidenceState.Current => "Current", ImplementationEvidenceState.Stale => "Stale", ImplementationEvidenceState.Historical => "Historical", _ => "None" })
                </span>
            }
            @if (evidence.Tests.Any)
            {
                <span class="te-ev-chip @(evidence.Tests.Failed > 0 ? "is-failed" : "")" data-testid="te-test-chip" title="@TestText(evidence)">
                    <span aria-hidden="true">▷ </span><span class="visually-hidden">Test evidence: </span>@TestShort(evidence.Tests)
                </span>
            }
        </span>
    };

    /// <summary>Tree rows preview task text longer than this; the details panel shows the whole text.</summary>
    private const int TreeTitlePreviewChars = 240;

    /// <summary>The start of a long task text, cut at a word boundary.</summary>
    private static string TreePreview(string text)
    {
        var cut = text.LastIndexOf(' ', TreeTitlePreviewChars);
        return text[..(cut > TreeTitlePreviewChars / 2 ? cut : TreeTitlePreviewChars)].TrimEnd(' ', ',', ';', ':');
    }

    /// <summary>Detail-pane titles longer than this are clamped behind Show more; shorter ones are shown whole.</summary>
    private const int DetailTitleClampChars = 220;
    private string? _expandedTitleNodeId;

    private sealed record TaskTopic(string Label, string CssClass, string Title);

    /// <summary>
    /// Topics of one task, from the Task artifact's marker ([P]) and wording (testing, security, architecture keywords).
    /// Metadata only: never task status, a traceability link or evidence.
    /// </summary>
    private static List<TaskTopic> TaskTopics(TaskNode node)
    {
        var topics = new List<TaskTopic>();
        if (node.IsParallel) topics.Add(new("Parallelizable", "te-chip-parallel", "The Task artifact marks this task as parallelizable: it can run in parallel with other tasks. Planning, not progress."));
        if (node.IsTestingTask) topics.Add(new("Testing", "te-chip-testing", "The task text describes testing work. Not a linked test asset and not a test result."));
        if (node.IsSecurityTask) topics.Add(new("Security", "te-chip-security", "The task text describes security work. Not a security check."));
        if (IsArchitectureTask(node)) topics.Add(new("Architecture", "te-chip-architecture", "The task text describes architecture or infrastructure work. Not a linked architecture note."));
        return topics;
    }

    /// <summary>A phase's share of tasks marked done in the Task artifact, in words (not implementation progress).</summary>
    private static string PhaseMarkedDoneLabel(int done, int total) =>
        total == 0 ? "No tasks" : done == 0 ? "None marked done" : done >= total ? "All marked done" : "Partly marked done";

    private static string TestShort(TaskTestEvidence t) =>
        t.Failed > 0 ? $"{t.Failed} failed" : t.Passed > 0 ? $"{t.Passed} passed" : t.Executed > 0 ? $"{t.Executed} executed" : $"{t.Designed} designed";

    private string ImplementationText(TaskEvidence e)
    {
        var via = e.Requirements.Count == 0 ? "" : $" (via {string.Join(", ", e.Requirements)})";
        return e.Implementation switch
        {
            ImplementationEvidenceState.Current => $"Current implementation evidence{via}. Evidence is not proof of correctness.",
            ImplementationEvidenceState.Stale => $"Potentially stale implementation evidence{via}: the source changed since it was linked.",
            ImplementationEvidenceState.Historical => $"Only historical implementation evidence{via}.",
            ImplementationEvidenceState.None => $"No implementation evidence{via}.",
            ImplementationEvidenceState.NoLinkedRequirement => "Not resolvable: the task references no requirement of the current specification.",
            _ => "Not assessed: no Source Analysis or implementation evidence in this workspace.",
        };
    }

    private string TestText(TaskEvidence e) => !e.TestsAssessed
        ? "Not assessed: no designed tests or test executions are recorded in this workspace, so no test asset can be traced to this task yet."
        : e.Requirements.Count == 0 ? "Not resolvable: the task references no requirement of the current specification."
        : !e.Tests.Any ? $"No test evidence for {string.Join(", ", e.Requirements)}."
        : $"{e.Tests.Designed} designed · {e.Tests.Executed} executed · {e.Tests.Passed} passed · {e.Tests.Failed} failed (via {string.Join(", ", e.Requirements)}).";

    private SpecificationImport? _importRef;
    private string _localTasksText = string.Empty;
    private TaskTree? _tree;
    private TaskHealth _health = new();
    private HashSet<string> _expandedIds = [];
    private string? _selectedNodeId;
    private string _searchQuery = string.Empty;
    private string? _activeFilter;
    private bool _isMapView;
    private bool _isImpactView;
    private bool _isChangesView;
    private bool _isDependenciesView;
    private bool _isParallelView;
    private ElementReference _mapContainer;
    private ElementReference _parallelContainer;
    private List<(TaskNode Node, int Depth, bool IsMatch)> _flatCache = [];
    private string _lastBuiltText = string.Empty;
    private HashSet<string> _tableLinkedTaskIds = [];
    private ImplementationCoverageSummary? _coverage;

    private string EffectiveText => !string.IsNullOrWhiteSpace(_localTasksText) ? _localTasksText : TasksText;
    private bool CanBuild => !string.IsNullOrWhiteSpace(EffectiveText);
    private bool HasHealthData => _health.TotalTasks > 0 || _health.TotalPhases > 0 || _health.TablesDetected > 0 || _health.UnresolvedTableRefs > 0;
    private bool HasEnrichmentData => Report is not null || _health.SpecLinked + _health.HighRisk > 0;
    private bool IsTreeView => !_isMapView && !_isImpactView && !_isChangesView && !_isDependenciesView && !_isParallelView;
    private TaskNode? SelectedNode => _tree is not null && _selectedNodeId is not null
        ? TaskExplorerService.FindNode(_tree.Roots, _selectedNodeId)
        : null;
    private bool ShouldShowTaskDetails => SelectedNode is { } selected && CurrentViewSupportsTaskDetails(selected);

    private bool CurrentViewSupportsTaskDetails(TaskNode selected) =>
        IsTreeView || (_isMapView && selected.NodeType == TaskNodeType.Task);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isMapView || _mapContainer.Context is null)
            return;
        try
        {
            // Arrow-key movement across the Map's task buttons (one tab stop); the markup already renders the tab stop.
            await JS.InvokeVoidAsync("birknextRovingAttach", _mapContainer, ".te-map-task");
        }
        catch (JSException)
        {
            // The markup already renders one tab stop; without the script only the arrow-key movement is lost.
        }
    }

    protected override void OnParametersSet()
    {
        if (ParsedTasks is not null)
        {
            _tree = ParsedTasks;
            if (Report is not null)
                TaskExplorerService.EnrichWithReport(_tree, Report);
            _health = TaskExplorerService.ComputeEnrichedHealth(_tree);
            _tableLinkedTaskIds = TaskExplorerService.BuildTableLinkedTaskIds(_tree.Roots);
            _expandedIds = TaskExplorerService.GetDefaultExpanded(_tree.Roots);
            _selectedNodeId = null;
            _searchQuery = string.Empty;
            _activeFilter = null;
            _isMapView = false;
            _isImpactView = false;
            _isChangesView = false;
            _coverage = BuildImplementationCoverage(_tree);
            RefreshFlatCache();
        }
        else
        {
            var text = EffectiveText;
            if (!string.IsNullOrWhiteSpace(text) && text != _lastBuiltText && string.IsNullOrEmpty(_localTasksText))
                RebuildTree(text);
            else if (_tree is not null && Report is not null)
                RefreshEnrichment();
        }

        if (_tree is not null && InitialView is not null)
        {
            if (InitialView == "changes" && !_isChangesView)
                ShowChangesView();
            else if (InitialView == "dependencies" && !_isDependenciesView)
                ShowDependenciesView();
            else if (InitialView == "parallel" && !_isParallelView)
                ShowParallelView();
            else if (InitialView == "map" && !_isMapView)
                ShowMapView();
            else if (InitialView == "impact" && !_isImpactView)
                ShowImpactView();
        }
    }

    private void OnFileImported(string content)
    {
        _localTasksText = content;
        RebuildTree(content);
    }

    private void OnFileRemoved()
    {
        _localTasksText = string.Empty;
        if (!string.IsNullOrWhiteSpace(TasksText))
            RebuildTree(TasksText);
        else
            _tree = null;
    }

    private void ClearInput()
    {
        _localTasksText = string.Empty;
        _importRef?.Reset();
    }

    private async Task BuildTreeAsync()
    {
        if (!CanBuild) return;
        await OnTextChanged.InvokeAsync(EffectiveText);
    }

    private void RebuildTree(string text)
    {
        _tree = TaskExplorerService.Parse(text);
        _lastBuiltText = text;
        if (Report is not null)
            TaskExplorerService.EnrichWithReport(_tree, Report);
        _health = TaskExplorerService.ComputeEnrichedHealth(_tree);
        _tableLinkedTaskIds = TaskExplorerService.BuildTableLinkedTaskIds(_tree.Roots);
        _expandedIds = TaskExplorerService.GetDefaultExpanded(_tree.Roots);
        _selectedNodeId = null;
        _searchQuery = string.Empty;
        _activeFilter = null;
        _isMapView = false;
        _isImpactView = false;
        _isChangesView = false;
        _coverage = BuildImplementationCoverage(_tree);
        RefreshFlatCache();
    }

    private void RefreshEnrichment()
    {
        if (_tree is null || Report is null) return;
        TaskExplorerService.EnrichWithReport(_tree, Report);
        _health = TaskExplorerService.ComputeEnrichedHealth(_tree);
        _coverage = BuildImplementationCoverage(_tree);
        RefreshFlatCache();
    }


    private void RefreshFlatCache()
    {
        if (_tree is null) { _flatCache = []; return; }
        _flatCache = TaskExplorerService.GetFlatVisible(
            _tree.Roots, _expandedIds, _searchQuery, _activeFilter, _tableLinkedTaskIds, Evidence);
    }

    private void HandleSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? string.Empty;
        RefreshFlatCache();
    }

    private void SetFilter(string? filter)
    {
        _activeFilter = filter;
        RefreshFlatCache();
    }

    private string TreeFilterMatchClass(bool isMatch)
    {
        if (!isMatch)
            return string.Empty;

        var semantic = FilterMatchSemantic(_activeFilter);
        if (semantic is null)
            return "is-match";

        return $"is-match te-filter-match te-filter-match--{semantic}";
    }

    private static string? FilterMatchSemantic(string? filter) => filter switch
    {
        "OnlyUserStories" or
        "OnlyRequirements" or
        "OnlySuccessCriteria" or
        "HasFrLinks" or
        "HasScLinks" or
        "HasTableLinks" or
        "TestingTasks" or
        "SecurityTasks" or
        "Parallel" or
        "ImplCurrent" or
        "TestsDesigned" or
        "TestsExecuted" => "info",

        "MissingImplementation" or
        "ImplNone" or
        "ImplStale" or
        "TestsFailed" or
        "NoLinks" => "warning",

        _ => null,
    };

    private void HandleNodeClick(TaskNode node)
    {
        _selectedNodeId = _selectedNodeId == node.Id ? null : node.Id;
        StateHasChanged();
    }

    private void ToggleExpand(string id)
    {
        if (!_expandedIds.Add(id)) _expandedIds.Remove(id);
        RefreshFlatCache();
    }

    private void ExpandAll()
    {
        if (_tree is null) return;
        ExpandAllNodes(_tree.Roots);
        RefreshFlatCache();
    }

    private void ExpandAllNodes(IEnumerable<TaskNode> nodes)
    {
        foreach (var node in nodes)
        {
            if (node.Children.Count > 0) _expandedIds.Add(node.Id);
            ExpandAllNodes(node.Children);
        }
    }

    private void CollapseAll()
    {
        _expandedIds.Clear();
        RefreshFlatCache();
    }

    private static int CountLines(string text) => text.Split('\n').Length;

    private void ShowTreeView()
    {
        _isMapView = false;
        _isImpactView = false;
        _isChangesView = false;
        _isDependenciesView = false;
        _isParallelView = false;
    }

    private async Task ShowMapView()
    {
        _isMapView = true;
        _isImpactView = false;
        _isChangesView = false;
        _isDependenciesView = false;
        _isParallelView = false;
        await ResetMapScroll();
    }

    private async Task ResetMapScroll()
    {
        try
        {
            if (_mapContainer.Context is not null)
            {
                // Reset Map container scroll position to top
                await JS.InvokeVoidAsync("eval", "document.querySelectorAll('.te-map')[document.querySelectorAll('.te-map').length-1].scrollTop = 0");
            }
        }
        catch
        {
            // Silently ignore errors; scroll reset is not critical
        }
    }

    private void ShowImpactView()
    {
        _isMapView = false;
        _isImpactView = true;
        _isChangesView = false;
        _isDependenciesView = false;
        _isParallelView = false;
    }

    private void ShowDependenciesView()
    {
        _isMapView = false;
        _isImpactView = false;
        _isChangesView = false;
        _isDependenciesView = true;
        _isParallelView = false;
    }

    private async Task ShowParallelView()
    {
        _isMapView = false;
        _isImpactView = false;
        _isChangesView = false;
        _isDependenciesView = false;
        _isParallelView = true;
        await ResetParallelScroll();
    }

    private async Task ResetParallelScroll()
    {
        try
        {
            if (_parallelContainer.Context is not null)
            {
                // Reset Parallel container scroll position to top
                await JS.InvokeVoidAsync("eval", "document.querySelector('[data-testid=\"te-parallel-view\"]').scrollTop = 0");
            }
        }
        catch
        {
            // Silently ignore errors; scroll reset is not critical
        }
    }

    private void ShowChangesView()
    {
        _isMapView = false;
        _isImpactView = false;
        _isChangesView = true;
        _isDependenciesView = false;
        _isParallelView = false;
    }

    private sealed record CoverageMetric(string Label, int Linked, int Total, string Status);
    private sealed record DeliveryRiskItem(string Label, int Count, string Severity);

    private sealed record ImplementationCoverageSummary(
        IReadOnlyList<CoverageMetric> Metrics,
        IReadOnlyList<DeliveryRiskItem> Risks,
        IReadOnlyList<string> MissingRequirements,
        IReadOnlyList<string> MissingSuccessCriteria,
        IReadOnlyList<string> MissingUserStories,
        IReadOnlyList<string> SecurityGapLabels,
        IReadOnlyList<string> TestingGapLabels,
        int ImplementationPercent,
        string OverallStatus);

    private ImplementationCoverageSummary BuildImplementationCoverage(TaskTree tree)
    {
        var allNodes = AllNodes(tree.Roots);
        var tasks = allNodes.Where(n => n.NodeType == TaskNodeType.Task).ToList();
        var userStories = allNodes.Select(ExtractUserStory).OfType<string>().Where(s => !string.IsNullOrWhiteSpace(s)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s).ToList();
        var requirements = tasks.SelectMany(t => t.ReferencedFrIds).Select(NormalizeArtifactId).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s).ToList();
        var successCriteria = tasks.SelectMany(t => t.ReferencedScIds).Select(NormalizeArtifactId).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s).ToList();
        var testingTasks = tasks.Where(t => t.IsTestingTask).ToList();
        var architectureTasks = tasks.Where(IsArchitectureTask).ToList();
        var missingUserStories = MissingSequence(userStories, "US");
        var missingRequirements = MissingSequence(requirements, "FR");
        var missingSuccessCriteria = MissingSequence(successCriteria, "SC");
        var securityGaps = BuildSecurityGaps(tasks, missingRequirements);
        var testingGaps = testingTasks.Count == 0 && requirements.Count > 0
            ? requirements.Select(r => $"{r}: testing requirements have no test tasks").ToList()
            : [];

        var metrics = new List<CoverageMetric>
        {
            BuildMetric("User Stories", userStories.Count, userStories.Count + missingUserStories.Count),
            BuildMetric("Functional Requirements", requirements.Count, requirements.Count + missingRequirements.Count),
            BuildMetric("Success Criteria", successCriteria.Count, successCriteria.Count + missingSuccessCriteria.Count),
            BuildMetric("Tests", testingTasks.Count, Math.Max(testingTasks.Count, requirements.Count)),
            BuildMetric("Architecture Notes", architectureTasks.Count, Math.Max(architectureTasks.Count, tasks.Count(t => t.Status == AlignmentStatus.TechnicalOnly))),
        };

        var linked = metrics.Sum(m => m.Linked);
        var total = metrics.Sum(m => m.Total);
        var percent = total == 0 ? 0 : (int)Math.Round((double)linked / total * 100);
        var overallStatus = CoverageStatus(linked, total);

        var risks = new List<DeliveryRiskItem>
        {
            BuildRisk("Requirements without implementation", missingRequirements.Count),
            BuildRisk("Success Criteria without tasks", missingSuccessCriteria.Count),
            BuildRisk("User Stories with no implementation", missingUserStories.Count),
            BuildRisk("Security requirements without security tasks", securityGaps.Count),
            BuildRisk("Testing requirements without test tasks", testingGaps.Count),
        };

        return new ImplementationCoverageSummary(
            metrics,
            risks,
            missingRequirements,
            missingSuccessCriteria,
            missingUserStories,
            securityGaps,
            testingGaps,
            percent,
            overallStatus);
    }

    private static CoverageMetric BuildMetric(string label, int linked, int total) =>
        new(label, linked, total, CoverageStatus(linked, total));

    private static string CoverageStatus(int linked, int total)
    {
        if (total == 0 || linked == 0) return "Missing";
        if (linked >= total) return "Covered";
        return "Partial";
    }

    private static DeliveryRiskItem BuildRisk(string label, int count)
    {
        var severity = count >= 5 ? "High" : count > 0 ? "Medium" : "Low";
        return new DeliveryRiskItem(label, count, severity);
    }

    private static string CoverageStatusClass(string status) => status.ToLowerInvariant();

    private static IReadOnlyList<TaskNode> AllNodes(IEnumerable<TaskNode> roots)
    {
        var result = new List<TaskNode>();
        Collect(roots, result);
        return result;

        static void Collect(IEnumerable<TaskNode> nodes, List<TaskNode> result)
        {
            foreach (var node in nodes)
            {
                result.Add(node);
                Collect(node.Children, result);
            }
        }
    }

    private static string? ExtractUserStory(TaskNode node)
    {
        if (!string.IsNullOrWhiteSpace(node.UserStoryTag))
            return NormalizeArtifactId(node.UserStoryTag);
        var source = $"{node.UserStoryTitle} {node.Title} {node.RawText}";
        var match = System.Text.RegularExpressions.Regex.Match(source, @"\bUS[-\s]?0*(\d+)\b", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        return match.Success ? $"US-{int.Parse(match.Groups[1].Value):000}" : null;
    }

    private string? ResolveUserStory(TaskNode node)
    {
        var direct = ExtractUserStory(node);
        if (direct is not null || _tree is null)
            return direct;
        var ancestors = new List<TaskNode>();
        return FindAncestors(_tree.Roots, node.Id, ancestors)
            ? ancestors.Select(ExtractUserStory).OfType<string>().LastOrDefault()
            : null;
    }

    private string? UserStoryDisplay(TaskNode node)
    {
        var storyId = !string.IsNullOrWhiteSpace(node.UserStoryTag)
            ? node.UserStoryTag.Trim()
            : ResolveUserStory(node);

        if (string.IsNullOrWhiteSpace(storyId))
            return null;

        var storyName = CleanUserStoryName(node.PhaseTitle, storyId)
            ?? CleanUserStoryName(node.UserStoryTitle, storyId)
            ?? FindUserStoryName(storyId);

        return string.IsNullOrWhiteSpace(storyName)
            ? storyId
            : $"{storyId} · {storyName}";
    }

    private string? GetUserStoryTitle(TaskNode node)
    {
        var display = UserStoryDisplay(node);
        if (string.IsNullOrWhiteSpace(display))
            return null;

        var storyId = !string.IsNullOrWhiteSpace(node.UserStoryTag)
            ? node.UserStoryTag.Trim()
            : ResolveUserStory(node);

        if (string.IsNullOrWhiteSpace(storyId))
            return "User Story";

        var parts = display.Split('·');
        return parts.Length > 1
            ? $"User Story {storyId} — {parts[1].Trim()}"
            : $"User Story {storyId}";
    }

    private string? FindUserStoryName(string storyId)
    {
        if (_tree is null)
            return null;

        return AllNodes(_tree.Roots)
            .Where(n => string.Equals(n.UserStoryTag, storyId, StringComparison.OrdinalIgnoreCase))
            .Select(n => CleanUserStoryName(n.PhaseTitle, storyId) ?? CleanUserStoryName(n.UserStoryTitle, storyId))
            .FirstOrDefault(name => !string.IsNullOrWhiteSpace(name));
    }

    private string UserStoryContextDisplay(TaskNode node)
    {
        return UserStoryDisplay(node) ?? node.UserStoryTitle ?? string.Empty;
    }

    private static string? CleanUserStoryName(string? source, string storyId)
    {
        if (string.IsNullOrWhiteSpace(source) || string.IsNullOrWhiteSpace(storyId))
            return null;

        var text = source.Trim().TrimStart('#').Trim();
        var hasExplicitStoryContext = System.Text.RegularExpressions.Regex.IsMatch(text, @"\bUser\s+Story\s+\d+\b", System.Text.RegularExpressions.RegexOptions.IgnoreCase)
            || System.Text.RegularExpressions.Regex.IsMatch(text, $@"\b{System.Text.RegularExpressions.Regex.Escape(storyId)}\b", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (!hasExplicitStoryContext)
            return null;

        text = System.Text.RegularExpressions.Regex.Replace(text, @"^\s*Phase\s+\d+\s*[:\-–—]\s*", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        text = System.Text.RegularExpressions.Regex.Replace(text, @"\s*\(Priority:[^)]+\).*$", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase).Trim();
        text = System.Text.RegularExpressions.Regex.Replace(text, @"\s*🎯\s*MVP\s*$", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase).Trim();

        var storyNumber = System.Text.RegularExpressions.Regex.Match(storyId, @"US[-\s]?0*(\d+)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (storyNumber.Success)
        {
            text = System.Text.RegularExpressions.Regex.Replace(text, $@"^\s*User\s+Story\s+0*{storyNumber.Groups[1].Value}\s*[:\-–—]\s*", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase).Trim();
            if (System.Text.RegularExpressions.Regex.IsMatch(text, $@"^\s*User\s+Story\s+0*{storyNumber.Groups[1].Value}\s*$", System.Text.RegularExpressions.RegexOptions.IgnoreCase))
                return null;
            if (System.Text.RegularExpressions.Regex.IsMatch(text, $@"\bUser\s+Story\s+0*{storyNumber.Groups[1].Value}\b", System.Text.RegularExpressions.RegexOptions.IgnoreCase))
                return null;
        }

        text = System.Text.RegularExpressions.Regex.Replace(text, $@"^\s*{System.Text.RegularExpressions.Regex.Escape(storyId)}\s*[:\-–—]\s*", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase).Trim();

        return string.IsNullOrWhiteSpace(text) || string.Equals(text, storyId, StringComparison.OrdinalIgnoreCase)
            ? null
            : text;
    }

    private static bool FindAncestors(IEnumerable<TaskNode> nodes, string targetId, List<TaskNode> ancestors)
    {
        foreach (var node in nodes)
        {
            if (node.Id == targetId)
                return true;
            ancestors.Add(node);
            if (FindAncestors(node.Children, targetId, ancestors))
                return true;
            ancestors.RemoveAt(ancestors.Count - 1);
        }
        return false;
    }

    private static string NormalizeArtifactId(string id)
    {
        var match = System.Text.RegularExpressions.Regex.Match(id, @"\b(US|FR|SC)[-\s]?0*(\d+)\b", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        return match.Success
            ? $"{match.Groups[1].Value.ToUpperInvariant()}-{int.Parse(match.Groups[2].Value):000}"
            : id.ToUpperInvariant();
    }

    private static List<string> MissingSequence(IReadOnlyList<string> ids, string prefix)
    {
        var numbers = ids
            .Select(id => System.Text.RegularExpressions.Regex.Match(id, $@"\b{prefix}-?(\d+)\b", System.Text.RegularExpressions.RegexOptions.IgnoreCase))
            .Where(m => m.Success)
            .Select(m => int.Parse(m.Groups[1].Value))
            .Distinct()
            .OrderBy(n => n)
            .ToList();
        if (numbers.Count < 2) return [];
        var present = numbers.ToHashSet();
        return Enumerable.Range(numbers.First(), numbers.Last() - numbers.First() + 1)
            .Where(n => !present.Contains(n))
            .Select(n => $"{prefix}-{n:000}")
            .ToList();
    }

    private static bool IsArchitectureTask(TaskNode node)
    {
        var text = $"{node.Title} {node.RawText} {node.PhaseTitle} {node.UserStoryTitle}";
        return text.Contains("architecture", StringComparison.OrdinalIgnoreCase)
            || text.Contains("technical", StringComparison.OrdinalIgnoreCase)
            || text.Contains("integration", StringComparison.OrdinalIgnoreCase)
            || text.Contains("api", StringComparison.OrdinalIgnoreCase);
    }

    private static List<string> BuildSecurityGaps(IReadOnlyList<TaskNode> tasks, IReadOnlyList<string> missingRequirements)
    {
        var hasSecurityTask = tasks.Any(t => t.IsSecurityTask);
        if (hasSecurityTask) return [];
        var securityRefs = tasks
            .Where(t => $"{t.Title} {t.RawText} {t.PhaseTitle}".Contains("security", StringComparison.OrdinalIgnoreCase))
            .SelectMany(t => t.ReferencedFrIds)
            .Select(NormalizeArtifactId)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (securityRefs.Count > 0)
            return securityRefs.Select(r => $"{r}: security requirements have no security tasks").ToList();
        return missingRequirements.Take(5).Select(r => $"{r}: security review not linked").ToList();
    }

    private static string DisplayOrEmpty(string? value) => string.IsNullOrWhiteSpace(value) ? "No link" : value;
    private static string DisplayListOrEmpty(IEnumerable<string> values)
    {
        var list = values.Select(NormalizeArtifactId).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        return list.Count == 0 ? "No link" : string.Join(", ", list);
    }

    private static string CoverageImpactLabel(TaskNode node)
    {
        if (node.ReferencedFrIds.Count == 0 && node.ReferencedScIds.Count == 0)
            return "Unlinked task; no implementation coverage impact";
        var refs = node.ReferencedFrIds.Count + node.ReferencedScIds.Count;
        return $"{refs} linked spec artifact{(refs == 1 ? "" : "s")} affect implementation coverage";
    }

    private void OpenInTraceability(TaskNode node)
    {
        var target = node.ReferencedFrIds.FirstOrDefault()
            ?? node.ReferencedScIds.FirstOrDefault()
            ?? ExtractUserStory(node)
            ?? node.TaskId
            ?? string.Empty;
        if (!string.IsNullOrWhiteSpace(target))
            SetSearch(NormalizeArtifactId(target));
    }


    private static bool IsExecutionGroup(TaskNode node) =>
        (node.NodeType == TaskNodeType.TaskGroup ||
         node.NodeType == TaskNodeType.UserStoryGroup ||
         node.NodeType == TaskNodeType.DeepGroup) &&
        AllNodes(node.Children).Any(n => n.NodeType == TaskNodeType.Task);


    private static RenderFragment RenderImpactGroup(string title, IReadOnlyList<string> items, string emptyText) => builder =>
    {
        builder.OpenElement(0, "section");
        builder.AddAttribute(1, "class", "te-impact-group");
        builder.OpenElement(2, "h4");
        builder.AddContent(3, title);
        builder.CloseElement();
        if (items.Count == 0)
        {
            builder.OpenElement(4, "p");
            builder.AddAttribute(5, "class", "te-impact-empty");
            builder.AddContent(6, emptyText);
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(7, "ul");
            builder.AddAttribute(8, "class", "te-impact-list");
            var seq = 9;
            foreach (var item in items.Take(8))
            {
                builder.OpenElement(seq++, "li");
                builder.AddContent(seq++, item);
                builder.CloseElement();
            }
            if (items.Count > 8)
            {
                builder.OpenElement(seq++, "li");
                builder.AddAttribute(seq++, "class", "te-impact-more");
                builder.AddContent(seq++, $"+{items.Count - 8} more");
                builder.CloseElement();
            }
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    // Table relationship lookup
    private record TableRelationship(string TableTitle, string RowTitle);

    private List<TableRelationship> GetTableRelationships(string? taskId)
    {
        if (taskId is null || _tree is null) return [];
        var result = new List<TableRelationship>();
        CollectTableRels(_tree.Roots, taskId, null, result);
        return result;
    }

    private static void CollectTableRels(
        IEnumerable<TaskNode> nodes, string taskId,
        string? parentTableTitle, List<TableRelationship> result)
    {
        foreach (var node in nodes)
        {
            var tableTitle = node.NodeType == TaskNodeType.TableSection ? node.Title : parentTableTitle;
            if (node.NodeType == TaskNodeType.TableRow &&
                node.LinkedTaskIds.Any(t => string.Equals(t, taskId, StringComparison.OrdinalIgnoreCase)))
            {
                result.Add(new TableRelationship(tableTitle ?? "Table", node.Title));
            }
            CollectTableRels(node.Children, taskId, tableTitle, result);
        }
    }

