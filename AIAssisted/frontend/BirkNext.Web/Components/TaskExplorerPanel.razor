    private static bool IsTaskRefUnresolved(TaskNode rowNode, string taskId) =>
        rowNode.Children.Any(c =>
            c.NodeType == TaskNodeType.TableTaskRef &&
            string.Equals(c.TaskId, taskId, StringComparison.OrdinalIgnoreCase) &&
            c.IsUnresolved);

    private static TaskNode? FindParentTableSection(IEnumerable<TaskNode> nodes, string childId)
    {
        foreach (var node in nodes)
        {
            if (node.NodeType == TaskNodeType.TableSection &&
                node.Children.Any(c => c.Id == childId))
                return node;
            var found = FindParentTableSection(node.Children, childId);
            if (found is not null) return found;
        }
        return null;
    }

