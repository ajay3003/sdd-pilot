@using System.Text
@using System.Xml.Linq
@using BirkNext.Integrations
@using BirkNext.TestData
@using BirkNext.Web.Services
@using BirkNext.Web.Services.SchemaStudio
@using BirkNext.Web.Models
@inject IServiceProvider Services

@* Test Data → XML fixtures: create a reusable message fixture for a test pack's contract without leaving Test Data. The XSD comes from the
   template's own evidence resolution (one candidate preselected, several chosen, none never guessed); generation and validation are Schema
   Studio's (a private instance, so Schema Studio's session is untouched) and run locally; the reporter and child come from Session test
   identities and are filled in by the backend from Test Data by alias. Nothing is saved until Save; a saved fixture is approved in Test Data. *@
<div class="xf" data-testid="xf">
    @if (_contexts.Count == 0)
    {
        <p class="xf-muted" data-testid="xf-none">No test pack declares an XML message fixture for this environment.</p>
    }
    else
    {
        var context = _context!;
        var xsds = XmlFixturePresentation.Xsds(context);
        var fixtures = XmlFixturePresentation.Fixtures(Assets, context.SchemaName!);
        var selection = Selection(context);
        var (readiness, readinessText, current) = XmlFixturePresentation.Readiness(fixtures, CurrentXsd(context)?.SnapshotId);
        <dl class="xf-summary" data-testid="xf-summary">
            <div><dt>Test context</dt><dd data-testid="xf-context">@context.PackName · @context.DisplayName</dd></div>
            @foreach (var binding in context.FixtureBindings)
            {
                var chosen = Chosen(binding);
                <div data-testid="xf-role" data-role="@binding.Role"><dt>@binding.Role</dt><dd>@(chosen is null ? "Missing — choose in Session test identities" : $"{chosen.Label ?? chosen.Alias} ({chosen.Alias})")@if (binding.ElementPath is null) { <span class="xf-muted" data-testid="xf-role-submission"> · Used for submission; not part of the XML payload.</span> }</dd></div>
            }
            <div><dt>Contract / XSD</dt><dd data-testid="xf-contract">@context.SchemaName</dd></div>
            <div><dt>XML fixture</dt><dd><span class="xf-badge xf-badge-@(readiness == TestDataXmlReadinessState.Ready ? "ready" : "attention")" data-testid="xf-readiness" data-state="@readiness">@readinessText</span></dd></div>
        </dl>

        @if (current is not null && _open && ChangedContract(context, current) is { } contractChange)
        {
            <p class="xf-notice" role="status" data-testid="xf-contract-changed">@contractChange Existing approved fixture @current.Alias remains unchanged. Regenerate as a new draft to use the new contract.</p>
        }
        @if (current is not null && ChangedRoles(context, current) is { Count: > 0 } changed)
        {
            @* A mapped identity (inside the XML) changed: the approved fixture is never mutated; a new draft is generated instead. A role that is
               not part of the payload (the submitting reporter) changes the submission context only. *@
            <p class="xf-notice" role="status" data-testid="xf-regenerate-notice">@string.Join(" ", changed.Select(c => $"{current.Alias} was generated with {c.Role.ToLowerInvariant()} {c.Was}; {c.Now} is now selected."))
                The saved fixture stays unchanged — regenerate the XML as a new draft to use the new selection.</p>
        }
        @if (current is not null && TestDataValueVersions.Changed(current, Assets) is { Count: > 0 } valueChanged)
        {
            @* The same asset, a new value (Test Data → Edit): the approved fixture keeps the value it was generated with; never rewritten. Only
               assets inside the XML are recorded, so a reporter (submission context) edit never marks the fixture. *@
            <p class="xf-notice" role="status" data-testid="xf-value-changed"><strong>Mapped Test Data changed.</strong> @current.Alias was generated using an earlier value of
                @string.Join(", ", valueChanged.Select(c => c.Missing ? $"{c.Alias} (no longer in Test Data)" : c.Alias)). The saved fixture stays unchanged — regenerate it as a new draft to use the current value.</p>
        }
        @if (!_open)
        {
            @* The primary action follows the state: a ready fixture is opened, not created again; anything else is created (or revalidated). *@
            <div class="xf-actions" data-testid="xf-primary-actions">
                @if (readiness == TestDataXmlReadinessState.Ready && current is not null)
                {
                    <button type="button" class="btn btn-primary btn-sm" data-testid="xf-open-ready" aria-controls="@DetailId(current)" aria-expanded="@(_detailFor == current.Id ? "true" : "false")" @onclick="() => ToggleDetail(current)">@(_detailFor == current.Id ? "Hide fixture" : "Open fixture")</button>
                    <button type="button" class="btn btn-secondary btn-sm" data-testid="xf-create" @onclick="Open">@(ChangedRoles(context, current).Count > 0 || TestDataValueVersions.Changed(current, Assets).Count > 0 ? "Regenerate as new draft" : "Create another")</button>
                    <button type="button" class="btn btn-secondary btn-sm" data-testid="xf-use-existing" aria-expanded="@(_useExisting ? "true" : "false")" aria-controls="xf-existing" @onclick="() => _useExisting = !_useExisting">Use existing XML fixture</button>
                }
                else if (readiness == TestDataXmlReadinessState.NotApproved && current is not null)
                {
                    <button type="button" class="btn btn-primary btn-sm" data-testid="xf-approve" disabled="@_busy" @onclick="() => ApproveAsync(current.Id)">Approve @current.Alias</button>
                    <button type="button" class="btn btn-secondary btn-sm" data-testid="xf-create" @onclick="Open">Create another</button>
                }
                else
                {
                    <button type="button" class="btn btn-primary btn-sm" data-testid="xf-create" @onclick="Open">@(readiness switch
                    {
                        TestDataXmlReadinessState.Outdated => "Revalidate against current XSD",
                        TestDataXmlReadinessState.Invalid => "Create a valid XML fixture",
                        _ => "Create XML fixture",
                    })</button>
                }
            </div>
            @if (_useExisting)
            {
                @* Payload level: an existing approved XML fixture is chosen as a whole message — never offered as a value for a single field. *@
                <div id="xf-existing" class="xf-step" data-testid="xf-existing" role="group" aria-label="Use an existing XML fixture (payload level)">
                    <label for="xf-existing-select">Existing XML fixtures for @context.SchemaName (payload level)</label>
                    <select id="xf-existing-select" class="form-select" data-testid="xf-existing-select" @onchange="e => UseExisting(fixtures, e.Value?.ToString())">
                        <option value="">Choose a fixture…</option>
                        @foreach (var f in fixtures.Where(f => f.Approval == TestDataApproval.Approved)) { <option value="@f.Alias">@($"{f.Label ?? f.Alias} — {f.Alias} · Approved · {XmlFixturePresentation.SchemaValidation(f)}")</option> }
                    </select>
                    <span class="xf-muted">The chosen fixture is used as the complete report payload; its source, XSD and mappings are in its details.</span>
                </div>
            }
            @if (readiness == TestDataXmlReadinessState.Outdated) { <p class="xf-muted" data-testid="xf-outdated-help">The fixture was validated against another snapshot of the XSD. Revalidate creates it again from the current XSD; nothing ready is assumed.</p> }
        }
        else
        {
            <section class="xf-flow" aria-label="Create XML fixture" data-testid="xf-flow">
                @if (_contexts.Count > 1)
                {
                    <label>Test context
                        <select class="form-select" data-testid="xf-context-select" value="@context.Key" @onchange="e => SelectContext(e.Value?.ToString())">
                            @foreach (var c in _contexts) { <option value="@c.Key">@c.PackName · @c.DisplayName</option> }
                        </select>
                    </label>
                }
                <fieldset class="xf-step" data-testid="xf-identities">
                    <legend>Test identities</legend>
                    @foreach (var binding in context.FixtureBindings)
                    {
                        var role = binding.Role;
                        var candidates = XmlFixturePresentation.Candidates(Assets, binding.Capability);
                        var chosen = Chosen(binding);
                        var selectId = $"xf-identity-{role.ToLowerInvariant()}";
                        <div class="xf-identity" data-testid="xf-identity-row" data-role="@role" data-in-xml="@(binding.ElementPath is null ? "false" : "true")">
                            <label for="@selectId">@(binding.ElementPath is null ? $"{role} · submission identity" : $"{role} · mapped into the XML")</label>
                            <select id="@selectId" class="form-select" data-testid="xf-identity" data-role="@role" aria-describedby="@($"{selectId}-help")" @onchange="e => ChooseIdentity(binding, e.Value?.ToString())">
                                @if (chosen is null) { <option value="" selected>Choose…</option> }
                                @foreach (var c in candidates) { <option value="@c.Alias" selected="@(chosen?.Alias == c.Alias)">@XmlFixturePresentation.IdentityOption(c)</option> }
                            </select>
                            <span id="@($"{selectId}-help")" class="xf-muted" data-testid="xf-identity-help">@(binding.ElementPath is null
                                ? "Used for the submission context (who signs in and submits). Not mapped into the XML payload; changing it does not regenerate the XML."
                                : $"Mapped into {XmlValueMappings.Display(_parameters, binding.ElementPath)}; changing it needs a regenerated XML.")</span>
                            @if (candidates.Count == 0) { <span class="xf-muted" data-testid="xf-identity-none">No approved @role.ToLowerInvariant() Test Data assets found.</span> }
                        </div>
                    }
                </fieldset>
                <fieldset class="xf-step" data-testid="xf-snapshot">
                    <legend>Source snapshot</legend>
                    @if (selection.Snapshot is { } snap)
                    {
                        <p data-testid="xf-snapshot-chosen"><strong>@snap.ArchiveFileName</strong> <span class="xf-muted">· snapshot @snap.ShortId@(snap.AnalyzedAt is { } at ? $" · analyzed {at.UtcDateTime:yyyy-MM-dd HH:mm} UTC" : "")</span></p>
                        <p class="xf-muted"><span class="xf-badge" data-testid="xf-snapshot-state" data-state="@selection.SnapshotState">@XmlContractResolution.StateLabel(selection.SnapshotState)</span> <span data-testid="xf-snapshot-reason">@selection.SnapshotReason</span></p>
                    }
                    else if (selection.SnapshotState == XmlSelectionState.NeedsDecision)
                    {
                        <p data-testid="xf-snapshot-decision"><span class="xf-badge xf-badge-attention" data-testid="xf-snapshot-state" data-state="NeedsDecision">Needs decision</span> @selection.SnapshotReason. Nothing is chosen by date.</p>
                    }
                    else if (selection.Snapshots.Count == 0)
                    {
                        <p class="xf-muted" data-testid="xf-snapshot-none">No imported source snapshot declares an XSD for @context.SchemaName.</p>
                    }
                    @if (_snapshotNotice is { } snapshotNotice) { <p class="xf-notice" role="status" data-testid="xf-snapshot-notice">@snapshotNotice</p> }
                    @if (selection.Snapshots.Count > 0)
                    {
                        @if (!_changeSnapshot && selection.Snapshot is not null)
                        {
                            <button type="button" class="btn btn-secondary btn-sm" data-testid="xf-change-snapshot" aria-expanded="false" aria-controls="xf-snapshot-select" @onclick="() => _changeSnapshot = true">Change snapshot</button>
                        }
                        else
                        {
                            <label for="xf-snapshot-select">Choose source snapshot</label>
                            <select id="xf-snapshot-select" class="form-select" data-testid="xf-snapshot-select" @onchange="e => SelectSnapshotAsync(context, e.Value?.ToString())">
                                <option value="" selected="@(selection.Snapshot is null)">Choose a source snapshot…</option>
                                @foreach (var option in selection.Snapshots) { <option value="@option.SnapshotId" selected="@(selection.Snapshot?.SnapshotId == option.SnapshotId)">@option.Label</option> }
                            </select>
                        }
                    }
                </fieldset>
                <fieldset class="xf-step" data-testid="xf-xsd">
                    <legend>Contract / XSD</legend>
                    @if (selection.Snapshots.Count == 0)
                    {
                        <p data-testid="xf-no-xsd">No matching XSD found for @context.SchemaName in the imported sources. <a href="schema-studio" data-testid="xf-open-studio">Open Schema Studio</a></p>
                    }
                    else if (_pendingReview && selection.Contract is { } review)
                    {
                        <p class="xf-notice" data-testid="xf-xsd-review">Matching XSD found in the selected snapshot: <strong>@System.IO.Path.GetFileName(review.File)</strong>. Review before continuing.</p>
                        <button type="button" class="btn btn-primary btn-sm" data-testid="xf-xsd-confirm" @onclick="() => ConfirmXsdAsync(review)">Use this XSD</button>
                    }
                    else if (CurrentXsd(context) is { } xsd)
                    {
                        <p data-testid="xf-xsd-chosen"><strong>@System.IO.Path.GetFileName(xsd.File)</strong> <span class="xf-muted">· @xsd.File · @xsd.ArchiveFileName · snapshot @xsd.SnapshotId.ToString()[..8]@(xsd.Version is { } v ? $" · version {v}" : "")</span></p>
                        <p class="xf-muted"><span class="xf-badge" data-testid="xf-xsd-state" data-state="@selection.ContractState">@XmlContractResolution.StateLabel(selection.ContractState)</span> <span data-testid="xf-xsd-reason">@selection.ContractReason</span></p>
                    }
                    else if (selection.Snapshot is not null)
                    {
                        <p data-testid="xf-xsd-decision"><span class="xf-badge xf-badge-attention">@XmlContractResolution.StateLabel(selection.ContractState)</span> @selection.ContractReason</p>
                    }
                    @if (selection.Snapshot is not null)
                    {
                        var choices = _showAll ? selection.Contracts.Concat(selection.OtherContracts).ToList() : selection.Contracts.ToList();
                        @if (_changeXsd || (CurrentXsd(context) is null && !_pendingReview))
                        {
                            <label for="xf-xsd-select">Choose XSD (from snapshot @selection.Snapshot.ShortId)</label>
                            <select id="xf-xsd-select" class="form-select" data-testid="xf-xsd-select" @onchange="e => SelectXsdAsync(context, choices, e.Value?.ToString())">
                                <option value="" selected="@(CurrentXsd(context) is null)">Choose…</option>
                                @for (var i = 0; i < choices.Count; i++)
                                {
                                    var c = choices[i];
                                    <option value="@i" selected="@(CurrentXsd(context) == c)">@XsdOption(context, c)</option>
                                }
                            </select>
                            <label class="xf-check"><input type="checkbox" data-testid="xf-show-all" checked="@_showAll" @onchange="e => _showAll = e.Value is true" /> Show all schemas/contracts in this snapshot</label>
                        }
                        else
                        {
                            <button type="button" class="btn btn-secondary btn-sm" data-testid="xf-change-xsd" aria-expanded="false" aria-controls="xf-xsd-select" @onclick="() => _changeXsd = true">Change XSD</button>
                        }
                    }
                    <a href="@SchemaStudioHref(CurrentXsd(context))" class="xf-link" data-testid="xf-studio-link">Open XSD in Schema Studio</a>
                </fieldset>
                <fieldset class="xf-step" data-testid="xf-mappings">
                    <legend>XML value mappings</legend>
                    <p class="xf-muted">Order: XSD structure and defaults → these mappings → generated values → XML generation → XSD validation. A mapping wins over a generated value. Test Data mappings store the asset reference, never its value.</p>
                    @if (_parameters.Count == 0)
                    {
                        <p class="xf-muted" data-testid="xf-mappings-waiting">@(_package is null ? "The XSD's fields are listed once the XSD is loaded." : "The XSD declares no mappable fields.")</p>
                        @if (_package is null && CurrentXsd(context) is not null) { <button type="button" class="btn btn-secondary btn-sm" data-testid="xf-load-fields" disabled="@_busy" @onclick="LoadFieldsAsync">Load XSD fields</button> }
                    }
                    @if (_parameters.Count > 0)
                    {
                        <label class="xf-filter">Search fields <input class="form-control" data-testid="xf-map-filter" type="search" placeholder="e.g. Identifikator" @bind="_fieldFilter" @bind:event="oninput" aria-describedby="xf-filter-help" /></label>
                        <span id="xf-filter-help" class="visually-hidden">Filters the Parameter lists below by full path or data type.</span>
                    }
                    @for (var i = 0; i < _mappings.Count; i++)
                    {
                        var index = i;
                        var row = _mappings[index];
                        var parameter = _parameters.FirstOrDefault(p => p.Path == row.Path);
                        var duplicate = _mappings.Count(m => m.Path == row.Path) > 1;
                        var rowId = $"xf-map-{index}";
                        <div class="xf-mapping" data-testid="xf-mapping" data-path="@row.Path" data-kind="@row.Kind" data-suggested="@(row.IsSuggested ? "true" : "false")" role="group" aria-labelledby="@($"{rowId}-label")">
                            <span id="@($"{rowId}-label")" class="visually-hidden">Mapping @(index + 1): @(parameter?.Technical ?? row.Path)</span>
                            <label>Parameter
                                <select class="form-select" data-testid="xf-map-parameter" aria-describedby="@($"{rowId}-technical")" @onchange="e => SetParameter(index, e.Value?.ToString())">
                                    @if (parameter is null) { <option value="" selected>Choose a field…</option> }
                                    @foreach (var p in FilteredParameters(row.Path)) { <option value="@p.Path" selected="@(p.Path == row.Path)" title="@p.Technical">@p.Display@(p.Type is { } type ? $" ({type})" : "")</option> }
                                </select>
                            </label>
                            <span id="@($"{rowId}-technical")" class="xf-mono xf-muted" data-testid="xf-map-technical">@(parameter?.Technical ?? "—")</span>
                            <label>Value source
                                <select class="form-select" data-testid="xf-map-source" @onchange="e => SetKind(index, e.Value?.ToString())">
                                    @foreach (var kind in Enum.GetValues<XmlValueSourceKind>()) { <option value="@kind" selected="@(kind == row.Kind)">@SourceLabel(kind)</option> }
                                </select>
                            </label>
                            @switch (row.Kind)
                            {
                                case XmlValueSourceKind.TestDataAsset:
                                    var compatible = XmlValueMappings.CompatibleAssets(Assets, row.Path, context.FixtureBindings);
                                    @* A mapped asset that was deleted is shown as missing; nothing falls back to another asset. *@
                                    if (row.AssetAlias is { } mappedAlias && Assets.Count > 0 && Assets.All(a => a.Alias != mappedAlias))
                                    {
                                        <span class="xf-badge xf-badge-attention" role="status" data-testid="xf-map-missing">XML mapping requires remapping: @mappedAlias no longer exists in Test Data</span>
                                    }
                                    if (compatible.Count == 0)
                                    {
                                        <span class="xf-muted" data-testid="xf-map-no-assets">No compatible Test Data assets found.</span>
                                    }
                                    else
                                    {
                                        <label>Value
                                            <select class="form-select" data-testid="xf-map-asset" @onchange="e => SetAsset(index, e.Value?.ToString())">
                                                @if (row.AssetAlias is null) { <option value="" selected>Choose a Test Data asset…</option> }
                                                @foreach (var asset in compatible) { <option value="@asset.Alias" selected="@(asset.Alias == row.AssetAlias)">@XmlFixturePresentation.IdentityOption(asset)</option> }
                                            </select>
                                        </label>
                                    }
                                    break;
                                case XmlValueSourceKind.Fixed:
                                    <label>Value <input class="form-control" data-testid="xf-map-fixed" value="@row.FixedValue" maxlength="200" @onchange="e => SetFixed(index, e.Value?.ToString())" /></label>
                                    break;
                                case XmlValueSourceKind.Generated:
                                    <label>Value
                                        <select class="form-select" data-testid="xf-map-generated" @onchange="e => SetGenerated(index, e.Value?.ToString())">
                                            @foreach (var g in Enum.GetValues<XmlGeneratedValue>()) { <option value="@g" selected="@(g == (row.Generated ?? XmlGeneratedValue.Uuid))">@(g switch { XmlGeneratedValue.Uuid => "UUID", XmlGeneratedValue.Timestamp => "Timestamp (UTC)", _ => "Today's date" })</option> }
                                        </select>
                                    </label>
                                    break;
                                default:
                                    <span class="xf-muted">The generated/default value is kept.</span>
                                    break;
                            }
                            <span class="xf-badge @(MappingStatus(row) == "Mapped" ? "xf-badge-ready" : "xf-badge-attention")" data-testid="xf-map-status" data-status="@MappingStatus(row)">@MappingStatus(row)</span>
                            @if (row.NeedsReview is { } why) { <span class="xf-error" data-testid="xf-map-review">@why</span> }
                            @if (row.SuggestedFrom is { } suggested) { <span class="xf-badge xf-badge-attention" data-testid="xf-map-suggested">Suggested from @suggested</span> }
                            @if (duplicate) { <span class="xf-error" data-testid="xf-map-duplicate">This field is mapped more than once.</span> }
                            <button type="button" class="btn btn-secondary btn-sm" data-testid="xf-map-remove" aria-label="@($"Remove mapping for {(parameter?.Technical ?? row.Path)}")" @onclick="() => RemoveMapping(index)">Remove</button>
                        </div>
                    }
                    <button type="button" class="btn btn-secondary btn-sm" data-testid="xf-map-add" disabled="@(_parameters.Count == 0)" @onclick="AddMapping">+ Add mapping</button>
                </fieldset>
                <div class="xf-actions">
                    <button type="button" class="btn btn-primary btn-sm" data-testid="xf-generate" disabled="@(_busy || CurrentXsd(context) is null || _mappings.Any(m => m.NeedsReview is not null))" @onclick="GenerateAsync">Generate XML</button>
                    @if (_mappings.Any(m => m.NeedsReview is not null)) { <span class="xf-muted" data-testid="xf-generate-blocked">Review the mappings marked "Needs review" first.</span> }
                </div>

                @if (_xml is not null)
                {
                    <fieldset class="xf-step" data-testid="xf-review">
                        <legend>Review and edit</legend>
                        <p class="xf-muted" data-testid="xf-generated-from">Generated from @CurrentXsd(context)?.File · @XmlFixturePresentation.BindingsText(context, Aliases(context))@(_mappings.Count > 0 ? $" · Mappings: {XmlValueMappings.ProvenanceText(_mappings)}" : "")</p>
                        <dl class="xf-fixture-facts" data-testid="xf-generated-summary">
                            <div><dt>Generated from</dt><dd data-testid="xf-sum-xsd">@CurrentXsd(context)?.File</dd></div>
                            <div><dt>Source snapshot</dt><dd data-testid="xf-sum-snapshot">@CurrentXsd(context)?.ArchiveFileName · snapshot @CurrentXsd(context)?.SnapshotId.ToString()[..8]</dd></div>
                            <div><dt>Mappings</dt><dd data-testid="xf-sum-mappings">@_appliedMappings applied</dd></div>
                            @foreach (var binding in context.FixtureBindings)
                            {
                                <div><dt>@binding.Role</dt><dd data-testid="xf-sum-role" data-role="@binding.Role">@(Aliases(context).GetValueOrDefault(binding.Role) ?? "—")@(binding.ElementPath is null ? " · submission context, not in XML" : "")</dd></div>
                            }
                            @if (_manualEdit) { <div><dt>Manual changes</dt><dd data-testid="xf-manual-edit">Manual XML changes present</dd></div> }
                        </dl>
                        <label for="xf-xml">Advanced / manual override — the generated XML (edits are recorded as manual changes)</label>
                        <textarea id="xf-xml" class="form-control xf-xml" rows="14" spellcheck="false" data-testid="xf-xml" value="@_xml" @oninput="Edited"></textarea>
                        <p role="status" aria-live="polite" data-testid="xf-validation" data-state="@_validation">Validation: @_validation</p>
                        @if (_validation == "Valid") { <p class="xf-muted" data-testid="xf-disclaimer">Valid against XSD. Business rules not verified. Runtime behavior not verified.</p> }
                        @if (_issues.Count > 0) { <ul class="xf-issues" data-testid="xf-issues">@foreach (var issue in _issues.Take(10)) { <li>@issue</li> }</ul> }
                        <button type="button" class="btn btn-primary btn-sm" data-testid="xf-validate" disabled="@_busy" @onclick="Validate">Validate XML</button>
                    </fieldset>
                    <fieldset class="xf-step" data-testid="xf-save">
                        <legend>Save to Test Data</legend>
                        <label>Name <input class="form-control" data-testid="xf-name" @bind="_name" @bind:event="oninput" @bind:after="() => _alias = XmlFixturePresentation.SuggestedAlias(_name ?? string.Empty)" /></label>
                        <label>Alias <input class="form-control" data-testid="xf-alias" @bind="_alias" @bind:event="oninput" /></label>
                        <button type="button" class="btn btn-primary btn-sm" data-testid="xf-save-button" disabled="@(_busy || _validation != "Valid" || string.IsNullOrWhiteSpace(_alias))" @onclick="SaveAsync">Save XML fixture</button>
                        @if (_validation != "Valid") { <span class="xf-muted" data-testid="xf-save-help"> Validate the XML first: only a schema-valid fixture is saved here (negative cases belong in Schema Studio).</span> }
                    </fieldset>
                }
            </section>
        }
        @if (_error is { } error) { <p class="xf-error" role="alert" data-testid="xf-error">@error</p> }
        @if (_message is { } message) { <p role="status" data-testid="xf-message">@message</p> }
        @if (_savedAlias is { } savedAlias && fixtures.FirstOrDefault(f => f.Alias == savedAlias) is { Approval: not TestDataApproval.Approved } unapproved
             && !(readiness == TestDataXmlReadinessState.NotApproved && current?.Id == unapproved.Id))
        {
            <button type="button" class="btn btn-secondary btn-sm" data-testid="xf-approve" disabled="@_busy" @onclick="() => ApproveAsync(unapproved.Id)">Approve @savedAlias</button>
        }

        @if (fixtures.Count > 0)
        {
            @* Compact rows: what a tester needs (approval and schema validation are separate facts); schema path, snapshot, fingerprint and
               provenance stay one click away in Details. *@
            <ul class="xf-list" data-testid="xf-fixtures" aria-label="Saved XML fixtures for @context.SchemaName">
                @foreach (var fixture in fixtures)
                {
                    var isReady = readiness == TestDataXmlReadinessState.Ready && current?.Id == fixture.Id;
                    var detailId = DetailId(fixture);
                    <li class="xf-fixture" data-testid="xf-fixture" data-alias="@fixture.Alias" data-ready="@(isReady ? "true" : "false")">
