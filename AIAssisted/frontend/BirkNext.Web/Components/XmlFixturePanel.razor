            if (generated.State == SchemaGenerationState.Blocked || string.IsNullOrEmpty(generated.Xml))
            { _error = $"The XML could not be generated: {string.Join(" ", generated.Reasons)}"; return; }
            // 2. Every mapped element present (an optional element is built in its schema position).
            var withMapped = SchemaStudioService.WithElements(_package, generated.Xml, mapped.Select(m => m.Path));
            // 3. Fixed and generated values replace synthetic/default ones (an explicit mapping wins).
            var (applied, problems) = XmlValueMappings.Apply(withMapped, mapped, DateTimeOffset.UtcNow);
            if (problems.Count > 0) { _error = $"Some mapped fields are not in the generated XML: {string.Join(" ", problems)}"; return; }
            // 4. Test Data assets are filled in by the backend by alias: their values never pass through this page.
            var bindings = mapped.Where(m => m.Kind == XmlValueSourceKind.TestDataAsset).Select(m => new TestDataXmlBinding(m.AssetAlias!, m.Path)).ToList();
            if (bindings.Count == 0) { _xml = applied; _validation = "Not run"; return; }
            var (bound, bindProblems) = await TestDataApiService.Resolve(Services).BindXmlFixtureAsync(new TestDataXmlBindRequest(applied, bindings));
            if (bound is null) { _error = $"Test Data values could not be filled in: {string.Join(" ", bindProblems)}"; return; }
            _xml = bound;
            _validation = "Not run";
        }
        catch (InvalidDataException ex) { _error = ex.Message; }
        catch (System.Xml.XmlException ex) { _error = $"The generated XML could not be read: {ex.Message}"; }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException) { _error = "The backend could not be reached; nothing was generated."; }
