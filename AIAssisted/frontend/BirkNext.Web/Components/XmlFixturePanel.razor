            var mapped = _mappings.Where(m => m.Path.Length > 0 && m.Kind != XmlValueSourceKind.SchemaDefault).ToList();
            _manualEdit = false; _appliedMappings = mapped.Count;
            if (_mappings.Any(m => m.Path.Length == 0)) { _error = "Choose a field for every mapping (or remove the empty row); nothing was generated."; return; }
            if (mapped.GroupBy(m => m.Path).FirstOrDefault(g => g.Count() > 1) is { } twice) { _error = $"{XmlValueMappings.Display(_parameters, twice.Key)} is mapped more than once; nothing was generated."; return; }
            if (mapped.FirstOrDefault(m => m.Kind == XmlValueSourceKind.TestDataAsset && m.AssetAlias is null) is { } unset)
            { _error = $"Choose a Test Data asset for {XmlValueMappings.Display(_parameters, unset.Path)}; nothing was generated."; return; }
            if (Assets.Count > 0 && mapped.FirstOrDefault(m => m.Kind == XmlValueSourceKind.TestDataAsset && Assets.All(a => a.Alias != m.AssetAlias)) is { } gone)
            { _error = $"{XmlValueMappings.Display(_parameters, gone.Path)} maps {gone.AssetAlias}, which no longer exists in Test Data — remap it; nothing was generated."; return; }
