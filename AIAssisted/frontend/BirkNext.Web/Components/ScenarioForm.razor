@using BirkNext.Web.GraphQL
@using System.ComponentModel.DataAnnotations
@inject IBirkNextClient Client

<EditForm Model="_model" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />

    <div>
        <label for="title">Title</label>
        <InputText id="title" @bind-Value="_model.Title" />
        <ValidationMessage For="() => _model.Title" />
        @if (FieldError("title") is { } titleErr) { <span class="validation-message">@titleErr</span> }
    </div>
    <div>
        <label for="description">Description</label>
        <InputTextArea id="description" @bind-Value="_model.Description" />
    </div>
    <div>
        <label for="kind">Type</label>
        <InputSelect id="kind" TValue="ScenarioKind?" @bind-Value="_model.Kind">
            <option value="">-- select a type --</option>
            <option value="Requirement">Requirement</option>
            <option value="Test">Test</option>
            <option value="NeedsClarification">Needs Clarification</option>
        </InputSelect>
        <ValidationMessage For="() => _model.Kind" />
        @if (FieldError("kind") is { } kindErr) { <span class="validation-message">@kindErr</span> }
    </div>

    @{ var unrouted = _errors.Where(e => e.Field is not ("title" or "kind")).ToList(); }
    @if (unrouted.Count > 0)
    {
        <ul role="alert">
            @foreach (var error in unrouted)
            {
                <li>@error.Message</li>
            }
        </ul>
    }

    @if (_networkError is not null)
    {
        <p role="alert">@_networkError</p>
    }

    @if (_correlationId is not null)
    {
        <p>Support reference: @_correlationId</p>
    }

    <button type="submit" disabled="@_isSubmitting">Create Scenario</button>
</EditForm>

@code {
    [Parameter] public EventCallback OnScenarioCreated { get; set; }

    private ScenarioFormModel _model = new();
    private bool _isSubmitting;
    private IReadOnlyList<ICreateScenario_CreateScenario_Errors> _errors = [];
    private string? _correlationId;
    private string? _networkError;

    private string? FieldError(string field) =>
        _errors.FirstOrDefault(e => e.Field == field)?.Message;

    private async Task HandleSubmit()
    {
        _isSubmitting = true;
        _errors = [];
        _correlationId = null;
        _networkError = null;
        StateHasChanged();

        try
        {
            var input = new CreateScenarioInput
            {
                Title = _model.Title,
                Description = string.IsNullOrEmpty(_model.Description) ? null : _model.Description,
                Kind = _model.Kind!.Value,
                ProjectId = "00000000-0000-0000-0000-000000000001"
            };

            var result = await Client.CreateScenario.ExecuteAsync(input);

            if (result.Data?.CreateScenario is { } payload)
            {
                _errors = payload.Errors;
                if (payload.Errors.Count > 0)
                {
                    _correlationId = payload.CorrelationId;
                }
                else if (payload.Scenario is not null)
                {
                    _model = new ScenarioFormModel();
                    await OnScenarioCreated.InvokeAsync();
                }
            }
        }
        catch (Exception)
        {
            _networkError = "Something went wrong. Please try again.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private class ScenarioFormModel
    {
        [Required(ErrorMessage = "Title is required")]
        [MaxLength(500, ErrorMessage = "Title must be 500 characters or fewer")]
        public string Title { get; set; } = string.Empty;
        public string? Description { get; set; }
        [Required(ErrorMessage = "A valid type must be selected")]
        public ScenarioKind? Kind { get; set; }
    }
}
