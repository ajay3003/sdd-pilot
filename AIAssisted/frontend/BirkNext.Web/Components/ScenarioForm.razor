@using BirkNext.Web.GraphQL
@using System.ComponentModel.DataAnnotations
@inject IBirkNextClient Client

<EditForm Model="_model" OnValidSubmit="HandleSubmit" class="scenario-form">
    <DataAnnotationsValidator />

    <div class="scenario-authoring-grid">
        <div class="scenario-authoring-main">
            <section class="scenario-form-card">
                <div class="scenario-card-heading">
                    <p class="section-kicker">Authoring</p>
                    <h2>Scenario Details</h2>
                </div>
                <div class="form-field">
                    <label for="title">Title</label>
                    <InputText id="title" @bind-Value="_model.Title" class="form-control" placeholder="Enter scenario title" />
                    <ValidationMessage For="() => _model.Title" />
                    @if (FieldError("title") is { } titleErr) { <span class="validation-message">@titleErr</span> }
                </div>
                <div class="form-field">
                    <label for="description">Description <span class="form-optional">(optional)</span></label>
                    <InputTextArea id="description" @bind-Value="_model.Description" class="form-control form-textarea" placeholder="Provide additional context or details" rows="5" />
                </div>
            </section>

            <section class="scenario-form-card">
                <div class="scenario-card-heading">
                    <p class="section-kicker">Coverage Metadata</p>
                    <h2>Classification</h2>
                    <span>Classify the scenario so coverage reporting can group tests correctly.</span>
                </div>
                <div class="classification-grid">
                    <div class="form-field">
                        <label for="scenario-type">Scenario Type</label>
                        <InputSelect id="scenario-type" @bind-Value="_model.ScenarioType" class="form-control form-select">
                            <option value="Functional">Functional</option>
                            <option value="Negative">Negative</option>
                            <option value="Edge Case">Edge Case</option>
                            <option value="Performance">Performance</option>
                            <option value="Security">Security</option>
                            <option value="Other">Other</option>
                        </InputSelect>
                    </div>
                    <div class="form-field">
                        <label for="priority">Priority</label>
                        <InputSelect id="priority" @bind-Value="_model.Priority" class="form-control form-select priority-select">
                            <option value="Critical">Critical</option>
                            <option value="High">High</option>
                            <option value="Medium">Medium</option>
                            <option value="Low">Low</option>
                        </InputSelect>
                        <span class="priority-badge priority-@_model.Priority.ToLowerInvariant()">@_model.Priority</span>
                    </div>
                </div>
            </section>

            <section class="scenario-form-card">
                <div class="scenario-card-heading">
                    <p class="section-kicker">Pass Criteria</p>
                    <h2>Expected Result</h2>
                </div>
                <div class="form-field">
                    <label for="expected-result">Expected Result</label>
                    <InputTextArea id="expected-result" @bind-Value="_model.ExpectedResult" class="form-control form-textarea" placeholder="Describe what should happen when the scenario passes." rows="4" />
                    <p class="field-example">Example: The scenario is successfully saved and appears in the scenario list.</p>
                </div>
            </section>
        </div>

        <aside class="scenario-authoring-aside" aria-label="Scenario authoring guidance">
            <section class="scenario-guidance-card">
                <div class="scenario-card-heading">
                    <p class="section-kicker">Traceability</p>
                    <h2>Traceability Impact</h2>
                </div>
                <p>This scenario can later be linked to:</p>
                <ul class="impact-list">
                    <li>Requirements</li>
                    <li>Clarifications</li>
                    <li>Coverage Reviews</li>
                    <li>QA Dashboard Metrics</li>
                </ul>
            </section>

            <section class="scenario-guidance-card">
                <div class="scenario-card-heading">
                    <p class="section-kicker">Quality</p>
                    <h2>QA Scenario Quality Tips</h2>
                </div>
                <h3>Good scenarios:</h3>
                <ul class="quality-list good">
                    <li>Test one behavior</li>
                    <li>Have a clear expected result</li>
                    <li>Are easy to trace to requirements</li>
                    <li>Can be reused</li>
                </ul>
                <h3>Avoid:</h3>
                <ul class="quality-list avoid">
                    <li>Multiple behaviors in one test</li>
                    <li>Ambiguous outcomes</li>
                    <li>Missing expected results</li>
                    <li>No business context</li>
                </ul>
            </section>
        </aside>
    </div>

    @{ var unrouted = _errors.Where(e => e.Field is not "title").ToList(); }
    @if (unrouted.Count > 0)
    {
        <ul role="alert" class="form-errors">
            @foreach (var error in unrouted)
            {
                <li>@error.Message</li>
            }
        </ul>
    }

    @if (_networkError is not null)
    {
        <p role="alert" class="form-network-error">@_networkError</p>
    }

    @if (_correlationId is not null)
    {
        <p class="form-support-ref">Support reference: @_correlationId</p>
    }

    <div class="form-actions">
        <a href="scenarios" class="btn-secondary">Cancel</a>
        <button type="submit" disabled="@_isSubmitting" class="btn-primary">
            @if (_isSubmitting)
            {
                <span>Saving...</span>
            }
            else
            {
                <span>Save Scenario</span>
            }
        </button>
    </div>
</EditForm>

@code {
    [Parameter] public EventCallback OnScenarioCreated { get; set; }

    private ScenarioFormModel _model = new();
    private bool _isSubmitting;
    private IReadOnlyList<ICreateScenario_CreateScenario_Errors> _errors = [];
    private string? _correlationId;
    private string? _networkError;

    private string? FieldError(string field) =>
        _errors.FirstOrDefault(e => e.Field == field)?.Message;

    private async Task HandleSubmit()
    {
        _isSubmitting = true;
        _errors = [];
        _correlationId = null;
        _networkError = null;
        StateHasChanged();

        try
        {
            var input = new CreateScenarioInput
            {
                Title = _model.Title,
                Description = string.IsNullOrEmpty(_model.Description) ? null : _model.Description,
                Kind = ScenarioKind.Test,
                ProjectId = "00000000-0000-0000-0000-000000000001"
            };

            var result = await Client.CreateScenario.ExecuteAsync(input);

            if (result.Data?.CreateScenario is { } payload)
            {
                _errors = payload.Errors;
                if (payload.Errors.Count > 0)
                {
                    _correlationId = payload.CorrelationId;
                }
                else if (payload.Scenario is not null)
                {
                    _model = new ScenarioFormModel();
                    await OnScenarioCreated.InvokeAsync();
                }
            }
            else
            {
                _networkError = "Something went wrong. Please try again.";
            }
        }
        catch (Exception)
        {
            _networkError = "Something went wrong. Please try again.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private class ScenarioFormModel
    {
        [Required(ErrorMessage = "Title is required")]
        [MaxLength(500, ErrorMessage = "Title must be 500 characters or fewer")]
        public string Title { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string ScenarioType { get; set; } = "Functional";
        public string Priority { get; set; } = "Medium";
        public string? ExpectedResult { get; set; }
    }
}
