@using BirkNext.Web.Models
@using BirkNext.Web.Services
@inject IDataModelAnalysisService AnalysisService

@* ── Empty state ──────────────────────────────────────────────────────────────── *@
@if (_document is null)
{
    <div class="dme-empty-state">
        <div class="dme-empty-icon" aria-hidden="true">🗄️</div>
        <h3 class="dme-empty-title">Data Model Explorer</h3>
        <p class="dme-empty-desc">Parse and explore database entities, tables, relationships, constraints, indexes, and traceability from a Data Model artifact; any file name works.</p>

        <div class="dme-input-area">
            <div class="dme-input-header">
                <span class="dme-input-label">Data Model document</span>
                <span class="dme-input-hint">Supports .md and .txt</span>
            </div>
            <SpecificationImport
                @ref="_importRef"
                InputId="dme-file-input"
                OnFileImported="OnFileImported"
                OnFileRemoved="OnFileRemoved"
                IsDisabled="false" />
            <textarea class="dme-textarea"
                      aria-label="Data Model content"
                      placeholder="Or paste data model content here…"
                      rows="12"
                      @bind="_localText"
                      @bind:event="oninput"></textarea>
            @if (!string.IsNullOrWhiteSpace(_localText))
            {
                <div class="dme-input-footer">
                    <span class="dme-input-stat">@(_localText.Split('\n').Length) lines · @_localText.Length chars</span>
                    <button class="dme-clear-btn" @onclick="ClearInput">Clear</button>
                </div>
            }
        </div>

        <button class="dme-build-btn" disabled="@(!CanBuild)" @onclick="BuildAsync">
            Build Data Model Explorer
        </button>
    </div>
}
else
{
    @* ── Explorer header ──────────────────────────────────────────────────────── *@
    <div class="dme-header">
        <div class="dme-header-left">
            <span class="dme-header-title">@_document.Title</span>
            @if (_document.ErrorCount > 0)
            {
                <span class="dme-header-badge dme-badge-warn">@_document.ErrorCount issue@(_document.ErrorCount != 1 ? "s" : "")</span>
            }
        </div>
        <div class="dme-header-right">
            <div class="dme-tab-bar" role="tablist">
                <button class="dme-tab @(_activeTab == "model" ? "is-active" : "")"
                        role="tab" aria-selected="@(_activeTab == "model" ? "true" : "false")" data-testid="dme-tab-model"
                        @onclick='() => SetTab("model")'>Model</button>
                <button class="dme-tab @(_activeTab == "overview" ? "is-active" : "")"
                        role="tab" aria-selected="@(_activeTab == "overview" ? "true" : "false")"
                        @onclick='() => SetTab("overview")'>Overview</button>
                <button class="dme-tab @(_activeTab == "design" ? "is-active" : "")"
                        role="tab" aria-selected="@(_activeTab == "design" ? "true" : "false")"
                        @onclick='() => SetTab("design")'>
                    Data Structures @if (_document.EntityCount > 0) { <span class="dme-tab-count">@_document.EntityCount</span> }
                </button>
                <button class="dme-tab @(_activeTab == "relationships" ? "is-active" : "")"
                        role="tab" aria-selected="@(_activeTab == "relationships" ? "true" : "false")"
                        @onclick='() => SetTab("relationships")'>
                    Relationships @if (_document.RelationshipCount > 0) { <span class="dme-tab-count">@_document.RelationshipCount</span> }
                </button>
                <button class="dme-tab @(_activeTab == "indexes" ? "is-active" : "")"
                        role="tab" aria-selected="@(_activeTab == "indexes" ? "true" : "false")"
                        @onclick='() => SetTab("indexes")'>
                    Indexes &amp; Constraints @if (_document.IndexCount > 0) { <span class="dme-tab-count">@_document.IndexCount</span> }
                </button>
                <button class="dme-tab @(_activeTab == "traceability" ? "is-active" : "")"
                        role="tab" aria-selected="@(_activeTab == "traceability" ? "true" : "false")"
                        @onclick='() => SetTab("traceability")'>Traceability</button>
                <button class="dme-tab @(_activeTab == "findings" ? "is-active" : "")"
                        role="tab" aria-selected="@(_activeTab == "findings" ? "true" : "false")"
                        @onclick='() => SetTab("findings")'>
                    Findings @if (_document.FindingCount > 0) { <span class="dme-tab-count @(_document.ErrorCount > 0 ? "dme-tab-count-warn" : "")">@_document.FindingCount</span> }
                </button>
            </div>
        </div>
    </div>

    @* ── Search bar (entity/relationship/index tabs) ───────────────────────────── *@
    @if ((_activeTab == "relationships" && _document.Relationships.Count > 0) || (_activeTab == "indexes" && (_document.Indexes.Count > 0 || _document.Constraints.Count > 0)))
    {
        <div class="dme-search-bar">
            <input type="search" class="dme-search"
                   placeholder="@SearchPlaceholder"
                   value="@_searchQuery"
                   @oninput="HandleSearch"
                   aria-label="@SearchAriaLabel" />
            @if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                <button class="dme-search-clear" @onclick="ClearSearch" title="Clear">×</button>
                <span class="dme-search-count">@SearchResultCount result@(SearchResultCount != 1 ? "s" : "")</span>
            }
        </div>
    }

    @* ── Tab body ──────────────────────────────────────────────────────────────── *@
    <div class="dme-tab-body">

        @* ── Model (primary): the normalized model — structures, fields, relationships, enums, provenance. Parser structure is only in technical details. *@
        @if (_activeTab == "model")
        {
            @ModelView(_document)
        }

        @* ── Overview ────────────────────────────────────────────────────────── *@
        @if (_activeTab == "overview")
        {
            <div class="dme-overview">
                <div class="dme-stat-row">
                    <div class="dme-stat">
                        <span class="dme-stat-value">@_document.EntityCount</span>
                        <span class="dme-stat-label">Data structures</span>
                    </div>
                    <div class="dme-stat">
                        <span class="dme-stat-value">@EvidenceValue(_document.ColumnCount, _document.ColumnEvidence)</span>
                        <span class="dme-stat-label">Fields / columns</span>
                        <span class="dme-stat-detail">@EvidenceLabel(_document.ColumnEvidence)</span>
                    </div>
                    <div class="dme-stat">
                        <span class="dme-stat-value">@EvidenceValue(_document.RelationshipCount, _document.RelationshipEvidence)</span>
                        <span class="dme-stat-label">Relationships</span>
                        <span class="dme-stat-detail">@EvidenceLabel(_document.RelationshipEvidence)</span>
                    </div>
                    <div class="dme-stat">
                        <span class="dme-stat-value">@EvidenceValue(_document.IndexCount, _document.IndexEvidence)</span>
                        <span class="dme-stat-label">Indexes</span>
                        <span class="dme-stat-detail">@EvidenceLabel(_document.IndexEvidence)</span>
                    </div>
                    <div class="dme-stat @(_document.ErrorCount > 0 ? "dme-stat-error" : (_document.WarningCount > 0 ? "dme-stat-warn" : ""))">
                        <span class="dme-stat-value">@_document.FindingCount</span>
                        <span class="dme-stat-label">Findings</span>
                    </div>
                    @if (_document.EvidenceGaps.Count > 0)
                    {
                        <div class="dme-stat dme-stat-neutral" data-testid="dme-evidence-gap-count">
                            <span class="dme-stat-value">@_document.EvidenceGaps.Count</span>
                            <span class="dme-stat-label">Evidence gaps</span>
                        </div>
                    }
                </div>

                <p class="dme-source-disclaimer" data-testid="dme-source-disclaimer">Source-derived model only. Deployed database schemas and runtime state are not verified here.</p>

                @if (_document.Entities.Count > 0)
                {
                    <section class="dme-structure-breakdown" data-testid="dme-structure-breakdown" aria-label="Data structure kinds">
                        @foreach (var kindGroup in _document.Entities.GroupBy(e => e.Kind).OrderBy(g => g.Key))
                        {
                            <span class="dme-structure-chip">@kindGroup.Count() @StructureKindPlural(kindGroup.Key)</span>
                        }
                    </section>
                }

                @if (!string.IsNullOrWhiteSpace(_document.Overview))
                {
                    <section class="dme-overview-text" data-testid="dme-structured-overview">
                        <div class="dme-section-label">Overview</div>
                        <MarkdownContent Content="@_document.Overview" CssClass="dme-overview-markdown" />
                    </section>
                }

                @if (_document.EvidenceGaps.Count > 0)
                {
                    <section class="dme-evidence-gaps" data-testid="dme-evidence-gaps">
                        <div class="dme-section-label">Evidence not available in this artifact</div>
                        @foreach (var group in _document.EvidenceGaps.GroupBy(g => g.Category))
                        {
                            <div class="dme-evidence-gap-row">
                                <strong>@group.Key</strong>
                                <span>@string.Join("; ", group.Select(g => string.IsNullOrWhiteSpace(g.EntityName) ? g.Description : $"{g.EntityName}: {g.Description}"))</span>
                            </div>
                        }
                    </section>
                }

                @if (_document.Findings.Count > 0)
                {
                    <div class="dme-findings-summary">
                        <div class="dme-section-label">Top Findings</div>
                        @foreach (var f in _document.Findings.OrderBy(f => GetSeverityPriority(f.Severity)).Take(5))
                        {
                            <div class="dme-finding-row">
                                <span class="dme-sev dme-sev-@f.Severity.ToString().ToLowerInvariant()">@f.Severity</span>
                                <span class="dme-finding-cat">@f.Category</span>
                                <span class="dme-finding-desc">
                                    @if (!string.IsNullOrEmpty(f.EntityName)) { <strong>@f.EntityName:</strong> @(string.Empty) }
                                    @f.Description
                                </span>
                            </div>
                        }
                        @if (_document.Findings.Count > 5)
                        {
                            <button class="dme-show-all-btn" @onclick='() => SetTab("findings")'>
                                View all @_document.FindingCount findings →
                            </button>
                        }
                    </div>
                }

                @if (_document.Enums.Count > 0)
                {
                    <div class="dme-overview-enums">
                        <div class="dme-section-label">Enums (@_document.Enums.Count)</div>
                        <div class="dme-enum-chips">
                            @foreach (var e in _document.Enums)
                            {
                                <div class="dme-enum-chip" title="@string.Join(", ", e.Values)" data-birknext-projection-id="@e.Provenance?.ProjectionId" data-birknext-projection-kind="@e.Provenance?.ProjectionKind">
                                    <strong>@e.Name</strong>
                                    <span class="dme-enum-count">@e.Values.Count values</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        @* ── DB Design ────────────────────────────────────────────────────────── *@
        @if (_activeTab == "design")
        {
            @if (_document.Entities.Count == 0)
            {
                <div class="dme-empty-tab">No data structures were extracted from this artifact.</div>
            }
            else
            {
                <div class="dme-design-canvas">
                    <div class="dme-design-legend">
                        <span class="dme-db-badge dme-db-pk">PK</span> <span>Primary Key</span>
                        <span class="dme-db-badge dme-db-fk">FK</span> <span>Foreign Key</span>
                        <span class="dme-db-badge dme-db-uq">UQ</span> <span>Unique</span>
                        <span class="dme-db-badge dme-db-idx">IDX</span> <span>Indexed</span>
                        <span class="dme-db-badge dme-db-req">REQ</span> <span>Required</span>
                        <span class="dme-db-badge dme-db-sens">SENS</span> <span>Sensitive</span>
                    </div>

                    <div class="dme-design-grid">
                        @foreach (var entity in _document.Entities)
                        {
                            var eFindings  = GetEntityFindings(entity.Name);
                            var hasWarn    = eFindings.Any(f => f.Severity == DataModelSeverity.Warning);
                            var hasError   = eFindings.Any(f => f.Severity is DataModelSeverity.Error or DataModelSeverity.Critical);
                            var cardMod    = hasError ? "has-error" : hasWarn ? "has-warning" : "";
                            var entityRels = GetEntityRelationships(entity.Name);

                            <div class="dme-dc @cardMod" data-birknext-projection-id="@entity.Provenance?.ProjectionId" data-birknext-projection-kind="@entity.Provenance?.ProjectionKind">
                                <div class="dme-dc-header">
                                    <span class="dme-dc-kind">@StructureKindLabel(entity.Kind)</span>
                                    <span class="dme-dc-name" title="@entity.Name">@entity.Name</span>
                                    @if (eFindings.Count > 0)
                                    {
                                        <span class="dme-dc-issue-count @(hasError ? "is-error" : "is-warn")">@eFindings.Count</span>
                                    }
                                </div>

                                @if (entity.Columns.Count > 0)
                                {
                                    <div class="dme-dc-cols">
                                        @foreach (var col in entity.Columns)
                                        {
                                            var indexed = IsColumnIndexed(entity, col);
                                            var isSens  = AnalysisService.IsSensitiveColumn(col);
                                            <div class="dme-dc-col @(col.IsPrimaryKey ? "is-pk" : col.IsForeignKey ? "is-fk" : "")" data-birknext-projection-id="@col.Provenance?.ProjectionId" data-birknext-projection-kind="@col.Provenance?.ProjectionKind">
                                                <span class="dme-dc-col-name" title="@col.Name">@col.Name</span>
                                                <div class="dme-dc-badges">
                                                    @if (col.IsPrimaryKey)                           { <span class="dme-db-badge dme-db-pk">PK</span> }
                                                    @if (col.IsForeignKey)                           { <span class="dme-db-badge dme-db-fk">FK</span> }
                                                    @if (col.IsUnique && !col.IsPrimaryKey)          { <span class="dme-db-badge dme-db-uq">UQ</span> }
                                                    @if (indexed && !col.IsPrimaryKey)               { <span class="dme-db-badge dme-db-idx">IDX</span> }
                                                    @if (col.Nullable == false && !col.IsPrimaryKey) { <span class="dme-db-badge dme-db-req">REQ</span> }
                                                    @if (isSens)                                     { <span class="dme-db-badge dme-db-sens">SENS</span> }
                                                </div>
                                                @if (!string.IsNullOrEmpty(col.Type))
                                                {
                                                    <span class="dme-dc-col-type" title="@col.Type">@col.Type</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="dme-dc-no-cols">@(entity.IsTable || entity.Kind == DataStructureKind.Table ? "Column-level detail was not extracted from this artifact." : "Fields or properties were not extracted from this artifact.")</div>
                                }

                                @if (entity.TraceabilityIds.Count > 0 || entityRels.Count > 0 || eFindings.Count > 0)
                                {
                                    <div class="dme-dc-footer">
                                        @if (entity.TraceabilityIds.Count > 0)
                                        {
                                            <span class="dme-dc-fc">@entity.TraceabilityIds.Count req</span>
                                        }
                                        @if (entityRels.Count > 0)
                                        {
                                            <span class="dme-dc-fc">@entityRels.Count rel@(entityRels.Count != 1 ? "s" : "")</span>
                                        }
                                        @if (eFindings.Count > 0)
                                        {
                                            <span class="dme-dc-fc dme-dc-fc-issues @(hasError ? "is-error" : "is-warn")">
                                                ⚠ @eFindings.Count issue@(eFindings.Count != 1 ? "s" : "")
                                            </span>
                                        }
                                    </div>
                                }

                                @if (eFindings.Count > 0)
                                {
                                    <div class="dme-dc-issue-list">
                                        @foreach (var f in eFindings.OrderBy(f => GetSeverityPriority(f.Severity)))
                                        {
                                            <div class="dme-dc-issue dme-sev-@f.Severity.ToString().ToLowerInvariant()">
                                                @f.Description
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    @if (_document.Relationships.Count > 0)
                    {
                        <div class="dme-design-rels">
                            <div class="dme-section-label">Relationships (@_document.RelationshipCount)</div>
                            <div class="dme-rel-list" role="list">
                                @foreach (var rel in _document.Relationships)
                                {
                                    <div class="dme-rel-row" role="listitem" data-birknext-projection-id="@rel.Provenance?.ProjectionId" data-birknext-projection-kind="@rel.Provenance?.ProjectionKind">
                                        <div class="dme-rel-source">
                                            <span class="dme-rel-entity">@rel.SourceEntity</span>
                                            @if (!string.IsNullOrEmpty(rel.SourceColumn))
                                            { <span class="dme-rel-column">.@rel.SourceColumn</span> }
                                        </div>
                                        <span class="dme-rel-arrow" aria-hidden="true">→</span>
                                        <div class="dme-rel-target">
                                            <span class="dme-rel-entity">@rel.TargetEntity</span>
                                            @if (!string.IsNullOrEmpty(rel.TargetColumn))
                                            { <span class="dme-rel-column">.@rel.TargetColumn</span> }
                                        </div>
                                        @if (!string.IsNullOrEmpty(rel.RelationshipType))
                                        {
                                            <span class="dme-rel-type">@rel.RelationshipType</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        }

        @* ── Relationships ────────────────────────────────────────────────────── *@
        @if (_activeTab == "relationships")
        {
            var visible = AnalysisService.FilterRelationships(_document.Relationships, _searchQuery).ToList();

            @if (visible.Count == 0)
            {
                <div class="dme-empty-tab">
                    @if (!string.IsNullOrWhiteSpace(_searchQuery))
                    { <span>No relationships match "<strong>@_searchQuery</strong>"</span> }
                    else
                    { <span>@EvidenceEmptyMessage("Relationships", _document.RelationshipEvidence)</span> }
                </div>
            }
            else
            {
                <div class="dme-rel-list" role="list">
                    @foreach (var rel in visible)
                    {
                        <div class="dme-rel-row" role="listitem" data-birknext-projection-id="@rel.Provenance?.ProjectionId" data-birknext-projection-kind="@rel.Provenance?.ProjectionKind">
                            <div class="dme-rel-source">
                                <span class="dme-rel-entity">@rel.SourceEntity</span>
                                @if (!string.IsNullOrEmpty(rel.SourceColumn))
                                { <span class="dme-rel-column">.@rel.SourceColumn</span> }
                            </div>
                            <span class="dme-rel-arrow" aria-hidden="true">→</span>
                            <div class="dme-rel-target">
                                <span class="dme-rel-entity">@rel.TargetEntity</span>
                                @if (!string.IsNullOrEmpty(rel.TargetColumn))
                                { <span class="dme-rel-column">.@rel.TargetColumn</span> }
                            </div>
                            @if (!string.IsNullOrEmpty(rel.RelationshipType))
                            {
                                <span class="dme-rel-type">@rel.RelationshipType</span>
                            }
                            else
                            {
                                <span class="dme-rel-type dme-rel-type-unspecified">Type not specified</span>
                            }
                        </div>
                    }
                </div>
            }
        }

        @* ── Indexes & Constraints ────────────────────────────────────────────── *@
        @if (_activeTab == "indexes")
        {
            var visibleIdx = AnalysisService.FilterIndexes(_document.Indexes, _searchQuery).ToList();
            var visibleCon = AnalysisService.FilterConstraints(_document.Constraints, _searchQuery).ToList();

            <div class="dme-idx-section">
                <div class="dme-section-label">Indexes (@EvidenceValue(_document.IndexCount, _document.IndexEvidence)) · @EvidenceLabel(_document.IndexEvidence)</div>
                @if (visibleIdx.Count == 0)
                {
                    <div class="dme-empty-tab" style="padding:0.5rem 0">
                        @if (!string.IsNullOrWhiteSpace(_searchQuery))
                        { <span>No indexes match "<strong>@_searchQuery</strong>"</span> }
                        else
                        { <span>@EvidenceEmptyMessage("Indexes", _document.IndexEvidence)</span> }
                    </div>
                }
                else
                {
                    <div class="dme-idx-list" role="list">
                        @foreach (var idx in visibleIdx)
                        {
                            <div class="dme-idx-row" role="listitem" data-birknext-projection-id="@idx.Provenance?.ProjectionId" data-birknext-projection-kind="@idx.Provenance?.ProjectionKind">
                                <span class="dme-idx-name" title="@idx.Name">@idx.Name</span>
                                @if (!string.IsNullOrEmpty(idx.EntityName))
                                { <span class="dme-idx-entity">@idx.EntityName</span> }
                                @if (idx.Columns.Count > 0)
                                { <span class="dme-idx-cols">on @string.Join(", ", idx.Columns)</span> }
                                @if (idx.IsUnique)
                                { <span class="dme-idx-unique">UNIQUE</span> }
                            </div>
                        }
                    </div>
                }
            </div>

            @if (_document.Constraints.Count > 0)
            {
                <div class="dme-idx-section" style="margin-top:1.5rem">
                    <div class="dme-section-label">Constraints (@EvidenceValue(_document.Constraints.Count, _document.ConstraintEvidence)) · @EvidenceLabel(_document.ConstraintEvidence)</div>
                    @if (visibleCon.Count == 0)
                    {
                        <div class="dme-empty-tab" style="padding:0.5rem 0">
                            @if (!string.IsNullOrWhiteSpace(_searchQuery))
                            { <span>No constraints match "<strong>@_searchQuery</strong>"</span> }
                            else
                            { <span>No constraints defined.</span> }
                        </div>
                    }
                    else
                    {
                        <div class="dme-idx-list" role="list">
                            @foreach (var con in visibleCon)
                            {
                                <div class="dme-idx-row" role="listitem" data-birknext-projection-id="@con.Provenance?.ProjectionId" data-birknext-projection-kind="@con.Provenance?.ProjectionKind">
                                    <span class="dme-con-type dme-con-@con.ConstraintType.ToLowerInvariant()" title="@GetConstraintTypeLabel(con.ConstraintType)">@con.ConstraintType</span>
                                    <span class="dme-idx-name" title="@con.Name">@con.Name</span>
                                    @if (!string.IsNullOrEmpty(con.EntityName))
                                    { <span class="dme-idx-entity">@con.EntityName</span> }
                                    @if (!string.IsNullOrEmpty(con.Definition))
                                    { <span class="dme-idx-cols">@con.Definition</span> }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }

        @* ── Traceability ─────────────────────────────────────────────────────── *@
        @if (_activeTab == "traceability")
        {
            var linked   = _document.Entities.Where(e => e.TraceabilityIds.Count > 0).ToList();
            var unlinked = _document.Entities.Where(e => e.TraceabilityIds.Count == 0).ToList();
            var allIds   = _document.Entities.SelectMany(e => e.TraceabilityIds)
                                             .Distinct(StringComparer.OrdinalIgnoreCase)
                                             .OrderBy(x => x)
                                             .ToList();

            <div class="dme-trace-summary">
                <div class="dme-stat-row">
                    <div class="dme-stat">
                        <span class="dme-stat-value">@allIds.Count</span>
                        <span class="dme-stat-label">Unique Traceability IDs</span>
                    </div>
                    <div class="dme-stat">
                        <span class="dme-stat-value">@linked.Count</span>
                        <span class="dme-stat-label">Data structures linked</span>
                    </div>
                    <div class="dme-stat">
                        <span class="dme-stat-value">@unlinked.Count</span>
                        <span class="dme-stat-label">Data structures without links</span>
                    </div>
                </div>
            </div>

            @if (linked.Count > 0)
            {
                <div class="dme-section-label" style="margin-top:1.5rem">Linked data structures</div>
                @foreach (var entity in linked)
                {
                    <div class="dme-trace-entity-row">
                        <span class="dme-entity-kind-sm">@StructureKindLabel(entity.Kind)</span>
                        <span class="dme-entity-name" title="@entity.Name">@entity.Name</span>
                        <div class="dme-trace-chips">
                            @foreach (var id in entity.TraceabilityIds)
                            {
                                <span class="dme-trace-chip">@id</span>
                            }
                        </div>
                    </div>
                }
            }

            @if (unlinked.Count > 0)
            {
                <div class="dme-section-label" style="margin-top:1.5rem">
                    Data structures with no requirement references extracted (@unlinked.Count)
                </div>
                @foreach (var entity in unlinked)
                {
                    <div class="dme-trace-entity-row dme-trace-unlinked">
                        <span class="dme-entity-kind-sm">@StructureKindLabel(entity.Kind)</span>
                        <span class="dme-entity-name">@entity.Name</span>
                        <span class="dme-trace-missing">no requirement references extracted</span>
                    </div>
                }
            }
        }

        @* ── Findings ─────────────────────────────────────────────────────────── *@
        @if (_activeTab == "findings")
        {
            @if (_document.EvidenceGaps.Count > 0)
            {
                <section class="dme-evidence-gaps" data-testid="dme-findings-evidence-gaps">
                    <div class="dme-section-label">Evidence gaps · not model findings</div>
                    @foreach (var gap in _document.EvidenceGaps)
                    {
                        <div class="dme-evidence-gap-row">
                            <strong>@gap.Category@(string.IsNullOrWhiteSpace(gap.EntityName) ? "" : $" · {gap.EntityName}")</strong>
                            <span>@gap.Description</span>
                        </div>
                    }
                </section>
            }
            @if (_document.Findings.Count == 0)
            {
                <div class="dme-empty-tab">
                    <span>No deterministic model findings were generated from the evidence extracted here.</span>
                </div>
            }
            else
            {
                @foreach (var group in _document.Findings
                    .GroupBy(f => f.Category)
                    .OrderBy(g => g.Key))
                {
                    <div class="dme-finding-group">
                        <div class="dme-section-label">@group.Key</div>
                        @foreach (var f in group.OrderBy(f => GetSeverityPriority(f.Severity)))
                        {
                            <div class="dme-finding-row">
                                <span class="dme-sev dme-sev-@f.Severity.ToString().ToLowerInvariant()">@f.Severity</span>
                                @if (!string.IsNullOrEmpty(f.EntityName))
                                {
                                    <span class="dme-finding-entity">@f.EntityName</span>
                                }
                                <span class="dme-finding-desc">@f.Description</span>
                            </div>
                        }
                    </div>
                }
            }
        }

    </div>
}

<MarkdownSourceNotesPanel Blocks="@(_document?.UnmappedSourceBlocks)" Lazy="true" Summary="Parsed document structure — technical details" />

@code {
    [Parameter] public string              DataModelText { get; set; } = string.Empty;
    [Parameter] public DataModelDocument?  ParsedDataModel { get; set; }
    [Parameter] public DataModelSemanticModel? SemanticModel { get; set; }
    [Parameter] public string?             InitialView   { get; set; }
    [Parameter] public EventCallback<string> OnTextChanged { get; set; }
    /// <summary>The selected artifact's path and revision (provenance of every fact); a path under autodoc/ or generated-docs/ is derived documentation.</summary>
    [Parameter] public string?             ArtifactPath  { get; set; }
    [Parameter] public int?                ArtifactRevision { get; set; }
    /// <summary>Replaces the origin label (e.g. for the derived aggregate of a shared base and a pack model).</summary>
    [Parameter] public string?             OriginOverride { get; set; }
    /// <summary>The layer of each structure in a derived aggregate (Shared base / Pack model / Overridden in pack); null for one document.</summary>
    [Parameter] public IReadOnlyDictionary<string, DataModelLayerOrigin>? EntityLayers { get; set; }
    /// <summary>With <see cref="EntityLayers"/>: the document each layer comes from, so a structure's lines name its own source.</summary>
    [Parameter] public string?             BaseArtifactPath { get; set; }
    [Parameter] public string?             PackArtifactPath { get; set; }

    private string? SourceOf(DataEntity entity) => EntityLayers?.TryGetValue(entity.Name, out var layer) == true
        ? layer == DataModelLayerOrigin.SharedBase ? BaseArtifactPath : PackArtifactPath
        : ArtifactPath;

    private DataModelDocument? _document;
    private string             _localText   = string.Empty;
    private string             _activeTab   = "overview";
    private string             _searchQuery = string.Empty;
    private SpecificationImport? _importRef;

    private bool CanBuild => !string.IsNullOrWhiteSpace(_localText);

    private static string EvidenceValue(int count, DataModelEvidenceState state) => state switch
    {
        DataModelEvidenceState.Extracted or DataModelEvidenceState.NoneDeclared => count.ToString(),
        _ => "—",
    };

    private static string EvidenceLabel(DataModelEvidenceState state) => state switch
    {
        DataModelEvidenceState.Extracted => "Extracted from artifact",
        DataModelEvidenceState.NoneDeclared => "None declared in artifact",
        DataModelEvidenceState.NotExtracted => "Not extracted",
        DataModelEvidenceState.NotRepresented => "Not represented",
        DataModelEvidenceState.Unsupported => "Notation not supported",
        DataModelEvidenceState.NotApplicable => "Not applicable",
        _ => "Not assessed",
    };

    private static string EvidenceEmptyMessage(string subject, DataModelEvidenceState state) => state switch
    {
        DataModelEvidenceState.NoneDeclared => $"No {subject.ToLowerInvariant()} are declared in this artifact.",
        DataModelEvidenceState.Unsupported => $"{subject} are mentioned, but this notation was not extracted by the analyzer.",
        DataModelEvidenceState.NotApplicable => $"{subject} are not applicable to the extracted data structures.",
        DataModelEvidenceState.NotExtracted => $"{subject} were not extracted from this artifact.",
        _ => $"No {subject.ToLowerInvariant()} definitions are represented in this artifact; this does not confirm that none exist.",
    };

    private static string StructureKindLabel(DataStructureKind kind) => kind switch
    {
        DataStructureKind.Table => "Table",
        DataStructureKind.PersistentEntity => "Persistent structure",
        DataStructureKind.Record => "Record / DTO",
        DataStructureKind.Event => "Event",
        DataStructureKind.Message => "Message",
        DataStructureKind.DataStructure => "Data structure",
        _ => "Unclassified structure",
    };

    private static string StructureKindPlural(DataStructureKind kind) => kind switch
    {
        DataStructureKind.Table => "tables",
        DataStructureKind.PersistentEntity => "persistent entities",
        DataStructureKind.Record => "records / DTOs",
        DataStructureKind.Event => "events",
        DataStructureKind.Message => "messages",
        DataStructureKind.DataStructure => "data structures",
        _ => "unclassified structures",
    };

    // ── Lifecycle ────────────────────────────────────────────────────────────

    protected override void OnParametersSet()
    {
        if (ParsedDataModel is not null)
        {
            if (!ReferenceEquals(_document, ParsedDataModel)) _selectedEntity = null;
            _document = ParsedDataModel;
            _activeTab = InitialView ?? "model";
            _searchQuery = string.Empty;
        }
        else if (!string.IsNullOrWhiteSpace(DataModelText) && _document is null)
        {
            _localText = DataModelText;
            Build();
        }

        if (InitialView is not null && _document is not null)
            _activeTab = InitialView;
    }

    // ── Actions ──────────────────────────────────────────────────────────────

    private async Task BuildAsync()
    {
        if (string.IsNullOrWhiteSpace(_localText)) return;
        await OnTextChanged.InvokeAsync(_localText);
    }

    private void Build()
    {
        if (string.IsNullOrWhiteSpace(_localText)) return;
        _document    = AnalysisService.Parse(_localText);
        _activeTab   = InitialView ?? "model";
        _selectedEntity = null;
        _searchQuery = string.Empty;
    }


    private void ClearInput()
    {
        _localText = string.Empty;
        _importRef?.Reset();
    }

    // ── Model view ───────────────────────────────────────────────────────────────

    private string? _selectedEntity;
    private string _modelQuery = string.Empty, _modelFilter = "all";

    private bool GeneratedOrigin => ArtifactPath is { } path && (path.Contains("/autodoc/", StringComparison.OrdinalIgnoreCase) || path.Contains("generated-docs/", StringComparison.OrdinalIgnoreCase));
    private string OriginLabel => OriginOverride ?? (GeneratedOrigin ? "Generated documentation — derived, never the canonical model" : "Authored document");

    private IEnumerable<DataEntity> ModelEntities(DataModelDocument document) => document.Entities
        .Where(e => _modelFilter switch
        {
            "tables" => e.IsTable || e.Kind == DataStructureKind.Table,
            "records" => e.Kind == DataStructureKind.Record,
            "events" => e.Kind is DataStructureKind.Event or DataStructureKind.Message,
            "relationships" => RelationshipsOf(document, e.Name).Any(),
            _ => true,
        })
        .Where(e => _modelQuery.Trim() is not { Length: > 0 } q || e.Name.Contains(q, StringComparison.OrdinalIgnoreCase)
            || e.Columns.Any(c => c.Name.Contains(q, StringComparison.OrdinalIgnoreCase) || (c.Type ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)))
        .OrderBy(e => e.Name, StringComparer.OrdinalIgnoreCase);

    private static IEnumerable<DataRelationship> RelationshipsOf(DataModelDocument document, string entity) =>
        document.Relationships.Where(r => string.Equals(r.SourceEntity, entity, StringComparison.OrdinalIgnoreCase) || string.Equals(r.TargetEntity, entity, StringComparison.OrdinalIgnoreCase));

    private static string Required(DataColumn c) => c.Nullable switch { false => "Required", true => "Optional", _ => "Unknown" };
    private static string NullableText(DataColumn c) => c.Nullable switch { true => "Yes", false => "No", _ => "Unknown" };

    private static string Cardinality(DataColumn c) => c.Type is not { Length: > 0 } t ? "Unknown"
        : t.EndsWith("[]", StringComparison.Ordinal) || System.Text.RegularExpressions.Regex.IsMatch(t, @"^(I?List|IReadOnlyList|IEnumerable|ICollection|IReadOnlyCollection|HashSet|Collection)<", System.Text.RegularExpressions.RegexOptions.CultureInvariant)
            || t.Contains("array", StringComparison.OrdinalIgnoreCase) ? "Many" : "One";

    private string NormalizedType(DataColumn c)
    {
        if (c.Type is not { Length: > 0 } raw) return "Unknown";
        var t = raw.Trim('`').TrimEnd('?').ToLowerInvariant();
        if (Cardinality(c) == "Many") return "collection";
        if (_document?.Enums.Any(e => string.Equals(e.Name, raw.Trim('`').TrimEnd('?'), StringComparison.OrdinalIgnoreCase)) == true) return "enum";
        return t switch
        {
            "string" or "text" or "varchar" or "nvarchar" or "char" or "uuid" or "guid" or "uniqueidentifier" => t is "uuid" or "guid" or "uniqueidentifier" ? "identifier" : "string",
            "int" or "integer" or "long" or "bigint" or "smallint" or "short" or "int32" or "int64" or "serial" => "integer",
            "decimal" or "numeric" or "double" or "float" or "money" or "real" => "decimal",
            "bool" or "boolean" or "bit" => "boolean",
            "date" or "dateonly" => "date",
            "datetime" or "datetimeoffset" or "timestamp" or "timestamptz" or "datetime2" => "datetime",
            _ when t.StartsWith("varchar(", StringComparison.Ordinal) || t.StartsWith("nvarchar(", StringComparison.Ordinal) || t.StartsWith("char(", StringComparison.Ordinal) => "string",
            _ when t.StartsWith("decimal(", StringComparison.Ordinal) || t.StartsWith("numeric(", StringComparison.Ordinal) => "decimal",
            _ => "object",
        };
    }

    private static string Key(DataColumn c) => c.IsPrimaryKey ? c.KeyInferred ? "Primary key (inferred from name)" : "Primary key"
        : c.IsForeignKey ? c.KeyInferred ? "Foreign key (inferred from name)" : "Foreign key"
        : c.Name.EndsWith("Id", StringComparison.Ordinal) && c.Name.Length > 2 ? "Identifier (inferred from name)" : "—";

    private string Constraints(DataEntity entity, DataColumn c)
    {
        var items = new List<string>();
        if (c.IsUnique) items.Add("Unique");
        items.AddRange((_document?.Constraints ?? []).Where(k => string.Equals(k.EntityName, entity.Name, StringComparison.OrdinalIgnoreCase)
            && (k.Definition ?? "").Contains(c.Name, StringComparison.OrdinalIgnoreCase)).Select(k => k.ConstraintType));
        return items.Count == 0 ? "—" : string.Join(", ", items.Distinct());
    }

    private static string Lines(ProjectionProvenance? provenance) => provenance?.Sources.FirstOrDefault() is { } s
        ? s.StartLine == s.EndLine ? $"Line {s.StartLine}" : $"Lines {s.StartLine}–{s.EndLine}" : "—";

    private RenderFragment ModelView(DataModelDocument document) => __builder =>
    {
        var unresolved = document.EvidenceGaps.Count + document.Findings.Count(f => f.Category == "Model discrepancy");
        var partial = document.UnmappedSourceBlocks.Count > 0 || document.EvidenceGaps.Count > 0;
        <section class="dme-model-summary" aria-label="Data model summary" data-testid="dme-model-summary">
            <dl class="dme-model-counts">
                <div><dt>Data structures</dt><dd data-testid="dme-model-entities">@document.EntityCount</dd></div>
                <div><dt>Fields</dt><dd data-testid="dme-model-fields">@document.ColumnCount</dd></div>
                <div><dt>Relationships</dt><dd>@(document.RelationshipEvidence is DataModelEvidenceState.Extracted or DataModelEvidenceState.NoneDeclared ? document.RelationshipCount.ToString() : "Not assessed")</dd></div>
                <div><dt>Enums / reference types</dt><dd data-testid="dme-model-enums">@document.Enums.Count</dd></div>
                <div><dt>Unresolved</dt><dd>@unresolved</dd></div>
            </dl>
            <p class="dme-model-source" data-testid="dme-model-source">Source: <span class="dme-wrap">@(ArtifactPath ?? "Pasted or imported document")</span>@(ArtifactRevision is { } rev ? $" · revision {rev}" : "") · @OriginLabel</p>
            @if (partial) { <p class="dme-model-partial" role="status" data-testid="dme-model-partial">Partial model coverage — @document.UnmappedSourceBlocks.Count section(s) of the document were not mapped to the model. They are listed under technical details; nothing is guessed from them.</p> }
        </section>
        if (document.EntityCount == 0 && document.Enums.Count == 0)
        {
            <div class="dme-model-empty" data-testid="dme-model-empty">
                <p><strong>No normalized data model could be derived from the selected evidence.</strong></p>
                <ul class="dme-plain">
                    <li>Source available: @(string.IsNullOrWhiteSpace(DataModelText) && ParsedDataModel is null ? "No" : "Yes")</li>
                    <li>Document parsed: Yes — @document.UnmappedSourceBlocks.Count block(s) were not recognised as data structures.</li>
                    <li>Recognised notations: entity/table headings with field tables, field lists, C# class/record/enum declarations and SQL CREATE TABLE in code blocks.</li>
                </ul>
                <p class="dme-muted">Open “Parsed document structure — technical details” below to see the unmapped blocks.</p>
            </div>
            return;
        }
        var visible = ModelEntities(document).ToList();
        var selected = document.Entities.FirstOrDefault(e => e.Name == _selectedEntity) ?? visible.FirstOrDefault();
        <div class="dme-model-tools" role="group" aria-label="Find in the model">
            <label class="dme-model-field">Search <input type="search" data-testid="dme-model-search" value="@_modelQuery" @oninput="e => _modelQuery = e.Value?.ToString() ?? string.Empty" placeholder="Structure, field or type" /></label>
            <label class="dme-model-field">Show
                <select data-testid="dme-model-filter" value="@_modelFilter" @onchange="e => _modelFilter = e.Value?.ToString() ?? string.Empty">
                    <option value="all">All structures</option>
                    @if (document.Entities.Any(e => e.IsTable || e.Kind == DataStructureKind.Table)) { <option value="tables">Tables</option> }
                    @if (document.Entities.Any(e => e.Kind == DataStructureKind.Record)) { <option value="records">Records / DTOs</option> }
                    @if (document.Entities.Any(e => e.Kind is DataStructureKind.Event or DataStructureKind.Message)) { <option value="events">Events / messages</option> }
                    @if (document.Relationships.Count > 0) { <option value="relationships">With relationships</option> }
                </select>
            </label>
        </div>
        <div class="dme-model" data-testid="dme-model">
            <nav class="dme-model-list" aria-label="Data structures">
                @if (visible.Count == 0) { <p class="dme-muted" data-testid="dme-model-no-match">No data structure matches the search.</p> }
                <ul class="dme-plain">
                    @foreach (var entity in visible)
                    {
                        var e = entity;
                        var isSelected = selected is not null && e.Name == selected.Name;
                        <li>
                            <button type="button" class="dme-model-item @(isSelected ? "is-selected" : "")" aria-current="@(isSelected ? "true" : null)" data-testid="dme-model-item" data-entity="@e.Name" @onclick="() => _selectedEntity = e.Name">
                                <strong class="dme-wrap">@e.Name</strong>
                                @if (EntityLayers?.TryGetValue(e.Name, out var layer) == true)
                                {
                                    <span class="dme-layer dme-layer-@layer.ToString().ToLowerInvariant()" data-testid="dme-model-layer">@DataModelLayers.Label(layer)</span>
                                }
                                <span class="dme-muted">@StructureKindLabel(e.Kind) · @e.Columns.Count field(s) · @(e.Columns.Any(c => c.IsPrimaryKey) ? "key declared" : "no key declared") · @RelationshipsOf(document, e.Name).Count() relationship(s)</span>
                            </button>
                        </li>
                    }
                </ul>
            </nav>
            @if (selected is not null)
            {
                var relations = RelationshipsOf(document, selected.Name).ToList();
                <section class="dme-model-detail" aria-labelledby="dme-model-detail-title" data-testid="dme-model-detail" data-entity="@selected.Name">
                    <h3 id="dme-model-detail-title" class="dme-wrap">@selected.Name</h3>
                    <p class="dme-muted">@StructureKindLabel(selected.Kind) · @Lines(selected.Provenance) of @(SourceOf(selected) ?? "the document") · @OriginLabel</p>
                    @if (!string.IsNullOrWhiteSpace(selected.Description))
                    {
                        <details class="dme-model-notes" data-testid="dme-model-notes"><summary>Notes from the document</summary><p class="dme-wrap">@selected.Description</p></details>
                    }
                    <h4>Fields</h4>
                    @if (selected.Columns.Count == 0) { <p class="dme-muted" data-testid="dme-model-no-fields">No fields are declared for this structure in the document.</p> }
                    else
                    {
                        <div class="dme-model-scroll" tabindex="0" role="region" aria-label="@($"Fields of {selected.Name}")">
                            <table class="dme-model-table" data-testid="dme-model-fields-table">
                                <thead><tr><th scope="col">Field</th><th scope="col">Type</th><th scope="col">Required</th><th scope="col">Nullable</th><th scope="col">Cardinality</th><th scope="col">Key</th><th scope="col">Constraints</th><th scope="col">Source</th></tr></thead>
                                <tbody>
                                    @foreach (var column in selected.Columns)
                                    {
                                        <tr data-testid="dme-model-field" data-field="@column.Name">
                                            <th scope="row" class="dme-wrap">@column.Name</th>
                                            <td>@NormalizedType(column)@if (column.Type is { Length: > 0 } original) { <small class="dme-muted dme-wrap dme-type-original">@original</small> }</td>
                                            <td>@Required(column)</td>
                                            <td>@NullableText(column)</td>
                                            <td>@Cardinality(column)</td>
                                            <td>@Key(column)</td>
                                            <td>@Constraints(selected, column)</td>
                                            <td>@Lines(column.Provenance)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    <h4>Relationships</h4>
                    @if (relations.Count == 0)
                    {
                        <p class="dme-muted" data-testid="dme-model-relationships">@(document.RelationshipEvidence == DataModelEvidenceState.Extracted ? "None declared for this structure." : "Not assessed — the document declares no relationships that could be extracted.")</p>
                    }
                    else
                    {
                        <ul class="dme-plain" data-testid="dme-model-relationships">
                            @foreach (var r in relations) { <li class="dme-wrap">@r.Source → @r.Target · @(r.RelationshipType ?? "relationship") · @Lines(r.Provenance)</li> }
                        </ul>
                    }
                    @foreach (var discrepancy in document.Findings.Where(f => f.Category == "Model discrepancy" && f.EntityName == selected.Name))
                    {
                        <p class="dme-model-partial" data-testid="dme-model-discrepancy">Model discrepancy — review required: @discrepancy.Description</p>
                    }
                </section>
            }
        </div>
        @if (document.Enums.Count > 0)
        {
            <section class="dme-model-enums" aria-labelledby="dme-model-enums-title" data-testid="dme-model-enum-list">
                <h3 id="dme-model-enums-title">Enums and reference values</h3>
                <ul class="dme-plain">
                    @foreach (var en in document.Enums.Where(x => _modelQuery.Trim() is not { Length: > 0 } q || x.Name.Contains(q, StringComparison.OrdinalIgnoreCase) || x.Values.Any(v => v.Contains(q, StringComparison.OrdinalIgnoreCase))))
                    {
                        <li data-testid="dme-model-enum" class="dme-wrap"><strong>@en.Name</strong> · @string.Join(", ", en.Values) <span class="dme-muted">· @Lines(en.Provenance)</span></li>
                    }
                </ul>
            </section>
        }
    };

    private void SetTab(string tab)
    {
        _activeTab   = tab;
        _searchQuery = string.Empty;
    }

    private void HandleSearch(ChangeEventArgs e) =>
        _searchQuery = e.Value?.ToString() ?? string.Empty;

    private void ClearSearch() => _searchQuery = string.Empty;

    private void OnFileImported(string text) => _localText = text;
    private void OnFileRemoved()             => _localText = string.Empty;

    // ── Computed ─────────────────────────────────────────────────────────────

    private string SearchPlaceholder => _activeTab switch
    {
        "relationships" => "Search source, target, type…",
        "indexes"       => "Search index names, columns…",
        _               => "Search…",
    };

    private string SearchAriaLabel => _activeTab switch
    {
        "relationships" => "Search relationships by source, target, or type",
        "indexes"       => "Search indexes and constraints",
        _               => "Search",
    };

    private int SearchResultCount => _activeTab switch
    {
        "relationships" => _document is null ? 0 : AnalysisService.FilterRelationships(_document.Relationships, _searchQuery).Count(),
        "indexes"       => _document is null ? 0 : AnalysisService.FilterIndexes(_document.Indexes, _searchQuery).Count(),
        _               => 0,
    };

    private List<DataModelFinding> GetEntityFindings(string entityName) =>
        _document?.Findings
            .Where(f => f.EntityName?.Equals(entityName, StringComparison.OrdinalIgnoreCase) == true)
            .ToList() ?? [];

    private bool IsColumnIndexed(DataEntity entity, DataColumn col) =>
        _document?.Indexes.Any(idx =>
            idx.EntityName.Equals(entity.Name, StringComparison.OrdinalIgnoreCase) &&
            idx.Columns.Any(c => c.Equals(col.Name, StringComparison.OrdinalIgnoreCase))) == true;

    private List<DataRelationship> GetEntityRelationships(string entityName) =>
        _document?.Relationships.Where(r =>
            r.SourceEntity.Equals(entityName, StringComparison.OrdinalIgnoreCase) ||
            r.TargetEntity.Equals(entityName, StringComparison.OrdinalIgnoreCase))
        .ToList() ?? [];

    private int GetSeverityPriority(DataModelSeverity severity) => severity switch
    {
        DataModelSeverity.Critical => 0,
        DataModelSeverity.Error => 1,
        DataModelSeverity.Warning => 2,
        DataModelSeverity.Info => 3,
        _ => 4,  // fallback for unknown values
    };

    private string GetConstraintTypeLabel(string constraintType) => constraintType switch
    {
        "PK" => "Primary Key",
        "FK" => "Foreign Key",
        "UQ" => "Unique",
        "CK" => "Check Constraint",
        _ => constraintType,
    };
}
