@using BirkNext.IntegrationTopology
@using BirkNext.Web.Services
@using M = BirkNext.Web.Services.TopologyMapPresentation
@inject IJSRuntime JS
@implements IAsyncDisposable

@* Topology Map: the expected flow (Test Pack relationships) or the system connections, drawn with the existing SVG renderer (pan, zoom, fit,
   select). Line style + text carry the state; the table below lists exactly the same edges for keyboard and screen-reader use, and is the
   fallback when the drawing is unavailable. Read-only. *@
<section class="tm" data-testid="tm" aria-labelledby="tm-heading">
    <h2 id="tm-heading" class="tm-heading">Topology map</h2>
    <div class="it-filters tm-controls" role="group" aria-label="Map options">
        <label>Level
            <select class="form-select form-select-sm" data-testid="tm-level" value="@_level" @onchange="e => SetLevel(e.Value?.ToString())">
                @if (Coverage is { Relationships.Count: > 0 }) { <option value="@M.ExpectedLevel">Expected flow (@Coverage.ProfileLabel)</option> }
                <option value="@M.SystemsLevel">System connections</option>
            </select>
        </label>
        <label>Show
            <select class="form-select form-select-sm" data-testid="tm-filter" value="@_filter" @onchange="e => SetFilter(e.Value?.ToString())">
                @foreach (var (key, label) in M.Filters) { <option value="@key">@label</option> }
            </select>
        </label>
        <button type="button" class="btn btn-secondary btn-sm" data-testid="tm-fit" @onclick="FitAsync">Fit to view</button>
    </div>
    <p class="tm-legend" data-testid="tm-legend">Solid line: resolved or observed · dashed: candidate or strongly supported (inferred, not resolved) · dotted: expected but unresolved · dash-dot: conflict. "observed" in a label marks runtime evidence. Nothing here is confirmed by a person.</p>
    @if (Graph.OmittedNodes > 0) { <p class="tm-note" data-testid="tm-omitted">Showing the @M.MaxSystemNodes most connected components; @Graph.OmittedNodes more are listed in the Technical Inventory.</p> }
    @if (Graph.Edges.Count == 0)
    {
        <p class="tm-note" data-testid="tm-empty">@(Graph.Nodes.Count == 0 ? "No connection is stated by any source yet, so there is nothing to draw." : "No relationship matches this filter.")</p>
    }
    else
    {
        <div class="tm-canvas" @ref="_canvas" data-testid="tm-canvas" aria-describedby="tm-heading"></div>
        @if (_message is { } message) { <p class="tm-note" role="status" data-testid="tm-message">@message</p> }
    }

    @if (SelectedEdge is { } edge)
    {
        <section class="tm-detail" data-testid="tm-detail" aria-labelledby="tm-detail-heading" tabindex="-1">
            <h3 id="tm-detail-heading">@NodeName(edge.From) → @NodeName(edge.To)</h3>
            <dl class="it-facts">
                <div><dt>State</dt><dd data-testid="tm-detail-state">@edge.StateLabel (@M.LineStyle(edge.Draw))</dd></div>
                <div><dt>Transport / connections</dt><dd>@edge.Label</dd></div>
                <div><dt>Runtime</dt><dd>@(edge.RuntimeObserved ? "Observed at runtime" : "Not observed at runtime")</dd></div>
            </dl>
            @if (Relationship(edge) is { } r)
            {
                <p data-testid="tm-detail-why"><strong>Why:</strong> @r.Why</p>
                @if (!TopologyPresentation.IsResolved(r.State)) { <p data-testid="tm-detail-missing"><strong>Missing:</strong> @r.MissingEvidence</p> }
                <ul class="tm-evidence">@foreach (var piece in r.Evidence.Take(8)) { <li>@TopologyPresentation.Strength(piece.Strength) · @piece.Source · @piece.Detail</li> }</ul>
            }
            else if (Connections(edge) is { Count: > 0 } connections)
            {
                <ul class="tm-evidence" data-testid="tm-detail-connections">
                    @foreach (var c in connections.Take(12)) { <li>@TopologyPresentation.Type(c.Type) · @(c.Address ?? c.Protocol) · @TopologyPresentation.Relationship(c.Relationship)@(c.Status == TopologyStatus.Conflict ? " · conflict" : "") · @TopologyPresentation.Sources(c.Provenance)</li> }
                </ul>
                @if (connections.Count > 12) { <p class="tm-note">@(connections.Count - 12) more in the Technical Inventory.</p> }
            }
            <button type="button" class="btn btn-link btn-sm" data-testid="tm-detail-close" @onclick="() => Select(null)">Close details</button>
        </section>
    }

    <table class="tm-table" data-testid="tm-table">
        <caption>Relationships shown (@Visible.Count)</caption>
        <thead><tr><th scope="col">From</th><th scope="col">To</th><th scope="col">State</th><th scope="col">Transport</th><th scope="col"><span class="visually-hidden">Details</span></th></tr></thead>
        <tbody>
            @foreach (var e in Visible)
            {
                <tr data-testid="tm-row" data-edge="@e.Id" data-filter="@e.Filter" aria-selected="@(e.Id == _selected ? "true" : "false")">
                    <td>@NodeName(e.From)</td><td>@NodeName(e.To)</td>
                    <td data-testid="tm-row-state">@e.StateLabel<span class="tm-note"> · @M.LineStyle(e.Draw)</span></td>
                    <td>@e.Label</td>
                    <td><button type="button" class="btn btn-link btn-sm" data-testid="tm-row-select" @onclick="() => Select(e.Id)" aria-label="@($"Details of {NodeName(e.From)} to {NodeName(e.To)}")">Details</button></td>
                </tr>
            }
        </tbody>
    </table>
</section>

@code {
    [Parameter, EditorRequired] public IntegrationTopologyView View { get; set; } = default!;
    [Parameter] public TopologyCoverageView? Coverage { get; set; }

    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private DotNetObjectReference<TopologyMap>? _reference;
    private string _level = M.ExpectedLevel, _filter = "";
    private string? _selected, _message, _renderKey;
    private M.MapGraph? _graph;
    private (IntegrationTopologyView?, TopologyCoverageView?, string) _graphFor;

    /// <summary>Built once per inputs (not on every render).</summary>
    private M.MapGraph Graph
    {
        get
        {
            var level = Coverage is { Relationships.Count: > 0 } ? _level : M.SystemsLevel;
            if (_graph is null || _graphFor != (View, Coverage, level)) { _graph = M.Build(View, Coverage, level); _graphFor = (View, Coverage, level); }
            return _graph;
        }
    }

    private IReadOnlyList<M.MapEdge> Visible => _filter.Length == 0 ? Graph.Edges : [.. Graph.Edges.Where(e => e.Filter == _filter)];
    private M.MapEdge? SelectedEdge => _selected is null ? null : Graph.Edges.FirstOrDefault(e => e.Id == _selected);
    private string NodeName(string id) => Graph.Nodes.FirstOrDefault(n => n.Id == id)?.Name ?? id;

    private TopologyRelationshipResult? Relationship(M.MapEdge edge) =>
        edge.Id.StartsWith("r:", StringComparison.Ordinal) ? Coverage?.Relationships.FirstOrDefault(r => "r:" + r.Id == edge.Id) : null;

    private List<TopologyConnection> Connections(M.MapEdge edge) =>
        [.. View.Connections.Where(c => $"c:{c.ProducerComponentId}>{c.ConsumerComponentId}" == edge.Id)];

    private void SetLevel(string? level) { _level = level == M.SystemsLevel ? M.SystemsLevel : M.ExpectedLevel; _selected = null; }
    private void SetFilter(string? filter) { _filter = filter ?? ""; if (SelectedEdge is { } e && _filter.Length > 0 && e.Filter != _filter) _selected = null; }
    private void Select(string? id) => _selected = _selected == id ? null : id;

    [JSInvokable] public Task SelectNode(string id) => Task.CompletedTask;
    [JSInvokable] public Task SelectEdge(string id) { _selected = id; StateHasChanged(); return Task.CompletedTask; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var visible = Visible;
        if (visible.Count == 0) { _renderKey = null; return; }
        var ids = visible.SelectMany(e => new[] { e.From, e.To }).ToHashSet(StringComparer.Ordinal);
        var key = $"{View.GeneratedAt:O}|{_graphFor.Item3}|{_filter}|{visible.Count}";
        if (_renderKey == key) return;
        _renderKey = key;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/architectureGraph.js");
            _reference ??= DotNetObjectReference.Create(this);
            await _module.InvokeAsync<string?>("render", _canvas,
                Graph.Nodes.Where(n => ids.Contains(n.Id)).Select(n => new { id = n.Id, name = n.Name, subtitle = n.Subtitle, kind = n.Kind, state = n.State }).ToArray(),
                visible.Select(e => new { id = e.Id, from = e.From, to = e.To, label = $"{e.Label} · {e.StateLabel}", state = e.Draw }).ToArray(),
                $"topology-layout:v1:{View.EnvironmentId}:{_graphFor.Item3}", _reference);
            await _module.InvokeVoidAsync("fit", _canvas);
            _message = null;
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
        {
            _message = "The interactive map could not be drawn; the table below lists the same relationships.";
            StateHasChanged();
        }
    }

    private async Task FitAsync()
    {
        try { if (_module is not null) await _module.InvokeVoidAsync("fit", _canvas); } catch (JSException) { }
    }

    public async ValueTask DisposeAsync()
    {
        try { if (_module is not null) { await _module.InvokeVoidAsync("dispose", _canvas); await _module.DisposeAsync(); } }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException) { }
        _reference?.Dispose();
    }
}
