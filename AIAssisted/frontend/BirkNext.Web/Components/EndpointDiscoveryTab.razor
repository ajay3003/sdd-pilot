@using BirkNext.BrowserCompanion
@using BirkNext.LocalHttpsProxy
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using Microsoft.JSInterop
@inject IEndpointDiscoveryService Discovery
@inject IJSRuntime JS

<section class="ed" data-testid="endpoint-discovery" aria-label="Endpoint discovery">

    <h4>Live discovery</h4>
    <div class="ed-overview" data-testid="discovery-overview">
        <div class="ed-ov-item" title="@ObservationHelp"><span class="ed-ov-label">Observation</span><span class="ed-ov-value" data-testid="discovery-active">@(Live.ObservationActive ? "Active" : "Inactive")</span></div>
        <div class="ed-ov-item" title="@AuthenticatedTrafficHelp"><span class="ed-ov-label">Authenticated traffic</span><span class="ed-ov-value" data-testid="discovery-auth-context">@Live.AuthenticatedTrafficState</span></div>
        <div class="ed-ov-item" title="@PageCorrelationHelp"><span class="ed-ov-label">Page correlation</span><span class="ed-ov-value" data-testid="discovery-network">@Live.PageCorrelationState</span></div>
        <div class="ed-ov-item"><span class="ed-ov-label">Last traffic</span><span class="ed-ov-value" data-testid="discovery-last-traffic">@(Live.LastTrafficAt is { } at ? Time(at) : "Unavailable")</span></div>
        <div class="ed-ov-item" title="Recent means traffic captured within the last two minutes of the current running listener."><span class="ed-ov-label">Freshness</span><span class="ed-ov-value">@Live.TrafficFreshness</span></div>
    </div>
    @if (!Live.ObservationActive)
    {
        <p role="status">Network observation inactive. New traffic is not currently being captured. Historical evidence remains available.</p>
    }
    else if (Live.TrafficFreshness != "Recent")
    {
        @* Active is about the observation path, not about traffic: both states are valid together. *@
        <p role="status" data-testid="discovery-no-recent-traffic">Observation is active, but no traffic has arrived in the last two minutes. Use the application to generate traffic.</p>
    }
    @if (Live.ObservationActive && !ProxyStatus.AuthenticatedCredentialAvailable)
    {
        <p role="status">Authenticated traffic not currently available for review execution. Public/background discovery can continue.</p>
    }
    @if ((!Live.ObservationActive || !ProxyStatus.AuthenticatedCredentialAvailable) && OnOpenAuthentication.HasDelegate)
    {
        <button type="button" class="ed-link" data-testid="discovery-open-authentication" @onclick="() => OnOpenAuthentication.InvokeAsync()">Review Authentication</button>
    }
    <h4>Observed evidence</h4>
    <div class="ed-overview" data-testid="discovery-evidence-summary">
        <div class="ed-ov-item"><span class="ed-ov-label">Application pages observed</span><span class="ed-ov-value" data-testid="discovery-pages-count">@Evidence.ApplicationPageCount</span></div>
        <div class="ed-ov-item" title="Distinct hostnames, case-insensitive; eligible observed application traffic only. Ports do not create additional hosts."><span class="ed-ov-label">Backend hosts observed</span><span class="ed-ov-value" data-testid="discovery-hosts-count">@Evidence.BackendHostCount</span></div>
        <div class="ed-ov-item" title="Calls classified as application communication (REST, GraphQL, WebSocket, authentication or other application traffic) from application or browser-observed traffic. The Calls column of Observed backend communication adds up to this number."><span class="ed-ov-label">Application requests</span><span class="ed-ov-value" data-testid="discovery-app-requests">@Evidence.TotalObservedRequestCount</span></div>
        <div class="ed-ov-item" title="Calls not correlated to a single page — background polling, shared configuration, global authentication, static and telemetry. Probes and BirkNext diagnostics are not counted here."><span class="ed-ov-label">Shared / background requests</span><span class="ed-ov-value" data-testid="discovery-shared-requests">@Evidence.SharedBackgroundCount</span></div>
        <div class="ed-ov-item" title="Requests BirkNext itself sent to probe the target. A separate source from browser-observed traffic."><span class="ed-ov-label">Discovery probes</span><span class="ed-ov-value" data-testid="discovery-probe-count">@Evidence.ProbeCount</span></div>
        <div class="ed-ov-item"><span class="ed-ov-label">Last captured evidence</span><span class="ed-ov-value">@(Evidence.LastCapturedEvidenceAt is { } captured ? captured.ToLocalTime().ToString("g") : "None retained")</span></div>
    </div>
    <p class="ed-note" data-testid="discovery-evidence-help">Counts describe retained evidence, not lifetime traffic. Application requests are application-classified communication; static, configuration, authentication-callback, probe and unknown-provenance evidence is excluded from them. Shared / background counts requests not correlated to a single page, so an uncorrelated application call can appear in both.</p>

    <nav class="ed-nav" role="tablist" aria-label="Observed network evidence">
        @for (var i = 0; i < Views.Length; i++)
        {
            var index = i;
            var view = Views[i];
            <button type="button" role="tab" id="@($"discovery-tab-{view.Key}")" aria-controls="discovery-evidence-panel" aria-selected="@(_view == view.Key ? "true" : "false")"
                    tabindex="@(_view == view.Key ? 0 : -1)" @ref="_tabButtons[index]" @onkeydown="e => NavigateTab(e, index)"
                    class="ed-navbtn @(_view == view.Key ? "ed-navbtn-active" : "")" data-testid="@($"discovery-nav-{view.Key}")" @onclick="() => _view = view.Key">@view.Label</button>
        }
    </nav>
    <div id="discovery-evidence-panel" role="tabpanel" aria-labelledby="@($"discovery-tab-{_view}")">


    @if (_view == "overview")
    {
        <div class="ed-panel">
            <h4>Observed backend communication</h4>
            @* Observed traffic only. Configured integrations are not observations and are listed separately. *@
            @if (OverviewRows.Count == 0)
            {
                <p class="ed-empty" data-testid="discovery-empty">No backend communication observed yet. @(Live.ObservationActive ? "Use the application to generate traffic." : "Review observation setup.")</p>
            }
            else
            {
                <div class="ed-tablewrap">
                    <table class="ed-table" data-testid="discovery-overview-table">
                        <thead><tr><th scope="col">Service / Host</th><th scope="col">Type</th><th scope="col">Pages</th><th scope="col">Auth</th><th scope="col">Calls</th><th scope="col">Last seen</th><th scope="col">Transport</th><th scope="col">Provenance</th></tr></thead>
                        <tbody>
                            @foreach (var svc in OverviewRows)
                            {
                                <tr data-testid="discovery-overview-row">
                                    <td class="ed-mono">@svc.Host</td>
                                    <td>@CategoryBadge(svc.Category)</td>
                                    @* The Pages tab owns page-level detail; the count only takes the reader there, filtered. *@
                                    <td>
                                        @if (svc.PageCount > 0)
                                        {
                                            <button type="button" class="ed-link ed-count-link" data-testid="discovery-overview-pages"
                                                    aria-label="@($"Show the {svc.PageCount} page{(svc.PageCount == 1 ? "" : "s")} with {CategoryLabel(svc.Category)} traffic to {svc.Host}")"
                                                    @onclick="() => OpenPagesFor(svc.Host, svc.Category)">@svc.PageCount</button>
                                        }
                                        else { <span title="Not correlated to an application page">0</span> }
                                    </td>
                                    @* Observed auth mechanism on the request. Not a statement about the application's sign-in policy. *@
                                    <td title="@(svc.AuthObserved ? AuthenticatedTrafficHelp : null)">@EndpointDiscoveryPresentation.ObservedAuthLabel(svc.AuthObserved)</td>
                                    <td>@svc.Calls</td>
                                    <td class="ed-mono">@Time(svc.LastSeen)</td>
                                    <td>@svc.Transport</td><td>@svc.Provenance</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="ed-note" data-testid="discovery-overview-help">Application communication only: the Calls column adds up to Application requests (@Evidence.TotalObservedRequestCount). Static, configuration, authentication-callback and probe evidence is summarised below. Select a page count to see those pages.</p>
            }
            <div class="ed-crosslinks" data-testid="discovery-overview-links">
                <button type="button" class="ed-link" data-testid="discovery-view-pages" @onclick="() => OpenPagesFor(null, null)">View Pages</button>
                <button type="button" class="ed-link" data-testid="discovery-view-shared" @onclick="OpenShared">View Shared / background</button>
            </div>

            @*
                A summary, not a second explorer. The raw technical evidence is explored in Shared / background, which already
                owns it, so the two tabs never render the same hundreds of rows twice.
            *@
            <section class="ed-technical-summary" data-testid="discovery-technical-summary" aria-labelledby="discovery-technical-summary-heading">
                <h4 id="discovery-technical-summary-heading">@TechnicalHeading</h4>
                @if (TechnicalEndpoints.Count == 0)
                {
                    <p class="ed-empty" data-testid="discovery-technical-empty">No technical or background evidence retained.</p>
                }
                else
                {
                    <p class="ed-note"><span data-testid="discovery-technical-total">@TechnicalEndpoints.Sum(e => e.Count)</span> retained requests, by classification:</p>
                    <ul class="ed-breakdown" data-testid="discovery-technical-breakdown">
                        @foreach (var (reason, calls) in TechnicalBreakdown)
                        {
                            <li><span>@reason</span> <strong>@calls</strong></li>
                        }
                    </ul>
                    <button type="button" class="ed-link" data-testid="discovery-show-technical" @onclick="() => OpenTechnical(null)">Show technical evidence</button>
                    @if (Evidence.ProbeCount > 0)
                    {
                        <button type="button" class="ed-link" data-testid="discovery-show-probes" @onclick='() => OpenTechnical("probe")'>Show discovery probes only</button>
                    }
                }
            </section>
        </div>
    }
    else if (_view == "pages")
    {
        @if (_pageFilter is { } filter)
        {
            <p class="ed-filter-chip" role="status" data-testid="discovery-page-filter">
                Showing pages with @CategoryLabel(filter.Category) traffic to <span class="ed-mono">@filter.Host</span>.
                <button type="button" class="ed-link" data-testid="discovery-page-filter-clear" @onclick="() => _pageFilter = null">Show all pages</button>
            </p>
        }
        <div class="ed-panel ed-split">
            <aside class="ed-pagelist">
                @if (Snapshot.Pages.Count == 0)
                {
                    <p class="ed-empty">No application pages have produced correlated network evidence yet.</p>
                }
                else
                {
                    @foreach (var pg in PageListPages)
                    {
                        <button type="button" class="ed-pagelink @(SelectedPage?.Identity == pg.Identity ? "ed-pagelink-active" : "")" aria-current="@(SelectedPage?.Identity == pg.Identity ? "page" : null)" data-testid="discovery-page-link" @onclick="() => _selectedPage = pg.Identity">
                            <span class="ed-pagetitle">@pg.PagePath</span>
                            @if (ShowPageTitles && !string.IsNullOrWhiteSpace(pg.DisplayName)) { <span class="ed-pagecount">@pg.DisplayName</span> }
                            @if (ShowPageOrigins) { <span class="ed-pagecount">@pg.PageOrigin</span> }
                            <span class="ed-pagecount">@(pg.IsWaitingForFreshTraffic ? "Waiting for fresh traffic" : $"Last observed {Time(pg.LastObservedAt)}")</span>
                            <span class="ed-pagecount" title="@CaptureHelp">@CaptureLabel(pg) &middot; @GroupLabel(pg)</span>
                        </button>
                    }
                }
            </aside>
            <div class="ed-pagedetail">
                @if (SelectedPage is { } sel)
                {
                    <div class="ed-page-head">
                        <div>
                            <h4 class="ed-page-title" data-testid="discovery-selected-page">@sel.PagePath</h4>
                            <p class="ed-page-sub ed-mono">@sel.Identity</p>
                            <dl class="ed-detail ed-page-summary" data-testid="discovery-page-summary">
                                <div><dt>Last observed</dt><dd>@Time(sel.LastObservedAt)</dd></div>
                                <div><dt>Captures</dt><dd>@CaptureLabel(sel)</dd></div>
                                <div><dt>Current communication</dt><dd>@GroupLabel(sel)</dd></div>
                                <div><dt>Authenticated traffic</dt><dd>@(sel.Endpoints.Any(e => NetworkEvidencePolicy.IsApplicationTraffic(e) && e.AuthObserved) ? "Bearer observed" : "None observed")</dd></div>
                            </dl>
                            <details class="ed-count-help"><summary>About these counts</summary><p class="ed-note">@CaptureHelp Current communication shows the current generation. Groups distinguish method, origin, path, protocol, GraphQL operation, transport and provenance. Calls are retained cumulative counts; Result is the latest observed status. Archived evidence is available in Overview maintenance.</p></details>
                        </div>
                    </div>
                    @if (sel.IsWaitingForFreshTraffic)
                    {
                        <p class="ed-note" data-testid="discovery-page-state">Waiting for fresh traffic. Use this page in the target application to collect fresh endpoint traffic.</p>
                    }
                    <h5 class="ed-section-title">Page-correlated application communication</h5>
                    @RenderEndpointTable(VisibleEndpoints(sel.Endpoints.Where(NetworkEvidencePolicy.IsApplicationTraffic).Where(MatchesPageFilter).ToList()), "discovery-page-table", "No page-correlated application communication observed for this page.")
                }
                else
                {
                    <p class="ed-empty">Select a page to see the endpoints it communicates with.</p>
                }
                <div class="ed-shared-pointer" data-testid="discovery-shared-pointer">
                    <strong>Shared / background evidence</strong>
                    <p class="ed-note">Technical and background evidence is available separately.</p>
                    <button type="button" class="ed-link" data-testid="discovery-open-shared" @onclick="OpenShared">Open Shared / background</button>
                </div>
            </div>
        </div>
    }
    else if (_view == "shared")
    {
        <div class="ed-panel">
            <p class="ed-note">Requests that could not be confidently correlated to a single page: background polling, shared configuration, global authentication and telemetry.</p>
            @RenderEndpointTable(VisibleEndpoints(Snapshot.Shared.Where(e => NetworkEvidencePolicy.ProvenanceOf(e) is not (RequestProvenance.DiscoveryProbe or RequestProvenance.BirkNextDiagnostic)).ToList()), "discovery-shared-table", "No shared or background traffic observed yet.")
            @*
                Classification-based, not correlation-based: static, configuration, authentication-callback, API-description,
                technical, probe and diagnostic resources from any page or none, plus evidence whose provenance is unknown.
                Discovery probes are one provenance among several here — hence not "probe activity". Collapsed by default.
            *@
            <div class="ed-disclosure" data-testid="discovery-technical">
                <button type="button" class="ed-disclosure-toggle" data-testid="discovery-technical-toggle" aria-expanded="@(_technicalOpen ? "true" : "false")"
                        aria-controls="discovery-technical-region" @onclick="() => _technicalOpen = !_technicalOpen">
                    <span aria-hidden="true">@(_technicalOpen ? "▾" : "▸")</span> @TechnicalHeading (@TechnicalEndpoints.Sum(e => e.Count) requests)
                </button>
                @* Rows are rendered only while expanded: a collapsed section must not cost hundreds of hidden rows. *@
                @if (_technicalOpen)
                {
                    <div id="discovery-technical-region">
                        <p class="ed-note">Category says what kind of request it is; Provenance says where the evidence came from. Filter Provenance to Discovery probe to see only BirkNext's own probes.</p>
                        @RenderEndpointTable(VisibleEndpoints(TechnicalEndpoints), "discovery-technical-table", "No technical or background evidence matches these filters.")
                    </div>
                }
            </div>
        </div>
    }
    </div>
    <p class="ed-note" data-testid="discovery-configured-pointer">Configured integrations are managed in Integrations.
        <a href="@EndpointDiscoveryPresentation.IntegrationsHref" data-testid="discovery-open-integrations">Open Integrations</a>
    </p>


    @*
        Secondary management, below the evidence and away from the view navigation. Deleting every saved
        analysis is not a way to move around the page, so it does not sit beside the things that are.
    *@
    @if (_view == "overview" && (Snapshot.Pages.Count > 0 || Snapshot.Shared.Count > 0 || Snapshot.ExcludedPageHistory.Count > 0))
    {
        <details class="ed-manage" data-testid="discovery-manage"><summary>Maintenance: retained evidence (@History.RetainedPageAnalyses page analyses)</summary>
            @foreach (var sel in OrderedPages)
            {
                <details class="ed-page-actions"><summary>@sel.PagePath captures and actions</summary>
                    <p>@CaptureLabel(sel) (analysis generations). Refresh archives current evidence and waits for new traffic.</p>
                    @foreach (var capture in sel.NetworkHistory.OrderByDescending(c => c.LastObservedAt))
                    {
                        <details><summary>Generation @capture.Generation - @capture.LastObservedAt.ToLocalTime().ToString("g")</summary>
                            @RenderEndpointTable(VisibleEndpoints(capture.Endpoints), "discovery-capture-table", "No network requests in this capture.")
                        </details>
                    }
                    <button type="button" class="btn-secondary fa-btn-sm" data-testid="discovery-refresh" disabled="@(_refreshing is not null)"
                            title="Archive this page's current observations and collect fresh endpoint traffic as you use the page again."
                            @onclick="() => RefreshPage(sel.Identity)">Refresh analysis</button>
                    @if (_confirmDeletePage == sel.Identity)
                    {
                        <button type="button" class="btn-danger fa-btn-sm" data-testid="discovery-delete-page-confirm" @onclick="() => DeletePage(sel.Identity)">Confirm delete</button>
                        <button type="button" class="btn-secondary fa-btn-sm" @onclick="() => _confirmDeletePage = null">Cancel</button>
                    }
                    else
                    {
                        <button type="button" class="btn-danger fa-btn-sm" data-testid="discovery-delete-page" @onclick="() => _confirmDeletePage = sel.Identity">Delete analysis</button>
                    }
                </details>
                @if (_confirmDeletePage == sel.Identity)
                {
                    <p class="ed-warn" data-testid="discovery-delete-page-note">Delete analysis for "@sel.PagePath"? This removes discovered endpoint history for this page only. Target Environment configuration is not changed.</p>
                }
            }
            <span class="ed-manage-label">Retained page analyses: @History.RetainedPageAnalyses; technical analyses: @History.ExcludedTechnicalAnalyses</span>
            @if (_confirmDeleteAll)
            {
                <span class="ed-confirm" role="alert">Delete all retained page captures, shared, technical and probe evidence for this Target Environment? Configured integrations are kept.
                    <button type="button" class="btn-danger fa-btn-sm" data-testid="discovery-delete-all-confirm" @onclick="DeleteAll">Delete all</button>
                    <button type="button" class="btn-secondary fa-btn-sm" @onclick="() => _confirmDeleteAll = false">Cancel</button>
                </span>
            }
            else
            {
                @* Named for what it removes: every retained page, shared, technical and probe record — not only "analyses". *@
                <button type="button" class="btn-secondary fa-btn-sm" data-testid="discovery-delete-all" @onclick="() => _confirmDeleteAll = true">Delete all retained evidence…</button>
            }
            @foreach (var old in Snapshot.ExcludedPageHistory)
            {
                <details><summary>@old.PagePath ? @NetworkEvidencePolicy.Classify(old.PagePath)</summary>
                    <p>Last captured @old.LastObservedAt.ToLocalTime().ToString("g"). Historical provenance may be unknown.</p>
                    @RenderEndpointTable(VisibleEndpoints(old.Endpoints), "discovery-history-table", "No retained network endpoints.")
                </details>
            }
        </details>
    }
</section>

@code {
    [Parameter] public FrontendAnalysisProfile? Profile { get; set; }
    [Parameter] public LocalHttpsProxyStatus ProxyStatus { get; set; } = new();
    /// <summary>Optional: Browser Companion status for the same environment (evidence is merged into the same page analyses).</summary>
    [Parameter] public BrowserCompanionStatus CompanionStatus { get; set; } = new();
    /// <summary>Raised when the reader needs the Authentication tab. This page reports auth evidence; it never owns the setup.</summary>
    [Parameter] public EventCallback OnOpenAuthentication { get; set; }

    private static readonly (string Key, string Label)[] Views = [("overview", "Overview"), ("pages", "Pages"), ("shared", "Shared / background")];
    private readonly ElementReference[] _tabButtons = new ElementReference[3];
    private async Task NavigateTab(KeyboardEventArgs e, int index)
    {
        var next = e.Key switch { "ArrowRight" => (index + 1) % 3, "ArrowLeft" => (index + 2) % 3, "Home" => 0, "End" => 2, _ => -1 };
        if (next < 0) return;
        _view = Views[next].Key;
        await _tabButtons[next].FocusAsync();
    }
    private string _view = "overview";
    private string? _selectedPage;
    private string? _confirmDeletePage;
    private string? _refreshing;
    private bool _confirmDeleteAll;
    private string _categoryFilter = "all";      // app = REST/GraphQL/WebSocket/Auth/Other; excludes static/telemetry
    private string _search = "";
    private string _provenanceFilter = "all";
    private bool _authenticatedOnly;
    private readonly HashSet<string> _expanded = new(StringComparer.Ordinal);

    private EndpointDiscoverySnapshot Snapshot => Profile is null ? new() : Discovery.GetSnapshot(Profile.Id);
    private LiveDiscoveryState Live => LiveDiscoveryState.From(ProxyStatus, DateTimeOffset.UtcNow, AllEndpoints.Count > 0);
    private ObservedNetworkEvidenceSummary Evidence => ObservedNetworkEvidenceSummary.From(Snapshot);
    private HistoricalAnalysisState History => HistoricalAnalysisState.From(Snapshot);
    private IReadOnlyList<ObservedNetworkEndpoint> TechnicalEndpoints => AllEndpoints.Where(e => NetworkEvidencePolicy.ResourceOf(e) != NetworkResourceKind.Unknown || NetworkEvidencePolicy.ProvenanceOf(e) == RequestProvenance.Unknown).ToList();
    private PageAnalysis? SelectedPage => PageListPages.FirstOrDefault(p => p.Identity == _selectedPage) ?? PageListPages.FirstOrDefault();
    private IReadOnlyList<PageAnalysis> OrderedPages => Snapshot.Pages.Where(p => NetworkEvidencePolicy.IsApplicationPage(p.PagePath)).OrderByDescending(p => p.LastObservedAt).ToList();

    private IReadOnlyList<ObservedNetworkEndpoint> AllEndpoints =>
        Snapshot.Pages.SelectMany(p => p.Endpoints).Concat(Snapshot.Shared).ToList();

    protected override async Task OnParametersSetAsync()
    {
        if (Profile is not null) Discovery.ConfigureTarget(Profile);
        // Fold the live runtime's observed endpoints into the persisted per-page snapshot as traffic arrives, without leaving the tab.
        if (Profile is not null && ProxyStatus.ObservedNetworkEndpoints.Count > 0)
            await Discovery.MergeObservedAsync(JS, Profile.Id, ProxyStatus.ObservedNetworkEndpoints);
        // Browser Companion page evidence lands on the same page identities (origin + normalized path) as the proxy traffic.
        if (Profile is not null && CompanionStatus.Pages.Count > 0 && CompanionStatus.ProfileId == Profile.Id)
            await Discovery.MergeBrowserEvidenceAsync(JS, Profile.Id, CompanionStatus.Pages);
    }


    private RenderFragment RenderEndpointTable(IReadOnlyList<ObservedNetworkEndpoint> endpoints, string testId, string emptyMessage) => __builder =>
    {
        var pageTable = testId == "discovery-page-table";
        var showHost = !pageTable || endpoints.Select(e => e.Origin).Distinct(StringComparer.OrdinalIgnoreCase).Skip(1).Any();
        <div class="ed-toolbar">
            <label>Search <input class="ed-search" placeholder="Search path or host" data-testid="discovery-search" value="@_search" @oninput="e => _search = e.Value?.ToString() ?? string.Empty" /></label>
            <label>Type <select @bind="_categoryFilter" data-testid="discovery-type-filter">@foreach (var (key, label) in Filters) { <option value="@key">@label</option> }</select></label>
            <label>Provenance <select @bind="_provenanceFilter" data-testid="discovery-provenance-filter">
                <option value="all">All provenance</option><option value="app">Application / browser traffic</option><option value="shared">Background / shared</option><option value="probe">Discovery probe</option><option value="diagnostic">BirkNext diagnostic</option><option value="unknown">Unknown / historical</option>
            </select></label>
            <label><input type="checkbox" @bind="_authenticatedOnly" /> Authenticated only</label>
        </div>
        @if (endpoints.Count == 0)
        {
            <p class="ed-empty">@emptyMessage</p>
        }
        else
        {
            <div class="ed-tablewrap">
                <table class="ed-table @(pageTable ? "ed-page-table" : "")" data-testid="@testId">
                    <thead><tr><th scope="col">Details</th><th scope="col">Type</th>@if (!pageTable) { <th scope="col">Category / reason</th> }<th scope="col">Method</th>@if (showHost) { <th scope="col">Host</th> }<th scope="col">Path</th><th scope="col">Auth</th><th scope="col">Result</th><th scope="col">Calls</th><th scope="col">Last seen</th>@if (!pageTable) { <th scope="col">Transport</th><th scope="col">Provenance</th> }</tr></thead>
                    <tbody>
                        @foreach (var e in endpoints)
                        {
                            var key = EndpointDiscoveryMerge.Key(e);
                            <tr class="ed-row" data-testid="discovery-endpoint-row">
                                <td><button type="button" class="ed-expand" @onclick="() => Toggle(key)" aria-expanded="@(_expanded.Contains(key) ? "true" : "false")" aria-label="@($"Toggle details for {e.Method} {e.Path}")">@(_expanded.Contains(key) ? "▾" : "▸")</button></td>
                                <td data-label="Type">@CategoryBadge(e.Category)</td>
                                @if (!pageTable) { <td>@NetworkEvidencePolicy.Reason(e)</td> }<td data-label="Method" class="ed-mono">@e.Method</td>
                                @if (showHost) { <td data-label="Host" class="ed-mono">@e.Host</td> }
                                <td data-label="Path" class="ed-mono ed-path" title="@e.Path">@e.Path @if (!string.IsNullOrWhiteSpace(e.OperationName)) { <small class="ed-operation">@e.OperationType @e.OperationName</small> }</td>
                                <td data-label="Auth">@(e.AuthObserved ? "Bearer observed" : "—")</td>
                                <td data-label="Result">@ResultLabel(e)</td>
                                <td data-label="Calls">@e.Count</td>
                                <td data-label="Last seen" class="ed-mono">@Time(e.LastObservedAt)</td>
                                @if (!pageTable) { <td>@NetworkEvidencePolicy.TransportLabel(e)</td><td>@NetworkEvidencePolicy.ProvenanceLabel(e)</td> }
                            </tr>
                            @if (_expanded.Contains(key))
                            {
                                <tr class="ed-detailrow"><td></td><td colspan="@(pageTable ? (showHost ? 8 : 7) : 11)">
                                    <dl class="ed-detail">
                                        <div><dt>Host</dt><dd>@e.Host</dd></div>
                                        <div><dt>Path</dt><dd class="ed-mono">@e.Path</dd></div>
                                        <div><dt>Category / reason</dt><dd>@NetworkEvidencePolicy.Reason(e)</dd></div>
                                        <div><dt>Transport</dt><dd>@NetworkEvidencePolicy.TransportLabel(e)</dd></div>
                                        <div><dt>Provenance</dt><dd>@NetworkEvidencePolicy.ProvenanceLabel(e)</dd></div>
                                        @if (e.Category is ObservedTrafficCategory.OtherHttp or ObservedTrafficCategory.Unknown) { <div><dt>Other</dt><dd>Observed communication not classified as REST, GraphQL or WebSocket; may include page navigation.</dd></div> }
                                        <div><dt>Origin</dt><dd class="ed-mono">@e.Origin</dd></div>
                                        <div><dt>Classification</dt><dd>@e.Category (@e.Confidence)</dd></div>
                                        @if (e.Category == ObservedTrafficCategory.GraphQl)
                                        {
                                            <div><dt>GraphQL operation</dt><dd>@e.OperationType @(e.OperationName is { Length: > 0 } n ? $"· {n}" : "")</dd></div>
                                        }
                                        <div><dt>Authentication</dt><dd>@(e.AuthObserved ? "Bearer observed" : "None observed")</dd></div>
                                        <div><dt>First observed</dt><dd class="ed-mono">@Time(e.FirstObservedAt)</dd></div>
                                        <div><dt>Last observed</dt><dd class="ed-mono">@Time(e.LastObservedAt)</dd></div>
                                        <div><dt>Calls</dt><dd>@e.Count</dd></div>
                                        <div><dt>Last status</dt><dd>@(e.LastStatus > 0 ? e.LastStatus.ToString() : "—")</dd></div>
                                        @if (NetworkEvidencePolicy.IsApiCandidate(e))
                                        {
                                            <div><dt>API Quality Review</dt><dd><a class="ed-analyze-link" data-testid="discovery-analyze-api" href="@AnalyzeHref(e)">Analyze in API Review →</a></dd></div>
                                        }
                                    </dl>
                                </td></tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    };

    private const string CaptureHelp = "A capture is an analysis generation: archived generations plus the current generation, which may be waiting for traffic. It is not a browser visit.";
    private static string CaptureLabel(PageAnalysis page) => $"{page.NetworkHistory.Count + 1} capture{(page.NetworkHistory.Count == 0 ? "" : "s")}";
    private static string GroupLabel(PageAnalysis page) => $"{AppEndpointCount(page)} correlated request group{(AppEndpointCount(page) == 1 ? "" : "s")}";
    private bool ShowPageTitles => OrderedPages.Select(p => p.DisplayName).Where(n => !string.IsNullOrWhiteSpace(n)).Distinct().Skip(1).Any();
    private bool ShowPageOrigins => OrderedPages.Select(p => p.PageOrigin).Distinct(StringComparer.OrdinalIgnoreCase).Skip(1).Any();
    private async Task OpenShared()
    {
        _search = ""; _categoryFilter = "all"; _provenanceFilter = "all"; _authenticatedOnly = false;
        _view = "shared";
        await _tabButtons[2].FocusAsync();
    }

    private void Toggle(string key) { if (!_expanded.Remove(key)) _expanded.Add(key); }

    // ── Overview summary, drill-down and help ────────────────────────────────

    private const string ObservationHelp = "Active means the observation path is running. It does not mean traffic is flowing right now — Freshness says that.";
    private const string AuthenticatedTrafficHelp = "Bearer authentication was observed in captured traffic. This does not independently verify the browser authentication state.";
    private const string PageCorrelationHelp = "Observed requests can be correlated to application pages. Not every retained request is page-correlated.";

    /// <summary>
    /// The technical section's name. Its rows are classified as technical kinds (static, configuration, authentication
    /// callback, API description, technical, probe, diagnostic) or have unknown provenance; most are browser-observed, so
    /// "discovery probe activity" described only one provenance among several.
    /// </summary>
    private const string TechnicalHeading = "Technical / background evidence";

    private bool _technicalOpen;
    /// <summary>A drill-down from an Overview row: pages with this type of application traffic to this host.</summary>
    private (string Host, ObservedTrafficCategory Category)? _pageFilter;

    /// <summary>Counts by the existing classification (<see cref="NetworkEvidencePolicy.Reason"/>) — no client heuristic of its own.</summary>
    private IReadOnlyList<(string Reason, int Calls)> TechnicalBreakdown => TechnicalEndpoints
        .GroupBy(e => NetworkEvidencePolicy.ProvenanceOf(e) == RequestProvenance.Unknown && NetworkEvidencePolicy.ResourceOf(e) == NetworkResourceKind.Unknown
            ? "Unknown / historical provenance" : NetworkEvidencePolicy.Reason(e))
        .Select(g => (g.Key, g.Sum(e => e.Count)))
        .OrderByDescending(x => x.Item2).ThenBy(x => x.Key, StringComparer.Ordinal)
        .ToList();

    private IReadOnlyList<PageAnalysis> PageListPages => _pageFilter is null
        ? OrderedPages
        : OrderedPages.Where(p => p.Endpoints.Any(e => NetworkEvidencePolicy.IsApplicationTraffic(e) && MatchesPageFilter(e))).ToList();

    private bool MatchesPageFilter(ObservedNetworkEndpoint e) => _pageFilter is not { } f
        || (e.Category == f.Category && string.Equals(e.Host, f.Host, StringComparison.OrdinalIgnoreCase));

    private async Task OpenPagesFor(string? host, ObservedTrafficCategory? category)
    {
        _pageFilter = host is not null && category is { } c ? (host, c) : null;
        _selectedPage = PageListPages.FirstOrDefault()?.Identity;
        _view = "pages";
        await _tabButtons[1].FocusAsync();
    }

    private async Task OpenTechnical(string? provenance)
    {
        await OpenShared();
        _provenanceFilter = provenance ?? "all";
        _technicalOpen = true;
    }

    private static string CategoryLabel(ObservedTrafficCategory category) => category switch
    {
        ObservedTrafficCategory.Rest => "REST",
        ObservedTrafficCategory.GraphQl => "GraphQL",
        ObservedTrafficCategory.WebSocket => "WebSocket",
        ObservedTrafficCategory.Authentication => "Auth",
        _ => "Other",
    };

    /// <summary>Safe navigation reference: the API review target id (type + origin + base path digest), never a query string or credential.</summary>
    private static string AnalyzeHref(ObservedNetworkEndpoint e) => e.Category == ObservedTrafficCategory.GraphQl
        ? $"/api-quality-review?target={ApiReviewTargetResolver.Id(BirkNext.ApiReview.ApiReviewTargetType.GraphQl, e.Origin, e.Path)}"
        : $"/api-quality-review?target={ApiReviewTargetResolver.Id(BirkNext.ApiReview.ApiReviewTargetType.Rest, e.Origin, ApiReviewTargetResolver.BasePathOf(e.Path))}";

    private static readonly (string Key, string Label)[] Filters =
        [("app", "Application"), ("rest", "REST"), ("graphql", "GraphQL"), ("websocket", "WebSocket"), ("auth", "Auth"), ("other", "Other"), ("static", "Static/CDN"), ("telemetry", "Telemetry"), ("all", "All")];

    private IReadOnlyList<ObservedNetworkEndpoint> VisibleEndpoints(IReadOnlyList<ObservedNetworkEndpoint> source)
    {
        IEnumerable<ObservedNetworkEndpoint> q = source;
        q = _provenanceFilter switch
        {
            "app" => q.Where(e => NetworkEvidencePolicy.IsApplicationTraffic(e) && e.PagePath is not null),
            "shared" => q.Where(e => e.PagePath is null && NetworkEvidencePolicy.ProvenanceOf(e) is not (RequestProvenance.DiscoveryProbe or RequestProvenance.BirkNextDiagnostic)),
            "probe" => q.Where(e => NetworkEvidencePolicy.ProvenanceOf(e) == RequestProvenance.DiscoveryProbe),
            "diagnostic" => q.Where(e => NetworkEvidencePolicy.ProvenanceOf(e) == RequestProvenance.BirkNextDiagnostic),
            "unknown" => q.Where(e => NetworkEvidencePolicy.ProvenanceOf(e) == RequestProvenance.Unknown),
            _ => q
        };
        if (_authenticatedOnly) q = q.Where(e => e.AuthObserved);
        q = _categoryFilter switch
        {
            "app" => q.Where(e => e.Category is ObservedTrafficCategory.Rest or ObservedTrafficCategory.GraphQl or ObservedTrafficCategory.WebSocket or ObservedTrafficCategory.Authentication or ObservedTrafficCategory.OtherHttp),
            "rest" => q.Where(e => e.Category == ObservedTrafficCategory.Rest),
            "graphql" => q.Where(e => e.Category == ObservedTrafficCategory.GraphQl),
            "websocket" => q.Where(e => e.Category == ObservedTrafficCategory.WebSocket),
            "auth" => q.Where(e => e.Category == ObservedTrafficCategory.Authentication),
            "other" => q.Where(e => e.Category is ObservedTrafficCategory.OtherHttp or ObservedTrafficCategory.Unknown),
            "static" => q.Where(e => e.Category == ObservedTrafficCategory.StaticAsset),
            "telemetry" => q.Where(e => e.Category == ObservedTrafficCategory.Telemetry),
            _ => q
        };
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var s = _search.Trim();
            q = q.Where(e => e.Host.Contains(s, StringComparison.OrdinalIgnoreCase) || e.Path.Contains(s, StringComparison.OrdinalIgnoreCase));
        }
        return q.OrderByDescending(e => e.LastObservedAt).ThenByDescending(e => e.Count).ToList();
    }

    // Application endpoints (excludes static/telemetry) count for a page badge.
    private static int AppEndpointCount(PageAnalysis page) =>
        page.Endpoints.Count(NetworkEvidencePolicy.IsApplicationTraffic);

    // ── overview dedup across pages ──────────────────────────────────────────

    private sealed record OverviewRow(string Host, ObservedTrafficCategory Category, int PageCount, bool AuthObserved, int Calls, DateTimeOffset LastSeen, string Transport, string Provenance);

    private IReadOnlyList<OverviewRow> OverviewRows
    {
        get
        {
            var byPage = Snapshot.Pages.SelectMany(p => p.Endpoints.Select(e => (Page: (string?)p.Identity, E: e)))
                .Concat(Snapshot.Shared.Select(e => (Page: (string?)null, E: e)));
            return byPage
                .Where(x => NetworkEvidencePolicy.IsApplicationTraffic(x.E))
                .GroupBy(x => (Host: x.E.Host.ToLowerInvariant(), x.E.Category, x.E.Source, Provenance: NetworkEvidencePolicy.ProvenanceOf(x.E)))
                .Select(g => new OverviewRow(
                    g.Key.Host, g.Key.Category,
                    g.Where(x => x.Page is not null).Select(x => x.Page).Distinct().Count(),
                    g.Any(x => x.E.AuthObserved),
                    g.Sum(x => x.E.Count),
                    g.Max(x => x.E.LastObservedAt), NetworkEvidencePolicy.TransportLabel(g.First().E), NetworkEvidencePolicy.ProvenanceLabel(g.First().E)))
                .OrderByDescending(r => r.LastSeen)
                .ToList();
        }
    }

    // ── management ───────────────────────────────────────────────────────────

    // Refresh applies to exactly the one selected page; the guard serializes rapid double-clicks so they cannot race the fresh-traffic window.
    private async Task RefreshPage(string identity)
    {
        if (Profile is null || _refreshing is not null) return;
        _refreshing = identity;
        try { await Discovery.RefreshPageAsync(JS, Profile.Id, identity); }
        finally { _refreshing = null; StateHasChanged(); }
    }
    private async Task DeletePage(string identity)
    {
        _confirmDeletePage = null;
        if (Profile is not null) { await Discovery.DeletePageAsync(JS, Profile.Id, identity); if (_selectedPage == identity) _selectedPage = null; StateHasChanged(); }
    }
    private async Task DeleteAll() { _confirmDeleteAll = false; if (Profile is not null) { await Discovery.DeleteAllAsync(JS, Profile.Id); _selectedPage = null; StateHasChanged(); } }

    // ── formatting ───────────────────────────────────────────────────────────

    private static string Time(DateTimeOffset t) => t == default ? "—" : t.ToLocalTime().ToString("HH:mm:ss");
    private static string ResultLabel(ObservedNetworkEndpoint e) =>
        e.Category == ObservedTrafficCategory.WebSocket ? "Connected" : e.LastStatus > 0 ? e.LastStatus.ToString() : "—";

    private RenderFragment CategoryBadge(ObservedTrafficCategory category) => __builder =>
    {
        var (cls, label) = category switch
        {
            ObservedTrafficCategory.Rest => ("ed-badge-rest", "REST"),
            ObservedTrafficCategory.GraphQl => ("ed-badge-graphql", "GraphQL"),
            ObservedTrafficCategory.WebSocket => ("ed-badge-ws", "WebSocket"),
            ObservedTrafficCategory.Authentication => ("ed-badge-auth", "Auth"),
            ObservedTrafficCategory.StaticAsset => ("ed-badge-static", "Static"),
            ObservedTrafficCategory.Telemetry => ("ed-badge-static", "Telemetry"),
            _ => ("ed-badge-other", "Other")
        };
        <span class="ed-badge @cls" title="@(label == "Other" ? "Observed communication not classified as REST, GraphQL or WebSocket; may include page navigation. Expand details for explanation." : null)">@label</span>
    };
}
