@using BirkNext.BrowserCompanion
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@implements IDisposable
@inject IEndpointDiscoveryService Discovery

@*
    Browser Discovery presents browser-side EVIDENCE observed by Browser Companion.
    Frontend Quality Review interprets that evidence. Nothing here assesses, scores or judges:
    WCAG areas group observed evidence by principle and are never a conformance result.
*@
<section class="bd" data-testid="browser-discovery" aria-label="Browser discovery">

    @* One notice for the companion situation, or none. A connected companion with no page open is not a warning. *@
    @if (BrowserCompanionSituations.Alert(Situation, Rows.Count) is { } alert)
    {
        <div class="bd-alert bd-alert-@alert.Tone" role="status" data-testid="bd-companion-alert">
            <span class="bd-alert-icon bd-icon-@alert.Icon" aria-hidden="true"></span>
            <div class="bd-alert-body">
                <h3 class="bd-alert-title" data-testid="bd-companion-alert-title">@alert.Title</h3>
                <p class="bd-alert-text">@alert.Body</p>
                @if (BrowserCompanionSituations.HistoryReassurance(Rows.Count) is { Length: > 0 } kept)
                {
                    @* Live evidence is gone; captured evidence is not. Saying so stops the warning reading as data loss. *@
                    <p class="bd-alert-note" data-testid="bd-companion-alert-history">@kept</p>
                }
            </div>
            @if (alert.ActionLabel is { Length: > 0 } action && OnPair.HasDelegate)
            {
                <button type="button" class="btn-secondary" data-testid="bd-companion-alert-action" @onclick="OnPair">@action</button>
            }
        </div>
    }

    @* Two questions, never one row: what is live in the browser right now, and what we captured before. *@
    <div class="bd-overview bd-overview-live" data-testid="browser-discovery-live" aria-label="Live browser session">
        <span class="bd-ov-group">Live session</span>
        <div class="bd-ov-item"><span class="bd-ov-label">Target</span><span class="bd-ov-value" data-testid="bd-target">@(Profile?.Name ?? "—")</span></div>
        @foreach (var fact in BrowserDiscoveryLive.Facts(Status))
        {
            <div class="bd-ov-item"><span class="bd-ov-label">@fact.Label</span><span class="bd-ov-value bd-mono @(fact.Muted ? "bd-ov-muted" : "")" data-testid="@fact.TestId">@fact.Value</span></div>
        }
    </div>
    @if (BrowserCompanionSituations.LivePageNote(Situation) is { } note)
    {
        <p class="bd-live-note" data-testid="bd-live-note">@note</p>
    }

    <div class="bd-overview bd-overview-evidence" data-testid="browser-discovery-summary" aria-label="Captured evidence">
        <span class="bd-ov-group">Historical evidence</span>
        @foreach (var fact in BrowserDiscoveryLive.EvidenceFacts(Status, Snapshot))
        {
            <div class="bd-ov-item"><span class="bd-ov-label">@fact.Label</span><span class="bd-ov-value @(fact.Muted ? "bd-ov-muted" : "")" data-testid="@fact.TestId">@fact.Value</span></div>
        }
    </div>

    <nav class="bd-nav" role="tablist" aria-label="Browser discovery views">
        @foreach (var (key, label, count) in Views)
        {
            <button type="button" class="bd-navbtn @(_view == key ? "bd-navbtn-active" : "")"
                    id="@($"browser-discovery-tab-{key}")" role="tab"
                    aria-selected="@((_view == key).ToString().ToLowerInvariant())"
                    aria-controls="@($"browser-discovery-panel-{key}")"
                    tabindex="@(_view == key ? 0 : -1)"
                    data-testid="@($"browser-discovery-nav-{key}")"
                    @onclick="() => Select(key)" @onkeydown="NavKey">@label@(count is { } c ? $" ({c})" : "")</button>
        }
    </nav>

    @* Every panel element exists so each tab's aria-controls always resolves; only the selected panel has content. *@

    @* ── Overview: what browser evidence is currently available? ── *@
    <div class="bd-panel" role="tabpanel" id="browser-discovery-panel-overview" aria-labelledby="browser-discovery-tab-overview" tabindex="0" hidden="@(_view != "overview")">
    @if (_view == "overview")
    {
            <h4 class="bd-panel-title">Observed browser evidence</h4>
            @if (Rows.Count == 0)
            {
                @EmptyEvidence
            }
            else
            {
                <div class="bd-tablewrap">
                    <table class="bd-table" data-testid="browser-discovery-overview-table">
                        <caption class="bd-caption">Browser evidence observed per page. Evidence only — Frontend Quality Review interprets it.</caption>
                        <thead>
                            <tr>
                                <th scope="col">Page / Route</th>
                                <th scope="col">State</th>
                                <th scope="col">DOM evidence</th>
                                <th scope="col">Accessibility evidence</th>
                                <th scope="col">Performance evidence</th>
                                <th scope="col">Last seen</th>
                                <th scope="col">Source</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Rows)
                            {
                                <tr data-testid="browser-discovery-page-row">
                                    <th scope="row" class="bd-mono bd-route">
                                        <button type="button" class="bd-routelink" data-testid="browser-discovery-open-page" @onclick="() => OpenPage(row.Identity)">@row.Route</button>
                                    </th>
                                    @* A page with evidence is not a page that is open. *@
                                    <td data-testid="browser-discovery-page-liveness">@BrowserDiscoveryLive.LivenessLabel(BrowserDiscoveryLive.Liveness(row, Status?.EffectiveLive))</td>
                                    @* Presence of evidence, never what it says. WCAG-area mapping is evidence metadata
                                       and lives in Evidence → Accessibility, where it is useful rather than decorative. *@
                                    <td>@StateBadge(row.Dom)</td>
                                    <td data-testid="browser-discovery-page-accessibility">@StateBadge(row.WcagAreas.Count > 0 ? BrowserEvidenceState.Available : BrowserEvidenceState.Unavailable)</td>
                                    <td>@StateBadge(row.Performance)</td>
                                    <td class="bd-mono">@(row.LastSeen is { } seen ? Time(seen) : "—")</td>
                                    <td><span class="bd-source">@row.Source</span></td>
                                </tr>
                            }
                            @foreach (var live in BrowserDiscoveryLive.LiveWithoutEvidence(Status?.Live, Snapshot))
                            {
                                <tr data-testid="browser-discovery-page-row">
                                    <th scope="row" class="bd-mono bd-route">@live.Route</th>
                                    <td data-testid="browser-discovery-page-liveness">@BrowserDiscoveryLive.LivenessLabel(BrowserPageLiveness.LiveWithoutEvidence)</td>
                                    <td>—</td><td>—</td><td>—</td><td class="bd-mono">—</td><td><span class="bd-source">Live page</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @* The per-evidence-type counts this used to repeat are the Historical evidence strip's, three rows up.
                   What is left is the one hand-off, said once. *@
                @Handoff("browser-discovery-handoff", "browser-discovery-open-review")
            }
    }
    </div>

    @* ── Pages: detailed per-page browser evidence ── *@
    <div class="bd-panel bd-split" role="tabpanel" id="browser-discovery-panel-pages" aria-labelledby="browser-discovery-tab-pages" tabindex="0" hidden="@(_view != "pages")">
    @if (_view == "pages")
    {
            <aside class="bd-pagelist" aria-label="Pages with browser evidence">
                @if (Rows.Count == 0)
                {
                    <p class="bd-empty-help">@EmptyEvidenceHelp</p>
                }
                @foreach (var row in Rows)
                {
                    <button type="button" class="bd-pagelink @(SelectedRow?.Identity == row.Identity ? "bd-pagelink-active" : "")"
                            aria-current="@(SelectedRow?.Identity == row.Identity ? "true" : null)"
                            data-testid="browser-discovery-page-link" @onclick="() => _selected = row.Identity">
                        <span class="bd-pagetitle">@row.Route</span>
                        <span class="bd-pagesub">@(row.LastSeen is { } s ? Time(s) : "—")</span>
                        <span class="bd-pageliveness" data-testid="browser-discovery-page-liveness">@BrowserDiscoveryLive.LivenessLabel(BrowserDiscoveryLive.Liveness(row, Status?.EffectiveLive))</span>
                    </button>
                }
                @foreach (var live in BrowserDiscoveryLive.LiveWithoutEvidence(Status?.Live, Snapshot))
                {
                    <button type="button" class="bd-pagelink" disabled data-testid="browser-discovery-page-link">
                        <span class="bd-pagetitle">@live.Route</span>
                        <span class="bd-pagesub">No evidence yet</span>
                        <span class="bd-pageliveness" data-testid="browser-discovery-page-liveness">@BrowserDiscoveryLive.LivenessLabel(BrowserPageLiveness.LiveWithoutEvidence)</span>
                    </button>
                }
            </aside>
            @* Keyed on the selected page so its disclosures start collapsed rather than inheriting the previous page's. *@
            <div class="bd-pagedetail" @key="SelectedRow?.Identity">
                @if (SelectedRow is { } sel && SelectedEvidence is { } evidence)
                {
                    @*
                        One page, one screen. Which page, whether it is live, when it was observed, and one line per
                        evidence type — presence and a couple of raw counts. The rule catalogue, the WCAG-area
                        grouping and the full metric list belong to Evidence, which is the technical explorer; they
                        used to be inlined here as well, which is what made a selected page several screens long.
                    *@
                    <div class="bd-page-head">
                        <h4 class="bd-page-title bd-mono" data-testid="browser-discovery-selected-page">@sel.Route</h4>
                        <span class="bd-pageliveness" data-testid="browser-discovery-selected-liveness">@BrowserDiscoveryLive.LivenessLabel(BrowserDiscoveryLive.Liveness(sel, Status?.EffectiveLive))</span>
                    </div>
                    <dl class="bd-summary" data-testid="browser-discovery-page-summary">
                        <div><dt>Last observed</dt><dd class="bd-mono" data-testid="browser-discovery-page-observed">@(sel.LastSeen is { } o ? Time(o) : "—")</dd></div>
                        <div><dt>Source</dt><dd data-testid="browser-discovery-page-source">@sel.Source</dd></div>
                    </dl>

                    @* Presence, then raw counts. Never a verdict, and never a zero standing in for a measurement nobody took. *@
                    <dl class="bd-summary bd-evidencelines" data-testid="browser-discovery-page-evidence">
                        <div>
                            <dt>DOM evidence</dt>
                            <dd>
                                <span data-testid="browser-discovery-page-dom-state">@StateBadge(sel.Dom)</span>
                                <span class="bd-evidenceline" data-testid="browser-discovery-page-dom-line">@DomLine(evidence)</span>
                            </dd>
                        </div>
                        <div>
                            <dt>Accessibility evidence</dt>
                            <dd>
                                <span data-testid="browser-discovery-page-accessibility-state">@StateBadge(Selected11yState)</span>
                                <span class="bd-evidenceline" data-testid="browser-discovery-page-accessibility-line">@AccessibilityLine</span>
                            </dd>
                        </div>
                        <div>
                            <dt>Performance evidence</dt>
                            <dd>
                                <span data-testid="browser-discovery-page-performance-state">@StateBadge(sel.Performance)</span>
                                <span class="bd-evidenceline" data-testid="browser-discovery-page-performance-line">@PerformanceLine(evidence)</span>
                            </dd>
                        </div>
                    </dl>

                    @* Where the raw detail is, and where it gets interpreted. Two destinations, stated once. *@
                    <div class="bd-pageactions">
                        <SecondaryButton Class="fa-btn-sm" data-testid="browser-discovery-page-raw" OnClick="() => OpenRawEvidence(sel.Identity)">View raw evidence</SecondaryButton>
                        <a class="bd-link" href="/frontend-quality-review" data-testid="browser-discovery-open-review-page">@BrowserDiscoveryPresentation.HandoffAction</a>
                    </div>

                }
                else
                {
                    <p class="bd-empty-help">Select a page to see the browser evidence observed for it.</p>
                }
            </div>
    }
    </div>

    @* ── Evidence: cross-page inventory. Pages investigates one page; this compares them. ── *@
    <div class="bd-panel" role="tabpanel" id="browser-discovery-panel-evidence" aria-labelledby="browser-discovery-tab-evidence" tabindex="0" hidden="@(_view != "evidence")">
    @if (_view == "evidence")
    {
            <h4 class="bd-panel-title">Observed browser evidence across pages</h4>
            @if (!Inventory.Any)
            {
                @EmptyEvidence
            }
            else
            {
                @* What exists, before any of it is listed. The source is stated once here instead of in every row:
                   browser evidence only ever comes from the companion. *@
                <dl class="bd-summary bd-inventory" data-testid="browser-discovery-inventory">
                    <div><dt>DOM</dt><dd data-testid="bd-inv-dom">@Pluralize(Inventory.Dom.Count, "page")</dd></div>
                    <div><dt>Accessibility</dt><dd data-testid="bd-inv-accessibility">@Pluralize(Inventory.AccessibilityPages, "page")</dd></div>
                    <div><dt>Performance</dt><dd data-testid="bd-inv-performance">@Pluralize(Inventory.Performance.Count, "page")</dd></div>
                    <div><dt>Source</dt><dd data-testid="bd-inv-source">@BrowserDiscoveryPresentation.Source</dd></div>
                </dl>

                @Handoff("browser-discovery-evidence-handoff", "browser-discovery-open-review-evidence")

                @* One evidence type at a time: three full tables at once is what made this a diagnostic dump. *@
                <nav class="bd-nav bd-subnav" role="tablist" aria-label="Evidence types">
                    @foreach (var (key, label, count) in EvidenceTypes)
                    {
                        <button type="button" class="bd-navbtn @(_evidence == key ? "bd-navbtn-active" : "")"
                                id="@($"bd-evidence-tab-{key}")" role="tab"
                                aria-selected="@((_evidence == key).ToString().ToLowerInvariant())"
                                aria-controls="@($"bd-evidence-panel-{key}")"
                                tabindex="@(_evidence == key ? 0 : -1)"
                                data-testid="@($"browser-discovery-evidence-nav-{key}")"
                                @onclick="() => _evidence = key">@label (@count)</button>
                    }
                </nav>

                @* ── DOM: one row per page ── *@
                <div role="tabpanel" id="bd-evidence-panel-dom" aria-labelledby="bd-evidence-tab-dom" tabindex="0" hidden="@(_evidence != "dom")">
                @if (_evidence == "dom")
                {
                        @if (Inventory.Dom.Count == 0)
                        {
                            <p class="bd-empty-help" data-testid="browser-discovery-evidence-dom-empty">No DOM evidence observed.</p>
                        }
                        else
                        {
                            <div class="bd-tablewrap">
                                <table class="bd-table" data-testid="browser-discovery-evidence-dom-table">
                                    <caption class="bd-caption">Structural counts per page. Observations only — no count here is good or bad, and none of them is a defect.</caption>
                                    <thead>
                                        <tr>
                                            <th scope="col">Page</th><th scope="col">Nodes</th><th scope="col">Depth</th>
                                            <th scope="col">Interactive</th><th scope="col">Forms</th><th scope="col">Images</th>
                                            <th scope="col">iFrames</th><th scope="col">Dialogs</th>
                                            @* Structural, like every other column here: elements the collector found focusable
                                               while hidden. Whether that matters is Frontend Quality Review's question. *@
                                            <th scope="col">Hidden focusable observed</th>
                                            <th scope="col">Observed at</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in Inventory.Dom)
                                        {
                                            <tr data-testid="browser-discovery-evidence-dom-row">
                                                <th scope="row" class="bd-mono bd-route">@PageLink(row.Identity, row.Route)</th>
                                                <td class="bd-mono">@row.Nodes</td>
                                                <td class="bd-mono">@row.Depth</td>
                                                <td class="bd-mono">@row.Interactive</td>
                                                <td class="bd-mono">@row.FormControls</td>
                                                <td class="bd-mono">@row.Images</td>
                                                <td class="bd-mono">@row.Iframes</td>
                                                <td class="bd-mono">@row.Dialogs</td>
                                                <td class="bd-mono">@row.HiddenFocusable</td>
                                                <td class="bd-mono">@Time(row.ObservedAt)</td>
                                            </tr>
                                            @if (row.Detail.Count > 0)
                                            {
                                                <tr class="bd-detailrow">
                                                    <td colspan="10">
                                                        <ReviewDisclosure TestId="@($"browser-discovery-evidence-dom-detail-{Slug(row.Identity)}")"
                                                                          Text="Landmarks and headings" CollapseText="Hide landmarks and headings"
                                                                          Class="disclosure-inline disclosure-small">
                                                            @ItemList(row.Detail, $"browser-discovery-evidence-dom-structure-{Slug(row.Identity)}")
                                                        </ReviewDisclosure>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                }
                </div>

                @* ── Accessibility: summary, then what needs attention, then the catalogue on request ── *@
                <div role="tabpanel" id="bd-evidence-panel-accessibility" aria-labelledby="bd-evidence-tab-accessibility" tabindex="0" hidden="@(_evidence != "accessibility")">
                @if (_evidence == "accessibility")
                {
                        @if (Inventory.Accessibility.Count == 0)
                        {
                            <p class="bd-empty-help" data-testid="browser-discovery-evidence-accessibility-empty">No accessibility browser evidence observed.</p>
                        }
                        else
                        {
                            @* The collector's own outcomes, in the collector's own terms. "Flagged" was the Browser
                               Companion marking something for a human; calling it that unqualified let a raw check
                               outcome read as a WCAG result. *@
                            <p class="bd-counts" data-testid="browser-discovery-evidence-a11y-counts">
                                <span>@Pluralize(Inventory.AccessibilityPages, "page") captured</span>
                                <span>@Inventory.Observations raw observation(s)</span>
                                @if (Inventory.Flagged > 0) { <span class="bd-count-flagged">@Inventory.Flagged source flag(s)</span> }
                                @if (Inventory.Uncertain > 0) { <span class="bd-count-uncertain">@Inventory.Uncertain source uncertaint(ies)</span> }
                            </p>
                            <p class="bd-areas-line" data-testid="browser-discovery-evidence-a11y-areas">
                                @foreach (var area in Inventory.Areas)
                                {
                                    <span class="bd-area-badge" data-testid="browser-discovery-area-badge">@BrowserDiscoveryPresentation.PrincipleLabel(area)</span>
                                }
                            </p>
                            <p class="bd-note" data-testid="browser-discovery-raw-outcome-disclaimer">@BrowserDiscoveryPresentation.RawOutcomeDisclaimer</p>
                            <p class="bd-note" data-testid="browser-discovery-area-disclaimer">@BrowserDiscoveryPresentation.AreaDisclaimer</p>

                            <div class="bd-filters" data-testid="browser-discovery-evidence-filters">
                                <label class="bd-filter">
                                    <span>Page</span>
                                    <select @bind="_filterPage" data-testid="browser-discovery-filter-page">
                                        <option value="">All pages</option>
                                        @* Not named 'page': Razor reads a leading @page as the routing directive. *@
                                        @foreach (var observed in Inventory.Accessibility.Select(r => (r.Identity, r.Route)).Distinct().OrderBy(p => p.Route, StringComparer.Ordinal))
                                        {
                                            <option value="@observed.Identity">@observed.Route</option>
                                        }
                                    </select>
                                </label>
                                <label class="bd-filter">
                                    <span>WCAG area</span>
                                    <select @bind="_filterArea" data-testid="browser-discovery-filter-area">
                                        <option value="">All areas</option>
                                        @foreach (var area in Inventory.Areas)
                                        {
                                            <option value="@area">@BrowserDiscoveryPresentation.PrincipleLabel(area)</option>
                                        }
                                    </select>
                                </label>
                                <label class="bd-filter">
                                    <span>Raw outcome</span>
                                    @* The collector's own outcomes. "Needs attention" read as a review obligation, which is
                                       a conclusion Browser Discovery does not draw. *@
                                    <select @bind="_filterState" data-testid="browser-discovery-filter-state">
                                        <option value="non-neutral">Source flags and uncertainties</option>
                                        <option value="all">All observations</option>
                                        <option value="flagged">Source flags</option>
                                        <option value="uncertain">Source uncertainties</option>
                                        <option value="evaluated">Other observations</option>
                                    </select>
                                </label>
                            </div>

                            @if (FilteredAccessibility.Count == 0)
                            {
                                <p class="bd-empty-help" data-testid="browser-discovery-evidence-a11y-none">
                                    @(_filterState == "non-neutral"
                                        ? "The collector reported no source flags or uncertainties in the current browser evidence."
                                        : "No observations match the current filters.")
                                </p>
                            }
                            else
                            {
                                @AccessibilityTable(FilteredAccessibility, "browser-discovery-evidence-accessibility-table", "browser-discovery-evidence-a11y-row")
                            }

                            @* The complete catalogue, including the rules that ran and matched nothing. Never deleted, just not first. *@
                            <ReviewDisclosure TestId="browser-discovery-evidence-all-rules" Text="Show all evaluated rules"
                                              CollapseText="Hide all evaluated rules" Hint="@($"{ScopedAccessibility.Count}")"
                                              Class="disclosure-inline disclosure-small">
                                @AccessibilityTable(ScopedAccessibility, "browser-discovery-evidence-all-rules-table", "browser-discovery-evidence-all-rules-row")
                            </ReviewDisclosure>
                        }
                }
                </div>

                @* ── Performance: one row per page, raw observations ── *@
                <div role="tabpanel" id="bd-evidence-panel-performance" aria-labelledby="bd-evidence-tab-performance" tabindex="0" hidden="@(_evidence != "performance")">
                @if (_evidence == "performance")
                {
                        @if (Inventory.Performance.Count == 0)
                        {
                            <p class="bd-empty-help" data-testid="browser-discovery-evidence-performance-empty">No browser performance evidence observed.</p>
                        }
                        else
                        {
                            <p class="bd-note">Raw observations only; thresholds are applied in Frontend Quality Review.</p>
                            <div class="bd-tablewrap">
                                <table class="bd-table" data-testid="browser-discovery-evidence-performance-table">
                                    <caption class="bd-caption">Field measurements per page. A metric the browser did not report is shown as not observed, never as zero.</caption>
                                    <thead>
                                        <tr>
                                            <th scope="col">Page</th><th scope="col">Observation</th><th scope="col">CLS</th>
                                            <th scope="col">Page stabilization</th><th scope="col">Resources fetched</th>
                                            <th scope="col">Transferred</th><th scope="col">Observed at</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in Inventory.Performance)
                                        {
                                            <tr data-testid="browser-discovery-evidence-performance-row">
                                                <th scope="row" class="bd-mono bd-route">@PageLink(row.Identity, row.Route)</th>
                                                <td>@row.Observation</td>
                                                <td class="bd-mono">@Measured(row.Cls?.ToString("0.###"))</td>
                                                <td class="bd-mono">@Measured(row.StabilizationMs is { } ms ? $"{ms:0} ms" : null)</td>
                                                <td class="bd-mono">@Measured(row.Resources?.ToString())</td>
                                                <td class="bd-mono">@Measured(row.TransferredBytes is { } b ? BrowserDiscoveryPresentation.ByteLabel(b) : null)</td>
                                                <td class="bd-mono">@Time(row.ObservedAt)</td>
                                            </tr>
                                            @if (row.Detail.Count > 0)
                                            {
                                                <tr class="bd-detailrow">
                                                    <td colspan="7">
                                                        <ReviewDisclosure TestId="@($"browser-discovery-evidence-performance-detail-{Slug(row.Identity)}")"
                                                                          Text="Other observed metrics" CollapseText="Hide other observed metrics"
                                                                          Hint="@($"{row.Detail.Count}")" Class="disclosure-inline disclosure-small">
                                                            @ItemList(row.Detail, $"browser-discovery-evidence-performance-detail-items-{Slug(row.Identity)}")
                                                        </ReviewDisclosure>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                }
                </div>
            }
    }
    </div>

    @*
        Browser Companion stays in Browser Discovery: it is what produces this evidence. But a second large "Connected"
        card under a Live session strip that already says Connected is duplication, so what is left is setup and
        control — pairing, the recovery actions, and the developer extension install. The initial recovery situation
        sets its default; after that, expansion belongs to the user and never follows live status refreshes.
    *@
    @if (_view == "overview")
    {
        <ReviewDisclosure TestId="browser-discovery-companion-setup" Class="disclosure-inline disclosure-small"
                          Text="Browser Companion setup" CollapseText="Hide Browser Companion setup"
                          @bind-Expanded="BrowserCompanionSetupExpanded">
            <BrowserCompanionPanel Profile="Profile" Runtime="Runtime" Compact="true" Setup="true"
                                   ShowPairAction="@(!BrowserDiscoveryStates.ShowsPairAction(DiscoveryState))" />
        </ReviewDisclosure>
    }
</section>

@code {
    /// <summary>Raised when the reader asks to pair. The host owns pairing; this surface never invents the action.</summary>
    [Parameter] public EventCallback OnPair { get; set; }

    private BrowserCompanionSituation Situation => BrowserCompanionSituations.Of(Status);

    [Parameter, EditorRequired] public FrontendAnalysisProfile Profile { get; set; } = new();
    [Parameter] public BrowserCompanionRuntime? Runtime { get; set; }

    private string _view = "overview";
    private string? _selected;
    private string? _setupProfileId;
    // Null only until the target's initial status is available. A user choice, including one made while
    // that request is in flight, takes precedence over the initial recovery default.
    private bool? _browserCompanionSetupExpanded;
    private bool BrowserCompanionSetupExpanded
    {
        get => _browserCompanionSetupExpanded ?? false;
        set => _browserCompanionSetupExpanded = value;
    }

    private EndpointDiscoverySnapshot Snapshot => Discovery.GetSnapshot(Profile?.Id ?? "");
    private IReadOnlyList<BrowserPageRow> Rows => BrowserDiscoveryPresentation.Rows(Snapshot);
    private DateTimeOffset? LastEvidence => BrowserDiscoveryPresentation.LastEvidenceAt(Snapshot);

    private BrowserCompanionStatus Status => Runtime?.For(Profile?.Id) ?? new();
    private IReadOnlyList<string> ApprovedOrigins => Status.ApprovedOrigins.Count > 0 ? Status.ApprovedOrigins : BrowserCompanionScope.ApprovedOrigins(Profile);
    /// <summary>Connection is about the session, never about evidence: a connected companion may still have observed nothing.</summary>
    private string StateLabel => Status.State switch
    {
        BrowserCompanionState.Connected => "Connected",
        BrowserCompanionState.Disconnected => "Paired · not reporting",
        BrowserCompanionState.PairingPending => "Pairing…",
        BrowserCompanionState.Expired => "Session expired",
        _ => "Not connected"
    };

    private (string Key, string Label, int? Count)[] Views =>
        [("overview", "Overview", null), ("pages", "Pages", Rows.Count), ("evidence", "Evidence", null)];

    private BrowserPageRow? SelectedRow => Rows.FirstOrDefault(r => r.Identity == _selected) ?? Rows.FirstOrDefault();
    private BrowserPageEvidence? SelectedEvidence =>
        Snapshot.Pages.FirstOrDefault(p => p.Identity == SelectedRow?.Identity)?.BrowserEvidence;

    // The summary row is the primary read-out for session state and evidence, so this component follows the
    // companion runtime itself rather than depending on the card below it re-rendering.
    private BrowserCompanionRuntime? _subscribed;

    protected override async Task OnParametersSetAsync()
    {
        var profileId = Profile?.Id;
        if (_setupProfileId != profileId)
        {
            _setupProfileId = profileId;
            _browserCompanionSetupExpanded = null;
        }
        if (!ReferenceEquals(_subscribed, Runtime))
        {
            if (_subscribed is not null) _subscribed.Changed -= OnRuntimeChanged;
            _subscribed = Runtime;
            if (_subscribed is not null) _subscribed.Changed += OnRuntimeChanged;
        }
        if (Runtime is not null && Profile is not null) await Runtime.FollowAsync(Profile);
        if (_setupProfileId == profileId)
            _browserCompanionSetupExpanded ??= Situation == BrowserCompanionSituation.PairedNotConnected;
    }

    private void OnRuntimeChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() { if (_subscribed is not null) _subscribed.Changed -= OnRuntimeChanged; }

    /// <summary>A session already exists, so only the "open a page" step remains.</summary>
    private bool CompanionPaired => Status.State is not (BrowserCompanionState.NotPaired or BrowserCompanionState.Expired);

    /// <summary>
    /// The one derivation of what this page is currently showing. The summary strip, the empty state and the
    /// Browser Companion card all read from it, so one situation cannot be described three different ways.
    /// </summary>
    private BrowserDiscoveryState DiscoveryState =>
        BrowserDiscoveryStates.Of(Status.State, Rows.Count > 0, BrowserDiscoveryStates.OnApprovedPage(Status));

    private string EmptyEvidenceHelp => BrowserDiscoveryStates.Explanation(DiscoveryState);

    /// <summary>
    /// The single absence message for browser evidence, with the next action attached. Absence of evidence is stated
    /// once here; the session state is the summary strip's job and is not repeated in these words.
    /// </summary>
    private RenderFragment EmptyEvidence => __builder =>
    {
        @* The explanation is associated with the absence it explains, so the next step is announced with it
           rather than read as a stray sentence. *@
        <div class="bd-empty" data-testid="browser-discovery-empty"
             role="group" aria-labelledby="bd-empty-title" aria-describedby="bd-empty-help">
            <p class="bd-empty-title" id="bd-empty-title">@BrowserDiscoveryPresentation.NoEvidenceTitle</p>
            <p class="bd-empty-help" id="bd-empty-help" data-testid="browser-discovery-empty-help">@EmptyEvidenceHelp</p>
            @* The ONE Pair control, and only where pairing is actually the next step. A connected session is
               never asked to pair again; the Browser Companion card below suppresses its own copy of this. *@
            @if (BrowserDiscoveryStates.ShowsPairAction(DiscoveryState) && Runtime is not null && Profile is not null)
            {
                <PrimaryButton OnClick="PairCompanion" Disabled="@(Runtime.Busy || ApprovedOrigins.Count == 0)" Class="fa-btn-sm" data-testid="browser-discovery-pair">Pair Browser Companion</PrimaryButton>
            }
        </div>
    };

    /// <summary>Starts pairing through the runtime that owns it. No protocol logic is duplicated here.</summary>
    private async Task PairCompanion()
    {
        if (Runtime is not null && Profile is not null) await Runtime.StartPairingAsync(Profile);
    }

    private BrowserAccessibilityOverview Selected11y => BrowserDiscoveryPresentation.Accessibility(SelectedEvidence?.Accessibility);

    /// <summary>Availability, not a result: an assessment that ran and flagged nothing is still evidence.</summary>
    private BrowserEvidenceState Selected11yState => BrowserDiscoveryPresentation.AccessibilityState(SelectedEvidence?.Accessibility);

    // ── Evidence tab: cross-page inventory ───────────────────────────────────

    /// <summary>Which evidence type the Evidence tab is comparing. One at a time; three tables at once is a dump.</summary>
    private string _evidence = "dom";

    /// <summary>
    /// Accessibility filters. The default shows the collector's non-neutral outcomes, because the inventory exists to
    /// find what to look at — but it is named for what those outcomes are, not for what a reviewer should do about them.
    /// </summary>
    private string _filterPage = "";
    private string _filterArea = "";
    private string _filterState = "non-neutral";

    private BrowserEvidenceInventory Inventory => BrowserDiscoveryPresentation.Inventory(Snapshot);

    private (string Key, string Label, int Count)[] EvidenceTypes =>
    [
        ("dom", "DOM", Inventory.Dom.Count),
        ("accessibility", "Accessibility", Inventory.AccessibilityPages),
        ("performance", "Performance", Inventory.Performance.Count),
    ];

    /// <summary>Everything the page and area filters admit, whatever its state — the scope the full catalogue covers.</summary>
    private IReadOnlyList<BrowserAccessibilityComparisonRow> ScopedAccessibility =>
        Inventory.Accessibility
            .Where(r => _filterPage.Length == 0 || r.Identity == _filterPage)
            .Where(r => _filterArea.Length == 0 || r.Principle.ToString() == _filterArea)
            .ToList();

    private IReadOnlyList<BrowserAccessibilityComparisonRow> FilteredAccessibility =>
        ScopedAccessibility.Where(r => _filterState switch
        {
            "flagged" => r.Observation.State == BrowserObservationState.Flagged,
            "uncertain" => r.Observation.State == BrowserObservationState.Uncertain,
            "evaluated" => r.Observation.State == BrowserObservationState.Observed,
            "all" => true,
            _ => r.NonNeutral,
        }).ToList();

    private static string Pluralize(int count, string noun) => $"{count} {noun}{(count == 1 ? "" : "s")}";

    /// <summary>A test id safe fragment of a page identity.</summary>
    private static string Slug(string identity) =>
        new(identity.Select(c => char.IsLetterOrDigit(c) ? char.ToLowerInvariant(c) : '-').ToArray());

    /// <summary>A value the browser never reported says so. Rendering it as 0 would claim a measurement nobody took.</summary>
    private RenderFragment Measured(string? value) => __builder =>
    {
        if (string.IsNullOrEmpty(value))
        {
            <span class="bd-unmeasured" data-testid="bd-not-observed">Not observed</span>
        }
        else
        {
            @value
        }
    };

    /// <summary>The page cell doubles as the way into that page's own evidence, which is what Pages is for.</summary>
    private RenderFragment PageLink(string identity, string route) => __builder =>
    {
        <button type="button" class="bd-routelink" data-testid="browser-discovery-evidence-open-page"
                @onclick="() => OpenPage(identity)">@route</button>
    };

    private RenderFragment AccessibilityTable(IReadOnlyList<BrowserAccessibilityComparisonRow> rows, string tableTestId, string rowTestId) => __builder =>
    {
        <div class="bd-tablewrap">
            <table class="bd-table" data-testid="@tableTestId">
                <thead>
                    <tr>
                        <th scope="col">Page</th><th scope="col">WCAG area</th><th scope="col">Criterion mapping</th>
                        <th scope="col">Evidence item</th><th scope="col">Raw observation</th><th scope="col">Observed at</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in rows)
                    {
                        <tr data-testid="@rowTestId">
                            <th scope="row" class="bd-mono bd-route">@PageLink(row.Identity, row.Route)</th>
                            <td><span class="bd-area-badge">@BrowserDiscoveryPresentation.PrincipleLabel(row.Principle)</span></td>
                            <td class="bd-mono">@(row.CriterionId ?? "—")</td>
                            <td><span class="bd-evidence-label">@row.Observation.Label</span></td>
                            <td><span class="bd-obs-state bd-obs-@row.Observation.State.ToString().ToLowerInvariant()">@row.Observation.StateDetail</span></td>
                            <td class="bd-mono">@Time(row.ObservedAt)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    };

    private void Select(string key) { _view = key; }
    private void OpenPage(string identity) { _selected = identity; _view = "pages"; }

    private void NavKey(KeyboardEventArgs e)
    {
        if (e.Key is not ("ArrowLeft" or "ArrowRight" or "Home" or "End")) return;
        var keys = Views.Select(v => v.Key).ToList();
        var index = keys.IndexOf(_view);
        _view = e.Key switch
        {
            "Home" => keys[0],
            "End" => keys[^1],
            "ArrowRight" => keys[(index + 1) % keys.Count],
            _ => keys[(index - 1 + keys.Count) % keys.Count]
        };
    }

    private static string Time(DateTimeOffset value) => value.ToLocalTime().ToString("HH:mm:ss");

    /// <summary>
    /// The one hand-off, rendered wherever a view ends. The boundary sentence used to appear as its own paragraph in
    /// three places plus once per evidence type; this is the single compact call to action that replaced them.
    /// </summary>
    private RenderFragment Handoff(string testId, string actionTestId) => __builder =>
    {
        <div class="bd-handoff" data-testid="@testId">
            <div class="bd-handoff-body">
                <h5 class="bd-handoff-title">@BrowserDiscoveryPresentation.HandoffTitle</h5>
                <p class="bd-handoff-text">@BrowserDiscoveryPresentation.HandoffText</p>
            </div>
            <a class="bd-link bd-handoff-action" href="/frontend-quality-review" data-testid="@actionTestId">@BrowserDiscoveryPresentation.HandoffAction →</a>
        </div>
    };

    /// <summary>Raw structural counts for the selected page. Three of them; the rest live in Evidence → DOM.</summary>
    private static string DomLine(BrowserPageEvidence evidence) => BrowserDiscoveryPresentation.DomSummaryLine(evidence.Dom);

    /// <summary>How much raw accessibility evidence exists, plus the collector's own non-neutral outcomes if any.</summary>
    private string AccessibilityLine => BrowserDiscoveryPresentation.Line(
        BrowserDiscoveryPresentation.AccessibilitySummaryLine(Selected11y),
        BrowserDiscoveryPresentation.RawOutcomeLine(Selected11y.Flagged, Selected11y.Uncertain));

    /// <summary>How the page was observed and how long it took to settle. No threshold, no rating.</summary>
    private static string PerformanceLine(BrowserPageEvidence evidence) => BrowserDiscoveryPresentation.PerformanceSummaryLine(evidence.Performance);

    /// <summary>
    /// Into the raw explorer, scoped to the page the reader was looking at. Pages summarizes one page; Evidence is
    /// where its individual observations live, so the hand-off between them carries the page filter.
    /// </summary>
    private void OpenRawEvidence(string identity)
    {
        _filterPage = identity;
        _evidence = "dom";
        _view = "evidence";
    }

    private RenderFragment StateBadge(BrowserEvidenceState state) => __builder =>
    {
        <span class="bd-state bd-state-@BrowserDiscoveryPresentation.StateCss(state)">@BrowserDiscoveryPresentation.StateLabel(state)</span>
    };

    private RenderFragment ItemList(IReadOnlyList<BrowserEvidenceItem> items, string testId) => __builder =>
    {
        <dl class="bd-items" data-testid="@testId">
            @foreach (var item in items)
            {
                <div><dt>@item.Label</dt><dd class="bd-mono">@item.Detail</dd></div>
            }
        </dl>
    };

}
