@using BirkNext.BrowserCompanion
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@implements IDisposable
@inject IEndpointDiscoveryService Discovery

@*
    Browser Discovery presents browser-side EVIDENCE observed by Browser Companion.
    Frontend Quality Review interprets that evidence. Nothing here assesses, scores or judges:
    WCAG areas group observed evidence by principle and are never a conformance result.
*@
<section class="bd" data-testid="browser-discovery" aria-label="Browser discovery">

    <div class="bd-overview" data-testid="browser-discovery-summary">
        <div class="bd-ov-item"><span class="bd-ov-label">Target</span><span class="bd-ov-value" data-testid="bd-target">@(Profile?.Name ?? "—")</span></div>
        <div class="bd-ov-item"><span class="bd-ov-label">Browser session</span><span class="bd-ov-value" data-testid="bd-session">@BrowserDiscoveryStates.SessionLabel(Status.State)</span></div>
        <div class="bd-ov-item"><span class="bd-ov-label">Pages with evidence</span><span class="bd-ov-value" data-testid="bd-pages-count">@Rows.Count</span></div>
        <div class="bd-ov-item"><span class="bd-ov-label">Last evidence</span><span class="bd-ov-value bd-mono" data-testid="bd-last-evidence">@(LastEvidence is { } t ? Time(t) : "None")</span></div>
        <div class="bd-ov-item"><span class="bd-ov-label">Current page</span><span class="bd-ov-value bd-mono" data-testid="bd-current-page">@CurrentPage</span></div>
        @* Approved origins is a security fact, not a review metric; it lives in the Browser Companion details. *@
    </div>

    <nav class="bd-nav" role="tablist" aria-label="Browser discovery views">
        @foreach (var (key, label, count) in Views)
        {
            <button type="button" class="bd-navbtn @(_view == key ? "bd-navbtn-active" : "")"
                    id="@($"browser-discovery-tab-{key}")" role="tab"
                    aria-selected="@((_view == key).ToString().ToLowerInvariant())"
                    aria-controls="@($"browser-discovery-panel-{key}")"
                    tabindex="@(_view == key ? 0 : -1)"
                    data-testid="@($"browser-discovery-nav-{key}")"
                    @onclick="() => Select(key)" @onkeydown="NavKey">@label@(count is { } c ? $" ({c})" : "")</button>
        }
    </nav>

    @* Every panel element exists so each tab's aria-controls always resolves; only the selected panel has content. *@

    @* ── Overview: what browser evidence is currently available? ── *@
    <div class="bd-panel" role="tabpanel" id="browser-discovery-panel-overview" aria-labelledby="browser-discovery-tab-overview" tabindex="0" hidden="@(_view != "overview")">
    @if (_view == "overview")
    {
            <h4 class="bd-panel-title">Observed browser evidence</h4>
            @if (Rows.Count == 0)
            {
                @EmptyEvidence
            }
            else
            {
                <div class="bd-tablewrap">
                    <table class="bd-table" data-testid="browser-discovery-overview-table">
                        <caption class="bd-caption">Browser evidence observed per page. Evidence only — Frontend Quality Review interprets it.</caption>
                        <thead>
                            <tr>
                                <th scope="col">Page / Route</th>
                                <th scope="col">WCAG areas</th>
                                <th scope="col">DOM</th>
                                <th scope="col">Performance evidence</th>
                                <th scope="col">Last seen</th>
                                <th scope="col">Source</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Rows)
                            {
                                <tr data-testid="browser-discovery-page-row">
                                    <th scope="row" class="bd-mono bd-route">
                                        <button type="button" class="bd-routelink" data-testid="browser-discovery-open-page" @onclick="() => OpenPage(row.Identity)">@row.Route</button>
                                    </th>
                                    <td>@AreaBadges(row.WcagAreas)</td>
                                    <td>@StateBadge(row.Dom)</td>
                                    <td>@StateBadge(row.Performance)</td>
                                    <td class="bd-mono">@(row.LastSeen is { } seen ? Time(seen) : "—")</td>
                                    <td><span class="bd-source">@row.Source</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="bd-note" data-testid="browser-discovery-area-disclaimer">@BrowserDiscoveryPresentation.AreaDisclaimer</p>
                @* What exists, then ONE way to go interpret it. The same link repeated per evidence type read as three
                   different destinations. *@
                <div class="bd-handoff" data-testid="browser-discovery-handoff">
                    @if (DomPages > 0)
                    {
                        <p data-testid="browser-discovery-dom-count">DOM evidence available for @DomPages page(s).</p>
                    }
                    @if (AccessibilityPages > 0)
                    {
                        <p data-testid="browser-discovery-accessibility-count">Accessibility evidence available for @AccessibilityPages page(s).</p>
                    }
                    @if (PerformancePages > 0)
                    {
                        <p data-testid="browser-discovery-performance-count">Performance evidence available for @PerformancePages page(s).</p>
                    }
                    <p>Browser Discovery records raw evidence. Frontend Quality Review interprets it.
                        <a class="bd-link" href="/frontend-quality-review" data-testid="browser-discovery-open-review">Open Frontend Quality Review</a></p>
                </div>
            }
    }
    </div>

    @* ── Pages: detailed per-page browser evidence ── *@
    <div class="bd-panel bd-split" role="tabpanel" id="browser-discovery-panel-pages" aria-labelledby="browser-discovery-tab-pages" tabindex="0" hidden="@(_view != "pages")">
    @if (_view == "pages")
    {
            <aside class="bd-pagelist" aria-label="Pages with browser evidence">
                @if (Rows.Count == 0)
                {
                    <p class="bd-empty-help">@EmptyEvidenceHelp</p>
                }
                @foreach (var row in Rows)
                {
                    <button type="button" class="bd-pagelink @(SelectedRow?.Identity == row.Identity ? "bd-pagelink-active" : "")"
                            aria-current="@(SelectedRow?.Identity == row.Identity ? "true" : null)"
                            data-testid="browser-discovery-page-link" @onclick="() => _selected = row.Identity">
                        <span class="bd-pagetitle">@row.Route</span>
                        <span class="bd-pagesub">@(row.LastSeen is { } s ? Time(s) : "—")</span>
                    </button>
                }
            </aside>
            @* Keyed on the selected page so its disclosures start collapsed rather than inheriting the previous page's. *@
            <div class="bd-pagedetail" @key="SelectedRow?.Identity">
                @if (SelectedRow is { } sel && SelectedEvidence is { } evidence)
                {
                    @* Result-first: which page, when it was observed, what evidence exists — before any rule detail. *@
                    <h4 class="bd-page-title bd-mono" data-testid="browser-discovery-selected-page">@sel.Route</h4>
                    <dl class="bd-summary" data-testid="browser-discovery-page-summary">
                        <div><dt>Last observed</dt><dd class="bd-mono" data-testid="browser-discovery-page-observed">@(sel.LastSeen is { } o ? Time(o) : "—")</dd></div>
                        <div><dt>Source</dt><dd data-testid="browser-discovery-page-source">@sel.Source</dd></div>
                    </dl>

                    @* Availability, never a verdict: "Not observed" rather than a zero that reads as a measurement. *@
                    <dl class="bd-summary bd-availability" data-testid="browser-discovery-page-evidence">
                        <div><dt>DOM</dt><dd data-testid="browser-discovery-page-dom-state">@StateBadge(sel.Dom)</dd></div>
                        <div><dt>Accessibility</dt><dd data-testid="browser-discovery-page-accessibility-state">@StateBadge(Selected11yState)</dd></div>
                        <div><dt>Performance</dt><dd data-testid="browser-discovery-page-performance-state">@StateBadge(sel.Performance)</dd></div>
                    </dl>

                    @* The one handoff. Repeating it per evidence type is how the same link ended up on the page three times. *@
                    <p class="bd-note bd-pagehandoff" data-testid="browser-discovery-page-handoff">
                        Browser Discovery records raw evidence. Frontend Quality Review interprets it.
                        <a class="bd-link" href="/frontend-quality-review" data-testid="browser-discovery-open-review-page">Open Frontend Quality Review</a>
                    </p>

                    @* ── Accessibility evidence: summary, then what needs attention, then detail on request ── *@
                    <h5 class="bd-section-title">Accessibility evidence</h5>
                    @if (Selected11y is { Any: true } a11y)
                    {
                        <p class="bd-counts" data-testid="browser-discovery-a11y-counts">
                            <span>@a11y.PrincipleCount WCAG area(s)</span>
                            <span>@a11y.Evaluated check(s) evaluated</span>
                            @if (a11y.Flagged > 0) { <span class="bd-count-flagged">@a11y.Flagged flagged</span> }
                            @if (a11y.Uncertain > 0) { <span class="bd-count-uncertain">@a11y.Uncertain uncertain</span> }
                        </p>
                        <p class="bd-note">@BrowserDiscoveryPresentation.AreaDisclaimer</p>

                        @if (a11y.Attention.Count > 0)
                        {
                            <section class="bd-attention" data-testid="browser-discovery-a11y-attention" aria-labelledby="bd-attention-heading">
                                <h6 class="bd-area-title" id="bd-attention-heading">Observed items requiring attention</h6>
                                <ul class="bd-obslist">
                                    @foreach (var observation in a11y.Attention.Take(AttentionPreview))
                                    {
                                        <li data-testid="browser-discovery-a11y-attention-item">
                                            <span class="bd-obs-id bd-mono">@observation.Id</span>
                                            <span class="bd-obs-state bd-obs-@observation.State.ToString().ToLowerInvariant()">@observation.StateDetail</span>
                                        </li>
                                    }
                                </ul>
                                @if (a11y.Attention.Count > AttentionPreview)
                                {
                                    <p class="bd-note" data-testid="browser-discovery-a11y-attention-more">@(a11y.Attention.Count - AttentionPreview) more in the principle detail below.</p>
                                }
                            </section>
                        }

                        @* Collapsed principle rows. Counts are visible without expanding; only the reader opens one. *@
                        <div class="bd-principles" data-testid="browser-discovery-a11y-principles">
                            @foreach (var principle in a11y.Principles)
                            {
                                var key = principle.Principle.ToString().ToLowerInvariant();
                                <section class="bd-principle" data-testid="@($"browser-discovery-area-{key}")">
                                    <ReviewDisclosure TestId="@($"browser-discovery-principle-{key}")"
                                                      Text="@BrowserDiscoveryPresentation.PrincipleLabel(principle.Principle)"
                                                      Hint="@PrincipleHint(principle)" Class="disclosure-inline">
                                        @ObservationRows(principle.Primary, $"browser-discovery-principle-{key}-item")
                                        @if (principle.OtherEvaluated.Count > 0)
                                        {
                                            <ReviewDisclosure TestId="@($"browser-discovery-principle-{key}-evaluated")"
                                                              Text="Other evaluated rules" CollapseText="Hide other evaluated rules"
                                                              Hint="@($"{principle.OtherEvaluated.Count}")" Class="disclosure-inline disclosure-small">
                                                @ObservationRows(principle.OtherEvaluated, $"browser-discovery-principle-{key}-evaluated-item")
                                            </ReviewDisclosure>
                                        }
                                    </ReviewDisclosure>
                                </section>
                            }
                        </div>

                        @if (a11y.AutomatedRules.Count > 0)
                        {
                            <section class="bd-automated" data-testid="browser-discovery-a11y-automated">
                                <h6 class="bd-area-title">Automated accessibility evidence</h6>
                                <p class="bd-counts" data-testid="browser-discovery-a11y-automated-counts">
                                    <span>@a11y.AutomatedRules.Count rule(s) evaluated</span>
                                    @if (a11y.AutomatedFlagged > 0) { <span class="bd-count-flagged">@a11y.AutomatedFlagged flagged</span> }
                                    @if (a11y.AutomatedUncertain > 0) { <span class="bd-count-uncertain">@a11y.AutomatedUncertain uncertain</span> }
                                </p>
                                <ReviewDisclosure TestId="browser-discovery-a11y-rules" Text="View evaluated rules"
                                                  CollapseText="Hide evaluated rules" Class="disclosure-inline disclosure-small">
                                    @ObservationRows(a11y.AutomatedRules, "browser-discovery-a11y-rule")
                                </ReviewDisclosure>
                            </section>
                        }
                    }
                    else
                    {
                        <p class="bd-empty-help" data-testid="browser-discovery-page-areas-empty">No accessibility evidence was observed for this page.</p>
                    }

                    @* ── DOM evidence ── *@
                    <h5 class="bd-section-title">DOM evidence</h5>
                    @if (BrowserDiscoveryPresentation.DomPrimary(evidence.Dom) is { Count: > 0 } domItems)
                    {
                        @ItemList(domItems, "browser-discovery-page-dom")
                        @if (BrowserDiscoveryPresentation.DomDetail(evidence.Dom) is { Count: > 0 } domDetail)
                        {
                            <ReviewDisclosure TestId="browser-discovery-page-dom-detail" Text="View DOM details"
                                              CollapseText="Hide DOM details" Hint="@($"{domDetail.Count}")" Class="disclosure-inline disclosure-small">
                                @ItemList(domDetail, "browser-discovery-page-dom-extra")
                            </ReviewDisclosure>
                        }
                    }
                    else
                    {
                        <p class="bd-empty-help" data-testid="browser-discovery-page-dom-empty">No DOM evidence was observed for this page.</p>
                    }

                    @* ── Performance evidence: unchanged raw observations, no thresholds ── *@
                    <h5 class="bd-section-title">Performance evidence</h5>
                    @if (BrowserDiscoveryPresentation.PerformanceEvidence(evidence.Performance) is { Count: > 0 } perfItems)
                    {
                        <p class="bd-note">Observation: @BrowserDiscoveryPresentation.ObservationLabel(evidence.Performance). Raw observations only; thresholds are applied in Frontend Quality Review.</p>
                        @ItemList(perfItems, "browser-discovery-page-performance")
                    }
                    else
                    {
                        <p class="bd-empty-help" data-testid="browser-discovery-page-performance-empty">No performance evidence was observed for this page.</p>
                    }
                }
                else
                {
                    <p class="bd-empty-help">Select a page to see the browser evidence observed for it.</p>
                }
            </div>
    }
    </div>

    @* ── Evidence: normalized explorer grouped by evidence type ── *@
    <div class="bd-panel" role="tabpanel" id="browser-discovery-panel-evidence" aria-labelledby="browser-discovery-tab-evidence" tabindex="0" hidden="@(_view != "evidence")">
    @if (_view == "evidence")
    {
            <h4 class="bd-panel-title">Observed browser evidence by type</h4>
            @if (Rows.Count == 0)
            {
                @EmptyEvidence
            }
            else
            {
                <section class="bd-evidence-group" data-testid="browser-discovery-evidence-dom" aria-labelledby="bd-evidence-dom-heading">
                    <h5 class="bd-section-title" id="bd-evidence-dom-heading">DOM</h5>
                    @EvidenceTable(
                        EvidencePages.SelectMany(p => BrowserDiscoveryPresentation.DomEvidence(p.Evidence.Dom).Select(i => (p.Route, Type: i.Label, i.Detail, p.Evidence.CapturedAt))).ToList(),
                        "Evidence type", "No DOM evidence observed yet.")
                </section>

                <section class="bd-evidence-group" data-testid="browser-discovery-evidence-accessibility" aria-labelledby="bd-evidence-a11y-heading">
                    <h5 class="bd-section-title" id="bd-evidence-a11y-heading">Accessibility</h5>
                    <p class="bd-note">@BrowserDiscoveryPresentation.AreaDisclaimer</p>
                    @if (AccessibilityRows.Count == 0)
                    {
                        <p class="bd-empty-help">No accessibility evidence observed yet.</p>
                    }
                    else
                    {
                        <div class="bd-tablewrap">
                            <table class="bd-table" data-testid="browser-discovery-evidence-accessibility-table">
                                <thead><tr><th scope="col">Page</th><th scope="col">WCAG area</th><th scope="col">Criterion</th><th scope="col">Evidence item</th><th scope="col">Observed at</th><th scope="col">Source</th></tr></thead>
                                <tbody>
                                    @foreach (var row in AccessibilityRows)
                                    {
                                        <tr>
                                            <th scope="row" class="bd-mono">@row.Route</th>
                                            <td><span class="bd-area-badge">@BrowserDiscoveryPresentation.PrincipleLabel(row.Principle)</span></td>
                                            <td class="bd-mono">@(row.Item.CriterionId ?? "—")</td>
                                            <td><span class="bd-evidence-label">@row.Item.Label</span> <span class="bd-evidence-detail">@row.Item.Detail</span></td>
                                            <td class="bd-mono">@Time(row.CapturedAt)</td>
                                            <td><span class="bd-source">@BrowserDiscoveryPresentation.Source</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>

                <section class="bd-evidence-group" data-testid="browser-discovery-evidence-performance" aria-labelledby="bd-evidence-perf-heading">
                    <h5 class="bd-section-title" id="bd-evidence-perf-heading">Performance</h5>
                    @EvidenceTable(
                        EvidencePages.SelectMany(p => BrowserDiscoveryPresentation.PerformanceEvidence(p.Evidence.Performance).Select(i => (p.Route, Type: i.Label, Detail: i.Detail, p.Evidence.CapturedAt))).ToList(),
                        "Metric", "No performance evidence observed yet.")
                </section>
            }
    }
    </div>

    @* Browser Companion stays in Browser Discovery: it is what produces this evidence. It belongs to Overview, which
       owns the session — pairing, approved origins and what to do when nothing is reporting. Repeating the card under
       every page's evidence made session management compete with the evidence the reader came for; the summary strip
       above states the session on every tab, so nothing is hidden by leaving it out here. *@
    @if (_view == "overview")
    {
        <BrowserCompanionPanel Profile="Profile" Runtime="Runtime" Compact="true"
                               ShowPairAction="@(!BrowserDiscoveryStates.ShowsPairAction(DiscoveryState))" />
    }
</section>

@code {
    [Parameter, EditorRequired] public FrontendAnalysisProfile Profile { get; set; } = new();
    [Parameter] public BrowserCompanionRuntime? Runtime { get; set; }

    private string _view = "overview";
    private string? _selected;

    private EndpointDiscoverySnapshot Snapshot => Discovery.GetSnapshot(Profile?.Id ?? "");
    private IReadOnlyList<BrowserPageRow> Rows => BrowserDiscoveryPresentation.Rows(Snapshot);
    private DateTimeOffset? LastEvidence => BrowserDiscoveryPresentation.LastEvidenceAt(Snapshot);
    private int DomPages => Rows.Count(r => r.Dom == BrowserEvidenceState.Available);
    private int AccessibilityPages => Rows.Count(r => r.WcagAreas.Count > 0);
    private int PerformancePages => Rows.Count(r => r.Performance == BrowserEvidenceState.Available);

    private BrowserCompanionStatus Status => Runtime?.For(Profile?.Id) ?? new();
    private IReadOnlyList<string> ApprovedOrigins => Status.ApprovedOrigins.Count > 0 ? Status.ApprovedOrigins : BrowserCompanionScope.ApprovedOrigins(Profile);
    /// <summary>Connection is about the session, never about evidence: a connected companion may still have observed nothing.</summary>
    private string StateLabel => Status.State switch
    {
        BrowserCompanionState.Connected => "Connected",
        BrowserCompanionState.Disconnected => "Paired · not reporting",
        BrowserCompanionState.PairingPending => "Pairing…",
        BrowserCompanionState.Expired => "Session expired",
        _ => "Not connected"
    };
    private string CurrentPage => Status.CurrentPageOrigin is { Length: > 0 } o ? $"{o}{Status.CurrentPagePath}"
        : Status.State == BrowserCompanionState.Connected ? "No approved page open" : "—";

    private (string Key, string Label, int? Count)[] Views =>
        [("overview", "Overview", null), ("pages", "Pages", Rows.Count), ("evidence", "Evidence", null)];

    private BrowserPageRow? SelectedRow => Rows.FirstOrDefault(r => r.Identity == _selected) ?? Rows.FirstOrDefault();
    private BrowserPageEvidence? SelectedEvidence =>
        Snapshot.Pages.FirstOrDefault(p => p.Identity == SelectedRow?.Identity)?.BrowserEvidence;

    private IReadOnlyList<(string Route, BrowserPageEvidence Evidence)> EvidencePages =>
        Snapshot.Pages.Where(p => p.BrowserEvidence is not null)
            .OrderByDescending(p => p.BrowserEvidence!.CapturedAt)
            .Select(p => (p.PagePath.Length == 0 ? "/" : p.PagePath, p.BrowserEvidence!)).ToList();

    private IReadOnlyList<(string Route, WcagPrinciple Principle, BrowserEvidenceItem Item, DateTimeOffset CapturedAt)> AccessibilityRows =>
        EvidencePages.SelectMany(p => BrowserDiscoveryPresentation.AreaEvidence(p.Evidence.Accessibility)
            .SelectMany(area => area.Items.Select(item => (p.Route, area.Principle, item, p.Evidence.CapturedAt)))).ToList();

    // The summary row is the primary read-out for session state and evidence, so this component follows the
    // companion runtime itself rather than depending on the card below it re-rendering.
    private BrowserCompanionRuntime? _subscribed;

    protected override async Task OnParametersSetAsync()
    {
        if (!ReferenceEquals(_subscribed, Runtime))
        {
            if (_subscribed is not null) _subscribed.Changed -= OnRuntimeChanged;
            _subscribed = Runtime;
            if (_subscribed is not null) _subscribed.Changed += OnRuntimeChanged;
        }
        if (Runtime is not null && Profile is not null) await Runtime.FollowAsync(Profile);
    }

    private void OnRuntimeChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() { if (_subscribed is not null) _subscribed.Changed -= OnRuntimeChanged; }

    /// <summary>A session already exists, so only the "open a page" step remains.</summary>
    private bool CompanionPaired => Status.State is not (BrowserCompanionState.NotPaired or BrowserCompanionState.Expired);

    /// <summary>
    /// The one derivation of what this page is currently showing. The summary strip, the empty state and the
    /// Browser Companion card all read from it, so one situation cannot be described three different ways.
    /// </summary>
    private BrowserDiscoveryState DiscoveryState =>
        BrowserDiscoveryStates.Of(Status.State, Rows.Count > 0, BrowserDiscoveryStates.OnApprovedPage(Status));

    private string EmptyEvidenceHelp => BrowserDiscoveryStates.Explanation(DiscoveryState);

    /// <summary>
    /// The single absence message for browser evidence, with the next action attached. Absence of evidence is stated
    /// once here; the session state is the summary strip's job and is not repeated in these words.
    /// </summary>
    private RenderFragment EmptyEvidence => __builder =>
    {
        @* The explanation is associated with the absence it explains, so the next step is announced with it
           rather than read as a stray sentence. *@
        <div class="bd-empty" data-testid="browser-discovery-empty"
             role="group" aria-labelledby="bd-empty-title" aria-describedby="bd-empty-help">
            <p class="bd-empty-title" id="bd-empty-title">@BrowserDiscoveryPresentation.NoEvidenceTitle</p>
            <p class="bd-empty-help" id="bd-empty-help" data-testid="browser-discovery-empty-help">@EmptyEvidenceHelp</p>
            @* The ONE Pair control, and only where pairing is actually the next step. A connected session is
               never asked to pair again; the Browser Companion card below suppresses its own copy of this. *@
            @if (BrowserDiscoveryStates.ShowsPairAction(DiscoveryState) && Runtime is not null && Profile is not null)
            {
                <PrimaryButton OnClick="PairCompanion" Disabled="@(Runtime.Busy || ApprovedOrigins.Count == 0)" Class="fa-btn-sm" data-testid="browser-discovery-pair">Pair Browser Companion</PrimaryButton>
            }
        </div>
    };

    /// <summary>Starts pairing through the runtime that owns it. No protocol logic is duplicated here.</summary>
    private async Task PairCompanion()
    {
        if (Runtime is not null && Profile is not null) await Runtime.StartPairingAsync(Profile);
    }

    /// <summary>Enough of the attention list to act on, without rebuilding the list the summary exists to replace.</summary>
    private const int AttentionPreview = 5;

    private BrowserAccessibilityOverview Selected11y => BrowserDiscoveryPresentation.Accessibility(SelectedEvidence?.Accessibility);

    /// <summary>Availability, not a result: an assessment that ran and flagged nothing is still evidence.</summary>
    private BrowserEvidenceState Selected11yState => BrowserDiscoveryPresentation.AccessibilityState(SelectedEvidence?.Accessibility);

    /// <summary>What a collapsed principle says about itself, so the reader can decide whether to open it.</summary>
    private static string PrincipleHint(BrowserPrincipleEvidence principle) => string.Join(" · ", new[]
    {
        $"{principle.Observations.Count} observed",
        principle.Flagged > 0 ? $"{principle.Flagged} flagged" : null,
        principle.Uncertain > 0 ? $"{principle.Uncertain} uncertain" : null,
    }.Where(part => part is not null));

    private RenderFragment ObservationRows(IReadOnlyList<BrowserObservation> observations, string testId) => __builder =>
    {
        <ul class="bd-obslist">
            @foreach (var observation in observations)
            {
                <li data-testid="@testId">
                    <span class="bd-obs-label">@observation.Label</span>
                    <span class="bd-obs-state bd-obs-@observation.State.ToString().ToLowerInvariant()">@observation.StateDetail</span>
                    <span class="bd-obs-detail">@observation.Detail</span>
                    @if (observation.CriterionId is { Length: > 0 } criterion)
                    {
                        <span class="bd-crit">WCAG @criterion</span>
                    }
                </li>
            }
        </ul>
    };

    private void Select(string key) { _view = key; }
    private void OpenPage(string identity) { _selected = identity; _view = "pages"; }

    private void NavKey(KeyboardEventArgs e)
    {
        if (e.Key is not ("ArrowLeft" or "ArrowRight" or "Home" or "End")) return;
        var keys = Views.Select(v => v.Key).ToList();
        var index = keys.IndexOf(_view);
        _view = e.Key switch
        {
            "Home" => keys[0],
            "End" => keys[^1],
            "ArrowRight" => keys[(index + 1) % keys.Count],
            _ => keys[(index - 1 + keys.Count) % keys.Count]
        };
    }

    private static string Time(DateTimeOffset value) => value.ToLocalTime().ToString("HH:mm:ss");

    private RenderFragment AreaBadges(IReadOnlyList<WcagPrinciple> areas) => __builder =>
    {
        if (areas.Count == 0)
        {
            <span class="bd-area-badge bd-area-badge-none" data-testid="browser-discovery-areas-none">No accessibility evidence</span>
        }
        else
        {
            foreach (var area in areas)
            {
                <span class="bd-area-badge" data-testid="browser-discovery-area-badge">@BrowserDiscoveryPresentation.PrincipleLabel(area)</span>
            }
        }
    };

    private RenderFragment StateBadge(BrowserEvidenceState state) => __builder =>
    {
        <span class="bd-state bd-state-@BrowserDiscoveryPresentation.StateCss(state)">@BrowserDiscoveryPresentation.StateLabel(state)</span>
    };

    private RenderFragment ItemList(IReadOnlyList<BrowserEvidenceItem> items, string testId) => __builder =>
    {
        <dl class="bd-items" data-testid="@testId">
            @foreach (var item in items)
            {
                <div><dt>@item.Label</dt><dd class="bd-mono">@item.Detail</dd></div>
            }
        </dl>
    };

    private RenderFragment EvidenceTable(IReadOnlyList<(string Route, string Type, string Detail, DateTimeOffset CapturedAt)> rows, string typeHeader, string empty) => __builder =>
    {
        if (rows.Count == 0)
        {
            <p class="bd-empty-help">@empty</p>
        }
        else
        {
            <div class="bd-tablewrap">
                <table class="bd-table">
                    <thead><tr><th scope="col">Page</th><th scope="col">@typeHeader</th><th scope="col">Observed value</th><th scope="col">Observed at</th><th scope="col">Source</th></tr></thead>
                    <tbody>
                        @foreach (var row in rows)
                        {
                            <tr>
                                <th scope="row" class="bd-mono">@row.Route</th>
                                <td>@row.Type</td>
                                <td class="bd-mono">@row.Detail</td>
                                <td class="bd-mono">@Time(row.CapturedAt)</td>
                                <td><span class="bd-source">@BrowserDiscoveryPresentation.Source</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    };
}
