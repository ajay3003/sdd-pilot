@using BirkNext.Web.Services
@using BirkNext.Web.Services.Explorers
@using BirkNext.Web.Services.ProjectEvidence
@implements IDisposable
@inject IArtifactExplorerContext Explorer
@inject IServiceProvider Services
@* Shared frame of every document explorer: reads the role's artifacts from the current workspace and shows loading,
   error, empty, choose-an-artifact or the loaded artifact (context bar + selector) around the explorer's own content.
   Explorers get the selected artifact's content from here and never look up files by name. *@

<section class="axh" data-testid="artifact-explorer" data-role="@Role" data-status="@StatusKey"
         data-birknext-document-id="@DocumentIdentity">
    <ProjectContextStrip RequiresEnvironment="false" />
    @if (_state is null)
    {
        <div class="axh-card axh-loading" role="status" aria-live="polite" data-testid="artifact-explorer-loading">
            <span class="loading-spinner" aria-hidden="true"></span>
            Loading @Label artifacts…
        </div>
    }
    else
    {
        @if (ShowSourceBar)
        {
            @* View: the project's corpus (default) or one imported source (provenance, inspection). The project is never offered as if it were a
               source, and choosing a mode never changes what is imported, bound or reviewed. Shared by every Explorer and saved with the workspace. *@
            <div class="axh-module-bar axh-source-bar" data-testid="artifact-explorer-source-bar">
                <span class="axh-select-label" id="@($"{_id}-view")">View</span>
                <div class="axh-segmented" role="group" aria-labelledby="@($"{_id}-view")" data-testid="artifact-explorer-view">
                    <button type="button" class="axh-segment @(SingleSourceView ? "" : "is-active")" aria-pressed="@(SingleSourceView ? "false" : "true")"
                            data-testid="artifact-explorer-view-project" @onclick="ShowProjectView">Project</button>
                    <button type="button" class="axh-segment @(SingleSourceView ? "is-active" : "")" aria-pressed="@(SingleSourceView ? "true" : "false")"
                            data-testid="artifact-explorer-view-single" @onclick="ShowSingleSourceView">Single source</button>
                </div>
                @if (SingleSourceView)
                {
                    <label class="axh-select-label" for="@($"{_id}-source")">Source</label>
                    <select id="@($"{_id}-source")" class="axh-select" data-testid="artifact-explorer-source-selector" value="@(Explorer.ExplorerSource ?? "")" @onchange="OnSourceChanged">
                        @if (Explorer.ExplorerSource is null) { <option value="">Choose a source…</option> }
                        @foreach (var group in Explorer.Sources.GroupBy(o => o.Group))
                        {
                            <optgroup label="@group.Key">
                                @foreach (var option in group)
                                {
                                    <option value="@option.Value">@option.Label@(option.ArchiveFileName is { } archive && !string.Equals(archive, option.Label + ".zip", StringComparison.OrdinalIgnoreCase) ? $" ({archive})" : "")@SourceCountText(option.Value)</option>
                                }
                            </optgroup>
                        }
                    </select>
                }
                <span class="axh-module-note" data-testid="artifact-explorer-source-note">@ViewNote</span>
            </div>
            @if (_sourceRemoved)
            {
                <p class="axh-evidence-line" role="status" data-testid="artifact-explorer-source-unavailable">The previously selected source is no longer imported in this workspace. Showing the project view instead; no other source was chosen for you.</p>
            }
        }
        @if (_state.HasModules && !_state.ModuleRequired && _state.Status is not (ExplorerArtifactStatus.Error or ExplorerArtifactStatus.ProjectUnavailable))
        {
            @* A monorepo: every role resolves within one module. The selector says which module this explorer (and every review) reads. *@
            <div class="axh-module-bar" data-testid="artifact-explorer-module-bar">
                <label class="axh-select-label" for="@($"{_id}-module")">Module</label>
                <select id="@($"{_id}-module")" class="axh-select" data-testid="artifact-explorer-module-selector"
                        value="@_state.Module" @onchange="OnModuleChanged">
                    @foreach (var module in _state.Modules!)
                    {
                        <option value="@module.Module">@ModuleOptionText(module)</option>
                    }
                </select>
                <span class="axh-module-note">Choose a module to review its features.</span>
            </div>
        }
        @if (_state.HasPacks && !_state.PackRequired && _state.Status is not (ExplorerArtifactStatus.Error or ExplorerArtifactStatus.ProjectUnavailable))
        {
            @* Feature packs: every role resolves within the viewed pack (plus shared artifacts); siblings are never mixed. *@
            <div class="axh-module-bar axh-pack-bar" data-testid="artifact-explorer-pack-bar">
                <label class="axh-select-label" for="@($"{_id}-pack")">Feature</label>
                <select id="@($"{_id}-pack")" class="axh-select" data-testid="artifact-explorer-pack-selector"
                        value="@_state.Pack" @onchange="OnPackChanged">
                    @foreach (var pack in _state.Packs!)
                    {
                        <option value="@pack.Pack">@PackOptionText(pack)</option>
                    }
                </select>
                <span class="axh-module-note" title="Documents from other feature packs are never mixed automatically.">Reviews use this feature and its shared project documents.
                    <span class="visually-hidden">Documents from other feature packs are never mixed automatically.</span></span>
            </div>
        }
        @if (Corpus is { } corpus && _state.Status is not (ExplorerArtifactStatus.Error or ExplorerArtifactStatus.ProjectUnavailable))
        {
            @if (SingleSourceView && corpus.Source(Explorer.ExplorerSource) is { } single)
            {
                <p class="axh-evidence-line" data-testid="artifact-explorer-evidence" data-view="SingleSource">
                    Viewing single source: <strong>@single.Name</strong> · @Count(single.Artifacts)@(single.Association is null ? " · not part of project " + corpus.ProjectName : "")
                </p>
            }
            else if (!SingleSourceView)
            {
                @* The project's corpus, counted once for every Explorer from the manifest: what the project has, not what one package holds. *@
                <p class="axh-evidence-line" data-testid="artifact-explorer-evidence" data-view="Project" data-artifacts="@corpus.Artifacts">
                    <strong>@corpus.ProjectName</strong> · @corpus.Modules module@(corpus.Modules == 1 ? "" : "s") · @Count(corpus.Artifacts) ·
                    @corpus.Contributing.Count contributing source@(corpus.Contributing.Count == 1 ? "" : "s")@(corpus.Occurrences > corpus.Artifacts ? $" · {corpus.Occurrences} occurrences" : "")
                    @if (corpus.Contributing.Count > 0)
                    {
                        <details class="axh-provenance" data-testid="artifact-explorer-corpus-sources">
                            <summary>Sources</summary>
                            <ul>@foreach (var c in corpus.Contributing) { <li>@c.Name — @Count(c.Artifacts) · @AssociationText(c.Association)</li> }</ul>
                        </details>
                    }
                </p>
                @if (corpus.Conflicts > 0)
                {
                    <p class="axh-evidence-line axh-notice" role="status" data-testid="artifact-explorer-corpus-conflicts">
                        Needs review: @corpus.Conflicts @Label artifact@(corpus.Conflicts == 1 ? "" : "s") differ between sources at the same module and path. Both are kept; none is chosen by source order.
                    </p>
                }
                @if (corpus.OutsideDocumentationEvidence && corpus.Artifacts > 0)
                {
                    <p class="axh-evidence-line axh-notice" role="status" data-testid="artifact-explorer-association-notice">
                        Some @PluralLower come from imported sources not currently marked as project documentation evidence.
                        @if (_state.Evidence?.EnvironmentId is { } envId)
                        {
                            <a href="@ProjectEvidenceResolver.ProjectTabHref(envId, ProjectEvidenceRoles.Documentation)" data-testid="artifact-explorer-review-associations">Review source associations</a>
                        }
                    </p>
                }
            }
        }
        switch (_state.Status)
        {
            case ExplorerArtifactStatus.Error:
                <div class="axh-card axh-error" role="alert" data-testid="artifact-explorer-error">
                    <h2 class="axh-title">The @Label artifact could not be loaded</h2>
                    <p class="axh-text">@_state.Error</p>
                    <div class="axh-actions">
                        <button type="button" class="btn-secondary" @onclick="ReloadAsync">Try again</button>
                    </div>
                </div>
                break;

            case ExplorerArtifactStatus.ProjectUnavailable:
                <div class="axh-card" role="status" data-testid="artifact-explorer-project-unavailable">
                    <div class="axh-icon" aria-hidden="true">@Icon</div>
                    <h2 class="axh-title">The selected project is not available</h2>
                    <p class="axh-text">
                        Project <strong>@(_state.ProjectName ?? _state.ProjectSlug)</strong> is no longer among the installed Demo Projects,
                        so its documents cannot be read.
                    </p>
                    <div class="axh-actions">
                        <a class="btn-primary" href="project-import" data-testid="artifact-explorer-import-project">Import Project</a>
                        <a class="btn-secondary axh-link-button" href="demo-projects">Open Demo Projects</a>
                    </div>
                </div>
                break;

            case ExplorerArtifactStatus.Empty when ArtifactState == WorkspaceArtifactState.NoWorkspace:
                @* No project and no document at all: the project ZIP is the way in; a single-role import is the advanced path. *@
                <div class="axh-card axh-empty" role="status" data-testid="artifact-explorer-empty" data-state="NoWorkspace">
                    <div class="axh-icon" aria-hidden="true">@Icon</div>
                    <h2 class="axh-title">No project is currently loaded</h2>
                    <p class="axh-text">Import a project ZIP to discover project artifacts and source evidence automatically.</p>
                    <div class="axh-actions">
                        <a class="btn-primary" href="project-import" data-testid="artifact-explorer-import-project">Import Project</a>
                        <a class="btn-secondary axh-link-button" href="demo-projects" data-testid="artifact-explorer-sample-projects">Open a Demo Project</a>
                        <button type="button" class="axh-link axh-advanced" aria-expanded="@(_importOpen ? "true" : "false")"
                                data-testid="artifact-explorer-import-toggle" @onclick="ToggleImport">
                            Import @Label.ToLowerInvariant() only
                        </button>
                    </div>
                </div>
                break;

            case ExplorerArtifactStatus.Empty when _state.SourceUnresolved:
                @* Target Environment → Project names the project, but its documentation source is not selected: a binding decision, not "no artifact". *@
                <div class="axh-card axh-empty" role="status" data-testid="artifact-explorer-empty" data-state="SourceUnresolved">
                    <div class="axh-icon" aria-hidden="true">@Icon</div>
                    <h2 class="axh-title">@Label source unresolved</h2>
                    <p class="axh-text" data-testid="artifact-explorer-unresolved">
                        The Project documentation role of <strong>@_state.Evidence!.ProjectName</strong> (Target Environment @_state.Evidence.EnvironmentName) has not been bound.
                        @if (_state.Evidence.UnboundDocumentPackages.Count > 0)
                        {
                            <span> Imported packages with project documents: @string.Join(", ", _state.Evidence.UnboundDocumentPackages).</span>
                        }
                    </p>
                    <div class="axh-actions">
                        <a class="btn-primary" href="@ProjectEvidenceResolver.ProjectTabHref(_state.Evidence.EnvironmentId, ProjectEvidenceRoles.Documentation)"
                           data-testid="artifact-explorer-open-project-setup">Open Project setup</a>
                    </div>
                </div>
                break;

            case ExplorerArtifactStatus.Empty when Explorer.ViewMode == ExplorerViewMode.SingleSource && _state.PackSummary is null:
                @* One imported source holds none of this role: normal for infrastructure or shared code, never an error, never "the project has none". *@
                <div class="axh-card axh-empty axh-neutral" role="status" data-testid="artifact-explorer-empty" data-state="NotInSource">
                    <div class="axh-icon" aria-hidden="true">@Icon</div>
                    <h2 class="axh-title">No @PluralLower in @SingleSourceName</h2>
                    <p class="axh-text">This source contains no recognized @Label artifacts.@(SingleSourceRole is { } sourceRole ? $" It is {sourceRole}." : "")</p>
                    @if (Corpus is { Artifacts: > 0 } projectCorpus)
                    {
                        <p class="axh-text" data-testid="artifact-explorer-project-available">Project <strong>@projectCorpus.ProjectName</strong> has @Count(projectCorpus.Artifacts) available in other source@(projectCorpus.Contributing.Count == 1 ? "" : "s").</p>
                    }
                    <div class="axh-actions">
                        @if (Corpus is { Artifacts: > 0 })
                        {
                            <button type="button" class="btn-primary" data-testid="artifact-explorer-view-project-specs" @onclick="ShowProjectView">View project @PluralLower</button>
                        }
                        <a class="btn-secondary axh-link-button" href="@SourceClassificationHref" data-testid="artifact-explorer-review-classification">Review source classification</a>
                    </div>
                    <details class="axh-why"><summary>Why?</summary>
                        <p class="axh-text">Documents are classified by their content in any folder; none in this source was recognised as a @Label artifact. Every artifact role is optional.</p>
                    </details>
                </div>
                break;

            case ExplorerArtifactStatus.Empty when !SingleSourceView && Corpus is { Artifacts: 0 } && _state.Evidence is { FromEnvironment: true } boundEvidence && _state.PackSummary is null:
                @* The project's whole corpus (every associated source) holds none of this role: the one true project-level empty state. *@
                <div class="axh-card axh-empty" role="status" data-testid="artifact-explorer-empty" data-state="NotInProject">
                    <div class="axh-icon" aria-hidden="true">@Icon</div>
                    <h2 class="axh-title">No @PluralLower found for this project</h2>
                    <p class="axh-text" data-testid="artifact-explorer-not-found">
                        No recognized @Label artifacts are currently associated with or available for <strong>@boundEvidence.ProjectName</strong>. Every artifact role is optional.
                    </p>
                    @if (Explorer.SourcesWith(Role) is { Count: > 0 } outside)
                    {
                        <p class="axh-text" data-testid="artifact-explorer-alternative-sources">@Label artifacts exist in imported sources that are not part of this project: <strong>@string.Join(", ", outside.Select(e => e.Label))</strong>.</p>
                    }
                    <div class="axh-actions">
                        <a class="btn-secondary axh-link-button" href="@ProjectEvidenceResolver.ProjectTabHref(boundEvidence.EnvironmentId, ProjectEvidenceRoles.Documentation)"
                           data-testid="artifact-explorer-open-project-setup">Review project evidence</a>
                        <a class="btn-secondary axh-link-button" href="project-import" data-testid="artifact-explorer-import-project">Import source</a>
                        <button type="button" class="btn-secondary" aria-expanded="@(_importOpen ? "true" : "false")"
                                data-testid="artifact-explorer-import-toggle" @onclick="ToggleImport">
                            Import @Label.ToLowerInvariant() only
                        </button>
                    </div>
                </div>
                break;

            case ExplorerArtifactStatus.Empty when _state.PackSummary is { } emptyPack:
                @* The viewed pack has no artifact of this role and nothing shared applies: neutral, and never borrowed from a sibling pack. *@
                <div class="axh-card axh-empty" role="status" data-testid="artifact-explorer-empty" data-state="NotInPack">
                    <div class="axh-icon" aria-hidden="true">@Icon</div>
                    <h2 class="axh-title">No @Label.ToLowerInvariant() is available for this feature</h2>
                    <p class="axh-text">
                        <strong>@emptyPack.DisplayName</strong> <span class="axh-muted">(pack @emptyPack.Pack)</span> has no @Label artifact of its own, and no shared one applies.
                        Other features' documents are never used instead. Choose another feature above, or open the other explorers for this feature's documents.
                    </p>
                </div>
                break;

            case ExplorerArtifactStatus.Empty:
                @* A workspace exists and this role has no artifact in it: neutral, never a failure. *@
                <div class="axh-card axh-empty" role="status" data-testid="artifact-explorer-empty" data-state="RoleUnavailable">
                    <div class="axh-icon" aria-hidden="true">@Icon</div>
                    @if (_state.Evidence is not { FromEnvironment: true } && ProjectImportScope.IsImport(_state.ProjectSlug))
                    {
                        <h2 class="axh-title">No @Label artifact was detected in the selected source: @(_state.ModuleLabel is { } sourceModule ? $"module {sourceModule} of {WorkspaceName}" : WorkspaceName)</h2>
                    }
                    else
                    {
                        <h2 class="axh-title">No @Label artifact was detected in @(_state.ModuleLabel is { } emptyModule ? $"module {emptyModule} of {WorkspaceName}" : WorkspaceName)</h2>
                    }
                    @if (Explorer.SourcesWith(Role) is { Count: > 0 } elsewhere)
                    {
                        @* Never an automatic switch: the tester decides to inspect the source that holds the artifact. *@
                        <div class="axh-alternatives" data-testid="artifact-explorer-alternative-sources">
                            <p class="axh-text">@(Label) artifacts are available in another imported source: <strong>@string.Join(", ", elsewhere.Select(e => e.Label))</strong>.</p>
                            <div class="axh-actions">
                                @foreach (var option in elsewhere.Take(3))
                                {
                                    <button type="button" class="btn-primary" data-testid="artifact-explorer-open-source" data-source="@option.Value" @onclick="() => Explorer.SelectSource(option.Value)">Inspect source @option.Label</button>
                                }
                            </div>
                        </div>
                    }
                    <p class="axh-text">
                        @(Origin == WorkspaceArtifactOrigin.ManualWorkspace
                            ? $"The documents imported into the workspace do not include a {Label} artifact. Every artifact role is optional."
                            : $"None of the project's documents was recognised as a {Label} artifact. Every artifact role is optional.")
                    </p>
                    <div class="axh-actions">
                        @if (Corpus is not { Artifacts: > 0 })
                        {
                            <button type="button" class="btn-secondary" aria-expanded="@(_importOpen ? "true" : "false")"
                                    data-testid="artifact-explorer-import-toggle" @onclick="ToggleImport">
                                Import @Label.ToLowerInvariant() only
                            </button>
                        }
                        @if (WorkspaceArtifactStates.ReviewArtifactsRoute(Origin) is { } review)
                        {
                            <a class="btn-secondary axh-link-button" href="@review" data-testid="artifact-explorer-review-artifacts">Review source classification</a>
                        }
                    </div>
                </div>
                break;

            case ExplorerArtifactStatus.SelectionRequired when _state.ModuleRequired:
                @* Several modules and none focused: the user chooses a module; nothing is picked for the whole project. *@
                <div class="axh-card axh-choose" role="status" data-testid="artifact-explorer-choose-module">
                    <h2 class="axh-title">Choose a module</h2>
                    <p class="axh-text" data-testid="artifact-explorer-module-candidates">
                        @WorkspaceName has @_state.Modules!.Count modules with their own project documents. @_state.Artifacts.Count @Label artifacts were
                        found across them. Choose the module to review: a module with one @Label artifact uses it automatically, a module with
                        several asks you to choose.
                    </p>
                    <ul class="axh-choices">
                        @foreach (var module in _state.Modules!)
                        {
                            <li>
                                <button type="button" class="axh-choice" data-testid="artifact-explorer-module-choice" data-module="@module.Module"
                                        @onclick="() => SelectModuleAsync(module.Module)">
                                    <span class="axh-choice-name">@module.Label</span>
                                    <span class="axh-choice-meta">@ModuleStateText(module)</span>
                                </button>
                            </li>
                        }
                    </ul>
                </div>
                break;

            case ExplorerArtifactStatus.SelectionRequired when _state.PackRequired:
                @* Several feature packs and none viewed: choosing a pack is navigation, not a warning and not an authority decision. *@
                <div class="axh-card axh-choose" role="status" data-testid="artifact-explorer-choose-pack">
                    <h2 class="axh-title">Choose a feature to explore</h2>
                    <p class="axh-text" data-testid="artifact-explorer-pack-candidates">
                        @(_state.ModuleLabel is { } packModule ? $"Module {packModule}" : WorkspaceName) has @_state.Packs!.Count features (feature packs).
                        Each feature keeps its own documents; shared project documents apply to every feature.
                    </p>
                    <ul class="axh-choices axh-packs">
                        @foreach (var pack in _state.Packs!)
                        {
                            <li>
                                <button type="button" class="axh-choice" data-testid="artifact-explorer-pack-choice" data-pack="@pack.Pack"
                                        @onclick="() => SelectPackAsync(pack.Pack)">
                                    <span class="axh-choice-name">@pack.DisplayName</span>
                                    <span class="axh-choice-meta">@(pack.FeatureId is { } fid ? $"Feature {fid} · " : "")pack @pack.Pack · @pack.Artifacts @(pack.Artifacts == 1 ? "document" : "documents")</span>
                                    <span class="axh-badges">
                                        @foreach (var role in pack.RolesPresent)
                                        {
                                            <span class="axh-badge">@BadgeLabel(role)</span>
                                        }
                                    </span>
                                </button>
                            </li>
                        }
                    </ul>
                </div>
                break;

            case ExplorerArtifactStatus.SelectionRequired:
                <div class="axh-card axh-choose" role="status" data-testid="artifact-explorer-choose">
                    <h2 class="axh-title">Choose a @Label artifact</h2>
                    <p class="axh-text" data-testid="artifact-explorer-candidates">
                        @if (_state.AmbiguousInPack && _state.PackSummary is { } ambiguousPack)
                        {
                            @($"{_state.Artifacts.Count} {Label} artifacts were found in pack {ambiguousPack.DisplayName} ({ambiguousPack.Pack}). One pack normally has one {Label} artifact, so BirkNext does not pick one. Choose the {Label} artifact this pack uses.")
                        }
                        else
                        {
                            @($"{_state.Artifacts.Count} candidate {Label} artifacts were discovered in {ScopeLabel}. No current {Label} artifact is selected and none is marked authoritative, so BirkNext does not pick one. Choose the {Label} artifact to explore.")
                        }
                    </p>
                    <ul class="axh-choices">
                        @foreach (var artifact in _state.Artifacts)
                        {
                            <li>
                                <button type="button" class="axh-choice" data-testid="artifact-explorer-choice"
                                        data-birknext-document-id="@artifact.DocumentIdentity"
                                        @onclick="() => SelectAsync(artifact.Id)">
                                    <span class="axh-choice-name">@artifact.DisplayName</span>
                                    <span class="axh-choice-meta">@MetaLine(artifact)@(artifact.Feature is { } feature ? $" · feature {feature}" : "")</span>
                                    <span class="axh-badges">@Badges(artifact)</span>
                                </button>
                            </li>
                        }
                    </ul>
                    <div class="axh-actions">
                        <button type="button" class="btn-secondary" aria-expanded="@(_importOpen ? "true" : "false")"
                                data-testid="artifact-explorer-import-toggle" @onclick="ToggleImport">
                            Import @Label.ToLowerInvariant() only
                        </button>
                    </div>
                </div>
                break;

            case ExplorerArtifactStatus.Loaded:
                var selected = _state.Selected!;
                var others = _state.Artifacts.Count - 1;
                @* Tester view first: what this document is (feature title), where it belongs (module · feature), that it is the primary document.
                   Provenance (file, path, source, revision, scope), the document switch and manual import are under Details. *@
                <div class="axh-context" data-testid="artifact-explorer-context">
                    <div class="axh-context-main">
                        <div class="axh-context-heading">
                            <span class="axh-role"><span aria-hidden="true">@Icon</span> @Label</span>
                            <strong class="axh-name" data-testid="artifact-explorer-name">@selected.DisplayName</strong>
                        </div>
                        <p class="axh-context-line" data-testid="artifact-explorer-summary">@ContextLine(selected)</p>
                        <span class="axh-badges">@ReasonBadge
                            @if (AvailabilityText is { } availability)
                            {
                                <span class="axh-badge" data-testid="artifact-explorer-availability">@availability</span>
                            }
                            else if (others > 0)
                            {
                                <span class="axh-badge" data-testid="artifact-explorer-supporting">@OthersText(others)</span>
                            }
                        </span>
                    </div>
                    <details class="axh-details" data-testid="artifact-explorer-details">
                        <summary>Details<span class="visually-hidden"> of the @Label document</span></summary>
                        <dl class="axh-meta">
                            @if (_state.HasProject)
                            {
                                <div><dt>Project</dt><dd data-testid="artifact-explorer-project">@WorkspaceName</dd></div>
                            }
                            @if (_state.ModuleLabel is { } moduleLabel)
                            {
                                <div><dt>Module</dt><dd data-testid="artifact-explorer-module">@moduleLabel</dd></div>
                            }
                            @if (_state.PackSummary is { } viewedPack)
                            {
                                <div><dt>Pack</dt><dd data-testid="artifact-explorer-pack">@viewedPack.DisplayName@(viewedPack.DisplayName != viewedPack.Pack ? $" ({viewedPack.Pack})" : "")</dd></div>
                                <div><dt>Scope</dt><dd data-testid="artifact-explorer-scope">@ArtifactPacks.ScopeLabel(selected)</dd></div>
                            }
                            <div><dt>File</dt><dd data-testid="artifact-explorer-file">@selected.FileName</dd></div>
                            @if (!string.IsNullOrWhiteSpace(selected.SourcePath) && selected.SourcePath != selected.FileName)
                            {
                                <div><dt>Path</dt><dd data-testid="artifact-explorer-path">@selected.SourcePath</dd></div>
                            }
                            <div><dt>Source</dt><dd data-testid="artifact-explorer-source">@SourceText(selected)</dd></div>
                            @if (selected.EvidenceSource is { } evidenceSource)
                            {
                                <div><dt>Project source</dt><dd data-testid="artifact-explorer-evidence-source">@evidenceSource</dd></div>
                                @if (selected.EvidenceImportedAt is { } importedAt)
                                {
                                    <div><dt>Imported</dt><dd>@importedAt.ToLocalTime().ToString("d MMM yyyy")</dd></div>
                                }
                            }
                            @if (selected.Revision is { } revision)
                            {
                                <div><dt>Revision</dt><dd>@revision@(selected.RevisionCount > 1 ? $" of {selected.RevisionCount}" : "")</dd></div>
                            }
                            @if (_state.Resolution is { } resolution)
                            {
                                <div><dt>Resolution</dt><dd>@resolution</dd></div>
                            }
                        </dl>
                        <span class="axh-badges">@Badges(selected)@TechnicalReasonBadge</span>
                        <div class="axh-context-actions">
                            @if (_state.Artifacts.Count > 1)
                            {
                                <label class="axh-select-label" for="@($"{_id}-select")">@_state.Artifacts.Count @Label artifacts@(_state.PackSummary is { } p ? $" for this feature" : _state.ModuleLabel is { } m ? $" in {m}" : "")</label>
                                <select id="@($"{_id}-select")" class="axh-select" data-testid="artifact-explorer-selector"
                                        value="@selected.Id" @onchange="OnSelectorChanged">
                                    @foreach (var artifact in _state.Artifacts)
                                    {
                                        <option value="@artifact.Id"
                                                data-birknext-document-id="@artifact.DocumentIdentity">@OptionText(artifact)</option>
                                    }
                                </select>
                            }
                            <button type="button" class="btn-secondary btn-small" aria-expanded="@(_importOpen ? "true" : "false")"
                                    data-testid="artifact-explorer-import-toggle" @onclick="ToggleImport">
                                Add a @Label.ToLowerInvariant() manually
                            </button>
                        </div>
                    </details>
                </div>
                break;
        }

        @if (_saveWarning is not null)
        {
            <p class="axh-notice" role="alert" data-testid="artifact-explorer-save-warning">@_saveWarning</p>
        }

        @if (_suggestedRole is { } suggested)
        {
            <p class="axh-notice" role="status" data-testid="artifact-explorer-role-warning">
                The imported document looks like a @ArtifactExplorerRoles.Label(suggested) artifact. It was added as a @Label artifact
                as you chose; import it in the @ArtifactExplorerRoles.Label(suggested) explorer if that was not intended.
            </p>
        }

        @if (_importOpen && _state.Status is not (ExplorerArtifactStatus.Error or ExplorerArtifactStatus.ProjectUnavailable))
        {
            <ArtifactImportPanel Role="Role" WorkspaceLabel="@WorkspaceLabel" OnImported="OnImportedAsync" OnCancel="ToggleImport" />
        }

        @if (_state.Status == ExplorerArtifactStatus.Loaded && ChildContent is not null)
        {
            @ChildContent(_state)
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public WorkspaceArtifactType Role { get; set; }
    /// <summary>The explorer's content for the loaded artifact.</summary>
    [Parameter] public RenderFragment<ArtifactExplorerState>? ChildContent { get; set; }
    /// <summary>Raised after every load, so the page can (re)build its analysis or clear it.</summary>
    [Parameter] public EventCallback<ArtifactExplorerState> OnStateChanged { get; set; }
    /// <summary>What the page found available for this feature (e.g. "Feature model + shared model available"); replaces the generic
    /// "N other documents" badge when the other document is a layer of the same view, not a competing artifact. Details still list them.</summary>
    [Parameter] public string? AvailabilityText { get; set; }

    private readonly string _id = "axh-" + Guid.NewGuid().ToString("N")[..8];
    private ArtifactExplorerState? _state;
    private string? _loadedScope;
    private bool _importOpen;
    private WorkspaceArtifactType? _suggestedRole;
    private string? _saveWarning;
    private int _loadVersion;
    private bool _disposed;

    private string Label => ArtifactExplorerRoles.Label(Role);
    /// <summary>The role as a tester names one document of it: "specification", "plan", "task list", "data model".</summary>
    private string Noun => Role == WorkspaceArtifactType.Tasks ? "task list" : Label.ToLowerInvariant();
    private string Icon => ArtifactExplorerRoles.Icon(Role);
    private string StatusKey => _state is null ? "Loading" : _state.Status.ToString();
    // Same canonical content fingerprint used by every role parser. This is an opaque identity, not source text or path.
    private string? DocumentIdentity => _state is { Status: ExplorerArtifactStatus.Loaded, Content: { } content }
        ? MarkdownTokenizer.DocumentFingerprint(content)
        : null;
    private string WorkspaceLabel => _state?.HasProject == true ? $"project {_state.ProjectName ?? _state.ProjectSlug}" : "the current workspace";
    private string WorkspaceName => _state?.HasProject == true ? (_state.ProjectName ?? _state.ProjectSlug)! : "the current workspace";
    private string ScopeLabel => _state?.ModuleLabel is { } module ? $"module {module} of {WorkspaceLabel}" : WorkspaceLabel;
    /// <summary>Whether the manual workspace holds any artifact (decides "no project loaded" vs "this role has none" without a project).</summary>
    private bool _workspaceHasArtifacts;
    private WorkspaceArtifactState ArtifactState => _state is null ? WorkspaceArtifactState.NoWorkspace : WorkspaceArtifactStates.Of(_state, _workspaceHasArtifacts);
    private WorkspaceArtifactOrigin Origin => WorkspaceArtifactStates.OriginOf(_state?.ProjectSlug, _workspaceHasArtifacts);

    protected override async Task OnInitializedAsync()
    {
        Explorer.Changed += OnExplorerChanged;
        // Deep links: ?view=project returns to Project view; ?source=<import id> (e.g. from Recommended Workflow) opens that single source, validated
        // against this workspace. A saved single source that is no longer imported falls back to Project view and says so.
        if (Services.GetService(typeof(NavigationManager)) is NavigationManager navigation)
        {
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(navigation.Uri).Query);
            if (query.TryGetValue("view", out var view) && view.ToString() == "project") Explorer.SelectSource(null);
            else if (query.TryGetValue("source", out var requested) && requested.ToString() is { Length: > 0 } source && Explorer.Sources.Any(o => o.Value == source))
                Explorer.SelectSource(source);
        }
        if (Explorer.ExplorerSourceUnavailable) { _sourceRemoved = true; Explorer.SelectSource(null); }
        await LoadAsync();
    }

    /// <summary>A view choice only matters with several imported sources, and never over a selected Demo Project (built-in demos stay a separate category).</summary>
    private bool ShowSourceBar => Explorer.Sources.Count >= 2 && (_state?.ProjectSlug is null || ProjectImportScope.IsImport(_state.ProjectSlug));

    /// <summary>Single source view: a source is chosen, or the person switched to Single source and has not chosen one yet.</summary>
    private bool SingleSourceView => Explorer.ViewMode == ExplorerViewMode.SingleSource || _choosingSource;
    private bool _choosingSource, _sourceRemoved;

    private ExplorerCorpusSummary? Corpus => Explorer.GetCorpusSummary(Role);

    private string ViewNote => SingleSourceView
        ? "Single source shows one imported source for provenance and inspection; this choice is kept for every Explorer until you return to Project view."
        : Corpus is { } corpus ? $"Project view combines the {PluralLower} of {corpus.ProjectName}. Use Single source to inspect one imported source."
        : "Project view shows the project's documents. Use Single source to inspect one imported source.";

    private string PluralLower => Label.ToLowerInvariant() + "s";

    /// <summary>"38 Specification artifacts": the one counting word for a role across the Explorer (artifact = the domain item; document = its file).</summary>
    private string Count(int artifacts) => $"{artifacts} {Label} artifact{(artifacts == 1 ? "" : "s")}";

    private string SourceCountText(string importId) => Corpus?.Source(importId) is { } c ? $" — {Count(c.Artifacts)}" : "";

    private string SingleSourceName => Corpus?.Source(Explorer.ExplorerSource)?.Name ?? Explorer.Sources.FirstOrDefault(o => o.Value == Explorer.ExplorerSource)?.Label ?? "this source";

    /// <summary>How the single source relates to the project, so an empty source reads as normal (e.g. an infrastructure package).</summary>
    private string? SingleSourceRole => Corpus?.Source(Explorer.ExplorerSource) is { } c
        ? c.Association is null ? $"not part of project {Corpus.ProjectName}" : $"a {AssociationText(c.Association).ToLowerInvariant()} of {Corpus.ProjectName}" : null;

    private static string AssociationText(ExplorerSourceAssociation? association) => association switch
    {
        ExplorerSourceAssociation.Documentation => "Project documentation evidence",
        ExplorerSourceAssociation.MainProject => "Main project package",
        ExplorerSourceAssociation.ProjectRole => "Project evidence source (another role)",
        ExplorerSourceAssociation.SameApplication => "Source imported for the same application",
        _ => "Not part of the project",
    };

    /// <summary>The selected source in Project setup (its evidence roles), where its classification is reviewed.</summary>
    private string SourceClassificationHref => _state?.Evidence?.EnvironmentId is { } env ? ProjectEvidenceResolver.ProjectTabHref(env) : "project-import";

    private void ShowProjectView() { _choosingSource = false; _sourceRemoved = false; Explorer.SelectSource(null); StateHasChanged(); }

    private void ShowSingleSourceView() { _choosingSource = true; StateHasChanged(); }

    private void OnSourceChanged(ChangeEventArgs e)
    {
        if (e.Value?.ToString() is not { Length: > 0 } source) return;
        _choosingSource = false;
        _sourceRemoved = false;
        Explorer.SelectSource(source);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A project switch can happen without a repository event (for example a restored selection); re-read when the
        // scope differs from the loaded one. This runs on render only; there is no polling.
        if (!firstRender && _state is not null && !string.Equals(Explorer.CurrentScope, _loadedScope, StringComparison.Ordinal))
        {
            await LoadAsync();
            StateHasChanged();
        }
    }

    private void OnExplorerChanged(object? sender, EventArgs e)
    {
        if (_disposed) return;
        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private async Task ReloadAsync()
    {
        _state = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var version = ++_loadVersion;
        var scope = Explorer.CurrentScope;
        // Another project: show loading rather than the previous project's artifact while its documents are read.
        if (_state is not null && !string.Equals(scope, _loadedScope, StringComparison.Ordinal))
        {
            _state = null;
            _suggestedRole = null;
        }
        ArtifactExplorerState state;
        try
        {
            state = await Explorer.GetStateAsync(Role);
        }
        catch (Exception ex)
        {
            state = new ArtifactExplorerState(Role, ExplorerArtifactStatus.Error, scope, null, [], Error: ex.Message);
        }
        var workspaceHasArtifacts = state.Artifacts.Count > 0 || state.HasProject;
        if (!workspaceHasArtifacts && state.Status == ExplorerArtifactStatus.Empty)
        {
            try { workspaceHasArtifacts = await WorkspaceArtifactStates.ManualWorkspaceHasArtifactsAsync(Explorer); }
            catch (Exception) { workspaceHasArtifacts = false; }
        }
        if (version != _loadVersion || _disposed) return;
        _workspaceHasArtifacts = workspaceHasArtifacts;
        _state = state;
        _loadedScope = scope;
        await OnStateChanged.InvokeAsync(state);
    }

    private void ToggleImport() => _importOpen = !_importOpen;

    private async Task OnImportedAsync(ArtifactImportResult result)
    {
        _importOpen = false;
        _suggestedRole = result.SuggestedRole;
        await PersistAsync();
        await LoadAsync();
    }

    /// <summary>Imports pasted text from an explorer panel's own input, exactly like the import panel.</summary>
    public async Task ImportPastedAsync(string text)
    {
        var result = Explorer.Import(new ArtifactImportRequest(Role, text, null, "Paste"));
        if (result.IsSuccess) await OnImportedAsync(result);
        StateHasChanged();
    }

    /// <summary>
    /// Saves the workspace now. Auto-save only runs where a page owns it, so explorer imports and selections are saved
    /// explicitly. A failed save is reported, never hidden: the change then lasts for this session only.
    /// </summary>
    private async Task PersistAsync()
    {
        if (Services.GetService(typeof(IWorkspaceAutoSaveService)) is not IWorkspaceAutoSaveService autoSave) return;
        _saveWarning = await autoSave.SaveNowAsync()
            ? null
            : "The change is shown in this session but could not be saved to the workspace, so it will be lost on reload. Check that the BirkNext backend is running.";
    }

    private async Task OnSelectorChanged(ChangeEventArgs e)
    {
        if (e.Value?.ToString() is { Length: > 0 } id) await SelectAsync(id);
    }

    private async Task OnModuleChanged(ChangeEventArgs e)
    {
        if (e.Value?.ToString() is { } module) await SelectModuleAsync(module);
    }

    private async Task SelectModuleAsync(string module)
    {
        _suggestedRole = null;
        await Explorer.SelectModuleAsync(module);
        await PersistAsync();
        await LoadAsync();
    }

    private async Task OnPackChanged(ChangeEventArgs e)
    {
        if (e.Value?.ToString() is { Length: > 0 } pack) await SelectPackAsync(pack);
    }

    private async Task SelectPackAsync(string pack)
    {
        _suggestedRole = null;
        await Explorer.SelectPackAsync(pack, _state?.Module);
        await PersistAsync();
        await LoadAsync();
    }

    private static string PackOptionText(ArtifactPackSummary pack) =>
        pack.DisplayName == pack.Pack ? $"{pack.Pack} · {pack.Artifacts} documents" : $"{pack.DisplayName} ({pack.Pack}) · {pack.Artifacts} documents";

    /// <summary>Badge text for a role on a feature card: "Tasks" (a list), "Research" explained as supporting analysis.</summary>
    private static string BadgeLabel(WorkspaceArtifactType role) => role switch
    {
        WorkspaceArtifactType.Tasks => "Tasks",
        WorkspaceArtifactType.Research => "Research (supporting)",
        _ => ArtifactExplorerRoles.Label(role),
    };

    /// <summary>"Person · Feature 002 · Missing Parent Failure Code": module, feature number and feature title — no file or path.</summary>
    private string ContextLine(ExplorerArtifact selected)
    {
        var parts = new List<string>();
        if (_state?.ModuleLabel is { } module) parts.Add(module);
        else if (_state?.HasProject == true) parts.Add(WorkspaceName);
        if (_state?.PackSummary is { } pack)
        {
            if (pack.FeatureId is { } id) parts.Add($"Feature {id}");
            if (pack.DisplayName != pack.Pack && pack.DisplayName != ArtifactPacks.PackTitle(selected.DisplayName)
                && !selected.DisplayName.Contains(pack.DisplayName, StringComparison.OrdinalIgnoreCase)) parts.Add(pack.DisplayName);
        }
        return string.Join(" · ", parts);
    }

    /// <summary>Other documents of the role this feature can read: Spec-Kit supporting documents, or shared/other ones — never "competing".</summary>
    private string OthersText(int others)
    {
        var noun = Role == WorkspaceArtifactType.Tasks ? "task" : Label.ToLowerInvariant();
        return _state?.Reason == ExplorerSelectionReason.PackFile
            ? $"{others} supporting {noun} document{(others == 1 ? "" : "s")}"
            : $"{others} other {noun} document{(others == 1 ? "" : "s")} available";
    }

    private string ModuleOptionText(ArtifactModuleRoleState module) => $"{module.Label} — {ModuleStateText(module)}";

    private string ModuleStateText(ArtifactModuleRoleState module) => module switch
    {
        { Candidates: 0 } => $"no {Label} artifact",
        { Packs: > 1, AmbiguousInPack: true } => $"{module.Packs} features · a feature requires clarification",
        { Packs: > 1 } => $"{module.Packs} features · {module.Candidates} {Label} artifact{(module.Candidates == 1 ? "" : "s")}",
        { SelectedId: not null, Candidates: 1 } => $"1 {Label} artifact",
        { SelectedId: not null } => $"{module.Candidates} {Label} artifacts · selected",
        _ => $"{module.Candidates} {Label} artifacts · needs selection",
    };

    private async Task SelectAsync(string id)
    {
        _suggestedRole = null;
        Explorer.Select(Role, id);
        await PersistAsync();
        await LoadAsync();
    }

    private string SourceText(ExplorerArtifact artifact) => artifact.Source switch
    {
        ExplorerArtifactSource.SampleProject => $"Demo Project {_state?.ProjectName ?? _state?.ProjectSlug}",
        _ => (artifact.Origin switch { "File" => "Imported file", "Drop" => "Dropped file", "Paste" => "Pasted text", _ => "Workspace" })
             + (_state?.HasProject == true ? $" in project {_state.ProjectName ?? _state.ProjectSlug}" : " in the manual workspace"),
    };

    private static string MetaLine(ExplorerArtifact artifact) =>
        string.IsNullOrWhiteSpace(artifact.SourcePath) || artifact.SourcePath == artifact.FileName ? artifact.FileName : artifact.SourcePath;

    private static string OptionText(ExplorerArtifact artifact)
    {
        var text = artifact.DisplayName == artifact.FileName ? artifact.FileName : $"{artifact.DisplayName} ({MetaLine(artifact)})";
        if (artifact.IsAuthoritative) text += $" · {artifact.Authority}";
        if (artifact.Currentness != ExplorerArtifactCurrentness.Current) text += $" · {artifact.Currentness}";
        // Several bound packages: every candidate keeps its package as provenance, so the same role from two sources is a visible choice.
        if (artifact.EvidenceSource is { } source) text += $" · {source}";
        return text;
    }

    private RenderFragment Badges(ExplorerArtifact artifact) => __builder =>
    {
        <span class="axh-badge axh-badge-source">@(artifact.Source == ExplorerArtifactSource.SampleProject ? "Demo Project" : "Imported")</span>
        if (artifact.IsAuthoritative)
        {
            <span class="axh-badge axh-badge-authority" data-testid="artifact-explorer-authoritative">Authoritative · @artifact.Authority</span>
        }
        else if (artifact.Authority is not ("Unknown" or ""))
        {
            <span class="axh-badge">@artifact.Authority</span>
        }
        if (artifact.Currentness != ExplorerArtifactCurrentness.Current)
        {
            <span class="axh-badge axh-badge-stale" data-testid="artifact-explorer-currentness">@artifact.Currentness</span>
        }
    };

    private RenderFragment ReasonBadge => __builder =>
    {
        var text = _state?.Reason switch
        {
            ExplorerSelectionReason.SharedArtifact => $"Shared {Noun} — this feature has none of its own",
            ExplorerSelectionReason.Explicit => $"{Label} chosen for this feature",
            null => null,
            _ => $"Primary {Noun}",
        };
        if (text is not null)
        {
            <span class="axh-badge axh-badge-reason" data-testid="artifact-explorer-primary">@text</span>
        }
    };

    private RenderFragment TechnicalReasonBadge => __builder =>
    {
        var text = _state?.Reason switch
        {
            ExplorerSelectionReason.Explicit => "Selected",
            ExplorerSelectionReason.Authoritative => "Opened because it is authoritative",
            ExplorerSelectionReason.OnlyArtifact => "Only artifact",
            ExplorerSelectionReason.PackArtifact => "This pack's artifact",
            ExplorerSelectionReason.SharedArtifact => "Shared artifact — this pack has none of its own",
            ExplorerSelectionReason.PackFile => _state?.PackSummary is not null ? $"This pack's {Label} file — other candidates in the pack are listed" : $"Spec-Kit {Label} file — other candidates are listed",
            _ => null,
        };
        if (text is not null)
        {
            <span class="axh-badge axh-badge-reason" data-testid="artifact-explorer-reason">@text</span>
        }
    };

    public void Dispose()
    {
        _disposed = true;
        Explorer.Changed -= OnExplorerChanged;
    }
}
