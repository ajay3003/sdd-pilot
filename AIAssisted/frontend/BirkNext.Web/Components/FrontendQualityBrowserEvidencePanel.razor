@using BirkNext.Web.Services

@* Browser evidence for the review, loaded by FQR itself (never by visiting Browser Discovery): which pages, live vs historical, which evidence
   kinds, what is limited. Historical evidence is usable with a limitation; only "Require live evidence" makes it insufficient. *@
<section class="fqr-card fbe" aria-labelledby="fbe-h" data-testid="fqr-evidence-summary">
    <h2 id="fbe-h">Pages and evidence</h2>
    @if (!Loaded)
    {
        <p class="fqr-muted" role="status" aria-live="polite" data-testid="fqr-browser-evidence-loading">Loading browser evidence…</p>
    }
    else if (Error is not null)
    {
        <p class="fqr-muted" role="status" data-testid="fqr-browser-evidence-error">@Error</p>
    }
    else if (Evidence is not { Pages.Count: > 0 } e)
    {
        <p class="fqr-muted" data-testid="fqr-browser-evidence-none">No browser evidence for this Target Environment yet. Captured pages appear here; capture them in
            <a href="@BrowserDiscoveryHref">Browser Discovery</a>; engines that need it are reported as not assessed, never as passed.</p>
    }
    else
    {
        <dl class="fqr-technical-list-grid fbe-counts" data-testid="fqr-browser-evidence-counts">
            <div><dt>Pages</dt><dd data-testid="fbe-pages">@e.Pages.Count</dd></div>
            <div><dt>Live pages</dt><dd data-testid="fbe-live">@e.LivePages</dd></div>
            <div><dt>Historical pages</dt><dd data-testid="fbe-historical">@e.HistoricalPages</dd></div>
            <div><dt>DOM evidence</dt><dd>@e.DomPages/@e.Pages.Count</dd></div>
            <div><dt>Accessibility evidence</dt><dd>@e.AccessibilityPages/@e.Pages.Count</dd></div>
            <div><dt>Performance evidence</dt><dd>@e.PerformancePages/@e.Pages.Count</dd></div>
        </dl>
        <p class="fqr-muted fbe-access" data-testid="fqr-browser-evidence-access">
            <strong>Access:</strong> observed in your own browser session — BirkNext performed no sign-in, and whether these pages required sign-in was not recorded.
            <strong>Attended authentication:</strong> @AttendedConfiguration — not exercised by this browser evidence.
        </p>
        @if (e.Limitations.Count > 0)
        {
            <ul class="fqr-list fbe-limitations" data-testid="fqr-browser-evidence-limitations">@foreach (var l in e.Limitations) { <li>@l</li> }</ul>
        }
        <ol class="fbe-pages" data-testid="fqr-browser-evidence-pages">
            @foreach (var p in e.Pages)
            {
                <li class="fbe-page fbe-page-@p.Freshness.ToString().ToLowerInvariant()" data-testid="fqr-evidence-page" data-live="@(p.Live ? "true" : "false")" data-freshness="@p.Freshness">
                    <code>@p.Route</code>
                    <span class="fbe-badge" data-testid="fqr-evidence-badge">@FrontendBrowserEvidences.FreshnessLabel(p)@(p.Live ? " · strongest runtime evidence" : p.Freshness == PageEvidenceFreshness.Stale ? "" : " · not revalidated in current session")</span>
                    <span class="fqr-muted">@string.Join(" · ", new[] { p.Dom ? "DOM" : null, p.Accessibility ? "accessibility" : null, p.Performance ? "performance" : null }.Where(x => x is not null))</span>
                </li>
            }
        </ol>
        <label class="fbe-require-live" data-testid="fqr-require-live">
            <input type="checkbox" checked="@RequireLive" @onchange="e2 => RequireLiveChanged.InvokeAsync(e2.Value is true)" data-testid="fqr-require-live-input" />
            Require live evidence (current-runtime review) — historical pages then block the run instead of being a limitation
        </label>
        @if (RequireLive && e.LiveRequiredBlocker is { } blocker) { <p class="fqr-run-reason" role="alert" data-testid="fqr-require-live-blocker">@blocker</p> }
    }
</section>

@code {
    [Parameter] public bool Loaded { get; set; }
    [Parameter] public FrontendBrowserEvidence? Evidence { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool RequireLive { get; set; }
    [Parameter] public EventCallback<bool> RequireLiveChanged { get; set; }
    /// <summary>"Configured (attended)" / "Not configured" — from the Target Environment, never from the evidence.</summary>
    [Parameter] public string AttendedConfiguration { get; set; } = "Not configured";
    [Parameter] public string BrowserDiscoveryHref { get; set; } = "/admin/system-settings?section=target-environments&tab=browser";
}
