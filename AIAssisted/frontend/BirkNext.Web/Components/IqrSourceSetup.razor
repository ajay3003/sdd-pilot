@using BirkNext.Integrations
@using BirkNext.Web.Services
@using Microsoft.Extensions.DependencyInjection
@inject IIntegrationCatalogApiService Api
@inject IServiceProvider Services

@* Integration Quality Review's source evidence: one Source Analysis snapshot bound per integration (exact id, chosen here, never the latest
   one automatically). Source upload belongs to Source Analysis; runtime integration evidence never needs a snapshot. *@
<section class="iqr-source-setup" aria-labelledby="@(ShowHeading ? "iqr-source-heading" : null)" aria-label="@(ShowHeading ? null : "Source evidence setup")" data-testid="iqr-source-setup">
    @if (ShowHeading) { <h2 id="iqr-source-heading">Source evidence</h2> }
    <p>Source evidence comes from snapshots managed by Source Analysis: choose the snapshot that holds an integration's implementation. The review keeps the evidence it used, so history does not depend on the snapshot later. Runtime evidence is configured separately.</p>
    <label for="iqr-source-integration">Integration</label>
    <select id="iqr-source-integration" value="@_integrationId" @onchange="IntegrationChangedAsync" disabled="@_busy"><option value="">Select an integration</option>@foreach (var integration in Integrations.Where(i => i.Enabled)) { <option value="@integration.Id">@integration.DisplayName</option> }</select>
    @if (_integrationId.Length > 0)
    {
        var state = StateFor(_integrationId);
        <SourceEvidencePrerequisite State="state" Prefix="iqr" SourceAnalysisEnabled="@(Services.GetService<FeatureVisibilityService>()?.SourceAnalysis ?? true)" ConsumerName="Integration Quality Review"
                                    ShowStatusLine="true" ReturnTo="integration-quality-review" LoadError="@_error"
                                    OtherSectionsNote="Configuration, connectivity and other runtime evidence of this integration do not need a source snapshot.">
            <SourceSnapshotSelector @ref="_selector" State="state" Prefix="iqr" Busy="_busy" Label="Source snapshot for this integration" OnPrimaryChanged="PrimaryChangedAsync" />
            <ReviewSourceScopePanel State="state" Prefix="iqr" Busy="_busy" SupportsRelated="false" EvidenceLabel="Integration source evidence" OnChangeSnapshot="FocusAsync" />
        </SourceEvidencePrerequisite>
        @if (state.PrimaryId is { } id && Snapshots.FirstOrDefault(s => s.Id == id) is { } selected) { <IqrSourceDetails Snapshot="selected" /> }
    }
</section>

@code {
    [Parameter] public string EnvironmentId { get; set; } = "";
    [Parameter] public IReadOnlyList<IntegrationDefinition> Integrations { get; set; } = [];
    [Parameter] public IReadOnlyList<IqrSourceSnapshot> Snapshots { get; set; } = [];
    [Parameter] public List<IqrSourceSelection> Selections { get; set; } = [];
    [Parameter] public EventCallback Analyzed { get; set; }
    [Parameter] public EventCallback<bool> BusyChanged { get; set; }
    /// <summary>False when a surrounding summary card already carries the "Source evidence" heading.</summary>
    [Parameter] public bool ShowHeading { get; set; } = true;
    private string _integrationId = "";
    private bool _busy;
    private string? _error;
    private SourceSnapshotSelector? _selector;
    private readonly Dictionary<string, ReviewSourceScopeState> _states = new(StringComparer.Ordinal);

    private ReviewSourceScopeState StateFor(string integrationId)
    {
        if (!_states.TryGetValue(integrationId, out var state))
        {
            _states[integrationId] = state = new ReviewSourceScopeState();
            if (Selections.FirstOrDefault(s => s.IntegrationId == integrationId) is { } chosen) state.PickPrimary(chosen.SnapshotId);
        }
        return state;
    }

    private async Task IntegrationChangedAsync(ChangeEventArgs e)
    {
        _integrationId = e.Value?.ToString() ?? "";
        if (_integrationId.Length > 0) await LoadAsync(StateFor(_integrationId));
    }

    private async Task LoadAsync(ReviewSourceScopeState state)
    {
        _busy = true;
        await BusyChanged.InvokeAsync(true);
        try { state.Options = await Api.IqrSourceScopeAsync(EnvironmentId, state.PrimaryId); _error = null; }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException) { _error = "Source Analysis snapshots could not be loaded (backend not reachable)."; }
        finally { _busy = false; await BusyChanged.InvokeAsync(false); }
    }

    private async Task PrimaryChangedAsync(Guid? id)
    {
        Selections.RemoveAll(s => s.IntegrationId == _integrationId);
        if (id is { } chosen) Selections.Add(new(_integrationId, chosen));
        await LoadAsync(StateFor(_integrationId));
        await Analyzed.InvokeAsync();
    }

    private async Task FocusAsync() { if (_selector is not null) await _selector.FocusAsync(); }
}
