@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using Microsoft.JSInterop
@inject IEndpointDiscoveryService Discovery
@inject IJSRuntime JS

<div class="wcag-workspace">
    <WcagCoverage @key="Snapshot.Wcag.ProfileId" Assessment="Assessment" Review="OpenReview">
        <ProfileSelector>
            <div class="wcag-profile">
                <label for="@_profileSelectId">Assessment profile</label>
                <select id="@_profileSelectId" class="form-select" data-testid="wcag-profile" @bind:get="Snapshot.Wcag.ProfileId" @bind:set="ChangeProfile">
                    @if (Snapshot.Wcag.ProfileId.StartsWith("legacy-")) { <option value="@Snapshot.Wcag.ProfileId">@Snapshot.Wcag.Profile.Label</option> }
                    @foreach (var profile in WcagProfiles.Available) { <option value="@profile.ProfileId">@profile.Label</option> }
                </select>
            </div>
        </ProfileSelector>
    </WcagCoverage>
    @if (_editing is { } row)
    {
        <section class="wcag-editor" aria-label="Manual WCAG review">
            <h4>Review @row.Definition.CriterionId · @row.Definition.Title</h4>
            <p>@row.Page · Generation @row.Generation. Enter review observations only; omit personal data and credentials.</p>
            <label>Decision <select @bind="_decision"><option value="Pass">Pass</option><option value="Fail">Fail</option><option value="NotApplicable">Not applicable</option></select></label>
            <label>Comment <textarea @bind="_comment" maxlength="1000"></textarea></label>
            <label>Evidence note <textarea @bind="_evidence" maxlength="1000" required></textarea></label>
            <label>Reviewed by (tester alias) <input @bind="_reviewer" maxlength="100" required /></label>
            <PrimaryButton OnClick="SaveReview">Save review</PrimaryButton><SecondaryButton OnClick="() => _editing = null">Cancel</SecondaryButton>
        </section>
    }
    @if (_error is not null) { <p role="alert">@_error</p> }
</div>

@code {
    [Parameter, EditorRequired] public string ProfileId { get; set; } = "";
    // One authoritative snapshot for configuration, selector, criteria, results and review generation.
    [Parameter, EditorRequired] public EndpointDiscoverySnapshot Snapshot { get; set; } = new();
    private WcagAssessment Assessment => BrowserQualityAssessmentService.ForPage(BrowserQualityAssessmentService.Assess(Snapshot), Page);
    [Parameter] public PageAnalysis? Page { get; set; }
    private WcagCriterionResult? _editing;
    private readonly string _profileSelectId = $"wcag-profile-{Guid.NewGuid():N}";
    private WcagVersion _reviewVersion;
    private string? _reviewProfileId;
    private string _scope = "", _comment = "", _evidence = "", _reviewer = "";
    private string? _error;
    private WcagStatus _decision = WcagStatus.Pass;
    private void OpenReview(WcagCriterionResult result)
    {
        _editing = result; _reviewProfileId = Snapshot.Wcag.ProfileId; _reviewVersion = Snapshot.Wcag.Version;
        _scope = result.Definition.RequiresCrossPageEvidence ? WcagAssessmentEngine.ScopeGeneration(Snapshot) : "";
        _comment = ""; _evidence = ""; _reviewer = ""; _error = null;
        _decision = WcagStatus.Pass;
    }
    private async Task SaveReview()
    {
        if (_editing is not { } row) return;
        try
        {
            await Discovery.RecordWcagReviewAsync(JS, ProfileId, row.Definition.RequiresCrossPageEvidence ? null : row.Page,
                new WcagManualReview { CriterionId = row.Definition.CriterionId, Generation = row.Generation,
                    Version = _reviewVersion, AssessmentProfileId = _reviewProfileId, ScopeGeneration = _scope, Result = _decision,
                    Comment = _comment, EvidenceNote = _evidence, ReviewedBy = _reviewer });
            _editing = null; _error = null;
        }
        catch (ArgumentException e) { _error = e.Message; }
        catch (InvalidOperationException e) { _error = e.Message; }
    }
    private async Task ChangeProfile(string profileId)
    {
        try
        {
            await Discovery.SaveWcagSettingsAsync(JS, ProfileId, new WcagSettings { ProfileId = profileId });
            Snapshot = Discovery.GetSnapshot(ProfileId);
            _error = null;
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException) { _error = ex.Message; }
        _editing = null;
    }
}
