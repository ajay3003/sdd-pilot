@using BirkNext.Web.Models
@using BirkNext.Web.Services
@inject IBrowserAutomationDiagnosticApiService Diagnostic
@inject IJSRuntime JS
@implements IDisposable

@*
    Browser Automation Diagnostic — an engine/runtime diagnostic, which is why it lives with Frontend Engine
    Capabilities rather than on a review page.

    It answers one question in two independent ways: does Playwright-controlled Microsoft Edge work in general but
    lose control of THIS target — with a window, and without one?

    The two modes are shown as PEERS. Headless is not a technical footnote: it is the mode an unattended pipeline
    would use, so it decides what is actually possible, and burying it under a details toggle would hide the finding.
    Within each mode the stages stay in the order they were gathered, and a target failure is never presented without
    that mode's control-page result beside it.
*@
<section class="bad-card" data-testid="browser-automation-diagnostic" aria-labelledby="bad-heading">
    <div class="bad-head">
        <div>
            <h3 id="bad-heading">Browser automation diagnostic</h3>
            <p class="bad-sub" data-testid="bad-intro">
                Starts a Playwright-controlled Microsoft Edge in a dedicated BirkNext profile — once with a visible
                window and once without — proves each can control a neutral page, then follows the selected target
                and reports where the browser actually ended up (the application, or its sign-in page) and whether
                Playwright stayed in control. No sign-in is attempted, and nothing about your browser or its security
                settings is changed.
            </p>
        </div>
    </div>

    <div class="bad-controls">
        <label class="bad-target-label" for="bad-target">Target Environment</label>
        @if (Targets.Count == 0)
        {
            <p class="bad-empty" data-testid="bad-no-targets">
                No Target Environments configured.
                <a class="bad-link" href="@TargetEnvironmentsHref" data-testid="bad-open-targets">Open Target Environments</a>
            </p>
        }
        else
        {
            @* Every Target Environment is listed, each with the URL it would test, so the reader sees exactly what will be
               driven. Ineligible ones stay selectable and say why they cannot run; the backend refuses them regardless. *@
            <select id="bad-target" class="form-control bad-target" data-testid="bad-target-select"
                    value="@(_selectedId ?? "")" @onchange="OnTargetChanged" disabled="@_running"
                    aria-describedby="bad-target-help">
                @if (Selected is null)
                {
                    <option value="" disabled selected data-testid="bad-target-placeholder">Select a Target Environment</option>
                }
                @foreach (var target in Targets)
                {
                    <option value="@target.Id">@BrowserAutomationDiagnosticTargets.OptionLabel(target)</option>
                }
            </select>
            <button type="button" class="btn-primary" data-testid="bad-run"
                    disabled="@(_running || RunBlockedReason is not null)" @onclick="RunAsync"
                    aria-describedby="@(RunBlockedReason is not null ? "bad-target-help" : null)">
                @(_running ? "Running diagnostic…" : _report is null ? "Run diagnostic" : "Run again")
            </button>
            @if (_running)
            {
                <button type="button" class="btn-secondary" data-testid="bad-cancel" @onclick="Cancel">Cancel diagnostic</button>
            }
        }
    </div>

    @if (Targets.Count > 0)
    {
        @* One line under the select: why Run is unavailable, or what it will run against. Neutral until the reader acts. *@
        <p class="bad-target-help @(RunBlockedReason is not null && Selected is not null ? "bad-target-help-blocked" : "")" id="bad-target-help" data-testid="bad-target-help">
            @(Selected is null ? (ActiveResolutionError is { Length: > 0 } activeError ? $"{activeError} " : "") + "Select an environment to run the browser automation diagnostic."
              : RunBlockedReason ?? "Browser automation diagnostic runs against the selected Target Environment.")
            @if (Selected is not null && RunBlockedReason is not null)
            {
                <a class="bad-link" href="@TargetEnvironmentsHref" data-testid="bad-open-target">Open Target Environment</a>
            }
        </p>
    }

    @if (_running)
    {
        <p class="bad-progress" role="status" aria-live="polite" data-testid="bad-progress">
            Headed mode runs first: a BirkNext diagnostic Edge window will open and close on its own. Headless mode
            then runs with no window at all. Do not sign in to either.
        </p>
    }

    @if (_requestFailed)
    {
        <p class="bad-error" role="alert" data-testid="bad-request-failed">
            The diagnostic could not be started. BirkNext.Api must be running locally on this workstation.
        </p>
    }

    @if (_report is { } report)
    {
        <div class="bad-result" data-testid="bad-result" data-result="@report.Result">
            <div class="bad-result-head">
                <span class="bad-result-label">Result</span>
                <span class="fqr-pill fqr-pill-@BrowserAutomationDiagnosticStages.ResultTone(report.Result)"
                      data-testid="bad-result-label">@report.ResultLabel</span>
            </div>
            @* The run's own target, from the report — changing the selection afterwards never relabels it. *@
            <p class="bad-result-target" data-testid="bad-result-target">
                <span class="bad-result-target-name">@report.TargetEnvironmentName</span>
                <code class="bad-result-target-url">@report.TargetUrl</code>
            </p>

            @if (report.BlockedReason is { Length: > 0 } blocked)
            {
                <p class="bad-blocked" role="status" data-testid="bad-blocked-reason">@blocked</p>
            }

            @* Both modes, side by side and at the same level. Neither is nested inside the other's disclosure. *@
            <div class="bad-modes" data-testid="bad-modes">
                @foreach (var (kind, mode) in ModePanels(report))
                {
                    <article class="bad-mode" data-testid="bad-mode" data-mode="@kind"
                             data-mode-result="@(mode?.Result ?? BrowserAutomationDiagnosticModeResult.NotRun)">
                        <header class="bad-mode-head">
                            <h4 class="bad-mode-name" data-testid="bad-mode-name">
                                @BrowserAutomationDiagnosticStages.ModeLabel(kind) mode
                            </h4>
                            <span class="fqr-pill fqr-pill-@BrowserAutomationDiagnosticStages.ModeResultTone(mode?.Result ?? BrowserAutomationDiagnosticModeResult.NotRun)"
                                  data-testid="bad-mode-result">
                                @BrowserAutomationDiagnosticStages.ModeResultLabel(mode?.Result ?? BrowserAutomationDiagnosticModeResult.NotRun)
                            </span>
                        </header>
                        @* Why this mode matters, so "headless" is not read as a technical variant of the same test. *@
                        <p class="bad-mode-sub" data-testid="bad-mode-description">
                            @BrowserAutomationDiagnosticStages.ModeDescription(kind)
                        </p>

                        @if (mode is null)
                        {
                            <p class="bad-mode-empty" data-testid="bad-mode-empty">This mode was not run.</p>
                        }
                        else
                        {
                            @* Setup stages: the browser and the neutral control page. What happened AT the target is
                               shown separately below, fact by fact, because it is not one pass/fail answer. *@
                            <ul class="bad-stages" data-testid="bad-stages">
                                @foreach (var stage in SetupStages(mode))
                                {
                                    <li class="bad-stage" data-testid="bad-stage" data-stage="@stage.Stage" data-state="@stage.State">
                                        <span class="bad-stage-glyph fqr-pill-@BrowserAutomationDiagnosticStages.Tone(stage.State)"
                                              aria-hidden="true">@BrowserAutomationDiagnosticStages.Glyph(stage.State)</span>
                                        <span class="bad-stage-name">@BrowserAutomationDiagnosticStages.Label(stage.Stage)</span>
                                        @* The state is always a word, never only a colour or a tick. *@
                                        <span class="bad-stage-state" data-testid="bad-stage-state">@BrowserAutomationDiagnosticStages.StateLabel(stage.State)</span>
                                        @if (!string.IsNullOrWhiteSpace(stage.Url))
                                        {
                                            <span class="bad-stage-url"><code>@stage.Url</code></span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(stage.Detail))
                                        {
                                            <span class="bad-stage-detail">@stage.Detail</span>
                                        }
                                    </li>
                                }
                            </ul>

                            @if (mode.Target is { } target)
                            {
                                @* Visible without opening anything: where the browser actually ended up is the finding. *@
                                <section class="bad-target" data-testid="bad-target-evidence" aria-label="At the target">
                                    <h5 class="bad-target-heading">At the target</h5>
                                    <dl class="bad-facts">
                                        @foreach (var fact in BrowserAutomationTargetFacts.For(mode))
                                        {
                                            <div class="bad-fact" data-testid="bad-fact" data-fact="@fact.Key">
                                                <dt>@fact.Label</dt>
                                                <dd><span class="bad-fact-value fqr-pill-@fact.Tone" data-testid="bad-fact-value">@fact.Value</span>
                                                    <span class="bad-fact-provenance" data-testid="bad-fact-provenance">@fact.Provenance</span></dd>
                                            </div>
                                        }
                                    </dl>
                                    @if (mode.Stage(BrowserAutomationDiagnosticStage.TargetApplication) is { Detail.Length: > 0 } application)
                                    {
                                        <p class="bad-target-note" data-testid="bad-target-application-detail">@application.Detail</p>
                                    }
                                    @if (BlockedTargetStage(mode) is { Detail.Length: > 0 } blockedStage)
                                    {
                                        <p class="bad-target-note" data-testid="bad-target-blocked-detail">@blockedStage.Detail</p>
                                    }
                                    @if (target.NavigationTrace.Count > 0 || target.LifecycleEvents.Count > 0)
                                    {
                                        <details class="bad-trace" data-testid="bad-trace">
                                            <summary>Navigation trace (@target.NavigationTrace.Count, sanitized)</summary>
                                            <ol class="bad-trace-list">
                                                @foreach (var step in target.NavigationTrace)
                                                {
                                                    <li data-testid="bad-trace-step"><code>@step.Url</code>
                                                        <span class="bad-trace-meta">@BrowserAutomationTargetFacts.LocationLabel(step.Location)@(step.SecondaryPage ? " · second page" : "") · @step.AtMs ms</span></li>
                                                }
                                            </ol>
                                            @foreach (var e in target.LifecycleEvents)
                                            {
                                                <p class="bad-trace-event" data-testid="bad-lifecycle-event">
                                                    Browser event: @e.Kind at @e.AtMs ms (@BrowserAutomationTargetFacts.PhaseLabel(e.Phase))
                                                </p>
                                            }
                                        </details>
                                    }
                                </section>
                            }
                            else
                            {
                                <ul class="bad-stages" data-testid="bad-target-stages">
                                    @foreach (var stage in mode.Stages.Where(s => BrowserAutomationDiagnosticStages.TargetStages.Contains(s.Stage)))
                                    {
                                        <li class="bad-stage" data-testid="bad-stage" data-stage="@stage.Stage" data-state="@stage.State">
                                            <span class="bad-stage-glyph fqr-pill-@BrowserAutomationDiagnosticStages.Tone(stage.State)"
                                                  aria-hidden="true">@BrowserAutomationDiagnosticStages.Glyph(stage.State)</span>
                                            <span class="bad-stage-name">@BrowserAutomationDiagnosticStages.Label(stage.Stage)</span>
                                            <span class="bad-stage-state" data-testid="bad-stage-state">@BrowserAutomationDiagnosticStages.StateLabel(stage.State)</span>
                                        </li>
                                    }
                                </ul>
                            }

                            @if (mode.ObservedExceptionType is { Length: > 0 } exceptionType)
                            {
                                <p class="bad-exception" data-testid="bad-exception">
                                    <strong>Observed exception:</strong> <code>@exceptionType</code>
                                </p>
                            }

                            <p class="bad-mode-profile" data-testid="bad-mode-profile">@mode.ProfileDescription</p>
                        }
                    </article>
                }
            </div>

            @* What was observed, and nothing beyond it. This text never names an organisational control as the cause. *@
            <p class="bad-interpretation" data-testid="bad-interpretation">@report.Interpretation</p>

            @* Three controls that are routinely confused. Reported apart, never inferred from one another. *@
            @if (report.ControlDimensions.Count > 0)
            {
                <dl class="bad-dimensions" data-testid="bad-control-dimensions">
                    @foreach (var dimension in report.ControlDimensions)
                    {
                        <div class="bad-dimension" data-testid="bad-control-dimension">
                            <dt>@dimension.Name</dt>
                            <dd><strong data-testid="bad-control-dimension-state">@dimension.State</strong> — @dimension.Basis</dd>
                        </div>
                    }
                </dl>
            }

            @* The prerequisite chain, said in the order the reader has to act on it. *@
            <div class="bad-prerequisite fqr-pill-@BrowserAutomationDiagnosticPrerequisite.Tone(report)"
                 data-testid="bad-prerequisite"
                 data-available="@report.HeadlessAutomationControlAfterTargetNavigation.ToString().ToLowerInvariant()">
                <p class="bad-prerequisite-head" data-testid="bad-prerequisite-headline">
                    @BrowserAutomationDiagnosticPrerequisite.Headline(report)
                </p>
                <p class="bad-prerequisite-body" data-testid="bad-prerequisite-explanation">
                    @BrowserAutomationDiagnosticPrerequisite.Explanation(report)
                </p>
                @if (report.HeadlessAutomationControlAfterTargetNavigation)
                {
                    @* Navigation only. The authentication diagnostic runs from its own card, never from here. *@
                    <a class="btn-primary bad-prerequisite-link" data-testid="bad-go-to-auth-diagnostic"
                       href="@BrowserAutomationDiagnosticPrerequisite.AuthenticationDiagnosticHref(report)">
                        Go to Headless Authentication Diagnostic
                    </a>
                }
            </div>

            <dl class="bad-meta" data-testid="bad-meta">
                <div><dt>Target</dt><dd>@report.TargetEnvironmentName (@report.TargetEnvironmentType)</dd></div>
                <div><dt>Edge</dt><dd>@(report.EdgeVersion ?? "unknown")</dd></div>
                <div><dt>Playwright</dt><dd>@(report.PlaywrightVersion ?? "unknown")</dd></div>
            </dl>

            <div class="bad-actions">
                <button type="button" class="btn-secondary" data-testid="bad-copy" @onclick="CopyReport">
                    @(_copied ? "Report copied" : "Copy diagnostic report")
                </button>
            </div>
        </div>
    }
</section>

@code {
    /// <summary>Every configured Target Environment. Which one may run is decided per selection (and again by the backend).</summary>
    [Parameter, EditorRequired] public IReadOnlyList<FrontendAnalysisProfile> Targets { get; set; } = [];
    /// <summary>The active Target Environment, selected by default until the reader chooses another one.</summary>
    [Parameter] public string? ActiveProfileId { get; set; }
    /// <summary>Why no active target could be resolved (e.g. several saved as active). Nothing is guessed then.</summary>
    [Parameter] public string? ActiveResolutionError { get; set; }

    private const string TargetEnvironmentsHref = "/admin/system-settings?section=target-environments";

    private BrowserAutomationDiagnosticReport? _report;
    private CancellationTokenSource? _cts;
    private bool _running;
    private bool _requestFailed;
    private bool _copied;
    private string? _selectedId;
    /// <summary>Set once the reader picks an environment; from then on status refreshes and active changes leave it alone.</summary>
    private bool _chosen;

    /// <summary>
    /// Headed then headless, always both, always in that order — the order they ran in. A mode with no report is
    /// still shown, saying it was not run, so a missing mode can never be mistaken for a passing one.
    /// </summary>
    private static IEnumerable<(BrowserAutomationDiagnosticMode Kind, BrowserAutomationDiagnosticModeReport? Report)>
        ModePanels(BrowserAutomationDiagnosticReport report) =>
        [
            (BrowserAutomationDiagnosticMode.Headed, report.Headed),
            (BrowserAutomationDiagnosticMode.Headless, report.Headless),
        ];

    /// <summary>Everything except the target stages, which are presented separately (as facts, or as a stage list when no evidence came back).</summary>
    private static IEnumerable<BrowserAutomationDiagnosticStageResult> SetupStages(BrowserAutomationDiagnosticModeReport mode) =>
        mode.Stages.Where(s => !BrowserAutomationDiagnosticStages.TargetStages.Contains(s.Stage));

    /// <summary>The target stage that lost control, if any — its detail says when, and on what signal.</summary>
    private static BrowserAutomationDiagnosticStageResult? BlockedTargetStage(BrowserAutomationDiagnosticModeReport mode) =>
        mode.Stages.FirstOrDefault(s => BrowserAutomationDiagnosticStages.TargetStages.Contains(s.Stage)
                                        && s.State is BrowserAutomationDiagnosticStageState.Blocked or BrowserAutomationDiagnosticStageState.Failed);

    /// <summary>The selected environment — never a substitute. No selection is no target, not the first one listed.</summary>
    private FrontendAnalysisProfile? Selected => Targets.FirstOrDefault(t => t.Id == _selectedId);

    private string? RunBlockedReason => BrowserAutomationDiagnosticTargets.BlockedReason(Selected);

    /// <summary>
    /// Until the reader chooses, the selection is the active Target Environment (or nothing when none is active) — on a
    /// fresh load, and if the active environment changes while the page is open. A choice is never overridden.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (_chosen && Targets.Any(t => t.Id == _selectedId)) return;
        _chosen = false;
        _selectedId = Targets.Any(t => t.Id == ActiveProfileId) ? ActiveProfileId : null;
    }

    private void OnTargetChanged(ChangeEventArgs e)
    {
        _selectedId = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString();
        _chosen = _selectedId is not null;
        _copied = false;
    }

    private async Task RunAsync()
    {
        if (_running || RunBlockedReason is not null || Selected is not { } target) return;
        _running = true;
        _requestFailed = false;
        _copied = false;
        _report = null;
        _cts = new CancellationTokenSource();
        try
        {
            _report = await Diagnostic.RunAsync(new BrowserAutomationDiagnosticRequest
            {
                TargetEnvironmentId = target.Id,
                TargetEnvironmentName = target.Name,
                TargetUrl = target.TargetUrl ?? "",
                EnvironmentType = target.EnvironmentType.ToString(),
                Authority = target.Authentication.ExpectedAuthority,
            }, _cts.Token);
            _requestFailed = _report is null;
        }
        catch (OperationCanceledException)
        {
            // Cancelling is a choice, not a fault: the card simply returns to its idle state.
        }
        finally
        {
            _running = false;
            _cts?.Dispose();
            _cts = null;
        }
    }

    private void Cancel() => _cts?.Cancel();

    private async Task CopyReport()
    {
        if (_report is null) return;
        var text = BrowserAutomationDiagnosticReportText.Build(_report);
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", text); } catch { }
        _copied = true;
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
