@using BirkNext.Integrations
@using BirkNext.Web.Services
@using BirkNext.Web.Services.ProjectImport

@* Add / Edit one configured integration. Opened only on "+ Add integration" or "Edit". Nothing secret is entered here:
   authentication is a mechanism, never a key or connection string. Validation appears on blur and on save — an untouched
   form never opens with "Configuration incomplete". A new integration starts without a type: only its identity is asked for until
   a type is chosen, then that type's endpoint and flow fields; authentication, contract, operations, ownership and advanced stay
   collapsed (with their state) until opened. A pack's integration template can fill the safe, known values (never secrets); values a
   person entered are only replaced after confirmation. Configuration is asked for as fields; everything that is a decision about evidence —
   consumer mapping, source evidence, authentication and contracts — is a review card with a state and an action, never a field to type a
   state into. A matching snapshot is bound only when a person chooses it (a recommendation comes from content evidence, never from the
   newest date), an existing binding is never replaced here, and nothing is confirmed by saving. *@
<section class="ip-editor" data-testid="ip-editor" aria-labelledby="ip-editor-heading">
    <h3 id="ip-editor-heading">@(IsNew ? "Add integration" : $"Edit {_model.DisplayName}")</h3>
    <p class="ip-muted">Fields marked <span aria-hidden="true">*</span><span class="ip-sr">with an asterisk</span> are required. BirkNext prefills what is known and lists what still needs a decision under Review needed.</p>

    @if (CurrentTemplate is { } summaryTemplate && _model.Kind is not null)
    {
        @* What am I adding, what is already known, what still needs my attention — before any field. *@
        <dl class="ip-editor-summary" data-testid="ip-edit-summary">
            <div><dt>Integration</dt><dd data-testid="ip-edit-summary-name">@(string.IsNullOrWhiteSpace(_model.DisplayName) ? summaryTemplate.DisplayName : _model.DisplayName)</dd></div>
            <div><dt>Type</dt><dd>@IntegrationConfigurationRules.KindLabel(_model.Kind.Value)</dd></div>
            @if (!string.IsNullOrWhiteSpace(_model.Producer) || !string.IsNullOrWhiteSpace(_model.ConsumerName)) { <div><dt>Flow</dt><dd class="ip-wrap">@(_model.Producer ?? "—") → @(_model.ConsumerName ?? "—")</dd></div> }
            <div><dt>Configuration</dt><dd data-testid="ip-edit-summary-config">@(MissingRequired().Count == 0 ? "Ready" : $"{MissingRequired().Count} required {(MissingRequired().Count == 1 ? "field" : "fields")} missing")</dd></div>
            <div><dt>Review items</dt><dd data-testid="ip-edit-summary-review">@(ReviewItems().Count == 0 ? "None remaining" : $"{ReviewItems().Count} remaining")</dd></div>
            @if (ReferenceDataLabel is { } referenceData) { <div><dt>Reference data</dt><dd data-testid="ip-edit-summary-reference">@referenceData</dd></div> }
        </dl>
    }

    @if (Templates.Count > 0)
    {
        <section class="ip-template" data-testid="ip-edit-template" aria-labelledby="ip-template-heading">
            <h4 id="ip-template-heading">Integration template</h4>
            @if (!IsNew) { <p class="ip-muted" data-testid="ip-edit-template-origin">@OriginText</p> }
            <label class="ip-field">Start from
                <select class="form-control" data-testid="ip-edit-template-select" @ref="_templateSelect" value="@_selectedKey" @onchange="OnTemplateChanged" aria-describedby="ip-template-help">
                    <option value="">Manual / custom integration</option>
                    @foreach (var group in Templates.GroupBy(t => t.PackName))
                    {
                        <optgroup label="@($"Recommended for {group.Key}")">
                            @foreach (var t in group) { <option value="@t.Key">@t.DisplayName@(t.AlreadyConfigured.Count > 0 ? " (already configured)" : "")</option> }
                        </optgroup>
                    }
                </select>
            </label>
            <p class="ip-muted" id="ip-template-help">The template prefills safe known values only. It never fills secrets, trust decisions or test results.</p>
            @if (_pending is { } pending)
            {
                <div class="ip-template-confirm" role="group" aria-labelledby="ip-template-confirm-heading" data-testid="ip-edit-template-confirm" tabindex="-1" @ref="_confirmFocus">
                    <p id="ip-template-confirm-heading"><strong>Apply template values?</strong> @pending.Conflicts.Count @(pending.Conflicts.Count == 1 ? "field already contains a value" : "fields already contain values") you entered: @string.Join(", ", pending.Conflicts.Select(IntegrationTemplatePresentation.FieldLabel)).</p>
                    <div class="ip-editor-actions">
                        <button type="button" class="btn-secondary" data-testid="ip-edit-template-keep" @onclick="() => ResolvePending(TemplateApplyMode.KeepMine)">Keep my values</button>
                        <button type="button" class="btn-primary" data-testid="ip-edit-template-where-empty" @onclick="() => ResolvePending(TemplateApplyMode.WhereEmpty)">Apply template where empty</button>
                        <button type="button" class="btn-secondary" data-testid="ip-edit-template-replace" @onclick="() => ResolvePending(TemplateApplyMode.Replace)">Replace with template values</button>
                    </div>
                </div>
            }
            @if (_applied is { } applied)
            {
                <div class="ip-template-preview" data-testid="ip-edit-template-preview">
                    <dl class="ip-template-facts">
                        <div><dt>Template</dt><dd>@applied.DisplayName</dd></div>
                        <div><dt>Type</dt><dd>@IntegrationConfigurationRules.KindLabel(applied.Kind)</dd></div>
                        @if (applied.Values.TryGetValue("Producer", out var from) && applied.Values.TryGetValue("Consumer", out var to)) { <div><dt>Flow</dt><dd>@from.Value → @to.Value</dd></div> }
                        @if (applied.EvidenceSource is { } evidence) { <div><dt>Evidence</dt><dd>@evidence.Role.Label source · <span data-testid="ip-edit-template-evidence-state">@IntegrationTemplatePresentation.Label(EvidenceState)</span></dd></div> }
                        @if (applied.ReferenceSource is { } reference) { <div><dt>@reference.Role.Label</dt><dd data-testid="ip-edit-template-reference">@IntegrationTemplatePresentation.ReferenceLabel(applied)</dd></div> }
                        @if (applied.Journeys.Count > 0) { <div><dt>Used by</dt><dd data-testid="ip-edit-template-journeys">@string.Join(", ", applied.Journeys)</dd></div> }
                    </dl>
                    <p class="ip-muted">@applied.Description</p>
                    @if (applied.AlreadyConfigured.Count > 0 && IsNew)
                    {
                        <p class="ip-template-note" data-testid="ip-edit-template-duplicate">Already configured: @string.Join(", ", applied.AlreadyConfigured). Adding another usually duplicates it.</p>
                    }
                    @if (applied.NeedsConfiguration.Count > 0)
                    {
                        <p class="ip-template-note" data-testid="ip-edit-template-needs">Needs configuration: @string.Join(", ", applied.NeedsConfiguration.Select(IntegrationTemplatePresentation.FieldLabel)) — not known for this environment, so left empty.</p>
                    }
                </div>
            }
        </section>
    }

    @if (_attempted && _errors.Count > 0)
    {
        <div class="ip-error-summary" role="alert" data-testid="ip-editor-errors">
            <strong>Fix @_errors.Count @(_errors.Count == 1 ? "field" : "fields") before saving:</strong>
            <ul>@foreach (var e in _errors) { <li>@e</li> }</ul>
        </div>
    }

    <fieldset class="ip-fieldset">
        <legend>Integration configuration @SectionPrefill("DisplayName", "Kind")</legend>
        <label class="ip-field">Display name <span aria-hidden="true">*</span>
            <input class="form-control" data-testid="ip-edit-name" @ref="_nameInput" @bind="_model.DisplayName" @bind:event="oninput" @onblur='() => Touch("name")' aria-required="true" aria-invalid="@Invalid("name", string.IsNullOrWhiteSpace(_model.DisplayName))" />
            @Provenance("DisplayName")
        </label>
        @if (Show("name") && string.IsNullOrWhiteSpace(_model.DisplayName)) { <span class="ip-field-error" role="status">Display name is required.</span> }
        <label class="ip-check"><input type="checkbox" data-testid="ip-edit-enabled" @bind="_model.Enabled" /> Enabled</label>
        <label class="ip-field">Type <span aria-hidden="true">*</span>
            <select class="form-control" data-testid="ip-edit-kind" @bind="KindText" aria-required="true" aria-invalid="@Invalid("kind", _model.Kind is null)">
                @if (_model.Kind is null) { <option value="">Select type</option> }
                @foreach (var kind in Enum.GetValues<IntegrationKind>()) { <option value="@kind">@IntegrationConfigurationRules.KindLabel(kind)</option> }
            </select>
            @Provenance("Kind")
        </label>
        @if (Show("kind") && _model.Kind is null) { <span class="ip-field-error" role="status">Choose a type.</span> }
        @if (_model.Kind is null)
        {
            <p class="ip-muted" data-testid="ip-edit-kind-first">Choose a type to see the fields that apply to it.</p>
        }
        else if (IntegrationReviewCapabilities.Of(_model.Kind.Value) == IntegrationReviewCapability.ConfigurationOnly)
        {
            <p class="ip-muted" data-testid="ip-edit-kind-note">Integration Quality Review assesses configuration for this type; no domain review profile exists for it.</p>
        }
        else if (_model.Kind == IntegrationKind.HttpApi)
        {
            <p class="ip-muted" data-testid="ip-edit-kind-note">HTTP/API integrations are reviewed with their own profile (endpoint, authentication evidence, contracts, the consumer's source). Consumer group, source resource and worker endpoint do not apply.</p>
        }
    </fieldset>

    @if (_model.Kind is not null)
    {
    <fieldset class="ip-fieldset">
        <legend>Connection @SectionPrefill("SystemName", "EndpointOrTopic", "Producer", "Consumer", "SourceResource", "SourceSystem", "DestinationSystem")</legend>
        <label class="ip-field">Integration system
            <input class="form-control" data-testid="ip-edit-system" @bind="_model.SystemName" placeholder="e.g. BIRK CDC / Debezium" />
            @Provenance("SystemName")
        </label>
        @* A platform is the environment's shared messaging platform (an Event Hubs / Service Bus namespace); an HTTP/API integration has none. *@
        @if (!IsHttpApi)
        {
            <label class="ip-field">Messaging platform
                <select class="form-control" data-testid="ip-edit-platform" @bind="_model.PlatformId">
                    <option value="">None</option>
                    @foreach (var p in Platforms) { <option value="@p.Id">@p.Name</option> }
                </select>
            </label>
        }
        <label class="ip-field">@EndpointLabel <span aria-hidden="true">*</span>
            <input class="form-control ip-mono" data-testid="ip-edit-topic" @bind="_model.EndpointOrTopic" @bind:event="oninput" @onblur='() => Touch("topic")' aria-required="true" aria-invalid="@Invalid("topic", string.IsNullOrWhiteSpace(_model.EndpointOrTopic))" />
            @Provenance("EndpointOrTopic")
        </label>
        @if (Show("topic") && string.IsNullOrWhiteSpace(_model.EndpointOrTopic)) { <span class="ip-field-error" role="status">This field is required.</span> }
        @* Consumer groups, source tables and delete/tombstone semantics belong to event streams (CDC); an HTTP/API integration has none. *@
        @if (!IsHttpApi)
        {
            <label class="ip-field">Consumer group
                <input class="form-control ip-mono" data-testid="ip-edit-consumer-group" @bind="_model.ConsumerGroup" placeholder="Leave blank until confirmed" aria-describedby="ip-edit-consumer-group-help" />
            </label>
            <p class="ip-muted" id="ip-edit-consumer-group-help" data-testid="ip-edit-consumer-group-help">Consumer group is required for checkpoint/lag review. Leave blank if not confirmed — <code>$Default</code> is never assumed.</p>
        }
        <label class="ip-field">Producer <input class="form-control" data-testid="ip-edit-producer" @bind="_model.Producer" />@Provenance("Producer")</label>
        @if (!IsHttpApi) { <label class="ip-field">Source <input class="form-control ip-mono" data-testid="ip-edit-source" @bind="_model.SourceResource" placeholder="e.g. BirkM2LB.dbo.Person" />@Provenance("SourceResource")</label> }
        <label class="ip-field">Consumer <input class="form-control" data-testid="ip-edit-consumer" @bind="_model.ConsumerName" />@Provenance("Consumer")</label>
        @if (!IsHttpApi)
        {
            <label class="ip-field">Delete / tombstone expectation
                <select class="form-control" data-testid="ip-edit-delete-expectation" @bind="_model.DeleteExpectation">
                    <option value="@CdcDeleteExpectation.NotSpecified">Not specified</option>
                    <option value="@CdcDeleteExpectation.DeleteEventOnly">Delete event only (no tombstone)</option>
                    <option value="@CdcDeleteExpectation.DeleteEventAndTombstone">Delete event followed by a tombstone</option>
                    <option value="@CdcDeleteExpectation.TombstoneNotExpected">Tombstones not expected</option>
                </select>
            </label>
        }
    </fieldset>

    @* Review needed: decisions, evidence and references — statuses with actions, never text fields to type a state into. *@
    <section class="ip-review" data-testid="ip-edit-review" aria-labelledby="ip-review-heading" tabindex="-1" @ref="_reviewSection">
        <h4 id="ip-review-heading">Review needed <span class="ip-pill ip-pill-@(ReviewItems().Count == 0 ? "ready" : "attention")" data-testid="ip-edit-review-count">@(ReviewItems().Count == 0 ? "Nothing remaining" : $"{ReviewItems().Count} remaining")</span></h4>
        <p class="ip-muted">The integration can be saved before these are finished; each stays in its current state until you decide.</p>

        @* Consumer mapping *@
        <article class="ip-review-card" data-testid="ip-edit-mapping-card" aria-labelledby="ip-mapping-heading">
            <div class="ip-review-head"><h5 id="ip-mapping-heading">Consumer mapping</h5>
                <span class="ip-pill ip-pill-@(_model.MappingState == ConsumerMappingState.Confirmed ? "ready" : "attention")" data-testid="ip-edit-mapping-state">@IntegrationConfigurationRules.MappingLabel(_model.MappingState)</span></div>
            <dl class="ip-template-facts">
                <div><dt>Proposed</dt><dd data-testid="ip-edit-mapping-proposed">@(string.IsNullOrWhiteSpace(_model.ConsumerName) ? "No consumer set" : _model.ConsumerName)</dd></div>
                <div><dt>Why</dt><dd data-testid="ip-edit-mapping-why">@MappingWhy</dd></div>
            </dl>
            <div class="ip-editor-actions">
                @if (!string.IsNullOrWhiteSpace(_model.ConsumerName) && _model.MappingState != ConsumerMappingState.Confirmed)
                {
                    <button type="button" class="btn-secondary" data-testid="ip-edit-mapping-confirm" @onclick="() => _model.MappingState = ConsumerMappingState.Confirmed">Confirm mapping</button>
                }
                else if (_model.MappingState == ConsumerMappingState.Confirmed)
                {
                    <button type="button" class="btn-secondary" data-testid="ip-edit-mapping-unconfirm" @onclick="() => _model.MappingState = ConsumerMappingState.NeedsConfirmation">Undo confirmation</button>
                }
            </div>
            <ReviewDisclosure Text="Review details" CollapseText="Hide details" TestId="ip-edit-mapping-details" Class="disclosure-inline disclosure-small">
                <label class="ip-field">Mapping state
                    <select class="form-control" data-testid="ip-edit-mapping" @bind="_model.MappingState">
                        @foreach (var m in Enum.GetValues<ConsumerMappingState>()) { <option value="@m">@IntegrationConfigurationRules.MappingLabel(m)</option> }
                    </select>
                </label>
                <p class="ip-muted">Confirming records that a person reviewed this consumer for this environment. Saving alone never confirms it.</p>
            </ReviewDisclosure>
        </article>

        @* Source evidence *@
        <article class="ip-review-card ip-evidence" data-testid="ip-edit-evidence" data-state="@EvidenceState" aria-labelledby="ip-evidence-heading">
            <div class="ip-review-head"><h5 id="ip-evidence-heading">Source evidence</h5>
                <span class="ip-pill ip-pill-@IntegrationTemplatePresentation.Tone(EvidenceState)" data-testid="ip-edit-evidence-state">@EvidenceBadge</span></div>
            @if (Binding is { } binding)
            {
                <p data-testid="ip-edit-evidence-bound">Canonical evidence: <span class="ip-wrap">@binding.ArchiveName</span></p>
                <p class="ip-muted">@IntegrationTemplatePresentation.Meaning(EvidenceState) <a class="ip-link" href="/integration-quality-review?view=evidence" data-testid="ip-edit-evidence-iqr">Open IQR Evidence</a></p>
            }
            else if (EvidenceStatus is not { } status)
            {
                <p class="ip-muted" data-testid="ip-edit-evidence-none">@(_applied is null && OriginalTemplate is null ? "No template evidence requirement. Source evidence can be bound in IQR Evidence after saving." : IntegrationTemplatePresentation.Meaning(EvidenceState))</p>
            }
            else
            {
                var choices = IntegrationTemplatePresentation.Choices(status);
                var recommended = Recommended(choices);
                <dl class="ip-template-facts">
                    <div><dt>@SourceSetupPresentation.RequirementLabel(status.Role.Requirement) source</dt><dd data-testid="ip-edit-evidence-role">@status.Role.Label</dd></div>
                    @if (choices.Count == 0) { <div><dt>Expected evidence</dt><dd>@status.Role.ExpectedArtifact</dd></div> }
                    else if (choices.Count == 1) { <div><dt>Matching source</dt><dd class="ip-wrap" data-testid="ip-edit-evidence-candidate">@choices[0].ArchiveFileName</dd></div> }
                    else { <div><dt>Matching source snapshots</dt><dd data-testid="ip-edit-evidence-count">@choices.Count matching @status.Role.Label snapshots</dd></div> }
                    @if (recommended is { } best && choices.Count > 1) { <div><dt>Recommended</dt><dd class="ip-wrap" data-testid="ip-edit-evidence-recommended">@best.ArchiveFileName</dd></div>
                        <div><dt>Reason</dt><dd class="ip-wrap" data-testid="ip-edit-evidence-reason">Recognized as @status.Role.Label from its content: @string.Join(", ", best.MatchedOn.Take(3)).</dd></div> }
                    else if (choices.Count > 1) { <div><dt>Recommendation</dt><dd data-testid="ip-edit-evidence-no-recommendation">@choices.Count matching sources found — choose one. None is preferred by its date.</dd></div> }
                </dl>
                @if (choices.Count <= 1) { <p class="ip-muted" data-testid="ip-edit-evidence-meaning">@IntegrationTemplatePresentation.Meaning(EvidenceState)</p> }
                @if (choices.Count == 0)
                {
                    <p class="ip-editor-actions"><a class="ip-link" href="project-import" data-testid="ip-edit-evidence-import">Import @status.Role.Label source</a></p>
                }
                else if (choices.Count == 1)
                {
                    var only = choices[0];
                    <div class="ip-editor-actions">
                        <button type="button" class="@(_evidenceChoice == only.SnapshotId ? "btn-primary" : "btn-secondary")" data-testid="ip-edit-evidence-use" aria-pressed="@(_evidenceChoice == only.SnapshotId ? "true" : "false")" @onclick="() => ToggleEvidence(only.SnapshotId)">@(_evidenceChoice == only.SnapshotId ? "Using for IQR evidence" : "Use for IQR evidence")</button>
                        <a class="ip-link" href="@ProjectImportPresentation.SourceAnalysisHref(only.SnapshotId)" data-testid="ip-edit-evidence-open">Open Source Analysis</a>
                    </div>
                    <ReviewDisclosure Text="Technical details" CollapseText="Hide technical details" TestId="ip-edit-evidence-details" Class="disclosure-inline disclosure-small">
                        <dl class="ip-template-facts" data-testid="ip-edit-evidence-detail-list">
                            <div><dt>Logical source</dt><dd>@status.Role.Label</dd></div>
                            <div><dt>Archive</dt><dd class="ip-wrap">@only.ArchiveFileName</dd></div>
                            @if (only.AnalysisStatus is { } analysis) { <div><dt>Analysis</dt><dd data-testid="ip-edit-evidence-analysis">@analysis</dd></div> }
                            <div><dt>Snapshot</dt><dd><span class="ip-mono">@Short(only.Fingerprint)</span> <span class="ip-muted">· analyzed @only.AnalyzedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC</span></dd></div>
                            @if (only.MatchedOn.Count > 0) { <div><dt>Matched on</dt><dd class="ip-wrap">@string.Join(", ", only.MatchedOn.Take(3))</dd></div> }
                        </dl>
                    </ReviewDisclosure>
                }
                else
                {
                    <div class="ip-editor-actions">
                        @if (recommended is { } useBest) { <button type="button" class="btn-secondary" data-testid="ip-edit-evidence-use-recommended" @onclick="() => _evidenceChoice = useBest.SnapshotId">Use recommended source</button> }
                        <button type="button" class="btn-secondary" data-testid="ip-edit-evidence-choose" aria-expanded="@(_chooseEvidence ? "true" : "false")" @onclick="() => _chooseEvidence = !_chooseEvidence">@(recommended is null ? "Choose source" : "Choose another source")</button>
                    </div>
                    @if (_chooseEvidence || recommended is null)
                    {
                        <fieldset class="ip-evidence-choices" data-testid="ip-edit-evidence-choices">
                            <legend>Choose source evidence</legend>
                            <label class="ip-check"><input type="radio" name="ip-evidence-choice" data-testid="ip-edit-evidence-none-choice" checked="@(_evidenceChoice is null)" @onchange="() => _evidenceChoice = null" /> Save without source evidence</label>
                            @foreach (var choice in choices)
                            {
                                <label class="ip-check" data-testid="ip-edit-evidence-option"><input type="radio" name="ip-evidence-choice" value="@choice.SnapshotId" checked="@(_evidenceChoice == choice.SnapshotId)" @onchange="() => _evidenceChoice = choice.SnapshotId" />
                                    <span class="ip-wrap">@choice.ArchiveFileName <span class="ip-muted">· analyzed @choice.AnalyzedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC@(choice.Bound ? " · bound to another integration" : "")@(recommended?.SnapshotId == choice.SnapshotId ? " · recommended" : "")</span></span></label>
                            }
                        </fieldset>
                        <ReviewDisclosure Text="Technical details" CollapseText="Hide technical details" TestId="ip-edit-evidence-fingerprints" Class="disclosure-inline disclosure-small">
                            <dl class="ip-template-facts">@foreach (var choice in choices) { <div><dt class="ip-wrap">@choice.ArchiveFileName</dt><dd class="ip-mono">@Short(choice.Fingerprint)@(choice.MatchedOn.Count > 0 ? $" · matched on {string.Join(", ", choice.MatchedOn.Take(3))}" : "")</dd></div> }</dl>
                        </ReviewDisclosure>
                    }
                }
                @if (_evidenceChoice is null && choices.Count > 0)
                {
                    <p class="ip-muted" data-testid="ip-edit-evidence-without">Save without source evidence: the integration can still be saved. Source-based integration review remains Not assessed until evidence is bound.</p>
                }
                @if (_evidenceChoice is { } chosen && choices.FirstOrDefault(c => c.SnapshotId == chosen) is { } picked)
                {
                    @* The explicit choice is confirmed by saving; nothing is bound by choosing a template or opening this form. *@
                    <div class="ip-template-note" role="status" data-testid="ip-edit-evidence-effect">
                        <p><strong>Bind on save</strong></p>
                        <dl class="ip-template-facts" data-testid="ip-edit-evidence-confirm">
                            <div><dt>Integration</dt><dd>@(string.IsNullOrWhiteSpace(_model.DisplayName) ? "This integration" : _model.DisplayName)</dd></div>
                            <div><dt>Source</dt><dd class="ip-wrap">@picked.ArchiveFileName</dd></div>
                            <div><dt>Logical source</dt><dd>@status.Role.Label</dd></div>
                            <div><dt>Action</dt><dd>Use this Source Analysis snapshot as canonical evidence for this integration.</dd></div>
                        </dl>
                        <p class="ip-muted">It is bound right after the integration is saved; the snapshot itself is not copied or changed. IQR Evidence is where it is changed later.</p>
                        <button type="button" class="btn-secondary" data-testid="ip-edit-evidence-cancel" @onclick="() => _evidenceChoice = null">Save without source evidence</button>
                    </div>
                }
            }
        </article>

        @* Authentication: what the application declares, where run authentication lives, and the integration's mechanism — never a credential. *@
        <article class="ip-review-card" data-testid="ip-edit-section-authentication" aria-labelledby="ip-auth-heading">
            <div class="ip-review-head"><h5 id="ip-auth-heading">Authentication</h5>
                <span class="ip-pill ip-pill-muted" data-testid="ip-edit-auth-state">@(AuthReference.Count > 0 ? "Authentication reference available" : "No declared reference")</span></div>
            @if (AuthReference.Count > 0)
            {
                <section class="ip-reference" aria-labelledby="ip-auth-reference-heading" data-testid="ip-edit-auth-reference">
                    <h6 id="ip-auth-reference-heading">Declared authentication</h6>
                    @ReferenceFacts(AuthReference, "ip-edit-auth-fact")
                    <p class="ip-muted">Source: @TestPackReferenceLabel. This describes what the application declares. It does not prove runtime authentication or configure credentials.</p>
                </section>
            }
            <dl class="ip-template-facts" data-testid="ip-edit-auth-run">
                <div><dt>Review/run authentication</dt><dd data-testid="ip-edit-auth-run-state">Configured elsewhere · <a class="ip-link" href="/integration-quality-review?view=test-verify" data-testid="ip-edit-auth-run-link">Integration Quality Review → Test &amp; Verify</a></dd></div>
            </dl>
            <p class="ip-muted">No secrets are stored in this integration record.</p>
            @if (IsHttpApi && _model.ProducerAuthentication == IntegrationAuthMechanism.NotConfigured && _model.ConsumerAuthentication == IntegrationAuthMechanism.NotConfigured)
            {
                <dl class="ip-template-facts" data-testid="ip-edit-auth-mechanism-summary">
                    <div><dt>Producer authentication</dt><dd>Not required for current configuration</dd></div>
                    <div><dt>Consumer authentication</dt><dd>Not required for current configuration</dd></div>
                </dl>
            }
            <ReviewDisclosure Text="Integration authentication mechanism" CollapseText="Hide integration authentication mechanism" TestId="ip-edit-auth-mechanism" Class="disclosure-inline disclosure-small" Expanded="@(!IsHttpApi)">
                <p class="ip-muted">Describes the mechanism only — never credentials, keys, tokens or secrets.</p>
                <label class="ip-field">Producer authentication
                    <select class="form-control" data-testid="ip-edit-producer-auth" @bind="_model.ProducerAuthentication">
                        @foreach (var a in Enum.GetValues<IntegrationAuthMechanism>()) { <option value="@a">@AuthOption(a)</option> }
                    </select>
                </label>
                <label class="ip-field">Consumer authentication
                    <select class="form-control" data-testid="ip-edit-consumer-auth" @bind="_model.ConsumerAuthentication">
                        @foreach (var a in Enum.GetValues<IntegrationAuthMechanism>()) { <option value="@a">@AuthOption(a)</option> }
                    </select>
                </label>
            </ReviewDisclosure>
        </article>

        @* Contract: the declared submission contract, the matching schema in the source, and their relationship — never confirmed by a name match. *@
        <article class="ip-review-card" data-testid="ip-edit-section-contract" aria-labelledby="ip-contract-heading">
            <div class="ip-review-head"><h5 id="ip-contract-heading">Contract</h5>
                <span class="ip-pill ip-pill-@(_model.ContractRelationship == ContractRelationshipState.RelationshipVerified ? "ready" : "attention")" data-testid="ip-edit-contract-state">@ContractStateLabel</span></div>
            @if (ContractReference.Count > 0)
            {
                <section class="ip-reference" aria-labelledby="ip-contract-reference-heading" data-testid="ip-edit-contract-reference">
                    <h6 id="ip-contract-reference-heading">Declared submission contract</h6>
                    @ReferenceFacts(ContractReference, "ip-edit-contract-fact")
                    <p class="ip-muted">Source: @TestPackReferenceLabel. This describes the submission contract declared by the application. It does not prove which downstream schema the receiving side actively validates.</p>
                </section>
            }
            @if (SchemaState != IntegrationTemplatePresentation.SchemaEvidenceState.NotApplicable && CurrentTemplate is { SchemaName: { } schemaName, EvidenceSource: { } schemaSource })
            {
                var schemaFiles = SchemaFiles;
                var schemaFound = SchemaState is IntegrationTemplatePresentation.SchemaEvidenceState.Available or IntegrationTemplatePresentation.SchemaEvidenceState.Bound or IntegrationTemplatePresentation.SchemaEvidenceState.Ambiguous && schemaFiles.Count > 0;
                <section class="ip-reference" aria-labelledby="ip-contract-schema-heading" data-testid="ip-edit-contract-schema" data-state="@SchemaState">
                    <h6 id="ip-contract-schema-heading">Source schema evidence</h6>
                    <p data-testid="ip-edit-contract-schema-summary">@(schemaFound ? $"Matching schema found in {schemaSource.Role.Label} source" : IntegrationTemplatePresentation.SchemaLabel(SchemaState))</p>
                    <dl class="ip-template-facts">
                        <div><dt>Status</dt><dd data-testid="ip-edit-contract-schema-state">@(schemaFound && _model.ContractRelationship != ContractRelationshipState.RelationshipVerified ? "Review required" : IntegrationTemplatePresentation.SchemaLabel(SchemaState))</dd></div>
                        @if (schemaFound) { <div><dt>Why</dt><dd>The source contains a schema named <span class="ip-mono ip-wrap">@schemaName</span>, but the active downstream validation relationship has not been confirmed.</dd></div> }
                        @if (schemaFiles.Count == 1 && SchemaState is IntegrationTemplatePresentation.SchemaEvidenceState.Available or IntegrationTemplatePresentation.SchemaEvidenceState.Bound) { <div><dt>Candidate</dt><dd class="ip-wrap ip-mono" data-testid="ip-edit-contract-schema-file">@schemaFiles[0]</dd></div> }
                        else if (schemaFiles.Count > 1) { <div><dt>Candidates</dt><dd data-testid="ip-edit-contract-schema-count">@schemaFiles.Count matching schema files</dd></div> }
                    </dl>
                    <p class="ip-editor-actions"><a class="ip-link" href="/schema-studio" data-testid="ip-edit-contract-schema-review">Review schema evidence</a></p>
                </section>
            }
            <section class="ip-reference" aria-labelledby="ip-contract-relationship-heading" data-testid="ip-edit-contract-relationship">
                <h6 id="ip-contract-relationship-heading">Contract relationship</h6>
                @(ContractPicker("Producer contract", _model.ProducerContractReference, ProducerContractCandidates, value => SetContractReference(true, value), "ip-edit-producer-contract"))
                @(ContractPicker("Consumer contract", _model.ConsumerContractReference, ConsumerContractCandidates, value => SetContractReference(false, value), "ip-edit-consumer-contract"))
                @if (!string.IsNullOrWhiteSpace(_model.ProducerContractReference) && !string.IsNullOrWhiteSpace(_model.ConsumerContractReference))
                {
                    <p data-testid="ip-edit-contract-possible">Possible relationship: <span class="ip-wrap">@_model.ProducerContractReference ↔ @_model.ConsumerContractReference</span></p>
                }
                <div class="ip-editor-actions">
                    @if (_model.ContractRelationship == ContractRelationshipState.RelationshipVerified)
                    {
                        <button type="button" class="btn-secondary" data-testid="ip-edit-contract-unconfirm" @onclick="() => _model.ContractRelationship = DerivedContractState">Undo confirmation</button>
                    }
                    else
                    {
                        <button type="button" class="btn-secondary" data-testid="ip-edit-contract-confirm" disabled="@(DerivedContractState != ContractRelationshipState.BothContractsAvailable)"
                                aria-describedby="ip-edit-contract-confirm-help" @onclick="() => _model.ContractRelationship = ContractRelationshipState.RelationshipVerified">Confirm relationship</button>
                    }
                </div>
                <p class="ip-muted" id="ip-edit-contract-confirm-help">@(DerivedContractState == ContractRelationshipState.BothContractsAvailable
                    ? "Confirm only when you have reviewed that both contracts describe the same message. A matching name alone is not confirmation."
                    : "Select both a producer and a consumer contract before the relationship can be confirmed.")</p>
            </section>
        </article>

        @if (ReviewItems().Count > 0)
        {
            <p class="ip-muted" data-testid="ip-edit-review-list">Remaining: @string.Join(" · ", ReviewItems())</p>
        }
    </section>

    @* Optional details: operational links, ownership, the consumer's runtime identity and type-specific settings. Never inferred, never required. *@
    <h4 class="ip-optional-heading" data-testid="ip-edit-optional">Optional details</h4>
    <ReviewDisclosure Text="Operations" CollapseText="Operations" Hint="@IntegrationTemplatePresentation.SectionHint(!new[] { _model.HealthUrl, _model.WorkerUrl, _model.MonitoringUrl, _model.RunbookUrl }.All(string.IsNullOrWhiteSpace), false, optional: true)"
                      TestId="ip-edit-section-operations" Class="disclosure-inline" Expanded="@(Show("urls") && UrlErrors().Any())">
    <fieldset class="ip-fieldset">
        <legend class="ip-sr">Operations</legend>
        <p class="ip-muted">Optional operational links for this integration.</p>
        <label class="ip-field">Health URL <input class="form-control ip-mono" @bind="_model.HealthUrl" @onblur='() => Touch("urls")' /></label>
        @* A worker endpoint belongs to a background consumer (queue/topic/stream processor); a request/response API has none. *@
        @if (!IsHttpApi || !string.IsNullOrWhiteSpace(_model.WorkerUrl)) { <label class="ip-field">Worker URL <input class="form-control ip-mono" @bind="_model.WorkerUrl" @onblur='() => Touch("urls")' /></label> }
        <label class="ip-field">Monitoring URL <input class="form-control ip-mono" @bind="_model.MonitoringUrl" @onblur='() => Touch("urls")' /></label>
        <label class="ip-field">Runbook URL <input class="form-control ip-mono" @bind="_model.RunbookUrl" @onblur='() => Touch("urls")' /></label>
        @if (Show("urls") && UrlErrors().ToList() is { Count: > 0 } urlErrors) { <span class="ip-field-error" role="status">@string.Join(" ", urlErrors)</span> }
    </fieldset>
    </ReviewDisclosure>

    <ReviewDisclosure Text="Ownership" CollapseText="Ownership" Hint="@IntegrationTemplatePresentation.SectionHint(!string.IsNullOrWhiteSpace(_model.TechnicalOwner), false, optional: true)"
                      TestId="ip-edit-section-ownership" Class="disclosure-inline">
    <fieldset class="ip-fieldset">
        <legend class="ip-sr">Ownership</legend>
        <p class="ip-muted">The accountable team or system owner, when it is known. Producer and consumer are set under Connection.</p>
        <label class="ip-field">Owner / responsible team <input class="form-control" data-testid="ip-edit-owner" @bind="_model.TechnicalOwner" /></label>
    </fieldset>
    </ReviewDisclosure>

    <ReviewDisclosure Text="Consumer runtime identity" CollapseText="Consumer runtime identity" Hint="@IntegrationTemplatePresentation.SectionHint(!new[] { _model.ConsumerLogicalName, _model.ConsumerContainerApp, _model.ConsumerManagedIdentity }.All(string.IsNullOrWhiteSpace), false, optional: true)"
                      TestId="ip-edit-section-consumer-runtime" Class="disclosure-inline">
    <fieldset class="ip-fieldset">
        <legend class="ip-sr">Consumer runtime identity</legend>
        <label class="ip-field">Consumer application (logical) <input class="form-control ip-mono" @bind="_model.ConsumerLogicalName" /></label>
        <label class="ip-field">Container app (optional) <input class="form-control ip-mono" @bind="_model.ConsumerContainerApp" /></label>
        <label class="ip-field">Managed identity (optional) <input class="form-control ip-mono" @bind="_model.ConsumerManagedIdentity" /></label>
    </fieldset>
    </ReviewDisclosure>

    @* Event-stream settings only: an HTTP/API integration has no advanced options, so the section is not rendered at all. *@
    @if (!IsHttpApi)
    {
        <ReviewDisclosure Text="Advanced" CollapseText="Hide advanced" TestId="ip-edit-advanced" Class="disclosure-inline">
            <label class="ip-field">Partition count <input type="number" min="1" class="form-control" @bind="_model.PartitionCount" /></label>
            <label class="ip-field">Retention (days) <input type="number" min="1" class="form-control" @bind="_model.RetentionDays" /></label>
        </ReviewDisclosure>
    }
    @if (!IsNew) { <p class="ip-muted ip-small" data-testid="ip-edit-identity">Id: <code>@_model.Id</code> · Origin: @Original?.Origin@(Original?.TemplateKey is { } templateKey ? $" · template {templateKey}" : "")</p> }
    }

    @* Can I save this now? Configured fields, review items that may stay open, and optional details — immediately above Save. *@
    <section class="ip-save-readiness" data-testid="ip-edit-readiness" aria-labelledby="ip-readiness-heading">
        <h4 id="ip-readiness-heading">@(MissingRequired().Count == 0 ? "Ready to save" : "Not ready to save")</h4>
        <div class="ip-readiness-grid">
            <div>
                <p class="ip-readiness-title">Configured</p>
                <ul class="ip-readiness-list" data-testid="ip-edit-readiness-configured">
                    @foreach (var (label, set, required) in ConfiguredItems())
                    {
                        <li data-set="@(set ? "true" : "false")"><span aria-hidden="true">@(set ? "✓" : required ? "✗" : "–")</span> @label<span class="ip-sr">@(set ? ": set" : required ? ": missing, required" : ": not set")</span>@(!set && required ? " — required" : "")</li>
                    }
                </ul>
            </div>
            @if (_model.Kind is not null)
            {
                <div>
                    <p class="ip-readiness-title">Review remaining</p>
                    <ul class="ip-readiness-list" data-testid="ip-edit-readiness-review">
                        @if (ReviewItems().Count == 0) { <li><span aria-hidden="true">✓</span> Nothing remaining</li> }
                        @foreach (var item in ReviewItems()) { <li><span aria-hidden="true">△</span> @item<span class="ip-sr">: review remaining</span></li> }
                    </ul>
                    @if (ReviewItems().Count > 0) { <button type="button" class="ip-link" data-testid="ip-edit-review-remaining" @onclick="FocusReviewAsync">Review remaining items</button> }
                </div>
                <div>
                    <p class="ip-readiness-title">Optional</p>
                    <ul class="ip-readiness-list" data-testid="ip-edit-readiness-optional">
                        <li>Operations · @(new[] { _model.HealthUrl, _model.WorkerUrl, _model.MonitoringUrl, _model.RunbookUrl }.All(string.IsNullOrWhiteSpace) ? "not set" : "set")</li>
                        <li>Ownership · @(string.IsNullOrWhiteSpace(_model.TechnicalOwner) ? "not set" : "set")</li>
                    </ul>
                </div>
            }
        </div>
        <p class="ip-muted" data-testid="ip-edit-readiness-note">@(MissingRequired().Count > 0
            ? $"Required before saving: {string.Join(", ", MissingRequired())}."
            : ReviewItems().Count > 0 ? "You can save now. Review items keep their current state and can be completed later." : "Everything is configured and reviewed.")</p>
    </section>

    <div class="ip-editor-actions">
        <button type="button" class="btn-primary" data-testid="ip-edit-save" disabled="@_saving" @onclick="SaveAsync">@(IsNew ? "Save integration" : "Save changes")</button>
        <button type="button" class="btn-secondary" data-testid="ip-edit-cancel" @onclick="OnCancel">Cancel</button>
    </div>
</section>

@code {
    private bool IsHttpApi => _model.Kind == IntegrationKind.HttpApi;
    private string EndpointLabel => _model.Kind switch
    {
        IntegrationKind.HttpApi => "Endpoint",
        IntegrationKind.ServiceBus => "Queue / topic",
        IntegrationKind.EventHub => "Event Hub / topic",
        _ => "Endpoint / channel",
    };
    /// <summary>The type as the select shows it: empty until a new integration's type is chosen.</summary>
    private string KindText
    {
        get => _model.Kind?.ToString() ?? "";
        set { _model.Kind = Enum.TryParse<IntegrationKind>(value, out var kind) ? kind : null; ApplyKindDefaults(); }
    }

    /// <summary>The platform defaults a new integration started with (messaging platform and its auth mechanisms) belong to messaging types:
    /// a new HTTP/API integration drops them while they are untouched, and gets them back if the type returns to messaging.</summary>
    private bool _platformDefaultsDropped;
    private void ApplyKindDefaults()
    {
        if (!IsNew || Platforms.FirstOrDefault() is not { } platform) return;
        if (IsHttpApi && _model.PlatformId == platform.Id)
        {
            _model.PlatformId = null;
            if (_model.ProducerAuthentication == platform.ProducerAuthentication) _model.ProducerAuthentication = IntegrationAuthMechanism.NotConfigured;
            if (_model.ConsumerAuthentication == platform.DefaultConsumerAuthentication) _model.ConsumerAuthentication = IntegrationAuthMechanism.NotConfigured;
            _platformDefaultsDropped = true;
        }
        else if (!IsHttpApi && _model.Kind is not null && _platformDefaultsDropped && _model.PlatformId is null)
        {
            _model.PlatformId = platform.Id;
            if (_model.ProducerAuthentication == IntegrationAuthMechanism.NotConfigured) _model.ProducerAuthentication = platform.ProducerAuthentication;
            if (_model.ConsumerAuthentication == IntegrationAuthMechanism.NotConfigured) _model.ConsumerAuthentication = platform.DefaultConsumerAuthentication;
            _platformDefaultsDropped = false;
        }
    }
    [Parameter] public IntegrationDefinition? Original { get; set; }
    [Parameter] public IReadOnlyList<IntegrationPlatform> Platforms { get; set; } = [];
    [Parameter] public EventCallback<IntegrationEditorSave> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    /// <summary>The environment's resolved integration templates (empty: the manual form only).</summary>
    [Parameter] public IReadOnlyList<IntegrationTemplateView> Templates { get; set; } = [];
    /// <summary>The edited integration's canonical evidence binding, if any (shown; never replaced here).</summary>
    [Parameter] public IntegrationEvidenceBinding? Binding { get; set; }

    private IntegrationTemplateView? OriginalTemplate => Original?.TemplateKey is { } key ? Templates.FirstOrDefault(t => t.Key == key) : null;
    private string OriginText => Original?.TemplateKey is { } key
        ? $"Created from template: {OriginalTemplate?.DisplayName ?? key}. Choosing a template here never overwrites saved values without asking."
        : "Custom integration. Choosing a template here never overwrites saved values without asking.";
    private IntegrationTemplateView? CurrentTemplate => _applied ?? OriginalTemplate;
    private TestPackSourceStatus? EvidenceStatus => CurrentTemplate?.EvidenceSource;
    private TemplateEvidenceState EvidenceState => IntegrationTemplatePresentation.Evidence(EvidenceStatus, Binding);
    private IReadOnlyList<TestPackReferenceFact> AuthReference => CurrentTemplate?.AuthenticationReference ?? [];
    private IReadOnlyList<TestPackReferenceFact> ContractReference => CurrentTemplate?.ContractReference ?? [];
    private const string TestPackReferenceLabel = "Test Pack reference";
    private IntegrationTemplatePresentation.SchemaEvidenceState SchemaState => IntegrationTemplatePresentation.SchemaEvidence(CurrentTemplate, EvidenceState, Binding?.SnapshotId);
    /// <summary>The distinct schema files in scope: the bound snapshot's when bound, else every matching snapshot's.</summary>
    private IReadOnlyList<string> SchemaFiles => (CurrentTemplate?.SchemaCandidates ?? [])
        .Where(c => Binding is null || c.SnapshotId == Binding.SnapshotId).Select(c => c.File).Distinct(StringComparer.Ordinal).ToList();

    private static string Short(string fingerprint) => fingerprint.Length > 8 ? $"sha256 {fingerprint[..8]}…" : fingerprint;

    private static RenderFragment ReferenceFacts(IReadOnlyList<TestPackReferenceFact> facts, string testId) => __builder =>
    {
        <dl class="ip-template-facts">
            @foreach (var fact in facts) { <div data-testid="@testId" data-label="@fact.Label"><dt>@fact.Label</dt><dd class="ip-wrap">@fact.Value</dd></div> }
        </dl>
    };

    private bool IsNew => Original is null;
    private Model _model = new();
    private readonly HashSet<string> _touched = [];
    private bool _attempted;
    private bool _saving;
    private IReadOnlyList<string> _errors = [];
    private ElementReference _templateSelect;
    private ElementReference _nameInput;
    private ElementReference _confirmFocus;
    private bool _focusConfirm;
    /// <summary>The template whose values are in the form (null: manual), what the form itself wrote (template values, platform defaults —
    /// never a person's input) and where each written value came from.</summary>
    private IntegrationTemplateView? _applied;
    private string _selectedKey = "";
    private string _previousKey = "";
    private readonly Dictionary<string, string> _prefilled = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _provenance = new(StringComparer.Ordinal);
    private sealed record PendingTemplate(IntegrationTemplateView Template, IReadOnlyList<string> Conflicts);
    private PendingTemplate? _pending;
    /// <summary>The snapshot a person explicitly chose to bind on save (never preselected, never the newest by default).</summary>
    private Guid? _evidenceChoice;

    protected override void OnParametersSet()
    {
        if (_model.SourceOriginal == Original && _model.Initialized) return;
        _model = Model.From(Original, Platforms.FirstOrDefault());
        _prefilled.Clear();
        _provenance.Clear();
        if (IsNew && _model.Producer is { Length: > 0 } platformProducer) _prefilled["Producer"] = platformProducer;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender) await (Templates.Count > 0 ? _templateSelect : _nameInput).FocusAsync();
            if (_focusConfirm) { _focusConfirm = false; await _confirmFocus.FocusAsync(); }
        }
        catch (Exception ex) when (ex is InvalidOperationException or Microsoft.JSInterop.JSException) { }
    }

    private Dictionary<string, string?> Current() => IntegrationTemplatePresentation.Fields.ToDictionary(field => field, _model.Get, StringComparer.Ordinal);

    private void OnTemplateChanged(ChangeEventArgs e)
    {
        _previousKey = _selectedKey;
        _selectedKey = e.Value?.ToString() ?? "";
        _pending = null;
        if (Templates.FirstOrDefault(t => t.Key == _selectedKey) is not { } template) { ClearTemplate(); return; }
        var conflicts = IntegrationTemplatePresentation.Conflicts(Current(), _prefilled, template);
        if (conflicts.Count == 0) Apply(template, TemplateApplyMode.WhereEmpty);
        else { _pending = new(template, conflicts); _focusConfirm = true; }
    }

    private void ResolvePending(TemplateApplyMode mode)
    {
        if (_pending is not { } pending) return;
        _pending = null;
        if (mode == TemplateApplyMode.KeepMine) { _selectedKey = _previousKey; return; }
        Apply(pending.Template, mode);
    }

    private void Apply(IntegrationTemplateView template, TemplateApplyMode mode)
    {
        // Values the previous template wrote (and nobody changed since) belong to that template, not to the person.
        if (_applied is not null && _applied.Key != template.Key) RemoveTemplateValues();
        foreach (var (field, value) in IntegrationTemplatePresentation.Apply(Current(), _prefilled, template, mode))
        {
            _model.Set(field, value);
            _prefilled[field] = value;
            _provenance[field] = IntegrationTemplatePresentation.Value(template, field)?.Provenance ?? "Template";
        }
        _applied = template;
        ApplyKindDefaults();
        if (_evidenceChoice is { } chosen && template.EvidenceSource?.Candidates.Any(c => c.SnapshotId == chosen) != true) _evidenceChoice = null;
        if (_attempted) Revalidate();
    }

    /// <summary>Manual / custom: the template's untouched values leave with it; anything a person typed stays.</summary>
    private void ClearTemplate()
    {
        RemoveTemplateValues();
        _applied = null;
        _evidenceChoice = null;
        if (_attempted) Revalidate();
    }

    private void RemoveTemplateValues()
    {
        foreach (var field in _provenance.Keys.ToList())
        {
            if (_prefilled.TryGetValue(field, out var written) && _model.Get(field) == written) _model.Set(field, null);
            _prefilled.Remove(field);
            _provenance.Remove(field);
        }
    }

    private void ToggleEvidence(Guid snapshotId) => _evidenceChoice = _evidenceChoice == snapshotId ? null : snapshotId;

    /// <summary>Whether a field still holds exactly the value the template wrote (a person has not changed it).</summary>
    private bool Prefilled(string field) => _provenance.ContainsKey(field) && _prefilled.TryGetValue(field, out var written) && _model.Get(field) == written;

    /// <summary>"Prefilled from template" once per section while any of its fields still holds the template's value — never under every field.</summary>
    private RenderFragment SectionPrefill(params string[] fields) => builder =>
    {
        var prefilled = fields.Where(Prefilled).ToList();
        if (prefilled.Count == 0) return;
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "ip-prov ip-prov-section");
        builder.AddAttribute(2, "data-testid", "ip-section-prefill");
        builder.AddAttribute(3, "title", $"Prefilled from template: {string.Join(", ", prefilled.Select(IntegrationTemplatePresentation.FieldLabel))}. Every value stays editable.");
        builder.AddContent(4, "Prefilled from template");
        builder.CloseElement();
    };

    /// <summary>A field the template cannot fill for this environment says so; a filled field carries no per-field provenance (the section does).</summary>
    private RenderFragment Provenance(string field) => builder =>
    {
        if (_applied?.NeedsConfiguration.Contains(field) == true && string.IsNullOrWhiteSpace(_model.Get(field)))
        {
            builder.OpenElement(5, "span");
            builder.AddAttribute(6, "class", "ip-prov ip-prov-needs");
            builder.AddAttribute(7, "data-testid", "ip-needs-config");
            builder.AddAttribute(8, "data-field", field);
            builder.AddContent(9, "Needs configuration — not known for this environment");
            builder.CloseElement();
        }
    };

    // ── Review needed, readiness and contract helpers ───────────────────────────────────────────────────────────────────────

    private ElementReference _reviewSection;
    /// <summary>The full source list is shown on request when one source is recommended (always when none is).</summary>
    private bool _chooseEvidence;

    private async Task FocusReviewAsync()
    {
        try { await _reviewSection.FocusAsync(); } catch (Exception ex) when (ex is InvalidOperationException or Microsoft.JSInterop.JSException) { }
    }

    /// <summary>Required configuration that is missing (by label). Save is blocked only by these.</summary>
    private IReadOnlyList<string> MissingRequired()
    {
        var missing = new List<string>();
        if (string.IsNullOrWhiteSpace(_model.DisplayName)) missing.Add("Display name");
        if (_model.Kind is null) missing.Add("Type");
        else if (string.IsNullOrWhiteSpace(_model.EndpointOrTopic)) missing.Add(EndpointLabel);
        return missing;
    }

    private IEnumerable<(string Label, bool Set, bool Required)> ConfiguredItems()
    {
        yield return ("Display name", !string.IsNullOrWhiteSpace(_model.DisplayName), true);
        yield return ("Type", _model.Kind is not null, true);
        if (_model.Kind is null) yield break;
        yield return (EndpointLabel, !string.IsNullOrWhiteSpace(_model.EndpointOrTopic), true);
        yield return ("Producer", !string.IsNullOrWhiteSpace(_model.Producer), false);
        yield return ("Consumer", !string.IsNullOrWhiteSpace(_model.ConsumerName), false);
    }

    /// <summary>
    /// Review decisions still open. They never block saving and keep their state when saved: an unconfirmed mapping stays unconfirmed, an
    /// unbound source keeps source-based review Not assessed, an unconfirmed contract relationship stays unconfirmed.
    /// </summary>
    private IReadOnlyList<string> ReviewItems()
    {
        if (_model.Kind is null) return [];
        var items = new List<string>();
        if (_model.MappingState != ConsumerMappingState.Confirmed) items.Add("Consumer mapping");
        if (Binding is null && _evidenceChoice is null && EvidenceStatus is { } status && IntegrationTemplatePresentation.Choices(status).Count > 0) items.Add("Source evidence");
        if (_model.ContractRelationship != ContractRelationshipState.RelationshipVerified
            && (ContractReference.Count > 0 || SchemaState != IntegrationTemplatePresentation.SchemaEvidenceState.NotApplicable
                || !string.IsNullOrWhiteSpace(_model.ProducerContractReference) || !string.IsNullOrWhiteSpace(_model.ConsumerContractReference)))
            items.Add("Contract relationship");
        return items;
    }

    /// <summary>Why the consumer is proposed, in words: the template's flow, the saved record's own mapping source, or this form.</summary>
    private string MappingWhy => string.IsNullOrWhiteSpace(_model.ConsumerName)
        ? "No consumer is set yet. Add it under Connection."
        : _model.MappingState == ConsumerMappingState.Confirmed
            ? Original?.Consumer.MappingState == ConsumerMappingState.Confirmed && Original.Consumer.DisplayName == _model.ConsumerName.Trim()
                ? Original.Consumer.MappingSource ?? "Confirmed earlier for this environment."
                : "You confirmed this mapping; it is recorded when the integration is saved."
        : Prefilled("Consumer") && CurrentTemplate is { } template
            ? $"The {template.DisplayName} template flow identifies {_model.ConsumerName} as the consumer, but the mapping has not been explicitly confirmed."
        : Original?.Consumer.MappingSource is { Length: > 0 } source && Original.Consumer.DisplayName == _model.ConsumerName.Trim()
            ? source
            : "Entered in this form; not yet confirmed for this environment.";

    private string EvidenceBadge => Binding is null && _applied is null && OriginalTemplate is null ? "Not bound"
        : Binding is null && _evidenceChoice is not null ? "Selected · binds on save"
        : IntegrationTemplatePresentation.Label(EvidenceState);

    /// <summary>
    /// A source is recommended only on evidence relevance: it is the single snapshot recognized as the source on the most content matches
    /// (components, projects, configuration, API names). Equal evidence means no recommendation. The analysis date never decides.
    /// </summary>
    private static TestPackSourceCandidate? Recommended(IReadOnlyList<TestPackSourceCandidate> choices)
    {
        if (choices.Count < 2) return null;
        var best = choices.Max(c => c.MatchedOn.Count);
        var top = choices.Where(c => c.MatchedOn.Count == best).ToList();
        return best > 0 && top.Count == 1 ? top[0] : null;
    }

    private string? ReferenceDataLabel => (AuthReference.Count > 0, ContractReference.Count > 0) switch
    {
        (true, true) => "Authentication and submission contract references available",
        (true, false) => "Authentication reference available",
        (false, true) => "Submission contract reference available",
        _ => null,
    };

    private static string AuthOption(IntegrationAuthMechanism mechanism) =>
        mechanism == IntegrationAuthMechanism.NotConfigured ? "Not set" : IntegrationConfigurationRules.AuthLabel(mechanism);

    /// <summary>What the selected contract references support, before any confirmation.</summary>
    private ContractRelationshipState DerivedContractState =>
        (string.IsNullOrWhiteSpace(_model.ProducerContractReference), string.IsNullOrWhiteSpace(_model.ConsumerContractReference)) switch
        {
            (false, false) => ContractRelationshipState.BothContractsAvailable,
            (false, true) => ContractRelationshipState.ProducerContractAvailable,
            (true, false) => ContractRelationshipState.ConsumerContractAvailable,
            _ => ContractRelationshipState.NotConfigured,
        };

    private string ContractStateLabel => _model.ContractRelationship switch
    {
        ContractRelationshipState.RelationshipVerified => "Relationship confirmed",
        _ when ContractReference.Count == 0 && SchemaState == IntegrationTemplatePresentation.SchemaEvidenceState.NotApplicable && DerivedContractState == ContractRelationshipState.NotConfigured => "No contracts selected",
        _ => "Not confirmed",
    };

    /// <summary>A contract reference changed: a confirmation no longer applies to the new pair, and the state follows what is now selected.</summary>
    private void SetContractReference(bool producer, string? value)
    {
        var clean = string.IsNullOrWhiteSpace(value) ? null : value.Trim();
        if (producer) _model.ProducerContractReference = clean; else _model.ConsumerContractReference = clean;
        _model.ContractRelationship = DerivedContractState;
    }

    /// <summary>The declared submission contract (Test Pack reference) offered as the producer side.</summary>
    private IReadOnlyList<(string Value, string Origin)> ProducerContractCandidates =>
        CurrentTemplate?.SchemaName is { Length: > 0 } declared ? [(declared, TestPackReferenceLabel)] : [];

    /// <summary>Matching schema files in the evidence source offered as the consumer side (never chosen for you).</summary>
    private IReadOnlyList<(string Value, string Origin)> ConsumerContractCandidates =>
        CurrentTemplate?.EvidenceSource is { } source ? [.. SchemaFiles.Select(file => (file, $"{source.Role.Label} Source Analysis"))] : [];

    /// <summary>A contract picker: known candidates first, manual entry secondary. Choosing writes the draft only.</summary>
    private RenderFragment ContractPicker(string label, string? current, IReadOnlyList<(string Value, string Origin)> candidates, Action<string?> set, string testId) => __builder =>
    {
        <div class="ip-contract-picker" data-testid="@testId">
            <p><strong>@label</strong>: <span class="ip-wrap ip-mono" data-testid="@($"{testId}-value")">@(string.IsNullOrWhiteSpace(current) ? "Not selected" : current)</span></p>
            @foreach (var (value, origin) in candidates.Where(c => !string.Equals(c.Value, current, StringComparison.Ordinal)))
            {
                <button type="button" class="btn-secondary ip-btn-sm" data-testid="@($"{testId}-use")" @onclick="() => set(value)">Select <span class="ip-wrap">@value</span> <span class="ip-muted">(@origin)</span></button>
            }
            @if (!string.IsNullOrWhiteSpace(current)) { <button type="button" class="ip-link" data-testid="@($"{testId}-clear")" @onclick="() => set(null)">Clear</button> }
            <ReviewDisclosure Text="Enter manually" CollapseText="Hide manual entry" TestId="@($"{testId}-manual")" Class="disclosure-inline disclosure-small">
                <label class="ip-field">@label reference
                    <input class="form-control ip-mono" data-testid="@($"{testId}-input")" value="@current" @onchange="e => set(e.Value?.ToString())" />
                </label>
            </ReviewDisclosure>
        </div>
    };

    private void Revalidate() =>
        _errors = _model.Kind is null
            ? [.. string.IsNullOrWhiteSpace(_model.DisplayName) ? new[] { "Display name is required." } : [], "Type is required: choose what kind of integration this is."]
            : IntegrationsPanePresentation.Validate(_model.ToDefinition(Original, _applied, IsNew));

    private void Touch(string field) => _touched.Add(field);
    private bool Show(string field) => _attempted || _touched.Contains(field);
    private string Invalid(string field, bool invalid) => Show(field) && invalid ? "true" : "false";
    private IEnumerable<string> UrlErrors() => _model.Kind is null ? [] : IntegrationsPanePresentation.Validate(_model.ToDefinition(Original, _applied, IsNew)).Where(e => e.Contains("URL"));

    private async Task SaveAsync()
    {
        _attempted = true;
        Revalidate();
        if (_model.Kind is null || _errors.Count > 0) return;
        var definition = _model.ToDefinition(Original, _applied, IsNew);
        var archive = _evidenceChoice is { } chosen ? EvidenceStatus?.Candidates.FirstOrDefault(c => c.SnapshotId == chosen)?.ArchiveFileName : null;
        _saving = true;
        try { await OnSave.InvokeAsync(new IntegrationEditorSave(definition, Binding is null && archive is not null ? _evidenceChoice : null, archive) { ReviewRemaining = ReviewItems() }); }
        finally { _saving = false; }
    }

    /// <summary>Mutable editing copy of the immutable record.</summary>
    private sealed class Model
    {
        public bool Initialized { get; set; }
        public IntegrationDefinition? SourceOriginal { get; set; }
        public string Id { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public bool Enabled { get; set; } = true;
        /// <summary>Null for a new integration until the person chooses a type (never silently Event Hub).</summary>
        public IntegrationKind? Kind { get; set; }
        public string? SystemName { get; set; }
        public string? PlatformId { get; set; }
        public string? EndpointOrTopic { get; set; }
        public string? ConsumerGroup { get; set; }
        public string? Producer { get; set; }
        public string? SourceResource { get; set; }
        public string? SourceSystem { get; set; }
        public string? DestinationSystem { get; set; }
        public string? ConsumerName { get; set; }
        public ConsumerMappingState MappingState { get; set; } = ConsumerMappingState.NeedsConfirmation;
        public string? ConsumerLogicalName { get; set; }
        public string? ConsumerContainerApp { get; set; }
        public string? ConsumerManagedIdentity { get; set; }
        public IntegrationAuthMechanism ProducerAuthentication { get; set; }
        public IntegrationAuthMechanism ConsumerAuthentication { get; set; }
        public ContractRelationshipState ContractRelationship { get; set; }
        public string? ProducerContractReference { get; set; }
        public string? ConsumerContractReference { get; set; }
        public string? HealthUrl { get; set; }
        public string? WorkerUrl { get; set; }
        public string? MonitoringUrl { get; set; }
        public string? RunbookUrl { get; set; }
        public string? TechnicalOwner { get; set; }
        public int? PartitionCount { get; set; }
        public int? RetentionDays { get; set; }
        public CdcDeleteExpectation DeleteExpectation { get; set; }

        /// <summary>A new integration starts from the environment's platform defaults (auth mechanisms), never from a guessed topic or consumer.</summary>
        public static Model From(IntegrationDefinition? d, IntegrationPlatform? platform) => d is null
            ? new Model
            {
                Initialized = true, PlatformId = platform?.Id,
                ProducerAuthentication = platform?.ProducerAuthentication ?? IntegrationAuthMechanism.NotConfigured,
                ConsumerAuthentication = platform?.DefaultConsumerAuthentication ?? IntegrationAuthMechanism.NotConfigured,
                Producer = platform?.ProducerTechnology,
            }
            : new Model
            {
                Initialized = true, SourceOriginal = d, Id = d.Id, DisplayName = d.DisplayName, Enabled = d.Enabled, Kind = d.Kind, SystemName = d.SystemName, PlatformId = d.PlatformId,
                EndpointOrTopic = d.EndpointOrTopic, ConsumerGroup = d.ConsumerGroup, Producer = d.Producer, SourceResource = d.SourceResource,
                SourceSystem = d.SourceSystem, DestinationSystem = d.DestinationSystem,
                ConsumerName = d.Consumer.DisplayName, MappingState = d.Consumer.MappingState, ConsumerLogicalName = d.Consumer.LogicalName,
                ConsumerContainerApp = d.Consumer.ContainerApp, ConsumerManagedIdentity = d.Consumer.ManagedIdentity,
                ProducerAuthentication = d.ProducerAuthentication, ConsumerAuthentication = d.ConsumerAuthentication, ContractRelationship = d.ContractRelationship,
                ProducerContractReference = d.ProducerContractReference, ConsumerContractReference = d.ConsumerContractReference,
                HealthUrl = d.HealthUrl, WorkerUrl = d.WorkerUrl, MonitoringUrl = d.MonitoringUrl, RunbookUrl = d.RunbookUrl, TechnicalOwner = d.TechnicalOwner,
                PartitionCount = d.PartitionCount, RetentionDays = d.RetentionDays, DeleteExpectation = d.DeleteExpectation,
            };

        private static string? Clean(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

        /// <summary>A template-fillable field by name (see <see cref="IntegrationTemplatePresentation.Fields"/>).</summary>
        public string? Get(string field) => field switch
        {
            "DisplayName" => DisplayName, "Kind" => Kind?.ToString(), "SystemName" => SystemName, "EndpointOrTopic" => EndpointOrTopic, "Producer" => Producer,
            "SourceResource" => SourceResource, "Consumer" => ConsumerName, "SourceSystem" => SourceSystem, "DestinationSystem" => DestinationSystem, _ => null,
        };

        public void Set(string field, string? value)
        {
            switch (field)
            {
                case "DisplayName": DisplayName = value ?? ""; break;
                case "Kind": Kind = Enum.TryParse<IntegrationKind>(value, out var kind) ? kind : null; break;
                case "SystemName": SystemName = value; break;
                case "EndpointOrTopic": EndpointOrTopic = value; break;
                case "Producer": Producer = value; break;
                case "SourceResource": SourceResource = value; break;
                case "Consumer": ConsumerName = value; break;
                case "SourceSystem": SourceSystem = value; break;
                case "DestinationSystem": DestinationSystem = value; break;
            }
        }

        /// <summary>A new record created with a template keeps it as its origin (setup guidance only; a later template version never rewrites it).</summary>
        public IntegrationDefinition ToDefinition(IntegrationDefinition? original, IntegrationTemplateView? template, bool isNew) => (original ?? new IntegrationDefinition()) with
        {
            DisplayName = DisplayName.Trim(), Enabled = Enabled, Kind = Kind ?? IntegrationKind.EventHub, SystemName = Clean(SystemName), PlatformId = Clean(PlatformId),
            EndpointOrTopic = Clean(EndpointOrTopic), ConsumerGroup = Clean(ConsumerGroup), Producer = Clean(Producer), SourceResource = Clean(SourceResource),
            SourceSystem = Clean(SourceSystem), DestinationSystem = Clean(DestinationSystem),
            Origin = isNew && template is not null ? IntegrationRecordOrigin.Template : original?.Origin ?? IntegrationRecordOrigin.Manual,
            TemplateKey = isNew ? template?.Key : original?.TemplateKey,
            Consumer = new IntegrationConsumer
            {
                DisplayName = Clean(ConsumerName), LogicalName = Clean(ConsumerLogicalName), ContainerApp = Clean(ConsumerContainerApp), ManagedIdentity = Clean(ConsumerManagedIdentity),
                MappingState = Clean(ConsumerName) is null ? ConsumerMappingState.NeedsConfirmation : MappingState,
                MappingSource = original?.Consumer.MappingState == MappingState && original.Consumer.DisplayName == Clean(ConsumerName) ? original.Consumer.MappingSource
                    : MappingState == ConsumerMappingState.Confirmed ? "Confirmed in Target Environment → Integrations" : original?.Consumer.MappingSource,
                MappingEvidence = original?.Consumer.MappingState == MappingState && original.Consumer.DisplayName == Clean(ConsumerName) ? original.Consumer.MappingEvidence
                    : MappingState == ConsumerMappingState.Confirmed ? "Confirmed by a person in BirkNext Integrations" : null,
                MappingConfirmedAt = original?.Consumer.MappingState == MappingState && original.Consumer.DisplayName == Clean(ConsumerName) ? original.Consumer.MappingConfirmedAt
                    : MappingState == ConsumerMappingState.Confirmed ? DateTimeOffset.UtcNow : null,
            },
            ProducerAuthentication = ProducerAuthentication, ConsumerAuthentication = ConsumerAuthentication, ContractRelationship = ContractRelationship,
            ProducerContractReference = Clean(ProducerContractReference), ConsumerContractReference = Clean(ConsumerContractReference),
            HealthUrl = Clean(HealthUrl), WorkerUrl = Clean(WorkerUrl), MonitoringUrl = Clean(MonitoringUrl), RunbookUrl = Clean(RunbookUrl), TechnicalOwner = Clean(TechnicalOwner),
            PartitionCount = PartitionCount, RetentionDays = RetentionDays, DeleteExpectation = DeleteExpectation,
        };
    }
}
