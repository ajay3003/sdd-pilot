@using BirkNext.Integrations
@using BirkNext.Web.Services

@* Add / Edit one configured integration. Opened only on "+ Add integration" or "Edit". Nothing secret is entered here:
   authentication is a mechanism, never a key or connection string. Validation appears on blur and on save — an untouched
   form never opens with "Configuration incomplete". *@
<section class="ip-editor" data-testid="ip-editor" aria-labelledby="ip-editor-heading">
    <h3 id="ip-editor-heading">@(IsNew ? "Add integration" : $"Edit {_model.DisplayName}")</h3>
    <p class="ip-muted">Fields marked <span aria-hidden="true">*</span><span class="ip-sr">with an asterisk</span> are required.</p>

    @if (_attempted && _errors.Count > 0)
    {
        <div class="ip-error-summary" role="alert" data-testid="ip-editor-errors">
            <strong>Fix @_errors.Count @(_errors.Count == 1 ? "field" : "fields") before saving:</strong>
            <ul>@foreach (var e in _errors) { <li>@e</li> }</ul>
        </div>
    }

    <fieldset class="ip-fieldset">
        <legend>A. Integration</legend>
        <label class="ip-field">Display name <span aria-hidden="true">*</span>
            <input class="form-control" data-testid="ip-edit-name" @bind="_model.DisplayName" @bind:event="oninput" @onblur='() => Touch("name")' aria-required="true" aria-invalid="@Invalid("name", string.IsNullOrWhiteSpace(_model.DisplayName))" />
        </label>
        @if (Show("name") && string.IsNullOrWhiteSpace(_model.DisplayName)) { <span class="ip-field-error" role="status">Display name is required.</span> }
        <label class="ip-check"><input type="checkbox" data-testid="ip-edit-enabled" @bind="_model.Enabled" /> Enabled</label>
        <label class="ip-field">Type <span aria-hidden="true">*</span>
            <select class="form-control" data-testid="ip-edit-kind" @bind="_model.Kind">
                @foreach (var kind in Enum.GetValues<IntegrationKind>()) { <option value="@kind">@IntegrationConfigurationRules.KindLabel(kind)</option> }
            </select>
        </label>
        @if (_model.Kind != IntegrationKind.EventHub)
        {
            <p class="ip-muted" data-testid="ip-edit-kind-note">Integration Quality Review assesses configuration for this type; its domain review is not implemented yet.</p>
        }
        <label class="ip-field">Integration system
            <input class="form-control" @bind="_model.SystemName" placeholder="e.g. BIRK CDC / Debezium" />
        </label>
    </fieldset>

    <fieldset class="ip-fieldset">
        <legend>B. Messaging endpoint</legend>
        <label class="ip-field">Platform
            <select class="form-control" data-testid="ip-edit-platform" @bind="_model.PlatformId">
                <option value="">None</option>
                @foreach (var p in Platforms) { <option value="@p.Id">@p.Name</option> }
            </select>
        </label>
        <label class="ip-field">@(_model.Kind == IntegrationKind.HttpApi ? "Endpoint" : "Event Hub / topic") <span aria-hidden="true">*</span>
            <input class="form-control ip-mono" data-testid="ip-edit-topic" @bind="_model.EndpointOrTopic" @bind:event="oninput" @onblur='() => Touch("topic")' aria-required="true" aria-invalid="@Invalid("topic", string.IsNullOrWhiteSpace(_model.EndpointOrTopic))" />
        </label>
        @if (Show("topic") && string.IsNullOrWhiteSpace(_model.EndpointOrTopic)) { <span class="ip-field-error" role="status">This field is required.</span> }
        <label class="ip-field">Consumer group
            <input class="form-control ip-mono" data-testid="ip-edit-consumer-group" @bind="_model.ConsumerGroup" placeholder="Unknown / not configured" />
        </label>
        <p class="ip-muted">Leave empty when unknown. <code>$Default</code> is never assumed; only checkpoint/lag review needs it.</p>
    </fieldset>

    <fieldset class="ip-fieldset">
        <legend>C. Flow</legend>
        <label class="ip-field">Producer <input class="form-control" data-testid="ip-edit-producer" @bind="_model.Producer" /></label>
        <label class="ip-field">Source <input class="form-control ip-mono" @bind="_model.SourceResource" placeholder="e.g. BirkM2LB.dbo.Person" /></label>
        <label class="ip-field">Consumer <input class="form-control" data-testid="ip-edit-consumer" @bind="_model.ConsumerName" /></label>
        <label class="ip-field">Consumer mapping
            <select class="form-control" data-testid="ip-edit-mapping" @bind="_model.MappingState">
                @foreach (var m in Enum.GetValues<ConsumerMappingState>()) { <option value="@m">@IntegrationConfigurationRules.MappingLabel(m)</option> }
            </select>
        </label>
        <label class="ip-field">Consumer application (logical) <input class="form-control ip-mono" @bind="_model.ConsumerLogicalName" /></label>
        <label class="ip-field">Container app <input class="form-control ip-mono" @bind="_model.ConsumerContainerApp" /></label>
        <label class="ip-field">Managed identity <input class="form-control ip-mono" @bind="_model.ConsumerManagedIdentity" /></label>
    </fieldset>

    <fieldset class="ip-fieldset">
        <legend>D. Authentication</legend>
        <p class="ip-muted">The mechanism only — never a key, connection string or secret.</p>
        <label class="ip-field">Producer authentication
            <select class="form-control" data-testid="ip-edit-producer-auth" @bind="_model.ProducerAuthentication">
                @foreach (var a in Enum.GetValues<IntegrationAuthMechanism>()) { <option value="@a">@IntegrationConfigurationRules.AuthLabel(a)</option> }
            </select>
        </label>
        <label class="ip-field">Consumer authentication
            <select class="form-control" data-testid="ip-edit-consumer-auth" @bind="_model.ConsumerAuthentication">
                @foreach (var a in Enum.GetValues<IntegrationAuthMechanism>()) { <option value="@a">@IntegrationConfigurationRules.AuthLabel(a)</option> }
            </select>
        </label>
    </fieldset>

    <fieldset class="ip-fieldset">
        <legend>E. Contract</legend>
        <label class="ip-field">Contract relationship
            <select class="form-control" data-testid="ip-edit-contract" @bind="_model.ContractRelationship">
                @foreach (var c in Enum.GetValues<ContractRelationshipState>()) { <option value="@c">@ContractLabel(c)</option> }
            </select>
        </label>
        <label class="ip-field">Producer contract reference <input class="form-control ip-mono" @bind="_model.ProducerContractReference" /></label>
        <label class="ip-field">Consumer contract reference <input class="form-control ip-mono" @bind="_model.ConsumerContractReference" /></label>
    </fieldset>

    <fieldset class="ip-fieldset">
        <legend>F. Operations</legend>
        <label class="ip-field">Health URL <input class="form-control ip-mono" @bind="_model.HealthUrl" @onblur='() => Touch("urls")' /></label>
        <label class="ip-field">Worker URL <input class="form-control ip-mono" @bind="_model.WorkerUrl" @onblur='() => Touch("urls")' /></label>
        <label class="ip-field">Monitoring URL <input class="form-control ip-mono" @bind="_model.MonitoringUrl" @onblur='() => Touch("urls")' /></label>
        <label class="ip-field">Runbook URL <input class="form-control ip-mono" @bind="_model.RunbookUrl" @onblur='() => Touch("urls")' /></label>
        @if (Show("urls") && UrlErrors().ToList() is { Count: > 0 } urlErrors) { <span class="ip-field-error" role="status">@string.Join(" ", urlErrors)</span> }
    </fieldset>

    <fieldset class="ip-fieldset">
        <legend>G. Ownership</legend>
        <label class="ip-field">Technical owner <input class="form-control" @bind="_model.TechnicalOwner" /></label>
    </fieldset>

    <ReviewDisclosure Text="H. Advanced" CollapseText="Hide advanced" TestId="ip-edit-advanced" Class="disclosure-inline">
        <label class="ip-field">Partition count <input type="number" min="1" class="form-control" @bind="_model.PartitionCount" /></label>
        <label class="ip-field">Retention (days) <input type="number" min="1" class="form-control" @bind="_model.RetentionDays" /></label>
        @if (!IsNew) { <p class="ip-muted">Id: <code>@_model.Id</code> · Origin: @Original?.Origin</p> }
    </ReviewDisclosure>

    <div class="ip-editor-actions">
        <button type="button" class="btn-primary" data-testid="ip-edit-save" disabled="@_saving" @onclick="SaveAsync">@(IsNew ? "Add integration" : "Save changes")</button>
        <button type="button" class="btn-secondary" data-testid="ip-edit-cancel" @onclick="OnCancel">Cancel</button>
    </div>
</section>

@code {
    [Parameter] public IntegrationDefinition? Original { get; set; }
    [Parameter] public IReadOnlyList<IntegrationPlatform> Platforms { get; set; } = [];
    [Parameter] public EventCallback<IntegrationDefinition> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private bool IsNew => Original is null;
    private Model _model = new();
    private readonly HashSet<string> _touched = [];
    private bool _attempted;
    private bool _saving;
    private IReadOnlyList<string> _errors = [];

    protected override void OnParametersSet()
    {
        if (_model.SourceOriginal == Original && _model.Initialized) return;
        _model = Model.From(Original, Platforms.FirstOrDefault());
    }

    private void Touch(string field) => _touched.Add(field);
    private bool Show(string field) => _attempted || _touched.Contains(field);
    private string Invalid(string field, bool invalid) => Show(field) && invalid ? "true" : "false";
    private IEnumerable<string> UrlErrors() => IntegrationsPanePresentation.Validate(_model.ToDefinition(Original)).Where(e => e.Contains("URL"));

    private async Task SaveAsync()
    {
        _attempted = true;
        var definition = _model.ToDefinition(Original);
        _errors = IntegrationsPanePresentation.Validate(definition);
        if (_errors.Count > 0) return;
        _saving = true;
        try { await OnSave.InvokeAsync(definition); }
        finally { _saving = false; }
    }

    private static string ContractLabel(ContractRelationshipState state) => state switch
    {
        ContractRelationshipState.NotConfigured => "Not configured",
        ContractRelationshipState.ProducerContractAvailable => "Producer contract available",
        ContractRelationshipState.ConsumerContractAvailable => "Consumer contract available",
        ContractRelationshipState.BothContractsAvailable => "Both contracts available",
        _ => "Relationship verified",
    };

    /// <summary>Mutable editing copy of the immutable record.</summary>
    private sealed class Model
    {
        public bool Initialized { get; set; }
        public IntegrationDefinition? SourceOriginal { get; set; }
        public string Id { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public bool Enabled { get; set; } = true;
        public IntegrationKind Kind { get; set; } = IntegrationKind.EventHub;
        public string? SystemName { get; set; }
        public string? PlatformId { get; set; }
        public string? EndpointOrTopic { get; set; }
        public string? ConsumerGroup { get; set; }
        public string? Producer { get; set; }
        public string? SourceResource { get; set; }
        public string? ConsumerName { get; set; }
        public ConsumerMappingState MappingState { get; set; } = ConsumerMappingState.NeedsConfirmation;
        public string? ConsumerLogicalName { get; set; }
        public string? ConsumerContainerApp { get; set; }
        public string? ConsumerManagedIdentity { get; set; }
        public IntegrationAuthMechanism ProducerAuthentication { get; set; }
        public IntegrationAuthMechanism ConsumerAuthentication { get; set; }
        public ContractRelationshipState ContractRelationship { get; set; }
        public string? ProducerContractReference { get; set; }
        public string? ConsumerContractReference { get; set; }
        public string? HealthUrl { get; set; }
        public string? WorkerUrl { get; set; }
        public string? MonitoringUrl { get; set; }
        public string? RunbookUrl { get; set; }
        public string? TechnicalOwner { get; set; }
        public int? PartitionCount { get; set; }
        public int? RetentionDays { get; set; }

        /// <summary>A new integration starts from the environment's platform defaults (auth mechanisms), never from a guessed topic or consumer.</summary>
        public static Model From(IntegrationDefinition? d, IntegrationPlatform? platform) => d is null
            ? new Model
            {
                Initialized = true, PlatformId = platform?.Id,
                ProducerAuthentication = platform?.ProducerAuthentication ?? IntegrationAuthMechanism.NotConfigured,
                ConsumerAuthentication = platform?.DefaultConsumerAuthentication ?? IntegrationAuthMechanism.NotConfigured,
                Producer = platform?.ProducerTechnology,
            }
            : new Model
            {
                Initialized = true, SourceOriginal = d, Id = d.Id, DisplayName = d.DisplayName, Enabled = d.Enabled, Kind = d.Kind, SystemName = d.SystemName, PlatformId = d.PlatformId,
                EndpointOrTopic = d.EndpointOrTopic, ConsumerGroup = d.ConsumerGroup, Producer = d.Producer, SourceResource = d.SourceResource,
                ConsumerName = d.Consumer.DisplayName, MappingState = d.Consumer.MappingState, ConsumerLogicalName = d.Consumer.LogicalName,
                ConsumerContainerApp = d.Consumer.ContainerApp, ConsumerManagedIdentity = d.Consumer.ManagedIdentity,
                ProducerAuthentication = d.ProducerAuthentication, ConsumerAuthentication = d.ConsumerAuthentication, ContractRelationship = d.ContractRelationship,
                ProducerContractReference = d.ProducerContractReference, ConsumerContractReference = d.ConsumerContractReference,
                HealthUrl = d.HealthUrl, WorkerUrl = d.WorkerUrl, MonitoringUrl = d.MonitoringUrl, RunbookUrl = d.RunbookUrl, TechnicalOwner = d.TechnicalOwner,
                PartitionCount = d.PartitionCount, RetentionDays = d.RetentionDays,
            };

        private static string? Clean(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

        public IntegrationDefinition ToDefinition(IntegrationDefinition? original) => (original ?? new IntegrationDefinition()) with
        {
            DisplayName = DisplayName.Trim(), Enabled = Enabled, Kind = Kind, SystemName = Clean(SystemName), PlatformId = Clean(PlatformId),
            EndpointOrTopic = Clean(EndpointOrTopic), ConsumerGroup = Clean(ConsumerGroup), Producer = Clean(Producer), SourceResource = Clean(SourceResource),
            Consumer = new IntegrationConsumer
            {
                DisplayName = Clean(ConsumerName), LogicalName = Clean(ConsumerLogicalName), ContainerApp = Clean(ConsumerContainerApp), ManagedIdentity = Clean(ConsumerManagedIdentity),
                MappingState = Clean(ConsumerName) is null ? ConsumerMappingState.NeedsConfirmation : MappingState,
                MappingSource = original?.Consumer.MappingState == MappingState && original.Consumer.DisplayName == Clean(ConsumerName) ? original.Consumer.MappingSource
                    : MappingState == ConsumerMappingState.Confirmed ? "Confirmed in Target Environment → Integrations" : original?.Consumer.MappingSource,
            },
            ProducerAuthentication = ProducerAuthentication, ConsumerAuthentication = ConsumerAuthentication, ContractRelationship = ContractRelationship,
            ProducerContractReference = Clean(ProducerContractReference), ConsumerContractReference = Clean(ConsumerContractReference),
            HealthUrl = Clean(HealthUrl), WorkerUrl = Clean(WorkerUrl), MonitoringUrl = Clean(MonitoringUrl), RunbookUrl = Clean(RunbookUrl), TechnicalOwner = Clean(TechnicalOwner),
            PartitionCount = PartitionCount, RetentionDays = RetentionDays,
        };
    }
}
