@using BirkNext.Integrations
@using BirkNext.Web.Services.ProjectImport
@using S = BirkNext.Web.Services.ProjectImport.SourceSetupPresentation

@* Source setup of every registered test pack that declares logical sources, as status-first cards rendered from the pack's own metadata and the
   backend's resolution. Availability (a compatible stored snapshot, any import) and binding (canonical IQR evidence) are separate lines; the
   technical requirement, matching evidence and provenance stay behind Details. A Test Pack reference (metadata the pack ships itself) is its own
   kind of card: no import or binding action, its facts and limits behind "View reference details". Generic: it names no pack, product or file. *@
@foreach (var pack in Setup.Packs)
{
    var headingId = $"pi-setup-{Slug(pack.PackId)}";
    <section class="pi-card pi-setup" aria-labelledby="@headingId" data-testid="pi-source-setup" data-pack="@pack.PackId">
        <h2 id="@headingId">@pack.DisplayName source setup</h2>
        <p class="pi-setup-progress" data-testid="pi-setup-progress">@S.Progress(pack)</p>
        <p class="pi-muted pi-setup-note" data-testid="pi-setup-note">@(pack.Sources.Any(S.IsReference) ? $"{pack.DisplayName} uses imported source evidence and Test Pack reference metadata. " : "")Imported source packages are matched by their content in any stored import, not by file name or by which project is current.@(pack.Sources.Any(S.IsReference) ? " Test Pack references are built into BirkNext and do not need to be uploaded." : "")@(Setup.BindingsRead ? "" : " No target environment is selected, so bindings are not shown.")</p>
        <div class="pi-source-grid" role="list" aria-label="@($"{pack.DisplayName} sources")">
            @foreach (var source in pack.Sources.OrderBy(S.Order))
            {
                var reference = S.IsReference(source);
                var optional = !reference && source.Role.Requirement != TestPackSourceRequirement.Required;
                var primary = S.Primary(source, ImportAnchor);
                var secondary = S.Secondary(source);
                var boundTo = BoundTo(source);
                var titleId = $"{headingId}-{Slug(source.Role.Key)}";
                <article class="pi-source-card pi-source-@S.CardTone(source) @(optional ? "is-optional" : "")" role="listitem" aria-labelledby="@titleId"
                         data-testid="pi-setup-source" data-role="@source.Role.Key" data-state="@source.State" data-requirement="@source.Role.Requirement" data-provider="@source.Role.Provider">
                    <header class="pi-source-head">
                        <h3 id="@titleId">@source.Role.Label</h3>
                        <div class="pi-source-badges">
                            <span class="pi-badge @(reference ? "pi-badge-reference" : "pi-badge-neutral")" data-testid="pi-setup-requirement">@S.ProviderLabel(source)</span>
                            <span class="pi-badge pi-state-@S.CardTone(source)" data-testid="pi-setup-state">@S.CardState(source)</span>
                        </div>
                    </header>
                    @if (S.SourceName(source) is { } name) { <p class="pi-source-name" data-testid="pi-setup-packages">@name</p> }
                    @if (S.BindingLine(source, Setup.BindingsRead, boundTo) is { } binding) { <p class="pi-source-binding" data-testid="pi-setup-binding">@binding</p> }
                    @if (S.JourneysText(source, pack.JourneyNames) is { Length: > 0 } journeys)
                    {
                        <p class="pi-source-usedby"><span class="pi-source-label">Used by</span> <span data-testid="pi-setup-journeys">@journeys</span></p>
                    }
                    else if (source.Role.Capabilities.Count > 0)
                    {
                        <p class="pi-source-usedby"><span class="pi-source-label">Used for</span> @source.Role.Capabilities[0]@(source.Role.Capabilities.Count > 1 ? $" and {source.Role.Capabilities.Count - 1} more" : "")</p>
                    }
                    <p class="pi-source-sentence" data-testid="pi-setup-detail">@S.Sentence(source)</p>
                    @if (primary is { } action)
                    {
                        <div class="pi-source-actions">
                            <a class="@(optional ? "btn-secondary" : "btn-primary")" href="@action.Href" aria-label="@action.AccessibleName" data-testid="pi-setup-action">@action.Text</a>
                            @if (secondary is { } second) { <a class="pi-source-secondary" href="@second.Href" aria-label="@second.AccessibleName" data-testid="pi-setup-secondary">@second.Text</a> }
                        </div>
                    }
                    @if (reference)
                    {
                        var available = source.State == TestPackSourceState.ReferenceAvailable;
                        <details class="pi-source-details pi-reference-details" data-testid="pi-setup-reference">
                            <summary><span aria-hidden="true">@(available ? "View reference details" : "View diagnostics")</span><span class="visually-hidden">@(available ? $"View {source.Role.Label} reference details" : $"View {source.Role.Label} reference diagnostics")</span></summary>
                            @if (source.Reference is { } info)
                            {
                                @if (available)
                                {
                                    <dl class="pi-source-facts" data-testid="pi-reference-facts">
                                        <div><dt>Reference type</dt><dd data-testid="pi-reference-kind">@info.Kind</dd></div>
                                        @foreach (var fact in info.Facts) { <div data-testid="pi-reference-fact"><dt>@fact.Label</dt><dd>@fact.Value</dd></div> }
                                        @if (info.Provenance.Count > 0) { <div><dt>Document</dt><dd>@string.Join(" · ", info.Provenance)</dd></div> }
                                        @if (info.Fingerprint is { } fingerprint) { <div><dt>Fingerprint</dt><dd><code title="@fingerprint">@ProjectImportPresentation.ShortFingerprint(fingerprint)</code></dd></div> }
                                        @if (S.JourneysText(source, pack.JourneyNames) is { Length: > 0 } referenceUsedBy) { <div><dt>Used by</dt><dd>@referenceUsedBy</dd></div> }
                                    </dl>
                                    <p class="pi-reference-limit" data-testid="pi-reference-limitation">@info.Limitation</p>
                                    @if (info.NotProven.Count > 0)
                                    {
                                        <p class="pi-muted">It does not prove:</p>
                                        <ul class="pi-list" data-testid="pi-reference-not-proven">@foreach (var item in info.NotProven) { <li>@item</li> }</ul>
                                    }
                                }
                                else
                                {
                                    <ul class="pi-list" data-testid="pi-reference-diagnostics">@foreach (var item in info.Diagnostics) { <li>@item</li> }</ul>
                                }
                            }
                            @if (source.Candidates.Count > 0)
                            {
                                <p class="pi-muted" data-testid="pi-reference-imported">Also imported as source evidence (additional; it does not replace the reference): @string.Join(", ", source.Candidates.Select(c => c.ArchiveFileName).Distinct())</p>
                            }
                        </details>
                    }
                    else
                    {
                    <details class="pi-source-details" data-testid="pi-setup-details">
                        <summary><span aria-hidden="true">Details</span><span class="visually-hidden">View @source.Role.Label source details</span></summary>
                        <dl class="pi-source-facts">
                            <div><dt>Expected source</dt><dd>@source.Role.ExpectedArtifact</dd></div>
                            <div><dt>Requirement</dt><dd data-testid="pi-setup-requirement-text">@S.RequirementText(source.Role)</dd></div>
                            @if (source.Role.Capabilities.Count > 0) { <div><dt>Used for</dt><dd><ul class="pi-list">@foreach (var capability in source.Role.Capabilities) { <li>@capability</li> }</ul></dd></div> }
                            @if (S.JourneysText(source, pack.JourneyNames) is { Length: > 0 } usedBy) { <div><dt>Used by</dt><dd>@usedBy</dd></div> }
                            @if (source.Integrations.Count > 0) { <div><dt>Integrations</dt><dd data-testid="pi-setup-integrations">@string.Join(", ", source.Integrations)</dd></div> }
                            <div><dt>Matching</dt><dd>@(source.Candidates.Count == 0 ? "No compatible stored snapshot found." : $"{source.Candidates.Count} compatible stored snapshot{(source.Candidates.Count == 1 ? "" : "s")}")</dd></div>
                        </dl>
                        @if (source.Candidates.Count > 0)
                        {
                            <ul class="pi-list" data-testid="pi-setup-candidates">
                                @foreach (var candidate in source.Candidates)
                                {
                                    <li data-testid="pi-setup-candidate">@candidate.ArchiveFileName · imported @candidate.AnalyzedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") · <code title="@candidate.Fingerprint">@ProjectImportPresentation.ShortFingerprint(candidate.Fingerprint)</code> ·
                                        @(candidate.Bound ? "Bound (canonical)" : "Not bound")
                                        @if (candidate.MatchedOn.Count > 0) { <span class="pi-muted" data-testid="pi-setup-matched"> — why it matches: @string.Join(", ", candidate.MatchedOn)</span> }
                                    </li>
                                }
                            </ul>
                        }
                        @if (source.NearMisses.Count > 0)
                        {
                            <ul class="pi-list" data-testid="pi-setup-nearmisses">
                                @foreach (var miss in source.NearMisses) { <li><strong>@miss.ArchiveFileName</strong> was checked: @miss.Reason</li> }
                            </ul>
                        }
                        <p class="pi-muted">@source.Detail</p>
                    </details>
                    }
                </article>
            }
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired] public SourceSetupView Setup { get; set; } = new();
    /// <summary>Where a missing source is imported on the hosting page.</summary>
    [Parameter] public string ImportAnchor { get; set; } = ProjectImportPresentation.ImportSourceHref;

    /// <summary>The IQR integrations whose canonical binding is this source's bound snapshot (role integrations only).</summary>
    private IReadOnlyList<string> BoundTo(TestPackSourceStatus source) =>
        source.Candidates.Where(c => c.Bound).SelectMany(c => Setup.Snapshots.FirstOrDefault(s => s.SnapshotId == c.SnapshotId)?.BoundIntegrations ?? [])
            .Where(name => source.Integrations.Count == 0 || source.Integrations.Contains(name)).Distinct().ToList();

    private static string Slug(string value) => new(value.Select(c => char.IsLetterOrDigit(c) ? char.ToLowerInvariant(c) : '-').ToArray());
}
