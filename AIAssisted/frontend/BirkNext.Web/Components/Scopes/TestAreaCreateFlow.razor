@using BirkNext.Scopes
@using BirkNext.Web.Services
@using P = BirkNext.Web.Services.ProjectTestSetupPresentation
@using S = BirkNext.Web.Services.SystemsScopesPresentation
@inject IScopeRegistryApiService Scopes

@* Create test area: "What do you want to test?" (a suggestion from evidence in this project, or your own) → choose the items → name and purpose →
   review → Save draft (the existing create API). Suggestions are never members: only items a person keeps or selects are saved, as confirmed
   membership. The step lives in the URL (?step=) so Back/Forward moves between steps; the selection itself is held by the page. *@
<section class="pts-create" data-testid="pts-create-flow" data-step="@Step" aria-labelledby="pts-create-h">
    <h2 id="pts-create-h" class="pts-h2">Create test area</h2>
    <ol class="pts-create-steps" aria-label="Create test area steps">
        @foreach (var (id, label, n) in new[] { ("choose", "What to test", 1), ("select", "Choose items", 2), ("details", "Name and purpose", 3), ("review", "Review and save", 4) })
        {
            var index = Array.IndexOf(P.CreateSteps.ToArray(), Step);
            <li class="@(id == Step ? "is-current" : n - 1 < index ? "is-done" : "")" aria-current="@(id == Step ? "step" : null)" data-testid="pts-create-step" data-step="@id">
                <span aria-hidden="true">@n.</span> @label@(n - 1 < index ? " (done)" : "")</li>
        }
    </ol>

    @if (Step == "choose") { @Choose() }
    else if (Step == "select") { @Select() }
    else if (Step == "details") { @Details() }
    else { @Review() }

    <div class="pts-actions">
        @if (Step != "choose") { <button type="button" class="btn-secondary" data-testid="pts-create-back" @onclick="BackAsync">Back</button> }
        @if (Step is "select") { <button type="button" class="btn-primary" data-testid="pts-next" @onclick='() => GoAsync("details")'>Next: name and purpose</button> }
        else if (Step is "details") { <button type="button" class="btn-primary" data-testid="pts-next" @onclick="DetailsNextAsync">Next: review</button> }
        else if (Step is "review")
        {
            <button type="button" class="btn-primary" data-testid="pts-save" disabled="@(Busy || Draft.Name.Trim().Length == 0)" @onclick="SaveAsync">@(Busy ? "Saving…" : "Save test area")</button>
        }
        <button type="button" class="pts-link" data-testid="pts-create-cancel" @onclick="() => OnCancel.InvokeAsync()">Cancel</button>
    </div>
    <p class="pts-save-status" aria-live="polite" role="status" data-testid="pts-save-status">@(Busy ? "Saving the test area…" : "")</p>
    @if (SaveError is not null) { <p class="psc-error" role="alert" data-testid="pts-save-error">@SaveError Your selection is kept on screen.</p> }
</section>

@code {
    [Parameter, EditorRequired] public TestAreaDraft Draft { get; set; } = new();
    [Parameter, EditorRequired] public string ProjectKey { get; set; } = "";
    [Parameter] public string? CatalogScope { get; set; }
    [Parameter] public IReadOnlyList<SystemOverviewItem> Systems { get; set; } = [];
    /// <summary>The current create step from the URL (choose, select, details, review).</summary>
    [Parameter] public string Step { get; set; } = "choose";
    [Parameter] public EventCallback<string> OnStep { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? SaveError { get; set; }

    private const int PageSize = 100, MaxPages = 3;
    private static readonly ScopeMemberKind[] SuggestionKinds = [ScopeMemberKind.Requirement, ScopeMemberKind.UserStory, ScopeMemberKind.Scenario, ScopeMemberKind.Feature, ScopeMemberKind.Journey];
    private IReadOnlyList<TestAreaSuggestion>? _suggestions;
    private readonly Dictionary<ScopeMemberKind, IReadOnlyList<ScopeCatalogItem>> _catalogs = [];
    private readonly List<string> _notices = [];
    private int _shown = 9;
    private bool _nameTouched;
    private string? _nameError;
    private bool _checking;
    private string? _checkedFor;

    protected override async Task OnInitializedAsync() => await LoadSuggestionsAsync();

    protected override async Task OnParametersSetAsync()
    {
        var key = string.Join("\n", Draft.Kept.Select(m => m.Key));
        if (Step == "review" && Draft.Kept.Count > 0 && Draft.Checks.Count == 0 && !_checking && _checkedFor != key) { _checkedFor = key; await CheckAsync(); }
    }

    /// <summary>Reads the catalogs a suggestion can come from (canonical kinds only with an active Target Environment).</summary>
    private async Task LoadSuggestionsAsync()
    {
        foreach (var kind in SuggestionKinds)
        {
            if (kind != ScopeMemberKind.Journey && string.IsNullOrWhiteSpace(CatalogScope)) continue;
            var items = new List<ScopeCatalogItem>();
            for (var page = 0; page < MaxPages; page++)
            {
                var (result, error) = await Scopes.CatalogAsync(kind, CatalogScope, null, page * PageSize, PageSize);
                if (error is not null) { _notices.Add($"{S.KindLabel(kind, plural: true)}: {error}"); break; }
                if (result is null) break;
                items.AddRange(result.Items);
                if (result.Items.Count == 0 || items.Count >= result.Total) break;
            }
            _catalogs[kind] = items;
        }
        if (string.IsNullOrWhiteSpace(CatalogScope)) _notices.Add("No Target Environment is active, so requirements, user stories and scenarios cannot be read for suggestions.");
        _suggestions = P.Suggest(ProjectKey, _catalogs, Systems, CatalogScope);
    }

    private RenderFragment Choose() => __builder =>
    {
        <div class="pts-choose" data-testid="pts-choose">
            <h3 class="pts-h3">What do you want to test?</h3>
            <p class="pts-muted">Start from a suggestion based on what BirkNext found in this project, or choose the items yourself. You decide what is kept.</p>
            @if (_suggestions is null) { <p class="pts-muted" role="status" data-testid="pts-suggestions-loading">Looking for suggestions in this project…</p> }
            else if (_suggestions.Count == 0)
            {
                <div class="pts-empty is-compact" data-testid="pts-no-suggestions">
                    <p><strong>No suggestions for this project.</strong> BirkNext suggests test areas only from analysed requirements, user stories, scenarios and journeys declared for this project, and found none. You can still create your own test area.</p>
                </div>
            }
            else
            {
                <ul class="pts-suggestions" aria-label="Suggested test areas">
                    @foreach (var s in _suggestions.Take(_shown))
                    {
                        var suggestion = s;
                        <li class="pts-suggestion" data-testid="pts-suggestion" data-id="@s.Id">
                            <div class="pts-suggestion-text">
                                <strong class="pts-suggestion-title">@s.Title</strong>
                                <span class="pts-muted" data-testid="pts-suggestion-provenance">From @s.Provenance</span>
                                <span data-testid="pts-suggestion-proposes">Proposes @s.Proposes</span>
                                <span class="pts-muted pts-small">@s.Basis</span>
                            </div>
                            <button type="button" class="btn-secondary" data-testid="pts-suggestion-use" @onclick="() => UseAsync(suggestion)">Use this suggestion<span class="visually-hidden">: @s.Title</span></button>
                        </li>
                    }
                </ul>
                @if (_suggestions.Count > _shown) { <button type="button" class="pts-link" data-testid="pts-suggestions-more" @onclick="() => _shown = int.MaxValue">Show all @_suggestions.Count suggestions</button> }
            }
            @foreach (var n in _notices) { <p class="pts-muted pts-small" data-testid="pts-suggestion-notice">@n</p> }
            <div class="pts-custom">
                <button type="button" class="btn-primary" data-testid="pts-create-custom" @onclick="CustomAsync">Create my own test area</button>
                <span class="pts-muted">Pick systems, scenarios, requirements, journeys, contracts or Test Data yourself. No systems are needed.</span>
            </div>
        </div>
    };

    private RenderFragment Select() => __builder =>
    {
        var pending = Draft.Pending.ToList();
        <div class="pts-select" data-testid="pts-select">
            <h3 class="pts-h3">Choose what belongs in the test area</h3>
            @if (pending.Count > 0)
            {
                <section class="pts-suggested" aria-labelledby="pts-suggested-h" data-testid="pts-suggested">
                    <div class="pts-head-row">
                        <h4 id="pts-suggested-h" class="pts-h4">Suggested from @(Draft.Suggestion?.Title ?? "the project") (@pending.Count)</h4>
                        <button type="button" class="btn-secondary btn-small" data-testid="pts-keep-all" @onclick="KeepAll">Keep all suggestions</button>
                    </div>
                    <p class="pts-muted">Suggestions are not part of the test area until you keep them. Anything you do not keep is not saved.</p>
                    <ul class="pts-member-list">
                        @foreach (var item in pending)
                        {
                            var it = item;
                            <li data-testid="pts-suggested-member" data-key="@($"{it.Kind}:{it.TargetId}")">
                                <span class="pts-member-name">@it.Label</span>
                                <span class="pts-muted pts-small">@S.KindLabel(it.Kind)</span>
                                <span class="psc-chip tone-info" data-testid="pts-member-state" data-state="SuggestedFromSource">@P.MemberStateLabel(AreaMemberState.SuggestedFromSource)</span>
                                <span class="pts-row-actions">
                                    <button type="button" class="btn-secondary btn-small" data-testid="pts-keep" @onclick="() => Keep(it)">Keep<span class="visually-hidden"> @it.Label</span></button>
                                    <button type="button" class="pts-link" data-testid="pts-dismiss" @onclick="() => Dismiss(it)">Dismiss<span class="visually-hidden"> @it.Label</span></button>
                                </span>
                            </li>
                        }
                    </ul>
                </section>
            }
            <section aria-labelledby="pts-kept-h" data-testid="pts-selected">
                <h4 id="pts-kept-h" class="pts-h4">In this test area (<span data-testid="pts-selected-count">@Draft.Kept.Count</span>)</h4>
                @if (Draft.Kept.Count == 0) { <p class="pts-muted" data-testid="pts-selected-empty">Nothing selected yet. Keep suggestions above or add items below. Every kind is optional; a test area of only requirements or scenarios is fine.</p> }
                @MemberTray(removable: true)
            </section>
            <details class="pts-add" data-testid="pts-add" open="@(Draft.Suggestion is null)">
                <summary>Add more items</summary>
                <p class="pts-muted">Search the project's catalogs. What you tick is added as explicitly selected.</p>
                <ScopeMemberPicker CatalogScope="@CatalogScope" Selected="Draft.Kept" SelectedChanged="Changed" />
            </details>
        </div>
    };

    private RenderFragment MemberTray(bool removable) => __builder =>
    {
        @foreach (var group in Draft.Kept.GroupBy(m => m.Kind).OrderBy(g => g.Key))
        {
            <div class="psc-tray-group"><span class="psc-tray-kind">@S.KindLabel(group.Key, plural: true) (@group.Count())</span>
                <ul class="pts-member-list">
                    @foreach (var m in group.OrderBy(m => m.Label, StringComparer.OrdinalIgnoreCase))
                    {
                        var member = m;
                        var state = P.MemberState(m, Draft.Checks.FirstOrDefault(c => c.Key == m.Key));
                        <li data-testid="pts-member" data-key="@m.Key">
                            <span class="pts-member-name">@m.Label</span>
                            <span class="psc-chip @(state == AreaMemberState.Unresolved ? "tone-attention" : "tone-ok")" data-testid="pts-member-state" data-state="@state">@P.MemberStateLabel(state)</span>
                            @if (removable)
                            {
                                <button type="button" class="pts-link" data-testid="pts-member-remove" @onclick="() => Remove(member)">Remove<span class="visually-hidden"> @m.Label</span></button>
                            }
                        </li>
                    }
                </ul>
            </div>
        }
    };

    private RenderFragment Details() => __builder =>
    {
        <div class="pts-form" data-testid="pts-details">
            <h3 class="pts-h3 psc-wide">Name and purpose</h3>
            <label class="psc-field" for="pts-name">Test area name <span aria-hidden="true">*</span></label>
            <input id="pts-name" class="pts-input" data-testid="pts-name" value="@Draft.Name" @oninput="NameChanged" maxlength="200" required aria-required="true"
                   aria-invalid="@(_nameError is null ? "false" : "true")" aria-describedby="@(_nameError is null ? null : "pts-name-error")" />
            @if (_nameError is not null) { <p id="pts-name-error" class="pts-field-error" role="alert" data-testid="pts-name-error">@_nameError</p> }
            <label class="psc-field" for="pts-area-purpose">Purpose</label>
            <select id="pts-area-purpose" class="pts-input" data-testid="pts-area-purpose" value="@Draft.Purpose" @onchange="e => Draft.Purpose = Enum.TryParse<ScopePurpose>(e.Value?.ToString(), out var p) ? p : ScopePurpose.Test">
                @foreach (var p in Enum.GetValues<ScopePurpose>()) { <option value="@p">@S.PurposeLabel(p)</option> }
            </select>
            <label class="psc-field" for="pts-description">Description (optional)</label>
            <textarea id="pts-description" class="pts-input" data-testid="pts-description" value="@Draft.Description" @oninput="e => Draft.Description = e.Value?.ToString() ?? string.Empty" maxlength="2000" rows="3"></textarea>
        </div>
    };

    private RenderFragment Review() => __builder =>
    {
        var notKept = Draft.Pending.Count();
        var unresolved = Draft.Kept.Count(m => P.MemberState(m, Draft.Checks.FirstOrDefault(c => c.Key == m.Key)) == AreaMemberState.Unresolved);
        <div class="pts-review" data-testid="pts-review">
            <h3 class="pts-h3">Review and save</h3>
            <dl class="psc-facts">
                <dt>Name</dt><dd data-testid="pts-review-name">@Draft.Name</dd>
                <dt>Purpose</dt><dd>@S.PurposeLabel(Draft.Purpose)</dd>
                @if (Draft.Description.Trim().Length > 0) { <dt>Description</dt><dd>@Draft.Description</dd> }
                <dt>Items</dt><dd data-testid="pts-review-count">@(Draft.Kept.Count == 0 ? "None yet" : string.Join(", ", Draft.Kept.GroupBy(m => m.Kind).OrderBy(g => g.Key).Select(g => $"{g.Count()} {S.KindLabel(g.Key, plural: g.Count() != 1).ToLowerInvariant()}")))</dd>
                <dt>Revision</dt><dd>Creates draft revision 1</dd>
            </dl>
            @MemberTray(removable: false)
            @if (notKept > 0) { <p class="pts-muted" data-testid="pts-review-not-kept">@P.Plural(notKept, "suggestion was", "suggestions were") not kept and will not be saved.</p> }
            @if (unresolved > 0) { <p class="psc-warning" data-testid="pts-review-unresolved">@P.Plural(unresolved, "item is", "items are") not current in their catalog; they are kept and marked for review.</p> }
            @if (Draft.Kept.Count == 0) { <p class="pts-muted" data-testid="pts-review-empty">This test area has no items yet. It can be saved and filled later, but it cannot be approved while it is empty.</p> }
            <p class="pts-muted">Saving creates a draft. Other modules filter only by an approved revision.</p>
        </div>
    };

    private async Task UseAsync(TestAreaSuggestion s)
    {
        Draft.Started = true;
        Draft.Suggestion = s;
        Draft.Suggested = [.. s.Members];
        Draft.Kept = [];
        Draft.Checks = [];
        if (!_nameTouched) Draft.Name = s.Title;
        await AddVerifyingScenariosAsync(s);
        await GoAsync("select");
    }

    /// <summary>Scenarios that verify the suggestion's requirements through an established relation (never candidates) are proposed too.</summary>
    private async Task AddVerifyingScenariosAsync(TestAreaSuggestion s)
    {
        var requirements = s.Members.Where(m => m.Kind == ScopeMemberKind.Requirement).Select(m => m.TargetId).ToList();
        if (requirements.Count == 0 || string.IsNullOrWhiteSpace(CatalogScope)) return;
        var (links, _) = await Scopes.VerifyingScenariosAsync(new ScopeScenarioLinkRequest(CatalogScope, requirements));
        var scenarios = (_catalogs.GetValueOrDefault(ScopeMemberKind.Scenario) ?? []).ToDictionary(i => i.TargetId, StringComparer.Ordinal);
        foreach (var link in links)
            if (scenarios.TryGetValue(link.ScenarioKey, out var scenario) && Draft.Suggested.All(m => m.Kind != ScopeMemberKind.Scenario || m.TargetId != scenario.TargetId))
                Draft.Suggested.Add(scenario);
    }

    private async Task CustomAsync()
    {
        Draft.Started = true;
        Draft.Suggestion = null;
        Draft.Suggested = [];
        Draft.Checks = [];
        await GoAsync("select");
    }

    private void Keep(ScopeCatalogItem item)
    {
        if (!Draft.IsKept(item)) Draft.Kept.Add(P.Keep(item, Draft.Suggestion?.Provenance ?? "the project"));
        Draft.Checks = [];
    }

    private void Dismiss(ScopeCatalogItem item) => Draft.Suggested.Remove(item);

    private void KeepAll() { foreach (var item in Draft.Pending.ToList()) Keep(item); }

    private void Remove(ScopeMember m) { Draft.Kept.Remove(m); Draft.Checks = []; }

    private void Changed() { Draft.Checks = []; StateHasChanged(); }

    private void NameChanged(ChangeEventArgs e)
    {
        Draft.Name = e.Value?.ToString() ?? string.Empty;
        _nameTouched = true;
        if (Draft.Name.Trim().Length > 0) _nameError = null;
    }

    private async Task DetailsNextAsync()
    {
        if (Draft.Name.Trim().Length == 0) { _nameError = "Give the test area a name."; return; }
        _nameError = null;
        await GoAsync("review");
    }

    private async Task CheckAsync()
    {
        _checking = true;
        try
        {
            var (checks, _) = await Scopes.CheckMembersAsync(new ScopeMemberCheckRequest([.. Draft.Kept], CatalogScope));
            Draft.Checks = checks;
        }
        finally { _checking = false; }
    }

    private async Task GoAsync(string step) => await OnStep.InvokeAsync(step);

    private async Task BackAsync()
    {
        var index = Array.IndexOf(P.CreateSteps.ToArray(), Step);
        await GoAsync(index <= 0 ? "choose" : P.CreateSteps[index - 1]);
    }

    private async Task SaveAsync()
    {
        if (Draft.Name.Trim().Length == 0) { _nameError = "Give the test area a name."; await GoAsync("details"); return; }
        await OnSave.InvokeAsync();
    }
}
