@using BirkNext.TestData
@using BirkNext.Web.Services.SchemaStudio
@inject IServiceProvider Services
@inject IJSRuntime JS

@* Test Data asset lifecycle in one place: Edit (value only where Test Data owns it; id, type, role, scope and origin read-only), View usages,
   Delete (simple confirmation when unused; usage-aware with Replace references… or Delete and mark references unresolved when used) and
   Replace references (compatible approved assets only). Nothing deletes a consumer or re-points a reference without an explicit choice. *@
<section class="tda" role="@(Destructive ? "alertdialog" : "dialog")" aria-modal="false" aria-labelledby="@_titleId" aria-describedby="@_descId" data-testid="tda" data-mode="@_mode">
    <h3 id="@_titleId" class="tda-title" tabindex="-1">@Title</h3>
    <p class="tda-asset"><span class="tda-alias" data-testid="tda-alias">@Asset.Alias</span>@if (Asset.Label is { Length: > 0 } label && label != Asset.Alias) { <span class="tda-muted"> · @label</span> }
        @if (Asset.ProtectionLabel is { } protection) { <span class="tda-badge" data-testid="tda-protected" data-protection="@Asset.ProtectionKind">@protection</span> }</p>
    @if (Asset.ProtectionKind == TestDataProtectionKinds.CanonicalFixture && Asset.ProtectionReason is { } protectionReason)
    {
        <p class="tda-muted" data-testid="tda-protection"><strong>Protection:</strong> Canonical Test Pack fixture · <strong>Reason:</strong> @protectionReason It survives Maintenance reset with its current content; change it through a new version.</p>
    }
    <div id="@_descId">
        @if (_loading)
        {
            <InlineLoading Text="Loading…" Class="tda-muted" />
        }
        else if (_mode == Mode.Edit)
        {
            @EditBody
        }
        else if (_mode == Mode.Usages)
        {
            @UsageList(Usages)
            <div class="tda-actions"><button type="button" class="btn-secondary" data-testid="tda-close" @onclick="CloseAsync">Close</button></div>
        }
        else if (_mode == Mode.Delete)
        {
            @DeleteBody
        }
        else if (_mode == Mode.Replace)
        {
            @ReplaceBody
        }
    </div>
    @if (_error is not null) { <p class="tda-error" role="alert" data-testid="tda-error">@_error</p> }
</section>

@code {
    public enum Mode { Edit, Usages, Delete, Replace }

    [Parameter, EditorRequired] public TestDataAssetSummary Asset { get; set; } = default!;
    [Parameter] public Mode Initial { get; set; } = Mode.Edit;
    /// <summary>The whole catalog (replacement candidates are filtered by the backend; regeneration impact is read from it after a change).</summary>
    [Parameter] public IReadOnlyList<TestDataAssetSummary> Assets { get; set; } = [];
    /// <summary>Called when the dialog closes; the message (or null when cancelled) is announced by the page, which then reloads.</summary>
    [Parameter] public EventCallback<string?> OnClose { get; set; }

    private readonly string _titleId = $"tda-{Guid.NewGuid():N}", _descId = $"tda-d-{Guid.NewGuid():N}";
    private Mode _mode;
    private bool _loading = true, _busy, _confirmImpact, _confirmRestore;
    private string? _error, _label, _value, _replacement;
    private TestDataEditView? _edit;
    private List<TestDataAssetUsage> _backendUsages = [];
    private IReadOnlyList<TestDataAssetSummary> _replacements = [];
    private ITestDataApiService? Api => TestDataApiService.Resolve(Services);
    private IWorkspaceArtifactRepository? Repository => Services.GetService(typeof(IWorkspaceArtifactRepository)) as IWorkspaceArtifactRepository;

    private bool Destructive => _mode is Mode.Delete or Mode.Replace;
    private string Title => _mode switch
    {
        Mode.Edit => "Edit Test Data asset",
        Mode.Usages => "Where this asset is used",
        Mode.Delete => "Delete Test Data asset?",
        _ => "Replace references",
    };

    /// <summary>Backend references plus the workspace's XML field mappings.</summary>
    private IReadOnlyList<TestDataAssetUsage> Usages =>
        [.. _backendUsages, .. TestDataAssetWorkspace.XmlUsages(Repository, Assets.Select(a => a.Alias).ToHashSet(StringComparer.Ordinal)).Where(u => u.Alias == Asset.Alias)];

    protected override async Task OnInitializedAsync()
    {
        _mode = Initial;
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { await JS.InvokeVoidAsync("birknextFocusElement", _titleId); } catch (JSException) { } catch (InvalidOperationException) { }
    }

    private async Task LoadAsync()
    {
        _loading = true; _error = null;
        try
        {
            if (Api is not { } api) { _error = "Test Data is not available in this host."; return; }
            if (_mode == Mode.Edit)
            {
                (_edit, _error) = await api.EditViewAsync(Asset.Id);
                _backendUsages = [.. _edit?.Usages ?? []];
                _label = _edit?.Asset.Label;
                _value = _edit?.Value;
                _semanticRole = _edit?.Asset.SemanticRole ?? "";
                _contexts.Clear();
                foreach (var c in _edit?.Asset.AppliesTo ?? []) _contexts.Add(c);
            }
            else
            {
                var (all, error) = await api.ReferencesAsync();
                _error = error;
                _backendUsages = [.. (all ?? []).Where(u => u.Alias == Asset.Alias)];
                if (_mode == Mode.Replace) (_replacements, _error) = await LoadReplacementsAsync(api);
            }
        }
        finally { _loading = false; }
    }

    private async Task<(IReadOnlyList<TestDataAssetSummary>, string?)> LoadReplacementsAsync(ITestDataApiService api)
    {
        var (list, error) = await api.ReplacementsAsync(Asset.Id);
        return (list ?? [], error);
    }

    private Task CloseAsync() => OnClose.InvokeAsync(null);

    // ── Usages ──────────────────────────────────────────────────────────────────────────────────────────────────────

    private RenderFragment UsageList(IReadOnlyList<TestDataAssetUsage> usages) => __builder =>
    {
        if (usages.Count == 0)
        {
            <p class="tda-muted" data-testid="tda-unused">No consumer references this asset.</p>
            return;
        }
        var resolvedUsages = usages.Where(u => !u.Unresolved).ToList();
        var consumers = resolvedUsages.Select(u => $"{u.ConsumerType}|{u.ConsumerId}").Distinct().Count();
        @* Counts come from references that resolve to this asset (stable ids); legacy or missing references are listed but never counted as use. *@
        <p class="tda-muted" data-testid="tda-usage-count">Used by @consumers consumer@(consumers == 1 ? "" : "s") · @resolvedUsages.Count reference@(resolvedUsages.Count == 1 ? "" : "s")@(usages.Count > resolvedUsages.Count ? $" · {usages.Count - resolvedUsages.Count} unresolved" : "")</p>
        <ul class="tda-usages" data-testid="tda-usages">
            @foreach (var usage in usages)
            {
                <li data-testid="tda-usage" data-consumer="@usage.ConsumerType">
                    <span class="tda-consumer">@usage.ConsumerType</span>
                    <span data-testid="tda-usage-consumer">@usage.ConsumerName</span>
                    <span data-testid="tda-usage-requirement"><span class="tda-muted">Requirement:</span> @usage.Location</span>
                    @if ((usage.EnvironmentName ?? usage.EnvironmentId) is { } environment) { <span data-testid="tda-usage-environment"><span class="tda-muted">Environment:</span> @environment</span> }
                    @* Status in text, never colour only. *@
                    @if (usage.NeedsReview) { <SemanticStatusBadge Status="SemanticStatus.NeedsReview" QualifiedLabel="Legacy Test Data reference · Needs review" TestId="tda-usage-status"
                        Explanation="Saved before stable Test Data ids, and the alias was reused or is ambiguous. It is not attached to this asset until someone chooses the asset again." /> }
                    else if (usage.Unresolved) { <span class="tda-badge tda-badge-attention" data-testid="tda-usage-status">Test Data reference missing</span> }
                    else { <span class="tda-badge" data-testid="tda-usage-status">Resolved</span> }
                    @if (TestDataAssetWorkspace.Href(usage) is { } href) { <a href="@href" class="tda-link">@TestDataAssetWorkspace.OpenLabel(usage)<span class="visually-hidden"> @usage.ConsumerName</span></a> }
                </li>
            }
        </ul>
    };

    // ── Edit ────────────────────────────────────────────────────────────────────────────────────────────────────────

    private RenderFragment EditBody => __builder =>
    {
        if (_edit is not { } view) return;
        var usageCount = Usages.Select(u => $"{u.ConsumerType}|{u.ConsumerId}").Distinct().Count();
        <dl class="tda-facts" data-testid="tda-facts">
            <div><dt>Asset</dt><dd>@(view.Asset.Label ?? view.Asset.Alias)</dd></div>
            <div><dt>Asset ID</dt><dd class="tda-mono" data-testid="tda-asset-id" title="Immutable TestDataAssetId: independent of the alias and the source label">@(view.Asset.AssetId ?? "Not assigned")</dd></div>
            <div><dt>Canonical ID</dt><dd class="tda-mono" data-testid="tda-id" title="Alias-derived id kept for compatibility; it changes when the alias is renamed">@view.Asset.Id</dd></div>
            @if (view.Asset.PreviousAliases is { Count: > 0 } previous) { <div><dt>Previously known as</dt><dd data-testid="tda-previous-aliases">@string.Join(", ", previous)</dd></div> }
            @if (view.Asset.IdentityReview is { } review) { <div><dt>Identity</dt><dd data-testid="tda-identity-review"><SemanticStatusBadge Status="SemanticStatus.NeedsReview" Explanation="@review" /> @review</dd></div> }
            @if (view.Asset.ValidationTrust is { } trust)
            {
                var (trustStatus, trustLabel, trustExplanation) = TestDataPresentation.Trust(trust);
                <div><dt>Validation trust</dt><dd data-testid="tda-validation-trust"><SemanticStatusBadge Status="trustStatus" QualifiedLabel="@trustLabel" Explanation="@trustExplanation" /></dd></div>
            }
            @if (view.Asset.Ownership == TestDataOwnership.Registered)
            {
                <div><dt>Alias</dt><dd class="tda-rename" data-testid="tda-rename">
                    <input class="form-control form-control-sm" aria-label="New alias" value="@_newAlias" @onchange="e => _newAlias = (string?)e.Value" data-testid="tda-rename-input" placeholder="@view.Asset.Alias" />
                    <button type="button" class="btn-secondary" disabled="@(_busy || string.IsNullOrWhiteSpace(_newAlias) || _newAlias == view.Asset.Alias)" @onclick="RenameAsync" data-testid="tda-rename-button">Rename alias</button>
                    <span class="tda-hint">The asset ID and every reference stay the same; the old alias is kept as history.</span>
                </dd></div>
            }
            <div><dt>Type</dt><dd data-testid="tda-type">@TestDataDataTypes.Label(view.Asset.DataType ?? TestDataDataTypes.Of(view.Asset.Kind, view.Asset.MediaType))</dd></div>
            @if (view.Role is { } role) { <div><dt>Role</dt><dd data-testid="tda-role">@role</dd></div> }
            <div><dt>Semantic role</dt><dd data-testid="tda-semantic-role">@TestDataSemanticRoles.Label(view.Asset.SemanticRole)@(view.MetadataEditable ? "" : " · declared by its source")</dd></div>
            <div><dt>Applies to</dt><dd data-testid="tda-applies">@(view.Asset.AppliesTo is { Count: > 0 } contexts ? string.Join(", ", contexts.Select(TestDataContexts.Label)) : "Not specified")</dd></div>
            <div><dt>Scope</dt><dd data-testid="tda-scope">@(view.Asset.Environment ?? "Shared")</dd></div>
            @if (view.Asset.Version is { } version)
            {
                <div><dt>Current version</dt><dd data-testid="tda-version">Version @version@(view.Asset.Approval == TestDataApproval.Approved ? " · approved" : " · not approved")@(view.Asset.VersionCreatedAt is { } at ? $" · generated {at.UtcDateTime:yyyy-MM-dd HH:mm} UTC" : "")</dd></div>
                @if (view.Asset.DraftVersion is { } draft) { <div><dt>Draft update</dt><dd data-testid="tda-draft">Version @draft (@XmlFixturePresentation.DraftValidation(view.Asset)) — consumers keep version @version until it is approved (Test Data → XML fixtures)</dd></div> }
            }
            @if (view.Asset.Schema is { } schema) { <div><dt>Schema</dt><dd class="tda-mono" data-testid="tda-schema">@schema.SchemaPath@(view.Asset.SchemaCheck is { } check ? $" · {check.Detail}" : "")</dd></div> }
            @if (view.Asset.Provenance.FirstOrDefault(p => p.Label == "Value mappings") is { } generatedFrom) { <div><dt>Generated from</dt><dd data-testid="tda-generated-from">@generatedFrom.Value</dd></div> }
            @if (view.Asset.Staleness is { } stale) { <div><dt>Staleness</dt><dd data-testid="tda-staleness">@stale</dd></div> }
            <div><dt>Owner</dt><dd data-testid="tda-owner">@TestDataOwnerships.Label(view.Asset.Ownership)@(view.Asset.ValueModified ? " · Modified" : "")</dd></div>
            <div><dt>Usage</dt><dd data-testid="tda-usage-summary">@TestDataAssetWorkspace.UsedBy(usageCount)</dd></div>
        </dl>
        <p class="tda-muted">The id, type, role, scope and owner stay as they are, so every consumer keeps referencing this asset.</p>
        if (_confirmRestore)
        {
            <p data-testid="tda-restore-confirm"><strong>Restore the default value of @view.Asset.Alias?</strong> Future uses resolve the seeded value; completed runs and saved fixtures stay as they are.</p>
            <div class="tda-actions">
                <button type="button" class="btn-secondary" data-testid="tda-cancel" @onclick="() => _confirmRestore = false">Cancel</button>
                <button type="button" class="btn-primary" data-testid="tda-restore-confirm-button" disabled="@_busy" @onclick="RestoreAsync">Restore default value</button>
            </div>
            return;
        }
        if (_roleImpact is { } impact)
        {
            <div role="alert" data-testid="tda-role-impact">
                <p><strong>Change the semantic role?</strong> @impact</p>
            </div>
            <div class="tda-actions">
                <button type="button" class="btn-secondary" data-testid="tda-cancel" @onclick="() => _roleImpact = null">Cancel</button>
                <button type="button" class="btn-primary" data-testid="tda-role-confirm" disabled="@_busy" @onclick="() => SaveAsync(confirmed: true, confirmRole: true)">Change role</button>
            </div>
            return;
        }
        if (_confirmImpact)
        {
            <div role="alert" data-testid="tda-impact">
                <p><strong>Update Test Data asset?</strong> This asset is used by:</p>
                @UsageList(Usages)
                <p>Changing the value affects future uses of this shared asset. Completed runs and saved fixtures are not rewritten.</p>
            </div>
            <div class="tda-actions">
                <button type="button" class="btn-secondary" data-testid="tda-cancel" @onclick="() => _confirmImpact = false">Cancel</button>
                <button type="button" class="btn-primary" data-testid="tda-save-confirm" disabled="@_busy" @onclick="() => SaveAsync(confirmed: true)">Save changes</button>
            </div>
            return;
        }
        <div class="tda-form">
            @if (view.LabelEditable)
            {
                <label for="@($"{_titleId}-label")">Name</label>
                <input id="@($"{_titleId}-label")" class="form-control" maxlength="100" data-testid="tda-label" @bind="_label" />
            }
            @if (view.ValueEditable)
            {
                <label for="@($"{_titleId}-value")">Value@(view.Role is { } valueRole ? $" ({valueRole.ToLowerInvariant()} identifier)" : "")</label>
                <input id="@($"{_titleId}-value")" class="form-control tda-mono" autocomplete="off" spellcheck="false" inputmode="numeric" data-testid="tda-value" @bind="_value"
                       aria-describedby="@($"{_titleId}-value-help")" />
                <p id="@($"{_titleId}-value-help")" class="tda-muted">Validated with the same rule as entry. Shown only here, never in the asset table.</p>
            }
            else if (view.ValueNote is { } note)
            {
                <p class="tda-muted" data-testid="tda-value-note">@note</p>
            }
            @if (view.MetadataEditable)
            {
                <label for="@($"{_titleId}-semantic-role")">Semantic role</label>
                <select id="@($"{_titleId}-semantic-role")" class="form-control" data-testid="tda-semantic-role-select" @bind="_semanticRole" aria-describedby="@($"{_titleId}-role-help")">
                    <option value="">Not specified</option>
                    @foreach (var r in TestDataSemanticRoles.All) { <option value="@r">@TestDataSemanticRoles.Label(r)</option> }
                </select>
                <p id="@($"{_titleId}-role-help")" class="tda-muted">What the value represents. Suggestions match the exact role — a Child is never offered where a Person ID is needed.</p>
                <fieldset class="tda-contexts" data-testid="tda-applies-edit">
                    <legend>Applies to</legend>
                    @foreach (var (id, label) in TestDataContexts.All)
                    {
                        var contextId = id;
                        <label><input type="checkbox" checked="@_contexts.Contains(contextId)" @onchange="e => ToggleContext(contextId, e.Value is true)" data-testid="tda-applies-option" data-context="@contextId" /> @label</label>
                    }
                    <p class="tda-muted">Helps BirkNext suggest this asset. It is not a binding: changing it never changes where the asset is actually used.</p>
                </fieldset>
            }
        </div>
        <div class="tda-actions">
            <button type="button" class="btn-secondary" data-testid="tda-cancel" @onclick="CloseAsync">Cancel</button>
            @if (view.LabelEditable || view.ValueEditable || view.MetadataEditable) { <button type="button" class="btn-primary" data-testid="tda-save" disabled="@_busy" @onclick="() => SaveAsync(confirmed: false)">Save changes</button> }
            @if (view.CanRestoreDefault) { <button type="button" class="btn-secondary" data-testid="tda-restore" @onclick="() => _confirmRestore = true">Restore default value</button> }
        </div>
    };

    private string _semanticRole = "";
    private readonly HashSet<string> _contexts = new(StringComparer.Ordinal);
    private string? _roleImpact;

    private void ToggleContext(string id, bool on) { if (on) _contexts.Add(id); else _contexts.Remove(id); }

    private async Task SaveAsync(bool confirmed, bool confirmRole = false)
    {
        if (Api is not { } api || _edit is not { } view) return;
        var valueChanged = view.ValueEditable && (_value?.Trim() ?? "") != (view.Value ?? "") && !string.IsNullOrWhiteSpace(_value);
        // A value change of an asset in use needs the impact confirmation first.
        if (valueChanged && !confirmed && Usages.Count > 0) { _confirmImpact = true; return; }
        var roleChanged = view.MetadataEditable && _semanticRole != (view.Asset.SemanticRole ?? "");
        var contexts = TestDataContexts.All.Select(c => c.Id).Where(_contexts.Contains).ToList();
        var contextsChanged = view.MetadataEditable && !contexts.SequenceEqual(view.Asset.AppliesTo ?? []);
        _busy = true; _error = null;
        try
        {
            var (result, error) = await api.EditAsync(Asset.Id, new TestDataEditRequest(_label?.Trim() != view.Asset.Label ? _label : null, valueChanged ? _value : null)
            {
                SemanticRole = roleChanged ? _semanticRole : null, AppliesTo = contextsChanged ? contexts : null, ConfirmRoleImpact = confirmRole,
            });
            // A role change that affects bound consumers is shown first; the person confirms it explicitly.
            if (result is { Updated: false, AffectedUsages.Count: > 0 } && roleChanged && !confirmRole) { _roleImpact = result.Message; return; }
            if (result is not { Updated: true }) { _error = error ?? result?.Message ?? "The asset was not updated."; _confirmImpact = false; _roleImpact = null; return; }
            await OnClose.InvokeAsync(await Feedback("Test Data asset updated.", result.ValueChanged));
        }
        finally { _busy = false; }
    }

    private string? _newAlias;

    private async Task RenameAsync()
    {
        if (Api is not { } api || string.IsNullOrWhiteSpace(_newAlias)) return;
        _busy = true; _error = null;
        try
        {
            if (await api.RenameAsync(Asset.AssetId ?? Asset.Id, _newAlias.Trim()) is { } error) { _error = error; return; }
            await OnClose.InvokeAsync($"Alias renamed to {_newAlias.Trim()}. The asset ID and its references are unchanged.");
        }
        finally { _busy = false; }
    }

    private async Task RestoreAsync()
    {
        if (Api is not { } api) return;
        _busy = true; _error = null;
        try
        {
            var (result, error) = await api.RestoreDefaultAsync(Asset.Id);
            if (result is not { Updated: true }) { _error = error ?? result?.Message; return; }
            await OnClose.InvokeAsync(await Feedback(result.Message, result.ValueChanged));
        }
        finally { _busy = false; }
    }

    /// <summary>"Test Data asset updated. 1 dependent XML fixture needs regeneration." — read from the catalog after the change.</summary>
    private async Task<string> Feedback(string message, bool valueChanged)
    {
        if (!valueChanged || Api is not { } api) return message;
        var (catalog, _) = await api.CatalogAsync();
        var stale = TestDataAssetWorkspace.FixturesNeedingRegeneration(catalog?.Assets ?? [], Asset.Alias).Count;
        return stale == 0 ? message : $"{message} {stale} dependent XML fixture{(stale == 1 ? " needs" : "s need")} regeneration (saved fixtures are not rewritten).";
    }

    // ── Delete ──────────────────────────────────────────────────────────────────────────────────────────────────────

    private RenderFragment DeleteBody => __builder =>
    {
        var usages = Usages;
        if (usages.Count == 0)
        {
            <p data-testid="tda-delete-simple">This cannot be undone.</p>
            <div class="tda-actions">
                <button type="button" class="btn-secondary" data-testid="tda-cancel" @onclick="CloseAsync">Cancel</button>
                <button type="button" class="btn-danger" data-testid="tda-delete" disabled="@_busy" @onclick="() => DeleteAsync(leaveUnresolved: false)">Delete</button>
            </div>
            return;
        }
        @UsageList(usages)
        <p data-testid="tda-delete-warning"><strong>Deleting it will leave these references unresolved.</strong> The consumers stay; each shows its reference as missing until it is remapped.</p>
        <div class="tda-actions">
            <button type="button" class="btn-secondary" data-testid="tda-cancel" @onclick="CloseAsync">Cancel</button>
            <button type="button" class="btn-secondary" data-testid="tda-replace" @onclick="ToReplaceAsync">Replace references…</button>
            <button type="button" class="btn-danger" data-testid="tda-delete-unresolved" disabled="@_busy" @onclick="() => DeleteAsync(leaveUnresolved: true)">Delete and mark references unresolved</button>
        </div>
    };

    private async Task ToReplaceAsync()
    {
        _mode = Mode.Replace;
        if (Api is { } api) (_replacements, _error) = await LoadReplacementsAsync(api);
    }

    private async Task DeleteAsync(bool leaveUnresolved)
    {
        if (Api is not { } api) return;
        _busy = true; _error = null;
        try
        {
            var references = Usages.Count;
            if (Asset.IsProtected) { _error = Asset.WhyNotDeletable ?? "This Test Data asset is protected and cannot be deleted."; return; }
            if (Asset.Ownership == TestDataOwnership.Generated)
            {
                // Generated fixtures live in the workspace's saved XML: removed there (the saved document goes with the registration).
                var removed = TestDataAssetWorkspace.RemoveGeneratedFixtures(Repository, Services.GetService(typeof(SchemaGeneratedXmlStore)) as SchemaGeneratedXmlStore,
                    new HashSet<string>([Asset.Alias], StringComparer.Ordinal));
                if (removed == 0 || !await PersistAsync()) { _error = "The generated fixture could not be removed from the workspace."; return; }
                await OnClose.InvokeAsync($"Deleted {Asset.Alias}.{(references > 0 ? $" {references} reference{(references == 1 ? " is" : "s are")} now unresolved." : "")}");
                return;
            }
            var (result, error) = await api.DeleteAsync(Asset.Id, leaveUnresolved);
            if (result is not { Deleted: true })
            {
                // An in-use refusal from the backend (another consumer appeared) shows its references here.
                _error = error ?? result?.Message;
                if (result?.UnresolvedReferences is { Count: > 0 } refs) _backendUsages = [.. refs];
                return;
            }
            var xml = TestDataAssetWorkspace.XmlUsages(Repository, Assets.Select(a => a.Alias).ToHashSet(StringComparer.Ordinal)).Count(u => u.Alias == Asset.Alias);
            var total = result.UnresolvedReferences.Count + xml;
            await OnClose.InvokeAsync(total == 0 ? $"Deleted {Asset.Alias}." : $"Deleted {Asset.Alias}. {total} reference{(total == 1 ? " is" : "s are")} now unresolved and require remapping.");
        }
        finally { _busy = false; }
    }

    private async Task<bool> PersistAsync() =>
        Services.GetService(typeof(IWorkspaceAutoSaveService)) is IWorkspaceAutoSaveService autoSave && await autoSave.SaveNowAsync();

    // ── Replace references ──────────────────────────────────────────────────────────────────────────────────────────

    private RenderFragment ReplaceBody => __builder =>
    {
        <p>Replace <span class="tda-mono">@Asset.Alias</span> in <strong data-testid="tda-affected">@Usages.Count affected reference@(Usages.Count == 1 ? "" : "s")</strong>, then delete the original.</p>
        if (_replacements.Count == 0)
        {
            <p class="tda-muted" role="status" data-testid="tda-no-replacement">No compatible approved asset: a replacement needs the same type, data type and role, a compatible scope and approval.</p>
            <div class="tda-actions"><button type="button" class="btn-secondary" data-testid="tda-cancel" @onclick="CloseAsync">Cancel</button></div>
            return;
        }
        <fieldset class="tda-options" data-testid="tda-replacements">
            <legend>Compatible approved assets</legend>
            @foreach (var candidate in _replacements)
            {
                var id = $"{_titleId}-{candidate.Alias}";
                <label for="@id"><input type="radio" id="@id" name="@_titleId" checked="@(_replacement == candidate.Id)" @onchange="() => _replacement = candidate.Id" data-testid="tda-replacement" data-alias="@candidate.Alias" />
                    <span class="tda-mono">@candidate.Alias</span>@if (candidate.Label is { Length: > 0 } label) { <span class="tda-muted"> · @label</span> }</label>
            }
        </fieldset>
        <div class="tda-actions">
            <button type="button" class="btn-secondary" data-testid="tda-cancel" @onclick="CloseAsync">Cancel</button>
            <button type="button" class="btn-danger" data-testid="tda-replace-delete" disabled="@(_busy || _replacement is null)" @onclick="ReplaceAndDeleteAsync">Replace and delete original</button>
        </div>
    };

    private async Task ReplaceAndDeleteAsync()
    {
        if (Api is not { } api || _replacement is null || _replacements.FirstOrDefault(r => r.Id == _replacement) is not { } replacement) return;
        _busy = true; _error = null;
        try
        {
            var (result, error) = await api.ReplaceAsync(Asset.Id, replacement.Id);
            if (result is not { Replaced: true }) { _error = error ?? result?.Message; return; }
            var xml = TestDataAssetWorkspace.ReplaceXmlMappings(Repository, Asset.Alias, replacement.Alias);
            if (xml > 0 && !await PersistAsync()) { _error = "The XML mappings were re-pointed but could not be saved; the original was kept."; return; }
            // A protected asset is never removed by Replace: its references move, the asset itself stays.
            if (Asset.IsProtected)
            {
                var moved = result.ReferencesUpdated + xml;
                await OnClose.InvokeAsync($"{moved} reference{(moved == 1 ? "" : "s")} now use {replacement.Alias}; {Asset.Alias} is protected and was kept.");
                return;
            }
            var (deleted, deleteError) = Asset.Ownership == TestDataOwnership.Generated ? (null, null) : await api.DeleteAsync(Asset.Id, leaveReferencesUnresolved: false);
            if (Asset.Ownership != TestDataOwnership.Generated && deleted is not { Deleted: true }) { _error = $"References now use {replacement.Alias}, but the original was not deleted: {deleteError ?? deleted?.Message}"; return; }
            if (Asset.Ownership == TestDataOwnership.Generated)
            {
                TestDataAssetWorkspace.RemoveGeneratedFixtures(Repository, Services.GetService(typeof(SchemaGeneratedXmlStore)) as SchemaGeneratedXmlStore, new HashSet<string>([Asset.Alias], StringComparer.Ordinal));
                await PersistAsync();
            }
            var total = result.ReferencesUpdated + xml;
            await OnClose.InvokeAsync($"{total} reference{(total == 1 ? "" : "s")} now use {replacement.Alias}; {Asset.Alias} was deleted.");
        }
        finally { _busy = false; }
    }
}
