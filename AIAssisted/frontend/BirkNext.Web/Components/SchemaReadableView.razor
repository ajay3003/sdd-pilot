@using BirkNext.Schemas
@using BirkNext.Web.Services.SchemaStudio
@using P = BirkNext.Web.Services.SchemaStudio.SchemaReadablePresentation
@using S = BirkNext.Web.Services.SchemaStudio.SchemaStudioPresentation

@* Deterministic readable views of the shared effective schema. Facts only; the schema's own documentation verbatim (in its source language);
   no inferred business rules. UI copy is English; technical XSD terms are secondary detail. *@
<section class="sr-view" aria-labelledby="@TitleId">
    @if (View == "Schema dependencies")
    {
        <h3 id="@TitleId">Schema dependencies</h3>
        <p class="sr-note">Dependencies resolve only within this package. Remote schema locations are never fetched, and nothing is guessed.</p>
        <div class="sr-table-wrap" tabindex="0" role="region" aria-label="Schema dependencies (scrollable)">
            <table class="sr-table sr-table-compact" data-testid="sr-dependencies">
                <thead><tr><th scope="col">Schema file</th><th scope="col">Namespace</th><th scope="col">Version</th><th scope="col">Dependency status</th></tr></thead>
                <tbody>
                    @foreach (var file in Package.Files)
                    {
                        var incoming = Package.Files.SelectMany(f => f.Links.Where(l => string.Equals(l.ResolvedFile, file.Name, StringComparison.OrdinalIgnoreCase)).Select(l => (From: f.Name, Link: l))).ToList();
                        <tr data-testid="sr-dependency-file">
                            <td><button type="button" class="sr-link" title="@file.Name" @onclick="() => OnFileSelected.InvokeAsync(file.Name)" aria-label="Open @file.Name as raw XSD">@S.FileName(file.Name)</button>
                                @if (incoming.Count > 0) { <small class="sr-sub">@string.Join("; ", incoming.Select(i => $"{P.KindLabel(i.Link.Kind)} from {S.FileName(i.From)}"))</small> }</td>
                            <td class="sr-namespace">@(file.TargetNamespace ?? "No target namespace")</td>
                            <td>@(file.Version ?? "Not stated")</td>
                            <td data-testid="sr-dependency-status">@FileStatus(file, incoming)</td>
                        </tr>
                    }
                    @foreach (var file in Package.Files)
                    {
                        @foreach (var link in file.Links.Where(l => l.EffectiveStatus is not (SchemaDependencyStatus.Resolved or SchemaDependencyStatus.Circular)))
                        {
                            <tr class="sr-problem" data-testid="sr-dependency-problem">
                                <td><span title="@link.Location">@(link.Location is null ? "(no schemaLocation)" : S.FileName(link.Location))</span><small class="sr-sub">@P.KindLabel(link.Kind) from @S.FileName(file.Name)</small></td>
                                <td class="sr-namespace">@(link.Namespace ?? "—")</td>
                                <td>—</td>
                                <td><strong>@P.DependencyStatusLabel(link.EffectiveStatus)</strong>@if (link.Reason is { } reason) { <small class="sr-sub">@reason</small> }</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <ReviewDisclosure Text="View provenance" CollapseText="Hide provenance" TestId="sr-dependency-provenance" Class="disclosure-small">
            <dl class="sr-facts">
                <div><dt>Source</dt><dd>@SourceLabel</dd></div>
                @foreach (var file in Package.Files)
                {
                    <div><dt>@S.FileName(file.Name)</dt><dd><span class="sr-mono">@file.Name</span><small class="sr-sub">Fingerprint <code>@file.Fingerprint[..Math.Min(12, file.Fingerprint.Length)]</code></small></dd></div>
                }
            </dl>
        </ReviewDisclosure>
        @if (Package.UnresolvedReferences is { Count: > 0 } unresolved)
        {
            <h4>Unresolved references</h4>
            <p class="sr-note">These types or elements are not declared in the package. Members inherited from them are not shown in the readable model.</p>
            <ul class="sr-list" data-testid="sr-unresolved-references">
                @foreach (var reference in unresolved.Take(100)) { <li><code>@reference.QualifiedName</code> <small>(@reference.Kind used in @reference.UsedIn@(reference.Path is { Length: > 1 } path ? " · " + path : ""))</small></li> }
            </ul>
        }
    }
    else if (Package.EffectiveSchema.Count == 0)
    {
        @* A library XSD has no global root element: there is no message to draw, so explain it in normal words and point to what it does declare. *@
        <h3 id="@TitleId">@Title</h3>
        <SchemaLibraryEmptyState Package="Package" OnNavigate="OnNavigate" TestId="sr-no-root" Actions="@SchemaLibraryEmptyState.Definitions("sr-no-root")" />
    }
    else
    {
        <div class="sr-heading">
            <h3 id="@TitleId">@Title</h3>
            @if (Package.EffectiveSchema.Count > 1)
            {
                <label class="sr-root">Top-level element
                    <select @bind="_rootName" aria-label="Top-level element">
                        <option value="">Choose a top-level element</option>
                        @foreach (var candidate in Package.EffectiveSchema) { <option value="@candidate.Name">@candidate.Name (@S.FileName(candidate.DeclaredIn))</option> }
                    </select>
                </label>
            }
        </div>
        @if (Root is not { } root)
        {
            <p class="sr-note" role="status">The package has @Package.EffectiveSchema.Count top-level elements. Choose which one to show; Schema Studio does not guess which one is the message.</p>
        }
        else
        {
            var fields = P.Fields(root, out var truncated);
            @if (truncated) { <p class="sr-warning" role="status">The view is limited to @P.MaxFields fields. The rest are omitted here; see Effective structure or Raw XSD.</p> }
            @switch (View)
            {
                case "Forretning":
                    <p class="sr-note">The message as readable sections: each group, whether it is required, optional or repeating, its key rules in plain language and the schema's own documentation. Types and origin are in Effective structure.</p>
                    @TreeToolbar
                    <article class="sr-business" data-testid="sr-business" @key="_treeGeneration">
                        <header class="sr-business-root">
                            <span class="sr-kicker">Message</span>
                            <h4>@root.Name</h4>
                            <span class="sr-count">@S.Count(root.Children.Count, "top-level section or field", "top-level sections and fields")</span>
                            @if (P.Documentation(root) is { } rootDoc) { @DocBlock(rootDoc.Text, "Show full description") }
                        </header>
                        @BusinessTree((root, root.Name, 0))
                    </article>
                    break;
                case "Felt og regler":
                    <p class="sr-note">Only rules stated in the XSD are shown. Business rules such as date order, sums or one field excluding another are not XSD rules and are not shown.</p>
                    <div class="sr-table-wrap" tabindex="0" role="region" aria-label="Fields and rules (scrollable)">
                        <table class="sr-table" data-testid="sr-fields">
                            <thead><tr><th scope="col" class="sr-col-field">Field</th><th scope="col" class="sr-col-compact">Occurrence</th><th scope="col" class="sr-col-compact">Type</th><th scope="col" class="sr-col-rules">Rules</th><th scope="col" class="sr-col-doc">Documentation</th><th scope="col" class="sr-col-source">Source</th></tr></thead>
                            <tbody>
                                @foreach (var field in fields)
                                {
                                    var member = field.Member;
                                    <tr data-path="@field.Path">
                                        <th scope="row"><span class="sr-name">@member.Name</span><small class="sr-sub sr-mono">@SchemaText.Breakable(field.Path)</small></th>
                                        <td>@Badges(member)<small class="sr-sub sr-mono">@P.ExactCardinality(member)</small></td>
                                        <td>@P.TypeLabel(member)<small class="sr-sub sr-mono">@P.RawType(member)</small></td>
                                        <td>@RulesCell(member)</td>
                                        <td>@if (P.Documentation(member) is { } doc) { @if (doc.FromType) { <small class="sr-sub">From the type:</small> }@DocBlock(doc.Text, "Show full documentation") } else { <span class="sr-muted">—</span> }</td>
                                        <td class="sr-col-source">@SourceCell(member.DeclaredIn, member.NamespaceUri, member.InheritedFrom, member.TypeDeclaredIn)</td>
                                    </tr>
                                    @foreach (var attr in member.Attributes ?? [])
                                    {
                                        <tr data-path="@(field.Path + "/@" + attr.Name)">
                                            <th scope="row"><span class="sr-name">@("@" + attr.Name)</span><small class="sr-sub sr-mono">@SchemaText.Breakable(field.Path + "/@" + attr.Name)</small></th>
                                            <td>@P.AttributeUseLabel(attr)</td>
                                            <td>@P.TypeLabel(attr)<small class="sr-sub sr-mono">@(attr.Type ?? "inline")</small></td>
                                            <td>@FacetCell(attr.Facets)</td>
                                            <td>@if (attr.Documentation is { } attributeDoc) { @DocBlock(P.Normalize(attributeDoc), "Show full documentation") } else { <span class="sr-muted">—</span> }</td>
                                            <td class="sr-col-source">@SourceCell(attr.DeclaredIn, "", attr.InheritedFrom, null)</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    break;
                default:
                    <p class="sr-note">The resolved structure with types, occurrence and origin. Inherited fields are shown where they actually occur.</p>
                    @TreeToolbar
                    <ul class="sr-tree" data-testid="sr-structure" @key="_treeGeneration">
                        <li><span class="sr-name">@root.Name</span> <small>Top-level message element · @(root.Type ?? "inline") · declared in @S.FileName(root.DeclaredIn)</small>@StructureTree((root, 0))</li>
                    </ul>
                    break;
            }
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public SchemaPackage Package { get; set; } = default!;
    /// <summary>"Forretning", "Felt og regler", "Struktur" or "Schema dependencies" (view identifiers; the labels a person reads are English).</summary>
    [Parameter, EditorRequired] public string View { get; set; } = "Forretning";
    [Parameter] public EventCallback<string> OnFileSelected { get; set; }
    /// <summary>Opens another Schema Studio view by its identifier (used by the library explanation).</summary>
    [Parameter] public EventCallback<string> OnNavigate { get; set; }

    /// <summary>The heading a person reads: "Struktur" is Business structure with types and origin.</summary>
    private string Title => View == SchemaStudioNavigation.TechnicalStructureAlias ? "Business structure" : SchemaStudioNavigation.Label(View);
    private string TitleId => "sr-title-" + new string(View.ToLowerInvariant().Select(c => char.IsLetterOrDigit(c) ? c : '-').ToArray());

    private string _rootName = "";
    private string? _packageId;
    /// <summary>Tree disclosure: null = default depth; true/false = Expand all / Collapse all. Re-keying the tree re-applies it to every node.</summary>
    private bool? _expandAll;
    private int _treeGeneration;
    private SchemaTreeFilterKind _filter = SchemaTreeFilterKind.All;
    private string _treeSearch = "";
    private bool Filtering => SchemaTreeFilter.IsFiltering(_filter, _treeSearch);

    private void SetExpanded(bool? expanded) { _expandAll = expanded; _treeGeneration++; }

    private static string FilterLabel(SchemaTreeFilterKind filter) => filter switch
    {
        SchemaTreeFilterKind.Mandatory => "Required fields only",
        SchemaTreeFilterKind.Optional => "Optional fields only",
        SchemaTreeFilterKind.WithDocumentation => "With documentation",
        SchemaTreeFilterKind.WithConstraints => "With rules",
        _ => "All fields",
    };

    /// <summary>A file's dependency status in words: a file nothing imports and that imports nothing has no dependencies at all.</summary>
    private static string FileStatus(SchemaFile file, IReadOnlyList<(string From, SchemaLink Link)> incoming) =>
        incoming.Any(i => i.Link.EffectiveStatus == SchemaDependencyStatus.Circular) ? P.DependencyStatusLabel(SchemaDependencyStatus.Circular)
        : file.Links.Count == 0 && incoming.Count == 0 ? "No imports/includes"
        : file.Links.All(l => l.EffectiveStatus == SchemaDependencyStatus.Resolved) ? P.DependencyStatusLabel(SchemaDependencyStatus.Resolved)
        : "Has unresolved dependencies";

    private RenderFragment TreeToolbar => __builder =>
    {
        <div class="sr-toolbar" data-testid="sr-tree-toolbar">
            <button type="button" class="btn-secondary sr-compact" data-testid="sr-expand-all" @onclick="() => SetExpanded(true)">Expand all</button>
            <button type="button" class="btn-secondary sr-compact" data-testid="sr-collapse-all" @onclick="() => SetExpanded(false)">Collapse all</button>
            <label>Show <select @bind="_filter" @bind:after="() => SetExpanded(null)" data-testid="sr-tree-filter">
                @foreach (var option in Enum.GetValues<SchemaTreeFilterKind>()) { <option value="@option">@FilterLabel(option)</option> }
            </select></label>
            <label>Search fields <input type="search" @bind="_treeSearch" @bind:event="oninput" @bind:after="() => SetExpanded(null)" data-testid="sr-tree-search" /></label>
        </div>
    };

    /// <summary>The file a value is declared in, as a short name; namespace and inheritance in a disclosure so long provenance never crowds the table.</summary>
    private static RenderFragment SourceCell(string declaredIn, string? namespaceUri, string? inheritedFrom, string? typeDeclaredIn) => __builder =>
    {
        <span class="sr-file" title="@declaredIn">@S.FileName(declaredIn)</span>
        <details class="sr-source-details"><summary>View provenance<span class="visually-hidden"> of the source</span></summary>
            <small class="sr-sub">Declared in @declaredIn</small>
            @if (!string.IsNullOrEmpty(namespaceUri)) { <small class="sr-sub">Namespace: @namespaceUri</small> }
            @if (inheritedFrom is not null) { <small class="sr-sub">Inherited from @inheritedFrom</small> }
            @if (typeDeclaredIn is not null && typeDeclaredIn != declaredIn) { <small class="sr-sub">Type from @typeDeclaredIn</small> }
        </details>
    };

    protected override void OnParametersSet()
    {
        if (_packageId == Package.Id) return;
        _packageId = Package.Id;
        _rootName = Package.EffectiveSchema.Count == 1 ? Package.EffectiveSchema[0].Name : "";
    }

    private EffectiveMember? Root => Package.EffectiveSchema.FirstOrDefault(root => root.Name == _rootName);

    private string SourceLabel => Package.Provenance is { SourceSnapshotId: { } snapshot } provenance
        ? $"Source Analysis snapshot {snapshot.ToString("D")[..8]} ({provenance.SourceArchiveName})" : "Local import";

    /// <summary>Business structure: groups are section cards, fields are readable rows with occurrence chips and their key rules in plain words.
    /// No XSD types or origin here — those belong to Effective structure.</summary>
    private RenderFragment<(EffectiveMember Member, string Path, int Depth)> BusinessTree => context =>
        @<ul class="sr-business-list sr-depth-@Math.Min(context.Depth, 4)">
            @foreach (var child in context.Member.Children.Take(context.Depth > 30 ? 0 : 500).Where(c => SchemaTreeFilter.Keep(c, _filter, _treeSearch)))
            {
                <li data-depth="@context.Depth" class="@(child.Children.Count > 0 ? "sr-section" : "sr-field")">
                    @if (child.Children.Count > 0)
                    {
                        <details class="sr-node sr-section-card" open="@SchemaTreeFilter.IsOpen(context.Depth, _expandAll, Filtering)">
                            <summary><span class="sr-name">@child.Name</span> @Badges(child) <small class="sr-count">@S.Count(child.Children.Count, "field", "fields")</small></summary>
                            @if (child.Documentation is { Length: > 0 } doc) { @DocBlock(P.Normalize(doc), "Show full description") }
                            @BusinessTree((child, context.Path + "/" + child.Name, context.Depth + 1))
                        </details>
                    }
                    else
                    {
                        <div class="sr-field-row">
                            <span class="sr-name">@child.Name</span> @Badges(child)
                            @if (SchemaStudioVisuals.PlainRules(child) is { Count: > 0 } rules) { <span class="sr-plain-rules" data-testid="sr-plain-rules">@string.Join(" · ", rules)</span> }
                        </div>
                        @if (child.Documentation is { Length: > 0 } doc) { @DocBlock(P.Normalize(doc), "Show full description") }
                    }
                </li>
            }
        </ul>;

    /// <summary>Occurrence as chips. The first chip carries the exact plain-language occurrence ("Optional, repeating").</summary>
    private static RenderFragment Badges(EffectiveMember member) => __builder =>
    {
        var chips = SchemaStudioVisuals.OccurrenceChips(member);
        <span class="sr-chips">
            <span class="sr-chip sr-chip-@chips[0].Tone" data-testid="sr-occurrence">@P.CardinalityLabel(member)</span>
            @foreach (var chip in chips.Skip(1).Where(c => c.Tone != "choice" || !P.CardinalityLabel(member).Contains("xs:choice"))) { <span class="sr-chip sr-chip-@chip.Tone">@chip.Label</span> }
        </span>
    };

    private RenderFragment StructureTree((EffectiveMember Member, int Depth) context) =>
        @<ul>
            @foreach (var child in context.Member.Children.Take(500).Where(c => SchemaTreeFilter.Keep(c, _filter, _treeSearch)))
            {
                <li>
                    @if (child.Children.Count > 0)
                    {
                        <details class="sr-node" open="@SchemaTreeFilter.IsOpen(context.Depth, _expandAll, Filtering)">
                            <summary><span class="sr-name">@child.Name</span> <small>@P.TypeLabel(child) (@P.RawType(child)) · @P.ExactCardinality(child)</small></summary>
                            <small class="sr-sub">declared in @S.FileName(child.DeclaredIn)@(child.InheritedFrom is { } inherited ? $" · inherited from {inherited}" : "")@(child.TypeDeclaredIn is { } typeFile ? $" · type in {S.FileName(typeFile)}" : "")@(P.CompositorLabel(child.Compositor) is { Length: > 0 } compositor ? " · " + compositor : "")</small>
                            @StructureTree((child, context.Depth + 1))
                        </details>
                    }
                    else
                    {
                        <span class="sr-name">@child.Name</span>
                        <small>@P.TypeLabel(child) (@P.RawType(child)) · @P.ExactCardinality(child)@(P.CompositorLabel(child.Compositor) is { Length: > 0 } compositor ? " · " + compositor : "")</small>
                        <small class="sr-sub">declared in @S.FileName(child.DeclaredIn)@(child.InheritedFrom is { } inherited ? $" · inherited from {inherited}" : "")@(child.TypeDeclaredIn is { } typeFile ? $" · type in {S.FileName(typeFile)}" : "")</small>
                    }
                </li>
            }
        </ul>;

    private RenderFragment RulesCell(EffectiveMember member) => FacetCell(member.Facets);

    /// <summary>Allowed values up to this many are listed inline; longer lists are one disclosure ("9 allowed values").</summary>
    private const int CompactValues = 5;

    /// <summary>Schema documentation, verbatim: a short excerpt by default and the full text one disclosure away when it is long.</summary>
    private static RenderFragment DocBlock(string text, string expandLabel) => __builder =>
    {
        var (preview, truncated) = S.DocumentationPreview(text, 160);
        if (!truncated) { <p class="sr-doc">@text</p> }
        else
        {
            <p class="sr-doc sr-doc-excerpt" data-testid="sr-doc-excerpt">@preview</p>
            <details class="sr-doc-details"><summary>@expandLabel</summary><p class="sr-doc">@text</p></details>
        }
    };

    private RenderFragment FacetCell(IReadOnlyList<SchemaFacet> facets) =>
        @<div class="sr-rules">
            @{ var values = P.AllowedValues(facets); var rules = P.Rules(facets); }
            @if (values.Count > CompactValues)
            {
                <details class="sr-values-details" data-testid="sr-allowed-values"><summary>@S.Count(values.Count, "allowed value", "allowed values")<span class="visually-hidden"> — view values</span></summary>
                    <ul class="sr-values">@foreach (var value in values) { <li><code>@value.Value</code>@if (value.Documentation is { } meaning) { <span> — @P.Normalize(meaning)</span> }</li> }</ul>
                </details>
            }
            else if (values.Count > 0)
            {
                <div><span class="sr-label">Allowed values:</span>
                    <ul class="sr-values">@foreach (var value in values) { <li><code>@value.Value</code>@if (value.Documentation is { } meaning) { <span> — @P.Normalize(meaning)</span> }</li> }</ul>
                </div>
            }
            @foreach (var rule in rules)
            {
                <div>@rule.Text @if (rule.Raw is { } raw) { <small class="sr-sub sr-mono">@raw</small> }</div>
            }
            @if (values.Count == 0 && rules.Count == 0) { <span class="sr-muted">—</span> }
        </div>;
}
