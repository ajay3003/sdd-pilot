@using BirkNext.Web.Services
@* The header every page of a testing workspace shares (Manual Testing today; Technical Testing can pass its own stages): the workspace and its
   stages as one navigation (the current stage marked), the page title and lead, and the project the page works on. Stages are destinations,
   never gates: every stage stays reachable. *@

<header class="twh" data-testid="twh">
    <nav class="twh-stages" aria-label="@($"{Workspace} stages")" data-testid="twh-stages">
        <a href="@HomeRoute" class="twh-stage twh-home @(Current is null ? "is-current" : null)" aria-current="@(Current is null ? "page" : null)" data-testid="twh-stage" data-stage="home">@Workspace</a>
        @foreach (var (stage, n) in Stages.Select((s, i) => (s, i + 1)))
        {
            <a href="@stage.Route" class="twh-stage @(stage.Id == Current ? "is-current" : null)" aria-current="@(stage.Id == Current ? "page" : null)"
               data-testid="twh-stage" data-stage="@stage.Id"><span class="twh-n" aria-hidden="true">@n</span>@stage.Title</a>
        }
    </nav>
    <div class="twh-eyebrow">@Workspace@(CurrentStage is { } s ? $" · {s.Question}" : "") @Help</div>
    <h1 class="twh-title" data-testid="twh-title">@Title</h1>
    @if (Lead is not null) { <p class="twh-lead">@Lead</p> }
    @if (ShowProject)
    {
        <p class="twh-context" data-testid="twh-project">
            @if (ProjectName is { Length: > 0 } project) { <span>Project: <strong>@project</strong></span> }
            else if (Restoring) { <span role="status" data-testid="twh-project-restoring">Loading the selected project…</span> }
            else { <span>No project selected — <a href="project-import">import or choose a project</a>.</span> }
            @if (Context is { Length: > 0 } context) { <span class="twh-sep" aria-hidden="true">·</span><span data-testid="twh-context">@context</span> }
        </p>
        @if (BoundElsewhere is { } other)
        {
            @* The workspaces follow the application the tester chose; the active environment still points at another one. Say so — runs against
               that environment would test the other application. *@
            <p class="mt-note mt-note-warn" role="status" data-testid="twh-environment-elsewhere">
                The active Target Environment <strong>@other.EnvironmentName</strong> belongs to <strong>@other.ApplicationName</strong>, not to this project.
                <a href="admin/system-settings?section=target-environments" data-testid="twh-environment-elsewhere-link">Choose or bind a Target Environment</a>
                before running technical or integration tests.
            </p>
        }
    }
</header>

@code {
    [Parameter, EditorRequired] public string Workspace { get; set; } = "";
    [Parameter, EditorRequired] public string HomeRoute { get; set; } = "";
    [Parameter, EditorRequired] public IReadOnlyList<WorkspaceStage> Stages { get; set; } = [];
    /// <summary>The current stage id; null = the workspace home.</summary>
    [Parameter] public string? Current { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Lead { get; set; }
    [Parameter] public string? ProjectName { get; set; }

    [Inject] private IServiceProvider HeaderServices { get; set; } = default!;

    /// <summary>The saved project selection is still being read (the workspace projection has no snapshot yet): say so instead of "No project
    /// selected", which would be wrong for a few hundred milliseconds after every fresh start.</summary>
    private bool Restoring => HeaderServices.GetService(typeof(BirkNext.Web.Services.ICurrentWorkspaceProjection)) is BirkNext.Web.Services.ICurrentWorkspaceProjection { Current: null };
    /// <summary>The active Target Environment is bound to another application than the chosen one (see IArtifactExplorerContext).</summary>
    private BirkNext.Web.Services.Explorers.EnvironmentBindingElsewhere? BoundElsewhere =>
        (HeaderServices.GetService(typeof(BirkNext.Web.Services.Explorers.IArtifactExplorerContext)) as BirkNext.Web.Services.Explorers.IArtifactExplorerContext)?.EnvironmentBoundElsewhere;
    /// <summary>Extra context after the project (source snapshot, plan), shown as plain text.</summary>
    [Parameter] public string? Context { get; set; }
    /// <summary>False when the page shows its own project context bar (so the project is not repeated).</summary>
    [Parameter] public bool ShowProject { get; set; } = true;
    /// <summary>Optional help link in the eyebrow.</summary>
    [Parameter] public RenderFragment? Help { get; set; }

    private WorkspaceStage? CurrentStage => Stages.FirstOrDefault(s => s.Id == Current);
}
