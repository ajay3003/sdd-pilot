@using BirkNext.SourceDomains
@using BirkNext.Web.Services

@* Source Analysis → Configuration: normalized configuration entries of the selected snapshot (stored analysis, never re-analyzed). Secret values
   are never shown: sensitive entries show their kind only. Different environments are variants, not conflicts. Configured ≠ deployed. *@
<section class="sd-workspace" aria-labelledby="sd-config-heading" data-testid="configuration-workspace">
    <SourceDomainHeader Title="Configuration" Slug="config" Result="C" Note="@SourceEvidenceDomainsPresentation.ConfigurationNote" HeadingId="sd-config-heading" />
    @if (!SourceEvidenceDomainsPresentation.Assessed(C) && Declared.Count == 0)
    {
        <div class="sd-empty" data-testid="sd-config-not-assessed"><p><strong>@(C.Status == SourceDomainStatus.NotDetected ? "No supported configuration files detected in the selected source." : SourceDomainText.Label(C.Status))</strong></p></div>
        <SourceDomainLimitations Slug="config" Result="C" Capabilities="Capabilities" />
    }
    else
    {
        <SourceViewNav Label="Configuration views" Views="Tabs" Current="@Tab" CurrentChanged="value => _tab = value" Prefix="sd-config-tab" />
        @if (Tab == DeclaredTab)
        {
            @DeclaredValues
        }
        else if (Tab == "Overview")
        {
            @* Four headline counts; every other count is a row of the category breakdown or a secondary signal below it. *@
            <dl class="sd-summary sd-summary-primary" data-testid="sd-config-overview">
                <div><dt>Configuration files</dt><dd>@C.Files.Count</dd></div>
                <div><dt>Entries</dt><dd>@C.Entries.Count</dd></div>
                <div><dt>Environment labels</dt><dd data-testid="sd-config-environment-count">@SourceEvidenceDomainsPresentation.NamedEnvironments(C)</dd></div>
                <div><dt>Sensitive references</dt><dd data-testid="sd-config-sensitive">@C.Entries.Count(e => e.Sensitivity != ConfigurationSensitivity.None)</dd></div>
            </dl>
            <div class="sd-panels">
                <section class="sd-panel" aria-labelledby="sd-config-categories-heading" data-testid="sd-config-categories">
                    <h3 id="sd-config-categories-heading">Entries by category</h3>
                    <p class="sd-muted">Classified from the key; uncertain keys stay Unknown. Sensitive values are counted, never shown.</p>
                    <div class="sd-scroll" tabindex="0" role="region" aria-label="Entries by category">
                        <table class="sd-links-table" data-testid="sd-config-category-table">
                            <thead><tr><th scope="col">Category</th><th scope="col">Entries</th></tr></thead>
                            <tbody>@foreach (var g in C.Entries.GroupBy(e => e.Category).OrderByDescending(g => g.Count()).ThenBy(g => g.Key)) { <tr data-category="@g.Key" data-testid="sd-config-category"><th scope="row">@SourceDomainText.Label(g.Key)</th><td>@g.Count()</td></tr> }</tbody>
                        </table>
                    </div>
                    <dl class="sd-mini" data-testid="sd-config-signals">
                        <div><dt>External endpoints (URL values)</dt><dd>@C.Entries.Count(e => e.ValueKind == ConfigurationValueKind.Url)</dd></div>
                        <div><dt>Placeholders</dt><dd>@C.Entries.Count(e => e.ValueKind == ConfigurationValueKind.Placeholder)</dd></div>
                        <div><dt>Potential conflicts</dt><dd data-testid="sd-config-conflict-count">@C.Conflicts.Count</dd></div>
                    </dl>
                </section>
                <section class="sd-panel" aria-labelledby="sd-config-environments-heading" data-testid="sd-config-environments">
                    <h3 id="sd-config-environments-heading">Environment labels found in source</h3>
                    <p class="sd-muted">Taken from file-name suffixes, launch profiles and folder names. They are naming conventions in source — not deployed environments and not Target Environments.</p>
                    <ul class="sd-list">@foreach (var e in C.Environments) { <li>@SourceDomainText.Label(e) <span class="sd-context">source label · @e.Kind · @C.Entries.Count(x => x.Environment == e) entr(ies)</span></li> }</ul>
                </section>
            </div>
            @if (C.Conflicts.Count > 0)
            {
                <section class="sd-panel" aria-labelledby="sd-config-conflicts-heading" data-testid="sd-config-conflicts">
                    <h3 id="sd-config-conflicts-heading">Potential conflicts <span class="sd-count">@C.Conflicts.Count</span></h3>
                    <p class="sd-muted">Same key and environment label with different values in sources one application loads together. Needs review — not an error.</p>
                    <ul class="sd-list">@foreach (var c in C.Conflicts) { <li data-testid="sd-config-conflict"><code>@c.NormalizedKey</code> · @SourceDomainText.Label(c.Environment) · @string.Join(" + ", c.Files)</li> }</ul>
                </section>
            }
            <SourceDomainLimitations Slug="config" Result="C" Capabilities="Capabilities" />
        }
        else if (Tab == "Entries")
        {
            var rows = SourceEvidenceDomainsPresentation.Filter(C.Entries, _filter).ToList();
            <section class="sd-panel" aria-labelledby="sd-config-entries-heading" data-testid="sd-config-entries">
                <h3 id="sd-config-entries-heading">Configuration entries <span class="sd-count">@C.Entries.Count</span></h3>
                <div class="sd-filterbar" data-testid="sd-config-filters">
                    <label>Category <select data-testid="sd-config-filter-category" value="@_filter.Category" @onchange="e => _filter = _filter with { Category = (string)e.Value! }"><option value="">All</option>@foreach (var c in C.Entries.Select(e => e.Category).Distinct().Order()) { <option value="@c">@SourceDomainText.Label(c)</option> }</select></label>
                    <label>Environment label <select data-testid="sd-config-filter-environment" value="@_filter.Environment" @onchange="e => _filter = _filter with { Environment = (string)e.Value! }"><option value="">All</option>@foreach (var env in C.Environments) { <option value="@SourceEvidenceDomainsPresentation.EnvironmentKey(env)">@SourceDomainText.Label(env)</option> }</select></label>
                    <label>Technology <select data-testid="sd-config-filter-technology" value="@_filter.Technology" @onchange="e => _filter = _filter with { Technology = (string)e.Value! }"><option value="">All</option>@foreach (var t in C.Entries.Select(e => e.Technology).Distinct().Order(StringComparer.Ordinal)) { <option value="@t">@t</option> }</select></label>
                    <label>Source <select data-testid="sd-config-filter-file" value="@_filter.File" @onchange="e => _filter = _filter with { File = (string)e.Value! }"><option value="">All files</option>@foreach (var f in C.Files) { <option value="@f.Path">@f.Path</option> }</select></label>
                    <label>Sensitivity <select data-testid="sd-config-filter-sensitivity" value="@_filter.Sensitivity" @onchange="e => _filter = _filter with { Sensitivity = (string)e.Value! }"><option value="">All</option><option value="Sensitive">Sensitive / secret references</option><option value="None">Not sensitive</option></select></label>
                    <label>Key <input type="search" data-testid="sd-config-search" value="@_filter.Search" @oninput="e => _filter = _filter with { Search = (string?)e.Value ?? string.Empty }" /></label>
                </div>
                <p class="sd-muted" role="status" data-testid="sd-config-shown">@rows.Count of @C.Entries.Count shown</p>
                <div class="sd-scroll" tabindex="0" role="region" aria-label="Configuration entries">
                    <table data-testid="sd-config-entry-table">
                        <thead><tr><th scope="col">Key</th><th scope="col">Category</th><th scope="col">Value</th><th scope="col">Environment label</th><th scope="col">Source</th></tr></thead>
                        <tbody>
                            @foreach (var e in rows.Take(_limit))
                            {
                                <tr data-testid="sd-config-entry" data-sensitive="@(e.Sensitivity != ConfigurationSensitivity.None ? "true" : "false")">
                                    <th scope="row"><code>@e.Key</code>@if (e.Component is { } c) { <span class="sd-context">@c</span> }</th>
                                    <td>@SourceDomainText.Label(e.Category)</td>
                                    <td class="@(e.Sensitivity != ConfigurationSensitivity.None ? "sd-redacted" : "")">@SourceEvidenceDomainsPresentation.ValueText(e)</td>
                                    <td>@SourceDomainText.Label(e.Environment)</td>
                                    <td class="sd-path">@SourceEvidenceDomainsPresentation.Location(e.File, e.Line)<span class="sd-context">@e.Technology</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (rows.Count > _limit) { <button type="button" class="btn-secondary" data-testid="sd-config-more" @onclick="() => _limit += 300">Show more (@(rows.Count - _limit) remaining)</button> }
            </section>
        }
        else if (Tab == "Files")
        {
            <section class="sd-panel" aria-labelledby="sd-config-files-heading" data-testid="sd-config-files">
                <h3 id="sd-config-files-heading">Configuration sources <span class="sd-count">@C.Files.Count</span></h3>
                <div class="sd-scroll" tabindex="0" role="region" aria-label="Configuration sources">
                    <table>
                        <thead><tr><th scope="col">File</th><th scope="col">Technology</th><th scope="col">Environment label</th><th scope="col">Component</th><th scope="col">Entries</th></tr></thead>
                        <tbody>@foreach (var f in C.Files) { <tr data-testid="sd-config-file"><th scope="row" class="sd-path">@f.Path</th><td>@f.Technology</td><td>@SourceDomainText.Label(f.Environment)<span class="sd-context">@f.EnvironmentBasis</span></td><td>@(f.Component ?? "—")</td><td>@(f.Parsed ? f.Entries.ToString() : "Not parsed")</td></tr> }</tbody>
                    </table>
                </div>
            </section>
        }
        else
        {
            <SourceDomainChanges Slug="config" Label="Configuration" Domain="SourceEvidenceDomain.Configuration" Current="Evidence" Previous="Previous" />
        }
    }
</section>
@code {
    [Parameter, EditorRequired] public SourceEvidenceDomainsSnapshot Evidence { get; set; } = default!;
    [Parameter] public (string Label, SourceEvidenceDomainsSnapshot Evidence)? Previous { get; set; }
    private ConfigurationEvidence C => Evidence.Configuration;
    private IEnumerable<DomainCapability> Capabilities => Evidence.Capabilities.Where(c => c.Domain == SourceEvidenceDomain.Configuration);
    private const string DeclaredTab = "Declared values";
    private IReadOnlyList<SourceConfigurationValue> Declared => Evidence.ConfigurationValues?.Values ?? [];
    /// <summary>Configuration files give the usual views; values declared by other artifacts (API documents, IaC) add "Declared values".</summary>
    private string[] Tabs => SourceEvidenceDomainsPresentation.Assessed(C)
        ? Declared.Count > 0 ? ["Overview", DeclaredTab, "Entries", "Files", "Changes"] : ["Overview", "Entries", "Files", "Changes"]
        : [DeclaredTab];
    private string _tab = "Overview";
    private string Tab => Tabs.Contains(_tab) ? _tab : Tabs[0];

    /// <summary>Values artifacts declare under generic semantic keys, grouped; each with its artifact and location. Agreeing artifacts are one row
    /// with several sources; disagreeing ones are a conflict. Declared in source: never configured, never runtime verified.</summary>
    private RenderFragment DeclaredValues => __builder =>
    {
        var resolutions = SourceConfigurationResolver.Resolve(Declared);
        var conflicts = resolutions.Count(item => item.State == SourceConfigurationResolutionState.Conflict);
        <section class="sd-panel" aria-labelledby="sd-config-declared-heading" data-testid="sd-config-declared">
            <h3 id="sd-config-declared-heading">Declared values <span class="sd-count">@resolutions.Count</span></h3>
            <p class="sd-muted" data-testid="sd-config-declared-note">Declared in source by API documents and Infrastructure as Code · runtime not verified · not configuration until a person accepts it where it is used.
                @if (conflicts > 0) { <strong role="status" data-testid="sd-config-declared-conflicts"> @conflicts configuration conflict@(conflicts == 1 ? "" : "s").</strong> }</p>
            @foreach (var group in resolutions.GroupBy(item => item.Candidates.SelectMany(c => c.Provenance).First().Group).OrderBy(group => group.Key))
            {
                var dense = group.Key is SourceConfigurationGroup.ApiEndpoints or SourceConfigurationGroup.Contract;
                <ReviewDisclosure Text="@($"{SourceGuidancePresentation.Group(group.Key)} ({group.Count()})")" CollapseText="@($"Hide {SourceGuidancePresentation.Group(group.Key)}")"
                                  Expanded="!dense" TestId="sd-config-declared-group" Class="disclosure-inline">
                    <div class="sd-scroll" tabindex="0" role="region" aria-label="@($"Declared values: {SourceGuidancePresentation.Group(group.Key)}")">
                        <table data-testid="sd-config-declared-table">
                            <thead><tr><th scope="col">Semantic key</th><th scope="col">Value</th><th scope="col">Environment</th><th scope="col">Source</th><th scope="col">State</th></tr></thead>
                            <tbody>
                                @foreach (var item in group)
                                {
                                    <tr data-testid="sd-config-declared-row" data-key="@item.SemanticKey" data-state="@item.State">
                                        <th scope="row"><code>@item.SemanticKey</code></th>
                                        <td>@foreach (var candidate in item.Candidates) { <div class="sd-path">@(candidate.Value ?? "(sensitive — not shown)")</div> }</td>
                                        <td>@(item.Environment == SourceEnvironmentRole.Any ? "—" : item.Environment.ToString())</td>
                                        <td>@foreach (var source in item.Candidates.SelectMany(candidate => candidate.Provenance)) { <div class="sd-path">@SourceGuidancePresentation.Kind(source.EvidenceKind) · @source.Artifact → @source.Location<span class="sd-context">@source.Basis</span></div> }</td>
                                        <td>@(item.State switch { SourceConfigurationResolutionState.Conflict => "Configuration conflict", SourceConfigurationResolutionState.Agreed => "Declared · sources agree", _ => "Declared in source" })<span class="sd-context">Runtime not verified</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </ReviewDisclosure>
            }
            @if (Evidence.ConfigurationValues?.Limitations is { Count: > 0 } limitations) { <ul class="sd-list sd-muted">@foreach (var item in limitations) { <li>@item</li> }</ul> }
        </section>
    };
    private SourceEvidenceDomainsPresentation.ConfigFilter _filter = new();
    private int _limit = 300;
}
