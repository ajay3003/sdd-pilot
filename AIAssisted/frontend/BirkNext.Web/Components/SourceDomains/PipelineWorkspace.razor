@using BirkNext.SourceDomains
@using BirkNext.Web.Services

@* Source Analysis → CI/CD: pipeline definitions of the selected snapshot (stored analysis). A step listed here is what a pipeline intends to
   run — never that it ran or passed; no execution history is read. Secrets are names only. *@
<section class="sd-workspace" aria-labelledby="sd-cicd-heading" data-testid="cicd-workspace">
    <SourceDomainHeader Title="CI/CD" Slug="cicd" Result="P" Note="@SourceEvidenceDomainsPresentation.PipelineNote" HeadingId="sd-cicd-heading" Reason="@SourceAnalysisReview.CiCdReason(P)" />
    @if (!SourceEvidenceDomainsPresentation.Assessed(P))
    {
        <div class="sd-empty" data-testid="sd-cicd-not-assessed">
            <p><strong>@(P.Status == SourceDomainStatus.NotDetected ? "No pipeline definition detected in the selected source." : SourceDomainText.Label(P.Status))</strong></p>
            <p class="sd-muted">That does not mean the project has no CI/CD: pipelines may live in another repository or in the CI system itself.</p>
        </div>
        <SourceDomainLimitations Slug="cicd" Result="P" Capabilities="Capabilities" />
    }
    else
    {
        var runnable = P.Pipelines.Where(p => !p.IsTemplate).ToList();
        var steps = P.Pipelines.SelectMany(p => p.Steps).ToList();
        var templates = P.Pipelines.Count(p => p.IsTemplate);
        var iac = steps.Count(s => s.Kind is PipelineStepKind.InfrastructureDeploy or PipelineStepKind.InfrastructurePlan);
        var checks = steps.Count(s => SourceEvidenceDomainsPresentation.IsCheck(s.Kind));
        <p class="sd-lead" data-testid="sd-cicd-lead">@SourceAnalysisReview.Plural(runnable.Count, "pipeline", "pipelines") detected</p>
        <dl class="sd-summary" data-testid="sd-cicd-overview">
            <div><dt>Build</dt><dd>@SourceAnalysisReview.Plural(steps.Count(s => s.Kind is PipelineStepKind.Build or PipelineStepKind.Restore or PipelineStepKind.ContainerBuild), "step", "steps")</dd></div>
            <div><dt>Tests</dt><dd data-testid="sd-cicd-tests">@SourceAnalysisReview.Plural(steps.Count(s => SourceEvidenceDomainsPresentation.IsTest(s.Kind)), "step", "steps")</dd></div>
            @{ var deployStages = P.Pipelines.Sum(p => p.Stages.Count(s => s.Deployment)); }
            <div><dt>Deployment</dt><dd class="@(deployStages == 0 ? "sd-muted" : "")">@(deployStages == 0 ? "None detected" : SourceAnalysisReview.Plural(deployStages, "stage", "stages"))</dd></div>
            <div><dt>Triggers</dt><dd>@runnable.Sum(p => p.Triggers.Count(t => t.Type != "none")) detected</dd></div>
            <div data-testid="sd-cicd-checks-item"><dt>Security / dependency checks</dt><dd data-testid="sd-cicd-checks">@(checks == 0 ? "Not detected" : SourceAnalysisReview.Plural(checks, "step", "steps"))</dd></div>
            @if (templates > 0) { <div><dt>Templates</dt><dd>@templates</dd></div> }
            @{ var unclassified = steps.Count(s => s.Kind == PipelineStepKind.Other); }
            @if (unclassified > 0) { <div data-testid="sd-cicd-unclassified-item"><dt>Steps not categorized</dt><dd data-testid="sd-cicd-unclassified">@SourceAnalysisReview.Plural(unclassified, "step needs", "steps need") classification <span class="sd-context">setup and other steps BirkNext does not categorize — not failures</span></dd></div> }
            @if (iac > 0) { <div><dt>IaC steps</dt><dd>@iac</dd></div> }
        </dl>
        <div class="sa-actions"><button type="button" class="btn-primary" data-testid="sd-cicd-review" @onclick="ReviewPipelines">Review pipelines</button></div>
        var groups = SourceEvidenceDomainsPresentation.PipelineGroups(P);
        <section class="sd-panel" aria-labelledby="sd-cicd-pipelines-heading" data-testid="sd-cicd-pipelines">
            <h3 id="sd-cicd-pipelines-heading" tabindex="-1">Pipelines <span class="sd-count">@P.Pipelines.Count</span></h3>
            @if (groups.Any(g => g.Stem is not null))
            {
                <p class="sa-help-text" data-testid="sd-cicd-grouping-note">Pipelines whose names differ only by an environment suffix (for example -dev / -qa) are shown together — a presentation grouping by name, not shared ownership or deployment.</p>
            }
            <div class="sd-scroll sa-stack" tabindex="0" role="region" aria-label="Pipelines">
                <table role="table" data-testid="sd-cicd-pipeline-table">
                    <thead role="rowgroup"><tr role="row"><th role="columnheader" scope="col">Pipeline</th><th role="columnheader" scope="col">Definition</th><th role="columnheader" scope="col">Trigger</th><th role="columnheader" scope="col">Tests</th><th role="columnheader" scope="col">Deploy</th><th role="columnheader" scope="col">Environment</th><th role="columnheader" scope="col"><span class="visually-hidden">Pipeline details</span></th></tr></thead>
                    @foreach (var group in groups)
                    {
                        <tbody role="rowgroup" data-testid="sd-cicd-group" data-group="@(group.Stem ?? (group.Templates ? "templates" : group.Pipelines[0].Id))">
                            @if (group.Stem is { } stem)
                            {
                                <tr role="row" data-testid="sd-cicd-group-header"><th role="rowheader" scope="colgroup" colspan="7" class="sa-variant-group">@stem <span class="sd-context">@group.Pipelines.Count variants by name: @string.Join(", ", group.Variants)</span></th></tr>
                            }
                            else if (group.Templates)
                            {
                                <tr role="row" data-testid="sd-cicd-group-header"><th role="rowheader" scope="colgroup" colspan="7" class="sa-variant-group">Templates <span class="sd-context">included by other pipelines · @group.Pipelines.Count</span></th></tr>
                            }
                            @foreach (var p in group.Pipelines)
                            {
                                var effective = SourceEvidenceDomainsPresentation.EffectiveSteps(P, p);
                                var open = _open.Contains(p.Id);
                                var detailId = DetailId(p);
                                var tests = effective.Count(s => SourceEvidenceDomainsPresentation.IsTest(s.Kind));
                                var deploys = effective.Count(s => SourceEvidenceDomainsPresentation.IsDeploy(s.Kind));
                                <tr role="row" data-testid="sd-cicd-pipeline" data-template="@(p.IsTemplate ? "true" : "false")">
                                    <th role="rowheader" scope="row">@p.Name</th>
                                    <td role="cell" data-label="Definition" data-testid="sd-cicd-review-state">@PipelineDefinitionState(p)</td>
                                    <td role="cell" data-label="Trigger" data-testid="sd-cicd-trigger-types">@TriggerSummary(p)</td>
                                    <td role="cell" data-label="Tests" class="@(tests == 0 ? "sd-muted" : "")">@(tests == 0 ? "None detected" : SourceAnalysisReview.Plural(tests, "test step", "test steps"))</td>
                                    <td role="cell" data-label="Deploy" class="@(deploys == 0 ? "sd-muted" : "")">@(deploys == 0 ? "None detected" : SourceAnalysisReview.Plural(deploys, "deploy step", "deploy steps"))</td>
                                    <td role="cell" data-label="Environment">@(p.Environments.Count == 0 ? "—" : string.Join(", ", p.Environments))</td>
                                    <td role="cell"><button type="button" class="sd-link" aria-expanded="@(open ? "true" : "false")" aria-controls="@(open ? detailId : null)" data-testid="sd-cicd-open" @onclick="() => Toggle(p.Id)">@(open ? "Hide pipeline details" : "View pipeline details")<span class="visually-hidden"> for @p.Name</span></button></td>
                                </tr>
                                @if (open)
                                {
                                    <tr role="row" class="sd-detail-row" id="@detailId" data-testid="sd-cicd-detail"><td role="cell" colspan="7">@Detail(p, effective)</td></tr>
                                }
                            }
                        </tbody>
                    }
                </table>
            </div>
        </section>
        @if (P.DependencyAutomation.Count > 0) { <p class="sd-muted" data-testid="sd-cicd-automation">Dependency-update automation configured: @string.Join(", ", P.DependencyAutomation)</p> }
        <SourceDomainChanges Slug="cicd" Label="CI/CD" Domain="SourceEvidenceDomain.CiCd" Current="Evidence" Previous="Previous" />
        <SourceDomainLimitations Slug="cicd" Result="P" Capabilities="Capabilities" />
    }
</section>
@code {
    [Parameter, EditorRequired] public SourceEvidenceDomainsSnapshot Evidence { get; set; } = default!;
    [Parameter] public (string Label, SourceEvidenceDomainsSnapshot Evidence)? Previous { get; set; }
    private PipelineEvidence P => Evidence.CiCd;
    private IEnumerable<DomainCapability> Capabilities => Evidence.Capabilities.Where(c => c.Domain == SourceEvidenceDomain.CiCd);
    private readonly HashSet<string> _open = [];
    private readonly HashSet<string> _showOther = [];
    private readonly Dictionary<string, string> _detailIds = [];
    private void Toggle(string id) { if (!_open.Add(id)) _open.Remove(id); }
    [Inject] private IJSRuntime JS { get; set; } = default!;
    private async Task ReviewPipelines() { try { await JS.InvokeVoidAsync("birknextFocusElement", "sd-cicd-pipelines-heading"); } catch (JSException) { } }
    /// <summary>The definition state of one pipeline, kept apart from its trigger, test and deployment columns: a template is included by other
    /// pipelines; otherwise the definition was detected in source (never "passed": nothing ran).</summary>
    private static string PipelineDefinitionState(PipelineDefinition p) => p.IsTemplate ? "Template" : "Detected in source";

    /// <summary>Trigger types only; a pipeline without a push/PR/schedule trigger says so in this column, not as a review state.</summary>
    private static string TriggerSummary(PipelineDefinition p) =>
        !p.IsTemplate && p.Triggers.All(t => t.Type is "none" or "manual") && p.Triggers.Any(t => t.Type == "manual") ? "Manual only"
        : !p.IsTemplate && p.Triggers.All(t => t.Type == "none") ? "None detected"
        : SourceEvidenceDomainsPresentation.TriggerTypes(p);
    private string DetailId(PipelineDefinition p) => _detailIds.TryGetValue(p.Id, out var id) ? id : _detailIds[p.Id] = $"sd-cicd-detail-{_detailIds.Count + 1}";

    /// <summary>The full evidence of one pipeline: exact trigger rules (branches, paths, cron), stages, templates, secret names and every step.</summary>
    private RenderFragment Detail(PipelineDefinition selected, List<PipelineStep> effective) => __builder =>
    {
        var showOther = _showOther.Contains(selected.Id);
        <dl class="sd-facts">
            <div><dt>File</dt><dd class="sd-path">@SourceDomainText.Label(selected.Platform) · @selected.File</dd></div>
            <div><dt>Triggers</dt><dd data-testid="sd-cicd-triggers">@if (selected.Triggers.Count == 0) { <span>None declared</span> } else { <ul class="sd-list">@foreach (var t in selected.Triggers) { <li>@SourceEvidenceDomainsPresentation.TriggerText(t)</li> }</ul> }</dd></div>
            <div><dt>Stages</dt><dd>@(selected.Stages.Count == 0 ? "—" : string.Join(" → ", selected.Stages.Select(s => s.Deployment ? $"{s.Name} (deploys to {s.Environment ?? "an environment"})" : s.Name)))</dd></div>
            <div><dt>Templates</dt><dd class="sd-path">@(selected.Templates.Count == 0 ? "—" : string.Join(", ", selected.Templates))</dd></div>
            <div><dt>Secret references</dt><dd data-testid="sd-cicd-secrets">@(selected.SecretReferences.Count == 0 ? "None found" : string.Join(", ", selected.SecretReferences)) <span class="sd-context">Names only — values are never read.</span></dd></div>
            <div><dt>Federated credentials (OIDC)</dt><dd>@(selected.UsesFederatedCredentials ? "Declared" : "Not found")</dd></div>
            <div><dt>Approvals in source</dt><dd>@(selected.ApprovalsDeclared ? "Declared" : "Not declared in source (environment checks may be configured in the CI system)")</dd></div>
        </dl>
        <div class="sd-scroll" tabindex="0" role="region" aria-label="@($"Steps of {selected.Name}")">
            <table data-testid="sd-cicd-step-table">
                <thead><tr><th scope="col">Step</th><th scope="col">Kind</th><th scope="col">Tool</th><th scope="col">Stage / job</th><th scope="col">Targets</th></tr></thead>
                <tbody>@foreach (var s in effective.Where(s => s.Kind != PipelineStepKind.Other || showOther)) { <tr data-testid="sd-cicd-step" data-kind="@s.Kind"><th scope="row">@s.Name<span class="sd-context">@(s.Id.Split('#')[0] == selected.File ? "" : $"from {s.Id.Split('#')[0]}")</span></th><td>@SourceDomainText.Label(s.Kind)</td><td>@s.Tool</td><td>@string.Join(" / ", new[] { s.Stage, s.Job }.Where(x => x is not null))@(s.Environment is { } env ? $" · {env}" : "")</td><td class="sd-path">@string.Join(", ", s.Targets)</td></tr> }</tbody>
            </table>
        </div>
        <label class="sd-check"><input type="checkbox" data-testid="sd-cicd-show-other" checked="@showOther" @onchange="e => ToggleOther(selected.Id, (bool)e.Value!)" /> Show setup and other steps (@effective.Count(s => s.Kind == PipelineStepKind.Other))</label>
        <p class="sd-muted">@SourceDomainText.StepNotExecuted.</p>
    };
    private void ToggleOther(string id, bool show) { if (show) _showOther.Add(id); else _showOther.Remove(id); }
}
