@using BirkNext.SourceDomains
@using BirkNext.Web.Services

@* Analyzer coverage (what the analyzer can read — Partial for heuristic readers, Unsupported reported, never guessed), diagnostics and
   limitations of one domain. Two compact disclosures in one row (collapsed by default, aria-expanded on the toggle); the detail is unchanged. *@
<div class="sa-disclosures" data-testid="@($"sd-{Slug}-limitations")">
    <ReviewDisclosure Text="@($"Analyzer coverage ({CapabilityList.Count})")" CollapseText="Hide analyzer coverage" TestId="@($"sd-{Slug}-coverage")" Class="disclosure-inline">
        <div class="sd-scroll" tabindex="0" role="region" aria-label="Analyzer coverage">
            <table>
                <thead><tr><th scope="col">Technology</th><th scope="col">Parser coverage</th><th scope="col">What is read</th></tr></thead>
                <tbody>@foreach (var c in CapabilityList) { <tr data-testid="@($"sd-{Slug}-capability")"><th scope="row">@c.Technology</th><td><SourceStatusBadge Dimension="SourceStatusDimension.ParserSupport" Label="@c.Support.ToString()" /></td><td>@c.Detail</td></tr> }</tbody>
            </table>
        </div>
    </ReviewDisclosure>
    <ReviewDisclosure Text="@($"Limitations ({Result.Limitations.Count + Result.Diagnostics.Count})")" CollapseText="Hide limitations and diagnostics" TestId="@($"sd-{Slug}-limits")" Class="disclosure-inline">
        <ul class="sd-list">
            @foreach (var l in Result.Limitations) { <li>@l</li> }
            @foreach (var d in Result.Diagnostics) { <li data-testid="@($"sd-{Slug}-diagnostic")"><strong>@d.Kind:</strong> @d.Message @if (d.File is { } f) { <span class="sd-path">@SourceEvidenceDomainsPresentation.Location(f, d.Line)</span> }</li> }
        </ul>
    </ReviewDisclosure>
</div>
@code {
    [Parameter, EditorRequired] public string Slug { get; set; } = "";
    [Parameter, EditorRequired] public SourceDomainResult Result { get; set; } = default!;
    [Parameter] public IEnumerable<DomainCapability> Capabilities { get; set; } = [];
    private List<DomainCapability> CapabilityList => Capabilities.ToList();
}
