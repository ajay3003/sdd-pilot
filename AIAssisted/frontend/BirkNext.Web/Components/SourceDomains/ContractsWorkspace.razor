@using BirkNext.SourceDomains
@using BirkNext.Web.Services

@* Source Analysis → Contracts: source contracts and schemas of the selected snapshot (stored analysis). A source contract is a design artifact:
   it does not prove the deployed API or message flow is compatible with it. Producer/consumer come from project ownership only. *@
<section class="sd-workspace" aria-labelledby="sd-contracts-heading" data-testid="contracts-workspace">
    <SourceDomainHeader Title="Contracts" Slug="contracts" Result="K" Note="@SourceEvidenceDomainsPresentation.ContractsNote" HeadingId="sd-contracts-heading" />
    @if (!SourceEvidenceDomainsPresentation.Assessed(K))
    {
        <div class="sd-empty" data-testid="sd-contracts-not-assessed">
            <p><strong>@(K.Status == SourceDomainStatus.NotDetected ? "No source contract detected." : SourceDomainText.Label(K.Status))</strong></p>
            <p class="sd-muted">That does not mean the API has no contract: it may be generated at runtime (served OpenAPI, GraphQL introspection).</p>
        </div>
        <SourceDomainLimitations Slug="contracts" Result="K" Capabilities="Capabilities" />
    }
    else
    {
        var rows = SourceEvidenceDomainsPresentation.FilterContracts(K.Contracts, _type, _search).ToList();
        var filtering = _type.Length > 0 || _search.Length > 0;
        <section class="sd-panel" aria-labelledby="sd-contracts-list-heading" data-testid="sd-contracts-list">
            <h3 id="sd-contracts-list-heading">Contracts <span class="sd-count">@K.Contracts.Count</span></h3>
            <div class="sd-filterbar">
                <label>Type <select data-testid="sd-contracts-filter-type" value="@_type" @onchange="e => _type = (string)e.Value!"><option value="">All</option>@foreach (var t in K.Contracts.Select(c => c.Type).Distinct().Order()) { <option value="@t">@SourceDomainText.Label(t)</option> }</select></label>
                <label>Search <input type="search" data-testid="sd-contracts-search" value="@_search" @oninput="e => _search = (string?)e.Value ?? string.Empty" /></label>
            </div>
            <p class="sd-muted" role="status" data-testid="sd-contracts-shown">@rows.Count of @K.Contracts.Count shown@(filtering ? " · matching groups are expanded" : "")</p>
            <p class="sa-help-text" id="sd-contracts-parser-help" data-testid="sd-contracts-parser-help">@SourceEvidenceDomainsPresentation.ParserCoverageHelp</p>
            @foreach (var group in SourceEvidenceDomainsPresentation.ContractGroups)
            {
                var all = K.Contracts.Where(c => group.Types.Contains(c.Type)).ToList();
                if (all.Count == 0) continue;
                var shown = rows.Where(c => group.Types.Contains(c.Type)).ToList();
                if (filtering && shown.Count == 0) continue;
                var expanded = filtering || _expanded.Contains(group.Key);
                var bodyId = $"sd-contracts-group-{group.Key}";
                var showOperations = group.Operations || all.Any(c => c.Operations.Count > 0);
                var showTypes = group.TypeCounts || all.Any(c => c.Types.Count > 0);
                var showType = all.Select(c => c.Type).Distinct().Count() > 1;
                var columns = 6 + (showType ? 1 : 0) + (showOperations ? 1 : 0) + (showTypes ? 1 : 0);
                <section class="sa-type-group" aria-labelledby="@($"{bodyId}-heading")" data-testid="sd-contracts-group" data-group="@group.Key" data-count="@all.Count">
                    <h4 id="@($"{bodyId}-heading")" class="visually-hidden">@group.Label</h4>
                    <button type="button" class="sa-type-group-toggle" aria-expanded="@(expanded ? "true" : "false")" aria-controls="@bodyId" data-testid="sd-contracts-group-toggle" @onclick="() => ToggleGroup(group.Key)">
                        <span aria-hidden="true">@(expanded ? "▾" : "▸")</span> @group.Label <span class="sd-count" data-testid="sd-contracts-group-count">@(filtering ? $"{shown.Count} of {all.Count}" : all.Count.ToString())</span>
                    </button>
                    <div class="sa-type-group-body" id="@bodyId" hidden="@(!expanded)">
                        @if (expanded)
                        {
                            <div class="sd-scroll sa-stack" tabindex="0" role="region" aria-label="@($"{group.Label} contracts")">
                                <table role="table" data-testid="sd-contracts-table">
                                    <thead role="rowgroup"><tr role="row"><th role="columnheader" scope="col">Contract</th>@if (showType) { <th role="columnheader" scope="col">Type</th> }<th role="columnheader" scope="col">Role</th><th role="columnheader" scope="col">Component</th><th role="columnheader" scope="col">Evidence</th>@if (showOperations) { <th role="columnheader" scope="col">Operations</th> }@if (showTypes) { <th role="columnheader" scope="col">Types</th> }<th role="columnheader" scope="col" aria-describedby="sd-contracts-parser-help" title="@SourceEvidenceDomainsPresentation.ParserCoverageHelp">Parser coverage</th><th role="columnheader" scope="col"><span class="visually-hidden">Details</span></th></tr></thead>
                                    <tbody role="rowgroup">
                                        @foreach (var c in shown)
                                        {
                                            var open = _open.Contains(c.Id);
                                            <tr role="row" data-testid="sd-contract" data-type="@c.Type">
                                                <th role="rowheader" scope="row">@c.Name@(c.Version is { } v ? $" {v}" : "")<span class="sd-context sd-path">@SourceEvidenceDomainsPresentation.Location(c.File, c.Line)</span></th>
                                                @if (showType) { <td role="cell" data-label="Type">@SourceDomainText.Label(c.Type)</td> }
                                                <td role="cell" data-label="Role" data-testid="sd-contract-role">@SourceEvidenceDomainsPresentation.OwnerRole(c)</td>
                                                <td role="cell" data-label="Component" data-testid="sd-contract-component">@SourceEvidenceDomainsPresentation.OwnerComponent(c)</td>
                                                <td role="cell" data-label="Evidence"><SourceStatusBadge Dimension="SourceStatusDimension.Confidence" Label="@SourceDomainText.Label(c.EvidenceState)" TestId="sd-contract-evidence" /></td>
                                                @if (showOperations) { <td role="cell" data-label="Operations">@c.Operations.Count</td> }
                                                @if (showTypes) { <td role="cell" data-label="Types">@c.Types.Count</td> }
                                                <td role="cell" data-label="Parser coverage"><SourceStatusBadge Dimension="SourceStatusDimension.ParserSupport" Label="@c.ParseSupport.ToString()" TestId="sd-contract-parser" /></td>
                                                <td role="cell"><button type="button" class="sd-link" aria-expanded="@(open ? "true" : "false")" data-testid="sd-contract-toggle" @onclick="() => Toggle(c.Id)">@(open ? "Hide" : "Details")<span class="visually-hidden"> for @c.Name</span></button></td>
                                            </tr>
                            @if (open)
                            {
                                <tr role="row" class="sd-detail-row" data-testid="sd-contract-detail"><td role="cell" colspan="@columns">
                                    <p><strong>Owner basis:</strong> @(c.ProducerBasis ?? "—")</p>
                                    @if (c.Operations.Count > 0) { <p><strong>Operations:</strong> @string.Join(", ", c.Operations.Take(60).Select(o => o.Name))@(c.Operations.Count > 60 ? $" … +{c.Operations.Count - 60}" : "")</p> }
                                    @if (c.Types.Count > 0)
                                    {
                                        <ul class="sd-list">@foreach (var t in c.Types.Take(40)) { <li><strong>@t.Name</strong> <span class="sd-context">@t.Kind</span> @string.Join(", ", t.Fields.Take(30).Select(f => f.Required ? $"{f.Name}: {f.Type} (required)" : $"{f.Name}: {f.Type}"))</li> }</ul>
                                        @if (c.Types.Count > 40) { <p class="sd-muted">First 40 of @c.Types.Count types shown.</p> }
                                    }
                                    @if (c.XmlSchema is { } xsd)
                                    {
                                        <h4>XML Schema structure</h4>
                                        <p><strong>Target namespace:</strong> <code>@(xsd.TargetNamespace ?? "(none)")</code> · <strong>Version:</strong> @(xsd.ExplicitVersion ?? "Not explicitly declared")</p>
                                        <p class="sd-muted">@xsd.VersionEvidence Schema structure only; no XML instance or business validation was run.</p>
                                        @if (xsd.Attributes.Count > 0)
                                        {
                                            <p><strong>XML attributes</strong></p>
                                            <ul class="sd-list">@foreach (var attr in xsd.Attributes.Take(200)) { <li><code>@attr.Path</code> · <code>@attr.QualifiedName</code> · @(attr.Type ?? "Inline/anonymous") · @attr.Use @string.Join(", ", attr.Restrictions.Select(r => $"{r.Facet}: {r.Value}"))</li> }</ul>
                                        }
                                        @if (xsd.Types.Count > 0)
                                        {
                                            <p><strong>Named XSD types</strong></p>
                                            <ul class="sd-list">@foreach (var type in xsd.Types) { <li><code>@type.QualifiedName</code> · @type.Kind · base @(type.BaseType ?? "not declared") @string.Join(", ", type.Restrictions.Select(r => $"{r.Facet}: {r.Value}"))</li> }</ul>
                                        }
                                        @if (xsd.Elements.Count > 0)
                                        {
                                            <div class="sd-table-scroll" tabindex="0" role="region" aria-label="XSD elements and declared constraints">
                                                <table class="sd-table"><thead><tr><th>Element path</th><th>Qualified name</th><th>Type</th><th>Declared occurrences</th><th>Nullable</th><th>Restrictions</th></tr></thead>
                                                    <tbody>@foreach (var element in xsd.Elements.Take(300))
                                                    {
                                                        <tr><th scope="row"><code>@element.Path</code></th><td><code>@element.QualifiedName</code></td><td>@(element.Type ?? "Inline/anonymous")</td>
                                                            <td>@element.MinOccurs–@element.MaxOccurs <span class="sd-context">@element.Compositor</span></td><td>@(element.Nillable ? "Yes" : "No")</td>
                                                            <td>@string.Join(", ", element.Restrictions.Select(r => $"{r.Facet}: {r.Value}"))</td></tr>
                                                    }</tbody>
                                                </table>
                                            </div>
                                        }
                                        @if (xsd.Dependencies.Count > 0)
                                        {
                                            <p><strong>Schema dependencies:</strong></p>
                                            <ul class="sd-list">@foreach (var dependency in xsd.Dependencies) { <li>@dependency.Kind · @(dependency.Namespace ?? "namespace not declared") · @(dependency.SchemaLocation ?? "location not declared") — @(dependency.ResolvedInSnapshot ? "file present in selected snapshot" : "unresolved in selected snapshot")</li> }</ul>
                                        }
                                    }
                                    @foreach (var l in c.Limitations) { <p class="sd-muted">@l</p> }
                                    <p class="sd-muted">@c.RuntimeState</p>
                                </td></tr>
                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </section>
            }
        </section>
        <SourceDomainChanges Slug="contracts" Label="Contract" Domain="SourceEvidenceDomain.Contracts" Current="Evidence" Previous="Previous" />
        <SourceDomainLimitations Slug="contracts" Result="K" Capabilities="Capabilities" />
    }
</section>
@code {
    [Parameter, EditorRequired] public SourceEvidenceDomainsSnapshot Evidence { get; set; } = default!;
    [Parameter] public (string Label, SourceEvidenceDomainsSnapshot Evidence)? Previous { get; set; }
    private ContractEvidence K => Evidence.Contracts;
    private IEnumerable<DomainCapability> Capabilities => Evidence.Capabilities.Where(c => c.Domain == SourceEvidenceDomain.Contracts);
    private string _type = "", _search = "";
    private readonly HashSet<string> _open = [];
    private HashSet<string> _expanded = [];
    private void Toggle(string id) { if (!_open.Add(id)) _open.Remove(id); }
    private void ToggleGroup(string key) { if (!_expanded.Add(key)) _expanded.Remove(key); }

    // A snapshot with contracts of a single type opens that group; otherwise every group starts collapsed (counts first, rows on demand).
    protected override void OnParametersSet()
    {
        var present = SourceEvidenceDomainsPresentation.ContractGroups.Where(g => K.Contracts.Any(c => g.Types.Contains(c.Type))).ToList();
        if (present.Count == 1) _expanded = [present[0].Key];
    }
}
