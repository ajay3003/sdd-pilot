@using BirkNext.SourceDomains
@using BirkNext.Web.Services

@* Header every source-evidence domain page shares: title + analysis status (completeness, never quality), the domain's OWN source limitation
   (the generic source-only note is stated once at the top of Source Analysis) and the provenance of the evidence (snapshot fingerprint,
   analyzer version, extraction time). *@
<h2 id="@HeadingId" tabindex="-1">@Title <SourceStatusBadge Dimension="SourceStatusDimension.Completeness" Label="@SourceDomainText.Label(Result.Status)" HiddenPrefix="Analysis status: " TestId="@($"sd-{Slug}-status")" /></h2>
<p class="sa-scope-note" role="note" data-testid="@($"sd-{Slug}-boundary")">@Note</p>
<p class="sd-muted sd-provenance" data-testid="@($"sd-{Slug}-provenance")">Source <code title="@Result.SourceFingerprint">@SourceAnalysisOverview.ShortFingerprint(Result.SourceFingerprint)</code> · analyzer v@(Result.AnalyzerVersion) · extracted @SourceAnalysisOverview.Utc(Result.ExtractedAt)@(Result.Technologies.Count > 0 ? $" · {string.Join(", ", Result.Technologies)}" : "")</p>
@if (Result.StatusReason is { } reason) { <p class="sd-reason" data-testid="@($"sd-{Slug}-reason")">@reason</p> }
@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string Slug { get; set; } = "";
    [Parameter, EditorRequired] public SourceDomainResult Result { get; set; } = default!;
    /// <summary>What this domain specifically cannot tell from source (e.g. "execution not assessed").</summary>
    [Parameter, EditorRequired] public string Note { get; set; } = "";
    [Parameter] public string? HeadingId { get; set; }
}
