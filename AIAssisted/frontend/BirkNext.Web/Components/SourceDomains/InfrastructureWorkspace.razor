@using BirkNext.SourceDomains
@using BirkNext.SourceArchitecture
@using BirkNext.Web.Services

@* Source Analysis → Infrastructure: Infrastructure as Code declarations read from the selected snapshot's stored analysis (never re-analyzed).
   Summary first; resources, dependencies, identity, networking, messaging, datastores and telemetry are filterable drill-downs.
   Declared ≠ exists ≠ reachable ≠ permitted ≠ delivering. *@
<section class="sd-workspace" aria-labelledby="sd-infra-heading" data-testid="infrastructure-workspace">
    @if (I.Status == SourceDomainStatus.NotDetected)
    {
        @* Neutral and compact: no supported IaC in this source is not "no infrastructure". *@
        <h2 id="sd-infra-heading" tabindex="-1">Infrastructure <SourceStatusBadge Dimension="SourceStatusDimension.Completeness" Label="Not detected" HiddenPrefix="Analysis status: " TestId="sd-infra-status" /></h2>
        <div class="sd-neutral" data-testid="sd-infra-not-assessed">
            <p><strong>Not detected in this source.</strong> This source does not contain supported Infrastructure as Code files or infrastructure automation scripts. Infrastructure may exist in another source package or repository.</p>
            <p class="sd-muted">Supported: Terraform · Bicep · ARM · Kubernetes · Helm (partial) · infrastructure scripts (Python, shell, PowerShell; read statically, never run)</p>
            @if (!I.AutomationAnalyzed) { <p class="sd-muted" data-testid="sd-infra-automation-version">@InfrastructureAutomationText.NotAvailableInVersion</p> }
            else if (I.OtherScriptCount > 0) { <p class="sd-muted" data-testid="sd-infra-other-scripts-note">@I.OtherScriptCount script(s) were read; none is infrastructure automation.</p> }
            <a class="btn-secondary" href="technology-coverage" data-testid="sd-infra-coverage-link">Check infrastructure source coverage</a>
        </div>
    }
    else if (!SourceEvidenceDomainsPresentation.Assessed(I))
    {
        <SourceDomainHeader Title="Infrastructure" Slug="infra" Result="Evidence.Infrastructure" Note="@SourceEvidenceDomainsPresentation.InfrastructureNote" HeadingId="sd-infra-heading" />
        <div class="sd-neutral" data-testid="sd-infra-not-assessed"><p><strong>@SourceDomainText.Label(I.Status)</strong> @I.StatusReason</p></div>
        <SourceDomainLimitations Slug="infra" Result="I" Capabilities="Capabilities" />
    }
    else
    {
        <SourceDomainHeader Title="Infrastructure" Slug="infra" Result="Evidence.Infrastructure" Note="@SourceEvidenceDomainsPresentation.InfrastructureNote" HeadingId="sd-infra-heading" />
        <SourceViewNav Label="Infrastructure views" Views="Tabs" @bind-Current="_tab" Prefix="sd-infra-tab" Slug="Slug" />
        @switch (_tab)
        {
            case "Overview":
                var resources = I.Resources.Where(r => r.Kind == "resource").ToList();
                <p class="sd-lead" data-testid="sd-infra-lead">Infrastructure detected</p>
                <dl class="sd-summary" data-testid="sd-infra-overview">
                    <div><dt>Resources</dt><dd>@resources.Count</dd></div>
                    <div><dt>Resource types</dt><dd>@resources.Select(r => r.ResourceType).Distinct().Count()</dd></div>
                    <div><dt>Bindings</dt><dd>@I.Dependencies.Count</dd></div>
                    <div><dt>Environment references</dt><dd>@I.Environments.Count</dd></div>
                    <div><dt>Needs review</dt><dd data-testid="sd-infra-unresolved">@I.UnresolvedReferences.Count</dd></div>
                </dl>
                <section class="sd-panel" aria-labelledby="sd-infra-automation-heading" data-testid="sd-infra-automation-summary">
                    <h3 id="sd-infra-automation-heading">Infrastructure automation</h3>
                    @if (!I.AutomationAnalyzed)
                    {
                        <p class="sd-muted" data-testid="sd-infra-automation-version">@InfrastructureAutomationText.NotAvailableInVersion Analyze the archive again to read its scripts.</p>
                    }
                    else
                    {
                        <dl class="sd-summary" data-testid="sd-infra-automation-overview">
                            <div><dt>Infrastructure scripts</dt><dd>@I.Scripts.Count</dd></div>
                            <div><dt>Source validation checks</dt><dd>@I.Checks.Count</dd></div>
                            <div><dt>Generated artifact definitions</dt><dd>@I.GeneratedArtifacts.Count</dd></div>
                            <div><dt>Remote-state dependencies</dt><dd>@I.RemoteStates.Count</dd></div>
                        </dl>
                        <p class="sd-muted">Scripts are read statically and never run: a check here is implemented in source, not executed or passed.</p>
                    }
                </section>
                <div class="sa-actions"><button type="button" class="btn-primary" data-testid="sd-infra-review" @onclick='() => _tab = "Resources"'>Review infrastructure</button>
                    @if (I.Scripts.Count > 0) { <button type="button" class="btn-secondary" data-testid="sd-infra-review-automation" @onclick='() => _tab = "Automation & checks"'>Review automation &amp; checks</button> }</div>
                <section class="sd-panel" aria-labelledby="sd-infra-categories-heading" data-testid="sd-infra-categories">
                    <h3 id="sd-infra-categories-heading">Declared resources by kind</h3>
                    <p class="sd-muted">A declaration does not prove the resource exists.</p>
                    <dl class="sd-mini">
                        @foreach (var g in resources.GroupBy(r => KindGroup(r.Category)).OrderBy(g => Array.IndexOf(KindOrder, g.Key)))
                        {
                            <div data-testid="sd-infra-category" data-category="@g.Key"><dt>@g.Key <span class="sd-context">@string.Join(", ", g.Select(r => r.CategoryDetail).Where(x => x.Length > 0).Distinct().Take(3))</span></dt><dd>@g.Count()</dd></div>
                        }
                    </dl>
                </section>
                <SourceDomainLimitations Slug="infra" Result="I" Capabilities="Capabilities" />
                break;
            case "Resources":
                @Resources(I.Resources, "all", "All declared resources and data sources")
                break;
            case "Dependencies":
                <section class="sd-panel" aria-labelledby="sd-infra-deps-heading" data-testid="sd-infra-dependencies">
                    <h3 id="sd-infra-deps-heading">Static dependencies <span class="sd-count">@I.Dependencies.Count</span></h3>
                    <p class="sd-muted">From explicit depends_on, attribute references and module wiring. A static dependency is not runtime connectivity.</p>
                    <div class="sd-scroll" tabindex="0" role="region" aria-label="Infrastructure dependencies">
                        <table data-testid="sd-infra-dependency-table">
                            <thead><tr><th scope="col">From</th><th scope="col">To</th><th scope="col">Kind</th><th scope="col">Evidence</th><th scope="col">Location</th></tr></thead>
                            <tbody>
                                @foreach (var d in I.Dependencies.Take(_dependencyLimit))
                                {
                                    <tr data-testid="sd-infra-dependency"><th scope="row">@SourceEvidenceDomainsPresentation.ResourceLabel(I, d.FromId)</th><td>@SourceEvidenceDomainsPresentation.ResourceLabel(I, d.ToId)</td><td>@d.Kind</td>
                                        <td><span class="sd-pill sd-pill-@SourceEvidenceDomainsPresentation.Tone(d.State)">@SourceDomainText.Label(d.State)</span></td><td class="sd-path">@SourceEvidenceDomainsPresentation.Location(d.File, d.Line)</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (I.Dependencies.Count > _dependencyLimit) { <button type="button" class="btn-secondary" data-testid="sd-infra-more-deps" @onclick="() => _dependencyLimit += 200">Show more (@(I.Dependencies.Count - _dependencyLimit) remaining)</button> }
                    @if (I.RemoteStates.Count > 0)
                    {
                        <h4 id="sd-infra-layers-heading">Layer dependencies (remote state) <span class="sd-count">@I.RemoteStates.Count</span></h4>
                        <p class="sd-muted">From data "terraform_remote_state". The source layer is matched by name only; the state backend is never contacted.</p>
                        <div class="sd-scroll" tabindex="0" role="region" aria-labelledby="sd-infra-layers-heading">
                            <table data-testid="sd-infra-remote-state-table">
                                <thead><tr><th scope="col">Used by</th><th scope="col">Reads</th><th scope="col">Source layer</th><th scope="col">Outputs read</th><th scope="col">Location</th></tr></thead>
                                <tbody>
                                    @foreach (var r in I.RemoteStates)
                                    {
                                        <tr data-testid="sd-infra-remote-state" data-resolution="@r.Resolution"><th scope="row" class="sd-path">@r.UsedBy</th><td>@r.Name</td>
                                            <td>@(r.SourceLayer ?? "Not resolved") <span class="sd-pill sd-pill-@(r.Resolution == "Strong source match" ? "muted" : "partial")" title="@r.ResolutionBasis">@r.Resolution</span></td>
                                            <td>@(r.ReferencedOutputs.Count == 0 ? "—" : string.Join(", ", r.ReferencedOutputs))@if (r.OutputsNotDeclared.Count > 0) { <span class="sd-context" data-testid="sd-infra-remote-missing">Not declared in the source layer: @string.Join(", ", r.OutputsNotDeclared)</span> }</td>
                                            <td class="sd-path">@SourceEvidenceDomainsPresentation.Location(r.File, r.Line)</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    @if (I.UnresolvedReferences.Count > 0)
                    {
                        <ReviewDisclosure Text="@($"View unresolved references ({I.UnresolvedReferences.Count})")" CollapseText="Hide unresolved references" TestId="sd-infra-unresolved-detail" Class="disclosure-inline">
                            <ul class="sd-list">@foreach (var u in I.UnresolvedReferences) { <li>@u</li> }</ul>
                        </ReviewDisclosure>
                    }
                </section>
                break;
            case "Identity & RBAC":
                <section class="sd-panel" aria-labelledby="sd-infra-access-heading" data-testid="sd-infra-access">
                    <h3 id="sd-infra-access-heading">Access assignments <span class="sd-count">@I.AccessAssignments.Count</span></h3>
                    <p class="sd-muted">Role assignments and policy bindings as declared. A declared assignment is not an effective permission.</p>
                    @if (I.AccessAssignments.Count == 0) { <p class="sd-empty">No role assignment or access binding declared in the selected source.</p> }
                    else
                    {
                        <div class="sd-scroll" tabindex="0" role="region" aria-label="Access assignments">
                            <table data-testid="sd-infra-access-table">
                                <thead><tr><th scope="col">Declaration</th><th scope="col">Role</th><th scope="col">Scope</th><th scope="col">Principal</th><th scope="col">Runtime</th></tr></thead>
                                <tbody>@foreach (var a in I.AccessAssignments) { <tr data-testid="sd-infra-access-row"><th scope="row">@SourceEvidenceDomainsPresentation.ResourceLabel(I, a.ResourceId)</th><td>@(a.Role ?? "Not resolved")</td><td>@(a.ScopeReference is { } s ? SourceEvidenceDomainsPresentation.ResourceLabel(I, s) : "Not resolved")</td><td>@(a.PrincipalReference is { } p ? SourceEvidenceDomainsPresentation.ResourceLabel(I, p) : "Not resolved")</td><td class="sd-muted">@a.RuntimeState</td></tr> }</tbody>
                            </table>
                        </div>
                    }
                </section>
                @Resources(I.Resources.Where(r => SourceEvidenceDomainsPresentation.IdentityCategories.Contains(r.Category)), "identity", "Identities, access control and secret stores")
                break;
            case "Networking":
                @Resources(I.Resources.Where(r => SourceEvidenceDomainsPresentation.NetworkCategories.Contains(r.Category)), "network", "Networking declarations (reachability not verified)")
                break;
            case "Messaging":
                @Resources(I.Resources.Where(r => r.Category == InfrastructureCategory.Messaging), "messaging", "Messaging declarations (a declared entity is not a consumer processing it)")
                break;
            case "Datastores":
                @Resources(I.Resources.Where(r => SourceEvidenceDomainsPresentation.DatastoreCategories.Contains(r.Category)), "datastores", "Datastore declarations (declared is not connected)")
                break;
            case "Observability":
                @Resources(I.Resources.Where(r => r.Category == InfrastructureCategory.Observability), "observability", "Telemetry sinks, diagnostic settings and alerts (declared is not telemetry delivered)")
                break;
            case "Variables":
                <section class="sd-panel" aria-labelledby="sd-infra-vars-heading" data-testid="sd-infra-variables">
                    <h3 id="sd-infra-vars-heading">Variables and environments <span class="sd-count">@I.Variables.Count</span></h3>
                    <p class="sd-muted">Only safe literal values are shown; sensitive variables and secret-shaped values are redacted. Environments come from tfvars/parameter file and folder names.</p>
                    <div class="sd-scroll" tabindex="0" role="region" aria-label="Infrastructure variables">
                        <table data-testid="sd-infra-variable-table">
                            <thead><tr><th scope="col">Variable</th><th scope="col">Type</th><th scope="col">Default</th><th scope="col">Per environment</th><th scope="col">Declared in</th></tr></thead>
                            <tbody>
                                @foreach (var v in I.Variables)
                                {
                                    <tr data-testid="sd-infra-variable"><th scope="row">@v.Name @if (v.Sensitive) { <span class="sd-pill sd-pill-muted">sensitive</span> }</th><td>@(v.Type ?? "—")</td>
                                        <td>@(v.DefaultState switch { "literal" => v.SafeDefault, "redacted" => "Redacted", "expression" => "(expression)", _ => "None" })</td>
                                        <td>@(v.Values.Count == 0 ? "—" : string.Join("; ", v.Values.Select(x => $"{SourceDomainText.Label(x.Environment)}: {(x.State == "literal" ? x.SafeValue : x.State == "redacted" ? "redacted" : "(expression)")}")))</td>
                                        <td class="sd-path">@SourceEvidenceDomainsPresentation.Location(v.File, v.Line)</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (I.Outputs.Count > 0) { <p class="sd-muted">Outputs: @string.Join(", ", I.Outputs.Select(o => o.Sensitive ? $"{o.Name} (sensitive)" : o.Name))</p> }
                </section>
                break;
            case "Evidence":
                <div class="sd-panels">
                    <section class="sd-panel" aria-labelledby="sd-infra-modules-heading" data-testid="sd-infra-modules">
                        <h3 id="sd-infra-modules-heading">Modules <span class="sd-count">@I.Modules.Count</span></h3>
                        @if (I.Modules.Count == 0) { <p class="sd-muted">No modules declared.</p> }
                        <ul class="sd-list">@foreach (var m in I.Modules) { <li data-testid="sd-infra-module" data-analyzed="@(m.Analyzed ? "true" : "false")"><strong>@m.Name</strong> — @m.Source@(m.Version is { } v ? $" ({v})" : "") · @(m.Analyzed ? "analyzed" : "not analyzed")@(m.Note is { } n ? $" · {n}" : "")</li> }</ul>
                    </section>
                    <section class="sd-panel" aria-labelledby="sd-infra-providers-heading" data-testid="sd-infra-providers">
                        <h3 id="sd-infra-providers-heading">Providers and state backends</h3>
                        <ul class="sd-list">
                            @foreach (var p in I.Providers) { <li><strong>@p.Name</strong>@(p.Source is { } s ? $" · {s}" : "")@(p.Version is { } v ? $" · {v}" : "")@(p.HasCredentialSettings ? " · credential settings declared (values not read)" : "")</li> }
                            @foreach (var b in I.Backends) { <li>Backend <strong>@b.Type</strong> · settings: @string.Join(", ", b.SettingNames) (values not read)</li> }
                            @foreach (var v in I.RequiredVersions.GroupBy(r => r.Constraint)) { <li data-testid="sd-infra-required-version">Terraform <strong>@v.Key</strong> · required in @v.Count() director@(v.Count() == 1 ? "y" : "ies")</li> }
                            @foreach (var l in I.LockedProviders.GroupBy(l => (l.Address, l.Version))) { <li data-testid="sd-infra-locked-provider">Locked <strong>@l.Key.Address</strong> @l.Key.Version · @l.Count() lock file(s)@(l.First().Constraints is { } c ? $" · constraints {c}" : "")</li> }
                        </ul>
                    </section>
                    @if (I.ProviderRuns.Count > 0)
                    {
                        <section class="sd-panel" aria-labelledby="sd-infra-runs-heading" data-testid="sd-infra-provider-runs">
                            <h3 id="sd-infra-runs-heading">Evidence providers</h3>
                            <ul class="sd-list">@foreach (var r in I.ProviderRuns) { <li data-testid="sd-infra-provider-run" data-provider="@r.Key"><strong>@r.Name</strong> v@(r.Version) · @SourceDomainText.Label(r.Status) · @r.Detail</li> }</ul>
                        </section>
                    }
                    @if (I.ExcludedFiles.Count > 0)
                    {
                        <section class="sd-panel" aria-labelledby="sd-infra-excluded-heading" data-testid="sd-infra-excluded">
                            <h3 id="sd-infra-excluded-heading">Intentionally not read <span class="sd-count">@I.ExcludedFiles.Count</span></h3>
                            <ul class="sd-list">@foreach (var x in I.ExcludedFiles) { <li><span class="sd-path">@x.Path</span> — @x.Reason</li> }</ul>
                        </section>
                    }
                </div>
                <SourceDomainLimitations Slug="infra" Result="I" Capabilities="Capabilities" />
                break;
            case "Automation & checks":
                @Automation()
                break;
            case "Changes":
                <SourceDomainChanges Slug="infra" Label="Infrastructure" Domain="SourceEvidenceDomain.Infrastructure" Current="Evidence" Previous="Previous" />
                break;
        }
    }
</section>
@code {
    private static readonly string[] KindOrder = ["Compute", "Messaging", "Storage", "Identity", "Networking", "Monitoring", "Other"];
    /// <summary>Presentation grouping of the provider-neutral categories into the seven kinds a reviewer scans first.</summary>
    private static string KindGroup(InfrastructureCategory category) => category switch
    {
        InfrastructureCategory.Compute or InfrastructureCategory.ApiGateway or InfrastructureCategory.ContainerRegistry => "Compute",
        InfrastructureCategory.Messaging => "Messaging",
        InfrastructureCategory.Database or InfrastructureCategory.Storage or InfrastructureCategory.Cache => "Storage",
        InfrastructureCategory.Identity or InfrastructureCategory.AccessControl or InfrastructureCategory.SecretStore => "Identity",
        InfrastructureCategory.Networking or InfrastructureCategory.Dns => "Networking",
        InfrastructureCategory.Observability => "Monitoring",
        _ => "Other",
    };
    [Parameter, EditorRequired] public SourceEvidenceDomainsSnapshot Evidence { get; set; } = default!;
    [Parameter] public (string Label, SourceEvidenceDomainsSnapshot Evidence)? Previous { get; set; }

    private InfrastructureEvidence I => Evidence.Infrastructure;
    private IEnumerable<DomainCapability> Capabilities => Evidence.Capabilities.Where(c => c.Domain == SourceEvidenceDomain.Infrastructure);
    private static readonly string[] Tabs = ["Overview", "Resources", "Dependencies", "Identity & RBAC", "Networking", "Messaging", "Datastores", "Observability", "Variables", "Automation & checks", "Evidence", "Changes"];
    private static string Slug(string tab) => tab switch { "Identity & RBAC" => "identity", "Automation & checks" => "automation", _ => tab.ToLowerInvariant() };
    private string? _automationOpen;

    /// <summary>Automation &amp; checks: source-side checks and other infrastructure automation, where each is configured to run, and the
    /// execution evidence Source Analysis has — never more than "not executed by analysis".</summary>
    private RenderFragment Automation() => __builder =>
    {
        var rows = InfrastructureAutomationPresentation.Rows(I).ToList();
        <section class="sd-panel" aria-labelledby="sd-infra-auto-heading" data-testid="sd-infra-automation">
            <h3 id="sd-infra-auto-heading">Automation &amp; checks <span class="sd-count">@rows.Count</span></h3>
            <p class="sd-muted">Checks and automation implemented in this source. Scripts are read statically and never run: execution and results are not assessed here.</p>
            @if (!I.AutomationAnalyzed)
            {
                <p class="sd-empty" data-testid="sd-infra-automation-version">@InfrastructureAutomationText.NotAvailableInVersion</p>
            }
            else if (rows.Count == 0)
            {
                <p class="sd-empty" data-testid="sd-infra-automation-empty">No infrastructure automation scripts in this source.</p>
            }
            else
            {
                <div class="sd-scroll" tabindex="0" role="region" aria-label="Automation and checks">
                    <table data-testid="sd-infra-automation-table">
                        <thead><tr><th scope="col">Check / automation</th><th scope="col">Type</th><th scope="col">Script</th><th scope="col">Scope</th><th scope="col">Pipeline usage</th><th scope="col">Execution evidence</th></tr></thead>
                        <tbody>
                            @foreach (var row in rows)
                            {
                                var open = _automationOpen == row.Key;
                                var detailId = $"sd-infra-auto-detail-{rows.IndexOf(row)}";
                                <tr data-testid="sd-infra-automation-row" data-kind="@(row.Check is null ? "automation" : "check")">
                                    <th scope="row">@row.Name
                                        <button type="button" class="sd-link" aria-expanded="@(open ? "true" : "false")" aria-controls="@detailId" data-testid="sd-infra-automation-toggle" @onclick="() => _automationOpen = open ? null : row.Key">@(open ? "Hide" : "View") details<span class="visually-hidden"> of @row.Name</span></button></th>
                                    <td>@row.Type@if (row.Check is { } c) { <span class="sd-context">@InfrastructureAutomationText.Label(c.Enforcement)</span> }</td>
                                    <td class="sd-path">@if (row.Scripts.Count == 1) { @row.Scripts[0].Path } else { <span>@row.Scripts.Count source implementations</span> }</td>
                                    <td>@row.Scope@if (row.Check?.MatchingDeclarations is int n) { <span class="sd-context">@n matching declaration@(n == 1 ? "" : "s") in this source</span> }</td>
                                    <td data-testid="sd-infra-automation-usage">@row.PipelineUsage</td>
                                    <td data-testid="sd-infra-automation-execution"><span class="sd-pill sd-pill-muted">@row.ExecutionEvidence</span></td>
                                </tr>
                                @if (open)
                                {
                                    <tr class="sd-detail-row" id="@detailId" data-testid="sd-infra-automation-detail"><td colspan="6">@AutomationDetail(row)</td></tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
        @if (I.GeneratedArtifacts.Count > 0)
        {
            <section class="sd-panel" aria-labelledby="sd-infra-artifacts-heading" data-testid="sd-infra-artifacts">
                <h3 id="sd-infra-artifacts-heading">Generated artifact definitions <span class="sd-count">@I.GeneratedArtifacts.Count</span></h3>
                <p class="sd-muted">What scripts would write if run. A definition is not a generated file; a copy is listed only when this source package contains one.</p>
                <div class="sd-scroll" tabindex="0" role="region" aria-label="Generated artifact definitions">
                    <table data-testid="sd-infra-artifact-table">
                        <thead><tr><th scope="col">Artifact</th><th scope="col">Kind</th><th scope="col">Generated by</th><th scope="col">In this source</th></tr></thead>
                        <tbody>@foreach (var a in I.GeneratedArtifacts) { <tr data-testid="sd-infra-artifact"><th scope="row">@a.Name <span class="sd-context sd-path">@a.PathTemplate</span></th><td>@a.Kind</td><td class="sd-path">@a.GeneratedBy</td><td>@a.PresenceNote</td></tr> }</tbody>
                    </table>
                </div>
            </section>
        }
        @if (I.OtherScriptCount > 0)
        {
            <ReviewDisclosure Text="@($"View other scripts ({I.OtherScriptCount})")" CollapseText="Hide other scripts" TestId="sd-infra-other-scripts" Class="disclosure-inline">
                <p class="sd-muted">Read, but not infrastructure automation (a script's language or folder is never enough).</p>
                <ul class="sd-list">@foreach (var o in I.OtherScripts) { <li><span class="sd-path">@o.Path</span> — @o.Reason</li> }</ul>
            </ReviewDisclosure>
        }
    };

    private RenderFragment AutomationDetail(InfrastructureAutomationPresentation.Row row) => __builder =>
    {
        if (row.Check is { } check)
        {
            <dl class="sd-facts" data-testid="sd-infra-check-facts">
                <div><dt>Implementation</dt><dd>@check.ImplementationState</dd></div>
                <div><dt>Behaviour on violation</dt><dd>@InfrastructureAutomationText.Label(check.Enforcement)</dd></div>
                <div><dt>Execution</dt><dd>@check.ExecutionState</dd></div>
                <div><dt>Rules (@check.RulesState)</dt><dd>@if (check.Rules.Count == 0) { <span>@(check.RulesState == "Not applicable" ? "Report: lists findings without failing" : "Complex dynamic logic could not be statically resolved")</span> } else { <ul class="sd-list" data-testid="sd-infra-check-rules">@foreach (var r in check.Rules) { <li>@r</li> }</ul> }</dd></div>
            </dl>
        }
        foreach (var script in row.Scripts)
        {
            <section class="sd-script" data-testid="sd-infra-script" aria-label="@($"Script {script.Path}")">
                <h4 class="sd-path">@script.Path <span class="sd-pill sd-pill-@InfrastructureAutomationPresentation.Tone(script.AnalysisState)">@InfrastructureAutomationText.Label(script.AnalysisState)</span></h4>
                @if (script.AnalysisNote is { } note) { <p class="sd-muted">@note</p> }
                <dl class="sd-facts">
                    <div><dt>Language</dt><dd>@script.Language@(script.EmbeddedPrograms.Count > 0 ? $" · embedded {string.Join(", ", script.EmbeddedPrograms)}" : "")</dd></div>
                    <div><dt>Why infrastructure</dt><dd>@InfrastructureAutomationPresentation.Relevance(script.Relevance): @string.Join("; ", script.RelevanceBasis)</dd></div>
                    <div><dt>Purpose</dt><dd>@string.Join(", ", script.Purposes.Select(InfrastructureAutomationText.Label)) — @string.Join("; ", script.PurposeBasis)</dd></div>
                    @if (script.EnforcementBasis is { } eb) { <div><dt>Exit behaviour</dt><dd>@InfrastructureAutomationText.Label(script.Enforcement) — @eb</dd></div> }
                    @if (script.TerraformConcepts.Count > 0) { <div><dt>Terraform concepts</dt><dd>@string.Join(", ", script.TerraformConcepts)</dd></div> }
                    @if (script.Inputs.Count > 0) { <div><dt>Reads</dt><dd class="sd-path">@string.Join(", ", script.Inputs.Select(i => i.Value))</dd></div> }
                    @if (script.Outputs.Count > 0) { <div><dt>Writes</dt><dd class="sd-path">@string.Join(", ", script.Outputs.Select(o => o.Path))</dd></div> }
                    @if (script.Commands.Any(c => c.ExternalTool)) { <div><dt>Commands it would run</dt><dd>@string.Join(", ", script.Commands.Where(c => c.ExternalTool).Select(c => c.Subcommand is null ? c.Command : $"{c.Command} {c.Subcommand}").Distinct()) <span class="sd-context">static references only</span></dd></div> }
                    @if (script.EnvironmentVariables.Count > 0) { <div><dt>Environment variables</dt><dd>@foreach (var v in script.EnvironmentVariables) { <span class="sd-chip">@v.Name@if (v.Sensitive) { <span class="sd-pill sd-pill-muted">sensitive · value never read</span> }</span> }</dd></div> }
                    @if (script.CliArguments.Count > 0) { <div><dt>Arguments</dt><dd>@string.Join(", ", script.CliArguments)</dd></div> }
                    @if (script.Capabilities.Count > 0) { <div><dt>Could do if run</dt><dd>@string.Join("; ", script.Capabilities.Select(c => $"{c.Capability} ({c.Detail})"))</dd></div> }
                    @if (script.LocalIncludes.Count > 0) { <div><dt>Includes</dt><dd class="sd-path">@string.Join(", ", script.LocalIncludes)</dd></div> }
                </dl>
                @{ var relations = I.ScriptRelationships.Where(r => r.ScriptId == script.Id).ToList(); }
                @if (relations.Count > 0)
                {
                    <ul class="sd-list" data-testid="sd-infra-script-relations">@foreach (var r in relations) { <li>@r.Relation → <span class="sd-path">@r.Target</span>@(r.Matches is int m ? $" ({m} in this source)" : "")</li> }</ul>
                }
                @foreach (var i in InfrastructureEvidenceQueries.Invocations(I, script.Id))
                {
                    <p class="sd-muted" data-testid="sd-infra-script-invocation">@i.Source <strong>@(i.Pipeline ?? i.Reference)</strong>@(i.Step is { } s ? $" · {s}" : "") · @InfrastructureAutomationText.Label(i.Blocking) — @i.BlockingBasis@(i.Trigger is { } tr ? $" · {tr}" : "") · @i.ExecutionState</p>
                }
            </section>
        }
    };
    private string _tab = "Overview";
    private int _dependencyLimit = 200;
    private readonly Dictionary<string, (string Category, string Search)> _filters = [];
    private readonly HashSet<string> _open = [];

    private RenderFragment Resources(IEnumerable<InfrastructureResource> source, string key, string title) => __builder =>
    {
        var all = source.ToList();
        (string Category, string Search) f = _filters.TryGetValue(key, out var x) ? x : ("", "");
        var rows = SourceEvidenceDomainsPresentation.FilterResources(all, f.Category, f.Search).ToList();
        var headingId = $"sd-infra-{key}-heading";
        <section class="sd-panel" aria-labelledby="@headingId" data-testid="@($"sd-infra-resources-{key}")">
            <h3 id="@headingId">@title <span class="sd-count">@all.Count</span></h3>
            @if (all.Count == 0) { <p class="sd-empty" data-testid="sd-infra-resources-empty">No declarations of this kind in the selected source.</p> }
            else
            {
                <div class="sd-filterbar">
                    @if (key == "all")
                    {
                        <label>Category <select data-testid="sd-infra-filter-category" value="@f.Category" @onchange="e => _filters[key] = ((string)e.Value!, f.Search)"><option value="">All</option>@foreach (var c in all.Select(r => r.Category).Distinct().Order()) { <option value="@c">@SourceDomainText.Label(c)</option> }</select></label>
                    }
                    <label>Search <input type="search" data-testid="@($"sd-infra-search-{key}")" value="@f.Search" @oninput="e => _filters[key] = (f.Category, (string?)e.Value ?? string.Empty)" /></label>
                </div>
                <p class="sd-muted" role="status" data-testid="@($"sd-infra-shown-{key}")">@rows.Count of @all.Count shown</p>
                <div class="sd-scroll" tabindex="0" role="region" aria-label="@title">
                    <table data-testid="sd-infra-resource-table">
                        <thead><tr><th scope="col">Resource</th><th scope="col">Type</th><th scope="col">Declared name</th><th scope="col">Location</th><th scope="col">Settings</th></tr></thead>
                        <tbody>
                            @foreach (var r in rows.Take(400))
                            {
                                var open = _open.Contains(r.Id);
                                <tr data-testid="sd-infra-resource" data-category="@r.Category">
                                    <th scope="row">@r.LogicalName<span class="sd-context">@r.CategoryDetail@(r.Kind == "data" ? " · data source" : "")@(r.ModulePath is { } m ? $" · module {m}" : "")@(r.Environment is { } env ? $" · {SourceDomainText.Label(env)}" : "")</span>
                                        @if (r.Conditional) { <span class="sd-pill sd-pill-partial" data-testid="sd-infra-conditional" title="@r.InstanceExpression">Conditional declaration</span> }</th>
                                    <td class="sd-path">@r.ResourceType</td>
                                    <td>@(r.DeclaredName ?? "Not resolved")</td>
                                    <td class="sd-path">@SourceEvidenceDomainsPresentation.Location(r.File, r.Line)</td>
                                    <td>
                                        @if (r.Settings.Count == 0) { <span class="sd-muted">None recorded</span> }
                                        else { <button type="button" class="sd-link" aria-expanded="@(open ? "true" : "false")" data-testid="sd-infra-settings-toggle" @onclick="() => Toggle(r.Id)">@(open ? "Hide" : "View") @r.Settings.Count setting(s)<span class="visually-hidden"> of @r.LogicalName</span></button> }
                                    </td>
                                </tr>
                                @if (open)
                                {
                                    <tr class="sd-detail-row" data-testid="sd-infra-settings"><td colspan="5">
                                        <dl class="sd-facts">@foreach (var s in r.Settings) { <div><dt>@s.Key <span class="sd-context">@s.Area</span></dt><dd>@s.Value</dd></div> }</dl>
                                        <p class="sd-muted">@r.RuntimeState@(r.TagKeys.Count > 0 ? $" · tags: {string.Join(", ", r.TagKeys)}" : "")</p>
                                    </td></tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                @if (rows.Count > 400) { <p class="sd-muted">First 400 of @rows.Count shown — narrow with the filters.</p> }
            }
        </section>
    };

    private void Toggle(string id) { if (!_open.Add(id)) _open.Remove(id); }
}
