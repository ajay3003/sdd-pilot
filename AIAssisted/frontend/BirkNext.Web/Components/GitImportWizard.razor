@using BirkNext.GitSources
@using BirkNext.Web.Models
@using BirkNext.Web.Components.GitSources
@using BirkNext.Web.Services.ProjectImport
@inject IGitSourcesApiService Git
@inject IFrontendAnalysisContextFactory Contexts
@inject ProjectImportSession Session

@* Import Project → Git (2026-11-22). Repositories are connected once, in System Settings → Git Sources (their URLs are kept there); here the
   tester only picks one from a list, its branch (or one exact commit) and roles, and imports. "Get the latest code first" (on by default)
   fetches before importing, so each import is a new snapshot of the current code; earlier snapshots are never replaced. Opening reads only
   local state; a remote is contacted only when the tester imports with "latest" ticked. *@
<section class="giw" aria-labelledby="giw-title" data-testid="giw">
    <h3 id="giw-title" class="giw-title">Import from Git</h3>
    <p class="giw-muted">Uses the Git installed on this computer and its sign-in (Git Credential Manager or SSH keys). Read-only: BirkNext never pushes and never changes your working folders.</p>

    @if (_status is null)
    {
        <ReviewStageList Stages="@([new ReviewStage("status", "Reading the Git installation", ReviewStageState.Running)])" TestId="giw-loading" />
    }
    else if (_status.Installation is not { Found: true })
    {
        <p class="giw-muted" data-testid="giw-not-connected">@(_status.Installation?.Problem ?? _status.Message)
            <a href="@ManageHref">Git Sources in System Settings</a>.</p>
    }
    else if (_environmentId is null)
    {
        <p class="giw-muted" data-testid="giw-no-project">Choose a Target Environment (your BirkNext project) first: repositories are connected per project.</p>
    }
    else if (_links.Count == 0)
    {
        @if (_error is not null) { <p class="giw-error" role="alert" data-testid="giw-error">@_error</p> }
        <p class="giw-muted" data-testid="giw-empty">No repository is connected to @(_projectName ?? "this project") yet.
            Add its Git URL once in <a href="@ManageHref" data-testid="giw-manage">System Settings → Git Sources</a>; it is then listed here and on every page that uses repositories.</p>
    }
    else
    {
        @if (_error is not null) { <p class="giw-error" role="alert" data-testid="giw-error">@_error</p> }
        @if (_busyText is not null) { <p class="giw-muted" role="status" data-testid="giw-busy">@_busyText</p> }

        <div class="giw-pick">
            <label for="giw-repo" class="giw-label">Repository</label>
            <div class="giw-pick-row">
                <select id="giw-repo" class="form-control giw-select" value="@(_choice?.Link.Id ?? "")" disabled="@Busy" @onchange="e => ChooseAsync(e.Value?.ToString())" data-testid="giw-repo">
                    <option value="">Choose a repository…</option>
                    @foreach (var link in _links)
                    {
                        <option value="@link.Id" data-testid="giw-repo-option">@GitSourcesPresentation.PickerLabel(link)</option>
                    }
                </select>
                <a href="@ManageHref" class="giw-small" data-testid="giw-manage">Add or manage repositories</a>
            </div>
        </div>

        @if (_choice is { } choice)
        {
            var link = choice.Link;
            <div class="giw-chosen" data-testid="giw-chosen" data-repo="@link.Id">
                <p class="giw-muted giw-small" data-testid="giw-repo-facts">@GitSourcesPresentation.KindLabel(link) · @GitSourcesPresentation.FetchText(link, DateTimeOffset.UtcNow)
                    @if (link.LastImport is { } last) { <span data-testid="giw-linked"> · last imported @last.CommitSha[..8] (@last.Branch, @last.ImportedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))</span> }
                    else { <span data-testid="giw-never-imported"> · not imported yet</span> }
                </p>
                @if (GitSourcesPresentation.FetchHint(link.LastFetchFailure) is { } hint) { <p class="giw-muted giw-small" data-testid="giw-hint">@hint</p> }
                @Configure(link, choice)

                @* The same content question as Import ZIP (shared component): the import stays locked until it is answered. *@
                <ImportRolesQuestion Session="Session" Legend="What does this repository contain?" Id="giw-roles" TestId="giw-roles" RoleTestId="giw-role" DetectTestId="giw-detect"
                                     Disabled="@Busy" Changed="() => _rolesHint = false">
                    <p class="pi-muted pi-small">After the import the roles appear in Manage sources and are kept for this repository's next import. A role the content does not show is not saved.</p>
                </ImportRolesQuestion>

                <label class="giw-latest"><input type="checkbox" checked="@choice.GetLatest" disabled="@(choice.Commit is { Length: > 0 })" @onchange="e => choice.GetLatest = (bool)e.Value!" data-testid="giw-latest" />
                    Get the latest code first <span class="giw-muted giw-small">(fetches the branch now, so this import is a new snapshot of the current code)</span></label>

                <div class="giw-review" data-testid="giw-review">
                    <p class="giw-muted giw-small">The import goes through the same review as a ZIP. It becomes a new snapshot; earlier snapshots are never replaced.</p>
                    @if (RolesAnswered)
                    {
                        <button type="button" class="btn-primary" disabled="@(Busy || choice.CommitProblem is not null || (!choice.GetLatest && link.LastFetchedAt is null && choice.Commit is null))"
                                @onclick="ImportAsync" data-testid="giw-import">Import @link.Repository</button>
                    }
                    else
                    {
                        @* Looks unavailable until the content question is answered; a click says why (as Choose ZIP file does). *@
                        <button type="button" class="btn-primary is-disabled" aria-disabled="true" aria-describedby="@(_rolesHint ? "giw-roles-hint" : null)"
                                @onclick="() => _rolesHint = true" data-testid="giw-import-locked">Import @link.Repository</button>
                        @if (_rolesHint)
                        {
                            <p class="pi-warning" id="giw-roles-hint" role="alert" data-testid="giw-roles-hint">Tick what the repository contains first, or “Not sure — let BirkNext detect it”.</p>
                        }
                    }
                    @if (!choice.GetLatest && link.LastFetchedAt is null && choice.Commit is null)
                    {
                        <p class="giw-muted giw-small" data-testid="giw-needs-fetch">Nothing has been fetched from this repository yet: tick “Get the latest code first”.</p>
                    }
                </div>
            </div>
        }
    }
</section>

@code {
    /// <summary>The queue of imports to run (each through the normal Project Import review), in order.</summary>
    [Parameter, EditorRequired] public EventCallback<IReadOnlyList<(GitImportRequest Request, string Label)>> OnImport { get; set; }

    /// <summary>Repositories are added and managed in one place; the link returns here afterwards.</summary>
    private const string ManageHref = "admin/system-settings?section=git-sources";

    private sealed class Choice(GitSourceLink link)
    {
        public GitSourceLink Link { get; set; } = link;
        public string Branch { get; set; } = link.Branch;
        public string? Commit { get; set; }
        public string? CommitProblem { get; set; }
        /// <summary>Fetch before importing (default): the import is the branch's current code, not what was fetched last time.</summary>
        public bool GetLatest { get; set; } = true;
        public IReadOnlyList<GitBranch> Branches { get; set; } = [];
    }

    /// <summary>The content question is answered (one or more roles, or "Not sure"): the import unlocks.</summary>
    private bool RolesAnswered => ImportRoleChoice.Answered(Session.ChosenRoles, Session.DetectRoles);
    private bool _rolesHint;

    private GitConnectionStatus? _status;
    private IReadOnlyList<GitSourceLink> _links = [];
    private Choice? _choice;
    private string? _error, _busyText, _environmentId, _projectName;
    private bool Busy => _busyText is not null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var context = await Contexts.GetActiveContextAsync();
            (_environmentId, _projectName) = (context.ActiveProfileOrNull?.Id, context.ActiveProfileOrNull?.Project?.ProjectName ?? context.ActiveProfileOrNull?.Name);
        }
        catch (InvalidOperationException) { }
        (_status, _error) = await Git.StatusAsync();
        if (_environmentId is not null && _status?.Installation is { Found: true })
        {
            (_links, _error) = await Git.LinksAsync(_environmentId);
            _links = [.. _links.OrderBy(l => l.Repository, StringComparer.OrdinalIgnoreCase)];
            // One repository: nothing to choose.
            if (_links.Count == 1) await ChooseAsync(_links[0].Id);
        }
    }

    private async Task Act(string text, Func<Task> work)
    {
        (_busyText, _error) = (text, null);
        try { await work(); }
        finally { _busyText = null; }
    }

    private async Task ChooseAsync(string? linkId)
    {
        _error = null;
        if (_links.FirstOrDefault(l => l.Id == linkId) is not { } link) { _choice = null; return; }
        var choice = new Choice(link);
        _choice = choice;
        // The repository's roles from its last import are ticked again (an answer the tester can change); none = the question is open.
        Session.ChosenRoles.Clear();
        Session.DetectRoles = false;
        foreach (var saved in link.Roles)
            if (Enum.TryParse<PackageEvidenceRole>(saved, out var role) && ImportRoleChoice.Choices.Contains(role)) Session.ChosenRoles.Add(role);
        _rolesHint = false;
        var (branches, error) = await Git.BranchesAsync(link.Id, link.EnvironmentId);
        (choice.Branches, _error) = (branches, error);
        if (choice.Branch.Length == 0 && branches.FirstOrDefault(b => b.IsDefault) is { } fallback) choice.Branch = fallback.Name;
    }

    private void CheckCommit(Choice choice)
    {
        choice.CommitProblem = null;
        if (string.IsNullOrWhiteSpace(choice.Commit)) { choice.Commit = null; return; }
        choice.Commit = choice.Commit.Trim().ToLowerInvariant();
        if (!GitSourcePolicy.IsCommitSha(choice.Commit)) choice.CommitProblem = "A full 40-character commit SHA is required.";
    }

    private Task ImportAsync() => Act(_choice is { GetLatest: true, Commit: null } ? "Getting the latest code. If Git Credential Manager opens a sign-in window, complete it there…" : "Saving the branch and roles…", async () =>
    {
        if (_environmentId is not { } environment) { _error = "Choose a Target Environment (BirkNext project) first."; return; }
        if (_choice is not { } c) return;
        if (!RolesAnswered) { _rolesHint = true; return; }
        var roles = Session.ChosenRoles.Select(r => r.ToString()).ToList();
        if (c.GetLatest && c.Commit is null)
        {
            var (fetched, fetchError) = await Git.FetchAsync(c.Link.Id, c.Link.EnvironmentId);
            if (fetched is null) { _error = $"Getting the latest code from {c.Link.Repository} failed: {fetchError}"; return; }
            if (fetched.LastFetchFailure is { } failure) { _error = $"Getting the latest code from {c.Link.Repository} failed: {fetched.LastFetchProblem ?? GitSourcePolicy.Describe(failure)}"; c.Link = fetched; return; }
            c.Link = fetched;
        }
        // The branch and roles are the link's (shown in Source Management); a specific commit is this import only, never a pin.
        var (link, error) = await Git.UpdateLinkAsync(c.Link.Id, environment, c.Branch, null, roles);
        if (link is null) { _error = $"{c.Link.Repository}: {error}"; return; }
        c.Link = link;
        _links = [.. _links.Select(l => l.Id == link.Id ? link : l)];
        await OnImport.InvokeAsync([(new GitImportRequest(link.RepositoryId, c.Branch) { OrganizationUrl = link.OrganizationUrl, Commit = c.Commit, EnvironmentId = environment, Roles = roles },
            $"{link.Repository} @ {(c.Commit is { Length: > 0 } sha ? sha[..8] : c.Branch)}")]);
    });

    private RenderFragment Configure(GitSourceLink link, Choice choice) => __builder =>
    {
        <div class="giw-config" data-testid="giw-config">
            <label>Branch
                <select value="@choice.Branch" @onchange="e => choice.Branch = e.Value?.ToString() ?? choice.Branch" data-testid="giw-branch">
                    @if (choice.Branches.All(b => b.Name != choice.Branch)) { <option value="@choice.Branch">@choice.Branch</option> }
                    @foreach (var b in choice.Branches) { <option value="@b.Name">@b.Name@(b.IsDefault ? " (default)" : "") · @b.CommitSha[..8]@(b.CommittedAt is { } d ? $" · {d.UtcDateTime:yyyy-MM-dd}" : "")</option> }
                </select>
            </label>
            <label>Specific commit (optional)
                <input class="form-control" @bind="choice.Commit" @bind:after="() => CheckCommit(choice)" placeholder="40-character SHA" spellcheck="false" data-testid="giw-commit" />
            </label>
            @if (choice.CommitProblem is { } problem) { <span class="giw-error giw-small" data-testid="giw-commit-problem">@problem</span> }
        </div>
    };
}
