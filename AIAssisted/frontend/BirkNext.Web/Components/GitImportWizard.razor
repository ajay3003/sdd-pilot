@using BirkNext.GitSources
@using BirkNext.Web.Models
@using BirkNext.Web.Components.GitSources
@using BirkNext.Web.Services.ProjectImport
@inject IGitSourcesApiService Git
@inject IFrontendAnalysisContextFactory Contexts

@* Import Project → Git (Git-only). The repositories connected to this BirkNext project (a local repository or a Git URL, fetched by the person's
   own Git into BirkNext-owned storage) → branch, or one exact commit, and roles → import, each in turn through the same review as a ZIP.
   Opening reads only local state; Fetch latest and Add contact a remote only when the person starts them. *@
<section class="giw" aria-labelledby="giw-title" data-testid="giw">
    <h3 id="giw-title" class="giw-title">Import from Git</h3>
    <p class="giw-muted">Uses the Git installed on this computer and its sign-in (Git Credential Manager or SSH keys). Read-only: BirkNext never pushes and never changes your working folders.</p>

    @if (_status is null)
    {
        <ReviewStageList Stages="@([new ReviewStage("status", "Reading the Git installation", ReviewStageState.Running)])" TestId="giw-loading" />
    }
    else if (_status.Installation is not { Found: true })
    {
        <p class="giw-muted" data-testid="giw-not-connected">@(_status.Installation?.Problem ?? _status.Message)
            <a href="admin/system-settings?section=git-sources">Git Sources in System Settings</a>.</p>
    }
    else if (_environmentId is null)
    {
        <p class="giw-muted" data-testid="giw-no-project">Choose a Target Environment (your BirkNext project) first: repositories are connected per project.</p>
    }
    else
    {
        @if (_error is not null) { <p class="giw-error" role="alert" data-testid="giw-error">@_error</p> }
        @if (_busyText is not null) { <p class="giw-muted" role="status" data-testid="giw-busy">@_busyText</p> }

        @if (_links.Count == 0)
        {
            <p class="giw-muted" data-testid="giw-empty">No repository is connected to @(_projectName ?? "this project") yet. Add one:</p>
        }
        else
        {
            <ul class="giw-list" data-testid="giw-repos">
                @foreach (var link in _links)
                {
                    var selected = _selected.TryGetValue(link.Id, out var choice);
                    <li data-testid="giw-repo" data-repo="@link.Id">
                        <div class="giw-repo-head">
                            <label><input type="checkbox" checked="@selected" disabled="@(link.LastFetchedAt is null)" @onchange="e => ToggleAsync(link, (bool)e.Value!)" data-testid="giw-repo-check" />
                                <strong>@link.Repository</strong></label>
                            <span class="giw-muted giw-small">@GitSourcesPresentation.KindLabel(link) · @(link.Branch.Length > 0 ? link.Branch : "—") · @GitSourcesPresentation.FetchText(link, DateTimeOffset.UtcNow)</span>
                            @if (link.LastImport is { } last) { <span class="giw-badge" data-testid="giw-linked">last imported @last.CommitSha[..8]</span> }
                            <button type="button" class="btn-secondary btn-sm giw-fetch" disabled="@Busy" @onclick="() => FetchAsync(link)" data-testid="giw-fetch">Fetch latest</button>
                        </div>
                        @if (GitSourcesPresentation.FetchHint(link.LastFetchFailure) is { } hint) { <p class="giw-muted giw-small" data-testid="giw-hint">@hint</p> }
                        @if (selected) { @Configure(link, choice!) }
                    </li>
                }
            </ul>

            @if (_selected.Count > 0)
            {
                <div class="giw-review" data-testid="giw-review">
                    <p class="giw-muted giw-small">Each repository is imported in turn through the same review as a ZIP. Earlier snapshots are never replaced.</p>
                    <button type="button" class="btn-primary" disabled="@(Busy || _selected.Values.Any(c => c.CommitProblem is not null))" @onclick="ImportAsync" data-testid="giw-import">
                        Import @_selected.Count repositor@(_selected.Count == 1 ? "y" : "ies")</button>
                </div>
            }
        }

        <details class="giw-add" open="@(_links.Count == 0)" data-testid="giw-add">
            <summary>Add a repository</summary>
            <GitAddRepositoryForm EnvironmentId="@_environmentId" ProjectName="@_projectName" OnAdded="OnAdded" />
        </details>
    }
</section>

@code {
    /// <summary>The queue of imports to run (each through the normal Project Import review), in order.</summary>
    [Parameter, EditorRequired] public EventCallback<IReadOnlyList<(GitImportRequest Request, string Label)>> OnImport { get; set; }

    private sealed class Choice(GitSourceLink link)
    {
        public GitSourceLink Link { get; set; } = link;
        public string Branch { get; set; } = link.Branch;
        public string? Commit { get; set; }
        public string? CommitProblem { get; set; }
        public IReadOnlyList<GitBranch> Branches { get; set; } = [];
        public HashSet<string> Roles { get; } = new(link.Roles, StringComparer.Ordinal);
    }

    private static readonly PackageEvidenceRole[] RoleChoices = [.. Enum.GetValues<PackageEvidenceRole>().Where(r => r != PackageEvidenceRole.NotClassified)];

    private GitConnectionStatus? _status;
    private IReadOnlyList<GitSourceLink> _links = [];
    private readonly Dictionary<string, Choice> _selected = new(StringComparer.Ordinal);
    private string? _error, _busyText, _environmentId, _projectName;
    private bool Busy => _busyText is not null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var context = await Contexts.GetActiveContextAsync();
            (_environmentId, _projectName) = (context.ActiveProfileOrNull?.Id, context.ActiveProfileOrNull?.Project?.ProjectName ?? context.ActiveProfileOrNull?.Name);
        }
        catch (InvalidOperationException) { }
        (_status, _error) = await Git.StatusAsync();
        if (_environmentId is not null && _status?.Installation is { Found: true }) (_links, _error) = await Git.LinksAsync(_environmentId);
    }

    private async Task Act(string text, Func<Task> work)
    {
        (_busyText, _error) = (text, null);
        try { await work(); }
        finally { _busyText = null; }
    }

    private void Replace(GitSourceLink updated)
    {
        _links = _links.Where(l => l.Id != updated.Id).Append(updated).OrderBy(l => l.Repository, StringComparer.OrdinalIgnoreCase).ToList();
        if (_selected.TryGetValue(updated.Id, out var choice)) choice.Link = updated;
    }

    private Task FetchAsync(GitSourceLink link) => Act("Fetching the latest branches. If Git Credential Manager opens a sign-in window, complete it there…", async () =>
    {
        var (updated, error) = await Git.FetchAsync(link.Id, link.EnvironmentId);
        if (updated is null) { _error = error; return; }
        Replace(updated);
        if (_selected.TryGetValue(updated.Id, out var choice)) choice.Branches = (await Git.BranchesAsync(updated.Id, updated.EnvironmentId)).Items;
    });

    private async Task ToggleAsync(GitSourceLink link, bool on)
    {
        if (!on) { _selected.Remove(link.Id); return; }
        var choice = new Choice(link);
        _selected[link.Id] = choice;
        var (branches, error) = await Git.BranchesAsync(link.Id, link.EnvironmentId);
        (choice.Branches, _error) = (branches, error);
        if (choice.Branch.Length == 0 && branches.FirstOrDefault(b => b.IsDefault) is { } fallback) choice.Branch = fallback.Name;
    }

    private void OnAdded(GitSourceLink link)
    {
        Replace(link);
        _error = link.LastFetchFailure is { } failure ? $"{link.Repository} was added, but fetching it failed: {link.LastFetchProblem ?? GitSourcePolicy.Describe(failure)}" : null;
    }

    private void CheckCommit(Choice choice)
    {
        choice.CommitProblem = null;
        if (string.IsNullOrWhiteSpace(choice.Commit)) { choice.Commit = null; return; }
        choice.Commit = choice.Commit.Trim().ToLowerInvariant();
        if (!GitSourcePolicy.IsCommitSha(choice.Commit)) choice.CommitProblem = "A full 40-character commit SHA is required.";
    }

    private Task ImportAsync() => Act("Saving the branch and roles…", async () =>
    {
        if (_environmentId is not { } environment) { _error = "Choose a Target Environment (BirkNext project) first."; return; }
        var queue = new List<(GitImportRequest, string)>();
        foreach (var c in _selected.Values)
        {
            // The branch and roles are the link's (shown in Source Management); a specific commit is this import only, never a pin.
            var (link, error) = await Git.UpdateLinkAsync(c.Link.Id, environment, c.Branch, null, [.. c.Roles]);
            if (link is null) { _error = $"{c.Link.Repository}: {error}"; return; }
            Replace(link);
            queue.Add((new GitImportRequest(link.RepositoryId, c.Branch) { OrganizationUrl = link.OrganizationUrl, Commit = c.Commit, EnvironmentId = environment, Roles = [.. c.Roles] },
                $"{link.Repository} @ {(c.Commit is { Length: > 0 } sha ? sha[..8] : c.Branch)}"));
        }
        await OnImport.InvokeAsync(queue);
    });

    private RenderFragment Configure(GitSourceLink link, Choice choice) => __builder =>
    {
        <div class="giw-config" data-testid="giw-config">
            <label>Branch
                <select value="@choice.Branch" @onchange="e => choice.Branch = e.Value?.ToString() ?? choice.Branch" data-testid="giw-branch">
                    @if (choice.Branches.All(b => b.Name != choice.Branch)) { <option value="@choice.Branch">@choice.Branch</option> }
                    @foreach (var b in choice.Branches) { <option value="@b.Name">@b.Name@(b.IsDefault ? " (default)" : "") · @b.CommitSha[..8]@(b.CommittedAt is { } d ? $" · {d.UtcDateTime:yyyy-MM-dd}" : "")</option> }
                </select>
            </label>
            <label>Specific commit (optional)
                <input class="form-control" @bind="choice.Commit" @bind:after="() => CheckCommit(choice)" placeholder="40-character SHA" spellcheck="false" data-testid="giw-commit" />
            </label>
            @if (choice.CommitProblem is { } problem) { <span class="giw-error giw-small" data-testid="giw-commit-problem">@problem</span> }
            <fieldset class="giw-roles" aria-label="Roles of @link.Repository">
                <legend class="giw-small">Roles (several allowed; empty = detected from content after import)</legend>
                @foreach (var role in RoleChoices)
                {
                    <label><input type="checkbox" checked="@choice.Roles.Contains(role.ToString())" @onchange="e => { if ((bool)e.Value!) choice.Roles.Add(role.ToString()); else choice.Roles.Remove(role.ToString()); }" data-testid="giw-role" data-role="@role" /> @ApplicationContexts.RoleLabel(role)</label>
                }
            </fieldset>
        </div>
    };
}
