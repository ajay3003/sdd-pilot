@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using Microsoft.Extensions.Logging
@inject IScenarioExtractionService ExtractionService
@inject IExtractionConfiguration ExtractionConfig
@inject IExtractionSessionService SessionService
@inject ILogger<ExtractionInput> Logger

<div class="extraction-input">
    <SpecificationImport
        OnFileImported="HandleFileImported"
        OnFileRemoved="HandleFileRemoved"
        IsDisabled="_isExtracting" />

    <div class="import-separator">or type / paste below</div>

    <div class="input-field">
        <label for="spec-input">Specification text</label>
        <textarea
            id="spec-input"
            rows="12"
            placeholder="Paste your specification document here — requirements, test cases, or any structured text…"
            @bind="_rawInput"
            @bind:event="oninput"
            data-testid="spec-textarea"
            disabled="@_isExtracting" />

        @if (_validationMessage is not null)
        {
            <p class="validation-message" data-testid="validation-message" role="alert">@_validationMessage</p>
        }
    </div>

    <div class="profile-selector" data-testid="profile-selector">
        <div class="profile-radio-group" role="radiogroup" aria-label="Analysis Profile">
            <label class="profile-radio-label">
                <input type="radio" name="extraction-profile"
                       checked="@(_profile == ExtractionProfile.Speckit)"
                       @onchange="@(() => _profile = ExtractionProfile.Speckit)"
                       data-testid="profile-radio-speckit" />
                <span>Speckit Structured Spec</span>
                <small>Optimized for structured Speckit spec.md documents with deterministic subgrouping and traceability.</small>
            </label>
            <label class="profile-radio-label">
                <input type="radio" name="extraction-profile"
                       checked="@(_profile == ExtractionProfile.Default)"
                       @onchange="@(() => _profile = ExtractionProfile.Default)"
                       data-testid="profile-radio-default" />
                <span>Generic Document</span>
                <small>Use for general markdown or text requirements documents.</small>
            </label>
        </div>
    </div>

    @if (_showReplaceConfirm)
    {
        <div class="replace-session-confirm"
             role="alertdialog"
             aria-labelledby="replace-confirm-title"
             aria-modal="true"
             data-testid="replace-session-dialog">
            <p id="replace-confirm-title">You already have an active review session.
                Starting a new extraction will replace the current session.</p>
            <div class="replace-session-actions">
                <button type="button"
                        @onclick="ConfirmReplaceAsync"
                        data-testid="replace-confirm-btn">Continue and Replace</button>
                <button type="button"
                        @onclick="CancelReplace"
                        data-testid="replace-cancel-btn">Cancel</button>
            </div>
        </div>
    }
    else
    {
        <div class="input-actions">
            <button
                type="button"
                @onclick="HandleExtract"
                disabled="@_isExtracting"
                data-testid="extract-button"
                class="btn-primary">
                @if (_isExtracting)
                {
                    <span>Analyzing...</span>
                }
                else
                {
                    <span>Analyze Specification</span>
                }
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public EventCallback<ExtractionPipelineResult> OnExtractionCompleted { get; set; }

    private string _rawInput = string.Empty;
    private bool _isExtracting;
    private string? _validationMessage;
    private ExtractionProfile _profile = ExtractionProfile.Speckit;
    private bool _showReplaceConfirm;

    private void HandleFileImported(string content)
    {
        _rawInput = content;
        _validationMessage = null;
    }

    private void HandleFileRemoved()
    {
        _rawInput = string.Empty;
        _validationMessage = null;
    }

    private async Task HandleExtract()
    {
        _validationMessage = null;

        if (string.IsNullOrWhiteSpace(_rawInput))
        {
            _validationMessage = "Paste specification text to analyze";
            return;
        }

        if (_rawInput.Length > ExtractionConfig.MaxInputLengthChars)
        {
            _validationMessage = $"Input is too large (max {ExtractionConfig.MaxInputLengthChars:N0} characters)";
            return;
        }

        var existingSession = await SessionService.LoadAsync();
        if (existingSession is not null && !SessionService.IsExpired(existingSession))
        {
            _showReplaceConfirm = true;
            return;
        }

        await RunExtractionAsync();
    }

    private async Task ConfirmReplaceAsync()
    {
        _showReplaceConfirm = false;
        await SessionService.ClearAsync();
        await RunExtractionAsync();
    }

    private void CancelReplace() => _showReplaceConfirm = false;

    private async Task RunExtractionAsync()
    {
        _isExtracting = true;
        StateHasChanged();

        var inputLengthChars = _rawInput.Length;
        var inputLineCount = _rawInput.Split('\n').Length;
        var sessionId = Guid.NewGuid().ToString();

        // no raw text: only numeric metrics and opaque session identifier
        Logger.LogInformation(
            "ExtractionTriggered: inputLengthChars={InputLengthChars}, inputLineCount={InputLineCount}, sessionId={SessionId}",
            inputLengthChars, inputLineCount, sessionId);

        try
        {
            var result = await ExtractionService.ExtractAsync(_rawInput, _profile);

            if (result.Status == PipelineStatus.Success)
            {
                // no raw text: only aggregate counts and duration
                Logger.LogInformation(
                    "ExtractionCompleted: candidateCount={CandidateCount}, requirementCount={RequirementCount}, testCount={TestCount}, needsClarificationCount={NeedsClarificationCount}, durationMs={DurationMs}, sessionId={SessionId}",
                    result.Candidates.Count, result.RequirementCount, result.TestCount, result.NeedsClarificationCount, result.DurationMs, sessionId);
            }
            else
            {
                var reason = result.Status switch
                {
                    PipelineStatus.EmptyInput => "empty_input",
                    PipelineStatus.InputTooLarge => "input_too_large",
                    PipelineStatus.NoResults => "no_candidates_found",
                    _ => result.Status.ToString().ToLowerInvariant(),
                };
                // no raw text: only input length, snake_case reason code, and session identifier
                Logger.LogInformation(
                    "ExtractionEmpty: inputLengthChars={InputLengthChars}, reason={Reason}, sessionId={SessionId}",
                    result.InputLengthChars, reason, sessionId);
            }

            await OnExtractionCompleted.InvokeAsync(result);
        }
        finally
        {
            _isExtracting = false;
        }
    }
}
