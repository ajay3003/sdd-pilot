@if (Scenarios.Count == 0)
{
    <div class="empty-state empty-state-dashed">
        <p data-testid="empty-state">No QA artifacts have been saved yet. <a href="/specification-explorer">Analyze Specification</a> to review and accept generated requirements, tests, and clarifications.</p>
    </div>
}
else
{
    @for (int i = 0; i < Scenarios.Count; i++)
    {
        var scenario = Scenarios[i];
        var index = i;
        var isDragTarget = _dragTargetIndex == index && _dragSourceIndex != index;
        var isDragSource = _dragSourceIndex == index;
        var relationship = GetRelationshipSummary(scenario.Id);
        <div class="scenario-card @(isDragSource ? "drag-source" : "") @(isDragTarget ? "drag-over-above" : "")"
             data-testid="scenario-row"
             draggable="@(IsDraggable ? "true" : "false")"
             @ondragstart="() => HandleDragStart(index)"
             @ondragenter="() => HandleDragEnter(index)"
             @ondragover:preventDefault="@IsDraggable"
             @ondrop="HandleDrop"
             @ondragend="HandleDragEnd">
            <div class="scenario-card-header">
                @if (IsDraggable)
                {
                    <span class="drag-handle"
                          aria-label="Drag to reorder test scenario"
                          data-testid="drag-handle-@scenario.Id"
                          role="img">⠿</span>
                }
                <div class="artifact-card-identity">
                    <span class="badge badge-@scenario.Kind.ToLowerInvariant()">@scenario.Kind</span>
                    <span class="artifact-state-pill state-@relationship.StateTone">@relationship.StateLabel</span>
                </div>
                <div class="scenario-card-actions">
                    @if (IsDraggable)
                    {
                        <button type="button" class="move-btn"
                                aria-label="Move test scenario up: @scenario.Title"
                                data-testid="move-up-btn-@scenario.Id"
                                disabled="@(index == 0)"
                                @onclick="() => MoveUp(index)">↑</button>
                        <button type="button" class="move-btn"
                                aria-label="Move test scenario down: @scenario.Title"
                                data-testid="move-down-btn-@scenario.Id"
                                disabled="@(index == Scenarios.Count - 1)"
                                @onclick="() => MoveDown(index)">↓</button>
                    }
                    @if (DeletingId == scenario.Id)
                    {
                        <span class="delete-spinner" aria-label="Deleting scenario">Deleting…</span>
                    }
                    else if (_pendingDeleteId != scenario.Id)
                    {
                        <button type="button" class="scenario-delete-btn"
                                aria-label="Delete scenario: @scenario.Title"
                                @onclick="() => RequestDelete(scenario.Id)"
                                data-testid="delete-btn-@scenario.Id">
                            Delete
                        </button>
                    }
                </div>
            </div>
            <div class="scenario-card-body">
                <div class="scenario-card-title">@scenario.Title</div>
                <p class="artifact-card-context">@relationship.CoverageLabel</p>
            </div>
            @if (scenario.Description is not null)
            {
                <div class="scenario-card-description">@scenario.Description</div>
            }
            @if (!string.IsNullOrWhiteSpace(relationship.RecommendedAction))
            {
                <div class="artifact-recommended-action">
                    <span>Recommended action</span>
                    <strong>@relationship.RecommendedAction</strong>
                </div>
            }
            <div class="artifact-relationship-row" aria-label="Artifact relationships">
                <span class="relationship-slot relationship-requirement @(relationship.LinkedRequirements > 0 ? "slot-filled" : "slot-empty")">
                    <strong>@relationship.LinkedRequirements</strong> Requirements
                </span>
                <span class="relationship-slot relationship-test @(relationship.LinkedTests > 0 ? "slot-filled" : "slot-empty")">
                    <strong>@relationship.LinkedTests</strong> Tests
                </span>
                <span class="relationship-slot relationship-clarification @(relationship.LinkedClarifications > 0 ? "slot-filled" : "slot-empty")">
                    <strong>@relationship.LinkedClarifications</strong> Clarifications
                </span>
            </div>
            @if (_pendingDeleteId == scenario.Id)
            {
                <div class="delete-confirm" role="alert" data-testid="delete-confirm-@scenario.Id">
                    <span>Delete this scenario? This cannot be undone.</span>
                    <button type="button" class="btn-danger btn-sm" @onclick="() => ConfirmDeleteAsync(scenario.Id)" data-testid="delete-confirm-btn">Confirm</button>
                    <button type="button" class="btn-secondary btn-sm" @onclick="CancelDelete" data-testid="delete-cancel-btn">Cancel</button>
                </div>
            }
            @if (DeleteErrors is not null && DeleteErrors.TryGetValue(scenario.Id, out var deleteError))
            {
                <div class="delete-error" role="alert" data-testid="delete-error-@scenario.Id">@deleteError</div>
            }
        </div>
    }
}

@code {
    [Parameter] public IReadOnlyList<ScenarioListItem> Scenarios { get; set; } = [];
    [Parameter] public EventCallback<string> OnDeleteRequested { get; set; }
    [Parameter] public string? DeletingId { get; set; }
    [Parameter] public IReadOnlyDictionary<string, string>? DeleteErrors { get; set; }
    [Parameter] public bool IsDraggable { get; set; }
    [Parameter] public EventCallback<List<ScenarioListItem>> OnReordered { get; set; }
    [Parameter] public IReadOnlyDictionary<string, ArtifactRelationshipSummary> RelationshipSummaries { get; set; }
        = new Dictionary<string, ArtifactRelationshipSummary>();

    private string? _pendingDeleteId;
    private int? _dragSourceIndex;
    private int? _dragTargetIndex;

    private ArtifactRelationshipSummary GetRelationshipSummary(string id) =>
        RelationshipSummaries.TryGetValue(id, out var summary)
            ? summary
            : new ArtifactRelationshipSummary();

    private static string Plural(int count) => count == 1 ? string.Empty : "s";

    private void RequestDelete(string id) => _pendingDeleteId = id;

    private void CancelDelete() => _pendingDeleteId = null;

    private async Task ConfirmDeleteAsync(string id)
    {
        _pendingDeleteId = null;
        await OnDeleteRequested.InvokeAsync(id);
    }

    private void HandleDragStart(int index) => _dragSourceIndex = index;

    private void HandleDragEnter(int index)
    {
        if (_dragSourceIndex is null) return;
        _dragTargetIndex = index;
    }

    private void HandleDragEnd()
    {
        _dragSourceIndex = null;
        _dragTargetIndex = null;
    }

    private async Task HandleDrop()
    {
        if (_dragSourceIndex is null || _dragTargetIndex is null || _dragSourceIndex == _dragTargetIndex)
        {
            HandleDragEnd();
            return;
        }

        var reordered = Scenarios.ToList();
        var item = reordered[_dragSourceIndex.Value];
        reordered.RemoveAt(_dragSourceIndex.Value);
        var insertAt = _dragTargetIndex.Value > _dragSourceIndex.Value ? _dragTargetIndex.Value - 1 : _dragTargetIndex.Value;
        reordered.Insert(insertAt, item);

        HandleDragEnd();
        await OnReordered.InvokeAsync(reordered);
    }

    private async Task MoveUp(int index)
    {
        if (index == 0) return;
        var reordered = Scenarios.ToList();
        (reordered[index], reordered[index - 1]) = (reordered[index - 1], reordered[index]);
        await OnReordered.InvokeAsync(reordered);
    }

    private async Task MoveDown(int index)
    {
        if (index == Scenarios.Count - 1) return;
        var reordered = Scenarios.ToList();
        (reordered[index], reordered[index + 1]) = (reordered[index + 1], reordered[index]);
        await OnReordered.InvokeAsync(reordered);
    }
}
