@if (Scenarios.Count == 0)
{
    <div class="empty-state empty-state-dashed">
        <p data-testid="empty-state">No scenarios yet. Use <a href="/extract">Extract</a> to identify and save scenarios from your specification text.</p>
    </div>
}
else
{
    @foreach (var scenario in Scenarios)
    {
        <div class="scenario-card" data-testid="scenario-row">
            <div class="scenario-card-header">
                <span class="badge badge-@scenario.Kind.ToLowerInvariant()">@scenario.Kind</span>
            </div>
            <div class="scenario-card-title">@scenario.Title</div>
            @if (scenario.Description is not null)
            {
                <div class="scenario-card-description">@scenario.Description</div>
            }
        </div>
    }
}

@code {
    [Parameter] public IReadOnlyList<ScenarioListItem> Scenarios { get; set; } = [];
}
