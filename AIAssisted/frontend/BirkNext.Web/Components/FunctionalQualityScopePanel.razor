@using BirkNext.DeliveryReporting
@using BirkNext.Web.Services
@using P = BirkNext.Web.Services.FunctionalQualityScopePresentation
@using T = BirkNext.DeliveryReporting.FunctionalQualityScopeText
@using BirkNext.Interpretation
@using BirkNext.Web.Models
@inject IFunctionalQualityScopeApiService Api
@inject NavigationManager Nav
@inject IServiceProvider Services
@inject IJSRuntime JS

@* Functional Quality Scope: choose a scope (domain flow, module or custom) and see its user stories, acceptance scenarios, acceptance criteria and
   requirements, each with its quality category, why it is in scope, coverage, Test Data and testability. A projection over the newest Delivery
   snapshot — custom scopes hold references only. *@

<section class="fqs" data-testid="fqs">
    <header class="fqs-head">
        <div>
            <h2 class="fqs-h2">Functional Quality Scope</h2>
            <p class="fqs-muted">Testable behaviour for one scope. Technical work (migrations, framework or pipeline changes) is excluded unless you include it.</p>
        </div>
        <div class="fqs-controls">
            <label class="fqs-field">
                <span>Scope</span>
                <select data-testid="fqs-scope" value="@_scopeKey" @onchange="OnScopeChanged">
                    @if (_available.Count == 0) { <option value="">No scopes yet</option> }
                    @foreach (var group in _available.GroupBy(a => a.Kind))
                    {
                        <optgroup label="@P.KindHeading(group.Key)">
                            @foreach (var scope in group) { <option value="@scope.Key" title="@scope.Detail">@scope.Name</option> }
                        </optgroup>
                    }
                </select>
            </label>
            <fieldset class="fqs-toggle" data-testid="fqs-relation-mode">
                <legend>Membership</legend>
                <label><input type="radio" name="fqs-mode" checked="@(!_includeRelated)" @onchange="() => SetRelated(false)" data-testid="fqs-mode-direct" /> Direct only</label>
                <label><input type="radio" name="fqs-mode" checked="@_includeRelated" @onchange="() => SetRelated(true)" data-testid="fqs-mode-related" /> Include related</label>
            </fieldset>
            <label class="fqs-check"><input type="checkbox" checked="@_includeTechnical" @onchange="ToggleTechnical" data-testid="fqs-technical" /> Include technical work</label>
            <label class="fqs-field" title="Test and schema evidence is environment-specific: coverage, tests and schemas come from the selected environment's interpreted source.">
                <span>Evidence environment</span>
                <select data-testid="fqs-environment" value="@(EnvironmentValue)" @onchange="OnEnvironmentChanged" disabled="@_loading">
                    @if (_resolution?.Evidence is { Applied: false, Available.Count: > 1 }) { <option value="">Choose an environment</option> }
                    @if (_resolution?.Evidence is { Available.Count: 0 }) { <option value="">No environment has test evidence</option> }
                    @foreach (var env in _resolution?.Evidence?.Available ?? [])
                    {
                        <option value="@env.Id">@ScopeFilterState.EnvironmentName(env.Id, _environmentNames) (@env.Tests test@(env.Tests == 1 ? "" : "s"))</option>
                    }
                    @if (_environment is { } chosen && chosen != ScopeEnvironments.All && _resolution?.Evidence?.Available.All(a => a.Id != chosen) != false)
                    {
                        <option value="@chosen">@ScopeFilterState.EnvironmentName(chosen, _environmentNames) (no test evidence)</option>
                    }
                    @if ((_resolution?.Evidence?.Available.Count ?? 0) > 1) { <option value="@ScopeEnvironments.All">All environments (aggregated)</option> }
                </select>
            </label>
        </div>
        <div class="fqs-actions">
            <button type="button" class="btn-secondary" data-testid="fqs-new" @onclick="StartNew">+ Custom scope</button>
            @if (_custom is not null)
            {
                <button type="button" class="btn-secondary" data-testid="fqs-edit" aria-pressed="@(_editing ? "true" : "false")" @onclick="ToggleEdit">@(_editing ? "Done editing" : "Edit scope")</button>
                <button type="button" class="btn-secondary" data-testid="fqs-clone" @onclick="Clone">Clone</button>
                <button type="button" class="btn-secondary" data-testid="fqs-delete" @onclick="() => _confirmDelete = true">Delete</button>
            }
            <button type="button" class="btn-secondary" data-testid="fqs-freeze" disabled="@(_resolution?.SnapshotId is null)" @onclick="Freeze"
                    title="Store this scope's exact membership now, for a report or a finalized review.">Freeze scope snapshot</button>
        </div>
    </header>

    @if (_newOpen)
    {
        <form class="fqs-card fqs-inline" data-testid="fqs-new-form" @onsubmit="CreateScope" @onsubmit:preventDefault>
            <label class="fqs-field"><span>Name</span><input data-testid="fqs-new-name" @bind="_newName" maxlength="200" required /></label>
            <label class="fqs-field"><span>Start from</span>
                <select data-testid="fqs-new-root" @bind="_newRoot">
                    <option value="">Empty (manual scope)</option>
                    @foreach (var scope in _available.Where(a => a.CustomId is null)) { <option value="@scope.Key">@scope.Name</option> }
                </select>
            </label>
            <div class="fqs-actions">
                <button type="submit" class="btn-primary" data-testid="fqs-new-save">Create scope</button>
                <button type="button" class="btn-secondary" @onclick="() => _newOpen = false">Cancel</button>
            </div>
        </form>
    }

    @if (_confirmDelete && _custom is not null)
    {
        <div class="fqs-card fqs-confirm" role="alertdialog" aria-labelledby="fqs-confirm-title" data-testid="fqs-delete-confirm">
            <p id="fqs-confirm-title"><strong>Delete the scope “@_custom.Name”?</strong> Its items are not touched. Frozen scope snapshots keep their membership.</p>
            <div class="fqs-actions">
                <button type="button" class="btn-primary" data-testid="fqs-delete-yes" @onclick="Delete">Delete scope</button>
                <button type="button" class="btn-secondary" @onclick="() => _confirmDelete = false">Cancel</button>
            </div>
        </div>
    }

    @if (_error is not null) { <p class="fqs-error" role="alert" data-testid="fqs-error">@_error</p> }
    @if (_notice is not null) { <p class="fqs-notice" role="status" data-testid="fqs-notice">@_notice</p> }

    @if (_loading && _resolution is null)
    {
        <div class="fqs-skeleton" role="status" aria-label="Loading scope"><span></span><span></span></div>
    }
    else if (_loading)
    {
        <ReviewStageList Stages="@([new ReviewStage("scope", _loadingLabel, ReviewStageState.Running)])" TestId="fqs-reloading" />
    }
    else if (_resolution is { } r)
    {
        @Summary(r)
        @if (r.RelatedModules.Count > 0) { @Related(r) }
        @Scenarios(r)
        @foreach (var limitation in r.Limitations) { <p class="fqs-limit" data-testid="fqs-limitation">@limitation</p> }
        @if (_editing && _custom is not null) { @Builder(r) }
        <div class="fqs-explorer" data-testid="fqs-explorer" @ref="_explorer">
            <div class="fqs-master" aria-label="Requirement explorer">
                @Filters(r)
                @if (_editing && _custom is not null)
                {
                    @* The drop zone exists even when the scope is still empty, so the first item can be dragged in. *@
                    <div class="fqs-dropzone @(_dragKey is null ? "" : "is-dragging")" data-testid="fqs-dropzone" @ondragenter:preventDefault="true" @ondragover:preventDefault="true" @ondrop="DropIntoScope">
                        <p class="fqs-drop-hint">Drop items here to add them to “@_custom.Name” — or use Add.</p>
                        @Items(r)
                    </div>
                }
                else { @Items(r) }
            </div>
            <div class="fqs-detail-pane" aria-live="polite" data-testid="fqs-detail-pane">
                @if (_detailLoading) { <ReviewStageList Stages="@([new ReviewStage("detail", $"Loading the item's details, tests and evidence{(_environment is null ? "" : $" for {ScopeFilterState.EnvironmentName(_environment, _environmentNames)}")}", ReviewStageState.Running)])" TestId="fqs-detail-loading" /> }
                else if (_detail is not null) { @Detail(_detail) }
                else { <p class="fqs-muted fqs-detail-empty" data-testid="fqs-detail-empty">Select a requirement, user story or acceptance criterion to see its description, acceptance criteria, tests, Test Data and evidence.</p> }
            </div>
        </div>
        @if (_snapshots.Count > 0) { @Snapshots() }
    }
</section>

@code {
    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
    /// <summary>Scope key from the URL (?scope=profile:skolenaervaer | module:Person | custom:{id}).</summary>
    [Parameter] public string? InitialScope { get; set; }

    private Guid _loadedProject;
    private IReadOnlyList<AvailableScope> _available = [];
    private string _scopeKey = "";
    private bool _includeRelated, _includeTechnical, _loading, _editing, _newOpen, _confirmDelete;
    private string? _error, _notice;
    private ScopeResolution? _resolution;
    private ScopeDefinition? _custom;
    private ScopeFilter _filter = new();
    /// <summary>Every filter change goes through here: the selection is reconciled (an item the filters hide is no longer selected) and the URL updated.</summary>
    private ScopeFilter Filter
    {
        get => _filter;
        set
        {
            if (value == _filter) return;
            _filter = value;
            if (_detail is { } d && _resolution is { } r && !P.Apply(r.Items, value).Any(i => i.Key == d.Item.Key))
            {
                (_detail, _selectedTest) = (null, null);
                _notice = "The selected item is not in the filtered list, so it is no longer selected.";
            }
            WriteUrl();
        }
    }
    private bool _detailLoading, _fullText, _deciding;
    private string? _selectedTest, _pendingItem;
    private int _detailGeneration;
    private IReadOnlyList<ReviewDecisionView> _history = [];
    private ICanonicalInterpretationApiService? Review => Services.GetService(typeof(ICanonicalInterpretationApiService)) as ICanonicalInterpretationApiService;
    private ExplorerViewStateStore? Store => Services.GetService(typeof(ExplorerViewStateStore)) as ExplorerViewStateStore;
    /// <summary>Imported test results (TRX) of this workspace, for requirement → test → execution.</summary>
    private BirkNext.Web.Models.SddLifecycleState? Lifecycle => (Services.GetService(typeof(IWorkspaceArtifactRepository)) as IWorkspaceArtifactRepository)?.SddLifecycle;
    private string StateKey => $"fqs|{ProjectId}";
    /// <summary>The evidence environment: a Target Environment id, "*" (all, aggregated) or null (the only one with evidence).</summary>
    private string? _environment;
    private string _loadingLabel = "Loading the scope";
    private IReadOnlyDictionary<string, string> _environmentNames = new Dictionary<string, string>();
    private string EnvironmentValue => _environment ?? (_resolution?.Evidence?.Applied == true ? _resolution.Evidence.Environment ?? "" : "");
    private string? AppliedEnvironment => _resolution?.Evidence is { CrossEnvironment: true } ? ScopeEnvironments.All : _resolution?.Evidence?.Environment;

    /// <summary>Filters, the evidence environment and the selected item live in the URL (fq-* keys) and in this session's memory, so leaving the tab
    /// or page and returning restores them; other query keys are kept.</summary>
    private void WriteUrl()
    {
        var query = new Dictionary<string, object?>(ScopeFilterState.ToQuery(_filter, _detail?.Item.Key)) { [ScopeFilterState.EnvironmentKey] = _environment };
        var target = Nav.GetUriWithQueryParameters(query);
        if (target != Nav.Uri) Nav.NavigateTo(target, replace: true);
        Store?.Set(StateKey, query);
    }

    private void ReadUrl()
    {
        var query = DeliveryExplorerState.Parse(Nav.Uri).Where(kv => kv.Key.StartsWith("fq-", StringComparison.Ordinal)).ToDictionary(kv => kv.Key, kv => kv.Value, StringComparer.Ordinal);
        // Nothing in the URL (the tab was opened from a plain link): this session's last state for the project, if any.
        if (query.Values.All(string.IsNullOrWhiteSpace) && Store?.Get(StateKey) is { } saved) query = saved.ToDictionary(kv => kv.Key, kv => kv.Value, StringComparer.Ordinal);
        (_filter, _pendingItem) = ScopeFilterState.FromQuery(query);
        _environment = query.GetValueOrDefault(ScopeFilterState.EnvironmentKey) is { Length: > 0 } env ? env : null;
    }

    private void LoadEnvironmentNames()
    {
        if (Services.GetService(typeof(IFrontendAnalysisSettingsService)) is not IFrontendAnalysisSettingsService settings) return;
        _environmentNames = settings.Settings.Profiles.Where(p => p.Id.Length > 0).GroupBy(p => p.Id).ToDictionary(g => g.Key, g => g.First().Name, StringComparer.Ordinal);
        _activeEnvironment = settings.ActiveProfile?.Id is { Length: > 0 } active ? active : null;
    }

    private string? _activeEnvironment;

    /// <summary>Another environment's evidence: coverage, the list, the open item's tests and schemas all re-read for it. A slower earlier response
    /// never overwrites a newer choice.</summary>
    private async Task OnEnvironmentChanged(ChangeEventArgs e)
    {
        _environment = e.Value?.ToString() is { Length: > 0 } env ? env : null;
        _loadingLabel = $"Loading test evidence for {ScopeFilterState.EnvironmentName(_environment, _environmentNames)}";
        var open = _detail?.Item.Key;
        await ResolveAsync();
        WriteUrl();
        if (open is not null && _resolution?.Items.Any(i => i.Key == open) == true) await OpenDetail(open);
    }
    private ScopeResolution? _all;
    private string? _builderSearch, _dragKey;
    private string _newName = "", _newRoot = "";
    private ScopeItemDetail? _detail;
    private TestDesignAssessmentView? _assessment;
    private string _assessmentData = "";
    private IReadOnlyList<ScopeSnapshotView> _snapshots = [];
    private readonly HashSet<string> _why = new(StringComparer.Ordinal);
    private ElementReference _explorer;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedProject == ProjectId) return;
        _loadedProject = ProjectId;
        _loading = true;
        (_available, _error) = await Api.AvailableAsync(ProjectId);
        _scopeKey = InitialScope is { Length: > 0 } wanted && _available.Any(a => a.Key == wanted) ? wanted : _available.FirstOrDefault()?.Key ?? "";
        if (InitialScope is { Length: > 0 } missing && _scopeKey != missing && _available.Count > 0)
            _notice = $"The scope “{missing}” is not available in this project; showing “{_available.First().Name}”.";
        _snapshots = await Api.SnapshotsAsync(ProjectId);
        ReadUrl();
        LoadEnvironmentNames();
        await ResolveAsync();
        // No environment chosen: the server uses the only one with evidence. With several, the active Target Environment is used when it has evidence;
        // otherwise the person chooses — evidence is never taken from an environment nobody selected.
        if (_environment is null && _resolution?.Evidence is { Applied: false, Available.Count: > 1 } ev && _activeEnvironment is { } activeEnv && ev.Available.Any(a => a.Id == activeEnv))
        {
            _environment = activeEnv;
            await ResolveAsync();
        }
        if (_pendingItem is { } item)
        {
            if (_resolution?.Items.Any(i => i.Key == item) == true) { await OpenDetail(item); _scrollToSelected = true; }
            else if (_resolution is not null) _notice = "The previously selected item is not in this scope or snapshot any more, so nothing is selected.";
        }
        _pendingItem = null;
        WriteUrl();
    }

    private Guid? CustomId => _available.FirstOrDefault(a => a.Key == _scopeKey)?.CustomId;

    private int _resolveGeneration;
    private bool _scrollToSelected;

    private async Task ResolveAsync()
    {
        if (_scopeKey.Length == 0) { _resolution = null; _loading = false; return; }
        _loading = true;
        var generation = ++_resolveGeneration;
        var (resolution, error) = await Api.ResolveAsync(ProjectId, new ScopeQuery(_scopeKey, CustomId, _includeRelated, _includeTechnical, Environment: _environment));
        // A newer scope or environment choice wins over a slower earlier response.
        if (generation != _resolveGeneration) return;
        _loading = false;
        _loadingLabel = "Loading the scope";
        _error = error;
        if (resolution is null) return;
        _resolution = resolution;
        _custom = resolution.Scope.Id is not null && !resolution.Scope.BuiltIn ? resolution.Scope : null;
        if (_custom is null) _editing = false;
    }

    private async Task OnScopeChanged(ChangeEventArgs e)
    {
        _scopeKey = e.Value?.ToString() ?? "";
        (_detail, _selectedTest) = (null, null);
        Filter = new();
        _notice = null;
        _editing = false;
        await ResolveAsync();
    }

    private async Task SetRelated(bool related) { _includeRelated = related; await ResolveAsync(); }
    private async Task ToggleTechnical() { _includeTechnical = !_includeTechnical; await ResolveAsync(); if (_editing) await LoadAllAsync(); }

    // ── Summary and relations ────────────────────────────────────────────────────────────────────────────────────────

    private RenderFragment Summary(ScopeResolution r) => __builder =>
    {
        var s = r.Summary;
        <div class="fqs-card fqs-summary" data-testid="fqs-summary">
            <div class="fqs-scope-line">
                <strong data-testid="fqs-scope-name">@r.Scope.Name</strong>
                @if (r.Scope.Id is not null && !r.Scope.BuiltIn) { <MetaBadge Kind="BadgeKind.Type" Text="@($"Custom · v{r.Scope.Version}")" /> }
                @if (r.SnapshotLabel is { } label) { <MetaBadge Kind="BadgeKind.Provenance" Text="@($"Delivery snapshot {label}")" TestId="fqs-snapshot" /> }
            </div>
            @if (r.Evidence is { } ev)
            {
                <p class="fqs-muted fqs-small @(ev.CrossEnvironment ? "fqs-cross-env" : "")" data-testid="fqs-evidence-context" data-environment="@(ev.CrossEnvironment ? ScopeEnvironments.All : ev.Environment ?? "")">
                    <strong>Evidence: @(ev.CrossEnvironment ? "All environments (aggregated)" : ev.Environment is { } env ? ScopeFilterState.EnvironmentName(env, _environmentNames) : "none applied")</strong> — @ev.Basis
                    @if (ev.CrossEnvironment) { <span data-testid="fqs-cross-env-warning"> Counts mix environments: they are not evidence from any one environment.</span> }
                </p>
            }
            <dl class="fqs-counts">
                <div><dt>User stories</dt><dd data-testid="fqs-count-stories">@s.UserStories</dd></div>
                <div><dt>Acceptance scenarios</dt><dd data-testid="fqs-count-scenarios">@s.Scenarios</dd></div>
                <div><dt>Acceptance criteria</dt><dd data-testid="fqs-count-criteria">@s.AcceptanceCriteria</dd></div>
                <div><dt>Requirements</dt><dd data-testid="fqs-count-requirements">@s.Requirements</dd></div>
                <div><dt>Formal test cases</dt><dd data-testid="fqs-count-testcases">@(s.FormalTestCases == 0 ? "None recorded" : s.FormalTestCases.ToString())</dd></div>
            </dl>
            <div class="fqs-chips" aria-label="Quality categories">
                @foreach (var (category, count) in s.ByCategory.OrderByDescending(c => c.Value))
                {
                    var active = _filter.Category == category;
                    <button type="button" class="fqs-chip @(active ? "is-active" : "")" aria-pressed="@(active ? "true" : "false")" data-testid="fqs-category-@category"
                            @onclick="() => Filter = _filter with { Category = active ? null : category }">@FunctionalQualityClassifier.Label(category) · @count</button>
                }
            </div>
            <p class="fqs-muted fqs-small">
                Coverage: @string.Join(" · ", s.ByCoverage.OrderBy(c => c.Key).Select(c => $"{T.CoverageLabel(c.Key)} {c.Value}"))
                @if (s.TechnicalExcluded > 0) { <span data-testid="fqs-technical-excluded"> · @s.TechnicalExcluded technical item(s) excluded</span> }
                @if (s.Unavailable > 0) { <span data-testid="fqs-unavailable-count"> · @s.Unavailable unavailable</span> }
            </p>
        </div>
    };

    private RenderFragment Related(ScopeResolution r) => __builder =>
    {
        <details class="fqs-card fqs-related" data-testid="fqs-related" open="@_includeRelated">
            <summary>Related modules (@r.RelatedModules.Count(m => m.Included) related, @r.RelatedModules.Count(m => !m.Included) suggested)</summary>
            <ul>
                @foreach (var m in r.RelatedModules)
                {
                    <li data-testid="fqs-related-module">
                        <strong>@m.Module</strong> <MetaBadge Kind="BadgeKind.Scope" Text="@(m.Included ? T.RelationLabel(m.Relation) : "Suggested")" />
                        <span class="fqs-muted">@m.Reason</span>
                        @if (m.Included && !_includeRelated) { <span class="fqs-muted fqs-small"> — shown with “Include related”.</span> }
                    </li>
                }
            </ul>
        </details>
    };

    // ── Scenario candidates (scenarios/1): drafts for criteria no test automates; never run, never coverage ─────────────────

    private RenderFragment Scenarios(ScopeResolution r) => __builder =>
    {
        var drafts = TestScenarioIntelligence.Drafts(r);
        if (drafts.Count == 0) return;
        var shown = drafts.Where(d => d.DuplicateOf is null).ToList();
        <details class="fqs-card fqs-scenarios" data-testid="fqs-scenarios">
            <summary>Scenario candidates (@shown.Count draft@(shown.Count == 1 ? "" : "s") · @shown.Count(d => d.Priority == ScenarioPriority.High) high priority)</summary>
            <p class="fqs-muted fqs-small">Drafts for acceptance criteria with no automated test. @TestScenarioDraft.Status. Review, then write the test where your team keeps tests.</p>
            @if (drafts.Count > shown.Count) { <p class="fqs-muted fqs-small" data-testid="fqs-scenario-duplicates">@(drafts.Count - shown.Count) duplicate criterion/criteria (same feature, same expected outcome) folded into the first.</p> }
            <ol class="fqs-scenario-list">
                @foreach (var d in shown.OrderBy(d => d.Priority).Take(100))
                {
                    <li data-testid="fqs-scenario" data-priority="@d.Priority">
                        <strong>@d.Scenario</strong> <MetaBadge Kind="BadgeKind.Type" Text="@($"{d.Priority} priority")" /> <MetaBadge Kind="BadgeKind.Type" Text="Draft" />
                        <div class="fqs-muted fqs-small">@d.Purpose @d.PriorityReason. @d.Coverage.</div>
                        <dl class="fqs-gwt">
                            @if (d.Given is not null) { <div><dt>Given</dt><dd>@d.Given</dd></div> }
                            @if (d.When is not null) { <div><dt>When</dt><dd>@d.When</dd></div> }
                            <div><dt>@(d.Given is null ? "Expected" : "Then")</dt><dd>@d.Then</dd></div>
                        </dl>
                        <div class="fqs-muted fqs-small" data-testid="fqs-scenario-source">Derived from @d.DerivedFrom</div>
                    </li>
                }
            </ol>
            @if (shown.Count > 100) { <p class="fqs-muted fqs-small">Showing the 100 highest-priority drafts; narrow the scope to see the rest.</p> }
        </details>
    };

    // ── Filters and items ────────────────────────────────────────────────────────────────────────────────────────────

    private RenderFragment Filters(ScopeResolution r) => __builder =>
    {
        var modules = r.Items.Select(i => i.Module).Where(m => m.Length > 0).Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase).ToList();
        var priorities = r.Items.Select(i => i.Priority).OfType<string>().Distinct(StringComparer.OrdinalIgnoreCase).Order().ToList();
        <div class="fqs-filters" data-testid="fqs-filters" role="group" aria-label="Basic filters">
            <label class="fqs-field"><span>Search</span><input type="search" data-testid="fqs-search" value="@_filter.Search" @oninput="e => Filter = _filter with { Search = e.Value?.ToString() }" /></label>
            <label class="fqs-field"><span>Type</span>
                <select data-testid="fqs-filter-type" @onchange="e => Filter = _filter with { Type = Parse<ScopeArtifactType>(e) }">
                    <option value="">All types</option>
                    @foreach (var t in Enum.GetValues<ScopeArtifactType>()) { <option value="@t" selected="@(_filter.Type == t)">@T.TypeLabel(t)</option> }
                </select>
            </label>
            <label class="fqs-field"><span>Quality</span>
                <select data-testid="fqs-filter-category" @onchange="e => Filter = _filter with { Category = Parse<QualityCategory>(e) }">
                    <option value="">All categories</option>
                    @foreach (var c in FunctionalQualityClassifier.AllCategories) { <option value="@c" selected="@(_filter.Category == c)">@FunctionalQualityClassifier.Label(c)</option> }
                </select>
            </label>
            <label class="fqs-field"><span>Module</span>
                <select data-testid="fqs-filter-module" @onchange="e => Filter = _filter with { Module = e.Value?.ToString() is { Length: > 0 } m ? m : null }">
                    <option value="">All modules</option>
                    @foreach (var m in modules) { <option value="@m" selected="@(_filter.Module == m)">@m</option> }
                </select>
            </label>
        </div>
        <details class="fqs-advanced" data-testid="fqs-advanced" open="@ScopeFilterState.AdvancedActive(_filter)">
            <summary>Advanced filters@(ScopeFilterState.AdvancedActive(_filter) ? " · active" : "")</summary>
            <div class="fqs-filters" role="group" aria-label="Advanced filters">
            <label class="fqs-field"><span>Relation</span>
                <select data-testid="fqs-filter-relation" @onchange="e => Filter = _filter with { Relation = Parse<ScopeRelation>(e) }">
                    <option value="">All</option>
                    @foreach (var rel in Enum.GetValues<ScopeRelation>()) { <option value="@rel" selected="@(_filter.Relation == rel)">@T.RelationLabel(rel)</option> }
                </select>
            </label>
            <label class="fqs-field"><span>Coverage</span>
                <select data-testid="fqs-filter-coverage" @onchange="e => Filter = _filter with { Coverage = Parse<ScopeCoverage>(e) }">
                    <option value="">All</option>
                    @foreach (var c in Enum.GetValues<ScopeCoverage>()) { <option value="@c" selected="@(_filter.Coverage == c)">@T.CoverageLabel(c)</option> }
                </select>
            </label>
            <label class="fqs-field"><span>Test Data</span>
                <select data-testid="fqs-filter-testdata" @onchange="e => Filter = _filter with { TestData = Parse<ScopeTestDataState>(e) }">
                    <option value="">All</option>
                    @foreach (var d in Enum.GetValues<ScopeTestDataState>()) { <option value="@d" selected="@(_filter.TestData == d)">@T.TestDataLabel(d)</option> }
                </select>
            </label>
            <label class="fqs-field"><span>Testability</span>
                <select data-testid="fqs-filter-testability" @onchange="e => Filter = _filter with { Testability = Parse<TestabilityClassification>(e) }">
                    <option value="">All</option>
                    @foreach (var t in Enum.GetValues<TestabilityClassification>()) { <option value="@t" selected="@(_filter.Testability == t)">@T.TestabilityLabel(t)</option> }
                </select>
            </label>
            @if (priorities.Count > 0)
            {
                <label class="fqs-field"><span>Priority</span>
                    <select data-testid="fqs-filter-priority" @onchange="e => Filter = _filter with { Priority = e.Value?.ToString() is { Length: > 0 } p ? p : null }">
                        <option value="">All</option>
                        @foreach (var p in priorities) { <option value="@p" selected="@(_filter.Priority == p)">@p</option> }
                    </select>
                </label>
            }
            </div>
        </details>
        @if (ScopeFilterState.Chips(_filter) is { Count: > 0 } chips)
        {
            <p class="fqs-chips fqs-active-filters" data-testid="fqs-active-filters">
                @foreach (var (label, without) in chips)
                {
                    <button type="button" class="fqs-chip is-active" data-testid="fqs-filter-chip" aria-label="@($"Remove filter {label}")" @onclick="() => Filter = without">@label <span aria-hidden="true">×</span></button>
                }
                <button type="button" class="btn-link" data-testid="fqs-clear-filters" @onclick="() => Filter = new()">Clear filters</button>
            </p>
        }
    };

    private RenderFragment Items(ScopeResolution r) => __builder =>
    {
        var shown = P.Apply(r.Items, _filter);
        <p class="fqs-muted fqs-small" data-testid="fqs-shown">Showing @shown.Count of @r.Items.Count items · @r.PrecedenceNote</p>
        if (shown.Count == 0)
        {
            <p class="fqs-card fqs-empty" data-testid="fqs-empty">@(r.Items.Count == 0 ? "Nothing is in this scope yet." : "No item matches these filters.")</p>
            return;
        }
        <div class="fqs-groups" data-testid="fqs-items">
            @foreach (var group in P.Group(shown))
            {
                <section class="fqs-group" data-testid="fqs-group">
                    <h3 class="fqs-h3"><span class="fqs-module">@group.Module</span> @group.FeatureKey — @group.FeatureTitle
                        <MetaBadge Kind="BadgeKind.Scope" Text="@T.RelationLabel(group.Relation)" /></h3>
                    <ul class="fqs-list">
                        @foreach (var item in group.Items) { @Row(item) }
                    </ul>
                </section>
            }
        </div>
    };

    private RenderFragment Row(ScopeItem item) => __builder =>
    {
        var whyOpen = _why.Contains(item.Key);
        <li class="fqs-item @(item.ParentKey is null ? "" : "is-child") @(item.Unavailable ? "is-unavailable" : "") @(_detail?.Item.Key == item.Key ? "is-selected" : "")" data-testid="fqs-item" data-key="@item.Key" data-type="@item.Type"
            aria-current="@(_detail?.Item.Key == item.Key ? "true" : null)">
            <div class="fqs-item-main">
                <span class="fqs-icon" aria-hidden="true">@T.Icon(item.Type)</span>
                <span class="fqs-type">@T.TypeLabel(item.Type)</span>
                <span class="fqs-id">@item.DisplayId</span>
                <button type="button" class="fqs-title" data-testid="fqs-open" @onclick="() => OpenDetail(item.Key)" disabled="@item.Unavailable" title="@item.Title">@item.Title</button>
            </div>
            <div class="fqs-item-meta">
                <MetaBadge Kind="BadgeKind.Type" Text="@FunctionalQualityClassifier.Label(item.Category)" Title="@($"Rule {item.CategoryRule}")" TestId="fqs-category" />
                @if (item.Unavailable) { <SemanticStatusBadge Status="SemanticStatus.Unresolved" QualifiedLabel="Unavailable in current source" TestId="fqs-unavailable" /> }
                else
                {
                    <SemanticStatusBadge Status="@P.CoverageStatus(item.Coverage)" QualifiedLabel="@T.CoverageLabel(item.Coverage)" Explanation="@item.CoverageDetail" TestId="fqs-coverage" />
                    <SemanticStatusBadge Status="@P.TestDataStatus(item.TestData)" QualifiedLabel="@T.TestDataLabel(item.TestData)" TestId="fqs-testdata" />
                    @if (item.Testability != TestabilityClassification.Unclassified) { <MetaBadge Kind="BadgeKind.Type" Text="@T.TestabilityLabel(item.Testability)" /> }
                    @if (item.Priority is { Length: > 0 } priority) { <MetaBadge Kind="BadgeKind.Count" Text="@($"Priority {priority}")" /> }
                }
                <button type="button" class="fqs-why" aria-expanded="@(whyOpen ? "true" : "false")" data-testid="fqs-why"
                        @onclick="() => { if (!_why.Remove(item.Key)) _why.Add(item.Key); }">Why included</button>
                @if (_editing && _custom is not null)
                {
                    @if (item.Inclusion == ScopeInclusion.ExplicitInclude)
                    { <button type="button" class="btn-secondary fqs-small-btn" data-testid="fqs-remove" @onclick="() => RemoveReference(item.Key)">Remove</button> }
                    else
                    { <button type="button" class="btn-secondary fqs-small-btn" data-testid="fqs-exclude" @onclick="() => AddReference(item.Key, ScopeInclusion.ExplicitExclude)">Exclude</button> }
                }
            </div>
            @if (whyOpen)
            {
                <p class="fqs-why-text" data-testid="fqs-why-text">
                    <strong>@T.RelationLabel(item.Relation)@(item.Inclusion == ScopeInclusion.ExplicitInclude ? " · explicitly included" : "")</strong> — @item.Reason
                    <br /><span class="fqs-muted">Category @FunctionalQualityClassifier.Label(item.Category) by rule <code>@item.CategoryRule</code>.</span>
                </p>
            }
        </li>
    };

    private static T2? Parse<T2>(ChangeEventArgs e) where T2 : struct, Enum => Enum.TryParse<T2>(e.Value?.ToString(), out var v) ? v : null;

    // ── Custom scope builder: drag/drop with Add / Remove fallback ───────────────────────────────────────────────────

    private RenderFragment Builder(ScopeResolution r) => __builder =>
    {
        var inScope = r.Items.Select(i => i.Key).ToHashSet(StringComparer.Ordinal);
        var excluded = _custom!.ExplicitExcludes.ToHashSet(StringComparer.Ordinal);
        // The server filters and bounds the list (search + take); only items already in the scope are removed here.
        var candidates = (_all?.Items ?? []).Where(i => !inScope.Contains(i.Key) && i.ParentKey is null).Take(60).ToList();
        <section class="fqs-card fqs-builder" data-testid="fqs-builder">
            <h3 class="fqs-h3">Add items to “@_custom.Name”</h3>
            <p class="fqs-muted fqs-small">Drag an item onto the scope list below, or use Add. Added items stay referenced by their stable key across re-imports.
                @if (excluded.Count > 0) { <span> @excluded.Count item(s) explicitly excluded.</span> }</p>
            <label class="fqs-field"><span>Find items in the project</span><input type="search" data-testid="fqs-builder-search" value="@_builderSearch" @onchange="SearchCandidates" /></label>
            @if (_all is null) { <p class="fqs-muted">Loading items…</p> }
            else if (candidates.Count == 0) { <p class="fqs-muted">No other items match.</p> }
            else
            {
                <ul class="fqs-list fqs-candidates" data-testid="fqs-candidates">
                    @foreach (var c in candidates)
                    {
                        <li class="fqs-item fqs-candidate" draggable="true" data-testid="fqs-candidate" data-key="@c.Key" @ondragstart="() => _dragKey = c.Key">
                            <span class="fqs-icon" aria-hidden="true">@T.Icon(c.Type)</span>
                            <span class="fqs-type">@T.TypeLabel(c.Type)</span> <span class="fqs-id">@c.DisplayId</span> <span>@c.Title</span>
                            <span class="fqs-module">@c.Module</span>
                            <button type="button" class="btn-secondary fqs-small-btn" data-testid="fqs-add" @onclick="() => AddReference(c.Key, ScopeInclusion.ExplicitInclude)">
                                @(excluded.Contains(c.Key) ? "Include again" : "Add")</button>
                        </li>
                    }
                </ul>
            }
        </section>
    };

    private async Task ToggleEdit()
    {
        _editing = !_editing;
        if (_editing) await LoadAllAsync();
    }

    private async Task LoadAllAsync() => (_all, _) = await Api.AllItemsAsync(ProjectId, _includeTechnical, _builderSearch);

    private async Task SearchCandidates(ChangeEventArgs e)
    {
        _builderSearch = e.Value?.ToString();
        await LoadAllAsync();
    }

    private async Task DropIntoScope()
    {
        if (_dragKey is { } key && _editing) await AddReference(key, ScopeInclusion.ExplicitInclude);
        _dragKey = null;
    }

    private async Task AddReference(string key, ScopeInclusion mode)
    {
        if (_custom?.Id is not { } id) return;
        var (scope, error) = await Api.ReferenceAsync(ProjectId, id, key, mode);
        await AfterChange(scope, error, mode == ScopeInclusion.ExplicitExclude ? "Item excluded from the scope." : "Item added to the scope.");
    }

    private async Task RemoveReference(string key)
    {
        if (_custom?.Id is not { } id) return;
        var (scope, error) = await Api.RemoveReferenceAsync(ProjectId, id, key);
        await AfterChange(scope, error, "Explicit reference removed.");
    }

    private async Task AfterChange(ScopeDefinition? scope, string? error, string notice)
    {
        _error = error;
        if (scope is null) return;
        _notice = $"{notice} Scope version {scope.Version}.";
        await ResolveAsync();
    }

    private void StartNew() { _newOpen = true; _newName = ""; _newRoot = ""; }

    private async Task CreateScope()
    {
        var roots = _newRoot.Length == 0 ? new List<string>() : [_newRoot];
        var (scope, error) = await Api.SaveAsync(ProjectId, new ScopeDefinition { Name = _newName, Roots = roots, IncludeRelated = _includeRelated });
        _error = error;
        if (scope?.Id is not { } id) return;
        _newOpen = false;
        await ReloadAvailable($"custom:{id}");
        _editing = true;
        await LoadAllAsync();
        _notice = $"Scope “{scope.Name}” created. Add items below.";
    }

    private async Task Clone()
    {
        if (_custom?.Id is not { } id) return;
        var (scope, error) = await Api.CloneAsync(ProjectId, id);
        _error = error;
        if (scope?.Id is { } cloned) { await ReloadAvailable($"custom:{cloned}"); _notice = $"Cloned as “{scope.Name}”."; }
    }

    private async Task Delete()
    {
        _confirmDelete = false;
        if (_custom?.Id is not { } id) return;
        _error = await Api.DeleteAsync(ProjectId, id);
        if (_error is null) { var name = _custom.Name; await ReloadAvailable(null); _notice = $"Scope “{name}” deleted."; }
    }

    private async Task ReloadAvailable(string? select)
    {
        (_available, _error) = await Api.AvailableAsync(ProjectId);
        _scopeKey = select is not null && _available.Any(a => a.Key == select) ? select : _available.FirstOrDefault()?.Key ?? "";
        _editing = false;
        await ResolveAsync();
    }

    private async Task Freeze()
    {
        var (snapshot, error) = await Api.FreezeAsync(ProjectId, new ScopeQuery(_scopeKey, CustomId, _includeRelated, _includeTechnical, Environment: _environment));
        _error = error;
        if (snapshot is null) return;
        _notice = $"Scope snapshot frozen: {snapshot.ItemCount} items (scope version {snapshot.ScopeVersion}).";
        _snapshots = await Api.SnapshotsAsync(ProjectId);
    }

    private RenderFragment Snapshots() => __builder =>
    {
        <details class="fqs-card fqs-snapshots" data-testid="fqs-snapshots">
            <summary>Frozen scope snapshots (@_snapshots.Count)</summary>
            <ul>
                @foreach (var s in _snapshots)
                {
                    <li data-testid="fqs-snapshot-row">@s.ScopeName v@(s.ScopeVersion) · @s.ItemCount items · @s.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                        <span class="fqs-muted fqs-small">@s.RuleSetVersion</span></li>
                }
            </ul>
            <a href="snapshots?module=functional-scope-snapshot" class="fqs-link">Open in Snapshots</a>
        </details>
    };

    // ── Lazy detail and test-design assessment ──────────────────────────────────────────────────────────────────────

    private async Task OpenDetail(string key, string? keepTest = null)
    {
        var generation = ++_detailGeneration;
        _detailLoading = true;
        var detail = await Api.DetailAsync(ProjectId, key, _environment ?? AppliedEnvironment);
        // A later selection wins over a slower earlier request: never show the details of an item that is no longer selected.
        if (generation != _detailGeneration) return;
        _detailLoading = false;
        if (detail is null) { _error = "The item could not be loaded."; return; }
        (_detail, _fullText, _selectedTest, _history) = (detail, false, keepTest is not null && detail.Tests.Any(t => t.RelationKey == keepTest) ? keepTest : null, []);
        _assessment = _detail.Assessment ?? new TestDesignAssessmentView(key, TestabilityClassification.Unclassified, [], [], null, null);
        _assessmentData = string.Join(", ", _assessment.RequiredTestDataAssetIds);
        if (_selectedTest is not null) await LoadHistoryAsync();
        WriteUrl();
    }

    private void CloseDetail() { (_detail, _selectedTest) = (null, null); WriteUrl(); }

    private async Task SelectTest(ScopeTestLink test)
    {
        _selectedTest = test.RelationKey;
        _history = [];
        await LoadHistoryAsync();
    }

    private async Task LoadHistoryAsync()
    {
        if (Review is not { } review || _detail?.Tests.FirstOrDefault(t => t.RelationKey == _selectedTest) is not { } test) return;
        (_history, _) = await review.DecisionsAsync(test.Scope, test.RelationKey);
    }

    /// <summary>A decision goes to the shared canonical review registry (the same one Correlation Review uses); the item is then re-read, so coverage and
    /// the test's classification come from the registry — a rejected candidate never comes back as confirmed.</summary>
    private async Task DecideAsync(ScopeTestLink test, ReviewDecisionOutcome outcome)
    {
        if (Review is not { } review || _detail is not { } d) return;
        _deciding = true;
        var (decision, error) = await review.DecideAsync(test.Scope, new ReviewDecisionRequest(ReviewTargetKind.Relation, test.RelationKey, outcome));
        _deciding = false;
        if (decision is null) { _error = error ?? "The decision could not be recorded."; return; }
        _notice = $"Recorded: {outcome} for {test.TestName}.";
        await OpenDetail(d.Item.Key, test.RelationKey);
        await ResolveAsync();
    }

    private RenderFragment Detail(ScopeItemDetail d) => __builder =>
    {
        var item = d.Item;
        var parent = item.ParentKey is { } pk ? _resolution?.Items.FirstOrDefault(i => i.Key == pk) : null;
        <aside class="fqs-detail" aria-labelledby="fqs-detail-title" data-testid="fqs-detail" data-key="@item.Key">
            <header class="fqs-detail-head">
                <div>
                    <p class="fqs-kicker" data-testid="fqs-detail-kicker">@T.TypeLabel(item.Type) · @item.Module / @item.FeatureKey</p>
                    <h3 id="fqs-detail-title" class="fqs-h3">@item.DisplayId — @item.Title</h3>
                </div>
                <button type="button" class="btn-secondary fqs-small-btn" data-testid="fqs-detail-close" @onclick="CloseDetail">Back to list</button>
            </header>
            @if (_selectedTest is not null && d.Tests.FirstOrDefault(t => t.RelationKey == _selectedTest) is { } test)
            {
                @TestDetail(d, test)
            }
            else
            {
                <details class="fqs-section" open data-testid="fqs-sec-overview">
                    <summary>Overview</summary>
                    <p class="fqs-detail-text @(_fullText || d.FullText.Length <= 320 ? "" : "is-clamped")" data-testid="fqs-full-text">@d.FullText</p>
                    @if (d.FullText.Length > 320)
                    {
                        <button type="button" class="btn-link" aria-expanded="@(_fullText ? "true" : "false")" data-testid="fqs-expand-text" @onclick="() => _fullText = !_fullText">@(_fullText ? "Show less" : "Show full description")</button>
                    }
                    <dl class="fqs-facts">
                        <div><dt>Feature</dt><dd>@item.Module / @item.FeatureKey — @item.FeatureTitle</dd></div>
                        <div><dt>Quality</dt><dd>@FunctionalQualityClassifier.Label(item.Category) <span class="fqs-muted">(rule @item.CategoryRule)</span></dd></div>
                        @if (item.Priority is { Length: > 0 } priority) { <div><dt>Priority</dt><dd>@priority</dd></div> }
                        <div><dt>Why included</dt><dd>@T.RelationLabel(item.Relation) — @item.Reason</dd></div>
                        <div><dt>Coverage</dt><dd><SemanticStatusBadge Status="@P.CoverageStatus(item.Coverage)" QualifiedLabel="@T.CoverageLabel(item.Coverage)" Explanation="@item.CoverageDetail" />
                            @if (d.CoverageEvidence.Count > 0) { <span class="fqs-muted"> @string.Join(" ", d.CoverageEvidence)</span> }</dd></div>
                        @if (P.SourceRef(item) is { Length: > 0 } source) { <div><dt>Source</dt><dd><code>@source</code></dd></div> }
                        <div><dt>Stable key</dt><dd><code>@item.Key</code></dd></div>
                    </dl>
                </details>
                @if (d.Children.Count > 0)
                {
                    <details class="fqs-section" open data-testid="fqs-sec-criteria">
                        <summary>Acceptance criteria (@d.Children.Count)</summary>
                        <ul class="fqs-children">
                            @foreach (var c in d.Children)
                            {
                                <li data-testid="fqs-child"><button type="button" class="btn-link" @onclick="() => OpenDetail(c.Key)" data-testid="fqs-child-open">@c.DisplayId</button> — @c.Title
                                    <SemanticStatusBadge Status="@P.CoverageStatus(c.Coverage)" QualifiedLabel="@T.CoverageLabel(c.Coverage)" /></li>
                            }
                        </ul>
                    </details>
                }
                <details class="fqs-section" open data-testid="fqs-sec-tests">
                    <summary>Tests @(d.TestsAssessed ? $"({d.Tests.Count(t => t.Kind == ScopeTestLinkKind.Explicit)} explicit · {d.Tests.Count(t => t.Kind == ScopeTestLinkKind.Candidate)} candidate)" : "· not assessed")</summary>
                    @Tests(d)
                </details>
                <details class="fqs-section" open="@(d.Schemas.Any(s => s.Kind != ScopeSchemaLinkKind.Candidate))" data-testid="fqs-sec-schemas">
                    <summary>Schemas &amp; contracts @(d.SchemasAssessed ? $"({d.Schemas.Count(s => s.Kind != ScopeSchemaLinkKind.Candidate)} linked · {d.Schemas.Count(s => s.Kind == ScopeSchemaLinkKind.Candidate)} candidate)" : "· not assessed")</summary>
                    @Schemas(d)
                </details>
                <details class="fqs-section" data-testid="fqs-sec-testdata">
                    <summary>Test Data · @T.TestDataLabel(item.TestData)</summary>
                    @if (_assessment is { RequiredTestDataAssetIds.Count: > 0 } withData)
                    {
                        <ul class="fqs-children" data-testid="fqs-testdata-assets">
                            @foreach (var asset in withData.RequiredTestDataAssetIds) { <li><a href="@($"test-data?asset={Uri.EscapeDataString(asset)}")"><code>@asset</code></a></li> }
                        </ul>
                    }
                    else { <p class="fqs-muted" data-testid="fqs-testdata-none">No Test Data asset is linked to this item. No schema or validation result is claimed without one.</p> }
                </details>
                <details class="fqs-section" data-testid="fqs-sec-relationships">
                    <summary>Relationships</summary>
                    <dl class="fqs-facts">
                        <div><dt>Feature</dt><dd>@item.Module / @item.FeatureKey — @item.FeatureTitle</dd></div>
                        @if (parent is not null) { <div><dt>Parent</dt><dd><button type="button" class="btn-link" data-testid="fqs-parent-open" @onclick="() => OpenDetail(parent.Key)">@parent.DisplayId — @parent.Title</button></dd></div> }
                    </dl>
                    <nav class="fqs-links" aria-label="Related views">
                        <a href="artifact-traceability?q=@Uri.EscapeDataString(item.DisplayId)" data-testid="fqs-link-traceability">Traceability</a>
                        <a href="test-coverage-review?q=@Uri.EscapeDataString(item.DisplayId)" data-testid="fqs-link-coverage">Test coverage</a>
                        <a href="correlation-review" data-testid="fqs-link-correlation">Correlation Review</a>
                        <a href="test-data" data-testid="fqs-link-testdata">Test Data</a>
                    </nav>
                </details>
                @if (_assessment is { } a)
                {
                    <details class="fqs-section" data-testid="fqs-sec-review">
                        <summary>Review · test design@(a.ReviewedAt is null ? "" : " · saved")</summary>
                        <form class="fqs-assessment" data-testid="fqs-assessment" @onsubmit="SaveAssessment" @onsubmit:preventDefault>
                            <label class="fqs-field"><span>Testability</span>
                                <select data-testid="fqs-testability" @onchange="e => _assessment = a with { Testability = Parse<TestabilityClassification>(e) ?? TestabilityClassification.Unclassified }">
                                    @foreach (var t in Enum.GetValues<TestabilityClassification>()) { <option value="@t" selected="@(a.Testability == t)">@T.TestabilityLabel(t)</option> }
                                </select>
                            </label>
                            <fieldset class="fqs-toggle"><legend>Verification</legend>
                                @foreach (var v in P.VerificationTypes)
                                {
                                    <label><input type="checkbox" checked="@a.VerificationTypes.Contains(v)" @onchange="() => ToggleVerification(v)" /> @v</label>
                                }
                            </fieldset>
                            <label class="fqs-field"><span>Required Test Data (stable asset ids, comma-separated)</span>
                                <input data-testid="fqs-required-data" @bind="_assessmentData" placeholder="td-…" /></label>
                            <label class="fqs-field"><span>Comment</span><input data-testid="fqs-assessment-comment" value="@a.Comment" @onchange="e => _assessment = a with { Comment = e.Value?.ToString() }" maxlength="2000" /></label>
                            <div class="fqs-actions"><button type="submit" class="btn-primary" data-testid="fqs-assessment-save">Save test design</button>
                                @if (a.ReviewedAt is { } at) { <span class="fqs-muted fqs-small">Last saved @at.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span> }</div>
                        </form>
                    </details>
                }
            }
        </aside>
    };

    private string? DetailEnvironment(ScopeItemDetail d) => d.Evidence is { CrossEnvironment: true } ? ScopeEnvironments.All : d.Evidence?.Environment;

    private TestExecutionSummary Execution(ScopeItemDetail d, ScopeTestLink t)
    {
        var env = DetailEnvironment(d);
        return RequirementTestExecutions.For(t, Lifecycle, env == ScopeEnvironments.All ? null : env, env is null || env == ScopeEnvironments.All ? null : ScopeFilterState.EnvironmentName(env, _environmentNames),
            env == ScopeEnvironments.All);
    }

    /// <summary>Schemas and contracts associated with the item: explicit and confirmed apart from candidates, each with its source, relationship and
    /// validation state. An existing schema is never shown as a validation.</summary>
    private RenderFragment Schemas(ScopeItemDetail d) => __builder =>
    {
        if (!d.SchemasAssessed)
        {
            <p class="fqs-muted" data-testid="fqs-schemas-not-assessed">Schema unavailable: no contract evidence is interpreted for @ScopeFilterState.EnvironmentName(DetailEnvironment(d), _environmentNames), so nothing can be said about this item's schemas — not "none".</p>
            return;
        }
        var linked = d.Schemas.Where(s => s.Kind != ScopeSchemaLinkKind.Candidate).ToList();
        var candidates = d.Schemas.Where(s => s.Kind == ScopeSchemaLinkKind.Candidate).ToList();
        <h4 class="fqs-h4">Linked schemas (@linked.Count)</h4>
        @if (linked.Count == 0) { <p class="fqs-muted" data-testid="fqs-schemas-none">No schema is linked to this item: it names no contract and no canonical relation links one.@(candidates.Count > 0 ? " The candidates below are suggestions from module ownership only." : "")</p> }
        else { <ul class="fqs-tests" data-testid="fqs-schemas-linked">@foreach (var s in linked) { @SchemaRow(s) }</ul> }
        @if (candidates.Count > 0)
        {
            <details class="fqs-rejected" data-testid="fqs-schemas-candidates"><summary>Candidate associations (@candidates.Count) — same module, not confirmed</summary>
                <ul class="fqs-tests">@foreach (var s in candidates) { @SchemaRow(s) }</ul>
            </details>
        }
        <p class="fqs-muted fqs-small">Validation: an existing schema is not a validation result — only a recorded validation run would show as validated.</p>
    };

    private RenderFragment SchemaRow(ScopeSchemaLink s) => __builder =>
    {
        <li class="fqs-test fqs-schema" data-testid="fqs-schema" data-kind="@s.Kind" data-schema-kind="@s.SchemaKind">
            <div>
                <strong data-testid="fqs-schema-name">@s.Name</strong> <MetaBadge Kind="BadgeKind.Type" Text="@ScopeFilterState.SchemaTypeLabel(s.SchemaKind)" />
                <MetaBadge Kind="BadgeKind.Provenance" Text="@ScopeFilterState.SchemaKindLabel(s.Kind)" TestId="fqs-schema-kind" />
                <SemanticStatusBadge Status="@(s.Validation == ScopeSchemaValidation.ServerValidated ? SemanticStatus.Validated : SemanticStatus.NotRun)"
                    QualifiedLabel="@(s.Validation == ScopeSchemaValidation.ServerValidated ? "Server-validated" : "Validation not performed")" Explanation="@s.ValidationDetail" TestId="fqs-schema-validation" />
            </div>
            <dl class="fqs-facts fqs-small">
                <div><dt>Identity</dt><dd><code data-testid="fqs-schema-identity">@s.ContractIdentity</code></dd></div>
                @if (s.Namespace is { Length: > 0 } ns) { <div><dt>Namespace</dt><dd><code>@ns</code></dd></div> }
                @if (s.Version is { Length: > 0 } version) { <div><dt>Version</dt><dd>@version</dd></div> }
                <div><dt>Source</dt><dd data-testid="fqs-schema-source">@(s.SourcePath is { } path ? path : "Not recorded")@(s.Package is { } pkg ? $" · package {pkg}" : "")@(s.SnapshotId is { } snap ? $" · snapshot {snap.ToString()[..8]}" : "")</dd></div>
                <div><dt>Relationship</dt><dd data-testid="fqs-schema-relationship">@s.Relationship · <code>@s.RuleId</code> · @s.Confidence</dd></div>
                <div><dt>Why</dt><dd>@s.Explanation</dd></div>
                <div><dt>Environment</dt><dd>@ScopeFilterState.EnvironmentName(s.Scope, _environmentNames)</dd></div>
            </dl>
            @if (ScopeFilterState.SchemaHref(s) is { } href) { <a href="@href" class="fqs-link" data-testid="fqs-schema-open">Open @(s.SchemaKind is "XmlSchema" or "JsonSchema" ? "in Schema Studio" : "the contract evidence")</a> }
            else { <span class="fqs-muted fqs-small">No stored source to open.</span> }
        </li>
    };

    /// <summary>Explicit links, candidates and rejected candidates apart. Without an interpretation the absence of tests means "not assessed".</summary>
    private RenderFragment Tests(ScopeItemDetail d) => __builder =>
    {
        if (!d.TestsAssessed)
        {
            <p class="fqs-muted" data-testid="fqs-tests-not-assessed">Not assessed@(d.Evidence is { Applied: false, Available.Count: > 1 } ? ": choose an evidence environment above — evidence from one environment never answers for another" : $": no canonical test interpretation exists for {ScopeFilterState.EnvironmentName(DetailEnvironment(d), _environmentNames)}, so the absence of tests here does not mean the item is untested. Interpret the Source Analysis snapshots in Correlation Review").</p>
            <p><a href="correlation-review">Correlation Review</a></p>
            return;
        }
        if (d.Evidence is { CrossEnvironment: true }) { <p class="fqs-limit" data-testid="fqs-tests-cross-env">All environments, aggregated: each test shows its own environment. This list is not evidence from one environment.</p> }
        var withRuns = d.Tests.Where(t => t.Kind != ScopeTestLinkKind.Rejected).Select(t => Execution(d, t)).ToList();
        <p class="fqs-muted fqs-small" data-testid="fqs-tests-execution-summary">
            Execution in @ScopeFilterState.EnvironmentName(DetailEnvironment(d), _environmentNames):
            @if (withRuns.Count == 0 || withRuns.All(x => x.State == RequirementTestExecutionState.Unavailable)) { <span>execution evidence unavailable — no test results (TRX) are imported in this workspace. <a href="implementation-review">Import test results</a></span> }
            else { <span>@string.Join(" · ", withRuns.GroupBy(x => x.Label).OrderBy(g => g.Key).Select(g => $"{g.Count()} {g.Key.ToLowerInvariant()}"))</span> }
        </p>
        var explicitTests = d.Tests.Where(t => t.Kind == ScopeTestLinkKind.Explicit).ToList();
        var candidates = d.Tests.Where(t => t.Kind == ScopeTestLinkKind.Candidate).ToList();
        var rejected = d.Tests.Where(t => t.Kind == ScopeTestLinkKind.Rejected).ToList();
        <h4 class="fqs-h4">Explicitly linked tests (@explicitTests.Count)</h4>
        @if (explicitTests.Count == 0)
        {
            <p class="fqs-muted" data-testid="fqs-tests-none">No confirmed test relationships found. @(candidates.Count > 0 ? $"{candidates.Count} candidate test{(candidates.Count == 1 ? "" : "s")} below need{(candidates.Count == 1 ? "s" : "")} review before it counts." : "No candidate tests either.")</p>
        }
        else { <ul class="fqs-tests" data-testid="fqs-tests-explicit">@foreach (var t in explicitTests) { @TestRow(t) }</ul> }
        <h4 class="fqs-h4">Candidate tests (@candidates.Count)</h4>
        @if (candidates.Count == 0) { <p class="fqs-muted" data-testid="fqs-tests-no-candidates">No candidate test relationships.</p> }
        else { <ul class="fqs-tests" data-testid="fqs-tests-candidates">@foreach (var t in candidates) { @TestRow(t) }</ul> }
        @if (rejected.Count > 0)
        {
            <details class="fqs-rejected" data-testid="fqs-tests-rejected"><summary>Rejected in review (@rejected.Count) — not coverage</summary>
                <ul class="fqs-tests">@foreach (var t in rejected) { @TestRow(t) }</ul>
            </details>
        }
    };

    private RenderFragment TestRow(ScopeTestLink t) => __builder =>
    {
        var run = _detail is { } d && t.Kind != ScopeTestLinkKind.Rejected ? Execution(d, t) : null;
        <li class="fqs-test" data-testid="fqs-test" data-kind="@t.Kind">
            <button type="button" class="fqs-title" data-testid="fqs-test-open" @onclick="() => SelectTest(t)" title="@t.TestIdentity">@t.TestName</button>
            <MetaBadge Kind="BadgeKind.Type" Text="@ScopeFilterState.LinkLabel(t)" TestId="fqs-test-kind" />
            @if (run is not null)
            {
                <SemanticStatusBadge Status="@(run.Current is { } c ? RequirementTestExecutions.Status(c.Outcome) : run.State == RequirementTestExecutionState.NotExecuted ? SemanticStatus.NotRun : SemanticStatus.Unavailable)"
                    QualifiedLabel="@run.Label" Explanation="@run.Text" TestId="fqs-test-run" />
            }
            @if (_resolution?.Evidence is { CrossEnvironment: true }) { <span class="fqs-muted fqs-small" data-testid="fqs-test-env">@ScopeFilterState.EnvironmentName(t.Scope, _environmentNames)</span> }
            @if (t.Location is { } location) { <span class="fqs-muted fqs-small"><code>@location</code></span> }
        </li>
    };

    private RenderFragment TestDetail(ScopeItemDetail d, ScopeTestLink t) => __builder =>
    {
        <section class="fqs-test-detail" data-testid="fqs-test-detail" data-kind="@t.Kind">
            <button type="button" class="btn-link" data-testid="fqs-test-back" @onclick="() => { _selectedTest = null; }">← Back to @d.Item.DisplayId</button>
            <h4 class="fqs-h4" data-testid="fqs-test-name">@t.TestName</h4>
            <dl class="fqs-facts">
                <div><dt>Relationship</dt><dd data-testid="fqs-test-relationship">@ScopeFilterState.LinkLabel(t) · Test → VERIFIES → @d.Item.DisplayId</dd></div>
                <div><dt>Evidence kind</dt><dd data-testid="fqs-test-evidence-kind">Source relationship (test discovered in the source interpreted for @ScopeFilterState.EnvironmentName(t.Scope, _environmentNames)) — discovery, not execution</dd></div>
                <div><dt>Test identity</dt><dd><code data-testid="fqs-test-identity">@t.TestIdentity</code></dd></div>
                <div><dt>Source location</dt><dd data-testid="fqs-test-location">@(t.Location ?? "Not recorded in the interpretation")</dd></div>
                <div><dt>Mapping rule</dt><dd><code>@(t.RuleId.Length > 0 ? t.RuleId : "—")</code> · @t.Resolution@(t.Confidence.Length > 0 ? $" · {t.Confidence}" : "")</dd></div>
                <div><dt>Review state</dt><dd data-testid="fqs-test-review-state">@t.ReviewState</dd></div>
            </dl>
            @ExecutionDetail(d, t)
            @if (t.Explanation.Length > 0) { <p data-testid="fqs-test-explanation">@t.Explanation</p> }
            <h5 class="fqs-h5">Relationship evidence</h5>
            @if (t.Evidence.Count == 0) { <p class="fqs-muted">No evidence items recorded for this relation.</p> }
            else
            {
                <ul class="fqs-children" data-testid="fqs-test-evidence">
                    @foreach (var e in t.Evidence) { <li><strong>@e.Kind</strong> <code>@e.Reference</code>@(e.Detail is { } detail ? $" — {detail}" : "")</li> }
                </ul>
            }
            <h5 class="fqs-h5">Review</h5>
            @if (Review is null)
            {
                <p class="fqs-muted" data-testid="fqs-review-readonly">Read-only here: review decisions are recorded in <a href="correlation-review">Correlation Review</a>.</p>
            }
            else
            {
                <div class="fqs-actions" data-testid="fqs-review-actions">
                    <button type="button" class="btn-secondary fqs-small-btn" disabled="@_deciding" data-testid="fqs-review-confirm" @onclick="() => DecideAsync(t, ReviewDecisionOutcome.Confirmed)">Confirm</button>
                    <button type="button" class="btn-secondary fqs-small-btn" disabled="@_deciding" data-testid="fqs-review-reject" @onclick="() => DecideAsync(t, ReviewDecisionOutcome.Rejected)">Reject</button>
                    <button type="button" class="btn-secondary fqs-small-btn" disabled="@_deciding" data-testid="fqs-review-defer" @onclick="() => DecideAsync(t, ReviewDecisionOutcome.Deferred)">Defer</button>
                </div>
                <p class="fqs-muted fqs-small">Recorded in the shared review registry (the same decisions Correlation Review shows).</p>
                @if (_history.Count > 0)
                {
                    <ol class="fqs-children" data-testid="fqs-review-history">
                        @foreach (var h in _history) { <li>@h.Outcome by @h.Reviewer · @h.DecidedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")@(h.Notes is { Length: > 0 } notes ? $" — {notes}" : "")</li> }
                    </ol>
                }
            }
        </section>
    };

    /// <summary>Execution of one linked test: the current result and why it was chosen, every run (with its run id, environment, time and source),
    /// runs elsewhere apart, and name-only matches as unattributed candidates.</summary>
    private RenderFragment ExecutionDetail(ScopeItemDetail d, ScopeTestLink t) => __builder =>
    {
        var x = Execution(d, t);
        <h5 class="fqs-h5">Execution</h5>
        <p data-testid="fqs-test-execution" data-state="@x.State">@x.Text</p>
        @if (t.Kind == ScopeTestLinkKind.Candidate && x.Runs.Count > 0) { <p class="fqs-limit" data-testid="fqs-test-candidate-runs">A candidate test's results do not count as this item's coverage until the link is confirmed.</p> }
        @if (x.Runs.Count > 0)
        {
            <p class="fqs-muted fqs-small" data-testid="fqs-test-selection-rule">@x.SelectionRule</p>
            @RunTable(x.Runs, "fqs-test-runs")
        }
        @if (x.OtherEnvironments.Count > 0)
        {
            <details class="fqs-rejected" data-testid="fqs-test-other-env"><summary>Runs in other environments or without a recorded environment (@x.OtherEnvironments.Count) — not counted here</summary>@RunTable(x.OtherEnvironments, "fqs-test-other-runs")</details>
        }
        @if (x.Unattributed.Count > 0)
        {
            <details class="fqs-rejected" data-testid="fqs-test-unattributed"><summary>Same test name, not correlated (@x.Unattributed.Count) — not attributed to this test</summary>
                <p class="fqs-muted fqs-small">These results name a test with the same name, but the import did not correlate them to this test's identity (ambiguous or unresolved). Their outcome is not this test's result. Confirm the correlation where the results were imported.</p>
                @RunTable(x.Unattributed, "fqs-test-unattributed-runs")
            </details>
        }
    };

    private RenderFragment RunTable(IReadOnlyList<TestRunResult> runs, string testId) => __builder =>
    {
        <div class="fqs-runs"><table class="fqs-run-table" data-testid="@testId">
            <thead><tr><th scope="col">Outcome</th><th scope="col">Run</th><th scope="col">Executed</th><th scope="col">Environment</th><th scope="col">Source</th></tr></thead>
            <tbody>
                @foreach (var r in runs)
                {
                    <tr data-testid="fqs-run-row" data-outcome="@r.Outcome" data-run="@r.RunId">
                        <td>@if (r.Attribution == TestExecutionAttribution.Identity) { <SemanticStatusBadge Status="@RequirementTestExecutions.Status(r.Outcome)" QualifiedLabel="@r.Outcome" Explanation="@r.Error" /> } else { <span>Not attributed <span class="fqs-muted">(reported @r.Outcome)</span></span> }
                            @if (r.Rows > 1) { <span class="fqs-muted fqs-small"> · @r.Rows rows</span> }
                            @if (r.Currentness != "Current") { <span class="fqs-muted fqs-small" title="@r.CurrentnessReason"> · @r.Currentness</span> }</td>
                        <td><code>@r.RunLabel</code>@if (r.ArtifactFile is { } file && file != r.RunLabel) { <br /><span class="fqs-muted fqs-small">@file</span> }</td>
                        <td>@(r.ExecutedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                        <td>@(r.EnvironmentRecorded ? ScopeFilterState.EnvironmentName(r.Environment, _environmentNames) : "Environment not recorded")</td>
                        <td class="fqs-small">@r.Basis@(r.Build is { } build ? $" · build {build}" : "")</td>
                    </tr>
                }
            </tbody>
        </table></div>
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            try { await JS.InvokeVoidAsync("birknextExplorer.stickyOffset"); }
            catch (Exception) { /* layout convenience only */ }
        if (!_scrollToSelected) return;
        _scrollToSelected = false;
        try { await JS.InvokeVoidAsync("birknextExplorer.selectedIntoView", _explorer, ".fqs-item.is-selected"); }
        catch (Exception) { /* scroll is a convenience */ }
    }

    private void ToggleVerification(string type)
    {
        if (_assessment is null) return;
        var list = _assessment.VerificationTypes.ToList();
        if (!list.Remove(type)) list.Add(type);
        _assessment = _assessment with { VerificationTypes = list };
    }

    private async Task SaveAssessment()
    {
        if (_assessment is null) return;
        var ids = _assessmentData.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        var (saved, error) = await Api.AssessAsync(ProjectId, _assessment with { RequiredTestDataAssetIds = ids });
        _error = error;
        if (saved is null) return;
        _assessment = saved;
        _notice = "Test design saved.";
        await ResolveAsync();
    }
}
