@using BirkNext.Integrations
@using BirkNext.Web.Services
@inject IIntegrationCatalogApiService Api
@inject IJSRuntime JS

@* Service Bus platform (a transport of its own — not an Event Hub), in separate sections: overview, declared (source-derived) topology,
   application messaging (Wolverine source findings), runtime access (configuration input + instance gate), runtime observations and the
   evaluation policy. "Run Service Bus review" is read-only: configuration and route comparison always, Azure Resource Manager GETs and
   Azure Monitor metrics only when runtime access is available. Nothing is sent, received, peeked, settled, created or changed. *@
<div class="sb" data-testid="sb">
    @{
        var topology = Platform.ServiceBusTopology;
        var declared = topology is { Entities.Count: > 0 };
        var access = ServiceBusPresentation.RuntimeAccess(Platform, AzureEnabled);
        var messaging = ServiceBusPresentation.Messaging(topology, Messaging);
        var counts = $"{topology?.Queues.Count() ?? 0} queues · {topology?.Topics.Count() ?? 0} topics · {topology?.Subscriptions.Count() ?? 0} subscriptions";
        var window = Platform.RuntimeEvidence?.ReviewWindowHours ?? IntegrationRuntimeEvidenceSettings.DefaultReviewWindowHours;
    }
    <dl class="sb-summary" data-testid="sb-summary">
        <div><dt>Namespace</dt><dd class="sb-mono" data-testid="sb-namespace">@(Platform.Namespace ?? "Not configured")</dd></div>
        <div><dt>Declared topology</dt><dd><span class="sb-badge sb-badge-@(declared ? "info" : "muted")" data-testid="sb-configuration">@(declared ? "Configured" : "Not configured")</span></dd></div>
        <div><dt>Queues</dt><dd data-testid="sb-queues">@(topology?.Queues.Count() ?? 0)</dd></div>
        <div><dt>Topics</dt><dd data-testid="sb-topics">@(topology?.Topics.Count() ?? 0)</dd></div>
        <div><dt>Subscriptions</dt><dd data-testid="sb-subscriptions">@(topology?.Subscriptions.Count() ?? 0)</dd></div>
        <div><dt>Application messaging source</dt><dd><span class="sb-badge sb-badge-@messaging.SourceTone" data-testid="sb-messaging-source">@messaging.Source</span></dd></div>
        <div><dt>Runtime access</dt><dd><span class="sb-badge sb-badge-@(access.Available ? "info" : "attention")" data-testid="sb-runtime">@access.Label</span></dd></div>
    </dl>
    <div class="sb-actions">
        <button type="button" class="btn-secondary" data-testid="sb-test" aria-label="@($"Run Service Bus review for {Platform.Name} (read-only)")" disabled="@_busy" @onclick="TestAsync">@(_busy ? "Reviewing Service Bus…" : "Run Service Bus review")</button>
    </div>
    <p class="sb-muted" data-testid="sb-review-scope">Read-only. Compares the declared topology with analyzed application routes@(access.Available ? " and reads Azure management metadata and metrics" : "; Azure metadata is not read while runtime access is not available"). Nothing is sent, received, peeked or changed.</p>
    <p class="sb-muted" role="status" aria-live="polite" data-testid="sb-status">@_status</p>

    <section class="sb-section" aria-labelledby="@($"{_id}-topology")" data-testid="sb-topology-source">
        <h4 id="@($"{_id}-topology")">Declared topology</h4>
        <dl class="sb-rows">
            <div><dt>State</dt><dd><span class="sb-badge sb-badge-@(declared ? "info" : "muted")">@(declared ? "Configured" : "Not configured")</span> <span data-testid="sb-topology-counts">@counts</span></dd></div>
            <div><dt>Source</dt><dd data-testid="sb-topology-provenance">@(topology?.Source is { Length: > 0 } source ? source : "Not recorded")</dd></div>
            @if (topology?.AuditedAt is { } audited) { <div><dt>Recorded</dt><dd data-testid="sb-topology-recorded">@audited.ToUniversalTime().ToString("yyyy-MM-dd")</dd></div> }
        </dl>
        <p class="sb-note" role="note" data-testid="sb-topology-boundary">Declared topology is the expected, source-derived topology — not proof of what is deployed. Runtime metadata, when available, may confirm or contradict it.</p>
        @if (topology is { Entities.Count: > 0 })
        {
            var rows = ServiceBusPresentation.TopicRows(topology);
            <ReviewDisclosure Text="Show topology" CollapseText="Hide topology" Hint="@counts" TestId="sb-topology" Class="disclosure-inline">
                <h5>Queues</h5>
                <div class="sb-tablewrap" tabindex="0" role="region" aria-label="Declared queues">
                    <table class="sb-table" data-testid="sb-queue-table">
                        <thead><tr><th scope="col">Queue</th><th scope="col">Publishers</th><th scope="col">Consumers</th><th scope="col">Expected properties</th></tr></thead>
                        <tbody>
                            @foreach (var queue in topology.Queues)
                            {
                                var (consumers, supporting) = ServiceBusPresentation.Consumers(queue, topology);
                                <tr data-testid="sb-queue" data-queue="@queue.Name">
                                    <th scope="row" class="sb-mono">@queue.Name</th>
                                    <td>@(queue.Publishers.Count == 0 ? "None configured" : string.Join(", ", queue.Publishers))</td>
                                    <td data-testid="sb-queue-consumers">@consumers@if (supporting is not null) { <span class="sb-cell sb-muted">@supporting</span> }</td>
                                    <td class="sb-expected" data-testid="sb-queue-expected">@ServiceBusPresentation.ExpectedCompact(queue)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (topology.NamespaceReceivers.Count > 0)
                {
                    <p class="sb-muted" data-testid="sb-namespace-receivers">Namespace-wide receive rights: @string.Join(", ", topology.NamespaceReceivers). A capability on every queue and subscription — not an entity-specific consumer mapping.</p>
                }
                <h5>Topics and subscriptions</h5>
                <div class="sb-tablewrap" tabindex="0" role="region" aria-label="Declared topics and subscriptions">
                    <table class="sb-table sb-topic-table" data-testid="sb-topic-table">
                        <thead><tr><th scope="col">Topic</th><th scope="col">Publisher</th><th scope="col">Subscription</th><th scope="col">Consumer</th><th scope="col">Expected properties</th><th scope="col">Mapping state</th></tr></thead>
                        @foreach (var row in rows)
                        {
                            var span = Math.Max(1, row.Subscriptions.Count);
                            <tbody data-testid="sb-topic" data-topic="@row.Topic.Name">
                                @if (row.Subscriptions.Count == 0)
                                {
                                    <tr>
                                        <th scope="row" class="sb-mono">@row.Topic.Name<span class="sb-cell sb-muted">@ServiceBusPresentation.ExpectedCompact(row.Topic)</span></th>
                                        <td>@(row.Topic.Publishers.Count == 0 ? "None configured" : string.Join(", ", row.Topic.Publishers))</td>
                                        <td>—</td><td>—</td><td>—</td>
                                        <td><span class="sb-badge sb-badge-muted" data-testid="sb-mapping-state">No subscription configured</span></td>
                                    </tr>
                                }
                                @for (var i = 0; i < row.Subscriptions.Count; i++)
                                {
                                    var sub = row.Subscriptions[i];
                                    <tr data-testid="sb-subscription" data-subscription="@sub.Subscription.Name">
                                        @if (i == 0)
                                        {
                                            <th scope="rowgroup" rowspan="@span" class="sb-mono">@row.Topic.Name<span class="sb-cell sb-muted">@ServiceBusPresentation.ExpectedCompact(row.Topic)</span></th>
                                            <td rowspan="@span">@(row.Topic.Publishers.Count == 0 ? "None configured" : string.Join(", ", row.Topic.Publishers))</td>
                                        }
                                        <td class="sb-mono">@sub.Subscription.Name</td>
                                        <td>@sub.Consumers@if (sub.Supporting is not null) { <span class="sb-cell sb-muted">@sub.Supporting</span> }</td>
                                        <td class="sb-expected">@ServiceBusPresentation.ExpectedCompact(sub.Subscription)</td>
                                        <td><span class="sb-badge sb-badge-@(sub.MappingState == "Configured" ? "info" : "muted")" data-testid="sb-mapping-state">@sub.MappingState</span></td>
                                    </tr>
                                }
                            </tbody>
                        }
                    </table>
                </div>
                <ReviewDisclosure Text="View exact properties" CollapseText="Hide exact properties" TestId="sb-exact" Class="disclosure-inline disclosure-small">
                    <div class="sb-tablewrap" tabindex="0" role="region" aria-label="Exact declared properties">
                        <table class="sb-table" data-testid="sb-exact-table">
                            <thead><tr><th scope="col">Entity</th><th scope="col">Type</th><th scope="col">Declared Azure properties</th></tr></thead>
                            <tbody>
                                @foreach (var entity in topology.Entities)
                                {
                                    var exact = ServiceBusPresentation.ExactProperties(entity);
                                    <tr><th scope="row" class="sb-mono">@entity.Path</th><td>@entity.EntityType</td>
                                        <td class="sb-mono">@(exact.Count == 0 ? "None declared" : string.Join(" · ", exact.Select(p => $"{p.Name} {p.Value}")))@if (entity.Note is { } note) { <span class="sb-cell sb-muted">@note</span> }</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </ReviewDisclosure>
            </ReviewDisclosure>
        }
        @if (topology is { Notes.Count: > 0 })
        {
            <ReviewDisclosure Text="Topology notes" CollapseText="Hide topology notes" Hint="@($"{topology.Notes.Count} note(s) from the source")" TestId="sb-topology-notes" Class="disclosure-inline disclosure-small">
                <ul class="sb-list" data-testid="sb-notes">@foreach (var note in topology.Notes) { <li>@note</li> }</ul>
            </ReviewDisclosure>
        }
    </section>

    <section class="sb-section" aria-labelledby="@($"{_id}-messaging")" data-testid="sb-messaging">
        <h4 id="@($"{_id}-messaging")">Application messaging</h4>
        <dl class="sb-rows">
            <div><dt>Source analysis</dt><dd><span class="sb-badge sb-badge-@messaging.SourceTone" data-testid="sb-messaging-analysis">@messaging.Source</span>@if (Messaging is null) { <span class="sb-muted"> Not analyzed is not evidence that Wolverine is absent.</span> }</dd></div>
            <div><dt>Wolverine routes</dt><dd><span class="sb-badge sb-badge-@messaging.RoutesTone" data-testid="sb-routes">@messaging.Routes</span>@if (Messaging is not null) { <span class="sb-muted"> Source findings, not executed handlers.</span> }</dd></div>
            <div><dt>Runtime processing</dt><dd><span class="sb-badge sb-badge-muted" data-testid="sb-messaging-runtime">Not assessed</span></dd></div>
        </dl>
        <p class="sb-note" role="note">Service Bus transport configuration does not prove that a Wolverine handler is configured or executed.</p>
        <div class="sb-actions"><button type="button" class="sb-link" data-testid="sb-analyze-messaging" @onclick="GoToMessagingAsync">@(Messaging is null ? "Analyze messaging source" : "Re-analyze messaging source")</button></div>
    </section>

    <section class="sb-section" aria-labelledby="@($"{_id}-access")" data-testid="sb-runtime-access">
        <h4 id="@($"{_id}-access")">Runtime access</h4>
        <div class="sb-state-row"><span class="sb-state-label">Status</span> <span class="sb-badge sb-badge-@(access.Available ? "info" : "attention")" data-testid="sb-access-status">@access.Label</span></div>
        <dl class="sb-rows">
            @if (access.Reasons.Count == 1) { <div><dt>Reason</dt><dd data-testid="sb-access-reason">@access.Reasons[0]</dd></div> }
            else if (access.Reasons.Count > 1) { <div><dt>Reasons</dt><dd><ul class="sb-list" data-testid="sb-access-reason">@foreach (var reason in access.Reasons) { <li>@reason</li> }</ul></dd></div> }
            <div><dt>Azure subscription</dt><dd data-testid="sb-access-subscription">@if (access.SubscriptionId is { } id) { <span class="sb-mono">@id</span> } else { <span class="sb-badge sb-badge-attention">Not configured</span> }</dd></div>
            <div><dt>Resource group</dt><dd class="sb-mono" data-testid="sb-access-rg">@(Platform.ResourceGroup ?? "Not configured")</dd></div>
            <div><dt>Namespace</dt><dd class="sb-mono" data-testid="sb-access-namespace">@(Platform.Namespace ?? "Not configured")</dd></div>
            @if (!access.Available)
            {
                <div><dt>Impact</dt><dd data-testid="sb-access-impact">BirkNext cannot currently verify the deployed: @string.Join(", ", ServiceBusPresentation.UnverifiedWithoutRuntime.Select(s => s.ToLowerInvariant())).</dd></div>
            }
        </dl>
        <div class="sb-actions"><button type="button" class="sb-link" data-testid="sb-configure-runtime" @onclick="OnConfigure">Configure Azure runtime access</button></div>
        @RuntimeEditor
        <ReviewDisclosure Text="Runtime access details" CollapseText="Hide runtime access details" TestId="sb-access-details" Class="disclosure-inline disclosure-small">
            <p class="sb-muted">Runtime access configuration (subscription, resource group, namespace) is an input, not evidence. With it, BirkNext reads Azure Resource Manager management metadata (GET only) and Azure Monitor metrics with the instance's Azure identity (Reader). No connection string, SAS or local authentication is used, and no message is sent, received or peeked.</p>
        </ReviewDisclosure>
    </section>

    <section class="sb-section" aria-labelledby="@($"{_id}-observations")" data-testid="sb-observations">
        <h4 id="@($"{_id}-observations")">Runtime observations</h4>
        <p class="sb-muted" data-testid="sb-observations-state">@(_result switch
        {
            null => access.Available ? "No runtime metadata collected yet. Run the Service Bus review to read it." : "No runtime metadata collected.",
            { Runtime.State: IntegrationEvidenceState.Available } => "Observed in the last review — see Azure runtime and operational evidence in the review result.",
            _ => $"No runtime metadata collected in the last review: {_result.Runtime?.Reason ?? "runtime metadata was not read."}",
        })</p>
    </section>

    <section class="sb-section" aria-labelledby="@($"{_id}-policy")" data-testid="sb-policy">
        <h4 id="@($"{_id}-policy")">Evaluation policy</h4>
        <dl class="sb-rows">
            <div><dt>Review window</dt><dd data-testid="sb-policy-window">@window h</dd></div>
            <div><dt>Message-count thresholds</dt><dd data-testid="sb-policy-thresholds">Not configured</dd></div>
        </dl>
        <p class="sb-muted" data-testid="sb-policy-semantics">Without thresholds, message counts are reported as Observed only — never judged Pass or Fail, and a missing count is never zero. The policy is not an evidence source.</p>
    </section>

    @if (_result is { } result)
    {
        var stale = ServiceBusPresentation.IsStale(result, DateTimeOffset.UtcNow);
        <section class="sb-result" tabindex="-1" @ref="_resultRef" aria-labelledby="sb-result-heading" data-testid="sb-result" data-state="@result.OverallState">
            <h4 id="sb-result-heading">Service Bus evidence <span class="sb-badge sb-badge-@ServiceBusPresentation.Tone(result.OverallState)" data-testid="sb-overall">@ServiceBusLabels.Overall(result.OverallState)</span>
                @if (stale) { <span class="sb-badge sb-badge-attention" data-testid="sb-stale">Stale</span> }</h4>
            <p class="sb-muted">Checked @result.CompletedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC · read-only; nothing was sent, received or changed.</p>

            <h5>Configuration</h5>
            <ul class="sb-list" data-testid="sb-result-configuration">
                @foreach (var item in result.Configuration.Where(c => c.CheckId != "sb-code-reference"))
                { <li><span class="sb-badge sb-badge-@ServiceBusPresentation.Tone(item.State)">@ServiceBusLabels.State(item.State)</span> @item.Title — @item.Detail</li> }
                @{ var routes = result.Routes.Where(r => r.Direction != nameof(MessagingRouteDirection.Reference)).ToList(); var (routeLabel, routeTone) = ServiceBusPresentation.RouteStatus(result); }
                <li data-testid="sb-result-route-status"><span class="sb-badge sb-badge-@routeTone">@routeLabel</span>
                    @if (result.RouteAnalysis == ServiceBusRouteAnalysis.NeedsReanalysis) { <text>Code routes: the application source was analyzed by an earlier version; re-analyze it (Integrations → Application messaging) to compare routes.</text> }
                    else if (result.RouteAnalysis == ServiceBusRouteAnalysis.NotAnalyzed) { <text>Code routes: no analyzed application source (Integrations → Application messaging).</text> }
                    else { <text>Code routes: @routes.Count(r => r.Configuration == ServiceBusCheckState.Matched) of @routes.Count match the configured topology@(routes.Any(r => r.Configuration == ServiceBusCheckState.NotAssessed) ? $"; {routes.Count(r => r.Configuration == ServiceBusCheckState.NotAssessed)} decided at runtime" : "").</text> }</li>
                @{ var unreferenced = result.Configuration.Where(c => c.CheckId == "sb-code-reference" && c.State == ServiceBusCheckState.NotReferenced).ToList(); }
                @if (unreferenced.Count > 0) { <li><span class="sb-badge sb-badge-attention">Not referenced</span> No code reference (possibly intentional): @string.Join(", ", unreferenced.Select(u => u.Entity)).</li> }
            </ul>

            <h5>Azure runtime</h5>
            @if (result.Runtime is not { State: IntegrationEvidenceState.Available } runtime)
            {
                <p data-testid="sb-result-runtime"><span class="sb-badge sb-badge-muted">@IntegrationReviewLabels.EvidenceState(result.Runtime?.State ?? IntegrationEvidenceState.NotConfigured)</span> @result.Runtime?.Reason</p>
            }
            else
            {
                <p class="sb-muted" data-testid="sb-result-provenance">Azure Resource Manager management metadata (GET only) · captured @runtime.CapturedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC</p>
                <ul class="sb-list" data-testid="sb-result-runtime">
                    <li><span class="sb-badge sb-badge-info">Observed</span> Namespace @runtime.Namespace (status @(runtime.NamespaceStatus ?? "not reported"), SKU @(runtime.Sku ?? "not reported"))</li>
                    @foreach (var type in new[] { ServiceBusEntityType.Queue, ServiceBusEntityType.Topic, ServiceBusEntityType.Subscription })
                    {
                        var (seen, missing, all) = ServiceBusPresentation.Entities(result, type);
                        <li><span class="sb-badge sb-badge-@(missing > 0 ? "fail" : "info")">@(missing > 0 ? "Not found" : "Observed")</span> @seen of @all @(type.ToString().ToLowerInvariant())s observed@(missing > 0 ? $"; not found: {string.Join(", ", result.RuntimeChecks.Where(c => c.CheckId == "sb-entity" && c.EntityType == type && c.State == ServiceBusCheckState.NotFound).Select(c => c.Entity))}" : "")</li>
                    }
                    @{ var mismatches = result.RuntimeChecks.Where(c => c.CheckId.StartsWith("sb-property-") && c.State == ServiceBusCheckState.Mismatch).ToList(); }
                    <li><span class="sb-badge sb-badge-@(mismatches.Count > 0 ? "fail" : "ready")">@(mismatches.Count > 0 ? "Mismatch" : "Pass")</span> Properties: @result.RuntimeChecks.Count(c => c.CheckId.StartsWith("sb-property-") && c.State == ServiceBusCheckState.Pass) match the expectation@(mismatches.Count > 0 ? $"; {string.Join("; ", mismatches.Select(m => $"{m.Title}: expected {m.Expected}, observed {m.Observed}"))}" : "")</li>
                </ul>
                var (active, dead, scheduled) = ServiceBusPresentation.Counts(result);
                <h5>Operational evidence</h5>
                <dl class="sb-summary" data-testid="sb-result-counts">
                    <div><dt>Active messages</dt><dd>Observed: @ServiceBusPresentation.Count(active)</dd></div>
                    <div><dt>Dead-letter messages</dt><dd>Observed: @ServiceBusPresentation.Count(dead)@if (dead > 0) { <span class="sb-badge sb-badge-attention">Dead-letter messages observed</span> }</dd></div>
                    <div><dt>Scheduled messages</dt><dd>Observed: @ServiceBusPresentation.Count(scheduled)</dd></div>
                </dl>
                <p class="sb-muted">Point-in-time counts with no configured threshold: zero is not a pass, and dead-letter messages are not judged a failure.</p>
            }

            <h5>Azure Monitor metrics</h5>
            @if (result.Metrics is { State: IntegrationEvidenceState.Available } metrics)
            {
                <p class="sb-muted" data-testid="sb-result-metrics-provenance">Azure Monitor platform metrics · last @metrics.WindowHours h · captured @metrics.CapturedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC</p>
                <dl class="sb-summary" data-testid="sb-result-metrics">
                    @foreach (var (label, metric, aggregation) in ServiceBusPresentation.MetricRows)
                    {
                        <div><dt>@label</dt><dd>Observed: @ServiceBusPresentation.Metric(metrics, metric, aggregation)@(metric == "ActiveMessages" ? $" / {ServiceBusPresentation.Metric(metrics, metric, "Maximum")}" : "")</dd></div>
                    }
                    <div><dt>Oldest-message age</dt><dd>Not available (not a Service Bus platform metric)</dd></div>
                </dl>
                <p class="sb-muted">Observed values with no configured threshold: zero errors or zero messages is not a pass, and non-zero values are not judged a failure.</p>
            }
            else
            {
                <p data-testid="sb-result-metrics"><span class="sb-badge sb-badge-muted">@IntegrationReviewLabels.EvidenceState(result.Metrics?.State ?? IntegrationEvidenceState.NotSupported)</span> @(result.Metrics?.Reason ?? "Azure Monitor metrics were not read in this run.")</p>
            }

            @if (result.Routes.Count > 0)
            {
                var shown = result.Routes.Where(r => r.Direction != nameof(MessagingRouteDirection.Reference) || r.Configuration != ServiceBusCheckState.Matched).ToList();
                <h5>Application messaging ↔ Service Bus</h5>
                <p class="sb-muted" data-testid="sb-route-summary">@shown.Count(r => r.Configuration == ServiceBusCheckState.Matched) matched · @shown.Count(r => r.Configuration == ServiceBusCheckState.Mismatch) mismatch · @shown.Count(r => r.Configuration == ServiceBusCheckState.NotAssessed) decided at runtime · handler execution not assessed</p>
                <ReviewDisclosure Text="@($"View {shown.Count} application route{(shown.Count == 1 ? "" : "s")}")" CollapseText="Hide application routes" TestId="sb-routes-detail" Class="disclosure-inline">
                <div class="sb-tablewrap" tabindex="0" role="region" aria-label="Application routes and Service Bus entities">
                    <table class="sb-table" data-testid="sb-result-routes">
                        <thead><tr><th scope="col">Application route</th><th scope="col">Entity</th><th scope="col">Configuration</th><th scope="col">Access</th><th scope="col">Runtime entity</th><th scope="col">Handler execution</th></tr></thead>
                        <tbody>
                            @foreach (var route in shown)
                            {
                                <tr data-testid="sb-route" data-configuration="@route.Configuration">
                                    <td>@route.Application · @route.Technology @route.Direction.ToLowerInvariant()@(route.MessageType is { } m ? $" {m}" : "")</td>
                                    <td><span class="sb-mono">@route.Entity</span><span class="sb-source">@route.EntitySource</span></td>
                                    <td><span class="sb-badge sb-badge-@ServiceBusPresentation.Tone(route.Configuration)">@ServiceBusLabels.State(route.Configuration)</span>@if (route.Configuration != ServiceBusCheckState.Matched) { <span class="sb-muted"> @route.Detail</span> }</td>
                                    <td><span class="sb-badge sb-badge-@ServiceBusPresentation.Tone(route.Access)">@ServiceBusLabels.State(route.Access)</span></td>
                                    <td><span class="sb-badge sb-badge-@ServiceBusPresentation.Tone(route.Runtime)">@ServiceBusLabels.State(route.Runtime)</span></td>
                                    <td><span class="sb-badge sb-badge-muted">Not assessed</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                </ReviewDisclosure>
                <p class="sb-muted">A matched route is configured infrastructure, not a message published or processed. Handler execution needs Application Insights evidence (Integration Quality Review).</p>
            }

            @if (result.Findings.Count > 0)
            {
                <h5>Findings</h5>
                <ul class="sb-list" data-testid="sb-result-findings">@foreach (var finding in result.Findings) { <li>@finding</li> }</ul>
            }
            <h5>What’s missing</h5>
            <ul class="sb-list" data-testid="sb-result-missing">@foreach (var item in result.Missing) { <li>@item</li> }</ul>
            @if (result.RuntimeChecks.Count > 0)
            {
                <ReviewDisclosure Text="Technical details" CollapseText="Hide technical details" TestId="sb-technical" Class="disclosure-inline">
                    <div class="sb-tablewrap" tabindex="0" role="region" aria-label="Service Bus runtime comparisons">
                        <table class="sb-table">
                            <thead><tr><th scope="col">Check</th><th scope="col">Expected</th><th scope="col">Observed</th><th scope="col">State</th></tr></thead>
                            <tbody>@foreach (var c in result.RuntimeChecks) { <tr><td class="sb-mono">@c.Title</td><td>@(c.Expected ?? "—")</td><td>@(c.Observed ?? "—")</td><td>@ServiceBusLabels.State(c.State)</td></tr> }</tbody>
                        </table>
                    </div>
                </ReviewDisclosure>
            }
        </section>
    }
</div>

@code {
    [Parameter, EditorRequired] public string EnvironmentId { get; set; } = "";
    [Parameter, EditorRequired] public IntegrationPlatform Platform { get; set; } = new();
    [Parameter] public ApplicationMessagingEvidenceSet? Messaging { get; set; }
    /// <summary>Opens the runtime access configuration (subscription, review window) — it never enables Azure execution itself.</summary>
    [Parameter] public EventCallback OnConfigure { get; set; }
    /// <summary>Whether this BirkNext instance may call Azure (IntegrationReview:Azure:Enabled).</summary>
    [Parameter] public bool AzureEnabled { get; set; }
    /// <summary>The runtime access form while it is edited (owned by the Integrations pane).</summary>
    [Parameter] public RenderFragment? RuntimeEditor { get; set; }

    /// <summary>The Application messaging upload input (ApplicationMessagingPanel) that "Analyze messaging source" moves focus to.</summary>
    public const string MessagingUploadId = "am-upload-input";
    private readonly string _id = "sb-" + Guid.NewGuid().ToString("N")[..8];

    private ServiceBusEvidenceCheck? _result;
    private bool _busy;
    private bool _focusResult;
    private string _status = "";
    private ElementReference _resultRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusResult) { _focusResult = false; await _resultRef.FocusAsync(); }
    }

    private async Task TestAsync()
    {
        _busy = true;
        _status = "Running the Service Bus review (read-only)…";
        try
        {
            _result = await Api.CheckServiceBusAsync(EnvironmentId, Platform.Id);
            _status = $"Service Bus evidence: {ServiceBusLabels.Overall(_result.OverallState)}. Nothing was changed.";
            _focusResult = true;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _status = "The Service Bus review could not run: the BirkNext backend did not answer. Nothing was changed.";
        }
        finally { _busy = false; }
    }

    /// <summary>The upload lives once, in Application messaging; this moves focus there instead of duplicating it.</summary>
    private async Task GoToMessagingAsync() => await JS.InvokeVoidAsync("birknextFocusElement", MessagingUploadId);
}
