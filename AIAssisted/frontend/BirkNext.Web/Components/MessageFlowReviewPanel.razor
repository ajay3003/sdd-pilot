@using BirkNext.Integrations
@using BirkNext.Web.Services
@inject IIntegrationCatalogApiService Api
@inject IServiceProvider Services

@* Integration Quality Review → Extensions: the message flow review and the Altinn provider configuration the Skolenærvær test pack uses.
   Provider-specific (Altinn, TT02 wording belongs here). Source evidence is never chosen here: the XML Schema comes from the snapshot bound to
   the report-intake integration in Integration Quality Review → Evidence (the canonical binding); this panel only names which schema in it. *@
<section class="mfr-panel" aria-labelledby="mfr-heading" data-testid="mfr-panel">
    <div class="mfr-heading-row">
        <div><h2 id="mfr-heading">Message flow review <span class="mfr-provider">Altinn provider</span></h2><p>Documented design, source evidence, configuration and runtime observations are shown as separate evidence stages. Used by the Skolenærvær test pack.</p></div>
        @if (_package is not null) { <span class="mfr-status">Active test: blocked</span> }
    </div>
    @if (string.IsNullOrWhiteSpace(EnvironmentId))
    {
        <p role="status">Select a Target Environment to review or configure a message flow.</p>
    }
    else if (_busy)
    {
        <p role="status">Loading message flow configuration…</p>
    }
    else if (_package is { } package)
    {
        @if (_documentedShown) { <p class="mfr-note" data-testid="mfr-documented-flow">Showing the test pack's documented flow. It is documentation evidence; nothing is saved until you save the review configuration.</p> }
        <div class="mfr-actions">
            <button type="button" class="btn-primary" data-testid="mfr-save" @onclick="SaveAsync" disabled="@_saving">@(_saving ? "Saving…" : "Save review configuration")</button>
            @if (_saved) { <span role="status" data-testid="mfr-saved">Saved</span> }
            @if (_error is not null)
            {
                <div role="alert" class="mfr-save-error" data-testid="mfr-save-error"><span>@_error</span>
                    @if (_fieldErrors.Count > 0)
                    {
                        <ul data-testid="mfr-save-error-fields">@foreach (var field in _fieldErrors) { <li data-testid="mfr-save-error-field" data-path="@field.Path"><strong>@field.Section → @field.Field:</strong> @field.Reason</li> }</ul>
                    }
                </div>
            }
        </div>
        <p class="mfr-note">Saved separately from Target Environment integration settings. Configuration is not verification; no messages are sent or consumed here.</p>
        @* Example loaders are developer/demo tools: a pack's documented flow is shown automatically, so testers never need them. *@
        <ReviewDisclosure Text="Developer tools" CollapseText="Hide developer tools" Hint="examples" TestId="mfr-developer-tools" Class="disclosure-inline">
            <div class="mfr-actions">
                <button type="button" class="btn-secondary" @onclick="LoadGeneric">Load generic example</button>
                <button type="button" class="btn-secondary" @onclick="LoadPilot">Load documented Skolenærvær pilot</button>
            </div>
            <p class="mfr-note">Replaces the flow and example configuration in this form (not saved until you save).</p>
        </ReviewDisclosure>
        @* One provider section at a time (hidden, never removed: every value stays bound and is saved as before). The readiness line stays
           visible; the full prerequisite list is the Readiness section. *@
        var counts = MessageFlowReadinessCounts.From(package.Readiness, KnownReadinessKeys());
        @* Known (resolvable now) ≠ saved for the active run (explicitly stored) ≠ runtime verified (observed): three counts, never one "configured". *@
        <dl class="mfr-counts" data-testid="mfr-readiness-line">
            <div><dt>Known configuration</dt><dd data-testid="mfr-count-known">@counts.Known of @counts.Total</dd></div>
            <div><dt>Saved for active run</dt><dd data-testid="mfr-count-saved">@counts.Saved of @counts.Total</dd></div>
            <div><dt>Runtime verified</dt><dd data-testid="mfr-count-verified">@counts.Verified of @counts.Total</dd></div>
            <div><dt>Active submission</dt><dd>@(package.Readiness.CanRunActiveTest ? "Can run" : "Blocked")
                @if (_section != "readiness") { <button type="button" class="mfr-link-button" @onclick='() => _section = "readiness"' data-testid="mfr-readiness-open">View readiness</button> }</dd></div>
        </dl>
        <nav class="mfr-subnav" aria-label="Altinn provider sections" data-testid="mfr-subnav">
            @foreach (var (key, label) in Sections)
            {
                <button type="button" class="mfr-subnav-item @(_section == key ? "mfr-subnav-active" : "")" aria-current="@(_section == key ? "true" : null)"
                        data-testid="@($"mfr-subnav-{key}")" @onclick="() => _section = key">@label</button>
            }
        </nav>
        <div class="mfr-view" data-testid="mfr-view-overview" hidden="@(_section != "overview")">
        <section class="mfr-card" aria-labelledby="mfr-flow-heading">
            <h3 id="mfr-flow-heading">Overview and flow</h3>
            <label>Flow name <input @bind="_name" /></label>
            <p>@package.Flow.Description</p>
            @if (package.Flow.Limitations.Count > 0) { <ul class="mfr-limitations">@foreach (var limitation in package.Flow.Limitations) { <li>@limitation</li> }</ul> }
            <details class="mfr-editor"><summary>Edit flow nodes and hops</summary>
                <div class="mfr-form">
                    <label>New node name<input @bind="_newNode" /></label>
                    <label>Role<select @bind="_newRole">@foreach (var role in Enum.GetValues<FlowNodeRole>()) { <option value="@role">@role</option> }</select></label>
                    <label>State owner<input @bind="_newOwner" /></label>
                    <button type="button" class="btn-secondary" @onclick="AddNode">Add node (Not assessed)</button>
                    <label>From<select @bind="_fromNode">@foreach (var node in package.Flow.Nodes) { <option value="@node.Id">@node.Name</option> }</select></label>
                    <label>To<select @bind="_toNode">@foreach (var node in package.Flow.Nodes) { <option value="@node.Id">@node.Name</option> }</select></label>
                    <label>Hop mechanism<input @bind="_mechanism" /></label>
                    <button type="button" class="btn-secondary" @onclick="AddHop" disabled="@(package.Flow.Nodes.Count < 2)">Add hop (Not assessed)</button>
                </div>
                <p>Manual entries are not source-confirmed until evidence is supplied; current editor records them as Not assessed.</p>
            </details>
            <ol class="mfr-flow">
                @foreach (var hop in package.Flow.Hops)
                {
                    var from = package.Flow.Nodes.FirstOrDefault(n => n.Id == hop.FromNodeId);
                    var to = package.Flow.Nodes.FirstOrDefault(n => n.Id == hop.ToNodeId);
                    <li><strong>@from?.Name → @to?.Name</strong><span>@hop.Mechanism</span><small>@hop.Evidence.State · owner: @to?.StateOwner</small>@if (hop.PayloadMode is FlowPayloadMode.Reference or FlowPayloadMode.EncryptedReference) { <small>Payload mode: @hop.PayloadMode. The broker may carry a reference, not business content.</small> }</li>
                }
            </ol>
            <p class="mfr-note">Documented or source-declared flows do not prove runtime delivery. Transport receipt, application receipt and business completion remain distinct.</p>
        </section>
            <section class="mfr-card" aria-labelledby="mfr-validate-heading"><h3 id="mfr-validate-heading">Validation and error paths</h3>
                @if (package.Flow.Validation.Count > 0) { <ul>@foreach (var v in package.Flow.Validation) { <li><strong>@v.Layer</strong> — @v.Outcome <small>(@v.Owner · @v.Evidence.State)</small></li> }</ul> }
                @foreach (var error in package.Flow.ErrorPaths) { <article class="mfr-error"><strong>@error.Condition</strong><span>Owner: @error.Owner</span><span>@error.ExpectedHandling</span><small>Retry: @Display(error.RetryPolicy) · Hold: @Display(error.HoldPolicy) · Dead-letter: @Display(error.DeadLetterPolicy)</small><small>Final state: @error.FinalState · @error.Evidence.State</small></article> }
                <details><summary>Add a documented error path</summary><div class="mfr-form"><label>Condition<input @bind="_errorCondition" /></label><label>State owner<input @bind="_errorOwner" /></label><label>Expected handling<input @bind="_errorHandling" /></label><label>Transport retry policy<input @bind="_retryPolicy" /></label><label>Domain hold policy<input @bind="_holdPolicy" /></label><label>Dead-letter policy<input @bind="_deadLetterPolicy" /></label><button type="button" class="btn-secondary" @onclick="AddErrorPath">Add error path</button></div></details>
            </section>
        </div>
        <div class="mfr-view" data-testid="mfr-view-readiness" hidden="@(_section != "readiness")">
            <section class="mfr-card mfr-readiness-card" aria-labelledby="mfr-readiness-heading" data-testid="mfr-readiness"><h3 id="mfr-readiness-heading">Altinn test readiness</h3>
                @{ var readinessCounts = MessageFlowReadinessCounts.From(package.Readiness, KnownReadinessKeys()); }
                <p data-testid="mfr-readiness-count"><strong>@readinessCounts.Saved of @readinessCounts.Total saved for the active run</strong> · @readinessCounts.Known known · @readinessCounts.Verified runtime verified.@(package.Readiness.CanRunActiveTest ? "" : " Active submission remains blocked.")</p>
                @{ var open = package.Readiness.Items.Where(item => !item.Satisfied).ToList(); }
                @if (open.Count > 0)
                {
                    <h4 class="mfr-subheading">Primary blockers</h4>
                    <ul class="mfr-blockers" data-testid="mfr-readiness-blockers">@foreach (var item in open.Take(3)) { <li><strong>@item.Label</strong> <span class="mfr-state">@item.State</span></li> }</ul>
                    @if (open.Count > 3) { <p class="mfr-note">@(open.Count - 3) more in the full list.</p> }
                }
                <p><a class="btn-secondary mfr-configure" href="#mfr-config-heading" @onclick="FocusConfigurationAsync" @onclick:preventDefault data-testid="mfr-configure-altinn">Configure Altinn</a></p>
                <ReviewDisclosure Text="@($"View all {package.Readiness.Total} prerequisites")" CollapseText="Hide prerequisites" TestId="mfr-readiness-all" Class="disclosure-inline">
                    <ul class="mfr-readiness">@foreach (var item in package.Readiness.Items) { <li data-testid="mfr-readiness-item" data-satisfied="@(item.Satisfied ? "true" : "false")"><span class="mfr-readiness-mark" aria-hidden="true">@(item.Satisfied ? "✓" : "○")</span><span class="mfr-readiness-text"><strong>@item.Label:</strong> @(item.Satisfied ? "Saved for active run" : KnownReadinessKeys().Contains(item.Key) ? "Known · not saved for active run" : "Needs attention") · @item.State <small>@item.Explanation</small></span></li> }</ul>
                </ReviewDisclosure>
                <p class="mfr-note">Implementation readiness: not source verified. QA configuration: not verified. Runtime: not observed.</p>
            </section>
        </div>
        <div class="mfr-view" data-testid="mfr-view-overview-details" hidden="@(_section != "overview")">
        <ReviewDisclosure Text="Flow details" CollapseText="Hide flow details" Hint="data handling, receipts, lifecycle, authority" TestId="mfr-flow-details" Class="mfr-disclosure">
        @if (package.Flow.DataHandling is { } handling)
        {
            <section class="mfr-card" aria-labelledby="mfr-data-heading"><h3 id="mfr-data-heading">Data handling</h3>
                <p><strong>Sensitive data entering:</strong> @Display(string.Join(", ", handling.SensitiveDataEntering))</p>
                <p><strong>Transit boundary:</strong> @handling.TransitBoundary</p><p><strong>Temporary persistence:</strong> @handling.TemporaryPersistence</p>
                <p><strong>Encryption:</strong> @handling.Encryption</p><p><strong>Forbidden destinations:</strong> @Display(string.Join(", ", handling.ForbiddenDestinations))</p>
                <p><strong>Cleanup expectation:</strong> @handling.CleanupExpectation</p><p>Evidence: @handling.Evidence.State. These are documented expectations, not source-verified controls.</p>
            </section>
        }
        @if (package.Flow.Receipts.Count > 0 || package.Flow.Deadlines.Count > 0)
        {
            <div class="mfr-grid">
                @if (package.Flow.Receipts.Count > 0) { <section class="mfr-card"><h3>Receipts</h3>@foreach (var receipt in package.Flow.Receipts) { <p><strong>@receipt.Kind:</strong> @receipt.Producer → @receipt.Consumer. @receipt.Trigger. Return path: @receipt.ReturnPath (@receipt.Evidence.State).</p> }</section> }
                @if (package.Flow.Deadlines.Count > 0) { <section class="mfr-card"><h3>Reporting lifecycle</h3>@foreach (var deadline in package.Flow.Deadlines) { <p><strong>@deadline.Name</strong> (@deadline.TimeZone): @deadline.Trigger. @deadline.Behavior (@deadline.Evidence.State)</p> }</section> }
            </div>
        }
        @if (package.Flow.AuthorityNotes.Count > 0)
        {
            <section class="mfr-card" aria-labelledby="mfr-authority-heading"><h3 id="mfr-authority-heading">Decision and artifact authority</h3><p>The task-provided consolidated Spec-Kit baseline is the pilot authority; older architecture assumptions below are superseded evidence, not current implementation findings.</p><ul>@foreach (var note in package.Flow.AuthorityNotes) { <li><strong>@note.Topic — @note.State.</strong> @note.Description <small>Source: @note.SourceReference. Superseded by: @note.SupersededBy</small></li> }</ul></section>
        }
        </ReviewDisclosure>
        </div>
        <div class="mfr-view" data-testid="mfr-view-configuration" hidden="@(_section != "configuration" && _section != "contracts")">
        <section class="mfr-card" aria-labelledby="mfr-config-heading" data-testid="mfr-config"><h3 id="mfr-config-heading" tabindex="-1">Altinn Test Configuration</h3>
            <p class="mfr-safe" data-testid="mfr-safe-warning"><strong>Safe references only.</strong> Never enter secrets, tokens, private keys, connection strings, message payloads or real personal data.</p>
            <div class="mfr-groups mfr-sections">
            <div hidden="@(_section != "configuration")" data-testid="mfr-configuration-sections">
            <ReviewDisclosure Text="Application" CollapseText="Application" Hint="@SectionHint(_environment != "Unknown", _product, _app, _submission != "Unknown", _baseUrl, _endpoint)" TestId="mfr-section-application" Class="mfr-section">
            <fieldset class="mfr-group" data-testid="mfr-group-application"><legend class="visually-hidden">Application</legend>
                @{ var applicationFields = ApplicationFields(); var knownFields = applicationFields.Where(item => item.Value is not null).ToList(); }
                <div class="mfr-known" data-testid="mfr-known">
                    <p><strong data-testid="mfr-known-count">@knownFields.Count of @applicationFields.Count known</strong> <span class="mfr-muted">· resolved once and reused by test packs; known values are not re-entered</span></p>
                    @if (knownFields.Count > 0)
                    {
                        <ul class="mfr-known-list">@foreach (var item in knownFields) { <li data-testid="mfr-known-item" data-field="@item.Field">@item.Field: <code>@item.Value</code> <span class="mfr-muted">· @item.Origin</span></li> }</ul>
                    }
                    @if (applicationFields.Where(item => item.Value is null).Select(item => item.Field).ToList() is { Count: > 0 } open)
                    {
                        <p data-testid="mfr-unresolved">Still to configure here: @string.Join(", ", open)</p>
                    }
                </div>
                <div class="mfr-form">
                <SourceValueHint Resolution="@Hint("Environment")" Origin="@HintOrigin("Environment")" Current="@(_environment == "Unknown" ? "" : _environment)" FieldLabel="Environment" OnUse="value => _environment = value" TestId="mfr-environment-suggestion" />
                <label>Environment<select @bind="_environment"><option value="Unknown">Needs verification</option><option value="Test">Test</option><option value="QualityAssurance">Quality assurance</option><option value="Staging">Staging</option><option value="Production">Production (active tests blocked)</option></select></label>
                <label>Altinn product / service type<input @bind="_product" /></label><label>App identifier<input @bind="_app" /></label>
                <SourceValueHint Resolution="@Hint("App identifier")" Origin="@HintOrigin("App identifier")" Current="@_app" FieldLabel="App identifier" OnUse="value => _app = value" TestId="mfr-app-suggestion" />
                <label>Submission mode<select @bind="_submission"><option value="Unknown">Needs verification</option>@foreach (var mode in Enum.GetValues<ExternalSubmissionMode>().Where(x => x != ExternalSubmissionMode.Unknown)) { <option value="@mode">@mode</option> }</select></label>
                <label>Safe base URL reference<input @bind="_baseUrl" /></label>
                <SourceValueHint Resolution="@Hint("Safe base URL reference")" Origin="@HintOrigin("Safe base URL reference")" Current="@_baseUrl" FieldLabel="Safe base URL reference" OnUse="value => _baseUrl = value" TestId="mfr-base-url-suggestion" />
                <label>Endpoint reference (URL without credentials/query)<input @bind="_endpoint" /></label>
                <SourceValueHint Resolution="@Hint("Endpoint reference")" Origin="@HintOrigin("Endpoint reference")" CanUse="@(!OwnedByIntegration("Endpoint reference"))" Current="@_endpoint" FieldLabel="Endpoint reference" OnUse="value => _endpoint = value" TestId="mfr-endpoint-suggestion" />
                @if (SafeEmptySuggestions.Count > 0)
                {
                    <p class="mfr-source-fill"><button type="button" class="btn-secondary" data-testid="mfr-use-source-values" @onclick="UseSourceValues">Use @SafeEmptySuggestions.Count safe source value@(SafeEmptySuggestions.Count == 1 ? "" : "s")</button>
                        <span class="mfr-muted"> Fills only empty fields from the bound source; nothing is saved until you save.</span></p>
                }
            </div></fieldset>
            </ReviewDisclosure>
            <ReviewDisclosure Text="Authentication" CollapseText="Authentication" Hint="@SectionHint(_auth != "Unknown", _client, _tenant, _documentedScopes, _scopes)" TestId="mfr-section-authentication" Class="mfr-section">
            <fieldset class="mfr-group" data-testid="mfr-group-authentication"><legend class="visually-hidden">Authentication</legend><div class="mfr-form">
                <label>Authentication type<select @bind="_auth"><option value="Unknown">Needs verification</option>@foreach (var auth in Enum.GetValues<ExternalAuthenticationType>().Where(x => x != ExternalAuthenticationType.Unknown)) { <option value="@auth">@auth</option> }</select></label>
                <label>Client / app reference<input @bind="_client" /></label><label>Tenant reference<input @bind="_tenant" /></label><label>Documented scopes (comma-separated)<input @bind="_documentedScopes" /></label><label>Configured scopes (comma-separated)<input @bind="_scopes" /></label>
                @if (UsesCertificate) { <label>Certificate reference<input @bind="_certificate" /></label><label>Key reference<input @bind="_key" /></label> }
            </div>
            <p class="mfr-note" data-testid="mfr-verified-scopes">Verified scopes: @(_package.AltinnConfiguration.VerifiedScopes.Count == 0 ? "None — no token verification has occurred. Configured scopes are not verified scopes." : string.Join(", ", _package.AltinnConfiguration.VerifiedScopes))</p></fieldset>
            </ReviewDisclosure>
            <ReviewDisclosure Text="Reporter &amp; Test Data" CollapseText="Reporter &amp; Test Data" Hint="@SectionHint(_reporterType, _reporter, _identitySet)" TestId="mfr-section-reporter" Class="mfr-section">
            <fieldset class="mfr-group" data-testid="mfr-group-reporter"><legend class="visually-hidden">Reporter &amp; test data</legend><div class="mfr-form">
                <label>Test reporter type<input @bind="_reporterType" /></label><label>Test reporter reference<input @bind="_reporter" /></label>
                <label>Approved synthetic identity-set reference<input @bind="_identitySet" /></label>
            </div>
            @* Attestations: the tester's own statement, recorded as such. Nothing here verifies the reporter's access or that the data is synthetic. *@
            <fieldset class="mfr-attestations" data-testid="mfr-attestations"><legend>Tester attestations <span class="mfr-attestation-state">Attested by user · not independently verified</span></legend>
                <label class="mfr-check"><input type="checkbox" @bind="_reporterApproved" data-testid="mfr-attest-reporter" /> I attest that reporter access is approved for this test</label>
                <label class="mfr-check"><input type="checkbox" @bind="_syntheticApproved" data-testid="mfr-attest-synthetic" /> I attest that the test data is approved synthetic data</label>
            </fieldset>
            <p class="mfr-note">Reusable test assets (synthetic reporters, identities and fixtures) come from <a href="/test-data">Test Data</a>, the one test-data catalog.</p></fieldset>
            </ReviewDisclosure>
            <ReviewDisclosure Text="Message transport" CollapseText="Message transport" Hint="@SectionHint(_channel, _messageType)" TestId="mfr-section-transport" Class="mfr-section">
            <fieldset class="mfr-group" data-testid="mfr-group-transport"><legend class="visually-hidden">Message transport</legend><div class="mfr-form">
                <label>MU channel reference<input @bind="_channel" /></label><label>Message type<input @bind="_messageType" /></label>
                @if (UsesBroker) { <label>Queue reference<input @bind="_queue" /></label><label>Payload store reference<input @bind="_payload" /></label> }
            </div></fieldset>
            </ReviewDisclosure>
            </div>
            <div hidden="@(_section != "contracts")" data-testid="mfr-contract-section">
            <ReviewDisclosure Text="Contracts &amp; correlation" CollapseText="Contracts &amp; correlation" Hint="@SectionHint(_contract, _version, _sourceContract)" TestId="mfr-section-contracts" Class="mfr-section">
            <fieldset class="mfr-group mfr-group-wide" data-testid="mfr-group-contracts"><legend class="visually-hidden">Contracts &amp; correlation</legend>
                <div class="mfr-source" data-testid="mfr-source-binding">
                    <strong>Source evidence</strong>
                    @if (_binding is { } binding)
                    {
                        <span data-testid="mfr-source-using">Using <span class="mfr-mono">@binding.ArchiveName</span> · analyzed @binding.AnalyzedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC · bound to @(_bindingIntegration ?? binding.IntegrationId) in Integration Quality Review → Evidence</span>
                        <a class="mfr-link" href="@($"source-analysis?snapshot={binding.SnapshotId}")" data-testid="mfr-source-open">Open evidence</a>
                        @if (_legacySnapshot is { } legacy && legacy != binding.SnapshotId) { <span class="mfr-review" role="note" data-testid="mfr-source-legacy">Review required: the saved schema was chosen in another snapshot. Choose the XML Schema again; nothing was reassigned automatically.</span> }
                    }
                    else if (_legacySnapshot is { } legacyOnly)
                    {
                        <span data-testid="mfr-source-legacy-only">Using a snapshot saved with this configuration earlier (@legacyOnly.ToString()[..8]…). Bind the report-intake integration's source evidence in Integration Quality Review → Evidence to make it the canonical evidence.</span>
                        <a class="mfr-link" href="integration-quality-review?view=evidence">Open Evidence</a>
                    }
                    else
                    {
                        <span data-testid="mfr-source-unbound">No source evidence is bound to the report-intake integration. Bind it in Integration Quality Review → Evidence; it is not selected here.</span>
                        @if (RequiredImportedSources.Count > 0) { <span data-testid="mfr-source-states">@string.Join(" · ", RequiredImportedSources.Select(SourceGuidancePresentation.SourceShort))</span> }
                        <a class="mfr-link" href="integration-quality-review?view=evidence" data-testid="mfr-source-bind">Open Evidence</a>
                    }
                </div>
                <div class="mfr-form">
                <label>Contract reference<input @bind="_contract" /></label><label>Contract version<input @bind="_version" /></label>
                @if (_sourceOptions is { } sourceOptions)
                {
                    <label>XML Schema contract from the bound snapshot<select value="@_sourceContract" @onchange="SourceContractChanged"><option value="">Select an XSD contract</option>@foreach (var contract in sourceOptions.Contracts) { <option value="@contract.Id">@contract.Name · @(contract.XmlSchema?.ExplicitVersion ?? contract.Version ?? "version not declared")</option> }</select></label>
                    @if (_sourceOptions.Contracts.FirstOrDefault(c => c.Id == _sourceContract) is { XmlSchema: { } schema } selectedContract)
                    {
                        <div class="mfr-schema" data-testid="mfr-xsd-evidence"><strong>@selectedContract.Name</strong><span>Snapshot @sourceOptions.SnapshotId · @sourceOptions.ArchiveName · @sourceOptions.Fingerprint</span><span>Evidence: SourceConfirmed from this exact Source Analysis snapshot · runtime: @selectedContract.RuntimeState</span><span>Namespace: @Display(schema.TargetNamespace)</span><span>Version: @(schema.ExplicitVersion ?? schema.VersionEvidence)</span><span>@schema.Elements.Count element(s), @schema.Attributes.Count attribute(s), @schema.Types.Count type(s), @schema.Dependencies.Count import/include(s)</span>
                            <details><summary>XML Schema structure and restrictions</summary><ul>@foreach (var element in schema.Elements) { <li><code>@element.QualifiedName</code> · path @element.Path · @element.Type · min @element.MinOccurs, max @element.MaxOccurs · nillable @element.Nillable · @string.Join(", ", element.Restrictions.Select(r => r.Facet + "=" + r.Value))</li> }</ul><ul>@foreach (var attr in schema.Attributes) { <li>Attribute <code>@attr.QualifiedName</code> · @attr.Type · use @attr.Use · @string.Join(", ", attr.Restrictions.Select(r => r.Facet + "=" + r.Value))</li> }</ul><ul>@foreach (var type in schema.Types) { <li>Type <code>@type.QualifiedName</code> · @type.Kind · base @type.BaseType · @string.Join(", ", type.Restrictions.Select(r => r.Facet + "=" + r.Value))</li> }</ul><ul>@foreach (var dependency in schema.Dependencies) { <li>@dependency.Kind · namespace @dependency.Namespace · @dependency.SchemaLocation · @(dependency.ResolvedInSnapshot ? "resolved in snapshot" : "unresolved dependency")</li> }</ul><p>@string.Join("; ", selectedContract.Limitations)</p></details>
                            <p>Source Analysis contract evidence is structured and snapshot-bound. This panel does not validate XML instances or business rules; schema validity does not prove business validity.</p>
                        </div>
                    }
                }
                </div>
                @if (_sourceOptions is { Contracts.Count: 0 }) { <p role="status">The bound snapshot has no parsed XML Schema contracts.</p> }
            </fieldset>
            </ReviewDisclosure>
            </div>
            </div>
            <div hidden="@(_section != "configuration")">
            <ReviewDisclosure Text="Advanced configuration" CollapseText="Hide advanced configuration" Hint="low-frequency references" TestId="mfr-advanced" Class="mfr-disclosure">
                <div class="mfr-form" data-testid="mfr-advanced-fields">
                @if (!UsesCertificate) { <label>Certificate reference<input @bind="_certificate" /></label><label>Key reference<input @bind="_key" /></label> }
                @if (!UsesBroker) { <label>Queue reference<input @bind="_queue" /></label><label>Payload store reference<input @bind="_payload" /></label> }
                <label>Receipt mode/reference<input @bind="_receipt" /></label><label>Checkpoint configuration reference<input @bind="_checkpoint" /></label><label>Correlation mapping reference<input @bind="_correlation" /></label>
                <label>Official documentation URLs/references (comma-separated)<input @bind="_documentation" /></label><label>Documentation platform/product<input @bind="_documentationPlatform" /></label><label>Documentation retrieved on<input type="date" @bind="_documentationRetrievedOn" /></label>
                </div>
                <p class="mfr-note">Shown here because they rarely apply to this configuration. Every value is saved as before.</p>
            </ReviewDisclosure>
            <p class="mfr-note">Configuration state and verification state are independent. Production is blocked by the backend for active execution; this release has no active submission provider.</p>
            </div>
        </section>
        </div>
        <div class="mfr-view" data-testid="mfr-view-checkpoints" hidden="@(_section != "checkpoints")">
        <ReviewDisclosure Text="Checkpoints" CollapseText="Hide checkpoints" Hint="@(package.Flow.Checkpoints.Count == 0 ? "none configured" : $"{package.Flow.Checkpoints.Count(c => c.ConfigurationStatus == FlowCheckpointConfigurationState.Configured)} of {package.Flow.Checkpoints.Count} observation sources configured · configured ≠ observed")" TestId="mfr-checkpoints" Class="mfr-disclosure">
            <section class="mfr-card" aria-labelledby="mfr-checkpoints-heading"><h3 id="mfr-checkpoints-heading">Checkpoints</h3><ol>@foreach (var checkpoint in package.Flow.Checkpoints) { <li class="mfr-checkpoint"><strong>@checkpoint.Name</strong><span>Configuration @checkpoint.ConfigurationStatus; runtime @checkpoint.RuntimeStatus.</span><label>Observation source<select value="@checkpoint.ProbeType" @onchange="e => SetCheckpointProbe(checkpoint.Id, e.Value?.ToString())"><option>Manual</option><option>Azure App Insights</option><option>Azure Monitor</option><option>Service API</option><option>Read-only DB</option><option>Queue metadata</option><option>Blob metadata</option><option>External platform status</option><option>Log query</option><option>Other</option></select></label><button type="button" class="btn-secondary" aria-pressed="@(checkpoint.ConfigurationStatus == FlowCheckpointConfigurationState.Configured)" @onclick="() => ToggleCheckpoint(checkpoint.Id)">@(checkpoint.ConfigurationStatus == FlowCheckpointConfigurationState.Configured ? "Mark observation source unconfigured" : "Mark observation source configured")</button></li> }</ol><p>Configured probe is not an observed checkpoint. Runtime status remains NotAssessed until evidence is captured.</p></section>
        </ReviewDisclosure>
        <ReviewDisclosure Text="Test plan" CollapseText="Hide test plan" Hint="@($"{package.TestCases.Count} case(s)")" TestId="mfr-test-plan" Class="mfr-disclosure">
            <section class="mfr-card" aria-labelledby="mfr-cases-heading"><h3 id="mfr-cases-heading">Test plan</h3>@foreach (var test in package.TestCases) { <details><summary>@test.Name</summary><p>@test.Purpose</p><p>Evidence basis: @test.EvidenceBasis</p><p>Preconditions: @string.Join("; ", test.Preconditions)</p><p>Expected: @string.Join("; ", test.ExpectedFlow)</p><p>Evidence: @string.Join("; ", test.EvidenceRequired)</p><p>@test.AutomationReadiness. @test.Limitations</p></details> }</section>
        </ReviewDisclosure>
        <ReviewDisclosure Text="Manual test procedure" CollapseText="Hide manual test procedure" Hint="@(package.ManualTestPlan.Count == 0 ? "not generated" : $"{package.ManualTestPlan.Count} step(s) · used until automation is available")" TestId="mfr-manual" Class="mfr-disclosure">
        <section class="mfr-card" aria-labelledby="mfr-manual-heading"><h3 id="mfr-manual-heading">Manual test procedure</h3><p>Generate a plan before automation is available. Unconfigured checkpoints remain not assessed, not failed.</p><ol>@foreach (var step in package.ManualTestPlan) { <li>@step</li> }</ol>@if (package.Flow.OpenQuestions.Count > 0) { <h4>Needs clarification</h4><ul>@foreach (var q in package.Flow.OpenQuestions) { <li>@q</li> }</ul> }</section>
        </ReviewDisclosure>
        </div>
        <p class="mfr-disclaimer">Technical status is derived from the evidence maturity shown above. Runtime/deployed behavior has not been verified.</p>
    }
</section>

