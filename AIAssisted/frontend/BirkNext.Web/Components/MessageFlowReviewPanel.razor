    private IEnumerable<BirkNext.SourceDomains.SourceConfigurationSuggestion> Offered =>
        (_guidance?.Suggestions ?? []).Where(item => _binding is not null || item.ResolvedFrom is not BirkNext.SourceDomains.ConfigurationValueOrigin.CanonicalSource);

    /// <summary>Where a field's hint comes from, by the shared precedence.</summary>
    private string HintOrigin(string field) => Resolved(field)?.ResolvedFrom switch
    {
