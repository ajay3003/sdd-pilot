        ("App identifier", !string.IsNullOrWhiteSpace(_app) ? _app : Resolved("App identifier")?.ResolvedValue, Origin("App identifier", !string.IsNullOrWhiteSpace(_app))),
        ("Safe base URL reference", !string.IsNullOrWhiteSpace(_baseUrl) ? _baseUrl : Resolved("Safe base URL reference")?.ResolvedValue, Origin("Safe base URL reference", !string.IsNullOrWhiteSpace(_baseUrl))),
        ("Endpoint reference", !string.IsNullOrWhiteSpace(_endpoint) ? _endpoint : Resolved("Endpoint reference")?.ResolvedValue, Origin("Endpoint reference", !string.IsNullOrWhiteSpace(_endpoint))),
