@using BirkNext.Integrations
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IIntegrationCatalogApiService Api
@inject IntegrationMappingEvidenceSession MappingEvidence
@implements IDisposable

@* Target Environment → Integrations: the configured, expected integrations Integration Quality Review runs from. Persisted
   by the backend and saved immediately per change — the surrounding Target Environment Edit/Save/Cancel does not stage or roll
   them back. Shared platform values sit once on the platform card; platform-support topics are listed apart and never counted as
   business integrations. Configuration status here is completeness only — never runtime health and never review readiness. *@
<div class="ip" data-testid="ip">
    @if (_loadError is { } error)
    {
        <div class="ip-banner ip-banner-error" role="alert" data-testid="ip-load-error">Integrations could not be loaded: @error</div>
    }
    else if (_catalog is null)
    {
        <p class="ip-muted" role="status" data-testid="ip-loading">Loading integrations…</p>
    }
    else
    {
        var summary = IntegrationsPanePresentation.Summary(_catalog);
        @foreach (var notice in _notices) { <p class="ip-notice" role="status" data-testid="ip-notice">@notice</p> }

        <div class="ip-head">
            <p class="ip-muted" data-testid="ip-intro">Configured integrations used by Integration Quality Review. Observed REST and GraphQL traffic is shown in Endpoint Discovery and is never added here automatically.</p>
            <button type="button" class="btn-secondary" data-testid="ip-add" @onclick="BeginAdd" disabled="@(_editing is not null)">+ Add integration</button>
        </div>
        <p class="ip-save-note" data-testid="ip-save-note">Integration changes are saved immediately and are not affected by the Target Environment Save/Cancel actions.</p>
        <p class="ip-save-status ip-save-status-@_saveState.ToString().ToLowerInvariant()" role="status" aria-live="polite" data-testid="ip-save-status" data-state="@_saveState">@_saveMessage</p>

        <dl class="ip-summary" data-testid="ip-summary">
            <div><dt>Business integrations</dt><dd data-testid="ip-summary-configured">@summary.Configured</dd></div>
            <div><dt>Ready</dt><dd data-testid="ip-summary-ready">@summary.Ready</dd></div>
            <div><dt>Need confirmation</dt><dd data-testid="ip-summary-confirm">@summary.NeedsConfirmation</dd><button type="button" class="ip-link" data-testid="ip-review-mappings" @onclick="ReviewMappings">Review @summary.NeedsConfirmation mappings</button></div>
            @{ var eventHubPlatforms = _catalog.Platforms.Where(p => p.Kind is not (IntegrationKind.ServiceBus or IntegrationKind.IdentityProvisioning)).ToList(); }
            <div><dt>Runtime evidence</dt><dd><span class="ip-pill ip-pill-@EventHubRuntimeEvidencePresentation.SourcesTone(eventHubPlatforms)" data-testid="ip-summary-runtime">@EventHubRuntimeEvidencePresentation.SourcesBadge(eventHubPlatforms)</span>
                <span class="ip-pill ip-pill-@EventHubRuntimeEvidencePresentation.ExecutionTone(_catalog.AzureRuntimeEnabled)" data-testid="ip-summary-azure">@EventHubRuntimeEvidencePresentation.ExecutionBadge(_catalog.AzureRuntimeEnabled)</span></dd></div>
        </dl>
        <dl class="ip-secondary" data-testid="ip-secondary">
            <div><dt>Environment</dt><dd data-testid="ip-summary-env">@(string.IsNullOrWhiteSpace(Profile.Name) ? Profile.Id : Profile.Name)</dd></div>
            <div><dt>Enabled</dt><dd data-testid="ip-summary-enabled">@summary.Enabled</dd></div>
            <div><dt>Needs configuration</dt><dd data-testid="ip-summary-configure">@summary.NeedsConfiguration</dd></div>
            <div><dt>Platform</dt><dd data-testid="ip-summary-platform">@(summary.Platforms.Count == 0 ? "None" : string.Join(", ", summary.Platforms))</dd></div>
        </dl>

        @if (_editing is { } editing)
        {
            <IntegrationDefinitionEditor Original="editing.Original" Platforms="_catalog.Platforms" OnSave="SaveAsync" OnCancel="CancelEdit" />
            @if (_saveError is { } saveError) { <p class="ip-banner ip-banner-error" role="alert" data-testid="ip-save-error">@saveError</p> }
        }

        @foreach (var platform in _catalog.Platforms)
        {
            var runtime = platform.RuntimeEvidence;
            <section class="ip-card ip-platform" data-testid="ip-platform" aria-labelledby="@($"ip-platform-{Slug(platform.Id)}")">
                <h3 id="@($"ip-platform-{Slug(platform.Id)}")">@platform.Name <span class="ip-pill ip-pill-muted">@IntegrationConfigurationRules.KindLabel(platform.Kind)</span></h3>
                @if (platform.Kind == IntegrationKind.IdentityProvisioning)
                {
                    @* Identity provisioning (SCIM) is its own flow — never Event Hub CDC: stages with source and runtime evidence kept apart. *@
                    <ScimProvisioningPanel Profile="Profile" Platform="platform" Catalog="_catalog" SaveSettings="settings => SaveScimAsync(platform, settings)" />
                }
                else if (platform.Kind == IntegrationKind.ServiceBus)
                {
                    @* Service Bus is its own transport: topology, runtime metadata and application routes — no Event Hub fields. *@
                    <ServiceBusPlatformPanel EnvironmentId="@Profile.Id" Platform="platform" Messaging="_messaging" OnConfigure="() => BeginRuntime(platform)" />
                }
                else
                {
                <dl class="ip-dl">
                    <div><dt>Namespace</dt><dd class="ip-mono" data-testid="ip-platform-namespace">@(platform.Namespace ?? "Not configured")</dd></div>
                    <div><dt>Producer</dt><dd>@(platform.ProducerTechnology ?? "Not configured")</dd></div>
                    <div><dt>Default consumer auth</dt><dd data-testid="ip-platform-consumer-auth">@IntegrationConfigurationRules.AuthLabel(platform.DefaultConsumerAuthentication)</dd></div>
                    <div><dt>Monitoring</dt><dd>@(platform.MonitoringProvider ?? "Not configured")</dd></div>
                </dl>
                <ReviewDisclosure Text="View platform details" CollapseText="Hide platform details" TestId="@($"ip-platform-details-{Slug(platform.Id)}")" Class="disclosure-inline">
                    <dl class="ip-dl ip-dl-technical">
                        <div><dt>Source DB</dt><dd>@(platform.SourceDatabase ?? "Not configured")</dd></div>
                        <div><dt>Producer auth</dt><dd data-testid="ip-platform-producer-auth">@IntegrationConfigurationRules.AuthLabel(platform.ProducerAuthentication)</dd></div>
                        <div><dt>FQDN</dt><dd class="ip-mono">@(platform.NamespaceFqdn ?? "Not configured")</dd></div>
                        <div><dt>Resource group</dt><dd class="ip-mono">@(platform.ResourceGroup ?? "Not configured")</dd></div>
                        <div><dt>Region</dt><dd>@(platform.Region ?? "Not configured")</dd></div>
                        <div><dt>Topic prefix</dt><dd class="ip-mono">@(platform.TopicPrefix ?? "Not configured")</dd></div>
                        <div><dt>Source host / port</dt><dd class="ip-mono">@(platform.SourceHost is null ? "Not configured" : $"{platform.SourceHost}:{platform.SourcePort}")</dd></div>
                        <div><dt>Technical owner</dt><dd>@(platform.TechnicalOwner ?? "Not configured")</dd></div>
                        <div><dt>Monitoring URL</dt><dd>@(platform.MonitoringUrl ?? "Not configured")</dd></div>
                        <div><dt>Runbook URL</dt><dd>@(platform.RunbookUrl ?? "Not configured")</dd></div>
                        <div><dt>Default partitions / retention</dt><dd>@(platform.DefaultPartitionCount?.ToString() ?? "—") / @(platform.DefaultRetentionDays is { } days ? $"{days} days" : "—")</dd></div>
                    </dl>
                </ReviewDisclosure>
                @* Runtime execution, the four counted evidence sources, supporting settings and evaluation policy are separate groups. *@
                <EventHubRuntimeEvidenceOverview Platform="platform" AzureEnabled="_catalog.AzureRuntimeEnabled"
                    SourcesExpanded="@(_runtimeExpanded == platform.Id)" SourcesExpandedChanged="@(value => _runtimeExpanded = value ? platform.Id : null)"
                    OnConfigureAccess="() => BeginRuntime(platform)" OnEditSources="() => BeginRuntime(platform)"
                    SavedMessage="@(_runtimeSaved == platform.Id ? EventHubRuntimeEvidencePresentation.SavedSummary(platform, _catalog.AzureRuntimeEnabled) : null)"
                    EditContent="@(_editingRuntime == platform.Id ? RuntimeForm(platform) : null)" />
                }
                @if (platform.Kind == IntegrationKind.ServiceBus)
                {
                <ReviewDisclosure Text="Runtime evidence sources" CollapseText="Hide runtime evidence sources" Hint="@ServiceBusPresentation.RuntimeConfiguration(platform).Label" Expanded="@(_runtimeExpanded == platform.Id)" ExpandedChanged="@(value => _runtimeExpanded = value ? platform.Id : null)" TestId="@($"ip-runtime-{Slug(platform.Id)}")" Class="disclosure-inline">
                    <p class="ip-muted">Read-only sources Integration Quality Review may use for this platform. @EventHubRuntimeEvidencePresentation.IdentityText</p>
                    @if (_editingRuntime == platform.Id)
                    {
                        <div class="ip-runtime-form" data-testid="ip-runtime-form">
                            @* Service Bus metadata is read through Azure Resource Manager: subscription + resource group + namespace. No connection string. *@
                            <label class="ip-field">Azure subscription id (Service Bus namespace metadata) <input class="form-control ip-mono" @ref="_runtimeFocus" @bind="_runtime.SubscriptionId" data-testid="ip-runtime-subscription" /></label>
                            <p class="ip-muted">Resource group @(platform.ResourceGroup ?? "not configured") · namespace @(platform.Namespace ?? "not configured"). Read-only metadata GETs with the instance's Azure identity (Reader); no message is read.</p>
                            <label class="ip-field">Review window (hours) <input type="number" min="1" max="168" class="form-control" @bind="_runtime.ReviewWindowHours" data-testid="ip-runtime-window" /></label>
                            @if (_runtimeError is { } runtimeError) { <p class="ip-field-error" role="alert" data-testid="ip-runtime-error">@runtimeError</p> }
                            <div class="ip-editor-actions">
                                <button type="button" class="btn-primary" data-testid="ip-runtime-save" @onclick="() => SaveRuntimeAsync(platform)">Save runtime evidence sources</button>
                                <button type="button" class="btn-secondary" @onclick="() => _editingRuntime = null">Cancel</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <dl class="ip-dl ip-dl-technical" data-testid="ip-runtime-summary">
                            <div><dt>Azure subscription</dt><dd class="ip-mono">@(runtime?.SubscriptionId ?? "Not configured")</dd></div>
                            <div><dt>Resource group / namespace</dt><dd class="ip-mono">@(platform.ResourceGroup ?? "—") / @(platform.Namespace ?? "—")</dd></div>
                            <div><dt>Review window</dt><dd>@(runtime?.ReviewWindowHours ?? IntegrationRuntimeEvidenceSettings.DefaultReviewWindowHours) h</dd></div>
                            <div><dt>Thresholds</dt><dd>None — message counts are reported as Observed, never judged.</dd></div>
                        </dl>
                        <button type="button" class="ip-link" data-testid="ip-runtime-edit" @onclick="() => BeginRuntime(platform)">Edit runtime evidence sources</button>
                    }
                </ReviewDisclosure>
                }
            </section>
        }

        <ApplicationMessagingPanel EnvironmentId="@Profile.Id" Catalog="_catalog" Evidence="_messaging" EvidenceChanged="set => _messaging = set" />

        <div class="ip-workflow"><a class="ip-link" href="/integration-quality-review" data-testid="ip-open-iqr">Open Integration Quality Review</a><span class="ip-muted">Review can run with limitations while mapping or runtime evidence is unavailable.</span></div>

        var readinessCounts = _catalog.Integrations.GroupBy(i => IntegrationsPanePresentation.Row(_catalog, i).ReviewReadiness).ToDictionary(g => g.Key, g => g.Count());
        <div class="ip-filters" role="group" aria-label="Filter integrations">
            <label class="ip-field-inline">Search <input type="search" class="form-control" data-testid="ip-search" @bind="_search" @bind:event="oninput" placeholder="Name, topic or consumer" /></label>
            <label class="ip-field-inline">Configuration status
                <select class="form-control" data-testid="ip-filter-state" @bind="_stateFilter">
                    <option value="">All</option>
                    @foreach (var s in Enum.GetValues<IntegrationConfigurationState>()) { <option value="@s">@IntegrationConfigurationRules.Label(s) (@_catalog.Integrations.Count(i => IntegrationConfigurationRules.Evaluate(i, IntegrationsPanePresentation.Platform(_catalog, i)).State == s))</option> }
                </select>
            </label>
            <label class="ip-field-inline">Review readiness
                <select class="form-control" data-testid="ip-filter-readiness" @bind="_readinessFilter">
                    <option value="">All</option>
                    @foreach (var r in IntegrationsPanePresentation.ReadinessLabels.Where(l => readinessCounts.ContainsKey(l))) { <option value="@r">@r (@readinessCounts[r])</option> }
                </select>
            </label>
        </div>
        @if (!string.IsNullOrWhiteSpace(_stateFilter) || !string.IsNullOrWhiteSpace(_readinessFilter) || !string.IsNullOrWhiteSpace(_search))
        {
            <p class="ip-muted" data-testid="ip-active-filter">Active filter: @ActiveFilter() <button type="button" class="ip-link" data-testid="ip-clear-filters" @onclick="ClearFilters">Clear filters</button></p>
        }
        <p class="ip-sr" role="status" aria-live="polite" data-testid="ip-mapping-announcement">@_mappingAnnouncement</p>

        var groups = IntegrationsPanePresentation.Groups(_catalog, _search, Enum.TryParse<IntegrationConfigurationState>(_stateFilter, out var f) ? f : null, _readinessFilter);
        var mappingChecks = MappingEvidence.For(Profile.Id);
        @if (_catalog.Integrations.Count == 0)
        {
            <p class="ip-empty" data-testid="ip-empty">No integrations configured. Use <strong>+ Add integration</strong> to add one.</p>
        }
        else if (groups.Count == 0)
        {
            <p class="ip-empty" data-testid="ip-no-match">@(_stateFilter == nameof(IntegrationConfigurationState.NeedsConfirmation) && summary.NeedsConfirmation == 0 ? "No mappings require confirmation." : "No integration matches the filter.")</p>
        }
        @foreach (var group in groups)
        {
            <section class="ip-group" data-testid="ip-group" aria-labelledby="@($"ip-group-{Slug(group.SystemName)}")">
                <h3 id="@($"ip-group-{Slug(group.SystemName)}")">@group.SystemName <span class="ip-muted">· @group.Rows.Count integration@(group.Rows.Count == 1 ? "" : "s")</span></h3>
                <div class="ip-tablewrap" tabindex="0" role="region" aria-label="@($"{group.SystemName} integrations")">
                    <table class="ip-table" data-testid="ip-table">
                        <thead><tr><th scope="col">Integration</th><th scope="col">Topic</th><th scope="col">Producer</th><th scope="col">Consumer</th><th scope="col">Configuration status</th><th scope="col">Review readiness</th><th scope="col"><span class="ip-sr">Actions</span></th></tr></thead>
                        <tbody>
                            @foreach (var row in group.Rows)
                            {
                                var open = _viewing == row.Definition.Id;
                                <tr @key="row.Definition.Id" data-testid="ip-row" data-integration-id="@row.Definition.Id" data-configuration="@row.Configuration">
                                    <td><strong>@row.ShortName</strong>@if (!row.Definition.Enabled) { <span class="ip-pill ip-pill-muted">Disabled</span> }</td>
                                    <td class="ip-mono ip-nowrap" title="@row.Topic">@row.TopicShort</td>
                                    <td>@row.Producer</td>
                                    <td data-testid="ip-row-consumer" data-mapping="@row.MappingState">@row.Consumer
                                        @if (row.MappingState is ConsumerMappingState.Suggested or ConsumerMappingState.Confirmed)
                                        { <span class="ip-pill ip-pill-muted" title="@(row.MappingState == ConsumerMappingState.Suggested ? "Suggested mapping. Not yet confirmed." : "Explicitly confirmed mapping.")">@row.MappingState</span> }
                                    </td>
                                    <td><span class="ip-pill ip-pill-@IntegrationsPanePresentation.StateTone(row.Configuration)" data-testid="ip-row-configuration" title="@row.ConfigurationDetail">@IntegrationConfigurationRules.Label(row.Configuration)</span>
                                        @if (row.Configuration == IntegrationConfigurationState.NeedsConfirmation)
                                        { <small class="ip-status-help">@(row.Consumer == "Not assigned" ? "Consumer mapping has not been established." : "BirkNext has a suggested consumer mapping, but the relationship has not yet been verified.")</small> }
                                    </td>
                                    <td data-testid="ip-row-readiness" title="@row.ReviewReadinessDetail"><span class="ip-pill ip-pill-muted">@row.ReviewReadiness</span><details class="ip-readiness"><summary>Why @row.ReviewReadiness.ToLowerInvariant()?</summary><p>@row.ReviewReadinessDetail</p></details></td>
                                    <td class="ip-actions">
                                        @if (row.Configuration == IntegrationConfigurationState.NeedsConfirmation)
                                        {
                                            <IconButton Title="Test mapping" AriaLabel="@(row.MappingState == ConsumerMappingState.Suggested ? $"Test suggested mapping for {row.ShortName} and {row.Consumer}" : $"Test mapping for {row.ShortName} (consumer not assigned)")" Class="ip-test" data-testid="ip-test-mapping" Disabled="@_mappingBusy.Contains(row.Definition.Id)" OnClick="() => TestMappingAsync(row.Definition)">
                                                <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M4 2 L14 8 L4 14 Z" /></svg>
                                            </IconButton>
                                            @if (_mappingBusy.Contains(row.Definition.Id)) { <span class="ip-muted" data-testid="ip-mapping-loading">Testing mapping…</span> }
                                        }
                                        @if (row.MappingState == ConsumerMappingState.Suggested)
                                        { <button type="button" class="ip-link" data-testid="ip-inline-confirm" aria-label="@($"Confirm {row.Consumer} as consumer for {row.ShortName}")" disabled="@(_saveState == SaveState.Saving || _mappingBusy.Contains(row.Definition.Id))" @onclick="() => ConfirmMappingAsync(row.Definition)">Confirm</button> }
                                        @if (mappingChecks.TryGetValue(row.Definition.Id, out var mappingResult))
                                        { <div class="ip-mapping-result"><span class="ip-pill ip-pill-@(mappingResult.OverallState == IntegrationMappingEvidenceState.Error ? "attention" : "muted")" data-testid="ip-mapping-result" data-state="@mappingResult.OverallState">@IntegrationMappingEvidenceCheck.Label(mappingResult.OverallState)</span><button type="button" class="ip-link" data-testid="ip-view-evidence" aria-expanded="@(_evidenceViewing == row.Definition.Id ? "true" : "false")" aria-controls="@($"ip-evidence-{Slug(row.Definition.Id)}")" @onclick="() => _evidenceViewing = _evidenceViewing == row.Definition.Id ? null : row.Definition.Id">View evidence</button></div> }
                                        <button type="button" class="ip-link" data-testid="ip-row-view" aria-expanded="@(open ? "true" : "false")" aria-controls="@($"ip-detail-{Slug(row.Definition.Id)}")" @onclick="() => _viewing = open ? null : row.Definition.Id">View</button>
                                        <details class="ip-menu" data-testid="ip-actions-menu"><summary aria-label="@($"Actions for {row.ShortName}")" title="Actions">⋯</summary><div class="ip-menu-items">
                                            <button type="button" class="ip-link" data-testid="ip-row-edit" disabled="@(_editing is not null)" @onclick="() => BeginEdit(row.Definition)">Edit</button>
                                            @if (row.MappingState == ConsumerMappingState.Suggested) { <button type="button" class="ip-link" @onclick="() => ConfirmMappingAsync(row.Definition)">Confirm mapping</button> }
                                            <button type="button" class="ip-link" @onclick="() => ToggleEnabledAsync(row.Definition)">@(row.Definition.Enabled ? "Disable" : "Enable")</button>
                                            <button type="button" class="ip-link" @onclick="() => ManageContracts(row.Definition)">Manage contracts</button>
                                            <button type="button" class="ip-link ip-link-danger" @onclick="() => { _viewing = row.Definition.Id; _confirmingDelete = row.Definition.Id; }">Delete</button>
                                        </div></details>
                                    </td>
                                </tr>
                                @if (_evidenceViewing == row.Definition.Id && mappingChecks.TryGetValue(row.Definition.Id, out var evidence))
                                {
                                    <tr class="ip-detail-row" id="@($"ip-evidence-{Slug(row.Definition.Id)}")" data-testid="ip-evidence"><td colspan="7">
                                        <IntegrationMappingEvidencePanel Result="evidence" OnConfigure="() => ConfigureFor(row.Definition)" CanConfigure="@(group.Platform is not null)"
                                            ConsumerState="row.MappingState" CanConfirm="@(row.MappingState == ConsumerMappingState.Suggested && _saveState != SaveState.Saving)" OnConfirm="() => ConfirmMappingAsync(row.Definition)" />
                                    </td></tr>
                                }
                                @if (open)
                                {
                                    var definition = row.Definition;
                                    <tr class="ip-detail-row" id="@($"ip-detail-{Slug(definition.Id)}")" data-testid="ip-row-detail">
                                        <td colspan="7">
                                            <dl class="ip-dl ip-dl-technical">
                                                <div><dt>Display name</dt><dd>@definition.DisplayName</dd></div>
                                                <div><dt>Topic</dt><dd class="ip-mono">@(row.Topic ?? "Not configured")</dd></div>
                                                <div><dt>Source</dt><dd class="ip-mono">@(definition.SourceResource ?? "Not configured")</dd></div>
                                                <div><dt>Consumer group</dt><dd class="ip-mono" data-testid="ip-detail-consumer-group">@(definition.ConsumerGroup ?? "Unknown / not configured")</dd></div>
                                                <div><dt>Consumer mapping</dt><dd data-testid="ip-detail-mapping">@IntegrationConfigurationRules.MappingLabel(row.MappingState)@(definition.Consumer.MappingSource is { } src ? $" · {src}" : "")@(definition.Consumer.MappingConfirmedAt is { } at ? $" · {at.ToUniversalTime():yyyy-MM-dd HH:mm} UTC" : "")</dd></div>
                                                @if (ApplicationMessagingPresentation.BoundTo(definition, _messaging) is { } messagingApp)
                                                {
                                                    <div><dt>Application messaging</dt><dd data-testid="ip-detail-messaging">@messagingApp.ApplicationId · Wolverine @ApplicationMessagingLabels.Detection(messagingApp.Detection)@(messagingApp.Detection == MessagingDetection.NotDetected ? "" : $" · Handler mapping {ApplicationMessagingLabels.Fact(messagingApp.HandlerMapping)} · Retry policy {ApplicationMessagingLabels.Fact(messagingApp.RetryPolicy)}") · Runtime processing Not assessed</dd></div>
                                                }
                                                @if (definition.Consumer.ContainerApp is { } app) { <div><dt>Container app</dt><dd class="ip-mono">@app</dd></div> }
                                                @if (definition.Consumer.ManagedIdentity is { } mi) { <div><dt>Managed identity</dt><dd class="ip-mono">@mi</dd></div> }
                                                <div><dt>Producer auth</dt><dd>@IntegrationConfigurationRules.AuthLabel(definition.ProducerAuthentication)</dd></div>
                                                <div><dt>Consumer auth</dt><dd>@IntegrationConfigurationRules.AuthLabel(definition.ConsumerAuthentication)</dd></div>
                                                <div><dt>Contract</dt><dd>@IntegrationConfigurationRules.ContractLabel(definition.ContractRelationship)</dd></div>
                                                <div><dt>Health / worker URL</dt><dd>@(definition.HealthUrl ?? "Not configured") / @(definition.WorkerUrl ?? "Not configured")</dd></div>
                                                <div><dt>Configuration status</dt><dd>@IntegrationConfigurationRules.Label(row.Configuration) · @row.ConfigurationDetail</dd></div>
                                                <div><dt>Review readiness</dt><dd>@row.ReviewReadiness · @row.ReviewReadinessDetail</dd></div>
                                            </dl>

                                            @if (definition.Consumer.MappingState == ConsumerMappingState.Suggested && definition.Consumer.DisplayName is { } suggested)
                                            {
                                                <div class="ip-mapping" data-testid="ip-mapping-suggested">
                                                    <p class="ip-muted">Suggested consumer: <strong>@suggested</strong> — @(definition.Consumer.MappingSource ?? "suggested source"). Receiver rights never confirm a mapping; a person does.</p>
                                                    <div class="ip-mapping-actions">
                                                        <button type="button" class="btn-secondary ip-btn-sm" data-testid="ip-mapping-confirm" @onclick="() => ConfirmMappingAsync(definition)">Confirm @suggested</button>
                                                        <button type="button" class="ip-link" data-testid="ip-mapping-change" @onclick="() => BeginEdit(definition)">Change</button>
                                                    </div>
                                                </div>
                                            }

                                            <div class="ip-contracts" data-testid="ip-contracts" role="group" tabindex="-1" @ref="_contractsFocus" id="@($"ip-contracts-{Slug(definition.Id)}")" aria-label="@($"Event contracts for {definition.DisplayName}")">
                                                <h4>Event contracts (JSON Schema)</h4>
                                                @foreach (var role in new[] { IntegrationContractRole.Producer, IntegrationContractRole.Consumer })
                                                {
                                                    var artifact = _contracts.FirstOrDefault(c => c.IntegrationId == definition.Id && c.Role == role);
                                                    var errorId = $"ip-contract-error-{Slug(definition.Id)}-{role.ToString().ToLowerInvariant()}";
                                                    var contractError = _contractErrors.TryGetValue((definition.Id, role), out var ce) ? ce : null;
                                                    <div class="ip-contract" data-testid="ip-contract" data-role="@role" data-configured="@(artifact is not null ? "true" : "false")">
                                                        <span class="ip-contract-role">@role contract</span>
                                                        @if (artifact is not null)
                                                        {
                                                            <span class="ip-contract-file" data-testid="ip-contract-file">@artifact.FileName</span>
                                                            <span class="ip-muted ip-mono">sha256 @artifact.ShortHash · @artifact.FieldCount field(s)@(artifact.Version is { } v ? $" · {v}" : "")</span>
                                                        }
                                                        else { <span class="ip-muted">None</span> }
                                                        <label class="ip-file-button">
                                                            <InputFile class="ip-file-input" accept=".json" OnChange="args => UploadContractAsync(definition, role, args)" aria-describedby="@(contractError is not null ? errorId : null)" aria-label="@($"{(artifact is null ? "Upload" : "Replace")} {role.ToString().ToLowerInvariant()} contract")" data-testid="ip-contract-input" />
                                                            <span aria-hidden="true">@(artifact is null ? "Upload" : "Replace")</span>
                                                        </label>
                                                        @if (artifact is not null) { <button type="button" class="ip-link ip-link-danger" data-testid="ip-contract-remove" @onclick="() => RemoveContractAsync(definition, role)" aria-label="@($"Remove {role.ToString().ToLowerInvariant()} contract {artifact.FileName}")">Remove</button> }
                                                        @if (contractError is not null) { <p class="ip-field-error" id="@errorId" role="alert" data-testid="ip-contract-error">Invalid contract: @contractError</p> }
                                                    </div>
                                                }
                                                <p class="ip-muted">Compatibility needs both contracts. Uploading both marks the relationship "Both available" — never "Verified" automatically.</p>
                                            </div>

                                            <p class="ip-detail-actions">
                                                <button type="button" class="ip-link" data-testid="ip-row-toggle-enabled" @onclick="() => ToggleEnabledAsync(definition)">@(definition.Enabled ? "Disable" : "Enable")</button>
                                                <span aria-hidden="true">·</span>
                                                @if (_confirmingDelete == definition.Id)
                                                {
                                                    <span class="ip-confirm" role="group" aria-label="Confirm delete" data-testid="ip-delete-confirm">
                                                        <span>Delete <strong>@definition.DisplayName</strong>? Review history keeps its snapshots.</span>
                                                        <button type="button" class="ip-link ip-link-danger" data-testid="ip-row-delete-confirm" @onclick="() => DeleteAsync(definition)">Delete</button>
                                                        <button type="button" class="ip-link" data-testid="ip-row-delete-cancel" @onclick="() => _confirmingDelete = null">Cancel</button>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <button type="button" class="ip-link ip-link-danger" data-testid="ip-row-delete" @onclick="() => _confirmingDelete = definition.Id">Delete</button>
                                                }
                                            </p>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        @if (_catalog.Platforms.Any(p => p.TechnicalTopics.Count > 0))
        {
            <ReviewDisclosure Text="Technical Event Hub topics" CollapseText="Hide technical Event Hub topics" Hint="@TechnicalHint()" TestId="ip-technical" Class="disclosure-inline">
                <p class="ip-muted">Used by Debezium/Kafka Connect. These are platform-support topics, not business integrations, and are excluded from IQR business-integration counts.</p>
                <ul class="ip-technical-list" data-testid="ip-technical-list">
                    @foreach (var topic in _catalog.Platforms.SelectMany(p => p.TechnicalTopics)) { <li><span class="ip-mono">@topic.Name</span> — @topic.Purpose</li> }
                </ul>
            </ReviewDisclosure>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public FrontendAnalysisProfile Profile { get; set; } = new();

    /// <summary>Deep-link target from Integration Quality Review ("focus=" key): mappings, runtime or contracts. Applied once per value after load.</summary>
    [Parameter] public string? Focus { get; set; }

    private enum SaveState { Idle, Saving, Saved, Failed }

    private IntegrationCatalog? _catalog;
    private IReadOnlyList<IntegrationContractArtifact> _contracts = [];
    private ApplicationMessagingEvidenceSet? _messaging;
    private readonly Dictionary<(string, IntegrationContractRole), string> _contractErrors = [];
    private string? _loadError;
    private string? _saveError;
    private readonly List<string> _notices = [];
    private string _search = "";
    private string _stateFilter = "";
    private string _readinessFilter = "";
    private string? _appliedFocus;
    private string? _focusElementId;
    private string? _viewing;
    private string? _loadedFor;
    private string? _confirmingDelete;
    private string? _editingRuntime;
    private RuntimeModel _runtime = new();
    private string? _runtimeError;
    /// <summary>Platform whose Event Hub runtime sources were just saved (post-save summary).</summary>
    private string? _runtimeSaved;
    private EditState? _editing;
    private SaveState _saveState = SaveState.Idle;
    private string _saveMessage = "";
    private string? _runtimeExpanded;
    private string? _evidenceViewing;
    private string _mappingAnnouncement = "";
    private readonly HashSet<string> _mappingBusy = [];
    private CancellationTokenSource _mappingCancellation = new();
    private ElementReference _runtimeFocus;
    private ElementReference _contractsFocus;
    private bool _focusContracts;
    private bool _focusRuntime;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusRuntime) { _focusRuntime = false; await _runtimeFocus.FocusAsync(); }
        if (_focusContracts) { _focusContracts = false; await _contractsFocus.FocusAsync(); }
    }

    private void ReviewMappings() { _search = ""; _readinessFilter = ""; _stateFilter = nameof(IntegrationConfigurationState.NeedsConfirmation); }
    private void ClearFilters() { _search = ""; _stateFilter = ""; _readinessFilter = ""; }

    private string ActiveFilter() => string.Join(" · ", new[]
    {
        Enum.TryParse<IntegrationConfigurationState>(_stateFilter, out var state) ? IntegrationConfigurationRules.Label(state) : null,
        _readinessFilter.Length > 0 ? $"Review readiness: {_readinessFilter}" : null,
        _search.Length > 0 ? $"Search: {_search}" : null,
    }.Where(x => x is not null));

    /// <summary>Opens the integration's detail and moves focus to its contracts group — the one place contracts are managed.</summary>
    private void ManageContracts(IntegrationDefinition definition)
    {
        _viewing = definition.Id;
        _focusContracts = true;
    }

    /// <summary>Applies an Integration Quality Review deep link: the exact corrective place, never an automatic change.</summary>
    private void ApplyFocus()
    {
        if (_catalog is null || Focus is not { Length: > 0 } focus || _appliedFocus == focus) return;
        _appliedFocus = focus;
        switch (focus)
        {
            case IntegrationReviewPrerunPresentation.FocusMappings:
                ReviewMappings();
                break;
            case IntegrationReviewPrerunPresentation.FocusRuntime when _catalog.Platforms.FirstOrDefault(p => p.Kind != IntegrationKind.ServiceBus) is { } platform:
                BeginRuntime(platform);
                break;
            case ServiceBusPresentation.Focus when _catalog.Platforms.FirstOrDefault(p => p.Kind == IntegrationKind.ServiceBus) is { } serviceBus:
                BeginRuntime(serviceBus);
                break;
            case IntegrationReviewPrerunPresentation.FocusContracts:
                var target = _catalog.Integrations.Where(i => i.Enabled)
                    .OrderBy(i => i.ContractRelationship == ContractRelationshipState.BothContractsAvailable)
                    .ThenBy(i => i.DisplayName, StringComparer.OrdinalIgnoreCase).FirstOrDefault();
                if (target is not null) ManageContracts(target);
                break;
        }
    }
    private void ConfigureFor(IntegrationDefinition definition)
    {
        if (_catalog is not null && IntegrationsPanePresentation.Platform(_catalog, definition) is { } platform) BeginRuntime(platform);
    }
    private async Task TestMappingAsync(IntegrationDefinition definition)
    {
        if (!_mappingBusy.Add(definition.Id)) return;
        var environmentId = Profile.Id;
        var token = _mappingCancellation.Token;
        _mappingAnnouncement = $"Testing mapping for {definition.DisplayName}…";
        try
        {
            var result = await Api.CheckMappingAsync(environmentId, definition.Id, token);
            if (Profile.Id != environmentId) return;
            MappingEvidence.Record(environmentId, result);
            _evidenceViewing = definition.Id;
            _mappingAnnouncement = $"{definition.DisplayName}: {IntegrationMappingEvidenceCheck.Label(result.OverallState)}. View evidence for missing sources. Mapping unchanged.";
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            if (Profile.Id != environmentId) return;
            MappingEvidence.Record(environmentId, new() { IntegrationId = definition.Id, Topic = definition.EndpointOrTopic, SuggestedConsumer = definition.Consumer.DisplayName,
                CompletedAt = DateTimeOffset.UtcNow, OverallState = IntegrationMappingEvidenceState.NotTestable,
                Checks = [new() { Label = "Evidence service", State = IntegrationEvidenceState.Unavailable, Summary = "The evidence service did not answer. Retry the check; the mapping is unchanged.", MissingReason = "The evidence service did not answer. Retry the check; the mapping is unchanged." }] });
            _evidenceViewing = definition.Id;
            _mappingAnnouncement = "Mapping evidence unavailable. The mapping is unchanged.";
        }
        finally { _mappingBusy.Remove(definition.Id); }
    }
    public void Dispose() { _mappingCancellation.Cancel(); _mappingCancellation.Dispose(); }

    private sealed record EditState(IntegrationDefinition? Original);

    /// <summary>Service Bus runtime settings in edit (the Event Hub form owns its own model).</summary>
    private sealed class RuntimeModel
    {
        public string? SubscriptionId { get; set; }
        public int? ReviewWindowHours { get; set; }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == Profile.Id) { ApplyFocus(); return; }
        _mappingCancellation.Cancel();
        _mappingCancellation.Dispose();
        _mappingCancellation = new();
        _mappingBusy.Clear(); _evidenceViewing = null; _appliedFocus = null;
        _loadedFor = Profile.Id;
        await LoadAsync(importLegacy: true);
        ApplyFocus();
    }

    private async Task LoadAsync(bool importLegacy)
    {
        _loadError = null;
        try
        {
            // Integrations saved before the catalog existed lived in the browser profile; the backend imports them once.
            if (importLegacy && Profile.Integrations.Count > 0)
            {
                var imported = await Api.ImportLegacyAsync(Profile);
                if (imported > 0) _notices.Add($"Imported {imported} integration{(imported == 1 ? "" : "s")} previously stored in this browser.");
            }
            _catalog = await Api.GetCatalogAsync(Profile);
            _notices.AddRange(_catalog.Notices.Except(_notices).ToList());
            _contracts = await Api.ContractsAsync(Profile.Id);
            _messaging = await Api.ApplicationMessagingAsync(Profile.Id);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _loadError = "the BirkNext backend did not answer. Integrations are stored by the backend.";
        }
    }

    /// <summary>Every change is stored at once; the status line says what happened (Saving… / Saved / Save failed).</summary>
    private async Task<bool> TrackAsync(string done, Func<Task> action)
    {
        _saveState = SaveState.Saving;
        _saveMessage = "Saving…";
        StateHasChanged();
        try
        {
            await action();
            _saveState = SaveState.Saved;
            _saveMessage = $"Saved. {done}";
            await LoadAsync(importLegacy: false);
            return true;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _saveState = SaveState.Failed;
            _saveMessage = "Save failed: the change was not stored. The backend did not accept it.";
            return false;
        }
    }

    private void BeginAdd() { _saveError = null; _editing = new EditState(null); }
    private void BeginEdit(IntegrationDefinition definition) { _saveError = null; _editing = new EditState(definition); }
    private void CancelEdit() { _editing = null; _saveError = null; }

    private async Task SaveAsync(IntegrationDefinition definition)
    {
        var isNew = _editing?.Original is null;
        var ok = await TrackAsync(isNew ? $"{definition.DisplayName} added." : $"{definition.DisplayName} updated.", async () =>
        {
            if (isNew) await Api.CreateAsync(Profile.Id, definition);
            else await Api.UpdateAsync(Profile.Id, definition);
        });
        if (ok) { _editing = null; _saveError = null; }
        else _saveError = "The integration could not be saved. Your edits are still in the form.";
    }

    private Task ToggleEnabledAsync(IntegrationDefinition definition) =>
        TrackAsync($"{definition.DisplayName} {(definition.Enabled ? "disabled" : "enabled")}.", () => Api.SetEnabledAsync(Profile.Id, definition.Id, !definition.Enabled));

    private async Task DeleteAsync(IntegrationDefinition definition)
    {
        _confirmingDelete = null;
        if (await TrackAsync($"{definition.DisplayName} deleted.", () => Api.DeleteAsync(Profile.Id, definition.Id))) _viewing = null;
    }

    /// <summary>A person confirms the suggested consumer; the provenance records that it was a person and when. Never automatic.</summary>
    private Task ConfirmMappingAsync(IntegrationDefinition definition) =>
        TrackAsync($"{definition.Consumer.DisplayName} confirmed as the consumer of {definition.DisplayName}.", () => Api.UpdateAsync(Profile.Id, definition with
        {
            Consumer = definition.Consumer with
            {
                MappingState = ConsumerMappingState.Confirmed,
                MappingEvidence = $"Confirmed by a person in BirkNext Integrations (suggested by: {definition.Consumer.MappingSource ?? "unknown source"})",
                MappingSource = "Confirmed in Target Environment → Integrations",
                MappingConfirmedAt = DateTimeOffset.UtcNow,
            },
        }));

    private const long MaxContractBytes = 2 * 1024 * 1024;

    private async Task UploadContractAsync(IntegrationDefinition definition, IntegrationContractRole role, InputFileChangeEventArgs args)
    {
        var key = (definition.Id, role);
        _contractErrors.Remove(key);
        var file = args.File;
        if (file.Size > MaxContractBytes) { _contractErrors[key] = "the file is larger than the 2 MB contract limit."; return; }
        string content;
        try
        {
            await using var stream = file.OpenReadStream(MaxContractBytes);
            using var reader = new StreamReader(stream, System.Text.Encoding.UTF8);
            content = await reader.ReadToEndAsync();
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException) { _contractErrors[key] = "the file could not be read."; return; }

        string? rejected = null;
        await TrackAsync($"{role} contract {file.Name} stored for {definition.DisplayName}.", async () =>
        {
            var (_, error) = await Api.SaveContractAsync(new IntegrationContractUpload { EnvironmentId = Profile.Id, IntegrationId = definition.Id, Role = role, FileName = file.Name, Content = content });
            rejected = error;
        });
        if (rejected is not null)
        {
            _contractErrors[key] = rejected;
            _saveState = SaveState.Failed;
            _saveMessage = $"Save failed: the {role.ToString().ToLowerInvariant()} contract was rejected and nothing was stored.";
        }
    }

    private Task RemoveContractAsync(IntegrationDefinition definition, IntegrationContractRole role) =>
        TrackAsync($"{role} contract removed from {definition.DisplayName}.", () => Api.RemoveContractAsync(Profile.Id, definition.Id, role));

    private RenderFragment RuntimeForm(IntegrationPlatform platform) =>
        @<EventHubRuntimeEvidenceForm Platform="platform" AzureEnabled="_catalog!.AzureRuntimeEnabled" OnSave="settings => SaveEventHubRuntimeAsync(platform, settings)" OnCancel="() => _editingRuntime = null" />;

    private void BeginRuntime(IntegrationPlatform platform)
    {
        _runtimeExpanded = platform.Id;
        // The Event Hub form focuses its own first field; the Service Bus fields are focused here.
        _focusRuntime = platform.Kind == IntegrationKind.ServiceBus;
        var r = platform.RuntimeEvidence;
        _runtime = new RuntimeModel { SubscriptionId = r?.SubscriptionId, ReviewWindowHours = r?.ReviewWindowHours };
        _runtimeError = null;
        _runtimeSaved = null;
        _editingRuntime = platform.Id;
    }

    /// <summary>Event Hub sources: the form validated them (shared rules); the backend validates again before storing.</summary>
    private async Task<bool> SaveEventHubRuntimeAsync(IntegrationPlatform platform, IntegrationRuntimeEvidenceSettings settings)
    {
        if (!await TrackAsync($"Runtime evidence sources of {platform.Name} updated.", () => Api.UpdatePlatformAsync(Profile.Id, platform with { RuntimeEvidence = settings }))) return false;
        _editingRuntime = null;
        _runtimeSaved = platform.Id;
        return true;
    }

    private async Task SaveRuntimeAsync(IntegrationPlatform platform)
    {
        static string? Clean(string? v) => string.IsNullOrWhiteSpace(v) ? null : v.Trim();
        // Service Bus: only the subscription and window are edited here; any other stored value is kept.
        var settings = (platform.RuntimeEvidence ?? new IntegrationRuntimeEvidenceSettings()) with { SubscriptionId = Clean(_runtime.SubscriptionId), ReviewWindowHours = _runtime.ReviewWindowHours };
        _runtimeError = settings.Validate();
        if (_runtimeError is not null) return;
        if (await TrackAsync($"Runtime evidence sources of {platform.Name} updated.", () => Api.UpdatePlatformAsync(Profile.Id, platform with { RuntimeEvidence = settings })))
            _editingRuntime = null;
    }

    private async Task<bool> SaveScimAsync(IntegrationPlatform platform, ScimProvisioningSettings settings)
    {
        if (settings.Validate() is { } invalid) { _saveState = SaveState.Failed; _saveMessage = invalid; return false; }
        return await TrackAsync($"SCIM settings of {platform.Name} updated.", () => Api.UpdatePlatformAsync(Profile.Id, platform with { ScimProvisioning = settings }));
    }

    private string TechnicalHint()
    {
        var count = _catalog!.Platforms.Sum(p => p.TechnicalTopics.Count);
        return $"{count} platform-support topic{(count == 1 ? "" : "s")} · not business integrations";
    }

    private static string Slug(string value) => new string(value.Select(c => char.IsLetterOrDigit(c) ? char.ToLowerInvariant(c) : '-').ToArray());
}
