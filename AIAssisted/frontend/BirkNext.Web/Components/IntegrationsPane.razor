@using BirkNext.Integrations
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using BirkNext.SourceDomains
@using Microsoft.AspNetCore.Components.Forms
@inject IIntegrationCatalogApiService Api
@inject IntegrationMappingEvidenceSession MappingEvidence
@inject IServiceProvider ServiceProvider
@implements IDisposable

@* Target Environment → Integrations owns environment-specific integration configuration: what is configured here, which Source Analysis
   suggestions to add, whether runtime evidence is set up, and the way into Integration Quality Review. Source Analysis owns detected source
   evidence (Wolverine usage, handlers, routes, retry, outbox, telemetry) — it is linked, never re-rendered here. Changes are saved
   immediately; the surrounding Target Environment Edit/Save/Cancel does not stage or roll them back. Configuration status is completeness
   only — never runtime health and never review readiness. *@
<div class="ip" data-testid="ip">
    @if (_loadError is { } error)
    {
        <div class="ip-banner ip-banner-error" role="alert" data-testid="ip-load-error">Integrations could not be loaded: @error</div>
    }
    else if (_catalog is null)
    {
        <p class="ip-muted" role="status" data-testid="ip-loading">Loading integrations…</p>
    }
    else
    {
        var summary = IntegrationsPanePresentation.Summary(_catalog);
        var suggestions = IntegrationsOverviewPresentation.Summary(_sources);
        var runtime = IntegrationsOverviewPresentation.Runtime(_catalog);
        @foreach (var notice in _notices) { <p class="ip-notice" role="status" data-testid="ip-notice">@notice</p> }

        <section class="ip-overview" aria-label="Integrations overview" data-testid="ip-overview">
            <p class="ip-muted" data-testid="ip-intro">Configured integrations used by Integration Quality Review. Observed REST and GraphQL traffic is shown in Endpoint Discovery and is never added here automatically.</p>
            <dl class="ip-summary" data-testid="ip-summary">
                <div><dt>Environment</dt><dd data-testid="ip-summary-env">@IntegrationsOverviewPresentation.Environment(Profile)</dd></div>
                <div><dt>Configured integrations</dt><dd data-testid="ip-summary-configured">@summary.Configured</dd></div>
                <div><dt>Source suggestions</dt><dd data-testid="ip-summary-suggestions">@(suggestions.Available ? suggestions.Total.ToString() : "Unavailable")</dd></div>
                <div><dt>Runtime evidence</dt><dd><span class="ip-pill ip-pill-@IntegrationsOverviewPresentation.Tone(runtime)" data-testid="ip-summary-runtime">@IntegrationsOverviewPresentation.Label(runtime)</span></dd></div>
            </dl>
            @* The create action belongs to Configured integrations (its empty state, or its header); the summary stays informational. *@
            @if (_catalog.Integrations.Count > 0 && suggestions.Available && suggestions.Total > 0)
            {
                <div class="ip-actions-row">
                    <button type="button" class="btn-secondary" data-testid="ip-review-suggestions" @onclick="OpenSuggestions">Review source suggestions</button>
                </div>
            }
            <p class="ip-save-note" data-testid="ip-save-note">Changes are saved immediately and are not affected by the Target Environment Save/Cancel actions.</p>
            <p class="ip-save-status ip-save-status-@_saveState.ToString().ToLowerInvariant()" role="status" aria-live="polite" data-testid="ip-save-status" data-state="@_saveState">@_saveMessage</p>
        </section>

        @if (_editing is { } editing)
        {
            <IntegrationDefinitionEditor Original="editing.Original" Platforms="_catalog.Platforms" Templates="_templates" OnSave="SaveAsync" OnCancel="CancelEdit"
                                         Binding="@(editing.Original is { } edited ? _bindings.FirstOrDefault(b => b.IntegrationId == edited.Id) : null)" />
            @if (_saveError is { } saveError) { <p class="ip-banner ip-banner-error" role="alert" data-testid="ip-save-error">@saveError</p> }
        }
        @if (_bindingOutcome is { } outcome)
        {
            <p class="@(outcome.Failed ? "ip-banner ip-banner-error" : "ip-notice")" role="@(outcome.Failed ? "alert" : "status")" data-testid="ip-binding-outcome" data-failed="@(outcome.Failed ? "true" : "false")">@outcome.Text
                <a class="ip-link" href="/integration-quality-review?view=evidence" data-testid="ip-binding-outcome-iqr">@(outcome.Failed ? "Bind in IQR Evidence" : "Open IQR Evidence")</a></p>
        }

        var filtered = SourceRows(Filter());
        var mappingChecks = MappingEvidence.For(Profile.Id);
        <section class="ip-section" aria-labelledby="ip-configured-heading" data-testid="ip-configured">
            <div class="ip-section-head">
                <h3 id="ip-configured-heading">Configured integrations</h3>
                @if (_catalog.Integrations.Count > 0 && _editing is null)
                {
                    <button type="button" class="btn-primary" id="ip-add-trigger" data-testid="ip-add" @ref="_addTrigger" @onclick="BeginAdd">Add integration</button>
                }
            </div>
            @if (_catalog.Integrations.Count == 0)
            {
                <div class="ip-empty" data-testid="ip-empty">
                    <p><strong>No integrations configured</strong></p>
                    <p class="ip-muted" data-testid="ip-empty-suggestions">@(suggestions.Available
                        ? suggestions.Total == 0 ? "No integration candidates were found from Source Analysis." : $"{suggestions.Total} integration candidate{(suggestions.Total == 1 ? "" : "s")} found from Source Analysis ({suggestions.StronglySupported} strongly supported)."
                        : "Source suggestions unavailable — no source snapshot is linked.")</p>
                    @if (_editing is null)
                    {
                        <div class="ip-actions-row">
                            @if (suggestions.Available && suggestions.Total > 0) { <button type="button" class="btn-primary" data-testid="ip-empty-review" @onclick="OpenSuggestions">Review suggestions</button> }
                            <button type="button" class="@(suggestions.Available && suggestions.Total > 0 ? "btn-secondary" : "btn-primary")" id="ip-add-trigger" data-testid="ip-empty-add" @ref="_addTrigger" @onclick="BeginAdd">Add integration</button>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="ip-filters" role="group" aria-label="Filter configured integrations">
                    <label class="ip-field-inline">Search <input type="search" class="form-control" data-testid="ip-search" @bind="_search" @bind:event="oninput" placeholder="Name, channel or consumer" /></label>
                    <label class="ip-field-inline">Mapping
                        <select class="form-control" data-testid="ip-filter-mapping" @bind="_mappingFilter">
                            <option value="">All</option>
                            @foreach (var category in Enum.GetValues<MappingCategory>()) { <option value="@category">@SourceIntegrationsPresentation.Label(category)</option> }
                        </select>
                    </label>
                    <label class="ip-field-inline">Configuration
                        <select class="form-control" data-testid="ip-filter-state" @bind="_stateFilter">
                            <option value="">All</option>
                            @foreach (var s in Enum.GetValues<IntegrationConfigurationState>()) { <option value="@s">@IntegrationConfigurationRules.Label(s)</option> }
                        </select>
                    </label>
                    @if (summary.NeedsConfirmation > 0)
                    {
                        <button type="button" class="ip-link" data-testid="ip-review-mappings" @onclick="ReviewMappings">@summary.NeedsConfirmation mapping@(summary.NeedsConfirmation == 1 ? "" : "s") need confirmation</button>
                    }
                    @if (IntegrationsOverviewPresentation.SourceConflicts(_sources) is var sourceConflicts and > 0)
                    {
                        <span class="ip-pill ip-pill-attention" data-testid="ip-source-conflicts" title="The configured consumer is kept until a person decides; nothing is overwritten from source.">@sourceConflicts configured mapping@(sourceConflicts == 1 ? " differs" : "s differ") from source · Needs review</span>
                    }
                </div>
                @if (Filter() != new SourceIntegrationFilter())
                {
                    <p class="ip-muted" data-testid="ip-active-filter">Active filter: @ActiveFilter() <button type="button" class="ip-link" data-testid="ip-clear-filters" @onclick="ClearFilters">Clear filters</button></p>
                }
                <p class="ip-sr" role="status" aria-live="polite" data-testid="ip-mapping-announcement">@_mappingAnnouncement</p>
                @if (filtered.Count == 0)
                {
                    <p class="ip-empty" data-testid="ip-no-match">@(_stateFilter == nameof(IntegrationConfigurationState.NeedsConfirmation) && summary.NeedsConfirmation == 0 ? "No mappings require confirmation." : "No integration matches the filter.")</p>
                }
                else
                {
                    <div class="ip-tablewrap" tabindex="0" role="region" aria-label="Configured integrations table">
                        <table class="ip-table" data-testid="ip-table">
                            <thead><tr><th scope="col">Integration</th><th scope="col">Type</th><th scope="col">Producer / source</th><th scope="col">Consumer / destination</th><th scope="col">Configuration</th><th scope="col">Source evidence</th><th scope="col">Runtime evidence</th><th scope="col"><span class="ip-sr">Actions</span></th></tr></thead>
                            <tbody>
                                @foreach (var (row, src) in filtered)
                                {
                                    var open = _viewing == row.Definition.Id;
                                    var note = SourceIntegrationsPresentation.SourceNote(src.Match);
                                    var rowRuntime = IntegrationsOverviewPresentation.Runtime(IntegrationsPanePresentation.Platform(_catalog, row.Definition));
                                    <tr @key="row.Definition.Id" data-testid="ip-row" data-integration-id="@row.Definition.Id" data-configuration="@row.Configuration" data-mapping-category="@src.Mapping" data-source-match="@(src.Match?.State.ToString() ?? "")" data-origin="@row.Definition.Origin">
                                        <th scope="row" class="ip-cell-source"><strong data-testid="ip-row-source">@src.Entity</strong>@if (!row.Definition.Enabled) { <span class="ip-pill ip-pill-muted">Disabled</span> }
                                            @if (src.Qualifier is { } qualifier) { <span class="ip-cell-sub">@qualifier</span> }
                                            <span class="ip-cell-sub"><span class="ip-pill ip-pill-muted ip-origin" data-testid="ip-row-origin" title="Where this configured record came from">@IntegrationsOverviewPresentation.Origin(row.Definition)</span></span></th>
                                        <td data-testid="ip-row-channel"><span class="ip-cell-sub ip-cell-first">@SourceIntegrationLabels.Transport(src.Transport)</span><span class="ip-mono ip-nowrap" title="@row.Topic">@SourceIntegrationsPresentation.ChannelShort(row.Topic)</span></td>
                                        <td data-testid="ip-row-producer"><span class="ip-cell-first">@src.Pattern</span><span class="ip-cell-sub">@src.Capture@if (src.CaptureDetected) { <span class="ip-detected" title="Detected from source"><span aria-hidden="true"> ◆</span><span class="ip-sr"> (detected from source)</span></span> }</span></td>
                                        <td data-testid="ip-row-consumer" data-mapping="@row.MappingState"><span class="ip-cell-first">@row.Consumer</span>
                                            <span class="ip-pill ip-pill-@SourceIntegrationsPresentation.Tone(src.Mapping)" data-testid="ip-row-mapping" title="@SourceIntegrationsPresentation.Meaning(src.Mapping, row.Consumer == "Not assigned" ? null : row.Consumer)">@SourceIntegrationsPresentation.Label(src.Mapping)</span>
                                            @if (note is { } n) { <span class="ip-pill ip-pill-@n.Tone ip-source-note" data-testid="ip-row-source-note" title="@n.Detail">@n.Label</span> }
                                        </td>
                                        <td><span class="ip-pill ip-pill-@IntegrationsPanePresentation.StateTone(row.Configuration)" data-testid="ip-row-configuration" title="@row.ConfigurationDetail">@IntegrationConfigurationRules.Label(row.Configuration)</span></td>
                                        @{ var binding = _bindings.FirstOrDefault(item => item.IntegrationId == row.Definition.Id); }
                                        <td data-testid="ip-row-source-evidence" data-bound="@(binding is null ? "false" : "true")">
                                            @* The canonical per-integration source evidence is owned by Integration Quality Review; shown here, never chosen here. *@
                                            <span class="ip-pill ip-pill-@(binding is null ? "muted" : "ready")">@(binding is null ? "Not bound" : "Bound")</span>
                                            @if (binding is not null) { <span class="ip-cell-sub ip-wrap" title="Bound in Integration Quality Review">@binding.ArchiveName</span> }
                                            <a class="ip-link" href="/integration-quality-review?view=evidence" data-testid="ip-row-source-evidence-open" aria-label="@($"Open IQR evidence for {src.Entity}")">@(binding is null ? "Bind in IQR Evidence" : "Open IQR Evidence")</a></td>
                                        <td data-testid="ip-row-runtime"><span class="ip-pill ip-pill-@IntegrationsOverviewPresentation.Tone(rowRuntime)">@IntegrationsOverviewPresentation.Label(rowRuntime)</span>
                                            @if (rowRuntime != RuntimeEvidenceStatus.Configured && IntegrationsPanePresentation.Platform(_catalog, row.Definition) is { } rowPlatform)
                                            { <button type="button" class="ip-link" data-testid="ip-row-runtime-configure" aria-label="@($"Configure runtime evidence for {src.Entity}")" @onclick="() => BeginRuntime(rowPlatform)">Configure</button> }</td>
                                        <td class="ip-actions">
                                            <a class="ip-link" href="/integration-quality-review" data-testid="ip-row-iqr" aria-label="@($"Review {src.Entity} in Integration Quality Review")">Review</a>
                                            @if (row.Configuration == IntegrationConfigurationState.NeedsConfirmation)
                                            {
                                                <button type="button" class="ip-link ip-test" data-testid="ip-test-mapping" aria-label="@(row.MappingState == ConsumerMappingState.Suggested ? $"Test suggested mapping for {src.Entity} and {row.Consumer}" : $"Test mapping for {src.Entity} (consumer not assigned)")" disabled="@_mappingBusy.Contains(row.Definition.Id)" @onclick="() => TestMappingAsync(row.Definition)">Test mapping</button>
                                                @if (_mappingBusy.Contains(row.Definition.Id)) { <span class="ip-muted" data-testid="ip-mapping-loading">Testing mapping…</span> }
                                            }
                                            @if (row.MappingState == ConsumerMappingState.Suggested)
                                            { <button type="button" class="ip-link" data-testid="ip-inline-confirm" aria-label="@($"Confirm {row.Consumer} as consumer for {src.Entity}")" disabled="@(_saveState == SaveState.Saving || _mappingBusy.Contains(row.Definition.Id))" @onclick="() => BeginConfirm(row.Definition, null)">Confirm</button> }
                                            else if (src.Match is { State: SourceMatchState.SourceSuggestion, SourceConsumer: { } sourceConsumer } && src.Mapping == MappingCategory.Unassigned)
                                            { <button type="button" class="ip-link" data-testid="ip-review-suggestion" aria-label="@($"Review source suggestion {sourceConsumer} for {src.Entity}")" disabled="@(_saveState == SaveState.Saving)" @onclick="() => BeginConfirm(row.Definition, sourceConsumer)">Review suggestion</button> }
                                            @if (mappingChecks.TryGetValue(row.Definition.Id, out var mappingResult))
                                            { <div class="ip-mapping-result"><span class="ip-pill ip-pill-@(mappingResult.OverallState == IntegrationMappingEvidenceState.Error ? "attention" : "muted")" data-testid="ip-mapping-result" data-state="@mappingResult.OverallState">@IntegrationMappingEvidenceCheck.Label(mappingResult.OverallState)</span><button type="button" class="ip-link" data-testid="ip-view-evidence" aria-expanded="@(_evidenceViewing == row.Definition.Id ? "true" : "false")" aria-controls="@($"ip-evidence-{Slug(row.Definition.Id)}")" @onclick="() => _evidenceViewing = _evidenceViewing == row.Definition.Id ? null : row.Definition.Id">View evidence</button></div> }
                                            <button type="button" class="ip-link" data-testid="ip-row-view" aria-expanded="@(open ? "true" : "false")" aria-controls="@($"ip-detail-{Slug(row.Definition.Id)}")" aria-label="@($"View {src.Entity}")" @onclick="() => _viewing = open ? null : row.Definition.Id">View</button>
                                            <details class="ip-menu" data-testid="ip-actions-menu"><summary aria-label="@($"More actions for {src.Entity}")" title="More actions">More</summary><div class="ip-menu-items">
                                                <button type="button" class="ip-link" data-testid="ip-row-edit" disabled="@(_editing is not null)" @onclick="() => BeginEdit(row.Definition)">Edit</button>
                                                @if (row.MappingState == ConsumerMappingState.Suggested) { <button type="button" class="ip-link" @onclick="() => BeginConfirm(row.Definition, null)">Confirm mapping</button> }
                                                <button type="button" class="ip-link" @onclick="() => ToggleEnabledAsync(row.Definition)">@(row.Definition.Enabled ? "Disable" : "Enable")</button>
                                                <button type="button" class="ip-link" @onclick="() => ManageContracts(row.Definition)">Manage contracts</button>
                                                <button type="button" class="ip-link ip-link-danger" @onclick="() => { _viewing = row.Definition.Id; _confirmingDelete = row.Definition.Id; }">Delete</button>
                                            </div></details>
                                        </td>
                                    </tr>
                                    @if (_confirming is { } confirming && confirming.IntegrationId == row.Definition.Id)
                                    {
                                        var candidate = src.Candidate;
                                        <tr class="ip-detail-row" data-testid="ip-confirm-row"><td colspan="7">
                                            <div class="ip-confirm-panel" role="group" aria-labelledby="ip-confirm-heading" data-testid="ip-confirm-panel">
                                                <h4 id="ip-confirm-heading" tabindex="-1" @ref="_confirmFocus">Confirm consumer mapping</h4>
                                                <dl class="ip-dl">
                                                    <div><dt>Integration</dt><dd>@row.Definition.DisplayName</dd></div>
                                                    <div><dt>Consumer to confirm</dt><dd data-testid="ip-confirm-consumer"><strong>@confirming.Consumer</strong></dd></div>
                                                    <div><dt>Current mapping</dt><dd>@SourceIntegrationsPresentation.Label(src.Mapping)@(row.Definition.Consumer.MappingSource is { } basis ? $" · {basis}" : "")</dd></div>
                                                    <div><dt>Source evidence</dt><dd data-testid="ip-confirm-evidence">@if (candidate is { ConsumerCandidate: not null })
                                                        { <text>@candidate.ConsumerCandidate · @SourceIntegrationsPresentation.Evidence(candidate.ConsumerEvidence) · source snapshot @(_sources?.Discovery?.ArchiveName)</text> }
                                                        else { <text>No source evidence for this consumer.</text> }</dd></div>
                                                </dl>
                                                <p class="ip-muted">Confirming records your decision. Source evidence, its confidence or a mapping test never confirm a mapping by themselves.</p>
                                                <div class="ip-mapping-actions">
                                                    <button type="button" class="btn-primary ip-btn-sm" data-testid="ip-confirm-mapping" disabled="@(_saveState == SaveState.Saving)" @onclick="() => ConfirmAsync(row.Definition, confirming)">Confirm mapping</button>
                                                    <button type="button" class="ip-link" data-testid="ip-confirm-cancel" @onclick="() => _confirming = null">Cancel</button>
                                                </div>
                                            </div>
                                        </td></tr>
                                    }
                                    @if (_evidenceViewing == row.Definition.Id && mappingChecks.TryGetValue(row.Definition.Id, out var evidence))
                                    {
                                        <tr class="ip-detail-row" id="@($"ip-evidence-{Slug(row.Definition.Id)}")" data-testid="ip-evidence"><td colspan="7">
                                            <IntegrationMappingEvidencePanel Result="evidence" OnConfigure="() => ConfigureFor(row.Definition)" CanConfigure="@(IntegrationsPanePresentation.Platform(_catalog, row.Definition) is not null)"
                                                ConsumerState="row.MappingState" CanConfirm="@(row.MappingState == ConsumerMappingState.Suggested && _saveState != SaveState.Saving)" OnConfirm="() => BeginConfirm(row.Definition, null)" />
                                        </td></tr>
                                    }
                                    @if (open)
                                    {
                                        var definition = row.Definition;
                                        <tr class="ip-detail-row" id="@($"ip-detail-{Slug(definition.Id)}")" data-testid="ip-row-detail">
                                            <td colspan="7">
                                                <p class="ip-muted" data-testid="ip-detail-source">Source evidence: @(src.Match is { } m ? $"{SourceIntegrationLabels.Match(m.State)} — {m.Detail}" : "Not analyzed")
                                                    <a class="ip-link" href="/source-analysis" data-testid="ip-detail-open-source">Open Source Analysis</a></p>
                                                <dl class="ip-dl ip-dl-technical">
                                                    <div><dt>Display name</dt><dd>@definition.DisplayName</dd></div>
                                                    <div><dt>Configured channel</dt><dd class="ip-mono">@(row.Topic ?? "Not configured")</dd></div>
                                                    <div><dt>Source</dt><dd class="ip-mono">@(definition.SourceResource ?? "Not configured")</dd></div>
                                                    <div><dt>Consumer group</dt><dd class="ip-mono" data-testid="ip-detail-consumer-group">@(definition.ConsumerGroup ?? "Unknown / not configured")</dd></div>
                                                    <div><dt>Consumer mapping</dt><dd data-testid="ip-detail-mapping">@IntegrationConfigurationRules.MappingLabel(row.MappingState)@(definition.Consumer.MappingSource is { } mappingSource ? $" · {mappingSource}" : "")@(definition.Consumer.MappingConfirmedAt is { } at ? $" · {at.ToUniversalTime():yyyy-MM-dd HH:mm} UTC" : "")</dd></div>
                                                    <div><dt>Origin</dt><dd data-testid="ip-detail-origin">@IntegrationsOverviewPresentation.Origin(definition)</dd></div>
                                                    @if (definition.Consumer.ContainerApp is { } app) { <div><dt>Container app</dt><dd class="ip-mono">@app</dd></div> }
                                                    @if (definition.Consumer.ManagedIdentity is { } mi) { <div><dt>Managed identity</dt><dd class="ip-mono">@mi</dd></div> }
                                                    <div><dt>Producer auth</dt><dd>@IntegrationConfigurationRules.AuthLabel(definition.ProducerAuthentication)</dd></div>
                                                    <div><dt>Consumer auth</dt><dd>@IntegrationConfigurationRules.AuthLabel(definition.ConsumerAuthentication)</dd></div>
                                                    <div><dt>Contract</dt><dd>@IntegrationConfigurationRules.ContractLabel(definition.ContractRelationship)</dd></div>
                                                    <div><dt>Health / worker URL</dt><dd>@(definition.HealthUrl ?? "Not configured") / @(definition.WorkerUrl ?? "Not configured")</dd></div>
                                                    <div><dt>Configuration status</dt><dd>@IntegrationConfigurationRules.Label(row.Configuration) · @row.ConfigurationDetail</dd></div>
                                                    <div><dt>Review readiness (IQR)</dt><dd>@row.ReviewReadiness · @row.ReviewReadinessDetail</dd></div>
                                                </dl>

                                                @if (definition.Consumer.MappingState == ConsumerMappingState.Suggested && definition.Consumer.DisplayName is { } suggested)
                                                {
                                                    <div class="ip-mapping" data-testid="ip-mapping-suggested">
                                                        <p class="ip-muted">Suggested consumer: <strong>@suggested</strong> — @(definition.Consumer.MappingSource ?? "suggested source"). Receiver rights never confirm a mapping; a person does.</p>
                                                        <div class="ip-mapping-actions">
                                                            <button type="button" class="btn-secondary ip-btn-sm" data-testid="ip-mapping-confirm" @onclick="() => BeginConfirm(definition, null)">Confirm @suggested</button>
                                                            <button type="button" class="ip-link" data-testid="ip-mapping-change" @onclick="() => BeginEdit(definition)">Change</button>
                                                        </div>
                                                    </div>
                                                }

                                                <div class="ip-contracts" data-testid="ip-contracts" role="group" tabindex="-1" @ref="_contractsFocus" id="@($"ip-contracts-{Slug(definition.Id)}")" aria-label="@($"Event contracts for {definition.DisplayName}")">
                                                    <h4>Event contracts (JSON Schema)</h4>
                                                    @foreach (var role in new[] { IntegrationContractRole.Producer, IntegrationContractRole.Consumer })
                                                    {
                                                        var artifact = _contracts.FirstOrDefault(c => c.IntegrationId == definition.Id && c.Role == role);
                                                        var errorId = $"ip-contract-error-{Slug(definition.Id)}-{role.ToString().ToLowerInvariant()}";
                                                        var contractError = _contractErrors.TryGetValue((definition.Id, role), out var ce) ? ce : null;
                                                        <div class="ip-contract" data-testid="ip-contract" data-role="@role" data-configured="@(artifact is not null ? "true" : "false")">
                                                            <span class="ip-contract-role">@role contract</span>
                                                            @if (artifact is not null)
                                                            {
                                                                <span class="ip-contract-file" data-testid="ip-contract-file">@artifact.FileName</span>
                                                                <span class="ip-muted ip-mono">sha256 @artifact.ShortHash · @artifact.FieldCount field(s)@(artifact.Version is { } v ? $" · {v}" : "")</span>
                                                            }
                                                            else { <span class="ip-muted">None</span> }
                                                            <label class="ip-file-button">
                                                                <InputFile class="ip-file-input" accept=".json" OnChange="args => UploadContractAsync(definition, role, args)" aria-describedby="@(contractError is not null ? errorId : null)" aria-label="@($"{(artifact is null ? "Upload" : "Replace")} {role.ToString().ToLowerInvariant()} contract")" data-testid="ip-contract-input" />
                                                                <span aria-hidden="true">@(artifact is null ? "Upload" : "Replace")</span>
                                                            </label>
                                                            @if (artifact is not null) { <button type="button" class="ip-link ip-link-danger" data-testid="ip-contract-remove" @onclick="() => RemoveContractAsync(definition, role)" aria-label="@($"Remove {role.ToString().ToLowerInvariant()} contract {artifact.FileName}")">Remove</button> }
                                                            @if (contractError is not null) { <p class="ip-field-error" id="@errorId" role="alert" data-testid="ip-contract-error">Invalid contract: @contractError</p> }
                                                        </div>
                                                    }
                                                    <p class="ip-muted">Compatibility needs both contracts. Uploading both marks the relationship "Both available" — never "Verified" automatically.</p>
                                                </div>

                                                <p class="ip-detail-actions">
                                                    <button type="button" class="ip-link" data-testid="ip-row-toggle-enabled" @onclick="() => ToggleEnabledAsync(definition)">@(definition.Enabled ? "Disable" : "Enable")</button>
                                                    <span aria-hidden="true">·</span>
                                                    @if (_confirmingDelete == definition.Id)
                                                    {
                                                        <span class="ip-confirm" role="group" aria-label="Confirm delete" data-testid="ip-delete-confirm">
                                                            <span>Delete <strong>@definition.DisplayName</strong>? Review history keeps its snapshots.</span>
                                                            <button type="button" class="ip-link ip-link-danger" data-testid="ip-row-delete-confirm" @onclick="() => DeleteAsync(definition)">Delete</button>
                                                            <button type="button" class="ip-link" data-testid="ip-row-delete-cancel" @onclick="() => _confirmingDelete = null">Cancel</button>
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="ip-link ip-link-danger" data-testid="ip-row-delete" @onclick="() => _confirmingDelete = definition.Id">Delete</button>
                                                    }
                                                </p>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            <p class="ip-workflow"><a class="ip-link" href="/integration-quality-review" data-testid="ip-open-iqr">Open Integration Quality Review</a> <span class="ip-muted">Review can run with limitations while mapping or runtime evidence is unavailable.</span></p>
        </section>

        <section class="ip-section" aria-labelledby="ip-suggestions-heading" data-testid="ip-suggestions">
            <h3 id="ip-suggestions-heading">Suggestions from Source Analysis</h3>
            @if (!suggestions.Available)
            {
                <p class="ip-muted" data-testid="ip-suggestions-unavailable"><strong>Unavailable.</strong> No source snapshot is linked. Configured integrations work without it.
                    <a class="ip-link" href="/source-analysis" data-testid="ip-open-source-analysis">Open Source Analysis</a></p>
                @if (_sourcesError is { } sourcesError) { <p class="ip-muted" role="status" data-testid="ip-sources-error">@sourcesError</p> }
            }
            else
            {
                <p class="ip-muted" data-testid="ip-suggestions-note">Detected in source and not configured here. <strong>A suggestion is never automatically configured</strong> and never a confirmed mapping; adding one keeps it a suggestion until you confirm it.</p>
                <dl class="ip-suggestion-summary" data-testid="ip-suggestions-summary">
                    <div><dt>Candidates</dt><dd data-testid="ip-suggestions-total">@suggestions.Total</dd></div>
                    <div><dt>Strongly supported</dt><dd data-testid="ip-suggestions-strong">@suggestions.StronglySupported</dd></div>
                    <div><dt>Suggested</dt><dd data-testid="ip-suggestions-suggested">@suggestions.Suggested</dd></div>
                    <div><dt>Unassigned</dt><dd data-testid="ip-suggestions-unassigned">@suggestions.Unassigned</dd></div>
                    @if (suggestions.Conflicts > 0) { <div><dt>Conflict</dt><dd data-testid="ip-suggestions-conflicts">@suggestions.Conflicts</dd></div> }
                </dl>
                @if (suggestions.Total > 0)
                {
                    <button type="button" class="btn-secondary" data-testid="ip-suggestions-toggle" aria-expanded="@(_suggestionsOpen ? "true" : "false")" aria-controls="ip-suggestion-list" @onclick="() => _suggestionsOpen = !_suggestionsOpen">@(_suggestionsOpen ? "Hide suggestions" : "Review suggestions")</button>
                }
                @if (_suggestionsOpen)
                {
                    var shown = IntegrationsOverviewPresentation.Prioritized(_sources, _showAllSuggestions);
                    <div id="ip-suggestion-list" tabindex="-1" @ref="_suggestionsFocus" data-testid="ip-suggestion-list">
                        <p class="ip-muted" data-testid="ip-suggestion-filter">@(_showAllSuggestions ? $"Showing all {suggestions.Total} candidates." : $"Showing strongly supported mappings and conflicts ({shown.Count} of {suggestions.Total}).")
                            <button type="button" class="ip-link" data-testid="ip-suggestions-all" @onclick="() => _showAllSuggestions = !_showAllSuggestions">@(_showAllSuggestions ? "Show only strongly supported and conflicts" : $"Show all {suggestions.Total} candidates")</button></p>
                        @if (shown.Count == 0) { <p class="ip-muted" data-testid="ip-suggestions-none">No strongly supported mapping or conflict. Show all candidates to review the rest.</p> }
                        <ul class="ip-suggestion-items">
                            @foreach (var c in shown)
                            {
                                var strength = IntegrationsOverviewPresentation.Strength(c);
                                var configured = IntegrationsOverviewPresentation.AlreadyConfigured(_catalog, c);
                                <li class="ip-suggestion" data-testid="ip-suggestion" data-strength="@strength" data-candidate="@c.Id">
                                    <div class="ip-suggestion-main">
                                        <strong>@(c.SourceEntity ?? SourceIntegrationsPresentation.ChannelShort(c.ChannelName))</strong>
                                        <span class="ip-cell-sub" data-testid="ip-suggestion-kind">@IntegrationsOverviewPresentation.SuggestionKind(c)</span>
                                        <span class="ip-cell-sub">@SourceIntegrationLabels.Transport(c.Transport) → @(c.ConsumerCandidate ?? "consumer not found in source") · <span class="ip-mono" title="@c.ChannelName">@SourceIntegrationsPresentation.ChannelShort(c.ChannelName)</span></span>
                                        <span class="ip-cell-sub ip-muted ip-wrap" data-testid="ip-suggestion-origin">@IntegrationsOverviewPresentation.DetectedIn(c, _sources?.Discovery?.ArchiveName)</span>
                                    </div>
                                    <span class="ip-pill ip-pill-@IntegrationsOverviewPresentation.Tone(strength)" data-testid="ip-suggestion-strength">@IntegrationsOverviewPresentation.Label(strength)</span>
                                    @if (configured) { <span class="ip-muted" data-testid="ip-suggestion-configured">Already configured</span> }
                                    else { <button type="button" class="btn-secondary ip-btn-sm" data-testid="ip-suggestion-add" aria-label="@($"Add integration {c.SourceEntity ?? c.ChannelName}")" disabled="@(_saveState == SaveState.Saving)" @onclick="() => AddSuggestionAsync(c)">Add this integration</button> }
                                </li>
                            }
                        </ul>
                    </div>
                }
            }
        </section>

        <section class="ip-section ip-source-card" aria-labelledby="ip-source-heading" data-testid="ip-source-evidence">
            <h3 id="ip-source-heading">Source evidence</h3>
            @if (_sources?.Discovery is { } discovery)
            {
                <p data-testid="ip-source-summary"><span class="ip-mono" data-testid="ip-source-archive">@discovery.ArchiveName</span> · Analysis: <span data-testid="ip-source-status">@discovery.Status</span>
                    <span class="ip-muted">· Updated @discovery.AnalyzedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC</span></p>
            }
            else { <p class="ip-muted" data-testid="ip-source-summary">No source snapshot is linked to this environment.</p> }
            <p class="ip-actions-row">
                <a class="btn-secondary ip-btn-link" href="/source-analysis" data-testid="ip-source-open">Open Source Analysis</a>
            </p>
            <ReviewDisclosure Text="View details" CollapseText="Hide details" TestId="ip-source-details" Class="disclosure-inline">
            @if (_terraform is { SourceAnalysisEnabled: true } terraform)
            {
                var reviews = IntegrationsOverviewPresentation.Reviews(terraform);
                <div class="ip-terraform" data-testid="ip-terraform" data-state="@(terraform.TerraformAvailable ? reviews.Count > 0 ? "review" : "available" : "absent")">
                    @if (!terraform.TerraformAvailable)
                    {
                        <p data-testid="ip-terraform-status"><strong>Terraform:</strong> Not provided. Environment-specific Azure values (namespaces, resource groups, grants) are not observed from source@(_catalog.Platforms.Any(p => p.Origin == IntegrationRecordOrigin.Seed) ? "; seeded values are seeded assumptions, not verified" : "").</p>
                    }
                    else
                    {
                        var compared = terraform.Values.Count(v => v.Comparison.State is SourceComparisonState.Matches || IntegrationsOverviewPresentation.NeedsReview(v.Comparison.State));
                        var matching = terraform.Values.Count(v => v.Comparison.State == SourceComparisonState.Matches);
                        <p data-testid="ip-terraform-status"><strong>Terraform:</strong> <span class="ip-mono">@terraform.ArchiveName</span> · @matching of @compared compared value@(compared == 1 ? "" : "s") match source@(reviews.Count > 0 ? $" · {reviews.Count} need{(reviews.Count == 1 ? "s" : "")} review" : "").
                            <span class="ip-muted">Declared in source is not deployed; neither value is changed automatically.</span></p>
                        @if (reviews.Count > 0)
                        {
                            <ul class="ip-terraform-reviews" data-testid="ip-terraform-reviews">
                                @foreach (var r in reviews)
                                {
                                    <li data-testid="ip-terraform-review"><strong>@r.SubjectName</strong> · @r.Comparison.Field: configured <span class="ip-mono">@r.Comparison.ConfiguredValue</span>
                                        @if (r.Comparison.Candidates.Count > 0) { <span>, Terraform declares <span class="ip-mono">@string.Join(", ", r.Comparison.Candidates.Select(c => c.Name).Distinct(StringComparer.OrdinalIgnoreCase).Take(3))</span></span> }
                                        <span class="ip-pill ip-pill-attention">@SourceInfrastructureComparer.Label(r.Comparison.State)</span></li>
                                }
                            </ul>
                        }
                    }
                </div>
            }
            <p class="ip-muted"><a class="ip-link" href="/source-analysis/application-messaging" data-testid="ip-open-messaging-evidence">Application messaging evidence</a> · bound per integration in <a class="ip-link" href="/integration-quality-review?view=evidence">Integration Quality Review → Evidence</a></p>
            </ReviewDisclosure>
        </section>

        @if (_catalog.Templates.FirstOrDefault() is { } offer)
        {
            <section class="ip-section ip-helper" aria-labelledby="ip-helper-heading" data-testid="ip-template">
                <p class="ip-helper-kind" data-testid="ip-template-kind">Environment helper — optional, project-specific, never applied automatically</p>
                <h3 id="ip-helper-heading">@offer.Name</h3>
                <p class="ip-muted">@offer.Description @offer.SuggestionReason It is never applied automatically and never overwrites an existing integration.</p>
                <div class="ip-actions-row">
                    <button type="button" class="btn-secondary" data-testid="ip-template-review" aria-expanded="@(_templateReview ? "true" : "false")" aria-controls="ip-template-items" @onclick="() => _templateReview = !_templateReview">@(_templateReview ? "Hide template" : "Review template")</button>
                    <button type="button" class="btn-secondary" data-testid="ip-template-apply" @onclick="() => ApplyTemplateAsync(offer)" disabled="@(_editing is not null)">Apply</button>
                </div>
                @if (_templateReview)
                {
                    <ul class="ip-template-items" id="ip-template-items" data-testid="ip-template-items">
                        @foreach (var item in offer.Items)
                        {
                            <li data-testid="ip-template-item" data-provenance="@item.Provenance"><strong>@item.Kind · @item.Name</strong> <span class="ip-pill ip-pill-muted">@IntegrationsOverviewPresentation.Provenance(item.Provenance)</span>
                                <span class="ip-cell-sub">@item.Detail</span></li>
                        }
                    </ul>
                    <p class="ip-muted">Existing records are never overwritten, and values Source Analysis discovers (hubs, consumers, Service Bus entities, routes) are not added.</p>
                }
            </section>
        }
        @if (_catalog.AppliedTemplateId is { } appliedTemplate)
        {
            <p class="ip-muted" data-testid="ip-template-applied">Extension helper @(_appliedTemplateNames.GetValueOrDefault(appliedTemplate) ?? _catalog.Templates.FirstOrDefault(t => t.Id == appliedTemplate)?.Name ?? $"template {appliedTemplate}") applied. Its records are ordinary integrations (origin “Seed”) you can edit or delete; values from it are template values, not discovered evidence.</p>
        }

        <section class="ip-section ip-advanced" aria-labelledby="ip-advanced-heading" data-testid="ip-advanced">
            <h3 id="ip-advanced-heading" class="ip-advanced-heading">
                <button type="button" class="ip-disclosure" data-testid="ip-advanced-toggle" aria-expanded="@(_advancedOpen ? "true" : "false")" aria-controls="ip-advanced-body" @onclick="() => _advancedOpen = !_advancedOpen">Advanced</button>
            </h3>
            @if (!_advancedOpen) { <p class="ip-muted">Runtime (platforms and runtime evidence) · Messaging (evidence scope and links) · Diagnostics (source discovery).</p> }
            else
            {
                <div id="ip-advanced-body" data-testid="ip-advanced-body">
                    <h4 data-testid="ip-advanced-runtime">Runtime</h4>
                    <p class="ip-muted">Platforms and runtime evidence setup. Configured ≠ observed: runtime evidence is read only when a review runs.</p>
                    <p class="ip-muted" data-testid="ip-advanced-execution"><span class="ip-pill ip-pill-@EventHubRuntimeEvidencePresentation.ExecutionTone(_catalog.AzureRuntimeEnabled)" data-testid="ip-summary-azure">@EventHubRuntimeEvidencePresentation.ExecutionBadge(_catalog.AzureRuntimeEnabled)</span></p>
                    @if (_catalog.Platforms.Count == 0) { <p class="ip-muted" data-testid="ip-no-platforms">No platform is configured. Runtime evidence is set up per platform once an integration uses one.</p> }
                    @foreach (var platform in _catalog.Platforms)
                    {
                        <section class="ip-card ip-platform" data-testid="ip-platform" aria-labelledby="@($"ip-platform-{Slug(platform.Id)}")">
                            <h5 id="@($"ip-platform-{Slug(platform.Id)}")">@platform.Name <span class="ip-pill ip-pill-muted">@IntegrationConfigurationRules.KindLabel(platform.Kind)</span>
                                @if (platform.Origin == IntegrationRecordOrigin.Seed) { <span class="ip-pill ip-pill-muted" data-testid="ip-platform-origin" title="Template value: a seeded assumption, not discovered or verified evidence">@(platform.UserModified ? "Seed · modified" : "Seed")</span> }
                                @if (IntegrationsOverviewPresentation.Support(_terraform, platform) is var support and not TerraformSupport.NotCompared) { <span class="ip-pill ip-pill-@IntegrationsOverviewPresentation.Tone(support)" data-testid="ip-platform-terraform">@IntegrationsOverviewPresentation.Label(support)</span> }</h5>
                            @if (platform.Kind == IntegrationKind.IdentityProvisioning)
                            {
                                @* Identity provisioning (SCIM) is its own flow — never Event Hub CDC: stages with source and runtime evidence kept apart. *@
                                <ScimProvisioningPanel Profile="Profile" Platform="platform" Catalog="_catalog" SaveSettings="settings => SaveScimAsync(platform, settings)" />
                            }
                            else if (platform.Kind == IntegrationKind.ServiceBus)
                            {
                                @* Service Bus is its own transport: topology, runtime metadata and application routes — no Event Hub fields. *@
                                <ServiceBusPlatformPanel EnvironmentId="@Profile.Id" Platform="platform" Messaging="_messaging" AzureEnabled="_catalog.AzureRuntimeEnabled" OnConfigure="() => BeginRuntime(platform)"
                                    RuntimeEditor="@(_editingRuntime == platform.Id ? ServiceBusRuntimeForm(platform) : null)" />
                            }
                            else
                            {
                            <dl class="ip-dl">
                                <div><dt>Namespace</dt><dd class="ip-mono" data-testid="ip-platform-namespace">@(platform.Namespace ?? "Not configured")</dd></div>
                                <div><dt>Producer</dt><dd>@(platform.ProducerTechnology ?? "Not configured")</dd></div>
                                <div><dt>Default consumer auth</dt><dd data-testid="ip-platform-consumer-auth">@IntegrationConfigurationRules.AuthLabel(platform.DefaultConsumerAuthentication)</dd></div>
                                <div><dt>Monitoring</dt><dd>@(platform.MonitoringProvider ?? "Not configured")</dd></div>
                            </dl>
                            <ReviewDisclosure Text="View platform details" CollapseText="Hide platform details" TestId="@($"ip-platform-details-{Slug(platform.Id)}")" Class="disclosure-inline">
                                <dl class="ip-dl ip-dl-technical">
                                    <div><dt>Source DB</dt><dd>@(platform.SourceDatabase ?? "Not configured")</dd></div>
                                    <div><dt>Producer auth</dt><dd data-testid="ip-platform-producer-auth">@IntegrationConfigurationRules.AuthLabel(platform.ProducerAuthentication)</dd></div>
                                    <div><dt>FQDN</dt><dd class="ip-mono">@(platform.NamespaceFqdn ?? "Not configured")</dd></div>
                                    <div><dt>Resource group</dt><dd class="ip-mono">@(platform.ResourceGroup ?? "Not configured")</dd></div>
                                    <div><dt>Region</dt><dd>@(platform.Region ?? "Not configured")</dd></div>
                                    <div><dt>Topic prefix</dt><dd class="ip-mono">@(platform.TopicPrefix ?? "Not configured")</dd></div>
                                    @if (platform.SourceHost is not null) { <div><dt>Source host / port</dt><dd class="ip-mono">@platform.SourceHost:@platform.SourcePort</dd></div> }
                                    <div><dt>Technical owner</dt><dd>@(platform.TechnicalOwner ?? "Not configured")</dd></div>
                                    <div><dt>Monitoring URL</dt><dd>@(platform.MonitoringUrl ?? "Not configured")</dd></div>
                                    <div><dt>Runbook URL</dt><dd>@(platform.RunbookUrl ?? "Not configured")</dd></div>
                                    <div><dt>Default partitions / retention</dt><dd>@(platform.DefaultPartitionCount?.ToString() ?? "—") / @(platform.DefaultRetentionDays is { } days ? $"{days} days" : "—")</dd></div>
                                </dl>
                            </ReviewDisclosure>
                            @* Runtime execution, the four counted evidence sources, supporting settings and evaluation policy are separate groups. *@
                            <EventHubRuntimeEvidenceOverview Platform="platform" AzureEnabled="_catalog.AzureRuntimeEnabled"
                                SourcesExpanded="@(_runtimeExpanded == platform.Id)" SourcesExpandedChanged="@(value => _runtimeExpanded = value ? platform.Id : null)"
                                OnConfigureAccess="() => BeginRuntime(platform)" OnEditSources="() => BeginRuntime(platform)"
                                SavedMessage="@(_runtimeSaved == platform.Id ? EventHubRuntimeEvidencePresentation.SavedSummary(platform, _catalog.AzureRuntimeEnabled) : null)"
                                EditContent="@(_editingRuntime == platform.Id ? RuntimeForm(platform) : null)" />
                            }
                        </section>
                    }

                    <h4 data-testid="ip-advanced-messaging">Messaging</h4>
                    <p class="ip-muted" data-testid="ip-messaging-semantics">Configured (in this catalog) ≠ discovered (in source) ≠ linked (bound to a consumer here) ≠ observed (at runtime). Source and configuration evidence never imply runtime observation.</p>
                    <ApplicationMessagingPanel EnvironmentId="@Profile.Id" Catalog="_catalog" Evidence="_messaging" EvidenceChanged="set => _messaging = set" View="ApplicationMessagingView.Configuration" />

                    <h4 data-testid="ip-advanced-diagnostics">Diagnostics</h4>
                    <div class="ip-actions-row">
                        <button type="button" class="btn-secondary" data-testid="ip-discover" disabled="@_discovering" @onclick="DiscoverAsync">@(_discovering ? "Discovering…" : "Re-run source discovery")</button>
                    </div>
                    @if (_discoveryReport is { } discoveryReport)
                    {
                        <div class="ip-discovery-report" role="status" data-testid="ip-discovery-report">
                            <strong>Discovery result</strong>
                            <ul>@foreach (var line in discoveryReport) { <li>@line</li> }</ul>
                        </div>
                    }
                    @{ var technical = SourceIntegrationsPresentation.TechnicalChannels(_catalog, _sources); }
                    @if (technical.Count > 0)
                    {
                        <ReviewDisclosure Text="Technical integration channels" CollapseText="Hide technical integration channels" Hint="@($"{technical.Count} excluded")" TestId="ip-technical" Class="disclosure-inline">
                            <p class="ip-muted" data-testid="ip-technical-subtitle">Platform/support channels excluded from business integration counts.</p>
                            <div class="ip-tablewrap" tabindex="0" role="region" aria-label="Technical integration channels">
                                <table class="ip-table" data-testid="ip-technical-list">
                                    <thead><tr><th scope="col">Channel</th><th scope="col">Transport</th><th scope="col">Purpose</th><th scope="col">Reason excluded</th></tr></thead>
                                    <tbody>
                                        @foreach (var t in technical)
                                        {
                                            <tr data-testid="ip-technical-row"><th scope="row" class="ip-mono">@t.Name</th><td>@SourceIntegrationLabels.Transport(t.Transport)</td><td>@t.Purpose</td><td>@t.ExclusionReason <span class="ip-cell-sub">@t.Source</span></td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </ReviewDisclosure>
                    }
                </div>
            }
        </section>
    }
</div>

@code {
    [Parameter, EditorRequired] public FrontendAnalysisProfile Profile { get; set; } = new();

    /// <summary>Deep-link target from Integration Quality Review ("focus=" key): mappings, runtime or contracts. Applied once per value after load.</summary>
    [Parameter] public string? Focus { get; set; }

    private enum SaveState { Idle, Saving, Saved, Failed }

    private IntegrationCatalog? _catalog;
    private IReadOnlyList<IntegrationContractArtifact> _contracts = [];
    private ApplicationMessagingEvidenceSet? _messaging;
    private readonly Dictionary<(string, IntegrationContractRole), string> _contractErrors = [];
    private string? _loadError;
    private string? _saveError;
    private readonly List<string> _notices = [];
    private string _search = "";
    private string _stateFilter = "";
    private string _mappingFilter = "";
    /// <summary>Source suggestions are secondary: listed only on request, strongly supported and conflicts first.</summary>
    private bool _suggestionsOpen;
    private bool _showAllSuggestions;
    private bool _focusSuggestions;
    private ElementReference _suggestionsFocus;
    private bool _templateReview;
    /// <summary>Advanced (platforms and runtime setup, messaging scope and IQR links, source diagnostics) is collapsed by default.</summary>
    private bool _advancedOpen;
    /// <summary>The canonical per-integration source evidence (Integration Quality Review bindings), shown per row; never selected here.</summary>
    private IReadOnlyList<IntegrationEvidenceBinding> _bindings = [];
    private SourceIntegrationsReport? _sources;
    private IntegrationTerraformComparison? _terraform;
    private string? _sourcesError;
    private bool _discovering;
    private IReadOnlyList<string>? _discoveryReport;
    /// <summary>The mapping a person is about to confirm (an existing suggestion, or a source suggestion for an unassigned consumer).</summary>
    private sealed record PendingConfirmation(string IntegrationId, string Consumer, bool FromSource);
    private PendingConfirmation? _confirming;
    private ElementReference _confirmFocus;
    private bool _focusConfirm;
    private string? _appliedFocus;
    private string? _focusElementId;
    private string? _viewing;
    private string? _loadedFor;
    private string? _confirmingDelete;
    private string? _editingRuntime;
    private RuntimeModel _runtime = new();
    private string? _runtimeError;
    /// <summary>Platform whose Event Hub runtime sources were just saved (post-save summary).</summary>
    private string? _runtimeSaved;
    private EditState? _editing;
    private ElementReference _addTrigger;
    private bool _focusAddTrigger;
    /// <summary>The environment's Add-integration templates (read-only guidance; empty when unavailable — the manual form still works).</summary>
    private IReadOnlyList<IntegrationTemplateView> _templates = [];
    /// <summary>The result of an explicitly chosen evidence binding after save (bound, or failed with the integration kept).</summary>
    private sealed record BindingOutcome(bool Failed, string Text);
    private BindingOutcome? _bindingOutcome;
    private SaveState _saveState = SaveState.Idle;
    private string _saveMessage = "";
    private string? _runtimeExpanded;
    private string? _evidenceViewing;
    private string _mappingAnnouncement = "";
    private readonly HashSet<string> _mappingBusy = [];
    private CancellationTokenSource _mappingCancellation = new();
    private ElementReference _runtimeFocus;
    private ElementReference _contractsFocus;
    private bool _focusContracts;
    private bool _focusRuntime;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusRuntime) { _focusRuntime = false; await _runtimeFocus.FocusAsync(); }
        if (_focusContracts) { _focusContracts = false; await _contractsFocus.FocusAsync(); }
        if (_focusConfirm) { _focusConfirm = false; try { await _confirmFocus.FocusAsync(); } catch (InvalidOperationException) { } }
        if (_focusSuggestions) { _focusSuggestions = false; try { await _suggestionsFocus.FocusAsync(); } catch (InvalidOperationException) { } }
        if (_focusAddTrigger) { _focusAddTrigger = false; try { await _addTrigger.FocusAsync(); } catch (Exception ex) when (ex is InvalidOperationException or Microsoft.JSInterop.JSException) { } }
    }

    private void ReviewMappings() { ClearFilters(); _stateFilter = nameof(IntegrationConfigurationState.NeedsConfirmation); }
    private void ClearFilters() { _search = ""; _stateFilter = ""; _mappingFilter = ""; }

    private SourceIntegrationFilter Filter() => new(_search, _stateFilter, "", _mappingFilter);

    private void OpenSuggestions() { _suggestionsOpen = true; _focusSuggestions = true; }

    /// <summary>Adds a source suggestion as a configured integration. Origin = source suggestion; the mapping stays a suggestion until confirmed.</summary>
    private Task AddSuggestionAsync(SourceIntegrationCandidate candidate)
    {
        var definition = IntegrationsOverviewPresentation.FromCandidate(_catalog!, candidate, _sources?.Discovery?.SourceSnapshotId);
        return TrackAsync($"{definition.DisplayName} added from a source suggestion; its consumer mapping is not confirmed.", () => Api.CreateAsync(Profile.Id, definition));
    }

    /// <summary>Configured business integrations with their source side, filtered and ordered (needs configuration first, then confirmation).</summary>
    private List<(IntegrationRow Row, IntegrationsPaneRowSource Source)> SourceRows(SourceIntegrationFilter filter) =>
        SourceIntegrationsPresentation.Business(_catalog!)
            .Select(i => (Row: IntegrationsPanePresentation.Row(_catalog!, i), Source: IntegrationsPaneRowSource.For(i, _sources)))
            .Where(r => SourceIntegrationsPresentation.Matches(r.Row, filter, r.Source))
            .OrderBy(r => r.Row.Configuration switch { IntegrationConfigurationState.NeedsConfiguration => 0, IntegrationConfigurationState.NeedsConfirmation => 1, IntegrationConfigurationState.Ready => 2, _ => 3 })
            .ThenBy(r => r.Source.Entity, StringComparer.OrdinalIgnoreCase).ThenBy(r => r.Row.Definition.Id, StringComparer.Ordinal)
            .ToList();

    private string ActiveFilter() => string.Join(" · ", new[]
    {
        _mappingFilter.Length > 0 && Enum.TryParse<MappingCategory>(_mappingFilter, out var mapping) ? $"Mapping: {SourceIntegrationsPresentation.Label(mapping)}" : null,
        Enum.TryParse<IntegrationConfigurationState>(_stateFilter, out var state) ? IntegrationConfigurationRules.Label(state) : null,
        _search.Length > 0 ? $"Search: {_search}" : null,
    }.Where(x => x is not null));

    /// <summary>"Discover from source": re-runs source integration discovery on the stored snapshot and shows a compact result. Source-only.</summary>
    private async Task DiscoverAsync()
    {
        _discovering = true;
        _sourcesError = null;
        try
        {
            _sources = await Api.DiscoverSourceIntegrationsAsync(Profile.Id);
            _discoveryReport = _sources is null ? ["Source integration discovery is not available."] : SourceIntegrationsPresentation.DiscoveryReport(_catalog!, _sources);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _sourcesError = $"{BackendRequestClassifier.FromException("Source discovery", ex).UserMessage} Nothing was changed.";
        }
        finally { _discovering = false; }
    }

    /// <summary>Opens the explicit confirmation of a consumer mapping (nothing is saved until the person confirms).</summary>
    private void BeginConfirm(IntegrationDefinition definition, string? sourceConsumer)
    {
        var consumer = sourceConsumer ?? definition.Consumer.DisplayName;
        if (string.IsNullOrWhiteSpace(consumer)) return;
        _confirming = new PendingConfirmation(definition.Id, consumer, sourceConsumer is not null);
        _focusConfirm = true;
    }

    private async Task ConfirmAsync(IntegrationDefinition definition, PendingConfirmation pending)
    {
        var snapshot = _sources?.Discovery?.SourceSnapshotId;
        var candidate = SourceIntegrationsPresentation.Candidate(_sources, SourceIntegrationsPresentation.Match(_sources, definition));
        var supported = candidate?.ConsumerCandidate is not null && string.Equals(candidate.ConsumerCandidate, pending.Consumer, StringComparison.Ordinal);
        var saved = pending.FromSource
            ? await TrackAsync($"{pending.Consumer} confirmed as the consumer of {definition.DisplayName}.", () => Api.UpdateAsync(Profile.Id, definition with
            {
                Consumer = definition.Consumer with
                {
                    DisplayName = pending.Consumer, MappingState = ConsumerMappingState.Confirmed, MappingConfirmedAt = DateTimeOffset.UtcNow,
                    MappingSource = "Confirmed in Target Environment → Integrations (suggested by source discovery)",
                    MappingEvidence = $"Confirmed by a person from source discovery evidence ({(candidate is null ? "source snapshot" : SourceIntegrationsPresentation.Evidence(candidate.ConsumerEvidence))})",
                    MappingSourceSnapshotId = snapshot,
                },
            }))
            : await TrackAsync($"{definition.Consumer.DisplayName} confirmed as the consumer of {definition.DisplayName}.", () => Api.UpdateAsync(Profile.Id, definition with
            {
                Consumer = definition.Consumer with
                {
                    MappingState = ConsumerMappingState.Confirmed,
                    MappingEvidence = $"Confirmed by a person in BirkNext Integrations (suggested by: {definition.Consumer.MappingSource ?? "unknown source"})",
                    MappingSource = "Confirmed in Target Environment → Integrations",
                    MappingConfirmedAt = DateTimeOffset.UtcNow,
                    MappingSourceSnapshotId = supported ? snapshot : definition.Consumer.MappingSourceSnapshotId,
                },
            }));
        if (saved) _confirming = null;
    }

    /// <summary>Opens the integration's detail and moves focus to its contracts group — the one place contracts are managed.</summary>
    private void ManageContracts(IntegrationDefinition definition)
    {
        _viewing = definition.Id;
        _focusContracts = true;
    }

    /// <summary>Applies an Integration Quality Review deep link: the exact corrective place, never an automatic change.</summary>
    private void ApplyFocus()
    {
        if (_catalog is null || Focus is not { Length: > 0 } focus || _appliedFocus == focus) return;
        _appliedFocus = focus;
        switch (focus)
        {
            case IntegrationReviewPrerunPresentation.FocusMappings:
                ReviewMappings();
                break;
            case IntegrationReviewPrerunPresentation.FocusRuntime when _catalog.Platforms.FirstOrDefault(p => p.Kind != IntegrationKind.ServiceBus) is { } platform:
                BeginRuntime(platform);
                break;
            case ServiceBusPresentation.Focus when _catalog.Platforms.FirstOrDefault(p => p.Kind == IntegrationKind.ServiceBus) is { } serviceBus:
                BeginRuntime(serviceBus);
                break;
            case IntegrationReviewPrerunPresentation.FocusContracts:
                var target = _catalog.Integrations.Where(i => i.Enabled)
                    .OrderBy(i => i.ContractRelationship == ContractRelationshipState.BothContractsAvailable)
                    .ThenBy(i => i.DisplayName, StringComparer.OrdinalIgnoreCase).FirstOrDefault();
                if (target is not null) ManageContracts(target);
                break;
        }
    }
    private void ConfigureFor(IntegrationDefinition definition)
    {
        if (_catalog is not null && IntegrationsPanePresentation.Platform(_catalog, definition) is { } platform) BeginRuntime(platform);
    }
    private async Task TestMappingAsync(IntegrationDefinition definition)
    {
        if (!_mappingBusy.Add(definition.Id)) return;
        var environmentId = Profile.Id;
        var token = _mappingCancellation.Token;
        _mappingAnnouncement = $"Testing mapping for {definition.DisplayName}…";
        try
        {
            var result = await Api.CheckMappingAsync(environmentId, definition.Id, token);
            if (Profile.Id != environmentId) return;
            MappingEvidence.Record(environmentId, result);
            _evidenceViewing = definition.Id;
            _mappingAnnouncement = $"{definition.DisplayName}: {IntegrationMappingEvidenceCheck.Label(result.OverallState)}. View evidence for missing sources. Mapping unchanged.";
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            if (Profile.Id != environmentId) return;
            MappingEvidence.Record(environmentId, new() { IntegrationId = definition.Id, Topic = definition.EndpointOrTopic, SuggestedConsumer = definition.Consumer.DisplayName,
                CompletedAt = DateTimeOffset.UtcNow, OverallState = IntegrationMappingEvidenceState.NotTestable,
                Checks = [new() { Label = "Evidence service", State = IntegrationEvidenceState.Unavailable, Summary = $"{BackendRequestClassifier.FromException("Mapping evidence", ex).UserMessage} Retry the check; the mapping is unchanged.", MissingReason = $"{BackendRequestClassifier.FromException("Mapping evidence", ex).UserMessage} Retry the check; the mapping is unchanged." }] });
            _evidenceViewing = definition.Id;
            _mappingAnnouncement = "Mapping evidence unavailable. The mapping is unchanged.";
        }
        finally { _mappingBusy.Remove(definition.Id); }
    }
    public void Dispose() { _mappingCancellation.Cancel(); _mappingCancellation.Dispose(); }

    private sealed record EditState(IntegrationDefinition? Original);

    /// <summary>Service Bus runtime settings in edit (the Event Hub form owns its own model).</summary>
    private sealed class RuntimeModel
    {
        public string? SubscriptionId { get; set; }
        public int? ReviewWindowHours { get; set; }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == Profile.Id) { ApplyFocus(); return; }
        _mappingCancellation.Cancel();
        _mappingCancellation.Dispose();
        _mappingCancellation = new();
        _mappingBusy.Clear(); _evidenceViewing = null; _appliedFocus = null;
        _loadedFor = Profile.Id;
        await LoadAsync(importLegacy: true);
        ApplyFocus();
    }

    /// <summary>Applying a template is an explicit, saved action; nothing is applied because the target host resembles a known project. The
    /// server decides whether the template fits this environment; a refusal is shown with the server's reason.</summary>
    /// <summary>Names of helpers applied in this session (the catalog keeps only the applied template's id).</summary>
    private readonly Dictionary<string, string> _appliedTemplateNames = new(StringComparer.Ordinal);

    private async Task ApplyTemplateAsync(IntegrationTemplateOffer offer)
    {
        string? refused = null;
        var ok = await TrackAsync($"{offer.Name} applied; existing records were left unchanged.", async () =>
        {
            try
            {
                var applied = await Api.ApplyTemplateAsync(Profile, offer.Id);
                _notices.AddRange(applied.Notices.Except(_notices).ToList());
                await LoadTerraformAsync();
            }
            catch (IntegrationTemplateRefusedException ex) { refused = ex.Message; throw; }
        });
        if (!ok && refused is not null) _saveMessage = $"Not applied: {refused}";
        if (ok) { _templateReview = false; _appliedTemplateNames[offer.Id] = offer.Name; }
    }

    private async Task LoadAsync(bool importLegacy)
    {
        _loadError = null;
        try
        {
            // Integrations saved before the catalog existed lived in the browser profile; the backend imports them once.
            if (importLegacy && Profile.Integrations.Count > 0)
            {
                var imported = await Api.ImportLegacyAsync(Profile);
                if (imported > 0) _notices.Add($"Imported {imported} integration{(imported == 1 ? "" : "s")} previously stored in this browser.");
            }
            _catalog = await Api.GetCatalogAsync(Profile);
            _notices.AddRange(_catalog.Notices.Except(_notices).ToList());
            _contracts = await Api.ContractsAsync(Profile.Id);
            _messaging = await Api.ApplicationMessagingAsync(Profile.Id);
            try { _bindings = await Api.ListEvidenceBindingsAsync(Profile.Id) ?? []; }
            catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { _bindings = []; }
            try { _sources = await Api.SourceIntegrationsAsync(Profile.Id); _sourcesError = null; }
            catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException or NotSupportedException)
            { _sources = null; _sourcesError = "Source integrations could not be loaded; the configured integrations are shown without source evidence."; }
            await LoadTerraformAsync();
            await LoadTemplatesAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _loadError = $"{BackendRequestClassifier.FromException("Integrations", ex).Detail} Integrations are stored by the backend.";
        }
    }

    /// <summary>Templates resolve against this environment's kind (endpoints are never offered for production) and its stored snapshots.</summary>
    private async Task LoadTemplatesAsync()
    {
        if (ServiceProvider.GetService<IIntegrationJourneysApiService>() is not { } journeys) { _templates = []; return; }
        try { _templates = (await journeys.IntegrationTemplatesAsync(Profile.Id, IntegrationTemplatePresentation.EnvironmentType(Profile))).Value ?? []; }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException or NotSupportedException) { _templates = []; }
    }

    /// <summary>Terraform comparison is supporting context: when it cannot be read, the page works without it (nothing is claimed).</summary>
    private async Task LoadTerraformAsync()
    {
        try { _terraform = await Api.TerraformComparisonAsync(Profile); }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException or NotSupportedException) { _terraform = null; }
    }

    /// <summary>Every change is stored at once; the status line says what happened (Saving… / Saved / Save failed).</summary>
    private async Task<bool> TrackAsync(string done, Func<Task> action)
    {
        _saveState = SaveState.Saving;
        _saveMessage = "Saving…";
        StateHasChanged();
        try
        {
            await action();
            _saveState = SaveState.Saved;
            _saveMessage = $"Saved. {done}";
            await LoadAsync(importLegacy: false);
            // Configured integrations and applied templates (domain extensions) change review applicability in the sidebar.
            if (ServiceProvider.GetService<ProjectApplicabilityState>() is { } applicability) _ = applicability.RefreshAsync();
            return true;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _saveState = SaveState.Failed;
            _saveMessage = "Save failed: the change was not stored. The backend did not accept it.";
            return false;
        }
    }

    // The form re-reads the templates when it opens: their evidence state is what the source store holds now. A snapshot imported after
    // this page loaded (another tab, Import Project in between) must never show as "Missing" from a list read earlier.
    private async Task BeginAdd() { _saveError = null; _bindingOutcome = null; await LoadTemplatesAsync(); _editing = new EditState(null); }
    private async Task BeginEdit(IntegrationDefinition definition) { _saveError = null; _bindingOutcome = null; await LoadTemplatesAsync(); _editing = new EditState(definition); }
    private void CancelEdit() { _focusAddTrigger = _editing?.Original is null; _editing = null; _saveError = null; }

    /// <summary>
    /// Saves the record; then, only when a person chose an evidence snapshot in the form, binds it. Creating an integration and binding its
    /// evidence are separate backend operations (a binding needs the stored integration), so a failed binding keeps the integration and says
    /// so, with the way to IQR Evidence — it is never silent.
    /// </summary>
    private async Task SaveAsync(IntegrationEditorSave save)
    {
        var definition = save.Definition;
        var isNew = _editing?.Original is null;
        IntegrationDefinition? stored = null;
        var ok = await TrackAsync(isNew ? $"{definition.DisplayName} added." : $"{definition.DisplayName} updated.", async () =>
        {
            stored = isNew ? await Api.CreateAsync(Profile.Id, definition) : await Api.UpdateAsync(Profile.Id, definition);
        });
        if (!ok) { _saveError = "The integration could not be saved. Your edits are still in the form."; return; }
        _editing = null;
        _saveError = null;
        _focusAddTrigger = isNew;
        if (save.EvidenceSnapshotId is not { } snapshotId) return;
        var integrationId = stored?.Id is { Length: > 0 } id ? id : definition.Id;
        string? error;
        try { (_, error) = await Api.SetEvidenceBindingAsync(Profile.Id, integrationId, snapshotId); }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { error = "The backend did not accept the binding."; }
        _bindingOutcome = error is null
            ? new(false, $"{save.EvidenceArchive} is now the canonical source evidence for {definition.DisplayName}.")
            : new(true, $"{definition.DisplayName} was saved, but its evidence source was not bound: {error}");
        try { _bindings = await Api.ListEvidenceBindingsAsync(Profile.Id) ?? []; }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { }
    }

    private Task ToggleEnabledAsync(IntegrationDefinition definition) =>
        TrackAsync($"{definition.DisplayName} {(definition.Enabled ? "disabled" : "enabled")}.", () => Api.SetEnabledAsync(Profile.Id, definition.Id, !definition.Enabled));

    private async Task DeleteAsync(IntegrationDefinition definition)
    {
        _confirmingDelete = null;
        if (await TrackAsync($"{definition.DisplayName} deleted.", () => Api.DeleteAsync(Profile.Id, definition.Id))) _viewing = null;
    }

    /// <summary>A person confirms the suggested consumer; the provenance records that it was a person and when. Never automatic.</summary>
    private Task ConfirmMappingAsync(IntegrationDefinition definition) =>
        TrackAsync($"{definition.Consumer.DisplayName} confirmed as the consumer of {definition.DisplayName}.", () => Api.UpdateAsync(Profile.Id, definition with
        {
            Consumer = definition.Consumer with
            {
                MappingState = ConsumerMappingState.Confirmed,
                MappingEvidence = $"Confirmed by a person in BirkNext Integrations (suggested by: {definition.Consumer.MappingSource ?? "unknown source"})",
                MappingSource = "Confirmed in Target Environment → Integrations",
                MappingConfirmedAt = DateTimeOffset.UtcNow,
            },
        }));

    private const long MaxContractBytes = 2 * 1024 * 1024;

    private async Task UploadContractAsync(IntegrationDefinition definition, IntegrationContractRole role, InputFileChangeEventArgs args)
    {
        var key = (definition.Id, role);
        _contractErrors.Remove(key);
        var file = args.File;
        if (file.Size > MaxContractBytes) { _contractErrors[key] = "the file is larger than the 2 MB contract limit."; return; }
        string content;
        try
        {
            await using var stream = file.OpenReadStream(MaxContractBytes);
            using var reader = new StreamReader(stream, System.Text.Encoding.UTF8);
            content = await reader.ReadToEndAsync();
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException) { _contractErrors[key] = "the file could not be read."; return; }

        string? rejected = null;
        await TrackAsync($"{role} contract {file.Name} stored for {definition.DisplayName}.", async () =>
        {
            var (_, error) = await Api.SaveContractAsync(new IntegrationContractUpload { EnvironmentId = Profile.Id, IntegrationId = definition.Id, Role = role, FileName = file.Name, Content = content });
            rejected = error;
        });
        if (rejected is not null)
        {
            _contractErrors[key] = rejected;
            _saveState = SaveState.Failed;
            _saveMessage = $"Save failed: the {role.ToString().ToLowerInvariant()} contract was rejected and nothing was stored.";
        }
    }

    private Task RemoveContractAsync(IntegrationDefinition definition, IntegrationContractRole role) =>
        TrackAsync($"{role} contract removed from {definition.DisplayName}.", () => Api.RemoveContractAsync(Profile.Id, definition.Id, role));

    private RenderFragment RuntimeForm(IntegrationPlatform platform) =>
        @<EventHubRuntimeEvidenceForm Platform="platform" AzureEnabled="_catalog!.AzureRuntimeEnabled" OnSave="settings => SaveEventHubRuntimeAsync(platform, settings)" OnCancel="() => _editingRuntime = null" />;

    /// <summary>Service Bus runtime access (subscription) and review window: read through Azure Resource Manager — no connection string.</summary>
    private RenderFragment ServiceBusRuntimeForm(IntegrationPlatform platform) =>
        @<div class="ip-runtime-form" data-testid="ip-runtime-form">
            <label class="ip-field">Azure subscription id (Service Bus namespace metadata) <input class="form-control ip-mono" @ref="_runtimeFocus" @bind="_runtime.SubscriptionId" data-testid="ip-runtime-subscription" /></label>
            <p class="ip-muted">Resource group @(platform.ResourceGroup ?? "not configured") · namespace @(platform.Namespace ?? "not configured"). Read-only metadata GETs with the instance's Azure identity (Reader); no message is read.</p>
            <label class="ip-field">Review window (hours) <input type="number" min="1" max="168" class="form-control" @bind="_runtime.ReviewWindowHours" data-testid="ip-runtime-window" /></label>
            @if (_runtimeError is { } runtimeError) { <p class="ip-field-error" role="alert" data-testid="ip-runtime-error">@runtimeError</p> }
            <div class="ip-editor-actions">
                <button type="button" class="btn-primary" data-testid="ip-runtime-save" @onclick="() => SaveRuntimeAsync(platform)">Save runtime access</button>
                <button type="button" class="btn-secondary" @onclick="() => _editingRuntime = null">Cancel</button>
            </div>
        </div>;

    private void BeginRuntime(IntegrationPlatform platform)
    {
        _advancedOpen = true;
        _runtimeExpanded = platform.Id;
        // The Event Hub form focuses its own first field; the Service Bus fields are focused here.
        _focusRuntime = platform.Kind == IntegrationKind.ServiceBus;
        var r = platform.RuntimeEvidence;
        _runtime = new RuntimeModel { SubscriptionId = r?.SubscriptionId, ReviewWindowHours = r?.ReviewWindowHours };
        _runtimeError = null;
        _runtimeSaved = null;
        _editingRuntime = platform.Id;
    }

    /// <summary>Event Hub sources: the form validated them (shared rules); the backend validates again before storing.</summary>
    private async Task<bool> SaveEventHubRuntimeAsync(IntegrationPlatform platform, IntegrationRuntimeEvidenceSettings settings)
    {
        if (!await TrackAsync($"Runtime evidence sources of {platform.Name} updated.", () => Api.UpdatePlatformAsync(Profile.Id, platform with { RuntimeEvidence = settings }))) return false;
        _editingRuntime = null;
        _runtimeSaved = platform.Id;
        return true;
    }

    private async Task SaveRuntimeAsync(IntegrationPlatform platform)
    {
        static string? Clean(string? v) => string.IsNullOrWhiteSpace(v) ? null : v.Trim();
        // Service Bus: only the subscription and window are edited here; any other stored value is kept.
        var settings = (platform.RuntimeEvidence ?? new IntegrationRuntimeEvidenceSettings()) with { SubscriptionId = Clean(_runtime.SubscriptionId), ReviewWindowHours = _runtime.ReviewWindowHours };
        _runtimeError = settings.Validate();
        if (_runtimeError is not null) return;
        if (await TrackAsync($"Runtime access of {platform.Name} updated.", () => Api.UpdatePlatformAsync(Profile.Id, platform with { RuntimeEvidence = settings })))
            _editingRuntime = null;
    }

    private async Task<bool> SaveScimAsync(IntegrationPlatform platform, ScimProvisioningSettings settings)
    {
        if (settings.Validate() is { } invalid) { _saveState = SaveState.Failed; _saveMessage = invalid; return false; }
        return await TrackAsync($"SCIM settings of {platform.Name} updated.", () => Api.UpdatePlatformAsync(Profile.Id, platform with { ScimProvisioning = settings }));
    }

    private static string Slug(string value) => new string(value.Select(c => char.IsLetterOrDigit(c) ? char.ToLowerInvariant(c) : '-').ToArray());
