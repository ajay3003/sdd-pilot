    private void HandleLinkAdded(CandidateLinkEntry entry)
    {
        if (entry.SourceId == entry.TargetId)
            return;

        if (!_links.Any(l => SameLink(l, entry)))
            _links.Add(entry);
        _ = SaveSessionAsync();
    }

    private void HandleLinkRemoved(CandidateLinkEntry entry)
    {
        _links.RemoveAll(l => SameLink(l, entry));
        _ = SaveSessionAsync();
    }

    private static bool SameLink(CandidateLinkEntry left, CandidateLinkEntry right) =>
        left.LinkType == right.LinkType &&
        ((left.SourceId == right.SourceId && left.TargetId == right.TargetId) ||
         (left.SourceId == right.TargetId && left.TargetId == right.SourceId));

    private ReviewStatusCounts ComputeStatusCounts(ScenarioKind kind)
    {
        var candidates = PipelineResult!.Candidates.Where(c => c.Classification == kind);
        return new ReviewStatusCounts(
            New:         candidates.Count(c => c.ReviewStatus == CandidateReviewStatus.New),
            Accepted:    candidates.Count(c => c.ReviewStatus == CandidateReviewStatus.Accepted),
            Rejected:    candidates.Count(c => c.ReviewStatus == CandidateReviewStatus.Rejected),
            NeedsReview: candidates.Count(c => c.ReviewStatus == CandidateReviewStatus.NeedsReview));
    }

    private static ReviewStatusCounts ComputeStatusCountsFor(IList<ExtractionCandidate> items) =>
        new(New:         items.Count(c => c.ReviewStatus == CandidateReviewStatus.New),
            Accepted:    items.Count(c => c.ReviewStatus == CandidateReviewStatus.Accepted),
            Rejected:    items.Count(c => c.ReviewStatus == CandidateReviewStatus.Rejected),
            NeedsReview: items.Count(c => c.ReviewStatus == CandidateReviewStatus.NeedsReview));

    private sealed record TestGroup(
        string Key,
        string Label,
        int TotalCount,
        List<ExtractionCandidate> VisibleItems);

    private IReadOnlyList<TestGroup> GetTestGroups(IReadOnlyList<ExtractionCandidate> visibleTests)
    {
        var totalCounts = new Dictionary<string, int>(StringComparer.Ordinal);
        var groupOrder  = new List<string>();

        foreach (var c in PipelineResult!.Candidates.Where(c => c.Classification == ScenarioKind.Test))
        {
            var key = c.ContextHeading ?? string.Empty;
            if (!totalCounts.ContainsKey(key))
            {
                totalCounts[key] = 0;
                groupOrder.Add(key);
            }
            totalCounts[key]++;
        }

        var visibleByKey = new Dictionary<string, List<ExtractionCandidate>>(StringComparer.Ordinal);
        foreach (var c in visibleTests)
        {
            var key = c.ContextHeading ?? string.Empty;
            if (!visibleByKey.TryGetValue(key, out var list))
            {
                list = [];
                visibleByKey[key] = list;
            }
            list.Add(c);
        }

        var result = new List<TestGroup>();
        foreach (var key in groupOrder)
        {
            if (!visibleByKey.TryGetValue(key, out var items)) continue;
            result.Add(new TestGroup(
                Key:          key,
                Label:        string.IsNullOrEmpty(key) ? "Other Tests" : key,
                TotalCount:   totalCounts[key],
                VisibleItems: items));
        }
        return result;
    }

