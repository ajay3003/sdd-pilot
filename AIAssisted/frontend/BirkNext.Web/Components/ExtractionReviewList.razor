    private async Task HandleSaveReviewAsync()
    {
        if (PipelineResult is null)
            return;

        _reviewPersistState = ReviewPersistState.Saving;
        StateHasChanged();

        try
        {
            var items = PipelineResult.Candidates
                .Select(c => new SaveReviewedCandidateItemInput
                {
                    CandidateId    = c.CandidateId.ToString(),
                    Title          = c.Title,
                    Classification = c.Classification,
                    ReviewStatus   = c.ReviewStatus,
                    SourceDocument = null,
                    SourceSection  = c.ContextHeading,
                    ProjectId      = ProjectId,
                    ReviewedBy     = null,
                    ReviewedAt     = c.ReviewStatus is CandidateReviewStatus.Accepted
                                     or CandidateReviewStatus.Rejected
                                     or CandidateReviewStatus.NeedsReview
                                         ? DateTimeOffset.UtcNow
                                         : null,
                })
                .ToList();

            var input = new SaveReviewedCandidatesInput
            {
                Items     = items,
                SessionId = _sessionId,
            };

            await SaveReviewedCandidatesMutation.ExecuteAsync(input);

            var linkItems = _links
                .Select(l => new SaveCandidateLinkItemInput
                {
                    SourceCandidateRef = l.SourceId.ToString(),
                    TargetCandidateRef = l.TargetId.ToString(),
                    LinkType           = l.LinkType,
                })
                .ToList();

            var linkInput = new SaveCandidateLinksInput
            {
                ProjectId = ProjectId,
                SessionId = _sessionId,
                Links     = linkItems,
            };

            await SaveCandidateLinksMutation.ExecuteAsync(linkInput);
            _reviewPersistState = ReviewPersistState.Saved;
        }
        catch (Exception)
        {
            _reviewPersistState = ReviewPersistState.Failed;
        }
    }

    private void HandleSelectionToggled(Guid candidateId)
    {
        var candidate = PipelineResult?.Candidates.FirstOrDefault(c => c.CandidateId == candidateId);
        if (candidate is null)
            return;

        if (candidate.IsSelected)
            _selectedIds.Add(candidateId);
        else
            _selectedIds.Remove(candidateId);
        _ = SaveSessionAsync();
    }

    private void HandleReviewStatusChanged(CandidateReviewStatus status) => _ = SaveSessionAsync();

    private void BulkSetStatus(CandidateReviewStatus status)
    {
        foreach (var candidate in PipelineResult!.Candidates.Where(c => _selectedIds.Contains(c.CandidateId)))
            candidate.ReviewStatus = status;
        _ = SaveSessionAsync();
    }

    private void ClearSelection()
    {
        foreach (var candidate in PipelineResult!.Candidates)
            candidate.IsSelected = false;
        _selectedIds.Clear();
    }

    private async Task HandleSaveConfirm()
    {
        if (PipelineResult is null || _selectedIds.Count == 0)
            return;

        _savePhase = ReviewSavePhase.Saving;
        _alreadySavedCount = 0;

        var selectedCandidates = PipelineResult.Candidates
            .Where(c => _selectedIds.Contains(c.CandidateId))
            .ToList();

        // Split: skip items already saved (client-side duplicate protection)
        var alreadySaved = selectedCandidates.Where(c => c.SaveState == CandidateSaveState.Saved).ToList();
        var toSave = selectedCandidates.Where(c => c.SaveState != CandidateSaveState.Saved).ToList();
        _alreadySavedCount = alreadySaved.Count;

        foreach (var c in toSave)
            c.SaveState = CandidateSaveState.Saving;

        StateHasChanged();

        try
        {
            if (toSave.Count == 0)
            {
                // Everything was already saved — no API call needed
                _savedSummary = new SavedTypeSummary(0, 0, 0);
                _savePhase = ReviewSavePhase.Complete;
            }
            else
            {
                var items = toSave
                    .Select(c => new CreateScenarioInput
                    {
                        Title = c.Title,
                        Description = null,
                        Kind = c.Classification,
                        ProjectId = ProjectId,
                    })
                    .ToList();

                var metadata = new ExtractionMetadataInput
                {
                    TotalExtracted = PipelineResult.Candidates.Count,
                    SelectedCount = selectedCandidates.Count,
                    ExtractionDurationMs = (int)PipelineResult.DurationMs,
                    SessionId = _sessionId,
                };

                var input = new CreateScenariosInput
                {
                    Items = items,
                    ExtractionMetadata = metadata,
                };

                var result = await CreateScenariosMutation.ExecuteAsync(input);

                if (result.Data?.CreateScenarios is { } payload)
                {
                    var results = payload.Results;
                    for (var i = 0; i < toSave.Count && i < results.Count; i++)
                    {
                        var candidate = toSave[i];
                        var itemResult = results[i];

                        if (itemResult is ICreateScenarios_CreateScenarios_Results_CreateScenarioSuccess success)
                        {
                            candidate.SaveState = CandidateSaveState.Saved;
                            candidate.SavedScenarioId = success.Scenario.Id;
                        }
                        else if (itemResult is ICreateScenarios_CreateScenarios_Results_CreateScenarioError error)
                        {
                            candidate.SaveState = CandidateSaveState.Failed;
                            candidate.SaveError = error.Message;
                        }
                    }

                    _savedSummary = new SavedTypeSummary(
                        toSave.Count(c => c.Classification == ScenarioKind.Requirement && c.SaveState == CandidateSaveState.Saved),
                        toSave.Count(c => c.Classification == ScenarioKind.Test && c.SaveState == CandidateSaveState.Saved),
                        toSave.Count(c => c.Classification == ScenarioKind.NeedsClarification && c.SaveState == CandidateSaveState.Saved));

                    if (payload.SuggestionResult is { } sr)
                        _suggestionResult = new SuggestionResultData(sr.TotalGenerated, sr.HighConfidenceCount, sr.NeedsReviewCount, sr.SuggestionsAvailable);

                    _savePhase = payload.FailureCount == 0
                        ? ReviewSavePhase.Complete
                        : payload.SuccessCount == 0
                            ? ReviewSavePhase.Failed
                            : ReviewSavePhase.PartialSuccess;
                }
                else
                {
                    foreach (var c in toSave)
                    {
                        c.SaveState = CandidateSaveState.Failed;
                        c.SaveError = "No response data received.";
                    }
                    _savePhase = ReviewSavePhase.Failed;
                }
            }

            if (_savePhase is ReviewSavePhase.Complete or ReviewSavePhase.PartialSuccess)
            {
                ClearSelection();
                await SaveSessionAsync();
            }
        }
        catch (Exception)
        {
            foreach (var c in toSave)
            {
                if (c.SaveState == CandidateSaveState.Saving)
                {
                    c.SaveState = CandidateSaveState.Failed;
                    c.SaveError = "Something went wrong. Please try again.";
                }
            }
            _savePhase = ReviewSavePhase.Failed;
        }
    }

    private void RestoreFromSession(ExtractionSessionSnapshot snapshot)
    {
        // Restore selection only for non-accepted, non-saved items (selection is temporary UI state)
        _selectedIds.Clear();
        foreach (var id in snapshot.SelectedIds)
        {
            var candidate = PipelineResult?.Candidates.FirstOrDefault(c => c.CandidateId == id);
            if (candidate is null) continue;
            if (candidate.ReviewStatus == CandidateReviewStatus.Accepted) continue;
            if (candidate.SaveState == CandidateSaveState.Saved) continue;
            _selectedIds.Add(id);
        }
        // Sync IsSelected on all candidates to match the filtered set
        if (PipelineResult is not null)
        {
            foreach (var c in PipelineResult.Candidates)
                c.IsSelected = _selectedIds.Contains(c.CandidateId);
        }

        _activeFilter = snapshot.ActiveFilter;
        _activeReviewFilter = snapshot.ActiveReviewFilter;
        _activeLinkFilter = snapshot.ActiveLinkFilter;
        _searchTerm = snapshot.SearchTerm;
        _activeViewMode = snapshot.HasActiveViewMode
            ? snapshot.ActiveViewMode
            : ExtractionViewMode.Traceability;

        _sectionExpanded.Clear();
        foreach (var kv in snapshot.SectionExpanded)
        {
            if (Enum.TryParse<ScenarioKind>(kv.Key, out var kind))
                _sectionExpanded[kind] = kv.Value;
        }

        _reqSubsectionExpanded.Clear();
        foreach (var kv in snapshot.ReqSubsectionExpanded)
            _reqSubsectionExpanded[kv.Key] = kv.Value;

        _testSubsectionExpanded.Clear();
        foreach (var kv in snapshot.TestSubsectionExpanded)
            _testSubsectionExpanded[kv.Key] = kv.Value;

        _clrSubsectionExpanded.Clear();
        foreach (var kv in snapshot.ClrSubsectionExpanded)
            _clrSubsectionExpanded[kv.Key] = kv.Value;

        _capabilityGroupExpanded.Clear();
        foreach (var kv in snapshot.CapabilityGroupExpanded)
            _capabilityGroupExpanded[kv.Key] = kv.Value;

        _architectureGroupExpanded.Clear();
        foreach (var kv in snapshot.ArchitectureGroupExpanded)
            _architectureGroupExpanded[kv.Key] = kv.Value;

        _links.Clear();
        foreach (var l in snapshot.Links)
            _links.Add(new CandidateLinkEntry(l.SourceId, l.TargetId, l.LinkType));

        if (_sectionExpanded.Count == 0 && PipelineResult is not null)
        {
            foreach (var kind in PipelineResult.Candidates.Select(c => c.Classification).Distinct())
                _sectionExpanded[kind] = true;
        }
    }

    private async Task SaveSessionAsync()
    {
        if (PipelineResult is null) return;
        try
        {
            await SessionService.SaveAsync(BuildSnapshot());
        }
        catch { }
    }

    private ExtractionSessionSnapshot BuildSnapshot()
    {
        var candidates = PipelineResult!.Candidates
            .Select(c => new CandidateSnapshot(
                CandidateId: c.CandidateId,
                Title: c.Title,
                Classification: c.Classification,
                ClassificationSignal: c.ClassificationSignal,
                ContextHeading: c.ContextHeading,
                SourceBlockType: c.SourceBlockType,
                Confidence: c.Confidence,
                IsSelected: c.IsSelected,
                ReviewStatus: c.ReviewStatus,
                SaveState: c.SaveState,
                SaveError: c.SaveError,
                SavedScenarioId: c.SavedScenarioId))
            .ToList();

        var links = _links
            .Select(l => new LinkSnapshot(l.SourceId, l.TargetId, l.LinkType))
            .ToList();

        return new ExtractionSessionSnapshot
        {
            SessionId = _sessionId,
            Timestamp = DateTimeOffset.UtcNow,
            Profile = PipelineResult.Profile,
            PipelineStatus = PipelineResult.Status,
            InputLengthChars = PipelineResult.InputLengthChars,
            InputLineCount = PipelineResult.InputLineCount,
            DurationMs = PipelineResult.DurationMs,
            Candidates = candidates,
            Links = links,
            SelectedIds = _selectedIds.ToList(),
            ActiveFilter = _activeFilter,
            ActiveReviewFilter = _activeReviewFilter,
            ActiveLinkFilter = _activeLinkFilter,
            SearchTerm = _searchTerm,
            ActiveViewMode = _activeViewMode,
            HasActiveViewMode = true,
            SpecMarkdown = SpecMarkdown,
            SectionExpanded = _sectionExpanded.ToDictionary(kv => kv.Key.ToString(), kv => kv.Value),
            ReqSubsectionExpanded = new Dictionary<string, bool>(_reqSubsectionExpanded),
            TestSubsectionExpanded = new Dictionary<string, bool>(_testSubsectionExpanded),
            ClrSubsectionExpanded = new Dictionary<string, bool>(_clrSubsectionExpanded),
            CapabilityGroupExpanded = new Dictionary<string, bool>(_capabilityGroupExpanded),
            ArchitectureGroupExpanded = new Dictionary<string, bool>(_architectureGroupExpanded),
        };
    }

    private static string FormatSessionAge(DateTimeOffset timestamp)
    {
        var age = DateTimeOffset.UtcNow - timestamp;
        if (age.TotalMinutes < 1) return "just now";
        if (age.TotalHours < 1)
        {
            var mins = (int)age.TotalMinutes;
            return $"{mins} minute{(mins == 1 ? "" : "s")} ago";
        }
        var hours = (int)age.TotalHours;
        return $"{hours} hour{(hours == 1 ? "" : "s")} ago";
    }

    private sealed record SuggestionResultData(int TotalGenerated, int HighConfidenceCount, int NeedsReviewCount, bool SuggestionsAvailable);
    private sealed record SavedTypeSummary(int RequirementCount, int TestCount, int ClarificationCount);

    private string SaveCompleteMessage
    {
        get
        {
            var newCount = _savedSummary is not null
                ? _savedSummary.RequirementCount + _savedSummary.TestCount + _savedSummary.ClarificationCount
                : 0;
            if (_alreadySavedCount > 0 && newCount == 0)
                return $"{_alreadySavedCount} artifact{(_alreadySavedCount == 1 ? "" : "s")} already saved — no duplicates created. Selection cleared.";
            if (_alreadySavedCount > 0)
                return $"{newCount} new artifact{(newCount == 1 ? "" : "s")} saved ({BuildSavedSummaryText(_savedSummary!)}). {_alreadySavedCount} already saved. Selection cleared.";
            if (newCount > 0)
                return $"{newCount} artifact{(newCount == 1 ? "" : "s")} saved ({BuildSavedSummaryText(_savedSummary!)}). Selection cleared.";
            return "Saved successfully. Selection cleared.";
        }
    }

    private static string BuildSavedSummaryText(SavedTypeSummary s)
    {
        var parts = new List<string>(3);
        if (s.RequirementCount > 0) parts.Add($"{s.RequirementCount} requirement{(s.RequirementCount == 1 ? "" : "s")}");
        if (s.TestCount > 0) parts.Add($"{s.TestCount} test{(s.TestCount == 1 ? "" : "s")}");
        if (s.ClarificationCount > 0) parts.Add($"{s.ClarificationCount} clarification{(s.ClarificationCount == 1 ? "" : "s")}");
        return string.Join(", ", parts);
    }

    public void Dispose()
    {
        // Not emitted when save phase is Complete: all selected candidates were successfully saved.
        if (PipelineResult is null || _savePhase == ReviewSavePhase.Complete)
            return;

        var hasUnsaved = PipelineResult.Candidates.Any(c => c.SaveState != CandidateSaveState.Saved);
        if (hasUnsaved)
        {
            // no raw text: only aggregate counts, no candidate titles or content
            Logger.LogInformation(
                "CandidateReviewAbandoned: totalExtracted={TotalExtracted}, selectedCount={SelectedCount}",
                PipelineResult.Candidates.Count,
                _selectedIds.Count);
        }
    }
