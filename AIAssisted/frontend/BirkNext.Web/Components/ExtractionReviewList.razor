@using BirkNext.Web.GraphQL
@using BirkNext.Web.Models
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject ICreateScenariosMutation CreateScenariosMutation
@inject ISaveReviewedCandidatesMutation SaveReviewedCandidatesMutation
@inject ISaveCandidateLinksMutation SaveCandidateLinksMutation
@inject ILogger<ExtractionReviewList> Logger

@if (PipelineResult is null)
{
    return;
}

@if (PipelineResult.Status == PipelineStatus.NoResults)
{
    <div class="empty-state-container">
        <p data-testid="empty-state">No extractable candidates were found in the pasted text.</p>
    </div>
}
else
{
    <div class="extraction-review-list">
        <p class="candidate-summary" data-testid="candidate-summary">
            @PipelineResult.Candidates.Count candidates extracted —
            @PipelineResult.RequirementCount REQUIREMENT,
            @PipelineResult.TestCount TEST,
            @PipelineResult.NeedsClarificationCount NEEDS_CLARIFICATION
            @if (PipelineResult.Profile != ExtractionProfile.Default)
            {
                <span class="profile-badge" data-testid="profile-badge">@PipelineResult.Profile</span>
            }
        </p>

        @{
            var rNewCount       = PipelineResult.Candidates.Count(c => c.ReviewStatus == CandidateReviewStatus.New);
            var rAcceptedCount  = PipelineResult.Candidates.Count(c => c.ReviewStatus == CandidateReviewStatus.Accepted);
            var rRejectedCount  = PipelineResult.Candidates.Count(c => c.ReviewStatus == CandidateReviewStatus.Rejected);
            var rNeedsRevCount  = PipelineResult.Candidates.Count(c => c.ReviewStatus == CandidateReviewStatus.NeedsReview);
            var hasNonNewStatus = rAcceptedCount > 0 || rRejectedCount > 0 || rNeedsRevCount > 0;
            var totalCandidates = PipelineResult.Candidates.Count;
            var reviewedCount = rAcceptedCount + rRejectedCount + rNeedsRevCount;
            var reviewedPct = Percent(reviewedCount, totalCandidates);
            var acceptedRatio = Percent(rAcceptedCount, totalCandidates);
            var rejectedRatio = Percent(rRejectedCount, totalCandidates);
            var requirementsWithTests = CountRequirementsWithTests();
            var requirementsWithoutTests = CountRequirementsWithoutTests();
            var requirementsWithClarifications = CountRequirementsWithClarifications();
            var requirementsWithUnresolvedClarifications = CountRequirementsWithUnresolvedClarifications();
            var testsWithoutRequirements = CountTestsWithoutRequirements();
            var clarificationsWithoutRequirements = CountClarificationsWithoutRequirements();
            var unresolvedClarifications = CountUnresolvedClarifications();
            var requirementsCoveredPct = Percent(requirementsWithTests, PipelineResult.RequirementCount);
            var requirementsWithoutTestsPct = Percent(requirementsWithoutTests, PipelineResult.RequirementCount);
            var testsWithRequirements = PipelineResult.TestCount - testsWithoutRequirements;
            var testsLinkedToRequirementsPct = Percent(testsWithRequirements, PipelineResult.TestCount);
            var pendingRequirements = CountPending(ScenarioKind.Requirement);
            var pendingTests = CountPending(ScenarioKind.Test);
            var pendingClarifications = CountPending(ScenarioKind.NeedsClarification);
        }

        <section class="coverage-dashboard qa-dashboard" aria-label="QA review dashboard" data-testid="coverage-dashboard">
            <div class="qa-dashboard-card qa-dashboard-card-progress">
                <h3 class="qa-dashboard-title">Review Progress</h3>
                <div class="qa-metric-grid">
                    <button type="button" class="coverage-tile qa-metric qa-metric-primary" @onclick="() => _activeReviewFilter = null" aria-label="Show all review statuses">
                        <span class="coverage-value">@reviewedPct%</span>
                        <span class="coverage-label">Reviewed</span>
                    </button>
                    <button type="button" class="coverage-tile qa-metric coverage-tile-accepted" @onclick="() => ApplyReviewFilter(CandidateReviewStatus.Accepted)" aria-label="Show accepted candidates">
                        <span class="coverage-value">@rAcceptedCount</span>
                        <span class="coverage-label">Accepted</span>
                    </button>
                    <button type="button" class="coverage-tile qa-metric coverage-tile-rejected" @onclick="() => ApplyReviewFilter(CandidateReviewStatus.Rejected)" aria-label="Show rejected candidates">
                        <span class="coverage-value">@rRejectedCount</span>
                        <span class="coverage-label">Rejected</span>
                    </button>
                    <button type="button" class="coverage-tile qa-metric coverage-tile-needsreview @(rNeedsRevCount > 0 ? "has-warning" : "")" @onclick="() => ApplyReviewFilter(CandidateReviewStatus.NeedsReview)" aria-label="Show candidates marked needs review">
                        <span class="coverage-value">@rNeedsRevCount</span>
                        <span class="coverage-label">Needs review</span>
                    </button>
                    <button type="button" class="coverage-tile qa-metric coverage-tile-new @(rNewCount > 0 ? "has-warning" : "")" @onclick="() => ApplyReviewFilter(CandidateReviewStatus.New)" aria-label="Show unreviewed candidates">
                        <span class="coverage-value">@rNewCount</span>
                        <span class="coverage-label">Unreviewed</span>
                    </button>
                </div>
            </div>

            <div class="qa-dashboard-card">
                <h3 class="qa-dashboard-title">Requirements Missing Tests</h3>
                <div class="qa-metric-grid">
                    <button type="button" class="coverage-tile qa-metric coverage-tile-test" @onclick="() => ApplyTraceabilityFilter(LinkFilter.RequirementsWithTests)" aria-label="Show requirements with linked tests">
                        <span class="coverage-value">@requirementsWithTests</span>
                        <span class="coverage-label">With tests</span>
                    </button>
                    <button type="button" class="coverage-tile qa-metric coverage-tile-gap @(requirementsWithoutTests > 0 ? "has-gap" : "")" @onclick="() => ApplyTraceabilityFilter(LinkFilter.RequirementsWithoutTests)" aria-label="Show requirements without linked tests">
                        <span class="coverage-value">@requirementsWithoutTests</span>
                        <span class="coverage-label">Missing tests</span>
                    </button>
                </div>
            </div>

            <div class="qa-dashboard-card">
                <h3 class="qa-dashboard-title">Open Clarification Risk</h3>
                <div class="qa-metric-grid">
                    <button type="button" class="coverage-tile qa-metric coverage-tile-clarification @(requirementsWithUnresolvedClarifications > 0 ? "has-warning" : "")" @onclick="() => ApplyTraceabilityFilter(LinkFilter.RequirementsWithClarifications)" aria-label="Show requirements with linked clarifications">
                        <span class="coverage-value">@requirementsWithUnresolvedClarifications</span>
                        <span class="coverage-label">Reqs with unresolved clarifications</span>
                    </button>
                    <button type="button" class="coverage-tile qa-metric coverage-tile-clarification @(unresolvedClarifications > 0 ? "has-warning" : "")" @onclick="() => ApplyTypeFilter(ScenarioKind.NeedsClarification)" aria-label="Show clarification candidates">
                        <span class="coverage-value">@unresolvedClarifications</span>
                        <span class="coverage-label">Unresolved clarifications</span>
                    </button>
                </div>
            </div>

            <div class="qa-dashboard-card">
                <h3 class="qa-dashboard-title">Extraction Quality</h3>
                <div class="qa-metric-grid">
                    <button type="button" class="coverage-tile qa-metric qa-metric-primary" @onclick="ClearDashboardFilters" aria-label="Show all extracted candidates">
                        <span class="coverage-value">@totalCandidates</span>
                        <span class="coverage-label">Extracted</span>
                    </button>
                    <button type="button" class="coverage-tile qa-metric coverage-tile-accepted" @onclick="() => ApplyReviewFilter(CandidateReviewStatus.Accepted)" aria-label="Show accepted candidates">
                        <span class="coverage-value">@rAcceptedCount</span>
                        <span class="coverage-label">Accepted candidates</span>
                    </button>
                    <button type="button" class="coverage-tile qa-metric coverage-tile-rejected @(rRejectedCount > 0 ? "has-warning" : "")" @onclick="() => ApplyReviewFilter(CandidateReviewStatus.Rejected)" aria-label="Show rejected candidates">
                        <span class="coverage-value">@rRejectedCount</span>
                        <span class="coverage-label">Rejected candidates</span>
                    </button>
                    <div class="coverage-tile qa-metric qa-metric-static" role="group" aria-label="Acceptance ratio">
                        <span class="coverage-value">@acceptedRatio%</span>
                        <span class="coverage-label">Acceptance ratio</span>
                    </div>
                    <div class="coverage-tile qa-metric qa-metric-static @(rejectedRatio > 0 ? "has-warning" : "")" role="group" aria-label="Rejection ratio">
                        <span class="coverage-value">@rejectedRatio%</span>
                        <span class="coverage-label">Rejection ratio</span>
                    </div>
                </div>
            </div>

            <div class="qa-dashboard-card">
                <h3 class="qa-dashboard-title">Coverage Summary</h3>
                <div class="qa-metric-grid">
                    <button type="button" class="coverage-tile qa-metric coverage-tile-test" @onclick="() => ApplyTraceabilityFilter(LinkFilter.RequirementsWithTests)" aria-label="Show covered requirements">
                        <span class="coverage-value">@requirementsCoveredPct%</span>
                        <span class="coverage-label">Requirements covered</span>
                    </button>
                    <button type="button" class="coverage-tile qa-metric coverage-tile-gap @(requirementsWithoutTests > 0 ? "has-gap" : "")" @onclick="() => ApplyTraceabilityFilter(LinkFilter.RequirementsWithoutTests)" aria-label="Show requirements without tests">
                        <span class="coverage-value">@requirementsWithoutTestsPct%</span>
                        <span class="coverage-label">Requirements without tests</span>
                    </button>
                    <button type="button" class="coverage-tile qa-metric coverage-tile-test" @onclick="() => ApplyTraceabilityFilter(LinkFilter.RequirementsWithTests)" aria-label="Show linked tests through requirements">
                        <span class="coverage-value">@testsLinkedToRequirementsPct%</span>
                        <span class="coverage-label">Tests linked to requirements</span>
                    </button>
                    <button type="button" class="coverage-tile qa-metric coverage-tile-gap @(testsWithoutRequirements > 0 ? "has-gap" : "")" @onclick="() => ApplyTraceabilityFilter(LinkFilter.TestsWithoutRequirements)" aria-label="Show orphan tests">
                        <span class="coverage-value">@testsWithoutRequirements</span>
                        <span class="coverage-label">Orphan tests</span>
                    </button>
                </div>
            </div>

            <div class="qa-dashboard-card">
                <h3 class="qa-dashboard-title">Orphan Detection</h3>
                <div class="qa-metric-grid">
                    <button type="button" class="coverage-tile qa-metric coverage-tile-gap @(testsWithoutRequirements > 0 ? "has-gap" : "")" @onclick="() => ApplyTraceabilityFilter(LinkFilter.TestsWithoutRequirements)" aria-label="Show tests without linked requirements">
                        <span class="coverage-value">@testsWithoutRequirements</span>
                        <span class="coverage-label">Orphan tests</span>
                    </button>
                    <button type="button" class="coverage-tile qa-metric coverage-tile-gap @(clarificationsWithoutRequirements > 0 ? "has-gap" : "")" @onclick="() => ApplyTraceabilityFilter(LinkFilter.ClarificationsWithoutRequirements)" aria-label="Show clarifications without linked requirements">
                        <span class="coverage-value">@clarificationsWithoutRequirements</span>
                        <span class="coverage-label">Orphan clarifications</span>
                    </button>
                </div>
            </div>

            <div class="qa-dashboard-card">
                <h3 class="qa-dashboard-title">Review Queue</h3>
                <div class="qa-metric-grid">
                    <button type="button" class="coverage-tile qa-metric coverage-tile-requirement @(pendingRequirements > 0 ? "has-warning" : "")" @onclick="() => ApplyTypeFilter(ScenarioKind.Requirement)" aria-label="Show requirement review queue">
                        <span class="coverage-value">@pendingRequirements</span>
                        <span class="coverage-label">Pending requirements</span>
                    </button>
                    <button type="button" class="coverage-tile qa-metric coverage-tile-test @(pendingTests > 0 ? "has-warning" : "")" @onclick="() => ApplyTypeFilter(ScenarioKind.Test)" aria-label="Show test review queue">
                        <span class="coverage-value">@pendingTests</span>
                        <span class="coverage-label">Pending tests</span>
                    </button>
                    <button type="button" class="coverage-tile qa-metric coverage-tile-clarification @(pendingClarifications > 0 ? "has-warning" : "")" @onclick="() => ApplyTypeFilter(ScenarioKind.NeedsClarification)" aria-label="Show clarification review queue">
                        <span class="coverage-value">@pendingClarifications</span>
                        <span class="coverage-label">Pending clarifications</span>
                    </button>
                </div>
            </div>
        </section>

        <div class="filter-toolbar">
            <div class="filter-chips" role="group" aria-label="Filter by type">
                <button type="button"
                        class="filter-chip @(_activeFilter is null ? "is-active" : "")"
                        @onclick="() => _activeFilter = null"
                        aria-pressed="@(_activeFilter is null)">
                    All <span class="chip-count">@PipelineResult.Candidates.Count</span>
                </button>
                @if (PipelineResult.RequirementCount > 0)
                {
                    <button type="button"
                            class="filter-chip filter-chip-requirement @(_activeFilter == ScenarioKind.Requirement ? "is-active" : "")"
                            @onclick="() => _activeFilter = ScenarioKind.Requirement"
                            aria-pressed="@(_activeFilter == ScenarioKind.Requirement)">
                        REQUIREMENT <span class="chip-count">@PipelineResult.RequirementCount</span>
                    </button>
                }
                @if (PipelineResult.TestCount > 0)
                {
                    <button type="button"
                            class="filter-chip filter-chip-test @(_activeFilter == ScenarioKind.Test ? "is-active" : "")"
                            @onclick="() => _activeFilter = ScenarioKind.Test"
                            aria-pressed="@(_activeFilter == ScenarioKind.Test)">
                        TEST <span class="chip-count">@PipelineResult.TestCount</span>
                    </button>
                }
                @if (PipelineResult.NeedsClarificationCount > 0)
                {
                    <button type="button"
                            class="filter-chip filter-chip-needsclarification @(_activeFilter == ScenarioKind.NeedsClarification ? "is-active" : "")"
                            @onclick="() => _activeFilter = ScenarioKind.NeedsClarification"
                            aria-pressed="@(_activeFilter == ScenarioKind.NeedsClarification)">
                        NEEDS_CLARIFICATION <span class="chip-count">@PipelineResult.NeedsClarificationCount</span>
                    </button>
                }
            </div>
            <input type="search"
                   class="search-input"
                   placeholder="Search candidates…"
                   @bind="_searchTerm"
                   @bind:event="oninput"
                   aria-label="Search candidates" />
        </div>

        @if (hasNonNewStatus || _activeReviewFilter is not null)
        {
            <div class="review-status-filter" role="group" aria-label="Filter by review status">
                <button type="button"
                        class="filter-chip @(_activeReviewFilter is null ? "is-active" : "")"
                        @onclick="() => _activeReviewFilter = null"
                        aria-pressed="@(_activeReviewFilter is null)">
                    All statuses
                </button>
                @if (rAcceptedCount > 0)
                {
                    <button type="button"
                            class="filter-chip filter-chip-status-accepted @(_activeReviewFilter == CandidateReviewStatus.Accepted ? "is-active" : "")"
                            @onclick="() => _activeReviewFilter = CandidateReviewStatus.Accepted"
                            aria-pressed="@(_activeReviewFilter == CandidateReviewStatus.Accepted)">
                        Accepted <span class="chip-count">@rAcceptedCount</span>
                    </button>
                }
                @if (rRejectedCount > 0)
                {
                    <button type="button"
                            class="filter-chip filter-chip-status-rejected @(_activeReviewFilter == CandidateReviewStatus.Rejected ? "is-active" : "")"
                            @onclick="() => _activeReviewFilter = CandidateReviewStatus.Rejected"
                            aria-pressed="@(_activeReviewFilter == CandidateReviewStatus.Rejected)">
                        Rejected <span class="chip-count">@rRejectedCount</span>
                    </button>
                }
                @if (rNeedsRevCount > 0)
                {
                    <button type="button"
                            class="filter-chip filter-chip-status-needsreview @(_activeReviewFilter == CandidateReviewStatus.NeedsReview ? "is-active" : "")"
                            @onclick="() => _activeReviewFilter = CandidateReviewStatus.NeedsReview"
                            aria-pressed="@(_activeReviewFilter == CandidateReviewStatus.NeedsReview)">
                        Needs Review <span class="chip-count">@rNeedsRevCount</span>
                    </button>
                }
                @if (rNewCount > 0)
                {
                    <button type="button"
                            class="filter-chip filter-chip-status-new @(_activeReviewFilter == CandidateReviewStatus.New ? "is-active" : "")"
                            @onclick="() => _activeReviewFilter = CandidateReviewStatus.New"
                            aria-pressed="@(_activeReviewFilter == CandidateReviewStatus.New)">
                        Pending <span class="chip-count">@rNewCount</span>
                    </button>
                }
            </div>
        }

        @if (PipelineResult.RequirementCount > 0 || PipelineResult.TestCount > 0 || PipelineResult.NeedsClarificationCount > 0)
        {
            <div class="traceability-filter" role="group" aria-label="Filter by traceability">
                <button type="button"
                        class="filter-chip @(_activeLinkFilter is null ? "is-active" : "")"
                        @onclick="() => _activeLinkFilter = null"
                        aria-pressed="@(_activeLinkFilter is null)">
                    All
                </button>
                @if (PipelineResult.RequirementCount > 0)
                {
                    <button type="button"
                            class="filter-chip @(_activeLinkFilter == LinkFilter.RequirementsWithoutTests ? "is-active" : "")"
                            @onclick="() => _activeLinkFilter = LinkFilter.RequirementsWithoutTests"
                            aria-pressed="@(_activeLinkFilter == LinkFilter.RequirementsWithoutTests)">
                        Requirements without tests <span class="chip-count">@CountRequirementsWithoutTests()</span>
                    </button>
                    <button type="button"
                            class="filter-chip @(_activeLinkFilter == LinkFilter.RequirementsWithTests ? "is-active" : "")"
                            @onclick="() => _activeLinkFilter = LinkFilter.RequirementsWithTests"
                            aria-pressed="@(_activeLinkFilter == LinkFilter.RequirementsWithTests)">
                        Requirements with tests <span class="chip-count">@CountRequirementsWithTests()</span>
                    </button>
                    <button type="button"
                            class="filter-chip @(_activeLinkFilter == LinkFilter.RequirementsWithClarifications ? "is-active" : "")"
                            @onclick="() => _activeLinkFilter = LinkFilter.RequirementsWithClarifications"
                            aria-pressed="@(_activeLinkFilter == LinkFilter.RequirementsWithClarifications)">
                        Requirements with clarifications <span class="chip-count">@CountRequirementsWithClarifications()</span>
                    </button>
                }
                @if (PipelineResult.TestCount > 0)
                {
                    <button type="button"
                            class="filter-chip @(_activeLinkFilter == LinkFilter.TestsWithoutRequirements ? "is-active" : "")"
                            @onclick="() => _activeLinkFilter = LinkFilter.TestsWithoutRequirements"
                            aria-pressed="@(_activeLinkFilter == LinkFilter.TestsWithoutRequirements)">
                        Tests without requirements <span class="chip-count">@CountTestsWithoutRequirements()</span>
                    </button>
                }
                @if (PipelineResult.NeedsClarificationCount > 0)
                {
                    <button type="button"
                            class="filter-chip @(_activeLinkFilter == LinkFilter.ClarificationsWithoutRequirements ? "is-active" : "")"
                            @onclick="() => _activeLinkFilter = LinkFilter.ClarificationsWithoutRequirements"
                            aria-pressed="@(_activeLinkFilter == LinkFilter.ClarificationsWithoutRequirements)">
                        Clarifications without requirements <span class="chip-count">@CountClarificationsWithoutRequirements()</span>
                    </button>
                }
            </div>
        }

        @{
            var visibleRequirements = (_activeFilter is null || _activeFilter == ScenarioKind.Requirement)
                                          ? GetVisible(ScenarioKind.Requirement) : [];
            var visibleTests        = (_activeFilter is null || _activeFilter == ScenarioKind.Test)
                                          ? GetVisible(ScenarioKind.Test) : [];
            var visibleNeeds        = (_activeFilter is null || _activeFilter == ScenarioKind.NeedsClarification)
                                          ? GetVisible(ScenarioKind.NeedsClarification) : [];
            var reqGroups           = GetRequirementGroups(visibleRequirements);
            var testGroups          = GetTestGroups(visibleTests);
            var clrGroups           = GetClarificationGroups(visibleNeeds);
            var anyVisible          = visibleRequirements.Count > 0 || visibleTests.Count > 0 || visibleNeeds.Count > 0;
        }

        @if (_reviewPersistState == ReviewPersistState.Saved)
        {
            <p class="notification notification-success" data-testid="review-saved" role="status">Review saved successfully.</p>
        }
        else if (_reviewPersistState == ReviewPersistState.Failed)
        {
            <p class="notification notification-error" data-testid="review-save-failed" role="alert">Review save failed. Please try again.</p>
        }

        @if (_savePhase == ReviewSavePhase.PartialSuccess)
        {
            <p class="notification notification-warning" data-testid="save-partial" role="status">Some candidates were saved successfully; others encountered errors. Review the items below.</p>
        }
        else if (_savePhase == ReviewSavePhase.Complete)
        {
            <p class="notification notification-success" data-testid="save-complete" role="status">All selected candidates saved successfully.</p>
        }
        else if (_savePhase == ReviewSavePhase.Failed)
        {
            <p class="notification notification-error" data-testid="save-failed" role="alert">Save failed. Please try again.</p>
        }

        @if (anyVisible)
        {
            <div class="section-summary-bar" role="toolbar" aria-label="Section controls">
                <div class="section-summary-pills">
                    @if (visibleRequirements.Count > 0)
                    {
                        <span class="summary-pill summary-pill-requirement">
                            @visibleRequirements.Count REQUIREMENT
                        </span>
                    }
                    @if (visibleTests.Count > 0)
                    {
                        <span class="summary-pill summary-pill-test">
                            @visibleTests.Count TEST
                        </span>
                    }
                    @if (visibleNeeds.Count > 0)
                    {
                        <span class="summary-pill summary-pill-needsclarification">
                            @visibleNeeds.Count NEEDS_CLARIFICATION
                        </span>
                    }
                </div>
                <div class="section-expand-controls">
                    <button type="button"
                            class="section-expand-btn"
                            @onclick="ExpandAll"
                            disabled="@AllSectionsExpanded"
                            aria-label="Expand all sections">
                        Expand All
                    </button>
                    <button type="button"
                            class="section-expand-btn"
                            @onclick="CollapseAll"
                            disabled="@AllSectionsCollapsed"
                            aria-label="Collapse all sections">
                        Collapse All
                    </button>
                </div>
            </div>
        }

        @if (visibleRequirements.Count > 0)
        {
            <ExtractionSectionGroup Title="Requirements"
                                    Accent="requirement"
                                    DataTestId="group-requirement"
                                    TotalCount="@PipelineResult.RequirementCount"
                                    VisibleCount="@visibleRequirements.Count"
                                    StatusCounts="@ComputeStatusCounts(ScenarioKind.Requirement)"
                                    @bind-IsExpanded="_sectionExpanded[ScenarioKind.Requirement]">
                @foreach (var group in reqGroups)
                {
                    <TestSubsectionGroup Title="@group.Label"
                                         Accent="requirement"
                                         TotalCount="@group.TotalCount"
                                         VisibleCount="@group.VisibleItems.Count"
                                         StatusCounts="@ComputeStatusCountsFor(group.VisibleItems)"
                                         IsExpanded="@GetReqSubsectionExpanded(group.Key)"
                                         IsExpandedChanged="@(v => SetReqSubsectionExpanded(group.Key, v))">
                        @foreach (var candidate in group.VisibleItems)
                        {
                            <ExtractionCandidateRow Candidate="candidate"
                                                    OnSelectionToggled="HandleSelectionToggled"
                                                    OnReviewStatusChanged="HandleReviewStatusChanged"
                                                    Links="GetLinksForCandidate(candidate.CandidateId)"
                                                    LinkableCandidates="GetLinkableCandidates(candidate)"
                                                    OnLinkAdded="HandleLinkAdded"
                                                    OnLinkRemoved="HandleLinkRemoved" />
                        }
                    </TestSubsectionGroup>
                }
            </ExtractionSectionGroup>
        }

        @if (visibleTests.Count > 0)
        {
            <ExtractionSectionGroup Title="Tests"
                                    Accent="test"
                                    DataTestId="group-test"
                                    TotalCount="@PipelineResult.TestCount"
                                    VisibleCount="@visibleTests.Count"
                                    StatusCounts="@ComputeStatusCounts(ScenarioKind.Test)"
                                    @bind-IsExpanded="_sectionExpanded[ScenarioKind.Test]">
                @foreach (var group in testGroups)
                {
                    <TestSubsectionGroup Title="@group.Label"
                                         Accent="test"
                                         TotalCount="@group.TotalCount"
                                         VisibleCount="@group.VisibleItems.Count"
                                         StatusCounts="@ComputeStatusCountsFor(group.VisibleItems)"
                                         IsExpanded="@GetSubsectionExpanded(group.Key)"
                                         IsExpandedChanged="@(v => SetSubsectionExpanded(group.Key, v))">
                        @foreach (var candidate in group.VisibleItems)
                        {
                            <ExtractionCandidateRow Candidate="candidate"
                                                    OnSelectionToggled="HandleSelectionToggled"
                                                    OnReviewStatusChanged="HandleReviewStatusChanged"
                                                    Links="GetLinksForCandidate(candidate.CandidateId)"
                                                    LinkableCandidates="GetLinkableCandidates(candidate)"
                                                    OnLinkAdded="HandleLinkAdded"
                                                    OnLinkRemoved="HandleLinkRemoved" />
                        }
                    </TestSubsectionGroup>
                }
            </ExtractionSectionGroup>
        }

        @if (visibleNeeds.Count > 0)
        {
            <ExtractionSectionGroup Title="Needs Clarification"
                                    Accent="needsclarification"
                                    DataTestId="group-needs-clarification"
                                    TotalCount="@PipelineResult.NeedsClarificationCount"
                                    VisibleCount="@visibleNeeds.Count"
                                    StatusCounts="@ComputeStatusCounts(ScenarioKind.NeedsClarification)"
                                    @bind-IsExpanded="_sectionExpanded[ScenarioKind.NeedsClarification]">
                @foreach (var group in clrGroups)
                {
                    <TestSubsectionGroup Title="@group.Label"
                                         Accent="needsclarification"
                                         TotalCount="@group.TotalCount"
                                         VisibleCount="@group.VisibleItems.Count"
                                         StatusCounts="@ComputeStatusCountsFor(group.VisibleItems)"
                                         IsExpanded="@GetClrSubsectionExpanded(group.Key)"
                                         IsExpandedChanged="@(v => SetClrSubsectionExpanded(group.Key, v))">
                        @foreach (var candidate in group.VisibleItems)
                        {
                            <ExtractionCandidateRow Candidate="candidate"
                                                    OnSelectionToggled="HandleSelectionToggled"
                                                    OnReviewStatusChanged="HandleReviewStatusChanged"
                                                    Links="GetLinksForCandidate(candidate.CandidateId)"
                                                    LinkableCandidates="GetLinkableCandidates(candidate)"
                                                    OnLinkAdded="HandleLinkAdded"
                                                    OnLinkRemoved="HandleLinkRemoved" />
                        }
                    </TestSubsectionGroup>
                }
            </ExtractionSectionGroup>
        }

        @if (!anyVisible)
        {
            <div class="filter-empty-state" data-testid="filter-empty-state">
                <p>No candidates match@(_searchTerm.Length > 0 ? " your search" : " the selected filter").</p>
            </div>
        }

        <div class="review-action-bar">
            <button type="button"
                    class="btn-save-review"
                    @onclick="HandleSaveReviewAsync"
                    disabled="@(_reviewPersistState == ReviewPersistState.Saving)"
                    data-testid="save-review-button">
                @(_reviewPersistState == ReviewPersistState.Saving ? "Saving review…" : "Save Review")
            </button>
            @if (_selectedIds.Count > 0 && _savePhase != ReviewSavePhase.Saving)
            {
                <span class="action-bar-selection-count">@_selectedIds.Count selected</span>
                <div class="bulk-review-actions">
                    <button type="button" class="bulk-review-btn bulk-review-accept"
                            @onclick="@(() => BulkSetStatus(CandidateReviewStatus.Accepted))">
                        Accept Selected
                    </button>
                    <button type="button" class="bulk-review-btn bulk-review-reject"
                            @onclick="@(() => BulkSetStatus(CandidateReviewStatus.Rejected))">
                        Reject Selected
                    </button>
                    <button type="button" class="bulk-review-btn bulk-review-needsreview"
                            @onclick="@(() => BulkSetStatus(CandidateReviewStatus.NeedsReview))">
                        Needs Review
                    </button>
                </div>
            }
            <div class="action-bar-right">
                @if (_selectedIds.Count > 0 && _savePhase != ReviewSavePhase.Saving)
                {
                    <button type="button" class="btn-secondary" @onclick="ClearSelection">
                        Clear selection
                    </button>
                }
                <button
                    type="button"
                    disabled="@(_selectedIds.Count == 0 || _savePhase == ReviewSavePhase.Saving)"
                    @onclick="HandleSaveConfirm"
                    data-testid="confirm-save-button"
                    class="btn-primary">
                    @if (_savePhase == ReviewSavePhase.Saving)
                    {
                        <span>Saving…</span>
                    }
                    else
                    {
                        <span>Save @_selectedIds.Count selected</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public ExtractionPipelineResult? PipelineResult { get; set; }

    private const string ProjectId = "00000000-0000-0000-0000-000000000001";

    private enum ReviewPersistState { Idle, Saving, Saved, Failed }
    private enum LinkFilter
    {
        RequirementsWithoutTests,
        RequirementsWithTests,
        RequirementsWithClarifications,
        TestsWithoutRequirements,
        ClarificationsWithoutRequirements,
    }

    private readonly HashSet<Guid> _selectedIds = new();
    private ReviewSavePhase _savePhase = ReviewSavePhase.Idle;
    private ReviewPersistState _reviewPersistState = ReviewPersistState.Idle;
    private string _sessionId = Guid.NewGuid().ToString();
    private ExtractionPipelineResult? _previousPipelineResult;
    private ScenarioKind? _activeFilter = null;
    private CandidateReviewStatus? _activeReviewFilter = null;
    private LinkFilter? _activeLinkFilter = null;
    private string _searchTerm = string.Empty;
    private readonly Dictionary<ScenarioKind, bool> _sectionExpanded = new();
    private readonly Dictionary<string, bool> _reqSubsectionExpanded = new();
    private readonly Dictionary<string, bool> _testSubsectionExpanded = new();
    private readonly Dictionary<string, bool> _clrSubsectionExpanded = new();
    private readonly List<CandidateLinkEntry> _links = new();

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(PipelineResult, _previousPipelineResult))
        {
            _selectedIds.Clear();
            _savePhase = ReviewSavePhase.Idle;
            _sessionId = Guid.NewGuid().ToString();
            _previousPipelineResult = PipelineResult;
            _activeFilter = null;
            _activeReviewFilter = null;
            _activeLinkFilter = null;
            _reviewPersistState = ReviewPersistState.Idle;
            _searchTerm = string.Empty;
            _sectionExpanded.Clear();
            _reqSubsectionExpanded.Clear();
            _testSubsectionExpanded.Clear();
            _clrSubsectionExpanded.Clear();
            _links.Clear();
            if (PipelineResult is not null)
            {
                foreach (var kind in PipelineResult.Candidates.Select(c => c.Classification).Distinct())
                    _sectionExpanded[kind] = true;
            }
        }
    }

    private void ExpandAll()
    {
        foreach (var key in _sectionExpanded.Keys.ToList())
            _sectionExpanded[key] = true;
    }

    private void CollapseAll()
    {
        foreach (var key in _sectionExpanded.Keys.ToList())
            _sectionExpanded[key] = false;
    }

    private bool AllSectionsExpanded => _sectionExpanded.Count > 0 && _sectionExpanded.Values.All(v => v);
    private bool AllSectionsCollapsed => _sectionExpanded.Count > 0 && _sectionExpanded.Values.All(v => !v);

    private List<ExtractionCandidate> GetVisible(ScenarioKind kind)
    {
        var source = PipelineResult!.Candidates.Where(c => c.Classification == kind);
        if (_searchTerm.Length > 0)
            source = source.Where(c => c.Title.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));
        if (_activeReviewFilter is not null)
            source = source.Where(c => c.ReviewStatus == _activeReviewFilter);
        if (_activeLinkFilter is not null)
        {
            source = _activeLinkFilter switch
            {
                LinkFilter.RequirementsWithoutTests when kind == ScenarioKind.Requirement =>
                    source.Where(c => GetLinkTestCount(c) == 0),
                LinkFilter.RequirementsWithTests when kind == ScenarioKind.Requirement =>
                    source.Where(c => GetLinkTestCount(c) > 0),
                LinkFilter.RequirementsWithClarifications when kind == ScenarioKind.Requirement =>
                    source.Where(c => GetLinkClrCount(c) > 0),
                LinkFilter.TestsWithoutRequirements when kind == ScenarioKind.Test =>
                    source.Where(c => GetLinkRequirementCount(c) == 0),
                LinkFilter.ClarificationsWithoutRequirements when kind == ScenarioKind.NeedsClarification =>
                    source.Where(c => GetLinkRequirementCount(c) == 0),
                _ => [],
            };
        }
        return source.ToList();
    }

    private IReadOnlyList<CandidateLinkEntry> GetLinksForCandidate(Guid id) =>
        _links.Where(l => l.SourceId == id || l.TargetId == id).ToList();

    private IReadOnlyList<ExtractionCandidate> GetLinkableCandidates(ExtractionCandidate c)
    {
        if (PipelineResult is null) return [];
        return c.Classification switch
        {
            ScenarioKind.Requirement => PipelineResult.Candidates
                .Where(x => x.Classification == ScenarioKind.Test ||
                             x.Classification == ScenarioKind.NeedsClarification)
                .ToList(),
            ScenarioKind.Test => PipelineResult.Candidates
                .Where(x => x.Classification == ScenarioKind.Requirement ||
                             x.Classification == ScenarioKind.NeedsClarification)
                .ToList(),
            ScenarioKind.NeedsClarification => PipelineResult.Candidates
                .Where(x => x.Classification == ScenarioKind.Requirement ||
                             x.Classification == ScenarioKind.Test)
                .ToList(),
            _ => [],
        };
    }

    private int GetLinkTestCount(ExtractionCandidate c) =>
        _links.Count(l => (l.LinkType == CandidateLinkType.RequirementTest ||
                           l.LinkType == CandidateLinkType.TestClarification) &&
                          (l.SourceId == c.CandidateId || l.TargetId == c.CandidateId));

    private int GetLinkClrCount(ExtractionCandidate c) =>
        _links.Count(l => (l.LinkType == CandidateLinkType.RequirementClarification ||
                           l.LinkType == CandidateLinkType.TestClarification) &&
                          (l.SourceId == c.CandidateId || l.TargetId == c.CandidateId));

    private int GetLinkRequirementCount(ExtractionCandidate c) =>
        _links.Count(l => (l.LinkType == CandidateLinkType.RequirementTest ||
                           l.LinkType == CandidateLinkType.RequirementClarification) &&
                          (l.SourceId == c.CandidateId || l.TargetId == c.CandidateId));

    private int CountRequirementsWithoutTests() =>
        PipelineResult!.Candidates.Count(c => c.Classification == ScenarioKind.Requirement && GetLinkTestCount(c) == 0);

    private int CountRequirementsWithTests() =>
        PipelineResult!.Candidates.Count(c => c.Classification == ScenarioKind.Requirement && GetLinkTestCount(c) > 0);

    private int CountRequirementsWithClarifications() =>
        PipelineResult!.Candidates.Count(c => c.Classification == ScenarioKind.Requirement && GetLinkClrCount(c) > 0);

    private int CountTestsWithoutRequirements() =>
        PipelineResult!.Candidates.Count(c => c.Classification == ScenarioKind.Test && GetLinkRequirementCount(c) == 0);

    private int CountClarificationsWithoutRequirements() =>
        PipelineResult!.Candidates.Count(c => c.Classification == ScenarioKind.NeedsClarification && GetLinkRequirementCount(c) == 0);

    private int CountUnresolvedClarifications() =>
        PipelineResult!.Candidates.Count(c => c.Classification == ScenarioKind.NeedsClarification && IsUnresolved(c));

    private int CountRequirementsWithUnresolvedClarifications()
    {
        var unresolvedClarificationIds = PipelineResult!.Candidates
            .Where(c => c.Classification == ScenarioKind.NeedsClarification && IsUnresolved(c))
            .Select(c => c.CandidateId)
            .ToHashSet();

        return PipelineResult.Candidates.Count(c =>
            c.Classification == ScenarioKind.Requirement &&
            _links.Any(l => l.LinkType == CandidateLinkType.RequirementClarification &&
                            (l.SourceId == c.CandidateId && unresolvedClarificationIds.Contains(l.TargetId) ||
                             l.TargetId == c.CandidateId && unresolvedClarificationIds.Contains(l.SourceId))));
    }

    private int CountPending(ScenarioKind kind) =>
        PipelineResult!.Candidates.Count(c => c.Classification == kind && IsUnresolved(c));

    private static bool IsUnresolved(ExtractionCandidate c) =>
        c.ReviewStatus is CandidateReviewStatus.New or CandidateReviewStatus.NeedsReview;

    private static int Percent(int value, int total) =>
        total == 0 ? 0 : (int)Math.Round(value * 100.0 / total, MidpointRounding.AwayFromZero);

    private void ApplyTypeFilter(ScenarioKind kind)
    {
        _activeFilter = kind;
        _activeLinkFilter = null;
    }

    private void ApplyReviewFilter(CandidateReviewStatus status)
    {
        _activeReviewFilter = status;
    }

    private void ApplyTraceabilityFilter(LinkFilter filter)
    {
        _activeLinkFilter = filter;
        _activeFilter = filter switch
        {
            LinkFilter.RequirementsWithoutTests => ScenarioKind.Requirement,
            LinkFilter.RequirementsWithTests => ScenarioKind.Requirement,
            LinkFilter.RequirementsWithClarifications => ScenarioKind.Requirement,
            LinkFilter.TestsWithoutRequirements => ScenarioKind.Test,
            LinkFilter.ClarificationsWithoutRequirements => ScenarioKind.NeedsClarification,
            _ => _activeFilter,
        };
    }

    private void ClearDashboardFilters()
    {
        _activeFilter = null;
        _activeReviewFilter = null;
        _activeLinkFilter = null;
    }

    private void HandleLinkAdded(CandidateLinkEntry entry)
    {
        if (entry.SourceId == entry.TargetId)
            return;

        if (!_links.Any(l => SameLink(l, entry)))
            _links.Add(entry);
    }

    private void HandleLinkRemoved(CandidateLinkEntry entry)
    {
        _links.RemoveAll(l => SameLink(l, entry));
    }

    private static bool SameLink(CandidateLinkEntry left, CandidateLinkEntry right) =>
        left.LinkType == right.LinkType &&
        ((left.SourceId == right.SourceId && left.TargetId == right.TargetId) ||
         (left.SourceId == right.TargetId && left.TargetId == right.SourceId));

    private ReviewStatusCounts ComputeStatusCounts(ScenarioKind kind)
    {
        var candidates = PipelineResult!.Candidates.Where(c => c.Classification == kind);
        return new ReviewStatusCounts(
            New:         candidates.Count(c => c.ReviewStatus == CandidateReviewStatus.New),
            Accepted:    candidates.Count(c => c.ReviewStatus == CandidateReviewStatus.Accepted),
            Rejected:    candidates.Count(c => c.ReviewStatus == CandidateReviewStatus.Rejected),
            NeedsReview: candidates.Count(c => c.ReviewStatus == CandidateReviewStatus.NeedsReview));
    }

    private static ReviewStatusCounts ComputeStatusCountsFor(IList<ExtractionCandidate> items) =>
        new(New:         items.Count(c => c.ReviewStatus == CandidateReviewStatus.New),
            Accepted:    items.Count(c => c.ReviewStatus == CandidateReviewStatus.Accepted),
            Rejected:    items.Count(c => c.ReviewStatus == CandidateReviewStatus.Rejected),
            NeedsReview: items.Count(c => c.ReviewStatus == CandidateReviewStatus.NeedsReview));

    private sealed record TestGroup(
        string Key,
        string Label,
        int TotalCount,
        List<ExtractionCandidate> VisibleItems);

    private IReadOnlyList<TestGroup> GetTestGroups(IReadOnlyList<ExtractionCandidate> visibleTests)
    {
        var totalCounts = new Dictionary<string, int>(StringComparer.Ordinal);
        var groupOrder  = new List<string>();

        foreach (var c in PipelineResult!.Candidates.Where(c => c.Classification == ScenarioKind.Test))
        {
            var key = c.ContextHeading ?? string.Empty;
            if (!totalCounts.ContainsKey(key))
            {
                totalCounts[key] = 0;
                groupOrder.Add(key);
            }
            totalCounts[key]++;
        }

        var visibleByKey = new Dictionary<string, List<ExtractionCandidate>>(StringComparer.Ordinal);
        foreach (var c in visibleTests)
        {
            var key = c.ContextHeading ?? string.Empty;
            if (!visibleByKey.TryGetValue(key, out var list))
            {
                list = [];
                visibleByKey[key] = list;
            }
            list.Add(c);
        }

        var result = new List<TestGroup>();
        foreach (var key in groupOrder)
        {
            if (!visibleByKey.TryGetValue(key, out var items)) continue;
            result.Add(new TestGroup(
                Key:          key,
                Label:        string.IsNullOrEmpty(key) ? "Other Tests" : key,
                TotalCount:   totalCounts[key],
                VisibleItems: items));
        }
        return result;
    }

    private bool GetSubsectionExpanded(string key) =>
        !_testSubsectionExpanded.TryGetValue(key, out var v) || v;

    private void SetSubsectionExpanded(string key, bool value) =>
        _testSubsectionExpanded[key] = value;

