@using BirkNext.Integrations
@using BirkNext.SourceDomains
@using BirkNext.Web.Components.SourceDomains
@* Event Hub runtime-evidence sources of one platform, in five sections. Identifiers only: no key, SAS token, connection string or token is
   accepted (IntegrationRuntimeEvidenceSettings.Validate is shared with the backend). Configured sources are not Azure execution. *@
<div class="ehr-form" data-testid="ip-runtime-form">
    <p class="ehr-identity" data-testid="ip-runtime-identity">@EventHubRuntimeEvidencePresentation.IdentityText</p>

    <fieldset class="ehr-section" data-testid="ip-runtime-section-a">
        <legend>A · Azure runtime access</legend>
        <p class="ehr-muted">Runtime execution on this BirkNext instance: <strong data-testid="ip-runtime-execution">@EventHubRuntimeEvidencePresentation.ExecutionStatus(AzureEnabled)</strong>@(AzureEnabled ? "" : " (IntegrationReview:Azure:Enabled is not true for this BirkNext instance; it is an instance setting, not set in this form, and sources can still be configured).")</p>
        <label class="ip-field">Subscription name <input class="form-control ip-mono" @ref="_first" @bind="_m.SubscriptionName" data-testid="ip-runtime-subscription-name" /></label>
        <label class="ip-field">Subscription ID <input class="form-control ip-mono" @bind="_m.SubscriptionId" data-testid="ip-runtime-subscription" aria-describedby="ehr-subscription-help" /></label>
        <p class="ehr-muted" id="ehr-subscription-help">A GUID. With the namespace's resource group it enables the read-only consumer-group list.</p>
        <dl class="ehr-facts">
            <div><dt>Resource group</dt><dd class="ip-mono">@(Platform.ResourceGroup ?? "Not configured")</dd></div>
            <div><dt>Namespace</dt><dd class="ip-mono">@(Platform.Namespace ?? "Not configured")</dd></div>
            <div><dt>FQDN</dt><dd class="ip-mono">@(Platform.NamespaceFqdn ?? "Not configured")</dd></div>
            <div><dt>Location / tier</dt><dd>@(Platform.Region ?? "—") · @(_m.NamespaceSku ?? "tier not recorded")@(_m.NamespaceCapacity is { } pu ? $", {pu} PU" : "")</dd></div>
        </dl>
        <SourceInfrastructureHint EnvironmentId="@Platform.EnvironmentId" Kind="InfrastructureResourceKind.EventHubNamespace" Field="Event Hubs namespace" Configured="@(Platform.Namespace ?? Platform.NamespaceFqdn)" TargetEnvironment="@Platform.EnvironmentId" TestId="ip-runtime-src-namespace" />
    </fieldset>

    <fieldset class="ehr-section" data-testid="ip-runtime-section-b">
        <legend>B · Event Hub and consumer evidence</legend>
        <label class="ip-check"><input type="checkbox" @bind="_m.EventHubMetadata" data-testid="ip-runtime-metadata" /> Read Event Hub metadata (existence, partitions, last enqueued position)</label>
        <label class="ip-field">Expected consumer group <input class="form-control ip-mono" @bind="_m.ExpectedConsumerGroup" placeholder="consumer-group-name" data-testid="ip-runtime-expected-group" aria-describedby="ehr-group-help" /></label>
        <SourceInfrastructureHint EnvironmentId="@Platform.EnvironmentId" Kind="InfrastructureResourceKind.ConsumerGroup" Field="Expected consumer group" Configured="@_m.ExpectedConsumerGroup" TargetEnvironment="@Platform.EnvironmentId" OnUse="UseConsumerGroup" TestId="ip-runtime-src-group" />
        <label class="ip-field">How it is known
            <select class="form-control" @bind="_m.ExpectedConsumerGroupProvenance" data-testid="ip-runtime-expected-group-provenance">
                <option value="@IntegrationValueProvenance.ConfiguredAssumption">@IntegrationRuntimeEvidenceSettings.ProvenanceLabel(IntegrationValueProvenance.ConfiguredAssumption)</option>
                <option value="@IntegrationValueProvenance.ObservedInAzure">@IntegrationRuntimeEvidenceSettings.ProvenanceLabel(IntegrationValueProvenance.ObservedInAzure)</option>
                <option value="@IntegrationValueProvenance.SourceConfigurationVerified">@IntegrationRuntimeEvidenceSettings.ProvenanceLabel(IntegrationValueProvenance.SourceConfigurationVerified)</option>
                <option value="@IntegrationValueProvenance.DeclaredInSource">@IntegrationRuntimeEvidenceSettings.ProvenanceLabel(IntegrationValueProvenance.DeclaredInSource)</option>
            </select>
        </label>
        <p class="ehr-muted" id="ehr-group-help">Used for checkpoint lookups of topics without their own consumer group. It stays an expectation: the mapping remains "Needs confirmation" and no checkpoint or lag verdict is given for it. Leave empty to assume nothing.</p>
        @if (!string.IsNullOrWhiteSpace(_m.ExpectedConsumerGroupNote)) { <p class="ehr-muted" data-testid="ip-runtime-expected-group-note">@_m.ExpectedConsumerGroupNote</p> }
    </fieldset>

    <fieldset class="ehr-section" data-testid="ip-runtime-section-c">
        <legend>C · Checkpoint evidence</legend>
        <label class="ip-field">Checkpoint Blob endpoint <input class="form-control ip-mono" @bind="_m.CheckpointBlobEndpoint" placeholder="https://account.blob.core.windows.net/" data-testid="ip-runtime-blob-endpoint" /></label>
        <SourceInfrastructureHint EnvironmentId="@Platform.EnvironmentId" Kind="InfrastructureResourceKind.StorageAccount" Field="Checkpoint Blob endpoint" Configured="@_m.CheckpointBlobEndpoint" TargetEnvironment="@Platform.EnvironmentId" OnUse="UseCheckpointAccount" TestId="ip-runtime-src-storage" />
        <label class="ip-field">Checkpoint container <input class="form-control ip-mono" @bind="_m.CheckpointContainerName" placeholder="checkpoints" data-testid="ip-runtime-container" /></label>
        <SourceInfrastructureHint EnvironmentId="@Platform.EnvironmentId" Kind="InfrastructureResourceKind.BlobContainer" Field="Checkpoint container" Configured="@_m.CheckpointContainerName" TargetEnvironment="@Platform.EnvironmentId" OnUse="UseCheckpointContainer" TestId="ip-runtime-src-container" />
        <p class="ehr-muted" data-testid="ip-runtime-checkpoint-derived">Derived container: <span class="ip-mono">@(Derived() ?? "—")</span>@(_m.CheckpointSourceNote is { Length: > 0 } note ? $" · {IntegrationRuntimeEvidenceSettings.ProvenanceLabel(_m.CheckpointProvenance)} ({note.TrimEnd('.')})" : "")</p>
        <p class="ehr-muted">Read-only listing with Storage Blob Data Reader. Never a SAS URL, account key or connection string; no checkpoint is written, leased or deleted.</p>
    </fieldset>

    <fieldset class="ehr-section" data-testid="ip-runtime-section-d">
        <legend>D · Monitoring and telemetry</legend>
        <label class="ip-field">Application Insights resource <input class="form-control ip-mono" @bind="_m.ApplicationInsightsResourceName" data-testid="ip-runtime-appinsights" /></label>
        <SourceInfrastructureHint EnvironmentId="@Platform.EnvironmentId" Kind="InfrastructureResourceKind.TelemetryComponent" Field="Application Insights resource" Configured="@_m.ApplicationInsightsResourceName" TargetEnvironment="@Platform.EnvironmentId" OnUse="UseAppInsights" TestId="ip-runtime-src-appinsights" />
        <label class="ip-field">Application Insights resource group <input class="form-control ip-mono" @bind="_m.ApplicationInsightsResourceGroup" data-testid="ip-runtime-appinsights-rg" /></label>
        <label class="ip-check"><input type="checkbox" @bind="_m.ApplicationInsightsConfigured" data-testid="ip-runtime-appinsights-configured" /> The consumer is configured with Application Insights (only this yes/no is stored — never the connection string)</label>
        <label class="ip-field">Log Analytics workspace id (optional) <input class="form-control ip-mono" @bind="_m.TelemetryWorkspaceId" data-testid="ip-runtime-workspace" aria-describedby="ehr-workspace-help" /></label>
        <p class="ehr-muted" id="ehr-workspace-help">Not required. @(string.Equals(_m.ContainerAppsLogDestination?.Trim(), "azure-monitor", StringComparison.OrdinalIgnoreCase) ? "The Container Apps environment sends logs to Azure Monitor and has no Log Analytics workspace; telemetry is read through Application Insights." : "Telemetry is read through the Application Insights resource when no workspace is set.") A missing workspace does not block metadata, consumer-group or checkpoint checks.</p>
    </fieldset>

    <fieldset class="ehr-section" data-testid="ip-runtime-section-e">
        <legend>E · Review policy</legend>
        <label class="ip-field">Review window (hours) <input type="number" min="1" max="168" class="form-control" @bind="_m.ReviewWindowHours" data-testid="ip-runtime-window" /></label>
        <label class="ip-field">Consumer lag threshold (events, optional) <input type="number" min="0" class="form-control" @bind="_m.MaxConsumerLagEvents" data-testid="ip-runtime-lag" /></label>
        <label class="ip-field">Checkpoint age threshold (minutes, optional) <input type="number" min="1" class="form-control" @bind="_m.MaxCheckpointAgeMinutes" data-testid="ip-runtime-age" /></label>
        <p class="ehr-muted">Without a threshold, measured lag and checkpoint age are reported as Observed only — never Pass.</p>
    </fieldset>

    <section class="ehr-readiness" aria-labelledby="@_readinessId" data-testid="ip-runtime-readiness">
        <h5 id="@_readinessId">Readiness (as entered)</h5>
        <EventHubRuntimeReadinessList Rows="EventHubRuntimeEvidencePresentation.Readiness(Platform with { RuntimeEvidence = Build() }, AzureEnabled)" />
    </section>

    @if (_error is { } error) { <p class="ip-field-error" role="alert" data-testid="ip-runtime-error">@error</p> }
    <div class="ip-editor-actions">
        <button type="button" class="btn-primary" data-testid="ip-runtime-save" @onclick="SaveAsync" disabled="@_saving">Save runtime evidence sources</button>
        <button type="button" class="btn-secondary" data-testid="ip-runtime-cancel" @onclick="OnCancel">Cancel</button>
    </div>
</div>
@code {
    [Parameter, EditorRequired] public IntegrationPlatform Platform { get; set; } = new();
    [Parameter] public bool AzureEnabled { get; set; }
    [Parameter, EditorRequired] public Func<IntegrationRuntimeEvidenceSettings, Task<bool>> OnSave { get; set; } = _ => Task.FromResult(false);
    [Parameter] public EventCallback OnCancel { get; set; }

    private readonly string _readinessId = "ehr-readiness-" + Guid.NewGuid().ToString("N")[..8];
    private Model _m = new();
    private string? _loadedFor;
    private string? _error;
    private bool _saving;
    private ElementReference _first;

    private sealed class Model
    {
        public bool EventHubMetadata { get; set; }
        public string? SubscriptionId { get; set; }
        public string? SubscriptionName { get; set; }
        public string? NamespaceSku { get; set; }
        public int? NamespaceCapacity { get; set; }
        public string? ExpectedConsumerGroup { get; set; }
        public IntegrationValueProvenance ExpectedConsumerGroupProvenance { get; set; } = IntegrationValueProvenance.ConfiguredAssumption;
        public string? ExpectedConsumerGroupNote { get; set; }
        public string? CheckpointBlobEndpoint { get; set; }
        public string? CheckpointContainerName { get; set; }
        public IntegrationValueProvenance CheckpointProvenance { get; set; }
        public string? CheckpointSourceNote { get; set; }
        public string? TelemetryWorkspaceId { get; set; }
        public string? ApplicationInsightsResourceName { get; set; }
        public string? ApplicationInsightsResourceGroup { get; set; }
        public bool ApplicationInsightsConfigured { get; set; }
        public string? ContainerAppsLogDestination { get; set; }
        public string? ConsumerApplicationName { get; set; }
        public string? ConsumerApplicationResourceGroup { get; set; }
        public int? ReviewWindowHours { get; set; }
        public long? MaxConsumerLagEvents { get; set; }
        public int? MaxCheckpointAgeMinutes { get; set; }
    }

    protected override void OnParametersSet()
    {
        if (_loadedFor == Platform.Id) return;
        _loadedFor = Platform.Id;
        var r = Platform.RuntimeEvidence;
        // Settings saved before the endpoint/container split are shown split; saving stores the pair.
        var (legacyEndpoint, legacyContainer) = EventHubRuntimeEvidencePresentation.SplitContainerUrl(r?.CheckpointContainerUrl);
        _m = new Model
        {
            EventHubMetadata = r?.EventHubMetadata ?? false, SubscriptionId = r?.SubscriptionId, SubscriptionName = r?.SubscriptionName,
            NamespaceSku = r?.NamespaceSku, NamespaceCapacity = r?.NamespaceCapacity,
            ExpectedConsumerGroup = r?.ExpectedConsumerGroup,
            ExpectedConsumerGroupProvenance = r?.ExpectedConsumerGroupProvenance is IntegrationValueProvenance.ObservedInAzure or IntegrationValueProvenance.SourceConfigurationVerified or IntegrationValueProvenance.DeclaredInSource
                ? r.ExpectedConsumerGroupProvenance : IntegrationValueProvenance.ConfiguredAssumption,
            ExpectedConsumerGroupNote = r?.ExpectedConsumerGroupNote,
            CheckpointBlobEndpoint = r?.CheckpointBlobEndpoint ?? legacyEndpoint, CheckpointContainerName = r?.CheckpointContainerName ?? legacyContainer,
            CheckpointProvenance = r?.CheckpointProvenance ?? IntegrationValueProvenance.NotSpecified, CheckpointSourceNote = r?.CheckpointSourceNote,
            TelemetryWorkspaceId = r?.TelemetryWorkspaceId, ApplicationInsightsResourceName = r?.ApplicationInsightsResourceName,
            ApplicationInsightsResourceGroup = r?.ApplicationInsightsResourceGroup, ApplicationInsightsConfigured = r?.ApplicationInsightsConfigured == true,
            ContainerAppsLogDestination = r?.ContainerAppsLogDestination, ConsumerApplicationName = r?.ConsumerApplicationName,
            ConsumerApplicationResourceGroup = r?.ConsumerApplicationResourceGroup,
            ReviewWindowHours = r?.ReviewWindowHours, MaxConsumerLagEvents = r?.MaxConsumerLagEvents, MaxCheckpointAgeMinutes = r?.MaxCheckpointAgeMinutes,
        };
        _error = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) { if (firstRender) await _first.FocusAsync(); }

    private static string? Clean(string? v) => string.IsNullOrWhiteSpace(v) ? null : v.Trim();

    private string? Derived() => Build().ResolvedCheckpointContainerUrl();

    // "Use detected value": fills the form only (Save persists it) and records that the value was chosen from a source declaration.
    private static string SourceNote(SourceResourceCandidate c) => $"Declared in source: {SourceEvidenceDomainsPresentation.Location(c.File, c.Line)} ({c.NameBasis}); selected in this form";
    private void UseConsumerGroup(SourceResourceCandidate c) { _m.ExpectedConsumerGroup = c.Name; _m.ExpectedConsumerGroupProvenance = IntegrationValueProvenance.DeclaredInSource; _m.ExpectedConsumerGroupNote = SourceNote(c); }
    private void UseCheckpointAccount(SourceResourceCandidate c)
    {
        _m.CheckpointBlobEndpoint = SourceEvidenceDomainsPresentation.StorageEndpoint(c);
        _m.CheckpointProvenance = IntegrationValueProvenance.DeclaredInSource;
        _m.CheckpointSourceNote = SourceNote(c);
    }
    private void UseCheckpointContainer(SourceResourceCandidate c) { _m.CheckpointContainerName = c.Name; _m.CheckpointProvenance = IntegrationValueProvenance.DeclaredInSource; _m.CheckpointSourceNote = SourceNote(c); }
    private void UseAppInsights(SourceResourceCandidate c) => _m.ApplicationInsightsResourceName = c.Name;

    private IntegrationRuntimeEvidenceSettings Build()
    {
        var group = Clean(_m.ExpectedConsumerGroup);
        return new()
        {
            EventHubMetadata = _m.EventHubMetadata, SubscriptionId = Clean(_m.SubscriptionId), SubscriptionName = Clean(_m.SubscriptionName),
            NamespaceSku = Clean(_m.NamespaceSku), NamespaceCapacity = _m.NamespaceCapacity,
            ExpectedConsumerGroup = group, ExpectedConsumerGroupProvenance = group is null ? IntegrationValueProvenance.NotSpecified : _m.ExpectedConsumerGroupProvenance,
            ExpectedConsumerGroupNote = group is null ? null : Clean(_m.ExpectedConsumerGroupNote),
            CheckpointBlobEndpoint = Clean(_m.CheckpointBlobEndpoint), CheckpointContainerName = Clean(_m.CheckpointContainerName),
            CheckpointProvenance = _m.CheckpointProvenance, CheckpointSourceNote = Clean(_m.CheckpointSourceNote),
            TelemetryWorkspaceId = Clean(_m.TelemetryWorkspaceId), ApplicationInsightsResourceName = Clean(_m.ApplicationInsightsResourceName),
            ApplicationInsightsResourceGroup = Clean(_m.ApplicationInsightsResourceGroup), ApplicationInsightsConfigured = _m.ApplicationInsightsConfigured ? true : null,
            ContainerAppsLogDestination = Clean(_m.ContainerAppsLogDestination), ConsumerApplicationName = Clean(_m.ConsumerApplicationName),
            ConsumerApplicationResourceGroup = Clean(_m.ConsumerApplicationResourceGroup),
            ReviewWindowHours = _m.ReviewWindowHours, MaxConsumerLagEvents = _m.MaxConsumerLagEvents, MaxCheckpointAgeMinutes = _m.MaxCheckpointAgeMinutes,
        };
    }

    private async Task SaveAsync()
    {
        var settings = Build();
        _error = settings.Validate();
        if (_error is not null) return;
        _saving = true;
        try { if (!await OnSave(settings)) _error = "The runtime evidence sources were not saved. Your edits are still in the form."; }
        finally { _saving = false; }
    }
}
