@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using BirkNext.Web.Services.ProjectEvidence
@using BirkNext.Web.Services.ProjectImport
@implements IDisposable
@inject IServiceProvider Services
@inject IJSRuntime JS

@* Target Environment → Project: which logical project this environment tests, and which ALREADY IMPORTED packages provide its evidence roles.
   Bindings are references (import id, exact snapshot); nothing imported is copied here. Import Project owns packages, Source Analysis owns
   snapshots. Unbound roles are only Suggested (one compatible package) or Needs decision (several): never the newest automatically. *@
<section class="tep" data-testid="tep" aria-labelledby="tep-title">
    <header class="tep-head">
        <h3 id="tep-title" class="tep-title">Project evidence</h3>
        <p class="tep-lead">Imported source, documentation, contracts, infrastructure and supporting evidence are associated with the Target Application automatically when their role is clear. Only uncertain or conflicting sources need your review. <a class="ug-learn-more" href="/user-guide#project-model" data-testid="tep-learn-more">Learn more</a></p>
    </header>

    @if (_error is { } error) { <p class="tep-banner tep-banner-error" role="alert" data-testid="tep-error">@error</p> }
    @if (_notice is { } notice) { <p class="tep-banner" role="status" data-testid="tep-notice">@notice</p> }

    @if (Evidence is null)
    {
        <p class="tep-muted" role="status" data-testid="tep-unavailable">Project evidence is not available in this view.</p>
    }
    else if (_view is null)
    {
        <p class="tep-muted" role="status">Loading project evidence…</p>
    }
    else
    {
        <dl class="tep-facts" data-testid="tep-facts">
            <div><dt>Target Environment</dt><dd data-testid="tep-environment">@(_view.EnvironmentName ?? EnvironmentId)</dd></div>
            <div><dt>Target Application</dt><dd data-testid="tep-target-application">@if (_identity is { } app) { @app.Name <span class="tep-muted" data-testid="tep-application-provenance"> · @TargetApplicationInference.Provenance(app)</span> } else { <a href="@TargetApplications.TabHref(EnvironmentId)">Application not chosen</a>@if (TargetUrl is { Length: > 0 } url) { <span class="tep-muted" data-testid="tep-target-url-only"> · URL @url is configured, but the application (for example M2LB) is not chosen</span> } }</dd></div>
            <div><dt>Project evidence</dt><dd data-testid="tep-project" data-state="@_view.EvidenceState">@EvidenceStatus</dd></div>
            @if (_view.IsConfigured)
            {
                <div><dt>Evidence roles</dt><dd data-testid="tep-binding-summary">@_view.Summary</dd></div>
            }
            <div><dt>Imported sources</dt><dd data-testid="tep-source-total">@_view.Packages.Count@(_view.Packages.Count > 0 ? $" · latest import {_view.Packages.Max(p => p.ImportedAt).ToLocalTime():d MMM yyyy HH:mm}" : "")</dd></div>
            <div><dt>Needs review</dt><dd data-testid="tep-needs-review-count">@ReviewItems.Count</dd></div>
        </dl>

        @if (_identity is not null && ReviewItems.Count > 0)
        {
            @* Only a human decision belongs here (ambiguous role, possible other component, conflict) — never limited analyzer coverage (Partial). *@
            <section class="tep-review" aria-labelledby="tep-review-h" data-testid="tep-needs-review">
                <h4 id="tep-review-h" class="tep-subtitle">Needs review</h4>
                <p class="tep-muted">@ReviewItems.Count source@(ReviewItems.Count == 1 ? " needs" : "s need") your decision. Strong matches were associated automatically.</p>
                <ul class="tep-review-list">
                    @foreach (var item in ReviewItems)
                    {
                        var importId = item.Package.ImportId;
                        <li data-testid="tep-review-item" data-import="@importId">
                            <strong>@item.Package.ArchiveFileName</strong> <span class="tep-state tep-tone-partial">Needs review</span>
                            <span class="tep-muted" data-testid="tep-review-why">Why: @item.Detail</span>
                            <span class="tep-review-actions">
                                <button type="button" class="btn btn-secondary btn-sm" data-testid="tep-review-associate" @onclick="() => AssociateAsync(item)">Associate<span class="visually-hidden"> @item.Package.ArchiveFileName</span></button>
                                <button type="button" class="btn btn-secondary btn-sm" data-testid="tep-review-ignore" @onclick="() => IgnoreAsync(importId)">Not used for @_identity.Name<span class="visually-hidden"> (@item.Package.ArchiveFileName)</span></button>
                                @if (item.Package.SnapshotId is { } snapshot) { <a class="btn btn-link btn-sm" data-testid="tep-review-inspect" href="@($"source-analysis?snapshot={snapshot:D}")">Inspect<span class="visually-hidden"> @item.Package.ArchiveFileName</span></a> }
                            </span>
                        </li>
                    }
                </ul>
            </section>
        }

        @if (!_view.IsConfigured)
        {
            @SourcesSection
        }
        @if (!_view.IsConfigured || _setup)
        {
            @* Project evidence for the Target Application: its evidence checklist. Saves into the same bindings the advanced table below shows. *@
            <ProjectSetupPanel @key="@($"{EnvironmentId}|{_identity?.Name}|{_setupVersion}")" EnvironmentId="@EnvironmentId" EnvironmentName="@(_view.EnvironmentName ?? EnvironmentId)"
                               Packages="_view.Packages" Current="_view.Project" TargetApplication="_identity" Evidence="Evidence!" TargetUrl="@TargetUrl"
                               OnSaved="SetupSavedAsync" OnCancel="@(_view.IsConfigured ? EventCallback.Factory.Create(this, () => _setup = false) : default)" />
        }

        @if (_view.IsConfigured)
        {
            @if (!_view.MainAvailable)
            {
                <p class="tep-banner" role="status" data-testid="tep-main-unavailable">The application package of @_view.ProjectName is not imported in this workspace. Consumers fall back to the current project until it is imported again or the Target Application is changed.</p>
            }
            <div class="tep-project-actions">
                <button type="button" class="btn btn-secondary btn-sm" data-testid="tep-edit-evidence" @onclick="() => OpenSetup(pick: false)">Review evidence</button>
                <a class="btn btn-secondary btn-sm" href="@TargetApplications.TabHref(EnvironmentId)" data-testid="tep-change-application">Change Target Application</a>
                <a class="btn btn-link btn-sm" href="@TargetApplications.TabHref(EnvironmentId)" data-testid="tep-view-detection">View target detection</a>
            </div>
            <p class="tep-muted" data-testid="tep-change-impact">Changing the Target Application re-evaluates these associations; imported packages, Source Analysis, Test Data and Connected Systems remain untouched.</p>
            @if (_impact.Count > 0)
            {
                <ul class="tep-impact" data-testid="tep-impact">@foreach (var line in _impact) { <li>@line</li> }</ul>
            }

            <p class="tep-headline" data-testid="tep-readiness-headline"><strong>Evidence readiness: @_view.ReadinessHeadline</strong> <span class="tep-muted" data-testid="tep-readiness-explanation">@_view.ReadinessExplanation</span></p>
            @* Readiness summary: the same rows as the table below (bound ≠ ready; Partial counts as bound, never as ready). *@
            <ul class="tep-readiness" aria-label="Evidence readiness" data-testid="tep-readiness">
                <li data-testid="tep-readiness-ready"><strong>@_view.RequiredReady</strong> required ready</li>
                <li data-testid="tep-readiness-partial"><strong>@_view.RequiredPartial</strong> required partial</li>
                <li data-testid="tep-readiness-missing"><strong>@(_view.RequiredTotal - _view.RequiredResolved)</strong> required missing</li>
                <li data-testid="tep-readiness-optional"><strong>@_view.OptionalAvailable / @_view.OptionalTotal</strong> optional available</li>
            </ul>

            @if (_view.Problems.Count > 0)
            {
                <section class="tep-problems" role="status" aria-labelledby="tep-problems-h" data-testid="tep-problems">
                    <h4 id="tep-problems-h" class="tep-subtitle">Needs attention</h4>
                    <ul>@foreach (var problem in _view.Problems) { <li data-testid="tep-problem">@problem</li> }</ul>
                    @if (FirstProblemRole() is { } first)
                    {
                        <button type="button" class="btn btn-secondary btn-sm" data-testid="tep-review-issues" @onclick="() => ReviewIssue(first)">Review issues</button>
                    }
                </section>
            }

            <h4 class="tep-subtitle" data-testid="tep-advanced-title">Evidence summary</h4>
            <p class="tep-muted">One row per evidence role: its sources, how they were associated, and whether the evidence is ready. Associated is not the same as ready.</p>
            <div class="tep-table-wrap">
            <table class="tep-table" data-testid="tep-roles">
                <thead><tr><th scope="col">Role</th><th scope="col">Requirement</th><th scope="col">Sources</th><th scope="col">Capabilities</th><th scope="col">Association · Readiness</th><th scope="col">Action</th></tr></thead>
                <tbody>
                    @foreach (var row in _view.Rows)
                    {
                        var open = _openRole == row.Role.RoleKey;
                        <tr id="@($"tep-role-{row.Role.RoleKey}")" tabindex="-1" data-testid="tep-role" data-role="@row.Role.RoleKey" data-state="@row.State" class="@(open ? "tep-row-open" : "")">
                            <th scope="row">
                                @row.Role.Label
                                <span class="tep-required-by" data-testid="tep-required-by">Required by: @row.Role.RequiredBy</span>
                            </th>
                            <td><span class="tep-badge" data-testid="tep-requirement-label">@(row.IsRequired ? "Required" : "Optional")</span></td>
                            <td data-testid="tep-selected">
                                @if (row.Bound.Count == 0 && row.UnavailableSources.Count == 0) { <span>—</span> }
                                @if (row.Bound.Count > 1) { <div class="tep-source-count" data-testid="tep-source-count">@row.Bound.Count sources</div> }
                                @foreach (var bound in row.Bound.Take(2)) { @BoundSource(row, bound) }
                                @if (row.Bound.Count > 2)
                                {
                                    <details class="tep-more" data-testid="tep-more-sources">
                                        <summary>+@(row.Bound.Count - 2) more<span class="visually-hidden"> sources for @row.Role.Label</span> · View all</summary>
                                        @foreach (var bound in row.Bound.Skip(2)) { @BoundSource(row, bound) }
                                    </details>
                                }
                                @foreach (var missing in row.UnavailableSources) { <div class="tep-muted">@missing.ArchiveFileName (not in this workspace)</div> }
                            </td>
                            <td>@if (row.Bound.Count == 0) { <span>—</span> }
                                else
                                {
                                    <ul class="tep-badges" aria-label="@($"Capabilities of the sources bound to {row.Role.Label}")">
                                        @foreach (var c in row.Bound.SelectMany(b => b.Capabilities).Select(c => c.Capability).Distinct()) { <li class="tep-badge tep-badge-compact" data-testid="tep-role-capability">@ShortCapability(c)</li> }
                                    </ul>
                                }</td>
                            <td>@if (row.IsBound) { <span class="tep-muted tep-bound-flag" data-testid="tep-bound-flag">@AssociationLabel(row)</span> }
                                <span class="tep-state tep-tone-@row.Tone" data-testid="tep-state">@row.StatusLabel</span>
                                @if (row.PartialDetail is { } partial)
                                {
                                    @* Association and readiness are separate facts: the reason a role is not ready is shown, not hidden. *@
                                    <span class="tep-partial-detail" data-testid="tep-partial-detail">Reason: @partial</span>
                                }
                                @if (row.State == EvidenceRoleState.Conflict) { <span class="tep-partial-detail" data-testid="tep-conflict-detail">This role uses one source, but @row.Bound.Count are associated. Remove the one that is not authoritative.</span> }
                            </td>
                            <td>
                                <button type="button" class="btn btn-sm @(row.IsResolved ? "btn-secondary" : "btn-primary")" data-testid="tep-role-action"
                                        aria-expanded="@(open ? "true" : "false")" aria-controls="@($"tep-picker-{row.Role.RoleKey}")"
                                        @onclick="() => Toggle(row.Role.RoleKey)">@(row.IsResolved ? row.Role.Cardinality == ProjectEvidenceCardinality.Multiple ? "Change / add" : "Change" : row.State == EvidenceRoleState.Suggested ? "Review suggestion" : "Select source")</button>
                            </td>
                        </tr>
                        @if (open)
                        {
                            <tr class="tep-picker-row"><td colspan="6">@Picker(row)</td></tr>
                        }
                    }
                </tbody>
            </table>
            </div>

            @SourcesSection

            <details class="tep-advanced" data-testid="tep-advanced">
                <summary>Advanced configuration — evidence roles and rules, package catalog, Test Pack roles, diagnostics</summary>
            <h4 class="tep-subtitle">Evidence roles and rules</h4>
            <p class="tep-muted">Required roles count toward evidence readiness. Changing a requirement never bypasses checks a review itself requires.</p>
            <ul class="tep-role-rules" data-testid="tep-role-rules">
                @foreach (var row in _view.Rows)
                {
                    <li><label>@row.Role.Label
                        <select class="form-select form-select-sm" aria-label="@($"Requirement of {row.Role.Label}")" data-testid="tep-requirement"
                                @onchange="e => SetRequirementAsync(row.Role.RoleKey, e.Value?.ToString())">
                            <option value="Required" selected="@row.IsRequired">Required</option>
                            <option value="Optional" selected="@(!row.IsRequired)">Optional</option>
                        </select></label></li>
                }
            </ul>
            @if (CatalogProject is { Length: > 0 } catalogProject)
            {
                <div id="pce"><PackageCatalogEditor Project="@catalogProject" /></div>
            }
            <div class="tep-cards" data-testid="tep-dimensions">
                @foreach (var d in ProjectEvidenceResolver.Dimensions(_view))
                {
                    <div class="tep-card tep-tone-@d.Tone" data-testid="tep-dimension" data-key="@d.Key">
                        <span class="tep-card-label">@d.Label</span>
                        <strong class="tep-card-value">@d.Value</strong>
                        <span class="tep-card-detail">@d.Detail</span>
                    </div>
                }
            </div>
            <details class="tep-add" data-testid="tep-add-evidence">
                <summary>Add supporting project evidence</summary>
                <div class="tep-add-form">
                    <label>Evidence type
                        <select class="form-select form-select-sm" data-testid="tep-add-capability" @bind="_newCapability">
                            @foreach (var capability in AddableCapabilities) { <option value="@capability">@ProjectEvidencePackages.CapabilityLabel(capability)</option> }
                        </select>
                    </label>
                    <label>Role name <input class="form-control form-control-sm" data-testid="tep-add-label" @bind="_newLabel" placeholder="e.g. Integration partner source" /></label>
                    <button type="button" class="btn btn-secondary btn-sm" data-testid="tep-add-submit" @onclick="AddRoleAsync">Add role</button>
                </div>
            </details>

            @if (_view.TestPackRows.Count > 0 || _view.SuggestedTestPacks.Count > 0)
            {
                <h4 class="tep-subtitle">Test Pack roles</h4>
                <p class="tep-muted">A Test Pack's logical sources stay bound through Integration Quality Review evidence bindings; they are listed here so required sources are visible with the project.</p>
                @foreach (var suggestion in _view.SuggestedTestPacks)
                {
                    <p class="tep-suggestion" data-testid="tep-testpack-suggestion">Suggested: <strong>@suggestion.PackName</strong> — @suggestion.Reason
                        <button type="button" class="btn btn-secondary btn-sm" data-testid="tep-testpack-activate" @onclick="() => SetTestPackAsync(suggestion.PackId, true)">Show its roles</button></p>
                }
                @if (_view.TestPackRows.Count > 0)
                {
                    <table class="tep-table" data-testid="tep-testpack-roles">
                        <thead><tr><th scope="col">Role</th><th scope="col">Requirement</th><th scope="col">Required by</th><th scope="col">Status</th><th scope="col">Action</th></tr></thead>
                        <tbody>
                            @foreach (var row in _view.TestPackRows)
                            {
                                var action = SourceSetupPresentation.Action(row.Status, ProjectImportPresentation.ImportSourceHref);
                                <tr data-testid="tep-testpack-role" data-state="@row.Status.State">
                                    <th scope="row">@row.Status.Role.Label</th>
                                    <td>@SourceSetupPresentation.RequirementLabel(row.Status.Role.Requirement)</td>
                                    <td>@row.PackName Test Pack</td>
                                    @if (row.ProjectBound)
                                    {
                                        <td><span class="tep-state tep-tone-available" data-testid="tep-testpack-project-bound">Ready · Bound from project evidence</span></td>
                                        <td></td>
                                    }
                                    else
                                    {
                                        <td><span class="tep-state tep-tone-@SourceSetupPresentation.StateTone(row.Status.State)">@SourceSetupPresentation.StateLabel(row.Status)</span></td>
                                        <td>@if (action is { } a) { <a href="@a.Href">@a.Text</a> }</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                    @foreach (var packId in _view.TestPackRows.Select(r => (r.PackId, r.PackName)).Distinct())
                    {
                        <button type="button" class="btn btn-link btn-sm" data-testid="tep-testpack-deactivate" @onclick="() => SetTestPackAsync(packId.PackId, false)">Hide @packId.PackName roles</button>
                    }
                }
            }
            <p class="tep-muted">Removing the project evidence keeps every import and Source Analysis snapshot; associations can be re-created.</p>
            <button type="button" class="btn btn-secondary btn-sm" data-testid="tep-clear-project" @onclick="ClearAsync">Remove project evidence</button>
            </details>
        }

        <p class="tep-muted tep-ownership" data-testid="tep-ownership">This page associates imported evidence with the selected Target Application. Imported packages and Source Analysis snapshots remain independently owned and are never deleted by changing these associations.</p>
    }
</section>

@code {
    [Parameter, EditorRequired] public string EnvironmentId { get; set; } = "";
    /// <summary>A role key to open and focus (deep link from Recommended Workflow or an Explorer).</summary>
    [Parameter] public string? Focus { get; set; }

    private ProjectEvidenceView? _view;
    private TargetApplicationIdentity? _identity;

    /// <summary>The environment's target URL (WHERE), shown so "application not chosen" is never mistaken for "URL not configured".</summary>
    private string? TargetUrl => (Services.GetService(typeof(IFrontendAnalysisSettingsService)) as IFrontendAnalysisSettingsService)?.Settings.Profiles
        .FirstOrDefault(p => p.Id == EnvironmentId)?.TargetUrl is { Length: > 0 } url ? url : null;

    /// <summary>Project evidence status: Not configured / Ready / Partial / Needs decision — never "Project not configured" when only evidence is missing.</summary>
    /// <summary>Available sources: the authoritative imported-package inventory, bound or not (rendered whether or not evidence is configured).</summary>
    private RenderFragment SourcesSection => __builder =>
    {
    @* Available Sources: every imported package of this workspace (the authoritative inventory: Import Project records + their Source
           Analysis snapshots), whether bound or not — imported is not bound, bound is not ready. *@
        <section class="tep-sources" aria-labelledby="tep-sources-h" data-testid="tep-sources">
            <div class="tep-sources-head">
                <h4 id="tep-sources-h" class="tep-subtitle">Available sources</h4>
                <label class="visually-hidden" for="tep-source-search">Search sources</label>
                <input id="tep-source-search" type="search" class="form-control form-control-sm tep-source-search" data-testid="tep-source-search" placeholder="Search sources…"
                       value="@_sourceSearch" @oninput="e => _sourceSearch = e.Value?.ToString()" />
                <button type="button" class="btn btn-secondary btn-sm" data-testid="tep-refresh-sources" disabled="@_refreshing" @onclick="RefreshSourcesAsync">@(_refreshing ? "Refreshing…" : "Refresh sources")</button>
            </div>
            @if (_view.Packages.Count == 0)
            {
                <p class="tep-muted" data-testid="tep-sources-empty">No package is imported yet. <a href="@ProjectImportPresentation.ImportSourceHref">Import a package</a>.</p>
            }
            else
            {
                <div class="tep-table-wrap">
                    <table class="tep-table tep-sources-table" data-testid="tep-sources-table">
                        <thead><tr><th scope="col">Source</th><th scope="col">Type</th><th scope="col">Capabilities</th><th scope="col">Analysis</th><th scope="col">Role</th></tr></thead>
                        <tbody>
                            @foreach (var package in FilteredSources())
                            {
                                var association = _view.Associations.FirstOrDefault(a => a.Package.ImportId == package.ImportId);
                                <tr data-testid="tep-source-row" data-import="@package.ImportId">
                                    <th scope="row">@package.ArchiveFileName<span class="tep-muted tep-source-meta">imported @package.ImportedAt.ToLocalTime().ToString("d MMM yyyy HH:mm")</span></th>
                                    <td>@package.Classification</td>
                                    <td>@if (package.Capabilities.Count == 0) { <span class="tep-muted">None detected</span> }
                                        else
                                        {
                                            <ul class="tep-badges" aria-label="@($"Capabilities of {package.ArchiveFileName}")">
                                                @foreach (var c in package.Capabilities) { <li class="tep-badge tep-badge-compact" data-testid="tep-source-capability" data-status="@c.Status">@ShortCapability(c.Capability)@(c.Status == PackageCapabilityStatus.Ready ? "" : $" · {c.Status}")</li> }
                                            </ul>
                                        }</td>
                                    <td data-testid="tep-source-analysis">@AnalysisBadges(package)</td>
                                    <td data-testid="tep-source-binding" data-state="@association?.State">@if (association is { } a)
                                        {
                                            <span class="tep-state tep-tone-@a.Tone" data-testid="tep-source-role">@a.StateLabel</span>
                                            @if (a.State == EvidenceAssociationState.WaitingForTargetApplication && a.Role != PackageEvidenceRole.NotClassified) { <span class="tep-muted tep-source-meta">@ApplicationContexts.RoleLabel(a.Role)</span> }
                                            <span class="tep-muted tep-source-meta" data-testid="tep-source-role-detail">@a.Detail</span>
                                        }</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    };

    private string EvidenceStatus => _view is not { IsConfigured: true } v ? _view?.EvidenceState ?? "Not assessed"
        : v.NeedsReviewCount > 0 && !v.RequiredReadyAll ? $"Needs review · {v.RequiredReady} / {v.RequiredTotal} required roles ready"
        : v.RequiredReadyAll ? $"Ready · {v.RequiredReady} / {v.RequiredTotal} required roles ready"
        : v.NeedsDecision > 0 ? $"Needs decision · {v.RequiredReady} / {v.RequiredTotal} required roles ready"
        : $"Partial · {v.RequiredReady} / {v.RequiredTotal} required roles ready{(v.BlockingLabels.Count > 0 ? $" · missing {string.Join(", ", v.BlockingLabels)}" : "")}";
    private bool _setup, _setupPick;
    private int _setupVersion;
    private string? _openRole;
    private string? _error, _notice;
    private string? _appliedFocus;
    private bool _focusPending;
    private IReadOnlyList<string> _impact = [];
    private ProjectEvidenceCapability _newCapability = ProjectEvidenceCapability.Documentation;
    private string _newLabel = "";

    private static readonly ProjectEvidenceCapability[] AddableCapabilities =
    [
        ProjectEvidenceCapability.Documentation, ProjectEvidenceCapability.Infrastructure, ProjectEvidenceCapability.ContractSchema,
        ProjectEvidenceCapability.SupportingSource, ProjectEvidenceCapability.IntegrationSource, ProjectEvidenceCapability.ApplicationSource,
    ];

    /// <summary>Resolved optionally so hosts that render every Target Environment tab without project evidence still render.</summary>
    private IProjectEvidenceService? Evidence => _evidence ??= Services.GetService(typeof(IProjectEvidenceService)) as IProjectEvidenceService;
    private IProjectEvidenceService? _evidence;

    protected override async Task OnParametersSetAsync()
    {
        if (Evidence is null) return;
        _view = await Evidence.GetAsync(EnvironmentId);
        _identity = Evidence.TargetApplicationOf(EnvironmentId);
        if (Focus is { Length: > 0 } focus && focus != _appliedFocus)
        {
            _appliedFocus = focus;
            if (_view.Row(focus) is not null) { _openRole = focus; _focusPending = true; }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusTarget is { } target)
        {
            _focusTarget = null;
            try { await JS.InvokeVoidAsync("birknextFocusElement", target); } catch (JSException) { } catch (InvalidOperationException) { }
        }
        if (!_focusPending || _openRole is null) return;
        _focusPending = false;
        try { await JS.InvokeVoidAsync("birknextFocusElement", $"tep-role-{_openRole}"); } catch (JSException) { } catch (InvalidOperationException) { }
    }

    private async Task ReloadAsync()
    {
        if (Evidence is null) return;
        _view = await Evidence.GetAsync(EnvironmentId);
        _identity = Evidence.TargetApplicationOf(EnvironmentId);
    }

    private void Toggle(string roleKey) => _openRole = _openRole == roleKey ? null : roleKey;

    private async Task RunAsync(Func<Task<bool>> change, string notice)
    {
        _error = null;
        _notice = null;
        try
        {
            if (Evidence is null) return;
            if (await change()) _notice = notice;
            else _error = "Nothing changed: the package does not provide this role, or the environment was not found.";
        }
        catch (Exception ex) { _error = $"The project binding could not be saved: {ex.Message}"; }
        await ReloadAsync();
    }

    private string? _focusTarget;

    private void OpenSetup(bool pick) { _setup = true; _setupPick = pick; _setupVersion++; _impact = []; }

    private async Task SetupSavedAsync(string name)
    {
        _setup = false; _setupPick = false;
        _notice = $"Project {name} saved. Imports, Source Analysis snapshots and documents are unchanged.";
        await ReloadAsync();
    }

    private string? FirstProblemRole() => _view?.Rows.FirstOrDefault(r => r.State == EvidenceRoleState.Conflict)?.Role.RoleKey
        ?? _view?.Rows.FirstOrDefault(r => r.Blocks)?.Role.RoleKey
        ?? _view?.Rows.FirstOrDefault(r => r.State == EvidenceRoleState.NeedsDecision)?.Role.RoleKey
        ?? _view?.Rows.FirstOrDefault(r => r.IsRequired && r.State == EvidenceRoleState.Partial)?.Role.RoleKey;

    private void ReviewIssue(string roleKey) { _openRole = roleKey; _focusPending = true; }

    private static string ShortCapability(ProjectEvidenceCapability capability) => capability switch
    {
        ProjectEvidenceCapability.ApplicationSource => "App source",
        ProjectEvidenceCapability.ContractSchema => "Contracts",
        ProjectEvidenceCapability.SupportingSource => "Shared",
        _ => ProjectEvidencePackages.CapabilityLabel(capability),
    };

    private RenderFragment BoundSource(EvidenceRoleRow row, ProjectEvidencePackage bound) => __builder =>
    {
        var reference = row.Role.Sources.FirstOrDefault(s => s.ImportId == bound.ImportId) ?? row.Role.Sources.FirstOrDefault(s => s.ArchiveSha256 == bound.ArchiveSha256);
        <div class="tep-bound" data-testid="tep-bound-source">@bound.ArchiveFileName
            @if (reference is not null) { <span class="tep-origin" data-testid="tep-binding-origin">@EvidenceRoleRow.OriginLabel(reference)</span> }</div>
    };

    private Task BindAsync(EvidenceRoleRow row, ProjectEvidencePackage package) =>
        RunAsync(() => Evidence!.BindAsync(EnvironmentId, row.Role.RoleKey, package.ImportId), $"{package.ArchiveFileName} confirmed for {row.Role.Label}.");

    private Task UnbindAsync(EvidenceRoleRow row, ProjectEvidencePackage package) =>
        RunAsync(() => Evidence!.UnbindAsync(EnvironmentId, row.Role.RoleKey, package.ImportId), $"{package.ArchiveFileName} removed from {row.Role.Label}. The import is unchanged.");

    private Task SetRequirementAsync(string roleKey, string? value) =>
        Enum.TryParse<ProjectEvidenceRequirement>(value, out var requirement)
            ? RunAsync(() => Evidence!.SetRequirementAsync(EnvironmentId, roleKey, requirement), "Requirement saved.")
            : Task.CompletedTask;

    private Task SetTestPackAsync(string packId, bool active) =>
        RunAsync(() => Evidence!.SetTestPackAsync(EnvironmentId, packId, active), active ? "Test Pack roles shown for this project." : "Test Pack roles hidden.");

    private async Task AddRoleAsync()
    {
        if (string.IsNullOrWhiteSpace(_newLabel)) { _error = "Name the evidence role first."; return; }
        if (Evidence is null) return;
        var key = await Evidence.AddRoleAsync(EnvironmentId, _newCapability, _newLabel);
        _notice = key is null ? null : $"Role {_newLabel.Trim()} added (optional).";
        _newLabel = "";
        _openRole = key;
        await ReloadAsync();
    }

    private Task RemoveRoleAsync(EvidenceRoleRow row) =>
        RunAsync(() => Evidence!.RemoveRoleAsync(EnvironmentId, row.Role.RoleKey), "Role " + row.Role.Label + " removed.");

    private async Task ClearAsync()
    {
        await RunAsync(() => Evidence!.ClearProjectAsync(EnvironmentId), "Project evidence removed (archived; not re-created automatically). Imports, snapshots and documents are unchanged.");
        _impact = [];
    }

    /// <summary>The compatible-source picker: compatible packages only, each with what it provides and why it matches. Incompatible packages are
    /// counted, never offered (an infrastructure-only package never satisfies an application or documentation role).</summary>
    private RenderFragment Picker(EvidenceRoleRow row) => __builder =>
    {
        var incompatible = (_view?.Packages.Count ?? 0) - row.Candidates.Count;
        <div class="tep-picker" id="@($"tep-picker-{row.Role.RoleKey}")" data-testid="tep-picker">
            <p class="tep-muted">
                @(row.State switch
                {
                    EvidenceRoleState.Suggested => "One imported package matches, but its association is not certain. It is used once you confirm it.",
                    EvidenceRoleState.NeedsDecision => $"{row.Candidates.Count(c => !c.Bound)} imported packages match. Choose which one this project uses; the newest is never chosen automatically.",
                    _ when row.Role.Cardinality == ProjectEvidenceCardinality.Multiple => "This role can aggregate several packages.",
                    _ => "This role uses one package.",
                })
            </p>
            @if (row.Candidates.Count == 0)
            {
                <p data-testid="tep-picker-empty">No imported package provides @ProjectEvidencePackages.CapabilityLabel(row.Role.Capability).ToLowerInvariant(). <a href="@ProjectImportPresentation.ImportSourceHref">Import a package</a>.</p>
            }
            <ul class="tep-candidates">
                @foreach (var candidate in row.Candidates)
                {
                    var p = candidate.Package;
                    <li class="tep-candidate" data-testid="tep-picker-candidate" data-import="@p.ImportId" data-bound="@(candidate.Bound ? "true" : "false")">
                        <div class="tep-candidate-main">
                            <strong>@p.ArchiveFileName</strong> <span class="tep-classification">@p.Classification</span>
                            <dl class="tep-candidate-facts">
                                <div><dt>Documents</dt><dd>@(p.DocumentCount == 0 ? "None" : $"{p.DocumentCount} · {p.DocumentRoleSummary}")</dd></div>
                                <div><dt>Source Analysis</dt><dd>@(p.SnapshotId is null ? "No snapshot (not applicable)" : p.SourceAnalysisStatus ?? "Snapshot recorded")</dd></div>
                                <div><dt>Contracts/schema</dt><dd>@(p.Has(ProjectEvidenceCapability.ContractSchema) ? "Available" : "None")</dd></div>
                                @if (p.ConfigurationEnvironments.Count > 0) { <div><dt>Environment labels</dt><dd>@string.Join(", ", p.ConfigurationEnvironments)</dd></div> }
                                <div><dt>Imported</dt><dd>@p.ImportedAt.ToLocalTime().ToString("d MMM yyyy HH:mm")</dd></div>
                            </dl>
                            <p class="tep-why" data-testid="tep-picker-why">Matches @row.Role.Label: @candidate.Why</p>
                        </div>
                        @if (candidate.Bound)
                        {
                            <button type="button" class="btn btn-secondary btn-sm" data-testid="tep-unbind" @onclick="() => UnbindAsync(row, p)">Remove</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-primary btn-sm" data-testid="tep-bind" @onclick="() => BindAsync(row, p)">@(row.Role.Cardinality == ProjectEvidenceCardinality.Multiple && row.Bound.Count > 0 ? "Add" : "Use for this role")</button>
                        }
                    </li>
                }
            </ul>
            @if (incompatible > 0)
            {
                <details class="tep-excluded" data-testid="tep-picker-incompatible">
                    <summary>@incompatible other imported package@(incompatible == 1 ? " is" : "s are") not offered — why</summary>
                    <ul>
                        @foreach (var p in _view!.Packages.Where(p => row.Candidates.All(c => c.Package.ImportId != p.ImportId)))
                        {
                            <li data-testid="tep-picker-excluded" data-import="@p.ImportId"><strong>@p.ArchiveFileName</strong> — @ExclusionReason(row, p)</li>
                        }
                    </ul>
                </details>
            }
            @if (row.Role.Origin is ProjectEvidenceRoleOrigin.UserAdded or ProjectEvidenceRoleOrigin.Expected)
            {
                <button type="button" class="btn btn-link btn-sm" data-testid="tep-remove-role" @onclick="() => RemoveRoleAsync(row)">Remove this role</button>
            }
        </div>
    };

    /// <summary>The logical project whose package catalog is shown: this environment's Target Application (else its Project evidence name).</summary>
    /// <summary>Sources that need a human decision (ambiguous role, possibly another component, conflict) — never "Partial" coverage.</summary>
    private IReadOnlyList<PackageAssociation> ReviewItems => _view?.Associations.Where(a => a.State == EvidenceAssociationState.NeedsReview).ToList() ?? [];

    /// <summary>"Associated automatically", "Confirmed by you" or both for a multi-source role.</summary>
    private static string AssociationLabel(EvidenceRoleRow row)
    {
        var sources = row.Role.Sources.Where(s => row.Bound.Any(b => b.ImportId == s.ImportId)).ToList();
        var detected = sources.Count(s => s.BoundBy == ProjectEvidenceAssociation.Detected);
        return detected == sources.Count ? "Associated automatically" : detected == 0 ? "Confirmed by you" : "Associated automatically · confirmed by you";
    }

    private async Task IgnoreAsync(string importId)
    {
        if (Evidence is null) return;
        if (await Evidence.IgnoreSourceAsync(EnvironmentId, importId)) { _notice = $"Set aside for {_identity?.Name}. The import is kept; re-evaluation will not associate it again."; await ReloadAsync(); }
    }

    /// <summary>Associate a source that needs review: open the role it fits (the user confirms the binding there).</summary>
    private void AssociateAsync(PackageAssociation item)
    {
        var role = _view?.Rows.FirstOrDefault(r => item.Package.Has(r.Role.Capability)) ?? _view?.Rows.FirstOrDefault();
        if (role is not null) { _openRole = role.Role.RoleKey; _focusPending = true; _appliedFocus = role.Role.RoleKey; }
    }

    private string? CatalogProject => Services.GetService(typeof(PackageCatalogService)) is null ? null : _identity?.Name ?? _view?.Project?.ProjectName;

    private string? _sourceSearch;
    private bool _refreshing;

    private IEnumerable<ProjectEvidencePackage> FilteredSources() => string.IsNullOrWhiteSpace(_sourceSearch) ? _view!.Packages
        : _view!.Packages.Where(p => p.ArchiveFileName.Contains(_sourceSearch, StringComparison.OrdinalIgnoreCase) || p.DisplayName.Contains(_sourceSearch, StringComparison.OrdinalIgnoreCase)
            || p.Classification.Contains(_sourceSearch, StringComparison.OrdinalIgnoreCase)
            || p.Capabilities.Any(c => ProjectEvidencePackages.CapabilityLabel(c.Capability).Contains(_sourceSearch, StringComparison.OrdinalIgnoreCase)));

    /// <summary>
    /// Analysis per dimension the package actually contains ([Source: Partial] [Docs: Analyzed] [Infrastructure: Analyzed]) — never an unlabeled
    /// "Partial · Failed". The snapshot's own status is the application-code analyzer's outcome only, so it is never shown as the package's state.
    /// </summary>
    private static RenderFragment AnalysisBadges(ProjectEvidencePackage p) => __builder =>
    {
        var dimensions = AnalysisDimensions(p);
        if (dimensions.Count == 0) { <span class="tep-muted">@(p.SnapshotId is null ? "Not analyzed" : "Nothing analyzable detected")</span> return; }
        <ul class="tep-badges" aria-label="@($"Analysis of {p.ArchiveFileName}")">
            @foreach (var (label, status) in dimensions)
            {
                var text = status switch { PackageCapabilityStatus.Ready => "Analyzed", PackageCapabilityStatus.Partial => "Partial", _ => "Failed" };
                var tone = status switch { PackageCapabilityStatus.Ready => "available", PackageCapabilityStatus.Partial => "partial", _ => "rejected" };
                var meaning = status switch
                {
                    PackageCapabilityStatus.Ready => "This dimension was analyzed completely.",
                    PackageCapabilityStatus.Partial => "Some of this dimension was analyzed; one or more areas were not fully analyzed. Details are in Source Analysis.",
                    _ => "This analysis dimension could not be completed. Details are in Source Analysis.",
                };
                <li class="tep-state tep-tone-@tone" data-testid="tep-analysis-badge" data-dimension="@label" data-status="@text" title="@meaning">@label: @text<span class="visually-hidden"> — @meaning</span></li>
            }
        </ul>
    };

    /// <summary>(Dimension, status) for each capability the package contains: Source, Docs, Contracts, Infrastructure, Generated docs.</summary>
    internal static IReadOnlyList<(string Label, PackageCapabilityStatus Status)> AnalysisDimensions(ProjectEvidencePackage p) =>
        [.. p.Capabilities.Select(c => (Label: c.Capability switch
        {
            ProjectEvidenceCapability.ApplicationSource or ProjectEvidenceCapability.SupportingSource => "Source",
            ProjectEvidenceCapability.Documentation => "Docs",
            ProjectEvidenceCapability.ContractSchema => "Contracts",
            ProjectEvidenceCapability.Infrastructure => "Infrastructure",
            ProjectEvidenceCapability.GeneratedDocumentation => "Generated docs",
            _ => ProjectEvidencePackages.CapabilityLabel(c.Capability),
        }, c.Status)).DistinctBy(d => d.Label)];

    /// <summary>Why a package is not offered for a role — never a silent omission.</summary>
    private static string ExclusionReason(EvidenceRoleRow row, ProjectEvidencePackage p)
    {
        var needs = ProjectEvidencePackages.CapabilityLabel(row.Role.Capability).ToLowerInvariant();
        if (row.Role.Origin == ProjectEvidenceRoleOrigin.Expected && ProjectEvidencePackages.Satisfies(p, row.Role.Capability))
            return $"provides {needs}, but is not named like the expected evidence “{row.Role.Label}”.";
        return row.Role.Capability switch
        {
            ProjectEvidenceCapability.Documentation or ProjectEvidenceCapability.GeneratedDocumentation => $"no {needs} was found in this package.",
            _ when p.SnapshotId is null => "not analyzed: the package has no Source Analysis snapshot. Analyze its source to make source-based roles available.",
            _ => $"Source Analysis found no {needs} in this package ({(p.Capabilities.Count == 0 ? "no capabilities detected" : "it provides " + string.Join(", ", p.Capabilities.Select(c => ProjectEvidencePackages.CapabilityLabel(c.Capability).ToLowerInvariant())))}).",
        };
    }

    /// <summary>Re-reads the imported sources and their Source Analysis state. Bindings are not changed.</summary>
    private async Task RefreshSourcesAsync()
    {
        if (Evidence is null) return;
        _refreshing = true;
        try
        {
            _view = await Evidence.GetAsync(EnvironmentId, refresh: true);
            _notice = $"Sources refreshed: {_view.Packages.Count} imported. Roles were re-evaluated; your own choices are unchanged.";
        }
        finally { _refreshing = false; }
    }

    protected override void OnInitialized() { if (Evidence is { } evidence) evidence.Changed += OnChanged; }
    private void OnChanged() => _ = InvokeAsync(async () => { await ReloadAsync(); StateHasChanged(); });
    public void Dispose() { if (_evidence is { } evidence) evidence.Changed -= OnChanged; }
}
