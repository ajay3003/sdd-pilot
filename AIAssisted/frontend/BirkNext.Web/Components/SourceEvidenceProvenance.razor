@* One exact source snapshot as provenance: repository, short fingerprint (full on hover), archive and analysis time. Metadata only. *@
<span class="rse-prov" data-testid="@TestId">@if (Role is not null) { <span class="rse-badge rse-badge-info">@Role</span> } <strong>@Entry.Repository</strong> · <code title="@Entry.Fingerprint">@ReviewSourceScopes.Short(Entry.Fingerprint)</code>@if (ShowArchive) { <span> · <span class="rse-wrap">@Entry.ArchiveName</span></span> }@if (ShowAnalyzed) { <span class="rse-muted"> · analyzed @ReviewSourceScopeState.Utc(Entry.AnalyzedAt)</span> }</span>

@code {
    [Parameter, EditorRequired] public SourceScopeEntry Entry { get; set; } = new();
    [Parameter] public string? Role { get; set; }
    [Parameter] public string? TestId { get; set; }
    [Parameter] public bool ShowArchive { get; set; } = true;
    [Parameter] public bool ShowAnalyzed { get; set; } = true;
}
