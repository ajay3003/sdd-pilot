@using BirkNext.Web.Models

@* Tester-facing coverage: which surfaces of the target the review can reach right now. The block's name is carried by the
   disclosure that hosts it, so it is not repeated here. Exact access values (method, mode, proxy/CDP state, manual
   verification vs automated access) stay available in the nested technical disclosure. *@
<div class="fqr-coverage" data-testid="fqr-coverage">
    <ul class="fqr-coverage-list">
        @foreach (var row in Rows)
        {
            <li class="fqr-coverage-row" data-testid="fqr-coverage-row" data-coverage="@row.Label" data-state="@row.State">
                <span class="fqr-coverage-label">@row.Label</span>
                <span class="fqr-pill fqr-pill-@FrontendQualityCoverageStates.Tone(row.State)" data-testid="fqr-coverage-state">
                    <span aria-hidden="true">@FrontendQualityCoverageStates.Glyph(row.State)</span> @FrontendQualityCoverageStates.Label(row.State)
                </span>
                <span class="fqr-coverage-detail">@row.Detail</span>
            </li>
        }
    </ul>
    @if (TechnicalDetails is not null)
    {
        <ReviewDisclosure Text="View technical coverage details" CollapseText="Hide technical coverage details" TestId="fqr-coverage-technical" Class="disclosure-inline">
            @TechnicalDetails
        </ReviewDisclosure>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<FrontendQualityCoverageRow> Rows { get; set; } = [];
    [Parameter] public RenderFragment? TechnicalDetails { get; set; }
}
