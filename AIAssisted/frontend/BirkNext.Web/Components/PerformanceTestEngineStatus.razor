@using BirkNext.PerformanceTests
@inject IServiceProvider ServiceProvider

@* Installation-level performance-test engines: provider (k6), execution runtime (Podman) and the pinned provider image. Per-test
   scenario/workload/thresholds live in Performance Test Review; the target and its environment live in Target Environment. A missing runtime
   or image is a tool limitation, never a test failure. *@
<div class="pte-root" data-testid="pte-status">
    <p class="settings-card-note">What this BirkNext installation can run for Performance Test Review. k6 runs as an on-demand container (created per run, removed afterwards); it is never part of the BirkNext images. Capabilities an engine lacks are shown as not supported.</p>
    @if (_providers is null) { <p role="status">Checking engines…</p> }
    else if (_providers.Count == 0) { <p data-testid="pte-none">No performance test engine status is available (the backend did not answer).</p> }
    else
    {
        @foreach (var p in _providers)
        {
            <dl class="settings-layers" data-testid="pte-provider" data-availability="@p.Availability">
                <div><dt>Engine</dt><dd>@p.DisplayName <code>@p.ProviderId</code></dd></div>
                <div><dt>Status</dt><dd data-testid="pte-availability">@(p.Availability == ProviderAvailability.Available ? "Ready" : p.Availability.ToString()) — @p.Detail</dd></div>
                <div><dt>Version</dt><dd>@(p.Version ?? "—")</dd></div>
                @if (p.Runtime is { } rt)
                {
                    <div><dt>Execution runtime</dt><dd data-testid="pte-runtime">@rt.DisplayName <code>@rt.RuntimeId</code> — @(rt.Availability == ProviderAvailability.Available ? $"available, {rt.Version}" : rt.Detail)</dd></div>
                }
                @if (p.Image is { } image)
                {
                    <div><dt>Image</dt><dd data-testid="pte-image"><code>@image</code> — @(p.ImagePresent ? $"present{(p.ImageDigest is null ? "" : $" ({p.ImageDigest})")}" : "missing") · pulls @(p.AllowImagePull ? "allowed on request" : "disabled (pull it once on the host)")</dd></div>
                }
                <div><dt>HTTP</dt><dd>@Yes(p.Capabilities.Http)</dd></div>
                <div><dt>GraphQL (query)</dt><dd>@Yes(p.Capabilities.GraphQl)</dd></div>
                <div><dt>Virtual-user workload</dt><dd>@Yes(p.Capabilities.Modes.Contains(WorkloadMode.VirtualUsers))</dd></div>
                <div><dt>Arrival-rate workload</dt><dd>@Yes(p.Capabilities.Modes.Contains(WorkloadMode.ArrivalRate))</dd></div>
                <div><dt>Cancellation</dt><dd>@Yes(p.Capabilities.Cancellation)</dd></div>
            </dl>
            @if (p.Availability == ProviderAvailability.ImageMissing && p.AllowImagePull)
            {
                <button type="button" class="btn-secondary" @onclick="() => PullAsync(p.ProviderId)" disabled="@_pulling" data-testid="pte-pull">@(_pulling ? "Pulling…" : $"Pull {p.Image}")</button>
            }
            @if (_message is { } m) { <p role="status" data-testid="pte-message">@m</p> }
        }
    }
</div>

@code {
    private List<PerformanceProviderStatus>? _providers;
    private IPerformanceTestApiService? _api;
    private bool _pulling;
    private string? _message;

    private static string Yes(bool supported) => supported ? "Supported" : "Not supported";

    protected override async Task OnInitializedAsync()
    {
        _api = ServiceProvider.GetService(typeof(IPerformanceTestApiService)) as IPerformanceTestApiService;
        _providers = _api is null ? [] : await _api.ProvidersAsync();
    }

    private async Task PullAsync(string providerId)
    {
        _pulling = true;
        var result = await _api!.PrepareProviderAsync(providerId);
        _pulling = false;
        _message = result.Value is null ? $"Not pulled: {result.Error}" : "Image pulled.";
        _providers = await _api.ProvidersAsync();
    }
}
