@using BirkNext.PerformanceTests
@using BirkNext.Web.Shared.Components.Common
@using P = BirkNext.Web.Services.PerformanceEngineCapabilityPresentation
@inject IServiceProvider ServiceProvider
@inject IJSRuntime JS
@inject NavigationManager Nav

@* System Settings → Performance Test Engines: what this installation can run (engines, their execution runtime and image) and what
   Resource Stability can observe. Capability only — test definitions live in Performance Test Review, the target in Target Environment.
   Every value comes from the backend probe; a missing runtime, image or metric is a tool limitation, never a test failure. Raw
   provider/runtime ids, image references and digests live under Technical details. *@
<div class="pte" data-testid="pte-status" aria-busy="@(_loading ? "true" : "false")">
    <header class="pte-header">
        <div class="pte-header-text">
            <h2 class="pte-title">Performance Test Engines</h2>
            <p class="pte-lead">Runtime engines and observability providers available to Performance Test Review.</p>
            <p class="pte-sub">Engines run on demand in an isolated container. Resource providers determine which runtime and container metrics BirkNext can observe during a test.</p>
        </div>
        <div class="pte-actions">
            <button type="button" class="btn-secondary pte-refresh" @onclick="LoadAsync" disabled="@_loading" data-testid="pte-refresh">@(_loading ? "Checking…" : "Refresh")</button>
            @if (P.SafeReturn(_returnTo) is { } back)
            {
                <a class="btn-secondary pte-back" href="@back" data-testid="pte-back-to-review">← Back to Performance Test Review</a>
            }
            else
            {
                <a class="pte-link" href="performance-test-review">Open Performance Test Review</a>
            }
        </div>
    </header>

    @if (_providers is null && _resources is null && _loading)
    {
        <p class="pte-loading" role="status">Checking engines and resource providers…</p>
    }
    else if (_providers is null && _resources is null)
    {
        <div class="pte-error" role="alert" data-testid="pte-error">
            <strong>Performance engine capabilities could not be loaded.</strong>
            <span>@(_api?.LastReadError?.UserMessage ?? "The engine requests failed.") Nothing is shown as unsupported because nothing could be checked.</span>
        </div>
    }
    else
    {
        var engines = P.Order(_providers ?? []);
        var resources = P.Order(_resources ?? []);
        var current = resources.Where(P.IsCurrent).ToList();
        var other = resources.Where(r => !P.IsCurrent(r)).ToList();
        var engineSummary = P.EngineSummary(engines);
        var resourceSummary = P.ResourceSummary(resources);
        var runtime = engines.FirstOrDefault()?.Runtime;

        <dl class="pte-summary" data-testid="pte-summary">
            <div>
                <dt>Performance engine</dt>
                <dd>@if (engineSummary is { } es) { @Pill(es, "Performance engine") } else { <span class="pte-muted">None installed</span> }</dd>
            </div>
            @if (runtime is not null)
            {
                <div><dt>Execution</dt><dd>@P.RuntimeText(runtime)</dd></div>
            }
            <div data-testid="pte-summary-local">
                <dt>Local execution</dt>
                <dd>@if (_local is { } le) { @Pill(P.Trust(le.TrustState), "Container TLS trust") <span class="pte-muted">Container TLS trust</span> } else { <span class="pte-muted">Not loaded</span> }</dd>
            </div>
            <div>
                <dt>Resource observation</dt>
                <dd>@if (resourceSummary is { } rs) { @Pill(rs, "Resource observation") } else { <span class="pte-muted">No providers</span> }</dd>
            </div>
        </dl>

        <section class="pte-section" aria-labelledby="pte-engines-heading">
            <h3 id="pte-engines-heading" class="pte-section-title">@(engines.Count == 1 ? "Engine" : "Engines")</h3>
            @if (_providers is null)
            {
                <p class="pte-error" role="alert" data-testid="pte-engines-error">Engine status could not be loaded.</p>
            }
            else if (engines.Count == 0)
            {
                <p class="pte-empty" data-testid="pte-none">No performance-test providers are installed.</p>
            }
            else
            {
                <div class="pte-engine-grid">
                    @foreach (var p in engines)
                    {
                        var status = P.Engine(p.Availability);
                        <article class="pte-card pte-engine" data-testid="pte-provider" data-availability="@p.Availability" aria-labelledby="@($"pte-engine-{p.ProviderId}")">
                            <div class="pte-card-head">
                                <span class="pte-icon pte-icon-engine" aria-hidden="true"></span>
                                <div class="pte-card-titles">
                                    <h4 id="@($"pte-engine-{p.ProviderId}")" class="pte-card-title">@p.DisplayName</h4>
                                    <p class="pte-card-kind">Performance test provider</p>
                                </div>
                                <span data-testid="pte-availability">@Pill(status, p.DisplayName)</span>
                            </div>

                            @if (p.Availability != ProviderAvailability.Available)
                            {
                                <p class="pte-reason" data-testid="pte-reason">@p.Detail</p>
                            }
                            @if (p.Availability == ProviderAvailability.ImageMissing)
                            {
                                @if (p.AllowImagePull)
                                {
                                    <button type="button" class="btn-secondary" @onclick="() => PullAsync(p.ProviderId)" disabled="@_pulling" data-testid="pte-pull">@(_pulling ? "Pulling…" : "Pull the configured image")</button>
                                }
                                else
                                {
                                    <p class="pte-guidance" data-testid="pte-guidance">Automatic image pull is disabled. Pull the configured image on the BirkNext host, then refresh. The exact reference is under Technical details.</p>
                                }
                            }
                            @if (_message is { } m) { <p role="status" class="pte-guidance" data-testid="pte-message">@m</p> }

                            <dl class="pte-facts">
                                <div><dt>Version</dt><dd>@(p.Version ?? "—")</dd></div>
                                @if (p.Runtime is { } rt)
                                {
                                    <div data-testid="pte-runtime"><dt>Runtime</dt><dd>@P.RuntimeText(rt) @Pill(P.Runtime(rt.Availability), $"{rt.DisplayName} runtime")</dd></div>
                                }
                                @if (p.Image is { } image)
                                {
                                    <div data-testid="pte-image"><dt>Image</dt><dd class="pte-image" title="@image">@P.ShortImage(image)</dd></div>
                                    <div data-testid="pte-image-status"><dt>Image status</dt><dd>@(p.ImagePresent ? "Present" : "Missing")</dd></div>
                                }
                            </dl>

                            <div class="pte-chips-block">
                                <p class="pte-chips-title" id="@($"pte-caps-{p.ProviderId}")">Capabilities</p>
                                <ul class="pte-chips" aria-labelledby="@($"pte-caps-{p.ProviderId}")" data-testid="pte-capabilities">
                                    @foreach (var chip in P.Chips(p.Capabilities))
                                    {
                                        <li class="pte-chip @(chip.Supported ? "is-on" : "is-off")" data-supported="@chip.Supported.ToString().ToLowerInvariant()">
                                            <span aria-hidden="true">@(chip.Supported ? "✓" : "—")</span>
                                            @chip.Label<span class="visually-hidden">: @(chip.Supported ? "supported" : "not supported")</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        @LocalExecutionSection()

        <section class="pte-section" aria-labelledby="pte-resources-heading">
            <h3 id="pte-resources-heading" class="pte-section-title">Resource Stability</h3>
            <p class="pte-section-sub">Runtime and container evidence BirkNext can observe during a performance test. Unavailable metrics are shown as unavailable, never as zero.</p>
            @if (_resources is null)
            {
                <p class="pte-error" role="alert" data-testid="pte-resources-error">Resource provider status could not be loaded.</p>
            }
            else if (current.Count == 0)
            {
                <p class="pte-empty" data-testid="pte-resource-none">No resource observation providers are installed.</p>
            }
            else
            {
                <div class="pte-resource-grid" data-testid="pte-resources">
                    @foreach (var r in current) { @ResourceCard(r) }
                </div>
            }
        </section>

        @if (other.Count > 0)
        {
            <section class="pte-section" aria-labelledby="pte-other-heading">
                <h3 id="pte-other-heading" class="pte-section-title">Unsupported and planned</h3>
                <p class="pte-section-sub">Shown for transparency. Not part of what this installation can observe today.</p>
                <div class="pte-resource-grid pte-other-grid" data-testid="pte-resources-other">
                    @foreach (var r in other) { @ResourceCard(r) }
                </div>
            </section>
        }

        <ReviewDisclosure Text="Technical details" CollapseText="Hide technical details" TestId="pte-technical" Class="pte-technical">
            <div class="pte-technical-body">
                @foreach (var p in engines)
                {
                    <h4 class="pte-tech-title">@p.DisplayName</h4>
                    <dl class="pte-tech">
                        @TechRow("Provider ID", p.ProviderId, copy: true)
                        @TechRow("Provider version", p.Version)
                        @TechRow("Availability", p.Availability.ToString())
                        <div><dt>Probe detail</dt><dd>@p.Detail</dd></div>
                        @if (p.Runtime is { } rt)
                        {
                            @TechRow("Runtime ID", rt.RuntimeId)
                            @TechRow("Runtime version", rt.Version)
                            <div><dt>Runtime detail</dt><dd>@rt.Detail</dd></div>
                        }
                        @if (p.Image is { } image)
                        {
                            @TechRow("Image reference", image, copy: true)
                            @TechRow("Image digest", p.ImageDigest, copy: true)
                            <div><dt>Image pull</dt><dd>@(p.AllowImagePull ? "Allowed on request" : "Disabled (pull on the host)")</dd></div>
                        }
                        <div><dt>Workload purposes</dt><dd>@(p.Capabilities.Purposes.Count == 0 ? "—" : string.Join(", ", p.Capabilities.Purposes))</dd></div>
                    </dl>
                }
                @if (resources.Count > 0)
                {
                    <h4 class="pte-tech-title">Resource providers</h4>
                    <dl class="pte-tech">
                        @foreach (var r in resources)
                        {
                            <div data-testid="pte-tech-resource"><dt><code>@r.ProviderId</code></dt><dd>@r.Availability — @r.Detail</dd></div>
                        }
                    </dl>
                }
            </div>
        </ReviewDisclosure>
    }
</div>

@code {
    private List<PerformanceProviderStatus>? _providers;
    private PerformanceLocalExecutionStatus? _local;
    private string _caPath = "";
    private string? _caMessage;
    private bool _caBusy, _caError, _focusTrust;
    private string? _returnTo;
    private List<ResourceProviderCapability>? _resources;
    private IPerformanceTestApiService? _api;
    private bool _loading;
    private bool _pulling;
    private string? _message;
    private string? _copied;

    protected override async Task OnInitializedAsync()
    {
        _api = ServiceProvider.GetService(typeof(IPerformanceTestApiService)) as IPerformanceTestApiService;
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        _returnTo = query.TryGetValue("returnTo", out var back) ? back.ToString() : null;
        _focusTrust = query.TryGetValue("focus", out var focus) && focus.ToString() == "container-tls-trust";
        await LoadAsync();
    }

    /// <summary>A readiness deep link ("Open local execution setup") focuses the Container TLS trust card once it is rendered.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusTrust || _local is null) return;
        _focusTrust = false;
        try { await JS.InvokeVoidAsync("birknextFocusElement", "container-tls-trust"); }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException) { }
    }

    /// <summary>Re-probes on request (no polling). Previous values stay on screen while checking, so the layout does not jump.</summary>
    private async Task LoadAsync()
    {
        if (_api is null) { _providers = []; _resources = []; return; }
        _loading = true;
        try
        {
            var providers = _api.ProvidersOrNullAsync();
            var resources = _api.ResourceProvidersOrNullAsync();
            var local = _api.LocalExecutionAsync();
            _providers = await providers;
            _resources = await resources;
            _local = await local;
            if (_local?.Source == ContainerTlsTrustSources.SystemSettings && _caPath.Length == 0) _caPath = _local.BundlePath ?? "";
        }
        finally { _loading = false; }
    }

    private async Task SaveCaAsync()
    {
        if (_api is null) return;
        _caBusy = true;
        var result = await _api.ConfigureCaBundleAsync(_caPath);
        _caBusy = false;
        _caError = result.Value is null;
        if (result.Value is { } status) { _local = status; _caMessage = "CA bundle saved for this machine. Run a container network check from Performance Test Review to validate it."; _providers = await _api.ProvidersOrNullAsync(); }
        else _caMessage = $"Not saved: {result.Error}";
    }

    private async Task RemoveCaAsync()
    {
        if (_api is null) return;
        _caBusy = true;
        var result = await _api.RemoveCaBundleAsync();
        _caBusy = false;
        _caError = result.Value is null;
        if (result.Value is { } status) { _local = status; _caPath = ""; _caMessage = "CA bundle removed from this machine's settings. The file itself was not changed."; _providers = await _api.ProvidersOrNullAsync(); }
        else _caMessage = $"Not removed: {result.Error}";
    }

    /// <summary>
    /// Local execution setup: the machine-local prerequisites of running k6 here, separate from engine readiness. Container TLS trust = an
    /// optional corporate CA bundle mounted read-only into the container and validated by the container network check. TLS verification is
    /// never disabled and nothing here is stored in a Target Environment, the Setup Library or an import.
    /// </summary>
    private RenderFragment LocalExecutionSection() => __builder =>
    {
        <section class="pte-section" aria-labelledby="pte-local-heading" data-testid="pte-local">
            <h3 id="pte-local-heading" class="pte-section-title">Local execution setup</h3>
            <p class="pte-section-sub">What this machine needs to run the k6 container against a target. Separate from engine readiness: the engine can be ready while the container still cannot trust the target's certificate.</p>
            @if (_local is not { } le)
            {
                <p class="pte-error" role="alert" data-testid="pte-local-error">Local execution status could not be loaded.</p>
            }
            else
            {
                var trust = P.Trust(le.TrustState);
                <article id="container-tls-trust" tabindex="-1" class="pte-card pte-trust pte-tone-@trust.Tone.ToString().ToLowerInvariant()" data-testid="pte-ca-card" data-state="@le.TrustState" aria-labelledby="pte-ca-title">
                    <div class="pte-card-head">
                        <span class="pte-icon pte-icon-engine" aria-hidden="true"></span>
                        <div class="pte-card-titles">
                            <h4 id="pte-ca-title" class="pte-card-title">Container TLS trust</h4>
                            <p class="pte-card-kind">Corporate CA bundle for the k6 container</p>
                        </div>
                        <span data-testid="pte-ca-state">@Pill(trust, "Container TLS trust")</span>
                    </div>
                    <p class="pte-card-summary" role="status" data-testid="pte-ca-detail">@le.TrustDetail</p>
                    <p class="pte-guidance" data-testid="pte-ca-safety">TLS verification is never disabled. The bundle is mounted read-only into the container and used identically by the network check and the run.</p>

                    <dl class="pte-facts" data-testid="pte-ca-facts">
                        <div><dt>Source</dt><dd data-testid="pte-ca-source">@le.Source</dd></div>
                        <div><dt>CA bundle</dt><dd data-testid="pte-ca-file">@(le.BundleFileName ?? "None — default container CA store")</dd></div>
                        @if (le.BundleFileName is not null)
                        {
                            <div><dt>Bundle check</dt><dd data-testid="pte-ca-bundle-status">@le.BundleStatus@(le.Certificates > 0 ? $" · {le.Certificates} certificate{(le.Certificates == 1 ? "" : "s")}" : "")</dd></div>
                        }
                        @if (le.LastValidation is { } v)
                        {
                            <div><dt>Last network check</dt><dd data-testid="pte-ca-last-check">@v.TargetOrigin · @v.CheckedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") · @(v.Passed ? "reached" : "failed")</dd></div>
                        }
                    </dl>

                    <ol class="pte-stages" aria-label="Container network check stages" data-testid="pte-ca-stages">
                        @foreach (var stage in le.Stages)
                        {
                            <li data-testid="pte-ca-stage" data-stage="@stage.Key" data-state="@stage.State"><span class="pte-stage-name">@stage.Name</span> @Pill(P.Stage(stage.State), null)@if (stage.Detail.Length > 0) { <span class="pte-stage-detail">@stage.Detail</span> }</li>
                        }
                    </ol>
                    @if (le.LastValidation is null)
                    {
                        <p class="pte-guidance" data-testid="pte-ca-how-to-validate">Validate by running “Check container network” for a saved definition in Performance Test Review. It sends one request from the k6 container — never a load test.</p>
                    }

                    <form class="pte-ca-form" @onsubmit="SaveCaAsync" @onsubmit:preventDefault="true" data-testid="pte-ca-form">
                        <label for="pte-ca-path" class="pte-ca-label">CA bundle file on this machine (.pem, .crt or .cer — public certificates only)</label>
                        <div class="pte-ca-row">
                            <input id="pte-ca-path" type="text" class="pte-ca-input" data-testid="pte-ca-path" value="@_caPath" @oninput="e => _caPath = e.Value?.ToString() ?? string.Empty"
                                   placeholder="Full path, e.g. corporate-roots.pem" autocomplete="off" spellcheck="false" aria-describedby="pte-ca-help" />
                            <button type="submit" class="btn-primary" disabled="@(_caBusy || _caPath.Trim().Length == 0)" data-testid="pte-ca-save">@(_caBusy ? "Checking…" : "Validate and save")</button>
                            @if (le.Source == ContainerTlsTrustSources.SystemSettings)
                            {
                                <button type="button" class="btn-secondary" disabled="@_caBusy" @onclick="RemoveCaAsync" data-testid="pte-ca-remove">Remove</button>
                            }
                        </div>
                        <p id="pte-ca-help" class="pte-section-sub">The file is checked before it is saved: it must load as X.509 certificates; private keys and PFX/PKCS#12 files are refused. Only its path, file name, fingerprint and certificate count are stored for this machine — never the certificate content, and never in a Target Environment, the Setup Library or an import package.</p>
                        @if (_caMessage is { } msg) { <p class="@(_caError ? "pte-error" : "pte-guidance")" role="@(_caError ? "alert" : "status")" data-testid="pte-ca-message">@msg</p> }
                    </form>

                    <ReviewDisclosure Text="Technical details" CollapseText="Hide technical details" TestId="pte-ca-technical" Class="disclosure-inline disclosure-small">
                        <dl class="pte-tech">
                            @TechRow("Configuration key", le.ConfigurationKey, copy: true)
                            @TechRow("Bundle path", le.BundlePath)
                            @TechRow("Bundle fingerprint (SHA-256, first 16)", le.Fingerprint)
                            <div><dt>Bundle detail</dt><dd>@le.BundleDetail</dd></div>
                            @TechRow("Container image", le.Image)
                            @TechRow("Container network", le.Network ?? "Podman default")
                            <div><dt>Proxy</dt><dd>@(le.ProxyConfigured ? "Configured" : "None")</dd></div>
                            @if (le.LastValidation is { } tv)
                            {
                                <div><dt>Last check</dt><dd>@P.Stage(tv.Passed ? "Passed" : "Failed").Label · @tv.ProbeState@(tv.ErrorCode is { } code ? $" · code {code}" : "")</dd></div>
                            }
                        </dl>
                    </ReviewDisclosure>
                </article>
            }
        </section>
    };

    private async Task PullAsync(string providerId)
    {
        _pulling = true;
        var result = await _api!.PrepareProviderAsync(providerId);
        _pulling = false;
        _message = result.Value is null ? $"Not pulled: {result.Error}" : "Image pulled.";
        _providers = await _api.ProvidersOrNullAsync();
    }

    private async Task CopyAsync(string text)
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", text); _copied = text; }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException) { _copied = null; }
    }

    /// <summary>Status pill: glyph (decorative) + text; <paramref name="subject"/> prefixes the spoken text ("k6 status: Ready"). Null where
    /// the label right before it already names the subject (metric rows).</summary>
    private RenderFragment Pill(CapabilityStatus status, string? subject) =>
        @<span class="sd-pill @status.PillClass pte-pill pte-tone-@status.Tone.ToString().ToLowerInvariant()" data-status="@status.Label">@if (subject is not null) {<span class="visually-hidden">@subject status: </span>}<span class="pte-glyph" aria-hidden="true">@status.Glyph</span> @status.Label</span>;

    private RenderFragment TechRow(string label, string? value, bool copy = false) =>
        @<div>
            <dt>@label</dt>
            <dd class="pte-tech-value">
                @if (string.IsNullOrWhiteSpace(value)) { <span>—</span> }
                else
                {
                    <code>@value</code>
                    @if (copy)
                    {
                        <button type="button" class="pte-copy" @onclick="() => CopyAsync(value)" aria-label="@($"Copy {label.ToLowerInvariant()}")">@(_copied == value ? "Copied" : "Copy")</button>
                    }
                }
            </dd>
        </div>;

    private RenderFragment ResourceCard(ResourceProviderCapability r)
    {
        var status = P.Resource(r.Availability);
        var titleId = $"pte-res-{r.ProviderId.Replace('.', '-')}";
        var metrics = P.Metrics(r);
        return @<article class="pte-card pte-resource pte-tone-@status.Tone.ToString().ToLowerInvariant()" data-testid="pte-resource" data-provider="@r.ProviderId" data-availability="@r.Availability" aria-labelledby="@titleId">
            <div class="pte-card-head">
                <span class="pte-icon pte-icon-resource" aria-hidden="true"></span>
                <div class="pte-card-titles">
                    <h4 id="@titleId" class="pte-card-title">@r.DisplayName</h4>
                    @if (r.Scope is { } scope) { <p class="pte-scope" data-testid="pte-scope"><span class="visually-hidden">Scope: </span>@scope</p> }
                </div>
                @Pill(status, r.DisplayName)
            </div>
            <p class="pte-card-summary">@(r.Summary ?? r.Detail)</p>

            @if (metrics.Any(m => !m.Available))
            {
                <dl class="pte-metric-states" data-testid="pte-metric-states">
                    @foreach (var (label, available) in metrics)
                    {
                        <div data-available="@available.ToString().ToLowerInvariant()"><dt>@label</dt><dd>@Pill(P.Resource(available ? "Available" : "Unavailable"), null)</dd></div>
                    }
                </dl>
            }
            else if (metrics.Count > 0)
            {
                <ul class="pte-chips pte-chips-small" aria-label="@($"Metrics observed by {r.DisplayName}")" data-testid="pte-metrics">
                    @foreach (var (label, _) in metrics) { <li class="pte-chip is-on">@label</li> }
                </ul>
            }

            @if (r.Limits.Count > 0)
            {
                <ul class="pte-limits" data-testid="pte-limits">
                    @foreach (var limit in r.Limits)
                    {
                        <li><span class="pte-limit-label">@limit.Label</span> @Pill(P.Resource(limit.Status), null)<span class="pte-limit-reason">@limit.Reason</span></li>
                    }
                </ul>
            }

            @if (r.Availability is "Partial" or "Unavailable" or "Unsupported" && r.Summary is not null && r.Detail != r.Summary)
            {
                <ReviewDisclosure Text="@($"Why {status.Label.ToLowerInvariant()}?")" CollapseText="Hide explanation" Class="disclosure-inline disclosure-small pte-why"
                                  TestId="@($"pte-why-{r.ProviderId.Replace('.', '-')}")">
                    <p class="pte-why-text">@r.Detail</p>
                </ReviewDisclosure>
            }
        </article>;
    }
}
