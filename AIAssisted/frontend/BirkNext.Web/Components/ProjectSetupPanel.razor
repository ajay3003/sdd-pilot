@using BirkNext.Web.Models
@using BirkNext.Web.Services.ProjectEvidence
@inject IJSRuntime JS

@* Target Environment → Project evidence: binds imported evidence to the selected Target Application (which owns the application/system
   identity — this panel never chooses it). Strong suggestions are preselected and explained; possible matches are not. Saving applies the
   choices to the one canonical binding model the advanced evidence table below also shows. Nothing is imported, copied or deleted here. *@
<section class="psp" aria-labelledby="psp-title" data-testid="psp">
    @if (TargetApplication is null)
    {
        <h4 id="psp-title" class="psp-title" tabindex="-1">Target Application required</h4>
        <div class="psp-prerequisite" role="note" data-testid="psp-target-application-required">
            <p>Project evidence can be configured after choosing the application/system this environment represents.</p>
            <a class="btn btn-primary btn-sm" href="@TargetApplications.TabHref(EnvironmentId)" data-testid="psp-configure-target-application">Configure Target Application<span class="visually-hidden"> for @EnvironmentName</span></a>
        </div>
    }
    else
    {
        <h4 id="psp-title" class="psp-title" tabindex="-1">Project evidence for @_name</h4>
        @if (_groups.All(g => g.Items.Count == 0) && Current is null)
        {
            <p class="psp-muted" data-testid="psp-no-evidence">No compatible imported evidence is currently available for @_name. <a href="@BirkNext.Web.Services.ProjectImport.ProjectImportPresentation.ImportSourceHref" data-testid="psp-import-evidence">Import evidence</a> or add the evidence you expect below.</p>
        }
        else if (Current is null)
        {
            <p class="psp-muted" data-testid="psp-suggestions-lead">We found evidence that appears to belong to @_name. Strong matches are selected by default. Deselect anything that does not belong to this application.</p>
        }
    }

    @* 2 · Evidence checklist *@
    @if (TargetApplication is not null && _name is not null)
    {
        <div class="psp-roles" data-testid="psp-checklist">
            @foreach (var group in _groups)
            {
                var selectedCount = Selected(group).Count;
                var many = group.Items.Count > 3;
                <fieldset class="psp-role" data-testid="psp-role" data-role="@group.Role.RoleKey">
                    <legend class="psp-role-title">@group.Role.Label <span class="psp-badge">@(group.Role.Requirement == ProjectEvidenceRequirement.Required ? "Required" : "Optional")</span>
                        @if (group.Role.Origin == ProjectEvidenceRoleOrigin.Expected) { <span class="psp-badge">Expected</span> }
                        <span class="psp-muted" data-testid="psp-role-count">@selectedCount selected</span></legend>
                    @if (group.Items.Count == 0 && _added.GetValueOrDefault(group.Role.RoleKey) is null or { Count: 0 })
                    {
                        <p class="psp-muted" data-testid="psp-role-empty">@(group.Role.Origin == ProjectEvidenceRoleOrigin.Expected ? "Missing · expected evidence is not imported or bound yet." : "No suggestion.")</p>
                    }
                    @if (many)
                    {
                        <details data-testid="psp-role-packages"><summary>Show packages<span class="visually-hidden"> for @group.Role.Label</span> (@group.Items.Count)</summary>@Items(group)</details>
                    }
                    else { @Items(group) }
                    @if (group.Addable.Count > 0)
                    {
                        <label class="psp-add">+ Add imported package
                            <select class="form-select form-select-sm" data-testid="psp-add-package" aria-label="@($"Add an imported package to {group.Role.Label}")" @onchange="e => Add(group, e.Value?.ToString())">
                                <option value="">Choose…</option>
                                @foreach (var package in group.Addable.Where(p => !(_added.GetValueOrDefault(group.Role.RoleKey)?.Contains(p.ImportId) ?? false)))
                                { <option value="@package.ImportId">@package.ArchiveFileName · @package.Classification</option> }
                            </select>
                        </label>
                    }
                </fieldset>
            }
        </div>

        <details class="psp-expected" data-testid="psp-expected">
            <summary>+ Add expected evidence</summary>
            <p class="psp-muted">Name evidence @_name needs that is not imported yet (for example “SkoleAdapter source”). It stays Missing until a matching package is imported and bound — no package is created.</p>
            <label>Expected evidence <input class="form-control form-control-sm" maxlength="80" data-testid="psp-expected-label" @bind="_expectedLabel" @bind:event="oninput" /></label>
            <label>Type
                <select class="form-select form-select-sm" data-testid="psp-expected-capability" @bind="_expectedCapability">
                    @foreach (var capability in ExpectedCapabilities) { <option value="@capability">@ProjectEvidencePackages.CapabilityLabel(capability)</option> }
                </select>
            </label>
            <button type="button" class="btn btn-secondary btn-sm" data-testid="psp-expected-add" disabled="@string.IsNullOrWhiteSpace(_expectedLabel)" @onclick="AddExpected">Add expected evidence</button>
            @if (_expected.Count > 0) { <ul data-testid="psp-expected-list">@foreach (var e in _expected) { <li>@e.Label · @ProjectEvidencePackages.CapabilityLabel(e.Capability) · Missing</li> }</ul> }
        </details>

        <section class="psp-summary" aria-labelledby="psp-summary-h" data-testid="psp-summary">
            <h5 id="psp-summary-h">Project evidence summary · @_name</h5>
            <ul>
                @foreach (var group in _groups) { <li>@group.Role.Label: @Selected(group).Count selected</li> }
                <li data-testid="psp-required-summary">Required roles: @RequiredSatisfied / @RequiredTotal with a selected source</li>
                <li data-testid="psp-needs-decision">Needs decision: @NeedsDecision</li>
            </ul>
        </section>
        <div class="psp-actions">
            <button type="button" class="btn btn-primary" data-testid="psp-save" disabled="@_busy" @onclick="SaveAsync">Save Project evidence</button>
            @if (OnCancel.HasDelegate) { <button type="button" class="btn btn-secondary" data-testid="psp-cancel" @onclick="OnCancel">Cancel</button> }
            <span role="status" class="psp-muted" data-testid="psp-status">@_status</span>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public string EnvironmentId { get; set; } = "";
    [Parameter] public string? EnvironmentName { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<ProjectEvidencePackage> Packages { get; set; } = [];
    [Parameter] public EnvironmentProject? Current { get; set; }
    /// <summary>The environment's Target Application: the application this evidence is for. Null shows the prerequisite instead.</summary>
    [Parameter] public TargetApplicationIdentity? TargetApplication { get; set; }
    [Parameter, EditorRequired] public IProjectEvidenceService Evidence { get; set; } = default!;
    [Parameter] public EventCallback<string> OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private static readonly ProjectEvidenceCapability[] ExpectedCapabilities =
    [
        ProjectEvidenceCapability.ApplicationSource, ProjectEvidenceCapability.SupportingSource, ProjectEvidenceCapability.IntegrationSource,
        ProjectEvidenceCapability.Documentation, ProjectEvidenceCapability.ContractSchema, ProjectEvidenceCapability.Infrastructure,
    ];

    private string? _name, _description, _expectedLabel, _status;
    private ProjectEvidencePackage? _main;
    private bool _busy, _initialized;
    private ProjectEvidenceCapability _expectedCapability = ProjectEvidenceCapability.SupportingSource;
    private IReadOnlyList<ChecklistGroup> _groups = [];
    /// <summary>The checkbox state per role and package (initialised from the suggestions' defaults).</summary>
    private readonly Dictionary<(string Role, string Import), bool> _checked = [];
    private readonly Dictionary<string, List<string>> _added = [];
    private readonly List<(string Label, ProjectEvidenceCapability Capability)> _expected = [];

    protected override void OnParametersSet()
    {
        if (_initialized) return;
        _initialized = true;
        if (TargetApplication is not { } application) return;
        _name = application.Name;
        _description = Current?.Description ?? application.Description;
        _main = ProjectEvidenceResolver.Find(Packages, application.ImportId ?? Current?.ProjectImportId, application.ArchiveSha256 ?? Current?.ArchiveSha256);
        Rebuild();
    }

    /// <summary>A different project starts from the defaults; the same project keeps its roles, bindings and declines.</summary>
    private EnvironmentProject? SameProject => Current is { } c && string.Equals(c.ProjectName, _name, StringComparison.OrdinalIgnoreCase) ? c : null;

    private void Rebuild()
    {
        if (_name is null) return;
        _groups = ProjectSetupPlanner.Checklist(_name, _main, Packages, SameProject);
        _checked.Clear(); _added.Clear();
        foreach (var item in _groups.SelectMany(g => g.Items)) _checked[(item.RoleKey, item.Package.ImportId)] = item.Selected;
    }

    private bool IsChecked(string role, string import) => _checked.GetValueOrDefault((role, import));

    private void Toggle(ChecklistGroup group, ProjectEvidencePackage package, bool value)
    {
        // A single-source role holds one package: selecting another replaces it.
        if (value && group.Role.Cardinality == ProjectEvidenceCardinality.Single)
            foreach (var key in _checked.Keys.Where(k => k.Role == group.Role.RoleKey).ToList()) _checked[key] = false;
        _checked[(group.Role.RoleKey, package.ImportId)] = value;
    }

    private void Add(ChecklistGroup group, string? importId)
    {
        if (string.IsNullOrEmpty(importId)) return;
        if (!_added.TryGetValue(group.Role.RoleKey, out var list)) _added[group.Role.RoleKey] = list = [];
        if (!list.Contains(importId)) list.Add(importId);
        if (Packages.FirstOrDefault(p => p.ImportId == importId) is { } package) Toggle(group, package, true);
    }

    private void AddExpected()
    {
        if (string.IsNullOrWhiteSpace(_expectedLabel)) return;
        _expected.Add((_expectedLabel.Trim(), _expectedCapability));
        _expectedLabel = null;
    }

    private IReadOnlyList<string> Selected(ChecklistGroup group) => [.. _checked.Where(k => k.Key.Role == group.Role.RoleKey && k.Value).Select(k => k.Key.Import)];
    private int RequiredTotal => _groups.Count(g => g.Role.Requirement == ProjectEvidenceRequirement.Required) + _expected.Count;
    private int RequiredSatisfied => _groups.Count(g => g.Role.Requirement == ProjectEvidenceRequirement.Required && Selected(g).Count > 0);
    private int NeedsDecision => _groups.Count(g => g.Role.Cardinality == ProjectEvidenceCardinality.Single && Selected(g).Count == 0 && g.Items.Count > 1);

    private RenderFragment Items(ChecklistGroup group) => __builder =>
    {
        <ul class="psp-items">
            @foreach (var item in group.Items.Concat(AddedItems(group)))
            {
                var id = $"psp-{EnvironmentId}-{group.Role.RoleKey}-{item.Package.ImportId}";
                <li class="psp-item" data-testid="psp-item" data-import="@item.Package.ImportId" data-strength="@item.Strength">
                    <input type="checkbox" id="@id" checked="@IsChecked(group.Role.RoleKey, item.Package.ImportId)" aria-describedby="@($"{id}-why")"
                           data-testid="psp-check" @onchange="e => Toggle(group, item.Package, e.Value is true)" />
                    <label for="@id"><strong>@item.Package.ArchiveFileName</strong> <span class="psp-badge psp-badge-@(item.Strength == EvidenceMatchStrength.Strong ? "strong" : "possible")" data-testid="psp-badge">@item.Badge</span></label>
                    <span id="@($"{id}-why")" class="psp-why" data-testid="psp-why">@item.Package.Classification · @item.Reason</span>
                </li>
            }
        </ul>
    };

    private IEnumerable<ChecklistItem> AddedItems(ChecklistGroup group) =>
        (_added.GetValueOrDefault(group.Role.RoleKey) ?? []).Select(id => Packages.FirstOrDefault(p => p.ImportId == id)).OfType<ProjectEvidencePackage>()
            .Select(p => new ChecklistItem(group.Role.RoleKey, p, EvidenceMatchStrength.Possible, true, "Added by you", false, false));

    private async Task SaveAsync()
    {
        if (_name is null) return;
        _busy = true;
        try
        {
            var decisions = _groups.Select(g => new ProjectSetupPlanner.RoleDecision(g.Role.RoleKey, Selected(g),
                [.. g.Items.Where(i => (i.Strength == EvidenceMatchStrength.Strong || i.Bound) && !IsChecked(g.Role.RoleKey, i.Package.ImportId)).Select(i => i.Package.ImportId)])).ToList();
            var saved = await Evidence.SaveProjectAsync(EnvironmentId, new ProjectSetupDraft(_name, _description, _main?.ImportId, decisions, [.. _expected]));
            _status = saved ? $"Project evidence for {_name} saved." : "The Project evidence could not be saved.";
            if (saved) await OnSaved.InvokeAsync(_name);
        }
        finally { _busy = false; }
    }
}
