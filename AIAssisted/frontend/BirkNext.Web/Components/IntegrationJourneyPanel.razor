@using BirkNext.Integrations
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@implements IDisposable
@inject IServiceProvider Services
@inject IReportExportService ExportService
@inject IWorkspaceSessionService Workspace
@inject IJSRuntime JS

@* IQR → Integration journeys: one shared view for every registered journey pack. Each journey shows its steps as separate evidence
   (configured ≠ observed ≠ verified), its prerequisites, scenarios and history. Delegated journeys (e.g. CDC) are executed by Active tests
   above and only summarized here. Architecture rules are evaluated by the backend on Source Analysis evidence. Nothing here is domain-specific:
   pack, journey and step labels come from the backend.
   Embedded: a host page (a test pack's own page) shows exactly one view of one pack — no heading, pack picker, trust line or tab bar — so the
   host's navigation stays the only navigation. Execution, steps and history remain this shared component's. *@
@if (Api is null) { return; }
<section class="ijp @(Embedded ? "ijp-is-embedded" : "")" aria-labelledby="@(Embedded ? null : "ijp-heading")" aria-label="@(Embedded ? "Journey details" : null)" data-testid="ijp-panel" data-embedded="@(Embedded ? "true" : "false")">
    @if (!Embedded) { <h2 id="ijp-heading">Integration journeys</h2> }
    @if (_error is { } error) { <p class="ijp-error" role="alert" data-testid="ijp-error">@error</p> }
    @if (_loading) { <p class="ijp-muted" role="status">Loading journeys…</p> }
    @if (!_loading && _packs.Count == 0 && _error is null) { <p class="ijp-empty" data-testid="ijp-empty">No journey packs are registered.</p> }

    @if (_packs.Count > 1 && !Embedded && PackId is null)
    {
        <fieldset class="ijp-packs" data-testid="ijp-packs">
            <legend>Journey pack</legend>
            @foreach (var item in _packs)
            {
                <label class="ijp-pack-option">
                    <input type="radio" name="ijp-pack-@_id" checked="@(item.PackId == _packId)" data-testid="@($"ijp-pack-{item.PackId}")" @onchange="() => SelectPack(item.PackId)" />
                    <span>@item.DisplayName</span>
                </label>
            }
        </fieldset>
    }

    @if (Pack is { } pack)
    {
        @if (!Embedded)
        {
            <h3 class="ijp-pack-title" data-testid="ijp-pack-title">@pack.DisplayName</h3>
            <p class="ijp-muted">@pack.Description</p>
            <p class="ijp-trust" data-testid="ijp-trust" data-trusted="@(pack.EnvironmentTrusted ? "true" : "false")">
                <span class="ijp-muted">Active execution</span>
                <span class="ijp-pill ijp-pill-@(pack.EnvironmentTrusted ? "ready" : "neutral")">@TestPackPresentation.ActiveExecution(pack)</span>
                <span class="ijp-muted">@pack.EnvironmentDetail</span>
                @if (!pack.EnvironmentTrusted) { <a class="ijp-link" href="@TestPackPresentation.ExecutionSettingsHref" data-testid="ijp-trust-settings">Target Environment safety</a> }
            </p>

            <div class="ijp-tabs" role="tablist" aria-label="@($"{pack.DisplayName} views")" data-testid="ijp-tabs">
                @foreach (var tab in Tabs)
                {
                    <button type="button" role="tab" id="@TabId(tab.Key)" class="ijp-tab @(_tab == tab.Key ? "ijp-tab-active" : "")" aria-selected="@(_tab == tab.Key ? "true" : "false")"
                            aria-controls="@($"{_id}-panel")" tabindex="@(_tab == tab.Key ? "0" : "-1")" data-testid="@($"ijp-tab-{tab.Key}")" @ref="_tabRefs[tab.Key]"
                            @onclick="() => SelectTabAsync(tab.Key)" @onkeydown="e => OnTabKeyAsync(e, tab.Key)">@tab.Label</button>
                }
            </div>
        }
        <div id="@($"{_id}-panel")" role="@(Embedded ? null : "tabpanel")" aria-labelledby="@(Embedded ? null : TabId(_tab))" class="ijp-tabpanel" data-testid="ijp-tabpanel" data-tab="@_tab" tabindex="@(Embedded ? null : "0")">
            @if (_tab == "overview")
            {
                <div class="ijp-table" tabindex="0" role="region" aria-label="Journey overview" data-testid="ijp-overview">
                    <table>
                        <thead><tr><th scope="col">Journey</th><th scope="col">Configuration</th><th scope="col">Source evidence</th><th scope="col">Execution readiness</th><th scope="col">Last run</th><th scope="col">Verification</th></tr></thead>
                        <tbody>
                            @foreach (var view in pack.Journeys)
                            {
                                <tr data-testid="ijp-overview-row" data-journey="@view.Journey.JourneyId" data-readiness="@view.Readiness">
                                    <th scope="row">@view.Journey.DisplayName</th>
                                    <td>@IntegrationJourneyPresentation.Configuration(view)</td>
                                    <td>@IntegrationJourneyPresentation.Source(view)</td>
                                    <td><span class="ijp-pill ijp-pill-@IntegrationJourneyPresentation.ReadinessTone(view.Readiness)">@IntegrationJourneyPresentation.Readiness(view.Readiness)</span></td>
                                    <td>@(view.LastRun is { } last ? $"{last.StartedAt:yyyy-MM-dd HH:mm} UTC" : "No run")</td>
                                    <td>@IntegrationJourneyPresentation.Verification(view)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="ijp-muted">Configured ≠ source verified ≠ executable ≠ runtime verified. Accepted or observed is never a pass.</p>
                @if (pack.Limitations.Count > 0)
                {
                    <details class="ijp-details" data-testid="ijp-limitations"><summary>Limitations</summary><ul>@foreach (var item in pack.Limitations) { <li>@item</li> }</ul></details>
                }
            }
            else if (_tab == "scenarios")
            {
                <p class="ijp-muted" data-testid="ijp-capability-intro">What each scenario needs, whether BirkNext can start it now, and how far its result can be verified. Execution and verification are separate: a runnable scenario is not a passed one, and Not assessed is never a pass.</p>
                @if (pack.EvidenceLimitations.Count > 0)
                {
                    <h4 class="ijp-capability-heading">Evidence limitations</h4>
                    <ul class="ijp-limitations" data-testid="ijp-evidence-limitations">
                        @foreach (var limitation in pack.EvidenceLimitations)
                        {
                            <li data-testid="ijp-evidence-limitation" data-key="@limitation.Key"><strong>@limitation.Title</strong> <span class="ijp-pill ijp-pill-neutral">@limitation.Status</span>
                                <span class="ijp-capability-text">@limitation.Detail</span> <span class="ijp-muted">Owner: @limitation.Owner</span></li>
                        }
                    </ul>
                }
                @foreach (var view in pack.Journeys.Where(item => item.ScenarioCapabilities.Count > 0))
                {
                    <h4 class="ijp-capability-heading">@view.Journey.DisplayName</h4>
                    <div data-testid="ijp-capabilities" data-journey="@view.Journey.JourneyId">
                        @* CDC scenarios are grouped by their source table; not-assessed scenarios fold into one collapsed group per table or journey. *@
                        @foreach (var group in view.ScenarioCapabilities.GroupBy(item => item.Resource))
                        {
                            var active = group.Where(item => item.Status != JourneyScenarioCapabilityStatus.NotAssessed).ToList();
                            var notAssessed = group.Where(item => item.Status == JourneyScenarioCapabilityStatus.NotAssessed).ToList();
                            <div class="ijp-capability-group" data-testid="ijp-capability-group" data-resource="@(group.Key ?? "")">
                                @if (group.Key is { } resource) { <h5 class="ijp-capability-subheading">Source table @resource</h5> }
                                <p class="ijp-muted" data-testid="ijp-capability-summary">@IntegrationJourneyPresentation.CapabilitySummary(group.Select(item => item.Status))</p>
                                @if (active.Count > 0)
                                {
                                    <ul class="ijp-capabilities" aria-label="@(group.Key is { } table ? $"{view.Journey.DisplayName} scenarios for {table}" : $"{view.Journey.DisplayName} scenarios")">@foreach (var capability in active) { @CapabilityCard(capability) }</ul>
                                }
                                @if (notAssessed.Count > 0)
                                {
                                    <details class="ijp-details ijp-not-assessed" data-testid="ijp-not-assessed">
                                        <summary>Not assessed (@notAssessed.Count)</summary>
                                        <ul class="ijp-capabilities">@foreach (var capability in notAssessed) { @CapabilityCard(capability) }</ul>
                                    </details>
                                }
                            </div>
                        }
                    </div>
                }
            }
            else if (_tab == "rules")
            {
                @if (_rulesLoading) { <p class="ijp-muted" role="status">Evaluating architecture rules…</p> }
                @if (_rules is { } rules)
                {
                    <p class="ijp-muted" data-testid="ijp-rules-source">Source: @(rules.SourceArchive ?? "no Source Analysis snapshot") · rules are checked on source dependency evidence, not on names alone.</p>
                    <ul class="ijp-rules" data-testid="ijp-rules">
                        @foreach (var finding in rules.Findings)
                        {
                            <li class="ijp-rule" data-testid="ijp-rule" data-rule="@finding.RuleId" data-outcome="@finding.Outcome">
                                <span class="ijp-rule-title">@finding.Title</span>
                                <span class="ijp-pill ijp-pill-@IntegrationJourneyPresentation.RuleTone(finding.Outcome)">@IntegrationJourneyPresentation.Rule(finding.Outcome)</span>
                                <span class="ijp-muted">@finding.SubjectLabel @IntegrationJourneyPresentation.Expectation(finding.Expectation).ToLowerInvariant() @finding.TargetLabel</span>
                                <span class="ijp-rule-detail">@finding.Detail</span>
                                @if (finding.Evidence.Count > 0)
                                {
                                    <details class="ijp-details"><summary>Source evidence (@finding.Evidence.Count)</summary>
                                        <ul>@foreach (var item in finding.Evidence) { <li><span class="ijp-mono">@item.File:@item.Line</span> @item.Symbol — @item.Explanation</li> }</ul>
                                    </details>
                                }
                            </li>
                        }
                    </ul>
                    @if (rules.Limitations.Count > 0) { <ul class="ijp-notes">@foreach (var item in rules.Limitations) { <li>@item</li> }</ul> }
                }
            }
            else if (_tab == "history")
            {
                <div class="ijp-filters" data-testid="ijp-history-filters">
                    <label for="@($"{_id}-hj")">Journey</label>
                    <select id="@($"{_id}-hj")" data-testid="ijp-history-journey" value="@_historyJourney" @onchange="OnHistoryJourneyAsync">
                        <option value="">All journeys</option>
                        @foreach (var view in pack.Journeys) { <option value="@view.Journey.JourneyId">@view.Journey.DisplayName</option> }
                    </select>
                    <label for="@($"{_id}-hs")">Result</label>
                    <select id="@($"{_id}-hs")" data-testid="ijp-history-state" value="@(_historyState?.ToString() ?? "")" @onchange="OnHistoryStateAsync">
                        <option value="">All results</option>
                        @foreach (var state in Enum.GetValues<JourneyRunState>()) { <option value="@state">@IntegrationJourneyPresentation.Run(state)</option> }
                    </select>
                </div>
                @if (_historyError is { } historyError) { <p class="ijp-empty" data-testid="ijp-history-error">@historyError</p> }
                else if (_history.Count == 0) { <p class="ijp-empty" data-testid="ijp-history-empty">No journey runs are recorded for this environment.</p> }
                else
                {
                    <div class="ijp-table" tabindex="0" role="region" aria-label="Journey run history" data-testid="ijp-history">
                        <table>
                            <thead><tr><th scope="col">Journey</th><th scope="col">Scenario</th><th scope="col">Environment</th><th scope="col">Started</th><th scope="col">Result</th><th scope="col">Evidence completeness</th><th scope="col">Limitations</th><th scope="col">Payload flow</th></tr></thead>
                            <tbody>
                                @foreach (var run in _history)
                                {
                                    <tr data-testid="ijp-history-row"><td>@JourneyName(run.JourneyId)</td><td>@run.ScenarioId</td><td>@run.EnvironmentId</td><td>@($"{run.StartedAt:yyyy-MM-dd HH:mm} UTC")</td>
                                        <td><span class="ijp-pill ijp-pill-neutral">@IntegrationJourneyPresentation.Run(run.State)</span></td><td>@run.VerifiedSteps of @run.TotalSteps steps verified</td><td>@run.LimitationCount</td>
                                        <td><button type="button" class="btn-secondary" data-testid="ijp-history-flow" aria-pressed="@(_historyFlowRun == run.RunId ? "true" : "false")"
                                                    aria-label="@($"Payload flow of the run started {run.StartedAt:yyyy-MM-dd HH:mm} UTC")" @onclick="() => LoadHistoryFlowAsync(run.RunId)">View</button></td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (_historyFlowError is { } flowError) { <p class="ijp-empty" role="status" data-testid="ijp-history-flow-error">@flowError</p> }
                    @if (_historyFlow is { } historyFlow) { <div data-testid="ijp-history-flow-view"><PayloadFlowPanel @key="historyFlow.RunId" Flow="historyFlow" /></div> }
                }
            }
            else if (pack.Journeys.FirstOrDefault(item => item.Journey.JourneyId == _tab) is { } view)
            {
                <div class="ijp-journey" data-testid="ijp-journey" data-journey="@view.Journey.JourneyId" data-readiness="@view.Readiness">
                    <p>@view.Journey.Description</p>
                    <p data-testid="ijp-readiness"><span class="ijp-pill ijp-pill-@IntegrationJourneyPresentation.ReadinessTone(view.Readiness)">@IntegrationJourneyPresentation.Readiness(view.Readiness)</span> <span class="ijp-muted">@view.ReadinessSummary</span></p>
                    <ul class="ijp-maturity" data-testid="ijp-maturity" aria-label="Evidence maturity">
                        <li data-on="@view.Maturity.Configured">Configured: @(view.Maturity.Configured ? "yes" : "no")</li>
                        <li data-on="@view.Maturity.SourceVerified">Source verified: @(view.Maturity.SourceVerified ? "yes" : "no")</li>
                        <li data-on="@view.Maturity.Executable">Executable: @(view.Maturity.Executable ? "yes" : "no")</li>
                        <li data-on="@view.Maturity.RuntimeVerified">Runtime verified: @(view.Maturity.RuntimeVerified ? "yes" : "no")</li>
                    </ul>
                    @if (view.Journey.ExecutionMode == JourneyExecutionMode.DelegatedToActiveEvent)
                    {
                        <p class="ijp-note" role="note" data-testid="ijp-delegated">This journey runs through Active tests (provider <span class="ijp-mono">@view.Journey.DelegatedProviderId</span>). Its scenarios, safety checks, run evidence and history live there; readiness below is taken from it.</p>
                    }

                    <h4 class="ijp-subheading" id="@($"{_id}-steps-{view.Journey.JourneyId}")">Journey steps</h4>
                    @* Configured, Observed, Verified and the step's assessment are separate columns: one never implies the next. *@
                    <div class="ijp-steps-wrap" role="region" aria-labelledby="@($"{_id}-steps-{view.Journey.JourneyId}")">
                        <table class="ijp-steps-table" role="table" data-testid="ijp-steps">
                            <thead role="rowgroup"><tr role="row"><th role="columnheader" scope="col">Step</th><th role="columnheader" scope="col">Configured</th><th role="columnheader" scope="col">Observed</th><th role="columnheader" scope="col">Verified</th><th role="columnheader" scope="col">Assessment</th></tr></thead>
                            <tbody role="rowgroup">
                                @foreach (var step in view.Journey.Steps)
                                {
                                    var status = view.StepStatus.FirstOrDefault(item => item.StepId == step.StepId);
                                    var state = status?.State ?? JourneyStepState.NotAssessed;
                                    <tr role="row" class="ijp-step" data-testid="ijp-step" data-step="@step.StepId" data-state="@state">
                                        <th role="rowheader" scope="row"><span class="ijp-step-label">@step.Label</span><span class="ijp-step-owner">@step.Owner · @IntegrationJourneyPresentation.Kind(step.Kind)</span>@if (status?.Limitation is { Length: > 0 } limitation) { <span class="ijp-step-limit">@limitation</span> }</th>
                                        <td role="cell" data-label="Configured" data-testid="ijp-step-configured">@(status?.Configured == true ? "Configured" : step.IntegrationKey is null ? "Not applicable" : "Not configured")</td>
                                        <td role="cell" data-label="Observed" data-testid="ijp-step-observed">@(status?.Observable == true ? "Observer available" : "No observer")</td>
                                        <td role="cell" data-label="Verified" data-testid="ijp-step-verified">@(status?.Verifiable == true ? "Verifier available" : "No verifier")</td>
                                        <td role="cell" data-label="Assessment"><span class="ijp-pill ijp-pill-@IntegrationJourneyPresentation.StepTone(state)" data-testid="ijp-step-assessment">@IntegrationJourneyPresentation.Step(state)</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <h4 class="ijp-subheading">Integrations (from Integration Quality Review)</h4>
                    <ul class="ijp-notes" data-testid="ijp-integrations">@foreach (var item in view.MatchedIntegrations) { <li data-configured="@(item.IntegrationId is not null)">@(item.DisplayName ?? item.RequirementKey) (@item.Kind): @item.Detail</li> }</ul>

                    @if (ShowPrerequisites)
                    {
                    <h4 class="ijp-subheading">Prerequisites</h4>
                    <ul class="ijp-checks" data-testid="ijp-prerequisites">
                        @foreach (var item in view.Prerequisites)
                        {
                            <li class="ijp-check" data-testid="ijp-prerequisite" data-key="@item.Key" data-state="@item.State" data-category="@item.Category">
                                <span class="ijp-check-label">@item.Label <span class="ijp-muted">· @IntegrationJourneyPresentation.Category(item.Category)</span></span>
                                <span class="ijp-pill ijp-pill-@IntegrationJourneyPresentation.ReadinessTone(item.State)">@IntegrationJourneyPresentation.Readiness(item.State)</span>
                                <span class="ijp-check-detail">@item.Detail</span>
                            </li>
                        }
                    </ul>
                    }

                    <h4 class="ijp-subheading">Scenarios</h4>
                    <ul class="ijp-checks" data-testid="ijp-scenarios">
                        @foreach (var scenario in view.Journey.Scenarios)
                        {
                            <li class="ijp-check" data-testid="ijp-scenario" data-scenario="@scenario.ScenarioId" data-support="@scenario.Support">
                                <span class="ijp-check-label">@scenario.DisplayName</span>
                                <span class="ijp-pill ijp-pill-@(scenario.Support == JourneyScenarioSupport.Supported ? "neutral" : "attention")">@(scenario.Support == JourneyScenarioSupport.Supported ? "Supported" : "Not assessed")</span>
                                <span class="ijp-check-detail">@(scenario.NotAssessedBecause ?? scenario.Description)</span>
                            </li>
                        }
                    </ul>

                    @if (view.Journey.ExecutionMode == JourneyExecutionMode.JourneyRunner)
                    {
                        var supported = view.Journey.Scenarios.Where(item => item.Support == JourneyScenarioSupport.Supported).ToList();
                        <div class="ijp-run" data-testid="ijp-run">
                            @if (supported.Count > 0)
                            {
                                <label for="@($"{_id}-scenario-{view.Journey.JourneyId}")">Scenario to run</label>
                                <select id="@($"{_id}-scenario-{view.Journey.JourneyId}")" data-testid="ijp-run-scenario" value="@SelectedScenario(view)" @onchange="e => SetScenario(view, e)">
                                    @foreach (var item in supported) { <option value="@item.ScenarioId">@item.DisplayName</option> }
                                </select>
                            }
                            @if (ScenarioOf(view) is { Inputs.Count: > 0 } withInputs)
                            {
                                <fieldset class="ijp-inputs" data-testid="ijp-inputs" disabled="@_running">
                                    <legend>Scenario inputs</legend>
                                    @foreach (var input in withInputs.Inputs!)
                                    {
                                        var inputId = $"{_id}-in-{view.Journey.JourneyId}-{input.Key}";
                                        var helpId = $"{inputId}-help";
                                        var value = InputValue(view, input.Key);
                                        <div class="ijp-input" data-testid="ijp-input" data-key="@input.Key">
                                            <label for="@inputId">@input.Label@(input.Required ? " (required)" : "")</label>
                                            @switch (input.Kind)
                                            {
                                                case JourneyScenarioInputKind.Choice:
                                                    <select id="@inputId" value="@value" aria-describedby="@(input.Help.Length > 0 ? helpId : null)" @onchange="e => SetInput(view, input.Key, e)">
                                                        <option value="">Choose…</option>
                                                        @foreach (var option in input.Options ?? []) { <option value="@option.Value">@option.Label</option> }
                                                    </select>
                                                    break;
                                                case JourneyScenarioInputKind.Date:
                                                    <input id="@inputId" type="date" value="@value" aria-describedby="@(input.Help.Length > 0 ? helpId : null)" @onchange="e => SetInput(view, input.Key, e)" />
                                                    break;
                                                case JourneyScenarioInputKind.Number:
                                                    <input id="@inputId" type="number" min="0" step="any" inputmode="decimal" value="@value" aria-describedby="@(input.Help.Length > 0 ? helpId : null)" @onchange="e => SetInput(view, input.Key, e)" />
                                                    break;
                                                case JourneyScenarioInputKind.Reference:
                                                    <input id="@inputId" type="text" autocomplete="off" spellcheck="false" maxlength="64" value="@value"
                                                           aria-describedby="@(input.Help.Length > 0 ? helpId : null)" @onchange="e => SetInput(view, input.Key, e)" />
                                                    break;
                                                default:
                                                    <input id="@inputId" type="text" inputmode="numeric" autocomplete="off" spellcheck="false" maxlength="11" value="@value"
                                                           aria-describedby="@(input.Help.Length > 0 ? helpId : null)" @onchange="e => SetInput(view, input.Key, e)" />
                                                    break;
                                            }
                                            @if (input.Help.Length > 0) { <span id="@helpId" class="ijp-muted">@input.Help</span> }
                                        </div>
                                    }
                                    <p class="ijp-muted">Inputs are validated by the backend, used for this run only and never stored; history keeps a redacted summary.</p>
                                </fieldset>
                            }
                            @if (!_confirming)
                            {
                                <div class="ijp-actions">
                                    <button type="button" class="btn-secondary" data-testid="ijp-validate" disabled="@(!CanValidate(view))" @onclick="() => ValidateAsync(view)">Validate run (no external calls)</button>
                                    <button type="button" class="btn-primary" data-testid="ijp-start" disabled="@(!CanRun(view))" aria-describedby="@($"{_id}-run-note")" @onclick="() => _confirming = true">Run journey</button>
                                </div>
                            }
                            else
                            {
                                <div class="ijp-confirm" role="group" aria-labelledby="@($"{_id}-confirm-heading")" data-testid="ijp-confirm">
                                    <h5 id="@($"{_id}-confirm-heading")">Confirm journey run</h5>
                                    <p>Environment: @pack.EnvironmentId · Journey: @view.Journey.DisplayName · Scenario: @SelectedScenario(view)</p>
                                    <p>Integrations: @string.Join(", ", view.MatchedIntegrations.Select(item => item.DisplayName ?? item.RequirementKey))</p>
                                    @if (ScenarioOf(view)?.StateChanging == false)
                                    {
                                        <p data-testid="ijp-confirm-read-only"><strong>Read-only: this run reads existing data and submits or changes nothing.</strong></p>
                                    }
                                    else
                                    {
                                        <p><strong>This run may change downstream state in the non-production environment. Only synthetic test data is used.</strong></p>
                                        <p data-testid="ijp-confirm-external">This is a real external call to the configured test environment: one attempt, nothing is retried. Validate the run first if you have not.</p>
                                        @if (ScenarioOf(view)?.ExecutionEffects is { Count: > 0 } effects)
                                        {
                                            <ul class="ijp-effects" data-testid="ijp-confirm-effects" aria-label="What this run will do">@foreach (var effect in effects) { <li>@effect</li> }</ul>
                                        }
                                    }
                                    <label class="ijp-ack"><input type="checkbox" data-testid="ijp-ack" @bind="_acknowledged" /> I confirm this synthetic run against the trusted non-production environment.</label>
                                    <div class="ijp-actions">
                                        <button type="button" class="btn-primary" data-testid="ijp-confirm-run" disabled="@(!_acknowledged || _running)" @onclick="() => StartAsync(view)">Confirm and run</button>
                                        <button type="button" class="btn-secondary" data-testid="ijp-confirm-cancel" @onclick="CancelConfirm">Cancel</button>
                                    </div>
                                </div>
                            }
                            <p id="@($"{_id}-run-note")" class="ijp-muted" data-testid="ijp-run-note">@RunNote(view)</p>
                            @if (_validating) { <p class="ijp-muted" role="status" data-testid="ijp-validating">Validating… no external call is made.</p> }
                            @if (_validation is { } validation && validation.JourneyId == view.Journey.JourneyId)
                            {
                                <section class="ijp-validation" aria-labelledby="@($"{_id}-validation-heading")" data-testid="ijp-validation" data-valid="@(validation.Valid ? "true" : "false")">
                                    <h5 id="@($"{_id}-validation-heading")">Run validation <span class="ijp-pill ijp-pill-neutral">@(validation.Valid ? "Valid — not executed" : "Not valid")</span></h5>
                                    <p class="ijp-muted">@validation.Note</p>
                                    <ul class="ijp-notes" aria-label="Validation checks">
                                        @foreach (var check in validation.Checks)
                                        {
                                            <li data-testid="ijp-validation-check" data-key="@check.Key" data-passed="@(check.Passed ? "true" : "false")" data-blocking="@(check.Blocking ? "true" : "false")">
                                                <strong>@(check.Passed ? "Passed" : check.Blocking ? "Not passed" : "Risk"):</strong> @check.Label — @check.Detail
                                            </li>
                                        }
                                    </ul>
                                    @if (validation.Preview.Count > 0)
                                    {
                                        <dl class="ijp-facts" data-testid="ijp-validation-preview" aria-label="Redacted payload preview">@foreach (var fact in validation.Preview) { <div><dt>@fact.Label</dt><dd>@fact.Value</dd></div> }</dl>
                                    }
                                    @if (validation.PayloadFlow is { } dryRunFlow) { <PayloadFlowPanel Flow="dryRunFlow" /> }
                                </section>
                            }
                            @if (_running) { <p class="ijp-muted" role="status" data-testid="ijp-running">Running… each step is recorded separately as its evidence arrives.</p> }
                            @if (_lastRun is { } run && run.JourneyId == view.Journey.JourneyId)
                            {
                                <div class="ijp-table" tabindex="0" role="region" aria-label="Last journey run" data-testid="ijp-last-run" data-state="@run.OverallState">
                                    <p><span class="ijp-pill ijp-pill-neutral">@IntegrationJourneyPresentation.Run(run.OverallState)</span> @run.StateReason</p>
                                    @if (run.InputSummary.Count > 0) { <ul class="ijp-notes" data-testid="ijp-run-inputs" aria-label="Run inputs (redacted)">@foreach (var item in run.InputSummary) { <li>@item</li> }</ul> }
                                    <table>
                                        <thead><tr><th scope="col">Step</th><th scope="col">State</th><th scope="col">Evidence</th><th scope="col">Reason</th></tr></thead>
                                        <tbody>@foreach (var step in run.Steps)
                                        {
                                            <tr data-testid="ijp-last-run-step" data-step="@step.StepId" data-state="@step.State"><td>@step.Label</td><td>@IntegrationJourneyPresentation.Step(step.State)</td>
                                                <td>@step.Evidence
                                                    @if (step.Facts.Count > 0)
                                                    {
                                                        <dl class="ijp-facts" data-testid="ijp-step-facts">@foreach (var fact in step.Facts) { <div><dt>@fact.Label</dt><dd>@fact.Value</dd></div> }</dl>
                                                    }
                                                </td><td>@step.Reason</td></tr>
                                        }</tbody>
                                    </table>
                                </div>
                                @if (_lastRunFlow is { } runFlow && runFlow.RunId == run.RunId) { <PayloadFlowPanel @key="runFlow.RunId" Flow="runFlow" /> }
                            }
                        </div>
                    }
                    @if (view.Journey.Limitations.Count > 0) { <ul class="ijp-notes" data-testid="ijp-journey-limitations">@foreach (var item in view.Journey.Limitations) { <li>@item</li> }</ul> }
                    <p class="ijp-muted">Evidence basis: @view.Journey.EvidenceBasis</p>
                </div>
            }
        </div>
        @if (!Embedded || _tab == "history")
        {
            @* An empty history has nothing to export: the button waits until there is a run. *@
            var nothingToExport = _tab == "history" && _history.Count == 0;
            <div class="ijp-actions">
                <button type="button" class="btn-secondary" data-testid="ijp-export" @onclick="ExportAsync" disabled="@nothingToExport" aria-describedby="@(nothingToExport ? $"{_id}-export-note" : null)">Export HTML</button>
                @if (nothingToExport) { <span class="ijp-muted" id="@($"{_id}-export-note")" data-testid="ijp-export-note">Available once a run is recorded.</span> }
            </div>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public FrontendAnalysisProfile Profile { get; set; } = default!;
    /// <summary>A journey tab to open first (e.g. from a domain page section), or "history". Unknown ids leave the overview open.</summary>
    [Parameter] public string? InitialJourneyId { get; set; }
    /// <summary>Shows only this pack (no pack picker). Null: every registered pack, the first selected.</summary>
    [Parameter] public string? PackId { get; set; }
    /// <summary>Hosted inside a test pack's page: exactly one view (<see cref="InitialJourneyId"/>) without heading, picker, trust line or tabs.</summary>
    [Parameter] public bool Embedded { get; set; }
    /// <summary>False when the host page already presents the journey's prerequisites (grouped by category).</summary>
    [Parameter] public bool ShowPrerequisites { get; set; } = true;

    private readonly string _id = "ijp-" + Guid.NewGuid().ToString("N")[..8];
    private readonly CancellationTokenSource _disposed = new();
    private IIntegrationJourneysApiService? _api;
    private ActiveEventAuthenticationState? _authentication;
    private List<IntegrationJourneyPackView> _packs = [];
    private string _packId = "";
    private string _tab = "overview";
    private string? _loadedFor;
    private bool _loading;
    private string? _error;
    private ArchitectureRuleReport? _rules;
    private bool _rulesLoading;
    private List<IntegrationJourneyRunSummary> _history = [];
    private string? _historyError;
    private string _historyJourney = "";
    private JourneyRunState? _historyState;
    private readonly Dictionary<string, string> _scenario = new(StringComparer.Ordinal);
    private readonly Dictionary<string, ElementReference> _tabRefs = new(StringComparer.Ordinal);
    private bool _confirming;
    private bool _acknowledged;
    private bool _running;
    private IntegrationJourneyRun? _lastRun;

    private IIntegrationJourneysApiService? Api => _api ??= Services.GetService<IIntegrationJourneysApiService>();
    private ActiveEventAuthenticationState Authentication => _authentication ??= Services.GetService<ActiveEventAuthenticationState>() ?? ActiveEventAuthenticationState.NotConfigured;
    private ExecutionAccessView? _access;
    /// <summary>Run is offered when the deployment signs users in (Entra) or the backend reports execution access (e.g. local trusted
    /// execution). Only a hint: the backend re-checks ActiveEventExecute on every execution request.</summary>
    private bool CanExecute => ExecutionGate.CanExecute(Authentication, _access);
    private async Task LoadAccessAsync()
    {
        if (_access is not null || Authentication.Configured || Services.GetService<IExecutionAccessApiService>() is not { } access) return;
        _access = await access.GetAsync();
    }

    private IntegrationJourneyPackView? Pack => _packs.FirstOrDefault(item => item.PackId == _packId);

    private IReadOnlyList<(string Key, string Label)> Tabs => Pack is { } pack
        ? [("overview", "Overview"), ("scenarios", "Scenario capability"), .. pack.Journeys.Select(view => (view.Journey.JourneyId, view.Journey.DisplayName)), ("rules", "Architecture rules"), ("history", "History")]
        : [];

    private string TabId(string key) => $"{_id}-tab-{key}";

    /// <summary>One scenario: status, execution and result verification side by side (never merged), the next action, and the rest collapsed.</summary>
    private static RenderFragment CapabilityCard(JourneyScenarioCapability capability) => __builder =>
    {
        var profile = capability.Profile;
        <li class="ijp-capability" data-testid="ijp-capability" data-scenario="@capability.ScenarioId" data-status="@capability.Status">
            <div class="ijp-capability-head">
                <span class="ijp-capability-name">@capability.DisplayName</span>
                <span class="ijp-pill ijp-pill-@IntegrationJourneyPresentation.CapabilityTone(capability.Status)" data-testid="ijp-capability-status">@IntegrationJourneyPresentation.Capability(capability.Status)</span>
            </div>
            <dl class="ijp-capability-facts">
                <div><dt>Execution</dt><dd data-testid="ijp-capability-execution">@IntegrationJourneyPresentation.Execution(capability.Status)</dd></div>
                <div><dt>Result verification</dt><dd data-testid="ijp-capability-verification">@IntegrationJourneyPresentation.Verification(profile?.Verification)@(profile is null ? "" : $" — {profile.VerificationDetail}")</dd></div>
                <div><dt>Next action</dt><dd>@(profile?.NextAction ?? "Not declared")</dd></div>
            </dl>
            <details class="ijp-details" data-testid="ijp-capability-details">
                <summary>Requirements and gaps</summary>
                <dl class="ijp-capability-facts">
                    <div><dt>System</dt><dd>@(profile?.System ?? "Not declared")</dd></div>
                    <div><dt>Readiness</dt><dd>@capability.StatusDetail</dd></div>
                    <div><dt>Existing execution method</dt><dd>@(profile?.ExecutionMethod ?? "Not declared")</dd></div>
                    <div><dt>Required configuration</dt><dd>@(profile?.RequiredConfiguration ?? "Not declared")</dd></div>
                    <div><dt>Required test data</dt><dd>@(profile?.RequiredTestData ?? "Not declared")</dd></div>
                    <div><dt>Required access</dt><dd>@(profile?.RequiredAccess ?? "Not declared")</dd></div>
                    <div><dt>Missing evidence</dt><dd>@(profile?.MissingEvidence ?? "Not declared")</dd></div>
                    <div><dt>Responsible team</dt><dd>@(profile?.ResponsibleTeam ?? "Not declared")</dd></div>
                    @if (capability.Blockers.Count > 0)
                    {
                        <div><dt>Unmet prerequisites</dt><dd><ul class="ijp-notes">@foreach (var blocker in capability.Blockers) { <li>@blocker</li> }</ul></dd></div>
                    }
                </dl>
            </details>
        </li>
    };

    private string JourneyName(string journeyId) => Pack?.Journeys.FirstOrDefault(item => item.Journey.JourneyId == journeyId)?.Journey.DisplayName ?? journeyId;

    private string SelectedScenario(IntegrationJourneyView view) => _scenario.TryGetValue(view.Journey.JourneyId, out var selected) && selected.Length > 0
        ? selected : view.Journey.Scenarios.FirstOrDefault(item => item.Support == JourneyScenarioSupport.Supported)?.ScenarioId ?? "";

    private JourneyRunValidation? _validation;
    private bool _validating;

    /// <summary>Validation needs the same execution capability as a run (it reveals configuration readiness) but never executes anything.</summary>
    private bool CanValidate(IntegrationJourneyView view) => CanExecute && !_running && !_validating && SelectedScenario(view).Length > 0 && InputsComplete(view)
        && view.Journey.ExecutionMode == JourneyExecutionMode.JourneyRunner;

    private async Task ValidateAsync(IntegrationJourneyView view)
    {
        if (Api is null || Profile is null || _packs.FirstOrDefault(item => item.PackId == _packId) is not { } pack) return;
        _validating = true;
        _error = null;
        try
        {
            var result = await Api.ValidateAsync(new IntegrationJourneyRunRequest
            {
                EnvironmentId = Profile.Id, PackId = pack.PackId, JourneyId = view.Journey.JourneyId, ScenarioId = SelectedScenario(view),
                Inputs = (ScenarioOf(view)?.Inputs ?? []).Where(input => InputValue(view, input.Key).Trim().Length > 0)
                    .ToDictionary(input => input.Key, input => InputValue(view, input.Key).Trim()),
            });
            _validation = result.Value;
            _error = result.Error;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { _error = "The backend could not validate the run."; }
        finally { _validating = false; }
    }

    private bool CanRun(IntegrationJourneyView view) => ScenarioRunnable(view) && CanExecute && !_running && SelectedScenario(view).Length > 0 && InputsComplete(view);

    private readonly Dictionary<string, Dictionary<string, string>> _inputs = new(StringComparer.Ordinal);

    private JourneyScenarioDescriptor? ScenarioOf(IntegrationJourneyView view) => view.Journey.Scenarios.FirstOrDefault(item => item.ScenarioId == SelectedScenario(view));

    private Dictionary<string, string> Inputs(IntegrationJourneyView view) =>
        _inputs.TryGetValue(view.Journey.JourneyId, out var values) ? values : _inputs[view.Journey.JourneyId] = new(StringComparer.Ordinal);

    /// <summary>The tester's value, else the value the pack resolved from an approved source (e.g. the only approved reporter). An explicit
    /// "Choose…" (empty) is the tester's choice and is kept.</summary>
    private string InputValue(IntegrationJourneyView view, string key) =>
        Inputs(view).TryGetValue(key, out var value) ? value : ScenarioOf(view)?.Inputs?.FirstOrDefault(input => input.Key == key)?.Default ?? "";

    private void SetInput(IntegrationJourneyView view, string key, ChangeEventArgs e) => Inputs(view)[key] = e.Value?.ToString() ?? "";

    /// <summary>Client-side convenience only: required inputs present. The backend validates every value again.</summary>
    private bool InputsComplete(IntegrationJourneyView view) =>
        (ScenarioOf(view)?.Inputs ?? []).All(input => !input.Required || InputValue(view, input.Key).Trim().Length > 0);

    /// <summary>Opens a journey's tab and moves focus to it (used by domain pages that link to one journey).</summary>
    public async Task ShowJourneyAsync(string journeyId, string? scenarioId = null)
    {
        if (Pack is null || Pack.Journeys.FirstOrDefault(item => item.Journey.JourneyId == journeyId) is not { } target) return;
        if (scenarioId is not null && target.Journey.Scenarios.Any(item => item.ScenarioId == scenarioId && item.Support == JourneyScenarioSupport.Supported))
        {
            _scenario[journeyId] = scenarioId;
            _inputs.Remove(journeyId);
        }
        await SelectTabAsync(journeyId);
        StateHasChanged();
        if (_tabRefs.TryGetValue(journeyId, out var element))
        {
            try { await element.FocusAsync(); }
            catch (JSException) { }
            catch (InvalidOperationException) { }
        }
    }

    /// <summary>Whether the selected scenario's own prerequisites are ready (a read-only observation needs less than a submission).</summary>
    private bool ScenarioRunnable(IntegrationJourneyView view) =>
        view.RunnableScenarios.Count > 0 ? view.RunnableScenarios.Contains(SelectedScenario(view), StringComparer.Ordinal) : view.CanRun;

    private string RunNote(IntegrationJourneyView view) => !CanExecute
        ? $"Execution not available: {ExecutionGate.Detail(Authentication, _access)}"
        : !ScenarioRunnable(view) ? $"Not runnable: {view.ReadinessSummary} The backend re-checks every prerequisite before anything runs."
        : "Ready. The backend re-checks every prerequisite, the trusted environment and your ActiveEventExecute permission before anything runs.";

    protected override async Task OnParametersSetAsync()
    {
        if (Api is null || Profile is null || _loadedFor == Profile.Id) return;
        _loadedFor = Profile.Id;
        await LoadAccessAsync();
        _loading = true;
        _error = null;
        _rules = null;
        _history = [];
        try
        {
            var result = await Api.PacksAsync(Profile.Id, _disposed.Token);
            _packs = result.Value?.ToList() ?? [];
            _error = result.Error;
            if (PackId is { } fixedPack) _packs = _packs.Where(item => item.PackId == fixedPack).ToList();
            if (_packs.All(item => item.PackId != _packId)) _packId = _packs.FirstOrDefault()?.PackId ?? "";
            if (InitialJourneyId is { } initial && Pack?.Journeys.Any(item => item.Journey.JourneyId == initial) == true) _tab = initial;
            else if (InitialJourneyId == "history") await SelectTabAsync("history");
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _error = "The integration journeys could not be loaded from the backend.";
        }
        finally { _loading = false; }
    }

    private void SelectPack(string packId)
    {
        _packId = packId;
        _tab = "overview";
        _rules = null;
        _history = [];
    }

    private async Task SelectTabAsync(string key)
    {
        _tab = key;
        _confirming = false;
        _acknowledged = false;
        if (key == "rules" && _rules is null) await LoadRulesAsync();
        if (key == "history") await LoadHistoryAsync();
    }

    private async Task OnTabKeyAsync(KeyboardEventArgs e, string current)
    {
        var keys = Tabs.Select(tab => tab.Key).ToList();
        var index = keys.IndexOf(current);
        var next = e.Key switch
        {
            "ArrowRight" => keys[(index + 1) % keys.Count],
            "ArrowLeft" => keys[(index - 1 + keys.Count) % keys.Count],
            "Home" => keys[0],
            "End" => keys[^1],
            _ => null,
        };
        if (next is null) return;
        await SelectTabAsync(next);
        if (_tabRefs.TryGetValue(next, out var element))
        {
            try { await element.FocusAsync(); }
            catch (JSException) { }
            catch (InvalidOperationException) { }
        }
    }

    private async Task LoadRulesAsync()
    {
        if (Api is null || Pack is not { } pack) return;
        _rulesLoading = true;
        try
        {
            var result = await Api.RulesAsync(Profile.Id, pack.PackId, _disposed.Token);
            _rules = result.Value;
            if (result.Error is { } error) _error = error;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { _error = "Architecture rules could not be evaluated."; }
        finally { _rulesLoading = false; }
    }

    private async Task LoadHistoryAsync()
    {
        if (Api is null || Pack is not { } pack) return;
        _historyError = null;
        try
        {
            var result = await Api.HistoryAsync(Profile.Id, pack.PackId, _historyJourney.Length == 0 ? null : _historyJourney, _historyState, _disposed.Token);
            _history = result.Value?.ToList() ?? [];
            _historyError = result.Unauthorized && !CanExecute ? ExecutionGate.Detail(Authentication, _access) : result.Error;
        }
        catch (Microsoft.AspNetCore.Components.WebAssembly.Authentication.AccessTokenNotAvailableException) { _historyError = "Sign-in required to read journey history."; }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { _historyError = "Journey history could not be loaded."; }
    }

    private async Task OnHistoryJourneyAsync(ChangeEventArgs e)
    {
        _historyJourney = e.Value?.ToString() ?? "";
        await LoadHistoryAsync();
    }

    private async Task OnHistoryStateAsync(ChangeEventArgs e)
    {
        _historyState = Enum.TryParse<JourneyRunState>(e.Value?.ToString(), out var state) ? state : null;
        await LoadHistoryAsync();
    }

    private void SetScenario(IntegrationJourneyView view, ChangeEventArgs e)
    {
        _scenario[view.Journey.JourneyId] = e.Value?.ToString() ?? "";
        _inputs.Remove(view.Journey.JourneyId);
    }

    private void CancelConfirm()
    {
        _confirming = false;
        _acknowledged = false;
    }

    private async Task StartAsync(IntegrationJourneyView view)
    {
        if (Api is null || Pack is not { } pack || !_acknowledged) return;
        _running = true;
        try
        {
            var result = await Api.StartAsync(new IntegrationJourneyRunRequest
            {
                EnvironmentId = Profile.Id, PackId = pack.PackId, JourneyId = view.Journey.JourneyId, ScenarioId = SelectedScenario(view), Confirmed = true,
                Inputs = (ScenarioOf(view)?.Inputs ?? []).Where(input => InputValue(view, input.Key).Trim().Length > 0)
                    .ToDictionary(input => input.Key, input => InputValue(view, input.Key).Trim()),
            }, _disposed.Token);
            // Identifiers are not kept in the browser after a run; the redacted summary comes back with the run.
            foreach (var input in ScenarioOf(view)?.Inputs ?? [])
                if (input.Kind == JourneyScenarioInputKind.SyntheticPersonIdentifier) Inputs(view).Remove(input.Key);
            _lastRun = result.Value;
            _error = result.Error;
            _lastRunFlow = null;
            // The pack's Payload & Mapping Flow for this run, from its stored (redacted) evidence; absent for packs without one.
            if (_lastRun is { } completed && (await Api.PayloadFlowAsync(completed.RunId, _disposed.Token)).Value is { } flow) _lastRunFlow = flow;
        }
        catch (Microsoft.AspNetCore.Components.WebAssembly.Authentication.AccessTokenNotAvailableException) { _error = "Sign-in required to run a journey."; }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { _error = "The journey run could not be started."; }
        finally
        {
            _running = false;
            _confirming = false;
            _acknowledged = false;
        }
    }

    private PayloadFlowView? _lastRunFlow;
    private PayloadFlowView? _historyFlow;
    private Guid? _historyFlowRun;
    private string? _historyFlowError;

    /// <summary>A recorded run's flow: only what that run recorded, with downstream expectations labelled as the current ones.</summary>
    private async Task LoadHistoryFlowAsync(Guid runId)
    {
        if (Api is null) return;
        _historyFlowError = null;
        try
        {
            var result = await Api.PayloadFlowAsync(runId, _disposed.Token);
            _historyFlow = result.Value;
            _historyFlowRun = result.Value is null ? null : runId;
            if (result.Value is null) _historyFlowError = result.Status == System.Net.HttpStatusCode.NotFound ? "No Payload & Mapping Flow exists for this run." : result.Error;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { _historyFlowError = "The payload flow could not be loaded."; }
    }

    private async Task ExportAsync()
    {
        if (Pack is not { } pack) return;
        if (_rules is null) await LoadRulesAsync();
        var html = ExportService.ExportIntegrationJourneys(pack, _rules, _history, Workspace.ProjectName);
        await JS.InvokeVoidAsync("downloadHtmlFile", $"integration-journeys-{pack.PackId}-{DateTime.UtcNow:yyyy-MM-dd}.html", html);
    }

    public void Dispose()
    {
        _disposed.Cancel();
        _disposed.Dispose();
    }
}
