@using BirkNext.GitSources
@using BirkNext.Web.Components.GitSources
@implements IDisposable
@inject IGitSourcesApiService Git
@inject IServiceProvider Services
@inject NavigationManager Navigation
@inject Microsoft.JSInterop.IJSRuntime JS

@* System Settings → Git Sources: a guided setup with one focused step at a time. Every status comes from GitSourcesSetupState (backend state);
   opening the section reads only local state — Microsoft and Azure DevOps are contacted only by actions the person starts. *@
<section class="gsx" aria-labelledby="gss-title" data-testid="gss">
    <header class="gsx-header">
        <div>
            <h2 id="gss-title" class="gsx-title">Git Sources</h2>
            <p class="gsx-subtitle">Connect Azure DevOps to import and refresh source evidence without changing repositories.</p>
        </div>
        @if (_setup?.Status is { } status)
        {
            <div class="gsx-header-side">
                <span class="gsx-pill gsx-pill-@OverallTone(status)" data-testid="gss-overall" role="status">@Overall(status)</span>
                <button type="button" class="gsx-link" aria-expanded="@(_setup.HelpOpen ? "true" : "false")" aria-controls="gss-help" @onclick="ToggleHelp" data-testid="gss-help-toggle">Help</button>
            </div>
        }
    </header>

    @if (_setup?.Status is null) { <p class="gsx-muted" role="status">@(_setup?.Error ?? "Reading the Git Sources state…")</p> }
    else
    {
        @if (_setup.HelpOpen)
        {
            <div id="gss-help" class="gsx-help" data-testid="gss-help">
                <p>Six steps: enable Git Sources, enter your organization's Microsoft application, save the Azure DevOps organization, sign in as yourself,
                    verify access, then import. BirkNext only reads; it never changes Azure DevOps and never stores a password, PAT or token.</p>
                <button type="button" class="gsx-link" @onclick="OpenInstructions" data-testid="gss-help-instructions">Setup instructions for your Entra administrator</button>
            </div>
        }
        <GitSetupProgress Setup="_setup" />
        var step = _setup.Step(_setup.Active);
        var (title, purpose) = Headings[_setup.Active];
        <div class="gsx-panel" data-testid="gss-panel" data-step="@_setup.Active">
            <div class="gsx-panel-head">
                <h3 class="gsx-panel-title">@title</h3>
                @if (step is not null) { <span class="gsx-pill gsx-pill-@Tone(step.State)" data-testid="gss-step-status">@step.StatusLabel</span> }
            </div>
            <p class="gsx-muted">@purpose</p>
            @if (_setup.Notice is { } notice) { <p class="gsx-notice" role="status" data-testid="gss-notice">@notice</p> }
            @switch (_setup.Active)
            {
                case "provider": <GitProviderStep Setup="_setup" /> break;
                case "application": <GitEntraStep Setup="_setup" /> break;
                case "organization": <GitOrganizationStep Setup="_setup" /> break;
                case "authentication": <GitSignInStep Setup="_setup" /> break;
                case "test": <GitConnectionStep Setup="_setup" /> break;
                default: <GitImportStep Setup="_setup" /> break;
            }
            @if (_setup.Error is { } error) { <p class="gsx-error" role="alert" data-testid="gss-error">@error</p> }
        </div>
        <GitSetupSummary Setup="_setup" />
    }
</section>

@code {
    private GitSourcesSetupState? _setup;

    private static readonly Dictionary<string, (string Title, string Purpose)> Headings = new()
    {
        ["provider"] = ("Enable Git Sources", "Use your Azure DevOps account to import source evidence securely."),
        ["application"] = ("Connect your Microsoft application", "Enter the application details provided by your Microsoft Entra administrator."),
        ["organization"] = ("Choose your Azure DevOps organization", "Specify the organization containing the projects you want to import."),
        ["authentication"] = ("Sign in with Microsoft", "Use your work account to access only the Azure DevOps projects you are permitted to read."),
        ["test"] = ("Verify Azure DevOps access", "Confirm that BirkNext can read projects from your organization."),
        ["import"] = ("Import source from Azure DevOps", "Select a project, repository and branch. BirkNext imports evidence without modifying Azure DevOps."),
    };

    protected override async Task OnInitializedAsync()
    {
        _setup = new GitSourcesSetupState(Git, Services.GetService(typeof(AdminApiService)) as AdminApiService, JS, Navigation,
            () => Services.GetService(typeof(BirkNext.Web.Services.ProjectImport.ProjectImportSession)) as BirkNext.Web.Services.ProjectImport.ProjectImportSession,
            Services.GetService(typeof(IFrontendAnalysisContextFactory)) as IFrontendAnalysisContextFactory);
        _setup.Changed += OnChanged;
        await _setup.InitializeAsync();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() { if (_setup is not null) _setup.Changed -= OnChanged; }
    private void ToggleHelp() => _setup!.HelpOpen = !_setup.HelpOpen;
    private void OpenInstructions() { _setup!.HelpOpen = false; _setup.InstructionsOpen = true; _setup.Select("application"); }

    /// <summary>One overall state for the header, from the same backend state as the steps.</summary>
    private string Overall(GitConnectionStatus s) =>
        s.State == GitConnectionState.NotConfigured ? "Setup required"
        : s.State == GitConnectionState.AccessDenied ? "Access denied"
        : _setup!.Discoverable ? "Connected"
        : _setup.SignedIn ? "Signed in · access not verified"
        : "Sign-in required";

    private string OverallTone(GitConnectionStatus s) =>
        _setup!.Discoverable ? "ok" : s.State is GitConnectionState.AccessDenied or GitConnectionState.Failed ? "bad" : "pending";

    public static string Tone(GuidedStepState state) => state switch
    {
        GuidedStepState.Done => "ok",
        GuidedStepState.Blocked => "bad",
        GuidedStepState.Current => "pending",
        _ => "neutral",
    };
}
