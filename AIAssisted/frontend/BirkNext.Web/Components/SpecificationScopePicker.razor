@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using BirkNext.Web.Services.Explorers
@inject IServiceProvider Services

@* Which specification manual testing reads, chosen where the tester works: the module, its feature and (when a feature has several) the
   specification, as dropdowns. The choice is the same one the explorers save (one authority), so every explorer and review follows it.
   Nothing is chosen automatically: an empty dropdown says what still has to be chosen. *@
@if (_state is { } s && (s.HasModules || s.Packs is { Count: > 0 } || s.Artifacts.Count > 1 || s.Status is ExplorerArtifactStatus.Loaded or ExplorerArtifactStatus.SelectionRequired))
{
    var chosen = s.Status == ExplorerArtifactStatus.Loaded && s.Selected is not null;
    <section class="ssp" data-testid="ssp" aria-label="Spesifikasjonen manuell testing bruker" aria-busy="@(_busy ? "true" : "false")">
        @* UX pass (2026-11-25): once a specification is in use the picker is one line; the dropdowns open under «Endre». *@
        <details class="ssp-choose" open="@(!chosen || _busy)" data-testid="ssp-choose">
        <summary class="ssp-summary">@(chosen ? "Endre modul eller spesifikasjon" : "Velg modul og spesifikasjon")</summary>
        <div class="ssp-row">
            @if (s.HasModules)
            {
                <label class="ssp-field"><span class="ssp-k">Modul</span>
                    <select class="ssp-select" data-testid="ssp-module" disabled="@_busy" value="@(s.Module is { } current ? ModuleValue(current) : AllModulesValue)" @onchange="OnModule">
                        <option value="@AllModulesValue">Alle moduler</option>
                        @foreach (var m in s.Modules!.Where(m => m.Candidates > 0))
                        {
                            <option value="@ModuleValue(m.Module)">@ModuleText(m)</option>
                        }
                    </select></label>
            }
            @* V8: the specification (pack) is offered even when the module has only one — it is never chosen by itself (CdcReplay). *@
            @if (s.Packs is { Count: > 0 } && !s.ModuleRequired)
            {
                <label class="ssp-field"><span class="ssp-k">Spesifikasjon</span>
                    <select class="ssp-select" data-testid="ssp-feature" disabled="@_busy" value="@(s.PackRequired ? "" : s.Pack ?? "")" @onchange="OnFeature">
                        <option value="">Alle spesifikasjoner</option>
                        @foreach (var p in s.Packs!)
                        {
                            <option value="@p.Pack">@(p.DisplayName == p.Pack ? p.Pack : $"{p.DisplayName} ({p.Pack})")</option>
                        }
                    </select></label>
            }
            @* A choice is offered whenever one is needed: several documents, or one that is not chosen yet (V8: never chosen by itself). Without
               packs the documents ARE the specifications («Spesifikasjon»); inside a chosen pack they are its documents («Dokument»). *@
            @if (!s.ModuleRequired && !s.PackRequired && SpecificationChoices(s) is { Count: > 0 } choices)
            {
                var documentsAreSpecs = s.Packs is not { Count: > 0 };
                <label class="ssp-field"><span class="ssp-k">@(documentsAreSpecs ? "Spesifikasjon" : "Dokument")</span>
                    <select @key="_renderKey" class="ssp-select" data-testid="ssp-specification" disabled="@_busy" value="@(s.Selected?.Id ?? "")" @onchange="OnSpecification">
                        <option value="">@(documentsAreSpecs ? "Alle spesifikasjoner" : "Alle dokumenter")</option>
                        @foreach (var a in choices)
                        {
                            <option value="@a.Id">@(a.DisplayName == a.FileName ? a.FileName : $"{a.DisplayName} ({a.SourcePath ?? a.FileName})")</option>
                        }
                    </select></label>
            }
            @* A module / feature / specification change rebuilds the review context before the new choice is shown (2026-11-25: it could take seconds
               on a large workspace with no sign of life): say what is happening beside the dropdowns. *@
            @if (_busy) { <InlineLoading Text="Henter spesifikasjoner …" Class="ssp-busy" TestId="ssp-busy" /> }
        </div>
        </details>
        @if (Actions is not null) { <div class="ssp-actions" data-testid="ssp-actions">@Actions</div> }
        <p class="ssp-current" role="status" data-testid="ssp-current" data-state="@CurrentState(s)">
            @if (s.Status == ExplorerArtifactStatus.Loaded && s.Selected is { } selected)
            {
                <span>Krav og scenarioer hentes fra <strong>@selected.DisplayName</strong> <span class="ssp-path">@(selected.SourcePath ?? selected.FileName)</span>.</span>
            }
            else if (s.ModuleRequired)
            {
                <span>Velg modulen du tester.</span>
            }
            else if (s.PackRequired)
            {
                <span>Velg spesifikasjonen du tester i @(s.ModuleLabel ?? "denne modulen").</span>
            }
            else if (s.Status == ExplorerArtifactStatus.SelectionRequired)
            {
                <span>@(s.Packs is { Count: > 0 } ? "Spesifikasjonen har flere dokumenter; velg det du tester." : "Velg spesifikasjonen du tester.")</span>
            }
            else if (s.Status == ExplorerArtifactStatus.Empty && s.PackSummary is { } pack)
            {
                <span>@pack.DisplayName har ingen egen spesifikasjon. Velg en annen spesifikasjon, eller <a href="specification-explorer">åpne Specification Explorer</a> for å bruke et felles dokument.</span>
            }
            else
            {
                <span>Ingen spesifikasjon er tilgjengelig her.</span>
            }
            <a class="ssp-link" href="specification-explorer" data-testid="ssp-open-explorer">Åpne i Specification Explorer</a>
        </p>
        @if (_changed && ShowDiscoverLink && s.Status == ExplorerArtifactStatus.Loaded)
        {
            <p class="ssp-note" role="status" data-testid="ssp-changed">Spesifikasjonen er endret. Scenarioer funnet tidligere kom fra den forrige; testtilfeller som allerede er forberedt, blir i testplanen.
                @if (Discover.HasDelegate)
                {
                    <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" data-testid="ssp-discover" @onclick="DiscoverNowAsync">Finn scenarioer nå</button>
                }
                else
                {
                    <a class="btn btn-primary btn-sm" href="test-plan-suggestions?area=choose&discover=now" data-testid="ssp-discover">Finn scenarioer nå</a>
                }
            </p>
        }
        @if (_saveWarning is not null) { <p class="ssp-note" role="alert" data-testid="ssp-save-warning">@_saveWarning</p> }
        @if (_refused is not null) { <p class="ssp-note" role="alert" data-testid="ssp-refused">@_refused</p> }
    </section>
}
else if (Actions is not null)
{
    @* Nothing to choose here: the page's actions keep their place. *@
    <section class="ssp ssp-bare" data-testid="ssp"><div class="ssp-row"><div class="ssp-actions" data-testid="ssp-actions">@Actions</div></div></section>
}

@code {
    /// <summary>Raised after the tester changed the module, feature or specification (the page reads its requirements again).</summary>
    [Parameter] public EventCallback Changed { get; set; }

    /// <summary>False to leave the "discover again" notice to the page.</summary>
    [Parameter] public bool ShowDiscoverLink { get; set; } = true;

    /// <summary>The page's actions for the chosen scope (Finn og forstå: «Oppdag på nytt»), shown in the same row as the dropdowns.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>Runs discovery on this page (Plan &amp; prepare); without it, Discover now opens Plan &amp; prepare and runs it there.</summary>
    [Parameter] public EventCallback Discover { get; set; }

    private async Task DiscoverNowAsync()
    {
        _changed = false;
        await Discover.InvokeAsync();
    }

    private IArtifactExplorerContext? _explorer;
    private ArtifactExplorerState? _state;
    private bool _busy;
    private bool _changed;
    private string? _saveWarning;
    /// <summary>Why the last specification choice could not be applied (shown; the dropdown then shows the specification actually used).</summary>
    private string? _refused;
    private int _renderKey;

    protected override async Task OnInitializedAsync()
    {
        _explorer = Services.GetService(typeof(IArtifactExplorerContext)) as IArtifactExplorerContext;
        await ReadAsync();
    }

    private async Task ReadAsync()
    {
        if (_explorer is null) return;
        try { _state = await _explorer.GetStateAsync(WorkspaceArtifactType.Specification); }
        catch (Exception e) when (e is not OperationCanceledException) { _state = null; }
    }

    /// <summary>The specifications to choose between in the current module or feature (a feature's own ones when it has any).</summary>
    private static IReadOnlyList<ExplorerArtifact> SpecificationChoices(ArtifactExplorerState s) =>
        s.Status is ExplorerArtifactStatus.Loaded or ExplorerArtifactStatus.SelectionRequired ? s.Artifacts : [];

    private static string CurrentState(ArtifactExplorerState s) =>
        s.Status == ExplorerArtifactStatus.Loaded ? "chosen" : s.ModuleRequired ? "module" : s.PackRequired ? "feature" : s.Status == ExplorerArtifactStatus.SelectionRequired ? "specification" : "none";

    private static string ModuleText(ArtifactModuleRoleState m) =>
        // A pack is one specification however many documents it holds (CdcReplay: one pack, four specification documents, was «4 spesifikasjoner»).
        m.Packs > 1 ? $"{m.Label} — {m.Packs} funksjoner"
        : m.Packs == 1 ? $"{m.Label} — 1 spesifikasjon{(m.Candidates > 1 ? $" ({m.Candidates} dokumenter)" : "")}"
        : $"{m.Label} — {m.Candidates} spesifikasjon{(m.Candidates == 1 ? "" : "er")}";

    /// <summary>The project-level module's key is "" — the same as "nothing chosen" — so it has its own option value.</summary>
    private const string ProjectLevelValue = "(project-level)";
    private const string AllModulesValue = "(all-modules)";

    private static string ModuleValue(string module) => module.Length == 0 ? ProjectLevelValue : module;

    private Task OnModule(ChangeEventArgs e) => e.Value?.ToString() switch
    {
        AllModulesValue => ApplyAsync(async () =>
        {
            await _explorer!.ClearSelectionAsync(WorkspaceArtifactType.Specification, keepEmptyChoice: false);
            await _explorer.SelectModuleAsync(null);
        }),
        ProjectLevelValue => ApplyAsync(async () =>
        {
            await _explorer!.ClearSelectionAsync(WorkspaceArtifactType.Specification, ArtifactModules.ProjectLevel);
            await _explorer.SelectModuleAsync(ArtifactModules.ProjectLevel);
        }),
        { Length: > 0 } module => ApplyAsync(async () =>
        {
            await _explorer!.ClearSelectionAsync(WorkspaceArtifactType.Specification, module);
            await _explorer.SelectModuleAsync(module);
        }),
        _ => Task.CompletedTask,
    };

    private Task OnFeature(ChangeEventArgs e) => e.Value?.ToString() is { } value
        ? ApplyAsync(async () =>
        {
            if (value.Length == 0)
            {
                await _explorer!.ClearSelectionAsync(WorkspaceArtifactType.Specification, _state?.Module, keepEmptyChoice: false);
                await _explorer.SelectPackAsync(null, _state?.Module);
            }
            else await _explorer!.SelectPackAsync(value, _state?.Module);
        }) : Task.CompletedTask;

    private async Task OnSpecification(ChangeEventArgs e)
    {
        if (e.Value?.ToString() is not { } id) return;
        _refused = null;
        if (id.Length == 0)
            await ApplyAsync(() => _explorer!.ClearSelectionAsync(WorkspaceArtifactType.Specification, _state?.Module, _state?.Pack));
        else
            await ApplyAsync(() => { _explorer!.Select(WorkspaceArtifactType.Specification, id); return Task.CompletedTask; });
        // Never show a choice that is not in use: when the explorers resolve another document, say so and redraw the dropdown from the real state.
        if (id.Length > 0 && _state is { } now && now.Selected?.Id != id)
        {
            var wanted = now.Artifacts.FirstOrDefault(a => a.Id == id)?.DisplayName ?? "Den valgte spesifikasjonen";
            _refused = now.Selected is { } used
                ? $"«{wanted}» kunne ikke brukes her; «{used.DisplayName}» brukes fortsatt."
                : $"«{wanted}» kunne ikke brukes her. Velg en annen spesifikasjon.";
            _renderKey++;
        }
    }

    private async Task ApplyAsync(Func<Task> change)
    {
        if (_explorer is null) return;
        _busy = true;
        try
        {
            await change();
            // Requirements are read from the review context: wait until it is rebuilt from the new choice, then show it.
            if (Services.GetService(typeof(IReviewContextProvider)) is IReviewContextProvider context) await context.RebuildAsync();
            await ReadAsync();
            _changed = true;
        }
        finally { _busy = false; }
        await Changed.InvokeAsync();
        // Saved like a choice in the explorers, so a reload and every explorer show the same specification. After the page shows the choice (the
        // save took seconds on a large workspace and held the page back); a failed save is still reported.
        if (Services.GetService(typeof(IWorkspaceAutoSaveService)) is IWorkspaceAutoSaveService autoSave)
        {
            // Flush, not a second full save: the auto-save already saves the change; this waits for it (or saves what is still unsaved) and
            // reports a failure. Two full saves took 4-5 s each of the browser's thread on a large workspace.
            _saveWarning = await autoSave.FlushAsync() ? null : "Valget brukes i denne økten, men kunne ikke lagres i arbeidsområdet og forsvinner ved ny innlasting.";
            StateHasChanged();
        }
    }
}
