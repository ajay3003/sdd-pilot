    private static string SemanticShortLabel(SectionSemantics sem) => sem switch
    {
        SectionSemantics.Clarifications         => "Q/A",
        SectionSemantics.EdgeCases              => "EDGE",
        SectionSemantics.Assumptions            => "ASSUME",
        SectionSemantics.ApiSurface             => "API",
        SectionSemantics.Observability          => "OBS",
        SectionSemantics.Security               => "SEC",
        SectionSemantics.Performance            => "PERF",
        SectionSemantics.AcceptanceScenarios    => "BDD",
        SectionSemantics.RequirementsSection    => "REQS",
        SectionSemantics.SuccessCriteriaSection => "SC",
        SectionSemantics.KeyEntities            => "ENTITY",
        _ => "",
    };

    private static string TableKindLabel(TableType t) => t switch
    {
        TableType.RequirementMap => "Requirements",
        TableType.UserStoryMap   => "User Stories",
        TableType.TestMapping    => "Test Mapping",
        TableType.Traceability   => "Traceability",
        TableType.EntityModel    => "Entity Model",
        TableType.ApiSpec        => "API Spec",
        TableType.DependencyMap  => "Dependencies",
        _                        => "Table",
    };

    private static string CoverageIcon(CoverageState s) => s switch
    {
        CoverageState.Covered => "✅",
        CoverageState.Partial => "⚠",
        CoverageState.Missing => "❌",
        _ => "",
    };

    private static string CoverageTitle(CoverageState s) => s switch
    {
        CoverageState.Covered => "Covered",
        CoverageState.Partial => "Partial",
        CoverageState.Missing => "Missing",
        _ => "Unknown",
    };
}
