    private static string NodeTypeLabel(SpecNodeType type) => type switch
    {
        SpecNodeType.Module           => "Module",
        SpecNodeType.Section          => "Section",
        SpecNodeType.SubSection       => "Sub-section",
        SpecNodeType.DeepSection      => "Section",
