@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using BirkNext.Web.Services.Explorers
@inject IPlanAnalysisService AnalysisService

<div class="pe-panel">

    @if (_plan is null)
    {
        <!-- ── Empty / input state ───────────────────────────────────────── -->
        <div class="pe-empty-state">
            <div class="pe-empty-icon" aria-hidden="true">📐</div>
            <h3 class="pe-empty-title">Plan Explorer</h3>
            <p class="pe-empty-desc">Turn a Plan artifact into a navigable view of architecture decisions, risks and constraints, implementation phases, constitution gates, and testing strategy. Paste or import a plan document below; any file name works.</p>

            <div class="pe-input-area">
                <div class="pe-input-header">
                    <span class="pe-input-label">Plan document</span>
                    <span class="pe-input-hint">Supports implementation plans, feature plans, and architecture plans</span>
                </div>
                <SpecificationImport
                    @ref="_importRef"
                    InputId="pe-file-input"
                    OnFileImported="OnFileImported"
                    OnFileRemoved="OnFileRemoved"
                    IsDisabled="false" />
                <textarea
                    class="pe-textarea"
                    aria-label="Plan content"
                    placeholder="Or paste plan content here..."
                    rows="12"
                    @bind="_localText"></textarea>
                @if (!string.IsNullOrWhiteSpace(_localText))
                {
                    var lineCount = _localText.Split('\n').Length;
                    <div class="pe-input-footer">
                        <span class="pe-input-stat">@lineCount lines · @_localText.Length chars</span>
                        <button class="pe-clear-btn" @onclick="ClearInput">Clear</button>
                    </div>
                }
            </div>

            <button class="pe-build-btn" disabled="@(!CanBuild)" @onclick="BuildPlanAsync">
                Build Plan Explorer
            </button>
        </div>
    }
    else
    {
        <!-- ── Explorer state ────────────────────────────────────────────── -->

        <!-- Header bar -->
        <div class="pe-header">
            <div class="pe-header-left">
                <span class="pe-header-title">@_plan.Title</span>
                @if (!string.IsNullOrEmpty(_plan.Status))
                {
                    <span class="pe-header-status pe-status-@StatusCssClass(_plan.Status)">@_plan.Status</span>
                }
            </div>
            <div class="pe-header-right">
                @* The tabs are the one way to move through the plan; Overview cards are information, not shortcuts. *@
                <div class="pe-view-toggle" role="tablist" aria-label="Plan sections">
                    @foreach (var (key, label) in Tabs)
                    {
                        <button type="button" role="tab" id="pe-tab-@key" class='pe-view-btn @(_tab == key ? "is-active" : "")'
                                aria-selected="@(_tab == key ? "true" : "false")" aria-controls="pe-tabpanel"
                                data-testid="pe-tab" data-tab="@key" @onclick='() => SetTab(key)'>@label</button>
                    }
                </div>
            </div>
        </div>

        <!-- Search bar -->
        @if (_tab is "architecture" or "risks" or "complexity" or "constitution" or "phases" or "testing")
        {
            <div class="pe-search-bar">
                <input
                    type="search"
                    class="pe-search"
                    placeholder="@SearchPlaceholder"
                    value="@_search"
                    @oninput="HandleSearch"
                    aria-label="Search plan" />
                @if (!string.IsNullOrWhiteSpace(_search))
                {
                    <span class="pe-search-clear" @onclick="ClearSearch" title="Clear">×</span>
                    <span class="pe-search-count">@SearchResultCount result@(SearchResultCount != 1 ? "s" : "")</span>
                }
            </div>
        }

        <!-- Risk severity + constraint type filter (risks tab) -->
        @if (_tab == "risks")
        {
            <div class="pe-filter-strip" role="group" aria-label="Filter by severity">
                <button class='pe-filter-chip @(_riskFilter is null ? "is-active" : "")' @onclick='() => SetRiskFilter(null)'>All @(_plan.Risks.Count > 0 ? $"({_plan.Risks.Count})" : "")</button>
                @if (_plan.Health.CriticalRisks > 0)
                {
                    <button class='pe-filter-chip pe-fc-critical @(_riskFilter == RiskSeverity.Critical ? "is-active" : "")' @onclick='() => SetRiskFilter(RiskSeverity.Critical)'>Critical (@_plan.Health.CriticalRisks)</button>
                }
                @if (_plan.Health.HighRisks > 0)
                {
                    <button class='pe-filter-chip pe-fc-high @(_riskFilter == RiskSeverity.High ? "is-active" : "")' @onclick='() => SetRiskFilter(RiskSeverity.High)'>High (@_plan.Health.HighRisks)</button>
                }
                @if (_plan.Health.MediumRisks > 0)
                {
                    <button class='pe-filter-chip pe-fc-medium @(_riskFilter == RiskSeverity.Medium ? "is-active" : "")' @onclick='() => SetRiskFilter(RiskSeverity.Medium)'>Medium (@_plan.Health.MediumRisks)</button>
                }
                @if (_plan.Health.LowRisks > 0)
                {
                    <button class='pe-filter-chip pe-fc-low @(_riskFilter == RiskSeverity.Low ? "is-active" : "")' @onclick='() => SetRiskFilter(RiskSeverity.Low)'>Low (@_plan.Health.LowRisks)</button>
                }
                @if (_plan.Health.UnratedRisks > 0)
                {
                    <button class='pe-filter-chip @(_riskFilter == RiskSeverity.Unrated ? "is-active" : "")' @onclick='() => SetRiskFilter(RiskSeverity.Unrated)'>Severity not stated (@_plan.Health.UnratedRisks)</button>
                }
            </div>
        }

        <!-- Complexity level filter -->
        @if (_tab == "complexity")
        {
            <div class="pe-filter-strip" role="group" aria-label="Filter by complexity">
                <button class='pe-filter-chip @(_complexityFilter is null ? "is-active" : "")' @onclick='() => SetComplexityFilter(null)'>All</button>
                <button class='pe-filter-chip pe-fc-cx @(_complexityFilter == ComplexityLevel.VeryHigh ? "is-active" : "")' @onclick='() => SetComplexityFilter(ComplexityLevel.VeryHigh)'>Very High</button>
                <button class='pe-filter-chip pe-fc-cx @(_complexityFilter == ComplexityLevel.High ? "is-active" : "")' @onclick='() => SetComplexityFilter(ComplexityLevel.High)'>High</button>
                <button class='pe-filter-chip pe-fc-cx @(_complexityFilter == ComplexityLevel.Medium ? "is-active" : "")' @onclick='() => SetComplexityFilter(ComplexityLevel.Medium)'>Medium</button>
                <button class='pe-filter-chip pe-fc-cx @(_complexityFilter == ComplexityLevel.Low ? "is-active" : "")' @onclick='() => SetComplexityFilter(ComplexityLevel.Low)'>Low</button>
            </div>
        }

        <!-- Constitution gate + check item filters -->
        @if (_tab == "constitution")
        {
            <!-- Gate status filter (shown only when gates exist) -->
            @if (_plan.Gates.Count > 0)
            {
                <div class="pe-filter-strip" role="group" aria-label="Filter gates by status stated in the plan">
                    @{
                        var justifiedDeviations = _plan.Gates.Count(g => g.Status == PlanGateStatus.Warning && g.IsJustifiedDeviation);
                        var genuineWarnings = _plan.Health.WarningGates - justifiedDeviations;
                    }
                    <button class='pe-filter-chip pe-plan-filter @(_gateFilter is null ? "is-active" : "")' @onclick='() => SetGateFilter(null)'>All plan gates (@_plan.Gates.Count)</button>
                    @if (_plan.Health.PassedGates > 0)
                    {
                        <button class='pe-filter-chip pe-plan-filter @(_gateFilter == PlanGateStatus.Pass ? "is-active" : "")' @onclick='() => SetGateFilter(PlanGateStatus.Pass)'>Plan says met (@_plan.Health.PassedGates)</button>
                    }
                    @if (genuineWarnings > 0)
                    {
                        <button class='pe-filter-chip pe-plan-filter @(_gateFilter == PlanGateStatus.Warning ? "is-active" : "")' @onclick='() => SetGateFilter(PlanGateStatus.Warning)'>Plan says warning (@genuineWarnings)</button>
                    }
                    @if (justifiedDeviations > 0)
                    {
                        <button class='pe-filter-chip pe-plan-filter @(_gateFilter == PlanGateStatus.Warning ? "is-active" : "")' @onclick='() => SetGateFilter(PlanGateStatus.Warning)'>Justified deviations in plan (@justifiedDeviations)</button>
                    }
                    @if (_plan.Health.FailedGates > 0)
                    {
                        <button class='pe-filter-chip pe-plan-filter @(_gateFilter == PlanGateStatus.Fail ? "is-active" : "")' @onclick='() => SetGateFilter(PlanGateStatus.Fail)'>Plan says not met (@_plan.Health.FailedGates)</button>
                    }
                </div>
            }
            <!-- Check item status filter -->
            @if (_plan.ConstitutionCheckItems.Count > 0)
            {
                <div class="pe-filter-strip" role="group" aria-label="Filter plan-declared Constitution statuses">
                    <button class='pe-filter-chip pe-plan-filter @(_checkFilter is null ? "is-active" : "")' @onclick='() => SetCheckFilter(null)'>All plan items</button>
                    <button class='pe-filter-chip pe-plan-filter @(_checkFilter == ConstitutionCheckStatus.NonCompliant ? "is-active" : "")' @onclick='() => SetCheckFilter(ConstitutionCheckStatus.NonCompliant)'>Plan says not met</button>
                    <button class='pe-filter-chip pe-plan-filter @(_checkFilter == ConstitutionCheckStatus.NeedsReview ? "is-active" : "")' @onclick='() => SetCheckFilter(ConstitutionCheckStatus.NeedsReview)'>Plan says needs review</button>
                    <button class='pe-filter-chip pe-plan-filter @(_checkFilter == ConstitutionCheckStatus.Compliant ? "is-active" : "")' @onclick='() => SetCheckFilter(ConstitutionCheckStatus.Compliant)'>Plan says met</button>
                    <button class='pe-filter-chip pe-plan-filter @(_checkFilter == ConstitutionCheckStatus.NotApplicable ? "is-active" : "")' @onclick='() => SetCheckFilter(ConstitutionCheckStatus.NotApplicable)'>Plan says not applicable</button>
                </div>
            }
        }

        <!-- Tab content -->
        <div class="pe-tab-body" role="tabpanel" id="pe-tabpanel" aria-labelledby="pe-tab-@_tab">

            @if (_tab == "overview")
            {
                <!-- ── Overview ──────────────────────────────────────────── -->
                <div class="pe-overview">

                    <!-- Summary block -->
                    @if (!string.IsNullOrEmpty(_plan.Summary))
                    {
                        <div class="pe-summary-block">
                            <div class="pe-summary-kicker">Plan Summary</div>
                            <p class="pe-summary-text">@_plan.Summary</p>
                        </div>
                    }

                    <!-- Plan metadata and provenance (as written in the plan) -->
                    <div class="pe-meta-card" data-testid="pe-metadata">
                        <div class="pe-meta-grid">
                            @if (!string.IsNullOrEmpty(_plan.FeatureName))
                            {
                                <div class="pe-meta-item">
                                    <div class="pe-meta-label">Feature</div>
                                    <div class="pe-meta-value">@_plan.FeatureName</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(_plan.Status))
                            {
                                <div class="pe-meta-item">
                                    <div class="pe-meta-label">Status (stated in plan)</div>
                                    <div class="pe-meta-value">@_plan.Status</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(_plan.Branch))
                            {
                                <div class="pe-meta-item">
                                    <div class="pe-meta-label">Branch</div>
                                    <div class="pe-meta-value">@_plan.Branch</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(_plan.Author))
                            {
                                <div class="pe-meta-item">
                                    <div class="pe-meta-label">Author</div>
                                    <div class="pe-meta-value">@_plan.Author</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(_plan.Date))
                            {
                                <div class="pe-meta-item">
                                    <div class="pe-meta-label">Date</div>
                                    <div class="pe-meta-value">@_plan.Date</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(_plan.CreatedDate))
                            {
                                <div class="pe-meta-item">
                                    <div class="pe-meta-label">Created</div>
                                    <div class="pe-meta-value">@_plan.CreatedDate</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(_plan.LastUpdated))
                            {
                                <div class="pe-meta-item">
                                    <div class="pe-meta-label">Last Updated</div>
                                    <div class="pe-meta-value">@_plan.LastUpdated</div>
                                </div>
                            }
                            @if (Provenance is { } provenance)
                            {
                                <div class="pe-meta-item pe-meta-provenance" data-testid="pe-provenance">
                                    <div class="pe-meta-label">@provenance.Label</div>
                                    <div class="pe-meta-value">@provenance.Value</div>
                                    @if (provenance.Detail is not null)
                                    {
                                        <div class="pe-meta-detail" data-testid="pe-provenance-detail">@provenance.Detail</div>
                                    }
                                    @if (SpecificationReference is { } reference)
                                    {
                                        <div class="pe-meta-detail pe-spec-reference pe-spec-reference-@reference.Status.ToString().ToLowerInvariant()" data-testid="pe-source-spec-resolution">
                                            @SpecificationReferenceSummary(reference)
                                        </div>
                                        @if (reference.Status == PlanSpecificationReferenceStatus.Resolved && reference.Artifact is { } resolvedArtifact)
                                        {
                                            <div class="pe-meta-detail" data-testid="pe-source-spec-identity">
                                                Current artifact: @resolvedArtifact.DisplayName · @(resolvedArtifact.SourcePath ?? resolvedArtifact.FileName)
                                                @if (resolvedArtifact.Revision is { } revision)
                                                { <text> · revision @revision</text> }
                                                · resolved by @(reference.Match == PlanSpecificationReferenceMatch.ExactSourcePath ? "exact source path" : "unique filename")
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Plan analysis: findings derived from the plan. Facts, not a score or a verdict. -->
                    <section class="pe-ov-group" aria-labelledby="pe-ov-analysis" data-testid="pe-analysis">
                        <h3 class="pe-ov-heading" id="pe-ov-analysis">Plan analysis</h3>
                        <div class="pe-ov-cards">
                            <div class="pe-ov-card @RiskCardClass" data-testid="pe-risk-summary">
                                <div class="pe-ov-value">@_plan.Health.TotalRisks</div>
                                <div class="pe-ov-label">@(_plan.Health.TotalRisks == 1 ? "Risk" : "Risks")</div>
                                <div class="pe-ov-detail" data-testid="pe-risk-distribution">@RiskDistribution</div>
                            </div>
                            <div class="pe-ov-card @(_plan.Health.HighComplexityItems > 0 ? "pe-ov-attention" : "")" data-testid="pe-complexity-summary">
                                <div class="pe-ov-value">@_plan.Health.TotalComplexityItems</div>
                                <div class="pe-ov-label">Complexity @(_plan.Health.TotalComplexityItems == 1 ? "item" : "items")</div>
                                <div class="pe-ov-detail" data-testid="pe-complexity-high">@_plan.Health.HighComplexityItems of @_plan.Health.TotalComplexityItems rated high or very high</div>
                                @if (_plan.ComplexityDerived)
                                {
                                    <div class="pe-ov-detail">Derived by plan analysis; the plan lists none itself</div>
                                }
                            </div>
                        </div>
                    </section>

                    <!-- Plan structure: what the plan contains. Counts of content, not progress. -->
                    @if (_plan.ArchitectureDecisions.Count > 0 || _plan.Phases.Count > 0 || _plan.Milestones.Count > 0 || _plan.Gates.Count > 0 || _plan.ConstitutionCheckItems.Count > 0)
                    {
                        <section class="pe-ov-group" aria-labelledby="pe-ov-structure" data-testid="pe-structure-summary">
                            <h3 class="pe-ov-heading" id="pe-ov-structure">Plan structure</h3>
                            <div class="pe-ov-cards">
                                @if (_plan.ArchitectureDecisions.Count > 0)
                                {
                                    <div class="pe-ov-card"><div class="pe-ov-value">@_plan.ArchitectureDecisions.Count</div><div class="pe-ov-label">Architecture decisions</div></div>
                                }
                                @if (_plan.Phases.Count > 0)
                                {
                                    <div class="pe-ov-card"><div class="pe-ov-value">@_plan.Phases.Count</div><div class="pe-ov-label">Implementation phases</div><div class="pe-ov-detail">Planned, not delivery progress</div></div>
                                }
                                @if (_plan.Milestones.Count > 0)
                                {
                                    <div class="pe-ov-card"><div class="pe-ov-value">@_plan.Milestones.Count</div><div class="pe-ov-label">Milestones</div></div>
                                }
                                @if (_plan.Gates.Count > 0 || _plan.ConstitutionCheckItems.Count > 0)
                                {
                                    <div class="pe-ov-card" data-testid="pe-constitution-summary-card">
                                        <div class="pe-ov-value">@(_plan.Gates.Count + _plan.ConstitutionCheckItems.Count)</div>
                                        <div class="pe-ov-label">Constitution statements in the plan</div>
                                        <div class="pe-ov-detail" data-testid="pe-constitution-summary">@ConstitutionStated</div>
                                        <div class="pe-ov-detail">BirkNext assessment: Not performed</div>
                                    </div>
                                }
                            </div>
                        </section>
                    }

                    @foreach (var note in _plan.Health.Indicators.Where(i => i.Topic == "context"))
                    {
                        <p class="pe-indicator pe-indicator-@note.Level.ToString().ToLowerInvariant()">
                            <span class="pe-indicator-icon" aria-hidden="true">@note.Icon</span>
                            <span class="pe-indicator-message">@note.Message</span>
                        </p>
                    }

                    <div class="pe-overview-secondary">
                        <!-- Declared dependencies: what the plan lists, not what the code or runtime uses -->
                        <section class="pe-overview-card" aria-labelledby="pe-ov-deps" data-testid="pe-dependencies">
                            <div class="pe-overview-card-header">
                                <h3 class="pe-overview-card-title" id="pe-ov-deps">Declared dependencies</h3>
                                <span class="pe-overview-card-count" data-testid="pe-dependency-count">@_plan.Dependencies.Count</span>
                            </div>
                            @if (_plan.Dependencies.Count == 0)
                            {
                                <p class="pe-ov-help">The plan declares no dependencies.</p>
                            }
                            else
                            {
                                <p class="pe-ov-help" data-testid="pe-dependency-help">@_plan.Dependencies.Count declared dependency entries in the plan (@DependencySources). One entry per plan declaration; multiple names on one line count as one entry. Use in code or at runtime is not verified here.@(_plan.Dependencies.Any(d => d.ScopeStated) ? "" : " The plan does not say which are internal or external.")</p>
                                <p class="pe-ov-help pe-dependency-visible-count" data-testid="pe-dependency-visible-count">Showing @VisibleDependencies.Count of @_plan.Dependencies.Count declared dependency entries</p>
                                <ul class="pe-overview-list pe-dep-list">
                                    @foreach (var dep in VisibleDependencies)
                                    {
                                        <li data-testid="pe-dependency">
                                            <span class="pe-dep-name">@dep.Name</span>
                                            @if (!string.IsNullOrEmpty(dep.Version))
                                            { <span class="pe-dep-version">@dep.Version</span> }
                                            @if (dep.ScopeStated)
                                            { <span class="pe-dep-badge" data-testid="pe-dependency-scope">@(dep.IsExternal ? "External to project" : "Internal to project")</span> }
                                            @if (!string.IsNullOrEmpty(dep.Description))
                                            { <span class="pe-dep-purpose">@dep.Description</span> }
                                        </li>
                                    }
                                </ul>
                                @if (_plan.Dependencies.Count > DependencyPreview)
                                {
                                    <button type="button" class="pe-ov-more" data-testid="pe-dependency-more" aria-expanded="@(_showAllDependencies ? "true" : "false")"
                                            @onclick="() => _showAllDependencies = !_showAllDependencies">
                                        @(_showAllDependencies ? $"Show first {Math.Min(DependencyPreview, _plan.Dependencies.Count)} dependency entries" : $"Show all {_plan.Dependencies.Count} declared dependency entries")
                                    </button>
                                }
                            }
                        </section>

                        <!-- Testing plan: what the plan says about testing; no test is run or read here -->
                        <section class="pe-overview-card" aria-labelledby="pe-ov-testing" data-testid="pe-testing-summary">
                            <div class="pe-overview-card-header">
                                <h3 class="pe-overview-card-title" id="pe-ov-testing">Testing plan</h3>
                                <span class="pe-overview-card-count">@(_plan.TestingInfo is null ? "Not in plan" : "In plan")</span>
                            </div>
                            @if (_plan.TestingInfo is { } testingPlan)
                            {
                                <p class="pe-ov-help">Testing approach declared in the plan@(testingPlan.Frameworks.Count > 0 ? $": {string.Join(", ", testingPlan.Frameworks)}" : "").</p>
                                <p class="pe-ov-help">No tests are run or read here; executed results come from imported test evidence.</p>
                            }
                            else
                            {
                                <p class="pe-ov-help">The plan has no testing section.</p>
                            }
                        </section>

                        @if (_plan.Milestones.Count > 0)
                        {
                            <div class="pe-overview-card">
                                <div class="pe-overview-card-header">
                                    <span class="pe-overview-card-title">Milestones</span>
                                    <span class="pe-overview-card-count">@_plan.Milestones.Count</span>
                                </div>
                                <ul class="pe-overview-list">
                                    @foreach (var ms in _plan.Milestones)
                                    {
                                        <li>
                                            <span class="pe-ms-title">@ms.Title</span>
                                            @if (!string.IsNullOrEmpty(ms.TargetDate))
                                            { <span class="pe-ms-date">@ms.TargetDate</span> }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>

                </div>
            }

            @if (_tab == "architecture")
            {
                <!-- ── Architecture Tab ───────────────────────────────────── -->
                <div class="pe-architecture">
                    @foreach (var sec in _plan.Sections.Where(s => s.SectionType == PlanSectionType.Architecture))
                    {
                        @RenderSectionBlocks(sec)
                    }

                    @if (!VisibleDecisions.Any() && !_plan.Sections.Any(s => s.SectionType == PlanSectionType.Architecture))
                    {
                        <div class="pe-empty-tab">
                            @if (!string.IsNullOrWhiteSpace(_search))
                            { <span>No architecture decisions match "<strong>@_search</strong>"</span> }
                            else
                            { <span>No architecture decisions found. Add an <code>## Architecture</code> section with <code>### Decision Title</code> or <code>### ADR-01: Title</code> headings.</span> }
                        </div>
                    }
                    else if (VisibleDecisions.Any())
                    {
                        <div class="pe-adr-section">
                            <div class="pe-section-kicker">Architecture Decision Records</div>
                            @foreach (var adr in VisibleDecisions)
                            {
                                var isExpanded = _expanded.Contains(adr.NodeId);
                                <div class="pe-adr-card @(isExpanded ? "is-expanded" : "")">
                                    <button class="pe-adr-header" @onclick="() => Toggle(adr.NodeId)" aria-expanded="@isExpanded.ToString().ToLower()">
                                        <div class="pe-adr-header-left">
                                            @if (!string.IsNullOrEmpty(adr.Id))
                                            { <span class="pe-adr-id" title="Architecture Decision Record @adr.Id">@adr.Id</span> }
                                            <span class="pe-adr-title">@adr.Title</span>
                                        </div>
                                        <span class="pe-expand-icon" aria-hidden="true">@(isExpanded ? "▾" : "▸")</span>
                                    </button>
                                    @if (isExpanded)
                                    {
                                        <div class="pe-adr-body">
                                            @if (!string.IsNullOrEmpty(adr.Context))
                                            {
                                                <div class="pe-adr-section-block">
                                                    <div class="pe-adr-section-label">Context</div>
                                                    <p class="pe-adr-text">@adr.Context</p>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(adr.Decision))
                                            {
                                                <div class="pe-adr-section-block">
                                                    <div class="pe-adr-section-label">Decision</div>
                                                    <p class="pe-adr-text">@adr.Decision</p>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(adr.Rationale))
                                            {
                                                <div class="pe-adr-section-block">
                                                    <div class="pe-adr-section-label">Rationale</div>
                                                    <p class="pe-adr-text">@adr.Rationale</p>
                                                </div>
                                            }
                                            @if (adr.Consequences.Count > 0)
                                            {
                                                <div class="pe-adr-section-block">
                                                    <div class="pe-adr-section-label">Consequences</div>
                                                    <ul class="pe-list">
                                                        @foreach (var c in adr.Consequences) { <li>@c</li> }
                                                    </ul>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @if (_tab == "tech-context")
            {
                <!-- ── Technical Context Tab ──────────────────────────────── -->
                <div class="pe-tech-context">
                    @{
                        var techSections = _plan.Sections
                            .Where(s => s.SectionType == PlanSectionType.TechnicalContext).ToList();
                    }
                    @if (techSections.Count == 0)
                    {
                        <div class="pe-empty-tab">
                            <span>No technical context section found. Add a <code>## Technical Context</code> section to the Plan artifact.</span>
                        </div>
                    }
                    else
                    {
                        @foreach (var sec in techSections)
                        {
                            <div class="pe-section">
                                <div class="pe-section-title">@sec.Title</div>
                                <div class="pe-section-content">
                                    <MarkdownContent Content="@sec.RawContent" PreserveSoftLineBreaks="true" />
                                </div>
                            </div>
                        }
                    }
                </div>
            }

            @if (_tab == "structure")
            {
                <!-- ── Project Structure Tab ──────────────────────────────── -->
                <div class="pe-structure">
                    @{
                        var structureSections = _plan.Sections
                            .Where(s => s.SectionType == PlanSectionType.ProjectStructure).ToList();
                    }
                    @if (structureSections.Count == 0)
                    {
                        <div class="pe-empty-tab">
                            <span>No project structure section found. Add a <code>## Project Structure</code> section to the Plan artifact.</span>
                        </div>
                    }
                    else
                    {
                        @foreach (var sec in structureSections)
                        {
                            <div class="pe-section">
                                <div class="pe-section-title">@sec.Title</div>
                                <div class="pe-section-content">
                                    @{
                                        var subsections = ExtractSubsections(sec.RawContent);
                                    }
                                    @if (subsections.Count == 0)
                                    {
                                        <MarkdownContent Content="@sec.RawContent" />
                                    }
                                    else
                                    {
                                        @foreach (var (index, subsec) in subsections.Select((s, i) => (i, s)))
                                        {
                                            var subsecNodeId = $"structure-subsec-{GenerateNodeId(subsec.Heading)}";
                                            var subsecExpanded = (index == 0) ? !_expanded.Contains(subsecNodeId) : _expanded.Contains(subsecNodeId);
                                            <div class="pe-subsection @(subsecExpanded ? "is-expanded" : "")">
                                                <button class="pe-subsection-header" @onclick="() => Toggle(subsecNodeId)" aria-expanded="@subsecExpanded.ToString().ToLower()">
                                                    <span class="pe-subsection-title">@subsec.Heading</span>
                                                    <span class="pe-expand-icon" aria-hidden="true">@(subsecExpanded ? "▾" : "▸")</span>
                                                </button>
                                                @if (subsecExpanded)
                                                {
                                                    <div class="pe-subsection-body">
                                                        <MarkdownContent Content="@subsec.Content" />
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            }

            @if (_tab == "risks")
            {
                <!-- ── Risks Tab ──────────────────────────────────────────── -->
                <div class="pe-risks">
                    @{
                        var visibleRisks = VisibleRisks.ToList();
                        var riskGrouped = visibleRisks
                            .GroupBy(r => r.Severity)
                            .OrderByDescending(g => g.Key)
                            .ToList();
                    }
                    @if (visibleRisks.Count == 0 && _plan.Constraints.Count == 0)
                    {
                        <div class="pe-empty-tab">
                            @if (!string.IsNullOrWhiteSpace(_search) || _riskFilter is not null)
                            { <span>No risks or constraints match the current filter.</span> }
                            else
                            { <span>No risks or constraints found. Add a <code>## Risks</code> section with <code>### High Risk: Title</code> items or constraint definitions.</span> }
                        </div>
                    }
                    else
                    {
                        @foreach (var group in riskGrouped)
                        {
                            <div class="pe-risk-group">
                                <div class="pe-risk-group-header pe-severity-header-@group.Key.ToString().ToLowerInvariant()">
                                    <span class="pe-severity-dot pe-dot-@group.Key.ToString().ToLowerInvariant()" aria-hidden="true"></span>
                                    @SeverityGroupLabel(group.Key) (@group.Count())
                                </div>
                                @foreach (var risk in group)
                                {
                                    var isExpanded = _expanded.Contains(risk.NodeId);
                                    <div class="pe-risk-card pe-risk-@risk.Severity.ToString().ToLowerInvariant() @(isExpanded ? "is-expanded" : "")">
                                        <button class="pe-risk-header" @onclick="() => Toggle(risk.NodeId)" aria-expanded="@isExpanded.ToString().ToLower()">
                                            <div class="pe-risk-header-left">
                                                <span class="pe-severity-badge pe-badge-@risk.Severity.ToString().ToLowerInvariant()">@SeverityLabel(risk.Severity)</span>
                                                <span class="pe-risk-title">@risk.Title</span>
                                                @if (!string.IsNullOrEmpty(risk.Area))
                                                { <span class="pe-risk-area">@risk.Area</span> }
                                            </div>
                                            <span class="pe-expand-icon" aria-hidden="true">@(isExpanded ? "▾" : "▸")</span>
                                        </button>
                                        @if (isExpanded)
                                        {
                                            <div class="pe-risk-body">
                                                @if (!string.IsNullOrEmpty(risk.Description))
                                                { <p class="pe-risk-desc">@risk.Description</p> }
                                                @if (!string.IsNullOrEmpty(risk.Mitigation))
                                                {
                                                    <div class="pe-risk-mitigation">
                                                        <span class="pe-risk-mitigation-label">Mitigation</span>
                                                        <span class="pe-risk-mitigation-text">@risk.Mitigation</span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }

                        <!-- Constraints & Performance Goals -->
                        @if (_plan.Constraints.Count > 0 && string.IsNullOrWhiteSpace(_search) && _riskFilter is null)
                        {
                            <div class="pe-constraints">
                                <div class="pe-constraints-section-header">Constraints &amp; Performance Goals</div>
                                @{
                                    var constraintGrouped = _plan.Constraints
                                        .GroupBy(c => c.ConstraintType)
                                        .OrderBy(g => (int)g.Key)
                                        .ToList();
                                }
                                @foreach (var cgroup in constraintGrouped)
                                {
                                    <div class="pe-constraint-group">
                                        @foreach (var constraint in cgroup)
                                        {
                                            <div class="pe-constraint-card pe-ctype-@ConstraintTypeCss(constraint.ConstraintType)">
                                                <span class="pe-constraint-type-badge pe-cbadge-@ConstraintTypeCss(constraint.ConstraintType)">@ConstraintTypeLabel(constraint.ConstraintType)</span>
                                                <div class="pe-constraint-body">
                                                    <div class="pe-constraint-title">@constraint.Title</div>
                                                    @if (!string.IsNullOrEmpty(constraint.Description) &&
                                                         !constraint.Title?.Trim().Equals(constraint.Description?.Trim(), StringComparison.OrdinalIgnoreCase) == true)
                                                    { <p class="pe-constraint-desc">@constraint.Description</p> }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            }

            @if (_tab == "complexity")
            {
                <!-- ── Complexity Tab ─────────────────────────────────────── -->
                <div class="pe-complexity">
                    @if (!VisibleComplexity.Any())
                    {
                        <div class="pe-empty-tab">
                            @if (!string.IsNullOrWhiteSpace(_search) || _complexityFilter is not null)
                            { <span>No complexity items match the current filter.</span> }
                            else
                            { <span>No complexity items found. Add a <code>## Complexity</code> section to the Plan artifact.</span> }
                        </div>
                    }
                    else
                    {
                        @if (_plan.ComplexityDerived)
                        {
                            <div class="pe-auto-generated-notice" data-testid="pe-complexity-derived">
                                <span class="pe-auto-generated-icon" aria-hidden="true">✦</span>
                                Derived by plan analysis from constraints, declared dependencies, risks and section keywords — the plan lists no complexity items itself.
                            </div>
                        }
                        @foreach (var group in VisibleComplexity.GroupBy(c => c.Level).OrderByDescending(g => g.Key))
                        {
                            <div class="pe-complexity-group">
                                <div class="pe-complexity-group-header pe-complexity-header-@group.Key.ToString().ToLowerInvariant()">
                                    @ComplexityLevelLabel(group.Key) Complexity (@group.Count())
                                </div>
                                @foreach (var item in group)
                                {
                                    var isExpanded = _expanded.Contains(item.NodeId);
                                    <div class="pe-complexity-card pe-complexity-@item.Level.ToString().ToLowerInvariant() @(isExpanded ? "is-expanded" : "")">
                                        <button class="pe-complexity-header" @onclick="() => Toggle(item.NodeId)" aria-expanded="@isExpanded.ToString().ToLower()">
                                            <div class="pe-complexity-header-left">
                                                <span class="pe-complexity-badge pe-cbadge-@item.Level.ToString().ToLowerInvariant()">@ComplexityLevelLabel(item.Level)</span>
                                                <span class="pe-complexity-area">@item.Area</span>
                                            </div>
                                            <span class="pe-expand-icon" aria-hidden="true">@(isExpanded ? "▾" : "▸")</span>
                                        </button>
                                        @if (isExpanded)
                                        {
                                            <div class="pe-complexity-body">
                                                @if (!string.IsNullOrEmpty(item.Notes))
                                                { <p class="pe-complexity-notes">@item.Notes</p> }
                                                @if (item.Factors.Count > 0)
                                                {
                                                    <div class="pe-complexity-factors">
                                                        <div class="pe-complexity-factors-label">Contributing Factors</div>
                                                        <ul class="pe-list">
                                                            @foreach (var f in item.Factors) { <li>@f</li> }
                                                        </ul>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            }

            @if (_tab == "phases")
            {
                <!-- ── Implementation Phases Tab ──────────────────────────── -->
                <div class="pe-phases">
                    @{
                        var visiblePhases = VisiblePhases.ToList();
                    }
                    @if (visiblePhases.Count == 0)
                    {
                        <div class="pe-empty-tab">
                            @if (!string.IsNullOrWhiteSpace(_search))
                            { <span>No phases match "<strong>@_search</strong>"</span> }
                            else
                            { <span>No implementation phases found. Add an <code>## Implementation</code> section with <code>### Phase 1: Title</code> headings.</span> }
                        </div>
                    }
                    else
                    {
                        @foreach (var shared in SharedPhaseKeys)
                        {
                            <p class="pe-phase-shared-note" role="note" data-phase-key="@shared.Key">
                                @shared.Count() source sections map to @PlanAnalysisService.PhaseDisplayLabel(shared.First()):
                                @string.Join(" · ", shared.Select(p => p.Title))
                            </p>
                        }
                        <div class="pe-phase-timeline">
                            @foreach (var phase in visiblePhases)
                            {
                                var isExpanded = _expanded.Contains(phase.NodeId);
                                var phaseClass = phase.PhaseNumber == 0 ? "is-pre" : phase.PhaseNumber == 99 ? "is-post" : string.Empty;
                                var phaseLabel = PhaseNodeLabel(phase);
                                <div class="pe-phase-item @phaseClass @(isExpanded ? "is-expanded" : "")">
                                    <div class="pe-phase-node">
                                        <span class="pe-phase-number">@phaseLabel</span>
                                    </div>
                                    <div class="pe-phase-card">
                                        <button class="pe-phase-header" @onclick="() => Toggle(phase.NodeId)" aria-expanded="@isExpanded.ToString().ToLower()">
                                            <div class="pe-phase-header-left">
                                                <span class="pe-phase-label">@phaseLabel</span>
                                                <span class="pe-phase-title-text">@phase.Title</span>
                                            </div>
                                            <div style="display:flex;align-items:center;gap:.5rem;">
                                                @if (phase.Tasks.Count > 0)
                                                { <span class="pe-phase-task-count">@phase.Tasks.Count task@(phase.Tasks.Count != 1 ? "s" : "")</span> }
                                                <span class="pe-expand-icon" aria-hidden="true">@(isExpanded ? "▾" : "▸")</span>
                                            </div>
                                        </button>
                                        @if (isExpanded)
                                        {
                                            <div class="pe-phase-body">
                                                @if (!string.IsNullOrEmpty(phase.Description))
                                                { <p class="pe-adr-text">@phase.Description</p> }
                                                @if (phase.Tasks.Count > 0)
                                                {
                                                    <div>
                                                        <div class="pe-phase-section-label">Tasks</div>
                                                        <ul class="pe-phase-task-list">
                                                            @foreach (var task in phase.Tasks) { <li>@task</li> }
                                                        </ul>
                                                    </div>
                                                }
                                                else if (phase.Blocks.Count > 0)
                                                {
                                                    @foreach (var block in phase.Blocks)
                                                    {
                                                        @if (!string.IsNullOrEmpty(block.SubHeading))
                                                        {
                                                            <h4 class="pe-block-subheading">@block.SubHeading</h4>
                                                        }
                                                        @if (!string.IsNullOrEmpty(block.Paragraph) && block.Paragraph.Trim() != "---" && block.Paragraph.Trim() != "***" && block.Paragraph.Trim() != "___")
                                                        {
                                                            <MarkdownContent Content="@block.Paragraph" />
                                                        }
                                                        @if (block.IsCodeBlock && !string.IsNullOrEmpty(block.CodeBlock))
                                                        {
                                                            <pre class="pe-code-block"><code>@block.CodeBlock</code></pre>
                                                        }
                                                        @if (block.BulletPoints.Count > 0)
                                                        {
                                                            <ul class="pe-block-bullets">
                                                                @foreach (var bullet in block.BulletPoints)
                                                                {
                                                                    <li>@bullet</li>
                                                                }
                                                            </ul>
                                                        }
                                                    }
                                                }
                                                @if (phase.Checks.Count > 0)
                                                {
                                                    <div class="pe-phase-checks">
                                                        <div class="pe-phase-section-label">Checks / Gates</div>
                                                        <ul class="pe-phase-check-list">
                                                            @foreach (var check in phase.Checks) { <li>@check</li> }
                                                        </ul>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @if (_tab == "testing")
            {
                <!-- ── Testing Tab ────────────────────────────────────────── -->
                <div class="pe-testing">
                    @{
                        var testing = _plan.TestingInfo;
                    }
                    @if (testing is null)
                    {
                        <div class="pe-empty-tab">
                            <span>No testing section found. Add a <code>## Testing</code> section to the Plan artifact.</span>
                        </div>
                    }
                    else
                    {
                        <p class="pe-tab-note" data-testid="pe-testing-note">Testing approach as declared in the Plan artifact. No tests are run or read here; executed test results come from imported test evidence.</p>
                        <!-- Frameworks -->
                        @if (testing.Frameworks.Count > 0)
                        {
                            <div class="pe-testing-frameworks">
                                <div class="pe-testing-section-title" style="width:100%;margin-bottom:0;">Frameworks &amp; Libraries</div>
                                @foreach (var fw in testing.Frameworks)
                                {
                                    <span class="pe-framework-chip">@fw</span>
                                }
                            </div>
                        }

                        <!-- Gate refs -->
                        @if (testing.GateRefs.Count > 0)
                        {
                            <div class="pe-testing-section">
                                <div class="pe-testing-section-title">Constitution Gate References</div>
                                <div class="pe-testing-gate-refs">
                                    @foreach (var ref_ in testing.GateRefs)
                                    {
                                        <span class="pe-testing-gate-ref">@ref_</span>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Test folders -->
                        @if (testing.TestFolders.Count > 0)
                        {
                            <div class="pe-testing-section">
                                <div class="pe-testing-section-title">Test paths named in the plan</div>
                                <div class="pe-testing-folders">
                                    @foreach (var folder in testing.TestFolders)
                                    {
                                        <span class="pe-testing-folder">📁 @folder</span>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Test classes -->
                        @if (testing.TestClasses.Count > 0)
                        {
                            <div class="pe-testing-section">
                                <div class="pe-testing-section-title">Test classes named in the plan</div>
                                <div class="pe-testing-folders">
                                    @foreach (var cls in testing.TestClasses)
                                    {
                                        <span class="pe-testing-folder">🔬 @cls</span>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Free-form blocks -->
                        @foreach (var block in testing.Blocks.Where(b => b.HasContent || b.SubHeading is not null))
                        {
                            <div class="pe-testing-section">
                                @if (!string.IsNullOrEmpty(block.SubHeading))
                                {
                                    <div class="pe-testing-section-title">@block.SubHeading</div>
                                }
                                @if (block.IsCodeBlock)
                                {
                                    <pre class="pe-code-block"><code>@block.CodeBlock</code></pre>
                                }
                                else
                                {
                                    @if (!string.IsNullOrEmpty(block.Paragraph))
                                    { <p class="pe-section-para">@block.Paragraph</p> }
                                    @if (block.BulletPoints.Count > 0)
                                    {
                                        <ul class="pe-section-list">
                                            @foreach (var pt in block.BulletPoints) { <li>@pt</li> }
                                        </ul>
                                    }
                                }
                            </div>
                        }
                    }
                </div>
            }

            @if (_tab == "constitution")
            {
                <!-- ── Constitution Check Tab ─────────────────────────────── -->
                <div class="pe-constitution-check">
                    @if (_plan.Gates.Count > 0 || _plan.ConstitutionCheckItems.Count > 0)
                    {
                        <p class="pe-tab-note" data-testid="pe-constitution-note">These statuses are the plan's own statements. Plan Explorer does not independently assess them against the Constitution artifact.</p>
                    }

                    <!-- Gate table (table-based, rendered first) -->
                    @{
                        var visibleGates = VisibleGates.ToList();
                        var showEvidenceColumn = visibleGates.Any(g => !string.IsNullOrWhiteSpace(g.Evidence));
                    }
                    @if (visibleGates.Any())
                    {
                        <div class="pe-gate-table-wrap">
                            <table class="pe-gate-table" aria-label="Constitution gates">
                                <thead>
                                    <tr>
                                        <th>Gate</th>
                                        <th>Rule</th>
                                        <th>Status stated in plan</th>
                                        @if (showEvidenceColumn)
                                        {
                                            <th>Evidence</th>
                                        }
                                        <th>Notes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var gate in visibleGates)
                                    {
                                        <tr>
                                            <td class="pe-gate-label">@gate.Gate</td>
                                            <td class="pe-gate-rule">@(string.IsNullOrEmpty(gate.RuleId) ? gate.Principle : gate.RuleId)</td>
                                            <td>
                                                <span class="pe-gate-status @GateStatusCss(gate.Status)">
                                                    Plan says: @GateStatusLabel(gate)
                                                </span>
                                            </td>
                                            @if (showEvidenceColumn)
                                            {
                                                <td class="pe-gate-evidence">@(gate.Evidence ?? string.Empty)</td>
                                            }
                                            <td class="pe-gate-notes">@(gate.Notes ?? string.Empty)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <!-- Heading-based check items -->
                    @if (!VisibleChecks.Any() && !VisibleGates.Any())
                    {
                        <div class="pe-empty-tab">
                            @if (!string.IsNullOrWhiteSpace(_search) || _checkFilter is not null || _gateFilter is not null)
                            { <span>No constitution check items match the current filter.</span> }
                            else
                            { <span>No constitution check items found. Add a <code>## Constitution Check</code> section with rule IDs (PP-01, PS-07) or a gate table.</span> }
                        </div>
                    }
                    else if (VisibleChecks.Any())
                    {
                        @if (VisibleGates.Any())
                        {
                            <div class="pe-constraints-section-header">Detailed Check Items</div>
                        }
                        @foreach (var group in VisibleChecks.GroupBy(c => c.Status).OrderBy(g => (int)g.Key))
                        {
                            <div class="pe-check-group">
                                <div class="pe-check-group-header pe-check-header-@CheckStatusCss(group.Key)">
                                    @PlanCheckStatusLabel(group.Key) (@group.Count())
                                </div>
                                @foreach (var item in group)
                                {
                                    var isExpanded = _expanded.Contains(item.NodeId);
                                    <div class="pe-check-card pe-check-@CheckStatusCss(item.Status) @(isExpanded ? "is-expanded" : "")">
                                        <button class="pe-check-header" @onclick="() => Toggle(item.NodeId)" aria-expanded="@isExpanded.ToString().ToLower()">
                                            <div class="pe-check-header-left">
                                                @if (!string.IsNullOrEmpty(item.RuleId))
                                                { <span class="pe-rule-id-badge">@item.RuleId</span> }
                                                <span class="pe-check-title">@item.Title</span>
                                            </div>
                                            <div class="pe-check-header-right">
                                                <span class="pe-check-status-badge pe-check-badge-@CheckStatusCss(item.Status)">Plan says: @PlanCheckStatusLabel(item.Status)</span>
                                                <span class="pe-expand-icon" aria-hidden="true">@(isExpanded ? "▾" : "▸")</span>
                                            </div>
                                        </button>
                                        @if (isExpanded && !string.IsNullOrEmpty(item.Notes))
                                        {
                                            <div class="pe-check-body">
                                                <p class="pe-check-notes">@item.Notes</p>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }

                </div>
            }

        </div>
    }

</div>

@code {
    [Parameter] public string PlanText { get; set; } = string.Empty;
    [Parameter] public PlanDocument? ParsedPlan { get; set; }
    [Parameter] public PlanSemanticModel? SemanticModel { get; set; }
    [Parameter] public ArtifactExplorerState? SpecificationState { get; set; }
    [Parameter] public string? InitialView { get; set; }
    [Parameter] public EventCallback<string> OnTextChanged { get; set; }

    private PlanDocument? _plan;
    private string _localText = string.Empty;
    private string _tab = "overview";
    private string _search = string.Empty;
    private HashSet<string> _expanded = [];
    private SpecificationImport? _importRef;

    private RiskSeverity? _riskFilter;
    private ComplexityLevel? _complexityFilter;
    private ConstitutionCheckStatus? _checkFilter;
    private PlanGateStatus? _gateFilter;

    private bool CanBuild => !string.IsNullOrWhiteSpace(_localText);

    private string SearchPlaceholder => _tab switch
    {
        "architecture" => "Search by ADR ID, title, context, or decision...",
        "risks"        => "Search by title, description, severity, area, or constraint type...",
        "complexity"   => "Search by area, level, or factor...",
        "phases"       => "Search by phase title, description, or task...",
        "testing"      => "Search testing content...",
        "constitution" => "Search by rule ID (PP-01), gate, or status...",
        _              => "Search...",
    };

    private IEnumerable<PlanArchitectureDecision> VisibleDecisions =>
        _plan is null ? [] : AnalysisService.SearchDecisions(_plan.ArchitectureDecisions, _search);

    private IEnumerable<PlanRisk> VisibleRisks
    {
        get
        {
            if (_plan is null) return [];
            var items = AnalysisService.FilterRisksBySeverity(_plan.Risks, _riskFilter);
            return AnalysisService.SearchRisks(items, _search);
        }
    }

    private IEnumerable<PlanComplexityItem> VisibleComplexity
    {
        get
        {
            if (_plan is null) return [];
            var items = AnalysisService.FilterComplexityByLevel(_plan.ComplexityItems, _complexityFilter);
            return AnalysisService.SearchComplexity(items, _search);
        }
    }

    private IEnumerable<PlanConstitutionCheckItem> VisibleChecks
    {
        get
        {
            if (_plan is null) return [];
            var items = AnalysisService.FilterCheckByStatus(_plan.ConstitutionCheckItems, _checkFilter);
            return AnalysisService.SearchConstitutionCheck(items, _search);
        }
    }

    private IEnumerable<PlanGate> VisibleGates
    {
        get
        {
            if (_plan is null) return [];
            var items = AnalysisService.FilterGatesByStatus(_plan.Gates, _gateFilter);
            return AnalysisService.SearchGates(items, _search);
        }
    }

    private IEnumerable<PlanImplementationPhase> VisiblePhases =>
        _plan is null ? [] : AnalysisService.SearchPhases(_plan.Phases, _search);

    private int SearchResultCount => _tab switch
    {
        "architecture" => VisibleDecisions.Count(),
        "risks"        => VisibleRisks.Count(),
        "complexity"   => VisibleComplexity.Count(),
        "phases"       => VisiblePhases.Count(),
        "constitution" => VisibleGates.Count() + VisibleChecks.Count(),
        _              => 0,
    };

    private string AdrBadge         => _plan?.ArchitectureDecisions.Count > 0 ? $"({_plan.ArchitectureDecisions.Count})" : string.Empty;
    private string ComplexityBadge   => _plan?.ComplexityItems.Count > 0 ? $"({_plan.ComplexityItems.Count})" : string.Empty;

    /// <summary>The tab holds risks and constraints; each gets its own count so neither is mistaken for the other.</summary>
    private string RisksTabLabel => _plan is null ? "Risks & Constraints"
        : $"Risks{(_plan.Risks.Count > 0 ? $" ({_plan.Risks.Count})" : "")} & Constraints{(_plan.Constraints.Count > 0 ? $" ({_plan.Constraints.Count})" : "")}";

    private IEnumerable<(string Key, string Label)> Tabs =>
    [
