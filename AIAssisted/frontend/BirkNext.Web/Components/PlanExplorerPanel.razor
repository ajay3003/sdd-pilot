    private static string GateStatusLabel(PlanGate gate)
    {
        if (gate.Status == PlanGateStatus.Warning && gate.IsJustifiedDeviation)
            return "justified deviation";

        return gate.Status switch
        {
            PlanGateStatus.Pass          => "marked met",
            PlanGateStatus.Warning       => "warning",
            PlanGateStatus.Fail          => "marked not met",
            PlanGateStatus.NotApplicable => "not applicable",
            _                            => gate.Status.ToString().ToLowerInvariant(),
        };
    }

