    // ── Section block renderer ─────────────────────────────────────────────

    private RenderFragment RenderSectionBlocks(PlanSection section) => __builder =>
    {
        __builder.OpenElement(0, "div");
        __builder.AddAttribute(1, "class", "pe-section-content");

        foreach (var block in section.Blocks.Where(b => b.HasContent || b.SubHeading is not null))
        {
            __builder.OpenElement(2, "div");
            __builder.AddAttribute(3, "class", "pe-section-block");

            if (!string.IsNullOrEmpty(block.SubHeading))
            {
                __builder.OpenElement(4, "h4");
                __builder.AddAttribute(5, "class", "pe-section-subheading");
                __builder.AddContent(6, block.SubHeading);
                __builder.CloseElement();
            }

            if (block.IsCodeBlock)
            {
                __builder.OpenElement(7, "pre");
                __builder.AddAttribute(8, "class", "pe-code-block");
                __builder.OpenElement(9, "code");
                __builder.AddContent(10, block.CodeBlock);
                __builder.CloseElement();
                __builder.CloseElement();
            }
            else
            {
                if (!string.IsNullOrEmpty(block.Paragraph))
                {
                    __builder.OpenElement(11, "p");
                    __builder.AddAttribute(12, "class", "pe-section-para");
                    __builder.AddContent(13, block.Paragraph);
                    __builder.CloseElement();
                }
                if (block.BulletPoints.Count > 0)
                {
                    __builder.OpenElement(14, "ul");
                    __builder.AddAttribute(15, "class", "pe-section-list");
                    foreach (var point in block.BulletPoints)
                    {
                        __builder.OpenElement(16, "li");
                        __builder.AddContent(17, point);
                        __builder.CloseElement();
                    }
                    __builder.CloseElement();
                }
            }

            __builder.CloseElement(); // block
        }

        __builder.CloseElement(); // section-content
    };

    // ── Project Structure subsection collapsing ────────────────────────────

    private sealed record Subsection(string Heading, string Content);

    private List<Subsection> ExtractSubsections(string markdown)
    {
        var subsections = new List<Subsection>();
        var lines = markdown.Split('\n');
        string? currentHeading = null;
        var currentContent = new System.Text.StringBuilder();

        foreach (var line in lines)
        {
            var trimmed = line.TrimStart();
            if (trimmed.StartsWith("### "))
            {
                if (currentHeading != null)
                {
                    subsections.Add(new Subsection(currentHeading, currentContent.ToString().TrimEnd()));
                }
                currentHeading = trimmed[4..].Trim();
                currentContent.Clear();
            }
            else if (currentHeading != null)
            {
                currentContent.AppendLine(line);
            }
        }

        if (currentHeading != null)
        {
            subsections.Add(new Subsection(currentHeading, currentContent.ToString().TrimEnd()));
        }

        return subsections;
    }

    private string GenerateNodeId(string text)
    {
        var id = System.Text.RegularExpressions.Regex.Replace(text.ToLowerInvariant(), @"[^\w\s-]", "");
        id = System.Text.RegularExpressions.Regex.Replace(id, @"\s+", "-");
        return id[..Math.Min(32, id.Length)];
    }
