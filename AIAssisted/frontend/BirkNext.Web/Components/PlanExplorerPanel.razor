    private const int DependencyPreview = 6;
    private bool _showAllDependencies;
    private IReadOnlyList<PlanDependency> VisibleDependencies => _plan is null
        ? []
        : (_showAllDependencies ? _plan.Dependencies : _plan.Dependencies.Take(DependencyPreview)).ToList();

    private string RiskCardClass => _plan is null ? "" : _plan.Health.CriticalRisks > 0 ? "pe-ov-critical" : _plan.Health.HighRisks > 0 ? "pe-ov-high" : "";

    /// <summary>The severity distribution as the plan states it; severities it does not state are named, never guessed.</summary>
    private string RiskDistribution
    {
        get
        {
            if (_plan is null || _plan.Health.TotalRisks == 0) return "No risks listed in the plan";
            var h = _plan.Health;
            var parts = new List<string> { $"{h.CriticalRisks} critical", $"{h.HighRisks} high" };
            if (h.MediumRisks > 0) parts.Add($"{h.MediumRisks} medium");
            if (h.LowRisks > 0) parts.Add($"{h.LowRisks} low");
            if (h.UnratedRisks > 0) parts.Add($"{h.UnratedRisks} severity not stated");
            return string.Join(" · ", parts);
        }
    }

    private string ConstitutionStated
    {
        get
        {
            if (_plan is null) return "";
            var met = _plan.Health.PassedGates + _plan.Health.CompliantItems;
            var notMet = _plan.Health.FailedGates + _plan.Health.NonCompliantItems;
            var review = _plan.Health.WarningGates + _plan.Health.NeedsReviewItems;
            var notApplicable = _plan.Gates.Count(g => g.Status == PlanGateStatus.NotApplicable)
                + _plan.ConstitutionCheckItems.Count(c => c.Status == ConstitutionCheckStatus.NotApplicable);
            var total = _plan.Gates.Count + _plan.ConstitutionCheckItems.Count;
            if (met == total)
                return $"{met} of {total} marked met by the plan; BirkNext assessment: Not performed";

            return $"Plan states: {met} marked met · {notMet} marked not met · {review} need review · {notApplicable} not applicable. BirkNext assessment: Not performed";
        }
    }

    private PlanSpecificationReferenceResolution? SpecificationReference =>
        _plan is null || (string.IsNullOrWhiteSpace(_plan.SpecLink) && string.IsNullOrWhiteSpace(_plan.InputSource))
            ? null
            : PlanSpecificationReferenceResolver.Resolve(_plan, SpecificationState);

    private static string SpecificationReferenceSummary(PlanSpecificationReferenceResolution reference) => reference.Status switch
    {
        PlanSpecificationReferenceStatus.Resolved => "Artifact reference resolved to the current Specification artifact. This does not establish traceability, coverage, review, or approval.",
        PlanSpecificationReferenceStatus.Ambiguous => reference.Detail ?? "Multiple Specification artifacts match; select the current artifact before resolving this reference.",
        PlanSpecificationReferenceStatus.Missing => reference.Detail ?? "No matching current Specification artifact is available.",
        _ => reference.Detail ?? "Named in the plan; not resolved to the current Specification artifact.",
    };

    private string DependencySources => _plan is null ? "" :
        string.Join(", ", _plan.Dependencies.Select(d => d.DeclaredIn ?? "Plan").Distinct());

    /// <summary>The source specification once: the linked file, with the plan's input path beneath it when that adds a path.</summary>
    private (string Label, string Value, string? Detail)? Provenance
    {
        get
        {
            if (_plan is null) return null;
            var spec = _plan.SpecLink?.Trim();
            var input = _plan.InputSource?.Trim();
            var path = string.IsNullOrEmpty(input) ? null
                : System.Text.RegularExpressions.Regex.Match(input, @"[`'""]?([\w.\-]+(?:[/\\][\w.\-]+)+)[`'""]?") is { Success: true } m ? m.Groups[1].Value : null;
            if (!string.IsNullOrEmpty(spec))
                return ("Source specification", spec,
                    path is not null && !string.Equals(path, spec, StringComparison.OrdinalIgnoreCase) ? path
                    : path is null && !string.IsNullOrEmpty(input) ? input : null);
            if (!string.IsNullOrEmpty(input)) return ("Plan input", input, null);
            return null;
        }
    }

    private static string SeverityLabel(RiskSeverity severity) => severity == RiskSeverity.Unrated ? "Severity not stated" : severity.ToString();

    private static string SeverityGroupLabel(RiskSeverity severity) => severity == RiskSeverity.Unrated ? "Severity not stated" : $"{severity} Risk";
    // Several source headings mapping to one phase key is allowed; surface it neutrally.
    private IEnumerable<IGrouping<string, PlanImplementationPhase>> SharedPhaseKeys =>
        _plan is null ? [] : _plan.Phases.GroupBy(p => p.PhaseKey, StringComparer.Ordinal).Where(g => g.Count() > 1);

    private static string PhaseNodeLabel(PlanImplementationPhase phase) => phase.IdentityKind switch
    {
        PlanPhaseIdentityKind.Labelled when phase.PhaseLabel is { } label => label[(label.LastIndexOf(' ') + 1)..],
        _ when phase.PhaseNumber == 0 => "Pre",
        _ when phase.PhaseNumber == 99 => "Post",
        _ when phase.PhaseNumber is int n => $"P{n}",
        _ => "–",
    };

    private string PhasesBadge       => _plan?.Phases.Count > 0 ? $"({_plan.Phases.Count})" : string.Empty;
    /// <summary>The plan has a testing approach. Not a check result: nothing is tested here.</summary>
    private string TestingBadge      => _plan?.TestingInfo is not null ? "(in plan)" : string.Empty;
    private string ConstitutionBadge
    {
        get
        {
            if (_plan is null) return string.Empty;
            var total = _plan.Gates.Count + _plan.ConstitutionCheckItems.Count;
            return total > 0 ? $"({total})" : string.Empty;
        }
    }

    protected override void OnParametersSet()
    {
        if (ParsedPlan is not null)
        {
            _plan = ParsedPlan;
            _expanded = [];
            _search = string.Empty;
            _riskFilter = null;
            _complexityFilter = null;
            _checkFilter = null;
            _gateFilter = null;
        }
        else if (!string.IsNullOrWhiteSpace(PlanText) && _plan is null)
        {
            _localText = PlanText;
            var service = new PlanAnalysisService();
            _plan = service.Parse(PlanText);
            _expanded = [];
            _search = string.Empty;
            _riskFilter = null;
            _complexityFilter = null;
            _checkFilter = null;
            _gateFilter = null;
        }

        if (InitialView is not null && _plan is not null)
            _tab = InitialView;
    }

    private async Task BuildPlanAsync()
    {
        if (string.IsNullOrWhiteSpace(_localText)) return;
        await OnTextChanged.InvokeAsync(_localText);
    }


    private void ClearInput() { _localText = string.Empty; _importRef?.Reset(); }
    private void SetTab(string tab) { _tab = tab; _search = string.Empty; }
    private void HandleSearch(ChangeEventArgs e) => _search = e.Value?.ToString() ?? string.Empty;
    private void ClearSearch() => _search = string.Empty;
    private void Toggle(string id) { if (!_expanded.Add(id)) _expanded.Remove(id); }
    private void SetRiskFilter(RiskSeverity? v) { _riskFilter = v; _search = string.Empty; }
    private void SetComplexityFilter(ComplexityLevel? v) { _complexityFilter = v; _search = string.Empty; }
    private void SetCheckFilter(ConstitutionCheckStatus? v) { _checkFilter = v; _search = string.Empty; }
    private void SetGateFilter(PlanGateStatus? v) { _gateFilter = v; _search = string.Empty; }
    private void OnFileImported(string t) => _localText = t;
    private void OnFileRemoved() => _localText = string.Empty;

    private static string StatusCssClass(string? status)
    {
        if (status is null) return "unknown";
        var s = status.ToLowerInvariant();
        if (s.Contains("draft") || s.Contains("progress") || s.Contains("wip")) return "draft";
        if (s.Contains("complete") || s.Contains("done") || s.Contains("approved")) return "complete";
        if (s.Contains("review")) return "review";
        return "other";
    }

