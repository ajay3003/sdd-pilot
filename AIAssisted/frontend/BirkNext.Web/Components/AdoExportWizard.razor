@using BirkNext.TestPlanning
@using BirkNext.Web.Services
@inject IServiceProvider ServiceProvider
@inject IJSRuntime JS

@* «Eksporter til fil» (offline, the default method of Overfør testplan): select saved test cases → the fields Azure DevOps needs → check → preview →
   download an Azure Test Plans import file (Excel by default, CSV as alternative) and a mapping report. Tester-facing text in Norwegian (2026-11-25).
   Nothing is sent to Azure DevOps; destination values are checked for form only. The history of files and transfers is shown by the panel.
   Simplified (2026-11-25): System Settings owns the field defaults; here they are a one-line summary with «Endre felter for denne eksporten»
   (closed), the check is a compact «Klar for eksport» / «N ting må rettes» with blocking problems always visible and the details in
   «Kontroller før overføring» (closed), and the import guide is behind «Vis importveiledning» (closed). *@

<section class="adx" data-testid="adx" aria-label="Eksporter til fil" aria-busy="@(_busy || _working ? "true" : "false")">
    @if (_api is null)
    {
        <p class="adx-muted" data-testid="adx-unavailable">Eksport til Azure DevOps er ikke tilgjengelig her.</p>
    }
    else
    {
        @if (Dirty) { <p class="adx-alert" role="alert" data-testid="adx-dirty">Testplanen har endringer som ikke er lagret. Eksporten bruker den lagrede testplanen — lagre først for å ta dem med.</p> }
        @if (_error is not null) { <p class="adx-alert" role="alert" data-testid="adx-error">@_error <button type="button" class="adx-btn adx-btn-quiet" @onclick="PreviewAsync" data-testid="adx-retry">Prøv igjen</button></p> }

        @* 1 · Select test cases *@
        <fieldset class="adx-step" data-testid="adx-select">
            <legend class="adx-legend"><span class="adx-n">1</span> Velg testtilfeller</legend>
            @if (_preview is { } pv)
            {
                <p class="adx-counts" data-testid="adx-counts" role="status">
                    <span>@pv.TotalCases i testplanen</span> · <span data-testid="adx-selected">@pv.SelectedCases valgt</span> · <span data-testid="adx-ready">@pv.ReadyCases klare</span>
                    @if (pv.CasesNeedingAttention > 0) { <span> · </span><span class="adx-bad" data-testid="adx-attention">@pv.CasesNeedingAttention må rettes</span> }
                </p>
            }
            <label class="adx-check"><input type="checkbox" checked="@_includeNotApproved" @onchange="e => Set(() => _includeNotApproved = e.Value is true)" data-testid="adx-include-unapproved" /> Ta med testtilfeller som ikke er godkjent ennå</label>
            @if (_includeNotApproved) { <p class="adx-muted adx-small" data-testid="adx-unapproved-note">Testtilfeller som ikke er godkjent, eksporteres som utkast. Gjennomgangsstatusen står i koblingsrapporten, og en import godkjenner ingenting.</p> }
            @{ var exportLanguages = Draft.Cases.SelectMany(c => c.TranslatedLanguages).Distinct(StringComparer.OrdinalIgnoreCase).ToList(); }
            @if (exportLanguages.Count > 0 || _language is not null)
            {
                <label class="adx-field" data-testid="adx-language-field"><span>Språk i filen</span>
                    <select @onchange="e => Set(() => _language = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString())" data-testid="adx-language">
                        <option value="" selected="@(_language is null)">Originalspråk</option>
                        @foreach (var l in exportLanguages) { <option value="@l" selected="@(_language == l)">@TranslationLanguages.Name(l) (testtilfeller med fullstendig tekst på @TranslationLanguages.Name(l))</option> }
                    </select></label>
            }
            else { <p class="adx-muted adx-small" data-testid="adx-language-none">Eksporteres på originalspråket: ingen testtilfeller i testplanen er oversatt ennå (Planlegg og klargjør → språkikonet på et scenario).</p> }
            @if (_language is { } chosen && _preview is { } lp) { <p class="adx-muted adx-small" data-testid="adx-language-summary">@lp.Cases.Count(c => c.Included && c.Language == chosen) på @TranslationLanguages.Name(chosen) · @lp.Cases.Count(c => c.Included && c.Language != chosen) på originalspråket (uten fullstendig tekst på @TranslationLanguages.Name(chosen)). Hvert testtilfelle er på ett språk.</p> }
            <div class="adx-bar">
                <button type="button" class="adx-btn adx-btn-quiet" @onclick="() => Set(() => _selected.Clear())" data-testid="adx-select-eligible">Velg alle som kan eksporteres</button>
                <button type="button" class="adx-btn adx-btn-quiet" @onclick="SelectNone" data-testid="adx-select-none">Velg ingen</button>
            </div>
            <ul class="adx-cases" aria-label="Testtilfeller">
                @foreach (var c in _preview?.Cases ?? [])
                {
                    var blocked = c.Issues.Any(i => i.Level == AdoIssueLevel.Blocking);
                    var state = c.ExcludedReason is not null ? "excluded" : blocked ? "attention" : "ready";
                    var id = c.CaseId;
                    <li class="adx-case" data-testid="adx-case" data-case="@id" data-state="@state">
                        <label class="adx-check"><input type="checkbox" checked="@(IsChecked(c))" disabled="@(c.Review is "Excluded" or "Superseded")" aria-label="@($"Eksporter {c.Title}")"
                                @onchange="e => Toggle(id, e.Value is true)" data-testid="adx-case-select" />
                            <span class="adx-case-title">@(c.Title.Length > 0 ? c.Title : "(uten tittel)")</span></label>
                        <span class="adx-chip">@c.Review</span>
                        <span class="adx-chip">@c.Steps steg</span>
                        @if (c.ScenarioTitle is { } scenarioTitle) { <span class="adx-muted adx-small" data-testid="adx-case-scenario">Scenario: @scenarioTitle</span> }
                        @if (_language is not null) { <span class="adx-chip" data-testid="adx-case-language">@(c.Language == AdoExportCase.OriginalLanguage ? "Original" : TranslationLanguages.Name(c.Language))</span> }
                        <span class="adx-muted adx-small" data-testid="adx-case-ado">@(c.AzureDevOpsId is { } adoId ? $"Azure DevOps-id {adoId}" : "Nytt i Azure DevOps (uten id)")</span>
                        <span class="adx-chip adx-chip-@state" data-testid="adx-case-state">@(state switch { "ready" => "Klar", "attention" => "Må rettes", _ => "Eksporteres ikke" })</span>
                        @if (c.ExcludedReason is { } why) { <span class="adx-muted adx-small" data-testid="adx-case-why">@why</span> }
                        @if (blocked) { <a class="adx-small" href="@($"test-plan-suggestions?draft={Draft.Id}&area=prepare&case={Uri.EscapeDataString(id)}")" data-testid="adx-case-open">Åpne testtilfellet</a> }
                    </li>
                }
            </ul>
        </fieldset>

        @* 2 · Configure Azure DevOps *@
        <fieldset class="adx-step" data-testid="adx-configure">
            <legend class="adx-legend"><span class="adx-n">2</span> Felter i Azure DevOps</legend>
            <p class="adx-muted adx-small" data-testid="adx-fields-summary">@FieldsSummary
                · <a href="admin/system-settings?section=azure-devops-test-plans" data-testid="adx-settings-link">Standardverdier i Systeminnstillinger</a></p>
            <details class="adx-advanced" data-testid="adx-fields-edit" open="@(_mode == AdoExportMode.UpdateExisting || Unsaved || FieldsNeedFix)">
            <summary>Endre felter for denne eksporten</summary>
            <div class="adx-grid">
                <label class="adx-field"><span>Azure DevOps-versjon</span>
                    <select @onchange="e => Set(() => _profile = _profile with { Target = Enum.Parse<AdoTarget>(e.Value!.ToString()!) })" data-testid="adx-target">
                        <option value="Services" selected="@(_profile.Target == AdoTarget.Services)">Azure DevOps Services</option>
                        <option value="Server" selected="@(_profile.Target == AdoTarget.Server)">Azure DevOps Server 2022 eller nyere</option>
                    </select></label>
                <label class="adx-field"><span>Area Path @(_profile.Target == AdoTarget.Services ? "(må fylles ut)" : "(valgfritt)")</span>
                    <input value="@_profile.AreaPath" placeholder="Project\Area" maxlength="4000" @onchange="e => Set(() => _profile = _profile with { AreaPath = e.Value?.ToString() })" data-testid="adx-area" /></label>
                <label class="adx-field"><span>Assigned To (valgfritt)</span>
                    <input value="@_profile.AssignedTo" placeholder="navn@organisasjon.no" maxlength="256" @onchange="e => Set(() => _profile = _profile with { AssignedTo = e.Value?.ToString() })" data-testid="adx-assigned" /></label>
                <label class="adx-field"><span>Startstatus (State)</span>
                    <input value="@_profile.State" maxlength="128" @onchange="e => Set(() => _profile = _profile with { State = e.Value?.ToString() ?? string.Empty })" data-testid="adx-state" /></label>
                <label class="adx-field"><span>Forutsetninger</span>
                    <select @onchange="e => Set(() => _profile = _profile with { Preconditions = Enum.Parse<AdoPreconditionsMode>(e.Value!.ToString()!) })" data-testid="adx-preconditions">
                        <option value="MappingReport" selected="@(_profile.Preconditions == AdoPreconditionsMode.MappingReport)">List dem i koblingsrapporten</option>
                        <option value="FirstStep" selected="@(_profile.Preconditions == AdoPreconditionsMode.FirstStep)">Legg dem inn som første steg</option>
                    </select></label>
            </div>
            <fieldset class="adx-inline" data-testid="adx-format">
                <legend>Filformat</legend>
                <label class="adx-check"><input type="radio" name="adx-format" checked="@(_profile.Format == AdoExportFormat.Xlsx)" @onchange="() => Set(() => _profile = _profile with { Format = AdoExportFormat.Xlsx })" data-testid="adx-format-xlsx" /> Excel (.xlsx) — anbefalt</label>
                <label class="adx-check"><input type="radio" name="adx-format" checked="@(_profile.Format == AdoExportFormat.Csv)" @onchange="() => Set(() => _profile = _profile with { Format = AdoExportFormat.Csv })" data-testid="adx-format-csv" /> CSV</label>
            </fieldset>
            <label class="adx-check"><input type="checkbox" checked="@_profile.IncludePriority" @onchange="e => Set(() => _profile = _profile with { IncludePriority = e.Value is true })" data-testid="adx-priority" /> Ta med prioritet (Kritisk/Høy/Middels/Lav → 1/2/3/4; koble kolonnen i importveiviseren)</label>
            <label class="adx-check"><input type="checkbox" checked="@_profile.IncludeSourceReferences" @onchange="e => Set(() => _profile = _profile with { IncludeSourceReferences = e.Value is true })" data-testid="adx-source-refs" /> Ta med hvor hvert testtilfelle kommer fra (spesifikasjon, akseptansescenario, krav) som Description — koble den til Description i importveiviseren</label>
            @* Rarely needed: a label for your own records, updating test cases that already exist in Azure DevOps, CSV formula protection. *@
            <details class="adx-advanced" data-testid="adx-advanced" open="@(_mode == AdoExportMode.UpdateExisting)">
            <summary>Avansert</summary>
            <label class="adx-field"><span>Mål (merkelapp for egen oversikt)</span>
                <input value="@_profile.DestinationLabel" placeholder="For eksempel organisasjon / prosjekt" maxlength="300" @onchange="e => Set(() => _profile = _profile with { DestinationLabel = e.Value?.ToString() })" data-testid="adx-destination" /></label>
            @if (_profile.Format == AdoExportFormat.Csv)
            {
                <label class="adx-check"><input type="checkbox" checked="@_profile.CsvSpreadsheetSafe" @onchange="e => Set(() => _profile = _profile with { CsvSpreadsheetSafe = e.Value is true })" data-testid="adx-csv-safe" /> Beskytt celler som starter med = + - @@ når CSV-filen åpnes i et regneark</label>
            }
            <fieldset class="adx-inline" data-testid="adx-mode">
                <legend>Opprett eller oppdater</legend>
                <label class="adx-check"><input type="radio" name="adx-mode" checked="@(_mode == AdoExportMode.CreateNew)" @onchange="() => Set(() => _mode = AdoExportMode.CreateNew)" data-testid="adx-mode-create" /> Opprett nye testtilfeller (anbefalt)</label>
                <label class="adx-check"><input type="radio" name="adx-mode" checked="@(_mode == AdoExportMode.UpdateExisting)" @onchange="() => Set(() => _mode = AdoExportMode.UpdateExisting)" data-testid="adx-mode-update" /> Oppdater eksisterende testtilfeller i Azure DevOps</label>
            </fieldset>
            @if (_mode == AdoExportMode.UpdateExisting)
            {
                <div class="adx-update" data-testid="adx-update">
                    <p class="adx-alert">En import som oppdaterer, erstatter ALLE steg i hvert testtilfelle i Azure DevOps med stegene i filen. Skriv inn id-en fra Azure DevOps for hvert testtilfelle én gang — BirkNext gjetter den aldri, og husker id-er du bekrefter her til neste eksport.</p>
                    @foreach (var c in (_preview?.Cases ?? []).Where(c => c.ExcludedReason is null))
                    {
                        var id = c.CaseId;
                        var remembered = _profile.KnownTestCaseIds.GetValueOrDefault(c.CaseKey);
                        var typed = _existing.TryGetValue(id, out var t) && t.Length > 0 ? t : null;
                        <label class="adx-field"><span>@c.Title</span><input inputmode="numeric" value="@(typed ?? remembered)" @onchange="e => Set(() => _existing[id] = e.Value?.ToString() ?? string.Empty)" data-testid="adx-existing-id" />
                            @if (typed is null && remembered is not null) { <span class="adx-muted" data-testid="adx-existing-id-remembered">Husket fra en tidligere eksport — endre den hvis testtilfellet er flyttet.</span> }</label>
                    }
                    <label class="adx-check"><input type="checkbox" checked="@_confirmed" @onchange="e => Set(() => _confirmed = e.Value is true)" data-testid="adx-confirm-ids" /> Jeg har kontrollert disse id-ene i Azure DevOps, og stegene deres kan erstattes.</label>
                </div>
            }
            </details>
            @if (Unsaved)
            {
                <p class="adx-muted adx-small" role="status" data-testid="adx-settings-unsaved">@(_restored
                    ? "Disse verdiene er tatt vare på fra før siden ble lastet på nytt. De gjelder bare denne eksporten i denne fanen."
                    : "Disse verdiene gjelder bare denne eksporten (fanen husker dem ved ny innlasting). Standardverdiene endres i Systeminnstillinger.")</p>
            }
            </details>
        </fieldset>

        @* 3 · Validate *@
        <fieldset class="adx-step" data-testid="adx-validate">
            <legend class="adx-legend"><span class="adx-n">3</span> Kontroll</legend>
            @if (_preview is { } p)
            {
                var blocking = p.Issues.Where(i => i.Level == AdoIssueLevel.Blocking).ToList();
                var notes = p.Issues.Count(i => i.Level != AdoIssueLevel.Blocking);
                @if (p.CanDownload)
                {
                    <p class="adx-ok" role="status" data-testid="adx-can-download"><strong>Klar for eksport.</strong> @p.ReadyCases testtilfelle@(p.ReadyCases == 1 ? "" : "r") (@p.Rows.Count rader).</p>
                }
                else
                {
                    <p class="adx-bad" role="status" data-testid="adx-must-fix"><strong>@Math.Max(blocking.Count, 1) ting må rettes</strong> før filen kan lastes ned.</p>
                }
                @if (blocking.Count > 0)
                {
                    <div class="adx-issues adx-issues-Blocking" data-testid="adx-issues-blocking">
                        <h3 class="adx-h3">Må rettes før nedlasting (@blocking.Count)</h3>
                        <ul>
                            @foreach (var i in blocking)
                            {
                                var caseTitle = i.CaseId is { } cid ? p.Cases.FirstOrDefault(c => c.CaseId == cid)?.Title : null;
                                <li data-testid="adx-issue">@(caseTitle is not null ? $"{caseTitle}: " : "")@i.Message
                                    @if (i.CaseId is { } ic) { <a href="@($"test-plan-suggestions?draft={Draft.Id}&area=prepare&case={Uri.EscapeDataString(ic)}")">Åpne</a> }</li>
                            }
                        </ul>
                    </div>
                }
                <details class="adx-advanced" data-testid="adx-check-details">
                <summary>Kontroller før overføring (@p.Fields.Count felt@(notes > 0 ? $", {notes} merknad{(notes == 1 ? "" : "er")}" : ""))</summary>
                <table class="adx-table" data-testid="adx-fields">
                    <thead><tr><th scope="col">Felt</th><th scope="col">Verdi</th><th scope="col">Kontroll</th></tr></thead>
                    <tbody>
                        @foreach (var f in p.Fields)
                        {
                            <tr data-testid="adx-field" data-field="@f.Field" data-check="@f.Check">
                                <th scope="row">@f.Field</th><td>@(f.Value ?? "—")</td>
                                <td><span class="adx-chip adx-check-@f.Check">@CheckLabel(f.Check)</span> <span class="adx-muted adx-small">@f.Explanation</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
                @foreach (var (level, title) in new[] { (AdoIssueLevel.Warning, "Advarsler"), (AdoIssueLevel.Info, "Greit å vite") })
                {
                    var list = p.Issues.Where(i => i.Level == level).ToList();
                    if (list.Count == 0) continue;
                    <div class="adx-issues adx-issues-@level" data-testid="@($"adx-issues-{level.ToString().ToLowerInvariant()}")">
                        <h3 class="adx-h3">@title (@list.Count)</h3>
                        <ul>
                            @foreach (var i in list)
                            {
                                var title2 = i.CaseId is { } cid ? p.Cases.FirstOrDefault(c => c.CaseId == cid)?.Title : null;
                                <li data-testid="adx-issue">@(title2 is not null ? $"{title2}: " : "")@i.Message
                                    @if (i.CaseId is { } ic) { <a href="@($"test-plan-suggestions?draft={Draft.Id}&area=prepare&case={Uri.EscapeDataString(ic)}")">Åpne</a> }</li>
                            }
                        </ul>
                    </div>
                }
                </details>
            }
            else if (_busy) { <p class="adx-muted" role="status">Kontrollerer …</p> }
        </fieldset>

        @* 4 · Preview and download *@
        <fieldset class="adx-step" data-testid="adx-download">
            <legend class="adx-legend"><span class="adx-n">4</span> Forhåndsvis og last ned</legend>
            @if (_preview is { Rows.Count: > 0 } pr)
            {
                <details class="adx-preview" data-testid="adx-preview">
                    <summary>Forhåndsvis filen (@pr.Rows.Count rader, kolonner: @string.Join(", ", pr.Headers))</summary>
                    <div class="adx-preview-scroll">
                        <table class="adx-table adx-rows">
                            <thead><tr><th scope="col">Tittel</th><th scope="col">Steg</th><th scope="col">Handling</th><th scope="col">Forventet</th></tr></thead>
                            <tbody>
                                @foreach (var r in pr.Rows.Take(200))
                                {
                                    <tr data-testid="adx-row"><td>@(r.TestStep == 1 ? r.Title : "")</td><td>@r.TestStep</td><td class="adx-pre">@r.StepAction</td><td class="adx-pre">@r.StepExpected</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            }
            <div class="adx-bar">
                <button type="button" class="adx-btn" disabled="@(_working || _preview is not { CanDownload: true })" @onclick="() => DownloadAsync(AdoExportFormat.Xlsx)" data-testid="adx-download-xlsx">Last ned Excel (.xlsx)</button>
                <button type="button" class="adx-btn adx-btn-quiet" disabled="@(_working || _preview is not { CanDownload: true })" @onclick="() => DownloadAsync(AdoExportFormat.Csv)" data-testid="adx-download-csv">Last ned CSV</button>
                <button type="button" class="adx-btn adx-btn-quiet" disabled="@(_working || _preview is null)" @onclick="ReportAsync" data-testid="adx-download-report">Last ned koblingsrapport</button>
            </div>
            @if (_downloaded is not null) { <p class="adx-ok" role="status" data-testid="adx-downloaded">@_downloaded</p> }
            <details class="adx-advanced" data-testid="adx-howto-details">
            <summary>Vis importveiledning</summary>
            <p class="adx-muted" data-testid="adx-format-note">Filen er i formatet til <strong>Azure Test Plans → Import test cases</strong> (Microsoft: «Bulk import or export test cases»): én rad per steg med handling og forventet resultat. Den importeres i en testgruppe som finnes fra før — filen oppretter ikke testplanen eller testgruppen.</p>
            <ol class="adx-howto" data-testid="adx-howto">
                <li>Åpne <strong>Test Plans</strong> i Azure DevOps, og velg testplanen og deretter testgruppen. Finnes de ikke, oppretter du dem først (eller i Systeminnstillinger → Azure DevOps – Test Plans).</li>
                <li>Velg <strong>Import test cases from CSV/XLSX</strong> og velg filen du lastet ned.</li>
                <li>Azure DevOps viser hvordan kolonnene kobles til feltene. Kontroller dem (koble Priority og Description hvis du tok dem med) og velg <strong>Import</strong>.</li>
                <li>Koble kravene i koblingsrapporten til testtilfellene i Azure DevOps — filen lager ikke slike koblinger.</li>
            </ol>
            <p class="adx-muted adx-small" data-testid="adx-boundary">BirkNext lager bare filen. Å laste ned er ikke å importere, og BirkNext kan ikke kontrollere at Area Path, bruker eller status finnes i organisasjonen deres.</p>
            </details>
        </fieldset>
    }
</section>

@code {
    /// <summary>The saved plan (its id and revision are what the file is built from).</summary>
    [Parameter, EditorRequired] public TestPlanDraft Draft { get; set; } = new();
    [Parameter, EditorRequired] public string ProjectKey { get; set; } = "";
    [Parameter] public bool CanWrite { get; set; }
    /// <summary>The page has unsaved plan edits (the export uses the saved plan).</summary>
    [Parameter] public bool Dirty { get; set; }
    /// <summary>A file was created (the panel reloads «Tidligere overføringer»).</summary>
    [Parameter] public EventCallback OnExported { get; set; }

    private IAdoExportApiService? _api;
    private AdoExportProfile _profile = new();
    // The project's saved export settings; _profile differs from it while the tester has changed a field without saving (kept for this tab only).
    private AdoExportProfile _saved = new();
    private bool _restored;
    private AdoExportPreview? _preview;
    // Explicit selection; empty = every eligible case.
    private readonly HashSet<string> _selected = new(StringComparer.Ordinal);
    private bool _noneSelected;
    private bool _includeNotApproved;
    private string? _language;
    private AdoExportMode _mode = AdoExportMode.CreateNew;
    private readonly Dictionary<string, string> _existing = new(StringComparer.Ordinal);
    private bool _confirmed;
    // _busy: a re-check (preview) is running — shown as aria-busy, never disables a button, so a click right after editing a field is not lost
    // (the field's change fires on that click and starts a re-check). _working: a save or download of its own is running.
    private bool _busy;
    private bool _working;
    private Task? _pendingPreview;
    private string? _error;
    private string? _downloaded;
    private (Guid, int)? _loadedFor;

    protected override async Task OnParametersSetAsync()
    {
        _api ??= ServiceProvider.GetService(typeof(IAdoExportApiService)) as IAdoExportApiService;
        if (_api is null || _loadedFor == (Draft.Id, Draft.Revision)) return;
        var first = _loadedFor is null;
        _loadedFor = (Draft.Id, Draft.Revision);
        if (first)
        {
            var (profile, _) = await _api.ProfileAsync(ProjectKey);
            if (profile is not null) _profile = _saved = profile;
            // Field values changed in this tab but not saved for the project survive a reload; remembered Azure DevOps ids always come from the project.
            if (await TabDraftStore.ReadAsync<AdoExportProfile>(JS, TabDraftStore.ExportSettingsKey(ProjectKey)) is { } kept)
            {
                _profile = kept with { KnownTestCaseIds = _saved.KnownTestCaseIds };
                _restored = Unsaved;
                if (!_restored) await TabDraftStore.RemoveAsync(JS, TabDraftStore.ExportSettingsKey(ProjectKey));
            }
        }
        await PreviewAsync();
    }

    private AdoExportRequest Request(AdoExportFormat? format = null) => new()
    {
        ProjectKey = ProjectKey, DraftId = Draft.Id, PlanRevision = Draft.Revision,
        CaseIds = _noneSelected ? ["\u0000none"] : [.. _selected], IncludeNotApproved = _includeNotApproved, Mode = _mode, Language = _language,
        ExistingIds = _existing.Where(e => !string.IsNullOrWhiteSpace(e.Value)).ToDictionary(e => e.Key, e => e.Value.Trim(), StringComparer.Ordinal), ExistingIdsConfirmed = _confirmed,
        Profile = format is { } f ? _profile with { Format = f } : _profile,
    };

    private bool IsChecked(AdoExportCase c) => c.ExcludedReason is null || (_selected.Count > 0 && _selected.Contains(c.CaseId));

    private bool Unsaved => (_profile with { KnownTestCaseIds = _saved.KnownTestCaseIds }) != _saved;

    private async Task Set(Action change)
    {
        var before = _profile;
        change(); _downloaded = null;
        if (_profile != before) await KeepSettingsAsync();
        await PreviewAsync();
    }

    private async Task KeepSettingsAsync()
    {
        _restored = false;
        if (Unsaved) await TabDraftStore.WriteAsync(JS, TabDraftStore.ExportSettingsKey(ProjectKey), _profile);
        else await TabDraftStore.RemoveAsync(JS, TabDraftStore.ExportSettingsKey(ProjectKey));
    }

    private async Task SelectNone() { _selected.Clear(); _noneSelected = true; _downloaded = null; await PreviewAsync(); }

    /// <summary>Checking a case makes the selection explicit (starting from what is shown as selected); unchecking removes it.</summary>
    private async Task Toggle(string id, bool on)
    {
        if (_selected.Count == 0 && !_noneSelected && _preview is not null)
            foreach (var c in _preview.Cases.Where(c => c.ExcludedReason is null)) _selected.Add(c.CaseId);
        _noneSelected = false;
        if (on) _selected.Add(id); else _selected.Remove(id);
        if (_selected.Count == 0) _noneSelected = true;
        if (on && Draft.Cases.FirstOrDefault(c => c.Source.ScenarioId == id) is { Review: not TestCaseReviewState.Accepted }) _includeNotApproved = true;
        _downloaded = null;
        await PreviewAsync();
    }

    private Task PreviewAsync() => _pendingPreview = CheckAsync();

    // Each check is numbered; only the newest one's answer is shown (found 2026-11-25 in the browser: ticking «Ta med … ikke godkjent» and then typing
    // the Area Path started two checks, the older answer arrived last and the page showed «Area Path mangler» with the path filled in).
    private int _checkNumber;

    private async Task CheckAsync()
    {
        if (_api is null) return;
        var number = ++_checkNumber;
        _busy = true; _error = null;
        var (preview, error) = await _api.PreviewAsync(Request());
        if (number != _checkNumber) return; // a newer check is running: its answer is the one that counts
        _busy = false;
        if (preview is null) { _error = error ?? "Eksporten kunne ikke kontrolleres."; return; }
        _preview = preview;
    }

    /// <summary>Lets a re-check started by the same click finish first, so a file or saved settings always match what the page shows.</summary>
    private async Task SettledAsync()
    {
        if (_pendingPreview is { IsCompleted: false } pending) await pending;
    }

    private async Task DownloadAsync(AdoExportFormat format)
    {
        _working = true; _error = null; _downloaded = null;
        await SettledAsync();
        if (_preview is not { CanDownload: true }) { _working = false; _error = "Eksporten må rettes før nedlasting — se Kontroll."; return; }
        var (file, error) = await _api!.FileAsync(Request(format));
        _working = false;
        if (file is null) { _error = error ?? "Filen kunne ikke lages."; return; }
        await JS.InvokeVoidAsync("downloadBase64File", file.FileName, file.Base64, file.ContentType);
        _downloaded = $"{file.FileName} er lastet ned: {file.Cases} testtilfelle{(file.Cases == 1 ? "" : "r")}, {file.Rows} rader. Importer den i Azure DevOps (se under). Ingenting er endret i Azure DevOps.";
        await OnExported.InvokeAsync();
    }

    private async Task ReportAsync()
    {
        _working = true; _error = null;
        await SettledAsync();
        var (file, error) = await _api!.ReportAsync(Request());
        _working = false;
        if (file is null) { _error = error ?? "Koblingsrapporten kunne ikke lages."; return; }
        await JS.InvokeVoidAsync("downloadBase64File", file.FileName, file.Base64, file.ContentType);
        _downloaded = $"{file.FileName} er lastet ned.";
    }

    /// <summary>The effective field values in one line (the defaults come from System Settings → Azure DevOps – Test Plans → Field defaults).</summary>
    private string FieldsSummary =>
        $"Area Path: {(string.IsNullOrWhiteSpace(_profile.AreaPath) ? "ikke satt" : _profile.AreaPath)} · Status: {(string.IsNullOrWhiteSpace(_profile.State) ? "ikke satt" : _profile.State)}"
        + (string.IsNullOrWhiteSpace(_profile.AssignedTo) ? "" : $" · Tildelt: {_profile.AssignedTo}")
        + (_profile.Format == AdoExportFormat.Xlsx ? " · Excel" : " · CSV")
        + (_profile.Target == AdoTarget.Server ? " · Azure DevOps Server" : "")
        + (Unsaved ? " (endret for denne eksporten)" : "");

    /// <summary>A required field is missing or invalid: the field editor opens so it can be fixed here.</summary>
    private bool FieldsNeedFix => _preview?.Fields.Any(f => f.Check is AdoFieldCheck.Invalid or AdoFieldCheck.Missing) == true;

    private static string CheckLabel(AdoFieldCheck check) => check switch
    {
        AdoFieldCheck.LocallyValid => "Gyldig", AdoFieldCheck.NeedsConfirmationInAzureDevOps => "Bekreft i Azure DevOps", AdoFieldCheck.Invalid => "Ugyldig",
        AdoFieldCheck.Missing => "Mangler", _ => "Ikke påkrevd",
    };
}
