    private RenderFragment GraphQlEditor(TestDataResourceValidation v) => __builder =>
    {
        @OperationPicker("Operation")
        if (Operation is { } op)
        {
            <p class="tdx-help" data-testid="tdx-variable-defs">Variables: @(op.Operation.ParameterDetails.Count > 0 ? string.Join(", ", op.Operation.ParameterDetails.Select(p => $"{p.Name.TrimStart('$')}: {p.Type}")) : string.Join(", ", op.Operation.Parameters) + " (names only; types not recorded)")</p>
            <button type="button" class="btn-secondary" data-testid="tdx-template" @onclick="() => _json = Template(op)">Insert synthetic template</button>
        }
        @JsonEditor(v, "variables")
    };

    /// <summary>A synthetic variables template from the declared types (never real values): required fields only, placeholders by type.</summary>
    private static string Template(TestDataOperationOption op)
    {
        JsonNode? Value(string? type, int depth)
        {
            var t = (type ?? "").Trim().TrimEnd('!');
            if (t.StartsWith('[')) return new JsonArray(Value(t.Trim('[', ']'), depth));
            if (depth > 4) return null;
            return t switch
            {
                "Int" => 0, "Float" => 0.0, "Boolean" => false, "String" or "ID" => "",
                _ when op.Types.FirstOrDefault(x => x.Name == t) is { } shape => shape.Kind == "enum" ? shape.Values.FirstOrDefault() ?? ""
                    : new JsonObject(shape.Fields.Where(f => f.Required || (f.Type ?? "").EndsWith('!')).Select(f => KeyValuePair.Create(f.Name, Value(f.Type, depth + 1)))),
                _ => "",
            };
        }
        var o = new JsonObject();
        foreach (var p in op.Operation.ParameterDetails) o[p.Name.TrimStart('$')] = Value(p.Type, 0);
        if (op.Operation.ParameterDetails.Count == 0) foreach (var n in op.Operation.Parameters) o[n.TrimStart('$')] = null;
        return o.ToJsonString(new JsonSerializerOptions { WriteIndented = true });
    }

    private RenderFragment RestEditor(TestDataResourceValidation v) => __builder =>
    {
        @OperationPicker("Operation (optional)")
        if (Operation is { } op)
        {
            <button type="button" class="btn-secondary" data-testid="tdx-use-operation" @onclick="() => UseOperation(op)">Use its method, path and parameters</button>
        }
        <div class="tdx-inline">
            <label class="tdx-field">Method <select class="form-control" data-testid="tdx-method" @bind="_method">@foreach (var m in TestDataResourceRules.Methods) { <option value="@m">@m</option> }</select></label>
            <label class="tdx-field tdx-grow">Path <input class="form-control tdx-mono" data-testid="tdx-path" @bind="_path" @bind:event="oninput" placeholder="/children/{id}" />@Error(v, "path")</label>
        </div>
        @GridEditor(v, rest: true)
        <label class="tdx-check"><input type="checkbox" data-testid="tdx-use-auth" @bind="_useAuth" /> Use the target's authentication (credentials are never stored in a template)</label>
        <div class="tdx-inline">
            <label class="tdx-field">Body content type <select class="form-control" data-testid="tdx-content-type" @bind="_contentType">@foreach (var t in TestDataResourceRules.ContentTypes) { <option value="@t">@t</option> }</select></label>
        </div>
        <label class="tdx-field">Body <textarea class="form-control tdx-mono" rows="6" spellcheck="false" data-testid="tdx-body" @bind="_body" @bind:event="oninput"></textarea>@Error(v, "body")</label>
    };

    private void UseOperation(TestDataOperationOption op)
    {
        var parts = op.Operation.Name.Split(' ', 2);
        if (TestDataResourceRules.Methods.Contains(parts[0])) _method = parts[0];
        _path = op.Operation.Path ?? (parts.Length > 1 ? parts[1] : _path);
        _rows.Clear();
        _rows.AddRange(op.Operation.ParameterDetails.Where(p => TestDataResourceRules.ParameterLocations.Contains(p.In)).Select(p => new Row
        {
            Name = p.Name, In = p.In, Required = p.Required, Type = TestDataOperationCompatibility.Expected(p.Type) ?? (p.Enum is { Count: > 0 } ? TestDataPrimitive.Enum : TestDataPrimitive.String),
            EnumText = string.Join(", ", p.Enum ?? []),
        }));
        if (op.Operation.RequestContentTypes.FirstOrDefault() is { } ct && TestDataResourceRules.ContentTypes.Contains(ct.Split(';')[0].Trim())) _contentType = ct.Split(';')[0].Trim();
    }

    private RenderFragment DatasetEditor(TestDataResourceValidation v) => __builder =>
    {
        <table class="tdx-grid" data-testid="tdx-members">
            <caption class="visually-hidden">Dataset members</caption>
            <thead><tr><th scope="col">Name</th><th scope="col">Source</th><th scope="col">Value or reference</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
            <tbody>
                @for (var i = 0; i < _rows.Count; i++)
                {
