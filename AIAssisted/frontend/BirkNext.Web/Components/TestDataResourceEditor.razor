        </div>
        @ErrorsUnder(v, "rows")
        <details class="tdx-csv">
            <summary>Paste rows as CSV</summary>
            <label class="tdx-field">First line: column names (an <code>id</code> column becomes the row id). Replaces the rows above.
                <textarea class="form-control tdx-mono" rows="5" data-testid="tdx-csv" @bind="_csv" @bind:event="oninput"></textarea></label>
            <button type="button" class="btn-secondary" data-testid="tdx-csv-import" @onclick="ImportCsv">Import rows</button>
            @if (_csvMessage is not null) { <p class="tdx-help" role="status" data-testid="tdx-csv-message">@_csvMessage</p> }
        </details>
    };

    private static void SetCell(DataRow row, int index, string value)
    {
        while (row.Cells.Count <= index) row.Cells.Add("");
        row.Cells[index] = value;
    }

    private void AddColumn()
    {
        _columns.Add(new() { Name = $"column{_columns.Count + 1}" });
        foreach (var r in _dataRows) r.Cells.Add("");
    }

    private void RemoveColumn(int index)
    {
        _columns.RemoveAt(index);
        foreach (var r in _dataRows.Where(r => index < r.Cells.Count)) r.Cells.RemoveAt(index);
    }

    private void AddRow()
    {
        var row = new DataRow { Id = NextRowId() };
        row.Cells.AddRange(_columns.Select(_ => ""));
        _dataRows.Add(row);
    }

    private string NextRowId()
    {
        for (var n = _dataRows.Count + 1; ; n++) { var id = $"r-{n:D3}"; if (_dataRows.All(r => r.Id != id)) return id; }
    }

    /// <summary>Replaces the rows with pasted CSV (RFC 4180 quoting). Column types are guessed from the values (integer, decimal, boolean, else text)
    /// and shown for review before saving; nothing is saved by importing.</summary>
    private void ImportCsv()
    {
        var lines = _csv.Replace("\r", "").Split('\n', StringSplitOptions.RemoveEmptyEntries).Select(CsvFields).ToList();
        if (lines.Count < 2) { _csvMessage = "Paste a header line and at least one row."; return; }
        var header = lines[0];
        var idIndex = header.FindIndex(h => h.Trim().Equals("id", StringComparison.OrdinalIgnoreCase));
        var columns = Enumerable.Range(0, header.Count).Where(i => i != idIndex).ToList();
        _columns.Clear(); _dataRows.Clear();
        foreach (var i in columns)
        {
            var values = lines.Skip(1).Select(l => i < l.Count ? l[i].Trim() : "").Where(v => v.Length > 0 && v != "null").ToList();
            var type = values.Count > 0 && values.All(v => long.TryParse(v, NumberStyles.AllowLeadingSign, CultureInfo.InvariantCulture, out _)) ? TestDataPrimitive.Int32
                : values.Count > 0 && values.All(v => decimal.TryParse(v, NumberStyles.Number, CultureInfo.InvariantCulture, out _)) ? TestDataPrimitive.Decimal
                : values.Count > 0 && values.All(v => v is "true" or "false") ? TestDataPrimitive.Boolean : TestDataPrimitive.String;
            _columns.Add(new() { Name = header[i].Trim(), Type = type });
        }
        foreach (var line in lines.Skip(1))
        {
            var row = new DataRow { Id = idIndex >= 0 && idIndex < line.Count && line[idIndex].Trim().Length > 0 ? line[idIndex].Trim() : NextRowId() };
            row.Cells.AddRange(columns.Select(i => i < line.Count ? line[i].Trim() : ""));
            _dataRows.Add(row);
        }
        _csvMessage = $"{_dataRows.Count} row(s) and {_columns.Count} column(s) imported. Check each column's type, then Validate.";
    }

    private static List<string> CsvFields(string line)
    {
        var fields = new List<string>();
        var current = new System.Text.StringBuilder();
        var quoted = false;
        for (var i = 0; i < line.Length; i++)
        {
            var ch = line[i];
            if (quoted)
            {
                if (ch == '"' && i + 1 < line.Length && line[i + 1] == '"') { current.Append('"'); i++; }
                else if (ch == '"') quoted = false;
                else current.Append(ch);
            }
            else if (ch == '"') quoted = true;
            else if (ch == ',') { fields.Add(current.ToString()); current.Clear(); }
            else current.Append(ch);
        }
        fields.Add(current.ToString());
        return fields;
    }

