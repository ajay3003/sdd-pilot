                </thead>
                <tbody>
                    @for (var r = 0; r < _dataRows.Count; r++)
                    {
                        var ri = r; var row = _dataRows[r];
                        <tr data-testid="tdx-row">
                            <td><input class="form-control" data-testid="tdx-row-id" aria-label="@($"Row {ri + 1} id")" @bind="row.Id" @bind:event="oninput" /></td>
