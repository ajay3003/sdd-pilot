            Leave a cell empty when the row has no value; type <code>null</code> for an explicit null.</p>
        <div class="tdx-rows-scroll">
            <table class="tdx-rows" data-testid="tdx-rows">
                <caption class="visually-hidden">Dataset rows</caption>
                <thead>
                    <tr>
                        <th scope="col">Row id</th>
                        @for (var c = 0; c < _columns.Count; c++)
                        {
                            var ci = c; var col = _columns[c];
                            <th scope="col" data-testid="tdx-column">
                                <input class="form-control" data-testid="tdx-col-name" aria-label="@($"Column {ci + 1} name")" @bind="col.Name" @bind:event="oninput" />
                                <select class="form-control" data-testid="tdx-col-type" aria-label="@($"Column {ci + 1} type")" @bind="col.Type">
                                    @foreach (var t in Enum.GetValues<TestDataPrimitive>().Where(t => t != TestDataPrimitive.Null)) { <option value="@t">@TestDataResourceRules.Label(t)</option> }
