
<div class="traceability-item @(Expanded ? "is-expanded" : "")">
    @if (OnActivate.HasDelegate)
    {
        <button type="button" class="traceability-item__activate @ActionClass" @onclick="Activate" aria-label="@ActivateLabel"
                aria-current="@(Current ? "true" : null)">
            @if (!string.IsNullOrWhiteSpace(ItemId)) { <span class="traceability-item__id">@ItemId</span> }
            <span class="visually-hidden">@ItemType: </span><div id="@TextId" class="traceability-item__text @(CanExpand && !Expanded ? "is-collapsed" : "")">@TextBody</div>
        </button>
    }
    else
    {
        <div class="traceability-item__content">
            @if (!string.IsNullOrWhiteSpace(ItemId)) { <span class="traceability-item__id">@ItemId</span> }
            <span class="visually-hidden">@ItemType: </span><div id="@TextId" class="traceability-item__text @(CanExpand && !Expanded ? "is-collapsed" : "")">@TextBody</div>
        </div>
    }
    @if (CanExpand)
    {
        <button type="button" class="traceability-item__toggle" aria-expanded="@(Expanded ? "true" : "false")" aria-controls="@TextId"
                aria-label="@(Expanded ? $"Show less for {ItemType} {ItemId}" : $"Show full text for {ItemType} {ItemId}")"
                @onclick="Toggle">@(Expanded ? "Show less" : "Show more")</button>
    }
</div>

@code {
    private readonly string TextId = $"traceability-text-{Guid.NewGuid():N}";
    [Parameter, EditorRequired] public string Text { get; set; } = "";
    [Parameter] public string ItemType { get; set; } = "Traceability item";
    [Parameter] public string? ItemId { get; set; }
    [Parameter] public string ActionClass { get; set; } = "";
    [Parameter] public EventCallback OnActivate { get; set; }
    /// <summary>The activate button is the selected item of its list (announced as aria-current).</summary>
    [Parameter] public bool Current { get; set; }
    [Parameter] public string? Given { get; set; }
    [Parameter] public string? When { get; set; }
    [Parameter] public string? Then { get; set; }
    /// <summary>Controlled expansion: the owner keeps the state by item identity (e.g. across filtering). Null = the component keeps it.</summary>
    [Parameter] public bool? IsExpanded { get; set; }
    [Parameter] public EventCallback<bool> IsExpandedChanged { get; set; }
    private bool _expanded;
    private bool Expanded => IsExpanded ?? _expanded;
    /// <summary>Characters shown while collapsed; the rest stays in the document (selectable, searchable) but hidden until Show more.</summary>
    private const int PreviewLength = 100;
    private bool HasStructuredScenario => Given is not null || When is not null || Then is not null;
    private string ExpansionText => HasStructuredScenario ? $"{Given} {When} {Then}" : Text;
    private bool CanExpand => ExpansionText.Length > 100;
    // Markup (not a hand-written RenderTreeBuilder) so the component's scoped CSS reaches the Given/When/Then keywords.
    private RenderFragment TextBody => __builder =>
    {
        if (HasStructuredScenario)
        {
            @ScenarioPart("Given", Given, "given")
            @* Collapsed, a long scenario shows its Given; When and Then follow on Show more. *@
            <div class="traceability-item__scenario-rest" hidden="@(CanExpand && !Expanded)">
                @ScenarioPart("When", When, "when")
                @ScenarioPart("Then", Then, "then")
            </div>
        }
        else if (CanExpand)
        {
            // A fixed preview, not a height clamp: a clamp that the text happens to fit makes "Show more" change nothing.
            var cut = PreviewCut(Text);
            @(Text[..cut])<span class="traceability-item__rest" hidden="@(!Expanded)">@(Text[cut..])</span>
        }
        else
        {
            @Text
        }
    };

    /// <summary>Where the preview ends: the last word boundary within <see cref="PreviewLength"/> characters (or exactly there).</summary>
    private static int PreviewCut(string text)
    {
        if (text.Length <= PreviewLength) return text.Length;
        var space = text.LastIndexOf(' ', PreviewLength);
        return space > PreviewLength / 2 ? space : PreviewLength;
    }

    private static RenderFragment ScenarioPart(string label, string? value, string kind) => __builder =>
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            <div class="traceability-item__scenario-part"><span class="@($"traceability-item__keyword traceability-item__{kind}")">@label</span>@(" ")<span class="traceability-item__scenario-body">@value</span></div>
        }
    };

    private string ActivateLabel => $"{ItemType}{(string.IsNullOrWhiteSpace(ItemId) ? "" : $" {ItemId}")}: {Text}";
    private Task Activate() => OnActivate.InvokeAsync();
    private async Task Toggle()
    {
        if (IsExpandedChanged.HasDelegate) await IsExpandedChanged.InvokeAsync(!Expanded);
        else _expanded = !_expanded;
    }
}
