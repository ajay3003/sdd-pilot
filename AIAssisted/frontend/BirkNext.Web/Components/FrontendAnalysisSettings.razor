@using BirkNext.ManagedEdge
@using BirkNext.LocalHttpsProxy
@implements IAsyncDisposable
@inject IServiceProvider ServiceProvider
@inject IServiceProvider ServiceProvider
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@inject IFrontendAnalysisSettingsService FaSettings
@inject ITargetEnvironmentDetectionApiService DetectionApi
@inject IJSRuntime JS

@* ── Load state ───────────────────────────────────────────────────────────── *@
@if (!FaSettings.IsLoaded)
{
    <p class="loading-state">Loading target environments…</p>
    return;
}

@* ── Notifications ────────────────────────────────────────────────────────── *@
@if (_saveSuccess is not null)
{
    <div class="notification notification-success" role="status">@_saveSuccess</div>
}
@if (_saveError is not null)
{
    <div class="notification notification-error" role="alert">@_saveError</div>
}

@* ── Active profile summary card ─────────────────────────────────────────── *@
<section class="fa-active-card" aria-labelledby="active-environment-heading">
    <h2 id="active-environment-heading" class="fa-section-heading">Active environment</h2>
    @if (EffectiveActiveProfile is { } ap)
    {
        <div class="fa-active-card-header">
            <div class="fa-active-card-left">
                <span class="fa-active-card-name">@ap.Name</span>
            </div>
        </div>
        <div class="fa-active-card-grid">
            <div class="fa-active-stat">
                <span class="fa-active-stat-label">Frontend URL</span>
                <span class="fa-active-stat-value fa-active-stat-mono">@(ap.TargetUrl ?? "—")</span>
            </div>
            <div class="fa-active-stat">
                <span class="fa-active-stat-label">Configured authentication</span>
                <span class="fa-active-stat-value">@ap.Authentication.AuthenticationType</span>
            </div>
            @{ var _apv = FaSettings.ValidateProfile(ap); }
            <div class="fa-active-stat">
                <span class="fa-active-stat-label">Configuration validation</span>
                <span class="fa-active-stat-value @(!_apv.IsValid ? "fa-stat-err" : _apv.Warnings.Count > 0 ? "fa-stat-warn" : "fa-stat-ok")">
                    @(!_apv.IsValid ? $"{_apv.Errors.Count} error(s)" : _apv.Warnings.Count > 0 ? $"{_apv.Warnings.Count} warning(s)" : "Valid")
                </span>
            </div>
        </div>
    }
    else
    {
        <p class="fa-active-bar-none" role="status">@(FaSettings.Settings.ActiveResolutionError ??
            (string.IsNullOrWhiteSpace(FaSettings.Settings.ActiveProfileId) ? "No active Target Environment" : "Active Target Environment is unavailable."))
            Select a Target Environment and choose “Set as Active”.</p>
    }
</section>

@* ── Profile list ─────────────────────────────────────────────────────────── *@
<section class="fa-environments" aria-labelledby="environments-heading">
<h2 id="environments-heading" class="fa-section-heading">Environments</h2>
<div class="fa-profiles-row">
    <div class="fa-profiles-list">
        @foreach (var p in FaSettings.Settings.Profiles)
        {
            <button class="fa-profile-chip @(p.Id == _selectedProfileId ? "fa-profile-chip-selected" : "")"
                    aria-selected="@(p.Id == _selectedProfileId ? "true" : "false")"
                    @onclick="() => SelectProfile(p.Id)">
                <span class="fa-env-dot fa-env-dot-@p.EnvironmentType.ToString().ToLowerInvariant()"></span>
                @p.Name
                @if (p.Id == EffectiveActiveProfile?.Id)
                {
                    <span class="fa-active-badge">Active</span>
                }
                @if (p.Id == _selectedProfileId)
                {
                    <span class="fa-selected-badge">Selected</span>
                }
            </button>
        }
    </div>
    <SecondaryButton OnClick="OpenCreateDialog" Class="fa-btn-create">+ Add Environment</SecondaryButton>
</div>
</section>

@* ── Profile detail ───────────────────────────────────────────────────────── *@
@if (SelectedProfile is { } profile)
{
    <div class="fa-profile-detail">

        @* ── Header ── *@
        <div class="fa-detail-header">
            <div class="fa-detail-header-left">
                <div>
                    <div class="fa-detail-kicker">Selected environment</div>
                    <h2 class="fa-detail-name">@profile.Name</h2>
                </div>
            </div>
            <div class="fa-detail-header-actions">
                @if (_isEditMode)
                {
                    @if (IsDirty)
                    {
                        <span class="fa-page-unsaved" role="status">Unsaved changes</span>
                    }
                    <SecondaryButton OnClick="CancelEdit" Disabled="@_isSaving">Cancel</SecondaryButton>
                    <PrimaryButton OnClick="SaveProfileAsync" Disabled="@(_isSaving || !IsDirty)">
                        @(_isSaving ? "Saving…" : "Save changes")
                    </PrimaryButton>
                }
                else
                {
                    <SecondaryButton OnClick="DuplicateProfileAsync">Duplicate</SecondaryButton>
                    <SecondaryButton OnClick="EnterEditMode">Edit Environment</SecondaryButton>
                    <DangerButton OnClick="@(() => _showDeleteConfirm = true)"
                                  Disabled="@(FaSettings.Settings.Profiles.Count <= 1)">Delete</DangerButton>
                }
            </div>
        </div>

        <div class="fa-selected-summary">
            <div class="fa-selected-url">
                <span class="fa-summary-label">Frontend URL</span>
                <span class="fa-summary-url">@(CurrentTargetUrl ?? "—")</span>
            </div>
            <div class="fa-detection-state" role="status">
                <span class="fa-summary-label">Detection</span>
                <strong class="fa-detection-value fa-detection-@DetectionStateCss">@DetectionStateBadge</strong>
            </div>
            <div class="fa-primary-actions" aria-busy="@_isDetecting.ToString().ToLowerInvariant()">
                @if (!_browserDetectionInProgress)
                {
                    <PrimaryButton OnClick="DetectSelectedTargetAsync" Disabled="@(_isDetecting || string.IsNullOrWhiteSpace(CurrentTargetUrl))">
                        @(_isDetecting ? "Detecting..." : CurrentDetectionState == DetectionState.Failed ? "Retry detection" : "Detect settings")
                    </PrimaryButton>
                    @if (profile.Id != EffectiveActiveProfile?.Id)
                    {
                        <SecondaryButton OnClick="SetActiveProfileAsync" Disabled="@(!CanSetActiveTarget)">Set as Active</SecondaryButton>
                    }
                    else
                    {
                        <span class="fa-active-badge">Active environment</span>
                    }
                }
            </div>

            @* ── Browser detection waiting state ── *@
            @if (_browserDetectionInProgress)
            {
                <div class="fa-browser-detection-waiting" role="status" aria-live="polite">
                    <div class="fa-browser-waiting-header">
                        <div class="fa-browser-spinner"></div>
                        <strong>Waiting for sign-in in BirkNext browser...</strong>
                    </div>
                    <div class="fa-browser-waiting-messages">
                        <p class="fa-browser-message">Complete authentication (account selection, password, MFA, MCAS) in the browser opened by BirkNext.</p>
                        <p class="fa-browser-message">BirkNext will observe your authentication flow and continue when the target application is reached.</p>
                        <p class="fa-browser-message"><small>Do not close the browser window. Use the BirkNext-opened browser, not another browser or window.</small></p>
                        @if (!string.IsNullOrWhiteSpace(_browserDetectionMessage))
                        {
                            <p class="fa-browser-message fa-browser-message-custom">@_browserDetectionMessage</p>
                        }
                    </div>
                    <div class="fa-browser-waiting-actions">
                        <SecondaryButton OnClick="CancelBrowserDetectionAsync">Cancel detection</SecondaryButton>
                    </div>
                </div>
            }

            <p class="fa-detection-help">Detect settings checks this Frontend URL and proposes configuration. Nothing is saved automatically.</p>
            @if (profile.Id != EffectiveActiveProfile?.Id && !CanSetActiveTarget)
            {
                <p id="activation-gate-reason" class="fa-activation-reason">Save a valid Target Environment with a Frontend URL before setting it active.</p>
            }
            @if (profile.Id != EffectiveActiveProfile?.Id && !DetectionReady)
            {
                <p id="detection-readiness-reason" class="fa-detection-help">@DetectionReadinessReason</p>
            }
            @if (_detectionError is not null)
            {
                <p class="fa-detection-error" role="alert">@_detectionError</p>
            }
        </div>

        @if (_detectionResult is not null && _activeTab != "auth")
        {
            <section class="fa-result fa-result-@DetectionStateCss" aria-labelledby="detection-result-heading" aria-live="polite">
                <div class="fa-result-heading">
                    <div>
                        <span class="fa-result-kicker">Detection result</span><h3 id="detection-result-heading">@DetectionStateLabel</h3>
                        @if (_detectionRestored)
                        {
                            <span class="fa-card-status" role="status" data-testid="detection-restored">@RestoredDetectionLabel</span>
                        }
                    </div>
                    <span class="fa-result-confidence">Target detection confidence: @DetectionPresentation.ConfidenceLabel(_detectionResult.Confidence)</span>
                </div>
                <p class="fa-result-message">@DetectionStateMessage</p>
                <dl class="fa-result-grid">
                    <div><dt>Reachability</dt><dd>@_detectionResult.Reachability</dd></div>
                    <div><dt>Framework</dt><dd>@DetectionPresentation.FrameworkLabel(_detectionResult.DetectedClientFramework)</dd></div>
                    <div><dt>Environment</dt><dd>@(_detectionResult.SuggestedEnvironmentType?.ToString() ?? "Not detected") <small>Proposed</small></dd></div>
                    <div><dt>Detected authentication</dt><dd>@DetectedAuthenticationLabel</dd></div>
                    @* The card heading above already states the verification requirement; repeating it as a value row
                       said the same sentence twice in one card. The Verification card below owns the next action. *@
                    <div><dt>Profile name</dt><dd>@(_detectionResult.SuggestedProfileName ?? "Not proposed") <small>Proposed</small></dd></div>
                    @if (HasUnsavedAuthenticationChanges && _editProfile is not null)
                    {
                        <div class="fa-configured-auth-draft"><dt>Configured authentication (draft)</dt><dd>@_editProfile.Authentication.AuthenticationType <small>⚠ Unsaved · saved: @profile.Authentication.AuthenticationType</small></dd></div>
                    }
                    else
                    {
                        <div><dt>Configured authentication</dt><dd>@profile.Authentication.AuthenticationType <small>Configured</small></dd></div>
                    }
                </dl>
                @if (!string.IsNullOrWhiteSpace(_detectionResult.FrameworkEvidence))
                {
                    <p class="fa-framework-evidence">Framework evidence: @_detectionResult.FrameworkEvidence · @_detectionResult.FrameworkConfidence</p>
                }

                <div class="fa-result-actions">
                    @if (CanContinueDetectionInBrowser() && !IsDetectionStale)
                    {
                        <div>
                            <PrimaryButton OnClick="StartBrowserDetectionAsync" Disabled="@_browserDetectionInProgress">Continue detection in browser</PrimaryButton>
                            <p><small>BirkNext will open a browser for interactive authentication. Complete sign-in in that browser window.</small></p>
                        </div>
                    }
                    @if (_detectionResult.SuggestedEnvironmentType is { } detectedType && profile.EnvironmentType != detectedType)
                    {
                        <SecondaryButton OnClick="ApplyDetectedEnvironmentType">Apply detected type</SecondaryButton>
                    }
                </div>
            </section>
        }

        @if (ManualVerificationRequired && _activeTab != "auth")
        {
            @* Focused on the next action: the state is stated once above, so this card leads with Status + button. *@
            <section class="fa-result fa-verification" aria-labelledby="manual-verification-heading">
                @* The Detection result card above states the requirement; here it is a compact badge beside the
                   heading so the card can lead with the action instead of repeating the sentence. *@
                <div class="fa-verification-head">
                    <h3 id="manual-verification-heading" class="fa-verification-heading">Verification</h3>
                    <span class="fa-verification-badge" role="status" data-testid="manual-verification-status">@ManualVerificationStatusLabel</span>
                </div>
                <div>
                    <details><summary>Verification details</summary>
                    <p>Your organization requires sign-in using a managed Microsoft Edge work profile. BirkNext cannot verify this sign-in automatically.</p>
                    @if (HasUnsavedAuthenticationChanges && _editProfile is not null)
                    {
                        <p class="fa-configured-auth-draft">Configured authentication (draft): <strong>@_editProfile.Authentication.AuthenticationType</strong> — ⚠ Unsaved. Saved authentication: @profile.Authentication.AuthenticationType.</p>
                    }
                    else if (profile.Authentication.AuthenticationType == FrontendAuthenticationType.None)
                    {
                        <p>Configured authentication None means no authentication settings are preconfigured.</p>
                    }
                    else
                    {
                        <p>Configured authentication: @profile.Authentication.AuthenticationType.</p>
                    }
                    </details>
                </div>
                @if (!_manualInstructionsOpen)
                {
                    <SecondaryButton OnClick="OpenManualVerification">Open verification instructions</SecondaryButton>
                }
                else
                {
                    <ol>
                        <li>Open @CurrentTargetUrl in your normal enterprise-managed Microsoft Edge work profile.</li>
                        <li>Sign in using your work account.</li>
                        <li>Complete PIN, passkey or MFA manually.</li>
                        <li>If MCAS / Defender for Cloud Apps appears, continue manually.</li>
                        <li>Confirm that the authenticated target application is reached.</li>
                        <li>Return to BirkNext and mark verification as passed or failed.</li>
                    </ol>
                    <p>Only your verification result is recorded. No browser authentication state is transferred.</p>
                    <PrimaryButton OnClick="@(() => RecordManualVerificationAsync(ManualAuthenticationVerificationStatus.Passed))" Disabled="@(!CanRecordManualVerification)">Mark verification passed</PrimaryButton>
                    <SecondaryButton OnClick="@(() => RecordManualVerificationAsync(ManualAuthenticationVerificationStatus.Failed))" Disabled="@(!CanRecordManualVerification)">Mark verification failed</SecondaryButton>
                }
                @if (ManualStatus == ManualAuthenticationVerificationStatus.Failed)
                {
                    <SecondaryButton OnClick="OpenManualVerification">Retry manual verification</SecondaryButton>
                }
                @if (CurrentProfile?.ManualVerification is { } evidence)
                {
                    <p><small>Last recorded verification: @evidence.Result ? @evidence.VerifiedAt ? @evidence.Origin</small></p>
                }
                @if (_detectionResult is not null && !ManualVerificationContextCurrent)
                {
                    <p class="fa-activation-reason fa-manual-context-changed" role="status">
                        Authentication or environment settings changed since detection.
                        @(IsDirty ? "Save changes, then run Detect settings again before recording manual verification." : "Run Detect settings again before recording manual verification.")
                        Target discovery is unaffected.
                    </p>
                }
                <p>If you changed environment settings, save them before recording verification. Activation requires current target detection and manual verification Passed.</p>
            </section>
        }

        @{ var typeConflict = GetTypeConflict(profile); }
        @if (typeConflict is not null)
        {
            <div class="fa-type-conflict" role="status">
                <div class="fa-type-conflict-text">
                    <strong>Target type may be incorrect.</strong>
                    Stored type: <strong>@profile.EnvironmentType</strong> · Detected type: <strong>@typeConflict</strong>.
                    Review detected settings before applying changes.
                </div>
                @if (!_isEditMode)
                {
                    <SecondaryButton OnClick="DetectSelectedTargetAsync" Disabled="@(_isDetecting || string.IsNullOrWhiteSpace(profile.TargetUrl))" Class="fa-type-conflict-action">
                        @(_isDetecting ? "Detecting…" : "Review Detect Settings")
                    </SecondaryButton>
                }
            </div>
        }

        @* ── Section tabs ── *@
        <div class="fa-section-tabs" role="tablist" aria-label="Target Environment sections">
            @foreach (var (key, label) in Tabs)
            {
                <button type="button" class="fa-tab @(_activeTab == key ? "fa-tab-active" : "")"
                        id="@($"target-tab-{key}")" aria-controls="target-section-panel"
                        tabindex="@(_activeTab == key ? 0 : -1)" @ref="_tabElements[Array.FindIndex(Tabs, t => t.Key == key)]"
                        @onkeydown="e => SectionTabKey(e, key)"
                        role="tab"
                        aria-selected="@(_activeTab == key ? "true" : "false")"
                        @onclick="() => _activeTab = key">
                    @label
                </button>
            }
        </div>

        @* ── Tab content ── *@
        <div class="fa-tab-content" role="tabpanel" id="target-section-panel" aria-labelledby="@($"target-tab-{_activeTab}")" tabindex="0">

            @* ── General ── *@
            @if (_activeTab == "general")
            {
                @if (_isEditMode && _editProfile is not null)
                {
                    <div class="fa-form-grid">
                        <div class="form-field">
                            <label class="fa-label">Environment Name <span class="wsr-required">*</span></label>
                            <input type="text" class="form-control" @bind="_editProfile.Name" />
                        </div>
                        <div class="form-field">
                            <label class="fa-label">Environment Type</label>
                            <select class="form-control" @bind="_editProfile.EnvironmentType">
                                @foreach (var env in Enum.GetValues<FrontendEnvironmentType>())
                                {
                                    <option value="@env">@env</option>
                                }
                            </select>
                        </div>
                        <div class="form-field fa-field-full">
                            <label class="fa-label">Description <span class="form-optional">(optional)</span></label>
                            <input type="text" class="form-control" @bind="_editProfile.Description" />
                        </div>
                        <div class="form-field fa-field-full">
                            <label class="fa-label">Notes <span class="form-optional">(optional)</span></label>
                            <textarea class="form-control" rows="3" @bind="_editProfile.Notes"></textarea>
                        </div>
                    </div>
                }
                else
                {
                    <dl class="fa-detail-list">
                        <div class="fa-dl-row"><dt>Environment Type</dt><dd>@profile.EnvironmentType</dd></div>
                        <div class="fa-dl-row"><dt>Description</dt><dd>@(profile.Description ?? "No description")</dd></div>
                        <div class="fa-dl-row"><dt>Notes</dt><dd>@(profile.Notes ?? "No notes")</dd></div>
                    </dl>
                }
            }

            @* ── Target Application ── *@
            @if (_activeTab == "target")
            {
                @* Detected target identity and runtime facts only. Authentication is configured, verified and
                   used for testing on the Authentication tab; nothing here edits authentication. *@
                @if (_detectionResult?.Success == true)
                {
                    <section class="fa-detected-card" data-testid="target-detected-summary" aria-labelledby="target-detected-heading">
                        <div class="fa-card-heading">
                            <h3 id="target-detected-heading">Detected from target</h3>
                            <span class="fa-card-status fa-card-status-muted" data-testid="target-detection-confidence">Detection confidence: @DetectionPresentation.ConfidenceLabel(_detectionResult.Confidence)</span>
                        </div>

                        <dl class="fa-detected-list">
                            <div class="fa-detected-row"><dt>Reachability</dt><dd class="fa-detected-value">@_detectionResult.Reachability</dd><dd class="fa-source-badge">Detected</dd></div>

                            @if (_detectionResult.DetectedClientFramework.HasValue)
                            {
                                <div class="fa-detected-row"><dt>Framework</dt><dd class="fa-detected-value">@DetectionPresentation.FrameworkLabel(_detectionResult.DetectedClientFramework)</dd><dd class="fa-source-badge">Detected</dd></div>
                            }

                            @if (_detectionResult.AuthenticationRequired)
                            {
                                <div class="fa-detected-row"><dt>Authentication required</dt><dd class="fa-detected-value">Yes</dd><dd class="fa-source-badge">Detected</dd></div>
                            }

                            @if (_detectionResult.DetectedAuthenticationType != FrontendAuthenticationType.None && !string.IsNullOrWhiteSpace(_detectionResult.DetectedAuthority))
                            {
                                <div class="fa-detected-row"><dt>Identity provider</dt><dd class="fa-detected-value" data-testid="target-identity-provider">@AuthenticationPresentation.ProviderLabel(_detectionResult.DetectedAuthenticationType)</dd><dd class="fa-source-badge">Detected</dd></div>
                            }

                            @if (!string.IsNullOrWhiteSpace(_detectionResult.DetectedAuthority))
                            {
                                <div class="fa-detected-row"><dt>Authority</dt><dd class="fa-detected-value fa-detected-mono" data-testid="target-authority">@_detectionResult.DetectedAuthority</dd><dd class="fa-source-badge">Detected</dd></div>
                            }

                            @if (!string.IsNullOrWhiteSpace(_detectionResult.DetectedTenantId))
                            {
                                <div class="fa-detected-row"><dt>Tenant</dt><dd class="fa-detected-value fa-detected-mono" data-testid="target-tenant">@_detectionResult.DetectedTenantId</dd><dd class="fa-source-badge">Detected</dd></div>
                            }
                            else if (!string.IsNullOrWhiteSpace(_detectionResult.TenantMode))
                            {
                                <div class="fa-detected-row"><dt>Tenant mode</dt><dd class="fa-detected-value" data-testid="target-tenant">@_detectionResult.TenantMode</dd><dd class="fa-source-badge">Detected</dd></div>
                            }

                            @if (!string.IsNullOrWhiteSpace(_detectionResult.DetectedClientId))
                            {
                                <div class="fa-detected-row"><dt>Client/Application ID</dt><dd class="fa-detected-value fa-detected-mono" data-testid="target-client-id">@_detectionResult.DetectedClientId</dd><dd class="fa-source-badge">Detected</dd></div>
                            }

                            @if (_detectionResult.SuggestedEnvironmentType.HasValue)
                            {
                                <div class="fa-detected-row">
                                    <dt>Environment type</dt>
                                    <dd class="fa-detected-value">
                                        @_detectionResult.SuggestedEnvironmentType
                                        @if (CurrentProfile is not null && CurrentProfile.EnvironmentType != _detectionResult.SuggestedEnvironmentType.Value)
                                        {
                                            <button type="button" class="fa-apply-suggestion" @onclick="ApplyDetectedEnvironmentType">Apply detected type</button>
                                        }
                                    </dd>
                                    <dd class="fa-source-badge fa-source-badge-suggested">Suggested</dd>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(_detectionResult.SuggestedProfileName))
                            {
                                <div class="fa-detected-row"><dt>Profile name</dt><dd class="fa-detected-value">@_detectionResult.SuggestedProfileName</dd><dd class="fa-source-badge fa-source-badge-suggested">Suggested</dd></div>
                            }
                        </dl>

                        @if (IsDetectionStale)
                        {
                            <p class="fa-detected-stale" role="status" data-testid="target-detection-stale">
                                <strong>Discoveries are stale.</strong> @DiscoveryStaleDetail
                            </p>
                        }

                        @* Detected values are evidence, never saved configuration. Authentication lives on its own tab. *@
                        <p class="fa-detected-footnote">
                            Detected values describe this target. They are not saved configuration.
                            @if (_detectionResult.AuthenticationRequired || _detectionResult.DetectedAuthenticationType != FrontendAuthenticationType.None)
                            {
                                <span data-testid="target-authentication-pointer">Configure, verify and test authentication on the Authentication tab.</span>
                            }
                        </p>
                    </section>
                }

                @if (_isEditMode && _editProfile is not null)
                {
                    <div class="fa-form-grid">
                        <div class="fa-threshold-group-title fa-field-full">Frontend</div>
                        <div class="form-field fa-field-full">
                            <label class="fa-label">Frontend Base URL</label>
                            <input type="url" class="form-control" placeholder="https://myapp.example.com"
                                   @bind="_editProfile.TargetUrl"
                                   @bind:after="() => ClearDetectionState()" />
                        </div>

                        <div class="fa-threshold-group-title fa-field-full">Request Settings</div>
                        <div class="fa-form-row-compact">
                            <div class="form-field">
                                <label class="fa-label">Request Timeout</label>
                                <div style="display:flex;align-items:center;gap:.5rem">
                                    <input type="number" class="form-control fa-threshold-input" min="1" max="300" @bind="_editProfile.RequestTimeoutSeconds" />
                                    <span class="fa-threshold-unit">seconds</span>
                                </div>
                            </div>
                            <div class="form-field">
                                <label class="fa-label">Retry Count</label>
                                <input type="number" class="form-control fa-threshold-input" min="0" max="10" @bind="_editProfile.RetryCount" />
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <dl class="fa-detail-list">
                        <div class="fa-dl-row fa-dl-section"><dt colspan="2" class="fa-dl-section-title">Frontend</dt></div>
                        <div class="fa-dl-row"><dt>Frontend Base URL</dt><dd>@(profile.TargetUrl ?? "—")</dd></div>
                        <div class="fa-dl-row fa-dl-section"><dt colspan="2" class="fa-dl-section-title">Request Settings</dt></div>
                        <div class="fa-dl-row"><dt>Request Timeout</dt><dd>@profile.RequestTimeoutSeconds s</dd></div>
                        <div class="fa-dl-row"><dt>Retry Count</dt><dd>@profile.RetryCount</dd></div>
                    </dl>
                }
            }

            @* ── Authentication ── *@
            @if (_activeTab == "auth")
            {
                <div class="fa-auth-layout">

                @* ── 1. Status: how authentication stands right now ── *@
                <section class="fa-auth-status fa-state-@AuthenticationDiscoveryState" data-testid="authentication-discovery" aria-labelledby="authentication-status-heading">
                    <div class="fa-card-heading">
                        <h3 id="authentication-status-heading">Authentication</h3>
                        <span class="fa-card-status" role="status">@AuthenticationDiscoveryLabel</span>
                    </div>

                    <p class="fa-auth-summary" data-testid="authentication-match-summary">
                        <span class="fa-auth-marker" aria-hidden="true">@AuthenticationPresentation.StateMarker(AuthenticationMatch)</span>
                        <span>@AuthenticationPresentation.StateSummary(AuthenticationMatch)</span>
                    </p>

                    <dl class="fa-detail-list">
                        <div class="fa-dl-row"><dt>Provider</dt><dd data-testid="authentication-provider">@AuthenticationPresentation.DetectedProviderLabel(_detectionResult)</dd></div>
                        <div class="fa-dl-row"><dt>Testing context</dt><dd data-testid="authenticated-context">@AuthenticatedContextLabel</dd></div>
                        <div class="fa-dl-row"><dt>Verification method</dt><dd data-testid="authentication-verification-method">@VerificationModeLabel</dd></div>
                        @if (ManualVerificationRequired)
                        {
                            <div class="fa-dl-row"><dt>Verification</dt><dd data-testid="authentication-verification-status">@ManualVerificationLabel</dd></div>
                        }
                    </dl>

                    <div class="fa-auth-actions">
                        @if (ManualVerificationRequired && SelectedTestingMethod != AuthenticatedTestingMethod.ManualOnly)
                        {
                            <button type="button" class="btn-secondary fa-btn-sm" @onclick='() => _activeTab = "target"'>Review manual verification</button>
                        }
                        @if (_detectionResult?.Success == true && HasDetectedAuthSettings(_detectionResult))
                        {
                            <button type="button" class="btn-secondary fa-btn-sm fa-apply-authentication" @onclick="ApplyDetectedAuthenticationSettings"
                                    disabled="@(AuthenticationProposalStale || AuthenticationProposalMatches(CurrentProfile))"
                                    title="Copy the detected authentication proposal into the draft. Use Save changes to persist.">
                                Apply authentication
                            </button>
                        }
                    </div>
                    <p class="fa-auth-help" data-testid="apply-authentication-explanation">@AuthenticationPresentation.ApplyExplanation(AuthenticationMatch, AuthenticationComparison)</p>

                    @* One comparison table, collapsed while everything matches and expanded automatically when a value differs.
                       This is the only place the detected and configured identifiers are listed. *@
                    <details class="fa-auth-details" data-testid="edge-auth-discovery" open="@AuthenticationDetailsOpen">
                        <summary data-testid="authentication-details-toggle">View details</summary>
                        <table class="fa-auth-comparison" data-testid="authentication-comparison">
                            <caption>Advanced authentication details</caption>
                            <thead>
                                <tr><th scope="col">Setting</th><th scope="col">Detected</th><th scope="col">Configured</th><th scope="col">Status</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var row in AuthenticationComparison)
                                {
                                    <tr>
                                        <th scope="row">@row.Setting</th>
                                        <td class="fa-auth-compare-value">@row.Detected</td>
                                        <td class="fa-auth-compare-value">@row.Configured</td>
                                        <td><span class="fa-compare-badge fa-compare-@AuthenticationPresentation.StatusCss(row.Status)"><span aria-hidden="true">@AuthenticationPresentation.StatusMarker(row.Status)</span> @AuthenticationPresentation.StatusLabel(row.Status)</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <dl class="fa-detail-list">
                            <div class="fa-dl-row"><dt>Source</dt><dd data-testid="authentication-detection-source">@(_detectionResult?.Success == true ? "Detect Settings" : "Not detected")</dd></div>
                        </dl>
                        <p class="fa-auth-help">Expected authentication settings only. Never enter passwords, tokens or client secrets — BirkNext has no field for them.</p>
                    </details>
                </section>

                @* ── 2. How authenticated testing is performed ── *@
                <section class="fa-detection-summary fa-state-@(TestingMethodChanged ? "draft" : "saved")" data-testid="authenticated-testing-method">
                    <div class="fa-card-heading"><h3>Authenticated testing method</h3><span class="fa-card-status" role="status">@(TestingMethodChanged ? "Unsaved change" : _isEditMode ? "Editing draft" : "Saved configuration")</span></div>
                    @if (_isEditMode && _editProfile is not null)
                    {
                        <label class="fa-label" for="authenticated-testing-method-select">Method</label>
                        <select id="authenticated-testing-method-select" class="form-control" @bind="_editProfile.Authentication.AuthenticatedTestingMethod">
                            <option value="@AuthenticatedTestingMethod.LocalHttpsProxy">@AuthenticatedTestingMethodLabels.EditOption(AuthenticatedTestingMethod.LocalHttpsProxy)</option>
                            <option value="@AuthenticatedTestingMethod.ManagedEdgeCdp">@AuthenticatedTestingMethodLabels.CdpOption</option>
                            <option value="@AuthenticatedTestingMethod.ManualOnly">@AuthenticatedTestingMethodLabels.ManualOption</option>
                        </select>
                    }
                    else
                    {
                        <dl class="fa-detail-list">
                            <div class="fa-dl-row"><dt>Method</dt><dd data-testid="authenticated-testing-method-value">@AuthenticatedTestingMethodLabels.Option(SelectedTestingMethod)</dd></div>
                            <div class="fa-dl-row"><dt>Authenticated context</dt><dd data-testid="authenticated-testing-method-context">@AuthenticatedContextLabel</dd></div>
                            <div class="fa-dl-row"><dt>Other available methods</dt><dd data-testid="authenticated-testing-method-others">@AuthenticatedTestingMethodLabels.OtherMethods(SelectedTestingMethod)</dd></div>
                        </dl>
                    }
                    @if (SelectedTestingMethod == AuthenticatedTestingMethod.LocalHttpsProxy)
                    {
                        <p class="fa-auth-note" data-testid="authenticated-testing-method-help">
                            <span class="fa-auth-note-tag">DEV only</span>
                            <span data-testid="proxy-security-warning">@AuthenticatedTestingMethodLabels.Help(SelectedTestingMethod)</span>
                        </p>
                    }
                    else
                    {
                        <p class="fa-auth-help" data-testid="authenticated-testing-method-help">@AuthenticatedTestingMethodLabels.Help(SelectedTestingMethod)</p>
                    }
                    @if (SelectedTestingMethod == AuthenticatedTestingMethod.LocalHttpsProxy && !LocalHttpsProxyScope.EnvironmentAllowed(CurrentProfile))
                    {
                        <p role="alert" data-testid="authenticated-testing-method-environment-blocked">@LocalHttpsProxyEnvironmentPolicy.EnvironmentBlockedReason</p>
                    }
                </section>

                @* The SAVED Authenticated testing method decides which runtime panel is shown. Runtime operations in either panel are
                   transient: they never enter edit mode, never show Save changes and never persist evidence. *@
                @if (SelectedTestingMethod == AuthenticatedTestingMethod.ManagedEdgeCdp)
                {
                    <ManagedEdgeConnectionPanel Runtime="_edgeRuntime" Profile="CurrentProfile" />
                }
                else if (SelectedTestingMethod == AuthenticatedTestingMethod.LocalHttpsProxy)
                {
                    <LocalHttpsProxyPanel Runtime="_proxyRuntime" Profile="CurrentProfile" OnViewDiscovery='() => _activeTab = "endpoint"' />
                }
                else
                {
                    <section class="fa-detection-summary fa-state-@(ManualStatus == ManualAuthenticationVerificationStatus.Passed ? "ready" : ManualStatus == ManualAuthenticationVerificationStatus.Failed ? "blocked" : "needs-action")" data-testid="manual-only-panel" aria-label="Manual verification only">
                        <h3>Manual verification</h3>
                        <dl class="fa-detail-list"><div class="fa-dl-row"><dt>Target</dt><dd>@CurrentProfile?.Name</dd></div><div class="fa-dl-row"><dt>Status</dt><dd>@ManualStatus</dd></div></dl>
                        <SecondaryButton OnClick="OpenManualVerification">Open verification instructions</SecondaryButton>
                        @if (_manualInstructionsOpen)
                        {
                            <p>Open @CurrentTargetUrl in your managed Edge work profile, sign in manually, and confirm access to the target application.</p>
                            <PrimaryButton OnClick="@(() => RecordManualVerificationAsync(ManualAuthenticationVerificationStatus.Passed))" Disabled="@(!CanRecordManualVerification)">Mark verification passed</PrimaryButton>
                            <SecondaryButton OnClick="@(() => RecordManualVerificationAsync(ManualAuthenticationVerificationStatus.Failed))" Disabled="@(!CanRecordManualVerification)">Mark verification failed</SecondaryButton>
                        }
                        <p>Manual verification confirms user access only. It does not enable authenticated REST, GraphQL or browser automation.</p>
                        <AuthenticatedCapabilities Api="false" Dom="false" Rest="false" GraphQl="false" TrafficVerified="false" />
                    </section>
                }

                @* ── 3. Saved authentication configuration ── *@
                <section class="fa-auth-configuration fa-state-@(HasUnsavedAuthenticationChanges ? "draft" : "saved")" data-testid="authentication-configuration">
                <div class="fa-card-heading"><h3>Authentication configuration</h3><span class="fa-card-status" role="status">@(HasUnsavedAuthenticationChanges ? "Unsaved changes" : _isEditMode ? "Editing draft" : "Saved configuration")</span></div>
                @if (_isEditMode && _editProfile is not null)
                {
                    var auth = _editProfile.Authentication;
                    <div class="fa-form-grid">
                        <div class="form-field fa-field-full">
                            <div class="fa-threshold-group-title" id="configured-authentication-heading">Configured Authentication</div>
                            @if (HasUnsavedAuthenticationChanges)
                            {
                                <div class="fa-unsaved-notice" role="status" aria-labelledby="auth-unsaved-title" data-testid="auth-unsaved-changes">
                                    <svg class="fa-unsaved-icon" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
                                        <path d="M8.982 1.566a1.13 1.13 0 0 0-1.964 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                                    </svg>
                                    <div class="fa-unsaved-body">
                                        <strong id="auth-unsaved-title" class="fa-unsaved-title">Unsaved changes</strong>
                                        <div class="fa-unsaved-help">Authentication settings differ from saved configuration. Use Save changes to persist them.</div>
                                    </div>
                                </div>
                            }
                            <label class="fa-label" for="configured-authentication-type">Configured Authentication Type</label>
                            <select id="configured-authentication-type" class="form-control" @bind="auth.AuthenticationType">
                                @foreach (var t in Enum.GetValues<FrontendAuthenticationType>())
                                {
                                    <option value="@t">@t</option>
                                }
                            </select>
                        </div>
                        <div class="form-field fa-field-checks">
                            <label class="fa-check-row">
                                <input type="checkbox" @bind="auth.RequiresAuthentication" />
                                <span>Requires Authentication</span>
                            </label>
                        </div>
                        <div class="form-field fa-field-full">
                            <label class="fa-label" for="configured-authority">Expected Authority <span class="form-optional">(optional, configured)</span></label>
                            <input id="configured-authority" type="url" class="form-control" placeholder="https://login.microsoftonline.com/…" @bind="auth.ExpectedAuthority" />
                        </div>
                        <div class="form-field">
                            <label class="fa-label" for="configured-tenant">Expected Tenant <span class="form-optional">(optional, configured)</span></label>
                            <input id="configured-tenant" type="text" class="form-control" placeholder="00000000-0000-0000-0000-000000000000" @bind="auth.ExpectedTenant" />
                        </div>
                        <div class="form-field">
                            <label class="fa-label" for="configured-client-id">Expected Client ID <span class="form-optional">(optional, configured)</span></label>
                            <input id="configured-client-id" type="text" class="form-control" placeholder="00000000-0000-0000-0000-000000000000" @bind="auth.ExpectedClientId" />
                        </div>
                        <div class="form-field fa-field-full">
                            <label class="fa-label" for="configured-redirect-urls">Allowed Redirect URLs <span class="form-optional">(one per line, configured)</span></label>
                            <textarea id="configured-redirect-urls" class="form-control" rows="3"
                                      value="@ListToText(auth.AllowedRedirectUrls)"
                                      @onchange="e => auth.AllowedRedirectUrls = TextToList(e.Value?.ToString())"></textarea>
                        </div>

                        @* Browser delivery trust: saved policy for managed-Edge authenticated testing. Exact origin is always preferred;
                           ApprovedMcasProxyOrigin only ADDS an approved, correlated Defender for Cloud Apps fallback. Changing it follows the normal
                           draft -> Save changes / Cancel flow and never marks public target detection stale. *@
                    @if (SelectedTestingMethod == AuthenticatedTestingMethod.ManagedEdgeCdp)
                    {
                        <div class="form-field fa-field-full fa-state-@(BrowserTrustChanged ? "draft" : "saved") fa-auth-subcard" data-testid="browser-delivery-trust">
                            <span class="fa-card-status" role="status">@(BrowserTrustChanged ? "Unsaved change" : "Editing draft")</span>
                            <div class="fa-threshold-group-title" id="browser-delivery-trust-heading">Browser delivery trust</div>
                            <p>Exact origin is always preferred.</p>
                            <dl class="fa-detail-list">
                                <div class="fa-dl-row"><dt>Configured target</dt><dd data-testid="browser-delivery-trust-target">@(BrowserDeliveryTrustLabels.ConfiguredTarget(_editProfile) ?? "Configure a Frontend URL")</dd></div>
                            </dl>
                            <label class="fa-label" for="browser-delivery-trust-model">Trust model</label>
                            <select id="browser-delivery-trust-model" class="form-control" @bind="auth.BrowserDeliveryTrust">
                                <option value="@ManagedEdgeTrustModel.ExactOrigin">@BrowserDeliveryTrustLabels.ExactOriginOption</option>
                                <option value="@ManagedEdgeTrustModel.ApprovedMcasProxyOrigin">@BrowserDeliveryTrustLabels.ApprovedProxyOption</option>
                            </select>
                            <details><summary>Trust policy details</summary><p data-testid="browser-delivery-trust-help">@BrowserDeliveryTrustLabels.Help(auth.BrowserDeliveryTrust)</p></details>
                        </div>
                    }

                    </div>
                }
                else
                {
                    var auth = profile.Authentication;
                    @* Identifiers and redirect URLs are not repeated here: they live only in the single comparison above. *@
                    <dl class="fa-detail-list">
                        <div class="fa-dl-row"><dt>Configured authentication</dt><dd>@auth.AuthenticationType @if (_detectionResult?.Success == true && _detectionResult.DetectedAuthenticationType != auth.AuthenticationType) { <small class="fa-configured-auth-draft">Differs from detected provider</small> }</dd></div>
                        <div class="fa-dl-row"><dt>Requires Authentication</dt><dd>@BoolLabel(auth.RequiresAuthentication)</dd></div>
                    </dl>
                    @if (SelectedTestingMethod == AuthenticatedTestingMethod.ManagedEdgeCdp)
                    {
                    <div class="fa-field-full fa-state-saved fa-auth-subcard" data-testid="browser-delivery-trust">
                        <span class="fa-card-status">Saved configuration</span>
                        <div class="fa-threshold-group-title" id="browser-delivery-trust-heading">Browser delivery trust</div>
                        <dl class="fa-detail-list">
                            <div class="fa-dl-row"><dt>Configured target</dt><dd data-testid="browser-delivery-trust-target">@(BrowserDeliveryTrustLabels.ConfiguredTarget(profile) ?? "Configure a Frontend URL")</dd></div>
                            <div class="fa-dl-row"><dt>Trust model</dt><dd data-testid="browser-delivery-trust-model">@BrowserDeliveryTrustLabels.Policy(auth.BrowserDeliveryTrust)</dd></div>
                        </dl>
                        <details><summary>Trust policy details</summary><p data-testid="browser-delivery-trust-help">@BrowserDeliveryTrustLabels.Help(auth.BrowserDeliveryTrust) Use Edit Environment to change the trust model; the change is saved only with Save changes.</p></details>
                    </div>
                    }
                }

                </section>
                </div>
            }

            @* ── Endpoint Discovery ── *@
            @if (_activeTab == "endpoint")
            {
                <p class="fa-section-note">
                    Pages, endpoints and services observed through network traffic, alongside configured backend integrations.
                </p>

                <EndpointDiscoveryTab Profile="CurrentProfile" ProxyStatus="ProxyStatus" CompanionStatus="@(_companionRuntime?.For(CurrentProfile?.Id) ?? new())" />
            }

            @* ── Performance Thresholds ── *@
            @if (_activeTab == "browser")
            {
                <BrowserDiscoveryTab @key="CurrentProfile!.Id" Profile="CurrentProfile" Runtime="_companionRuntime" />
            }

            @if (_activeTab == "performance")
            {
                <p class="fa-section-note">
                    These are QA baseline values intended for enterprise Blazor WASM applications.
                    Adjust them after measuring your own application's baseline.
                </p>
                @if (_isEditMode && _editProfile is not null)
                {
                    <div class="fa-threshold-presets">
                        <span class="fa-threshold-mode-label">
                            Mode: <strong>@_editProfile.Performance.Mode</strong>
                        </span>
                        <button class="btn-secondary fa-btn-sm" @onclick="ApplyDefaultPreset">Set to Default</button>
                        <button class="btn-secondary fa-btn-sm" @onclick="ApplyStrictPreset">Set to Strict Defaults</button>
                    </div>
                    <div class="fa-threshold-grid">
                        <div class="fa-threshold-group">
                            <div class="fa-threshold-group-title">Startup</div>
                            <div class="fa-threshold-row">
                                <label class="fa-threshold-label">Maximum Startup Size</label>
                                <input type="number" class="form-control fa-threshold-input" step="0.5" min="0"
                                       value="@ToMB(_editProfile.Performance.MaxStartupSizeBytes)"
                                       @onchange="e => SetMaxStartupSizeMb(e.Value)" />
                                <span class="fa-threshold-unit">MB</span>
                            </div>
                            <div class="fa-threshold-row">
                                <label class="fa-threshold-label">Maximum Startup Requests</label>
                                <input type="number" class="form-control fa-threshold-input" min="1"
                                       @bind="_editProfile.Performance.MaxStartupRequests"
                                       @bind:after="MarkThresholdsCustom" />
                                <span class="fa-threshold-unit">requests</span>
                            </div>
                            <div class="fa-threshold-row">
                                <label class="fa-threshold-label">Maximum Startup API Calls</label>
                                <input type="number" class="form-control fa-threshold-input" min="1"
                                       @bind="_editProfile.Performance.MaxStartupApiCalls"
                                       @bind:after="MarkThresholdsCustom" />
                                <span class="fa-threshold-unit">calls</span>
                            </div>
                        </div>
                        <div class="fa-threshold-group">
                            <div class="fa-threshold-group-title">Payloads</div>
                            <div class="fa-threshold-row">
                                <label class="fa-threshold-label">Maximum REST Payload</label>
                                <input type="number" class="form-control fa-threshold-input" step="10" min="0"
                                       value="@ToKB(_editProfile.Performance.MaxRestPayloadBytes)"
                                       @onchange="e => SetMaxRestPayloadKb(e.Value)" />
                                <span class="fa-threshold-unit">KB</span>
                            </div>
                            <div class="fa-threshold-row">
                                <label class="fa-threshold-label">Maximum GraphQL Payload</label>
                                <input type="number" class="form-control fa-threshold-input" step="10" min="0"
                                       value="@ToKB(_editProfile.Performance.MaxGraphQlPayloadBytes)"
                                       @onchange="e => SetMaxGraphQlPayloadKb(e.Value)" />
                                <span class="fa-threshold-unit">KB</span>
                            </div>
                        </div>
                        <div class="fa-threshold-group">
                            <div class="fa-threshold-group-title">Latency</div>
                            <div class="fa-threshold-row">
                                <label class="fa-threshold-label">Maximum Average API Latency</label>
                                <input type="number" class="form-control fa-threshold-input" min="1"
                                       @bind="_editProfile.Performance.MaxAverageApiLatencyMs"
                                       @bind:after="MarkThresholdsCustom" />
                                <span class="fa-threshold-unit">ms</span>
                            </div>
                            <div class="fa-threshold-row">
                                <label class="fa-threshold-label">Maximum Single Request Latency</label>
                                <input type="number" class="form-control fa-threshold-input" min="1"
                                       @bind="_editProfile.Performance.MaxSingleRequestLatencyMs"
                                       @bind:after="MarkThresholdsCustom" />
                                <span class="fa-threshold-unit">ms</span>
                            </div>
                        </div>
                        <div class="fa-threshold-group">
                            <div class="fa-threshold-group-title">Bundle Sizes</div>
                            <div class="fa-threshold-row">
                                <label class="fa-threshold-label">Maximum WASM Runtime Size</label>
                                <input type="number" class="form-control fa-threshold-input" step="0.5" min="0"
                                       value="@ToMB(_editProfile.Performance.MaxWasmRuntimeSizeBytes)"
                                       @onchange="e => SetMaxWasmRuntimeSizeMb(e.Value)" />
                                <span class="fa-threshold-unit">MB</span>
                            </div>
                            <div class="fa-threshold-row">
                                <label class="fa-threshold-label">Maximum Framework Size</label>
                                <input type="number" class="form-control fa-threshold-input" step="0.5" min="0"
                                       value="@ToMB(_editProfile.Performance.MaxFrameworkSizeBytes)"
                                       @onchange="e => SetMaxFrameworkSizeMb(e.Value)" />
                                <span class="fa-threshold-unit">MB</span>
                            </div>
                            <div class="fa-threshold-row">
                                <label class="fa-threshold-label">Maximum Application Assembly Size</label>
                                <input type="number" class="form-control fa-threshold-input" step="0.5" min="0"
                                       value="@ToMB(_editProfile.Performance.MaxApplicationAssemblySizeBytes)"
                                       @onchange="e => SetMaxAppAssemblySizeMb(e.Value)" />
                                <span class="fa-threshold-unit">MB</span>
                            </div>
                            <div class="fa-threshold-row">
                                <label class="fa-threshold-label">Maximum Individual Asset Size</label>
                                <input type="number" class="form-control fa-threshold-input" step="0.5" min="0"
                                       value="@ToMB(_editProfile.Performance.MaxIndividualAssetSizeBytes)"
                                       @onchange="e => SetMaxIndividualAssetSizeMb(e.Value)" />
                                <span class="fa-threshold-unit">MB</span>
                            </div>
                        </div>
                        <div class="fa-threshold-group" data-testid="fa-performance-quality-thresholds">
                            <div class="fa-threshold-group-title">BirkNext Performance Quality</div>
                            <div class="fa-threshold-row">
                                <label class="fa-threshold-label">API Response Warning</label>
                                <input type="number" class="form-control fa-threshold-input" min="1" @bind="_editProfile.Performance.ApiResponseWarningMs" @bind:after="MarkThresholdsCustom" />
                                <span class="fa-threshold-unit">ms</span>
                            </div>
                            <div class="fa-threshold-row">
                                <label class="fa-threshold-label">API Response Poor</label>
                                <input type="number" class="form-control fa-threshold-input" min="1" @bind="_editProfile.Performance.ApiResponsePoorMs" @bind:after="MarkThresholdsCustom" />
                                <span class="fa-threshold-unit">ms</span>
                            </div>
                            <div class="fa-threshold-row">
                                <label class="fa-threshold-label">Page Stabilization Good</label>
                                <input type="number" class="form-control fa-threshold-input" min="1" @bind="_editProfile.Performance.PageStabilizationGoodMs" @bind:after="MarkThresholdsCustom" />
                                <span class="fa-threshold-unit">ms</span>
                            </div>
                            <div class="fa-threshold-row">
                                <label class="fa-threshold-label">Page Stabilization Poor</label>
                                <input type="number" class="form-control fa-threshold-input" min="1" @bind="_editProfile.Performance.PageStabilizationPoorMs" @bind:after="MarkThresholdsCustom" />
                                <span class="fa-threshold-unit">ms</span>
                            </div>
                            <div class="fa-threshold-row">
                                <label class="fa-threshold-label">Maximum JavaScript Transfer</label>
                                <input type="number" class="form-control fa-threshold-input" step="0.5" min="0"
                                       value="@ToMB(_editProfile.Performance.MaxJsTransferBytes)"
                                       @onchange="e => SetMaxJsTransferMb(e.Value)" />
                                <span class="fa-threshold-unit">MB</span>
                            </div>
                            <div class="fa-threshold-row">
                                <label class="fa-threshold-label">Slow Resource Duration</label>
                                <input type="number" class="form-control fa-threshold-input" min="1" @bind="_editProfile.Performance.SlowResourceMs" @bind:after="MarkThresholdsCustom" />
                                <span class="fa-threshold-unit">ms</span>
                            </div>
                            <div class="fa-threshold-row">
                                <label class="fa-threshold-label">Maximum Long Tasks</label>
                                <input type="number" class="form-control fa-threshold-input" min="0" @bind="_editProfile.Performance.MaxLongTasks" @bind:after="MarkThresholdsCustom" />
                                <span class="fa-threshold-unit">tasks</span>
                            </div>
                            <div class="fa-threshold-row">
                                <label class="fa-threshold-label">Main-thread Blocking Warning</label>
                                <input type="number" class="form-control fa-threshold-input" min="0" @bind="_editProfile.Performance.MainThreadBlockingWarningMs" @bind:after="MarkThresholdsCustom" />
                                <span class="fa-threshold-unit">ms</span>
                            </div>
                            <div class="fa-threshold-row">
                                <label class="fa-threshold-label">Maximum Identical API Calls</label>
                                <input type="number" class="form-control fa-threshold-input" min="1" @bind="_editProfile.Performance.MaxIdenticalApiCalls" @bind:after="MarkThresholdsCustom" />
                                <span class="fa-threshold-unit">calls</span>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    var perf = profile.Performance;
                    <div class="fa-threshold-mode-pill fa-threshold-mode-pill-@perf.Mode.ToString().ToLowerInvariant()">
                        @perf.Mode Thresholds
                    </div>
                    <div class="fa-threshold-card-groups">
                        <div class="fa-threshold-card">
                            <div class="fa-threshold-card-title">Startup</div>
                            <div class="fa-threshold-display-row"><span>Startup Size</span><strong>@ToMB(perf.MaxStartupSizeBytes) MB</strong></div>
                            <div class="fa-threshold-display-row"><span>Startup Requests</span><strong>@perf.MaxStartupRequests</strong></div>
                            <div class="fa-threshold-display-row"><span>Startup API Calls</span><strong>@perf.MaxStartupApiCalls</strong></div>
                        </div>
                        <div class="fa-threshold-card">
                            <div class="fa-threshold-card-title">Payload</div>
                            <div class="fa-threshold-display-row"><span>REST Payload</span><strong>@ToKB(perf.MaxRestPayloadBytes) KB</strong></div>
                            <div class="fa-threshold-display-row"><span>GraphQL Payload</span><strong>@ToKB(perf.MaxGraphQlPayloadBytes) KB</strong></div>
                        </div>
                        <div class="fa-threshold-card">
                            <div class="fa-threshold-card-title">Latency</div>
                            <div class="fa-threshold-display-row"><span>Average API Latency</span><strong>@perf.MaxAverageApiLatencyMs ms</strong></div>
                            <div class="fa-threshold-display-row"><span>Single Request Latency</span><strong>@perf.MaxSingleRequestLatencyMs ms</strong></div>
                        </div>
                        <div class="fa-threshold-card">
                            <div class="fa-threshold-card-title">Blazor Runtime</div>
                            <div class="fa-threshold-display-row"><span>WASM Runtime</span><strong>@ToMB(perf.MaxWasmRuntimeSizeBytes) MB</strong></div>
                            <div class="fa-threshold-display-row"><span>Framework</span><strong>@ToMB(perf.MaxFrameworkSizeBytes) MB</strong></div>
                            <div class="fa-threshold-display-row"><span>App Assembly</span><strong>@ToMB(perf.MaxApplicationAssemblySizeBytes) MB</strong></div>
                            <div class="fa-threshold-display-row"><span>Individual Asset</span><strong>@ToMB(perf.MaxIndividualAssetSizeBytes) MB</strong></div>
                        </div>
                        <div class="fa-threshold-card" data-testid="fa-performance-quality-thresholds-display">
                            <div class="fa-threshold-card-title">BirkNext Performance Quality</div>
                            <div class="fa-threshold-display-row"><span>API Response Warning / Poor</span><strong>@perf.ApiResponseWarningMs / @perf.ApiResponsePoorMs ms</strong></div>
                            <div class="fa-threshold-display-row"><span>Page Stabilization Good / Poor</span><strong>@perf.PageStabilizationGoodMs / @perf.PageStabilizationPoorMs ms</strong></div>
                            <div class="fa-threshold-display-row"><span>JavaScript Transfer</span><strong>@ToMB(perf.MaxJsTransferBytes) MB</strong></div>
                            <div class="fa-threshold-display-row"><span>Slow Resource</span><strong>@perf.SlowResourceMs ms</strong></div>
                            <div class="fa-threshold-display-row"><span>Long Tasks / Blocking</span><strong>@perf.MaxLongTasks / @perf.MainThreadBlockingWarningMs ms</strong></div>
                            <div class="fa-threshold-display-row"><span>Identical API Calls</span><strong>@perf.MaxIdenticalApiCalls</strong></div>
                        </div>
                    </div>
                    <div class="fa-reset-row">
                        <SecondaryButton OnClick="RestoreDefaultThresholdsAsync" Class="fa-btn-sm">Set to Default</SecondaryButton>
                        <SecondaryButton OnClick="RestoreStrictThresholdsAsync" Class="fa-btn-sm">Set to Strict Defaults</SecondaryButton>
                    </div>
                }
            }

            @* ── Core Web Vitals ── *@
            @if (_activeTab == "cwv")
            {
                @if (_isEditMode && _editProfile is not null)
                {
                    var cwv = _editProfile.CoreWebVitals;
                    <div class="fa-threshold-grid">
                        <div class="fa-threshold-group">
                            <div class="fa-threshold-group-title">Largest Contentful Paint (LCP)</div>
                            <div class="fa-threshold-row">
                                <label class="fa-threshold-label">Good threshold</label>
                                <input type="number" class="form-control fa-threshold-input" min="0" @bind="cwv.LcpGoodMs" />
                                <span class="fa-threshold-unit">ms</span>
                            </div>
                            <div class="fa-threshold-row">
                                <label class="fa-threshold-label">Poor threshold</label>
                                <input type="number" class="form-control fa-threshold-input" min="0" @bind="cwv.LcpPoorMs" />
                                <span class="fa-threshold-unit">ms</span>
                            </div>
                        </div>
                        <div class="fa-threshold-group">
                            <div class="fa-threshold-group-title">Interaction to Next Paint (INP)</div>
                            <div class="fa-threshold-row">
                                <label class="fa-threshold-label">Good threshold</label>
                                <input type="number" class="form-control fa-threshold-input" min="0" @bind="cwv.InpGoodMs" />
                                <span class="fa-threshold-unit">ms</span>
                            </div>
                            <div class="fa-threshold-row">
                                <label class="fa-threshold-label">Poor threshold</label>
                                <input type="number" class="form-control fa-threshold-input" min="0" @bind="cwv.InpPoorMs" />
                                <span class="fa-threshold-unit">ms</span>
                            </div>
                        </div>
                        <div class="fa-threshold-group">
                            <div class="fa-threshold-group-title">Cumulative Layout Shift (CLS)</div>
                            <div class="fa-threshold-row">
                                <label class="fa-threshold-label">Good threshold</label>
                                <input type="number" class="form-control fa-threshold-input" step="0.01" min="0" @bind="cwv.ClsGood" />
                                <span class="fa-threshold-unit">score</span>
                            </div>
                            <div class="fa-threshold-row">
                                <label class="fa-threshold-label">Poor threshold</label>
                                <input type="number" class="form-control fa-threshold-input" step="0.01" min="0" @bind="cwv.ClsPoor" />
                                <span class="fa-threshold-unit">score</span>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    var cwv = profile.CoreWebVitals;
                    <div class="fa-threshold-display-grid">
                        <div class="fa-threshold-display-row"><span>LCP Good</span><strong>@cwv.LcpGoodMs ms</strong></div>
                        <div class="fa-threshold-display-row"><span>LCP Poor</span><strong>@cwv.LcpPoorMs ms</strong></div>
                        <div class="fa-threshold-display-row"><span>INP Good</span><strong>@cwv.InpGoodMs ms</strong></div>
                        <div class="fa-threshold-display-row"><span>INP Poor</span><strong>@cwv.InpPoorMs ms</strong></div>
                        <div class="fa-threshold-display-row"><span>CLS Good</span><strong>@cwv.ClsGood</strong></div>
                        <div class="fa-threshold-display-row"><span>CLS Poor</span><strong>@cwv.ClsPoor</strong></div>
                    </div>
                    <div class="fa-reset-row">
                        <SecondaryButton OnClick="RestoreCoreWebVitalsAsync" Class="fa-btn-sm">Restore Default Core Web Vitals</SecondaryButton>
                    </div>
                }
            }

            @* ── Security Expectations ── *@
            @if (_activeTab == "security")
            {
                <p class="fa-section-note">
                    These are expectations only — no validation is performed yet. Never enter secrets, passwords, or tokens.
                </p>
                @if (_isEditMode && _editProfile is not null)
                {
                    var sec = _editProfile.Security;
                    <div class="fa-form-grid">
                        <div class="form-field">
                            <label class="fa-label">Expected Authority <span class="form-optional">(optional)</span></label>
                            <input type="url" class="form-control" @bind="sec.ExpectedAuthority" />
                        </div>
                        <div class="form-field">
                            <label class="fa-label">Expected Tenant <span class="form-optional">(optional)</span></label>
                            <input type="text" class="form-control" @bind="sec.ExpectedTenant" />
                        </div>
                        <div class="form-field">
                            <label class="fa-label">Expected Client ID <span class="form-optional">(optional)</span></label>
                            <input type="text" class="form-control" @bind="sec.ExpectedClientId" />
                        </div>
                        <div class="form-field fa-field-full">
                            <label class="fa-label">Allowed Redirect URLs <span class="form-optional">(one per line)</span></label>
                            <textarea class="form-control" rows="3"
                                      value="@ListToText(sec.AllowedRedirectUrls)"
                                      @onchange="e => sec.AllowedRedirectUrls = TextToList(e.Value?.ToString())"></textarea>
                        </div>
                        <div class="form-field fa-field-full">
                            <label class="fa-label">Allowed Backend Domains <span class="form-optional">(one per line)</span></label>
                            <textarea class="form-control" rows="3"
                                      value="@ListToText(sec.AllowedBackendDomains)"
                                      @onchange="e => sec.AllowedBackendDomains = TextToList(e.Value?.ToString())"></textarea>
                        </div>
                        <div class="form-field fa-field-full">
                            <label class="fa-label">Allowed REST Hosts <span class="form-optional">(one per line)</span></label>
                            <textarea class="form-control" rows="3"
                                      value="@ListToText(sec.AllowedRestHosts)"
                                      @onchange="e => sec.AllowedRestHosts = TextToList(e.Value?.ToString())"></textarea>
                        </div>
                        <div class="form-field fa-field-full">
                            <label class="fa-label">Allowed GraphQL Hosts <span class="form-optional">(one per line)</span></label>
                            <textarea class="form-control" rows="3"
                                      value="@ListToText(sec.AllowedGraphQlHosts)"
                                      @onchange="e => sec.AllowedGraphQlHosts = TextToList(e.Value?.ToString())"></textarea>
                        </div>
                        <div class="form-field fa-field-full">
                            <label class="fa-label">Allowed CDN Hosts <span class="form-optional">(one per line)</span></label>
                            <textarea class="form-control" rows="3"
                                      value="@ListToText(sec.AllowedCdnHosts)"
                                      @onchange="e => sec.AllowedCdnHosts = TextToList(e.Value?.ToString())"></textarea>
                        </div>
                        <div class="form-field fa-field-full">
                            <label class="fa-label">Expected Security Headers <span class="form-optional">(one per line)</span></label>
                            <textarea class="form-control" rows="5"
                                      value="@ListToText(sec.ExpectedSecurityHeaders)"
                                      @onchange="e => sec.ExpectedSecurityHeaders = TextToList(e.Value?.ToString())"></textarea>
                        </div>
                    </div>
                }
                else
                {
                    var sec = profile.Security;
                    <dl class="fa-detail-list">
                        <div class="fa-dl-row"><dt>Expected Authority</dt><dd>@(sec.ExpectedAuthority ?? "—")</dd></div>
                        <div class="fa-dl-row"><dt>Expected Tenant</dt><dd>@(string.IsNullOrWhiteSpace(sec.ExpectedTenant) ? "—" : "Configured")</dd></div>
                        <div class="fa-dl-row"><dt>Expected Client ID</dt><dd>@(string.IsNullOrWhiteSpace(sec.ExpectedClientId) ? "—" : "Configured")</dd></div>
                        <div class="fa-dl-row"><dt>Allowed Redirect URLs</dt><dd>@HostList(sec.AllowedRedirectUrls)</dd></div>
                        <div class="fa-dl-row"><dt>Allowed Backend Domains</dt><dd>@HostList(sec.AllowedBackendDomains)</dd></div>
                        <div class="fa-dl-row"><dt>Allowed REST Hosts</dt><dd>@HostList(sec.AllowedRestHosts)</dd></div>
                        <div class="fa-dl-row"><dt>Allowed GraphQL Hosts</dt><dd>@HostList(sec.AllowedGraphQlHosts)</dd></div>
                        <div class="fa-dl-row"><dt>Allowed CDN Hosts</dt><dd>@HostList(sec.AllowedCdnHosts)</dd></div>
                        <div class="fa-dl-row"><dt>Expected Security Headers</dt><dd>@HostList(sec.ExpectedSecurityHeaders)</dd></div>
                    </dl>
                    <div class="fa-reset-row">
                        <SecondaryButton OnClick="RestoreSecurityExpectationsAsync" Class="fa-btn-sm">Restore Default Security Expectations</SecondaryButton>
                        <SecondaryButton OnClick="RestoreSecurityHostsAsync" Class="fa-btn-sm">Restore Default Allowed Hosts</SecondaryButton>
                        <SecondaryButton OnClick="RestoreSecurityHeadersAsync" Class="fa-btn-sm">Restore Default Expected Headers</SecondaryButton>
                    </div>
                }
            }

            @* ── Frontend Review Engines ── *@
            @if (_activeTab == "features")
            {
                var engineDraft = _isEditMode && _editProfile is not null ? _editProfile : profile;
                var engineRows = FrontendReviewEnginePresentation.Rows(engineDraft.Features, engineDraft.EngineRequirements);
                <section class="fa-engines" data-testid="frontend-review-engines" aria-labelledby="frontend-review-engines-heading">
                    <div class="fa-card-heading">
                        <h3 id="frontend-review-engines-heading">Frontend Quality Review engines</h3>
                        <span class="fa-card-status fa-card-status-muted">Saved per Target Environment</span>
                    </div>

                    @* The scope of this tab is exactly one review page; the other two read none of these. *@
                    <p class="fa-engines-scope" data-testid="engines-scope-note">@FrontendReviewEnginePresentation.ScopeNote</p>

                    @if (engineRows.Any(r => r.RequiredButDisabled))
                    {
                        <p class="fa-engines-warning" role="status" data-testid="engines-required-disabled">
                            <strong>Configuration inconsistency:</strong> @FrontendReviewEnginePresentation.RequiredButDisabledWarning(engineRows)
                        </p>
                    }

                    <div class="fa-engines-tablewrap">
                        <table class="fa-engines-table" data-testid="frontend-review-engines-table">
                            <thead>
                                <tr>
                                    <th scope="col">Engine</th>
                                    <th scope="col">Enabled</th>
                                    <th scope="col">Policy</th>
                                    <th scope="col">Requires</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in engineRows)
                                {
                                    <tr data-testid="engine-row" data-engine-id="@row.EngineId">
                                        <th scope="row">
                                            <span class="fa-engine-name">@row.DisplayName</span>
                                            <span class="fa-engine-clarification">@row.Clarification</span>
                                        </th>
                                        <td>
                                            @if (_isEditMode && _editProfile is not null)
                                            {
                                                <label class="fa-check-row">
                                                    <input type="checkbox" checked="@row.Enabled"
                                                           aria-label="@($"Enable {row.DisplayName}")"
                                                           data-testid="engine-enabled-input"
                                                           @onchange="@((ChangeEventArgs e) => FrontendReviewEnginePresentation.SetEnabled(_editProfile.Features, row.EngineId, (bool)e.Value!))" />
                                                    <span class="fa-engine-state" data-testid="engine-enabled">@(row.Enabled ? "Enabled" : "Disabled")</span>
                                                </label>
                                            }
                                            else
                                            {
                                                <span class="fa-engine-state" data-testid="engine-enabled">@(row.Enabled ? "Enabled" : "Disabled")</span>
                                            }
                                        </td>
                                        <td><span class="fa-engine-policy fa-engine-policy-@row.Policy.ToString().ToLowerInvariant()" data-testid="engine-policy">@row.Policy</span></td>
                                        <td><span class="fa-engine-requires" data-testid="engine-requires">@row.Requires</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @* Enabled is configuration; whether the engine can actually run is reported on the review page. *@
                    <p class="fa-engines-note" data-testid="engines-capability-note">@FrontendReviewEnginePresentation.EnabledVersusAvailableNote</p>
                    <p class="fa-engines-note" data-testid="engines-policy-note">@FrontendReviewEnginePresentation.RequiredPolicyNote</p>
                    @* Two-way relationship: this tab is what the profile wants; the other two say what can run and what ran. *@
                    <p class="fa-engines-note">
                        <a class="fa-engines-link" href="/frontend-quality-review" data-testid="engines-open-review">Open Frontend Quality Review to see live capability status</a>
                        <span class="fa-engines-sep"> · </span>
                        <a class="fa-engines-link" href="@FrontendQualityTargetAccess.FrontendEngineCapabilitiesHref" data-testid="engines-open-capabilities">View system capability details</a>
                    </p>

                    @if (!_isEditMode)
                    {
                        <div class="fa-reset-row">
                            <SecondaryButton OnClick="RestoreFeatureTogglesAsync" Class="fa-btn-sm">Restore default engine configuration</SecondaryButton>
                        </div>
                    }
                </section>
            }

            @* ── Validation ── *@
            @if (_activeTab == "validation")
            {
                var v = FaSettings.ValidateProfile(profile);
                <dl class="fa-detail-list" style="margin-bottom:1.5rem">
                    <div class="fa-dl-row"><dt>Detection freshness</dt><dd>@(IsDetectionStale ? "Stale" : _detectionResult is null ? "Not checked" : "Current")</dd></div>
                    @if (SelectedTestingMethod == AuthenticatedTestingMethod.ManagedEdgeCdp)
                    {
                        <div class="fa-dl-row"><dt>Manual sign-in</dt><dd>@(EdgeStatus.AuthenticatedBrowserAvailable ? "Completed - browser access verified" : "Required for authenticated browser access")</dd></div>
                        <div class="fa-dl-row"><dt>Managed Edge connection</dt><dd>@AuthenticatedTestingMethodLabels.Connection(EdgeStatus.State)</dd></div>
                    }
                    <div class="fa-dl-row"><dt>Authenticated testing method</dt><dd data-testid="validation-testing-method">@AuthenticatedTestingMethodLabels.Option(profile.Authentication.AuthenticatedTestingMethod)</dd></div>
                    <div class="fa-dl-row"><dt>Local HTTPS proxy</dt><dd data-testid="validation-proxy-state">@(profile.Authentication.AuthenticatedTestingMethod == AuthenticatedTestingMethod.LocalHttpsProxy ? $"{AuthenticatedTestingMethodLabels.ProxyState(ProxyStatus.State)} · {ProxyStatus.Endpoint}" : "Not selected")</dd></div>
                    <div class="fa-dl-row"><dt>Authenticated API context</dt><dd data-testid="validation-proxy-credential">@(profile.Authentication.AuthenticatedTestingMethod == AuthenticatedTestingMethod.LocalHttpsProxy ? AuthenticatedTestingMethodLabels.Credential(ProxyStatus) : "—")</dd></div>
                    <div class="fa-dl-row"><dt>Public surface</dt><dd data-testid="validation-coverage-public">@Coverage.PublicSurface</dd></div>
                    <div class="fa-dl-row"><dt>Authenticated API surface</dt><dd data-testid="validation-coverage-api">@Coverage.AuthenticatedApiSurface</dd></div>
                    <div class="fa-dl-row"><dt>Authenticated browser DOM surface</dt><dd data-testid="validation-coverage-dom">@Coverage.AuthenticatedBrowserDomSurface</dd></div>
                    @if (SelectedTestingMethod == AuthenticatedTestingMethod.ManagedEdgeCdp)
                    {
                    <div class="fa-dl-row"><dt>Browser trust configuration</dt><dd data-testid="validation-trust-configuration">@BrowserDeliveryTrustLabels.Configuration(profile)</dd></div>
                    <div class="fa-dl-row"><dt>Configured trust</dt><dd data-testid="validation-configured-trust">@BrowserDeliveryTrustLabels.Policy(profile.Authentication.BrowserDeliveryTrust)</dd></div>
                    <div class="fa-dl-row"><dt>Observed delivery</dt><dd data-testid="validation-observed-delivery">@BrowserDeliveryTrustLabels.Delivery(EdgeStatus)</dd></div>
                    <div class="fa-dl-row"><dt>Correlation</dt><dd data-testid="validation-correlation">@BrowserDeliveryTrustLabels.Correlation(EdgeStatus)</dd></div>
                    <div class="fa-dl-row"><dt>Trust decision</dt><dd data-testid="validation-trust-decision">@BrowserDeliveryTrustLabels.ValidationDecision(EdgeStatus)</dd></div>
                    <div class="fa-dl-row"><dt>Authenticated access</dt><dd>@(EdgeStatus.AuthenticatedBrowserAvailable ? "Verified" : "Not verified")</dd></div>
                    }
                    <div class="fa-dl-row">
                        <dt>Configuration validation</dt>
                        <dd>
                            @if (v.IsValid && v.Warnings.Count == 0)
                            {
                                <span class="fa-validation-ok-inline">✓ Configuration valid — no configuration errors</span>
                            }
                            else if (v.Errors.Count == 0 && v.Warnings.Count > 0)
                            {
                                <span style="color:var(--color-warning)">⚠ Valid with @v.Warnings.Count warning(s)</span>
                            }
                            else
                            {
                                <span style="color:var(--color-error)">✕ @v.Errors.Count error(s)</span>
                            }
                        </dd>
                    </div>
                    <div class="fa-dl-row">
                        <dt>Activation readiness</dt>
                        <dd>
                            @if (!DetectionReady)
                            {
                                <span style="color:var(--color-text-muted)">Not ready — @DetectionReadinessReason</span>
                            }
                            else if (!_isEditMode || IsDirty == false)
                            {
                                <span class="fa-validation-ok-inline">✓ Ready for activation</span>
                            }
                            else if (_isEditMode && IsDirty)
                            {
                                <span style="color:var(--color-warning)">⚠ Unsaved changes — save changes before activation</span>
                            }
                        </dd>
                    </div>
                </dl>
                @if (v.Errors.Count > 0 || v.Warnings.Count > 0)
                {
                    <div class="fa-issue-cards">
                        <div style="font-weight:600;margin-bottom:0.75rem;font-size:0.875rem">Configuration Issues</div>
                        @foreach (var err in v.Errors)
                        {
                            <div class="fa-issue-card fa-issue-card-error">
                                <span class="fa-issue-sev fa-issue-sev-error">Error</span>
                                <span class="fa-issue-body">@err</span>
                            </div>
                        }
                        @foreach (var warn in v.Warnings)
                        {
                            <div class="fa-issue-card fa-issue-card-warning">
                                <span class="fa-issue-sev fa-issue-sev-warning">Warning</span>
                                <span class="fa-issue-body">@warn</span>
                            </div>
                        }
                    </div>
                }
            }

            @* ── Integrations ── *@
            @if (_activeTab == "integrations")
            {
                @if (_isEditMode && _editProfile is not null)
                {
                    @* Neutral guidance, not a warning: this states where the configuration is consumed. *@
                    <div class="fa-integrations-head">
                        <p class="fa-integrations-note" data-testid="fa-integrations-note">Configure service integrations used by Integration Quality Review. Observed REST and GraphQL traffic is shown in Endpoint Discovery and is not added here automatically.</p>
                        <SecondaryButton OnClick="BeginAddIntegration" Class="fa-btn-sm">+ Add Integration</SecondaryButton>
                    </div>

                    @* Add flow: either a template evidenced for this environment, or an empty custom integration. *@
                    @if (_addingIntegration)
                    {
                        <div class="fa-add-integration" data-testid="fa-add-integration-flow">
                            @* Selectable cards over real radio inputs: the choice matters, and native radios keep
                               arrow-key selection, grouping and the exposed checked state for free. *@
                            <fieldset class="fa-add-mode">
                                <legend class="fa-label">Add integration</legend>
                                <div class="fa-add-mode-options">
                                    <label class="fa-add-mode-card @(_addMode == "known" ? "fa-add-mode-card-selected" : "")">
                                        <input type="radio" name="fa-add-mode" data-testid="fa-add-mode-known"
                                               checked="@(_addMode == "known")"
                                               @onchange="@(() => SetAddMode("known"))" />
                                        <span class="fa-add-mode-body">
                                            <span class="fa-add-mode-title">Known M2LB integration</span>
                                            <span class="fa-add-mode-help">Use a predefined integration template when one is available for this environment.</span>
                                        </span>
                                    </label>
                                    <label class="fa-add-mode-card @(_addMode == "custom" ? "fa-add-mode-card-selected" : "")">
                                        <input type="radio" name="fa-add-mode" data-testid="fa-add-mode-custom"
                                               checked="@(_addMode == "custom")"
                                               @onchange="@(() => SetAddMode("custom"))" />
                                        <span class="fa-add-mode-body">
                                            <span class="fa-add-mode-title">Custom integration</span>
                                            <span class="fa-add-mode-help">Configure an integration manually.</span>
                                            <span class="fa-add-mode-types">Supports: REST, GraphQL, Event Hub, Service Bus, Kafka, RabbitMQ</span>
                                        </span>
                                    </label>
                                </div>
                            </fieldset>

                            @if (_addMode == "known")
                            {
                                @if (_knownTemplates.Count == 0)
                                {
                                    @* The catalogue is reusable knowledge, so this is only ever a load failure. *@
                                    <div class="fa-templates-empty" data-testid="fa-templates-empty">
                                        <p class="fa-templates-empty-title">The known M2LB templates could not be loaded.</p>
                                        <p class="fa-templates-empty-help">You can configure a custom integration instead.</p>
                                        <SecondaryButton OnClick="@(() => SetAddMode("custom"))" Class="fa-btn-sm" data-testid="fa-templates-empty-custom">
                                            Configure custom integration
                                        </SecondaryButton>
                                    </div>
                                }
                                else
                                {
                                    <label class="fa-label" for="fa-template-select">Template</label>
                                    @* Grouped by transport so a long catalogue stays scannable. *@
                                    <select id="fa-template-select" class="form-control" data-testid="fa-template-select"
                                            @onchange="OnTemplateSelected">
                                        <option value="">Select a template...</option>
                                        @foreach (var group in _knownTemplates.GroupBy(v => v.Template.IntegrationType).OrderBy(g => g.Key.ToString(), StringComparer.Ordinal))
                                        {
                                            <optgroup label="@IntegrationConfigPresenter.TypeLabel(group.Key)" data-testid="fa-template-group">
                                                @foreach (var view in group.OrderBy(v => v.Template.DisplayName, StringComparer.Ordinal))
                                                {
                                                    <option value="@view.Template.Id">@view.Template.DisplayName</option>
                                                }
                                            </optgroup>
                                        }
                                    </select>

                                    @* Preview before committing, in two clearly separate halves: what the template
                                       knows (reusable, the same in every environment) and what this environment
                                       binds it to (specific, and unknown until someone establishes it). *@
                                    @if (SelectedTemplate is { } templateView)
                                    {
                                        var preview = templateView.Template;
                                        <dl class="fa-template-preview" data-testid="fa-template-preview">
                                            <div><dt colspan="2" class="fa-template-group-label">Template</dt><dd></dd></div>
                                            <div><dt>Type</dt><dd>@IntegrationConfigPresenter.TypeLabel(preview.IntegrationType)</dd></div>
                                            @if (!string.IsNullOrWhiteSpace(preview.SuggestedProducer))
                                            {
                                                <div><dt>Producer</dt><dd data-testid="fa-template-producer">@preview.SuggestedProducer</dd></div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(preview.SuggestedConsumer))
                                            {
                                                <div><dt>Consumer</dt><dd data-testid="fa-template-consumer">@preview.SuggestedConsumer</dd></div>
                                            }
                                            <div><dt>Source</dt><dd data-testid="fa-template-source">@IntegrationConfigPresenter.SourceLabel(IntegrationConfigurationSource.CodeSuggested)</dd></div>
                                        </dl>

                                        <dl class="fa-template-preview fa-template-binding" data-testid="fa-template-binding">
                                            <div><dt colspan="2" class="fa-template-group-label" data-testid="fa-template-binding-heading">@EnvironmentValuesLabel values</dt><dd></dd></div>
                                            @* An unknown value is stated as unknown for THIS environment. It is never
                                               filled in from another environment's binding. *@
                                            <div>
                                                <dt>Resource</dt>
                                                <dd class="fa-template-mono" data-testid="fa-template-resource">
                                                    @(templateView.Binding?.Resource is { Length: > 0 } boundResource
                                                        ? boundResource
                                                        : $"Not defined for {EnvironmentValuesLabel}")
                                                </dd>
                                            </div>
                                            <div>
                                                <dt>Namespace</dt>
                                                <dd class="fa-template-mono" data-testid="fa-template-namespace">
                                                    @(templateView.Binding?.EndpointOrNamespace is { Length: > 0 } boundNamespace
                                                        ? boundNamespace
                                                        : $"Not defined for {EnvironmentValuesLabel}")
                                                </dd>
                                            </div>
                                            @* Service Bus has subscriptions, not consumer groups, so the field is absent. *@
                                            @if (preview.IntegrationType is IntegrationType.EventHub or IntegrationType.Kafka)
                                            {
                                                <div>
                                                    <dt>Consumer group</dt>
                                                    <dd data-testid="fa-template-consumer-group">
                                                        @(templateView.Binding?.ConsumerGroup is { Length: > 0 } boundGroup
                                                            ? boundGroup
                                                            : $"Not defined for {EnvironmentValuesLabel}")
                                                    </dd>
                                                </div>
                                            }
                                        </dl>

                                        @if (!string.IsNullOrWhiteSpace(preview.RelationshipNote))
                                        {
                                            <p class="fa-section-note" data-testid="fa-template-note">@preview.RelationshipNote</p>
                                        }

                                        @if (templateView.NeedsConfiguration)
                                        {
                                            @* The integration cannot carry a stable structural identity yet, so it is
                                               not saved half-described; the missing values are asked for instead. *@
                                            <div class="fa-template-required" data-testid="fa-template-required">
                                                <p class="fa-template-required-title" data-testid="fa-template-required-reason">
                                                    @string.Join(", ", templateView.MissingRequiredFields) must be configured for @EnvironmentValuesLabel before this template can be added.
                                                </p>
                                                @foreach (var field in templateView.MissingRequiredFields)
                                                {
                                                    <label class="fa-label" for="@($"fa-template-field-{field}")">@field <span aria-hidden="true">*</span></label>
                                                    <input id="@($"fa-template-field-{field}")" class="form-control" type="text"
                                                           data-testid="@($"fa-template-field-{field}")"
                                                           value="@SuppliedValue(field)"
                                                           @onchange="e => SetSuppliedValue(field, e.Value?.ToString())" />
                                                }
                                            </div>
                                        }

                                        @if (ExistingForTemplate(templateView) is not null)
                                        {
                                            <p class="fa-section-note" data-testid="fa-template-existing">This integration is already configured. Adding it fills in any values that are still blank and keeps everything you entered.</p>
                                        }
                                        <SecondaryButton OnClick="AddSelectedTemplate" Class="fa-btn-sm" data-testid="fa-template-add"
                                                         Disabled="@(!TemplateStructurallyComplete(templateView))">Add integration</SecondaryButton>
                                    }
                                }
                            }
                            else
                            {
                                <SecondaryButton OnClick="AddCustomIntegration" Class="fa-btn-sm" data-testid="fa-add-custom-confirm">
                                    Add custom integration
                                </SecondaryButton>
                            }
                        </div>
                    }

                    @if (_editProfile.Integrations.Count == 0)
                    {
                        <div class="fa-empty-state" style="padding:.75rem;font-size:.85rem">
                            No integrations configured. Click <strong>+ Add Integration</strong> to add one.
                        </div>
                    }
                    else
                    {
                        @* One list of configured integrations. The former Detected / Configured split partitioned this
                           same collection by provenance, but no production path ever writes EndpointDiscovery here, so
                           the Detected half could never populate. Observed REST/GraphQL traffic lives in Endpoint
                           Discovery; each row below still carries its own provenance label. *@
                        @foreach (var intg in _editProfile.Integrations)
                        {
                            var isExpanded = _editingIntegrationId == intg.Id;
                            <div class="fa-integration-row" style="border:1px solid var(--clr-border);border-radius:var(--radius-md);margin-bottom:.5rem">
                                <button class="fa-integration-toggle"
                                        style="width:100%;background:var(--clr-surface);border:none;border-radius:var(--radius-md);cursor:pointer;display:flex;align-items:center;gap:.6rem;padding:.55rem .75rem;text-align:left"
                                        @onclick="() => _editingIntegrationId = isExpanded ? null : intg.Id">
                                    <span style="font-weight:700;font-size:.82rem;background:var(--clr-bg,#f1f5f9);border:1px solid var(--clr-border);border-radius:3px;padding:.1rem .4rem;min-width:4rem;text-align:center">@intg.Type</span>
                                    <span style="flex:1;font-size:.88rem;color:var(--clr-text-heading)">@(string.IsNullOrWhiteSpace(intg.Name) ? "(unnamed)" : intg.Name)</span>
                                    <span style="font-size:.72rem;color:var(--clr-text-subtle)" data-testid="fa-integration-source">@IntegrationConfigPresenter.SourceLabel(intg.ConfigurationSource)</span>
                                    @if (!IntegrationConfigPresenter.IsComplete(intg))
                                    {
                                        <span style="font-size:.72rem" data-testid="fa-integration-incomplete">@IntegrationConfigPresenter.ConfigurationState(intg)</span>
                                    }
                                    @if (!intg.Enabled)
                                    { <span style="font-size:.74rem;color:var(--clr-text-subtle)">Disabled</span> }
                                    <span style="font-size:.7rem;color:var(--clr-text-placeholder)">@(isExpanded ? "▲" : "▼")</span>
                                    <button @onclick="() => RemoveIntegration(intg.Id)"
                                            @onclick:stopPropagation="true"
                                            style="background:none;border:none;color:var(--clr-danger);cursor:pointer;font-size:.8rem;padding:.1rem .3rem"
                                            title="Remove integration">✕</button>
                                </button>

                                @if (isExpanded)
                                {
                                    <div class="fa-form-grid" style="padding:.65rem .75rem;border-top:1px solid var(--clr-border)">
                                        <div class="form-field">
                                            <label class="fa-label">Name <span class="wsr-required">*</span></label>
                                            <input type="text" class="form-control" placeholder="e.g. Order Events" @bind="intg.Name" />
                                        </div>
                                        <div class="form-field">
                                            <label class="fa-label">Type</label>
                                            <select class="form-control" @bind="intg.Type">
                                                @foreach (var t in Enum.GetValues<IntegrationType>())
                                                { <option value="@t">@t</option> }
                                            </select>
                                        </div>
                                        @* Transport-aware fields. Labels and visibility follow
                                           IntegrationConfigPresenter so the editor cannot drift from
                                           the rules the review and readiness checks use. *@
                                        <div class="form-field fa-field-full">
                                            <label class="fa-label" for="@($"fa-endpoint-{intg.Id}")">@EndpointLabel(intg.Type)</label>
                                            <input id="@($"fa-endpoint-{intg.Id}")" type="text" class="form-control"
                                                   data-testid="fa-field-endpoint"
                                                   placeholder="@EndpointPlaceholder(intg.Type)" @bind="intg.Endpoint" />
                                        </div>

                                        @if (IntegrationConfigPresenter.ShowsResourceKind(intg))
                                        {
                                            <div class="form-field">
                                                <label class="fa-label" for="@($"fa-kind-{intg.Id}")">Resource kind</label>
                                                <select id="@($"fa-kind-{intg.Id}")" class="form-control"
                                                        data-testid="fa-field-resourcekind" @bind="intg.ResourceKind">
                                                    <option value="@IntegrationResourceKind.Unknown">Select...</option>
                                                    @foreach (var kind in IntegrationConfigPresenter.ResourceKindChoices(intg.Type))
                                                    {
                                                        <option value="@kind">@IntegrationConfigPresenter.ResourceKindLabel(kind)</option>
                                                    }
                                                </select>
                                            </div>
                                        }

                                        @if (intg.Type != IntegrationType.REST && intg.Type != IntegrationType.GraphQL)
                                        {
                                            <div class="form-field">
                                                <label class="fa-label" for="@($"fa-resource-{intg.Id}")">@ResourceLabel(intg.Type)</label>
                                                <input id="@($"fa-resource-{intg.Id}")" type="text" class="form-control"
                                                       data-testid="fa-field-resource"
                                                       placeholder="@ResourcePlaceholder(intg.Type)" @bind="intg.Resource" />
                                            </div>
                                        }

                                        @if (IntegrationConfigPresenter.ShowsConsumerGroup(intg))
                                        {
                                            <div class="form-field">
                                                <label class="fa-label" for="@($"fa-consumergroup-{intg.Id}")">Consumer group</label>
                                                <input id="@($"fa-consumergroup-{intg.Id}")" type="text" class="form-control"
                                                       data-testid="fa-field-consumergroup"
                                                       placeholder="e.g. $Default" @bind="intg.Consumer" />
                                            </div>
                                        }
                                        else if (IntegrationConfigPresenter.ShowsSubscriptionName(intg))
                                        {
                                            <div class="form-field">
                                                <label class="fa-label" for="@($"fa-subscription-{intg.Id}")">Subscription name</label>
                                                <input id="@($"fa-subscription-{intg.Id}")" type="text" class="form-control"
                                                       data-testid="fa-field-subscription"
                                                       placeholder="e.g. my-subscription" @bind="intg.Consumer" />
                                            </div>
                                        }

                                        <div class="form-field">
                                            <label class="fa-label" for="@($"fa-producer-{intg.Id}")">Producer <span class="form-optional">(optional)</span></label>
                                            <input id="@($"fa-producer-{intg.Id}")" type="text" class="form-control"
                                                   data-testid="fa-field-producer"
                                                   placeholder="Unknown if not known" @bind="intg.LogicalProducerService" />
                                        </div>
                                        <div class="form-field">
                                            <label class="fa-label" for="@($"fa-consumer-{intg.Id}")">Consumer <span class="form-optional">(optional)</span></label>
                                            <input id="@($"fa-consumer-{intg.Id}")" type="text" class="form-control"
                                                   data-testid="fa-field-consumer"
                                                   placeholder="Unknown if not known" @bind="intg.LogicalConsumerService" />
                                        </div>

                                        @{
                                            var missingFields = IntegrationConfigPresenter.MissingRequiredFields(intg);
                                        }
                                        @if (missingFields.Count > 0)
                                        {
                                            <p class="form-field fa-field-full" data-testid="fa-missing-fields"
                                               id="@($"fa-missing-{intg.Id}")" role="status">
                                                Configuration incomplete. Missing: @string.Join(", ", missingFields).
                                            </p>
                                        }
                                        <div class="form-field">
                                            <label class="fa-label">Authentication Type</label>
                                            <select class="form-control" @bind="intg.AuthType">
                                                @foreach (var t in Enum.GetValues<IntegrationAuthType>())
                                                { <option value="@t">@t</option> }
                                            </select>
                                        </div>
                                        <div class="form-field">
                                            <label class="fa-label">Owner <span class="form-optional">(team or contact)</span></label>
                                            <input type="text" class="form-control" placeholder="e.g. platform-team" @bind="intg.Owner" />
                                        </div>
                                        <div class="form-field fa-field-full">
                                            <label class="fa-label">Health URL <span class="form-optional">(optional)</span></label>
                                            <input type="url" class="form-control" placeholder="https://..." @bind="intg.HealthUrl" />
                                        </div>
                                        <div class="form-field fa-field-full">
                                            <label class="fa-label">Worker URL <span class="form-optional">(optional)</span></label>
                                            <input type="url" class="form-control" placeholder="https://..." @bind="intg.WorkerUrl" />
                                        </div>
                                        <div class="form-field fa-field-full">
                                            <label class="fa-label">Monitoring URL <span class="form-optional">(runbook / dashboard)</span></label>
                                            <input type="url" class="form-control" placeholder="https://..." @bind="intg.MonitoringUrl" />
                                        </div>
                                        <div class="form-field">
                                            <label class="fa-label">
                                                <input type="checkbox" @bind="intg.Enabled" style="margin-right:.4rem" />
                                                Enabled
                                            </label>
                                        </div>

                                        @* Contract Relationship Section (Phase 2) *@
                                        <details class="fa-advanced" style="margin-top:.75rem;padding-top:.75rem;border-top:1px solid var(--clr-border)">
                                            <summary style="cursor:pointer;font-weight:600;font-size:.85rem">
                                                Contract Relationship
                                                <span style="font-size:.75rem;margin-left:.5rem;color:var(--clr-text-muted)">
                                                    @{
                                                        intg.ComputeReadiness();
                                                        var readinessLabel = intg.ContractMetadataReadiness switch
                                                        {
                                                            ContractMetadataReadiness.Ready => "✓ Ready",
                                                            ContractMetadataReadiness.Partial => "◐ Partial",
                                                            _ => "○ Not configured"
                                                        };
                                                        <text>@readinessLabel</text>
                                                    }
                                                </span>
                                            </summary>
                                            <div style="margin-top:.65rem;padding:.65rem 0">
                                                <div class="form-field">
                                                    <label class="fa-label">Producer Service <span class="form-optional">(optional)</span></label>
                                                    <input type="text" class="form-control"
                                                           placeholder="e.g. Hendelse Adapter"
                                                           @bind="intg.LogicalProducerService"
                                                           @bind:after="() => intg.ComputeReadiness()"
                                                           style="margin-bottom:.1rem" />
                                                    <div style="font-size:.75rem;color:var(--clr-text-muted)">Logical service name that produces to this integration</div>
                                                </div>

                                                <div class="form-field">
                                                    <label class="fa-label">Consumer Service <span class="form-optional">(optional)</span></label>
                                                    <input type="text" class="form-control"
                                                           placeholder="e.g. Hendelse"
                                                           @bind="intg.LogicalConsumerService"
                                                           @bind:after="() => intg.ComputeReadiness()"
                                                           style="margin-bottom:.1rem" />
                                                    <div style="font-size:.75rem;color:var(--clr-text-muted)">Logical service name that consumes from this integration</div>
                                                </div>

                                                <div class="form-field">
                                                    <label class="fa-label">Contract Name <span class="form-optional">(optional)</span></label>
                                                    <input type="text" class="form-control"
                                                           placeholder="e.g. ChildUpdated"
                                                           @bind="intg.ContractName"
                                                           @bind:after="() => intg.ComputeReadiness()"
                                                           style="margin-bottom:.1rem" />
                                                    <div style="font-size:.75rem;color:var(--clr-text-muted)">Name of the contract/event/message exchanged</div>
                                                </div>

                                                <div class="form-field">
                                                    <label class="fa-label">Contract Source Type <span class="form-optional">(optional)</span></label>
                                                    <select class="form-control"
                                                            @bind="intg.ContractSourceType"
                                                            @bind:after="() => intg.ComputeReadiness()"
                                                            style="margin-bottom:.1rem">
                                                        @foreach (var t in Enum.GetValues<ContractSourceType>())
                                                        { <option value="@t">@t</option> }
                                                    </select>
                                                    <div style="font-size:.75rem;color:var(--clr-text-muted)">Where the contract definition comes from</div>
                                                </div>

                                                <div class="form-field fa-field-full">
                                                    <label class="fa-label">Source Location <span class="form-optional">(optional)</span></label>
                                                    <input type="text" class="form-control"
                                                           placeholder="e.g. URL, file path, or artifact reference"
                                                           @bind="intg.ContractSourceLocation"
                                                           @bind:after="() => intg.ComputeReadiness()"
                                                           style="margin-bottom:.1rem" />
                                                    <div style="font-size:.75rem;color:var(--clr-text-muted)">
                                                        @{
                                                            var hint = intg.ContractSourceType switch
                                                            {
                                                                ContractSourceType.OpenApi => "Swagger/OpenAPI URL (e.g., https://api.example.com/swagger/v1/swagger.json)",
                                                                ContractSourceType.GraphQlSchema => "GraphQL endpoint URL (e.g., https://api.example.com/graphql)",
                                                                ContractSourceType.Assembly => "Assembly reference (e.g., BirkNext.Contracts.v1.0)",
                                                                ContractSourceType.SchemaFile => "Schema file path (e.g., schemas/contract.json)",
                                                                ContractSourceType.Endpoint => "Contract endpoint URL",
                                                                ContractSourceType.Manual => "Manual entry (free text)",
                                                                _ => "Reference to contract definition"
                                                            };
                                                            <text>@hint</text>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </details>
                                    </div>
                                }
                            </div>
                        }
                    }
                }
                else
                {
                    @if (profile.Integrations.Count == 0)
                    {
                        <div class="fa-empty-state" style="padding:.75rem;font-size:.85rem">
                            No integrations configured. Switch to Edit mode to add integrations.
                        </div>
                    }
                    else
                    {
                        <table style="width:100%;border-collapse:collapse;font-size:.83rem">
                            <thead>
                                <tr style="background:var(--clr-bg,#f8fafc);text-align:left">
                                    <th style="padding:.45rem .65rem;border-bottom:1px solid var(--clr-border)">Name</th>
                                    <th style="padding:.45rem .65rem;border-bottom:1px solid var(--clr-border)">Type</th>
                                    <th style="padding:.45rem .65rem;border-bottom:1px solid var(--clr-border)">Endpoint</th>
                                    <th style="padding:.45rem .65rem;border-bottom:1px solid var(--clr-border)">Resource</th>
                                    <th style="padding:.45rem .65rem;border-bottom:1px solid var(--clr-border)">Consumer</th>
                                    <th style="padding:.45rem .65rem;border-bottom:1px solid var(--clr-border)">Auth</th>
                                    <th style="padding:.45rem .65rem;border-bottom:1px solid var(--clr-border)">Owner</th>
                                    <th style="padding:.45rem .65rem;border-bottom:1px solid var(--clr-border)">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var intg in profile.Integrations)
                                {
                                    <tr style="border-bottom:1px solid var(--clr-border-subtle)">
                                        <td style="padding:.4rem .65rem;font-weight:600;color:var(--clr-text-heading)">@intg.Name</td>
                                        <td style="padding:.4rem .65rem;color:var(--clr-text-muted)">@intg.Type</td>
                                        <td style="padding:.4rem .65rem;font-family:var(--font-mono);font-size:.76rem;color:var(--clr-text-subtle)">@(intg.Endpoint ?? "—")</td>
                                        <td style="padding:.4rem .65rem;color:var(--clr-text-muted)">@(intg.Resource ?? "—")</td>
                                        <td style="padding:.4rem .65rem;color:var(--clr-text-muted)">@(intg.Consumer ?? "—")</td>
                                        <td style="padding:.4rem .65rem;color:var(--clr-text-muted)">@intg.AuthType</td>
                                        <td style="padding:.4rem .65rem;color:var(--clr-text-muted)">@(intg.Owner ?? "—")</td>
                                        <td style="padding:.4rem .65rem">
                                            @if (intg.Enabled)
                                            { <span style="color:var(--clr-success);font-weight:700;font-size:.78rem">Enabled</span> }
                                            else
                                            { <span style="color:var(--clr-text-subtle);font-size:.78rem">Disabled</span> }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                }
            }

        </div>

        @* ── Reset entire profile ── *@
        @if (!_isEditMode)
        {
            <div class="fa-profile-reset-zone">
                <span class="fa-profile-reset-label">Reset entire profile to defaults — keeps Name, Environment Type, Target URL, and Notes.</span>
                <SecondaryButton OnClick="@(() => _showResetConfirm = true)" Class="fa-btn-sm">Reset Profile</SecondaryButton>
            </div>
        }

    </div>
}
else if (FaSettings.Settings.Profiles.Count == 0)
{
    <div class="fa-empty-state">
        No environments found. Add an environment to get started.
    </div>
}

@* ── Create Profile Modal ─────────────────────────────────────────────────── *@
@if (_showCreateDialog)
{
    <div class="modal-backdrop" @onclick="() => _showCreateDialog = false" role="dialog" aria-modal="true" aria-labelledby="fa-create-title">
        <div class="modal-panel" @onclick:stopPropagation="true">
            <h2 id="fa-create-title" class="modal-title">Add Environment</h2>
            <div class="fa-form-grid">
                <div class="form-field fa-field-full">
                    <label class="fa-label" for="fa-create-name">Environment Name <span class="wsr-required">*</span></label>
                    <input id="fa-create-name" type="text" class="form-control" @bind="_newProfileName" placeholder="e.g. Staging" autofocus />
                </div>
                <div class="form-field fa-field-full">
                    <label class="fa-label" for="fa-create-type">Environment Type</label>
                    <select id="fa-create-type" class="form-control" @bind="_newProfileEnv">
                        @foreach (var env in Enum.GetValues<FrontendEnvironmentType>())
                        {
                            <option value="@env">@env</option>
                        }
                    </select>
                </div>
                <div class="form-field fa-field-full">
                    <label class="fa-label" for="fa-create-url">Frontend Base URL</label>
                    <input id="fa-create-url" type="url" class="form-control" @bind="_newProfileUrl" @bind:event="oninput"
                           placeholder="https://your-application.example.com/" aria-describedby="fa-create-url-help" />
                    <small id="fa-create-url-help">Optional. Add the frontend URL to run Detect settings after creation.</small>
                    @if (!IsNewProfileUrlValid)
                    {
                        <div role="alert">Target URL is not a valid absolute URL.</div>
                    }
                </div>
            </div>
            <div class="modal-actions">
                <SecondaryButton OnClick="@(() => _showCreateDialog = false)">Cancel</SecondaryButton>
                <PrimaryButton OnClick="CreateProfileAsync"
                               Disabled="@(string.IsNullOrWhiteSpace(_newProfileName) || !IsNewProfileUrlValid)">Add Environment</PrimaryButton>
            </div>
        </div>
    </div>
}

@* ── Delete Confirmation Modal ────────────────────────────────────────────── *@
@if (_showDeleteConfirm)
{
    <div class="modal-backdrop" @onclick="() => _showDeleteConfirm = false" role="dialog" aria-modal="true" aria-labelledby="fa-delete-title">
        <div class="modal-panel" @onclick:stopPropagation="true">
            <h2 id="fa-delete-title" class="modal-title">Delete Environment</h2>
            <div class="notification notification-warning">
                This will permanently delete the environment <strong>@SelectedProfile?.Name</strong> and all its settings.
            </div>
            <div class="modal-actions">
                <SecondaryButton OnClick="@(() => _showDeleteConfirm = false)" Disabled="@_isDeleting">Cancel</SecondaryButton>
                <DangerButton OnClick="ExecuteDeleteAsync" Disabled="@_isDeleting">
                    @(_isDeleting ? "Deleting…" : "Delete Environment")
                </DangerButton>
            </div>
        </div>
    </div>
}

@* ── Reset Profile Confirmation Modal ────────────────────────────────────── *@
@if (_showResetConfirm)
{
    <div class="modal-backdrop" @onclick="() => _showResetConfirm = false" role="dialog" aria-modal="true" aria-labelledby="fa-reset-title">
        <div class="modal-panel" @onclick:stopPropagation="true">
            <h2 id="fa-reset-title" class="modal-title">Reset Profile</h2>
            <div class="notification notification-warning">
                This resets Performance Thresholds, Core Web Vitals, Security Expectations, and Feature Toggles to defaults.
                Profile Name, Environment Type, Target URL, and Notes are kept.
            </div>
            <div class="modal-actions">
                <SecondaryButton OnClick="@(() => _showResetConfirm = false)" Disabled="@_isResetting">Cancel</SecondaryButton>
                <DangerButton OnClick="ResetProfileAsync" Disabled="@_isResetting">
                    @(_isResetting ? "Resetting…" : "Reset Profile")
                </DangerButton>
            </div>
        </div>
    </div>
}

@code {
    // ── State ────────────────────────────────────────────────────────────────

    private string?                  _selectedProfileId;
    private bool                     _isEditMode;
    private FrontendAnalysisProfile? _editProfile;
    /// <summary>
    /// Tab to open initially, supplied by the host from the "tab=" query key (e.g. Frontend Quality Review's
    /// "Edit engines" deep link). Ignored when it does not name a known tab; user tab clicks always win afterwards.
    /// </summary>
    [Parameter] public string? InitialTab { get; set; }

    private string                   _activeTab = "general";
    private string?                  _appliedInitialTab;

    private string? _saveSuccess;
    private string? _saveError;
    private bool    _isSaving;

    private bool   _showCreateDialog;
    private string _newProfileName = "";
    private string _newProfileUrl = "";
    private bool IsNewProfileUrlValid => string.IsNullOrWhiteSpace(_newProfileUrl) ||
        FrontendAnalysisSettingsService.IsValidUrl(_newProfileUrl);
    private FrontendEnvironmentType _newProfileEnv = FrontendEnvironmentType.Local;

    private bool _showDeleteConfirm;
    private bool _isDeleting;

    private bool _showResetConfirm;
    private bool _isResetting;

    // Detection state - Current lifecycle (NOT persisted, semantically tracked via ComputeDetectionState)
    private bool _isDetecting;
    private string? _detectionError;
    private TargetEnvironmentDetectionResult? _detectionResult;
    private bool? _browserRuntimeInspectionRequired;
    private string? _originalProfileJson;
    private string? _originalAuthenticationJson;
    private string? _lastDetectionTargetUrl;
    // True when _detectionResult was rehydrated from a persisted DetectionSnapshot (a previous application session), not detected now.
    private bool _detectionRestored;
    // Optional freshness limit: a restored detection older than this revalidates as Stale (re-detect required). Live in-session detection is never aged out.
    private static readonly TimeSpan DetectionFreshness = TimeSpan.FromDays(14);
    // Profile the current detection evidence belongs to (target discovery identity, not verification context)
    private string? _detectionProfileId;
    // Deep copy of the profile as it was when detection ran; lets applied detector proposals be
    // recognised as evidence-consistent rather than as detection-invalidating edits.
    private FrontendAnalysisProfile? _detectionProfileSnapshot;
    private AuthenticationFailureReason? _authenticationFailureReason;

    // Browser detection state (Phase 2)
    private bool _browserDetectionInProgress;
    private string? _browserDetectionMessage;
    private string? _currentBrowserDetectionAttemptId;

    private static readonly (string Key, string Label)[] Tabs =
    [
        ("general",     "General"),
        ("target",      "Target Application"),
        ("auth",        "Authentication"),
        ("endpoint",    "Endpoint Discovery"),
        ("browser",     "Browser Discovery"),
        ("performance", "Performance Thresholds"),
        ("cwv",         "Core Web Vitals"),
        ("security",    "Security Expectations"),
        ("features",    "Frontend Review Engines"),
        ("validation",    "Validation"),
        ("integrations",  "Integrations"),
    ];

    // ── Computed ─────────────────────────────────────────────────────────────

    private readonly ElementReference[] _tabElements = new ElementReference[Tabs.Length];
    private async Task SectionTabKey(KeyboardEventArgs e, string key)
    {
        if (e.Key is not ("ArrowLeft" or "ArrowRight" or "Home" or "End")) return;
        var index = Array.FindIndex(Tabs, t => t.Key == key);
        index = e.Key == "Home" ? 0 : e.Key == "End" ? Tabs.Length - 1
            : (index + (e.Key == "ArrowRight" ? 1 : -1) + Tabs.Length) % Tabs.Length;
        _activeTab = Tabs[index].Key;
        await _tabElements[index].FocusAsync(preventScroll: true);
    }

    private ManagedEdgeRuntime? _edgeRuntime;
    private LocalHttpsProxyRuntime? _proxyRuntime;
    private BrowserCompanionRuntime? _companionRuntime;
    private IEndpointDiscoveryService? _discovery;
    private bool _disposed;
    private ManagedEdgeStatus EdgeStatus => _edgeRuntime?.For(CurrentProfile) ?? new();
    /// <summary>Transient Local HTTPS proxy status for the current configuration. Never persisted; never contains a credential.</summary>
    private LocalHttpsProxyStatus ProxyStatus => _proxyRuntime?.For(CurrentProfile) ?? new();
    private string VerificationModeLabel => CurrentProfile?.Authentication.VerificationMode == AuthenticationVerificationMode.ManualManagedEdge ? "Manual verification" : "Automated detection";
    private AuthenticatedTestingMethod SelectedTestingMethod => CurrentProfile?.Authentication.AuthenticatedTestingMethod ?? AuthenticatedTestingMethod.ManagedEdgeCdp;
    private AuthenticatedCapabilitySummary Coverage => AuthenticatedTestingMethodLabels.Capabilities(SelectedTestingMethod, EdgeStatus, ProxyStatus);
    /// <summary>Machine-proven authenticated API context through the saved Local HTTPS proxy method (API surface only, never DOM).</summary>
    private bool ProxyApiContextAvailable => SelectedTestingMethod == AuthenticatedTestingMethod.LocalHttpsProxy && ProxyStatus.AuthenticatedCredentialAvailable;
    private void EdgeRuntimeChanged() { if (!_disposed) _ = OnRuntimeChangedAsync(); }
    // Fold live proxy-observed network endpoints into the persisted Endpoint Discovery history as traffic arrives, even while the user is
    // on another tab, then re-render. Persistence carries only safe metadata (no credential); the runtime session itself is never persisted.
    private async Task OnRuntimeChangedAsync()
    {
        if (_disposed) return;
        if (_discovery is not null && _proxyRuntime is not null && CurrentProfile is { } profile && _proxyRuntime.For(profile).ObservedNetworkEndpoints is { Count: > 0 } endpoints)
            await _discovery.MergeObservedAsync(JS, profile.Id, endpoints);
        if (!_disposed) await InvokeAsync(StateHasChanged);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_edgeRuntime is not null) await _edgeRuntime.SynchronizeAsync(CurrentProfile);
        if (_proxyRuntime is not null) await _proxyRuntime.SynchronizeAsync(CurrentProfile);
    }
    public ValueTask DisposeAsync()
    {
        _disposed = true;
        // The managed-Edge and Local HTTPS proxy runtimes are app-scoped: their session lifetime follows the backend/runtime session and
        // the selected Target Environment, NOT this component. Navigating to another BirkNext page unmounts this component but must not stop
        // the proxy or disconnect CDP — the authenticated session keeps listening so it can back API testing across the application. Only
        // unsubscribe from change notifications here. Real invalidation still happens on an explicit Stop proxy / Disconnect click, on a
        // selected-environment or target-configuration change (SynchronizeAsync), or on credential expiry.
        if (_edgeRuntime is not null) _edgeRuntime.Changed -= EdgeRuntimeChanged;
        if (_proxyRuntime is not null) _proxyRuntime.Changed -= EdgeRuntimeChanged;
        if (_companionRuntime is not null) _companionRuntime.Changed -= EdgeRuntimeChanged;
        return ValueTask.CompletedTask;
    }

    private FrontendAnalysisProfile? SelectedProfile =>
        string.IsNullOrEmpty(_selectedProfileId)
            ? null
            : FaSettings.Settings.Profiles.FirstOrDefault(p => p.Id == _selectedProfileId);

    private FrontendAnalysisProfile? EffectiveActiveProfile =>
        FaSettings.ActiveProfile;

    // ── Lifecycle ────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        _edgeRuntime = ServiceProvider.GetService<ManagedEdgeRuntime>();
        if (_edgeRuntime is not null) _edgeRuntime.Changed += EdgeRuntimeChanged;
        _proxyRuntime = ServiceProvider.GetService<LocalHttpsProxyRuntime>();
        if (_proxyRuntime is not null) _proxyRuntime.Changed += EdgeRuntimeChanged;
        _companionRuntime = ServiceProvider.GetService<BrowserCompanionRuntime>();
        if (_companionRuntime is not null) _companionRuntime.Changed += EdgeRuntimeChanged;
        _discovery = ServiceProvider.GetService<IEndpointDiscoveryService>();
        await FaSettings.LoadAsync(JS);
        // Detection snapshots live in a separate evidence store (never in the saved profile), so load them before restoring.
        await FaSettings.LoadDetectionSnapshotsAsync(JS);
        // Endpoint Discovery history is persisted separately per Target Environment; load it so a restart restores discovery (never a credential).
        if (_discovery is not null) await _discovery.LoadAsync(JS);

        _selectedProfileId = FaSettings.Settings.ActiveProfileId
            ?? FaSettings.Settings.Profiles.FirstOrDefault()?.Id;
        // Restore the persisted public detection snapshot so a restart shows "Previously detected" (revalidated to Current/Stale)
        // instead of forcing a fresh Detect. No credential is restored — only safe discovery evidence.
        RestoreDetectionSnapshot();
    }

    /// <summary>Applies a deep-linked tab once per distinct value, so navigating here again re-selects it.</summary>
    protected override void OnParametersSet()
    {
        if (InitialTab is { Length: > 0 } requested && _appliedInitialTab != requested)
        {
            _appliedInitialTab = requested;
            if (Tabs.Any(t => t.Key == requested)) _activeTab = requested;
        }
    }

    // ── Profile selection ────────────────────────────────────────────────────

    private void SelectProfile(string profileId)
    {
        _manualInstructionsOpen = false;
        _manualResultRecordedThisSession = false;
        if (_isEditMode) CancelEdit();
        _selectedProfileId = profileId;
        _activeTab         = "general";
        // Reset current detection state when switching profiles (no cross-profile leakage), then restore the newly selected
        // profile's persisted detection snapshot (if any) so it shows "Previously detected" revalidated to Current/Stale.
        _detectionError    = null;
        _authenticationFailureReason = null;
        _browserRuntimeInspectionRequired = null;
        RestoreDetectionSnapshot();
    }

    /// <summary>
    /// Clears in-session detection evidence and rehydrates it from the selected profile's persisted <see cref="DetectionSnapshot"/>.
    /// Only the safe public detection result is restored; the fresh-session manual verification context (<c>_manualDetectionContext</c>)
    /// is deliberately NOT restored, so recording manual verification and activating a manual-verification environment still require a
    /// fresh Detect. A deep copy avoids aliasing the persisted snapshot object.
    /// </summary>
    private void RestoreDetectionSnapshot()
    {
        _detectionResult = null;
        _lastDetectionTargetUrl = null;
        _detectionProfileId = null;
        _detectionProfileSnapshot = null;
        _manualDetectionContext = null;
        _detectionRestored = false;

        if (SelectedProfile is { } profile && FaSettings.GetDetectionSnapshot(profile.Id) is { Result: not null } snapshot)
        {
            _detectionResult = System.Text.Json.JsonSerializer.Deserialize<TargetEnvironmentDetectionResult>(
                System.Text.Json.JsonSerializer.Serialize(snapshot.Result));
            _detectionProfileId = snapshot.DetectedProfileId ?? profile.Id;
            _lastDetectionTargetUrl = snapshot.DetectedUrl;
            _detectionRestored = _detectionResult is not null;
        }
    }

    // ── Edit mode ────────────────────────────────────────────────────────────

    private void EnterEditMode()
    {
        if (SelectedProfile is null) return;
        var json     = System.Text.Json.JsonSerializer.Serialize(SelectedProfile);
        _editProfile = System.Text.Json.JsonSerializer.Deserialize<FrontendAnalysisProfile>(json);
        _originalProfileJson = json;
        _originalAuthenticationJson = System.Text.Json.JsonSerializer.Serialize(SelectedProfile.Authentication);
        _isEditMode  = true;
        _saveError   = null;
    }

    private void CancelEdit()
    {
        _editProfile = null;
        _originalProfileJson = null;
        _originalAuthenticationJson = null;
        _isEditMode  = false;
        _saveError   = null;
    }

    private async Task SaveProfileAsync()
    {
        if (_editProfile is null || _isSaving) return;

        var validation = FaSettings.ValidateProfile(_editProfile);
        if (!validation.IsValid)
        {
            _saveError = string.Join(" | ", validation.Errors);
            return;
        }

        _isSaving  = true;
        _saveError = null;
        try
        {
            FaSettings.UpdateProfile(_editProfile);
            await FaSettings.SaveAsync(JS);
            _selectedProfileId = _editProfile.Id;
            _isEditMode        = false;
            _editProfile       = null;
            _originalProfileJson = null;
            _originalAuthenticationJson = null;
            RecomputeManualReadiness();
            _saveSuccess       = "Target environment saved.";
            StateHasChanged();
            await Task.Delay(4000);
            _saveSuccess = null;
        }
        finally
        {
            _isSaving = false;
        }
    }

    // ── Profile operations ───────────────────────────────────────────────────

    private async Task SetActiveProfileAsync()
    {
        if (_selectedProfileId is null || !CanSetActiveTarget) return;
        var previousId = FaSettings.Settings.ActiveProfileId;
        var previousError = FaSettings.Settings.ActiveResolutionError;
        FaSettings.SelectActiveProfile(_selectedProfileId);
        try
        {
            await FaSettings.SaveAsync(JS);
            _saveError = null;
        }
        catch
        {
            FaSettings.Settings.ActiveProfileId = previousId;
            FaSettings.Settings.ActiveResolutionError = previousError;
            _saveError = "The active Target Environment could not be saved. Your previous active target is unchanged. Try again.";
        }
    }

    private async Task DuplicateProfileAsync()
    {
        if (_selectedProfileId is null) return;
        var copy = FaSettings.DuplicateProfile(_selectedProfileId);
        copy.ManualVerification = null;
        copy.LastDetectedUrl = null;
        copy.LastDetectionSucceeded = false;
        copy.LastDetectionFailure = null;
        await FaSettings.SaveAsync(JS);
        // The duplicate is a new environment identity; it inherits no detection snapshot (the source's is keyed to the source id).
        await FaSettings.RemoveDetectionSnapshotAsync(JS, copy.Id);
        _selectedProfileId = copy.Id;
        _activeTab         = "general";
    }

    private async Task ExecuteDeleteAsync()
    {
        if (_selectedProfileId is null) return;
        _isDeleting = true;
        try
        {
            FaSettings.DeleteProfile(_selectedProfileId);
            await FaSettings.SaveAsync(JS);
            _selectedProfileId = FaSettings.Settings.ActiveProfileId
                ?? FaSettings.Settings.Profiles.FirstOrDefault()?.Id;
            _showDeleteConfirm = false;
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private async Task CreateProfileAsync()
    {
        if (string.IsNullOrWhiteSpace(_newProfileName) || !IsNewProfileUrlValid) return;
        var profile = FaSettings.CreateProfile(_newProfileName.Trim(), _newProfileEnv);
        profile.TargetUrl = string.IsNullOrWhiteSpace(_newProfileUrl) ? null : _newProfileUrl;
        await FaSettings.SaveAsync(JS);
        SelectProfile(profile.Id);
        _showCreateDialog  = false;
        _activeTab         = "general";
