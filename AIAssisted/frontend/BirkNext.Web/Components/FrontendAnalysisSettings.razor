    // ── Target detection ─────────────────────────────────────────────────────

    private void ClearDetectionState()
    {
        // When URL changes, clear error but preserve result so staleness can be computed
        // ComputeDetectionState will compare detection URL against current URL
        _detectionError = null;
    }

    private async Task DetectSelectedTargetAsync()
    {
        if (CurrentProfile is null) return;

        _activeTab = "target";
        await DetectConfigurationAsync();
    }

    private void ApplyDetectedEnvironmentType()
    {
        if (_detectionResult?.SuggestedEnvironmentType is null) return;
