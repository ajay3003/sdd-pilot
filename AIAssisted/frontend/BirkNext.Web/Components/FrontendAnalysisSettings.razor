    // ── Add-integration flow ───────────────────────────────────────────────────
    private bool _addingIntegration;
    private string _addMode = "known";
    private List<KnownIntegrationTemplateView> _knownTemplates = [];
    /// <summary>Previewed template. Selecting only previews; acceptance is the explicit Add integration action.</summary>
    private string? _selectedTemplateId;
    /// <summary>
    /// Structural values the user typed for fields this environment has no binding for. Held here
    /// rather than written back onto the template: the template is reusable knowledge and must stay
    /// identical for every environment that reads it.
    /// </summary>
    private readonly Dictionary<string, string> _suppliedBindingValues = new(StringComparer.Ordinal);

    /// <summary>
    /// Opens the add flow and loads the templates evidenced for this environment. An environment
    /// with none simply shows an empty state; that is a normal outcome, not a failure.
    /// </summary>
    private async Task BeginAddIntegration()
    {
        _addingIntegration = true;
        _addMode = "known";
        await LoadKnownTemplatesAsync();
    }

    private async Task SetAddMode(string mode)
    {
        _addMode = mode;

        if (mode == "known")
            await LoadKnownTemplatesAsync();
    }

    private async Task LoadKnownTemplatesAsync()
    {
        // Bindings are keyed by the environment TYPE, not the profile's display name: a name like
        // "M2LB QA" matches nothing. The type is a closed enum, so the lookup is deterministic.
        // The catalogue itself is returned whatever this value is — only the bindings vary.
        var environmentType = _editProfile?.EnvironmentType.ToString() ?? "";

        try
        {
            // Resolved optionally: the editor must stay renderable where template lookup is not
            // wired up, and a failed load leaves the manual path available.
            var templates = ServiceProvider.GetService(typeof(IIntegrationTemplateService)) as IIntegrationTemplateService;
            _knownTemplates = templates is null ? [] : await templates.GetForEnvironmentAsync(environmentType);
        }
        catch
        {
            // Templates are optional assistance; failing to load them must not block adding an
            // integration manually.
            _knownTemplates = [];
        }
    }

    /// <summary>The environment these structural values belong to, as the user reads it.</summary>
    private string EnvironmentValuesLabel => _editProfile?.EnvironmentType.ToString() ?? "this environment";

    private string SuppliedValue(string field) => _suppliedBindingValues.GetValueOrDefault(field, "");

    private void SetSuppliedValue(string field, string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) _suppliedBindingValues.Remove(field);
        else _suppliedBindingValues[field] = value.Trim();
    }

    /// <summary>
    /// The environment values this template would be accepted with: the binding, overlaid with
    /// anything the user supplied for a field the binding had no value for.
    /// </summary>
    private IntegrationEnvironmentValues ValuesFor(KnownIntegrationTemplateView view) => new(
        Resource: view.Binding?.Resource is { Length: > 0 } resource ? resource : SuppliedValue(KnownIntegrationFields.Resource) is { Length: > 0 } typedResource ? typedResource : null,
        EndpointOrNamespace: view.Binding?.EndpointOrNamespace is { Length: > 0 } endpoint ? endpoint : SuppliedValue(KnownIntegrationFields.Endpoint) is { Length: > 0 } typedEndpoint ? typedEndpoint : null,
        ConsumerGroup: view.Binding?.ConsumerGroup);

    /// <summary>
    /// Whether every structurally required field now has a value. Until it does, the template is
    /// not accepted: a persisted integration without its structural identity would carry a baseline
    /// key that means nothing and could never be matched again.
    /// </summary>
    private bool TemplateStructurallyComplete(KnownIntegrationTemplateView view)
    {
        var values = ValuesFor(view);
        return view.RequiredFields.All(field => field switch
        {
            KnownIntegrationFields.Resource => !string.IsNullOrWhiteSpace(values.Resource),
            KnownIntegrationFields.Endpoint => !string.IsNullOrWhiteSpace(values.EndpointOrNamespace),
            _ => true,
        });
    }

    /// <summary>
    /// Creates an integration from a template. Only values the audit established are written, so
    /// anything it could not establish stays blank and shows as still needed.
    /// </summary>
    /// <summary>Selecting a template only previews it. Nothing is added until "Add integration".</summary>
    private void OnTemplateSelected(ChangeEventArgs e)
    {
        _selectedTemplateId = e.Value?.ToString() is { Length: > 0 } id ? id : null;
        // Values typed for one template never carry over to the next.
        _suppliedBindingValues.Clear();
    }

    private KnownIntegrationTemplateView? SelectedTemplate =>
        _selectedTemplateId is null ? null : _knownTemplates.FirstOrDefault(v => v.Template.Id == _selectedTemplateId);

    /// <summary>
    /// The configured integration this template would apply to, matched on structural identity
    /// (type + resource + endpoint) exactly as the baseline key is derived — never on template id,
    /// display name, producer or consumer. An existing match is enriched rather than duplicated.
    ///
    /// Structural identity needs structural values, so while any required one is still unknown no
    /// match is claimed: guessing here would either merge two different integrations or split one.
    /// </summary>
    private IntegrationConfig? ExistingForTemplate(KnownIntegrationTemplateView view)
    {
        if (!TemplateStructurallyComplete(view)) return null;

        var values = ValuesFor(view);
        return _editProfile?.Integrations.FirstOrDefault(i =>
            i.Type == view.Template.IntegrationType &&
            string.Equals((i.Resource ?? "").Trim(), (values.Resource ?? "").Trim(), StringComparison.OrdinalIgnoreCase) &&
            string.Equals((i.Endpoint ?? "").Trim(), (values.EndpointOrNamespace ?? "").Trim(), StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>
    /// Explicit acceptance. Only values the audit established are written, so anything it could not
    /// establish stays blank and shows as still needed. An equivalent integration is filled in rather
    /// than duplicated, and a value a person already typed is never overwritten.
    /// </summary>
    private void AddSelectedTemplate()
    {
        if (SelectedTemplate is not { } view || _editProfile is null) return;
        // An integration whose structural identity is still unknown is not persisted at all.
        if (!TemplateStructurallyComplete(view)) return;

        var values = ValuesFor(view);

        if (ExistingForTemplate(view) is { } existing)
        {
            IntegrationConfigPresenter.ApplyTemplate(existing, view.Template, values, fillOnly: true);
            _editingIntegrationId = existing.Id;
        }
        else
        {
            var cfg = new IntegrationConfig { Id = NewIntegrationId(), Enabled = true };
            IntegrationConfigPresenter.ApplyTemplate(cfg, view.Template, values);
            _editProfile.Integrations.Add(cfg);
            _editingIntegrationId = cfg.Id;
        }

        _selectedTemplateId = null;
        _suppliedBindingValues.Clear();
        _addingIntegration = false;
    }

    private void AddCustomIntegration()
    {
        AddIntegration();
        _addingIntegration = false;
    }

    private void AddIntegration()
    {
        var cfg = new IntegrationConfig { Id = NewIntegrationId(), Enabled = true };
        _editProfile!.Integrations.Add(cfg);
        _editingIntegrationId = cfg.Id;
    }

    private void RemoveIntegration(string id) =>
        _editProfile!.Integrations.RemoveAll(i => i.Id == id);

    private static string NewIntegrationId() =>
        Guid.NewGuid().ToString("N")[..8];

    // ── Authentication detection helpers ────────────────────────────────────

    private bool HasDetectedAuthSettings(TargetEnvironmentDetectionResult detection)
    {
        return detection.DetectedAuthenticationType != FrontendAuthenticationType.None ||
               !string.IsNullOrWhiteSpace(detection.DetectedAuthority) ||
               !string.IsNullOrWhiteSpace(detection.DetectedClientId) ||
               !string.IsNullOrWhiteSpace(detection.DetectedTenantId) ||
               !string.IsNullOrWhiteSpace(detection.TenantMode) ||
               detection.DetectedRedirectUrls.Count > 0;
    }

    /// <summary>
    /// Apply authentication: copies the detected authentication proposal (type, authority, tenant,
    /// client ID, redirect URLs) into the DRAFT only. Follows the same Detected → Apply → draft →
    /// Save changes model as the endpoint proposals. Never persists, never activates, never opens a
    /// browser and never records manual verification. Idempotent: applying values that already match
    /// the draft leaves the draft (and dirty state) unchanged.
    /// </summary>
    private void ApplyDetectedAuthenticationSettings()
    {
        if (_detectionResult?.Success != true || AuthenticationProposalStale || AuthenticationProposalMatches(CurrentProfile)) return;
        var wasEditing = _isEditMode;
        if (!_isEditMode) EnterEditMode();
        if (_editProfile is null) return;

        var auth = _editProfile.Authentication;

        // Apply detected authentication type
        if (_detectionResult.DetectedAuthenticationType != FrontendAuthenticationType.None)
            auth.AuthenticationType = _detectionResult.DetectedAuthenticationType;

        // Apply detected authority
        if (!string.IsNullOrWhiteSpace(_detectionResult.DetectedAuthority))
            auth.ExpectedAuthority = _detectionResult.DetectedAuthority;

        // Apply detected tenant (prefer GUID tenant over mode)
        if (!string.IsNullOrWhiteSpace(_detectionResult.DetectedTenantId))
            auth.ExpectedTenant = _detectionResult.DetectedTenantId;
        else if (!string.IsNullOrWhiteSpace(_detectionResult.TenantMode))
            auth.ExpectedTenant = _detectionResult.TenantMode;

        // Apply detected client ID
        if (!string.IsNullOrWhiteSpace(_detectionResult.DetectedClientId))
            auth.ExpectedClientId = _detectionResult.DetectedClientId;

        // Apply detected redirect URLs (merge with existing, avoiding duplicates)
        if (_detectionResult.DetectedRedirectUrls.Count > 0)
        {
            var merged = new HashSet<string>(auth.AllowedRedirectUrls, StringComparer.OrdinalIgnoreCase);
            foreach (var url in _detectionResult.DetectedRedirectUrls)
                merged.Add(url);
            auth.AllowedRedirectUrls = merged.ToList();
        }

        if (!wasEditing && !IsDirty) CancelEdit();
        StateHasChanged();
    }

}
