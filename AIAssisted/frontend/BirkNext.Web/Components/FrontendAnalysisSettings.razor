    // ── Browser detection flow (Phase 2) ─────────────────────────────────────

    /// <summary>
    /// Initiates browser-based detection flow for authentication scenarios.
    /// Shows waiting UI and sends request to backend to launch headed browser.
    /// </summary>
    private bool CanContinueDetectionInBrowser()
    {
        // Show Continue button for states that explicitly support browser continuation
        if (ManualVerificationRequired) return false;
        return CurrentDetectionState == DetectionState.AuthenticationRequired ||
               (CurrentDetectionState == DetectionState.Partial &&
                _browserRuntimeInspectionRequired == true);
    }

    private async Task StartBrowserDetectionAsync()
    {
        if (!CanContinueDetectionInBrowser() || string.IsNullOrWhiteSpace(CurrentTargetUrl))
            return;

        // Check that URL hasn't changed since last detection
        if (IsDetectionStale)
            return;

        var callingProfile = SelectedProfile;
        var callingUrl = CurrentTargetUrl;
        if (callingProfile?.Id is null || string.IsNullOrWhiteSpace(callingUrl))
            return;

        var callingProfileId = callingProfile.Id;
        var callingNormalizedUrl = NormalizeUrl(callingUrl);
        var attemptId = Guid.NewGuid().ToString("N");
        _currentBrowserDetectionAttemptId = attemptId;

        _browserDetectionInProgress = true;
        _authenticationFailureReason = null;
        _browserDetectionMessage = null;
        _detectionError = null;
        StateHasChanged();

        try
        {
            // Generate a temporary detection session ID for tracking (not tied to active review session)
            var detectionSessionId = $"detection-{callingProfileId}-{DateTime.UtcNow.Ticks}";

            // Call backend to start interactive browser-based authentication
            var result = await DetectionApi.StartBrowserDetectionAsync(
                callingUrl,
                detectionSessionId,
                callingProfileId);

            // Bind completion to the exact attempt, profile, and URL that initiated it.
            // A selection change, URL edit, cancellation, or newer attempt invalidates this response.
            if (_currentBrowserDetectionAttemptId != attemptId ||
                _selectedProfileId != callingProfileId ||
                !string.Equals(NormalizeUrl(CurrentTargetUrl), callingNormalizedUrl, StringComparison.OrdinalIgnoreCase))
                return;

            if (result is not null && result.DetectionResponse is not null)
            {
                // Update detection state based on backend result
                _detectionResult = result.DetectionResponse;
                _detectionRestored = false;
                _detectionProfileId = callingProfileId;
                _authenticationFailureReason = result.AuthenticationFailureReason;
                _browserRuntimeInspectionRequired = result.BrowserRuntimeInspectionRequired;

                // Store detection provenance in the profile (existing behaviour for the interactive/browser continuation path).
                callingProfile.LastDetectedUrl = callingUrl;
                callingProfile.LastDetectionSucceeded = result.State == DetectionState.Complete;
                callingProfile.LastDetectionFailure = result.State == DetectionState.Complete ? null : result.State.ToString();
                await FaSettings.SaveAsync(JS);

                // Also persist the safe public detection snapshot (separate evidence store, no credential) so a restart restores it.
                await PersistDetectionSnapshotAsync(callingProfile, result.DetectionResponse, callingUrl);

                _browserDetectionInProgress = false;
                StateHasChanged();

                // Show appropriate message based on final state
                if (result.State == DetectionState.Complete)
                {
                    _detectionError = "✓ Interactive detection complete!";
                    await Task.Delay(2000);
                    _detectionError = null;
                }
                else if (result.State == DetectionState.Partial && result.BrowserRuntimeInspectionRequired == true)
                {
                    _detectionError = $"⚠ Additional confirmation required in browser. {result.Message}";
                    await Task.Delay(3000);
                    _detectionError = null;
                }
                else if (result.State == DetectionState.Partial)
                {
                    _detectionError = $"⚠ Partial detection: {result.StrategySuggestion}";
                    await Task.Delay(3000);
                    _detectionError = null;
                }
                else
                {
                    // Use typed message from backend for all failures
                    _detectionError = $"✗ {(result.Message ?? "Interactive detection could not be completed. Try again.")}";
                    // Keep error visible longer for failures
                }

                StateHasChanged();
            }
            else
            {
                _browserDetectionInProgress = false;
                _detectionError = "✗ Browser detection request failed. Please try again.";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            if (_currentBrowserDetectionAttemptId != attemptId)
                return;
            _browserDetectionInProgress = false;
            _detectionError = $"✗ Error during browser detection: {ex.Message}";
            StateHasChanged();
        }
        finally
        {
            if (_currentBrowserDetectionAttemptId == attemptId)
            {
                _currentBrowserDetectionAttemptId = null;
                _browserDetectionInProgress = false;
                StateHasChanged();
            }
        }
    }

    /// <summary>
    /// Cancels ongoing browser detection.
    /// Returns to AuthenticationRequired state and allows user to retry.
    /// </summary>
    private async Task CancelBrowserDetectionAsync()
    {
        _currentBrowserDetectionAttemptId = null;
        _browserDetectionInProgress = false;
        _browserDetectionMessage = null;

        // Show message that user can retry
        _detectionError = "Authentication not completed. Click 'Continue detection in browser' to try again.";

        // Keep detection state as AuthenticationRequired to allow retry
        StateHasChanged();

        // Auto-clear error after a delay (optional)
        await Task.Delay(5000);
        if (_detectionError?.Contains("Authentication not completed") == true)
        {
            _detectionError = null;
            StateHasChanged();
        }
    }

    private static FrontendEnvironmentType? GetTypeConflict(FrontendAnalysisProfile profile)
    {
        var inferred = TargetEnvironmentTypeClassifier.InferFromUrl(profile.TargetUrl);
        return inferred.HasValue && profile.EnvironmentType != FrontendEnvironmentType.Custom && inferred != profile.EnvironmentType
            ? inferred
            : null;
    }

    private async Task DetectConfigurationAsync()
    {
        if (CurrentProfile is null || string.IsNullOrWhiteSpace(CurrentProfile.TargetUrl))
            return;

        _isDetecting = true;
        _detectionError = null;
        _detectionResult = null;
        StateHasChanged();

        try
        {
            _lastDetectionTargetUrl = NormalizeUrl(CurrentProfile.TargetUrl);
            var detectionProfile = CurrentProfile;
            var detectionContext = ManualAuthenticationVerificationEvidence.Fingerprint(detectionProfile);
            var detectionSnapshot = System.Text.Json.JsonSerializer.Deserialize<FrontendAnalysisProfile>(
                System.Text.Json.JsonSerializer.Serialize(detectionProfile));
            var result = detectionProfile.Authentication.VerificationMode == AuthenticationVerificationMode.ManualManagedEdge
                ? await DetectionApi.DetectManualManagedEdgeAsync(detectionProfile.TargetUrl)
                : await DetectionApi.DetectFromUrlAsync(detectionProfile.TargetUrl);
            if (CurrentProfile is null || ManualAuthenticationVerificationEvidence.Fingerprint(CurrentProfile) != detectionContext) return;
            // Two independent contexts are recorded here:
            //  - _manualDetectionContext: full verification context (URL + authentication + security settings).
            //    Governs whether manual authentication verification may be recorded / remains valid.
            //  - _detectionProfileId + detected URL: target discovery identity (see TargetDiscoveryFingerprint).
            //    Governs whether endpoint/framework/environment discovery is stale. Authentication draft
            //    changes must not affect it.
            _manualDetectionContext = detectionContext;
            _detectionProfileSnapshot = detectionSnapshot;
            _detectionProfileId = detectionProfile.Id;
            _manualInstructionsOpen = false;
            _manualResultRecordedThisSession = false;

            if (result is not null)
            {
                _detectionResult = result;
                _detectionRestored = false;
                _browserRuntimeInspectionRequired = result.BrowserRuntimeInspectionRequired;

                // Persist the safe public detection snapshot (no credential) so a restart restores it as "Previously detected".
                await PersistDetectionSnapshotAsync(detectionProfile, result, detectionProfile.TargetUrl);

                // Detection updates transient evidence only; Apply owns draft mutations.
                if (!result.Success)
                {
                    _detectionError = result.Message;
                }
            }
            else
            {
                _detectionError = "Detection failed. Please try again.";
            }
        }
        catch (Exception)
        {
            _detectionError = "Detection failed. Please try again.";
        }
        finally
        {
            _isDetecting = false;
            RecomputeManualReadiness();
        }
    }

    /// <summary>
    /// Persists a safe public detection snapshot on the saved profile so it survives a restart. Stores only discovery evidence and its
    /// target-identity fingerprint/timestamp/source — never a token, cookie, bearer, proxy or CDP session. Writes to the persisted
    /// profile (by id) and saves immediately, matching how detection evidence is stored outside the Save-changes flow.
    /// </summary>
    private async Task PersistDetectionSnapshotAsync(FrontendAnalysisProfile detectionProfile, TargetEnvironmentDetectionResult result, string? detectedUrl)
    {
        // Only a successful/meaningful detection is remembered; a hard failure must not masquerade as "previously detected".
        // Writes ONLY the separate evidence store — the saved profile is never modified by detection.
        if (!result.Success || result.State == DetectionState.Failed) return;
        var snapshot = new DetectionSnapshot
        {
            Result = System.Text.Json.JsonSerializer.Deserialize<TargetEnvironmentDetectionResult>(System.Text.Json.JsonSerializer.Serialize(result)) ?? result,
            DetectedProfileId = detectionProfile.Id,
            DetectedUrl = NormalizeUrl(detectedUrl ?? result.OriginalUrl),
            DetectedAt = DateTimeOffset.UtcNow,
            Source = "Detect Settings"
        };
        await FaSettings.SaveDetectionSnapshotAsync(JS, detectionProfile.Id, snapshot);
    }

    private FrontendAnalysisProfile? CurrentProfile => _isEditMode ? _editProfile : SelectedProfile;

    private string? CurrentTargetUrl => CurrentProfile?.TargetUrl;

    /// <summary>
    /// Computes the detection state for the currently selected profile.
    /// Separates CURRENT detection lifecycle from LAST persisted detection outcome.
    ///
    /// CURRENT LIFECYCLE: Reflects what's happening NOW in this UI session
    ///   - NotChecked: No detection has been started in this session
    ///   - Checking: Detection is currently running
    ///   - Complete/AuthenticationRequired/Partial/Failed: Current attempt result
    ///   - Stale: Current attempt result is stale (URL changed)
    ///
    /// HISTORICAL OUTCOME: Persisted from previous session(s)
    ///   - Used only when current lifecycle is NotChecked and no URL changes detected
    ///   - Presented differently (as historical context, not active failure)
    /// </summary>
    private DetectionState ComputeDetectionState()
    {
        var profile = CurrentProfile;
        if (profile is null)
            return DetectionState.NotChecked;

        // PART 1: Active current detection lifecycle has highest priority
        if (_isDetecting)
            return DetectionState.Checking;

        if (_detectionResult is not null)
        {
            // Target discovery staleness is decided ONLY by target identity (profile + Frontend URL).
            // Authentication draft changes are tracked separately via the manual verification context.
            if (CurrentDiscoveryStaleReason != TargetDiscoveryStaleReason.None)
                return DetectionState.Stale;

            // A restored snapshot older than the freshness limit revalidates as Stale even when the target identity is unchanged.
            if (RestoredDetectionExpired)
                return DetectionState.Stale;

            // Return state from current result
            if (_detectionResult.State != DetectionState.NotChecked)
                return _detectionResult.State;

            if (!_detectionResult.Success)
                return DetectionState.Failed;

            if (_detectionResult.AuthenticationRequired)
                return DetectionState.AuthenticationRequired;

            if (_browserRuntimeInspectionRequired == true)
                return DetectionState.Partial;

            if (_detectionResult.Warnings.Count > 0)
                return DetectionState.Partial;

            return DetectionState.Complete;
        }

        // PART 2: No active current detection result. Check URL staleness against persisted state.
        if (CurrentDiscoveryStaleReason == TargetDiscoveryStaleReason.TargetUrlChanged)
            return DetectionState.Stale;

        // PART 3: Current lifecycle is neutral (not in an active attempt).
        // Return NotChecked regardless of persisted historical outcome.
        // This is the key fix: Don't surface historical failure as active current failure.
        return DetectionState.NotChecked;
    }

    /// <summary>
    /// Fingerprint of the target the current detection evidence was gathered for.
    /// Null when no detection result is held in this session.
    /// </summary>
    private TargetDiscoveryFingerprint? DetectedDiscoveryFingerprint
    {
        get
        {
            if (_detectionResult is null) return null;
            var detectedUrl = string.IsNullOrWhiteSpace(_detectionResult.OriginalUrl)
                ? _lastDetectionTargetUrl
                : _detectionResult.OriginalUrl;
            return TargetDiscoveryFingerprint.For(_detectionProfileId ?? CurrentProfile?.Id ?? "", detectedUrl);
        }
    }

    /// <summary>
    /// Typed reason why target discovery (reachability, framework, environment, endpoint and
    /// integration proposals) is stale for the current profile. Never reacts to authentication,
    /// threshold, feature toggle or other non-identity changes.
    /// </summary>
    private TargetDiscoveryStaleReason CurrentDiscoveryStaleReason
    {
        get
        {
            var profile = CurrentProfile;
            if (profile is null) return TargetDiscoveryStaleReason.None;

            if (DetectedDiscoveryFingerprint is { } detected)
                return detected.StaleReasonFor(profile);

            // No detection result in this session: compare against the persisted last-detected URL.
            if (profile.LastDetectedUrl is not null && !UrlsMatch(profile.LastDetectedUrl, profile.TargetUrl))
                return TargetDiscoveryStaleReason.TargetUrlChanged;

            return TargetDiscoveryStaleReason.None;
        }
    }

    private DetectionSnapshot? RestoredSnapshot => SelectedProfile is { } p ? FaSettings.GetDetectionSnapshot(p.Id) : null;

    /// <summary>A restored (previous-session) detection whose snapshot is older than the freshness limit; re-detect is required.</summary>
    private bool RestoredDetectionExpired => _detectionRestored && RestoredSnapshot is { } snapshot &&
        DateTimeOffset.UtcNow - snapshot.DetectedAt > DetectionFreshness;

    /// <summary>Header badge for a restored detection: whether it is still current or needs re-detecting.</summary>
    private string RestoredDetectionLabel
    {
        get
        {
            var when = RestoredSnapshot?.DetectedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
            var suffix = when is null ? "" : $" ({when})";
            return CurrentDetectionState == DetectionState.Stale
                ? $"Previously detected — stale, re-detect required{suffix}"
                : $"Previously detected — current{suffix}";
        }
    }

    private string DiscoveryStaleMessage => RestoredDetectionExpired && CurrentDiscoveryStaleReason == TargetDiscoveryStaleReason.None
        ? "The saved detection is older than the freshness limit. Run detection again to refresh."
        : CurrentDiscoveryStaleReason switch
        {
            TargetDiscoveryStaleReason.ProfileChanged => "The selected environment changed since the last detection. Run detection again to refresh.",
            _ => "The target URL changed since the last detection. Run detection again to refresh."
        };

    private string DiscoveryStaleReadinessReason => CurrentDiscoveryStaleReason switch
    {
        TargetDiscoveryStaleReason.ProfileChanged => "Selected environment changed. Run Detect settings again to refresh detection evidence.",
        _ => "Frontend URL changed. Run Detect settings again to refresh detection evidence."
    };

    private string DiscoveryStaleDetail => CurrentDiscoveryStaleReason switch
    {
        TargetDiscoveryStaleReason.ProfileChanged => "The selected environment changed since detection. Run Detect settings again to refresh discovered endpoints and integrations.",
        _ => "The target URL changed since detection. Run Detect settings again to refresh discovered endpoints and integrations."
    };

    private DetectionState CurrentDetectionState => ComputeDetectionState();

    private bool HasCurrentSuccessfulDetection =>
        CurrentDetectionState == DetectionState.Complete;

    /// <summary>
    /// Compact wording for the summary badge beside the Frontend URL. Every other detection state is already short;
    /// only manual verification had a full sentence there, which the Detection result card states once on its own.
    /// </summary>
    private string DetectionStateBadge =>
        CurrentDetectionState == DetectionState.ManualAuthenticationVerificationRequired && !DetectionReady
            ? "Needs verification"
            : DetectionStateLabel;

    private string DetectionStateLabel =>
        CurrentDetectionState switch
        {
            DetectionState.Checking => "Detecting...",
            DetectionState.Complete => "Detection complete",
            DetectionState.ManualAuthenticationVerificationRequired when DetectionReady => "Target detection complete",
            DetectionState.ManualAuthenticationVerificationRequired => "Manual authentication verification required",
            DetectionState.AuthenticationRequired => "Authentication required",
            DetectionState.Partial when _browserRuntimeInspectionRequired == true => "Needs browser inspection",
            DetectionState.Partial => "Detection incomplete",
            DetectionState.Stale => "Needs re-check",
            DetectionState.Failed => "Detection failed",
            // NotChecked: show historical outcome if available
            DetectionState.NotChecked when SelectedProfile?.LastDetectionSucceeded == true => "Last detection complete",
            DetectionState.NotChecked when SelectedProfile?.LastDetectionFailure is not null => "Last detection failed",
            DetectionState.NotChecked => "Not checked",
            _ => "Unknown"
        };

    private string DetectionStateCss =>
        CurrentDetectionState switch
        {
            DetectionState.Checking => "checking",
            DetectionState.Complete => "checked",
            DetectionState.ManualAuthenticationVerificationRequired => "auth-required",
            DetectionState.AuthenticationRequired => "auth-required",
            DetectionState.Partial => "partial",
            DetectionState.Stale => "stale",
            DetectionState.Failed => "failed",
            // NotChecked: use historical status for styling if available
            DetectionState.NotChecked when SelectedProfile?.LastDetectionSucceeded == true => "historical-success",
            DetectionState.NotChecked when SelectedProfile?.LastDetectionFailure is not null => "historical-failure",
            DetectionState.NotChecked => "not-checked",
            _ => "unknown"
        };

    // Selecting an execution target does not assert reachability or grant authenticated access.
    // Detection and engine readiness retain their independent checks below.
    private bool CanSetActiveTarget => !_isEditMode && SelectedProfile is { } profile &&
        FrontendAnalysisSettingsService.IsValidUrl(profile.TargetUrl ?? "") && FaSettings.ValidateProfile(profile).IsValid;

    private bool DetectionReady => ManualVerificationRequired
        ? CanRecordManualVerification && _detectionResult?.DetectedClientFramework.HasValue == true &&
          _detectionResult.Warnings.Count == 0 && (ManualStatus == ManualAuthenticationVerificationStatus.Passed || EdgeStatus.AuthenticatedBrowserAvailable || ProxyApiContextAvailable)
        : _detectionResult?.IsActivationReady == true && CurrentDetectionState == DetectionState.Complete;

    private string? _manualDetectionContext;
    private bool _manualInstructionsOpen;
    private bool _manualResultRecordedThisSession;
    private bool ManualVerificationRequired => _detectionResult?.ManualAuthenticationVerificationRequired == true ||
        CurrentProfile?.Authentication.VerificationMode == AuthenticationVerificationMode.ManualManagedEdge ||
        (_detectionResult is null && CurrentProfile?.ManualVerification is not null);
    private ManualAuthenticationVerificationStatus ManualStatus => CurrentProfile?.ManualVerification?.StatusFor(CurrentProfile)
        ?? (_manualInstructionsOpen ? ManualAuthenticationVerificationStatus.Pending : ManualAuthenticationVerificationStatus.Required);
    /// <summary>
    /// Short status for surfaces that sit beside the Detection result card, which already states the long phrase once.
    /// The stale variants keep their full wording because the sentence carries the instruction, not just the state.
    /// </summary>
    private string ManualVerificationStatusLabel =>
        !_manualResultRecordedThisSession && CurrentProfile?.ManualVerification is { } previous && ManualStatus != ManualAuthenticationVerificationStatus.Stale
            ? $"Previous manual verification: {previous.Result}"
            : ManualStatus switch
            {
                ManualAuthenticationVerificationStatus.Passed => "Manual verification passed",
                ManualAuthenticationVerificationStatus.Failed => "Manual verification failed",
                ManualAuthenticationVerificationStatus.Pending => "Manual verification pending",
                ManualAuthenticationVerificationStatus.Stale => ManualVerificationLabel,
                _ => "Manual verification required",
            };

    private string ManualVerificationLabel => !_manualResultRecordedThisSession && CurrentProfile?.ManualVerification is { } previous && ManualStatus != ManualAuthenticationVerificationStatus.Stale
        ? $"Previous manual authentication verification: {previous.Result}"
        : ManualStatus switch
        {
            ManualAuthenticationVerificationStatus.Passed => "Manual authentication verification passed",
            ManualAuthenticationVerificationStatus.Failed => "Manual authentication verification failed",
            // The recorded result no longer matches the configured expectations. Detection only needs
            // repeating when the profile has diverged from the detection evidence.
            ManualAuthenticationVerificationStatus.Stale when !ManualVerificationContextCurrent => "Manual authentication verification stale. Repeat detection and verification",
            ManualAuthenticationVerificationStatus.Stale when IsDirty => "Manual authentication verification stale. Save changes, then repeat verification",
            ManualAuthenticationVerificationStatus.Stale => "Manual authentication verification stale. Repeat verification",
            ManualAuthenticationVerificationStatus.Pending => "Manual authentication verification pending",
            _ => "Manual authentication verification required"
        };
    /// <summary>
    /// Fingerprint of the current profile for comparison with the detection-time verification context.
    /// Fields that equal the detector's own proposal are treated as unchanged (see
    /// <see cref="DetectionProposalConsistency"/>): applying "Apply authentication" or "Apply detected
    /// type" never invalidates the detection that produced those values. Independent edits that diverge
    /// from the evidence (URL, authority, tenant, client ID, security settings, …) still do.
    /// </summary>
    private string ManualVerificationContextFingerprint(FrontendAnalysisProfile profile) =>
        _detectionProfileSnapshot is { } snapshot && _detectionResult is { } detection
            ? DetectionProposalConsistency.ConsistentFingerprint(profile, snapshot, detection)
            : ManualAuthenticationVerificationEvidence.Fingerprint(profile);

    /// <summary>
    /// True when the current profile is still consistent with the verification context captured at
    /// detection. False only after an edit that diverges from the detection evidence; such an edit
    /// requires detection to be repeated before manual verification can be recorded. This is
    /// independent of target discovery staleness.
    /// </summary>
    private bool ManualVerificationContextCurrent => _manualDetectionContext is null || CurrentProfile is not { } p ||
        _manualDetectionContext == ManualVerificationContextFingerprint(p);
    private bool CanRecordManualVerification => CurrentProfile is { } p && !IsDirty &&
        FaSettings.ValidateProfile(p).IsValid && _detectionResult?.Success == true &&
        CurrentDetectionState == DetectionState.ManualAuthenticationVerificationRequired &&
        _manualDetectionContext is not null && ManualVerificationContextCurrent;
    private void OpenManualVerification()
    {
        _manualInstructionsOpen = true;
        RecomputeManualReadiness();
    }
    private async Task RecordManualVerificationAsync(ManualAuthenticationVerificationStatus result)
    {
        if (!CanRecordManualVerification || CurrentProfile is not { } profile ||
            result is not (ManualAuthenticationVerificationStatus.Passed or ManualAuthenticationVerificationStatus.Failed)) return;
        var evidence = ManualAuthenticationVerificationEvidence.Record(profile, result);
        profile.ManualVerification = evidence;
        if (SelectedProfile is { } saved) saved.ManualVerification = evidence;
        if (_editProfile is not null) _originalProfileJson = System.Text.Json.JsonSerializer.Serialize(_editProfile);
        await FaSettings.SaveAsync(JS);
        _manualResultRecordedThisSession = true;
        RecomputeManualReadiness();
    }
    private void RecomputeManualReadiness()
    {
        if (_detectionResult is { ManualAuthenticationVerificationRequired: true } detection)
        {
            detection.ManualAuthenticationVerificationStatus = ManualStatus;
            detection.IsActivationReady = DetectionReady;
        }
    }

    private bool IsDirty => _editProfile is not null && _originalProfileJson is not null &&
        System.Text.Json.JsonSerializer.Serialize(_editProfile) != _originalProfileJson;

    /// <summary>True when the authentication draft differs from the persisted authentication settings.</summary>
    private bool HasUnsavedAuthenticationChanges => _editProfile is not null && _originalAuthenticationJson is not null &&
        System.Text.Json.JsonSerializer.Serialize(_editProfile.Authentication) != _originalAuthenticationJson;

    private bool TestingMethodChanged => _editProfile is not null &&
        _editProfile.Authentication.AuthenticatedTestingMethod != SelectedProfile?.Authentication.AuthenticatedTestingMethod;

    private bool BrowserTrustChanged => _editProfile is not null &&
        _editProfile.Authentication.BrowserDeliveryTrust != SelectedProfile?.Authentication.BrowserDeliveryTrust;

    // Preserve both existing fingerprint contracts: target identity and proposal-consistent
    // authentication/security context. Applying the detector's own values remains current.
    private bool AuthenticationProposalStale => IsDetectionStale ||
        (_manualDetectionContext is not null && CurrentProfile is { } current &&
         ManualVerificationContextFingerprint(current) != _manualDetectionContext);

    private bool AuthenticationProposalMatches(FrontendAnalysisProfile? profile)
    {
        if (profile is null || _detectionResult is not { Success: true } d || !HasDetectedAuthSettings(d)) return false;
        var a = profile.Authentication;
        var tenant = !string.IsNullOrWhiteSpace(d.DetectedTenantId) ? d.DetectedTenantId : d.TenantMode;
        return (d.DetectedAuthenticationType == FrontendAuthenticationType.None || a.AuthenticationType == d.DetectedAuthenticationType) &&
            (string.IsNullOrWhiteSpace(d.DetectedAuthority) || a.ExpectedAuthority == d.DetectedAuthority) &&
            (string.IsNullOrWhiteSpace(tenant) || a.ExpectedTenant == tenant) &&
            (string.IsNullOrWhiteSpace(d.DetectedClientId) || a.ExpectedClientId == d.DetectedClientId) &&
            d.DetectedRedirectUrls.All(url => a.AllowedRedirectUrls.Contains(url, StringComparer.OrdinalIgnoreCase));
    }

    /// <summary>
    /// Where the detected authentication proposal stands relative to the saved configuration. The rules are
    /// unchanged; only the wording moved to <see cref="AuthenticationPresentation"/> so the Authentication tab
    /// and the Target Application tab cannot drift apart.
    /// </summary>
    private AuthenticationMatchState AuthenticationMatch => AuthenticationProposalStale ? AuthenticationMatchState.Stale :
        _detectionResult?.Success != true || !HasDetectedAuthSettings(_detectionResult) ? AuthenticationMatchState.NotDetected :
        AuthenticationProposalMatches(CurrentProfile) ?
            AuthenticationProposalMatches(SelectedProfile) ? AuthenticationMatchState.MatchesSaved : AuthenticationMatchState.AppliedToDraft
            : AuthenticationMatchState.Detected;

    private string AuthenticationDiscoveryState => AuthenticationPresentation.StateCss(AuthenticationMatch);

    private string AuthenticationDiscoveryLabel => AuthenticationPresentation.StateLabel(AuthenticationMatch);

    /// <summary>
    /// The single detected-versus-configured comparison shown on the Authentication tab. It reads the draft while
    /// editing so "Configured" always names what would be saved, never a stale persisted value.
    /// </summary>
    private IReadOnlyList<AuthenticationComparisonRow> AuthenticationComparison =>
        AuthenticationPresentation.Compare(_detectionResult, CurrentProfile?.Authentication);

    /// <summary>Collapsed while everything matches; opened automatically as soon as a value would change.</summary>
    private bool AuthenticationDetailsOpen => AuthenticationComparison.Any(r => AuthenticationPresentation.IsActionable(r.Status));

    /// <summary>
    /// Whether an authenticated testing context exists right now for the SAVED method. This is runtime evidence,
    /// deliberately separate from whether authentication is configured or manually verified.
    /// </summary>
    private bool AuthenticatedContextAvailable => SelectedTestingMethod switch
    {
        AuthenticatedTestingMethod.LocalHttpsProxy => ProxyStatus.AuthenticatedCredentialAvailable,
        AuthenticatedTestingMethod.ManagedEdgeCdp => EdgeStatus.AuthenticatedBrowserAvailable,
        _ => false
    };

    private string AuthenticatedContextLabel => AuthenticatedContextAvailable
        ? "Authenticated context available"
        : "Authenticated context unavailable";

    private string DetectedAuthenticationLabel => _detectionResult is null ||
        (!_detectionResult.AuthenticationRequired && _detectionResult.DetectedAuthenticationType == FrontendAuthenticationType.None)
            ? "Not determined"
            : _detectionResult.DetectedAuthenticationType == FrontendAuthenticationType.None
                ? "Authentication required (type not determined)"
                : _detectionResult.DetectedAuthenticationType.ToString();

    private string DetectionStateMessage => CurrentDetectionState switch
    {
        DetectionState.Checking => "Checking target settings…",
        DetectionState.Partial when _browserRuntimeInspectionRequired == true => "Server preflight succeeded. Browser inspection is required to finish detection.",
        DetectionState.AuthenticationRequired => "Authentication is required to finish detection in the browser.",
        DetectionState.Complete => "Review the detected/proposed settings below.",
        DetectionState.ManualAuthenticationVerificationRequired => "Target preflight complete. Managed Microsoft Edge work profile required for manual authentication verification.",
        DetectionState.Failed => _detectionResult?.Message ?? "Detection could not be completed safely.",
        DetectionState.Stale => DiscoveryStaleMessage,
        // NotChecked: show historical message if available
        DetectionState.NotChecked when SelectedProfile?.LastDetectionSucceeded == true => "Previously detected. Run detection again to refresh.",
        DetectionState.NotChecked when SelectedProfile?.LastDetectionFailure is not null =>
            $"Previous detection failed ({SelectedProfile.LastDetectionFailure}). Run detection again to retry.",
        DetectionState.NotChecked => "Run Detect settings to check this target.",
        _ => _detectionResult?.Message ?? ""
    };

    /// <summary>
    /// Indicates if target discovery is stale (target identity changed since detection).
    /// </summary>
    private bool IsDetectionStale => CurrentDetectionState == DetectionState.Stale;

    private string DetectionReadinessReason =>
        CurrentDetectionState switch
        {
            DetectionState.NotChecked => "Run Detect settings to verify this environment.",
            DetectionState.ManualAuthenticationVerificationRequired when IsDirty => "Unsaved changes. Save changes and pass manual authentication verification to verify authenticated access.",
            DetectionState.ManualAuthenticationVerificationRequired when !ManualVerificationContextCurrent => "Settings changed since detection. Run Detect settings again and pass manual authentication verification to verify authenticated access.",
            DetectionState.ManualAuthenticationVerificationRequired => "Manual authentication verification must pass to verify authenticated access.",
            DetectionState.AuthenticationRequired => "Interactive browser detection is required to complete authentication. Click 'Continue detection in browser' above.",
            DetectionState.Partial when _browserRuntimeInspectionRequired == true => "Complete the authentication confirmation in the browser and try again.",
            DetectionState.Partial => "Partial detection. Run interactive browser detection again to complete authentication.",
            DetectionState.Stale => DiscoveryStaleReadinessReason,
            DetectionState.Failed => "Detection failed. Run Detect settings successfully to refresh detection evidence.",
            _ => "Detection is not complete. Run Detect settings first."
        };

