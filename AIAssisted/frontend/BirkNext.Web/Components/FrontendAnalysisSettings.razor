    // ── Authentication detection helpers ────────────────────────────────────

    private bool HasDetectedAuthSettings(TargetEnvironmentDetectionResult detection)
    {
        return detection.DetectedAuthenticationType != FrontendAuthenticationType.None ||
               !string.IsNullOrWhiteSpace(detection.DetectedAuthority) ||
               !string.IsNullOrWhiteSpace(detection.DetectedClientId) ||
               !string.IsNullOrWhiteSpace(detection.DetectedTenantId) ||
               !string.IsNullOrWhiteSpace(detection.TenantMode) ||
               detection.DetectedRedirectUrls.Count > 0;
    }

    /// <summary>
    /// Apply authentication: copies the detected authentication proposal (type, authority, tenant,
    /// client ID, redirect URLs) into the DRAFT only. Follows the same Detected → Apply → draft →
    /// Save changes model as the endpoint proposals. Never persists, never activates, never opens a
    /// browser and never records manual verification. Idempotent: applying values that already match
    /// the draft leaves the draft (and dirty state) unchanged.
    /// </summary>
    private void ApplyDetectedAuthenticationSettings()
    {
        if (_detectionResult is null) return;
        var wasEditing = _isEditMode;
        if (!_isEditMode) EnterEditMode();
        if (_editProfile is null) return;

        var auth = _editProfile.Authentication;

        // Apply detected authentication type
        if (_detectionResult.DetectedAuthenticationType != FrontendAuthenticationType.None)
            auth.AuthenticationType = _detectionResult.DetectedAuthenticationType;

        // Apply detected authority
        if (!string.IsNullOrWhiteSpace(_detectionResult.DetectedAuthority))
            auth.ExpectedAuthority = _detectionResult.DetectedAuthority;

        // Apply detected tenant (prefer GUID tenant over mode)
        if (!string.IsNullOrWhiteSpace(_detectionResult.DetectedTenantId))
            auth.ExpectedTenant = _detectionResult.DetectedTenantId;
        else if (!string.IsNullOrWhiteSpace(_detectionResult.TenantMode))
            auth.ExpectedTenant = _detectionResult.TenantMode;

        // Apply detected client ID
        if (!string.IsNullOrWhiteSpace(_detectionResult.DetectedClientId))
            auth.ExpectedClientId = _detectionResult.DetectedClientId;

        // Apply detected redirect URLs (merge with existing, avoiding duplicates)
        if (_detectionResult.DetectedRedirectUrls.Count > 0)
        {
            var merged = new HashSet<string>(auth.AllowedRedirectUrls, StringComparer.OrdinalIgnoreCase);
            foreach (var url in _detectionResult.DetectedRedirectUrls)
                merged.Add(url);
            auth.AllowedRedirectUrls = merged.ToList();
        }

        if (!wasEditing && !IsDirty) CancelEdit();
        StateHasChanged();
    }

    private DiscoveryEvidence? GetEndpointEvidence(string fieldName) =>
        _detectionResult?.DiscoveryEvidence.LastOrDefault(e => e.TargetField == fieldName);

    private void ApplyDetectedEndpoint(string fieldName, string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return;
        if (!_isEditMode) EnterEditMode();
        if (_editProfile is null) return;

        if (fieldName == nameof(_editProfile.RestBaseUrl))
            _editProfile.RestBaseUrl = value;
        else if (fieldName == nameof(_editProfile.GraphQlEndpoint))
            _editProfile.GraphQlEndpoint = value;
        else if (fieldName == nameof(_editProfile.SwaggerUrl))
            _editProfile.SwaggerUrl = value;
        else if (fieldName == nameof(_editProfile.HealthEndpoint))
            _editProfile.HealthEndpoint = value;

        StateHasChanged();
    }

    private void ApplyDetectedIntegration(DiscoveredIntegration integration)
    {
        if (_editProfile is null || integration is null)
            return;

        var integrationType = Enum.TryParse<IntegrationType>(integration.Type, ignoreCase: true, out var parsed)
            ? parsed
            : IntegrationType.REST;

        var newIntegration = new IntegrationConfig
        {
            Id = Guid.NewGuid().ToString("N"),
            Type = integrationType,
            Name = integration.DisplayName ?? integration.Type,
            Endpoint = integration.Endpoint,
            Resource = integration.ResourceName,
            Enabled = true
        };

        if (_editProfile.Integrations == null)
            _editProfile.Integrations = new List<IntegrationConfig>();

        if (!_editProfile.Integrations.Any(i => i.Endpoint == newIntegration.Endpoint && i.Type == newIntegration.Type))
            _editProfile.Integrations.Add(newIntegration);

        StateHasChanged();
    }
