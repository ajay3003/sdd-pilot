@using BirkNext.Web.Models
@using BirkNext.Web.Services
@inject IFrontendAnalysisSettingsService FaSettings
@inject ITargetEnvironmentDetectionApiService DetectionApi
@inject IJSRuntime JS

@* ── Load state ───────────────────────────────────────────────────────────── *@
@if (!FaSettings.IsLoaded)
{
    <p class="loading-state">Loading target environments…</p>
    return;
}

@* ── Notifications ────────────────────────────────────────────────────────── *@
@if (_saveSuccess is not null)
{
    <div class="notification notification-success" role="status">@_saveSuccess</div>
}
@if (_saveError is not null)
{
    <div class="notification notification-error" role="alert">@_saveError</div>
}

@* ── Active profile summary card ─────────────────────────────────────────── *@
<section class="fa-active-card" aria-labelledby="active-environment-heading">
    <h2 id="active-environment-heading" class="fa-section-heading">Active environment</h2>
    @if (EffectiveActiveProfile is { } ap)
    {
        <div class="fa-active-card-header">
            <div class="fa-active-card-left">
                <span class="fa-active-card-name">@ap.Name</span>
            </div>
        </div>
        @if (FaSettings.ActiveProfile is null)
        {
            <div class="fa-active-fallback-warning" role="status">
                No active target is saved. Reviews currently use the first configured target, @ap.Name, as a fallback.
            </div>
        }
        <div class="fa-active-card-grid">
            <div class="fa-active-stat">
                <span class="fa-active-stat-label">Frontend URL</span>
                <span class="fa-active-stat-value fa-active-stat-mono">@(ap.TargetUrl ?? "—")</span>
            </div>
            <div class="fa-active-stat">
                <span class="fa-active-stat-label">Configured authentication</span>
                <span class="fa-active-stat-value">@ap.Authentication.AuthenticationType</span>
            </div>
            @{ var _apv = FaSettings.ValidateProfile(ap); }
            <div class="fa-active-stat">
                <span class="fa-active-stat-label">Configuration validation</span>
                <span class="fa-active-stat-value @(!_apv.IsValid ? "fa-stat-err" : _apv.Warnings.Count > 0 ? "fa-stat-warn" : "fa-stat-ok")">
                    @(!_apv.IsValid ? $"{_apv.Errors.Count} error(s)" : _apv.Warnings.Count > 0 ? $"{_apv.Warnings.Count} warning(s)" : "Valid")
                </span>
            </div>
        </div>
    }
    else
    {
        <p class="fa-active-bar-none">No target environments are configured.</p>
    }
</section>

@* ── Profile list ─────────────────────────────────────────────────────────── *@
<section class="fa-environments" aria-labelledby="environments-heading">
<h2 id="environments-heading" class="fa-section-heading">Environments</h2>
<div class="fa-profiles-row">
    <div class="fa-profiles-list">
        @foreach (var p in FaSettings.Settings.Profiles)
        {
            <button class="fa-profile-chip @(p.Id == _selectedProfileId ? "fa-profile-chip-selected" : "")"
                    aria-selected="@(p.Id == _selectedProfileId ? "true" : "false")"
                    @onclick="() => SelectProfile(p.Id)">
                <span class="fa-env-dot fa-env-dot-@p.EnvironmentType.ToString().ToLowerInvariant()"></span>
                @p.Name
                @if (p.Id == EffectiveActiveProfile?.Id)
                {
                    <span class="fa-active-badge">Active</span>
                }
                @if (p.Id == _selectedProfileId)
                {
                    <span class="fa-selected-badge">Selected</span>
                }
            </button>
        }
    </div>
    <SecondaryButton OnClick="OpenCreateDialog" Class="fa-btn-create">+ Add Environment</SecondaryButton>
</div>
</section>

@* ── Profile detail ───────────────────────────────────────────────────────── *@
@if (SelectedProfile is { } profile)
{
    <div class="fa-profile-detail">

        @* ── Header ── *@
        <div class="fa-detail-header">
            <div class="fa-detail-header-left">
                <div>
                    <div class="fa-detail-kicker">Selected environment</div>
                    <h2 class="fa-detail-name">@profile.Name</h2>
                </div>
            </div>
            <div class="fa-detail-header-actions">
                @if (_isEditMode)
                {
                    <SecondaryButton OnClick="CancelEdit" Disabled="@(_isSaving || !IsDirty)">Cancel</SecondaryButton>
                    <PrimaryButton OnClick="SaveProfileAsync" Disabled="@(_isSaving || !IsDirty)">
                        @(_isSaving ? "Saving…" : "Save changes")
                    </PrimaryButton>
                }
                else
                {
                    <SecondaryButton OnClick="DuplicateProfileAsync">Duplicate</SecondaryButton>
                    <SecondaryButton OnClick="EnterEditMode">Edit Environment</SecondaryButton>
                    <DangerButton OnClick="@(() => _showDeleteConfirm = true)"
                                  Disabled="@(FaSettings.Settings.Profiles.Count <= 1)">Delete</DangerButton>
                }
            </div>
        </div>

        <div class="fa-selected-summary">
            <div class="fa-selected-url">
                <span class="fa-summary-label">Frontend URL</span>
                <span class="fa-summary-url">@(CurrentTargetUrl ?? "—")</span>
            </div>
            <div class="fa-detection-state" role="status">
                <span class="fa-summary-label">Detection</span>
                <strong class="fa-detection-value fa-detection-@DetectionStateCss">@DetectionStateLabel</strong>
            </div>
            <div class="fa-primary-actions" aria-busy="@_isDetecting.ToString().ToLowerInvariant()">
                @if (!_browserDetectionInProgress)
                {
                    <PrimaryButton OnClick="DetectSelectedTargetAsync" Disabled="@(_isDetecting || string.IsNullOrWhiteSpace(CurrentTargetUrl))">
                        @(_isDetecting ? "Detecting..." : CurrentDetectionState == DetectionState.Failed ? "Retry detection" : "Detect settings")
                    </PrimaryButton>
                    @if (profile.Id != EffectiveActiveProfile?.Id)
                    {
                        <SecondaryButton OnClick="SetActiveProfileAsync" Disabled="@(!CanActivateSelected)" aria-describedby="activation-gate-reason">Set as Active</SecondaryButton>
                    }
                }
            </div>

            @* ── Browser detection waiting state ── *@
            @if (_browserDetectionInProgress)
            {
                <div class="fa-browser-detection-waiting" role="status" aria-live="polite">
                    <div class="fa-browser-waiting-header">
                        <div class="fa-browser-spinner"></div>
                        <strong>Waiting for sign-in in BirkNext browser...</strong>
                    </div>
                    <div class="fa-browser-waiting-messages">
                        <p class="fa-browser-message">Complete authentication (account selection, password, MFA, MCAS) in the browser opened by BirkNext.</p>
                        <p class="fa-browser-message">BirkNext will observe your authentication flow and continue when the target application is reached.</p>
                        <p class="fa-browser-message"><small>Do not close the browser window. Use the BirkNext-opened browser, not another browser or window.</small></p>
                        @if (!string.IsNullOrWhiteSpace(_browserDetectionMessage))
                        {
                            <p class="fa-browser-message fa-browser-message-custom">@_browserDetectionMessage</p>
                        }
                    </div>
                    <div class="fa-browser-waiting-actions">
                        <SecondaryButton OnClick="CancelBrowserDetectionAsync">Cancel detection</SecondaryButton>
                    </div>
                </div>
            }

            <p class="fa-detection-help">Detect settings checks this Frontend URL and proposes configuration. Nothing is saved automatically.</p>
            @if (profile.Id != EffectiveActiveProfile?.Id && !CanActivateSelected)
            {
                <p id="activation-gate-reason" class="fa-activation-reason">@ActivationBlockedReason</p>
            }
            @if (_detectionError is not null)
            {
                <p class="fa-detection-error" role="alert">@_detectionError</p>
            }
        </div>

        @if (_detectionResult is not null)
        {
            <section class="fa-result fa-result-@DetectionStateCss" aria-labelledby="detection-result-heading" aria-live="polite">
                <div class="fa-result-heading">
                    <div><span class="fa-result-kicker">Detection result</span><h3 id="detection-result-heading">@DetectionStateLabel</h3></div>
                    <span class="fa-result-confidence">Target detection confidence: @_detectionResult.Confidence</span>
                </div>
                <p class="fa-result-message">@DetectionStateMessage</p>
                <dl class="fa-result-grid">
                    <div><dt>Reachability</dt><dd>@_detectionResult.Reachability</dd></div>
                    <div><dt>Framework</dt><dd>@DetectionPresentation.FrameworkLabel(_detectionResult.DetectedClientFramework)</dd></div>
                    <div><dt>Environment</dt><dd>@(_detectionResult.SuggestedEnvironmentType?.ToString() ?? "Not detected") <small>Proposed</small></dd></div>
                    <div><dt>Detected authentication</dt><dd>@DetectedAuthenticationLabel</dd></div>
                    @if (ManualVerificationRequired)
                    {
                        <div><dt>Manual authentication verification</dt><dd>@ManualVerificationLabel</dd></div>
                    }
                    <div><dt>Profile name</dt><dd>@(_detectionResult.SuggestedProfileName ?? "Not proposed") <small>Proposed</small></dd></div>
                    <div><dt>Configured authentication</dt><dd>@profile.Authentication.AuthenticationType <small>Configured</small></dd></div>
                </dl>
                @if (!string.IsNullOrWhiteSpace(_detectionResult.FrameworkEvidence))
                {
                    <p class="fa-framework-evidence">Framework evidence: @_detectionResult.FrameworkEvidence · @_detectionResult.FrameworkConfidence</p>
                }

                <div class="fa-result-actions">
                    @if (CanContinueDetectionInBrowser() && !IsDetectionStale)
                    {
                        <div>
                            <PrimaryButton OnClick="StartBrowserDetectionAsync" Disabled="@_browserDetectionInProgress">Continue detection in browser</PrimaryButton>
                            <p><small>BirkNext will open a browser for interactive authentication. Complete sign-in in that browser window.</small></p>
                        </div>
                    }
                    @if (_detectionResult.SuggestedEnvironmentType is { } detectedType && profile.EnvironmentType != detectedType)
                    {
                        <SecondaryButton OnClick="ApplyDetectedEnvironmentType">Apply detected type</SecondaryButton>
                    }
                </div>
            </section>
        }

        @if (ManualVerificationRequired)
        {
            <section class="fa-result" aria-label="Manual authentication verification">
                <div role="status">
                    <strong>@ManualVerificationLabel</strong>
                    <p>Your organization requires sign-in using a managed Microsoft Edge work profile. BirkNext cannot verify this sign-in automatically.</p>
                    <p>Configured authentication None means no authentication settings are preconfigured.</p>
                </div>
                @if (!_manualInstructionsOpen)
                {
                    <SecondaryButton OnClick="OpenManualVerification">Open verification instructions</SecondaryButton>
                }
                else
                {
                    <ol>
                        <li>Open @CurrentTargetUrl in your normal enterprise-managed Microsoft Edge work profile.</li>
                        <li>Sign in using your work account.</li>
                        <li>Complete PIN, passkey or MFA manually.</li>
                        <li>If MCAS / Defender for Cloud Apps appears, continue manually.</li>
                        <li>Confirm that the authenticated target application is reached.</li>
                        <li>Return to BirkNext and mark verification as passed or failed.</li>
                    </ol>
                    <p>Only your verification result is recorded. No browser authentication state is transferred.</p>
                    <PrimaryButton OnClick="@(() => RecordManualVerificationAsync(ManualAuthenticationVerificationStatus.Passed))" Disabled="@(!CanRecordManualVerification)">Mark verification passed</PrimaryButton>
                    <SecondaryButton OnClick="@(() => RecordManualVerificationAsync(ManualAuthenticationVerificationStatus.Failed))" Disabled="@(!CanRecordManualVerification)">Mark verification failed</SecondaryButton>
                }
                @if (ManualStatus == ManualAuthenticationVerificationStatus.Failed)
                {
                    <SecondaryButton OnClick="OpenManualVerification">Retry manual verification</SecondaryButton>
                }
                @if (CurrentProfile?.ManualVerification is { } evidence)
                {
                    <p><small>Last recorded verification: @evidence.Result ? @evidence.VerifiedAt ? @evidence.Origin</small></p>
                }
                <p>If you changed environment settings, save them before recording verification. Activation requires current target detection and manual verification Passed.</p>
            </section>
        }

        @{ var typeConflict = GetTypeConflict(profile); }
        @if (typeConflict is not null)
        {
            <div class="fa-type-conflict" role="status">
                <div class="fa-type-conflict-text">
                    <strong>Target type may be incorrect.</strong>
                    Stored type: <strong>@profile.EnvironmentType</strong> · Detected type: <strong>@typeConflict</strong>.
                    Review detected settings before applying changes.
                </div>
                @if (!_isEditMode)
                {
                    <SecondaryButton OnClick="DetectSelectedTargetAsync" Disabled="@(_isDetecting || string.IsNullOrWhiteSpace(profile.TargetUrl))" Class="fa-type-conflict-action">
                        @(_isDetecting ? "Detecting…" : "Review Detect Settings")
                    </SecondaryButton>
                }
            </div>
        }

        @* ── Section tabs ── *@
        <div class="fa-section-tabs" role="tablist">
            @foreach (var (key, label) in Tabs)
            {
                <button class="fa-tab @(_activeTab == key ? "fa-tab-active" : "")"
                        role="tab"
                        aria-selected="@(_activeTab == key ? "true" : "false")"
                        @onclick="() => _activeTab = key">
                    @label
                </button>
            }
        </div>

        @* ── Tab content ── *@
        <div class="fa-tab-content">

            @* ── General ── *@
            @if (_activeTab == "general")
            {
                @if (_isEditMode && _editProfile is not null)
                {
                    <div class="fa-form-grid">
                        <div class="form-field">
                            <label class="fa-label">Environment Name <span class="wsr-required">*</span></label>
                            <input type="text" class="form-control" @bind="_editProfile.Name" />
                        </div>
                        <div class="form-field">
                            <label class="fa-label">Environment Type</label>
                            <select class="form-control" @bind="_editProfile.EnvironmentType">
                                @foreach (var env in Enum.GetValues<FrontendEnvironmentType>())
                                {
                                    <option value="@env">@env</option>
                                }
                            </select>
                        </div>
                        <div class="form-field fa-field-full">
                            <label class="fa-label">Description <span class="form-optional">(optional)</span></label>
                            <input type="text" class="form-control" @bind="_editProfile.Description" />
                        </div>
                        <div class="form-field fa-field-full">
                            <label class="fa-label">Notes <span class="form-optional">(optional)</span></label>
                            <textarea class="form-control" rows="3" @bind="_editProfile.Notes"></textarea>
                        </div>
                    </div>
                }
                else
                {
                    <dl class="fa-detail-list">
                        <div class="fa-dl-row"><dt>Environment Type</dt><dd>@profile.EnvironmentType</dd></div>
                        <div class="fa-dl-row"><dt>Description</dt><dd>@(profile.Description ?? "No description")</dd></div>
                        <div class="fa-dl-row"><dt>Notes</dt><dd>@(profile.Notes ?? "No notes")</dd></div>
                    </dl>
                }
            }

            @* ── Target Application ── *@
            @if (_activeTab == "target")
            {
                @if (_isEditMode && _editProfile is not null)
                {
                    <div class="fa-form-grid">
                        <div class="fa-threshold-group-title fa-field-full">Frontend</div>
                        <div class="form-field fa-field-full">
                            <label class="fa-label">Frontend Base URL</label>
                            <input type="url" class="form-control" placeholder="https://myapp.example.com"
                                   @bind="_editProfile.TargetUrl"
                                   @bind:after="() => ClearDetectionState()" />
                        </div>

                        @* Detection results summary with provenance *@
                        @if (_detectionResult?.Success == true)
                        {
                            <div class="fa-detection-summary fa-field-full" style="margin-top: 1.5rem; padding: 1rem; background: var(--color-surface-subtle); border-radius: 0.5rem; border-left: 3px solid var(--color-primary);">
                                <div style="font-weight: 600; margin-bottom: 0.75rem;">Detected from target</div>

                                @* Detection result rows with provenance *@
                                <div style="display: grid; grid-template-columns: 1fr 1.5fr 1fr; gap: 1rem; font-size: 0.875rem; row-gap: 0.75rem;">
                                    @* Reachability *@
                                    <div style="color: var(--color-text-subtle);">Reachability</div>
                                    <div style="font-weight: 500;">@_detectionResult.Reachability</div>
                                    <div style="color: var(--color-text-subtle); text-align: right;">Detected</div>

                                    @* Client Framework *@
                                    @if (_detectionResult.DetectedClientFramework.HasValue)
                                    {
                                        <div style="color: var(--color-text-subtle);">Framework</div>
                                        <div style="font-weight: 500;">@DetectionPresentation.FrameworkLabel(_detectionResult.DetectedClientFramework)</div>
                                        <div style="color: var(--color-text-subtle); text-align: right;">Detected</div>
                                    }

                                    @* Authentication Required *@
                                    @if (_detectionResult.AuthenticationRequired)
                                    {
                                        <div style="color: var(--color-text-subtle);">Authentication required</div>
                                        <div style="font-weight: 500;">Yes</div>
                                        <div style="color: var(--color-text-subtle); text-align: right;">Detected</div>
                                    }

                                    @* Identity Provider *@
                                    @if (_detectionResult.DetectedAuthenticationType != FrontendAuthenticationType.None && !string.IsNullOrWhiteSpace(_detectionResult.DetectedAuthority))
                                    {
                                        <div style="color: var(--color-text-subtle);">Identity provider</div>
                                        <div style="font-weight: 500;">@_detectionResult.DetectedAuthenticationType</div>
                                        <div style="color: var(--color-text-subtle); text-align: right;">Detected</div>
                                    }

                                    @* Authority *@
                                    @if (!string.IsNullOrWhiteSpace(_detectionResult.DetectedAuthority))
                                    {
                                        <div style="color: var(--color-text-subtle);">Authority</div>
                                        <div style="font-family: monospace; font-weight: 500; word-break: break-all;">@_detectionResult.DetectedAuthority</div>
                                        <div style="color: var(--color-text-subtle); text-align: right;">Detected</div>
                                    }

                                    @* Tenant / Tenant Mode *@
                                    @if (!string.IsNullOrWhiteSpace(_detectionResult.DetectedTenantId))
                                    {
                                        <div style="color: var(--color-text-subtle);">Tenant</div>
                                        <div style="font-family: monospace; font-weight: 500; word-break: break-all;">@_detectionResult.DetectedTenantId</div>
                                        <div style="color: var(--color-text-subtle); text-align: right;">Detected</div>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(_detectionResult.TenantMode))
                                    {
                                        <div style="color: var(--color-text-subtle);">Tenant mode</div>
                                        <div style="font-weight: 500;">@_detectionResult.TenantMode</div>
                                        <div style="color: var(--color-text-subtle); text-align: right;">Detected</div>
                                    }

                                    @* Client ID *@
                                    @if (!string.IsNullOrWhiteSpace(_detectionResult.DetectedClientId))
                                    {
                                        <div style="color: var(--color-text-subtle);">Client/Application ID</div>
                                        <div style="font-family: monospace; font-weight: 500; word-break: break-all;">@_detectionResult.DetectedClientId</div>
                                        <div style="color: var(--color-text-subtle); text-align: right;">Detected</div>
                                    }

                                    @* Environment Type (Suggested) *@
                                    @if (_detectionResult.SuggestedEnvironmentType.HasValue)
                                    {
                                        <div style="color: var(--color-text-subtle);">Environment type</div>
                                        <div style="font-weight: 500;">
                                            @_detectionResult.SuggestedEnvironmentType
                                            @if (_editProfile is not null && _editProfile.EnvironmentType != _detectionResult.SuggestedEnvironmentType.Value)
                                            {
                                                <button type="button" class="fa-apply-suggestion" @onclick="ApplyDetectedEnvironmentType">Apply detected type</button>
                                            }
                                        </div>
                                        <div style="color: var(--color-text-subtle); text-align: right;">Suggested</div>
                                    }

                                    @* Profile Name (Suggested) *@
                                    @if (!string.IsNullOrWhiteSpace(_detectionResult.SuggestedProfileName))
                                    {
                                        <div style="color: var(--color-text-subtle);">Profile name</div>
                                        <div style="font-weight: 500;">@_detectionResult.SuggestedProfileName</div>
                                        <div style="color: var(--color-text-subtle); text-align: right;">Suggested</div>
                                    }
                                </div>

                                @* Authentication Support Status *@
                                @if (_detectionResult.AuthenticationRequired && _detectionResult.DetectedAuthenticationType != FrontendAuthenticationType.None)
                                {
                                    <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--color-border); font-size: 0.875rem;">
                                        <div style="font-weight: 600; margin-bottom: 0.5rem;">Authentication Support</div>
                                        <div style="color: var(--color-warning); font-size: 0.8125rem;">
                                            <strong>Note:</strong> Authenticated review is <strong>not currently supported</strong> in Frontend Quality Review.
                                            Detection only identifies the authentication configuration of your target.
                                        </div>
                                    </div>
                                }

                                @* Stale Detection Warning *@
                                @if (IsDetectionStale)
                                {
                                    <div style="margin-top: 1rem; padding: 0.75rem; background: var(--color-warning-bg, rgba(255, 193, 7, 0.1)); border-left: 3px solid var(--color-warning); border-radius: 0.25rem; font-size: 0.875rem;">
                                        <div style="color: var(--color-warning); font-weight: 600; margin-bottom: 0.25rem;">⚠️ Discoveries are stale</div>
                                        <div style="color: var(--color-text-muted); font-size: 0.8125rem;">The target URL changed since detection. Run Detect settings again to refresh discovered endpoints and integrations.</div>
                                    </div>
                                }

                        @* Detected API Endpoints *@
                                @if (!IsDetectionStale && (!string.IsNullOrWhiteSpace(_detectionResult.DetectedRestBaseUrl) ||
                                     !string.IsNullOrWhiteSpace(_detectionResult.DetectedGraphQlEndpoint) ||
                                     !string.IsNullOrWhiteSpace(_detectionResult.DetectedSwaggerUrl) ||
                                     !string.IsNullOrWhiteSpace(_detectionResult.DetectedHealthEndpoint)))
                                {
                                    <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--color-border); font-size: 0.875rem;">
                                        <div style="font-weight: 600; margin-bottom: 0.75rem;">Discovered API Endpoints</div>
                                        @if (!string.IsNullOrWhiteSpace(_detectionResult.DetectedRestBaseUrl))
                                        {
                                            <EndpointProposal Field="RestBaseUrl" Label="REST Base URL" Value="@_detectionResult.DetectedRestBaseUrl"
                                                ApplyLabel="Apply REST" Evidence="@GetEndpointEvidence("RestBaseUrl")"
                                                CanApply="@(_isEditMode && (_editProfile?.RestBaseUrl ?? "") != _detectionResult.DetectedRestBaseUrl)"
                                                OnApply="@(() => ApplyDetectedEndpoint(nameof(FrontendAnalysisProfile.RestBaseUrl), _detectionResult.DetectedRestBaseUrl))" />
                                        }
                                        @if (!string.IsNullOrWhiteSpace(_detectionResult.DetectedGraphQlEndpoint))
                                        {
                                            <EndpointProposal Field="GraphQlEndpoint" Label="GraphQL Endpoint" Value="@_detectionResult.DetectedGraphQlEndpoint"
                                                ApplyLabel="Apply GraphQL" Evidence="@GetEndpointEvidence("GraphQlEndpoint")"
                                                CanApply="@(_isEditMode && (_editProfile?.GraphQlEndpoint ?? "") != _detectionResult.DetectedGraphQlEndpoint)"
                                                OnApply="@(() => ApplyDetectedEndpoint(nameof(FrontendAnalysisProfile.GraphQlEndpoint), _detectionResult.DetectedGraphQlEndpoint))" />
                                        }
                                        @if (!string.IsNullOrWhiteSpace(_detectionResult.DetectedSwaggerUrl))
                                        {
                                            <EndpointProposal Field="SwaggerUrl" Label="Swagger / OpenAPI" Value="@_detectionResult.DetectedSwaggerUrl"
                                                ApplyLabel="Apply Swagger" Evidence="@GetEndpointEvidence("SwaggerUrl")"
                                                CanApply="@(_isEditMode && (_editProfile?.SwaggerUrl ?? "") != _detectionResult.DetectedSwaggerUrl)"
                                                OnApply="@(() => ApplyDetectedEndpoint(nameof(FrontendAnalysisProfile.SwaggerUrl), _detectionResult.DetectedSwaggerUrl))" />
                                        }
                                        @if (!string.IsNullOrWhiteSpace(_detectionResult.DetectedHealthEndpoint))
                                        {
                                            <EndpointProposal Field="HealthEndpoint" Label="Health Endpoint" Value="@_detectionResult.DetectedHealthEndpoint"
                                                ApplyLabel="Apply Health" Evidence="@GetEndpointEvidence("HealthEndpoint")"
                                                CanApply="@(_isEditMode && (_editProfile?.HealthEndpoint ?? "") != _detectionResult.DetectedHealthEndpoint)"
                                                OnApply="@(() => ApplyDetectedEndpoint(nameof(FrontendAnalysisProfile.HealthEndpoint), _detectionResult.DetectedHealthEndpoint))" />
                                        }
