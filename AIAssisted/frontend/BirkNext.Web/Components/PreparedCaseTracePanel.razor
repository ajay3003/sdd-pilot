@using BirkNext.TestPlanning
@using L = BirkNext.Web.Services.RequirementLinkPresentation
@* Saved test cases (Test Plan Suggestions) as test-design evidence: requirement → cases, requirements without test design, and every case with its
   stage, its links (automatically identified or manually confirmed) and why each link is or is not counted. Read-only; the same view in Test
   Coverage Review and Requirements Traceability (PreparedCaseTraceability). Test design is never execution: executed and passed tests are the
   review's own evidence. *@

<section class="pct" data-testid="pct" aria-labelledby="pct-title">
    <h3 id="pct-title" class="pct-title">Prepared test cases</h3>
    @if (View is null)
    {
        <p class="pct-muted" data-testid="pct-none">@(Message ?? "No project is loaded, so no saved test case is shown.")</p>
    }
    else
    {
        <p class="pct-boundary" data-testid="pct-boundary">@View.Boundary</p>
        <dl class="pct-counts" data-testid="pct-counts">
            <div><dt>Saved test cases</dt><dd data-testid="pct-cases">@View.Cases</dd></div>
            <div><dt>Linked to the specification</dt><dd data-testid="pct-linked">@View.LinkedCases</dd></div>
            <div><dt>Not linked (not counted)</dt><dd data-testid="pct-unlinked">@View.UnlinkedCases</dd></div>
            @if (View.SpecificationRequirements is { } total)
            {
                <div><dt>Requirements in the specification</dt><dd data-testid="pct-req-total">@total</dd></div>
            }
            <div><dt>Requirements with an approved test design</dt><dd data-testid="pct-req-approved">@View.RequirementsWithApprovedCase</dd></div>
            <div><dt>Requirements with a prepared test design only</dt><dd data-testid="pct-req-prepared">@View.RequirementsWithPreparedCaseOnly</dd></div>
            @if (View.SpecificationRequirements is not null)
            {
                <div><dt>Requirements without test design</dt><dd data-testid="pct-req-none">@View.WithoutTestDesign.Count</dd></div>
            }
        </dl>
        <p class="pct-muted" data-testid="pct-explain">@Explain(View)</p>
        @foreach (var limitation in View.Limitations)
        {
            <p class="pct-muted" data-testid="pct-limitation">@limitation</p>
        }
        @if (View.Cases == 0)
        {
            <p class="pct-muted" data-testid="pct-empty">This project has no saved test case yet. Prepare cases in <a href="test-plan-suggestions">Test Plan Suggestions</a>.</p>
        }
        @if (View.Requirements.Count > 0)
        {
            <table class="pct-table" data-testid="pct-requirements">
                <thead><tr><th scope="col">Requirement</th><th scope="col">Test design</th><th scope="col">How linked</th><th scope="col">Saved cases</th></tr></thead>
                <tbody>
                    @foreach (var r in View.Requirements)
                    {
                        <tr data-testid="pct-requirement" data-requirement="@r.RequirementId">
                            <th scope="row" data-label="Requirement"><span class="pct-req-id">@r.RequirementId</span>@if (r.Title is { Length: > 0 } title) { <span class="pct-req-title" data-testid="pct-requirement-title">@title</span> }</th>
                            <td data-label="Test design">@r.State <span class="pct-muted">(@r.ApprovedCases approved, @r.PreparedCases prepared)</span></td>
                            <td data-label="How linked" data-testid="pct-requirement-origin">@Origins(r)</td>
                            <td data-label="Saved cases">
                                @foreach (var key in r.CaseKeys)
                                {
                                    var c = View.CaseList.FirstOrDefault(x => x.CaseKey == key);
                                    if (c is not null) { <a class="pct-case-link" href="@c.Href" data-testid="pct-requirement-case">@c.Title</a> }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        @if (View.Integration.Count > 0)
        {
            @* Integration testing of the requirements: confirmed requirement ↔ journey links and the suites prepared for the journeys. Shown apart from
               the manual counts above (never added to them); a prepared suite is not an execution. *@
            <h3 class="pct-h3" data-testid="pct-integration-title">Integration testing</h3>
            <table class="pct-table" data-testid="pct-integration">
                <thead><tr><th scope="col">Requirement</th><th scope="col">Journey</th><th scope="col">Test suites prepared for the journey</th></tr></thead>
                <tbody>
                    @foreach (var t in View.Integration)
                    {
                        <tr data-testid="pct-integration-row" data-requirement="@t.RequirementId" data-journey="@t.JourneyId">
                            <th scope="row" data-label="Requirement"><span class="pct-req-id">@t.RequirementId</span> <span class="pct-req-title">@t.RequirementTitle</span></th>
                            <td data-label="Journey"><a href="@($"technical-testing/integrations?stage=prepare&journey={Uri.EscapeDataString(t.JourneyId)}")" data-testid="pct-integration-journey">@t.JourneyName</a>
                                @if (t.CurrentJourneyRevision != t.LinkedAtJourneyRevision) { <span class="pct-muted" data-testid="pct-integration-revised"> (linked at revision @t.LinkedAtJourneyRevision; the journey is now at revision @t.CurrentJourneyRevision)</span> }</td>
                            <td data-label="Test suites">
                                @if (t.Suites.Count == 0) { <span class="pct-muted" data-testid="pct-integration-no-suite">No suite prepared yet</span> }
                                @foreach (var s in t.Suites)
                                {
                                    <span class="pct-integration-suite" data-testid="pct-integration-suite" data-executed="@(s.Executed ? "true" : "false")"><a href="@s.Href">@s.Name r@(s.Revision)</a> — @s.Outcome</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        @if (View.StoryAssociations.Count > 0)
        {
            @* Requirements confirmed for a user story as a whole: an association, never counted above and never inherited by the story's cases. *@
            <details class="pct-gaps" data-testid="pct-stories">
                <summary>Requirements associated with user stories (@View.StoryAssociations.Count, not counted)</summary>
                <p class="pct-muted">A tester confirmed these for a whole user story in Plan &amp; prepare. They describe what the story is about; they are not a test case's design, so they never count as coverage and its scenarios and cases do not inherit them.</p>
                <ul class="pct-gap-list">
                    @foreach (var a in View.StoryAssociations)
                    {
                        <li data-testid="pct-story-association" data-story="@a.StoryKey" data-requirement="@a.RequirementId">
                            <strong>@a.RequirementId</strong>@(a.Title is { Length: > 0 } at ? $" — {at}" : "")
                            <span class="pct-chip" data-testid="pct-story-association-story">@(a.StoryId ?? a.StoryKey)</span>
                            @if (L.ValidityLabel(a.Validity) is { Length: > 0 } validity) { <span class="pct-chip pct-chip-quiet" data-testid="pct-story-association-validity">@validity</span> }
                            <span class="pct-muted">@(a.StoryTitle is { Length: > 0 } st ? st + " · " : "")confirmed by @(string.IsNullOrWhiteSpace(a.LinkedBy) ? "a tester" : a.LinkedBy) · <a href="@a.Href">@a.PlanName</a></span>
                        </li>
                    }
                </ul>
            </details>
        }
        @if (View.WithoutTestDesign.Count > 0)
        {
            <details class="pct-gaps" data-testid="pct-gaps">
                <summary>Requirements without test design (@View.WithoutTestDesign.Count)</summary>
                <p class="pct-muted">No active saved case covers these requirements yet, by its own evidence or by a tester's link. This is missing test design; missing execution is shown by the review's test evidence.</p>
                <ul class="pct-gap-list">
                    @foreach (var g in View.WithoutTestDesign)
                    {
                        <li data-testid="pct-gap" data-requirement="@g.RequirementId"><strong>@g.RequirementId</strong>@(g.Title is { Length: > 0 } t ? $" — {t}" : "")</li>
                    }
                </ul>
            </details>
        }
        @if (View.Cases > 0)
        {
            <details class="pct-cases" open="@ShowCases" data-testid="pct-case-list">
                <summary>All saved cases (@View.Cases)</summary>
                <ul class="pct-case-items">
                    @foreach (var c in View.CaseList)
                    {
                        <li class="pct-case" data-testid="pct-case" data-case="@c.CaseKey" data-stage="@c.Stage" data-counted="@(c.Counted ? "true" : "false")">
                            <a href="@c.Href" class="pct-case-title" data-testid="pct-case-open">@c.Title</a>
                            <span class="pct-chip" data-testid="pct-case-stage">@c.StageLabel</span>
                            <span class="pct-muted">@c.PlanName · @(c.SourceKind == ScenarioSourceKind.Manual ? "written by hand" : $"from {c.Capability ?? "discovery"}")</span>
                            @if (c.Requirements.Count == 0)
                            {
                                <div class="pct-muted" data-testid="pct-case-unlinked">No requirement link — visible here, not counted as requirement coverage. Link requirements to the case in Test Plan Suggestions.</div>
                            }
                            else
                            {
                                <ul class="pct-links">
                                    @foreach (var link in c.Requirements)
                                    {
                                        <li data-testid="pct-case-link" data-counted="@(link.Counted ? "true" : "false")" data-origin="@(link.Manual ? "manual" : "automatic")">
                                            <strong>@link.RequirementId</strong>@(link.Title is { Length: > 0 } lt ? $" {lt}" : "")
                                            <span class="pct-chip" data-testid="pct-case-link-origin">@L.OriginLabel(link.Basis)</span>
                                            @if (L.ValidityLabel(link.Validity) is { Length: > 0 } validity) { <span class="pct-chip pct-chip-quiet" data-testid="pct-case-link-validity">@validity</span> }
                                            — @(link.Counted ? "counted" : "not counted"): @link.Explanation
                                        </li>
                                    }
                                </ul>
                            }
                            @if (c.SpecificationScenarioId is { } scenario)
                            {
                                <div class="pct-muted" data-testid="pct-case-scenario">Prepared from acceptance scenario @scenario (the same scenario Test Coverage lists as a QA test; counted once).</div>
                            }
                            @if (c.CriticalE2EFlowIds.Count > 0)
                            {
                                <div class="pct-muted" data-testid="pct-case-flows">Critical E2E flow(s): @string.Join(", ", c.CriticalE2EFlowIds) — their runs belong to the flow, not to this case.</div>
                            }
                        </li>
                    }
                </ul>
            </details>
        }
    }
</section>

@code {
    /// <summary>The traced cases; null shows <see cref="Message"/> (no project, or the view could not be read).</summary>
    [Parameter] public PreparedCaseTraceView? View { get; set; }
    [Parameter] public string? Message { get; set; }
    /// <summary>Open the case list at first (true when no requirement row explains the cases).</summary>
    [Parameter] public bool ShowCases { get; set; }

    /// <summary>The numbers in one plain sentence: each requirement counts once, design is not execution.</summary>
    private static string Explain(PreparedCaseTraceView v)
    {
        var designed = v.RequirementsWithApprovedCase + v.RequirementsWithPreparedCaseOnly;
        var of = v.SpecificationRequirements is { } total ? $"{designed} of {total} requirements" : $"{designed} requirement{(designed == 1 ? "" : "s")}";
        return $"{of} have a saved test case designed for them ({v.RequirementsWithApprovedCase} approved, {v.RequirementsWithPreparedCaseOnly} prepared only). "
            + "Each requirement counts once, however many cases cover it. "
            + "This is test design, not execution: manual tests are executed in Azure DevOps Test Plans, and BirkNext does not read those results.";
    }

    private static string Origins(PreparedRequirementTrace r) => (r.AutomaticCases, r.ManualCases) switch
    {
        ( > 0, > 0) => $"{L.AutomaticLabel} ({r.AutomaticCases}) · {L.ManualLabel} ({r.ManualCases})",
        (0, > 0) => $"{L.ManualLabel} ({r.ManualCases})",
        ( > 0, 0) => $"{L.AutomaticLabel} ({r.AutomaticCases})",
        _ => L.AutomaticLabel,
    };
}
