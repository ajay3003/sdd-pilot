@using BirkNext.TestPlanning
@using BirkNext.Web.Services
@* «Legg til scenarioer» (Testplaner v4, 2026-11-26): plan existing source-backed scenarios — acceptance scenarios and standalone documented tests
   of THIS project's discovery — into a chosen testgruppe of an existing plan. Scenario-first: no test case is created, no result is recorded,
   a scenario the plan already holds is shown as such and never added twice. Each addition names the plan revision it started from. *@

@* BUG-001 (manual E2E 2026-11-27): a click on the backdrop closed the dialog and lost search, filters, selected scenarios and the chosen testgruppe.
   Now the backdrop never closes it; «Lukk» and Escape close at once when nothing is chosen, and ask first when there is unsaved work. *@
<div class="mtp-preview-backdrop asp-backdrop" @onclick="KeepFocusAsync" data-testid="asp">
    <div class="mtp-preview asp" role="dialog" aria-modal="true" aria-labelledby="asp-title" tabindex="-1" @ref="_dialog" @onclick:stopPropagation="true" @onkeydown="KeyAsync" data-testid="asp-dialog">
        <header class="mtp-preview-head">
            <h2 id="asp-title" class="mtp-preview-title">Legg til scenarioer@(_plan is { } p ? $" i «{p.PlanName}»" : "")</h2>
            <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseAsync" data-testid="asp-close">Lukk</button>
        </header>
        @if (_confirmClose)
        {
            <div class="msb-callout is-warn asp-confirm" role="alertdialog" aria-labelledby="asp-confirm-text" data-testid="asp-confirm">
                <p id="asp-confirm-text">@DirtyText() Lukke uten å legge til?</p>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="KeepOpenAsync" @ref="_keepButton" data-testid="asp-confirm-keep">Fortsett å velge</button>
                <button type="button" class="btn btn-outline-danger btn-sm" @onclick="DiscardAsync" data-testid="asp-confirm-discard">Lukk uten å legge til</button>
            </div>
        }
        @if (_error is { } err) { <p class="msb-error" role="alert" data-testid="asp-error">@err</p> }
        @if (_plan is null)
        {
            <p class="mt-muted" role="status" data-testid="asp-loading">@(_error is null ? "Henter testplanen …" : "")</p>
        }
        else if (_discovery is null || _all.Count == 0)
        {
            <p class="msb-empty" data-testid="asp-no-scenarios">Ingen scenarioer er funnet for prosjektet ennå. Åpne <a href="@ManualTestingPresentation.DiscoverRoute">Finn og forstå</a> for å hente dem.</p>
        }
        else
        {
            var shown = Shown();
            <div class="asp-body">
                <div class="asp-filters" role="search" aria-label="Filtrer scenarioer">
                    <input type="search" class="msb-search" placeholder="Søk i tittel, US/AC eller TEST-id" aria-label="Søk i scenarioer" value="@_query" @oninput="e => { _query = e.Value?.ToString() ?? string.Empty; _limit = Page; _ = SearchBeyondAsync(more: false); }" data-testid="asp-search" />
                    <select class="msb-select" aria-label="Modul" @onchange="e => { _module = Blank(e.Value); _limit = Page; _ = SearchBeyondAsync(more: false); }" data-testid="asp-module">
                        <option value="">Alle moduler</option>
                        @foreach (var m in _modules) { <option value="@m" selected="@(_module == m)">@m</option> }
                    </select>
                    <select class="msb-select" aria-label="Testnivå" @onchange="e => { _level = Blank(e.Value); _limit = Page; _ = SearchBeyondAsync(more: false); }" data-testid="asp-level">
                        <option value="">Alle testnivåer</option>
                        @foreach (var l in TestLevelClassifier.Order) { <option value="@l" selected="@(_level == l.ToString())">@TestLevelClassifier.Label(l)</option> }
                    </select>
                    <select class="msb-select" aria-label="Prioritet" @onchange="e => { _priority = Blank(e.Value); _limit = Page; _ = SearchBeyondAsync(more: false); }" data-testid="asp-priority">
                        <option value="">Alle prioriteter</option>
                        @foreach (var pr in _priorities) { <option value="@pr" selected="@(_priority == pr)">@pr</option> }
                        <option value="none" selected="@(_priority == "none")">Ikke prioritert</option>
                    </select>
                    <span class="mt-muted msb-small" data-testid="asp-count">@shown.Count av @_all.Count scenarioer · @_selected.Count valgt</span>
                </div>
                <ul class="asp-list" aria-label="Scenarioer" data-testid="asp-list">
                    @foreach (var c in shown.Take(_limit)) { @Row(c, "asp-row") }
                </ul>
                <ShowMore Shown="@Math.Min(_limit, shown.Count)" Total="@shown.Count" Step="Page" Noun="scenarioer" OnMore="() => _limit += Page" TestId="asp-more" />
                @if (_discovery?.NotKept is > 0 and var notKept)
                {
                    @* 2026-11-27 (P1): the scenarios not loaded with the page (beyond the first window) are searched on the server - same project and
                       module/specification selection, same filters - and can be chosen like the others. Nothing is loaded without a search or filter. *@
                    <section class="asp-beyond" aria-label="Scenarioer som ikke er lastet inn" data-testid="asp-beyond">
                        @if (!SearchesBeyond)
                        {
                            <p class="mt-muted msb-small" data-testid="asp-beyond-hint">@notKept scenario@(notKept == 1 ? "" : "er") er ikke lastet inn. Søk, eller velg modul, testnivå eller prioritet, for å finne dem.</p>
                        }
                        else if (_beyond is { } beyondPage)
                        {
                            <h3 class="mtp-ctx-label" data-testid="asp-beyond-title">Treff blant scenarioene som ikke er lastet inn (@beyondPage.Total)</h3>
                            @if (_beyondItems.Count > 0)
                            {
                                <ul class="asp-list" aria-label="Treff som ikke er lastet inn" data-testid="asp-beyond-list">
                                    @foreach (var c in _beyondItems) { @Row(c, "asp-beyond-row") }
                                </ul>
                                <ShowMore Shown="@_beyondItems.Count" Total="@beyondPage.Total" Step="BeyondPage" Noun="treff" OnMore="() => SearchBeyondAsync(more: true)" Error="@_beyondError" TestId="asp-beyond-more" />
                            }
                            else { <p class="mt-muted msb-small" data-testid="asp-beyond-none">Ingen treff blant scenarioene som ikke er lastet inn.</p> }
                        }
                        else if (_beyondError is { } be) { <p class="msb-error" role="alert" data-testid="asp-beyond-error">@be <button type="button" class="msb-link" @onclick="() => SearchBeyondAsync(more: false)">Prøv igjen</button></p> }
                        else { <InlineLoading Text="Søker i hele utvalget …" TestId="asp-beyond-loading" /> }
                    </section>
                }
            </div>
            <footer class="mtp-preview-foot asp-foot">
                <label class="asp-suite">Testgruppe
                    <select class="msb-select" @onchange="e => { _suite = Blank(e.Value); _suiteChosen = true; }" data-testid="asp-suite">
                        @if (_plan.Suites.Count == 0) { <option value="">Ny testgruppe «Planlagte scenarioer»</option> }
                        else if (PreSelected is not null && !_suiteChosen) { <option value="" selected>Velg testgruppe …</option> }
                        @foreach (var (suite, depth) in PlanStructure.Flatten(_plan.Suites))
                        {
                            <option value="@suite.Id" selected="@(_suite == suite.Id)">@(new string(' ', depth * 2))@PlanStructure.PathOf(_plan.Suites, suite.Id)</option>
                        }
                    </select></label>
                <span class="mt-muted msb-small">Scenarioene planlegges uten testtilfelle; testtilfeller er valgfrie og kan forberedes senere.</span>
                @if (_notice is { } n) { <span class="msb-status msb-tone-ok" role="status" data-testid="asp-notice">@n</span> }
                @if (NeedsSuiteChoice) { <span class="msb-small" role="status" data-testid="asp-suite-required">Velg testgruppen scenarioene skal legges i.</span> }
                <button type="button" class="btn btn-primary" disabled="@(_busy || _selected.Count == 0 || NeedsSuiteChoice)" @onclick="AddAsync" data-testid="asp-add">Legg til @_selected.Count scenario@(_selected.Count == 1 ? "" : "er")</button>
            </footer>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ITestPlanSuggestionsApiService Api { get; set; } = default!;
    [Parameter, EditorRequired] public string ProjectKey { get; set; } = "";
    [Parameter, EditorRequired] public Guid PlanId { get; set; }
    /// <summary>The project's current discovery (the same scenarios Finn og forstå shows); only its acceptance scenarios and documented tests are offered.</summary>
    [Parameter] public ScenarioDiscoveryResult? Discovery { get; set; }
    /// <summary>Reads the discovery when the page did not load it (Testplaner reads it only when this dialog opens).</summary>
    [Parameter] public Func<Task<ScenarioDiscoveryResult?>>? LoadDiscovery { get; set; }
    private ScenarioDiscoveryResult? _discovery;
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>The plan after an addition (the dialog stays open so more scenarios can go to another testgruppe).</summary>
    [Parameter] public EventCallback<TestPlanDraft> OnAdded { get; set; }
    /// <summary>
    /// V12 (2026-11-27, MT-9): scenarios chosen in Finn og forstå (candidate ids), selected when the dialog opens. The destination test group is then
    /// never chosen silently: the tester picks it (brief §14). Ids that cannot be planned here (not an acceptance scenario or documented test,
    /// or not loaded) are counted, never dropped silently.
    /// </summary>
    [Parameter] public IReadOnlyCollection<string>? PreSelected { get; set; }
    private bool _suiteChosen;
    private bool NeedsSuiteChoice => PreSelected is not null && !_suiteChosen && _plan is { Suites.Count: > 0 };

    private const int Page = 100;
    private TestPlanDraft? _plan;
    private List<DiscoveredScenario> _all = [];
    private List<string> _modules = [], _priorities = [];
    private readonly HashSet<string> _selected = new(StringComparer.Ordinal);
    private string _query = "";
    private string? _module, _level, _priority, _suite, _error, _notice;
    private int _limit = Page;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _discovery = Discovery ?? (LoadDiscovery is null ? null : await LoadDiscovery());
        _all = [.. (_discovery?.Candidates ?? []).Where(ScenarioTypeClassifier.IsClassifiable)
            .OrderBy(c => c.Story?.SpecificationPath ?? "~").ThenBy(c => c.Story?.StoryId ?? "~").ThenBy(c => c.NumberInStory ?? 999).ThenBy(c => c.Title, StringComparer.CurrentCultureIgnoreCase)];
        _modules = [.. _all.Select(Module).OfType<string>().Distinct().Order(StringComparer.CurrentCultureIgnoreCase)];
        _priorities = [.. _all.Select(Priority).OfType<string>().Distinct().OrderBy(p => int.TryParse(p.AsSpan(1), out var n) ? n : 99)];
        // The modules and priorities of the scenarios not loaded are offered too, so a filter can find them (server search).
        if (_discovery?.NotKeptFacets is { } more)
        {
            _modules = [.. _modules.Concat(more.Modules).Distinct().Order(StringComparer.CurrentCultureIgnoreCase)];
            _priorities = [.. _priorities.Concat(more.Priorities.Select(p => p.Trim().ToUpperInvariant()).Where(p => p.Length == 2 && p[0] == 'P' && char.IsDigit(p[1])))
                .Distinct().OrderBy(p => int.TryParse(p.AsSpan(1), out var n) ? n : 99)];
        }
        await LoadPlanAsync();
        if (PreSelected is { Count: > 0 } wanted)
        {
            var offered = _all.Where(c => !InPlan(c)).Select(c => c.CandidateId).ToHashSet(StringComparer.Ordinal);
            foreach (var id in wanted.Where(offered.Contains)) _selected.Add(id);
            var inPlan = wanted.Count(id => _all.Any(c => c.CandidateId == id && InPlan(c)));
            var other = wanted.Count - _selected.Count - inPlan;
            _notice = string.Join(" ", new[]
            {
                $"{_selected.Count} valgt fra Finn og forstå.",
                inPlan > 0 ? $"{inPlan} er allerede i testplanen." : null,
                other > 0 ? $"{other} kan ikke planlegges her (ikke et akseptansescenario eller en dokumentert test, eller ikke tilgjengelig i denne oppdagelsen)." : null,
            }.Where(x => x is not null));
        }
    }

    private async Task LoadPlanAsync()
    {
        var (plan, error) = await Api.DraftAsync(PlanId);
        if (plan is null) { _error = $"Testplanen kunne ikke hentes. {error}"; return; }
        _plan = plan;
        if (PreSelected is null || _suiteChosen) _suite ??= plan.Suites.FirstOrDefault()?.Id;
    }

    private static string? Blank(object? v) => v?.ToString() is { Length: > 0 } s ? s : null;
    private static string? Module(DiscoveredScenario c) => c.Story?.SpecificationPath is { Length: > 0 } spec ? PlanStructure.ModuleOf(spec) : c.Area;
    private static string? Priority(DiscoveredScenario c) => c.Story?.Priority?.Trim().ToUpperInvariant() is { Length: 2 } p && p[0] == 'P' && char.IsDigit(p[1]) ? p : null;
    private static string Identity(DiscoveredScenario c) => c.Story is { } st ? $"{st.StoryId}{(c.NumberInStory is { } n ? $" · AC {n}" : "")}" : "Uten brukerhistorie";

    /// <summary>Already planned — by a scenario-only item or by a case of the scenario (the same rule the server applies).</summary>
    private bool InPlan(DiscoveredScenario c) => _plan is { } p && (
        p.Cases.Any(x => x.Source.ScenarioId == c.CandidateId || c.SourceIdentity.Length > 0 && x.Generated.SourceIdentity == c.SourceIdentity)
        || (p.PlannedScenarios ?? []).Any(x => x.ScenarioId == c.CandidateId || c.SourceIdentity.Length > 0 && x.SourceIdentity == c.SourceIdentity));

    private List<DiscoveredScenario> Shown() => [.. _all.Where(c =>
        (_module is null || Module(c) == _module)
        && (_level is null || TestLevelClassifier.Of(c.Type).Level.ToString() == _level)
        && (_priority is null || (_priority == "none" ? Priority(c) is null : Priority(c) == _priority))
        && (_query.Length == 0 || $"{c.Title} {Identity(c)} {c.CanonicalKey}".Contains(_query.Trim(), StringComparison.CurrentCultureIgnoreCase)))];

    private void Toggle(string id, bool on) { if (on) _selected.Add(id); else _selected.Remove(id); _notice = null; }

    private RenderFragment Row(DiscoveredScenario cand, string testId) => __builder =>
    {
        var inPlan = InPlan(cand);
        <li class="asp-row @(inPlan ? "is-member" : null)" data-testid="@testId" data-id="@cand.CandidateId" data-in-plan="@(inPlan ? "true" : "false")">
            <label>
                <input type="checkbox" disabled="@inPlan" checked="@(_selected.Contains(cand.CandidateId))" @onchange="e => Toggle(cand.CandidateId, e.Value is true)" />
                <span class="asp-title">@cand.Title</span>
            </label>
            <span class="mt-muted msb-small">@Identity(cand) · @TestLevelClassifier.Label(TestLevelClassifier.Of(cand.Type).Level)@(Module(cand) is { } m ? $" · {m}" : "")</span>
            @if (inPlan) { <span class="msb-tag" data-testid="asp-in-plan">Allerede i testplanen</span> }
        </li>
    };

    // -- Scenarios beyond the loaded window (2026-11-27, P1) --
    /// <summary>The module/specification selection, when the discovery does not name its own (<see cref="ScenarioDiscoveryResult.SelectionScope"/> wins:
    /// the server search reads exactly the selection whose result the dialog shows).</summary>
    [Parameter] public string? DiscoveryScope { get; set; }
    private const int BeyondPage = 40;
    private ScenarioSearchPage? _beyond;
    private List<DiscoveredScenario> _beyondItems = [];
    private string? _beyondError;
    private int _beyondGeneration;

    /// <summary>A search beyond the window needs words (2 characters) or a filter: an empty dialog never lists the whole population.</summary>
    private bool SearchesBeyond => _query.Trim().Length >= 2 || _module is not null || _level is not null || _priority is not null;

    /// <summary>The dialog's own filters for the server (the same rules as <see cref="Shown"/>; only plannable scenarios).</summary>
    private ScenarioSearchFilter BeyondFilter() =>
        new(Priority: _priority is null ? null : _priority == "none" ? ScenarioSearchFilter.NoPriority : _priority, TestLevel: _level) { Module = _module, ClassifiableOnly = true };

    /// <summary>Searches the scenarios not loaded (the newest query wins; the first page waits for typing to settle). Selections are kept by
    /// candidate id, so a scenario chosen here stays chosen across new searches, filters and pages; the server resolves the ids against the complete
    /// stored discovery result. A row the dialog already shows is never repeated.</summary>
    private async Task SearchBeyondAsync(bool more)
    {
        var generation = more ? _beyondGeneration : ++_beyondGeneration;
        if (!more) { _beyond = null; _beyondItems = []; _beyondError = null; }
        if (_discovery is not { NotKept: > 0 } || !SearchesBeyond) { StateHasChanged(); return; }
        if (!more) { await Task.Delay(250); if (generation != _beyondGeneration) return; }
        var query = _query.Trim();
        var (page, error) = await Api.SearchDiscoveryAsync(ProjectKey, _discovery.SelectionScope ?? DiscoveryScope, query.Length >= 2 ? query : "", more ? _beyondItems.Count : 0, BeyondPage, BeyondFilter());
        if (generation != _beyondGeneration) return;
        if (page is null) { _beyondError = error ?? "Søket i hele utvalget feilet."; StateHasChanged(); return; }
        if (page.DiscoveryId.Length > 0 && page.DiscoveryId != _discovery.DiscoveryId)
        { _beyondError = "Scenarioene er hentet på nytt siden dialogen ble åpnet. Lukk og åpne den igjen."; StateHasChanged(); return; }
        _beyondError = null; _beyond = page;
        var known = _all.Select(c => c.CandidateId).ToHashSet(StringComparer.Ordinal);
        _beyondItems = [.. _beyondItems, .. page.Items.Where(c => !known.Contains(c.CandidateId) && _beyondItems.All(b => b.CandidateId != c.CandidateId))];
        StateHasChanged();
    }

    private async Task AddAsync()
    {
        if (_plan is null || _discovery is null || _selected.Count == 0 || _busy) return;
        _busy = true; _error = null; _notice = null;
        try
        {
            var ids = _selected.ToList();
            var (plan, error) = await Api.CreateProjectAsync(new CreateProjectTestPlanRequest
            {
                ProjectKey = ProjectKey, DiscoveryId = _discovery.DiscoveryId, CandidateIds = ids, DraftId = _plan.Id, BaseRevision = _plan.Revision,
                ScenarioOnly = true, SuiteId = _suite,
            });
            if (plan is null) { _error = $"Scenarioene ble ikke lagt til. {error}"; await LoadPlanAsync(); return; }
            var added = (plan.PlannedScenarios?.Count ?? 0) - (_plan.PlannedScenarios?.Count ?? 0);
            var suiteName = _suite is { } sid && plan.Suites.Any(s => s.Id == sid) ? PlanStructure.PathOf(plan.Suites, sid) : plan.Suites.LastOrDefault()?.Name;
            _plan = plan;
            _selected.Clear();
            _notice = added > 0 ? $"{added} scenario{(added == 1 ? "" : "er")} lagt til i «{suiteName}»." : "Ingen nye scenarioer — de valgte var allerede i testplanen.";
            await OnAdded.InvokeAsync(plan);
        }
        finally { _busy = false; }
    }

    // ── Closing (BUG-001) ──
    [Parameter] public string? ReturnFocusId { get; set; }
    [Inject] private Microsoft.JSInterop.IJSRuntime JS { get; set; } = default!;
    private ElementReference _dialog, _keepButton;
    private bool _confirmClose, _focused, _focusKeep;

    /// <summary>Unsaved work: chosen scenarios, or a search or filter the tester set (the chosen testgruppe alone is not work to lose).</summary>
    private bool Dirty => _selected.Count > 0 || _query.Length > 0 || _module is not null || _level is not null || _priority is not null;
    private string DirtyText() => _selected.Count > 0 ? $"{_selected.Count} valgt{(_selected.Count == 1 ? "" : "e")} scenario{(_selected.Count == 1 ? "" : "er")} er ikke lagt til." : "Søket og filtrene dine forsvinner.";

    private async Task CloseAsync()
    {
        // V12 fix (2026-11-27): the question is shown and its «Behold» button focused after the render (OnAfterRenderAsync), not after a
        // Task.Yield inside this handler — the yield left the handler running, so a second Escape could interleave with the first (flaky test).
        if (Dirty && !_confirmClose) { _confirmClose = true; _focusKeep = true; return; }
        await DiscardAsync();
    }

    private async Task DiscardAsync()
    {
        _confirmClose = false;
        await OnClose.InvokeAsync();
        if (ReturnFocusId is { } id) try { await JS.InvokeVoidAsync("birknextFocusElement", id); } catch (Exception e) when (e is Microsoft.JSInterop.JSException or InvalidOperationException or TaskCanceledException) { }
    }

    /// <summary>A click beside the dialog never closes it; focus goes back into the dialog, so Escape and the keyboard keep working (found in the
    /// browser: after a click on the backdrop, Escape no longer reached the dialog).</summary>
    private async Task KeepFocusAsync() { try { await _dialog.FocusAsync(); } catch (Exception e) when (e is InvalidOperationException or Microsoft.JSInterop.JSException) { } }

    private async Task KeepOpenAsync() { _confirmClose = false; try { await _dialog.FocusAsync(); } catch (Exception e) when (e is InvalidOperationException or Microsoft.JSInterop.JSException) { } }

    /// <summary>Escape: closes when nothing is chosen; with unsaved work it asks first; Escape on the question keeps the dialog open.</summary>
    private Task KeyAsync(KeyboardEventArgs e) => e.Key != "Escape" ? Task.CompletedTask : _confirmClose ? KeepOpenAsync() : CloseAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusKeep && _confirmClose)
        {
            _focusKeep = false;
            try { await _keepButton.FocusAsync(); } catch (Exception e) when (e is InvalidOperationException or Microsoft.JSInterop.JSException) { }
            return;
        }
        _focusKeep = false;
        if (_focused) return;
        _focused = true;
        try { await _dialog.FocusAsync(); } catch (Exception e) when (e is InvalidOperationException or Microsoft.JSInterop.JSException) { }
    }
}
