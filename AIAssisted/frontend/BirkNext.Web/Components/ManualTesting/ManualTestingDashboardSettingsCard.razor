@using BirkNext.TestPlanning
@using BirkNext.Web.Services
@inject IServiceProvider Services

@* System Settings → Manual Testing → Testoversikt (2026-11-25), in Git Sources' design. Which parts of the Testoversikt dashboard are shown, per
   switch; the names are the ones testers see on the dashboard (Norwegian), the section chrome is English like every System Settings section.
   Installation-wide; saved on «Save changes» (server-side permission check; unknown parts refused). Restoring the defaults resets only this setup —
   never plans, cases or source data — and no change here writes a test plan revision. *@
<section class="gsx mtds" aria-labelledby="mtds-title" data-testid="mtds">
    <header class="gsx-header">
        <div>
            <h2 id="mtds-title" class="gsx-title">Manual Testing — Testoversikt default layout (Standardoppsett for Testoversikt)</h2>
            <p class="gsx-subtitle">Choose which key figures, charts and follow-up panels the Testoversikt dashboard shows. Execution results are never part of it.</p>
        </div>
    </header>
    @if (_saved is null)
    {
        <p class="gsx-muted" role="status" data-testid="mtds-loading">@(_loadError ?? "Reading the settings…")</p>
        @if (_loadError is not null) { <button type="button" class="btn-secondary btn-sm" @onclick="LoadAsync" data-testid="mtds-retry">Retry</button> }
    }
    else
    {
        @foreach (var group in ManualTestingDashboard.Widgets.GroupBy(w => w.Group))
        {
            <div class="gsx-panel" data-testid="mtds-group" data-group="@group.Key">
                <div class="gsx-panel-head"><h3 class="gsx-panel-title">@group.Key</h3></div>
                <ul class="mtds-list">
                    @foreach (var w in group)
                    {
                        var widget = w;
                        <li>
                            <label class="mtds-switch">
                                <input type="checkbox" role="switch" checked="@IsOn(widget.Id)" disabled="@_busy" @onchange="e => _edits[widget.Id] = e.Value is true" data-testid="mtds-toggle" data-widget="@widget.Id" />
                                <span><strong>@widget.Title</strong><span class="gsx-muted mtds-desc">@widget.Description</span></span>
                            </label>
                        </li>
                    }
                </ul>
            </div>
        }
        <p class="gsx-muted" data-testid="mtds-layout-note">This is the installation's dashboard layout. Testers change the same layout on Testoversikt with «Tilpass oversikten»
            (show/hide, order, own key figures); there is no separate per-user layout in this installation. Key figure definitions cannot be changed here or there.</p>
        <div class="gsx-panel" data-testid="mtds-plan-structure">
            <div class="gsx-panel-head"><h3 class="gsx-panel-title">Test plan structure (Testplanstruktur)</h3></div>
            <p class="gsx-muted mtds-desc">The suite structure proposed when a new test plan is created from selected scenarios. Testers can choose another when they create a plan. Existing plans keep their saved structure.</p>
            <ul class="mtds-list">
                @foreach (var (key, label, description) in PlanStructureTemplates.All)
                {
                    var k = key;
                    <li><label class="mtds-switch">
                        <input type="radio" name="mtds-plan-structure" checked="@(EffectiveStructure == k)" disabled="@_busy" @onchange="() => _structureEdit = k" data-testid="mtds-plan-structure-option" data-structure="@k" />
                        <span><strong>@label</strong><span class="gsx-muted mtds-desc">@description</span></span></label></li>
                }
            </ul>
        </div>
        @* Custom KPI tiles (2026-11-26): the same tiles testers edit from the tile menu on Testoversikt; each change is saved at once. *@
        <div class="gsx-panel" data-testid="mtds-tiles">
            <div class="gsx-panel-head"><h3 class="gsx-panel-title">KPI tiles (Fliser)</h3></div>
            <p class="gsx-muted mtds-desc">Custom key figures on Testoversikt. Each tile counts unique acceptance scenarios and standalone documented tests on one dimension
                (test level or scenario type) in the dashboard's selected scope. The name is only a label. Removing a tile removes only its configuration.</p>
            <ul class="mtds-list">
                @foreach (var (tile, i) in Tiles.Select((t, i) => (t, i)))
                {
                    var t = tile; var index = i;
                    <li class="mtds-tile" data-testid="mtds-tile" data-tile="@t.Id">
                        <label class="mtds-switch"><input type="checkbox" role="switch" checked="@t.Visible" disabled="@_busy" @onchange="e => SetVisibleAsync(t, e)" data-testid="mtds-tile-visible" />
                            <span><strong class="mtds-tile-name">@DashboardKpiTiles.DisplayTitle(t)</strong><span class="gsx-muted mtds-desc">@TileMeta(t)</span></span></label>
                        <span class="mtds-tile-tools">
                            <button type="button" class="btn-secondary btn-sm" disabled="@(_busy || index == 0)" @onclick="() => MoveTileAsync(index, -1)" aria-label="Move up" data-testid="mtds-tile-up">↑</button>
                            <button type="button" class="btn-secondary btn-sm" disabled="@(_busy || index == Tiles.Count - 1)" @onclick="() => MoveTileAsync(index, 1)" aria-label="Move down" data-testid="mtds-tile-down">↓</button>
                            <button type="button" class="btn-secondary btn-sm" disabled="@_busy" @onclick="() => OpenTile(t)" data-testid="mtds-tile-edit">Edit</button>
                            <button type="button" class="btn-secondary btn-sm" disabled="@_busy" @onclick="() => RemoveTileAsync(t)" data-testid="mtds-tile-remove">Remove</button>
                        </span>
                    </li>
                }
            </ul>
            @if (Tiles.Count == 0) { <p class="gsx-muted" data-testid="mtds-tiles-none">No tiles. Add one, or restore the default tile.</p> }
            <div class="mtds-actions">
                <button type="button" class="btn-secondary btn-sm" disabled="@(_busy || Tiles.Count >= DashboardKpiTiles.MaxTiles)" @onclick="() => OpenTile(null)" data-testid="mtds-tile-add">Add tile</button>
                <button type="button" class="btn-secondary btn-sm" disabled="@_busy" @onclick="ResetTilesAsync" data-testid="mtds-tiles-reset">Restore default tiles</button>
            </div>
            @if (_tileEditing)
            {
                <KpiTileEditor Tile="_tileEdit" English="true" Busy="_busy" OnSave="SaveTileAsync" OnCancel="CloseTile" />
            }
        </div>
        @if (_error is { } err) { <p class="gsx-error" role="alert" data-testid="mtds-error">The setup could not be saved. @err <button type="button" class="btn-secondary btn-sm" @onclick="SaveAsync">Retry</button></p> }
        @if (_notice is { } n) { <p class="gsx-muted" role="status" data-testid="mtds-notice">@n</p> }
        <div class="mtds-actions">
            <button type="button" class="btn-primary btn-sm" disabled="@(_busy || !Dirty)" @onclick="SaveAsync" data-testid="mtds-save">Save changes</button>
            @if (_confirmReset)
            {
                <span class="gsx-muted">Restore the default dashboard? Only this setup changes.</span>
                <button type="button" class="btn-secondary btn-sm" disabled="@_busy" @onclick="ResetAsync" data-testid="mtds-reset-yes">Restore defaults</button>
                <button type="button" class="btn-secondary btn-sm" @onclick="() => _confirmReset = false" data-testid="mtds-reset-no">Cancel</button>
            }
            else { <button type="button" class="btn-secondary btn-sm" disabled="@_busy" @onclick="() => _confirmReset = true" data-testid="mtds-reset">Restore defaults…</button> }
        </div>
    }
</section>

@code {
    private ManualTestingDashboardSettings? _saved;

    // ── KPI tiles (saved immediately; the switches above keep their own «Save changes») ──
    private bool _tileEditing;
    private DashboardKpiTile? _tileEdit;
    private IReadOnlyList<DashboardKpiTile> Tiles => _saved?.EffectiveTiles ?? DashboardKpiTiles.Defaults;

    private static string TileMeta(DashboardKpiTile t) =>
        $"{DashboardKpiTiles.DimensionLabel(t.Dimension)} / {DashboardKpiTiles.MetricLabel(t.Dimension, t.Metric)}" + (t.Visible ? "" : " · hidden");

    private void OpenTile(DashboardKpiTile? t) { _tileEdit = t; _tileEditing = true; }
    private void CloseTile() => _tileEditing = false;

    private Task SetVisibleAsync(DashboardKpiTile t, ChangeEventArgs e) => SaveTileAsync(t with { Visible = e.Value is true });

    private Task SaveTileAsync(DashboardKpiTile t)
    {
        var list = Tiles.ToList();
        var i = list.FindIndex(x => x.Id == t.Id);
        if (i >= 0) list[i] = t; else list.Add(t);
        return SaveTilesAsync(list, null);
    }

    private Task MoveTileAsync(int index, int delta)
    {
        var list = Tiles.ToList();
        var to = index + delta;
        if (to < 0 || to >= list.Count) return Task.CompletedTask;
        (list[index], list[to]) = (list[to], list[index]);
        return SaveTilesAsync(list, null);
    }

    private Task RemoveTileAsync(DashboardKpiTile t) =>
        SaveTilesAsync([.. Tiles.Where(x => x.Id != t.Id)], "Tile «" + DashboardKpiTiles.DisplayTitle(t) + "» removed (only its configuration).");

    private async Task SaveTilesAsync(List<DashboardKpiTile> tiles, string? notice)
    {
        if (Api is not { } api) return;
        _busy = true; _error = null; _notice = null;
        try
        {
            var (settings, error) = await api.SaveDashboardSettingsAsync(new SaveManualTestingDashboardSettingsRequest(null) { Tiles = [.. tiles.Select((x, i) => x with { Order = i })] });
            if (settings is null) { _error = error; return; }
            _saved = settings; _tileEditing = false; _notice = notice ?? "Tiles saved.";
        }
        finally { _busy = false; }
    }

    private async Task ResetTilesAsync()
    {
        if (Api is not { } api) return;
        _busy = true; _error = null; _notice = null;
        try
        {
            var (settings, error) = await api.SaveDashboardSettingsAsync(new SaveManualTestingDashboardSettingsRequest(null) { ResetTiles = true });
            if (settings is null) { _error = error; return; }
            _saved = settings; _notice = "The default tile «Ende-til-ende-tester» is restored. Other dashboard settings are unchanged.";
        }
        finally { _busy = false; }
    }
    private readonly Dictionary<string, bool> _edits = new(StringComparer.Ordinal);
    private bool _busy, _confirmReset;
    private string? _loadError, _error, _notice;
    private ITestPlanSuggestionsApiService? Api => Services.GetService(typeof(ITestPlanSuggestionsApiService)) as ITestPlanSuggestionsApiService;

    private bool IsOn(string id) => _edits.TryGetValue(id, out var on) ? on : _saved!.IsOn(id);
    private bool Dirty => _saved is not null && (_edits.Any(e => e.Value != _saved.IsOn(e.Key)) || _structureEdit is not null && _structureEdit != _saved.EffectivePlanStructure);
    private string? _structureEdit;
    private string EffectiveStructure => _structureEdit ?? _saved?.EffectivePlanStructure ?? PlanStructureTemplates.Default;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (Api is not { } api) { _loadError = "The settings service is not available."; return; }
        var (settings, error) = await api.DashboardSettingsAsync();
        _saved = settings;
        _loadError = settings is null ? error ?? "The settings could not be read." : null;
    }

    private async Task SaveAsync()
    {
        if (Api is not { } api || !Dirty) return;
        _busy = true; _error = null; _notice = null;
        try
        {
            var changed = _edits.Where(e => e.Value != _saved!.IsOn(e.Key)).ToDictionary(e => e.Key, e => e.Value, StringComparer.Ordinal);
            var structure = _structureEdit is not null && _structureEdit != _saved!.EffectivePlanStructure ? _structureEdit : null;
            var (settings, error) = await api.SaveDashboardSettingsAsync(new SaveManualTestingDashboardSettingsRequest(changed, PlanStructure: structure));
            if (settings is null) { _error = error; return; }
            _saved = settings; _edits.Clear(); _structureEdit = null; _notice = "Saved. The dashboard uses the new setup the next time it is opened.";
        }
        finally { _busy = false; }
    }

    private async Task ResetAsync()
    {
        if (Api is not { } api) return;
        _busy = true; _error = null; _notice = null;
        try
        {
            var (settings, error) = await api.SaveDashboardSettingsAsync(new SaveManualTestingDashboardSettingsRequest(null, ResetToDefaults: true));
            if (settings is null) { _error = error; return; }
            _saved = settings; _edits.Clear(); _structureEdit = null; _confirmReset = false; _notice = "The default dashboard is restored.";
        }
        finally { _busy = false; }
    }
}
