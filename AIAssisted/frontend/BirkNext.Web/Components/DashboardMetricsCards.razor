@using BirkNext.Web.Services

<section class="qa-command-center" aria-label="QA dashboard" data-testid="coverage-dashboard">
    <div class="health-hero health-hero-@HeroState">
        <div class="health-hero-left">
            <p class="section-kicker">QA Command Center</p>
            <h2 class="health-hero-heading">QA Health Score</h2>
            <p class="health-hero-desc">
                @(IsEmpty
                    ? "Run a specification review to generate QA health, coverage, risk, and traceability metrics."
                    : "Based on review progress, requirement coverage, and traceability.")
            </p>
        </div>

        <div class="health-hero-right" data-testid="dashboard-empty-state">
            <div class="health-score-panel">
                <span class="health-score-number">@(IsEmpty ? "--" : Metrics.QaHealthScore)</span>
                <div class="health-status-row">
                    <span class="health-status-label">QA Status</span>
                    <span class="health-score-badge health-score-badge-@HealthState">@(IsEmpty ? "No Data" : HealthStateLabel)</span>
                </div>
            </div>
            @if (IsEmpty)
            {
                <a class="hero-cta" href="extract">Analyze Specification</a>
            }
        </div>
    </div>

    <div class="kpi-row" aria-label="Key metrics">
        <div class="kpi-card kpi-card-coverage @KpiEmptyMod" data-testid="dashboard-health-card">
            <span class="kpi-marker" aria-hidden="true"></span>
            <span class="@KpiValClass">@KpiCoverageVal</span>
            <span class="kpi-label">Coverage</span>
            <span class="kpi-hint">@KpiCoverageHint</span>
        </div>
        <div class="kpi-card kpi-card-progress @KpiEmptyMod" data-testid="dashboard-health-card">
            <span class="kpi-marker" aria-hidden="true"></span>
            <span class="@KpiValClass">@KpiReviewVal</span>
            <span class="kpi-label">Review Progress</span>
            <span class="kpi-hint">@KpiReviewHint</span>
        </div>
        <div class="kpi-card kpi-card-risks @KpiRisksCardMod" data-testid="dashboard-health-card">
            <span class="kpi-marker" aria-hidden="true"></span>
            <span class="@KpiValClass">@KpiRisksVal</span>
            <span class="kpi-label">Open Risks</span>
            <span class="kpi-hint">@KpiRisksHint</span>
        </div>
        <div class="kpi-card kpi-card-traceability @KpiEmptyMod" data-testid="dashboard-health-card">
            <span class="kpi-marker" aria-hidden="true"></span>
            <span class="@KpiValClass">@KpiTraceVal</span>
            <span class="kpi-label">Traceability</span>
            <span class="kpi-hint">items linked to requirements</span>
        </div>
    </div>

    <div class="command-grid">
        <div class="primary-panel-stack">
            <section class="command-panel risk-panel-compact" aria-label="Top QA risks" data-testid="top-qa-risks">
                <h3 class="panel-title">Top QA Risks</h3>
                @if (IsEmpty)
                {
                    <div class="risk-no-data">
                        <span class="risk-dot risk-dot-clear" aria-hidden="true"></span>
                        No data yet - run a specification review to identify QA risks.
                    </div>
                }
                else if (RiskItems.Count == 0)
                {
                    <div class="risk-clear">
                        <span class="risk-dot risk-dot-clear" aria-hidden="true"></span>
                        No active QA risks - coverage, traceability, and review queues are clear.
                    </div>
                }
                else
                {
                    <ul class="risk-list-compact">
                        @foreach (var risk in RiskItems)
                        {
                            <li class="risk-row risk-row-@risk.State">
                                <span class="risk-dot risk-dot-@risk.State" aria-hidden="true"></span>
                                <span>@risk.Label</span>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="command-panel" aria-label="Quality overview">
                <h3 class="panel-title">Quality Overview</h3>
                <div class="quality-grid">
                    <div class="stat-tile stat-tile-requirements">
                        <span class="stat-num">@Metrics.RequirementCount</span>
                        <span class="stat-lbl">Requirements</span>
                    </div>
                    <div class="stat-tile stat-tile-tests">
                        <span class="stat-num">@Metrics.TestCount</span>
                        <span class="stat-lbl">Tests</span>
                    </div>
                    <div class="stat-tile stat-tile-clarifications">
                        <span class="stat-num">@Metrics.ClarificationCount</span>
                        <span class="stat-lbl">Clarifications</span>
                    </div>
                    <div class="stat-tile stat-tile-saved">
                        <span class="stat-num">@Metrics.TotalCandidates</span>
                        <span class="stat-lbl">Saved Items</span>
                    </div>
                    <div class="stat-tile stat-tile-accepted">
                        <span class="stat-num">@Metrics.AcceptedCount</span>
                        <span class="stat-lbl">Accepted</span>
                    </div>
                    <div class="stat-tile stat-tile-rejected">
                        <span class="stat-num">@Metrics.RejectedCount</span>
                        <span class="stat-lbl">Rejected</span>
                    </div>
                </div>
            </section>
        </div>

        <section class="command-panel next-actions-panel" aria-label="Next actions">
            <h3 class="panel-title">Next Actions</h3>
            <ul class="next-actions-list">
                @foreach (var action in NextActions)
                {
                    <li class="next-action-row">
                        <span class="next-action-dot" aria-hidden="true"></span>
                        <span>@action</span>
                    </li>
                }
            </ul>
        </section>
    </div>

    <section class="command-panel coverage-breakdown-panel" aria-label="Test Coverage Breakdown">
        <h3 class="panel-title">Test Coverage Breakdown</h3>
        <div class="coverage-bars">
            @foreach (var bar in CoverageBars)
            {
                <div class="bar-row">
                    <span class="bar-label">
                        <span>@bar.Label</span>
                        <strong>@(IsEmpty ? "--" : bar.Count)</strong>
                    </span>
                    <div class="bar-track" role="progressbar"
                         aria-label="@bar.Label"
                         aria-valuemin="0" aria-valuemax="100" aria-valuenow="@bar.WidthPct">
                        <div class="bar-fill bar-fill-@bar.Color" style="width: @bar.WidthPct%"></div>
                    </div>
                    <span class="bar-count">@(IsEmpty ? "--" : bar.Count.ToString())</span>
                </div>
            }
        </div>
        @if (Metrics.TestCount == 0)
        {
            <p class="coverage-empty-hint">
                @(IsEmpty
                    ? "No tests saved yet - run a specification review to classify tests by type"
                    : "No tests saved yet. Tests are classified by title keywords.")
            </p>
        }
    </section>
</section>

@code {
    [Parameter, EditorRequired] public DashboardMetrics Metrics { get; set; } = default!;

    private bool IsEmpty => Metrics.TotalCandidates == 0;

    private string HealthState => IsEmpty ? "empty"
        : Metrics.QaHealthScore >= 80 ? "healthy"
        : Metrics.QaHealthScore >= 60 ? "attention"
        : "risk";

    private string HealthStateLabel => Metrics.QaHealthScore >= 80 ? "Healthy"
        : Metrics.QaHealthScore >= 60 ? "Attention"
        : "At Risk";

    private string HeroState => IsEmpty ? "empty" : HealthState;

    private string KpiEmptyMod => IsEmpty ? "kpi-card-empty" : "";
    private string KpiValClass => IsEmpty ? "kpi-value kpi-value-empty" : "kpi-value";

    private string KpiCoverageVal => IsEmpty ? "--" : $"{Metrics.RequirementsCoveredPercent}%";
    private string KpiReviewVal => IsEmpty ? "--" : $"{Metrics.ReviewedPercent}%";
    private string KpiRisksVal => IsEmpty ? "--" : Metrics.OpenRisksCount.ToString();
    private string KpiTraceVal => IsEmpty ? "--" : $"{Metrics.TraceabilityPercent}%";

    private string KpiCoverageHint => IsEmpty
        ? "requirements with tests"
        : $"{Metrics.RequirementsWithTests} of {Metrics.RequirementCount} requirements";

    private string KpiReviewHint => IsEmpty
        ? "candidates reviewed"
        : $"{Metrics.ReviewedCount} of {Metrics.TotalCandidates} candidates";

    private string KpiRisksHint => IsEmpty
        ? "active QA risks"
        : Metrics.OpenRisksCount == 0 ? "no active risks" : "active QA risks";

    private string KpiRisksCardMod => IsEmpty
        ? "kpi-card-empty"
        : Metrics.OpenRisksCount == 0 ? "kpi-risk-none" : "kpi-risk-active";

    private IReadOnlyList<string> NextActions
    {
        get
        {
            if (IsEmpty)
            {
                return
                [
                    "Run your first specification review",
                    "Save accepted requirements",
                    "Link tests to requirements",
                    "Resolve clarification items",
                ];
            }

            var actions = new List<string>();

            if (Metrics.RequirementsWithoutTests > 0)
                actions.Add("Link tests to uncovered requirements");

            if (Metrics.UnresolvedClarifications > 0)
                actions.Add("Resolve clarification items");

            if (Metrics.UnreviewedCount > 0)
                actions.Add("Review pending extracted candidates");

            return actions.Count == 0
                ? ["QA review is currently clear"]
                : actions;
        }
    }

    private IReadOnlyList<RiskItem> RiskItems
    {
        get
        {
            var risks = new List<RiskItem>();

            if (Metrics.RequirementsWithoutTests > 0)
                risks.Add(new(
                    $"{Metrics.RequirementsWithoutTests} requirement{(Metrics.RequirementsWithoutTests == 1 ? "" : "s")} missing tests",
                    "high"));

            if (Metrics.RequirementCount > 0 && Metrics.RequirementsCoveredPercent < 70 && Metrics.RequirementsWithTests > 0)
                risks.Add(new(
                    $"Test coverage below 70% - {Metrics.RequirementsWithoutTests} requirement{(Metrics.RequirementsWithoutTests == 1 ? "" : "s")} still need{(Metrics.RequirementsWithoutTests == 1 ? "s" : "")} tests",
                    "medium"));

            if (Metrics.UnresolvedClarifications > 0)
                risks.Add(new(
                    $"{Metrics.UnresolvedClarifications} unresolved clarification{(Metrics.UnresolvedClarifications == 1 ? "" : "s")}",
                    "medium"));

            if (Metrics.UnreviewedCount > 0 && Metrics.ReviewedPercent < 80)
                risks.Add(new(
                    $"{Metrics.UnreviewedCount} candidate{(Metrics.UnreviewedCount == 1 ? "" : "s")} still require{(Metrics.UnreviewedCount == 1 ? "s" : "")} review",
                    "medium"));

            return risks;
        }
    }

    private IReadOnlyList<CoverageBar> CoverageBars
    {
        get
        {
            var max = Math.Max(1, new[] {
                Metrics.FunctionalTests, Metrics.NegativeTests, Metrics.EdgeCaseTests,
                Metrics.PerformanceTests, Metrics.SecurityTests, Metrics.OtherTests
            }.Max());

            int W(int n) => (int)Math.Round(n * 100.0 / max);

            return
            [
                new("Functional", Metrics.FunctionalTests, "functional", W(Metrics.FunctionalTests)),
                new("Negative", Metrics.NegativeTests, "negative", W(Metrics.NegativeTests)),
                new("Edge Cases", Metrics.EdgeCaseTests, "edge", W(Metrics.EdgeCaseTests)),
                new("Performance", Metrics.PerformanceTests, "performance", W(Metrics.PerformanceTests)),
                new("Security", Metrics.SecurityTests, "security", W(Metrics.SecurityTests)),
                new("Other", Metrics.OtherTests, "other", W(Metrics.OtherTests)),
            ];
        }
    }

    private sealed record RiskItem(string Label, string State);
    private sealed record CoverageBar(string Label, int Count, string Color, int WidthPct);
}
