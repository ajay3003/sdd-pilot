@using BirkNext.LocalHttpsProxy
@using BirkNext.Web.Models
@using BirkNext.Web.Services

<section class="fqr-section fqr-decision" aria-label="Release disposition">
    <SectionHeader Title="Release disposition" />
    <div class="wsr-banner @DispositionClass" role="status">
        <strong>@DispositionLabel</strong> — @DispositionText
    </div>
    <p><strong>Critical/high logical issues:</strong> @CriticalHighCount &nbsp; <strong>Logical issues:</strong> @Report.LogicalIssues.Count &nbsp; <strong>Source findings:</strong> @Report.Findings.Count</p>
</section>

<section class="fqr-section" aria-label="Automated coverage and engine outcomes">
    <SectionHeader Title="Automated coverage" />
    <p><strong data-testid="fqr-coverage-label">@CoverageLabel</strong></p>
    <p>
        <strong>Required assessed:</strong> <span data-testid="fqr-required-assessed">@RequiredAssessed / @RequiredTotal</span> &nbsp;
        <strong>Optional assessed:</strong> <span data-testid="fqr-optional-assessed">@(OptionalTotal == 0 ? "0 / 0 (no optional engine enabled)" : $"{OptionalAssessed} / {OptionalTotal}")</span>
        @if (InactiveCount > 0) { <span class="fqr-muted" data-testid="fqr-inactive-count"> &nbsp; @InactiveCount @(InactiveCount == 1 ? "engine" : "engines") not active (disabled or not selected) — excluded from coverage</span> }
    </p>
    <p class="fqr-engine-filter">
        <label><input type="checkbox" checked="@_showInactive" @onchange="@((ChangeEventArgs e) => _showInactive = (bool)e.Value!)" data-testid="fqr-show-inactive" /> Show disabled / not selected engines</label>
    </p>
    @if (RequiredTotal > 0 && RequiredAssessed < RequiredTotal)
    {
        <div class="fqr-coverage-summary" data-testid="fqr-coverage-summary">
            <p>@RequiredAssessed of @RequiredTotal required engines completed.</p>
            <ul>
                @foreach (var outcome in RequiredNotAssessed)
                {
                    <li data-engine-id="@outcome.EngineId"><strong>@outcome.DisplayName:</strong> @FrontendQualityEngineOutcomePresentation.StateLabel(outcome) — @(outcome.SanitizedFailureReason ?? FrontendQualityEngineOutcomePresentation.GetLabel(outcome.OutcomeReason))</li>
                }
            </ul>
        </div>
    }
    <div class="fqr-table-wrap">
        <table class="fqr-findings-table fqr-engine-matrix">
            <thead><tr><th>Engine</th><th>Policy</th><th>Enabled</th><th>Assessment</th><th>Access</th><th>Outcome</th><th>Evidence / findings</th><th>Duration</th><th>Tool / browser</th><th>Reason / required action</th></tr></thead>
            <tbody>
                @foreach (var outcome in Report.EngineOutcomes.Where(item => _showInactive || !FrontendQualityCoverage.IsInactive(item)).OrderBy(item => item.EngineId))
                {
                    <tr data-engine-id="@outcome.EngineId" data-engine-state="@FrontendQualityEngineOutcomePresentation.StateClass(outcome)" data-engine-active="@((!FrontendQualityCoverage.IsInactive(outcome)).ToString().ToLowerInvariant())">
                        <td><strong>@outcome.DisplayName</strong></td>
                        <td>@outcome.Requirement</td>
                        <td data-testid="fqr-enabled">@(outcome.Enabled ? "Yes" : "No")</td>
                        <td data-testid="fqr-assessment">@FrontendQualityEngineOutcomePresentation.AssessmentLabel(outcome)</td>
                        <td data-testid="fqr-access">@(outcome.AccessLabel ?? (outcome.AccessKind.HasValue ? FrontendQualityEngineOutcomePresentation.AccessKindLabel(outcome.AccessKind.Value) : "—"))</td>
                        <td>
                            <span class="fqr-state fqr-state-@FrontendQualityEngineOutcomePresentation.StateClass(outcome)" data-testid="fqr-state">@FrontendQualityEngineOutcomePresentation.StateLabel(outcome)</span>
                            @if (outcome.ExecutionState != FrontendQualityEngineExecutionState.Assessed && outcome.OutcomeReason != FrontendQualityEngineOutcomeReason.None)
                            {
                                <span class="fqr-outcome-reason fqr-reason-@(FrontendQualityEngineOutcomePresentation.GetCategory(outcome.OutcomeReason).ToString().ToLowerInvariant())" data-testid="fqr-outcome-reason">@FrontendQualityEngineOutcomePresentation.GetLabel(outcome.OutcomeReason)</span>
                            }
                        </td>
                        <td>@(outcome.EvidenceCount?.ToString() ?? "—") / @(outcome.FindingCount?.ToString() ?? "—")</td>
                        <td>@(outcome.DurationMs.HasValue ? $"{outcome.DurationMs.Value} ms" : "—")</td>
                        <td>@ToolLabel(outcome)</td>
                        <td data-testid="fqr-reason">
                            @if (!string.IsNullOrWhiteSpace(outcome.SanitizedFailureReason)) { <span>@outcome.SanitizedFailureReason</span> }
                            @if (!string.IsNullOrWhiteSpace(outcome.RequiredAction))
                            {
                                <span class="fqr-required-action">
                                    @if (!string.IsNullOrWhiteSpace(outcome.ActionHref)) { <a href="@outcome.ActionHref">@outcome.RequiredAction</a> } else { <span>@outcome.RequiredAction</span> }
                                </span>
                            }
                            @if (outcome.ManualTestingObligations.Count > 0) { <span>@string.Join(" ", outcome.ManualTestingObligations)</span> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@if (Report.AuthenticatedApiSurface is { } surface)
{
    <section class="fqr-section" aria-label="Authenticated API surface" data-testid="fqr-auth-api-surface">
        <SectionHeader Title="Authenticated API surface (Local HTTPS Proxy)" />
        @if (surface.ContextAvailable && surface.Checks.Count > 0)
        {
            <p>Approved read-only requests executed by the backend gateway with the memory-only proxy credential. Response bodies, headers other than the security allow-list, and the credential itself are never captured.</p>
            <div class="fqr-table-wrap">
                <table class="fqr-findings-table">
                    <thead><tr><th>Check</th><th>Endpoint</th><th>Mode</th><th>Status</th><th>Latency</th><th>Outcome</th><th>Security headers</th></tr></thead>
                    <tbody>
                        @foreach (var check in surface.Checks)
                        {
                            <tr data-testid="fqr-auth-api-check" data-check="@check.Label">
                                <td><strong>@check.Label</strong></td>
                                <td>@check.Url</td>
                                <td>@ModeLabel(check.Mode)</td>
                                <td>@(check.StatusCode.HasValue ? $"HTTP {check.StatusCode}" : check.Status.ToString())</td>
                                <td>@(check.ElapsedMs.HasValue ? $"{check.ElapsedMs:0} ms" : "—")</td>
                                <td>@check.Outcome</td>
                                <td>@(check.SecurityHeaders.Count == 0 ? "—" : string.Join(" · ", check.SecurityHeaders.Select(h => $"{h.Key}: {h.Value}")))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="fqr-empty-panel" data-testid="fqr-auth-api-not-executed"><strong>Not checked.</strong> @surface.NotExecutedReason</div>
        }
    </section>
}

<section class="fqr-section" aria-label="Logical issues">
    <SectionHeader Title="Logical issues" />
    @if (Report.LogicalIssues.Count == 0)
    {
        <div class="fqr-empty-panel">No automated findings were produced. This does not remove manual review obligations or assessment limitations.</div>
    }
    else
    {
        <div class="fqr-risk-grid">
            @foreach (var issue in Report.LogicalIssues)
            {
                <article class="fqr-risk-card fqr-risk-@issue.PrimarySeverity.ToString().ToLowerInvariant()" data-logical-id="@issue.LogicalId">
                    <div class="fqr-risk-meta"><span class="fqr-severity fqr-severity-@issue.PrimarySeverity.ToString().ToLowerInvariant()">@issue.PrimarySeverity</span><span>@issue.Category</span></div>
                    <h3>@issue.CanonicalTitle</h3>
                    <p><strong>Observed by:</strong> @string.Join(", ", issue.Sources.Select(FrontendQualityDecisionSupportService.SourceLabel))</p>
                    <p><strong>Evidence:</strong> @EvidenceLabel(issue.EvidenceStrength) @if (issue.Confidence.HasValue) { <span> · <strong>Confidence:</strong> @issue.Confidence</span> }</p>
                    <p><strong>Disposition:</strong> @DispositionLabelFor(issue.ReviewDisposition)</p>
                    <p><strong>Next step:</strong> @issue.Recommendation</p>
                    @if (issue.ManualVerificationRequired) { <p><strong>Manual verification required.</strong></p> }
                    <details>
                        <summary>Source evidence (@issue.FindingInstances.Count)</summary>
                        @foreach (var instance in issue.FindingInstances)
                        {
                            <div class="fqr-evidence-group" data-source-finding-id="@instance.SourceFindingId">
                                <p><strong>@FrontendQualityDecisionSupportService.SourceLabel(instance.EngineId):</strong> @instance.Title (@instance.Severity)</p>
                                <p><strong>Source ID:</strong> @instance.SourceFindingId @if (!string.IsNullOrWhiteSpace(instance.SourceRuleId)) { <span> · <strong>Rule:</strong> @instance.SourceRuleId</span> }</p>
                                @if (instance.SanitizedEvidence.Count > 0) { <ul>@foreach (var evidence in instance.SanitizedEvidence) { <li><code>@evidence</code></li> }</ul> }
                                <p><strong>Source recommendation:</strong> @instance.Recommendation</p>
                            </div>
                        }
                    </details>
                </article>
            }
        </div>
    }
</section>

<section class="fqr-section" aria-label="Manual verification required">
    <SectionHeader Title="Manual verification required" />
    @if (Report.ManualReviewItems.Count == 0)
    {
        <div class="fqr-empty-panel">No explicit manual-verification item was generated by the configured automated review. Existing assessment limitations still apply.</div>
    }
    else
    {
        @foreach (var item in Report.ManualReviewItems)
        {
            <article class="fqr-recommendation-card">
                <h3>@item.Title</h3><p>@item.Reason</p><p><strong>Source:</strong> @item.Source</p>
                @if (!string.IsNullOrWhiteSpace(item.RelatedLogicalId)) { <p><strong>Related issue:</strong> @item.RelatedLogicalId</p> }
            </article>
        }
    }
</section>

<section class="fqr-summary-grid" aria-label="Source-specific scores">
    <MetricCard Value="@(Report.OverallScore?.ToString() ?? "—")" Label="Legacy static review score" Sublabel="Static/passive legacy scope; not all enabled engines" Variant="neutral" />
    <MetricCard Value="@(Report.SecurityScore?.ToString() ?? "—")" Label="Static security score" Sublabel="Static Security source" Variant="neutral" />
    <MetricCard Value="@(Report.PerformanceScore?.ToString() ?? "—")" Label="Passive performance score" Sublabel="Passive Performance source" Variant="neutral" />
    <MetricCard Value="@(Report.LighthouseReport?.PerformanceScore?.ToString() ?? "—")" Label="Lighthouse performance score" Sublabel="Synthetic lab measurement" Variant="neutral" />
</section>

@if (Report.BrowserRuntimeReport is { } runtime)
{
    <section class="fqr-section" aria-label="Browser Runtime details">
        <SectionHeader Title="Browser Runtime" />
        <p><strong>Assessment state:</strong> @runtime.Status &nbsp; <strong>Browser:</strong> @(runtime.BrowserName ?? "Unavailable") @(runtime.BrowserVersion ?? "") &nbsp; <strong>Duration:</strong> @(runtime.DurationMs.HasValue ? $"{runtime.DurationMs.Value} ms" : "Unavailable")</p>
        <p><strong>Console errors:</strong> @runtime.ConsoleErrorCount &nbsp; <strong>Page errors:</strong> @runtime.PageErrorCount &nbsp; <strong>Critical resource failures:</strong> @runtime.CriticalResourceFailureCount</p>
        @foreach (var finding in runtime.Findings ?? []) { <p><strong>@finding.Category:</strong> @finding.Title — @finding.Description</p> }
        @if ((runtime.Limitations ?? []).Count > 0) { <p><strong>Limitations:</strong> @string.Join(" ", runtime.Limitations!)</p> }
    </section>
}

<section class="fqr-section" aria-label="Engine scope statements">
    <SectionHeader Title="Engine scope statements" />
    <p><strong>Accessibility:</strong> Automated accessibility checks can identify selected rendered-DOM issues. Manual accessibility testing remains required; automated results do not establish WCAG conformance.</p>
    <p><strong>Passive Security / ZAP:</strong> Passive checks only. No active scan, spider, fuzzing, or penetration-test claim.</p>
    <p><strong>Lighthouse:</strong> Synthetic lab performance only. It is not production field data and does not provide field INP.</p>
</section>

@code {
    [Parameter, EditorRequired] public FrontendQualityReviewReport Report { get; set; } = default!;
    /// <summary>Disabled / not-selected engines are hidden by default; they were not part of this review and are not missed work.</summary>
    private bool _showInactive;
    private FrontendQualityCoverage CoverageCounts =>
        Report.Coverage is { } coverage && coverage.RequiredTotal + coverage.OptionalTotal + coverage.InactiveCount > 0
            ? coverage
            : FrontendQualityCoverage.Evaluate(Report.EngineOutcomes);
    private int RequiredTotal => CoverageCounts.RequiredTotal;
    private int RequiredAssessed => CoverageCounts.RequiredAssessed;
    private IEnumerable<FrontendQualityEngineOutcome> RequiredNotAssessed => Report.EngineOutcomes
        .Where(o => o.Requirement == FrontendQualityEngineRequirement.Required && o.ExecutionState != FrontendQualityEngineExecutionState.Assessed)
        .OrderBy(o => o.EngineId);
    private int OptionalTotal => CoverageCounts.OptionalTotal;
    private int OptionalAssessed => CoverageCounts.OptionalAssessed;
    private int InactiveCount => CoverageCounts.InactiveCount;
    private int CriticalHighCount => Report.LogicalIssues.Count(i => i.PrimarySeverity is FrontendQualitySeverity.Critical or FrontendQualitySeverity.High);
    private string DispositionLabel => Report.ReleaseDisposition?.ToString() ?? "ReviewRequired";
    private string DispositionText => Report.ReleaseDisposition switch {
        FrontendQualityReleaseDisposition.Blocked when RequiredTotal > 0 && RequiredAssessed < RequiredTotal =>
            $"Required engine could not assess the target ({RequiredAssessed} of {RequiredTotal} required engines completed). See the engine table for the exact access blocker.",
        FrontendQualityReleaseDisposition.Blocked => "Automated review is blocked by one or more configured release-blocking conditions.",
        FrontendQualityReleaseDisposition.NoAutomatedBlockDetected => "No configured automated release block was detected.",
        _ => "Automated evidence requires review before a release decision can be made." };
    private string DispositionClass => Report.ReleaseDisposition == FrontendQualityReleaseDisposition.Blocked ? "wsr-banner-error" : Report.ReleaseDisposition == FrontendQualityReleaseDisposition.ReviewRequired ? "wsr-banner-warn" : "wsr-banner-info";
    private string CoverageLabel => Report.Coverage?.RequiredCoverageState switch {
        FrontendQualityRequiredCoverageState.AllRequiredAssessed => "All required engines assessed",
        FrontendQualityRequiredCoverageState.SomeRequiredNotAssessed => "Some required engines not assessed",
        _ => "No trustworthy required assessment" };
    private static string ModeLabel(ReviewExecutionMode mode) => mode switch
    {
        ReviewExecutionMode.AuthenticatedViaLocalHttpsProxy => "Authenticated via Local HTTPS Proxy",
        ReviewExecutionMode.AuthenticatedViaManagedEdgeCdp => "Authenticated via Managed Edge (CDP)",
        ReviewExecutionMode.AuthenticatedUnavailable => "Authenticated context unavailable",
        ReviewExecutionMode.ManualNotExecuted => "Manual only — not executed",
        _ => "Public",
    };
    private static string ToolLabel(FrontendQualityEngineOutcome outcome) => string.Join(" · ", new[] { outcome.ToolName, outcome.ToolVersion, outcome.BrowserName, outcome.BrowserVersion }.Where(v => !string.IsNullOrWhiteSpace(v)));
    private static string EvidenceLabel(FrontendQualityEvidenceStrength strength) => strength switch { FrontendQualityEvidenceStrength.DirectObservation => "Direct observation", FrontendQualityEvidenceStrength.ToolDiagnostic => "Tool diagnostic", FrontendQualityEvidenceStrength.StaticIndicator => "Static indicator", _ => "Derived summary" };
    private static string DispositionLabelFor(FrontendQualityReviewDisposition disposition) => disposition switch { FrontendQualityReviewDisposition.ManualVerificationRequired => "Manual verification required", FrontendQualityReviewDisposition.Informational => "Informational", _ => "Automated finding" };
}
