@using BirkNext.Web.Models
@using BirkNext.Web.Services

@* Contract and schema evidence for the selected targets, plus the baseline history drift is compared against. Each state
   keeps its own meaning: "No contract configured" is a configuration fact, "Introspection unavailable" is a server policy
   observation, and "Not compared yet" is not the same as "no drift". None of them is a failure. *@
<div class="aqr-contracts" data-testid="aqr-contracts">
    <ul class="aqr-contract-rows">
        @foreach (var row in Contracts.Rows)
        {
            <li class="aqr-contract-row" data-testid="aqr-contract-row" data-protocol="@row.Label" data-state="@row.State">
                <span class="aqr-contract-label">@row.Label</span>
                <span class="aqr-pill aqr-pill-@ApiReviewContractStates.Tone(row.State)" data-testid="aqr-contract-state"><span aria-hidden="true">@ApiReviewContractStates.Glyph(row.State)</span> @ApiReviewContractStates.Label(row.State)</span>
                <span class="aqr-contract-detail">@row.Detail</span>
            </li>
        }
        <li class="aqr-contract-row" data-testid="aqr-contract-history">
            <span class="aqr-contract-label">History</span>
            <span class="aqr-pill aqr-pill-@(Contracts.BaselineCount > 0 ? "ready" : "muted")" data-testid="aqr-baselines"><span aria-hidden="true">@(Contracts.BaselineCount > 0 ? "✓" : "○")</span> @Contracts.HistoryLabel</span>
            <span class="aqr-contract-detail" data-testid="aqr-latest-comparison">@Contracts.LatestComparison</span>
        </li>
    </ul>
    <ReviewDisclosure Text="View contract details" CollapseText="Hide contract details" TestId="aqr-contract-details" Class="disclosure-inline">
        <ul class="aqr-list aqr-muted">
            @foreach (var line in Contracts.Details) { <li>@line</li> }
        </ul>
    </ReviewDisclosure>
</div>

@code {
    [Parameter, EditorRequired] public ApiReviewContractPanelModel Contracts { get; set; } = default!;
}
