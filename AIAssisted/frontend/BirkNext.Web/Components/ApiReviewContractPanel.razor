@using BirkNext.Web.Models
@using BirkNext.Web.Services

@* Contract and schema evidence for the selected targets, plus the baseline history drift is compared against. Each state
   keeps its own meaning: "No contract configured" is a configuration fact, "Introspection unavailable" is a server policy
   observation, and "Not compared yet" is not the same as "no drift". None of them is a failure. *@
<div class="aqr-contracts" data-testid="aqr-contracts">
    @* Compact: one line per contract source and one for history. Each row's explanation is in contract details. *@
    <dl class="aqr-contract-rows">
        @foreach (var row in Contracts.Rows)
        {
            <div class="aqr-contract-row" data-testid="aqr-contract-row" data-protocol="@row.Label" data-state="@row.State">
                <dt class="aqr-contract-label">@(row.Label == "REST" ? "REST contract" : "GraphQL schema")</dt>
                <dd><span class="aqr-pill aqr-pill-@ApiReviewContractStates.Tone(row.State)" data-testid="aqr-contract-state"><span aria-hidden="true">@ApiReviewContractStates.Glyph(row.State)</span> @ApiReviewContractStates.PreRunSummary(row.State)</span></dd>
            </div>
        }
        <div class="aqr-contract-row" data-testid="aqr-contract-history">
            <dt class="aqr-contract-label">History</dt>
            @* Two separate facts: how many baselines exist, and what the latest comparison found. "No drift detected"
               is about compared evidence only; it never says the contract is compatible. *@
            <dd><span data-testid="aqr-baselines">@Contracts.HistoryLabel</span> · <span data-testid="aqr-latest-comparison">@Contracts.LatestComparison</span></dd>
        </div>
    </dl>
    @* How each source is used, not what state it is in: the rows above already say that. *@
    <ReviewDisclosure Text="Contract details" CollapseText="Hide contract details" TestId="aqr-contract-details" Class="disclosure-inline disclosure-small">
        <ul class="aqr-list aqr-muted" data-testid="aqr-contract-details-list">
            @* A runtime schema row reads the same whether the latest review retrieved it or the next one will try; only its
               detail says which. Every other row's detail restates its summary, so it is not repeated here. *@
            @foreach (var row in Contracts.Rows.Where(r => r.State == ApiReviewContractState.RuntimeSchema)) { <li>@(row.Label): @row.Detail</li> }
            @foreach (var line in Contracts.Details) { <li>@line</li> }
        </ul>
    </ReviewDisclosure>
</div>

@code {
    [Parameter, EditorRequired] public ApiReviewContractPanelModel Contracts { get; set; } = default!;
}
