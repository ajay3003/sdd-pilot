@using BirkNext.LocalHttpsProxy
@using BirkNext.ManagedEdge
@using BirkNext.Web.Services
@using BirkNext.Web.Models

<section class="fa-detection-summary fa-state-@RuntimeState" data-testid="local-https-proxy-panel" aria-label="Local HTTPS proxy authenticated testing">
    <div class="fa-card-heading"><h3>Local HTTPS proxy</h3><span class="fa-card-status" role="status">Runtime: @RuntimeLabel</span></div>
    <div class="fa-auth-steps">
    <div class="fa-auth-step fa-state-@RuntimeState">
    <h4>Step 1 — Proxy</h4>
    <dl class="fa-detail-list" data-testid="proxy-status">
        <div class="fa-dl-row"><dt>Proxy status</dt><dd data-testid="proxy-state">@ProxyStatusLabel</dd></div>
        <div class="fa-dl-row"><dt>Endpoint</dt><dd data-testid="proxy-endpoint">@Status.Endpoint</dd></div>
    </dl>
    @if (Status.State == LocalHttpsProxyState.Stale)
    {
        <p role="status" data-testid="proxy-stale">Environment settings changed. The proxy session and its in-memory authentication context were cleared. Run Check proxy compatibility again.</p>
    }
    <details><summary>Proxy diagnostics</summary>
    <dl class="fa-detail-list">
        <div class="fa-dl-row"><dt>Local integration</dt><dd data-testid="proxy-local-integration">@(Checked ? (Status.LocalIntegrationAvailable ? "Available" : "Local proxy integration unavailable in this deployment mode") : "Not checked")</dd></div>
        <div class="fa-dl-row"><dt>Environment</dt><dd data-testid="proxy-environment">@EnvironmentLabel</dd></div>
        <div class="fa-dl-row"><dt>Port</dt><dd data-testid="proxy-port">@(Checked ? (Status.PortAvailable ? "Available" : "Occupied — free the port or configure another local port (BirkNext never frees a port)") : "Not checked")</dd></div>
        <div class="fa-dl-row"><dt>Target</dt><dd data-testid="proxy-target">@(Profile?.Name ?? "—") @(Status.TargetOrigin is { } origin ? $"({origin})" : "")</dd></div>
        <div class="fa-dl-row"><dt>Approved hosts</dt><dd data-testid="proxy-approved-hosts">@(Status.ApprovedHosts.Count == 0 ? (Checked ? "None" : "Not checked") : string.Join(", ", Status.ApprovedHosts))</dd></div>
    </dl>
    <p role="status" data-testid="proxy-evidence">@Status.Evidence</p>
    </details>
    @if (Status.FailureReason is { } failure)
    {
        <p role="alert" data-testid="proxy-failure">@failure</p>
    }
    @if (Status.Certificate.Guidance is { Length: > 0 } guidance && Status.Certificate.State != ProxyCertificateTrustState.Trusted && Checked)
    {
        <p class="fa-section-note" data-testid="proxy-certificate-guidance">@guidance</p>
    }

    <div class="fa-field-full" style="display:flex;gap:0.5rem;flex-wrap:wrap;margin:0.5rem 0">
        <button type="button" class="btn-secondary" disabled="@(Runtime is null || Runtime.Busy || Profile is null)" @onclick="Check">Check proxy compatibility</button>
        <button type="button" class="btn-secondary" disabled="@(Runtime is null || Runtime.Busy || Profile is null || !EnvironmentAllowed || (Checked && !Status.CanStart && !Active))" @onclick="Start">Start authenticated proxy</button>
        <button type="button" class="btn-secondary" disabled="@(Runtime is null || !Active)" @onclick="Stop">Stop proxy</button>
    </div>

    </div>
    <div class="fa-auth-step fa-state-@(Status.Certificate.State == ProxyCertificateTrustState.Trusted ? "ready" : Checked ? "needs-action" : "neutral")">
    <h4>Step 2 — Certificate</h4>
    <p data-testid="proxy-certificate">@AuthenticatedTestingMethodLabels.Certificate(Status.Certificate.State)</p>
    <details><summary>Certificate details</summary>
    <p class="fa-section-note">
        Intercepting approved hosts requires trusting the dedicated <em>BirkNext DEV HTTPS Inspection CA</em> for the current Windows user. BirkNext never installs it silently:
        confirm here, then confirm the Windows prompt. Remove it when authenticated proxy testing is no longer needed.
    </p>
    </details>
    @if (Status.Certificate.State == ProxyCertificateTrustState.Trusted)
    {
        @if (!_confirmRemove)
        {
            <button type="button" class="btn-secondary" disabled="@(Runtime is null || Runtime.Busy)" @onclick="() => _confirmRemove = true">Remove test certificate</button>
        }
        else
        {
            <button type="button" class="btn-secondary" disabled="@(Runtime is null || Runtime.Busy)" @onclick="RemoveCertificate">Confirm remove test certificate</button>
            <button type="button" class="btn-secondary" @onclick="() => _confirmRemove = false">Cancel</button>
        }
    }
    else
    {
        @if (!_confirmInstall)
        {
            <button type="button" class="btn-secondary" disabled="@(Runtime is null || Runtime.Busy || !Status.Certificate.InstallSupported || !Checked)" @onclick="() => _confirmInstall = true">Install test certificate</button>
        }
        else
        {
            <button type="button" class="btn-secondary" disabled="@(Runtime is null || Runtime.Busy)" @onclick="InstallCertificate">Confirm install test certificate</button>
            <button type="button" class="btn-secondary" @onclick="() => _confirmInstall = false">Cancel</button>
        }
    }

    </div>
    <div class="fa-auth-step fa-state-@BrowserStepState" data-testid="proxy-browser-step">
    <h4>Step 3 — Browser</h4>
    <p>Configure your normal managed Microsoft Edge to use the BirkNext local proxy, then sign in normally.</p>
    <dl class="fa-detail-list">
        <div class="fa-dl-row"><dt>Proxy</dt><dd data-testid="proxy-browser-endpoint">@ProxyEndpointDisplay</dd></div>
        <div class="fa-dl-row"><dt>Browser authentication</dt><dd data-testid="proxy-browser-auth">Manual</dd></div>
    </dl>
    @if (BrowserStepBlocker is { } blocker)
    {
        <p role="status" data-testid="proxy-browser-prerequisite">@blocker</p>
    }
    <p class="fa-section-note" data-testid="proxy-browser-note">BirkNext does not change your default Windows or Edge proxy settings automatically.</p>
    <details data-testid="proxy-setup-instructions"><summary>Show proxy setup instructions</summary>
    <p class="fa-section-note">
        Windows Settings → Network &amp; Internet → Proxy → Manual proxy setup → Address <code>127.0.0.1</code>, Port <code>@PortDisplay</code>.
        Then open your normal managed Microsoft Edge, go to the target application, and sign in manually — complete MFA, PIN, passkey and Conditional Access as usual.
        Turn the proxy setting off again after testing. If organization policy forces proxy settings, only the manual route applies.
    </p>
    </details>

    </div>
    <div class="fa-auth-step">
    <h4>Step 4 — Authenticated API discovery</h4>
    <dl class="fa-detail-list">
        <div class="fa-dl-row"><dt>Authenticated context</dt><dd data-testid="proxy-credential">@(Status.AuthenticatedCredentialAvailable || Status.CredentialExpired ? AuthenticatedTestingMethodLabels.Credential(Status) : "Waiting for authenticated traffic")</dd></div>
        <div class="fa-dl-row"><dt>Authenticated traffic</dt><dd data-testid="proxy-authenticated-traffic">@AuthenticatedTestingMethodLabels.AuthenticatedTraffic(Status)</dd></div>
        @if (Status.CredentialExpiresAt is { } expires)
        {
            <div class="fa-dl-row"><dt>Authenticated API session expires</dt><dd data-testid="proxy-credential-expiry">@expires.ToLocalTime().ToString("HH:mm:ss")</dd></div>
        }
        <div class="fa-dl-row"><dt>Discovered REST</dt><dd data-testid="discovered-rest">@DiscoveredRestLabel</dd></div>
        <div class="fa-dl-row"><dt>Discovered GraphQL</dt><dd data-testid="discovered-graphql">@DiscoveredGraphQlLabel</dd></div>
    </dl>
    <p class="fa-section-note" data-testid="discovery-guidance">Endpoints are learned from the authenticated traffic BirkNext actually observed — never assumed. @(Status.ObservedEndpoints.Count == 0 ? "Sign in and use the application normally (open a screen that loads data) to generate authenticated API traffic." : "")</p>
    <details data-testid="observed-endpoints"><summary>Observed authenticated endpoints (@Status.ObservedEndpoints.Count)</summary>
    @if (Status.ObservedEndpoints.Count == 0)
    {
        <p class="fa-section-note">No authenticated API endpoints observed yet. Use the application normally to generate API traffic.</p>
    }
    else
    {
        <dl class="fa-detail-list">
            @foreach (var endpoint in Status.ObservedEndpoints)
            {
                <div class="fa-dl-row">
                    <dt>@endpoint.EndpointType · @ConfidenceLabel(endpoint)</dt>
                    <dd>@endpoint.Method @endpoint.Display → HTTP @endpoint.ResponseStatus@(endpoint.EndpointType == ObservedEndpointType.GraphQl ? $" ({endpoint.OperationType}{(endpoint.OperationName is { Length: > 0 } n ? $" {n}" : "")})" : "")@(endpoint.Count > 1 ? $" ×{endpoint.Count}" : "")</dd>
                </div>
            }
        </dl>
    }
    </details>
    <details><summary>Authenticated API checks</summary>
    <p class="fa-section-note">Read-only checks only: a REST GET/HEAD/OPTIONS on a discovered (or configured) endpoint, and a single GraphQL query. Mutations, subscriptions and unsafe HTTP methods are rejected. Response bodies are not captured.</p>
    <dl class="fa-detail-list" data-testid="proxy-checks">
        <div class="fa-dl-row"><dt>REST check target</dt><dd>@(RestReplayUrl ?? "No discovered or configured HTTPS REST endpoint")</dd></div>
        <div class="fa-dl-row"><dt>REST result</dt><dd data-testid="proxy-rest-result">@(Runtime?.LastRestResult?.Outcome ?? "Not run")</dd></div>
        <div class="fa-dl-row"><dt>GraphQL check target</dt><dd>@(GraphQlReplayUrl ?? "No discovered or configured HTTPS GraphQL endpoint")</dd></div>
        <div class="fa-dl-row"><dt>GraphQL result</dt><dd data-testid="proxy-graphql-result">@(Runtime?.LastGraphQlResult?.Outcome ?? "Not run")</dd></div>
    </dl>
    @if (Runtime?.LastExecutionError is { } error)
    {
        <p role="alert" data-testid="proxy-check-error">@error</p>
    }
    <div class="fa-field-full" style="display:flex;gap:0.5rem;flex-wrap:wrap;margin:0.5rem 0">
        <button type="button" class="btn-secondary" disabled="@(Runtime is null || Runtime.Busy || !Status.RestAvailable || RestReplayUrl is null)" @onclick="RunRest">Run authenticated REST GET</button>
        <button type="button" class="btn-secondary" disabled="@(Runtime is null || Runtime.Busy || !Status.GraphQlQueryAvailable || GraphQlReplayUrl is null)" @onclick="RunGraphQl">Run authenticated GraphQL query</button>
    </div>

    </details>
    </div>
    </div>
    <AuthenticatedCapabilities Api="Status.AuthenticatedCredentialAvailable" Rest="Status.AuthenticatedRestObserved" GraphQl="Status.AuthenticatedGraphQlQueryObserved" TrafficVerified="true" />

</section>

@code {
    [Parameter] public LocalHttpsProxyRuntime? Runtime { get; set; }
    [Parameter] public FrontendAnalysisProfile? Profile { get; set; }
    [Parameter] public ManagedEdgeStatus EdgeStatus { get; set; } = new();

    private bool _confirmInstall;
    private bool _confirmRemove;

    private LocalHttpsProxyStatus Status => Runtime?.For(Profile) ?? new();
    private bool Checked => Status.State != LocalHttpsProxyState.NotStarted || Status.ApprovedHosts.Count > 0 || Status.FailureReason is not null;
    private bool Active => Status.SessionId is not null && Status.State is not (LocalHttpsProxyState.Stopped or LocalHttpsProxyState.Stale or LocalHttpsProxyState.Failed);
    private bool EnvironmentAllowed => LocalHttpsProxyScope.EnvironmentAllowed(Profile);
    private string RuntimeState => !EnvironmentAllowed || Status.State == LocalHttpsProxyState.Failed ? "blocked" :
        Status.CredentialExpired ? "needs-action" : Status.AuthenticatedCredentialAvailable ? "ready" : Status.State switch
        {
            LocalHttpsProxyState.WaitingForCertificateTrust or LocalHttpsProxyState.WaitingForAuthenticatedTraffic or LocalHttpsProxyState.Stale => "needs-action",
            LocalHttpsProxyState.Listening or LocalHttpsProxyState.Starting or LocalHttpsProxyState.AuthenticatedTrafficDetected or LocalHttpsProxyState.Ready => "detected",
            _ => "neutral"
        };
    private string RuntimeLabel => RuntimeState == "blocked" ? "Blocked" : Status.CredentialExpired ? "Expired" :
        Status.AuthenticatedCredentialAvailable ? "Authenticated API context available" : AuthenticatedTestingMethodLabels.ProxyState(Status.State);
    private string EnvironmentLabel => Profile is null ? "—" : EnvironmentAllowed ? $"{Profile.EnvironmentType} - allowed" : $"{Profile.EnvironmentType} - Local HTTPS proxy unavailable (non-production environments only)";
    private string? RestUrl => Profile is null ? null : LocalHttpsProxyScope.RestCheckUrl(Profile);
    private string? GraphQlUrl => Profile is null ? null : LocalHttpsProxyScope.GraphQlCheckUrl(Profile);

    // Discovery: verified endpoints learned from observed authenticated traffic (never assumed /health or /graphql).
    private ObservedAuthenticatedEndpoint? DiscoveredRest => Status.VerifiedRestEndpoint;
    private ObservedAuthenticatedEndpoint? DiscoveredGraphQl => Status.VerifiedGraphQlQueryEndpoint;
    private string DiscoveredRestLabel => DiscoveredRest is { } e ? $"Verified — {e.Method} {e.Display} (HTTP {e.ResponseStatus})" : "Not observed yet";
    private string DiscoveredGraphQlLabel => DiscoveredGraphQl is { } e ? $"Verified — {e.Method} {e.Display} ({e.OperationType})" : "Not observed yet";
    private static string ConfidenceLabel(ObservedAuthenticatedEndpoint endpoint) => endpoint.Confidence switch
    {
        ObservedEndpointConfidence.Verified => "Verified from traffic",
        ObservedEndpointConfidence.Candidate => "Candidate",
        _ => "Rejected (not an API)"
    };

    // Safe replay prefers a discovered read-only endpoint; falls back to the configured endpoint. The backend re-enforces HTTPS + approved-host + safe-method.
    private string? RestReplayUrl => DiscoveredRest is { Method: "GET" or "HEAD" or "OPTIONS" } e ? e.Display : RestUrl;
    private string? GraphQlReplayUrl => DiscoveredGraphQl?.Display ?? GraphQlUrl;

    // Primary Step-1 status line in plain words. Stopped/Stale are transient session states (their integration/port flags are not a fresh
    // compatibility signal), so they use the base wording; environment/deployment/port blockers only override an actively evaluated state.
    private string ProxyStatusLabel =>
        Status.State is LocalHttpsProxyState.Stopped or LocalHttpsProxyState.Stale ? AuthenticatedTestingMethodLabels.ProxyState(Status.State)
        : !EnvironmentAllowed ? "Blocked by environment policy (non-production only)"
        : Checked && !Status.LocalIntegrationAvailable ? "Unavailable in this deployment mode"
        : Checked && !Status.PortAvailable && !Active ? "Port occupied — free the port or configure another"
        : AuthenticatedTestingMethodLabels.ProxyState(Status.State);

    private string PortDisplay => Status.Port > 0 ? Status.Port.ToString() : "<port>";
    private string ProxyEndpointDisplay => Status.Port > 0 ? $"127.0.0.1:{Status.Port}" : "127.0.0.1:<port>";
    // Step 3 becomes actionable only once the proxy can actually accept authenticated traffic: a live session and a trusted certificate.
    private string BrowserStepState => !Active ? "neutral" : Status.Certificate.State != ProxyCertificateTrustState.Trusted ? "needs-action" : "ready";
    private string? BrowserStepBlocker => !Active ? "Complete Steps 1–2 first: start the proxy so it is listening."
        : Status.Certificate.State != ProxyCertificateTrustState.Trusted ? "Trust the BirkNext DEV test certificate (Step 2) before signing in."
        : null;

    private Task Check() => Runtime is not null && Profile is not null ? Runtime.CheckCompatibilityAsync(Profile) : Task.CompletedTask;
    private Task Start() => Runtime is not null && Profile is not null && EnvironmentAllowed ? Runtime.StartAsync(Profile) : Task.CompletedTask;
    private Task Stop() => Runtime?.StopAsync() ?? Task.CompletedTask;
    private async Task InstallCertificate() { _confirmInstall = false; if (Runtime is not null) await Runtime.InstallCertificateAsync(); }
    private async Task RemoveCertificate() { _confirmRemove = false; if (Runtime is not null) await Runtime.RemoveCertificateAsync(); }
    private Task RunRest() => Runtime is not null && RestReplayUrl is { } url ? Runtime.ExecuteRestCheckAsync(url) : Task.CompletedTask;
    private Task RunGraphQl() => Runtime is not null && GraphQlReplayUrl is { } url ? Runtime.ExecuteGraphQlCheckAsync(url, LocalHttpsProxyScope.GraphQlCheckQuery) : Task.CompletedTask;
}
