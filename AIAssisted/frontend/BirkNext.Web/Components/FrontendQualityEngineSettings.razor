@using BirkNext.Web.Models

<div class="frontend-quality-engine-settings">
    <div class="fqe-toolbar">
        <SecondaryButton OnClick="OnRefreshRequested" Disabled="@IsLoadingStatus">Refresh status</SecondaryButton>
    </div>

    @if (IsLoadingStatus)
    {
        <div class="fqe-message" role="status">Checking engine status…</div>
    }
    else if (AnonymousStatus == null)
    {
        <div class="fqe-message fqe-message-error" role="alert">Unable to load engine status. @StatusLoadError</div>
    }
    else
    {
        <div class="dev-diag-subgrid" role="list">
            @foreach (var engine in GetEngineDisplayOrder())
            {
                var status = AnonymousStatus.Engines.FirstOrDefault(e => e.EngineId == engine.EngineId);
                var authStatus = AuthenticatedStatus?.Engines.FirstOrDefault(e => e.EngineId == engine.EngineId);

                if (status != null)
                {
                    <section class="dev-diag-section" role="listitem" aria-label="@engine.DisplayLabel">
                        <div class="dev-diag-section-title">@engine.DisplayLabel</div>
                        <table class="settings-table">
                            <tbody>
                                <tr>
                                    <td>Installation policy</td>
                                    <td><span class="settings-badge @(status.Layer1Allowed ? "settings-badge-local" : "settings-badge-shared")">@(status.Layer1Allowed ? "Allowed" : "Not allowed")</span></td>
                                </tr>
                                <tr>
                                    <td>System setting</td>
                                    <td>
                                        <FeatureRow Label=""
                                                    Enabled="@(IsEditMode ? (EditedPreferences?.TryGetValue(engine.PreferenceKey, out var pref) == true ? pref : status.Layer2Enabled) : status.Layer2Enabled)"
                                                    IsEditMode="@IsEditMode"
                                                    IsLocked="false"
                                                    OnToggle="@((bool value) => HandleToggle(engine.PreferenceKey, value))" />
                                    </td>
                                </tr>
                                <tr>
                                    <td>Runtime readiness</td>
                                    <td>
                                        <span class="settings-badge @(status.Layer3Readiness?.IsAvailable == true ? "settings-badge-local" : "settings-badge-shared")">@(status.Layer3Readiness?.IsAvailable == true ? "Ready" : "Unavailable")</span>
                                        @if (!string.IsNullOrWhiteSpace(status.Layer3Readiness?.StatusReason))
                                        {
                                            <span class="fqe-inline-reason">@status.Layer3Readiness.StatusReason</span>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <td>Authenticated review</td>
                                    <td><span class="settings-badge @(authStatus?.AuthModeSupported == true ? "settings-badge-local" : "settings-badge-shared")">@(authStatus?.AuthModeSupported == true ? "Supported" : "Not supported")</span></td>
                                </tr>
                                <tr>
                                    <td>Effective availability</td>
                                    <td><span class="settings-badge @(status.Available ? "settings-badge-local" : "settings-badge-shared")">@(status.Available ? "Available" : "Unavailable")</span></td>
                                </tr>
                            </tbody>
                        </table>

                        @{ var reasons = status.Reasons.Where(r => r != FrontendQualityEngineUnavailableReasonDto.None).ToList(); }
                        @if (reasons.Count > 0)
                        {
                            <div class="fqe-reasons" aria-label="Availability reasons">
                                <div class="fqe-reasons-title">Reasons</div>
                                <ul>
                                    @foreach (var reason in reasons)
                                    {
                                        <li>@GetReasonText(reason)</li>
                                    }
                                </ul>
                            </div>
                        }
                    </section>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public bool IsEditMode { get; set; }
    [Parameter] public IReadOnlyDictionary<string, bool>? EditedPreferences { get; set; }
    [Parameter] public EventCallback<(string EngineKey, bool Value)> OnToggle { get; set; }
    [Parameter] public FrontendQualityEngineStatusReportDto? AnonymousStatus { get; set; }
    [Parameter] public FrontendQualityEngineStatusReportDto? AuthenticatedStatus { get; set; }
    [Parameter] public bool IsLoadingStatus { get; set; }
    [Parameter] public string? StatusLoadError { get; set; }
    [Parameter] public EventCallback OnRefreshRequested { get; set; }

    private sealed record EngineDisplay(FrontendQualityEngineIdDto EngineId, string DisplayLabel, string PreferenceKey);

    private static IReadOnlyList<EngineDisplay> GetEngineDisplayOrder() =>
    [
        new(FrontendQualityEngineIdDto.BrowserRuntime, "Browser Runtime", "BrowserRuntime"),
        new(FrontendQualityEngineIdDto.Accessibility, "Accessibility", "Accessibility"),
        new(FrontendQualityEngineIdDto.Lighthouse, "Lighthouse", "Lighthouse"),
        new(FrontendQualityEngineIdDto.PassiveSecurity, "Passive Security (ZAP)", "PassiveSecurity"),
    ];

    private static string GetReasonText(FrontendQualityEngineUnavailableReasonDto reason) => reason switch
    {
        FrontendQualityEngineUnavailableReasonDto.BlockedByDeploymentPolicy => "Not allowed on this installation",
        FrontendQualityEngineUnavailableReasonDto.DisabledInSystemSettings => "Disabled in System Settings",
        FrontendQualityEngineUnavailableReasonDto.RuntimeUnavailable => "Runtime prerequisite unavailable",
        FrontendQualityEngineUnavailableReasonDto.RuntimeStatusUnknown => "Status check timed out or is unknown",
        FrontendQualityEngineUnavailableReasonDto.NotApplicableToReview => "Not applicable to this review",
        FrontendQualityEngineUnavailableReasonDto.AuthenticationModeUnsupported => "Not supported for authenticated reviews",
        _ => reason.ToString(),
    };

    private Task HandleToggle(string key, bool value) => OnToggle.InvokeAsync((key, value));
}
