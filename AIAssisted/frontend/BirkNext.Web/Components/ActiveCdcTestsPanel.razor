@using BirkNext.Integrations
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@implements IDisposable
@inject IServiceProvider Services
@inject IReportExportService ExportService
@inject IWorkspaceSessionService Workspace
@inject IJSRuntime JS

@* IQR → Active tests → CDC. The only IQR action that SENDS: one built-in synthetic Person event to an enrolled DEV/QA Event Hub.
   Every gate (environment, destination, source contract, reserved key range, identity) is decided by the backend; this panel shows
   the decision, asks for explicit confirmation and then shows each stage as its own evidence. Not assessed is never shown as a pass. *@
@if (Api is null) { return; }
<section class="act" aria-labelledby="act-heading" data-testid="act-panel">
    <h2 id="act-heading">Active tests</h2>
    @if (SummaryFirst)
    {
        var blockers = _readiness?.Checks.Where(c => c.State == ActiveCdcReadinessState.Blocked).ToList() ?? [];
        <dl class="act-summary" data-testid="act-summary">
            <div><dt>Scenarios</dt><dd data-testid="act-summary-scenarios">@ScenarioOptions.Length available</dd></div>
            <div><dt>Selected scenario</dt><dd data-testid="act-summary-scenario">@(ScenarioOptions.FirstOrDefault(o => o.Id == _scenarioId)?.Name ?? "None available")</dd></div>
            <div><dt>Execution</dt><dd><span class="act-pill act-pill-@(_readiness?.CanRun == true ? "ready" : "neutral")" data-testid="act-summary-execution">@SummaryExecution</span></dd></div>
        </dl>
        @if (blockers.Count > 0)
        {
            <p class="act-summary-label">Main blockers</p>
            <ul class="act-summary-blockers" data-testid="act-summary-blockers">@foreach (var b in blockers) { <li>@b.Label</li> }</ul>
        }
        <button type="button" class="act-toggle" aria-expanded="@(_open ? "true" : "false")" aria-controls="@_runnerId" data-testid="act-open" @onclick="() => _open = !_open">@(_open ? "Hide active tests" : "Open active tests")</button>
    }
    <div id="@_runnerId" class="act-runner" hidden="@(SummaryFirst && !_open)" data-testid="act-runner">
    <p class="act-notice" role="note" data-testid="act-notice"><strong>@ActiveCdcLabels.ActiveTestNotice</strong></p>
    <fieldset class="act-scenarios" data-testid="act-scenarios" disabled="@(_starting || _run is { Completed: false })">
        <legend>CDC scenario</legend>
        @foreach (var option in ScenarioOptions)
        {
            <label class="act-scenario">
                <input type="radio" name="act-scenario" value="@option.Id" checked="@(option.Id == _scenarioId)" data-testid="@($"act-scenario-{option.Id}")" @onchange="() => SelectScenarioAsync(option.Id)" />
                <span>@option.Name</span> <span class="act-pill act-pill-neutral">@option.Category</span>
                <span class="act-muted">Provider @option.ExtensionId · transport @option.TransportType</span>
            </label>
        }
    </fieldset>
    <h3 class="act-subheading" data-testid="act-scenario-heading">CDC — @Shown.Name <span class="act-muted">(@Shown.Id v@(Shown.Version))</span> <span class="act-pill act-pill-neutral" data-testid="act-category">@Category</span></h3>
    <p class="act-muted">@Shown.Description</p>
    @if (Shown.Limitation.Length > 0) { <p class="act-limitation" role="note" data-testid="act-limitation"><strong>@Shown.Limitation</strong></p> }

@if (Candidates.Count == 0)
    {
        <p class="act-empty" data-testid="act-no-integration">No enabled Event Hub integration is available. Configure an integration in Target Environment → Integrations.</p>
    }
    else
    {
        <label for="act-integration">CDC integration</label>
        <select id="act-integration" value="@_integrationId" @onchange="SelectIntegrationAsync" disabled="@Busy">
            @foreach (var integration in Candidates) { <option value="@integration.Id">@integration.DisplayName</option> }
        </select>

        @if (_loading) { <p class="act-muted" role="status">Checking readiness…</p> }
        @if (_readiness is { } readiness)
        {
            <dl class="act-facts" data-testid="act-destination">
                <div><dt>Event Hub</dt><dd class="act-mono">@(readiness.Destination.EventHub ?? "Not configured")</dd></div>
                <div><dt>Namespace</dt><dd class="act-mono">@(readiness.Destination.NamespaceFqdn ?? "Not configured")</dd></div>
                <div><dt>Consumer group</dt><dd>@(readiness.Destination.ConsumerGroup is { } g ? $"{g}{(readiness.Destination.ConsumerGroupAssumed ? " (configured assumption)" : "")}" : "Not configured")</dd></div>
                <div><dt>Source contract</dt><dd data-testid="act-contract" data-status="@readiness.Manifest.Status">@ActiveCdcLabels.Contract(readiness.Manifest.Status)@if (readiness.Manifest.Fingerprint.Length > 0) { <span class="act-muted"> · manifest @readiness.Manifest.Fingerprint</span> }</dd></div>
            </dl>
            <ul class="act-checks" data-testid="act-checks">
                @foreach (var check in readiness.Checks)
                {
                    <li class="act-check" data-testid="act-check" data-key="@check.Key" data-state="@check.State">
                        <span class="act-check-label">@check.Label</span>
                        <span class="act-pill act-pill-@ActiveCdcPresentation.Tone(check.State)">@ActiveCdcLabels.Readiness(check.State)</span>
                        <span class="act-check-detail">@check.Detail</span>
                    </li>
                }
            </ul>

            @if (!_confirming)
            {
                <div class="act-actions">
                    <button type="button" class="btn-primary" data-testid="act-start" disabled="@(!readiness.CanRun || Busy)" aria-describedby="act-start-note" @onclick="() => { _confirming = true; _acknowledged = false; }">@(Shown.MessageCount > 1 ? $"Send {Shown.MessageCount} synthetic events…" : "Send one synthetic event…")</button>
                </div>
                <p id="act-start-note" class="act-muted" data-testid="act-start-note">
                    @(!readiness.CanRun ? "Cannot run: resolve the blocked checks above. Nothing is sent while any check is blocked."
                        : IsInvalidScenario ? $"Sends the reviewed invalid event I, then a valid control V — one attempt each, in order — and observes read-only evidence for up to {readiness.ObservationSeconds} s after each. Passed requires the consumer to advance past V after I."
                        : Shown.MessageCount > 1 ? $"Sends A, an exact replay A2 and a control B — one attempt each, in order — and observes read-only evidence for up to {readiness.ObservationSeconds} s after each. Passed requires progression after the replay."
                        : $"Sends exactly one event, then observes read-only evidence for up to {readiness.ObservationSeconds} s. Without a verified Person read the best result is Partial.")
                </p>
            }
            else
            {
                <div class="act-confirm" role="group" aria-labelledby="act-confirm-heading" data-testid="act-confirm">
                    <h4 id="act-confirm-heading">Confirm active test</h4>
                    @if (IsInvalidScenario)
                    {
                        <p>Two synthetic Person events are sent, in order, to <strong class="act-mono">@readiness.Destination.EventHub</strong> on <span class="act-mono">@readiness.Destination.NamespaceFqdn</span> (@Profile.EnvironmentType):</p>
                        <ol class="act-plan" data-testid="act-confirm-messages">
                            <li><strong>I</strong> — controlled invalid Person CDC (@Shown.InvalidFixture). Table Person, operation create. Invalid condition: @Shown.InvalidCondition</li>
                            <li><strong>V</strong> — valid synthetic Person control (next reserved synthetic key)</li>
                        </ol>
                        <p>Persistent synthetic control Person may remain: <strong>Yes</strong>. Sent events cannot be recalled; cancelling only stops the remaining steps.</p>
                    }
                    else if (Shown.MessageCount > 1)
                    {
                        <p>Three synthetic Person events are sent, in order, to <strong class="act-mono">@readiness.Destination.EventHub</strong> on <span class="act-mono">@readiness.Destination.NamespaceFqdn</span> (@Profile.EnvironmentType):</p>
                        <ol class="act-plan" data-testid="act-confirm-messages">
                            <li><strong>A</strong> — PersonPK X (next reserved synthetic key)</li>
                            <li><strong>A2</strong> — same PersonPK X, exact replay of A</li>
                            <li><strong>B</strong> — different PersonPK Y, a following valid Person</li>
                        </ol>
                        <p>Persistent synthetic records may remain: <strong>Yes</strong>. Sent events cannot be recalled; cancelling only stops the remaining steps.</p>
                    }
                    else
                    {
                        <p>One synthetic Person create event is sent to <strong class="act-mono">@readiness.Destination.EventHub</strong> on <span class="act-mono">@readiness.Destination.NamespaceFqdn</span> (@Profile.EnvironmentType). A sent event cannot be recalled; cancelling only stops waiting for evidence.</p>
                    }
                    <label class="act-ack"><input type="checkbox" data-testid="act-ack" @bind="_acknowledged" /> I understand this sends synthetic test data to a non-production environment and cannot be undone.</label>
                    <div class="act-actions">
                        <button type="button" class="btn-primary" data-testid="act-confirm-send" disabled="@(!_acknowledged || Busy)" @onclick="StartAsync">@(Shown.MessageCount > 1 ? "Send synthetic events" : "Send synthetic event")</button>
                        <button type="button" class="btn-secondary" data-testid="act-confirm-cancel" @onclick="() => _confirming = false">Cancel</button>
                    </div>
                </div>
            }
        }
    }

    @if (_error is { } error) { <p class="act-error" role="alert" data-testid="act-error">@error</p> }

    @if (_run is { } run)
    {
        <section class="act-run" aria-labelledby="act-run-heading" data-testid="act-run" data-status="@run.Status">
            <h3 id="act-run-heading">Active test result <span class="act-pill act-pill-@ActiveCdcPresentation.Tone(run.Status)" data-testid="act-run-status">@ActiveCdcLabels.Status(run.Status)</span></h3>
            <p aria-live="polite" data-testid="act-run-headline"><strong>@ActiveCdcPresentation.Headline(run)</strong></p>
            @if (run.StatusReason.Length > 0) { <p data-testid="act-run-reason">@run.StatusReason</p> }
            @if (run.Scenario.PassDoesNotMean.Length > 0)
            {
                <p class="act-limitation" role="note" data-testid="act-pass-bounds">@(run.Status == ActiveCdcRunStatus.Passed ? $"{run.Scenario.PassMeaning} " : "")<strong>@run.Scenario.PassDoesNotMean</strong></p>
            }
            @if (!run.Completed)
            {
                <div class="act-actions">
                    <button type="button" class="btn-secondary" data-testid="act-cancel" disabled="@_cancelling" @onclick="CancelAsync">Stop the run</button>
                </div>
                <p class="act-muted" data-testid="act-cancel-note">@ActiveCdcLabels.CancelNotice</p>
            }
            <div class="act-table" tabindex="0" role="region" aria-label="Active test stages">
                <table>
                    <thead><tr><th scope="col">Stage</th><th scope="col">State</th><th scope="col">Evidence</th><th scope="col">Source</th></tr></thead>
                    <tbody>
                        @foreach (var stage in ActiveCdcPresentation.Stages(run))
                        {
                            <tr data-testid="act-stage" data-kind="@stage.Kind" data-state="@stage.State">
                                <th scope="row">@stage.Label</th>
                                <td><span class="act-pill act-pill-@stage.Tone">@stage.State</span></td>
                                <td>@stage.Detail</td>
                                <td class="act-muted">@stage.Source</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (run.Messages.Count > 0)
            {
                <div class="act-table" tabindex="0" role="region" aria-label="Messages sent" data-testid="act-messages">
                    <table>
                        <thead><tr><th scope="col">Message</th><th scope="col">Synthetic PersonPK</th><th scope="col">Send</th><th scope="col">Partition (post-send position)</th><th scope="col">Consumer checkpoint</th><th scope="col">Payload</th></tr></thead>
                        <tbody>
                            @foreach (var m in run.Messages)
                            {
                                <tr data-testid="act-message" data-label="@m.Label" data-send="@m.SendState">
                                    <th scope="row">@m.Label <span class="act-muted">@m.Role</span>@if (m.InvalidCondition.Length > 0) { <span class="act-muted" data-testid="act-invalid-condition"> — @m.InvalidCondition</span> }</th>
                                    <td class="act-mono">@ActiveCdcPresentation.PersonPk(m)</td>
                                    <td><span class="act-pill act-pill-@ActiveCdcPresentation.Tone(m.SendState)">@ActiveCdcLabels.State(m.SendState)</span></td>
                                    <td>@(m.AdvancedPartitions.Count == 0 ? "Not located" : string.Join(", ", m.AdvancedPartitions.Select(a => $"{a.Key} → {a.Value}")))</td>
                                    <td><span class="act-pill act-pill-@ActiveCdcPresentation.Tone(m.CheckpointState)">@ActiveCdcLabels.State(m.CheckpointState)</span></td>
                                    <td class="act-muted">@m.PayloadBytes bytes · <span class="act-mono">@(m.PayloadSha256.Length >= 12 ? m.PayloadSha256[..12] : m.PayloadSha256)…</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (run.CheckpointSnapshots.Count > 0)
                {
                    <details class="act-details" data-testid="act-snapshots"><summary>Partition / checkpoint snapshots (@run.CheckpointSnapshots.Count)</summary>
                        <ul>@foreach (var c in run.CheckpointSnapshots) { <li data-testid="act-snapshot"><strong>@c.Label</strong> — @ActiveCdcLabels.State(c.State): @(c.Partitions.Count == 0 ? c.Detail : string.Join("; ", c.Partitions.Select(p => $"partition {p.PartitionId}: last enqueued {p.LastEnqueued?.ToString() ?? "unknown"}, checkpoint {p.Checkpointed?.ToString() ?? "unknown"}")))</li> }</ul>
                        <p class="act-muted">Positions are compared per partition only; a checkpoint shows the adapter finished a flush, not what it stored.</p>
                    </details>
                }
                <div class="act-coverage" data-testid="act-coverage">
                    <p><strong>Developer coverage</strong> (discovered in the bound source, not executed): @ActiveCdcPresentation.DeveloperCoverage(run)</p>
                    <p><strong>Active CDC coverage</strong>: @ActiveCdcPresentation.ActiveCoverage(run)</p>
                    @if (run.Scenario.InvalidFixture.Length > 0) { <p data-testid="act-invalid-fixture"><strong>Invalid fixture</strong>: @run.Scenario.InvalidFixture — table Person, operation create; @run.Scenario.InvalidCondition Review: @(run.Manifest.InvalidFixtureStatus.Length > 0 ? run.Manifest.InvalidFixtureStatus : "not recorded").</p> }
                </div>
            }
            @if (run.Messages.Count == 0 && run.Fixture is { } fixture)
            {
                <dl class="act-facts" data-testid="act-fixture">
                    <div><dt>Synthetic PersonPK</dt><dd class="act-mono">@fixture.SyntheticPersonPk</dd></div>
                    <div><dt>Expected PersonId</dt><dd class="act-mono">@fixture.ExpectedPersonId</dd></div>
                    <div><dt>Marker</dt><dd class="act-mono">@fixture.Marker</dd></div>
                    <div><dt>Payload</dt><dd>@fixture.PayloadBytes bytes · SHA-256 <span class="act-mono">@fixture.PayloadSha256[..16]…</span> (not stored)</dd></div>
                </dl>
            }
            @if (run.Completed)
            {
                <details class="act-details" data-testid="act-tested"><summary>What was tested (@run.WhatWasTested.Count)</summary><ul>@foreach (var t in run.WhatWasTested) { <li>@t</li> }</ul></details>
                <details class="act-details" open data-testid="act-not-assessed"><summary>What was not assessed (@run.WhatWasNotAssessed.Count)</summary><ul>@foreach (var t in run.WhatWasNotAssessed) { <li>@t</li> }</ul></details>
                @if (run.Limitations.Count > 0) { <details class="act-details" data-testid="act-limitations"><summary>Limitations (@run.Limitations.Count)</summary><ul>@foreach (var t in run.Limitations) { <li>@t</li> }</ul></details> }
                <div class="act-actions">
                    <button type="button" class="btn-secondary" data-testid="act-export" @onclick="ExportAsync">Export HTML</button>
                </div>
            }
        </section>
    }

    @if (_history.Count > 0)
    {
        <details class="act-details" data-testid="act-history"><summary>Previous active runs (@_history.Count)</summary>
            <p class="act-muted">Stored runs are immutable; a later source upload or configuration change never re-renders them.</p>
            <ul class="act-history">
                @foreach (var item in _history)
                {
                    <li data-testid="act-history-item"><button type="button" class="act-link" @onclick="() => OpenAsync(item.RunId)">@item.StartedAt.ToString("yyyy-MM-dd HH:mm") UTC</button> — @ScenarioName(item.ScenarioId) · @ActiveCdcLabels.Status(item.Status) · @(item.SendAttempted ? ScenarioOptions.FirstOrDefault(s => s.Id == item.ScenarioId)?.EventCount > 1 ? "events sent" : "event sent" : "nothing sent")@if (item.ManifestFingerprint.Length > 0) { <span class="act-muted"> · manifest @item.ManifestFingerprint</span> }</li>
                }
            </ul>
        </details>
    }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public FrontendAnalysisProfile Profile { get; set; } = default!;
    [Parameter] public IReadOnlyList<IntegrationDefinition> Integrations { get; set; } = [];
    /// <summary>Show a compact model-derived summary first and keep the full runner collapsed until opened (presentation only).</summary>
    [Parameter] public bool SummaryFirst { get; set; }
    private bool _open;
    private readonly string _runnerId = "act-runner-" + Guid.NewGuid().ToString("N")[..8];
    private string SummaryExecution => Candidates.Count == 0 ? "No CDC integration"
        : _readiness is null ? (_loading ? "Checking readiness…" : "Not checked")
        : _readiness.CanRun ? "Ready" : "Blocked";
    /// <summary>The IQR source selections: a snapshot chosen there for this integration is the one the fixture is bound to (else the latest).</summary>
    [Parameter] public IReadOnlyList<IqrSourceSelection> Selections { get; set; } = [];
    /// <summary>Poll interval while a run is in flight (tests shorten it).</summary>
    [Parameter] public TimeSpan PollInterval { get; set; } = TimeSpan.FromSeconds(2);

    // Optional: hosts that do not register the client (older page tests) simply show no Active tests panel.
    private IActiveCdcTestsApiService? Api => _api ??= Services.GetService<IActiveCdcTestsApiService>();
    private IActiveCdcTestsApiService? _api;
    private sealed record ScenarioOption(string Id, string Name, string Category, string ExtensionId, string TransportType, int EventCount);
    private IReadOnlyList<ActiveEventScenarioDescriptor> _scenarioDescriptors = [];
    private ScenarioOption[] ScenarioOptions => _scenarioDescriptors.Select(s => new ScenarioOption(s.ScenarioId, s.DisplayName, s.Category, s.ExtensionId, s.RequiredTransportType, s.ExpectedEventCount)).ToArray();
    private string _scenarioId = "";
    private string Category => ScenarioOptions.FirstOrDefault(o => o.Id == _scenarioId)?.Category ?? "";
    private string ScenarioName(string id) => ScenarioOptions.FirstOrDefault(o => o.Id == id)?.Name ?? id;

    private async Task SelectScenarioAsync(string id)
    {
        _scenarioId = id;
        _run = null;
        _confirming = false;
        await LoadAsync();
    }

    private readonly CancellationTokenSource _disposed = new();
    private string _integrationId = "";
    private ActiveCdcReadiness? _readiness;
    private ActiveCdcRun? _run;
    private IReadOnlyList<ActiveCdcRunSummary> _history = [];
    private bool _loading, _starting, _cancelling, _confirming, _acknowledged;
    private string? _error;
    private string? _loadedFor;

    private IReadOnlyList<IntegrationDefinition> RawCandidates => Integrations.Where(i => i is { Enabled: true, Kind: IntegrationKind.EventHub }).ToList();
    private Dictionary<string, IReadOnlyList<ActiveEventScenarioDescriptor>> _scenarioCache = new(StringComparer.Ordinal);
    private bool _scenarioCacheReady;
    private IReadOnlyList<IntegrationDefinition> Candidates => _scenarioCacheReady
        ? RawCandidates.Where(integration => _scenarioCache.TryGetValue(integration.Id, out var descriptors) && descriptors is { Count: > 0 }).ToList()
        : RawCandidates;
    private ActiveCdcScenario Shown => _readiness?.Scenario is { Id.Length: > 0 } s && s.Id == _scenarioId ? s
        : _scenarioDescriptors.FirstOrDefault(s => s.ScenarioId == _scenarioId) is { } descriptor
            ? new ActiveCdcScenario { Id = descriptor.ScenarioId, Version = descriptor.ScenarioVersion, Name = descriptor.DisplayName, Description = descriptor.Description,
                Category = descriptor.Category, MessageCount = descriptor.ExpectedEventCount }
            : new ActiveCdcScenario();
    private bool IsInvalidScenario => _scenarioDescriptors.FirstOrDefault(s => s.ScenarioId == _scenarioId)?.ReplayKind == ActiveEventReplayKind.ControlAfterInvalid;
    private bool Busy => _loading || _starting || _run is { Completed: false };

    protected override async Task OnParametersSetAsync()
    {
        if (Api is null || RawCandidates.Count == 0) return;
        try
        {
            var scenarios = new Dictionary<string, IReadOnlyList<ActiveEventScenarioDescriptor>>(StringComparer.Ordinal);
            foreach (var integration in RawCandidates)
                scenarios[integration.Id] = await Api.ScenariosAsync(Profile, integration.Id, _disposed.Token) ?? [];
            _scenarioCache = scenarios;
            _scenarioCacheReady = true;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _error = BackendRequestClassifier.FromException("Active event scenarios", ex).UserMessage;
            _scenarioCacheReady = true;
            _scenarioDescriptors = [];
            return;
        }
        if (Candidates.Count == 0) return;
        if (!Candidates.Any(c => c.Id == _integrationId)) _integrationId = Candidates[0].Id;
        var key = $"{Profile.Id}|{_integrationId}|{SnapshotId}|{_scenarioId}";
        if (key != _loadedFor) await LoadAsync();
    }

    private Guid? SnapshotId => Selections.FirstOrDefault(s => s.IntegrationId == _integrationId)?.SnapshotId;

    private async Task SelectIntegrationAsync(ChangeEventArgs e)
    {
        _integrationId = e.Value?.ToString() ?? "";
        _run = null;
        _confirming = false;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var key = $"{Profile.Id}|{_integrationId}|{SnapshotId}|{_scenarioId}";
        _loadedFor = key;
        _loading = true;
        _error = null;
        try
        {
            var descriptors = _scenarioCache.GetValueOrDefault(_integrationId, []);
            if (key != _loadedFor) return;
            _scenarioDescriptors = descriptors;
            if (!_scenarioDescriptors.Any(s => s.ScenarioId == _scenarioId)) _scenarioId = _scenarioDescriptors.FirstOrDefault()?.ScenarioId ?? "";
            if (_scenarioId.Length == 0)
            {
                _readiness = null;
                _history = await Api.HistoryAsync(Profile.Id, _integrationId, _disposed.Token);
                return;
            }
            var readiness = await Api.ReadinessAsync(Profile, _integrationId, SnapshotId, _scenarioId, _disposed.Token);
            var history = await Api!.HistoryAsync(Profile.Id, _integrationId, _disposed.Token);
            // The scenario can change while this load is in flight: an answer for a previous selection is dropped, never shown.
            if (key != _loadedFor) return;
            (_readiness, _history) = (readiness, history);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            if (!_disposed.IsCancellationRequested && key == _loadedFor) _error = BackendRequestClassifier.FromException("Active test readiness", ex).UserMessage;
        }
        finally { if (key == _loadedFor) _loading = false; }
    }

    private async Task StartAsync()
    {
        if (_readiness is null || !_acknowledged) return;
        _starting = true;
        _error = null;
        try
        {
            var (run, error) = await Api!.StartAsync(Profile, new ActiveCdcRunRequest
            {
                EnvironmentId = Profile.Id, EnvironmentName = Profile.Name, IntegrationId = _integrationId, ScenarioId = _scenarioId,
                SourceSnapshotId = _readiness.Manifest.SourceSnapshotId, ConfirmedSend = true, ConfirmedEventHub = _readiness.Destination.EventHub,
            }, _disposed.Token);
            _confirming = false;
            if (error is not null) { _error = error; return; }
            _run = run;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            // The request may have reached the backend: say so rather than implying nothing happened.
            if (!_disposed.IsCancellationRequested) _error = $"{BackendRequestClassifier.FromException("Starting the active test", ex).UserMessage} Check the history below before starting again — the run may have started.";
        }
        finally { _starting = false; }
        if (_run is { Completed: false }) await PollAsync(_run.RunId);
        else await RefreshAsync();
    }

    private async Task PollAsync(Guid runId)
    {
        while (!_disposed.IsCancellationRequested && _run is { Completed: false } && _run.RunId == runId)
        {
            try
            {
                await Task.Delay(PollInterval, _disposed.Token);
                if (await Api!.GetAsync(runId, _disposed.Token) is { } latest) _run = latest;
            }
            catch (TaskCanceledException) { return; }
            catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
            {
                _error = $"Live progress is unavailable: {BackendRequestClassifier.FromException("Run progress", ex).Detail} The run continues in the backend; open it from the history.";
                return;
            }
            StateHasChanged();
        }
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        _cancelling = false;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task CancelAsync()
    {
        if (_run is null) return;
        _cancelling = true;
        try { if (!await Api!.CancelAsync(_run.RunId, _disposed.Token)) _error = "The run is no longer in flight."; }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException) { _error = BackendRequestClassifier.FromException("Requesting cancellation", ex).UserMessage; }
    }

    private async Task OpenAsync(Guid runId)
    {
        try { _run = await Api!.GetAsync(runId, _disposed.Token); }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { _error = "The run could not be loaded."; }
        if (_run is { Completed: false }) await PollAsync(_run.RunId);
    }

    private async Task ExportAsync()
    {
        if (_run is null) return;
        var html = ExportService.ExportActiveCdcRun(_run, Workspace.ProjectName);
        await JS.InvokeVoidAsync("downloadHtmlFile", $"active-cdc-test-{_run.StartedAt:yyyy-MM-dd}-{_run.RunId.ToString("N")[..8]}.html", html);
    }

    public void Dispose()
    {
        _disposed.Cancel();
        _disposed.Dispose();
    }
}
