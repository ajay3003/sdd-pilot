@using BirkNext.Integrations
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IServiceProvider Services
@inject NavigationManager Navigation

@* Altinn TT02 submission setup for one environment: the app contract (uploaded app files or public TT02 metadata, never guessed) and the
   readiness of unattended reporter authentication (approved synthetic TestID reporters, authenticated by the backend). The tester's own
   interactive TestID sign-in is an optional fallback. Running the submission is done by the shared Integration Journey panel; this component
   only prepares it. No token, secret or identifier is ever shown or kept here. *@
@if (Api is null) { return; }
<section class="atp" aria-labelledby="atp-heading" data-testid="atp-panel">
    <h3 id="atp-heading">Altinn TT02 submission</h3>
    <p class="atp-semantics" data-testid="atp-semantics">An Altinn submission is only the first part of Rapportmottak. <strong>Altinn submitted</strong> does not mean MU received it;
        MU received does not mean MM processed it; MM processed does not mean Skolenærværsrapport stored it; and none of these means Bufdata received anything.</p>
    @if (_signInOutcome is { } outcome)
    {
        <p class="atp-status" role="status" data-testid="atp-sign-in-outcome">@(outcome == "complete" ? "ID-porten TEST sign-in completed." : "ID-porten TEST sign-in did not complete. Start it again.")</p>
    }
    @if (_error is { } error) { <p class="atp-error" role="alert" data-testid="atp-error">@error</p> }

    <h4 class="atp-subheading">1. App contract</h4>
    @if (_contract is { } contract)
    {
        @if (contract.Changes is { } changes)
        {
            <div class="atp-change" data-testid="atp-contract-changed" data-impact="@changes.Impact">
                <p><strong>Deployed Altinn contract changed since last confirmation.</strong> Real execution is blocked until the changes are reviewed.</p>
                <details data-testid="atp-change-review">
                    <summary>Review changes (@changes.Changes.Count)</summary>
                    <div class="atp-table" tabindex="0" role="region" aria-label="Contract changes" data-testid="atp-changes">
                        <table>
                            <thead><tr><th scope="col">Change</th><th scope="col">Before</th><th scope="col">After</th><th scope="col">Impact</th></tr></thead>
                            <tbody>
                                @foreach (var change in changes.Changes)
                                {
                                    <tr data-testid="atp-change" data-impact="@change.Impact"><th scope="row">@change.Area</th><td class="atp-mono">@change.Before</td><td class="atp-mono">@change.After</td>
                                        <td><span class="atp-pill atp-pill-@(change.Impact is AltinnContractChangeImpact.Compatible ? "neutral" : "attention")">@ImpactLabel(change.Impact)</span> <span class="atp-muted">@change.Detail</span></td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="atp-muted" data-testid="atp-changes-detail">@contract.ChangesDetail</p>
                    <div class="atp-actions">
                        <button type="button" class="btn-secondary" data-testid="atp-accept-changes" disabled="@(_busy || !contract.ChangesAcceptable)" @onclick="AcceptChangesAsync">Accept reviewed changes</button>
                    </div>
                </details>
            </div>
        }
        @if (contract.ConfiguredAppId is not null)
        {
            <p data-testid="atp-app"><span class="atp-pill atp-pill-@(contract.AppApproved ? "ready" : "neutral")">@(contract.AppApproved ? "Approved app" : "App not ready")</span>
                <span class="atp-mono">@contract.ConfiguredAppId</span> <span class="atp-muted">@contract.AppDetail</span></p>
        }
        @if (DefaultsPending(contract))
        {
            <p data-testid="atp-defaults">
                @if (contract.ConfiguredEnvironment == ExternalTestEnvironment.Unknown) { <span data-testid="atp-default-environment">Environment <strong>Test</strong></span> }
                @if (contract.ConfiguredAppId is null) { <span data-testid="atp-default-app">App <span class="atp-mono">@SkoleNaervaerAltinnDefaults.AppIdentifier</span></span> }
                <span class="atp-muted">Default for Skolenærvær; saved to Integration Quality Review when you read the public TT02 metadata.</span></p>
        }
        <fieldset class="atp-source" data-testid="atp-source">
            <legend>Contract source</legend>
            <label class="atp-option"><input type="radio" name="@($"{_id}-source")" checked="@(_source == "source")" data-testid="atp-source-analysis" @onchange="@(() => _source = "source")" />
                <span>The Altinn app's source in Source Analysis (authoritative): applicationmetadata.json, the form model's *.schema.json and, optionally, process.bpmn from the uploaded app repository</span></label>
            <label class="atp-option"><input type="radio" name="@($"{_id}-source")" checked="@(_source == "public")" data-testid="atp-source-public" @onchange="@(() => _source = "public")" />
                <span>Public TT02 metadata of the configured app (read-only): its metadata, the form's schema and its deployed OpenAPI contract, which can establish the process operation without process.bpmn</span></label>
        </fieldset>
        @if (_source == "source")
        {
            @if (contract.SourceCandidates.Count == 0)
            {
                <p class="atp-muted" data-testid="atp-no-source">No Source Analysis snapshot of this environment contains the source of @(contract.ConfiguredAppId ?? "the configured app").
                    <a href="/source-analysis">Upload the Altinn app repository in Source Analysis</a>, then come back here.</p>
            }
            else
            {
                <label for="@($"{_id}-snapshot")">Source Analysis snapshot</label>
                <select id="@($"{_id}-snapshot")" data-testid="atp-snapshot" value="@_snapshotId" @onchange="e => _snapshotId = e.Value?.ToString() ?? string.Empty" disabled="@_busy">
                    @foreach (var candidate in contract.SourceCandidates) { <option value="@candidate.SnapshotId">@candidate.ArchiveName · @($"{candidate.AnalyzedAt:yyyy-MM-dd HH:mm}") UTC</option> }
                </select>
                <div class="atp-actions">
                    <button type="button" class="btn-secondary" data-testid="atp-use-source" disabled="@_busy" @onclick="UseSourceAsync">Use this app source</button>
                </div>
            }
            <p class="atp-muted">Source Analysis owns uploaded source; only the app's contract facts and a fingerprint are kept here. Nothing is sent to Altinn.</p>
        }
        else
        {
            <div class="atp-actions">
                <button type="button" class="btn-secondary" data-testid="atp-read-public" disabled="@(_busy || !(contract.AppApproved || DefaultsPending(contract)))" @onclick="ReadPublicAsync">Read public TT02 metadata</button>
            </div>
            <p class="atp-muted">Read-only, anonymous GETs: application metadata, the form's JSON schema, the app's deployed OpenAPI document and its authorization policy (hash only).
                Nothing is submitted and nobody signs in.</p>
            <div class="atp-import">
                <label for="@($"{_id}-import")">Import an OpenAPI document (offline analysis, optional)</label>
                <InputFile id="@($"{_id}-import")" accept=".json,application/json" data-testid="atp-import-openapi" disabled="@_busy" OnChange="ImportAsync" />
                <p class="atp-muted">An imported document is compared with the live contract. It is never live-verified and never used to run.</p>
            </div>
        }
        <p data-testid="atp-freshness" data-freshness="@contract.Freshness"><span class="atp-pill atp-pill-@(contract.Freshness == AltinnContractFreshness.Current ? "ready" : contract.Freshness == AltinnContractFreshness.NotRead ? "neutral" : "attention")">Deployed contract: @FreshnessLabel(contract.Freshness)</span>
            <span class="atp-muted">@contract.FreshnessDetail@(contract.Sources.FirstOrDefault(item => item.Source == AltinnContractSourceKind.PublicTt02Metadata) is { } live ? $" · fingerprint {live.Fingerprint[..Math.Min(12, live.Fingerprint.Length)]}…" : "")@(contract.Confirmed is { } confirmed ? $" · confirmed {confirmed.ConfirmedAt.UtcDateTime:yyyy-MM-dd HH:mm} UTC ({confirmed.Basis})" : "")</span></p>
        @if (contract.ImportedOpenApi is { } imported)
        {
            <p data-testid="atp-imported" class="atp-note" role="note">Source: <strong>Imported OpenAPI</strong> · Status: <strong>Not live-verified</strong>
                · app-lib @(imported.DeployedProcess?.AppLibVersion ?? "unknown") · @(contract.ImportedComparedToLive is { } compared
                    ? compared.Impact == AltinnContractChangeImpact.NoChange ? "matches the live deployed contract" : $"differs from the live deployed contract: {string.Join("; ", compared.Changes.Take(4).Select(change => $"{change.Area} {change.Before} → {change.After}"))}"
                    : "no live contract to compare with")</p>
        }

        <div class="atp-table" tabindex="0" role="region" aria-label="App contract parts" data-testid="atp-parts">
            <table>
                <thead><tr><th scope="col">Part</th><th scope="col">Status</th><th scope="col">Source</th><th scope="col">Detail</th></tr></thead>
                <tbody>
                    @foreach (var part in contract.Parts)
                    {
                        <tr data-testid="atp-part" data-part="@part.Part" data-present="@(part.Present ? "true" : "false")">
                            <th scope="row">@PartLabel(part.Part)</th>
                            <td><span class="atp-pill atp-pill-@(part.Present ? "ready" : "attention")">@(part.Part == AltinnContractPartKind.ProcessDefinition ? ProcessStatus(contract.Process.Status) : part.Present ? "Present" : "Missing")</span></td>
                            <td>@(part.Source switch
                                {
                                    AltinnContractSourceKind.SourceAnalysisSnapshot => "App source (Source Analysis)",
                                    AltinnContractSourceKind.PublicTt02Metadata => "Public TT02 metadata",
                                    AltinnContractSourceKind.DeployedOpenApi => "TT02 deployed OpenAPI contract",
                                    _ => "—",
                                })</td>
                            <td>@part.Detail</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <section class="atp-process" aria-labelledby="@($"{_id}-process")" data-testid="atp-process" data-status="@contract.Process.Status">
            <h5 class="atp-minor" id="@($"{_id}-process")">Process contract for the intended operation</h5>
            <dl class="atp-facts">
                <div><dt>Current operation contract</dt><dd data-testid="atp-process-status"><span class="atp-pill atp-pill-@(contract.Process.Confirmed ? "ready" : "attention")">@ProcessStatus(contract.Process.Status)</span></dd></div>
                <div><dt>Process definition source</dt><dd data-testid="atp-process-source">@(contract.Process.Sources.Count > 0 ? string.Join(" + ", contract.Process.Sources) : "None")</dd></div>
                @if (contract.Process.DeclaredTaskCount is { } declared)
                {
                    <div><dt>Declared process tasks</dt><dd>@declared</dd></div>
                }
                <div><dt>Current task</dt><dd data-testid="atp-process-task">@(contract.Process.PlannedTasks.Count > 0 ? string.Join(" → ", contract.Process.PlannedTasks.Select(task => string.Join(" · ", new[] { task.TaskId, task.Name, task.TaskType }.Where(part => part.Length > 0)))) : "Not established")</dd></div>
                <div><dt>Transition policy</dt><dd data-testid="atp-process-bound">@(contract.Process.MaxTransitions == 1 ? "One bounded process/next (no action body)" : $"At most {contract.Process.MaxTransitions} bounded process/next calls (no action body)")</dd></div>
                <div><dt>Expected post-condition</dt><dd>Process ended (ended and end event set, no current task); anything else stops the run</dd></div>
                <div><dt>process.bpmn</dt><dd data-testid="atp-process-bpmn">@(string.IsNullOrEmpty(contract.Process.StaticDefinition) ? "Not provided · Optional" : contract.Process.StaticDefinition)</dd></div>
            </dl>
            <p class="atp-muted" data-testid="atp-process-topology">@(contract.Process.TopologyKnown
                ? "The full BPMN topology is known from process.bpmn."
                : "BirkNext does not know the full BPMN topology (gateways, events). It only needs to know enough for this one operation, and it checks the live instance's task before the transition.")</p>
            @if (!contract.Process.Confirmed && contract.Process.Reasons.Count > 0)
            {
                <ul class="atp-list atp-missing" data-testid="atp-process-reasons" aria-label="Why the process operation is not confirmed">@foreach (var reason in contract.Process.Reasons) { <li>@reason</li> }</ul>
            }
        </section>
        @if (contract.Bindings.Count > 0)
        {
            <h5 class="atp-minor">Form fields BirkNext fills</h5>
            <ul class="atp-list" data-testid="atp-bindings">
                @foreach (var binding in contract.Bindings)
                {
                    <li data-present="@(binding.Present ? "true" : "false")"><span class="atp-pill atp-pill-@(binding.Present ? "ready" : "attention")">@(binding.Present ? "Verified" : "Not verified")</span>
                        @binding.Label <span class="atp-mono">@binding.ExpectedPath</span> <span class="atp-muted">@binding.Detail</span></li>
                }
            </ul>
        }
        @if (contract.RequiredUnboundFields.Count > 0)
        {
            <p class="atp-note" role="note" data-testid="atp-required-unbound">The app's schema requires @contract.RequiredUnboundFields.Count field(s) BirkNext does not fill
                (@string.Join(", ", contract.RequiredUnboundFields.Take(8).Select(field => field.Path))@(contract.RequiredUnboundFields.Count > 8 ? ", …" : "")).
                Altinn's own validation step will show whether the app fills them.</p>
        }
        <p data-testid="atp-contract-state"><span class="atp-pill atp-pill-@(contract.Complete ? "ready" : "attention")">@(contract.Complete ? "Contract complete" : "Contract incomplete")</span></p>
        @if (!contract.Complete)
        {
            <ul class="atp-list atp-missing" data-testid="atp-missing" aria-label="Missing contract information">@foreach (var item in contract.Missing) { <li>@item</li> }</ul>
        }
    }
    else if (_loading) { <p class="atp-muted" role="status">Loading the app contract…</p> }

    @if (_configuration is { } configuration)
    {
        <h4 class="atp-subheading">Configuration and sources</h4>
        <p class="atp-muted">Configured values, values discovered from the deployed app, confirmed policy evidence and run input — each with its source. Current values are current evidence, not permanent facts.</p>
        <div class="atp-table" tabindex="0" role="region" aria-label="Configuration and sources" data-testid="atp-configuration">
            <table class="atp-config">
                <thead><tr><th scope="col">Setting</th><th scope="col">Value</th><th scope="col">State</th><th scope="col">Source</th></tr></thead>
                <tbody>
                    @foreach (var item in configuration.Items)
                    {
                        <tr data-testid="atp-config-item" data-key="@item.Key" data-state="@item.State">
                            <th scope="row">@item.Label</th><td class="atp-mono">@(item.Value ?? "—")</td>
                            <td><span class="atp-pill atp-pill-@ConfigTone(item.State)">@item.State</span></td>
                            <td>@item.Source<span class="atp-muted atp-block">@item.Detail</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <ul class="atp-list" data-testid="atp-reporters" aria-label="Configured synthetic reporters">
            @if (configuration.Reporters.Count == 0) { <li class="atp-muted">No synthetic reporter is configured (backend AltinnTesting:UnattendedIdPortenTest:Reporters).</li> }
            @foreach (var reporter in configuration.Reporters)
            {
                <li data-testid="atp-reporter" data-alias="@reporter.Alias">
                    <strong>@reporter.Label</strong> <span class="atp-muted">(@reporter.Alias)</span>
                    · Identifier <span class="atp-pill atp-pill-@(reporter.IdentifierConfigured ? "ready" : "attention")" data-testid="atp-reporter-identifier">@(reporter.IdentifierConfigured ? "Configured" : "Missing")</span>
                    · TT02 profile <span class="atp-pill atp-pill-@(reporter.ProfileConfirmed ? "ready" : "attention")" data-testid="atp-reporter-profile">@(reporter.ProfileConfirmed ? "Confirmed" : "Not confirmed")</span>
                    · Role @reporter.Role · <span class="atp-muted">Source: local backend configuration</span>
                    @if (reporter.Problem is { } problem) { <span class="atp-muted atp-block" data-testid="atp-reporter-problem">@problem</span> }
                </li>
            }
        </ul>
    }

    <h4 class="atp-subheading">2. Reporter authentication (unattended)</h4>
    <p class="atp-muted" data-testid="atp-unattended-intro">No sign-in step: when a run starts, the backend authenticates the selected approved synthetic TestID reporter with
        ID-porten TEST and exchanges the result for an Altinn TT02 token. No browser opens and no token is shown. The reporter is the Altinn actor;
        the child in the report is separate.</p>
    @if (_readiness.Count > 0)
    {
        <ul class="atp-list atp-readiness" data-testid="atp-unattended-readiness" aria-label="Unattended run readiness">
            <li data-testid="atp-readiness-item" data-key="local-execution" data-state="@(CanExecute ? "Ready" : "NotReady")">
                <span class="atp-pill atp-pill-@(CanExecute ? "ready" : "attention")">@(CanExecute ? "Ready" : "Not ready")</span>
                <strong>Local execution</strong> <span class="atp-muted">@ExecutionGate.Detail(Authentication, _access)</span>
            </li>
            @foreach (var item in _readiness)
            {
                <li data-testid="atp-readiness-item" data-key="@item.Key" data-state="@item.State">
                    <span class="atp-pill atp-pill-@(item.State == JourneyReadinessState.Ready ? "ready" : "attention")">@ReadinessLabel(item)</span>
                    <strong>@item.Label</strong> <span class="atp-muted">@item.Detail</span>
                </li>
            }
            <li data-testid="atp-readiness-item" data-key="real-execution" data-state="@(RealExecutionReady ? "Ready" : "NotReady")">
                <span class="atp-pill atp-pill-@(RealExecutionReady ? "ready" : "attention")">@(RealExecutionReady ? "Ready" : "Not ready")</span>
                <strong>Real external execution (E2E-01)</strong>
                <span class="atp-muted">@(RealExecutionReady
                    ? "Every prerequisite is met. A run is a real call to ID-porten TEST and Altinn TT02: validate it first, then confirm it explicitly. One attempt; nothing is retried."
                    : "Not ready: resolve the items marked Not ready, Missing or Not confirmed. Scenario input is checked when you validate or run.")</span>
            </li>
        </ul>
    }
    else if (_readinessError is { } readinessError) { <p class="atp-muted" data-testid="atp-readiness-unavailable">@readinessError</p> }

    <details class="atp-fallback" data-testid="atp-interactive-fallback">
        <summary>Alternative: interactive TestID sign-in (fallback)</summary>
        <p class="atp-muted">Only needed when no synthetic reporter can be used unattended. You choose or enter the synthetic person in TestID yourself (BirkNext sends no
            identity hint). The resulting Altinn TT02 token stays in backend memory for your BirkNext session and this environment only. Choose
            "Interactive TestID sign-in" as the reporter when running.</p>
        @if (!CanExecute)
        {
            <p class="atp-muted" data-testid="atp-sign-in-unavailable">@ExecutionGate.Detail(Authentication, _access) The interactive fallback needs execution permission in BirkNext.</p>
        }
        else if (_signIn is { } status)
        {
            <p data-testid="atp-sign-in-state"><span class="atp-pill atp-pill-@(status.SignedIn ? "ready" : "neutral")">@(status.SignedIn ? "Signed in" : status.Configured ? "Not signed in" : "Not configured")</span>
                <span class="atp-muted">@status.Detail@(status.ExpiresAt is { } expires ? $" Expires {expires:HH:mm} UTC." : "")</span></p>
            @if (status.ConfigurationProblems.Count > 0)
            {
                <ul class="atp-list atp-missing" data-testid="atp-sign-in-problems" aria-label="Missing sign-in configuration">@foreach (var item in status.ConfigurationProblems) { <li>@item</li> }</ul>
            }
            <div class="atp-actions">
                @if (status.SignedIn)
                {
                    <button type="button" class="btn-secondary" data-testid="atp-sign-out" disabled="@_busy" @onclick="SignOutAsync">Sign out of ID-porten TEST</button>
                }
                else
                {
                    <button type="button" class="btn-secondary" data-testid="atp-sign-in" disabled="@(_busy || !status.Configured)" @onclick="SignInAsync">Sign in with TestID</button>
                }
            </div>
        }
    </details>

    <h4 class="atp-subheading">3. Altinn instance evidence (read-only)</h4>
    <p class="atp-muted" data-testid="atp-instance-evidence">Read one existing Altinn instance — process state and data-element metadata — from Altinn Storage. <strong>Read-only: no data is submitted or changed.</strong>
        The app's own instance endpoint is not used, because it marks the instance as read. An Altinn storage path is Altinn's own storage, not an MU blob, and an observed instance is not a verified submission.</p>
    @if (OnOpenJourney.HasDelegate)
    {
        <div class="atp-actions"><button type="button" class="btn-secondary" data-testid="atp-open-instance-evidence" @onclick="@(() => OnOpenJourney.InvokeAsync("instance-evidence"))">Check an Altinn instance</button></div>
    }

    <h4 class="atp-subheading">4. Run the test</h4>
    <p class="atp-muted">Choose a report scenario and reporter, enter the synthetic child, period and hours, and select Run journey in Integration journeys → Rapportmottak.
        Authentication, instance, data, validation, submission and receipt are recorded as separate steps; MU, MM and Skolenærværsrapport steps stay Not assessed.</p>
    @if (OnOpenJourney.HasDelegate)
    {
        <div class="atp-actions"><button type="button" class="btn-secondary" data-testid="atp-open-journey" @onclick="@(() => OnOpenJourney.InvokeAsync(null))">Open the Rapportmottak run</button></div>
    }
</section>

@code {
    [Parameter, EditorRequired] public string EnvironmentId { get; set; } = "";
    /// <summary>Opens Rapportmottak in the shared journey panel, optionally with a scenario selected.</summary>
    [Parameter] public EventCallback<string?> OnOpenJourney { get; set; }

    private readonly string _id = "atp-" + Guid.NewGuid().ToString("N")[..8];
    private IAltinnTestingApiService? _api;
    private ActiveEventAuthenticationState? _authentication;
    private AltinnAppContractView? _contract;
    private AltinnSignInStatus? _signIn;
    private AltinnConfigurationOverview? _configuration;
    private IReadOnlyList<JourneyPrerequisite> _readiness = [];
    private string? _readinessError;
    /// <summary>The Rapportmottak prerequisites this section explains, in the order a tester resolves them.</summary>
    private static readonly string[] ReadinessKeys = ["backend-build", "altinn-environment", "unattended-provider", "idporten-client", "redirect-uri", "client-secret", "synthetic-reporter",
        "reporter-role", "reporter-profile", "reporter-auth", "synthetic-data", TrustedIntegrationKey, "public-metadata", "submission-contract", "process-contract", "app-policy", "meldingshode"];
    /// <summary>The Altinn report-intake integration's own readiness row: configured in IQR and enrolled in the backend trusted environment.</summary>
    private const string TrustedIntegrationKey = "integration:report-intake";
    private bool _realScenarioRunnable;
    /// <summary>The backend's own verdict for the first real scenario (E2E-01) plus this browser's execution access; the backend re-checks on Run.</summary>
    private bool RealExecutionReady => _realScenarioRunnable && CanExecute;
    private string _source = "source";
    private string _snapshotId = "";
    private string? _error;
    private string? _signInOutcome;
    private string? _loadedFor;
    private bool _loading;
    private bool _busy;

    private IAltinnTestingApiService? Api => _api ??= Services.GetService<IAltinnTestingApiService>();
    private ActiveEventAuthenticationState Authentication => _authentication ??= Services.GetService<ActiveEventAuthenticationState>() ?? ActiveEventAuthenticationState.NotConfigured;
    private ExecutionAccessView? _access;
    /// <summary>Run is offered when the deployment signs users in (Entra) or the backend reports execution access (e.g. local trusted
    /// execution). Only a hint: the backend re-checks ActiveEventExecute on every execution request.</summary>
    private bool CanExecute => ExecutionGate.CanExecute(Authentication, _access);
    private async Task LoadAccessAsync()
    {
        if (_access is not null || Authentication.Configured || Services.GetService<IExecutionAccessApiService>() is not { } access) return;
        _access = await access.GetAsync();
    }


    protected override async Task OnParametersSetAsync()
    {
        if (Api is null || string.IsNullOrWhiteSpace(EnvironmentId) || _loadedFor == EnvironmentId) return;
        _loadedFor = EnvironmentId;
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        _signInOutcome = query.TryGetValue("altinn-sign-in", out var value) && value.ToString() is "complete" or "failed" ? value.ToString() : null;
        _loading = true;
        try
        {
            var contract = await Api.ContractAsync(EnvironmentId);
            _contract = contract.Value;
            _snapshotId = _contract?.SourceCandidates.FirstOrDefault()?.SnapshotId.ToString() ?? "";
            // Without an app source in Source Analysis, the public TT02 metadata is the only source: start there.
            if (_contract is { SourceCandidates.Count: 0 }) _source = "public";
            _error = contract.Error;
            await LoadAccessAsync();
            if (CanExecute)
            {
                var status = await Api.SignInStatusAsync(EnvironmentId);
                _signIn = status.Value;
                _error ??= status.Error;
            }
            await LoadReadinessAsync();
            await LoadConfigurationAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { _error = "The Altinn setup could not be loaded from the backend."; }
        finally { _loading = false; }
    }

    /// <summary>Unattended readiness comes from the shared journey readiness (one source of truth), not from a second Altinn status call.</summary>
    private async Task LoadReadinessAsync()
    {
        if (Services.GetService<IIntegrationJourneysApiService>() is not { } journeys) return;
        var packs = await journeys.PacksAsync(EnvironmentId);
        var view = packs.Value?.SelectMany(pack => pack.Journeys).FirstOrDefault(item => item.Journey.JourneyId == "rapportmottak");
        _readiness = view is null ? [] : ReadinessKeys.Select(key => view.Prerequisites.FirstOrDefault(item => item.Key == key)).OfType<JourneyPrerequisite>().ToArray();
        _readinessError = view is null ? packs.Error ?? "Rapportmottak readiness is not available." : null;
        _realScenarioRunnable = view?.RunnableScenarios.Contains("valid-report", StringComparer.Ordinal) == true;
    }

    private static string ReadinessLabel(JourneyPrerequisite item) => item.Key switch
    {
        "app-policy" => item.State == JourneyReadinessState.Ready ? "Confirmed" : "Not confirmed",
        "unattended-provider" => item.State == JourneyReadinessState.Ready ? "Enabled" : "Disabled",
        "reporter-role" => item.State == JourneyReadinessState.Ready ? "PRIV" : "Missing",
        "public-metadata" => item.State == JourneyReadinessState.Ready ? "Loaded" : "Missing",
        TrustedIntegrationKey => item.State == JourneyReadinessState.Ready ? "Configured" : item.State == JourneyReadinessState.NotConfigured ? "Missing" : "Not enrolled",
        "backend-build" => "Build",
        "reporter-profile" => item.State == JourneyReadinessState.Ready ? "Confirmed" : "Not confirmed",
        "process-contract" => item.State switch { JourneyReadinessState.Ready => "Confirmed", JourneyReadinessState.Partial => "Partial", _ => "Not confirmed" },
        "client-secret" => item.State == JourneyReadinessState.Ready ? "Available" : "Missing",
        "idporten-client" or "synthetic-reporter" or "redirect-uri" => item.State == JourneyReadinessState.Ready ? "Configured" : "Missing",
        "synthetic-data" => item.State == JourneyReadinessState.Ready ? "Declared" : "Missing",
        "meldingshode" => item.State == JourneyReadinessState.Ready ? "Filled" : "Risk",
        "altinn-environment" => item.State == JourneyReadinessState.Ready ? "Ready" : "Blocked",
        _ => item.State == JourneyReadinessState.Ready ? "Ready" : "Not ready",
    };

    /// <summary>Whether the IQR Altinn test configuration lacks the environment or app, so the Skolenærvær defaults apply when the metadata is
    /// read (an unreported environment counts as configured).</summary>
    private static bool DefaultsPending(AltinnAppContractView contract) =>
        contract.ConfiguredAppId is null || contract.ConfiguredEnvironment == ExternalTestEnvironment.Unknown;

    private async Task UseSourceAsync() => await RunAsync(async () =>
    {
        var result = await Api!.UseSourceAnalysisAsync(EnvironmentId, Guid.TryParse(_snapshotId, out var id) ? id : null);
        if (result.Value is { } contract) _contract = contract;
        _error = result.Error;
    });

    private async Task ReadPublicAsync() => await RunAsync(async () =>
    {
        var result = await Api!.ReadSkoleNaervaerPublicMetadataAsync(EnvironmentId);
        if (result.Value is { } contract) _contract = contract;
        _error = result.Error;
        await RefreshDerivedAsync();
    });

    private async Task AcceptChangesAsync() => await RunAsync(async () =>
    {
        var result = await Api!.AcceptContractChangesAsync(EnvironmentId);
        if (result.Value is { } contract) _contract = contract;
        _error = result.Error;
        await RefreshDerivedAsync();
    });

    private const long MaxImportBytes = 2 * 1024 * 1024;

    private async Task ImportAsync(InputFileChangeEventArgs e) => await RunAsync(async () =>
    {
        if (e.File.Size > MaxImportBytes) { _error = "The OpenAPI document exceeds the 2 MB limit."; return; }
        using var reader = new StreamReader(e.File.OpenReadStream(MaxImportBytes));
        var result = await Api!.ImportOpenApiAsync(EnvironmentId, await reader.ReadToEndAsync());
        if (result.Value is { } contract) _contract = contract;
        _error = result.Error;
        await RefreshDerivedAsync();
    });

    /// <summary>Readiness and the configuration overview depend on the contract: reload both after it changes.</summary>
    private async Task RefreshDerivedAsync()
    {
        await LoadReadinessAsync();
        await LoadConfigurationAsync();
    }

    private async Task LoadConfigurationAsync()
    {
        var result = await Api!.ConfigurationAsync(EnvironmentId);
        _configuration = result.Value;
    }

    private static string ImpactLabel(AltinnContractChangeImpact impact) => impact switch
    {
        AltinnContractChangeImpact.Blocking => "Blocks run",
        AltinnContractChangeImpact.NeedsReview => "Needs review",
        AltinnContractChangeImpact.Compatible => "Informational",
        _ => "No change",
    };

    private static string FreshnessLabel(AltinnContractFreshness freshness) => freshness switch
    {
        AltinnContractFreshness.Current => "Current",
        AltinnContractFreshness.RefreshRecommended => "Refresh recommended",
        AltinnContractFreshness.Changed => "Changed",
        _ => "Not read",
    };

    private static string ConfigTone(string state) => state switch
    {
        "Approved" or "TT02" or "Derived" or "Discovered" or "Resolved" or "Current" or "Confirmed" or "Confirmed for current operation" or "Configured" or "Available" or "Declared" => "ready",
        _ when state.EndsWith(" configured", StringComparison.Ordinal) => "ready",
        "Not live-verified" => "neutral",
        _ => "attention",
    };

    private async Task SignInAsync() => await RunAsync(async () =>
    {
        var result = await Api!.StartSignInAsync(EnvironmentId);
        _error = result.Error;
        // Only an ID-porten TEST address built by the backend is followed; anything else is refused here as well.
        if (result.Value is { } start && Uri.TryCreate(start.AuthorizationUrl, UriKind.Absolute, out var url) && url.Scheme == Uri.UriSchemeHttps && url.Host == "login.test.idporten.no")
            Navigation.NavigateTo(url.ToString(), forceLoad: true);
        else if (result.Value is not null) _error = "The sign-in address was not an ID-porten TEST address and was not opened.";
    });

    private async Task SignOutAsync() => await RunAsync(async () =>
    {
        var result = await Api!.SignOutAsync(EnvironmentId);
        _error = result.Error;
        _signIn = (await Api.SignInStatusAsync(EnvironmentId)).Value ?? _signIn;
    });

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try { await action(); }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException or IOException) { _error = "The backend could not complete the request."; }
        finally { _busy = false; }
    }

    private static string PartLabel(AltinnContractPartKind part) => part switch
    {
        AltinnContractPartKind.ApplicationMetadata => "Application metadata",
        AltinnContractPartKind.FormDataType => "Form data type",
        AltinnContractPartKind.DataModelSchema => "Data model schema",
        _ => "Process contract (current operation)",
    };

    private static string ProcessStatus(AltinnProcessContractStatus status) => status switch
    {
        AltinnProcessContractStatus.ConfirmedForCurrentOperation => "Confirmed for current operation",
        AltinnProcessContractStatus.Partial => "Partial",
        AltinnProcessContractStatus.Conflict => "Conflict",
        _ => "Not confirmed",
    };
