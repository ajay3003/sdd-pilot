@using BirkNext.LocalHttpsProxy
@using BirkNext.Web.Models
@using BirkNext.Web.Services
@using BirkNext.Web.Shared.Components.Common

@*
    The Authentication pane, in the order a reader needs it: the verdict, the prerequisites behind it, the three cards
    that answer configuration / verification / testing context, the Endpoint Discovery hand-off, and then the two
    disclosures nobody needs until something is wrong.

    Every state here comes from one derived AuthenticationPaneState. No card works out its own answer, which is how the
    page used to end up saying "No authentication is configured" directly above "Matches saved configuration".
*@
<section class="ar" data-testid="auth-readiness" aria-label="Authentication readiness">

    <div class="ar-hero ar-tone-@Summary.Tone" data-testid="auth-readiness-hero">
        <div class="ar-hero-head">
            <span class="ar-icon ar-icon-key" aria-hidden="true"></span>
            <h3 class="ar-hero-title">Authentication</h3>
            <span class="ar-chip ar-chip-@Summary.Tone" data-testid="auth-readiness-state">@Summary.Label</span>
        </div>
        <p class="ar-hero-detail" data-testid="auth-readiness-detail">@Summary.Detail</p>

        @*
            The three answers, side by side and never substituted for one another. Prerequisite detail is deliberately
            absent: each prerequisite says its piece once, on its own card.
        *@
        <dl class="ar-summary" data-testid="auth-readiness-summary">
            <div>
                <dt>Configuration</dt>
                <dd class="ar-tone-@AuthenticationPaneStates.ConfigurationTone(State.Configuration)" data-testid="auth-summary-configuration">
                    @AuthenticationPaneStates.ConfigurationLabel(State.Configuration)
                </dd>
            </div>
            <div>
                <dt>Verification</dt>
                <dd class="ar-tone-@AuthenticationPaneStates.VerificationTone(State.Verification)" data-testid="auth-summary-verification">
                    @AuthenticationPaneStates.VerificationLabel(State.Verification)
                </dd>
            </div>
            <div>
                <dt>Testing context</dt>
                @* The same words the Authenticated testing context card uses, from the same derivation. *@
                <dd class="ar-tone-@AuthenticatedTestingStates.Tone(State.TestingContext)" data-testid="auth-summary-context">
                    @AuthenticatedTestingStates.Label(State.TestingContext)
                </dd>
            </div>
        </dl>

        <div class="ar-hero-actions">
            <button type="button" class="btn-primary" data-testid="auth-verify"
                    disabled="@(!Summary.CanVerify)" @onclick="OnVerify">Verify authentication</button>
            @* A disabled action always says what is missing; a greyed-out button on its own makes the user guess. *@
            @if (AuthenticationReadinessPresentation.VerificationBlockedReason(Summary) is { Length: > 0 } blocked)
            {
                <p class="ar-blocked" data-testid="auth-verify-blocked">@blocked</p>
            }
        </div>
    </div>

    @if (Summary.Prerequisites.Count > 0)
    {
        @* Status cards, not a wizard. Once the system is operational this is not a linear sequence, and numbering it
           told the reader to start at the top even when only the third one needed anything. *@
        <div class="ar-section" data-testid="auth-prerequisites">
            <h4 class="ar-section-title" id="auth-prerequisites-heading">Prerequisites</h4>
            <div class="ar-cards" role="group" aria-labelledby="auth-prerequisites-heading">
                @foreach (var item in Summary.Prerequisites)
                {
                    <article class="ar-card ar-tone-@item.Tone" data-testid="auth-card-@item.Id">
                        <div class="ar-card-head">
                            <span class="ar-icon ar-icon-@item.Icon" aria-hidden="true"></span>
                            <div>
                                <h5 class="ar-card-title">@item.Title</h5>
                                <span class="ar-chip ar-chip-@item.Tone" data-testid="auth-status-@item.Id">@item.StatusLabel</span>
                            </div>
                        </div>

                        @if (item.Explanation is { Length: > 0 })
                        {
                            <p class="ar-card-text">@item.Explanation</p>
                        }

                        @if (item.Facts is { Count: > 0 } facts)
                        {
                            @* Runtime facts only while there is a runtime; empty rows for a stopped proxy are noise. *@
                            <dl class="ar-facts">
                                @foreach (var (label, value) in facts)
                                {
                                    <div><dt>@label</dt><dd>@value</dd></div>
                                }
                            </dl>
                        }

                        @if (item.ActionLabel is { Length: > 0 } action)
                        {
                            <button type="button" class="btn-secondary" data-testid="auth-action-@item.Id"
                                    disabled="@Busy" @onclick="() => OnAction.InvokeAsync(item.ActionId)">@action</button>
                        }
                    </article>
                }
            </div>
        </div>
    }

    @* Configuration, verification and authenticated context. The host owns them because they are bound to its draft
       and its runtimes; they belong here in the reading order. *@
    @ChildContent

    @* Endpoint Discovery is never disabled from here: it holds observed traffic from more than one source, so an
       incomplete proxy setup limits what arrives next rather than making the surface useless. *@
    <article class="ar-cta" data-testid="auth-discovery-cta">
        <span class="ar-icon ar-icon-radar" aria-hidden="true"></span>
        <div class="ar-cta-body">
            <h4 class="ar-card-title">@EndpointDiscoveryCta.Title</h4>
            <p class="ar-card-text">@EndpointDiscoveryCta.Description</p>
            <p class="ar-cta-status">
                <span class="ar-chip ar-chip-@DiscoveryTone" data-testid="auth-discovery-status">@DiscoveryStatus</span>
                @if (DiscoveryNote is { Length: > 0 })
                {
                    <span class="ar-cta-note" data-testid="auth-discovery-note">@DiscoveryNote</span>
                }
            </p>
        </div>
        <button type="button" class="btn-secondary" data-testid="auth-open-discovery" @onclick="OnOpenDiscovery">
            Open Endpoint Discovery →
        </button>
    </article>

    @if (Capabilities is not null)
    {
        <ReviewDisclosure Text="Testing capabilities" CollapseText="Hide testing capabilities"
                          TestId="auth-capabilities" Class="disclosure-inline disclosure-small">
            @Capabilities
        </ReviewDisclosure>
    }

    @if (Proxy is not null || AuthenticationFacts is { Count: > 0 })
    {
        <ReviewDisclosure Text="Technical details" CollapseText="Hide technical details"
                          TestId="auth-technical-details" Class="disclosure-inline disclosure-small">
            @if (Proxy is { } runtime)
            {
                <dl class="ar-facts ar-facts-technical" data-testid="auth-technical-facts">
                    <div><dt>Runtime id</dt><dd>@(runtime.RuntimeId ?? "—")</dd></div>
                    <div><dt>Proxy endpoint</dt><dd>@(runtime.ExpectedProxyPort is { } p ? $"127.0.0.1:{p}" : "—")</dd></div>
                    <div><dt>Owned Edge process id</dt><dd>@(runtime.EdgeRunning ? runtime.EdgeProcessId?.ToString() ?? "—" : "—")</dd></div>
                    <div><dt>Edge launched</dt><dd>@(runtime.EdgeRunning ? runtime.EdgeStartedAt?.ToLocalTime().ToString("HH:mm:ss") ?? "—" : "—")</dd></div>
                    @* Intent and evidence, side by side and never merged: what BirkNext passed, and what the running process carries. *@
                    <div><dt>Launch argument (BirkNext record)</dt><dd data-testid="auth-tech-launch-record">@(runtime.EdgeProxyPort is { } e ? $"--proxy-server=127.0.0.1:{e}" : "—")</dd></div>
                    <div><dt>Proxy argument on running process</dt><dd data-testid="auth-tech-process-argument">@ProcessArgument(runtime)</dd></div>
                    <div><dt>Expected profile</dt><dd>@(runtime.EdgeProfileDirectory ?? "—")</dd></div>
                    <div><dt>Profile on running process</dt><dd>@(runtime.EdgeProfileVerified switch { true => "Matches", false => "Different profile", _ => "Not read" })</dd></div>
                    <div><dt>Configuration verified at</dt><dd>@(runtime.EdgeLaunchVerifiedAt?.ToLocalTime().ToString("HH:mm:ss") ?? "—")</dd></div>
                    <div><dt>Proxy traffic from this browser</dt><dd data-testid="auth-tech-traffic">@AuthenticationReadinessPresentation.TrafficLabel(runtime)@(runtime.EdgeProxyTrafficObservedAt is { } seen ? $" (first at {seen.ToLocalTime():HH:mm:ss})" : "")</dd></div>
                    <div><dt>Proxy connections from other processes</dt><dd>@runtime.UnattributedProxyConnections</dd></div>
                    <div><dt>Verification method</dt><dd data-testid="auth-tech-method">Owned Edge process arguments (read by process id); connection owner matched to that process or its child processes</dd></div>
                    <div><dt>Edge proxy source</dt><dd data-testid="auth-tech-source">BirkNext launch argument (process-scoped). Edge Settings, Edge policy and the Windows proxy are not read or changed.</dd></div>
                    <div><dt>Proxy started</dt><dd>@(runtime.StartedAt?.ToLocalTime().ToString("HH:mm:ss") ?? "—")</dd></div>
                    <div><dt>Certificate thumbprint</dt><dd>@(string.IsNullOrWhiteSpace(runtime.Certificate.Thumbprint) ? "—" : runtime.Certificate.Thumbprint)</dd></div>
                    <div><dt>Certificate expires</dt><dd>@(runtime.Certificate.NotAfter?.ToLocalTime().ToString("d MMM yyyy") ?? "—")</dd></div>
                </dl>
            }
            @* The configured identifiers are diagnostics down here, and the readable summary up in the configuration
               card. They are never a secret — BirkNext has no field for one — but they are nobody's first question. *@
            @if (AuthenticationFacts is { Count: > 0 } authFacts)
            {
                <dl class="ar-facts ar-facts-technical" data-testid="auth-technical-authentication">
                    @foreach (var (label, value) in authFacts)
                    {
                        <div><dt>@label</dt><dd>@value</dd></div>
                    }
                </dl>
            }
        </ReviewDisclosure>
    }

</section>

@code {
    /// <summary>The one derived state. Every label on this surface is read from it; none is recomputed.</summary>
    [Parameter, EditorRequired] public AuthenticationPaneState State { get; set; } = default!;
    /// <summary>How many endpoints Endpoint Discovery already holds, so an incomplete setup is not reported as nothing to see.</summary>
    [Parameter] public int KnownEndpoints { get; set; }
    /// <summary>The proxy runtime, for the technical details disclosure only. Readiness never reads it directly.</summary>
    [Parameter] public LocalHttpsProxyStatus? Proxy { get; set; }
    /// <summary>Saved authentication identifiers for the technical details disclosure. Never a credential.</summary>
    [Parameter] public IReadOnlyList<(string Label, string Value)>? AuthenticationFacts { get; set; }
    [Parameter] public bool Busy { get; set; }
    /// <summary>Receives the prerequisite's ActionId. The host owns every one of these operations.</summary>
    [Parameter] public EventCallback<string?> OnAction { get; set; }
    [Parameter] public EventCallback OnVerify { get; set; }
    [Parameter] public EventCallback OnOpenDiscovery { get; set; }
    /// <summary>Configuration, verification and authenticated context, placed between prerequisites and the hand-off.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>The capability inventory, collapsed by default.</summary>
    [Parameter] public RenderFragment? Capabilities { get; set; }

    private AuthenticationReadinessSummary Summary => State.Readiness;

    private static string ProcessArgument(LocalHttpsProxyStatus runtime) => runtime.EdgeProxyArgument switch
    {
        DedicatedBrowserProxyArgument.Verified or DedicatedBrowserProxyArgument.Mismatch => $"--proxy-server={runtime.ObservedEdgeProxyEndpoint}",
        DedicatedBrowserProxyArgument.Missing => "None",
        _ => runtime.EdgeRunning ? "Not read" : "—",
    };

    private (string Status, string Tone, string? Note) Discovery => EndpointDiscoveryCta.Status(Summary, KnownEndpoints);
    private string DiscoveryStatus => Discovery.Status;
    private string DiscoveryTone => Discovery.Tone;
    private string? DiscoveryNote => Discovery.Note;
}
