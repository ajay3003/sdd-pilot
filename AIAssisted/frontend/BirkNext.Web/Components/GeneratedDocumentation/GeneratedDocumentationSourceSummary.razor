@using BirkNext.GeneratedDocumentation
@using BirkNext.Integrations

@* Source Analysis → compact Generated Documentation row for the selected snapshot. Details and drift review live in the diagnostic. *@
<section class="gds" aria-labelledby="gds-heading" data-testid="sa-generated-docs">
    <h3 id="gds-heading" class="gds-title">Generated documentation <BirkNext.Web.Components.SourceDomains.SourceStatusBadge Dimension="BirkNext.Web.Services.SourceStatusDimension.Completeness" Label="@Status" TestId="sa-generated-docs-status" /></h3>
    @if (Snapshot.GeneratedDocumentation is not { } g)
    {
        <p class="gds-muted" data-testid="sa-generated-docs-missing">This snapshot predates generated-documentation evidence. Analyze the same source again to include it.</p>
    }
    else if (g.Documents.Count == 0)
    {
        <p class="gds-muted" data-testid="sa-generated-docs-empty">@GeneratedDocumentationText.EmptyState</p>
    }
    else
    {
        var read = GeneratedDocumentationSemantics.Reinterpret(g);
        <dl class="gds-metrics">
            <div><dt>Modules</dt><dd>@g.Modules.Count</dd></div>
            <div><dt>Generated documents</dt><dd>@g.Documents.Count(d => d.Origin == DocumentationOrigin.Generated)</dd></div>
            <div><dt>Generator traced</dt><dd>@g.Modules.Count(m => m.GeneratorIds.Count > 0) of @g.Modules.Count</dd></div>
            <div><dt>Potentially stale</dt><dd>@read.Modules.Count(m => m.Freshness == GeneratedDocumentationFreshnessStatus.Stale)</dd></div>
            <div data-testid="sa-generated-docs-differences"><dt>Source consistency candidates</dt><dd>@read.Drift.Count(d => d.DriftType == CrossArtifactDriftType.DocumentationDrift && GeneratedDocumentationSemantics.IsReviewCandidate(d))</dd></div>
            <div data-testid="sa-generated-docs-unresolved"><dt>Source correlation unresolved</dt><dd>@read.Drift.Count(d => d.DriftType == CrossArtifactDriftType.DocumentationDrift && !GeneratedDocumentationSemantics.IsReviewCandidate(d)) <span class="gds-muted">not drift</span></dd></div>
        </dl>
        <p class="gds-muted">Generated documentation is implementation-derived evidence — never authored documentation, never source evidence. A consistency candidate needs comparable source and generated claims that differ; it is a candidate for review, not a confirmed defect.</p>
    }
    <a class="gds-link" href="generated-documentation-health" data-testid="sa-generated-docs-link">Open Generated Documentation Health</a>
</section>

@code {
    [Parameter, EditorRequired] public IqrSourceSnapshot Snapshot { get; set; } = default!;

    private string Status => Snapshot.GeneratedDocumentation switch
    {
        null => "Not available",
        { Documents.Count: 0 } => "None detected",
        var g when g.Documents.Any(d => d.StructurallyInvalid) => "Structural failure",
        // Trustworthy staleness or a comparable inconsistency only suggests review; unresolved correlation and unknown freshness stay neutral.
        var g when GeneratedDocumentationSemantics.Reinterpret(g) is var read && (read.Modules.Any(m => m.Freshness == GeneratedDocumentationFreshnessStatus.Stale)
            || read.Drift.Any(GeneratedDocumentationSemantics.IsReviewCandidate)) => "Review suggested",
        _ => "Detected",
    };
}
