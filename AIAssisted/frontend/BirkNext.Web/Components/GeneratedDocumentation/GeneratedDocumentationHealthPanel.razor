@using BirkNext.GeneratedDocumentation
@using BirkNext.Web.Services
@using BirkNext.Web.Services.Explorers
@inject IServiceProvider Services

@* Generated Documentation Health (project analysis of the imported project). Reads generated-documentation evidence stored on ONE Source Analysis
   snapshot; authored artifacts of the current workspace are compared only with the snapshot of the same imported project. No score: counts and
   states only. Health (presence, provenance, freshness, required documents, parseability) is kept visibly separate from consistency with the
   available evidence. Hosted by the /generated-documentation-health page, which owns the heading and the target-project context. *@
<section class="gdh" aria-labelledby="gdh-title" data-testid="gdh-panel">
    <header class="gdh-header">
        @if (Embedded)
        {
            <h2 id="gdh-title" class="visually-hidden">Generated documentation diagnostics</h2>
        }
        else
        {
            <h2 id="gdh-title" class="gdh-title">Generated Documentation Health</h2>
            <p class="gdh-description" data-testid="gdh-description">@GeneratedDocumentationText.Description</p>
        }
        @if (!Embedded)
        {
            <p class="gdh-boundary">@GeneratedDocumentationText.Boundary</p>
        }
        <button type="button" class="btn btn-primary gdh-run" data-testid="gdh-run" disabled="@_running" @onclick="RunAsync">
            @(_running ? "Running diagnostics…" : "Run diagnostics")
        </button>
    </header>

    @if (_error is not null)
    {
        <p role="alert" class="gdh-error" data-testid="gdh-error">@_error</p>
    }

    @if (_run is { } run)
    {
        <p class="gdh-status" role="status" data-testid="gdh-run-status">
            Completed @run.CompletedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") in @run.DurationMilliseconds ms@(run.FromCache ? " (cached result for the same evidence)" : "").
        </p>
        @if (run.Snapshot is { } snapshot && (!Embedded || snapshot.SnapshotId != SnapshotId))
        {
            <dl class="gdh-binding" data-testid="gdh-snapshot">
                <div><dt>Source snapshot</dt><dd><span class="gdh-wrap">@snapshot.ArchiveName</span> · analyzed @snapshot.AnalyzedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd></div>
                <div><dt>Selected by</dt><dd>@snapshot.Basis@(snapshot.IsNewest ? "" : " — not the newest snapshot")</dd></div>
                <div><dt>Snapshot id</dt><dd><code class="gdh-wrap">@snapshot.SnapshotId</code></dd></div>
            </dl>
        }

        @if (run.State != GeneratedDocumentationRunState.Ready)
        {
            <section class="gdh-state" aria-labelledby="gdh-state-title" data-testid="gdh-state" data-state="@run.State">
                <h3 id="gdh-state-title">@GeneratedDocumentationPresentation.StateTitle(run.State)</h3>
                <p>@run.StateMessage</p>
            </section>
            @* With no generated documentation at all, the inventory still answers which modules/APIs exist and that none is configured (neutral). *@
            @if (run.Autodoc is { } noDocsAutodoc) { <AutodocDiagnosticsSection Diagnostics="noDocsAutodoc" Snapshot="run.Snapshot" /> }
        }
        else
        {
            @if (run.Autodoc is { } autodoc)
            {
                <AutodocDiagnosticsSection Diagnostics="autodoc" Snapshot="run.Snapshot" ExplorerHref="@ExplorerHref" AdvancedContent="@Detailed(run)" />
            }
            else
            {
                @Detailed(run)
            }
        }
    }
    else if (!_running && _error is null)
    {
        <p class="gdh-note" data-testid="gdh-not-run">Not run yet. The diagnostic reads the generated-documentation evidence of a stored Source Analysis snapshot; it does not upload or rescan source.</p>
    }
</section>

@code {
    /// <summary>Test seam: the API is resolved from DI when not set.</summary>
    [Parameter] public IGeneratedDocumentationApiService? Api { get; set; }
    /// <summary>Hosted by the analysis page: the page shows the title, the target project and the source snapshot.</summary>
    [Parameter] public bool Embedded { get; set; }
    /// <summary>Fail safe: without a current imported project nothing runs — never another project's or the newest snapshot.</summary>
    [Parameter] public bool RequireImportedProject { get; set; }

    /// <summary>The selected import to analyse; when set it replaces the current workspace project (the global project is never changed).</summary>
    [Parameter] public string? ProjectImportId { get; set; }
    /// <summary>The exact Source Analysis snapshot to analyse; never the newest by date.</summary>
    [Parameter] public Guid? SnapshotId { get; set; }
    /// <summary>Authored artifacts of the workspace are compared only when the selected import is the current project.</summary>
    [Parameter] public bool IncludeAuthoredArtifacts { get; set; } = true;

    private GeneratedDocumentationDiagnosticRun? _run;
    private (string?, Guid?) _selection;
    private string? _error;
    private bool _running;
    private GeneratedDocumentationFilter _filter = GeneratedDocumentationFilter.All;
    private readonly HashSet<string> _expanded = new(StringComparer.Ordinal);
    private const int _driftLimit = 200;

    private async Task RunAsync()
    {
        if (_running) return;
        _running = true;
        _error = null;
        try
        {
            var api = Api ?? Services.GetService<IGeneratedDocumentationApiService>();
            if (api is null) { _error = "The generated-documentation diagnostic is not available in this host."; return; }
            TraceabilityInputs? inputs = null;
            if (Services.GetService<IArtifactExplorerContext>() is { } context)
            {
                try { inputs = await TraceabilityInputs.ResolveAsync(context); }
                catch (Exception) { inputs = null; }
            }
            var request = GeneratedDocumentationApiService.Request(IncludeAuthoredArtifacts ? inputs : null);
            if (ProjectImportId is not null) request = request with { ProjectImportId = ProjectImportId, SnapshotId = SnapshotId };
            if (RequireImportedProject && string.IsNullOrWhiteSpace(request.ProjectImportId))
            {
                _error = BirkNext.Web.Pages.GeneratedDocumentationHealthPage.NoProjectMessage;
                return;
            }
            _run = await api.RunAsync(request);
            if (_run is null) _error = "The diagnostic returned no result.";
            _expanded.Clear();
            _filter = GeneratedDocumentationFilter.All;
        }
        catch (HttpRequestException)
        {
            _error = "The generated-documentation diagnostic is unavailable because the local API could not be reached.";
        }
        finally
        {
            _running = false;
        }
    }

    /// <summary>The detailed diagnostics (health and consistency metrics, generator evidence, per-module details, workspace drift, limitations).</summary>
    private RenderFragment Detailed(GeneratedDocumentationDiagnosticRun run) => __builder =>
    {
            <section aria-labelledby="gdh-summary-title" data-testid="gdh-summary">
                <h3 id="gdh-summary-title" class="gdh-h3">Summary</h3>
                <h4 class="gdh-h4" id="gdh-summary-health">Generated documentation health</h4>
                <dl class="gdh-cards" aria-labelledby="gdh-summary-health" data-testid="gdh-summary-health">
                    @foreach (var (label, value, testId) in HealthCards(run.Summary))
                    {
                        <div class="gdh-card" data-testid="gdh-card" data-metric="@testId"><dt>@label</dt><dd>@value</dd></div>
                    }
                </dl>
                <h4 class="gdh-h4" id="gdh-summary-consistency">Consistency with available evidence</h4>
                <dl class="gdh-cards" aria-labelledby="gdh-summary-consistency" data-testid="gdh-summary-consistency">
                    @foreach (var (label, value, testId) in ConsistencyCards(run.Summary))
                    {
                        <div class="gdh-card" data-testid="gdh-card" data-metric="@testId"><dt>@label</dt><dd>@value</dd></div>
                    }
                </dl>
                <p class="gdh-note" data-testid="gdh-consistency-boundary">@GeneratedDocumentationText.ConsistencyBoundary</p>
                <p class="gdh-note" data-testid="gdh-authored-state">
                    <strong>Authored comparison:</strong> @(run.Authored.Compared ? $"compared ({string.Join(", ", run.Authored.Artifacts)})." : "not made.") @run.Authored.Reason
                </p>
                <p class="gdh-note">@GeneratedDocumentationText.NotSynchronized</p>
            </section>

            @if (run.Generators.Count > 0)
            {
                <section aria-labelledby="gdh-generators-title" data-testid="gdh-generators">
                    <h3 id="gdh-generators-title" class="gdh-h3">Generator and workflow evidence</h3>
                    <div class="gdh-scroll" tabindex="0" role="region" aria-label="Generator and workflow evidence">
                        <table class="gdh-table">
                            <thead><tr><th scope="col">File</th><th scope="col">Type</th><th scope="col">Role</th><th scope="col">Name (explicit only)</th><th scope="col">Declares / references</th></tr></thead>
                            <tbody>
                                @foreach (var g in run.Generators)
                                {
                                    <tr data-testid="gdh-generator">
                                        <th scope="row"><code class="gdh-wrap">@g.Path</code></th>
                                        <td>@GeneratedDocumentationText.Label(g.Type)</td>
                                        <td>@g.Role</td>
                                        <td>@(g.GeneratorName ?? "Not named")</td>
                                        <td class="gdh-wrap">@g.Basis@(g.DeclaredOutputFiles.Count > 0 ? $" · outputs: {string.Join(", ", g.DeclaredOutputFiles)}" : "")@(g.RequiredOutputFiles.Count > 0 ? $" · declared required: {string.Join(", ", g.RequiredOutputFiles)}" : "")@(g.ConditionalOutputFiles.Count > 0 ? $" · capability rules: {string.Join(", ", g.ConditionalOutputFiles.Select(r => r.Replace("|", " when ")))}" : "")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }


            <section aria-labelledby="gdh-modules-title" data-testid="gdh-modules">
                <h3 id="gdh-modules-title" class="gdh-h3">Modules</h3>
                <div class="gdh-filters" role="group" aria-label="Filter modules" data-testid="gdh-filters">
                    @foreach (var filter in GeneratedDocumentationPresentation.Filters)
                    {
                        var f = filter;
                        <button type="button" class="gdh-filter @(f == _filter ? "is-active" : "")" aria-pressed="@(f == _filter ? "true" : "false")"
                                data-testid="gdh-filter" data-filter="@f" @onclick="() => _filter = f">
                            @GeneratedDocumentationPresentation.Label(f) <span class="gdh-count">(@GeneratedDocumentationPresentation.Count(run, f))</span>
                        </button>
                    }
                </div>
                @{ var visible = run.Modules.Where(m => GeneratedDocumentationPresentation.Matches(m, _filter)).ToList(); }
                @if (visible.Count == 0)
                {
                    <p class="gdh-note" data-testid="gdh-filter-empty">No module matches “@GeneratedDocumentationPresentation.Label(_filter)”.</p>
                }
                <ul class="gdh-module-list">
                    @foreach (var module in visible)
                    {
                        var m = module;
                        var detailsId = $"gdh-module-{Slug(m.ModuleId)}";
                        var expanded = _expanded.Contains(m.ModuleId);
                        var sourceUnresolved = GeneratedDocumentationPresentation.UnresolvedFor(run, m, source: true);
                        var crossUnresolved = GeneratedDocumentationPresentation.UnresolvedFor(run, m, source: false);
                        var generatedCount = m.Evidence.Count(e => e.Origin == DocumentationOrigin.Generated);
                        <li class="gdh-module" data-testid="gdh-module" data-module="@m.Module" data-status="@m.Status" data-review="@m.Review">
                            <div class="gdh-module-head">
                                <h4 class="gdh-module-name"><span class="gdh-wrap">@m.Module</span></h4>
                                <span class="sd-pill sd-pill-@GeneratedDocumentationPresentation.Tone(m.Review)" data-testid="gdh-module-review">@GeneratedDocumentationText.Label(m.Review)</span>
                            </div>
                            <dl class="gdh-dims" data-testid="gdh-module-dimensions">
                                <div><dt>Generated docs</dt><dd>@generatedCount available</dd></div>
                                <div><dt>Health</dt><dd><span class="sd-pill sd-pill-@GeneratedDocumentationPresentation.Tone(m.Status)" data-testid="gdh-module-status">@GeneratedDocumentationText.Label(m.Status)</span></dd></div>
                                <div><dt>Freshness</dt><dd><span class="sd-pill sd-pill-@GeneratedDocumentationPresentation.Tone(m.Freshness)" data-testid="gdh-module-freshness">@GeneratedDocumentationText.Label(m.Freshness)</span></dd></div>
                                <div><dt>Required-doc coverage</dt><dd data-testid="gdh-module-coverage">@GeneratedDocumentationPresentation.RequiredCoverage(m)</dd></div>
                                <div><dt>Source consistency</dt><dd data-testid="gdh-module-source-consistency">@GeneratedDocumentationPresentation.Consistency(m.SourceDiscrepancies.Count, sourceUnresolved.Count)</dd></div>
                                <div><dt>Cross-artifact consistency</dt><dd data-testid="gdh-module-cross-consistency">@GeneratedDocumentationPresentation.Consistency(m.CrossArtifactDrift.Count, crossUnresolved.Count)</dd></div>
                            </dl>
                            <p class="gdh-module-reason gdh-wrap">@(m.ReviewReasons.Count > 0 ? string.Join(" ", m.ReviewReasons) : m.StatusReason)</p>
                            <p class="gdh-module-meta gdh-wrap">@(m.GeneratorDetected ? "Generator: " + m.GeneratorSummary : GeneratedDocumentationText.NoGeneratorEstablished) · @m.Evidence.Count document(s) in <code>@m.GeneratedDirectory</code></p>
                            <button type="button" class="btn-secondary gdh-toggle" aria-expanded="@(expanded ? "true" : "false")" aria-controls="@detailsId" data-testid="gdh-module-toggle"
                                    @onclick="() => Toggle(_expanded, m.ModuleId)">
                                @(expanded ? "Hide details" : "Show details")<span class="visually-hidden"> for @m.Module</span>
                            </button>
                            @if (expanded)
                            {
                                <div id="@detailsId" class="gdh-module-details" data-testid="gdh-module-details">
                                    <section data-testid="gdh-health-section" aria-label="@($"Generated documentation health of {m.Module}")">
                                        <h5 class="gdh-h5">Generated documentation health</h5>
                                        <dl class="gdh-facts">
                                            <div><dt>Health</dt><dd class="gdh-wrap">@GeneratedDocumentationText.Label(m.Status) — @m.StatusReason</dd></div>
                                            <div><dt>Generated folder</dt><dd><code class="gdh-wrap">@m.GeneratedDirectory</code></dd></div>
                                            <div><dt>Generator / workflow</dt><dd class="gdh-wrap">@(m.GeneratorDetected ? m.GeneratorSummary : GeneratedDocumentationText.NoGeneratorEstablished)</dd></div>
                                            <div><dt>Generated documents present</dt><dd>@generatedCount generated · @(m.Evidence.Count - generatedCount) of other or unknown origin</dd></div>
                                            <div><dt>Parseability</dt><dd>@(m.Evidence.Any(e => e.StructurallyInvalid) ? $"{m.Evidence.Count(e => e.StructurallyInvalid)} generated contract(s) do not parse" : "No structural failure")</dd></div>
                                            <div><dt>Generation evidence</dt><dd class="gdh-wrap">@GeneratedDocumentationPresentation.Date(m.LatestGeneratedEvidence)</dd></div>
                                        </dl>
                                    </section>

                                    <section data-testid="gdh-freshness-section" aria-label="@($"Freshness of {m.Module}")">
                                        <h5 class="gdh-h5">Freshness</h5>
                                        <dl class="gdh-facts">
                                            <div><dt>Freshness</dt><dd class="gdh-wrap">@GeneratedDocumentationText.Label(m.Freshness) — @m.FreshnessReason</dd></div>
                                            <div><dt>Latest relevant source evidence</dt><dd class="gdh-wrap">@GeneratedDocumentationPresentation.Date(m.LatestSourceEvidence)</dd></div>
                                            <div><dt>Latest generated evidence</dt><dd class="gdh-wrap">@GeneratedDocumentationPresentation.Date(m.LatestGeneratedEvidence)</dd></div>
                                            @if (m.SupportingFreshnessSignals.Count > 0)
                                            {
                                                <div><dt>Supporting signals (weaker than source)</dt><dd><ul class="gdh-plain">@foreach (var s in m.SupportingFreshnessSignals) { <li class="gdh-wrap">@s</li> }</ul></dd></div>
                                            }
                                        </dl>
                                    </section>

                                    <section data-testid="gdh-required-section" aria-label="@($"Required and expected documentation of {m.Module}")">
                                        <h5 class="gdh-h5">Required / expected documentation</h5>
                                        <p class="gdh-note" data-testid="gdh-missing">@GeneratedDocumentationPresentation.RequiredCoverage(m)@(m.MissingExpectedDocs.Count > 0 ? $": {string.Join(", ", m.MissingExpectedDocs)}" : "")</p>
                                        @if (m.ExpectedDocuments.Count > 0)
                                        {
                                            <div class="gdh-scroll" tabindex="0" role="region" aria-label="@($"Declared outputs of {m.Module}")">
                                                <table class="gdh-table" data-testid="gdh-expected">
                                                    <thead><tr><th scope="col">Document</th><th scope="col">State</th><th scope="col">Present</th><th scope="col">Basis</th></tr></thead>
                                                    <tbody>
                                                        @foreach (var e in m.ExpectedDocuments)
                                                        {
                                                            <tr data-testid="gdh-expected-row" data-state="@e.State">
                                                                <th scope="row"><code class="gdh-wrap">@e.FileName</code></th>
                                                                <td><span class="sd-pill sd-pill-@GeneratedDocumentationPresentation.Tone(e)">@(e.State is { } state ? GeneratedDocumentationText.Label(state) : "Unknown")</span></td>
                                                                <td>@(e.Present ? "Yes" : "No")</td>
                                                                <td class="gdh-wrap">@(e.StateBasis.Length > 0 ? e.StateBasis : e.Basis)</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                        @if (m.AdditionalDocs.Count > 0)
                                        {
                                            <p class="gdh-note gdh-wrap"><strong>Additional documents — not a failure:</strong> @string.Join(", ", m.AdditionalDocs)</p>
                                        }
                                    </section>

                                    <section data-testid="gdh-documents-section" aria-label="@($"Generated documents of {m.Module}")">
                                        <h5 class="gdh-h5">Generated documents</h5>
                                        @if (ExplorerVisible)
                                        {
                                            <p class="gdh-note"><a class="btn-link" href="@GeneratedDocumentationPresentation.ExplorerLink(m)" data-testid="gdh-open-explorer">Open in Generated Documentation Explorer</a></p>
                                        }
                                        <div class="gdh-scroll" tabindex="0" role="region" aria-label="@($"Generated documents of {m.Module}")">
                                            <table class="gdh-table" data-testid="gdh-documents">
                                                <thead><tr><th scope="col">Document</th><th scope="col">Kind</th><th scope="col">Origin</th><th scope="col">Freshness</th><th scope="col">Generated</th></tr></thead>
                                                <tbody>
                                                    @foreach (var d in m.Evidence)
                                                    {
                                                        <tr data-testid="gdh-document">
                                                            <th scope="row"><code class="gdh-wrap">@d.SafeRelativePath</code>@if (d.StructurallyInvalid) { <span class="sd-pill sd-pill-attention gdh-inline">Does not parse</span> }</th>
                                                            <td>@GeneratedDocumentationText.Label(d.DocumentKind)</td>
                                                            <td class="gdh-wrap">@d.Origin<span class="gdh-sub">@d.Provenance.Label</span></td>
                                                            <td class="gdh-wrap">@GeneratedDocumentationText.Label(d.FreshnessStatus)<span class="gdh-sub">@d.FreshnessReason</span></td>
                                                            <td class="gdh-wrap">@GeneratedDocumentationPresentation.Date(d.LastModified)</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </section>

                                    <section class="gdh-consistency" data-testid="gdh-consistency-section" aria-label="@($"Consistency with available evidence for {m.Module}")">
                                        <h5 class="gdh-h5">Consistency with available evidence</h5>
                                        <p class="gdh-note">Not part of the health status above. @GeneratedDocumentationText.ConsistencyBoundary</p>
                                        @if (m.Comparisons.Count > 0)
                                        {
                                            <div class="gdh-scroll" tabindex="0" role="region" aria-label="@($"Structured comparisons for {m.Module}")">
                                                <table class="gdh-table" data-testid="gdh-comparisons">
                                                    <thead><tr><th scope="col">Family</th><th scope="col">State</th><th scope="col">Detail</th></tr></thead>
                                                    <tbody>
                                                        @foreach (var c in m.Comparisons)
                                                        {
                                                            <tr data-testid="gdh-comparison" data-state="@c.State"><th scope="row">@(c.Family == "Specification contracts" ? "Specification contracts (authored/generated consistency)" : c.Family)</th><td><span class="sd-pill sd-pill-@GeneratedDocumentationPresentation.Tone(c.State)">@GeneratedDocumentationText.Label(c.State)</span></td><td class="gdh-wrap">@c.Detail</td></tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }

                                        @{ var candidates = GeneratedDocumentationPresentation.DriftFor(run, m); }
                                        <h6 class="gdh-h6">Review candidates (@candidates.Count)</h6>
                                        @if (candidates.Count == 0)
                                        {
                                            <p class="gdh-note" data-testid="gdh-no-candidates">No comparable conflicting claims among the structured keys compared. @GeneratedDocumentationText.NotSynchronized</p>
                                        }
                                        else
                                        {
                                            <ul class="gdh-drift-list" data-testid="gdh-drift-list">
                                                @foreach (var candidate in candidates.Take(_driftLimit))
                                                {
                                                    <DriftCandidateItem Candidate="candidate" Snapshot="run.Snapshot" />
                                                }
                                            </ul>
                                            @if (candidates.Count > _driftLimit)
                                            {
                                                <p class="gdh-note">Showing the first @_driftLimit of @candidates.Count candidates.</p>
                                            }
                                        }
                                        @if (m.CrossArtifactDrift.Count > 0)
                                        {
                                            <p class="gdh-note"><a class="btn-link" href="documentation-drift" data-testid="gdh-open-drift">Compare authored and generated documentation in Documentation Drift</a></p>
                                        }
                                        @{ var unresolved = GeneratedDocumentationPresentation.UnresolvedFor(run, m); }
                                        @if (unresolved.Count > 0)
                                        {
                                            <details class="gdh-unresolved" data-testid="gdh-unresolved">
                                                <summary>Unresolved correlations and source-only items (@unresolved.Count) — diagnostics, not drift</summary>
                                                <ul class="gdh-drift-list">
                                                    @foreach (var candidate in unresolved.Take(_driftLimit))
                                                    {
                                                        <DriftCandidateItem Candidate="candidate" Snapshot="run.Snapshot" />
                                                    }
                                                </ul>
                                            </details>
                                        }
                                    </section>

                                    <section data-testid="gdh-provenance-section" aria-label="@($"Technical provenance of {m.Module}")">
                                        <h5 class="gdh-h5">Technical provenance</h5>
                                        <dl class="gdh-facts">
                                            <div><dt>Module id</dt><dd><code class="gdh-wrap">@m.ModuleId</code></dd></div>
                                            <div><dt>Documented scope</dt><dd><code class="gdh-wrap">@(m.RootPath.Length == 0 ? "(repository root)" : m.RootPath)</code></dd></div>
                                            @if (run.Snapshot is { } binding)
                                            {
                                                <div><dt>Source snapshot</dt><dd><code class="gdh-wrap">@binding.SnapshotId</code> · analyzer v@(binding.AnalyzerVersion)</dd></div>
                                            }
                                        </dl>
                                    </section>
                                </div>
                            }
                        </li>
                    }
                </ul>
            </section>

            var workspaceDrift = run.Drift.Where(d => d.ModuleId == "module:*").ToList();
            @if (workspaceDrift.Count > 0)
            {
                <section aria-labelledby="gdh-workspace-drift-title" data-testid="gdh-workspace-drift">
                    <h3 id="gdh-workspace-drift-title" class="gdh-h3">Workspace-level consistency (@workspaceDrift.Count(GeneratedDocumentationSemantics.IsReviewCandidate) review candidates)</h3>
                    <p class="gdh-note">Authored artifacts without a module path are compared with the generated documentation of every module.</p>
                    <ul class="gdh-drift-list">@foreach (var candidate in workspaceDrift.OrderBy(d => GeneratedDocumentationSemantics.Classify(d)).Take(_driftLimit)) { <DriftCandidateItem Candidate="candidate" Snapshot="run.Snapshot" /> }</ul>
                </section>
            }

            @if (run.Limitations.Count > 0)
            {
                <section aria-labelledby="gdh-limitations-title" data-testid="gdh-limitations">
                    <h3 id="gdh-limitations-title" class="gdh-h3">Limitations</h3>
                    <ul class="gdh-plain">@foreach (var l in run.Limitations) { <li class="gdh-wrap">@l</li> }</ul>
                </section>
            }
    };

    /// <summary>A different import or snapshot clears the shown result: a result is never shown for a selection it was not run for.</summary>
    protected override void OnParametersSet()
    {
        if (_selection == (ProjectImportId, SnapshotId)) return;
        _selection = (ProjectImportId, SnapshotId);
        _run = null;
        _error = null;
        _expanded.Clear();
    }

    private string? ExplorerHref => ExplorerVisible && ProjectImportId is not null ? $"{NavigationCatalog.GeneratedDocumentationExplorerRoute}?import={Uri.EscapeDataString(ProjectImportId)}" : null;

    private static void Toggle(HashSet<string> set, string id) { if (!set.Remove(id)) set.Add(id); }

    private static string Slug(string value) => System.Text.RegularExpressions.Regex.Replace(value.ToLowerInvariant(), "[^a-z0-9]+", "-").Trim('-');

    /// <summary>Generated Documentation Explorer is linked only when its feature is visible (shown when no feature service is registered).</summary>
    private bool ExplorerVisible => Services.GetService<FeatureVisibilityService>()?.GeneratedDocumentationExplorer ?? true;

    private static IEnumerable<(string Label, int Value, string TestId)> HealthCards(GeneratedDocumentationSummary s) =>
    [
        ("Generated docs", s.GeneratedDocuments, "documents"),
        ("Generated modules", s.ModulesWithGeneratedDocs, "modules"),
        ("Generator / workflow detected", s.ModulesWithGeneratorDetected, "generator"),
        ("Fresh", s.Fresh, "fresh"),
        ("Potentially stale", s.PotentiallyStale, "stale"),
        ("Freshness unknown", s.FreshnessUnknown, "unknown"),
        ("Required docs missing", s.MissingExpectedDocs, "missing"),
        ("Applicability unresolved", s.ApplicabilityUnresolved, "applicability"),
    ];

    /// <summary>Consistency counters are separate from health: review candidates need comparable conflicting claims; the rest are neutral diagnostics.</summary>
    private static IEnumerable<(string Label, int Value, string TestId)> ConsistencyCards(GeneratedDocumentationSummary s) =>
    [
        ("Source consistency candidates", s.SourceDocumentationDiscrepancies, "discrepancies"),
        ("Authored/generated consistency candidates", s.AuthoredGeneratedCandidates, "authored"),
        ("Cross-artifact consistency candidates", s.CrossArtifactDriftCandidates, "drift"),
        ("Correlation unresolved", s.CorrelationUnresolved, "unresolved"),
        ("Source-only items", s.SourceOnlyObservations, "source-only"),
        ("Unable to compare", s.UnableToCompare, "unable"),
    ];
}
