@using BirkNext.GitSources
@inject IGitSourcesApiService Git

@* Import Project → from an Azure DevOps Git repository. Nothing is requested from Azure DevOps until the person asks: opening the page or this section
   reads only the local sign-in state. The chosen branch is resolved to its commit by the backend; the import is then exactly a ZIP import. *@
<details class="gip" data-testid="gip" @ontoggle="ToggleAsync">
    <summary>Import from an Azure DevOps Git repository</summary>
    @if (_status is null) { <p class="gip-muted" role="status">@(_error ?? "Reading the sign-in state…")</p> }
    else if (_status.State != GitConnectionState.Connected)
    {
        <p class="gip-muted" data-testid="gip-not-connected">@_status.Message <a href="admin/system-settings?section=git-sources">Open System Settings → Git Sources</a> to sign in and test the connection.</p>
    }
    else
    {
        <p class="gip-muted">Signed in as @_status.Account. BirkNext reads only what your account can read and never writes to the repository.</p>
        <div class="gip-row">
            <button type="button" class="btn-secondary" disabled="@_busy" @onclick="LoadRepositoriesAsync" data-testid="gip-load-repos">@(_repos.Count == 0 ? "Load repositories" : "Refresh repositories")</button>
            @if (_repos.Count > 0)
            {
                <label>Repository
                    <select data-testid="gip-repo" value="@_repoId" @onchange="RepositoryChangedAsync">
                        <option value="">Choose…</option>
                        @foreach (var r in _repos.Where(r => !r.IsDisabled)) { <option value="@r.Id">@r.Project / @r.Name</option> }
                    </select>
                </label>
            }
        </div>
        @if (_branches.Count > 0)
        {
            <label class="gip-search">Branch (latest commit first)
                <input type="search" data-testid="gip-branch-search" @bind="_search" @bind:event="oninput" placeholder="Filter branches" />
            </label>
            <ul class="gip-branches" data-testid="gip-branches">
                @foreach (var b in _branches.Where(b => _search.Length == 0 || b.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)).Take(50))
                {
                    <li>
                        <label><input type="radio" name="gip-branch" checked="@(_branch == b.Name)" @onchange="() => _branch = b.Name" data-testid="gip-branch" data-branch="@b.Name" />
                            <strong>@b.Name</strong>@(b.IsDefault ? " (default)" : "")
                            <span class="gip-muted"> · @(b.CommitSha.Length >= 8 ? b.CommitSha[..8] : b.CommitSha)@(b.CommittedAt is { } d ? $" · {d.UtcDateTime:yyyy-MM-dd HH:mm} UTC" : "")@(b.Author is null ? "" : $" · {b.Author}")</span></label>
                    </li>
                }
            </ul>
            <button type="button" class="btn-primary" disabled="@(_branch is null || _busy)" @onclick="ImportAsync" data-testid="gip-import">Preview import of this branch's current commit</button>
        }
        @if (_error is not null) { <p class="gip-error" role="alert" data-testid="gip-error">@_error</p> }
    }
</details>

@code {
    /// <summary>Starts the Git preview through the import session (label, request).</summary>
    [Parameter, EditorRequired] public EventCallback<(GitImportRequest Request, string Label)> OnImport { get; set; }

    private GitConnectionStatus? _status;
    private IReadOnlyList<GitRepository> _repos = [];
    private IReadOnlyList<GitBranch> _branches = [];
    private string? _repoId, _branch, _error;
    private string _search = "";
    private bool _busy, _opened;

    private async Task ToggleAsync()
    {
        if (_opened) return;
        _opened = true;
        (_status, _error) = await Git.StatusAsync();
    }

    private async Task LoadRepositoriesAsync()
    {
        (_busy, _error) = (true, null);
        (_repos, _error) = await Git.RepositoriesAsync();
        _busy = false;
    }

    private async Task RepositoryChangedAsync(ChangeEventArgs e)
    {
        (_repoId, _branch, _branches, _error) = (e.Value?.ToString(), null, [], null);
        if (string.IsNullOrEmpty(_repoId)) return;
        _busy = true;
        (_branches, _error) = await Git.BranchesAsync(_repoId);
        _busy = false;
    }

    private async Task ImportAsync()
    {
        if (_repoId is null || _branch is null) return;
        var repo = _repos.FirstOrDefault(r => r.Id == _repoId);
        await OnImport.InvokeAsync((new GitImportRequest(_repoId, _branch), $"{repo?.Name ?? "repository"} @ {_branch}"));
    }
}
