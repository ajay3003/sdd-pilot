@using BirkNext.Web.Models

@* The automated/passive review scope, by area. Named by the disclosure that hosts it; nothing here is a result, because
   nothing has run yet, and nothing here is counted — the entries are not comparable units. Areas OUTSIDE this review are
   a separate block (FrontendQualityNotAssessedList).

   The accessibility disclaimer lives on the accessibility group, where the accessibility scope is. It used to be
   repeated as a footer under every group, which said it about bundle sizes and service workers too. *@
<div class="fqr-checks" data-testid="fqr-checks">
    <div class="fqr-check-groups">
        @foreach (var group in Groups)
        {
            <div class="fqr-check-group" data-testid="fqr-check-group" data-group="@group.Title">
                <h3>@group.Title</h3>
                @if (group.Checks.Count > 0)
                {
                    <ul>
                        @foreach (var check in group.Checks)
                        {
                            <li>@check</li>
                        }
                    </ul>
                }
                @if (!string.IsNullOrWhiteSpace(group.Note))
                {
                    <p class="fqr-check-note">@group.Note</p>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<FrontendQualityCheckGroup> Groups { get; set; } = [];
}
