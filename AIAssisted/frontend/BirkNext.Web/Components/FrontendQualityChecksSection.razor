@using BirkNext.Web.Models

@* The automated/passive checks this review runs, grouped. Named by the disclosure that hosts it; nothing here is a result,
   because nothing has run yet. "Not assessed by this review" is a separate block (FrontendQualityNotAssessedList). *@
<div class="fqr-checks" data-testid="fqr-checks">
    <div class="fqr-check-groups">
        @foreach (var group in Groups)
        {
            <div class="fqr-check-group" data-testid="fqr-check-group" data-group="@group.Title">
                <h3>@group.Title</h3>
                @if (group.Checks.Count > 0)
                {
                    <ul>
                        @foreach (var check in group.Checks)
                        {
                            <li>@check</li>
                        }
                    </ul>
                }
                @if (!string.IsNullOrWhiteSpace(group.Note))
                {
                    <p class="fqr-check-note">@group.Note</p>
                }
            </div>
        }
    </div>
    <p class="fqr-section-note">Automated results never replace manual testing.</p>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<FrontendQualityCheckGroup> Groups { get; set; } = [];
}
