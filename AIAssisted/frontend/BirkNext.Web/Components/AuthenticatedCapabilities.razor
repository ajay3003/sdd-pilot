<section data-testid="authenticated-capabilities" aria-label="Authenticated capabilities">
    <h3>Authenticated capabilities</h3>
    <dl class="fa-detail-list">
        <div class="fa-dl-row"><dt>Security · Public</dt><dd>Available</dd></div>
        <div class="fa-dl-row"><dt>Security · Authenticated API</dt><dd data-testid="capability-api">@Available(Rest || GraphQl)</dd></div>
        <div class="fa-dl-row"><dt>Security · Authenticated DOM</dt><dd data-testid="capability-dom">@Available(Dom)</dd></div>
        <div class="fa-dl-row"><dt>REST · Public discovery</dt><dd>Available</dd></div>
        <div class="fa-dl-row"><dt>REST · Authenticated</dt><dd data-testid="capability-rest" title="Approved read-only requests only">@Available(Rest)</dd></div>
        <div class="fa-dl-row"><dt>GraphQL · Schema discovery</dt><dd>Available</dd></div>
        <div class="fa-dl-row"><dt>GraphQL · Authenticated query</dt><dd data-testid="capability-graphql" title="Queries only; mutations and subscriptions remain blocked">@Available(GraphQl)</dd></div>
    </dl>
</section>

@code {
    [Parameter] public bool Dom { get; set; }
    [Parameter] public bool Rest { get; set; }
    [Parameter] public bool GraphQl { get; set; }
    private static string Available(bool value) => value ? "Available" : "Unavailable";
}
