@using BirkNext.ManagedEdge
@using BirkNext.Web.Services
@using BirkNext.Web.Models

<section class="fa-detection-summary" data-testid="managed-edge-panel" aria-label="Managed Edge authentication">
    <h3>Managed Edge / CDP</h3>
    <details><summary>Sign-in instructions</summary>
        <p>Start a separate Edge instance, open @SafeOrigin and sign in manually. Complete MFA, PIN, passkeys and Conditional Access yourself, then re-check the target application. BirkNext never reads cookies, tokens or browser storage.</p>
    </details>
    <div class="fa-auth-steps">
    <div class="fa-auth-step">
    <h4>Step 1 — Edge</h4>
    <p role="status">@(Preflight is null ? "Not checked" : Preflight.EdgeStarted ? "Running" : Preflight.CanLaunchTestEdge || Preflight.CanConnect ? "Ready" : "Unavailable")</p>
    <details><summary>Compatibility details</summary>
    <dl class="fa-detail-list" data-testid="edge-compatibility">
        <div class="fa-dl-row"><dt>Local browser integration</dt><dd>@(Preflight is null ? "Not checked" : Preflight.LocalBrowserIntegrationAvailable ? "Available" : "Unavailable in this deployment mode")</dd></div>
        <div class="fa-dl-row"><dt>Edge installed</dt><dd>@(Preflight is null ? "Not checked" : Preflight.EdgeInstalled ? "Yes" : "No")</dd></div>
        <div class="fa-dl-row"><dt>Version</dt><dd>@(Preflight?.EdgeVersion ?? "—")</dd></div>
        <div class="fa-dl-row"><dt>Remote debugging policy</dt><dd>@(Preflight is null ? "Not checked" : PolicyLabel(Preflight.RemoteDebuggingPolicyStatus))</dd></div>
        <div class="fa-dl-row"><dt>Remote debugging runtime</dt><dd>@(Preflight is null ? "Not checked" : Preflight.RemoteDebuggingRuntimeActive ? "Active" : "Not active")</dd></div>
        <div class="fa-dl-row"><dt>CDP endpoint</dt><dd>@(Preflight?.CdpEndpoint ?? Status.Endpoint) — @EndpointLabel</dd></div>
        <div class="fa-dl-row"><dt>Browser</dt><dd>@(Preflight?.BrowserProduct is { } product ? $"{product} {Preflight.BrowserVersion}" : "—")</dd></div>
        <div class="fa-dl-row"><dt>Target application</dt><dd>@(Preflight is null ? "Not checked" : Preflight.TargetTabFound ? $"Found ({Preflight.TargetTabCount} tab{(Preflight.TargetTabCount == 1 ? "" : "s")})" : "Not opened yet")</dd></div>
        <div class="fa-dl-row"><dt>Edge started by BirkNext</dt><dd>@(Preflight is null ? "—" : Preflight.EdgeStarted ? "Yes" : "No")</dd></div>
    </dl>
    </details>
    @if (Preflight?.FailureReason is { } reason)
    {
        <p role="status" data-testid="edge-preflight-reason">@reason</p>
    }
    <button type="button" class="btn-secondary" disabled="@(Runtime is null || Runtime.PreflightBusy || Profile is null)" @onclick="Check">Check Edge compatibility</button>
    <button type="button" class="btn-secondary" disabled="@(Runtime is null || Runtime.PreflightBusy || Runtime.Busy || Profile is null || Preflight?.CanLaunchTestEdge != true)" @onclick="Launch">Start Edge for authenticated testing</button>

    </div>
    <div class="fa-auth-step">
    <h4>Step 2 — Sign in</h4>
    <p role="status" data-testid="edge-manual-signin">@ManualSignInLabel</p>

    </div>
    <div class="fa-auth-step">
    <h4>Step 3 — Connection</h4>
    <dl class="fa-detail-list" data-testid="edge-connection">
        <div class="fa-dl-row"><dt>Connection</dt><dd>@AuthenticatedTestingMethodLabels.Connection(Status.State)</dd></div>
        <div class="fa-dl-row"><dt>Target tab</dt><dd>@TargetTabLabel</dd></div>
        <div class="fa-dl-row"><dt>Target</dt><dd>@Profile?.Name</dd></div>
    </dl>
    <button type="button" class="btn-secondary" disabled="@(Runtime is null || Runtime.Busy || Profile is null || Preflight?.LocalBrowserIntegrationAvailable == false)" @onclick="Connect">@(Preflight?.EdgeStarted == true || Status.SessionId is not null ? "Re-check target application" : "Connect to existing Edge")</button>
    <button type="button" class="btn-secondary" disabled="@(Runtime is null || Runtime.Busy || Status.State is not (ManagedEdgeState.ConnectedUnproven or ManagedEdgeState.ConnectedAuthenticated))" @onclick="Verify">Verify authenticated access</button>
    <button type="button" class="btn-secondary" disabled="@(Runtime is null || Status.SessionId is null)" @onclick="Disconnect">Disconnect BirkNext from Edge</button>

    <details><summary>Browser delivery details</summary>
    <dl class="fa-detail-list" data-testid="edge-browser-delivery">
        <div class="fa-dl-row"><dt>Configured target</dt><dd>@(Status.TargetOrigin ?? SafeOrigin)</dd></div>
        <div class="fa-dl-row"><dt>Configured trust</dt><dd data-testid="edge-configured-trust">@ConfiguredTrustLabel</dd></div>
        <div class="fa-dl-row"><dt>Observed browser origin</dt><dd data-testid="edge-observed-origin">@(Status.DeliveryOrigin ?? "Not observed")</dd></div>
        <div class="fa-dl-row"><dt>Delivery</dt><dd data-testid="edge-delivery">@BrowserDeliveryTrustLabels.Delivery(Status)</dd></div>
        <div class="fa-dl-row"><dt>Trust decision</dt><dd data-testid="edge-trust-decision">@BrowserDeliveryTrustLabels.Decision(Status)</dd></div>
        <div class="fa-dl-row"><dt>Correlation evidence</dt><dd data-testid="edge-correlation">@(Status.CorrelationEvidence ?? "—")</dd></div>
    </dl>

    </details>
    </div>
    <div class="fa-auth-step">
    <h4>Step 4 — Authenticated access</h4>
    @if (Status.State == ManagedEdgeState.TargetTabNotInspectable)
    {
        <p role="status" data-testid="edge-enterprise-protection"><strong>Authenticated browser automation: Blocked</strong><br />Enterprise browser protection prevents debugger attachment to this target.</p>
    }
    <p role="status"><strong>@(Status.AuthenticatedBrowserAvailable ? "Verified" : "Not verified")</strong></p>
    <details><summary>Access evidence</summary>@Status.Evidence</details>
    @if (Status.Probe is { } probe)
    {
        <p>Safe request: HTTP @probe.StatusCode · @probe.ContentType · @probe.ElapsedMs ms. Response bodies are not captured.</p>
    }

    </div>
    </div>
    @if (Status.State == ManagedEdgeState.TargetTabNotInspectable && LocalHttpsProxyScope.EnvironmentAllowed(Profile))
    {
        <p class="fa-section-note" role="status" data-testid="cdp-blocked-proxy-hint">@AuthenticatedTestingMethodLabels.CdpBlockedProxyHint</p>
    }
    <AuthenticatedCapabilities Dom="Status.SecurityBrowserAvailable" Rest="Status.RestAvailable" GraphQl="Status.GraphQlAvailable" />

</section>

@code {
    [Parameter] public ManagedEdgeRuntime? Runtime { get; set; }
    [Parameter] public FrontendAnalysisProfile? Profile { get; set; }
    [Parameter] public TargetEnvironmentDetectionResult? Detection { get; set; }
    private ManagedEdgeStatus Status => Runtime?.For(Profile) ?? new() { State = ManagedEdgeState.NotConfigured };
    private ManagedEdgePreflightResult? Preflight => Runtime?.PreflightFor(Profile);
    private string SafeOrigin => Uri.TryCreate(Profile?.TargetUrl, UriKind.Absolute, out var uri) ? uri.GetLeftPart(UriPartial.Authority) : "Configure a Frontend URL";
    private static string PolicyLabel(EdgeRemoteDebuggingPolicyStatus status) => status switch
    {
        EdgeRemoteDebuggingPolicyStatus.Allowed => "Allowed",
        EdgeRemoteDebuggingPolicyStatus.Blocked => "Blocked",
        EdgeRemoteDebuggingPolicyStatus.NotConfigured => "Not configured",
        _ => "Unknown"
    };
    private string EndpointLabel => Preflight is null ? "Not checked"
        : Preflight.RemoteDebuggingRuntimeActive ? "Ready"
        : Preflight.PortInUseByOtherService ? "Occupied by a non-CDP service"
        : "Unreachable";
    private string TargetTabLabel => Status.OriginMatched ? (Status.ProxiedDelivery ? Status.DeliveryOrigin : Status.TargetOrigin) ?? "Matched"
        : Status.State == ManagedEdgeState.TargetTabNotInspectable ? "Found, but Edge refuses debugger attachment (protected session)"
        : Status.State == ManagedEdgeState.ProxiedDeliveryUncorrelated ? "Proxied tab found, but not correlated to the target"
        : Status.State == ManagedEdgeState.ProxiedDeliveryNotPermitted ? "Proxied delivery found, but this environment permits exact-origin delivery only"
        : Status.State == ManagedEdgeState.AmbiguousTargetTabs ? "Multiple tabs found — keep exactly one"
        : "Not found";
    /// <summary>The SAVED policy (draft while editing). Read-only here: the control lives in the Authentication configuration.</summary>
    private string ConfiguredTrustLabel => Profile is null ? "—" : BrowserDeliveryTrustLabels.PolicyShort(Profile.Authentication.BrowserDeliveryTrust);
    private string ManualSignInLabel => Status.AuthenticatedBrowserAvailable ? "User completed — browser access verified"
        : Status.State is ManagedEdgeState.ConnectedUnproven ? "Waiting — sign in manually in the connected Edge tab, then verify"
        : Status.State == ManagedEdgeState.TargetTabNotInspectable ? "Required — cannot be verified through CDP for this protected tab"
        : Status.State == ManagedEdgeState.ProxiedDeliveryNotPermitted ? "Blocked — browser delivery is proxied by Microsoft Defender for Cloud Apps, but this environment permits exact-origin delivery only"
        : "Required — complete sign-in manually in the test Edge instance";
    private Task Check() => Runtime is not null && Profile is not null ? Runtime.CheckCompatibilityAsync(Profile) : Task.CompletedTask;
    private Task Launch() => Runtime is not null && Profile is not null ? Runtime.LaunchEdgeAsync(Profile) : Task.CompletedTask;
    private Task Connect() => Runtime is not null && Profile is not null ? Runtime.ConnectAsync(Profile) : Task.CompletedTask;
    private Task Verify() => Runtime?.VerifyAsync() ?? Task.CompletedTask;
    private Task Disconnect() => Runtime?.DisconnectAsync() ?? Task.CompletedTask;
}
