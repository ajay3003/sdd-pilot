@using BirkNext.Web.Models

<div class="fa-endpoint-proposal" data-field="@Field" style="display:grid;grid-template-columns:1fr auto;gap:1rem;align-items:start;padding:1rem;background:var(--color-surface-subtle);border:1px solid var(--color-border);border-radius:0.5rem;margin-bottom:0.75rem">
    <div style="display:flex;flex-direction:column;gap:0.5rem">
        <div style="display:flex;align-items:baseline;gap:0.75rem">
            <strong style="font-size:0.95rem">@Label</strong>
            @* Keep status and confidence on one line so the text reads "Status · Confidence" without stray whitespace. *@
            <span style="font-size:0.8rem;color:var(--color-text-subtle)">@(Evidence?.Status ?? EndpointEvidenceStatus.Candidate) · <span style="@(Evidence?.Confidence == DetectionConfidence.Low ? "color:var(--color-warning)" : "color:var(--color-success)")">@(Evidence?.Confidence ?? DetectionConfidence.Low)</span></span>
        </div>
        <div style="font-family:monospace;font-size:0.9rem;overflow-wrap:break-word;word-break:break-all">@Value</div>
        <div style="font-size:0.8rem;color:var(--color-text-subtle)">Source: @SourceLabel@(Evidence is null ? "" : $" ({Evidence.LocationCategory})")</div>
        @if (!string.IsNullOrWhiteSpace(Evidence?.Value)) {
            <div style="font-size:0.8rem;color:var(--color-text-subtle)">@Evidence.Value</div>
        }
        <div style="font-size:0.8rem;color:var(--color-text-subtle)">Probe: @ProbeLabel@HttpDetails</div>
        @if (Evidence?.OpenApiKind is OpenApiResourceKind.SwaggerUi or OpenApiResourceKind.OpenApiDocument)
        {
            <div style="font-size:0.75rem;color:var(--color-text-muted)">@(Evidence.OpenApiKind == OpenApiResourceKind.SwaggerUi ? "Swagger UI URL; not a confirmed contract document" : "OpenAPI document URL")</div>
        }
    </div>
    @if (CanApply)
    {
        <button type="button" class="btn-secondary fa-btn-sm" @onclick="OnApply" style="white-space:nowrap;align-self:flex-start;margin-top:0.25rem" title="Apply this @(Label.ToLowerInvariant()) endpoint">
            @ApplyLabel
        </button>
    }
</div>

@code {
    [Parameter] public string Field { get; set; } = "";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? Value { get; set; }
    [Parameter] public string ApplyLabel { get; set; } = "";
    [Parameter] public bool CanApply { get; set; }
    [Parameter] public EventCallback OnApply { get; set; }
    [Parameter] public DiscoveryEvidence? Evidence { get; set; }
    private string SourceLabel => Evidence?.Type switch
    {
        DiscoveryEvidence.EvidenceType.StructuredConfig => "Structured config",
        DiscoveryEvidence.EvidenceType.ConventionalCandidate => "Conventional path",
        DiscoveryEvidence.EvidenceType.SafeProbe => "Safe probe",
        DiscoveryEvidence.EvidenceType.HtmlReference => "HTML reference",
        DiscoveryEvidence.EvidenceType.WasmAsset => "WASM asset",
        DiscoveryEvidence.EvidenceType.HintExtractor => "Project hint",
        _ => "Evidence unavailable"
    };
    private string ProbeLabel => (Evidence?.ProbeStatus ?? EndpointProbeStatus.NotPerformed) switch
    {
        EndpointProbeStatus.NotPerformed => "Not performed",
        EndpointProbeStatus.ResponseReceived => "Response received",
        EndpointProbeStatus.SizeLimitExceeded => "Response size limit exceeded",
        var status => status.ToString()
    };
    private string HttpDetails => Evidence?.HttpStatus is int status ? $" · HTTP {status} · {Evidence.ContentType ?? "Content type unavailable"}" : "";
}
