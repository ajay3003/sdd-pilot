@using BirkNext.Integrations
@using BirkNext.Web.Services
@inject IServiceProvider Services

@* Target Environment → Connected Systems: the canonical environment-specific setup of external systems (provider instances). Light by
   default — one card per system with the same five dimensions — and Advanced details on request. The Integration Catalog (Target Environment
   → Integrations) keeps logical producer→consumer integrations; IQR reviews their evidence; this page owns the systems they run against.
   Detect proposes systems from deterministic evidence and never saves; Add / Accept / Apply are explicit. *@
<section class="ei" data-testid="ei" aria-labelledby="ei-title">
    <header class="ei-head">
        <h3 id="ei-title" class="ei-title">Connected Systems</h3>
        <div class="ei-actions">
            @* Discover first, add manually second: Detect stays the primary action even when systems exist (new evidence can reveal more). *@
            <button type="button" class="btn btn-primary btn-sm" data-testid="ei-detect" disabled="@(_view is null || _busy)" @onclick="DetectAsync">Detect systems</button>
            <button type="button" class="btn btn-secondary btn-sm" data-testid="ei-add" disabled="@(_view is null)" @onclick="() => Toggle(Mode.Add)">Add system</button>
            <button type="button" class="btn btn-secondary btn-sm" data-testid="ei-import" disabled="@(_view is null)" @onclick="() => Toggle(Mode.Import)">Import setup</button>
            <button type="button" class="btn btn-secondary btn-sm" data-testid="ei-export" disabled="@(_view is null)" @onclick="() => Toggle(Mode.Export)">Export setup</button>
            <a class="btn btn-secondary btn-sm" data-testid="ei-library" href="@ExternalIntegrationPresentation.LibraryHref(EnvironmentId)">Setup Library</a>
        </div>
    </header>
    <ProjectContextStrip EnvironmentId="@EnvironmentId" />
    <p class="ei-muted ei-intro" data-testid="ei-intro">Configure the systems available in this environment. <a class="ug-learn-more" href="/user-guide#connected-systems" data-testid="ei-learn-more">Learn more</a></p>
    @if (_error is { } error) { <p class="ei-banner ei-banner-error" role="alert" data-testid="ei-error">@error</p> }
    @if (_notice is { } notice) { <p class="ei-banner" role="status" data-testid="ei-notice">@notice</p> }

    @if (_view is null)
    {
        <p class="ei-muted" role="status" data-testid="ei-loading">@(_error is null ? "Loading connected systems…" : "Connected systems are not available.")</p>
    }
    else
    {
        @if (_mode == Mode.Add)
        {
            var descriptor = _view.Providers.First(p => p.Type == _newProvider);
            <section class="ei-add" data-testid="ei-add-form" aria-label="Add system">
                <div class="ei-form-row">
                    <label>Name <input class="form-control" data-testid="ei-name" @bind="_newName" placeholder="e.g. Altinn – Skolenærvær" /></label>
                    <label>External integration type
                        <select class="form-select" data-testid="ei-provider" value="@_newProvider" @onchange="e => { _newProvider = Enum.Parse<ExternalProviderType>(e.Value!.ToString()!); _newSettings = []; }">
                            @foreach (var provider in _view.Providers) { <option value="@provider.Type">@provider.DisplayName</option> }
                        </select>
                    </label>
                    <label>Environment <input class="form-control" data-testid="ei-environment" @bind="_newEnvironment" placeholder="e.g. TT02, QA" /></label>
                    <label class="ei-check"><input type="checkbox" @bind="_newEnabled" /> Enabled</label>
                </div>
                <p class="ei-muted" data-testid="ei-provider-description">@descriptor.Description</p>
                <ProviderSettingsFields @key="_newProvider" Descriptor="descriptor" Values="_newSettings" Disabled="_busy" />
                <button type="button" class="btn btn-primary btn-sm" data-testid="ei-create" disabled="@(_busy || string.IsNullOrWhiteSpace(_newName))" @onclick="CreateAsync">Save integration</button>
            </section>
        }
        @if (_mode is Mode.Import or Mode.Export)
        {
            <SetupPackagePanel @key="_mode" EnvironmentId="@EnvironmentId" Import="@(_mode == Mode.Import)" Integrations="@_view.Integrations.Select(i => i.Integration).ToList()"
                               Providers="_view.Providers" OnApplied="ReloadAsync" />
        }

        @if (_view.Proposals.Count > 0)
        {
            @* Detected proposals: Accept is the next safe action (primary), one per proposal and always explicit; nothing is saved by Detect. An
               ambiguous proposal or one that matches a configured system never offers a blind Accept. *@
            <section class="ei-proposals" data-testid="ei-proposals" aria-labelledby="ei-proposals-heading">
                <h4 class="ei-h4" id="ei-proposals-heading" tabindex="-1">Detected systems <span class="ei-muted">(@_view.Proposals.Count pending · nothing saved)</span></h4>
                @foreach (var proposal in _view.Proposals)
                {
                    var configured = IsConfigured(proposal);
                    <div class="ei-proposal" data-testid="ei-proposal" data-provider="@proposal.ProviderType" data-state="@(configured ? "configured" : proposal.Ambiguous ? "ambiguous" : "pending")">
                        <strong>@proposal.Name</strong> · @ExternalIntegrationPresentation.ProviderLabel(proposal.ProviderType, _view.Providers)
                        <span class="ei-muted" data-testid="ei-proposal-provenance">Detected from: @proposal.DetectedFrom · @proposal.Reason</span>
                        @if (configured)
                        {
                            <span class="ei-muted" data-testid="ei-proposal-configured">Already configured — nothing to accept.</span>
                        }
                        else if (proposal.Ambiguous)
                        {
                            <span class="ei-proposal-decision" data-testid="ei-proposal-ambiguous">Needs a decision: the evidence matches more than one system. Review it and add the right one with Add system; nothing is accepted for you.</span>
                        }
                        else
                        {
                            <button type="button" class="btn btn-primary btn-sm" data-testid="ei-accept" disabled="@_busy" @onclick="() => AcceptAsync(proposal)"
                                    aria-label="@($"Accept detected system {proposal.Name}")">Accept detected system</button>
                        }
                    </div>
                }
            </section>
        }

        @if (_view.Integrations.Count == 0)
        {
            <p class="ei-muted" data-testid="ei-empty">No connected systems yet. Start with Detect systems. Add a system manually only if it cannot be discovered from project evidence.</p>
        }
        <div class="ei-cards">
            @foreach (var item in _view.Integrations)
            {
                var integration = item.Integration;
                var open = _open.Contains(integration.Id);
                <article class="ei-card" data-testid="ei-card" data-provider="@integration.ProviderType" aria-label="@integration.Name">
                    @* System identity first; while open, Close sits at the far right of this header — never in the provider's action row. *@
                    <header class="ei-card-head" data-testid="ei-card-head">
                        <div class="ei-card-identity">
                            <h4 class="ei-card-title">@integration.Name</h4>
                            <span class="ei-muted">@ExternalIntegrationPresentation.ProviderLabel(integration.ProviderType, _view.Providers)@(integration.EnvironmentName is { } env ? $" · {env}" : "")@(integration.Enabled ? "" : " · disabled")</span>
                        </div>
                        @if (open)
                        {
                            <button type="button" id="@($"ei-toggle-{integration.Id}")" class="btn btn-link btn-sm ei-close" data-testid="ei-review" aria-expanded="true" aria-label="@($"Close {integration.Name}")" @onclick="() => ToggleOpen(integration.Id)">Close</button>
                        }
                    </header>
                    @if (!open)
                    {
                        <dl class="ei-dims" data-testid="ei-dims">
                            @foreach (var dim in ExternalIntegrationPresentation.Dimensions(item.Summary))
                            {
                                <div data-key="@dim.Key"><dt>@dim.Label</dt><dd><span class="ei-pill ei-pill-@ExternalIntegrationPresentation.Tone(dim.State)" title="@dim.Reason">@ExternalIntegrationPresentation.Label(dim.State)</span></dd></div>
                            }
                            @if (item.TestData is { } td)
                            {
                                <div data-key="test-data" data-testid="ei-dim-test-data"><dt>Test Data</dt><dd><span class="ei-pill ei-pill-@ExternalIntegrationPresentation.Tone(td.Readiness.State)" title="@td.Readiness.Reason">@td.StatusLabel</span></dd></div>
                            }
                        </dl>
                    }
                    @if (!open)
                    {
                        <div class="ei-card-actions">
                            <button type="button" id="@($"ei-toggle-{integration.Id}")" class="btn btn-secondary btn-sm" data-testid="ei-review" aria-expanded="false" @onclick="() => ToggleOpen(integration.Id)">Review</button>
                        </div>
                    }
                    @if (open)
                    {
                        @* Every provider renders in the shared compact shell: Altinn through its own component, every other provider through the
                           generic panel (its own fields only). *@
                        <div class="ei-review" data-testid="ei-review-body">
                            @if (integration.ProviderType == ExternalProviderType.Altinn)
                            {
                                <AltinnEnvironmentPane EnvironmentId="@EnvironmentId" OpenContract="@(string.Equals(Focus, "altinn-contract", StringComparison.OrdinalIgnoreCase))" />
                            }
                            else
                            {
                                <GenericProviderPanel @key="integration.Id" EnvironmentId="@EnvironmentId" View="item" Descriptor="@_view.Providers.First(p => p.Type == integration.ProviderType)"
                                                      OnChanged="Replace" OnRemoved="RemovedAsync" />
                            }
                            @* Test Data is its own section (not under advanced details): requirements, bindings, suggestions. *@
                            <ConnectedSystemTestDataPanel @key="@($"td-{integration.Id}")" EnvironmentId="@EnvironmentId" IntegrationId="@integration.Id" View="item.TestData"
                                                          OnChanged="view => ReplaceTestData(integration.Id, view)" />
                        </div>
                    }
                </article>
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public string EnvironmentId { get; set; } = "";
    /// <summary>"altinn" opens the Altinn system's review (deep links from consumers such as Skolenærvær).</summary>
    [Parameter] public string? Focus { get; set; }

    private enum Mode { None, Add, Import, Export }
    private IExternalIntegrationsApiService? _api;
    private ExternalIntegrationsView? _view;
    private Mode _mode;
    private bool _busy;
    private string? _error, _notice, _loadedFor;
    private readonly HashSet<string> _open = new(StringComparer.Ordinal);
    private string? _newName, _newEnvironment;
    private ExternalProviderType _newProvider = ExternalProviderType.Altinn;
    private Dictionary<string, string> _newSettings = [];
    private bool _newEnabled = true;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == EnvironmentId) return;
        _loadedFor = EnvironmentId;
        _api = Services.GetService(typeof(IExternalIntegrationsApiService)) as IExternalIntegrationsApiService;
        if (_api is null) { _error = "Connected systems are not available in this host."; return; }
        await ReloadAsync();
        var altinnFocus = Focus?.StartsWith("altinn", StringComparison.OrdinalIgnoreCase) == true;
        if (altinnFocus && _view?.Integrations.FirstOrDefault(i => i.Integration.ProviderType == ExternalProviderType.Altinn) is { } altinn)
            _open.Add(altinn.Integration.Id);
        else if (altinnFocus) { _mode = Mode.Add; _newProvider = ExternalProviderType.Altinn; }
    }

    private async Task ReloadAsync()
    {
        if (_api is null) return;
        var result = await _api.ListAsync(EnvironmentId);
        if (result.Value is { } view) { _view = view with { Proposals = _view?.Proposals ?? [] }; _error = null; } else _error = result.Error;
    }

    private void Toggle(Mode mode) => _mode = _mode == mode ? Mode.None : mode;
    /// <summary>Opens or closes a system. Close and Review are different buttons, so focus moves to the one that replaces the clicked one.</summary>
    private void ToggleOpen(string id) { if (!_open.Remove(id)) _open.Add(id); _focusToggle = $"ei-toggle-{id}"; }

    private string? _focusToggle;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusToggle is not { } target || Services.GetService<IJSRuntime>() is not { } js) return;
        _focusToggle = null;
        try { await js.InvokeVoidAsync("birknextFocusElement", target); } catch (JSException) { } catch (InvalidOperationException) { }
    }

    /// <summary>A proposal that names an already configured system (same provider and name) offers no Accept.</summary>
    private bool IsConfigured(ExternalIntegrationProposal proposal) => _view?.Integrations.Any(i => i.Integration.ProviderType == proposal.ProviderType
        && string.Equals(i.Integration.Name.Trim(), proposal.Name.Trim(), StringComparison.OrdinalIgnoreCase)) == true;

    private async Task Run(Func<Task> action) { _busy = true; _error = null; try { await action(); } finally { _busy = false; } }

    private Task DetectAsync() => Run(async () =>
    {
        var result = await _api!.DetectAsync(EnvironmentId);
        if (result.Value is { } view)
        {
            _view = view;
            _notice = view.Proposals.Count == 0 ? "Nothing new detected. Nothing was saved." : $"{view.Proposals.Count} integration(s) detected. Nothing was saved: review and accept.";
            // The result region takes focus (it is what the user asked for): the next Tab reaches the first Accept.
            if (view.Proposals.Count > 0) _focusToggle = "ei-proposals-heading";
        }
        else _error = result.Error;
    });

    /// <summary>A provider panel saved, detected or refreshed one integration: replace it in place (its card and review stay open).</summary>
    private void Replace(ExternalIntegrationView one)
    {
        if (_view is null) return;
        _view = _view with { Integrations = [.. _view.Integrations.Select(i => i.Integration.Id == one.Integration.Id ? one : i)] };
    }

    /// <summary>Test Data bindings were applied or cleared: refresh that system's Test Data dimension in place.</summary>
    private void ReplaceTestData(string id, ConnectedSystemTestDataView view)
    {
        if (_view is null) return;
        _view = _view with { Integrations = [.. _view.Integrations.Select(i => i.Integration.Id == id ? i with { TestData = view } : i)] };
    }

    private async Task RemovedAsync(string id) { _open.Remove(id); await ReloadAsync(); }

    private Task CreateAsync() => Run(async () =>
    {
        var result = await _api!.SaveAsync(EnvironmentId, null, new ExternalIntegrationRequest(_newName!.Trim(), _newProvider, _newEnvironment, _newEnabled, new(_newSettings)));
        if (result.Value is { } created) { _notice = $"{created.Integration.Name} saved."; _mode = Mode.None; _newName = null; _newSettings = []; await ReloadAsync(); _open.Add(created.Integration.Id); }
        else _error = result.Error;
    });

    private Task AcceptAsync(ExternalIntegrationProposal proposal) => Run(async () =>
    {
        var result = await _api!.SaveAsync(EnvironmentId, null, new ExternalIntegrationRequest(proposal.Name, proposal.ProviderType, proposal.EnvironmentName, true, proposal.Settings));
        if (result.Value is { } created)
        {
            // The other proposals stay pending: a reload returns configured systems only, so they are carried over (minus any now configured).
            var pending = _view!.Proposals.Where(p => p != proposal).ToList();
            await ReloadAsync();
            if (_view is not null) _view = _view with { Proposals = [.. pending.Where(p => !IsConfigured(p))] };
            _notice = $"{created.Integration.Name} accepted · review it.{(pending.Count > 0 ? $" {pending.Count} detected system(s) still pending." : "")}";
            _open.Add(created.Integration.Id);
        }
        else _error = result.Error;
    });

}
