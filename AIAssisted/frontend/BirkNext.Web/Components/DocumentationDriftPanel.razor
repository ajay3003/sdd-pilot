@using BirkNext.Web.Models
@using BirkNext.Web.Services
@inject IServiceProvider ServiceProvider

@* Documentation Drift: version comparison inside one project lineage, authored ↔ generated consistency inside one import, and manual
   comparison of any two documents. Overview lists imported projects (never a revision chain across projects), Changes walks the versions
   of one document identity within its project, Drift separates equivalent-scope pairs from related documentation whose scope differs.
   Selection, mode, comparison and saved results only — nothing here edits, regenerates, compares automatically or picks a winner. *@
<section class="dd" aria-label="Documentation Drift" data-testid="dd-panel" data-view="@View">
    @if (_catalog.Count == 0)
    {
        <div class="dd-empty" data-testid="dd-empty">
            <p><strong>No documentation artifacts yet.</strong> Import a project, or open Specification, Plan, Tasks or other Markdown documents in the explorers; their revisions appear here. Generated documentation is captured from Project Import automatically — no separate upload.</p>
        </div>
    }
    else if (View == "overview")
    {
        @Overview()
    }
    else if (View == "changes")
    {
        @Changes()
    }
    else if (View == "drift")
    {
        @Drift()
    }
    else
    {
        @Compare()
    }
</section>

@code {
    /// <summary>compare (default), overview, changes or drift.</summary>
    [Parameter] public string View { get; set; } = "compare";
    /// <summary>Asks the page to show another view (e.g. "Open in Compare"); the comparison state stays with this component.</summary>
    [Parameter] public EventCallback<string> OnViewChange { get; set; }
    /// <summary>Context from another page: the import, module and concern to preselect in the composite comparison. Nothing is run or saved.</summary>
    [Parameter] public string? PreselectImport { get; set; }
    [Parameter] public string? PreselectModule { get; set; }
    [Parameter] public string? PreselectConcern { get; set; }

    private IReadOnlyList<DriftDocument> _catalog = [];
    private IReadOnlyList<DriftImport> _imports = [];
    private DriftDocument? _left, _right;
    private DriftIntent _mode = DriftIntent.VersionDrift;
    private string _identity = "", _fromId = "", _toId = "", _consistencyImport = "", _changesLineage = "", _changesIdentity = "", _changesFrom = "", _changesTo = "";
    private DriftComparisonResult? _result;
    private bool _savedCurrent;
    private string? _reopened;
    // Composite authored intent ↔ generated (structured). Nothing is compared until Compare; nothing is saved until Save.
    private string _groupKey = "", _contributorId = "";
    private DataModelConsistencyResult? _composite;
    private CompositeAuthoredIntent? _intentPreview;
    private SddDocumentationDriftComparison? _savedComposite;
    private static readonly DataModelAnalysisService Parser = new();

    private WorkspaceArtifactRepository? Repository => ServiceProvider.GetService(typeof(IWorkspaceArtifactRepository)) as WorkspaceArtifactRepository
        ?? ServiceProvider.GetService(typeof(WorkspaceArtifactRepository)) as WorkspaceArtifactRepository;
    private SddLifecycleState? Lifecycle => Repository?.SddLifecycle;
    private IReadOnlyList<SddDocumentationDriftComparison> Saved => Lifecycle?.DocumentationDriftComparisons ?? [];
    private string? FocusImport => Lifecycle is { } state ? DocumentationDrift.FocusImportId(state) : null;

    protected override void OnInitialized()
    {
        if (Lifecycle is not { } state) return;
        _catalog = DocumentationDrift.Catalog(state);
        _imports = DocumentationDrift.Imports(state);
        _consistencyImport = FocusImport ?? "";
        _changesLineage = _imports.FirstOrDefault(i => i.ImportId == FocusImport)?.LineageKey ?? _imports.LastOrDefault()?.LineageKey ?? "";
        // Without any same-lineage revision, Compare opens on the mode that can do something.
        if (!DocumentationDrift.Identities(_catalog).Any(i => i.Versions.Count > 1)) _mode = FocusImport is null ? DriftIntent.Manual : DriftIntent.ConsistencyDrift;
        // Combined authored intent ↔ generated is the recommended default wherever a module + concern candidate exists.
        if (FocusImport is not null && DocumentationDriftComposite.CandidateGroups(_catalog, Saved, FocusImport).Any(g => g.State == DriftGroupState.ComparisonAvailable))
            _mode = DriftIntent.CompositeConsistency;
        if (PreselectModule is { Length: > 0 } module && Enum.TryParse<DriftConcern>(PreselectConcern, out var concern))
        {
            if (PreselectImport is { Length: > 0 } import && _imports.Any(i => i.ImportId == import)) _consistencyImport = import;
            if (Groups.FirstOrDefault(g => g.Concern == concern && g.Module.Equals(module, StringComparison.OrdinalIgnoreCase)) is { } group)
            {
                _mode = DriftIntent.CompositeConsistency; _groupKey = group.Key; PreviewIntent();
            }
        }
    }

    // ── Compare ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
    private RenderFragment Compare() => __builder =>
    {
        <p class="dd-note" data-testid="dd-authority">Authored documents are intent and design evidence; generated documents are implementation-derived documentation. Raw source stays with Source Analysis and runtime evidence stays separate. A comparison shows how two documents differ — it never decides which one is right.</p>

        <div class="dd-type" data-testid="dd-comparison-type">
            <label class="dd-field">Comparison mode
                <select data-testid="dd-mode" @onchange="ModeChanged">
                    @foreach (var mode in new[] { DriftIntent.CompositeConsistency, DriftIntent.ContributionConsistency, DriftIntent.VersionDrift, DriftIntent.ConsistencyDrift, DriftIntent.Manual })
                    {
                        <option value="@mode" selected="@(_mode == mode)">@DocumentationDrift.ComparisonType(mode)</option>
                    }
                </select>
            </label>
            <p class="dd-note" data-testid="dd-mode-help">@ModeHelp(_mode)</p>
        </div>

        @if (_mode is DriftIntent.CompositeConsistency or DriftIntent.ContributionConsistency)
        {
            @CompositeView()
            return;
        }
        @if (_mode == DriftIntent.VersionDrift) { @VersionSelectors() }
        else if (_mode == DriftIntent.ConsistencyDrift) { @ConsistencySelectors() }
        else { @ManualSelectors() }

        @if (_left is not null || _right is not null)
        {
            <div class="dd-sides">
                @Provenance("Left", "left", _left)
                @Provenance("Right", "right", _right)
            </div>
        }

        <div class="dd-run" data-testid="dd-run-controls">
            <p class="dd-scope" data-testid="dd-scope">Scope: <strong>@DocumentationDrift.WholeDocument</strong></p>
            @if (_left is not null && _right is not null)
            {
                <p class="dd-context" data-testid="dd-revision-context" role="status">@DocumentationDrift.RevisionContext(_left, _right) · @DocumentationDrift.ContentState(_left, _right)</p>
                @if (DocumentationDrift.PackContext(_left, _right) is { } crossPack) { <p class="dd-context" data-testid="dd-cross-pack" role="status"><strong>@crossPack</strong></p> }
            }
            @if (_mode == DriftIntent.Manual) { <p class="dd-note" data-testid="dd-manual-note">@DocumentationDrift.ManualNote</p> }
            @if (DocumentationDrift.Guard(_mode, _left, _right) is { } guard && (_left is not null || _right is not null)) { <p class="dd-note" data-testid="dd-guard">@guard</p> }
            <button type="button" class="btn-primary" data-testid="dd-run" disabled="@(DocumentationDrift.Guard(_mode, _left, _right) is not null)" @onclick="Run">@(NeedsAnyway ? "Compare anyway" : "Compare")</button>
        </div>

        @if (_result is null)
        {
            <p class="dd-empty-line" data-testid="dd-no-result">@DocumentationDrift.NoResult</p>
        }
        else
        {
            @Result()
        }
    };

    private bool NeedsAnyway => _mode == DriftIntent.Manual && _left is not null && _right is not null && DocumentationDrift.Guard(_left, _right) is null
        && DocumentationDriftPresentation.NeedsConfirmation(DocumentationDriftPresentation.Compatibility(_left, _right).Level);

    private static string ModeHelp(DriftIntent mode) => mode switch
    {
        DriftIntent.VersionDrift => "The same document identity across imports or revisions of one project. Imports of different projects are never versions of each other.",
        DriftIntent.CompositeConsistency => "Recommended: every authored document of one module and documentation area combined into one authored intent (with provenance), compared concept by concept with that module's generated document. " + DocumentationDrift.NeutralReview,
        DriftIntent.ContributionConsistency => "Review whether the intent contributed by this authored artifact is represented consistently in the generated implementation-derived documentation. Only concepts this artifact states are compared.",
        DriftIntent.ConsistencyDrift => "An authored and a generated document of the same import, compared as text. Consistency, not version history: " + DocumentationDrift.NeutralReview,
        _ => "Advanced: any two documents you choose — cross-module, cross-import or cross-type. A compatibility assessment is shown before you compare; scope equivalence is never assumed and the result lists differences only.",
    };

    /// <summary>Version comparison: a document identity with more than one version in its own project, then two of those versions.</summary>
    private RenderFragment VersionSelectors() => __builder =>
    {
        var identities = DocumentationDrift.Identities(_catalog).Where(i => i.Versions.Count > 1).ToList();
        var identity = identities.FirstOrDefault(i => i.LogicalKey == _identity);
        @if (identities.Count == 0)
        {
            <p class="dd-empty-line" data-testid="dd-version-none">No same-project document revisions are available yet. Version comparison needs the same document in two imports or revisions of one project.</p>
            return;
        }
        <div class="dd-side-fields" data-testid="dd-version-selectors">
            <label class="dd-field dd-field-wide">Document
                <select data-testid="dd-version-identity" value="@_identity" @onchange="e => SelectVersionIdentity(e.Value?.ToString() ?? string.Empty)">
                    <option value="">Select a document…</option>
                    @foreach (var group in identities.GroupBy(i => ProjectOf(i.LineageKey)))
                    {
                        <optgroup label="@group.Key">@foreach (var i in group) { <option value="@i.LogicalKey">@i.Label (@i.Versions.Count versions)</option> }</optgroup>
                    }
                </select>
            </label>
            @if (identity is not null)
            {
                <label class="dd-field">Earlier version
                    <select data-testid="dd-version-from" value="@_fromId" @onchange="e => { _fromId = e.Value?.ToString() ?? string.Empty; ApplyVersionPair(identity); }">
                        @foreach (var v in identity.Versions) { <option value="@v.Id">@VersionText(v)</option> }
                    </select>
                </label>
                <label class="dd-field">Later version
                    <select data-testid="dd-version-to" value="@_toId" @onchange="e => { _toId = e.Value?.ToString() ?? string.Empty; ApplyVersionPair(identity); }">
                        @foreach (var v in identity.Versions) { <option value="@v.Id">@VersionText(v)</option> }
                    </select>
                </label>
            }
        </div>
    };

    /// <summary>Authored ↔ generated consistency: one import, an authored document and a generated document of that import.</summary>
    private RenderFragment ConsistencySelectors() => __builder =>
    {
        var docs = _catalog.Where(d => d.ProjectImportId == _consistencyImport && d.Supported).ToList();
        var authored = docs.Where(d => d.Origin == DriftOrigin.Authored).ToList();
        var generated = docs.Where(d => d.Origin == DriftOrigin.Generated).ToList();
        <div class="dd-side-fields" data-testid="dd-consistency-selectors">
            <label class="dd-field">Imported project
                <select data-testid="dd-consistency-import" value="@_consistencyImport" @onchange="e => { _consistencyImport = e.Value?.ToString() ?? string.Empty; _left = _right = null; ResetResult(); }">
                    @foreach (var i in _imports) { <option value="@i.ImportId">@i.Label</option> }
                </select>
            </label>
            <label class="dd-field">Authored document
                <select data-testid="dd-left-document" value="@(_left?.Id ?? "")" @onchange="e => Select(true, e.Value?.ToString() ?? string.Empty)">
                    <option value="">Select a document…</option>
                    @foreach (var o in authored) { <option value="@o.Id">@DocumentationDrift.KindLabel(o) · @o.Path.Replace('\\', '/')</option> }
                </select>
            </label>
            <label class="dd-field">Generated document
                <select data-testid="dd-right-document" value="@(_right?.Id ?? "")" @onchange="e => Select(false, e.Value?.ToString() ?? string.Empty)">
                    <option value="">Select a document…</option>
                    @foreach (var o in generated) { <option value="@o.Id">@DocumentationDrift.KindLabel(o) · @o.Path.Replace('\\', '/')</option> }
                </select>
            </label>
        </div>
        @if (generated.Count == 0) { <p class="dd-note" data-testid="dd-consistency-no-generated">@DocumentationDrift.GeneratedNotPresent</p> @GeneratedMissing(_consistencyImport) }
        @if (_left is { Origin: DriftOrigin.Authored } a && _right is { Origin: DriftOrigin.Generated } g)
        {
            var pair = DocumentationDrift.Candidates(_catalog, Saved, _consistencyImport).FirstOrDefault(c => c.Authored.Id == a.Id && c.Generated.Id == g.Id);
            <dl class="dd-facts" data-testid="dd-pairing">
                <div><dt>Authored scope</dt><dd>@DocumentationDrift.ScopeOf(a)</dd></div>
                <div><dt>Generated scope</dt><dd>@DocumentationDrift.ScopeOf(g)</dd></div>
                <div><dt>Relationship</dt><dd data-testid="dd-pairing-relationship">@(pair is null ? "Manual relationship — not a deterministic pair" : PairingText(pair.Pairing))</dd></div>
            </dl>
        }
    };

    /// <summary>
    /// Advanced comparison: any two documents, chosen with searchable keyboard comboboxes (type to filter by type, path or import; arrow keys
    /// and Enter pick). A deterministic compatibility assessment warns before Compare — it never blocks.
    /// </summary>
    private RenderFragment ManualSelectors() => __builder =>
    {
        var supported = _catalog.Where(d => d.Supported).ToList();
        <datalist id="dd-document-options">@foreach (var o in supported) { <option value="@DocumentationDriftPresentation.SearchText(o)"></option> }</datalist>
        <div class="dd-sides" data-testid="dd-manual-selectors">
            @foreach (var (title, key, selected) in new[] { ("Left", "left", _left), ("Right", "right", _right) })
            {
                var left = key == "left";
                <fieldset class="dd-side" data-testid="@($"dd-side-{key}")">
                    <legend>@title</legend>
                    <label class="dd-field" for="@($"dd-{key}-search")">Document (type to search)</label>
                    <input id="@($"dd-{key}-search")" type="search" role="combobox" list="dd-document-options" autocomplete="off" aria-autocomplete="list"
                           class="dd-combobox" data-testid="@($"dd-{key}-search")" placeholder="Type, path or import…"
                           value="@(selected is null ? "" : DocumentationDriftPresentation.SearchText(selected))"
                           @onchange="e => SelectBySearch(left, e.Value?.ToString() ?? string.Empty)" />
                </fieldset>
            }
        </div>
        @if (_left is not null && _right is not null && DocumentationDrift.Guard(_left, _right) is null)
        {
            var (level, reason) = DocumentationDriftPresentation.Compatibility(_left, _right);
            <div class="dd-compat dd-compat-@level.ToString().ToLowerInvariant()" role="status" data-testid="dd-compatibility" data-level="@level">
                <p><strong>Compatibility: @DocumentationDriftPresentation.Label(level)</strong> — @reason</p>
                @if (DocumentationDriftPresentation.NeedsConfirmation(level))
                {
                    <p data-testid="dd-compatibility-warning">These documents may not describe comparable content. You can still compare them; the result will say that scope equivalence is not assumed.</p>
                }
            </div>
        }
    };

    private void SelectBySearch(bool left, string text)
    {
        var document = _catalog.Where(d => d.Supported).FirstOrDefault(d => DocumentationDriftPresentation.SearchText(d) == text)
            ?? _catalog.FirstOrDefault(d => d.Supported && d.Id == text);
        if (left) _left = document; else _right = document;
        ResetResult();
    }

    private RenderFragment Provenance(string title, string key, DriftDocument? d) => __builder =>
    {
        <fieldset class="dd-side" data-testid="@($"dd-{key}-card")">
            <legend>@title</legend>
            @if (d is null)
            {
                <p class="dd-side-empty" data-testid="@($"dd-{key}-empty")">@DocumentationDrift.SelectDocument</p>
            }
            else
            {
                <dl class="dd-facts" data-testid="@($"dd-{key}-provenance")">
                    <div><dt>Origin</dt><dd>@d.Origin@(d.Origin == DriftOrigin.Generated ? " (implementation-derived)" : " (intent / design)")</dd></div>
                    <div><dt>Type</dt><dd>@DocumentationDrift.KindLabel(d)</dd></div>
                    <div><dt>Scope</dt><dd class="dd-wrap">@DocumentationDrift.ScopeOf(d)</dd></div>
                    <div><dt>Path</dt><dd class="dd-wrap"><code>@d.Path</code></dd></div>
                    <div><dt>Import</dt><dd data-testid="@($"dd-{key}-project-revision")">@(d.ProjectRevision ?? "Manual workspace document (no project import)")</dd></div>
                    <div><dt>Artifact revision</dt><dd>@(d.RevisionNumber is { } n ? $"rev {n}" : d.Origin == DriftOrigin.Generated ? "— (generated document)" : "—")</dd></div>
                    @if (d.ArchiveName is { } archive) { <div><dt>Imported source</dt><dd class="dd-wrap" data-testid="@($"dd-{key}-imported-source")">@archive</dd></div> }
                    <div><dt>Fingerprint</dt><dd><code>@Short(d.Fingerprint)</code></dd></div>
                </dl>
                <details class="dd-tech">
                    <summary>Technical details</summary>
                    <dl class="dd-facts">
                        <div><dt>Global import order</dt><dd>@(d.GlobalRevision ?? "—") (storage order only, not a project revision)</dd></div>
                        <div><dt>Project lineage</dt><dd><code class="dd-wrap">@(d.LineageKey ?? "—")</code></dd></div>
                        <div><dt>Source snapshot</dt><dd><code class="dd-wrap">@(d.SourceSnapshotId?.ToString() ?? "None associated")</code></dd></div>
                        @if (d.Origin == DriftOrigin.Generated)
                        {
                            <div><dt>Generated documentation set</dt><dd class="dd-wrap">@d.GeneratedSetId</dd></div>
                            <div><dt>Generator</dt><dd>@(d.Generator ?? "Not proven")</dd></div>
                        }
                        <div><dt>Full fingerprint</dt><dd><code class="dd-wrap">@d.Fingerprint</code></dd></div>
                    </dl>
                </details>
                @if (!d.Supported) { <p class="dd-note">@DocumentationDrift.Unsupported</p> }
            }
        </fieldset>
    };

    /// <summary>The result of the current comparison (run here, in Changes, or reopened): counts in the pair's words, then the sections.</summary>
    private RenderFragment Result() => __builder =>
    {
        var result = _result!;
        <section class="dd-result" aria-labelledby="dd-result-title" data-testid="dd-result" data-intent="@result.Intent">
            <h3 id="dd-result-title">@DocumentationDrift.ComparisonType(result.Intent) · @result.RevisionContext</h3>
            @if (result.Intent == DriftIntent.Manual)
            {
                <p class="dd-note" data-testid="dd-result-manual"><strong>Advanced comparison · Scope equivalence not assumed.</strong> These artifacts are not assumed to describe equivalent scope.@(_left is not null && _right is not null ? $" Compatibility: {DocumentationDriftPresentation.Compatibility(_left, _right).Level}." : "")</p>
            }
            @if (_left is not null && _right is not null)
            {
                <p class="dd-note" data-testid="dd-result-pair">@DocumentationDrift.OptionText(_left) ↔ @DocumentationDrift.OptionText(_right)</p>
            }
            <p data-testid="dd-outcome"><strong>@result.Outcome</strong></p>
            @if (result.Counts.Count > 0)
            {
                <dl class="dd-counts" data-testid="dd-counts">@foreach (var (kind, count) in result.Counts.OrderBy(c => Enum.TryParse<DriftItemKind>(c.Key, out var k) ? (int)k : 99))
                {
                    <div><dt>@(Enum.TryParse<DriftItemKind>(kind, out var k) ? DocumentationDrift.Label(k, _left, _right) : kind)</dt><dd>@count</dd></div>
                }</dl>
            }
            <p class="dd-note" data-testid="dd-basis">@DocumentationDrift.ComparisonBasis</p>
            @if (result.Intent is DriftIntent.ConsistencyDrift or DriftIntent.AuthoredVsGenerated)
            {
                <p class="dd-note" data-testid="dd-neutral">@DocumentationDrift.NeutralReview</p>
                <p class="dd-note" data-testid="dd-source-boundary">@DocumentationDrift.SourceBoundary <a class="btn-link" href="source-analysis">Open Source Analysis</a></p>
            }
            @if (result.Items.Count > 0)
            {
                @RowsView(DocumentationDriftPresentation.Rows(result, _left, _right), "dd-item", SideName(_left, "Left"), SideName(_right, "Right"))
            }
            @if (!_savedCurrent) { <button type="button" class="btn-secondary" data-testid="dd-save" @onclick="SaveAsync">Save comparison</button> }
            else { <p class="dd-note" role="status" data-testid="dd-saved">Saved with exact artifact revisions, fingerprints, imports, project lineage, mode and scope.</p> }
            @if (_reopened is { } reopened) { <p class="dd-note" role="status" data-testid="dd-reopened">@reopened</p> }
        </section>
    };

    // ── Overview ────────────────────────────────────────────────────────────────────────────────────────────────────────────
    private RenderFragment Overview() => __builder =>
    {
        var state = Lifecycle!;
        var summaries = DocumentationDrift.ImportSummaries(state, _catalog);
        var identities = DocumentationDrift.Identities(_catalog);
        var authoredVersioned = identities.Count(i => i.Origin == DriftOrigin.Authored && i.Versions.Count > 1);
        var generatedVersioned = identities.Count(i => i.Origin == DriftOrigin.Generated && i.Versions.Count > 1);
        var candidates = DocumentationDrift.Candidates(_catalog, Saved, FocusImport);
        var focus = _imports.FirstOrDefault(i => i.ImportId == FocusImport);
        @Dashboard(summaries)
        <ReviewDisclosure Text="All imported projects and comparison availability" CollapseText="Hide all imported projects" TestId="dd-overview-all">
        <dl class="dd-summary" data-testid="dd-overview-summary">
            <div><dt>Imported projects</dt><dd data-testid="dd-sum-imports">@_imports.Count</dd></div>
            <div><dt>Version-comparable projects</dt><dd data-testid="dd-sum-lineages">@DocumentationDrift.VersionComparableLineages(_imports)</dd></div>
            <div><dt>Authored documents</dt><dd>@identities.Count(i => i.Origin == DriftOrigin.Authored)</dd></div>
            <div><dt>Generated documents</dt><dd>@identities.Count(i => i.Origin == DriftOrigin.Generated)</dd></div>
            <div><dt>Documents with version history</dt><dd data-testid="dd-sum-versioned">@(authoredVersioned + generatedVersioned)</dd></div>
            <div><dt>Saved comparisons</dt><dd>@Saved.Count</dd></div>
        </dl>

        <section aria-labelledby="dd-imports-title" data-testid="dd-revisions">
            <h3 id="dd-imports-title">Imported projects and documentation availability</h3>
            @if (summaries.Count == 0)
            {
                <p class="dd-note">No project imports yet — only manual workspace documents (@_catalog.Count(d => d.ProjectImportId is null)) can be compared.</p>
            }
            else
            {
                <div class="dd-scroll" tabindex="0" role="region" aria-label="Imported projects">
                    <table class="dd-table">
                        <thead><tr><th scope="col">Project</th><th scope="col">Import</th><th scope="col">Imported source</th><th scope="col">Source snapshot</th><th scope="col" class="dd-num">Authored docs</th><th scope="col" class="dd-num">Generated docs</th><th scope="col" class="dd-num">Modules with generated docs</th></tr></thead>
                        <tbody>
                            @foreach (var r in summaries)
                            {
                                <tr data-testid="dd-revision-row" data-import="@r.Import.Label" data-lineage="@r.Import.LineageKey" data-generated="@r.GeneratedState">
                                    <th scope="row" class="dd-wrap">@r.Import.ProjectName</th>
                                    <td>Import @r.Import.Number</td>
                                    <td class="dd-wrap">@r.Import.ArchiveName</td>
                                    <td><code class="dd-wrap">@(r.Import.SourceSnapshotId?.ToString() ?? "None")</code></td>
                                    <td class="dd-num">@r.AuthoredDocuments</td>
                                    <td class="dd-num">@(r.GeneratedState == "Present" ? r.GeneratedDocuments.ToString() : r.GeneratedState)</td>
                                    <td class="dd-num">@(r.GeneratedState == "Present" ? r.GeneratedModules.ToString() : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="dd-note" data-testid="dd-lineage-rule">@DocumentationDrift.LineageRule</p>
                <p class="dd-note" data-testid="dd-not-present-meaning">@DocumentationDrift.NotPresentMeaning</p>
                <p class="dd-note" data-testid="dd-gdh-link">@DocumentationDrift.GeneratedReviewNote <a class="btn-link" href="@NavigationCatalog.GeneratedDocumentationHealthRoute">Open Generated Documentation Health</a></p>
            }
        </section>

        <section aria-labelledby="dd-possible-title" data-testid="dd-possible">
            <h3 id="dd-possible-title">Comparison availability</h3>
            <ul class="dd-bullets">
                <li data-testid="dd-possible-version">Version comparison: @(authoredVersioned + generatedVersioned == 0 ? "no same-project document revisions available yet." : $"{authoredVersioned} authored and {generatedVersioned} generated document(s) with more than one version in their project.")</li>
                <li data-testid="dd-possible-consistency">Authored ↔ generated@(focus is null ? "" : $" in {focus.Label}"): @candidates.Count(c => c.Pairing == DriftPairing.Equivalent) equivalent-scope pair(s) · @candidates.Count(c => c.Pairing == DriftPairing.RelatedScopeDiffers) related document pair(s) whose scope differs — see Drift.</li>
                <li>Manual comparison: any two documents can be compared in Compare; the result is never treated as version history or drift.</li>
            </ul>
        </section>

        <section aria-labelledby="dd-history-title" data-testid="dd-history">
            <h3 id="dd-history-title">Recent comparisons</h3>
            @if (Saved.Count == 0)
            {
                <p class="dd-note">No saved comparisons for this workspace yet. @DocumentationDrift.NoResult</p>
            }
            else
            {
                <div class="dd-scroll" tabindex="0" role="region" aria-label="Recent comparisons">
                    <table class="dd-table">
                        <thead><tr><th scope="col">Saved</th><th scope="col">Mode</th><th scope="col">Left</th><th scope="col">Right</th><th scope="col">Outcome</th><th scope="col"><span class="visually-hidden">Open</span></th></tr></thead>
                        <tbody>
                            @foreach (var comparison in Saved.Take(10))
                            {
                                var c = comparison;
                                <tr data-testid="dd-history-row">
                                    <td>@c.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@DocumentationDrift.ComparisonType(DocumentationDrift.SavedIntent(c))</td>
                                    <td class="dd-wrap">@SideText(c.Left)</td>
                                    <td class="dd-wrap">@SideText(c.Right)</td>
                                    <td class="dd-wrap">@c.Outcome</td>
                                    <td><button type="button" class="btn-link" data-testid="dd-history-open" @onclick="() => Reopen(c)">Open<span class="visually-hidden"> comparison from @c.CreatedAt</span></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
        </ReviewDisclosure>
    };

    // ── Changes ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
    private RenderFragment Changes() => __builder =>
    {
        var lineages = _imports.GroupBy(i => i.LineageKey).Select(g => (Key: g.Key, Name: g.First().ProjectName, Imports: g.OrderBy(i => i.Number).ToList())).ToList();
        var lineage = lineages.FirstOrDefault(l => l.Key == _changesLineage);
        var identities = DocumentationDrift.Identities(_catalog).Where(i => lineage.Key is not null ? i.LineageKey == lineage.Key : i.LineageKey?.StartsWith("workspace:") == true).ToList();
        var identity = identities.FirstOrDefault(i => i.LogicalKey == _changesIdentity);
        <p class="dd-note" data-testid="dd-changes-intro"><strong>Changes = same-lineage revisions.</strong> How one document changed across the imports of its own project. Imports of other projects are never earlier revisions.</p>
        <div class="dd-side-fields">
            <label class="dd-field">Project
                <select data-testid="dd-changes-project" value="@_changesLineage" @onchange="e => { _changesLineage = e.Value?.ToString() ?? string.Empty; _changesIdentity = string.Empty; }">
                    @foreach (var l in lineages) { <option value="@l.Key">@l.Name (@l.Imports.Count import@(l.Imports.Count == 1 ? "" : "s"))</option> }
                    @if (_catalog.Any(d => d.ProjectImportId is null)) { <option value="">Manual workspace documents</option> }
                </select>
            </label>
            <label class="dd-field dd-field-wide">Document
                <select data-testid="dd-changes-identity" value="@_changesIdentity" @onchange="e => SelectChangesIdentity(e.Value?.ToString() ?? string.Empty)">
                    <option value="">Select a document…</option>
                    <optgroup label="Authored">@foreach (var i in identities.Where(x => x.Origin == DriftOrigin.Authored)) { <option value="@i.LogicalKey">@i.Label (@i.Versions.Count)</option> }</optgroup>
                    <optgroup label="Generated">@foreach (var i in identities.Where(x => x.Origin == DriftOrigin.Generated)) { <option value="@i.LogicalKey">@i.Label (@i.Versions.Count)</option> }</optgroup>
                </select>
            </label>
        </div>
        @if (identity is not null)
        {
            var imports = lineage.Imports ?? [];
            <div class="dd-scroll" tabindex="0" role="region" aria-label="Versions">
                <table class="dd-table" data-testid="dd-changes-versions">
                    <thead><tr><th scope="col">Import</th><th scope="col">Artifact revision</th><th scope="col">Fingerprint</th></tr></thead>
                    <tbody>
                        @foreach (var import in imports)
                        {
                            var here = identity.Versions.Where(v => v.ProjectImportId == import.ImportId).ToList();
                            @if (here.Count == 0 && imports.Count > 1)
                            {
                                <tr data-testid="dd-changes-version" data-present="false"><th scope="row">@import.Label</th><td colspan="2">Not present in this import</td></tr>
                            }
                            @foreach (var v in here)
                            {
                                <tr data-testid="dd-changes-version" data-present="true"><th scope="row">@import.Label</th><td>@(v.RevisionNumber is { } n ? $"rev {n}" : "—")</td><td><code>@Short(v.Fingerprint)</code></td></tr>
                            }
                        }
                        @foreach (var v in identity.Versions.Where(v => v.ProjectImportId is null))
                        {
                            <tr data-testid="dd-changes-version" data-present="true"><th scope="row">Manual</th><td>@(v.RevisionNumber is { } n ? $"rev {n}" : "—")</td><td><code>@Short(v.Fingerprint)</code></td></tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (identity.Versions.Count < 2)
            {
                <p class="dd-empty-line" data-testid="dd-changes-no-earlier">Observed in @(imports.Count == 0 ? "the workspace" : $"{identity.Versions.Count} import of {lineage.Name}"). @DocumentationDrift.NoEarlierRevision</p>
            }
            else
            {
                var from = identity.Versions.FirstOrDefault(v => v.Id == _changesFrom);
                var to = identity.Versions.FirstOrDefault(v => v.Id == _changesTo);
                <div class="dd-run">
                    <label class="dd-field">From
                        <select data-testid="dd-changes-from" value="@_changesFrom" @onchange="e => { _changesFrom = e.Value?.ToString() ?? string.Empty; }">
                            @foreach (var v in identity.Versions) { <option value="@v.Id">@VersionText(v)</option> }
                        </select>
                    </label>
                    <label class="dd-field">To
                        <select data-testid="dd-changes-to" value="@_changesTo" @onchange="e => { _changesTo = e.Value?.ToString() ?? string.Empty; }">
                            @foreach (var v in identity.Versions) { <option value="@v.Id">@VersionText(v)</option> }
                        </select>
                    </label>
                    <button type="button" class="btn-primary" data-testid="dd-changes-run" disabled="@(DocumentationDrift.Guard(DriftIntent.VersionDrift, from, to) is not null)"
                            @onclick="() => RunVersions(from!, to!)">Compare @(from?.ProjectRevision ?? "manual") → @(to?.ProjectRevision ?? "manual")</button>
                </div>
                @if (DocumentationDrift.Guard(DriftIntent.VersionDrift, from, to) is { } guard) { <p class="dd-note" data-testid="dd-changes-guard">@guard</p> }
                @if (_result is not null && _left?.LogicalKey == identity.LogicalKey && _right?.LogicalKey == identity.LogicalKey) { @Result() }
            }
        }
    };

    // ── Drift ───────────────────────────────────────────────────────────────────────────────────────────────────────────────
    private RenderFragment Drift() => __builder =>
    {
        var groups = DocumentationDriftComposite.CandidateGroups(_catalog, Saved, FocusImport);
        var candidates = DocumentationDrift.Candidates(_catalog, Saved, FocusImport).Where(c => !DocumentationDriftComposite.Structured(DocumentationDriftComposite.ConcernOf(c.Generated))).ToList();
        var equivalent = candidates.Where(c => c.Pairing == DriftPairing.Equivalent).ToList();
        var related = candidates.Where(c => c.Pairing == DriftPairing.RelatedScopeDiffers).ToList();
        var focus = _imports.FirstOrDefault(i => i.ImportId == FocusImport);
        var discrepancies = Saved.Where(c => DocumentationDrift.SavedIntent(c) == DriftIntent.ConsistencyDrift).ToList();
        <p class="dd-note" data-testid="dd-drift-intro"><strong>Drift = divergence inventory.</strong> Where authored (intent / design) and generated (implementation-derived) documentation intended to describe the same scope disagree. @DocumentationDrift.NeutralReview @DocumentationDrift.SourceBoundary</p>
        <section aria-labelledby="dd-groups-title" data-testid="dd-candidate-groups">
            <h3 id="dd-groups-title">Module consistency@(focus is null ? "" : $" · {focus.Label}")</h3>
            <p class="dd-note">One candidate per module and documentation area: every authored document of that module and area forms one authored intent; the module's generated document is the implementation-derived side. Absence on either side is neutral.</p>
            @if (groups.Count == 0) { <p class="dd-empty-line" data-testid="dd-no-groups">No module has authored or generated documentation of a structured documentation area in this import.</p> }
            else { <ul class="dd-cards">@foreach (var g in groups) { @GroupCard(g) }</ul> }
        </section>
        <section aria-labelledby="dd-candidates-title" data-testid="dd-candidates">
            <h3 id="dd-candidates-title">Other equivalent-scope pairs@(focus is null ? "" : $" · {focus.Label}")</h3>
            <p class="dd-note">Only pairs with deterministic evidence of the same scope. Nothing is compared automatically: a pair stays a comparison candidate until you compare it.</p>
            @if (equivalent.Count == 0)
            {
                <p class="dd-empty-line" data-testid="dd-no-candidates">@(focus is not null && !_catalog.Any(d => d.ProjectImportId == focus.ImportId && d.Origin == DriftOrigin.Generated) ? DocumentationDrift.GeneratedNotPresent + " " : "")No authored ↔ generated pair with proven equivalent scope.@(related.Count > 0 ? " Related documentation whose scope differs is listed below." : "")</p>
            }
            else
            {
                <ul class="dd-cards">@foreach (var candidate in equivalent) { @Card(candidate) }</ul>
            }
        </section>
        @if (related.Count > 0)
        {
            <details class="dd-related" data-testid="dd-related">
                <summary>Related documentation · scope differs (@related.Count)</summary>
                <p class="dd-note">Same module and document type, different scope (for example a feature's Data Model and the module-wide generated Data Model). Not drift candidates; open one in Compare to review it manually.</p>
                @foreach (var group in related.GroupBy(c => c.Generated.Id))
                {
                    var generated = group.First().Generated;
                    <div class="dd-related-group" data-testid="dd-related-group">
                        <p><strong class="dd-wrap">@DocumentationDrift.KindLabel(generated) generated for @DocumentationDrift.ScopeOf(generated)</strong> — related to @group.Count() authored document@(group.Count() == 1 ? "" : "s")</p>
                        <ul class="dd-cards">@foreach (var candidate in group) { @Card(candidate) }</ul>
                    </div>
                }
            </details>
        }
        <section aria-labelledby="dd-recorded-title" data-testid="dd-recorded">
            <h3 id="dd-recorded-title">Saved consistency comparisons</h3>
            @if (discrepancies.Count == 0)
            {
                <p class="dd-note">No consistency comparison saved yet.</p>
            }
            else
            {
                <ul class="dd-plain">
                    @foreach (var comparison in discrepancies.Take(20))
                    {
                        var c = comparison;
                        <li class="dd-item" data-testid="dd-recorded-row">
                            <p class="dd-wrap"><strong>@SideText(c.Left)</strong> ↔ <strong>@SideText(c.Right)</strong></p>
                            <p class="dd-note">@(c.Items.Count == 0 ? "No material difference" : $"Consistency discrepancy — differences found: {string.Join(", ", c.Counts.Where(x => x.Key != nameof(DriftItemKind.Unchanged)).Select(x => $"{x.Value} {KindName(x.Key, c)}"))}")</p>
                            <button type="button" class="btn-link" data-testid="dd-recorded-open" @onclick="() => Reopen(c)">Open in Compare<span class="visually-hidden"> comparison from @c.CreatedAt</span></button>
                        </li>
                    }
                </ul>
            }
        </section>
    };

    private RenderFragment GroupCard(DriftCandidateGroup g) => __builder =>
    {
        <li class="dd-card dd-group-card" data-testid="dd-candidate-group" data-state="@g.State" data-module="@g.Module" data-concern="@g.Concern">
            <p><strong class="dd-wrap">@g.Module</strong> <span class="dd-note">@DocumentationDriftComposite.ConcernLabel(g.Concern) consistency</span></p>
            <p class="dd-kicker">Authored intent</p>
            <p class="dd-note" data-testid="dd-group-contributors">@(g.Contributors.Count == 0 ? "Not present" : $"{g.Contributors.Count} related authored document{(g.Contributors.Count == 1 ? "" : "s")}")</p>
            @if (g.Contributors.Count > 0) { <ul class="dd-plain dd-contributors">@foreach (var c in g.Contributors) { <li class="dd-wrap"><code>@DocumentationDrift.StablePathOf(c)</code></li> }</ul> }
            <p class="dd-kicker">Implementation-derived</p>
            <p class="dd-note dd-wrap" data-testid="dd-group-generated">@(g.Generated is { } gen ? DocumentationDrift.StablePathOf(gen) : g.GeneratedCandidates.Count > 1 ? $"{g.GeneratedCandidates.Count} generated candidates — none chosen" : "Generated documentation: Not present")</p>
            <p><span class="sd-pill @(g.State == DriftGroupState.MultipleGeneratedCandidates ? "sd-pill-attention" : "sd-pill-muted")" data-testid="dd-group-state">@g.StateLabel</span> <span class="sd-pill sd-pill-muted" data-testid="dd-group-status">@g.Status</span></p>
            @if (g.State == DriftGroupState.ComparisonAvailable)
            {
                <button type="button" class="btn-secondary btn-small" data-testid="dd-group-open" @onclick="() => OpenGroup(g)">Open comparison<span class="visually-hidden"> @g.Title</span></button>
            }
        </li>
    };

    private RenderFragment Card(DriftCandidate c) => __builder =>
    {
        <li class="dd-card" data-testid="dd-candidate" data-status="@c.Status" data-pairing="@c.Pairing">
            <p><strong class="dd-wrap">@c.Title</strong></p>
            <p class="dd-note dd-wrap">Authored: <code>@c.Authored.Path</code> · @c.AuthoredScope</p>
            <p class="dd-note dd-wrap">Generated: <code>@c.Generated.Path</code> · @c.GeneratedScope</p>
            <p class="dd-note" data-testid="dd-candidate-basis">@PairingText(c.Pairing) — @c.Basis</p>
            <p><span class="sd-pill sd-pill-muted" data-testid="dd-candidate-status">@c.Status</span></p>
            <button type="button" class="btn-secondary btn-small" data-testid="dd-candidate-open" @onclick="() => OpenInCompare(c.Authored, c.Generated)">Open in Compare<span class="visually-hidden"> @c.Title @c.Authored.Path</span></button>
        </li>
    };

    // ── Shared result rendering ─────────────────────────────────────────────────────────────────────────────────────────
    private DriftStatus? _statusFilter;
    private string _search = "";

    /// <summary>
    /// Summary-first rows: status counts, filters and search, then groups (entity / section). Within a group the items needing review come
    /// first; consistent items stay collapsed; technical details per item stay collapsed. Every status is text plus colour.
    /// </summary>
    private RenderFragment RowsView(IReadOnlyList<DriftResultRow> rows, string itemTestId, string leftLabel, string rightLabel) => __builder =>
    {
        var counts = DocumentationDriftPresentation.Counts(rows);
        var visible = DocumentationDriftPresentation.Filter(rows, _statusFilter, _search);
        <div class="dd-status-summary" data-testid="dd-status-summary">
            @foreach (var (status, count) in counts)
            {
                <span class="dd-status dd-status-@DocumentationDriftPresentation.Tone(status)" data-testid="dd-status-count" data-status="@status">@DocumentationDriftPresentation.Label(status) · @count</span>
            }
        </div>
        <div class="dd-result-tools">
            <div class="dd-filters" role="group" aria-label="Filter results by status" data-testid="dd-result-filters">
                <button type="button" class="dd-filter @(_statusFilter is null ? "is-active" : "")" aria-pressed="@(_statusFilter is null ? "true" : "false")" data-testid="dd-result-filter" data-status="All" @onclick="() => _statusFilter = null">All (@rows.Count)</button>
                @foreach (var (status, count) in counts)
                {
                    var st = status;
                    <button type="button" class="dd-filter @(_statusFilter == st ? "is-active" : "")" aria-pressed="@(_statusFilter == st ? "true" : "false")" data-testid="dd-result-filter" data-status="@st" @onclick="() => _statusFilter = st">@DocumentationDriftPresentation.Label(st) (@count)</button>
                }
            </div>
            <label class="dd-field dd-search">Search results
                <input type="search" data-testid="dd-result-search" value="@_search" @oninput="e => _search = e.Value?.ToString() ?? string.Empty" placeholder="Entity, section, value…" />
            </label>
        </div>
        <p class="dd-note" role="status" data-testid="dd-result-count">@visible.Count of @rows.Count items shown</p>
        @if (visible.Count == 0) { <p class="dd-empty-line" data-testid="dd-result-empty">No item matches this filter.</p> }
        @foreach (var group in visible.GroupBy(r => r.Group))
        {
            var attention = group.Where(r => r.Status != DriftStatus.Consistent).ToList();
            var consistent = group.Where(r => r.Status == DriftStatus.Consistent).ToList();
            <section class="dd-group" data-testid="dd-result-group" data-group="@group.Key" aria-label="@group.Key">
                <h4 class="dd-group-title"><span class="dd-wrap">@group.Key</span> <span class="dd-note">@string.Join(" · ", DocumentationDriftPresentation.Counts(group).Select(c => $"{c.Count} {DocumentationDriftPresentation.Label(c.Status).ToLowerInvariant()}"))</span></h4>
                @if (attention.Count > 0) { <ul class="dd-items">@foreach (var row in attention) { @RowItem(row, itemTestId, leftLabel, rightLabel) }</ul> }
                @if (consistent.Count > 0)
                {
                    <ReviewDisclosure Text="@($"Consistent ({consistent.Count})")" CollapseText="@($"Hide consistent ({consistent.Count})")" TestId="dd-consistent" Expanded="@(_statusFilter == DriftStatus.Consistent)">
                        <ul class="dd-items">@foreach (var row in consistent) { @RowItem(row, itemTestId, leftLabel, rightLabel) }</ul>
                    </ReviewDisclosure>
                }
            </section>
        }
    };

    private RenderFragment RowItem(DriftResultRow row, string testId, string leftLabel, string rightLabel) => __builder =>
    {
        <li class="dd-item dd-item-@DocumentationDriftPresentation.Tone(row.Status)" data-testid="@testId" data-kind="@row.Kind" data-category="@row.Kind" data-status="@row.Status">
            <p><span class="dd-status dd-status-@DocumentationDriftPresentation.Tone(row.Status)">@DocumentationDriftPresentation.Label(row.Status)</span> <strong class="dd-wrap">@row.Title</strong></p>
            @if (row.Detail.Length > 0) { <p class="dd-note">@row.Detail</p> }
            @if (row.Authored is not null || row.Generated is not null || row.Technical.Count > 0)
            {
                <details class="dd-lines"><summary>Technical details<span class="visually-hidden"> for @row.Title</span></summary>
                    @if (row.Authored is not null) { <p class="dd-note dd-wrap"><strong>@leftLabel:</strong> @row.Authored</p> }
                    @if (row.Generated is not null) { <p class="dd-note dd-wrap"><strong>@rightLabel:</strong> @row.Generated</p> }
                    @foreach (var t in row.Technical) { <p class="dd-note dd-wrap" data-testid="dd-row-provenance"><code>@t</code></p> }
                </details>
            }
        </li>
    };

    private static string SideName(DriftDocument? d, string fallback) =>
        d is null ? fallback : $"{fallback} ({d.Origin.ToString().ToLowerInvariant()}, {d.ProjectRevision ?? "manual"})";

    /// <summary>Generated documentation absent: a neutral state with where to look, never a failure.</summary>
    private RenderFragment GeneratedMissing(string? importId) => __builder =>
    {
        <div class="dd-neutral" role="status" data-testid="dd-generated-missing">
            <p><strong>Generated documentation: Not present.</strong> This is a neutral state — no comparison with implementation-derived documentation is possible, and nothing is wrong with the authored documentation.</p>
            <p>
                <a class="btn-link" data-testid="dd-generated-missing-health" href="@($"{NavigationCatalog.GeneratedDocumentationHealthRoute}{(importId is null ? "" : $"?import={Uri.EscapeDataString(importId)}")}")">Check Generated Documentation Health</a>
                · <a class="btn-link" data-testid="dd-generated-missing-explorer" href="@($"{NavigationCatalog.GeneratedDocumentationExplorerRoute}{(importId is null ? "" : $"?import={Uri.EscapeDataString(importId)}")}")">Open Generated Documentation Explorer</a>
            </p>
        </div>
    };

    // ── Overview dashboard ──────────────────────────────────────────────────────────────────────────────────────────────
    private string _overviewImport = "";

    /// <summary>
    /// Test-lead dashboard for one imported project: documentation availability, module consistency candidates, saved comparisons with
    /// differences and what to review next. Nothing is compared automatically.
    /// </summary>
    private RenderFragment Dashboard(IReadOnlyList<DriftImportSummary> summaries) => __builder =>
    {
        if (summaries.Count == 0) return;
        var importId = _imports.Any(i => i.ImportId == _overviewImport) ? _overviewImport : FocusImport ?? summaries[^1].Import.ImportId;
        var summary = summaries.FirstOrDefault(r => r.Import.ImportId == importId) ?? summaries[^1];
        var groups = DocumentationDriftComposite.CandidateGroups(_catalog, Saved, summary.Import.ImportId);
        var available = groups.Where(g => g.State == DriftGroupState.ComparisonAvailable).ToList();
        var waiting = available.Where(g => g.Status == "Comparison candidate").ToList();
        var withDifferences = Saved.Count(c => (c.Left.ProjectRevision is not null || c.Right.ProjectRevision is not null) && c.Items.Any(i => i.Kind is not (nameof(DriftItemKind.Unchanged) or nameof(ConsistencyCategory.Consistent))));
        var versioned = DocumentationDrift.Identities(_catalog).Count(i => i.LineageKey == summary.Import.LineageKey && i.Versions.Count > 1);
        <section class="dd-dashboard" aria-labelledby="dd-dashboard-title" data-testid="dd-dashboard">
            <h3 id="dd-dashboard-title">Documentation review status</h3>
            <label class="dd-field">Imported project
                <select data-testid="dd-overview-import" @onchange="e => _overviewImport = e.Value?.ToString() ?? string.Empty">
                    @foreach (var i in _imports) { <option value="@i.ImportId" selected="@(i.ImportId == summary.Import.ImportId)">@i.Label</option> }
                </select>
            </label>
            <dl class="dd-summary" data-testid="dd-dashboard-summary">
                <div><dt>Authored documents</dt><dd data-testid="dd-dash-authored">@summary.AuthoredDocuments</dd></div>
                <div><dt>Generated documentation</dt><dd data-testid="dd-dash-generated">@(summary.GeneratedState == "Present" ? $"{summary.GeneratedDocuments} docs · {summary.GeneratedModules} modules" : "Not present")</dd></div>
                <div><dt>Module consistency</dt><dd data-testid="dd-dash-modules">@available.Count comparable · @(groups.Count - available.Count) unavailable</dd></div>
                <div><dt>Waiting for review</dt><dd data-testid="dd-dash-waiting">@waiting.Count</dd></div>
                <div><dt>Saved comparisons with differences</dt><dd data-testid="dd-dash-differences">@withDifferences</dd></div>
                <div><dt>Documents with revisions</dt><dd data-testid="dd-dash-versioned">@versioned</dd></div>
            </dl>
            @if (summary.GeneratedState != "Present") { @GeneratedMissing(summary.Import.ImportId) }
            <h4>What to review next</h4>
            @if (waiting.Count == 0)
            {
                <p class="dd-note" data-testid="dd-dash-next-none">@(available.Count == 0 ? "No module has both authored intent and generated documentation of one documentation area in this import." : "Every comparable module has a saved comparison.")</p>
            }
            else
            {
                <ul class="dd-plain dd-next" data-testid="dd-dash-next">
                    @foreach (var g in waiting.Take(8))
                    {
                        var group = g;
                        <li data-testid="dd-dash-next-item"><span class="dd-wrap">@group.Title</span> <button type="button" class="btn-link" @onclick="() => OpenGroup(group)">Open comparison<span class="visually-hidden"> @group.Title</span></button></li>
                    }
                </ul>
                @if (waiting.Count > 8) { <p class="dd-note">@(waiting.Count - 8) more in Drift.</p> }
            }
        </section>
    };

    private static string PairingText(DriftPairing pairing) => pairing == DriftPairing.Equivalent ? "Equivalent scope" : "Related documentation · scope differs";

    private string ProjectOf(string? lineageKey) => _imports.FirstOrDefault(i => i.LineageKey == lineageKey)?.ProjectName ?? "Manual workspace documents";
    private static string Short(string fingerprint) => fingerprint.Length > 12 ? fingerprint[..12] : fingerprint;
    private static string SideText(SddDriftSide side) =>
        $"{side.Origin} · {side.DisplayName} · {side.ProjectRevision ?? "manual"}{(side.RevisionNumber is { } n ? $" · rev {n}" : "")} · {Short(side.Fingerprint)}";
    private static string VersionText(DriftDocument v) => $"{v.ProjectRevision ?? "manual"}{(v.RevisionNumber is { } n ? $" / rev {n}" : "")} · {Short(v.Fingerprint)}";
    private static string KindName(string kind, SddDocumentationDriftComparison c) => Enum.TryParse<DriftItemKind>(kind, out var k)
        ? k switch { DriftItemKind.OnlyInLeft => $"only in {c.Left.Origin.ToLowerInvariant()}", DriftItemKind.OnlyInRight => $"only in {c.Right.Origin.ToLowerInvariant()}", DriftItemKind.ConsistencyDiscrepancy => "described differently", _ => DocumentationDrift.Label(k).ToLowerInvariant() }
        : kind;

    private void ResetResult() { _result = null; _savedCurrent = false; _reopened = null; _statusFilter = null; _search = ""; }

    private void ModeChanged(ChangeEventArgs e)
    {
        if (!Enum.TryParse<DriftIntent>(e.Value?.ToString(), out var mode)) return;
        _mode = mode; _left = _right = null; _identity = _fromId = _toId = ""; _contributorId = ""; _composite = null; _savedComposite = null; ResetResult();
    }

    private void Select(bool left, string id)
    {
        var document = _catalog.FirstOrDefault(d => d.Id == id);
        if (left) _left = document; else _right = document;
        ResetResult();
    }

    private void SelectVersionIdentity(string key)
    {
        _identity = key;
        var identity = DocumentationDrift.Identities(_catalog).FirstOrDefault(i => i.LogicalKey == key);
        _fromId = identity is { Versions.Count: > 1 } ? identity.Versions[^2].Id : "";
        _toId = identity is { Versions.Count: > 0 } ? identity.Versions[^1].Id : "";
        if (identity is not null) ApplyVersionPair(identity); else { _left = _right = null; ResetResult(); }
    }

    private void ApplyVersionPair(DriftIdentity identity)
    {
        _left = identity.Versions.FirstOrDefault(v => v.Id == _fromId);
        _right = identity.Versions.FirstOrDefault(v => v.Id == _toId);
        ResetResult();
    }

    private void SelectChangesIdentity(string key)
    {
        _changesIdentity = key;
        var versions = DocumentationDrift.Identities(_catalog).FirstOrDefault(i => i.LogicalKey == key)?.Versions ?? [];
        _changesFrom = versions.Count > 1 ? versions[^2].Id : "";
        _changesTo = versions.Count > 0 ? versions[^1].Id : "";
    }

    private void Run()
    {
        if (Lifecycle is not { } state || DocumentationDrift.Guard(_mode, _left, _right) is not null) return;
        _result = DocumentationDrift.Compare(_left!, DocumentationDrift.Text(state, _left!) ?? "", _right!, DocumentationDrift.Text(state, _right!) ?? "", _mode);
        _savedCurrent = false; _reopened = null;
    }

    private void RunVersions(DriftDocument from, DriftDocument to)
    {
        _left = from; _right = to; _mode = DriftIntent.VersionDrift;
        Run();
    }

    private async Task OpenInCompare(DriftDocument authored, DriftDocument generated)
    {
        _mode = DriftIntent.ConsistencyDrift; _consistencyImport = authored.ProjectImportId ?? "";
        _left = authored; _right = generated; ResetResult();
        await OnViewChange.InvokeAsync("compare");
    }

    private async Task SaveAsync()
    {
        if (Lifecycle is not { } state || _result is null || _left is null || _right is null) return;
        DocumentationDrift.Save(state, _left, _right, _result, Repository?.SessionScope, DateTimeOffset.UtcNow);
        _savedCurrent = true;
        if (ServiceProvider.GetService(typeof(IWorkspaceAutoSaveService)) is IWorkspaceAutoSaveService autoSave) await autoSave.SaveNowAsync();
    }

    /// <summary>Reopens a saved result exactly as computed; it is never re-run against newer content or reinterpreted across projects.</summary>
    private async Task OpenGroup(DriftCandidateGroup g)
    {
        _mode = DriftIntent.CompositeConsistency; _consistencyImport = g.ImportId; _groupKey = g.Key; _contributorId = "";
        _composite = null; _savedComposite = null; ResetResult(); PreviewIntent();
        await OnViewChange.InvokeAsync("compare");
    }

    private async Task Reopen(SddDocumentationDriftComparison saved)
    {
        if (saved.ComparisonKind == DocumentationDriftComposite.StructuredDataModel)
        {
            // A saved composite is shown exactly as saved — its contributor fingerprints are never re-resolved against a later import.
            _mode = DocumentationDrift.SavedIntent(saved); _composite = null; _savedComposite = saved; _savedCurrent = true;
            await OnViewChange.InvokeAsync("compare");
            return;
        }
        var (left, right) = DocumentationDrift.Resolve(_catalog, saved);
        _mode = DocumentationDrift.SavedIntent(saved);
        if (_mode == DriftIntent.ConsistencyDrift) _consistencyImport = left?.ProjectImportId ?? _consistencyImport;
        _left = left; _right = right;
        _result = new DriftComparisonResult(_mode, saved.RevisionContext, saved.Outcome, saved.Items, saved.Counts);
        _savedCurrent = true;
        _reopened = left is null || right is null
            ? "Historical comparison: a referenced revision is no longer in this workspace. The saved identities and result are shown unchanged."
            : $"Showing the saved result for {saved.Left.ProjectRevision ?? "manual"} ↔ {saved.Right.ProjectRevision ?? "manual"} exactly as compared (fingerprints {Short(saved.Left.Fingerprint)} ↔ {Short(saved.Right.Fingerprint)}).";
        await OnViewChange.InvokeAsync("compare");
    }

    // ── Composite authored intent ↔ generated ─────────────────────────────────────────────────────────────────────────────

    private IReadOnlyList<DriftCandidateGroup> Groups => DocumentationDriftComposite.CandidateGroups(_catalog, Saved, string.IsNullOrEmpty(_consistencyImport) ? FocusImport : _consistencyImport);
    private DriftCandidateGroup? SelectedGroup => Groups.FirstOrDefault(g => g.Key == _groupKey);

    private IReadOnlyList<(DriftDocument Document, string Text)> ContributorTexts(DriftCandidateGroup g, string? only = null) =>
        Lifecycle is not { } state ? [] : g.Contributors.Where(c => only is null || c.Id == only)
            .Select(c => (c, DocumentationDrift.Text(state, c))).Where(x => x.Item2 is not null).Select(x => (x.c, x.Item2!)).ToList();

    private void PreviewIntent()
    {
        _intentPreview = SelectedGroup is { Contributors.Count: > 0 } g ? DocumentationDriftComposite.BuildDataModel(g.ImportId, g.Module, ContributorTexts(g), Parser) : null;
    }

    private void CompositeImportChanged(ChangeEventArgs e) { _consistencyImport = e.Value?.ToString() ?? ""; _groupKey = ""; _module = ""; _composite = null; _intentPreview = null; _savedComposite = null; }

    private void ContributionChanged(ChangeEventArgs e) { _contributorId = e.Value?.ToString() ?? ""; _composite = null; }

    private void GroupChanged(ChangeEventArgs e) { _groupKey = e.Value?.ToString() ?? ""; _module = SelectedGroup?.Module ?? _module; _contributorId = ""; _composite = null; _savedComposite = null; ResetResult(); PreviewIntent(); }

    private string _module = "";
    private string CurrentModule => SelectedGroup?.Module ?? _module;

    /// <summary>Choosing a module preselects its only available documentation area; with several areas the tester chooses.</summary>
    private void ModuleChanged(ChangeEventArgs e)
    {
        _module = e.Value?.ToString() ?? "";
        var areas = Groups.Where(g => string.Equals(g.Module, _module, StringComparison.OrdinalIgnoreCase)).ToList();
        var available = areas.Where(g => g.State == DriftGroupState.ComparisonAvailable).ToList();
        _groupKey = available.Count == 1 ? available[0].Key : areas.Count == 1 ? areas[0].Key : "";
        _contributorId = ""; _composite = null; _savedComposite = null; ResetResult(); PreviewIntent();
    }

    private void AreaChanged(ChangeEventArgs e) => GroupChanged(e);

    private bool CanCompare => SelectedGroup is { State: DriftGroupState.ComparisonAvailable }
        && (_mode == DriftIntent.CompositeConsistency || _contributorId.Length > 0);

    private void RunComposite()
    {
        if (Lifecycle is not { } state || SelectedGroup is not { Generated: { } generated } g || DocumentationDrift.Text(state, generated) is not { } genText) return;
        var contribution = _mode == DriftIntent.ContributionConsistency;
        var intent = DocumentationDriftComposite.BuildDataModel(g.ImportId, g.Module, ContributorTexts(g, contribution ? _contributorId : null), Parser);
        _composite = DocumentationDriftComposite.CompareDataModel(intent, generated, genText, Parser, contribution);
        _statusFilter = null; _search = "";
        _savedComposite = null; _savedCurrent = false;
    }

    private async Task SaveCompositeAsync()
    {
        if (Lifecycle is not { } state || _composite is null) return;
        _savedComposite = DocumentationDriftComposite.Save(state, _composite, Repository?.SessionScope, DateTimeOffset.UtcNow, _mode == DriftIntent.ContributionConsistency);
        _savedCurrent = true;
        if (ServiceProvider.GetService(typeof(IWorkspaceAutoSaveService)) is IWorkspaceAutoSaveService autoSave) await autoSave.SaveNowAsync();
    }

    private RenderFragment CompositeView() => __builder =>
    {
        var groups = Groups;
        var group = SelectedGroup;
        <div class="dd-composite" data-testid="dd-composite">
            <label class="dd-field">Imported project
                <select data-testid="dd-composite-import" @onchange="CompositeImportChanged">
                    @foreach (var i in _imports) { <option value="@i.ImportId" selected="@(i.ImportId == (string.IsNullOrEmpty(_consistencyImport) ? FocusImport : _consistencyImport))">@i.Label</option> }
                </select>
            </label>
            @{ var modules = groups.Select(g => g.Module).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(m => m, StringComparer.OrdinalIgnoreCase).ToList(); }
            <label class="dd-field">Module
                <select data-testid="dd-composite-module" @onchange="ModuleChanged">
                    <option value="" selected="@(string.IsNullOrEmpty(CurrentModule))">Choose a module…</option>
                    @foreach (var m in modules) { <option value="@m" selected="@(string.Equals(m, CurrentModule, StringComparison.OrdinalIgnoreCase))">@m</option> }
                </select>
            </label>
            <label class="dd-field">Documentation area
                <select data-testid="dd-composite-area" @onchange="AreaChanged" disabled="@string.IsNullOrEmpty(CurrentModule)">
                    <option value="" selected="@(group is null)">Choose an area…</option>
                    @foreach (var g in groups.Where(g => string.Equals(g.Module, CurrentModule, StringComparison.OrdinalIgnoreCase)))
                    {
                        <option value="@g.Key" selected="@(g.Key == _groupKey)">@DocumentationDriftComposite.ConcernLabel(g.Concern) — @(g.State == DriftGroupState.ComparisonAvailable ? "available" : "unavailable")</option>
                    }
                </select>
            </label>
            @* Kept for links and older tests: one select over every module · area. *@
            <label class="dd-field visually-hidden">Module · documentation area
                <select data-testid="dd-composite-group" tabindex="-1" aria-hidden="true" @onchange="GroupChanged">
                    <option value="" selected="@(group is null)">Choose a module…</option>
                    @foreach (var g in groups) { <option value="@g.Key" selected="@(g.Key == _groupKey)">@g.Module · @DocumentationDriftComposite.ConcernLabel(g.Concern) — @g.StateLabel</option> }
                </select>
            </label>
            @if (group is not null)
            {
                <dl class="dd-availability" data-testid="dd-availability" data-state="@group.State">
                    <div><dt>Authored intent</dt><dd>@(group.Contributors.Count == 0 ? "Not present" : $"{group.Contributors.Count} document{(group.Contributors.Count == 1 ? "" : "s")}")</dd></div>
                    <div><dt>Generated documentation</dt><dd>@(group.Generated is not null ? "Present" : group.GeneratedCandidates.Count > 1 ? $"{group.GeneratedCandidates.Count} candidates — review required" : "Not present")</dd></div>
                    <div><dt>Comparison</dt><dd>@(group.State == DriftGroupState.ComparisonAvailable ? "Available" : "Unavailable")</dd></div>
                </dl>
                @if (group.State == DriftGroupState.GeneratedNotPresent) { @GeneratedMissing(group.ImportId) }
            }
            @if (group is not null)
            {
                @if (_mode == DriftIntent.ContributionConsistency)
                {
                    <label class="dd-field">Authored contribution
                        <select data-testid="dd-composite-contribution" @onchange="ContributionChanged">
                            <option value="" selected="@(_contributorId.Length == 0)">Choose an authored document…</option>
                            @foreach (var c in group.Contributors) { <option value="@c.Id" selected="@(c.Id == _contributorId)">@DocumentationDrift.StablePathOf(c)</option> }
                        </select>
                    </label>
                }
                <div class="dd-sides">
                    <section class="dd-side" data-testid="dd-authored-intent" aria-label="Authored intent">
                        <p class="dd-kicker">Authored intent</p>
                        <p data-testid="dd-authored-intent-summary">@(group.Contributors.Count == 0 ? "Not present" : $"Combined from {group.Contributors.Count} relevant authored document{(group.Contributors.Count == 1 ? "" : "s")}")</p>
                        <ul class="dd-plain">@foreach (var c in group.Contributors) { <li class="dd-wrap" data-testid="dd-contributor">✓ <code>@DocumentationDrift.StablePathOf(c)</code></li> }</ul>
                        @if (_intentPreview is { } preview)
                        {
                            <p class="dd-note" data-testid="dd-intent-counts">@preview.Entities.Count entities · @preview.FieldCount fields · @preview.Relationships.Count relationships@(preview.Conflicts.Count > 0 ? $" · {preview.Conflicts.Count} authored conflict{(preview.Conflicts.Count == 1 ? "" : "s")}" : "")</p>
                        }
                        <details data-testid="dd-included-review"><summary>Review included documents</summary>
                            <p class="dd-note">Included automatically:</p>
                            <ul class="dd-plain">@foreach (var c in group.Contributors) { <li class="dd-wrap">✓ <code>@DocumentationDrift.StablePathOf(c)</code> — Reason: @group.Module module · @DocumentationDriftComposite.ConcernLabel(group.Concern) artifact · same import</li> }</ul>
                            <p class="dd-note">Excluded: other documentation areas (Plan, Specification, …), other modules, project-level documents and documents of other imports.</p>
                        </details>
                    </section>
                    <section class="dd-side" data-testid="dd-generated-side" aria-label="Implementation-derived documentation">
                        <p class="dd-kicker">Implementation-derived</p>
                        @if (group.Generated is { } gen)
                        {
                            <p class="dd-wrap" data-testid="dd-generated-path"><code>@DocumentationDrift.StablePathOf(gen)</code></p>
                            <p class="dd-note">Generated documentation@(gen.Generator is { } generator ? $" · Generator: {generator}" : " · generator not established")</p>
                        }
                        else { <p data-testid="dd-generated-path">@(group.GeneratedCandidates.Count > 1 ? "Review required — multiple generated candidates" : "Generated documentation: Not present")</p> }
                    </section>
                </div>
                <p class="dd-note" data-testid="dd-composite-state">@group.StateLabel</p>
                <details class="dd-technical" data-testid="dd-composite-technical"><summary>Technical details</summary>
                    <dl class="dd-mini">
                        @foreach (var c in group.Contributors) { <div><dt>@DocumentationDrift.StablePathOf(c)</dt><dd><code>@c.Fingerprint</code></dd></div> }
                        @if (group.Generated is { } g2) { <div><dt>Generated set</dt><dd><code>@g2.GeneratedSetId</code></dd></div><div><dt>Generated fingerprint</dt><dd><code>@g2.Fingerprint</code></dd></div><div><dt>Source snapshot</dt><dd><code>@g2.SourceSnapshotId</code></dd></div> }
                        @if (_intentPreview is { } p2) { <div><dt>Composite fingerprint</dt><dd><code data-testid="dd-composite-fingerprint">@p2.Fingerprint</code></dd></div> }
                    </dl>
                </details>
            }
            <div class="dd-run">
                <button type="button" class="btn-primary" data-testid="dd-composite-run" disabled="@(!CanCompare)" @onclick="RunComposite">Compare</button>
            </div>
            @if (_composite is { } result) { @CompositeResult(result) }
            else if (_savedComposite is { } saved) { @SavedComposite(saved) }
        </div>
    };

    private RenderFragment CompositeResult(DataModelConsistencyResult r) => __builder =>
    {
        <section class="dd-result" data-testid="dd-composite-result" aria-label="Consistency result">
            <h3>@r.Intent.Module · Data Model consistency</h3>
            <p class="dd-note">Authored intent: @r.Intent.Contributors.Count contributing document@(r.Intent.Contributors.Count == 1 ? "" : "s") · Generated documentation: 1 implementation-derived document</p>
            <ul class="dd-plain dd-summary" data-testid="dd-composite-summary">
                <li><span class="dd-status dd-status-green">Consistent</span> @r.Count(ConsistencyCategory.Consistent)</li>
                <li><span class="dd-status dd-status-amber">Difference</span> @r.Discrepancies</li>
                <li><span class="dd-status dd-status-blue">Generated-only</span> @r.Count(ConsistencyCategory.GeneratedOnly)</li>
                <li><span class="dd-status dd-status-blue">Authored-only</span> @r.Count(ConsistencyCategory.AuthoredOnly)</li>
                <li><span class="dd-status dd-status-red">Conflict</span> @r.Intent.Conflicts.Count authored</li>
                <li><span class="dd-status dd-status-grey">Unmatched</span> @r.Count(ConsistencyCategory.NotComparable)</li>
            </ul>
            <p class="dd-note">@DocumentationDrift.NeutralReview</p>
            @if (r.Intent.Conflicts.Count > 0)
            {
                <section class="dd-conflicts" data-testid="dd-authored-conflicts" aria-label="Authored intent needs review">
                    <h4>Authored intent needs review · @r.Intent.Conflicts.Count authored conflict@(r.Intent.Conflicts.Count == 1 ? "" : "s")</h4>
                    @foreach (var c in r.Intent.Conflicts)
                    {
                        <div class="dd-item" data-testid="dd-authored-conflict"><p><strong>@c.Concept</strong> · @c.Attribute</p>
                            <ul class="dd-plain">@foreach (var st in c.Statements) { <li class="dd-wrap"><code>@st.Provenance.Path</code>: @st.Value</li> }</ul>
                            <p class="dd-note">@AuthoredIntentConflict.Reason Status: Review required. Comparison with generated documentation: Not concluded.</p></div>
                    }
                </section>
            }
            <div data-testid="dd-composite-rows">@RowsView(DocumentationDriftPresentation.Rows(r), "dd-composite-row", "Authored", "Generated")</div>
            <button type="button" class="btn-secondary" data-testid="dd-composite-save" disabled="@_savedCurrent" @onclick="SaveCompositeAsync">@(_savedCurrent ? "Saved" : "Save comparison")</button>
        </section>
    };

    private RenderFragment SavedComposite(SddDocumentationDriftComparison s) => __builder =>
    {
        <section class="dd-result" data-testid="dd-composite-saved" aria-label="Saved consistency comparison">
            <h3>@s.Scope consistency · saved @s.CreatedAt.ToLocalTime().ToString("g")</h3>
            <p class="dd-note" data-testid="dd-composite-saved-note">Shown exactly as saved: @s.Contributors.Count contributing document@(s.Contributors.Count == 1 ? "" : "s") at their saved fingerprints; a later import never changes this result.</p>
            <ul class="dd-plain">@foreach (var c in s.Contributors) { <li class="dd-wrap"><code>@c.Path</code> · <code>@Short(c.Fingerprint)</code></li> }</ul>
            <p data-testid="dd-composite-saved-outcome">@s.Outcome</p>
        </section>
    };
}
