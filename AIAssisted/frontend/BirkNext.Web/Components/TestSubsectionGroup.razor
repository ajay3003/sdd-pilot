@using BirkNext.Web.Models

<div class="test-subsection-group test-subsection-group-@Accent" data-testid="test-subsection-group">
    <button type="button"
            class="subsection-toggle @(IsExpanded ? "is-open" : "")"
            aria-expanded="@IsExpanded"
            aria-controls="@BodyId"
            @onclick="Toggle">
        <span class="subsection-chevron @(IsExpanded ? "is-open" : "")" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </span>

        @if (_semanticIcon is not null)
        {
            <span class="subsection-semantic-icon" aria-hidden="true">@_semanticIcon</span>
        }
        <span class="subsection-heading">@Title</span>

        <span class="subsection-meta">
            <span class="subsection-count">
                @if (VisibleCount != TotalCount)
                {
                    @VisibleCount<span class="subsection-count-of"> of @TotalCount</span>
                }
                else
                {
                    @TotalCount
                }
            </span>
            @if (StatusCounts.HasValue)
            {
                var sc = StatusCounts.Value;
                var hasBreakdown = sc.Accepted > 0 || sc.Rejected > 0 || sc.NeedsReview > 0;
                @if (hasBreakdown)
                {
                    <span class="subsection-status-line">
                        @if (sc.Accepted > 0)
                        {
                            <span class="subsection-status-micro subsection-status-micro-accepted">@sc.Accepted acc</span>
                        }
                        @if (sc.Rejected > 0)
                        {
                            <span class="subsection-status-micro subsection-status-micro-rejected">@sc.Rejected rej</span>
                        }
                        @if (sc.NeedsReview > 0)
                        {
                            <span class="subsection-status-micro subsection-status-micro-needsreview">@sc.NeedsReview ?</span>
                        }
                    </span>
                }
            }
        </span>
    </button>

    <div id="@BodyId"
         class="subsection-body @(IsExpanded ? "is-expanded" : "is-collapsed")"
         aria-hidden="@(!IsExpanded ? "true" : null)">
        <div class="subsection-body-inner">
            @ChildContent
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string Accent { get; set; } = "test";
    [Parameter, EditorRequired] public int TotalCount { get; set; }
    [Parameter, EditorRequired] public int VisibleCount { get; set; }
    [Parameter] public ReviewStatusCounts? StatusCounts { get; set; }
    [Parameter] public bool IsExpanded { get; set; } = true;
    [Parameter] public EventCallback<bool> IsExpandedChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string BodyId => $"subsection-body-{Accent}-{SanitizeId(Title)}";

    private string? _semanticIcon => Accent == "needsclarification"
        ? GetClarificationIcon(Title)
        : null;

    private async Task Toggle()
    {
        IsExpanded = !IsExpanded;
        await IsExpandedChanged.InvokeAsync(IsExpanded);
    }

    private static string SanitizeId(string value)
    {
        var chars = value
            .ToLowerInvariant()
            .Select(c => char.IsLetterOrDigit(c) ? c : '-')
            .ToArray();
        var id = new string(chars).Trim('-');
        return string.IsNullOrWhiteSpace(id) ? "untitled" : id;
    }

    private static string GetClarificationIcon(string title)
    {
        if (title.Contains("edge", StringComparison.OrdinalIgnoreCase)
            || title.Contains("question", StringComparison.OrdinalIgnoreCase)
            || title.Contains("unknown", StringComparison.OrdinalIgnoreCase))
            return "?";

        if (title.Contains("assumption", StringComparison.OrdinalIgnoreCase)
            || title.Contains("risk", StringComparison.OrdinalIgnoreCase)
            || title.Contains("fallback", StringComparison.OrdinalIgnoreCase))
            return "!";

        return "i";
    }
}
