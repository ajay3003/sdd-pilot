@using BirkNext.Web.Models

<div class="test-subsection-group" data-testid="test-subsection-group">
    <button type="button"
            class="subsection-toggle @(IsExpanded ? "is-open" : "")"
            aria-expanded="@IsExpanded"
            @onclick="Toggle">
        <span class="subsection-chevron @(IsExpanded ? "is-open" : "")" aria-hidden="true">
            <svg width="10" height="10" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </span>
        <span class="subsection-heading">@Title</span>
        <span class="subsection-count">
            @if (VisibleCount != TotalCount)
            {
                @VisibleCount<span class="subsection-count-of"> of @TotalCount</span>
            }
            else
            {
                @TotalCount
            }
        </span>
        @if (StatusCounts.HasValue)
        {
            var sc = StatusCounts.Value;
            var hasBreakdown = sc.Accepted > 0 || sc.Rejected > 0 || sc.NeedsReview > 0;
            @if (hasBreakdown)
            {
                <div class="subsection-status-line">
                    @if (sc.Accepted > 0)
                    {
                        <span class="subsection-status-micro subsection-status-micro-accepted">@sc.Accepted acc</span>
                    }
                    @if (sc.Rejected > 0)
                    {
                        <span class="subsection-status-micro subsection-status-micro-rejected">@sc.Rejected rej</span>
                    }
                    @if (sc.NeedsReview > 0)
                    {
                        <span class="subsection-status-micro subsection-status-micro-needsreview">@sc.NeedsReview ?</span>
                    }
                </div>
            }
        }
    </button>

    <div class="subsection-body @(IsExpanded ? "is-expanded" : "is-collapsed")">
        <div class="subsection-body-inner">
            @ChildContent
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public int TotalCount { get; set; }
    [Parameter, EditorRequired] public int VisibleCount { get; set; }
    [Parameter] public ReviewStatusCounts? StatusCounts { get; set; }
    [Parameter] public bool IsExpanded { get; set; } = true;
    [Parameter] public EventCallback<bool> IsExpandedChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private async Task Toggle()
    {
        IsExpanded = !IsExpanded;
        await IsExpandedChanged.InvokeAsync(IsExpanded);
    }
}
