@inherits LayoutComponentBase
@using BirkNext.Web.Services
@using BirkNext.Web.Components
@inject FeatureVisibilityService FeatureViz
@inject AdminApiService AdminApi
@inject IWorkspacePersistenceApiService WorkspacePersistence
@inject IWorkspaceSessionRestoreService WorkspaceRestore
@inject ILogger<MainLayout> Logger
@inject IServiceProvider LayoutServices
@inject NavigationManager Navigation
@implements IDisposable

@if (!_ready)
{
    <div class="layout-loading">
        <svg class="loading-progress" style="width:3rem;height:3rem">
            <circle r="40%" cx="50%" cy="50%" />
            <circle r="40%" cx="50%" cy="50%" />
        </svg>
    </div>
}
else
{
    <div class="page @(_navigation?.SidebarCollapsed == true ? "nav-collapsed" : null)" data-testid="layout-page">
        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <LocalSessionGate />
            @* Activity Center: always available, on every page; observes long-running work, never owns it. *@
            <div class="activity-row"><ActivityCenter /></div>
            <WorkspaceSaveIndicator />
            <article class="content px-4">
                <WorkspaceScopeNotice Sections="_navigation" />
                <SharedWorkspaceTabs />
                <WorkspaceDocumentsGate PageType="@RouteData?.PageType">@Body</WorkspaceDocumentsGate>
            </article>
        </main>
    </div>
}

@code {
    private bool _ready;
    [CascadingParameter] public RouteData? RouteData { get; set; }

    private NavigationSectionState? _navigation;
    private bool _sidebarCollapsed;

    protected override async Task OnInitializedAsync()
    {
        // Navigation preferences first and synchronously (WebAssembly), so the sidebar has its remembered width on the first render.
        _navigation = LayoutServices.GetService(typeof(NavigationSectionState)) as NavigationSectionState;
        if (_navigation is not null)
        {
            _navigation.EnsureRestored(LayoutServices.GetService(typeof(Microsoft.JSInterop.IJSRuntime)) as Microsoft.JSInterop.IJSRuntime);
            _sidebarCollapsed = _navigation.SidebarCollapsed;
            _navigation.Changed += OnNavigationChanged;
        }

        // Another tab (or an earlier reset this tab missed) reset local data: discard this tab's leftover project state instead of saving it.
        _resetEpoch = LayoutServices.GetService(typeof(LocalDataResetEpoch)) as LocalDataResetEpoch;
        if (_resetEpoch is not null) _resetEpoch.StaleDetected += OnStaleAfterResetAsync;
        try
        {
            await FeatureViz.LoadAsync(AdminApi);

            // Restore the last active workspace on app startup
            await RestoreCurrentWorkspaceAsync();

            // Target Environment → Project decides which evidence explorers and the workflow read. Load the environments before the body
            // renders, so a page opened directly (reload, deep link) never falls back to the last imported package for lack of settings.
            if (LayoutServices.GetService(typeof(IFrontendAnalysisSettingsService)) is IFrontendAnalysisSettingsService environments && !environments.IsLoaded
                && LayoutServices.GetService(typeof(Microsoft.JSInterop.IJSRuntime)) is Microsoft.JSInterop.IJSRuntime js)
            {
                try { await environments.LoadAsync(js); }
                catch (Exception ex) { Logger.LogWarning(ex, "Target Environments could not be loaded on startup"); }
            }
        }
        finally
        {
            _ready = true;
        }
    }

    private async Task OnStaleAfterResetAsync(int epoch)
    {
        if (LayoutServices.GetService(typeof(ApplicationRuntimeResetService)) is not ApplicationRuntimeResetService RuntimeReset) return;
        await InvokeAsync(async () =>
        {
            await RuntimeReset.PauseAutoSaveForResetAsync();
            try { await RuntimeReset.ClearFrontendRuntimeStateAsync(); }
            finally { RuntimeReset.ResumeAutoSaveAfterReset(); }
            Navigation.NavigateTo("dashboard?reset=stale");
        });
    }

    private LocalDataResetEpoch? _resetEpoch;

    /// <summary>Only the sidebar width follows the navigation state here; other navigation changes do not re-render the page.</summary>
    private void OnNavigationChanged()
    {
        if (_navigation is null || _navigation.SidebarCollapsed == _sidebarCollapsed) return;
        _sidebarCollapsed = _navigation.SidebarCollapsed;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (_resetEpoch is not null) _resetEpoch.StaleDetected -= OnStaleAfterResetAsync;
        if (_navigation is not null) _navigation.Changed -= OnNavigationChanged;
    }

    private async Task RestoreCurrentWorkspaceAsync()
    {
        try
        {
            var currentState = await WorkspacePersistence.GetCurrentStateAsync();
            if (currentState?.CurrentWorkspaceId is not null && currentState.CurrentWorkspaceId != Guid.Empty)
            {
                // Summary first: identity and the lifecycle manifest. Document bodies load when a page reads documents, never before the shell.
                var workspace = await WorkspacePersistence.LoadBootstrapAsync(currentState.CurrentWorkspaceId.Value);
                // A Sample Project selection is persisted identity-only (project slug, no artifact copies), so a
                // workspace with zero artifacts but a project name must be restored too. Nothing is ever substituted:
                // an empty project name and no artifacts simply leaves the session empty.
                if (workspace is not null && (workspace.Artifacts.Count > 0 || !string.IsNullOrWhiteSpace(workspace.ProjectName)
                    || ProjectImportScope.HasCurrentImport(workspace.SddLifecycleJson)))
                {
                    Logger.LogInformation("Restoring workspace: {WorkspaceName} (project: {ProjectName}, artifacts: {ArtifactCount})",
                        workspace.Name, string.IsNullOrWhiteSpace(workspace.ProjectName) ? "(none)" : workspace.ProjectName, workspace.Artifacts.Count);
                    await WorkspaceRestore.RestoreWorkspaceAsync(workspace);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to restore current workspace on startup");
            // Continue with empty workspace if restoration fails
        }
    }
}
