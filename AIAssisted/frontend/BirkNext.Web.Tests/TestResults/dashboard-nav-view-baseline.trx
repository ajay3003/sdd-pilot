                &lt;div class="ug-about-row" b-z0y9qx4pqm&gt;&lt;span class="ug-about-label" b-z0y9qx4pqm&gt;Version&lt;/span&gt;&#xD;
                    &lt;span class="ug-about-value" b-z0y9qx4pqm&gt;Preview&lt;/span&gt;&lt;/div&gt;&#xD;
                &lt;div class="ug-about-row" b-z0y9qx4pqm&gt;&lt;span class="ug-about-label" b-z0y9qx4pqm&gt;Platform&lt;/span&gt;&#xD;
                    &lt;span class="ug-about-value" b-z0y9qx4pqm&gt;Blazor WebAssembly · .NET 8&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;&#xD;
