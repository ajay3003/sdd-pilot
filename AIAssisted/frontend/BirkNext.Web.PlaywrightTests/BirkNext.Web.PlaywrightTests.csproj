<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="Microsoft.Playwright" Version="1.48.0" />
    <PackageReference Include="FluentAssertions" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BirkNext.Web\BirkNext.Web.csproj" />
    <ProjectReference Include="..\..\backend\BirkNext.Api\BirkNext.Api.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(RunPreStartedPlaywrightTests)' != 'true'">
    <Compile Remove="Tests\*_PreStarted.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(RunPreStartedPlaywrightTests)' == 'true'">
    <Compile Remove="Tests\QualityReviewPlaywrightTests.cs" />
  </ItemGroup>

</Project>
