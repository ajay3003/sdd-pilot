<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>BirkNext.Api.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Messaging.EventHubs" Version="5.12.2" />
    <PackageReference Include="Azure.Monitor.Query" Version="1.7.1" />
    <!-- Syntax-only parsing of uploaded application source (Wolverine evidence); same version the EF Core design tools already resolve. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.5.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.2" />
    <PackageReference Include="HotChocolate.AspNetCore" Version="14.*" />
    <PackageReference Include="HotChocolate.Data.EntityFramework" Version="14.*" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.16" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.*" />
    <PackageReference Include="Microsoft.Playwright" Version="1.48.0" />
    <PackageReference Include="Deque.AxeCore.Commons" Version="4.13.0" />
    <PackageReference Include="CycloneDX.Core" Version="12.1.2" />
    <PackageReference Include="CycloneDX.Spdx" Version="12.1.2" />
    <PackageReference Include="NuGet.Versioning" Version="7.9.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.*" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Tools\LighthouseRunner\package.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="Tools\LighthouseRunner\package-lock.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="Tools\LighthouseRunner\run-lighthouse.mjs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../shared/ManagedEdgeCdpContracts.cs" Link="Models/ManagedEdgeCdpContracts.cs" />
    <Compile Include="../../shared/HeadlessAuthDiagnosticContracts.cs" Link="Models/HeadlessAuthDiagnosticContracts.cs" />
    <Compile Include="../../shared/LocalHttpsProxyContracts.cs" Link="Models/LocalHttpsProxyContracts.cs" />
    <Compile Include="../../shared/AxeRuleCatalog.cs" Link="Models/AxeRuleCatalog.cs" />
    <Compile Include="../../shared/BrowserCompanionContracts.cs" Link="Models/BrowserCompanionContracts.cs" />
    <Compile Include="../../shared/ApiReviewContracts.cs" Link="Models/ApiReviewContracts.cs" />
    <Compile Include="../../shared/CriticalE2EContracts.cs" Link="Models/CriticalE2EContracts.cs" />
    <Compile Include="../../shared/IntegrationCatalogContracts.cs" Link="Models/IntegrationCatalogContracts.cs" />
    <Compile Include="../../shared/ApplicationMessagingContracts.cs" Link="Models/ApplicationMessagingContracts.cs" />
    <Compile Include="../../shared/IqrSourceContracts.cs" Link="Models/IqrSourceContracts.cs" />
    <Compile Include="../../shared/SourceIntegrationContracts.cs" Link="Models/SourceIntegrationContracts.cs" />
    <Compile Include="../../shared/DatabaseArchitectureContracts.cs" Link="Models/DatabaseArchitectureContracts.cs" />

    <Compile Include="../../shared/SourceArchitectureContracts.cs" Link="Models/SourceArchitectureContracts.cs" />
    <Compile Include="../../shared/SecurityExpectationContracts.cs" Link="Models/SecurityExpectationContracts.cs" />
    <Compile Include="../../shared/ActiveCdcTestContracts.cs" Link="Models/ActiveCdcTestContracts.cs" />
    <Compile Include="../../shared/ServiceBusContracts.cs" Link="Models/ServiceBusContracts.cs" />
    <Compile Include="../../shared/DependencyReviewContracts.cs" Link="Models/DependencyReviewContracts.cs" />
    <Compile Include="../../shared/SourceDependencyContracts.cs" Link="Models/SourceDependencyContracts.cs" />
    <Compile Include="../../shared/ReviewSourceContracts.cs" Link="Models/ReviewSourceContracts.cs" />
    <Compile Include="../../shared/SourceObservabilityContracts.cs" Link="Models/SourceObservabilityContracts.cs" />
    <Compile Include="../../shared/SourceEvidenceDomainContracts.cs" Link="Models/SourceEvidenceDomainContracts.cs" />
    <Compile Include="../../shared/SourceInfrastructureIdentityContracts.cs" Link="Models/SourceInfrastructureIdentityContracts.cs" />
    <Compile Include="../../shared/PipelineReviewContracts.cs" Link="Models/PipelineReviewContracts.cs" />
    <Compile Include="../../shared/SourceChangeImpactContracts.cs" Link="Models/SourceChangeImpactContracts.cs" />
    <Compile Include="../../shared/DependencyHealthContracts.cs" Link="Models/DependencyHealthContracts.cs" />
    <Compile Include="../../shared/ScimProvisioningContracts.cs" Link="Models/ScimProvisioningContracts.cs" />
    <Compile Include="../../shared/SecurityClassificationContracts.cs" Link="Models/SecurityClassificationContracts.cs" />
    <Compile Include="../../shared/GraphQlSchemaArtifactContracts.cs" Link="Models/GraphQlSchemaArtifactContracts.cs" />
  </ItemGroup>
  <Target Name="PackageBrowserCompanion" BeforeTargets="AssignTargetPaths">
    <Exec Command="node build.mjs --prepare-only" WorkingDirectory="$(MSBuildProjectDirectory)/../../browser-companion" />
    <!-- Collected into their own item type first: an unqualified %(RecursiveDir) inside a target batches over every
         existing Content item, which copied the backend's own content (appsettings, Playwright driver) into
         BrowserCompanion/ and never the Companion itself. -->
    <ItemGroup>
      <_BirkNextCompanionFile Include="../../browser-companion/dist/current/**/*" />
      <Content Include="@(_BirkNextCompanionFile)" Link="BrowserCompanion/%(_BirkNextCompanionFile.RecursiveDir)%(_BirkNextCompanionFile.Filename)%(_BirkNextCompanionFile.Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <Using Include="BirkNext.SourceEvidence" />
  </ItemGroup>
</Project>
