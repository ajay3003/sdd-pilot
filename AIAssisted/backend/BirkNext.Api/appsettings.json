{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=birknext;Username=birknext;Password=birknext"
  },
  "FRONTEND_ORIGIN": "http://localhost:5173",
  "Anthropic": {
    "ApiKey": "",
    "Model": "claude-sonnet-4-6"
  },
  "AdminSettings": {
    "Enabled": true,
    "AllowLocalDatabaseReset": true,
    "ShowDiagnostics": true
  },
  "RuntimeSettings": {
    "ApplicationName": "QA Review Studio",
    "PackageMode": "Auto",
    "ComposeProjectName": "birknext-studio-local",
    "ExpectedDatabaseVolume": "birknext-studio-local_postgres_data"
  },
  "DatabaseSettings": {
    "Mode": "Local",
    "Provider": "PostgreSQL",
    "Host": "localhost",
    "Port": 5432,
    "DatabaseName": "birknext"
  },
  "LoggingSettings": {
    "Provider": "Serilog",
    "MinimumLevel": "Information",
    "LogPath": "./logs",
    "StructuredLogging": true,
    "SeqUrl": ""
  },
  "AzureDevOps": {
    "Enabled": false,
    "OrganizationUrl": "https://dev.azure.com/{organization}",
    "Project": "{project}",
    "RepositoryId": "{repositoryId}",
    "DefaultBranch": "main",
    "Pat": ""
  },
  "FeatureVisibility": {
    "Dashboard": true,
    "UserGuide": true,
    "RecommendedWorkflow": true,
    "AdminSystemSettings": true,
    "SpecificationReview": true,
    "QaArtifactLibrary": true,
    "TraceabilityCoverage": true,
    "ImplementationReview": true,
    "ImplementationTraceability": true,
    "BlazorWasmSecurityReview": true,
    "CreateTestScenario": false,
    "CodeTraceability": false,
    "SpecComparison": false,
    "SpecificationDeltas": false,
    "TaskDeltas": false,
    "ImpactAnalysis": false,
    "SpecDrift": false,
    "AiChangeReview": false,
    "QaReadiness": false,
    "EnableExtractionReview": false,
    "EnableArchitectureView": false
  }
}
