<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Server GC, as BirkNext.Api itself runs (the Web SDK default) (2026-11-24). The suite hosts dozens of in-process copies of the web app;
         under the default workstation GC a full run spent ~229 s (33 %) frozen in collections, single pauses up to 6 s, and in-memory HTTP calls hit
         their 100 s timeouts (9-11 failures per run). With Server GC: 32 s total, longest pause 0.44 s (runtime probe: BIRKNEXT_TEST_STALL_PROBE). -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Deque.AxeCore.Commons" Version="4.13.0" />
    <PackageReference Include="FluentAssertions" Version="8.9.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Snapshooter.Xunit" Version="1.3.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.11.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BirkNext.Api\BirkNext.Api.csproj" />
    <ProjectReference Include="..\..\frontend\BirkNext.Web\BirkNext.Web.csproj" Aliases="WebProject" />
    <ProjectReference Include="..\..\launcher\BirkNext.Launcher\BirkNext.Launcher.csproj" Aliases="LauncherProject" />
    <ProjectReference Include="..\..\launcher\BirkNext.Updater\BirkNext.Updater.csproj" Aliases="UpdaterProject" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="BirkNext.SourceEvidence" />
  </ItemGroup>
</Project>
