<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Workstation (concurrent) GC, chosen from measurements (2026-11-25; scratchpad diag/mem-*, harness run_suite.ps1, 24 cores, ~8.5 GB free):
         - Workstation: full suite completed 7352 passed / 0 failed / 19 skipped in 13 m 15 s; peak 6.5 GB; GC pauses 394 s total, longest 8.7 s.
         - Server GC (default threads and 8 threads) and Server GC + DATAS: stopped by the 2.5 GB free-RAM floor after 60-140 s at 4.6-6.1 GB
           (24 heaps grow budgets faster than the suite releases hosts). On 2026-11-24 Server GC shortened pauses but the machine ran out of memory.
         - 8 parallel threads instead of 24 did not lower the peak (5.5 GB at 170 s): the memory is the sum of many concurrent host-based tests
           (Data/Integration/Contract 2.1 GB, Controllers 1.1 GB; no single leak found).
         The 2026-11-24 timeouts under workstation GC were measured while every test host shared the real database; with isolated databases the
         workstation run had none. Re-measure before changing this: set BIRKNEXT_TEST_STALL_PROBE to a file path for GC/pause/heap per second. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Deque.AxeCore.Commons" Version="4.13.0" />
    <PackageReference Include="FluentAssertions" Version="8.9.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Snapshooter.Xunit" Version="1.3.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.11.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BirkNext.Api\BirkNext.Api.csproj" />
    <ProjectReference Include="..\..\frontend\BirkNext.Web\BirkNext.Web.csproj" Aliases="WebProject" />
    <ProjectReference Include="..\..\launcher\BirkNext.Launcher\BirkNext.Launcher.csproj" Aliases="LauncherProject" />
    <ProjectReference Include="..\..\launcher\BirkNext.Updater\BirkNext.Updater.csproj" Aliases="UpdaterProject" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="BirkNext.SourceEvidence" />
  </ItemGroup>
</Project>
