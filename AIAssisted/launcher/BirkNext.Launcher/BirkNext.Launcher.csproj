<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The Windows Tester Package entry point (Start-BirkNext.exe): TesterNative runtime profile only. It verifies the package, manages the bundled
    PostgreSQL for this Windows user, starts the packaged backend, serves the packaged frontend and opens the browser. The developer setup keeps
    scripts/start-local.ps1 (DeveloperContainer). Published self-contained (win-x64) by scripts/build-tester-package.ps1; the RID is not fixed here
    so the test project can reference it.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>Start-BirkNext</AssemblyName>
    <RootNamespace>BirkNext.Launcher</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StartupObject>BirkNext.Launcher.LauncherProgram</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.*" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BirkNext.Api.Tests" />
    <Compile Include="../../shared/RuntimeProfileContracts.cs" Link="Shared/RuntimeProfileContracts.cs" />
  </ItemGroup>

  <Import Project="../../versioning/BirkNext.BuildIdentity.targets" />

</Project>
