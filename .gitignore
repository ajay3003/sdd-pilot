# =========================================================
# Generated scoped CSS
# =========================================================

# IMPORTANT:
# This file must never exist as tracked source.
#
# Blazor generates BirkNext.Web.styles.css automatically from
# scoped *.razor.css files during the build.
#
# A physical copy under wwwroot can collide with the generated
# scoped CSS bundle and cause:
#
# GenerateStaticWebAssetsDevelopmentManifest
# InvalidOperationException:
# Sequence contains more than one element
#
# The generated version under obj/ is valid.
# The physical wwwroot copy is not source code and must not
# be committed.
AIAssisted/frontend/BirkNext.Web/wwwroot/BirkNext.Web.styles.css


